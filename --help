            border-radius:12px; padding:16px 18px 12px; }
  h2 { font-size:15px; margin:0 0 10px; }
  .stage { display:flex; justify-content:center; }
  figcaption { margin-top:8px; font-size:12px; opacity:.6; }
  code { font-size:11px; }
</style></head>
