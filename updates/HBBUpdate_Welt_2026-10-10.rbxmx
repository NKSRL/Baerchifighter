<Item class="Folder" referent="RBX27"><Properties>
<string name="Name">Modules</string>
</Properties>
<Item class="ModuleScript" referent="RBX28"><Properties>
<string name="Name">CombatCalculator</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- CombatCalculator.luau
-- ReplicatedStorage/Modules/CombatCalculator.luau
--
-- Reine Funktionen fuer Kampfberechnungen.
-- Kein State, keine Services — nur Mathe.
-- Kann einfach unit-getestet werden.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SkillConfig     = require(ReplicatedStorage.Config.SkillConfig)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local PromotionConfig = require(ReplicatedStorage.Config.PromotionConfig)
local CharmConfig     = require(ReplicatedStorage.Config.CharmConfig)
local Types           = require(ReplicatedStorage.Network.Types)

local CombatCalculator = {}

-- ============================================================
-- ES GIBT KEINE VERTEIDIGUNG
-- ============================================================
-- Frueher hatte jeder Kaempfer einen DEF-Wert, der eingehenden Schaden
-- prozentual reduzierte. Der ist ersatzlos entfallen: ein Treffer macht genau
-- so viel Schaden, wie der Angreifer ATK hat. Wer einen Tank will, baut einen
-- Baerchi mit viel HP.
--
-- Das ist eine bewusste Entscheidung fuer ein einfaches Spiel, keine
-- Vereinfachung aus Versehen. Wer hier wieder eine Reduktion einbauen will:
-- die Stelle ist calcDamage, und die HP-Grundwerte in BaerchiConfig muessten
-- dann zurueckgerechnet werden (dort steht, wie sie entstanden sind).
export type FighterStats = {
	maxHp  : number,
	atk    : number,
	spd    : number,

	-- Ability-Staerke als Anteil (0.20 = +20% Skill-Schaden). Wirkt
	-- ausschliesslich auf den SKILL-Anteil einer Runde, nie auf den Grundschlag
	-- (calcDamage) — siehe applySkill weiter unten.
	--
	-- Eine Feinheit, die man kennen sollte: BasicPunch ist als Skill mit
	-- Multiplikator 1.0 und Cooldown 0 modelliert, ist also technisch eine
	-- Ability. Ein Baerchi mit BasicPunch bekommt seine PWR deshalb in JEDER
	-- Runde als Aufschlag, waehrend ein Baerchi mit ShardBlast (Cooldown 3)
	-- sie nur alle vier Runden sieht. Das ist Absicht und kein Versehen: der
	-- Grundschlag-Baerchi hat dafuer keinen Ausschlag nach oben, der
	-- Skill-Baerchi schon.
	pwr    : number,

	skillId: string,
}

export type CombatSnapshot = {
	uid    : string,
	stats  : FighterStats,
	hp     : number,     -- aktuell
	-- v15: Aufladung der Faehigkeit in "Stoessen" (siehe SkillConfig.CHARGE).
	-- Bleibt ueber die Stages eines Laufs erhalten, deshalb im Snapshot.
	charge : number,
}

-- Wachstumsfaktor eines Levels: +10% pro Level auf den Vorwert, also
-- exponentiell (siehe BaerchiConfig.STAT_GROWTH_PER_LEVEL). Level 1 = 1.0.
-- Oeffentlich, weil die PIT-Gegner mit derselben Kurve skalieren muessen —
-- zwei getrennte Formeln wuerden beim naechsten Balancing auseinanderlaufen.
function CombatCalculator.getLevelGrowth(level: number): number
	return math.pow(1 + BaerchiConfig.STAT_GROWTH_PER_LEVEL, math.max(level, 1) - 1)
end

-- Alle Charm-Boni eines Baerchis, aufsummiert nach Ziel-Stat.
--
-- Getrennt nach `percent` (Faktor, multipliziert sich auf den Basiswert) und
-- `flat` (wird direkt addiert) — welcher Typ was ist, steht in
-- CharmConfig.STAT_POOL, nicht hier.
--
-- Gleiche Typen addieren sich einfach: acht Slots mit je +1.4% HP ergeben
-- +11.2%, nicht 1.014^8. Das ist die einfachere und vorhersagbarere Variante,
-- und bei acht Slots ist der Unterschied ohnehin klein.
type CharmTotals = {
	percent : { hp: number, atk: number, spd: number, pwr: number },
	flat    : { hp: number, atk: number, spd: number, pwr: number },
}

local function sumCharms(baerchi: Types.Baerchi): CharmTotals
	local totals: CharmTotals = {
		percent = { hp = 0, atk = 0, spd = 0, pwr = 0 },
		flat    = { hp = 0, atk = 0, spd = 0, pwr = 0 },
	}

	local charms = baerchi.charms
	if not charms then
		return totals
	end

	for _, charm in charms do
		-- Ein Charm in einem Slot, der durch einen spaeteren Datenstand nicht
		-- mehr freigeschaltet waere, zaehlt bewusst NICHT mit: die Freischaltung
		-- ist die einzige Bremse des Systems, und sie muss auch dann greifen,
		-- wenn ein Spielstand aus irgendeinem Grund mehr Charms enthaelt als
		-- der Promotions-Stand erlaubt.
		if CharmConfig.isSlotUnlocked(charm.slot, baerchi.promotionLevel or 0) then
			local statDef = CharmConfig.getStatDef(charm.statId)
			if statDef then
				local bucket = if statDef.mode == "percent" then totals.percent else totals.flat
				bucket[statDef.target] += charm.value or 0
			end
		end
	end

	return totals
end

-- Berechnet effektive Stats eines Bärchis auf seinem Level.
--
-- ============================================================
-- DIE FUENF MULTIPLIKATOREN AUF HP/ATK — REIHENFOLGE UND WARUM
-- ============================================================
--   1. Level-Wachstum   (getLevelGrowth, exponentiell)
--   2. Fusions-Bonus    (Baerchi.fusionBonus, gesetzt von FusionService)
--   3. Promotions-Bonus (+2% je Stufe, PromotionConfig)
--   4. Stat-Level-Bonus (+4% je Stufe, waechst durch Event-Teilnahme)
--   5. Charm-Bonus      (Summe aller ausgeruesteten Charms)
--
-- Alle fuenf multiplizieren sich, weil jeder eine EIGENE Fortschrittsachse ist:
-- wer beides betreibt (fuettern UND Events), soll den Nutzen von beidem sehen.
-- Addierte Faktoren wuerden die spaetere Achse jeweils entwerten.
--
-- Der MUTATIONS-Bonus (BaerchiConfig.getMutationBonus, seit v11 an die Stelle
-- des frueheren binaeren INVERTED_BONUS getreten) kommt VOR allem anderen: er
-- wirkt auf den Basiswert, nicht auf das Ergebnis. Dadurch bedeutet z.B.
-- "+150% HP" (Diamond) wirklich 150% mehr, egal auf welchem Level oder mit
-- welchen Charms der Baerchi gerade steht — und nicht mal mehr, mal weniger.
--
-- SPD und PWR bekommen bewusst KEINEN Prozentbonus aus Level/Fusion/Promotion,
-- sondern nur flache Zugaben. Der Grund steht in BaerchiConfig bei
-- SPD_PER_LEVEL / PWR_PER_LEVEL: PWR multipliziert bereits den Skill-Schaden,
-- der seinerseits am exponentiell wachsenden ATK haengt.
--
-- ============================================================
-- baseStatOverride
-- ============================================================
-- Basiswerte kommen normalerweise aus `baseDef` (das ist
-- BaerchiConfig.data[configId].baseStats, der Aufrufer reicht es herein). Ein
-- FUSIONS-Ergebnis kann aber per Stat hoehere Basiswerte geerbt haben, als sein
-- eigener configId hergibt (siehe FusionService, Regel 1) — dafuer, und NUR
-- dafuer, gibt es Baerchi.baseStatOverride. Fuer jeden anderen Baerchi ist das
-- Feld nil.
-- Paket 9: Kampf-Level = Level + Endless-Level (nur auf MAX_LEVEL).
function CombatCalculator.getCombatLevel(baerchi: Types.Baerchi): number
	if baerchi.level >= BaerchiConfig.MAX_LEVEL then
		return baerchi.level + math.max(0, baerchi.endlessLevel or 0)
	end
	return baerchi.level
end

function CombatCalculator.getEffectiveStats(baerchi: Types.Baerchi, baseDef: { [string]: any }): FighterStats
	local level  = CombatCalculator.getCombatLevel(baerchi)
	local growth = CombatCalculator.getLevelGrowth(level)

	-- 1. Basiswerte: Override schlaegt Config, wo gesetzt.
	local override = baerchi.baseStatOverride
	local baseHp   = (override and override.hp)  or baseDef.hp
	local baseAtk  = (override and override.atk) or baseDef.atk
	local baseSpd  = (override and override.spd) or baseDef.spd
	local basePwr  = (override and override.pwr) or baseDef.pwr or 0

	-- 2. Mutation: wirkt direkt auf die Basiswerte, vor allem anderen.
	-- getMutationBonus liefert fuer baerchi.mutation == nil einen Nullbonus,
	-- die Multiplikation unten ist deshalb ohne Sonderfall immer korrekt.
	local mutationBonus = BaerchiConfig.getMutationBonus(baerchi.mutation)
	baseHp  *= (1 + mutationBonus.hp)
	baseAtk *= (1 + mutationBonus.atk)
	baseSpd *= (1 + mutationBonus.spd)
	basePwr *= (1 + mutationBonus.pwr)

	-- 3. Die prozentualen Zuschlaege ausserhalb des Levels.
	local fusionBonus    = 1 + (baerchi.fusionBonus or 0)
	local promotionBonus = 1 + PromotionConfig.getPromotionBonus(baerchi.promotionLevel or 0)

	local statLevels = baerchi.statLevels
	local hpLevels   = if statLevels then (statLevels.hp  or 0) else 0
	local atkLevels  = if statLevels then (statLevels.atk or 0) else 0
	local spdLevels  = if statLevels then (statLevels.spd or 0) else 0
	local pwrLevels  = if statLevels then (statLevels.pwr or 0) else 0

	local hpStatBonus  = 1 + hpLevels  * PromotionConfig.STAT_LEVEL_GAIN.hp
	local atkStatBonus = 1 + atkLevels * PromotionConfig.STAT_LEVEL_GAIN.atk

	-- 4. Charms.
	local charms = sumCharms(baerchi)

	local maxHp = baseHp * growth * fusionBonus * promotionBonus * hpStatBonus
		* (1 + charms.percent.hp) + charms.flat.hp

	local atk = baseAtk * growth * fusionBonus * promotionBonus * atkStatBonus
		* (1 + charms.percent.atk) + charms.flat.atk

	local spd = baseSpd
		+ (level - 1) * BaerchiConfig.SPD_PER_LEVEL
		+ spdLevels * PromotionConfig.STAT_LEVEL_GAIN.spd
		+ charms.flat.spd

	local pwr = basePwr
		+ (level - 1) * BaerchiConfig.PWR_PER_LEVEL
		+ pwrLevels * PromotionConfig.STAT_LEVEL_GAIN.pwr
		+ charms.flat.pwr

	return {
		-- math.max(1, ...): ein Baerchi mit 0 maxHp waere sofort und dauerhaft
		-- erschoepft und liesse sich auch nicht mehr hochfuettern.
		maxHp   = math.max(1, math.floor(maxHp)),
		atk     = math.max(1, math.floor(atk)),
		spd     = spd * (1 + charms.percent.spd),

		-- PWR darf nicht negativ werden (ein Skill soll nie heilen statt zu
		-- schaden), nach oben ist es bewusst offen: es multipliziert nur den
		-- Skill-Anteil, und dessen Cooldown begrenzt ihn ohnehin.
		pwr     = math.max(0, pwr * (1 + charms.percent.pwr)),

		skillId = baerchi.skillId,
	}
end

-- Schaden eines normalen Schlags.
--
-- Seit dem DEF-Ausbau ist das schlicht der ATK-Wert — es gibt nichts mehr, was
-- ihn reduziert. Die Funktion bleibt trotzdem stehen: sie ist die eine Stelle,
-- an der "was macht ein Treffer" beantwortet wird.
local function calcDamage(atk: number): number
	return math.max(1, math.floor(atk))
end

-- ============================================================
-- DIE ABILITY-FORMEL
-- ============================================================
--     Skill-Schaden = (ATK x Skill-Multiplikator + Skill-Basisschaden)
--                     x (1 + PWR)
--
-- Gibt den BONUS ueber den normalen Schlag zurueck (der Aufrufer rechnet
-- calcDamage(atk) + bonus). Ein Skill, der schwaecher waere als ein normaler
-- Schlag, gibt 0 Bonus statt eines negativen Werts.
local function skillDamage(atk: number, pwr: number, multiplier: number, baseDamage: number): number
	local raw = (atk * multiplier + baseDamage) * (1 + pwr)
	return math.max(0, math.floor(raw) - calcDamage(atk))
end

-- ============================================================
-- v14: RUNDENKAMPF MIT SPD UND STATUS-EFFEKTEN
-- ============================================================
-- Bis v13 schlugen beide Seiten strikt abwechselnd zu, SPD wurde nie
-- ausgewertet, und Shield/SpeedBuff/DoT/AoE setzten nur ihren Cooldown.
--
-- Jetzt laeuft der Kampf auf einer ZEITACHSE: jeder Kaempfer handelt alle
-- 1/SPD Sekunden. Wer doppelt so schnell ist, handelt doppelt so oft. Bei
-- Gleichstand handelt A (der Baerchi) zuerst — damit ist ein Kampf zweier
-- gleich schneller Kaempfer exakt der alte Wechsel.
--
-- Eine AKTION des Kaempfers X gegen Y:
--   1. Ist X betaeubt, verfaellt die Aktion (nur die Betaeubung endet).
--   2. Brennt X (DoT von Y), nimmt er zuerst den Brand-Schaden.
--   3. Cooldown von X zaehlt eins runter; steht er auf 0, setzt X seinen
--      Skill ein (sonst nur der normale Schlag).
--   4. Schaden trifft Y — ein Schild von Y faengt seinen Anteil ab, die
--      Letzte Chance von Y kann ihn mit 1 HP retten.
--   5. Alle Status, die X TRAEGT, zaehlen eine Aktion runter.
--   6. Naechste Aktion von X in 1 / (SPD x Buff x Verlangsamung) Sekunden.
--
-- Die Dauer eines Status zaehlt also die Aktionen dessen, der ihn traegt.
-- Ein Status, der in dieser Aktion erst entstanden ist, zaehlt in ihr nicht.

-- Ein Eintrag im Runden-Log (serverseitig). Der Client bekommt davon nur die
-- Zusammenfassung je Stage (PitStageResult.skillUses), siehe Types.
export type ActionLog = Types.RoundLogEntry

type Timed = { left: number, fresh: boolean }

type Fighter = {
	snap      : CombatSnapshot,
	tag       : string,          -- "A" | "B"
	nextAt    : number,
	actions   : number,
	stunned   : boolean,
	dot       : { perTick: number, left: number }?,
	shield    : (Timed & { absorb: number })?,
	slow      : (Timed & { mult: number })?,
	weaken    : (Timed & { mult: number })?,
	buff      : (Timed & { spdMult: number, pwrAdd: number, atkMult: number })?,
	lastStand : boolean,          -- hat (noch) eine Letzte Chance
	burst     : number,           -- ausstehender Feuerstoss (Schaden)
	rampUses  : number,
	opened    : boolean,
	skillUses : number,
}

local function newFighter(snap: CombatSnapshot, tag: string): Fighter
	local skill = SkillConfig.getById(snap.stats.skillId)
	local hasLastStand = skill ~= nil and (skill.effectType == "LastStand" or skill.effectType == "Revive")
	return {
		snap      = snap,
		tag       = tag,
		nextAt    = 0,
		actions   = 0,
		stunned   = false,
		dot       = nil,
		shield    = nil,
		slow      = nil,
		weaken    = nil,
		buff      = nil,
		lastStand = hasLastStand,
		burst     = 0,
		rampUses  = 0,
		opened    = false,
		skillUses = 0,
	}
end

local function effSpd(f: Fighter): number
	local spd = math.max(0.1, f.snap.stats.spd)
	if f.buff then spd *= f.buff.spdMult end
	if f.slow then spd *= f.slow.mult end
	return math.max(0.1, spd)
end

local function effAtk(f: Fighter): number
	local atk = f.snap.stats.atk
	if f.buff then atk *= f.buff.atkMult end
	if f.weaken then atk *= f.weaken.mult end
	return math.max(1, atk)
end

local function effPwr(f: Fighter): number
	local pwr = f.snap.stats.pwr
	if f.buff then pwr += f.buff.pwrAdd end
	return math.max(0, pwr)
end

-- Schaden auf `target` anwenden. Gibt (wirklich abgezogen, abgefangen,
-- Letzte-Chance-ausgeloest) zurueck.
local function dealDamage(target: Fighter, amount: number): (number, number, boolean)
	if amount <= 0 or target.snap.hp <= 0 then
		return 0, 0, false
	end

	local absorbed = 0
	if target.shield then
		absorbed = math.floor(amount * target.shield.absorb)
		amount -= absorbed
	end

	local before = target.snap.hp
	local after  = before - amount
	local saved  = false

	if after <= 0 and target.lastStand then
		target.lastStand = false
		saved = true
		local skill = SkillConfig.getById(target.snap.stats.skillId)
		if skill and skill.effectType == "Revive" then
			after = math.max(1, math.floor(target.snap.stats.maxHp * (skill.params.reviveHpPercent or 0.5)))
		else
			after = 1
			-- Phoenix-Glut: der Feuerstoss kommt mit der naechsten eigenen Aktion.
			if skill then
				target.burst = skillDamage(effAtk(target), effPwr(target),
					skill.params.burstMultiplier or 2, skill.params.baseDamage or 0) + calcDamage(effAtk(target))
			end
		end
	end

	target.snap.hp = math.max(0, after)
	return before - target.snap.hp, absorbed, saved
end

local function tickTimed(t: Timed?): Timed?
	if not t then return nil end
	if t.fresh then
		t.fresh = false
		return t
	end
	t.left -= 1
	if t.left <= 0 then return nil end
	return t
end

-- Fuehrt EINE Aktion von x gegen y aus und gibt den Log-Eintrag zurueck.
local function act(x: Fighter, y: Fighter, round: number, a: Fighter, b: Fighter): ActionLog
	local entry: ActionLog = {
		roundNumber     = round,
		actor           = x.tag,
		kind            = "hit",
		chargeA         = 0,
		skillUsed       = false,
		skillId         = nil,
		damage          = 0,
		heal            = 0,
		absorbed        = 0,
		effects         = nil,
		attackerHpAfter = 0,
		defenderHpAfter = 0,
	}
	local effects: { string } = {}

	x.actions += 1

	if x.stunned then
		x.stunned = false
		table.insert(effects, "stunned")
		entry.kind = "stunned"
	else
		-- Brand
		if x.dot then
			local burnt = dealDamage(x, x.dot.perTick)
			table.insert(effects, "burn:" .. burnt)
			x.dot.left -= 1
			if x.dot.left <= 0 then x.dot = nil end
		end

		if x.snap.hp > 0 then
			local atk = effAtk(x)
			local pwr = effPwr(x)
			local dmg = calcDamage(atk)
			local heal = 0
			local selfCost = 0

			-- Ausstehender Feuerstoss (Letzte Chance) ersetzt den Schlag.
			if x.burst > 0 then
				dmg = x.burst
				x.burst = 0
				table.insert(effects, "laststand_burst")
				entry.skillUsed = true
				entry.skillId = x.snap.stats.skillId
				entry.kind = "burst"
			end

			-- ============================================================
			-- v15: STOSS ODER FAEHIGKEIT
			-- ============================================================
			-- Normalfall: ein STOSS (Grundschaden = ATK), der die Faehigkeit
			-- laedt. Ist sie voll geladen, ist dieser Zug die Faehigkeit.
			local skill = SkillConfig.getById(x.snap.stats.skillId)
			local cost = if skill then (skill.charge or 0) else 0
			local canCharge = skill ~= nil and cost > 0 and skill.effectType ~= "Passive"
				and skill.effectType ~= "LastStand" and skill.effectType ~= "Revive"

			if entry.kind ~= "burst" and skill and cost <= 0 and skill.effectType == "Damage" then
				-- Grundschlag-Baerchi (BasicPunch): keine eigene Faehigkeit, dafuer
				-- bekommt JEDER Stoss den PWR-Aufschlag (wie bisher).
				dmg += skillDamage(atk, pwr, skill.params.multiplier or 1, skill.params.baseDamage or 0)
			elseif entry.kind ~= "burst" and canCharge and skill and (x.snap.charge or 0) >= cost then
				local p = skill.params
				local base = p.baseDamage or 0
				local et = skill.effectType
				local used = true

				if et == "Damage" then
					dmg += skillDamage(atk, pwr, p.multiplier or 1, base)
				elseif et == "AoeDamage" then
					dmg += skillDamage(atk, pwr, p.damageMultiplier or 1, base)
				elseif et == "Heal" then
					heal = math.floor(x.snap.stats.maxHp * (p.healPercent or 0))
				elseif et == "Drain" then
					local drained = math.floor(y.snap.hp * (p.drainPercent or 0) * (1 + pwr))
					drained = math.min(drained, y.snap.hp)
					dmg += drained
					heal = drained
				elseif et == "Stun" then
					dmg += skillDamage(atk, pwr, p.damageMultiplier or 1, base)
					y.stunned = true
					table.insert(effects, "stun")
				elseif et == "InstantKill" then
					if math.random() < (p.chance or 0) then
						dmg += y.snap.hp
						table.insert(effects, "instakill")
					else
						dmg += skillDamage(atk, pwr, p.fallbackMultiplier or 1, base)
					end
				elseif et == "Shield" then
					x.shield = { absorb = p.absorbPercent or 0, left = p.duration or 1, fresh = true }
					table.insert(effects, "shield")
				elseif et == "SpeedBuff" then
					x.buff = { spdMult = p.speedMult or 1, pwrAdd = 0, atkMult = 1, left = p.duration or 1, fresh = true }
					table.insert(effects, "buff")
				elseif et == "SelfBuff" then
					x.buff = {
						spdMult = p.spdMult or 1, pwrAdd = p.pwrAdd or 0, atkMult = p.atkMult or 1,
						left = p.duration or 1, fresh = true,
					}
					selfCost = math.floor(x.snap.stats.maxHp * (p.hpCost or 0))
					table.insert(effects, "buff")
				elseif et == "Slow" then
					y.slow = { mult = 1 - (p.slowPercent or 0), left = p.duration or 1, fresh = false }
					table.insert(effects, "slow")
				elseif et == "Weaken" then
					y.weaken = { mult = 1 - (p.atkReduce or 0), left = p.duration or 1, fresh = false }
					table.insert(effects, "weaken")
				elseif et == "DoT" then
					dmg += skillDamage(atk, pwr, p.multiplier or 1, base)
					local perTick = math.floor(((p.dotDamage or 0) + atk * (p.dotMultiplier or 0)) * (1 + pwr))
					y.dot = { perTick = math.max(1, perTick), left = p.dotDuration or 1 }
					table.insert(effects, "dot")
				elseif et == "Finisher" then
					local ratio = y.snap.hp / math.max(1, y.snap.stats.maxHp)
					local mult = if ratio < (p.threshold or 0.3) then (p.finisherMultiplier or 1) else (p.multiplier or 1)
					if ratio < (p.threshold or 0.3) then table.insert(effects, "finisher") end
					dmg += skillDamage(atk, pwr, mult, base)
				elseif et == "Opener" then
					local mult = if x.opened then (p.multiplier or 1) else (p.openerMultiplier or 1)
					if not x.opened then table.insert(effects, "opener") end
					x.opened = true
					dmg += skillDamage(atk, pwr, mult, base)
				elseif et == "Ramp" then
					local mult = (p.multiplier or 1) + (p.rampPerUse or 0) * x.rampUses
					x.rampUses += 1
					dmg += skillDamage(atk, pwr, mult, base)
				elseif et == "MultiHit" then
					local hits = math.max(1, math.floor(p.hits or 1))
					local per = (atk * (p.multiplierPerHit or 1) + base) * (1 + pwr)
					dmg = math.max(dmg, math.floor(per * hits))
					table.insert(effects, "hits:" .. hits)
				else
					used = false
				end

				if used then
					x.snap.charge = math.max(0, (x.snap.charge or 0) - cost)
					x.skillUses += 1
					entry.skillUsed = true
					entry.skillId = skill.id
					entry.kind = "skill"
				end
			end

			-- Ein normaler Stoss laedt die Faehigkeit auf.
			if entry.kind == "hit" and canCharge then
				local gain = SkillConfig.CHARGE.PER_HIT * (1 + pwr * SkillConfig.CHARGE.PWR_FACTOR)
				x.snap.charge = math.min(cost, (x.snap.charge or 0) + gain)
			end

			local dealt, absorbed, saved = dealDamage(y, dmg)
			entry.damage   = dealt
			entry.absorbed = absorbed
			if saved then
				table.insert(effects, "laststand")
				-- Die Letzte Chance IST der Skill des Getroffenen: zaehlt als Einsatz.
				y.skillUses += 1
			end

			if heal > 0 then
				local before = x.snap.hp
				x.snap.hp = math.min(x.snap.stats.maxHp, x.snap.hp + heal)
				entry.heal = x.snap.hp - before
			end

			if selfCost > 0 then
				-- Der Preis eines Buffs darf nie selbst toeten.
				x.snap.hp = math.max(1, x.snap.hp - selfCost)
			end
		end
	end

	-- Status des Handelnden laufen ab.
	x.shield = tickTimed(x.shield) :: any
	x.buff   = tickTimed(x.buff) :: any
	x.slow   = tickTimed(x.slow) :: any
	x.weaken = tickTimed(x.weaken) :: any

	x.nextAt += 1 / effSpd(x)

	entry.attackerHpAfter = a.snap.hp
	entry.defenderHpAfter = b.snap.hp
	-- Ladestand von A (0..1) fuer die Ladeleiste in der Arena.
	do
		local sk = SkillConfig.getById(a.snap.stats.skillId)
		local c = if sk then (sk.charge or 0) else 0
		entry.chargeA = if c > 0 then math.clamp((a.snap.charge or 0) / c, 0, 1) else 0
	end
	if #effects > 0 then entry.effects = effects end
	return entry
end

export type FullCombatResult = {
	winnerUid   : string,
	loserUid    : string,
	rounds      : number,           -- Aktionen des Baerchis (A)
	log         : { Types.RoundLogEntry },
	skillUses   : number,           -- wie oft A seinen Skill eingesetzt hat
	firstSkillRound : number?,      -- in welcher Runde (A-Aktion) zum ersten Mal
}

-- Schutz vor Endlos-Kaempfen (z.B. zwei Heiler). Bei Erreichen gewinnt, wer
-- mehr HP hat — dieselbe Regel wie vorher bei MAX_ROUNDS = 50.
local MAX_A_ACTIONS     = 50
local MAX_TOTAL_ACTIONS = 200

-- Simuliert einen vollstaendigen Kampf zwischen zwei Baerchis.
-- Gibt das Ergebnis zurueck — kein Side-Effect ausser auf den Snapshots
-- (hp/charge, wie bisher hp/skillCooldown).
--
-- `withLog = false` spart den Log (Massensimulationen in tools/sim).
function CombatCalculator.simulate(a: CombatSnapshot, b: CombatSnapshot, withLog: boolean?): FullCombatResult
	local log: { Types.RoundLogEntry } = {}
	local fa = newFighter(a, "A")
	local fb = newFighter(b, "B")
	local total = 0
	local firstSkill: number? = nil

	while a.hp > 0 and b.hp > 0 and fa.actions < MAX_A_ACTIONS and total < MAX_TOTAL_ACTIONS do
		total += 1
		local entry
		local usesBefore = fa.skillUses
		if fa.nextAt <= fb.nextAt then
			entry = act(fa, fb, fa.actions + 1, fa, fb)
		else
			entry = act(fb, fa, fa.actions, fa, fb)
		end
		if fa.skillUses > usesBefore and not firstSkill then
			firstSkill = math.max(1, fa.actions)
		end
		if withLog ~= false then
			table.insert(log, entry)
		end
	end

	local winnerUid, loserUid
	if a.hp >= b.hp then
		winnerUid, loserUid = a.uid, b.uid
	else
		winnerUid, loserUid = b.uid, a.uid
	end

	return {
		winnerUid = winnerUid,
		loserUid  = loserUid,
		rounds    = fa.actions,
		log       = log,
		skillUses = fa.skillUses,
		firstSkillRound = firstSkill,
	}
end

return CombatCalculator
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX29"><Properties>
<string name="Name">DayCycle</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- DayCycle.luau
-- ReplicatedStorage/Modules/DayCycle.luau
--
-- Einzige Zustaendigkeit:
--   - Tageszeit und Licht-Werte des Tageslaufs als REINE Funktion der
--     Serverzeit (Paket A, "Welt aufwerten")
--
-- Wie Modules/EventMotion: kein Zustand, keine Instanzen. Der Client
-- (DayCycleController) fragt mit workspace:GetServerTimeNow() und setzt das
-- Ergebnis; zwei Clients bekommen fuer dieselbe Serverzeit genau dieselben
-- Zahlen. Testbar ohne Roblox (tools/luau-tests/day_cycle.test.lua).

local Config = script.Parent.Parent.Config
local WorldFXConfig = require(Config.WorldFXConfig)

local DayCycle = {}

local TAU = math.pi * 2

export type Curve = { { any } }

-- Uhrzeit zur Serverzeit `now`: Kosinus-Pendel CLOCK_MIN → CLOCK_MAX → CLOCK_MIN.
-- Bei now = 0 (und jedem Vielfachen der Periode) steht sie auf CLOCK_MIN.
function DayCycle.clockAt(now: number): number
	local cfg = WorldFXConfig.DAY
	local phase = (now % cfg.PERIOD) / cfg.PERIOD
	local k = (1 - math.cos(TAU * phase)) * 0.5
	return cfg.CLOCK_MIN + (cfg.CLOCK_MAX - cfg.CLOCK_MIN) * k
end

-- "Daemmerung" 0..1 zu einer Uhrzeit (0 = goldener Nachmittag, 1 = blaue Stunde).
function DayCycle.duskOf(clock: number): number
	local cfg = WorldFXConfig.DAY
	return math.clamp((clock - cfg.CLOCK_MIN) / (cfg.CLOCK_MAX - cfg.CLOCK_MIN), 0, 1)
end

local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end

local function lerpValue(a: any, b: any, t: number): any
	if typeof(a) == "number" then
		return a + (b - a) * t
	end
	-- Color3 (die einzige andere Art in den Kurven)
	return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end

-- Wert einer Kurve bei `d`. Zwischen zwei Stuetzpunkten weich (smoothstep):
-- die Steigung ist an jedem Stuetzpunkt null, es gibt also keinen Knick.
function DayCycle.sample(curve: Curve, d: number): any
	local first = curve[1]
	if d <= first[1] then
		return first[2]
	end
	for i = 2, #curve do
		local b = curve[i]
		if d <= b[1] then
			local a = curve[i - 1]
			local span = b[1] - a[1]
			local t = if span > 0 then (d - a[1]) / span else 1
			return lerpValue(a[2], b[2], smooth(t))
		end
	end
	return curve[#curve][2]
end

-- Alle Kurven bei `d` in einer Tabelle (Schluessel wie WorldFXConfig.DAY_CURVES).
function DayCycle.valuesAt(d: number): { [string]: any }
	local out = {}
	for name, curve in WorldFXConfig.DAY_CURVES :: any do
		out[name] = DayCycle.sample(curve, d)
	end
	return out
end

-- Mischt zwei Wertetabellen (fuer den weichen Rueckweg nach einer Show).
function DayCycle.blend(a: { [string]: any }, b: { [string]: any }, t: number): { [string]: any }
	local out = {}
	for name, value in b do
		local from = a[name]
		out[name] = if from ~= nil then lerpValue(from, value, t) else value
	end
	return out
end

return DayCycle
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX30"><Properties>
<string name="Name">HoneyPondMode</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- HoneyPondMode.luau
-- ReplicatedStorage/Modules/HoneyPondMode.luau
--
-- Einzige Zustaendigkeit:
--   - Die Honig-Gebaeude einer Insel auf den richtigen Modus bringen
--     (FeatureFlags.HONEY_POND_V2): EIN Honig-Teich ("HoneyPond") statt
--     Bienenstock + Veredler — und zurueck. Rein, ohne Roblox-Dienste:
--     tools/luau-tests/honey_pond.test.lua.
--
-- NICHTS GEHT VERLOREN: was gerade nicht gilt, liegt in
-- island.retiredBuildings und kommt beim Zurueckschalten unveraendert wieder.
--
-- Beim ERSTEN Wechsel auf den Teich startet er auf dem hoechsten Level der
-- alten Gebaeude und bekommt deren Honig (der Aufrufer deckelt ihn auf das
-- Lager). Ein Teich auf Level L leistet genau so viel wie Stock UND Veredler
-- auf Level L (siehe BuildingBehavior) — niemand faellt zurueck.
--
-- Aufrufer: Types.createDefaultPlayerData (neue Spieler, Rebirth) und
-- PlayerMigration.applyDefaults (jeder Join) — dort VOR dem Aufraeumen
-- unbekannter Gebaeude-Ids, sonst waeren die alten schon weg.
--
-- Bewusst ohne Types (any): Types ruft dieses Modul selbst auf.

local HoneyPondMode = {}

HoneyPondMode.POND = "HoneyPond"
HoneyPondMode.CLASSIC = { "Beehive", "HoneyRefiner" }

local function newBuilding(id: string, now: number): any
	return { id = id, level = 1, honey = 0, lastProducedAt = now }
end

-- Bringt `island` in den Modus `pondOn`. Idempotent: ein zweiter Aufruf
-- aendert nichts mehr. Gibt die Insel zurueck.
function HoneyPondMode.apply(island: any, pondOn: boolean, now: number): any
	local buildings = island.buildings
	if buildings == nil then
		buildings = {}
		island.buildings = buildings
	end
	local retired = island.retiredBuildings or {}

	local active: { string } = if pondOn then { HoneyPondMode.POND } else HoneyPondMode.CLASSIC
	local inactive: { string } = if pondOn then HoneyPondMode.CLASSIC else { HoneyPondMode.POND }

	-- 1. Was jetzt gilt und im Ruhestand liegt, kommt zurueck. Der Ruhestand
	--    gewinnt: ein Gebaeude gleichen Namens in `buildings` kann nur ein
	--    frisch angelegter Standardwert sein (im Ruhestand wird nicht gespielt).
	for _, id in active do
		if retired[id] ~= nil then
			buildings[id] = retired[id]
			retired[id] = nil
		elseif buildings[id] == nil then
			buildings[id] = newBuilding(id, now)
		end
	end

	-- 2. Erster Wechsel auf den Teich: alte Gebaeude stehen noch aktiv da.
	if pondOn then
		local pond = buildings[HoneyPondMode.POND]
		for _, id in HoneyPondMode.CLASSIC do
			local old = buildings[id]
			if old ~= nil then
				pond.level = math.max(pond.level or 1, old.level or 1)
				pond.honey = (pond.honey or 0) + math.max(0, old.honey or 0)
			end
		end
	end

	-- 3. Was nicht gilt, geht in den Ruhestand (ein vorhandener Eintrag dort
	--    bleibt — siehe 1.).
	for _, id in inactive do
		local building = buildings[id]
		if building ~= nil then
			if retired[id] == nil then
				retired[id] = building
			end
			buildings[id] = nil
		end
	end

	island.retiredBuildings = if next(retired) ~= nil then retired else nil
	return island
end

return HoneyPondMode
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX31"><Properties>
<string name="Name">IslandStage</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- IslandStage.luau
-- ReplicatedStorage/Modules/IslandStage.luau
--
-- Einzige Zustaendigkeit:
--   - Aus dem Fortschritt eines Spielers die Stufe seiner Insel-Deko
--     berechnen (Paket D, "Welt aufwerten"): 1 = Start, 2 = Blumen,
--     3 = + Pilze, 4 = + Bienenhaus und leuchtender Bernstein-Stein
--
-- Reine Rechnung, keine Instanzen. Der Server (PlotDisplayService) schreibt
-- das Ergebnis als Attribut "IslandStage" an das Plot-Model, der Client
-- (PlotLifeController) baut daraus die Deko. Grundlage ist dasselbe, was
-- PlotDisplayService schon fuer den Tower-Turm kennt (Tower-Rekorde), dazu
-- die Rebirth-Zahl — es zaehlt, was weiter ist.

local Config = script.Parent.Parent.Config
local TowerConfig   = require(Config.TowerConfig)
local WorldFXConfig = require(Config.WorldFXConfig)

local IslandStage = {}

IslandStage.MAX = 4

-- Wie viele Tower (I, II, III, …) vollstaendig geschafft sind.
function IslandStage.towersCleared(records: { [string]: number }?): number
	local cleared = 0
	for _, def in TowerConfig.TOWERS do
		if def.id ~= "Endless" then
			local record = if records then records[def.id] or 0 else 0
			if record >= def.stages then
				cleared += 1
			else
				break   -- Tower bauen aufeinander auf
			end
		end
	end
	return cleared
end

-- Stufe 1..MAX aus Tower-Rekorden und Rebirth-Zahl.
function IslandStage.compute(records: { [string]: number }?, rebirths: number): number
	local cfg = WorldFXConfig.ISLAND_STAGE
	local stage = 1
	local cleared = IslandStage.towersCleared(records)
	for s = 2, IslandStage.MAX do
		if cleared >= cfg.TOWERS_FOR[s] or rebirths >= cfg.REBIRTHS_FOR[s] then
			stage = s
		end
	end
	return stage
end

return IslandStage
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX32"><Properties>
<string name="Name">LiveBoardText</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- LiveBoardText.luau
-- ReplicatedStorage/Modules/LiveBoardText.luau
--
-- Einzige Zustaendigkeit:
--   - Aus den laufenden Tower-Laeufen den Inhalt des Live-Kampf-Boards machen
--     (HBB Paket 6). Rein, ohne Roblox-Dienste: tools/luau-tests/live_board.test.lua.
--
-- Sprachneutral (HBB Paket 1: Icons und Zahlen statt Text): die Tafel steht
-- in der Welt und wird von Spielern aller Sprachen gelesen.
--   Titel:  "⚔ LIVE · 3"            (ohne Kampf: "⚔ LIVE")
--   Zeile:  "⚔  Name   III · 14"   kaempft gerade in Tower III, Stage 14
--           "➡  Name   III"        laeuft zur Arena
-- Laeufe auf dem Rueckweg sind fertig und stehen nicht mehr da.
-- Reihenfolge: wer kaempft vor wer hinlaeuft, dann hoeherer Tower, dann
-- hoehere Stage — oben steht der spannendste Kampf.

local TowerConfig = require(script.Parent.Parent.Config.TowerConfig)

local LiveBoardText = {}

export type LiveRun = {
	name    : string,
	towerId : string?,
	stage   : number?,
	phase   : string,    -- "ToPit" | "InPit" | "Returning" (PitArenaService)
}

local function numeral(towerId: string?): string
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	return def.numeral
end

local function towerIndex(towerId: string?): number
	local def = TowerConfig.get(towerId or "")
	return if def then def.index else 0
end

-- Gibt Titel, Zeilen (hoechstens maxLines) und "laeuft etwas?" zurueck.
function LiveBoardText.build(runs: { LiveRun }, maxLines: number): (string, { string }, boolean)
	local shown: { LiveRun } = {}
	for _, run in runs do
		if run.phase == "InPit" or run.phase == "ToPit" then
			table.insert(shown, run)
		end
	end

	table.sort(shown, function(a, b)
		if a.phase ~= b.phase then return a.phase == "InPit" end
		local ta, tb = towerIndex(a.towerId), towerIndex(b.towerId)
		if ta ~= tb then return ta > tb end
		if (a.stage or 0) ~= (b.stage or 0) then return (a.stage or 0) > (b.stage or 0) end
		return a.name < b.name
	end)

	local lines: { string } = {}
	for i = 1, math.min(#shown, maxLines) do
		local run = shown[i]
		if run.phase == "InPit" and run.stage then
			table.insert(lines, string.format("⚔  %s   %s · %d", run.name, numeral(run.towerId), run.stage))
		else
			table.insert(lines, string.format("➡  %s   %s", run.name, numeral(run.towerId)))
		end
	end

	local title = if #shown > 0 then string.format("⚔ LIVE · %d", #shown) else "⚔ LIVE"
	return title, lines, #shown > 0
end

return LiveBoardText
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX33"><Properties>
<string name="Name">MapLayout</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- MapLayout.luau
-- ReplicatedStorage/Modules/MapLayout.luau
--
-- Einzige Zustaendigkeit:
--   - WO die festen Wahrzeichen der Welt stehen (HBB Paket 5/6): Bestenlisten-
--     Tafeln, Live-Kampf-Board, Schau-Tuerme, Wespen-Nest, Ei-Haendler.
--     Reine Rechnung aus MapConfig/EggConfig, baut nichts.
--
-- Warum ein eigenes Modul: Dieselben Positionen brauchen drei Stellen — die
-- Builder (bauen), ScenicBuilder (haelt Baeume/Buesche fern) und der Test
-- tools/luau-tests/map_layout.test.lua (prueft Abstaende zu Stegen, Laternen
-- und untereinander). Stuende die Formel dreimal da, liefe sie auseinander.
--
-- Winkel wie MapParts.buildPlotCFrame: Slot 1 liegt bei 0 Grad (+X), jeder
-- weitere 360/PLOT_COUNT Grad weiter Richtung +Z. Zwischen zwei Stegen liegt
-- eine "Luecke" bei 22,5 + k x 45 Grad.

local Config = script.Parent.Parent.Config
local MapConfig    = require(Config.MapConfig)
local EggConfig    = require(Config.EggConfig)
local FeatureFlags = require(Config.FeatureFlags)

local MapLayout = {}

-- Ein Wahrzeichen als Kreis auf der Wiese (fuer Abstandspruefungen).
export type Landmark = { name: string, x: number, z: number, r: number }

--------------------------------------------------------------------------------
-- Richtungen
--------------------------------------------------------------------------------

function MapLayout.slotAngle(slot: number): number
	return math.rad((slot - 1) * (360 / MapConfig.PLOT_COUNT))
end

-- Einheitsvektor von der Weltmitte zum Plot `slot` (= Richtung seines Stegs).
function MapLayout.outward(slot: number): Vector3
	local angle = MapLayout.slotAngle(slot)
	return Vector3.new(math.cos(angle), 0, math.sin(angle))
end

-- Quer zum Steg, zum naechsten Slot hin (wie die Laternen in ScenicBuilder).
function MapLayout.side(slot: number): Vector3
	local o = MapLayout.outward(slot)
	return Vector3.new(-o.Z, 0, o.X)
end

-- Punkt auf der Wiese bei `angleDegrees` und `radius` (Hoehe PLATFORM_TOP_Y).
function MapLayout.atAngle(angleDegrees: number, radius: number): Vector3
	local angle = math.rad(angleDegrees)
	return Vector3.new(
		MapConfig.CENTER.X + radius * math.cos(angle),
		MapConfig.PLATFORM_TOP_Y,
		MapConfig.CENTER.Z + radius * math.sin(angle)
	)
end

--------------------------------------------------------------------------------
-- Honig-Teich und Baerchi-Platz auf dem Plot (plot-lokal, siehe MapConfig-Kopf)
--------------------------------------------------------------------------------
-- HONEY_POND_V2: der Teich steht dort, wo das Gebaeude HoneyPond steht (Mitte
-- des hinteren Plot-Teils), sein Standplatz zeigt nach +Z (ins Plot hinein),
-- und der Baerchi WOHNT auf diesem Standplatz — er frisst ohne hinzulaufen.
-- Ohne Schalter: alter Teich (POND_OFFSET) und alter Baerchi-Platz.

local function pondV2(): boolean
	return FeatureFlags.isOn("HONEY_POND_V2")
end

function MapLayout.pondOffset(): Vector3
	return if pondV2() then MapConfig.BUILDING_OFFSETS.HoneyPond.offset else MapConfig.POND_OFFSET
end

-- Richtung (plot-lokal, waagerecht, Einheitsvektor) vom Teich zum Standplatz.
function MapLayout.pondFacing(): Vector3
	if pondV2() then
		return Vector3.new(0, 0, 1)
	end
	local toHome = MapConfig.BAERCHI_HOME_OFFSET - MapConfig.POND_OFFSET
	local flat = Vector3.new(toHome.X, 0, toHome.Z)
	return if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, 1)
end

-- Abstand Teich-Mitte -> Standplatz (Beckenrand + Luecke).
function MapLayout.pondStandDistance(): number
	return MapConfig.POND_RADIUS + MapConfig.POND_STAND_GAP
end

-- Wo der ausgeruestete Baerchi steht, wenn er nichts tut.
function MapLayout.baerchiHomeOffset(): Vector3
	if pondV2() then
		return MapLayout.pondOffset() + MapLayout.pondFacing() * MapLayout.pondStandDistance()
	end
	return MapConfig.BAERCHI_HOME_OFFSET
end

--------------------------------------------------------------------------------
-- Wahrzeichen
--------------------------------------------------------------------------------

-- Fuss des Schau-Turms von `slot` (Mitte, PLATFORM_TOP_Y).
-- MAP_V2_SHOWCASE: am Brueckenkopf auf der Hauptinsel; sonst wie v15 aussen
-- an der Arena-Insel (gleiche Formel wie MapParts.pitCenter + distance).
function MapLayout.showcaseFoot(slot: number): Vector3
	local cfg = MapConfig.TOWER_SHOWCASE
	local outward = MapLayout.outward(slot)
	local flat: Vector3
	if FeatureFlags.isOn("MAP_V2_SHOWCASE") then
		flat = MapConfig.CENTER + outward * cfg.bridgeheadAlong + MapLayout.side(slot) * cfg.bridgeheadAcross
	else
		local pitRadius = MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS
			+ MapConfig.ISLAND_GAP + MapConfig.PIT_BASE_RADIUS
		flat = MapConfig.CENTER + outward * (pitRadius + cfg.distance)
	end
	return Vector3.new(flat.X, MapConfig.PLATFORM_TOP_Y, flat.Z)
end

-- Die Bestenlisten-Tafeln: je Tafel Liste (nil = wechselnd, alter Weg) und Winkel.
function MapLayout.leaderboardBoards(): { { listId: string?, angleDegrees: number } }
	if FeatureFlags.isOn("MAP_V2_BOARDS") then
		local boards = {}
		for _, b in MapConfig.LEADERBOARD_BOARDS_V2 do
			if b.flag == nil or FeatureFlags.isOn(b.flag) then
				table.insert(boards, { listId = b.listId :: string?, angleDegrees = b.angleDegrees })
			end
		end
		return boards
	end
	return { { listId = nil, angleDegrees = MapConfig.LEADERBOARD_BOARD.angleDegrees } }
end

-- Mitte des Wespen-Nests (Weltkoordinaten).
function MapLayout.waspNestCenter(): Vector3
	return MapConfig.CENTER + Vector3.new(0, MapConfig.PLATFORM_TOP_Y, 0) + MapConfig.WASP_NEST.offset
end

-- Alle Wahrzeichen auf der Wiese der Hauptinsel, die gerade gebaut werden.
-- `r` = Radius des Kreises, der den Grundriss sicher umschliesst.
function MapLayout.landmarks(): { Landmark }
	local list: { Landmark } = {}
	local function add(name: string, p: Vector3, r: number)
		table.insert(list, { name = name, x = p.X, z = p.Z, r = r })
	end

	local board = MapConfig.LEADERBOARD_BOARD
	for i, b in MapLayout.leaderboardBoards() do
		add("Bestenliste" .. i, MapLayout.atAngle(b.angleDegrees, board.radius), board.size.X * 0.5 + 0.5)
	end

	if FeatureFlags.isOn("MAP_V2_LIVE_BOARD") then
		local live = MapConfig.LIVE_BOARD
		add("LiveBoard", MapLayout.atAngle(live.angleDegrees, live.radius), live.size.X * 0.5 + 0.5)
	end

	if FeatureFlags.isOn("MAP_V2_MERCHANT") then
		local m = EggConfig.MERCHANT_V2
		add("Haendler", MapLayout.atAngle(m.angleDegrees, m.radius), 6)
	end

	if FeatureFlags.isOn("MAP_V2_SHOWCASE") then
		-- Sockel: Turmradius + 1,2 (ArenaBuilder.buildShowcase), Dach bis 5
		local r = math.max(MapConfig.TOWER_SHOWCASE.radius + 1.2, 5) + 0.5
		for slot = 1, MapConfig.PLOT_COUNT do
			add("SchauTurm" .. slot, MapLayout.showcaseFoot(slot), r)
		end
	end

	return list
end

--------------------------------------------------------------------------------
-- Welt aufwerten (08.10.2026): Inselmitten, offenes Wasser, Wegweiser, Bojen
--------------------------------------------------------------------------------
-- Gebraucht von den Client-Controllern (Water/Hub/DayCycle) und von
-- map_layout.test.lua. Gleiche Formeln wie MapParts (Server), hier ohne
-- Server-Abhaengigkeit.

-- Mitte der Plot-Insel `slot` (PLATFORM_TOP_Y).
function MapLayout.plotCenter(slot: number): Vector3
	local flat = MapConfig.CENTER + MapLayout.outward(slot) * MapConfig.PLOT_RING_RADIUS
	return Vector3.new(flat.X, MapConfig.PLATFORM_TOP_Y, flat.Z)
end

-- Abstand der Arena-Mitte zur Weltmitte (wie MapParts.pitCenter).
function MapLayout.pitRadius(): number
	return MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS
		+ MapConfig.ISLAND_GAP + MapConfig.PIT_BASE_RADIUS
end

-- Mitte der Arena-Insel `slot` (PLATFORM_TOP_Y).
function MapLayout.pitCenter(slot: number): Vector3
	local flat = MapConfig.CENTER + MapLayout.outward(slot) * MapLayout.pitRadius()
	return Vector3.new(flat.X, MapConfig.PLATFORM_TOP_Y, flat.Z)
end

-- Liegt (x, z) auf offenem Wasser, mit `margin` Studs Abstand zu jeder
-- Sandkante und jedem Steg? Arena-Inseln und aeussere Stege zaehlen immer als
-- Land (es koennte ein Spieler kommen). Fuer Fisch und Gluehwuermchen.
function MapLayout.isOpenWater(x: number, z: number, margin: number): boolean
	local dx, dz = x - MapConfig.CENTER.X, z - MapConfig.CENTER.Z
	local r = math.sqrt(dx * dx + dz * dz)
	if r > MapConfig.WATER_RADIUS - margin then
		return false
	end
	local shore = MapConfig.SHORE_WIDTH + margin
	if r < MapConfig.PLATFORM_RADIUS + shore then
		return false
	end
	local laneHalf = MapConfig.BRIDGE_WIDTH * 0.5 + margin
	local pitR = MapLayout.pitRadius()
	for slot = 1, MapConfig.PLOT_COUNT do
		local o = MapLayout.outward(slot)
		local along = dx * o.X + dz * o.Z
		local across = math.abs(dx * o.Z - dz * o.X)
		if along > 0 and along < pitR and across <= laneHalf then
			return false
		end
		local plot = MapLayout.plotCenter(slot)
		if math.sqrt((x - plot.X) ^ 2 + (z - plot.Z) ^ 2) < MapConfig.PLOT_ISLAND_RADIUS + shore then
			return false
		end
		local pit = MapLayout.pitCenter(slot)
		if math.sqrt((x - pit.X) ^ 2 + (z - pit.Z) ^ 2) < MapConfig.PIT_BASE_RADIUS + shore then
			return false
		end
	end
	return true
end

-- Wegweiser: einer je Steg, neben dem Pflasterweg, wo er am Event-Pit
-- beginnt. `facing` = Richtung nach aussen (zum Plot).
function MapLayout.signposts(radius: number, sideOffset: number): { { slot: number, position: Vector3, outward: Vector3 } }
	local list = {}
	for slot = 1, MapConfig.PLOT_COUNT do
		local o = MapLayout.outward(slot)
		local flat = MapConfig.CENTER + o * radius + MapLayout.side(slot) * sideOffset
		table.insert(list, { slot = slot, position = Vector3.new(flat.X, MapConfig.PLATFORM_TOP_Y, flat.Z), outward = o })
	end
	return list
end

-- Bojen: je eine in der Luecke zwischen zwei Stegen, weit draussen.
function MapLayout.buoys(radius: number): { Vector3 }
	local list = {}
	for slot = 1, MapConfig.PLOT_COUNT do
		local angle = (slot - 1) * (360 / MapConfig.PLOT_COUNT) + 180 / MapConfig.PLOT_COUNT
		local p = MapLayout.atAngle(angle, radius)
		table.insert(list, Vector3.new(p.X, MapConfig.PLATFORM_TOP_Y - MapConfig.WATER_DROP, p.Z))
	end
	return list
end

-- Paket D: Punkt am Rand der Plot-Insel `slot`. `angleDegrees` plot-lokal:
-- 0 = nach aussen (Arena-Steg), 90 = zur Seite (side), 180 = zur Hauptinsel.
-- Zweiter Wert: Richtung von dort zur Inselmitte (fuer die Ausrichtung der Deko).
function MapLayout.islandRimPoint(slot: number, angleDegrees: number, radius: number): (Vector3, Vector3)
	local a = math.rad(angleDegrees)
	local dir = MapLayout.outward(slot) * math.cos(a) + MapLayout.side(slot) * math.sin(a)
	local center = MapLayout.plotCenter(slot)
	return center + dir * radius, -dir
end

return MapLayout
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX34"><Properties>
<string name="Name">ShopRules</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- ShopRules.luau
-- ReplicatedStorage/Modules/ShopRules.luau
--
-- Einzige Zustaendigkeit:
--   - Die Regeln des Shops (HBB Paket 10) als reine Funktionen auf dem
--     Shop-Teil des Spielstands: Gratis-Griff pro UTC-Tag und das Merken von
--     Robux-Kaeufen (jeder Kauf zahlt genau einmal aus).
--     Test: tools/luau-tests/shop.test.lua. ShopService ruft nur diese auf.
--
-- Bewusst ohne Roblox-Dienste und ohne Types (Shop-Teil als any), damit der
-- Test ohne Attrappe laeuft.

local ShopRules = {}

local SECONDS_PER_DAY = 86400

function ShopRules.dayOf(unixTime: number): number
	return math.floor(unixTime / SECONDS_PER_DAY)
end

function ShopRules.secondsUntilNextDay(unixTime: number): number
	return SECONDS_PER_DAY - (unixTime % SECONDS_PER_DAY)
end

-- Neuer, leerer Shop-Teil fuer den Spielstand.
function ShopRules.newState(): any
	return { freeGrabDay = -1, receipts = {} }
end

function ShopRules.freeReady(shop: any, now: number): boolean
	return shop.freeGrabDay ~= ShopRules.dayOf(now)
end

-- Gratis-Griff nehmen. false = heute schon genommen (nichts geaendert).
function ShopRules.claimFree(shop: any, now: number): boolean
	if not ShopRules.freeReady(shop, now) then return false end
	shop.freeGrabDay = ShopRules.dayOf(now)
	return true
end

function ShopRules.hasReceipt(shop: any, purchaseId: string): boolean
	return table.find(shop.receipts, purchaseId) ~= nil
end

-- Kauf merken. false = schon bekannt (nicht noch einmal auszahlen).
-- Haelt die Liste auf `maxReceipts` (aelteste fliegen raus).
function ShopRules.recordPurchase(shop: any, purchaseId: string, maxReceipts: number): boolean
	if ShopRules.hasReceipt(shop, purchaseId) then return false end
	table.insert(shop.receipts, purchaseId)
	while #shop.receipts > maxReceipts do
		table.remove(shop.receipts, 1)
	end
	return true
end

-- Kauf wieder vergessen (Speichern ist gescheitert: Roblox meldet den Kauf
-- spaeter erneut, dann soll er normal ausgezahlt werden).
function ShopRules.forgetPurchase(shop: any, purchaseId: string)
	local index = table.find(shop.receipts, purchaseId)
	if index then table.remove(shop.receipts, index) end
end

return ShopRules
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX35"><Properties>
<string name="Name">SoundZones</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- SoundZones.luau
-- ReplicatedStorage/Modules/SoundZones.luau
--
-- Einzige Zustaendigkeit:
--   - Wie laut jede Klang-Zone an einer Kamera-Position sein soll (Paket H,
--     "Welt aufwerten"), als REINE Funktion: Ufer, Wiese/Grillen, Honigmast,
--     Event-Pit, Wind an der Arena und in der Hoehe
--
-- Jedes Gewicht ist stetig in der Position (keine harten Kanten): wer ueber
-- die Map laeuft, hoert weiche Uebergaenge. `audible` waehlt die lautesten
-- MAX_AUDIBLE aus, der Rest bekommt 0. Testbar: sound_zones.test.lua.

local Config = script.Parent.Parent.Config
local MapConfig     = require(Config.MapConfig)
local WorldFXConfig = require(Config.WorldFXConfig)
local MapLayout     = require(script.Parent.MapLayout)

local SoundZones = {}

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

local function flatDist(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Naechste Insel: (Abstand zur Mitte, Kuestenradius). Hauptinsel, alle
-- Plot-Inseln, alle Arena-Inseln (die festen Formeln, besetzt oder nicht).
local function nearestIsland(p: Vector3): (number, number)
	local shore = MapConfig.SHORE_WIDTH
	local bestGap, bestD, bestR = math.huge, 0, 0
	local function consider(center: Vector3, radius: number)
		local d = flatDist(p, center)
		local gap = d - (radius + shore)
		if gap < bestGap then
			bestGap, bestD, bestR = gap, d, radius + shore
		end
	end
	consider(MapConfig.CENTER, MapConfig.PLATFORM_RADIUS)
	for slot = 1, MapConfig.PLOT_COUNT do
		consider(MapLayout.plotCenter(slot), MapConfig.PLOT_ISLAND_RADIUS)
		consider(MapLayout.pitCenter(slot), MapConfig.PIT_BASE_RADIUS)
	end
	return bestD, bestR
end

-- Gewichte 0..1 je Klang. `dusk` 0..1 (Tageslauf), `eventLive` = Event laeuft.
function SoundZones.weights(p: Vector3, dusk: number, eventLive: boolean): { [string]: number }
	local cfg = WorldFXConfig.SOUNDSCAPE
	local d, coast = nearestIsland(p)
	local band = cfg.SHORE_BAND

	-- Ufer: an der Kueste voll, auf dem Wasser voll, ins Land hinein leiser
	local waves = if d >= coast then 1 else clamp01(1 - (coast - d) / band)
	-- Wiese: im Inselinneren voll, zur Kueste hin leiser
	local land = if d >= coast then 0 else clamp01((coast - d) / (band * 0.66))
	local night = clamp01((dusk - (cfg.NIGHT_FROM - 0.1)) / 0.2)
	night = night * night * (3 - 2 * night)

	local mastD = flatDist(p, MapConfig.CENTER)
	local drip = clamp01(1 - mastD / cfg.MAST_RADIUS)
	local crowd = if eventLive then clamp01(1 - mastD / cfg.PIT_RADIUS) else 0

	local arena = 0
	for slot = 1, MapConfig.PLOT_COUNT do
		arena = math.max(arena, clamp01(1 - flatDist(p, MapLayout.pitCenter(slot)) / cfg.ARENA_RADIUS))
	end
	local high = clamp01((p.Y - MapConfig.PLATFORM_TOP_Y - cfg.HIGH_FROM) / 60)
	local wind = clamp01(arena * 0.6 + high * 0.7)

	return {
		waves    = waves,
		meadow   = land * (1 - night),
		crickets = land * night,
		drip     = drip,
		crowd    = crowd,
		wind     = wind,
	}
end

-- Hoechstens MAX_AUDIBLE Klaenge mit Gewicht ueber MIN_WEIGHT, der Rest 0.
function SoundZones.audible(weights: { [string]: number }): { [string]: number }
	local cfg = WorldFXConfig.SOUNDSCAPE
	local names = {}
	for name, w in weights do
		if w > cfg.MIN_WEIGHT then table.insert(names, name) end
	end
	table.sort(names, function(a, b)
		if weights[a] == weights[b] then return a < b end
		return weights[a] > weights[b]
	end)
	local out = {}
	for name in weights do out[name] = 0 end
	for i = 1, math.min(cfg.MAX_AUDIBLE, #names) do
		out[names[i]] = weights[names[i]]
	end
	return out
end

return SoundZones
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX36"><Properties>
<string name="Name">UnlockRules</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- UnlockRules.luau
-- ReplicatedStorage/Modules/UnlockRules.luau
--
-- Einzige Zustaendigkeit:
--   - Aus dem Spielstand ableiten, welche Bedienelemente ein Spieler schon
--     sieht (reine Funktion, keine Roblox-Dienste)
--
-- Kontext: HBB Paket 3 (progressive Freischaltung). Die erste Sitzung zeigt
-- eine Waehrung, zwei Kacheln (Eier, Baerchis) und den Fight-Knopf; alles
-- andere kommt, wenn der Spieler es braucht.
--
-- Die Freischaltung ist REIN KOSMETISCH. Der Server sperrt nichts; wer ein
-- Panel auf anderem Weg erreicht, darf es benutzen. Kein Spielstand-Wert
-- haengt an dieser Tabelle.
--
-- Jede Regel ist MONOTON: einmal frei, immer frei. Wo die Datenquelle das
-- nicht ist (Waehrung, Anzahl Baerchis), steht ein monotoner Ersatz (Zaehler
-- in stats) — und zusaetzlich gilt ein Element als frei, sobald es in
-- `uiSeen` steht (Latch, gesetzt von UiStateService).
--
-- Keine requires: laeuft unveraendert im Luau-Test
-- (tools/luau-tests/unlock_rules.test.lua).

export type View = {
	rebirthCount : number,
	goldGummies  : number,
	island : {
		baerchis      : { [string]: any },
		towerProgress : { [string]: number }?,
	},
	towers     : { records: { [string]: number } }?,
	discovered : { [string]: boolean }?,
	eggTree    : { unlocked: { [string]: boolean } }?,
	stats      : { [string]: number }?,
	uiSeen     : { [string]: boolean }?,
}

local UnlockRules = {}

-- Alle Element-IDs. Zugleich die Whitelist fuer RequestMarkUiSeen.
UnlockRules.ELEMENTS = {
	"pill_gummies", "tile_eggs", "tile_bears", "button_fight",
	"button_event", "tile_leaderboard", "tile_daily", "pill_gold",
	"tile_tree", "tab_upgrade", "charms", "recycling",
	"pill_rank", "pill_rebirth", "index", "tile_shop",
}

-- Schwellen (Default-Annahmen aus dem Plan, im Bericht benannt)
UnlockRules.TREE_HATCHED       = 10
UnlockRules.UPGRADE_HATCHED    = 2
UnlockRules.CHARMS_TOWER_I     = 15
UnlockRules.RECYCLE_HATCHED    = 21   -- "mehr als 20 Baerchis" (monotoner Ersatz)
UnlockRules.INDEX_DISCOVERED   = 3
-- Paket 10: Shop ab der zweiten Sitzung (stats.sessions, PlayerService zaehlt).
-- SHOP_ENABLED spiegelt FeatureFlags.SHOP_V1: dieses Modul hat bewusst keine
-- requires (laeuft im reinen Luau-Test), deshalb setzen ShopService (Server)
-- und ShopPanel (Client) den Wert beim Start.
UnlockRules.SHOP_ENABLED       = false
UnlockRules.SHOP_SESSIONS      = 2

local ALWAYS: { [string]: boolean } = {
	pill_gummies = true, tile_eggs = true, tile_bears = true, button_fight = true,
}
UnlockRules.ALWAYS = ALWAYS

local function count(map: { [any]: any }?): number
	local n = 0
	if map then
		for _ in map do n += 1 end
	end
	return n
end

local function stat(view: View, key: string): number
	local stats = view.stats
	return if stats then (stats[key] or 0) else 0
end

-- Erster beendeter Kampf: Rekord in irgendeinem Tower, gespeicherter
-- letzter Lauf, oder ein Kampf-Zaehler.
function UnlockRules.hasFought(view: View): boolean
	local towers = view.towers
	if towers and next(towers.records) ~= nil then return true end
	local progress = view.island.towerProgress
	if progress and next(progress) ~= nil then return true end
	return stat(view, "totalFightsWon") + stat(view, "totalFightsLost") > 0
end

-- Bedingung ohne Latch
local function condition(view: View, id: string): boolean
	if ALWAYS[id] then return true end
	local fought = UnlockRules.hasFought(view)
	local hatched = stat(view, "totalHatched")
	local rebirths = view.rebirthCount or 0

	if id == "button_event" or id == "tile_leaderboard" or id == "tile_daily" then
		return fought or rebirths > 0
	elseif id == "pill_gold" then
		return (view.goldGummies or 0) > 0
	elseif id == "tile_tree" then
		-- Start-Knoten sind BasicEgg und SugarEgg; mehr = erstes EggTreeUnlocked
		local unlocked = if view.eggTree then count(view.eggTree.unlocked) else 0
		return hatched >= UnlockRules.TREE_HATCHED or unlocked > 2 or rebirths > 0
	elseif id == "tab_upgrade" then
		return hatched >= UnlockRules.UPGRADE_HATCHED or rebirths > 0
	elseif id == "charms" then
		local towers = view.towers
		local recordI = if towers then (towers.records.I or 0) else 0
		return rebirths >= 1 or recordI >= UnlockRules.CHARMS_TOWER_I
	elseif id == "recycling" then
		return hatched >= UnlockRules.RECYCLE_HATCHED or rebirths > 0
	elseif id == "pill_rank" or id == "pill_rebirth" then
		return rebirths >= 1
	elseif id == "index" then
		return count(view.discovered) >= UnlockRules.INDEX_DISCOVERED
	elseif id == "tile_shop" then
		local stats = view.stats
		local sessions = if stats then (stats.sessions or 0) else 0
		return UnlockRules.SHOP_ENABLED and sessions >= UnlockRules.SHOP_SESSIONS
	end
	return false
end

function UnlockRules.isVisible(view: View, id: string): boolean
	local seen = view.uiSeen
	if seen and seen[id] then return true end
	return condition(view, id)
end

-- { [elementId] = sichtbar }
function UnlockRules.visible(view: View): { [string]: boolean }
	local result: { [string]: boolean } = {}
	for _, id in UnlockRules.ELEMENTS do
		result[id] = UnlockRules.isVisible(view, id)
	end
	return result
end

-- Hat der Spielstand schon Fortschritt? (Veteranen bekommen beim ersten
-- Laden alles Sichtbare als "gesehen", damit keine Badge-Flut entsteht.)
function UnlockRules.hasProgress(view: View): boolean
	return stat(view, "totalHatched") > 0 or (view.rebirthCount or 0) > 0 or UnlockRules.hasFought(view)
end

return UnlockRules
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX37"><Properties>
<string name="Name">WorldMoments</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldMoments.luau
-- ReplicatedStorage/Modules/WorldMoments.luau
--
-- Einzige Zustaendigkeit:
--   - Grosse Momente eines Spielers aus seinem Spielstand ERKENNEN und ihre
--     Anzeige DROSSELN (Paket G, "Welt aufwerten") — als reine Rechnung
--
-- Server (WorldMomentService): `snapshot` merkt sich das Noetigste, `diff`
-- vergleicht mit dem neuen Stand und liefert die Momente, `throttle`
-- entscheidet gross/klein je Spieler (hoechstens ein grosser pro 30 s).
-- Client (WorldMomentController): `Queue` zeigt hoechstens EINEN grossen
-- Moment gleichzeitig, weitere warten kurz (Zahlen in WorldFXConfig.MOMENTS).
-- Ohne Instanzen, testbar: tools/luau-tests/world_moments.test.lua.

local Config = script.Parent.Parent.Config
local WorldFXConfig = require(Config.WorldFXConfig)
local BaerchiConfig = require(Config.BaerchiConfig)
local TowerConfig   = require(Config.TowerConfig)

local WorldMoments = {}

export type Kind = "hatch" | "tower" | "record" | "rebirth" | "mutation"
export type Moment = { kind: Kind, value: string, number: number? }
export type Snapshot = {
	baerchis: { [string]: { rarity: string, mutation: string? } },
	highest: string,
	records: { [string]: number },
	rebirths: number,
}

local function rarityIndex(rarity: string): number
	for i, r in BaerchiConfig.RARITY_ORDER do
		if r == rarity then return i end
	end
	return 0
end
WorldMoments.rarityIndex = rarityIndex

-- Das Noetigste aus dem Spielstand (keine Referenzen auf die Daten selbst).
function WorldMoments.snapshot(data: any): Snapshot
	local baerchis = {}
	for uid, b in (data.island and data.island.baerchis) or {} do
		baerchis[uid] = { rarity = b.rarity, mutation = b.mutation }
	end
	local records = {}
	local towers = data.towers or {}
	for id, n in towers.records or {} do
		records[id] = n
	end
	return {
		baerchis = baerchis,
		highest = towers.highestTower or "I",
		records = records,
		rebirths = data.rebirthCount or 0,
	}
end

-- Was ist zwischen `before` und `after` Grosses passiert?
function WorldMoments.diff(before: Snapshot, after: Snapshot): { Moment }
	local cfg = WorldFXConfig.MOMENTS
	local out: { Moment } = {}

	-- Neuer Baerchi ab Mythic (Schluepfen; auch Fusion) — der seltenste zaehlt
	local best: string? = nil
	for uid, b in after.baerchis do
		if not before.baerchis[uid] and rarityIndex(b.rarity) >= rarityIndex(cfg.HATCH_MIN_RARITY) then
			if not best or rarityIndex(b.rarity) > rarityIndex(best) then best = b.rarity end
		end
	end
	if best then
		table.insert(out, { kind = "hatch", value = best })
	end

	-- Seltene Mutation: neu geschluepft mit Mutation oder Mutation geaendert
	for uid, b in after.baerchis do
		local m = b.mutation
		if m and cfg.RARE_MUTATIONS[m] then
			local old = before.baerchis[uid]
			if not old or old.mutation ~= m then
				table.insert(out, { kind = "mutation", value = m })
				break
			end
		end
	end

	-- Neuer Tower geschafft/freigeschaltet
	if TowerConfig.getIndex(after.highest) > TowerConfig.getIndex(before.highest) then
		table.insert(out, { kind = "tower", value = after.highest })
	end

	-- Neuer persoenlicher Rekord (in irgendeinem Tower)
	for id, n in after.records do
		if n > (before.records[id] or 0) and (before.records[id] or 0) > 0 then
			table.insert(out, { kind = "record", value = id, number = n })
			break
		end
	end

	if after.rebirths > before.rebirths then
		table.insert(out, { kind = "rebirth", value = tostring(after.rebirths), number = after.rebirths })
	end
	return out
end

-- Grosser oder kleiner Moment? `lastBig` = Zeit des letzten grossen Moments
-- dieses Spielers. Rueckgabe: big, neues lastBig.
function WorldMoments.throttle(lastBig: number?, now: number): (boolean, number?)
	if lastBig and now - lastBig < WorldFXConfig.MOMENTS.PLAYER_COOLDOWN then
		return false, lastBig
	end
	return true, now
end

--------------------------------------------------------------------------------
-- Warteschlange (Client): hoechstens ein grosser Moment gleichzeitig
--------------------------------------------------------------------------------

export type Entry = { id: number, kind: string, big: boolean, at: number }
export type Queue = { waiting: { Entry }, busyUntil: number }

function WorldMoments.newQueue(): Queue
	return { waiting = {}, busyUntil = -math.huge }
end

-- Kleine Momente laufen sofort (Rueckgabe true = jetzt zeigen). Grosse
-- reihen sich ein; ist die Schlange voll, wird der neue klein gezeigt.
function WorldMoments.push(q: Queue, e: Entry): boolean
	if not e.big then return true end
	if #q.waiting >= WorldFXConfig.MOMENTS.QUEUE_MAX then
		e.big = false
		return true
	end
	table.insert(q.waiting, e)
	return false
end

-- Naechster grosser Moment, falls die Buehne frei ist. Wer zu lange wartete,
-- kommt klein heraus (`big = false`), belegt die Buehne dann aber nicht.
function WorldMoments.pop(q: Queue, now: number): Entry?
	local cfg = WorldFXConfig.MOMENTS
	local first = q.waiting[1]
	if not first then return nil end
	if now - first.at > cfg.MAX_WAIT then
		table.remove(q.waiting, 1)
		first.big = false
		return first
	end
	if now < q.busyUntil then return nil end
	table.remove(q.waiting, 1)
	local duration = (cfg.DURATION :: any)[first.kind] or 2
	q.busyUntil = now + duration + cfg.QUEUE_GAP
	return first
end

return WorldMoments
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX38"><Properties>
<string name="Name">Network</string>
</Properties>
<Item class="ModuleScript" referent="RBX39"><Properties>
<string name="Name">Remotes</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- Remotes.luau
-- ReplicatedStorage/Network/Remotes.luau
--
-- Alle RemoteEvents und RemoteFunctions als benannte Konstanten.
-- Kein Magic-String im gesamten Projekt.
-- Server und Client importieren von hier.
--
-- Konvention: der Feldname hier ist gleichzeitig der Schluessel in
-- NetworkConfig.REMOTE_COOLDOWNS — RateLimiter verlaesst sich darauf.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

-- ============================================================
-- WARUM DIE FALLUNTERSCHEIDUNG SERVER/CLIENT
-- ============================================================
-- Nur der SERVER legt die Remotes an. Der Client wartet ausschliesslich
-- darauf, dass sie repliziert werden.
--
-- Ohne diese Trennung koennte ein Client-Skript, das laeuft bevor der Ordner
-- bei ihm angekommen ist, sich selbst einen EIGENEN "RemoteFolder" mit
-- eigenen, rein lokalen RemoteEvents bauen. Die kommen nie beim Server an
-- und der Server erreicht sie nie — das Spiel saehe vollstaendig normal aus
-- und wuerde einfach gar nichts tun, ohne eine einzige Fehlermeldung. Das ist
-- eine der unangenehmsten Fehlerarten ueberhaupt, deshalb hier explizit.
local IS_SERVER = RunService:IsServer()

local folder: Instance
if IS_SERVER then
	local existing = ReplicatedStorage:FindFirstChild("RemoteFolder")
	if existing then
		folder = existing
	else
		local created = Instance.new("Folder")
		created.Name   = "RemoteFolder"
		created.Parent = ReplicatedStorage
		folder = created
	end
else
	folder = ReplicatedStorage:WaitForChild("RemoteFolder")
end

local function getOrCreateEvent(name: string): RemoteEvent
	if not IS_SERVER then
		return folder:WaitForChild(name) :: RemoteEvent
	end

	local existing = folder:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local remote  = Instance.new("RemoteEvent")
	remote.Name   = name
	remote.Parent = folder
	return remote
end

local function getOrCreateFunction(name: string): RemoteFunction
	if not IS_SERVER then
		return folder:WaitForChild(name) :: RemoteFunction
	end

	local existing = folder:FindFirstChild(name)
	if existing and existing:IsA("RemoteFunction") then
		return existing
	end
	local remote  = Instance.new("RemoteFunction")
	remote.Name   = name
	remote.Parent = folder
	return remote
end

-- ============================================================
-- Server → Client Events
-- ============================================================

-- Wird nach jeder Zustandsaenderung gefeuert
-- Args: PlayerDataUpdate
local PlayerDataUpdated = getOrCreateEvent("PlayerDataUpdated")

-- Kampfergebnis anzeigen (Animation auf Client)
-- Args: CombatResult
local CombatResultReceived = getOrCreateEvent("CombatResultReceived")

-- Hatch-Ergebnis anzeigen (Gacha-Animation auf Client)
-- Args: HatchResult
local HatchResultReceived = getOrCreateEvent("HatchResultReceived")

-- Fusions-Ergebnis anzeigen
-- Args: FusionResult
local FusionResultReceived = getOrCreateEvent("FusionResultReceived")

-- Recycling-Ergebnis anzeigen
-- Args: RecycleResult
local RecycleResultReceived = getOrCreateEvent("RecycleResultReceived")

-- Rebirth durchgefuehrt
-- Args: RebirthResult
local RebirthResultReceived = getOrCreateEvent("RebirthResultReceived")

-- Offline-Ertrag beim Join
-- Args: OfflineReport
local OfflineReportReceived = getOrCreateEvent("OfflineReportReceived")

-- Ein Honig wurde verfuettert: Heilung, XP und ggf. Level-Up
-- Args: FeedResult
local FeedResultReceived = getOrCreateEvent("FeedResultReceived")

-- Ein Baerchi wurde befoerdert
-- Args: PromotionResult
local PromotionResultReceived = getOrCreateEvent("PromotionResultReceived")

-- Charms wurden neu gewuerfelt (ein Wurf oder ein Auto-Roll-Paket)
-- Args: CharmRollResult
local CharmRollResultReceived = getOrCreateEvent("CharmRollResultReceived")

-- Ein Stat-Level ist durch Event-Teilnahme gestiegen
-- Args: EventStatGain
local EventStatGained = getOrCreateEvent("EventStatGained")

-- Der ausgeruestete Baerchi ist am Event angekommen bzw. wieder zuhause.
-- Reiner Anzeige-Zustand fuer den "Zum Event"-Knopf — die Wahrheit darueber,
-- wer am Event steht, liegt ausschliesslich serverseitig
-- (EventParticipationService), dieser Event teilt sie nur mit.
-- Args: atEvent: boolean, baerchiUid: string?
local EventPresenceChanged = getOrCreateEvent("EventPresenceChanged")

-- Der Event-Zyklus hat die Phase gewechselt: ein Event hat begonnen oder ist
-- vorbei. Geht an ALLE Spieler (der Zyklus ist fuer alle derselbe) und beim
-- Join zusaetzlich einmal gezielt an den neuen Spieler.
--
-- Uebertragen wird nur die eventId, NICHT die Belohnung: den Katalog kennt der
-- Client selbst (EventConfig liegt in ReplicatedStorage), und ein zweiter
-- Uebertragungsweg fuer dieselben Zahlen waere genau die Art Doppelung, die
-- beim naechsten Balancing auseinander laeuft.
--
-- Args: eventId: string?  (nil = gerade Pause),
--       secondsRemaining: number,
--       nextEventId: string  (was als naechstes laeuft — waehrend der Pause
--                             die eigentlich wichtige Angabe, weil der Spieler
--                             danach entscheidet, ob er seinen Baerchi
--                             losschickt)
local EventPhaseChanged = getOrCreateEvent("EventPhaseChanged")

-- Ein gelegtes Ei wurde eingesammelt und liegt jetzt im Lager
-- Args: EggCollectResult
local EggCollectedReceived = getOrCreateEvent("EggCollectedReceived")

-- Beim Join: wie viele Eier waehrend der Abwesenheit dazugekommen sind
-- Args: OfflineEggReport
local OfflineEggReportReceived = getOrCreateEvent("OfflineEggReportReceived")

-- v15: Der Spieler hat seinen Waben-Stapel auf der eigenen Insel abgegeben.
-- Reiner Anzeige-Anlass (Meldung); die Waben gehen serverseitig direkt in die
-- Warteschlange des Recyclers (CombRecyclerService).
-- Args: count: number (Waben), units: number (Wabeneinheiten, goldene zaehlen mehr)
local CombDelivered = getOrCreateEvent("CombDelivered")

-- v15: Der Waben-Recycler wurde ausgebaut.
-- Args: newLevel: number
local RecyclerUpgraded = getOrCreateEvent("RecyclerUpgraded")

-- v12: Zustand des ausgeruesteten Baerchis fuer die untere Pet-Leiste
-- (PetBar). Die Wahrheit liegt ausschliesslich in PetModeService, dieser
-- Event teilt sie nur mit.
-- Args: state: string  ("Home" | "ToEvent" | "AtEvent" | "ToPit" | "InPit" | "Returning"),
--       pending: string? ("Event" | "Fight" — vorgemerktes Ziel beim Wechsel),
--       info: { stage: number? }?  (laufende Stage im PIT, fuer die Beschriftung)
local PetModeChanged = getOrCreateEvent("PetModeChanged")

-- Eine Anfrage wurde serverseitig abgelehnt — Client zeigt Toast/Fehlertext.
-- Args: action: string, reason: Types.LocMsg  (Schluessel + Zahlen, KEIN fertiger
--       Satz: der Client baut den Text in der Sprache des Spielers, siehe
--       Localization/Loc. Ein einfacher String wird als Altlast unveraendert
--       angezeigt.)
-- v13: Quest-Belohnung wurde ausgezahlt (Toast). Args: reward: Types.QuestReward
local QuestRewardReceived = getOrCreateEvent("QuestRewardReceived")

local ActionFailed = getOrCreateEvent("ActionFailed")

-- v17 (lebendige Events): Meldung waehrend eines Events, als LocMsg (der
-- Client uebersetzt). Geht an einen Spieler oder an alle (Jackpot, Boss).
-- Args: msg: Types.LocMsg, style: ("info" | "good" | "big")?
local EventNotice = getOrCreateEvent("EventNotice")

-- v17: Telegraph einer Boss-Attacke (an alle). Args: Types.HazardTelegraph
local EventTelegraph = getOrCreateEvent("EventTelegraph")

-- v17: Der eigene Charakter wurde von einer Boss-Attacke getroffen.
-- Args: Types.HazardHit
local EventHazardHit = getOrCreateEvent("EventHazardHit")

-- v15 (Tower): ein Tower-Meilenstein wurde ausgezahlt (Toast).
-- Args: Types.TowerMilestoneReward
local TowerMilestoneReceived = getOrCreateEvent("TowerMilestoneReceived")

-- v15: Login-Bonus ausgezahlt (Toast). Args: Types.DailyBonusResult
local DailyBonusReceived = getOrCreateEvent("DailyBonusReceived")

-- v14 (Mega Egg Tree): Ei-Baum, Ei-Presse, Blaupausen, Faehigkeiten-Show
local EggTreeUnlocked        = getOrCreateEvent("EggTreeUnlocked")        -- S->C (Types.EggUnlockResult)
local EggPressResultReceived = getOrCreateEvent("EggPressResultReceived") -- S->C (Types.EggPressResult)
local SkillFXPlay            = getOrCreateEvent("SkillFXPlay")            -- S->C (alle Clients, siehe PitArenaService)
-- Welt aufwerten, Paket G: ein grosser Moment eines Spielers, an ALLE Clients.
-- Der Server sagt nur WAS passiert ist; wie es aussieht entscheidet der Client
-- (WorldMomentController). Args: { userId, kind, value, number?, big }
-- (kind: "hatch" | "tower" | "record" | "rebirth" | "mutation", siehe Modules/WorldMoments)
local WorldMoment            = getOrCreateEvent("WorldMoment")            -- S->C (alle Clients, siehe WorldMomentService)
local RequestPressEggs       = getOrCreateEvent("RequestPressEggs")       -- C->S (eggType, path?)
local RequestUseBlueprint    = getOrCreateEvent("RequestUseBlueprint")    -- C->S (eggType)

-- ============================================================
-- Client → Server Events (Anfragen)
-- ============================================================

-- Spieler oeffnet ein Ei aus seinem Lager (seit v12 sofort, ohne Brutzeit
-- und ohne Kauf). Ergebnis kommt ueber HatchResultReceived.
-- Args: eggType: string
local RequestHatchEgg = getOrCreateEvent("RequestHatchEgg")

-- v13: Quest-Belohnung abholen. Der Server prueft selbst, ob die Quest erledigt ist.
-- Args: kind: "chain" | "daily", questId: string
local RequestClaimQuest = getOrCreateEvent("RequestClaimQuest")

-- v12: Pet-Leiste. Der Client sagt nur, welcher Knopf gedrueckt wurde — was
-- daraus folgt (hinschicken, zurueckholen, wechseln), entscheidet
-- PetModeService.
-- Args: mode: "Event" | "Fight" | "Home",
--       resume: ("Fresh" | "Percent" | "Last")?  (nur bei "Fight": Wahl aus der
--               Fortsetzungs-Frage; nil = von vorn)
local RequestPetMode = getOrCreateEvent("RequestPetMode")

-- Spieler will ein Gebaeude upgraden
-- Args: buildingId: string
local RequestUpgradeBuilding = getOrCreateEvent("RequestUpgradeBuilding")

-- (v15: RequestUpgradePit ist entfallen — es gibt kein PIT-Level mehr.)

-- v15: Tower waehlen, in den der Fight-Knopf schickt. Der Server prueft, ob
-- der Tower beim aktuellen Rebirth offen ist (TowerConfig.isOpen).
-- Args: towerId: string
local RequestSelectTower = getOrCreateEvent("RequestSelectTower")

-- v15: taeglichen Login-Bonus abholen. Der Server prueft UTC-Tag,
-- Gnadenfrist und doppelte Abholung (Modules/LoginBonusCalc).
-- Args: (keine)
local RequestClaimDailyBonus = getOrCreateEvent("RequestClaimDailyBonus")

-- v15: Waben-Recycler ausbauen (kein Argument: es gibt nur einen pro Insel)
local RequestUpgradeRecycler = getOrCreateEvent("RequestUpgradeRecycler")

-- Spieler will zwei Baerchis fusionieren
--
-- Args: uidA: string, uidB: string,
--       lockedProperty: ("ability" | "level" | "eggs")?,   -- nil = alles automatisch
--       lockedFrom:     ("A" | "B")?                        -- nur wenn lockedProperty gesetzt
--
-- Die beiden letzten Argumente kommen aus dem Sperr-Schritt des Fusions-Menues
-- (siehe FusionPanel). Sie sind optional: ein Aufruf ohne sie verhaelt sich wie
-- vor der Erweiterung, alles automatisch nach der Standard-Regel.
local RequestFuseBaerchis = getOrCreateEvent("RequestFuseBaerchis")

-- Spieler will einen Baerchi mit Duplikaten befoerdern
-- Args: baerchiUid: string
local RequestPromoteBaerchi = getOrCreateEvent("RequestPromoteBaerchi")

-- Spieler will die Charms eines Baerchis neu wuerfeln.
-- `rolls` ist die Anzahl der Wuerfe in EINEM Paket (1 = "Roll Charms",
-- CharmConfig.AUTO_ROLL_COUNT = "Auto Roll"). Siehe CharmConfig, Kommentar bei
-- AUTO_ROLL_COUNT, warum das ein Paket ist und keine Schleife auf dem Client.
-- Args: baerchiUid: string, rolls: number?
local RequestRollCharms = getOrCreateEvent("RequestRollCharms")

-- Spieler will einen Charm-Slot gegen erneutes Wuerfeln sperren/freigeben
-- Args: baerchiUid: string, slot: number
local RequestToggleCharmLock = getOrCreateEvent("RequestToggleCharmLock")

-- Spieler sammelt ein gelegtes Ei auf, das in der Welt liegt.
-- Args: eggUid: string  (Types.LaidEgg.uid — NICHT die Position: die aendert
--       sich nicht, aber eine uid ist eindeutig auch dann noch, wenn zwei Eier
--       uebereinander liegen.)
local RequestCollectEgg = getOrCreateEvent("RequestCollectEgg")

-- Spieler sammelt ALLE herumliegenden Eier auf einmal auf.
-- Args: (keine)
local RequestCollectAllEggs = getOrCreateEvent("RequestCollectAllEggs")

-- Spieler will einen Baerchi verwerten
-- Args: baerchiUid: string
local RequestRecycleBaerchi = getOrCreateEvent("RequestRecycleBaerchi")

-- Spieler will einen Baerchi mit einem Honig fuettern (heilt + gibt XP).
-- Aus welchem Gebaeude der Honig kommt, entscheidet der Server (bestes zuerst).
-- Args: baerchiUid: string
local RequestFeedHoney = getOrCreateEvent("RequestFeedHoney")

-- Spieler will einen Baerchi ausruesten. Es steht immer nur EINER auf dem
-- Plot — die anderen bleiben im Inventar. Siehe IslandService.equipBaerchi.
-- Args: baerchiUid: string
local RequestEquipBaerchi = getOrCreateEvent("RequestEquipBaerchi")

-- Spieler will Rebirth machen
-- Args: (keine)
local RequestRebirth = getOrCreateEvent("RequestRebirth")

-- Spieler waehlt seine Sprache. nil/"auto" = zurueck auf die Roblox-Sprache.
-- Args: language: string?   ("de" | "en" | "fr" | "es")
local RequestSetLanguage = getOrCreateEvent("RequestSetLanguage")

-- HBB Paket 0: Messpunkte der Oberflaeche (Panel geoeffnet, Panel schnell
-- wieder geschlossen, Spieler steht still). Reine Statistik, aendert nichts
-- am Spielstand. Der Server prueft Art und Panel-Namen gegen
-- FunnelConfig und deckelt die Anzahl pro Sitzung.
-- Args: kind: "PanelOpened" | "PanelQuickClose" | "IdleStanding",
--       panelName: string?
local RequestLogUiEvent = getOrCreateEvent("RequestLogUiEvent")

-- HBB Paket 3: Bedienelemente als "gesehen" markieren (Badge verschwindet).
-- Rein kosmetisch; der Server prueft nur die Ids gegen UnlockRules.ELEMENTS.
-- Args: ids: string | { string }
local RequestMarkUiSeen = getOrCreateEvent("RequestMarkUiSeen")

-- HBB Paket 5: Heim-Knopf. Der Server teleportiert auf den eigenen Plot,
-- ausser der Spieler traegt Waben (dann ActionFailed).
-- Args: (keine)
local RequestGoHome = getOrCreateEvent("RequestGoHome")
-- HBB Paket 10: Shop — Gratis-Griff (Client -> Server, keine Argumente)
local RequestClaimFreeGrab = getOrCreateEvent("RequestClaimFreeGrab")

-- ============================================================
-- Client → Server Functions (brauchen eine Antwort)
-- ============================================================

-- Spieler fragt seine aktuellen Daten an (z.B. nach Reconnect)
-- Returns: PlayerDataUpdate?
local GetPlayerData = getOrCreateFunction("GetPlayerData")

-- v15: eine Bestenliste (LeaderboardService, gecacht).
-- Args: listId: "Tower" | "Rebirths" | "Collection"
-- Returns: Types.LeaderboardView?
local GetLeaderboard = getOrCreateFunction("GetLeaderboard")

-- v15: Profilkarte eines anderen Spielers auf DIESEM Server (Inspektor).
-- Args: userId: number
-- Returns: Types.PlayerProfileCard?
local GetPlayerProfile = getOrCreateFunction("GetPlayerProfile")

return {
	-- Server → Client
	PlayerDataUpdated     = PlayerDataUpdated,
	CombatResultReceived  = CombatResultReceived,
	HatchResultReceived   = HatchResultReceived,
	FusionResultReceived  = FusionResultReceived,
	RecycleResultReceived = RecycleResultReceived,
	RebirthResultReceived = RebirthResultReceived,
	OfflineReportReceived = OfflineReportReceived,
	FeedResultReceived    = FeedResultReceived,
	PromotionResultReceived = PromotionResultReceived,
	CharmRollResultReceived = CharmRollResultReceived,
	EventStatGained         = EventStatGained,
	EventPresenceChanged    = EventPresenceChanged,
	EventPhaseChanged       = EventPhaseChanged,
	EggCollectedReceived    = EggCollectedReceived,
	OfflineEggReportReceived = OfflineEggReportReceived,
	PetModeChanged          = PetModeChanged,
	CombDelivered           = CombDelivered,
	RecyclerUpgraded        = RecyclerUpgraded,
	QuestRewardReceived     = QuestRewardReceived,
	ActionFailed          = ActionFailed,
	EventNotice           = EventNotice,
	EventTelegraph        = EventTelegraph,
	EventHazardHit        = EventHazardHit,

	TowerMilestoneReceived = TowerMilestoneReceived,
	DailyBonusReceived     = DailyBonusReceived,

	EggTreeUnlocked        = EggTreeUnlocked,
	EggPressResultReceived = EggPressResultReceived,
	SkillFXPlay            = SkillFXPlay,
	WorldMoment            = WorldMoment,
	RequestPressEggs       = RequestPressEggs,
	RequestUseBlueprint    = RequestUseBlueprint,

	-- Client → Server
	RequestHatchEgg        = RequestHatchEgg,
	RequestClaimQuest      = RequestClaimQuest,
	RequestPetMode         = RequestPetMode,
	RequestUpgradeBuilding = RequestUpgradeBuilding,
	RequestSelectTower     = RequestSelectTower,
	RequestClaimDailyBonus = RequestClaimDailyBonus,
	RequestUpgradeRecycler = RequestUpgradeRecycler,
	RequestFuseBaerchis    = RequestFuseBaerchis,
	RequestRecycleBaerchi  = RequestRecycleBaerchi,
	RequestFeedHoney       = RequestFeedHoney,
	RequestEquipBaerchi    = RequestEquipBaerchi,
	RequestRebirth         = RequestRebirth,
	RequestSetLanguage     = RequestSetLanguage,
	RequestPromoteBaerchi  = RequestPromoteBaerchi,
	RequestRollCharms      = RequestRollCharms,
	RequestToggleCharmLock = RequestToggleCharmLock,
	RequestCollectEgg      = RequestCollectEgg,
	RequestCollectAllEggs  = RequestCollectAllEggs,
	RequestLogUiEvent      = RequestLogUiEvent,
	RequestMarkUiSeen      = RequestMarkUiSeen,
	RequestGoHome          = RequestGoHome,
	RequestClaimFreeGrab   = RequestClaimFreeGrab,

	-- Functions
	GetPlayerData          = GetPlayerData,
	GetLeaderboard         = GetLeaderboard,
	GetPlayerProfile       = GetPlayerProfile,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX40"><Properties>
<string name="Name">Types</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- Types.luau
-- ReplicatedStorage/Network/Types.luau
--
-- Einzige Wahrheit fuer alle Datenstrukturen im Spiel.
-- Wird auf Server UND Client importiert.
-- Wenn sich ein Feld aendert, aendert es sich hier — nirgendwo sonst.

--------------------------------------------------------------------------------
-- Enums
--------------------------------------------------------------------------------

local HoneyPondMode = require(script.Parent.Parent.Modules.HoneyPondMode)
local FeatureFlags  = require(script.Parent.Parent.Config.FeatureFlags)

export type Rarity =
	| "Common"
	| "Uncommon"
	| "Rare"
	| "Epic"
	| "Legendary"
	| "Mythic"
	| "Divine"
	| "Cosmic"
	| "Secret"
	| "Godly"
	| "Eternal"
	| "Omega"

-- v14 (Mega Egg Tree): 20 Eier in einem Freischalt-Baum. Welches Ei zu
-- welchem Pfad gehoert und wie es frei wird, steht in EggConfig (TREE).
export type EggType =
	-- Stamm
	| "BasicEgg"
	| "SugarEgg"
	-- Gold-Pfad
	| "GoldenEgg"
	| "PlatinumEgg"
	| "SunEgg"
	| "ZenithEgg"
	-- Kristall-Pfad
	| "CrystalEgg"
	| "PrismEgg"
	| "AuroraEgg"
	-- Void-Pfad
	| "MistEgg"
	| "VoidEgg"
	| "ShadowEgg"
	| "AbyssEgg"
	-- Kosmos-Pfad
	| "CometEgg"
	| "NovaEgg"
	| "GalaxyEgg"
	-- Ascensions-Pfad (nur Rebirth)
	| "AscensionEgg"
	| "TranscendenceEgg"
	| "EternityEgg"
	| "OmegaEgg"
	-- Sonder-Eier ausserhalb des Baums (EggConfig: special = true)
	| "UfoJackpotEgg"

-- v14: die Pfade des Ei-Baums. Ein Pfad ist kein Upgrade, sondern ein
-- Spielziel (Gold = stark, Kristall = schnell, Void = selten, Kosmos =
-- Allrounder, Ascension = Rebirth). Siehe BaerchiConfig.PATHS.
export type PathId = "Stamm" | "Gold" | "Kristall" | "Void" | "Kosmos" | "Ascension"
	| "Event"   -- Sonder-Eier aus Events (nicht im Baum, nie freischaltbar)

-- v11: MUTATION-SYSTEM (ersetzt das binaere isInverted-Feld).
--
-- Acht Stufen statt einem einzigen Bonus — Namen und Werte (Multiplikator,
-- Farbe, Wuerfel-Gewicht) stehen NICHT hier, sondern in
-- Config/BaerchiConfig.MUTATIONS (dieselbe Trennung wie bei Rarity: Types
-- kennt nur die Werte-Menge, BaerchiConfig kennt die Bedeutung dahinter).
-- Aufsteigend sortiert nach Seltenheit/Staerke — BaerchiConfig.MUTATION_ORDER
-- haelt exakt diese Reihenfolge fuer Fusions-Vergleiche ("hoehere Stufe
-- gewinnt").
export type MutationId =
	| "Gold"
	| "Diamond"
	| "Bloodrot"
	| "Celestial"
	| "Candy"
	| "Lava"
	| "Galaxy"
	| "Rainbow"

-- Gebaeude sind seit v4 reine HONIG-Produzenten: jedes stellt regelmaessig
-- einen Honig her und lagert eine begrenzte Menge davon. Ein Honig an einen
-- Baerchi verfuettert heilt ihn und gibt XP — die einzige XP-Quelle im Spiel
-- (Kaempfe geben keine XP mehr).
--
-- Seit v15 (Gebaeude Option B) sind es noch ZWEI Honig-Gebaeude, und nur eine
-- Datei weiss, was sie koennen: Config/BuildingBehavior.luau. Kurz:
--   Beehive       Vorrat   — groesseres Lager, schnellere Produktion
--   HoneyRefiner  Veredeln — sein Level hebt Heilung UND XP jedes Honigs
--                            (verschmolzen aus Honigtopf und Honig-Presse;
--                            "Honig-Veredler" ist ein Platzhalter-Name)
-- Das dritte Gebaeude, der Waben-Recycler, liegt in island.recycler.
--
-- Level 1-60 (EconomyConfig.MAX_BUILDING_LEVEL), Look-Stufe aus dem Level
-- (BuildingBehavior.getLook).
--
-- Seit dem Honig-Teich (FeatureFlags.HONEY_POND_V2) ist es EIN Gebaeude:
--   HoneyPond     Honig-Teich — kann alles, was Stock und Veredler zusammen
--                 koennen; seine Looks wachsen bis zum Honig-Springbrunnen.
-- Die jeweils nicht aktiven liegen in IslandData.retiredBuildings
-- (Modules/HoneyPondMode).
export type BuildingId =
	| "Beehive"        -- Bienenstock
	| "HoneyRefiner"   -- Honig-Veredler (Platzhalter-Name)
	| "HoneyPond"      -- Honig-Teich (HONEY_POND_V2)
-- Fusion ist seit v3 kein Gebaeude mehr — sie laeuft rein ueber GUI
-- (FusionPanel/BaerchiInventory) und ist von Anfang an freigeschaltet.
-- Recycling ist seit v4 ebenfalls eine reine GUI-Funktion mit festem Wert
-- (EconomyConfig.RECYCLE_RETURN). Eier werden seit v12 sofort geoeffnet,
-- es gibt keine Brut-Slots mehr.

export type SkillId = string  -- "SugarRush", "GummySmash", "BearHug", etc.
                               -- String damit neue Skills nur Config-Eintraege sind

-- Rarity eines BATTLE-CHARMS. Bewusst eine eigene Kette, nicht Types.Rarity:
-- ein Charm hat andere Stufen als ein Baerchi ("Super Rare", "Ascended"), und
-- die Odds der einen duerfen sich nicht verschieben, wenn jemand die andere
-- erweitert. Zahlen und Farben stehen in Config/CharmConfig.
export type CharmRarity =
	| "Common"
	| "Uncommon"
	| "Rare"
	| "SuperRare"
	| "Legendary"
	| "Ascended"

-- Ein einzelner ausgeruesteter Battle-Charm.
--
-- Der Slot steht IM Eintrag statt als Tabellen-Schluessel: eine Lua-Tabelle mit
-- Luecken in den Zahlen-Schluesseln ({[1]=..., [5]=...}) laesst sich nicht in
-- einem DataStore ablegen. Baerchi.charms ist deshalb eine dichte Liste, in der
-- nur die tatsaechlich gewuerfelten Slots vorkommen — nach `slot` sortiert.
export type Charm = {
	slot   : number,        -- 1-8, siehe CharmConfig.SLOT_COUNT
	rarity : CharmRarity,   -- erster Wurf
	statId : string,        -- zweiter Wurf, Eintrag aus CharmConfig.STAT_POOL
	value  : number,        -- konkreter Bonus (Faktor bzw. flacher Wert, siehe STAT_POOL.mode)
	locked : boolean,       -- vom Spieler gegen erneutes Wuerfeln gesperrt
}

-- Fortschritt JEDES EINZELNEN Stats durch Event-Teilnahme, gedeckelt durch die
-- rarity-abhaengige Obergrenze (PromotionConfig.STAT_CAP). Voellig getrennt von
-- Baerchi.level, das ueber Honig/XP waechst — zwei unabhaengige Achsen.
--
-- Seit v10 sind alle fuenf echt: `egg` war lange ein Balken ohne Wirkung, weil
-- es das Ei-Legen noch nicht gab. Jetzt beschleunigt es das Legen (siehe
-- EggConfig.LAY_STAT_LEVEL_GAIN).
export type StatLevels = {
	hp  : number,
	atk : number,
	spd : number,   -- Angriffsgeschwindigkeit
	pwr : number,   -- Ability-Staerke (skaliert den Skill-Schaden)
	egg : number,   -- Lege-Tempo (siehe EggCalculator)
}

--------------------------------------------------------------------------------
-- Kern-Einheit: Baerchi
--------------------------------------------------------------------------------

export type Baerchi = {
	uid            : string,   -- eindeutige Instanz-ID ("b_1721abc...")
	configId       : string,   -- Schluessel in BaerchiConfig ("RedBaerchi", "GoldenGrizzly")
	rarity         : Rarity,
	level          : number,   -- 1 - BaerchiConfig.MAX_LEVEL
	xp             : number,   -- XP-Fortschritt zum naechsten Level
	endlessLevel   : number?,  -- Paket 9: Level ueber MAX_LEVEL (nil = 0), bleibt ueber Rebirths
	skillId        : SkillId,  -- aktiver Skill (durch Fusion ueberschreibbar)
	isFusionResult : boolean,  -- fuer UI-Badge "FUSION"
	fusionBonus    : number,   -- 0.0 = kein Bonus, 0.25 = +25% HP/ATK
	                           -- wird beim Fusionieren gesetzt (EconomyConfig.FUSION_STAT_BONUS)
	                           -- und von CombatCalculator.getEffectiveStats angewendet
	currentHp      : number,   -- aktuelle Lebenspunkte, bleiben zwischen PIT-Laeufen
	                           -- stehen. 0 = erschoepft, der Baerchi kann erst
	                           -- wieder kaempfen wenn er mit Honig gefuettert wurde.
	                           -- Obergrenze ist maxHp aus getEffectiveStats.

	-- v8: die zweite Fortschrittsachse (siehe Config/PromotionConfig).
	promotionLevel : number,       -- 0 - PromotionConfig.MAX_PROMOTION, angezeigt als 5 Sterne
	statLevels     : StatLevels,   -- waechst durch Event-Teilnahme
	charms         : { Charm },    -- dichte Liste, nach slot sortiert (siehe Charm)

	-- v8: nur bei einem FUSIONS-Ergebnis gesetzt, sonst nil.
	--
	-- Basiswerte haengen sonst ausschliesslich am configId
	-- (BaerchiConfig.data[configId].baseStats). Seit der neuen Fusions-Regel
	-- ("pro Stat der bessere der beiden Eltern") kann ein Fusions-Ergebnis aber
	-- hoehere Basiswerte tragen, als sein eigener configId hergibt — genau
	-- dafuer ist dieses Feld da.
	--
	-- CombatCalculator.getEffectiveStats bevorzugt die hier gesetzten Werte.
	-- Fuer JEDEN nicht fusionierten Baerchi bleibt das Feld nil und das
	-- Verhalten unveraendert.
	baseStatOverride : {
		hp  : number?,
		atk : number?,
		spd : number?,
		pwr : number?,
	}?,

	-- v11: MUTATION (ersetzt das fruehere binaere isInverted-Feld aus v9).
	--
	-- Eine seltene Variante JEDES Baerchis (Wurf beim Schluepfen:
	-- BaerchiConfig.rollMutation()), diesmal GESTUFT statt binaer: acht
	-- Stufen mit steigendem Stat-Multiplikator, steigender Seltenheit und
	-- eigener Farbe/Leuchten (siehe BaerchiConfig.MUTATIONS). nil = keine
	-- Mutation, der weit ueberwiegende Normalfall.
	--
	-- Bewusst ein eigenes Feld und KEINE eigene Rarity: die Rarity steuert
	-- Gacha-Gewichte, Stat-Obergrenzen, Fusions-Kette und Farben. Mutation an
	-- sie zu haengen haette all das mitverbogen — derselbe Grund wie zuvor bei
	-- Inverted, nur jetzt mit mehr als zwei moeglichen Zustaenden.
	mutation : MutationId?,
}

--------------------------------------------------------------------------------
-- Insel-Daten
--------------------------------------------------------------------------------

export type Building = {
	id    : BuildingId,
	level : number,   -- 1 .. EconomyConfig.MAX_BUILDING_LEVEL (60)

	-- Eingelagerter Honig, 0 .. EconomyConfig.HONEY_CAPACITY.
	honey : number,

	-- os.time() des zuletzt ANGERECHNETEN Honigs. Die Produktion laeuft nicht
	-- ueber einen Timer sondern wird aus dieser Zeitmarke nachgerechnet
	-- (gleiches Prinzip wie HatchingEgg.readyAt) — dadurch produzieren die
	-- Gebaeude auch waehrend der Spieler offline ist, ohne Server-Loop.
	lastProducedAt : number,
}

-- v12: Brut-Slots (HatchingEgg, island.hatchingEggs) sind entfallen. Ein Ei
-- aus dem Lager wird per Klick sofort geoeffnet (EggService.openEgg). Die
-- Migration (Util/PlayerMigration) legt laufende Bruten alter Spielstaende zurueck
-- ins Lager.

-- v15: TOWER-SYSTEM (ersetzt das PIT-Level).
--
-- Vier Tower mit eigener Stage-Zahl und eigenem Gegner-Wachstum, Zahlen in
-- Config/TowerConfig. "I" Holz (30 Stages), "II" Stein (45), "III" Gold (60),
-- "Final" Kristall (100).
export type TowerId = "I" | "II" | "III" | "Final" | "Endless"   -- Endless: HBB Paket 9

-- Permanenter Tower-Fortschritt. Liegt bewusst AUSSERHALB von island (wie
-- eggTree): ein Rebirth setzt die Insel zurueck, Rekorde und abgeholte
-- Meilensteine bleiben.
--
--   records      beste geschaffte Stage je Tower (zaehlt nur bis zum Deckel
--                des jeweiligen Rebirths, siehe TowerConfig.getStageCap)
--   claimed      abgeholte Meilenstein-Stages je Tower. Die Stage steht als
--                TEXT-Schluessel ("5", "10"): eine Lua-Tabelle mit Luecken in
--                Zahlen-Schluesseln laesst sich nicht im DataStore ablegen
--                (derselbe Grund wie bei Baerchi.charms).
--   highestTower hoechster je erreichte Tower (Look des Turms, Abzeichen)
--   selected     der Tower, in den der Fight-Knopf schickt
export type TowerState = {
	records      : { [string]: number },
	claimed      : { [string]: { [string]: boolean } },
	highestTower : string,
	selected     : string,
	endlessWeek  : { week: number, best: number }?, -- Paket 9: beste Endless-Stage der Woche
}

-- v15: Taeglicher Login-Bonus (Config/LoginBonusConfig). Tage zaehlen nach
-- UTC (os.time() // 86400). streak = wie viele Tage des 7-Tage-Zyklus schon
-- abgeholt sind (0-7); lastClaimDay = UTC-Tag der letzten Abholung (0 = nie).
export type DailyState = {
	lastClaimDay : number,
	streak       : number,
}

-- Ein GELEGTES Ei: liegt sichtbar in der Welt und wartet darauf, angeklickt zu
-- werden. Erst beim Einsammeln wird daraus ein Eintrag in eggStock, der sich
-- ausbrueten laesst.
--
-- Die Position steht als drei Zahlen drin, nicht als Vector3: ein DataStore
-- kann nur einfache Werte speichern, ein Vector3 waere beim naechsten Laden
-- verschwunden.
--
-- Warum das Ei ueberhaupt eine Position hat: es wird dort abgelegt, wo der
-- Baerchi im Moment des Legens stand. Wer seinen Baerchi zum Honig-Teich und
-- zurueck laufen laesst, findet danach eine Spur aus Eiern — genau das ist
-- gewollt.
export type LaidEgg = {
	uid     : string,     -- eindeutig, wird zum Einsammeln benutzt
	eggType : EggType,
	laidAt  : number,     -- os.time(), nur fuer die Anzeige ("gerade eben")
	x       : number,
	y       : number,     -- Fusspunkt, das Ei sitzt mit seiner Unterkante darauf
	z       : number,
}

-- v15: der Waben-Recycler vor der Basis (siehe Config/CombConfig). Er nimmt die
-- Waben, die der Spieler im Event-Pit gesammelt hat, in eine Warteschlange und
-- verwandelt sie nach und nach in Gummies. Wie Building.lastProducedAt laeuft
-- das ueber eine Zeitmarke und nicht ueber einen Timer, damit er auch offline
-- weiterarbeitet.
export type RecyclerData = {
	level           : number,   -- 1 .. CombConfig.RECYCLER_MAX_LEVEL
	queued          : number,   -- Wabeneinheiten, die noch verarbeitet werden muessen
	progress        : number,   -- angefangene Einheit (0 .. <1), damit keine Bruchteile verloren gehen
	lastProcessedAt : number,   -- os.time() der letzten Verrechnung
}

export type IslandData = {
	buildings    : { [BuildingId]: Building },
	-- HONEY_POND_V2: Gebaeude, die im aktuellen Modus nicht gelten (Teich
	-- bzw. Stock + Veredler). Bleiben erhalten, kommen beim Zurueckschalten
	-- wieder (Modules/HoneyPondMode). nil = keine.
	retiredBuildings : { [BuildingId]: Building }?,
	baerchis     : { [string]: Baerchi },     -- key = Baerchi.uid
	eggStock     : { [EggType]: number },     -- Eier im Lager (Legen, Events, Rebirth, Haendler)

	-- Der EINE Baerchi, der auf dem Plot steht: laeuft selbststaendig zum
	-- Honig-Teich, in den PIT und wieder zurueck. Alle anderen bleiben reiner
	-- Inventar-Datensatz und werden nicht in der Welt gebaut (MapService
	-- rendert ausschliesslich diesen). nil = noch keiner ausgeruestet (leerer
	-- Plot) — kommt nur direkt nach dem ersten Ei oder nach einem Rebirth vor,
	-- IslandService ruestet den ersten geschluepften Baerchi automatisch aus.
	equippedUid  : string?,

	-- v10: Eier, die der ausgeruestete Baerchi gelegt hat und die noch
	-- herumliegen. Gedeckelt durch EggConfig.MAX_UNCOLLECTED_EGGS.
	laidEggs : { LaidEgg },

	-- os.time() des zuletzt ANGERECHNETEN Eis. Genau wie
	-- Building.lastProducedAt: die Produktion laeuft nicht ueber einen Timer,
	-- sondern wird aus dieser Zeitmarke nachgerechnet — dadurch legt der
	-- Baerchi auch waehrend der Spieler offline ist weiter (langsamer, siehe
	-- EggConfig.OFFLINE_SLOWDOWN) und es braucht keinen Server-Loop dafuer.
	lastEggAt : number,

	-- v15: Waben-Recycler (Level 1-60 + Warteschlange).
	recycler : RecyclerData,

	-- v15: letzte erreichte Stage je Tower fuer die Fortsetzungs-Frage
	-- (ersetzt pitProgress). Schluessel = TowerId. Gehoert zur Insel, weil ein
	-- Rebirth den Baerchi auf Level 1 setzt und ein alter Einstieg dann
	-- sinnlos waere.
	towerProgress : { [string]: number },

	-- v15: Erstattung fuer gekaufte PIT-Level (Migration v14 -> v15). Die
	-- Migration schreibt den Betrag, TowerService zahlt ihn beim Join ueber
	-- EconomyService aus und setzt das Feld auf 0.
	pitRefund : number,
}

--------------------------------------------------------------------------------
-- Lokalisierte Nachrichten (Server → Client)
--------------------------------------------------------------------------------

-- Der Server formuliert nie einen Satz. Er schickt einen Schluessel plus Zahlen
-- bzw. Namen, der Client baut daraus den Text in der Sprache des Spielers
-- (siehe Localization/Loc). Ein Argument darf selbst wieder eine LocMsg sein,
-- damit z.B. ein Eiername in der Sprache des Spielers eingesetzt wird.
--
-- Konvention fuer Schluessel: "err.*" fuer abgelehnte Aktionen, "msg.*" fuer
-- Meldungen, "ui.*" fuer feste Beschriftungen. Die Texte stehen ausschliesslich
-- in Localization/Strings/<sprache>.luau.
export type LocArg = string | number | LocMsg
export type LocMsg = {
	k : string,                      -- Schluessel
	a : { [string]: LocArg }?,       -- Platzhalter-Werte
}

--------------------------------------------------------------------------------
-- Quests und Index (v13)
--------------------------------------------------------------------------------

-- Gespeicherter Quest-Stand. Gespeichert wird bewusst NUR, was sich nicht aus
-- den Spielzaehlern ableiten laesst: wie viele Kettenquests schon abgeholt
-- wurden, und der Tagesstand. Den Fortschritt selbst rechnet QuestProgress
-- jedes Mal frisch aus data.stats / island — so gibt es keine zweite Wahrheit,
-- die auseinanderlaufen kann, und kein anderer Service muss Quests kennen.
export type QuestBaseline = {
	hatched     : number,
	fightsWon   : number,
	gummies     : number,
}

export type QuestState = {
	chainClaimed : number,                    -- Kettenquests, die schon abgeholt sind
	day          : number,                    -- Tagesnummer (UTC), siehe QuestConfig.dayOf
	baseline     : QuestBaseline,             -- Zaehlerstand zu Tagesbeginn
	dailyClaimed : { [string]: boolean },     -- abgeholte Tages-Quests von `day`
}

-- Eine Zeile in der Quest-Anzeige (Server -> Client). Keine Texte: der Client
-- baut sie aus der id (Schluessel "quest.<id>.title").
export type QuestEntry = {
	id       : string,
	kind     : string,   -- "chain" | "daily"
	progress : number,   -- schon auf `target` gedeckelt
	target   : number,
	claimed  : boolean,
}

export type QuestView = {
	chain      : QuestEntry?,   -- aktuelle Kettenquest, nil = Kette komplett
	chainDone  : number,        -- wie viele der Kette erledigt sind
	chainTotal : number,
	daily      : { QuestEntry },
	dailyResetIn : number,      -- Sekunden bis zum naechsten Tageswechsel
}

-- Belohnungs-Meldung (Server -> Client), fuer den Toast.
export type QuestReward = {
	questId : string,
	gummies : number,
	eggType : EggType?,
	goldGummies : number?,   -- GOLD_CHARMS_ONLY: Tages-Quests
}

--------------------------------------------------------------------------------
-- Ei-Baum (v14)
--------------------------------------------------------------------------------

-- Fortschritt im Ei-Baum. Liegt bewusst AUSSERHALB von island: ein Rebirth
-- setzt die Insel zurueck, den Baum aber nicht — er ist der lange Grind.
--
--   unlocked   Eier, deren Knoten frei ist (einmal frei, immer frei)
--   hatched    wie oft jedes Ei schon geoeffnet wurde (Freischalt-Bedingung)
--   pressed    wie oft jedes Ei in der Ei-Presse entstanden ist (Statistik)
--   blueprints Blaupausen aus Events, noch nicht eingesetzt
--   bypass     Knoten, deren Hatch- und Index-Bedingung eine Blaupause
--              ersetzt hat (das Rebirth-Gate gilt trotzdem)
export type EggTreeState = {
	unlocked   : { [string]: boolean },
	hatched    : { [string]: number },
	pressed    : { [string]: number },
	blueprints : number,
	bypass     : { [string]: boolean },
}

--------------------------------------------------------------------------------
-- Spieler-Rang
--------------------------------------------------------------------------------

export type Rank = {
	tier   : number,  -- 1, 2, 3 ...
	name   : string,  -- "Gummy Hatchling", "Sugar Brawler", "Golden Champion" ...
	points : number,  -- Rangpunkte (PvP Arena)
}

--------------------------------------------------------------------------------
-- Sitzungs-Sperre
--------------------------------------------------------------------------------

-- jobId ist game.JobId des haltenden Servers, lockedAt sein os.time() beim
-- letzten Laden oder Speichern.
export type SessionLock = {
	jobId    : string,
	lockedAt : number,
}

--------------------------------------------------------------------------------
-- PlayerData — alles was im DataStore landet
--------------------------------------------------------------------------------

-- HBB Paket 10: Shop-Teil des Spielstands (Regeln: Modules/ShopRules)
export type ShopState = {
	freeGrabDay : number,     -- UTC-Tag des letzten Gratis-Griffs, -1 = nie
	receipts    : { string }, -- zuletzt ausgezahlte Robux-Kauf-IDs
}

-- HBB Paket 10: was der Client fuer das Shop-Fenster braucht
export type ShopView = {
	freeReady  : boolean,
	nextFreeIn : number,      -- Sekunden bis zum naechsten UTC-Tag
	freeGold   : number,
}

export type PlayerData = {
	-- Schema
	version    : number,   -- fuer Migrationen beim Laden alter Daten
	createdAt  : number,   -- Unix-Timestamp
	lastSeenAt : number,   -- fuer Offline-Gummy-Farm-Berechnung

	-- Waehrungen
	gummies     : number,  -- aktiv: PIT-Kaempfe, Quests, Recycling
	goldGummies : number,  -- Premium: PIT-Meilensteine, Events

	-- Progression
	rebirthCount : number,   -- Anzahl Rebirths
	rebirthMult  : number,   -- Earnings-Multiplikator (1.0 → 1.5 → 2.25 ...)
	rank         : Rank,

	-- Gewaehlte Sprache ("de" | "en" | "fr" | "es"). nil = der Spieler hat nie
	-- gewaehlt, es gilt die Roblox-Sprache seines Clients. Bewusst OHNE
	-- Versions-Sprung: ein fehlendes Feld liest sich in Lua ohnehin als nil
	-- und bedeutet genau "automatisch" (wie equippedUid in v6).
	language     : string?,

	-- Insel
	island : IslandData,

	-- Nur serverseitig relevant (wird nicht an Client gesendet)
	stats : {
		totalGummiesEarned  : number,
		totalFightsWon      : number,
		totalFightsLost     : number,
		totalFusions        : number,
		totalRebirths       : number,
		totalRecycled       : number,
		totalHatched        : number,   -- v13: geoeffnete Eier (Quest-Zaehler)
		-- HBB Paket 2: Events, an deren Ende der Baerchi belohnt wurde
		-- (Fuehrung: "erstes Event geschafft"). Alte Staende starten bei 0.
		totalEventsCompleted : number,
	},

	-- v13: Index. Jede configId, die der Spieler je besessen hat (auch nach
	-- Recycling/Fusion/Rebirth). Wird nie geleert.
	discovered : { [string]: boolean },

	-- HBB Paket 3: welche Bedienelemente der Spieler schon gesehen hat
	-- (Badge "!" nur fuer neue). Rein kosmetisch, gesetzt nur von
	-- UiStateService; Ids siehe Modules/UnlockRules.ELEMENTS.
	uiSeen : { [string]: boolean },

	-- HBB Paket 10: Shop (Gratis-Griff, gemerkte Robux-Kaeufe)
	shop : ShopState,

	-- v13: Quest-Stand
	quests : QuestState,

	-- v14: Ei-Baum (ueberlebt Rebirths)
	eggTree : EggTreeState,

	-- v15: Tower-Rekorde und Meilensteine (ueberleben Rebirths)
	towers : TowerState,

	-- v15: taeglicher Login-Bonus
	daily : DailyState,

	-- Welcher Server den Spielstand gerade haelt (siehe Util/SessionLock).
	-- Nur serverseitig, geht nie an den Client. nil = niemand; das ist der
	-- Stand nach einem sauberen Verlassen und bei jedem alten Spielstand,
	-- deshalb ohne Versions-Sprung.
	session : SessionLock?,
}

--------------------------------------------------------------------------------
-- Netzwerk-Typen (Server → Client Updates)
--------------------------------------------------------------------------------

-- Wird nach jeder relevanten Aenderung gefeuert.
-- Stats werden bewusst weggelassen (kein Leak sensibler Serverdaten).
export type PlayerDataUpdate = {
	gummies      : number,
	goldGummies  : number,
	rebirthCount : number,
	rebirthMult  : number,
	rank         : Rank,
	language     : string?,
	island       : IslandData,
	discovered   : { [string]: boolean },
	quests       : QuestView,
	eggTree      : EggTreeState,   -- v14
	towers       : TowerState,     -- v15
	daily        : DailyView,      -- v15
	-- HBB Paket 2: fuer Fuehrung und Freischaltung (rein lesend im Client)
	stats        : { [string]: number }?,
	createdAt    : number?,
	uiSeen       : { [string]: boolean }?,   -- HBB Paket 3
	shop         : ShopView?,                -- HBB Paket 10
}

-- v15: was der Client fuer das Login-Bonus-Fenster braucht (fertig
-- ausgewertet vom Server, siehe LoginBonusService.buildView).
--   day        welcher Tag des Zyklus heute dran ist (1-7)
--   claimable  heute noch nicht abgeholt
--   streak     schon abgeholte Tage im laufenden Zyklus
--   resetIn    Sekunden bis zum naechsten UTC-Tag
export type DailyView = {
	day       : number,
	claimable : boolean,
	streak    : number,
	resetIn   : number,
}

-- Eine einzelne Kampf-AKTION (v14: Runden-Log). Bleibt serverseitig in
-- CombatCalculator und wird NICHT komplett an den Client geschickt: ein
-- PIT-Lauf hat viele Stages, das ganze Protokoll waere ein Vielfaches der
-- Nutzlast. Der Client bekommt pro Stage nur die Zusammenfassung
-- (PitStageResult.skillUses / firstSkillRound) — genug fuer die SkillFX.
--
-- Seit v14 handelt jeder Kaempfer nach seiner SPD (siehe CombatCalculator),
-- ein Eintrag ist deshalb EINE Aktion von A oder B, nicht mehr eine
-- Doppelrunde.
export type RoundLogEntry = {
	roundNumber     : number,     -- wievielte Aktion von A (der Baerchi)
	actor           : string,     -- "A" | "B"
	-- v15: was in diesem Zug passiert ist: "hit" (Stoss), "skill"
	-- (Faehigkeit), "burst" (Feuerstoss nach Letzter Chance), "stunned"
	kind            : string,
	chargeA         : number,     -- v15: Ladestand von A nach dem Zug (0..1)
	skillUsed       : boolean,
	skillId         : string?,
	damage          : number,     -- wirklich abgezogene HP beim Ziel
	heal            : number,
	absorbed        : number,     -- vom Schild abgefangen
	effects         : { string }?, -- "stun", "slow", "dot", "burn:12", "laststand" ...
	attackerHpAfter : number,     -- HP von A nach der Aktion
	defenderHpAfter : number,     -- HP von B nach der Aktion
}

-- v15: ein Zug fuer die WIEDERGABE in der Arena (aus RoundLogEntry
-- verdichtet). Bleibt serverseitig: CombatService baut die Liste,
-- PitArenaService spielt sie ab (Stoesse, Faehigkeiten, Lebens- und
-- Ladeleisten). HP und Ladung als Anteil 0..1, damit die Leisten direkt
-- gesetzt werden koennen.
export type FightBeat = {
	actor   : string,    -- "A" = der Baerchi, "B" = der Gegner
	kind    : string,    -- "hit" | "skill" | "burst" | "stunned"
	selfHp  : number,    -- HP des Baerchis nach dem Zug (0..1)
	enemyHp : number,    -- HP des Gegners nach dem Zug (0..1)
	charge  : number,    -- Ladestand der Faehigkeit des Baerchis (0..1)
	skillId : string?,   -- bei "skill"/"burst"
}

-- Eine bestandene (oder verlorene) Stage innerhalb eines PIT-Laufs.
export type PitStageResult = {
	stage      : number,
	won        : boolean,
	rounds     : number,
	hpAfter    : number,   -- HP des Baerchis NACH dieser Stage
	gummiesWon : number,
	-- v14: fuer die Fähigkeiten-Animation (SkillFX)
	skillUses       : number?,   -- wie oft der Skill in dieser Stage kam
	firstSkillRound : number?,   -- erste Aktion mit Skill (nil = keiner)
}

-- Ergebnis eines kompletten PIT-Laufs.
--
-- Ein Lauf ist kein einzelner Kampf mehr: der Baerchi kaempft Stage fuer
-- Stage weiter, solange er ueberlebt. Seine HP werden zwischen den Stages
-- NICHT zurueckgesetzt — der Lauf endet erst wenn er verliert. Danach steht
-- er erschoepft (hpAfter, meist 0) auf dem Plot und muss mit Honig
-- hochgefuettert werden.
export type PitRunResult = {
	baerchiUid    : string,
	towerId       : string?,          -- v15: in welchem Tower der Lauf war
	capStage      : number?,          -- v15: Deckel des Rebirths in diesem Tower (Belohnung/Rekord nur bis hier)
	capReached    : boolean?,         -- v15: der Lauf hat den Deckel erreicht (Rebirth-Hinweis)
	newRecord     : number?,          -- v15: neuer Tower-Rekord (nil = keiner)
	startStage    : number,           -- v12: erste gespielte Stage (1 = von vorn, sonst Fortsetzung)
	recalled      : boolean,          -- v12: true = vom Spieler nach einer Stage zurueckgeholt
	corrected     : boolean?,         -- v12: true = nachgeschicktes, gekuerztes Ergebnis nach dem Zurueckholen
	stagesCleared : number,           -- wie viele Stages gewonnen wurden
	stages        : { PitStageResult },
	gummiesWon    : number,           -- Summe ueber alle Stages, bereits mit rebirthMult
	goldGummiesWon: number,           -- Meilenstein-Belohnung (siehe EconomyConfig)
	hpBefore      : number,           -- HP mit denen der Lauf gestartet wurde
	hpAfter       : number,
	maxHp         : number,
}

-- Ergebnis einer Fuetterung: ein Honig heilt und gibt XP.
export type FeedResult = {
	baerchiUid : string,
	buildingId : BuildingId,   -- aus welchem Gebaeude der Honig kam
	hpGained   : number,
	xpGained   : number,
	leveledUp  : boolean,
	newLevel   : number,
	hpAfter    : number,
	maxHp      : number,
}

export type HatchResult = {
	eggType  : EggType,
	baerchi  : Baerchi,
	isNew    : boolean,   -- erstes Mal dieser configId → besondere Animation
}

-- Ergebnis eines Charm-Wurfs, eines Events oder einer Fusion enthaelt den
-- Baerchi selbst — `mutation` steht dort mit drin, ein eigener Typ dafuer
-- waere ueberfluessig.

export type FusionResult = {
	resultBaerchi : Baerchi,
	consumedUids  : { string },
}

export type RecycleResult = {
	consumedUid   : string,
	gummiesGained : number,
	goldGummiesGained : number,
}

-- Ergebnis einer Befoerderung (PromotionService).
export type PromotionResult = {
	baerchiUid       : string,
	newPromotion     : number,      -- 1 - PromotionConfig.MAX_PROMOTION
	consumedUids     : { string },  -- die verbrauchten Duplikate
	unlockedSlots    : { number },  -- Charm-Slots, die durch DIESE Stufe dazukamen
}

-- Ergebnis eines Charm-Wurf-Pakets (CharmService).
--
-- `rolls` ist die Anzahl der tatsaechlich durchgefuehrten Wuerfe: bei einem
-- Auto-Roll kann sie kleiner sein als angefragt, wenn zwischendurch die
-- GoldGummies ausgehen. Der Client zeigt genau diese Zahl an, nicht die
-- angefragte — sonst behauptet die Oberflaeche etwas, das nicht passiert ist.
export type CharmRollResult = {
	baerchiUid       : string,
	rolls            : number,
	goldGummiesSpent : number,
	charms           : { Charm },   -- Stand NACH allen Wuerfen
}

-- Ein gelegtes Ei wurde eingesammelt (fuer den Toast beim Spieler).
export type EggCollectResult = {
	eggUid   : string,
	eggType  : EggType,
	inStock  : number,   -- wie viele von dieser Sorte jetzt im Lager liegen
}

-- Beim Join nachgerechnete Eier aus der Abwesenheit. Wird zusammen mit dem
-- Honig-Bericht gezeigt (siehe OfflineReport) — aber als eigener Typ, weil
-- die beiden Systeme sonst aneinander haengen wuerden.
export type OfflineEggReport = {
	laid        : number,   -- wie viele Eier nachgelegt wurden
	skipped     : boolean,  -- true wenn die Obergrenze das Nachlegen gebremst hat
	secondsAway : number,
}

-- Was eine Event-Teilnahme gebracht hat (EventParticipationService).
--
-- Heisst weiterhin "StatGain", weil die Stat-Stufe der Kern der Belohnung ist —
-- seit dem Event-Katalog (EventConfig) kann aber zusaetzlich ein Bonus dazu
-- kommen, und in einem Fall NUR der Bonus.
export type EventStatGain = {
	baerchiUid : string,
	eventId    : string,

	-- Welcher Stat gestiegen ist ("hp" | "atk" | "spd" | "pwr" | "egg").
	--
	-- nil heisst: es gab KEINE Stat-Stufe, weil bereits jeder Stat dieses
	-- Baerchis an seiner Rarity-Obergrenze steht. Der Bonus unten wurde
	-- trotzdem vergeben — deshalb ist das kein Fehlerfall, und der Client muss
	-- diesen Fall anzeigen koennen statt ihn zu verwerfen.
	statKey    : string?,
	newLevel   : number,   -- 0, wenn statKey nil ist
	cap        : number,

	-- Der Zusatz-Ertrag dieses Events als fertiger Text ("+1x Goldenes Ei").
	-- nil = dieses Event hatte keinen Bonus, oder der Wurf ging daneben
	-- (Mutations-Sturm). Bewusst als Text und nicht als Zahlenfeld pro
	-- Bonus-Art: der Client zeigt ihn nur an, und die Formulierung soll an
	-- EINER Stelle stehen (EventConfig.describeBonus bzw. der Ausgabe-Text in
	-- EventParticipationService).
	bonusText  : string?,

	-- Gesetzt, wenn der Baerchi durch dieses Event eine (bessere) Mutation
	-- bekommen hat — der seltenste Ausgang im ganzen Event-System, deshalb als
	-- eigenes Feld statt nur im Text: der Client faerbt den Hinweis damit ein.
	mutation   : MutationId?,

	-- true: Zwischenmeldung WAEHREND eines Events (UFO-Kampf, Fund, Entfuehrung)
	-- statt Abschlussmeldung. Der Client zeigt dann nur `bonusText`.
	midEvent   : boolean?,

	-- Neue Rarity, falls das UFO den Baerchi aufsteigen liess.
	rarityUp   : string?,
}

-- Telegraph einer Boss-Attacke (Server → alle Clients, Remotes.EventTelegraph).
-- Die Wahrheit (wer getroffen wird) rechnet der Server zum Zeitpunkt hitAt;
-- der Client zeichnet nur die Warnflaeche von jetzt bis hitAt.
--   kind = "ring"    Kreisring um `center` zwischen `inner` und `outer`
--   kind = "circles" Kreise mit Radius `radius` um jeden Punkt in `points`
--   kind = "lane"    Bahn von `from` nach `to`, Breite `width`
-- warnAt/hitAt sind Serverzeiten (workspace:GetServerTimeNow()).
export type HazardTelegraph = {
	kind   : "ring" | "circles" | "lane",
	center : Vector3?,
	inner  : number?,
	outer  : number?,
	points : { Vector3 }?,
	radius : number?,
	from   : Vector3?,
	to     : Vector3?,
	width  : number?,
	warnAt : number,
	hitAt  : number,
}

-- Treffer einer Boss-Attacke am eigenen Charakter (Server → ein Client,
-- Remotes.EventHazardHit). Der Server hat entschieden; der Client fuehrt nur
-- die Physik an seinem eigenen Charakter aus (er besitzt ihn).
export type HazardHit = {
	push        : Vector3,   -- Rueckstoss (Studs/s, waagerecht)
	slowFactor  : number,    -- WalkSpeed-Faktor fuer slowSeconds
	slowSeconds : number,
}

export type RebirthResult = {
	newRebirthCount : number,
	newMultiplier   : number,
	ascensionEggs   : number,   -- Summe aller Meilenstein-Eier (0 = keine), fuer alte Anzeigen
	-- v14: Meilenstein-Eier nach Sorte (Ascension, Transzendenz, Ewigkeit, Omega)
	milestoneEggs   : { { eggType: EggType, count: number } }?,
}

-- v14: ein Knoten im Ei-Baum ist frei geworden (fuer den Toast).
export type EggUnlockResult = {
	eggType : EggType,
	reason  : string,    -- "tree" | "blueprint" | "rebirth" | "migration"
}

-- v14: Ergebnis der Ei-Presse.
export type EggPressResult = {
	fromEgg : EggType,
	toEgg   : EggType,
	used    : number,
}

-- v15: ein Tower-Meilenstein wurde ausgezahlt (Toast).
export type TowerMilestoneReward = {
	towerId     : string,
	stage       : number,
	gummies     : number,   -- ohne Rebirth-Multiplikator
	goldGummies : number,
	eggType     : EggType?,
	eggs        : number,
	blueprints  : number,
	endlessLevels : number?, -- Paket 9: +Endless-Level fuer den ausgeruesteten Baerchi
}

-- v15: eine Zeile einer Bestenliste (Server → Client).
export type LeaderboardEntry = {
	rank   : number,
	userId : number,
	name   : string,
	value  : number,
}

-- v15: eine Bestenliste. listId = "Tower" | "Rebirths" | "Collection".
-- ownRank = Rang des Anfragenden (nil = nicht in den Top N).
export type LeaderboardView = {
	listId    : string,
	entries   : { LeaderboardEntry },
	ownRank   : number?,
	ownValue  : number,
	updatedAt : number,
}

-- v15: die Profilkarte eines anderen Spielers (Inspektor). Der Server baut sie
-- aus den Daten im Speicher — rohe PlayerData gehen nie an fremde Clients.
export type ProfileBaerchi = {
	configId  : string,
	rarity    : Rarity,
	mutation  : MutationId?,
	level     : number,
	promotion : number,
	power     : number,   -- grobe Staerke (fuer die Top-3-Sortierung)
}

export type PlayerProfileCard = {
	userId       : number,
	name         : string,
	equipped     : ProfileBaerchi?,
	highestTower : string,
	towerRecord  : number,
	rebirths     : number,
	indexCount   : number,
	indexTotal   : number,
	top          : { ProfileBaerchi },
}

-- v15: Ergebnis des Login-Bonus (Toast).
export type DailyBonusResult = {
	day         : number,
	gummies     : number,
	goldGummies : number,
	eggType     : EggType?,
	eggs        : number,
	blueprint   : boolean,
}

-- Offline-Ertrag beim Join (Server → Client, direkt nach dem ersten Sync).
-- Seit v4 ist das der Honig, den die Gebaeude waehrend der Abwesenheit
-- produziert haben — gedeckelt durch EconomyConfig.HONEY_CAPACITY pro
-- Gebaeude, laenger weg bringt also nichts zusaetzlich.
export type OfflineReport = {
	secondsAway  : number,
	honeyGained  : number,
}

--------------------------------------------------------------------------------
-- Default-Fabrik (nur PlayerService darf dies aufrufen)
--------------------------------------------------------------------------------

local function createDefaultPlayerData(): PlayerData
	local now = os.time()

	local data: PlayerData = {
		-- v11: das binaere isInverted-Feld weicht dem gestuften Mutation-System
		-- (siehe Baerchi.mutation und BaerchiConfig.MUTATIONS). Die Migration in
		-- PlayerService bildet alte isInverted=true-Eintraege auf eine feste
		-- Mutation ab und entfernt das alte Feld — DAS ist der Grund, warum
		-- diese Zahl steigen MUSS: es wird wieder etwas ENTFERNT, nicht nur
		-- ein fehlendes Feld angelegt (dieselbe Konvention wie beim v9-Sprung).
		--
		-- v10: der ausgeruestete Baerchi legt Eier. Neu sind island.laidEggs
		-- und island.lastEggAt; die Migration legt beide an.
		--
		-- v9: DEF ist ersatzlos entfallen, PWR (Ability-Staerke) ist an seine
		-- Stelle getreten, und jeder Baerchi hat ein isInverted-Feld bekommen.
		-- Die Migration (Util/PlayerMigration) raeumt dafuer die alten def-Eintraege
		-- aus statLevels und baseStatOverride weg — DAS ist der Grund, warum
		-- diese Zahl steigen MUSS: die Migration entfernt etwas, statt nur ein
		-- fehlendes Feld anzulegen.
		--
		-- v8: jeder Baerchi hat drei neue Felder bekommen (promotionLevel,
		-- statLevels, charms) plus das optionale baseStatOverride. Die
		-- zugehoerige Migration (Util/PlayerMigration) legt sie auf bestehenden
		-- Baerchis an — sie erkennt fehlende Felder selbst und ist deshalb
		-- gefahrlos wiederholbar.
		--
		-- v7: eigene Rolle pro Gebaeude. KEIN neues Feld — die Zahl stieg
		-- trotzdem, weil die zugehoerige Migration (Util/PlayerMigration) einen Wert
		-- UMRECHNET (die Presse erbt einmalig das hoechste Gebaeude-Level) und
		-- deshalb genau einmal laufen darf.
		-- v13: Quests + Index. Neu: discovered, quests, stats.totalHatched. Die
		-- Migration seedet discovered aus den vorhandenen Baerchis und setzt
		-- totalHatched auf deren Anzahl, damit Veteranen nicht bei null starten.
		-- v12: Brut-Slots entfallen (Eier werden sofort geoeffnet), die
		-- Migration legt laufende Bruten zurueck ins Lager und ENTFERNT
		-- island.hatchingEggs. Neu: island.pitProgress (optional).
		-- v15: Gebaeude Option B (Honigtopf + Honig-Presse -> HoneyRefiner),
		-- Level 1-60, Tower statt PIT-Level (towers, island.towerProgress,
		-- island.pitRefund), Login-Bonus (daily). Die Migration RECHNET um
		-- (Veredler-Level, PIT-Erstattung, alter Rekord) — deshalb Sprung.
		version    = 15,  -- v15: Tower + Gebaeude B + Login-Bonus, v14: Ei-Baum, v13: Quests + Index (discovered, quests, stats.totalHatched), v12: Sofort-Oeffnen + pitProgress, v11: Mutation-System (v10: Eier legen, v9: PWR statt DEF + Inverted, v8: Promotion/Charms/Stat-Level, v7: Gebaeude-Rollen, v6: equippedUid, v5: Ei-uid, v4: Honig-Gebaeude + currentHp)
		createdAt  = now,
		lastSeenAt = now,

		gummies     = 100,
		goldGummies = 0,

		rebirthCount = 0,
		rebirthMult  = 1.0,

		rank = {
			tier   = 1,
			name   = "Gummy Hatchling",
			points = 0,
		},

		island = {
			-- Beide Honig-Gebaeude stehen ab dem ersten Join auf dem Plot und
			-- fangen sofort an zu produzieren.
			buildings = {
				Beehive      = { id = "Beehive",      level = 1, honey = 0, lastProducedAt = now },
				HoneyRefiner = { id = "HoneyRefiner", level = 1, honey = 0, lastProducedAt = now },
				HoneyPond    = { id = "HoneyPond",    level = 1, honey = 0, lastProducedAt = now },
			},
			baerchis     = {},
			eggStock     = {
				BasicEgg = 3,  -- Starter-Eier fuer den ersten Join
			},
			equippedUid  = nil,   -- noch kein Baerchi da, der ausgeruestet sein koennte

			laidEggs  = {},
			lastEggAt = now,

			recycler = { level = 1, queued = 0, progress = 0, lastProcessedAt = now },

			towerProgress = {},
			pitRefund     = 0,
		},

		stats = {
			totalGummiesEarned  = 0,
			totalFightsWon      = 0,
			totalFightsLost     = 0,
			totalFusions        = 0,
			totalRebirths       = 0,
			totalRecycled       = 0,
			totalHatched        = 0,
			totalEventsCompleted = 0,
			sessions             = 0,   -- HBB Paket 10: Sitzungen (Shop ab der 2.)
		},

		-- HBB Paket 10: Shop (Modules/ShopRules). freeGrabDay = UTC-Tag des
		-- letzten Gratis-Griffs (-1 = nie), receipts = gemerkte Robux-Kauf-IDs.
		shop = { freeGrabDay = -1, receipts = {} },

		discovered = {},
		uiSeen     = {},

		eggTree = {
			unlocked   = { BasicEgg = true, SugarEgg = true },
			hatched    = {},
			pressed    = {},
			blueprints = 0,
			bypass     = {},
		},

		towers = {
			records      = {},
			claimed      = {},
			highestTower = "I",
			selected     = "I",
		},

		daily = {
			lastClaimDay = 0,
			streak       = 0,
		},

		quests = {
			chainClaimed = 0,
			day          = 0,   -- 0 = noch nie gesetzt; QuestService setzt beim Join den Tag
			baseline     = { hatched = 0, fightsWon = 0, gummies = 0 },
			dailyClaimed = {},
		},
	}

	-- Honig-Teich oder Stock + Veredler, je nach Schalter (neue Spieler und
	-- Rebirth gehen beide hierueber).
	HoneyPondMode.apply(data.island, FeatureFlags.isOn("HONEY_POND_V2"), now)
	return data
end

return {
	createDefaultPlayerData = createDefaultPlayerData,
}]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="Folder" referent="RBX41"><Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Folder" referent="RBX42"><Properties>
<string name="Name">Core</string>
</Properties>
<Item class="Script" referent="RBX43"><Properties>
<string name="Name">GameManager</string>
<bool name="Disabled">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- GameManager.server.luau
-- ServerScriptService/Core/GameManager.server.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Services laden und in drei Phasen starten
--
-- Kein anderes Skript startet Services. Die drei Phasen:
--   1. laden   alle Module per require — danach existiert jedes Modul
--   2. init()  jeder Service richtet sich ein: Remotes verbinden, Rueckrufe
--              bei anderen Services anmelden (onDataLoaded, onEventEnded ...)
--   3. start() erst jetzt passiert etwas mit Spielern oder Zeit: PlayerService
--              laedt verbundene Spieler, EventService startet den Zyklus
--
-- Weil kein Service in init() schon Spieler verarbeitet, ist die Reihenfolge
-- in REGISTRY beliebig: jeder Rueckruf ist angemeldet, bevor der erste
-- Spieler geladen wird. Ein neuer Service traegt sich irgendwo ein und
-- verschiebt Arbeit mit Spielern in ein start().

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService          = game:GetService("RunService")

-- ALLERERSTE Zeile mit Wirkung, bevor irgendein Service laedt: kein Spieler
-- soll automatisch in der Weltmitte landen. Stattdessen spawnt PlayerService
-- jeden Spieler explizit auf seiner eigenen Insel (player:LoadCharacter(),
-- erst NACHDEM MapService.spawnIsland sein RespawnLocation gesetzt hat — siehe
-- PlayerService.onPlayerAdded). Muss vor jedem require() stehen: ein Spieler
-- kann in Studio-Play-Solo bereits verbunden sein, sobald dieses Skript
-- ueberhaupt zu laufen beginnt.
Players.CharacterAutoLoads = false

-- Der Name links ist nur fuer den Studio-Debug-Hook am Ende der Datei
-- relevant. Gruppiert nach Thema, nicht nach Abhaengigkeit.
local REGISTRY: { { name: string, module: ModuleScript } } = {
	-- Infrastruktur
	{ name = "RateLimiter",    module = ServerScriptService.Util.RateLimiter },
	{ name = "PlayerService",  module = ServerScriptService.Services.PlayerService },
	{ name = "EconomyService", module = ServerScriptService.Services.EconomyService },

	-- Welt und Darstellung
	{ name = "MapService",              module = ServerScriptService.Services.MapService },
	{ name = "PlotDisplayService",      module = ServerScriptService.Services.PlotDisplayService },
	-- Welt aufwerten, Paket G: grosse Momente eines Spielers an alle melden
	{ name = "WorldMomentService",      module = ServerScriptService.Services.WorldMomentService },
	{ name = "BaerchiAutopilotService", module = ServerScriptService.Services.BaerchiAutopilotService },

	-- Insel, Honig, Eier
	{ name = "IslandService",      module = ServerScriptService.Services.IslandService },
	{ name = "HoneyService",       module = ServerScriptService.Services.HoneyService },
	{ name = "EggService",         module = ServerScriptService.Services.EggService },
	{ name = "EggMerchantService", module = ServerScriptService.Services.EggMerchantService },
	{ name = "EggLayService",      module = ServerScriptService.Services.EggLayService },
	{ name = "EggTreeService",     module = ServerScriptService.Services.EggTreeService },

	-- Kampf
	{ name = "PitArenaService", module = ServerScriptService.Services.PitArenaService },
	{ name = "CombatService",   module = ServerScriptService.Services.CombatService },
	{ name = "PetModeService",  module = ServerScriptService.Services.PetModeService },
	-- v15: Tower-Fortschritt (ersetzt das PIT-Level)
	{ name = "TowerService",    module = ServerScriptService.Services.TowerService },

	-- Events
	{ name = "EventService",              module = ServerScriptService.Services.EventService },
	{ name = "EventParticipationService", module = ServerScriptService.Services.EventParticipationService },

	-- Waben: Sammeln im Event-Pit und der Recycler auf dem Plot
	{ name = "CombRecyclerService", module = ServerScriptService.Services.CombRecyclerService },
	{ name = "CombService",         module = ServerScriptService.Services.CombService },

	-- Baerchis veraendern
	{ name = "FusionService",    module = ServerScriptService.Services.FusionService },
	{ name = "RecycleService",   module = ServerScriptService.Services.RecycleService },
	{ name = "PromotionService", module = ServerScriptService.Services.PromotionService },
	{ name = "CharmService",     module = ServerScriptService.Services.CharmService },
	{ name = "RebirthService",   module = ServerScriptService.Services.RebirthService },

	-- Meta
	{ name = "QuestService",    module = ServerScriptService.Services.QuestService },
	{ name = "SettingsService", module = ServerScriptService.Services.SettingsService },

	-- v15: Angeben (Bestenlisten, Inspektor, Abzeichen) und Login-Bonus
	{ name = "LeaderboardService", module = ServerScriptService.Services.LeaderboardService },
	{ name = "ProfileService",     module = ServerScriptService.Services.ProfileService },
	{ name = "PlayerBadgeService", module = ServerScriptService.Services.PlayerBadgeService },
	{ name = "LoginBonusService",  module = ServerScriptService.Services.LoginBonusService },

	-- HBB Paket 0: Messpunkte (Onboarding-Trichter, UI-Ereignisse)
	{ name = "FunnelService",      module = ServerScriptService.Services.FunnelService },
	-- HBB Paket 3: Anzeigestand (welche Bedienelemente schon gesehen sind)
	{ name = "UiStateService",     module = ServerScriptService.Services.UiStateService },
	-- HBB Paket 5: Heim-Knopf (zurueck auf den eigenen Plot)
	{ name = "HomeService",        module = ServerScriptService.Services.HomeService },
	-- HBB Paket 6: Live-Kampf-Board auf der Hauptinsel
	{ name = "LiveBoardService",   module = ServerScriptService.Services.LiveBoardService },
	-- HBB Paket 10: Shop (Gratis-Griff, Robux-Goldpakete)
	{ name = "ShopService",        module = ServerScriptService.Services.ShopService },

	-- Kein Spiel-Service: die Studio-Test-Schnittstelle
	{ name = "DebugService", module = ServerScriptService.Services.DebugService },
}

local loaded: { [string]: any } = {}

for _, entry in REGISTRY do
	loaded[entry.name] = require(entry.module)
end

for _, entry in REGISTRY do
	local service = loaded[entry.name]
	if service.init then
		service.init()
	end
end

for _, entry in REGISTRY do
	local service = loaded[entry.name]
	if service.start then
		service.start()
	end
end

--------------------------------------------------------------------------------
-- Studio-Debug-Hook
--
-- Legt die tatsaechlich laufenden Service-Instanzen unter _G.RBL ab.
-- Nur in Studio — im Live-Spiel existiert der Hook nicht.
--
-- ACHTUNG, gemessen und bestaetigt: die Studio Command Bar laeuft in einem
-- EIGENEN Lua-VM. Sie sieht dieses _G NICHT, und ein dortiges
-- require(ServerScriptService.Services.PlayerService) liefert eine zweite,
-- nie initialisierte Kopie des Moduls mit leerem _playerData — Aufrufe darauf
-- laufen still ins Leere. Zum Testen aus der Command Bar deshalb IMMER die
-- BindableFunction benutzen, die DebugService anlegt:
--
--   game.ServerScriptService.RBLDebug:Invoke("help")
--
-- _G.RBL ist nur fuer anderen Server-Code im selben VM gedacht.
--------------------------------------------------------------------------------

if RunService:IsStudio() then
	local debugTable: { [string]: any } = {}
	for name, service in loaded do
		debugTable[name] = service
	end

	-- Configs und Factories gleich mitgeben, die braucht man beim Testen staendig
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	debugTable.EconomyConfig  = require(ReplicatedStorage.Config.EconomyConfig)
	debugTable.BaerchiConfig  = require(ReplicatedStorage.Config.BaerchiConfig)
	debugTable.EggConfig      = require(ReplicatedStorage.Config.EggConfig)
	debugTable.BaerchiFactory = require(ReplicatedStorage.Modules.BaerchiFactory)

	_G.RBL = debugTable
	print("[GameManager] Studio-Debug-Hook aktiv — Zugriff ueber _G.RBL")
end

print("[GameManager] Alle Services gestartet")
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX44"><Properties>
<string name="Name">Services</string>
</Properties>
<Item class="ModuleScript" referent="RBX45"><Properties>
<string name="Name">BaerchiAutopilotService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- BaerchiAutopilotService.luau
-- ServerScriptService/Services/BaerchiAutopilotService.luau
--
-- Einzige Zustaendigkeit:
--   - Den AUSGERUESTETEN Baerchi von sich aus zum Honig-Teich auf dem
--     eigenen Plot laufen und dort essen lassen, sobald welcher da ist —
--     auch bei vollen HP, solange noch Level drin sind (siehe shouldEat
--     unten). Das Spiel ist auf laengeres AFK-Grinden ausgelegt: wer online
--     ist, aber gerade nicht selbst spielt, soll trotzdem weiter Fortschritt
--     machen, solange Honig produziert wird.
--
-- Essen ist seit dem Equip-System die einzige automatische Aktion im Spiel:
-- Kaempfen, Ausbauen und Fusion loest weiterhin der Spieler selbst aus. Es
-- gibt nur noch EINEN Baerchi auf dem Plot zu sehen (siehe MapService,
-- IslandService) — ein Fuetter-Knopf am Gebaeude fuer "irgendeinen erschoepften
-- Baerchi" waere ohne die anderen sichtbaren Baerchis ohnehin bedeutungslos.
-- Stattdessen kuemmert sich der ausgeruestete Baerchi selbst darum.
--
-- Die eigentliche Heilung/XP-Vergabe passiert weiterhin in HoneyService.feed
-- (einzige Stelle die Honig verbraucht) — dieser Service entscheidet nur WANN
-- und spielt das Hinlaufen sichtbar ab.
--
-- ActivityLock verhindert, dass der Baerchi gleichzeitig zum Teich laeuft
-- UND in den PIT geschickt wird; ein Kampf hat dabei immer Vorrang
-- (PitArenaService nimmt das Schloss notfalls per forceAcquire weg).

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local Types            = require(ReplicatedStorage.Network.Types)

local FigureWalker  = require(ServerScriptService.Util.FigureWalker)
local FigureFX      = require(ServerScriptService.Util.FigureFX)
local ActivityLock  = require(ServerScriptService.Util.ActivityLock)
local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)
local HoneyService  = require(ServerScriptService.Services.HoneyService)

local BaerchiAutopilotService = {}

local LOCK_HOLDER = "Autopilot"

-- Wie oft nachgesehen wird, ob der ausgeruestete Baerchi essen gehen sollte.
-- Muss nicht schnell sein: das Fuettern selbst ist nicht zeitkritisch, nur
-- regelmaessig genug, dass es sich von alleine anfuehlt.
local CHECK_INTERVAL = 3

-- Wie lange am Teich "gegessen" wird, bevor es zurueckgeht — rein optisch,
-- der eigentliche Honig-Abzug passiert sofort beim Ankommen. Diese Zeit wird
-- von der Vorbeuge-Bewegung (FigureFX.leanForward) genau ausgefuellt, statt
-- sie einfach abzuwarten.
local EAT_PAUSE_SECONDS = 1.2

local function footPosOf(model: Model): Vector3
	local box, size = model:GetBoundingBox()
	return Vector3.new(box.Position.X, box.Position.Y - size.Y * 0.5, box.Position.Z)
end

-- Braucht der ausgeruestete Baerchi gerade Honig, und ist welcher da?
--
-- Seit v8 gilt das auch bei VOLLEN HP: Honig ist die einzige XP-Quelle im
-- Spiel (siehe HoneyService, Kopf-Kommentar), und das Spiel ist bewusst auf
-- laengeres AFK-Grinden ausgelegt — der ausgeruestete Baerchi soll von
-- alleine weiteressen und -leveln, solange er auf dem Plot steht, nicht nur
-- wenn er gerade verletzt aus dem PIT kommt. Einzige Grenze ist das
-- Maximal-Level: darueber hinaus braechte weiteressen nichts mehr, und der
-- Honig bleibt dann fuer die Heilung nach dem naechsten Kampf liegen.
local function shouldEat(data: Types.PlayerData, baerchi: Types.Baerchi): boolean
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then return false end

	local maxHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
	if maxHp <= 0 then return false end

	if HoneyService.getTotalHoney(data) <= 0 then
		return false
	end

	local hpRatio = math.clamp(baerchi.currentHp or maxHp, 0, maxHp) / maxHp
	if hpRatio < 1 then
		return true
	end

	-- Voll geheilt: nur noch fuers Leveln weiteressen, und nur solange das
	-- ueberhaupt noch etwas bringt (Paket 9: mit offenem Endless immer).
	return baerchi.level < BaerchiConfig.MAX_LEVEL or TowerConfig.isEndlessOpen(data.towers.records)
end

local function runEatCycle(player: Player, baerchiUid: string)
	if not ActivityLock.tryAcquire(player, LOCK_HOLDER) then
		return
	end

	task.spawn(function()
		-- Wird gesetzt, sobald feststeht welche Figur bewegt wird — damit sie
		-- nach der Sequenz (auch nach einem Fehler) wieder atmen darf.
		local moved: Model? = nil

		local ok, err = pcall(function()
			local figure = MapService.getBaerchiModel(player, baerchiUid)
			local pond   = MapService.getPondPosition(player)
			if not figure or not pond then
				return
			end

			-- Ruhe-Atmen abschalten, BEVOR der Heimat-Fusspunkt gemessen wird:
			-- sonst waere der gemerkte Punkt um einen Teil des Hubs zu hoch und
			-- der Baerchi kaeme jedes Mal ein Stueckchen ueber dem Boden an.
			-- Ausserdem wuerden sich Idle-Loop und Lauf sonst gegenseitig
			-- ueberschreiben.
			moved = figure
			FigureFX.stopIdle(figure)

			local homeFoot = footPosOf(figure)

			-- Bricht ab, sobald irgendetwas dem Baerchi das Schloss abnimmt
			-- (ein Kampf), er von der Karte verschwindet, oder gar nicht mehr
			-- der ausgeruestete Baerchi ist (equipBaerchi hat inzwischen die
			-- Figur ausgetauscht).
			local function cancelled(): boolean
				return ActivityLock.owner(player) ~= LOCK_HOLDER
					or player.Parent == nil
					or figure.Parent == nil
					or MapService.getBaerchiModel(player, baerchiUid) ~= figure
			end

			FigureWalker.walk(figure, homeFoot, pond, {
				speed       = MapConfig.WALK_SPEED,
				isCancelled = cancelled,
			})
			if cancelled() then return end

			-- HoneyService.feed prueft selbst nochmal ob es sich noch lohnt
			-- (Honig da, Baerchi nicht laengst anderweitig geheilt) — der
			-- Lauf zum Teich dauert ein paar Sekunden, in denen sich das
			-- theoretisch geaendert haben kann.
			if PlayerService.getData(player) then
				HoneyService.feed(player, baerchiUid)
			end

			-- Statt die Fress-Pause einfach abzuwarten: sich hinunterbeugen,
			-- kurz unten bleiben, wieder aufrichten. Dauert exakt so lange wie
			-- das bisherige task.wait — die Sequenz wird also nicht laenger,
			-- man sieht nur, dass er frisst.
			FigureFX.leanForward(figure, MapConfig.EAT_LEAN_DEGREES, EAT_PAUSE_SECONDS)
			if cancelled() then return end

			FigureWalker.walk(figure, pond, homeFoot, {
				speed       = MapConfig.WALK_SPEED,
				isCancelled = cancelled,
			})
		end)

		if not ok then
			warn("[BaerchiAutopilotService] Ess-Sequenz fehlgeschlagen:", err)
		end

		-- Wieder atmen lassen — aber NUR wenn die Figur noch uns gehoert.
		-- Wurde die Sequenz abgebrochen, weil ein Kampf das Schloss per
		-- forceAcquire uebernommen hat, bewegt PitArenaService die Figur
		-- gerade selbst; ein Idle-Loop wuerde ihm dabei dazwischenfunken.
		-- Dieselbe Bedingung, unter der auch das Schloss noch unseres ist.
		if moved and moved.Parent ~= nil and ActivityLock.owner(player) == LOCK_HOLDER then
			FigureFX.idleBob(moved, {
				height = MapConfig.IDLE_BOB_HEIGHT,
				rate   = MapConfig.IDLE_BOB_RATE,
			})
		end

		ActivityLock.release(player, LOCK_HOLDER)
	end)
end

local function tick()
	for _, player in Players:GetPlayers() do
		local data = PlayerService.getData(player)
		if not data then continue end

		local uid = data.island.equippedUid
		if not uid then continue end

		local baerchi = data.island.baerchis[uid]
		if not baerchi then continue end

		if ActivityLock.isFree(player) and shouldEat(data, baerchi) then
			runEatCycle(player, uid)
		end
	end
end

function BaerchiAutopilotService.init()
	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)

			local ok, err = pcall(tick)
			if not ok then
				warn("[BaerchiAutopilotService] Tick fehlgeschlagen:", err)
			end
		end
	end)

	print("[BaerchiAutopilotService] Initialisiert | Intervall:", CHECK_INTERVAL, "s")
end

return BaerchiAutopilotService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX46"><Properties>
<string name="Name">DebugService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- DebugService.luau
-- ServerScriptService/Services/DebugService.luau
--
-- Einzige Zustaendigkeit:
--   - Test-Befehle aus der Studio Command Bar entgegennehmen
--
-- NUR IN STUDIO. Im veroeffentlichten Spiel macht init() nichts und die
-- BindableFunction existiert nicht.
--
-- Warum eine BindableFunction und nicht einfach _G oder ein require?
--   Die Command Bar laeuft in einem eigenen Lua-VM. Sie hat deshalb
--     * ihren eigenen require-Cache  → require(PlayerService) liefert dort eine
--       ZWEITE, nie initialisierte Kopie mit leerem _playerData, und
--     * ihr eigenes _G               → im Server gesetzte Globals sind unsichtbar.
--   Aufrufe auf der Kopie laufen still ins Leere, was beim Testen extrem
--   verwirrend ist. Eine BindableFunction ist eine Instanz im DataModel:
--   ihr OnInvoke wurde vom echten Server-Script gesetzt und laeuft daher
--   garantiert im echten Server-VM, mit dem echten Zustand.
--
-- Benutzung (Command Bar, Server-Kontext, Play laeuft):
--   local D = game.ServerScriptService.RBLDebug
--   D:Invoke("info")
--   D:Invoke("give", 100000, 1000)
--   D:Invoke("add", "RedBaerchi", 10)
--   D:Invoke("add", "RedBaerchi", 10, "Rainbow")   -- Mutation (siehe BaerchiConfig.MUTATIONS)
--   D:Invoke("stats", uid)                    -- Kampfwerte inkl. PWR
--   D:Invoke("list")
--   D:Invoke("fuse", uidA, uidB)
--   D:Invoke("recycle", uid)
--   D:Invoke("building", "Beehive", 5)   -- Level 1-60 (v15), Look folgt automatisch
--   D:Invoke("building", "HoneyRefiner", 60)
--   D:Invoke("hatch", "BasicEgg")   -- legt ein Ei ins Lager und oeffnet es sofort (v12)
--   D:Invoke("egg", "GoldenEgg", 5) -- 5 Eier ins Lager legen (ohne zu oeffnen)
--   D:Invoke("pitprogress", 12)     -- letzten Lauf im gewaehlten Tower auf Stage 12 setzen (Fortsetzungs-Test)
--   D:Invoke("petmode")             -- aktueller Zustand der Pet-Leiste
--   D:Invoke("pm", "Fight", "Last")  -- wie ein Klick auf die Pet-Leiste
--   D:Invoke("honey")               -- alle Honig-Lager sofort voll
--   D:Invoke("feed", uid, 20)       -- 20x fuettern (heilt + gibt XP)
--   D:Invoke("fight", uid)          -- kompletter Lauf im gewaehlten Tower
--   D:Invoke("rebirth")
--
-- v8 (Promotion / Charms / Event-Teilnahme):
--   D:Invoke("promote", uid)        -- braucht genug Duplikate, siehe "add"
--   D:Invoke("charms", uid)         -- alle acht Slots im Klartext
--   D:Invoke("roll", uid, 5)        -- 5x wuerfeln (kostet GoldGummies)
--   D:Invoke("lock", uid, 1)        -- Slot I sperren/freigeben
--   D:Invoke("event")               -- ausgeruesteten Baerchi zum Event schicken
--   D:Invoke("skipevent")           -- laufende Phase sofort beenden
--   D:Invoke("events")              -- Katalog: alle Events mit ihrer Belohnung
--   D:Invoke("startevent", "ZauberZirkel")  -- genau dieses Event sofort starten
--
-- v10 (Eier legen):
--   D:Invoke("eggs")            -- was liegt herum, wie schnell legt er, welche Chancen
--   D:Invoke("lay", 5)          -- 5 Eier sofort legen (ohne aufs Intervall zu warten)
--   D:Invoke("collect")         -- alles einsammeln
--   D:Invoke("eggtime", 60)     -- Zeitmarke 60 Minuten zurueck, Tick legt nach
--
-- v15 (Waben im Event-Pit, Recycler):
--   D:Invoke("combs", 20)           -- 20 Waben sofort ins Pit legen (Stand ausgeben)
--   D:Invoke("queue", 50)           -- 50 Wabeneinheiten in die Recycler-Warteschlange
--   D:Invoke("recycler", 5)         -- Recycler-Level setzen (ohne Kosten), Stand ausgeben
--
-- v15 (Tower, Gebaeude 1-60, Angeben, Login-Bonus):
--   D:Invoke("tower", "II", 20)     -- Tower II waehlen und ab Stage 20 kaempfen (Fortsetzung gratis)
--   D:Invoke("towerrecord", "III", 45) -- Rekord setzen (Meilensteine bis dorthin werden ausgezahlt)
--   D:Invoke("rebirthcap")          -- Deckel des aktuellen Rebirths in allen Towern
--   D:Invoke("dailyshift", 1)       -- Login-Bonus: so tun, als waeren 1 Tag(e) vergangen
--   D:Invoke("lbflush")             -- Bestenlisten sofort schreiben und neu lesen
--   D:Invoke("parts")               -- Teile auf der eigenen Insel zaehlen (Budget 250)
--   D:Invoke("v14save")             -- Spielstand im alten v14-Format simulieren + migrieren
--
-- v17 (lebendige Events):
--   D:Invoke("startevent", "Ufo")   -- UFO-Patrouille mit Abwuerfen
--   D:Invoke("jackpot")             -- naechster UFO-Abwurf ist sicher ein Jackpot (Stand des Pity-Zaehlers)
--   D:Invoke("combtheme", "HotEgg") -- Wabenthema setzen ("off" = normal)
--   D:Invoke("launch", 10)          -- 10 Waben einfliegen lassen (Vulkan aus der Mitte)
--   D:Invoke("startevent", "WaspQueen") -- Boss-Event sofort (laeuft sonst nur jeden 2. Durchlauf)
--
-- v14 (Mega Egg Tree):
--   D:Invoke("tree")                 -- alle 20 Knoten mit Bedingungen und Stand
--   D:Invoke("unlock", "SunEgg")     -- einen Knoten freischalten ("all" = alle)
--   D:Invoke("hatched", "SugarEgg", 15) -- Hatch-Zaehler setzen (Freischalt-Test)
--   D:Invoke("blueprint", 1)         -- Blaupausen gutschreiben
--   D:Invoke("useblueprint", "PlatinumEgg")
--   D:Invoke("press", "SugarEgg", "Void") -- 5 Zucker-Eier -> 1 Nebel-Ei
--   D:Invoke("setrebirth", 10)       -- Rebirth-Zaehler setzen (ohne Reset)
--   D:Invoke("skilltest", "OmegaBaerchi", 30) -- einen Kampf mit Runden-Log
--   D:Invoke("snapshot")             -- Spielstand merken (fuer Tests)
--   D:Invoke("restore")              -- gemerkten Spielstand zurueckschreiben
--
-- Welt aufwerten (08.10.2026, nur Optik, setzt workspace-Attribute fuer die
-- Client-Controller; alle Test-Clients sehen dasselbe):
--   D:Invoke("worldshots", 1)        -- Kamera auf festen Punkt 1..6 (UI aus), 0 = zurueck
--   D:Invoke("daytime", 19)          -- Tageslauf auf feste Uhrzeit, "auto" = Zyklus
--   D:Invoke("pitstate", "soon")     -- Pit-Rahmen: idle | soon | live | auto
--   D:Invoke("neststate", "boss")    -- Wespen-Nest: calm | boss | auto
--   D:Invoke("arrival")              -- Ankunft (Blasen + Bienen) erneut abspielen
--   D:Invoke("fish")                 -- sofort einen Honig-Fisch springen lassen
--   D:Invoke("islandstage", 4)       -- Insel-Deko Stufe 1..4 zeigen ("auto" = aus dem Fortschritt)
--   D:Invoke("pondfull")             -- Teich bis zum Rand fuellen (Ueberlauf-Tropfen)
--   D:Invoke("spectators", "hop")    -- Zuschauer an der eigenen Arena: hop | cheer
--   D:Invoke("record")               -- Rekord-Moment am eigenen Schau-Turm (Flagge glaenzt, Jubel)
--   D:Invoke("moment", "hatch", "Cosmic") -- Welt-Moment an alle: hatch <Rarity> | tower <Id> | record | rebirth | mutation <Id>
--   D:Invoke("moments5")             -- fuenf grosse Momente gleichzeitig (Drosselung pruefen)
--   (Event-Start und Boss: D:Invoke("pitstate", "live") / D:Invoke("neststate", "boss"))
--
-- HBB Paket 0 (Test-Zustaende, erst "snapshot"):
--   D:Invoke("state", "fresh")       -- neues Konto, Trichter F01–F10 misst
--   D:Invoke("state", "hatch10")     -- dazu zehn geoeffnete Basis-Eier
--   D:Invoke("state", "tower1")      -- dazu Tower I geschafft (Rekord 30)
--
-- Ein kompletter Event-Durchlauf ohne acht Minuten Wartezeit:
--   D:Invoke("skipevent")   → Pause endet, Event laeuft
--   D:Invoke("event")       → Baerchi laeuft hin (ein paar Sekunden abwarten)
--   D:Invoke("skipevent")   → Event endet, Stat-Stufe wird vergeben
--
-- Rueckgaben sind einfache Tabellen/Zahlen — BindableFunctions kopieren
-- Werte ueber die VM-Grenze, Funktionen und Metatables kommen nicht durch.

local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local CharmConfig      = require(ReplicatedStorage.Config.CharmConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local BaerchiFactory   = require(ReplicatedStorage.Modules.BaerchiFactory)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggCalculator    = require(ReplicatedStorage.Modules.EggCalculator)
local CombConfig       = require(ReplicatedStorage.Config.CombConfig)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local IslandService  = require(ServerScriptService.Services.IslandService)
local EggService     = require(ServerScriptService.Services.EggService)
local CombatService  = require(ServerScriptService.Services.CombatService)
local FusionService  = require(ServerScriptService.Services.FusionService)
local RecycleService = require(ServerScriptService.Services.RecycleService)
local RebirthService = require(ServerScriptService.Services.RebirthService)
local HoneyService   = require(ServerScriptService.Services.HoneyService)
local MapService     = require(ServerScriptService.Services.MapService)

-- v8
local PromotionService          = require(ServerScriptService.Services.PromotionService)
local CharmService              = require(ServerScriptService.Services.CharmService)
local EventService              = require(ServerScriptService.Services.EventService)
local EventParticipationService = require(ServerScriptService.Services.EventParticipationService)

-- v10
local EggLayService             = require(ServerScriptService.Services.EggLayService)

-- v14
local EggTreeService            = require(ServerScriptService.Services.EggTreeService)
local EggTree                   = require(ReplicatedStorage.Modules.EggTree)
local CombatConfig              = require(ReplicatedStorage.Config.CombatConfig)

-- v12
local PetModeService            = require(ServerScriptService.Services.PetModeService)
local PitArenaService           = require(ServerScriptService.Services.PitArenaService)

-- v15 (Waben)
local CombService               = require(ServerScriptService.Services.CombService)
local CombRecyclerService       = require(ServerScriptService.Services.CombRecyclerService)

-- v15 (Tower, Angeben, Login-Bonus)
local TowerConfig               = require(ReplicatedStorage.Config.TowerConfig)
local TowerService              = require(ServerScriptService.Services.TowerService)
local LeaderboardService        = require(ServerScriptService.Services.LeaderboardService)
local LoginBonusService         = require(ServerScriptService.Services.LoginBonusService)
local PlayerMigration           = require(ServerScriptService.Util.PlayerMigration)

-- v17 (lebendige Events)
local JackpotRoll               = require(ServerScriptService.Util.JackpotRoll)

-- HBB Paket 0
local FunnelService             = require(ServerScriptService.Services.FunnelService)

local DebugService = {}

local BINDABLE_NAME = "RBLDebug"

--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

-- Der erste Spieler im Server. Fuer Solo-Tests in Studio genau richtig.
local function firstPlayer(): Player?
	return Players:GetPlayers()[1]
end

local function requireData(): (Player?, Types.PlayerData?, string?)
	local player = firstPlayer()
	if not player then
		return nil, nil, "Kein Spieler im Spiel — laeuft der Play-Modus?"
	end

	local data = PlayerService.getData(player)
	if not data then
		return player, nil, "Daten fuer " .. player.Name .. " noch nicht geladen"
	end

	return player, data, nil
end

local function countBaerchis(data: Types.PlayerData): number
	local n = 0
	for _ in data.island.baerchis do n += 1 end
	return n
end

--------------------------------------------------------------------------------
-- Befehle
--------------------------------------------------------------------------------

local commands: { [string]: (Player, Types.PlayerData, ...any) -> any } = {}

commands.info = function(player, data)
	local buildings: { [string]: number } = {}
	for id, building in data.island.buildings do
		buildings[id] = building.level
	end

	return {
		player       = player.Name,
		gummies      = data.gummies,
		goldGummies  = data.goldGummies,
		rebirthCount = data.rebirthCount,
		rebirthMult  = data.rebirthMult,
		baerchis     = countBaerchis(data),
		towers       = data.towers,
		towerProgress = data.island.towerProgress,
		buildings    = buildings,
		eggStock     = data.island.eggStock,
	}
end

-- Waehrung schenken. Ohne rebirthMult, du bekommst exakt die Zahl.
commands.give = function(player, _data, gummies: any, gold: any)
	EconomyService.awardGummiesFlat(player, tonumber(gummies) or 100000)
	EconomyService.awardGoldGummies(player, tonumber(gold) or 1000)
	return commands.info(player, PlayerService.getDataOrError(player))
end

-- Alle Baerchis als flache Liste (uid zum Weiterverwenden)
commands.list = function(_player, data)
	local out = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(out, {
			uid      = uid,
			configId = baerchi.configId,
			rarity   = baerchi.rarity,
			level    = baerchi.level,
			xp       = baerchi.xp,
			fusion   = baerchi.isFusionResult,
			bonus    = baerchi.fusionBonus,

			-- v8: die zweite Fortschrittsachse. `charms` bewusst nur als Anzahl
			-- — die Detailwerte holt man sich ueber "charms <uid>", sonst wird
			-- die Liste in der Command Bar unlesbar.
			promo    = baerchi.promotionLevel or 0,
			stats    = baerchi.statLevels,
			charms   = #(baerchi.charms or {}),
			mutation = baerchi.mutation,
		})
	end
	table.sort(out, function(a, b) return a.uid < b.uid end)
	return out
end

-- Baerchi direkt erzeugen, ohne Ei.
--
-- Das dritte Argument setzt eine Mutation (siehe BaerchiConfig.MUTATIONS fuer
-- gueltige Namen: Gold/Diamond/Bloodrot/Celestial/Candy/Lava/Galaxy/Rainbow).
-- Ohne diesen Weg waeren Mutationen in Studio praktisch nicht testbar: die
-- Gesamtchance beim Schluepfen liegt bei 1.5%, die seltenste Stufe (Rainbow)
-- bei 0.0005% — man muesste also im Schnitt 200'000 Eier ausbrueten.
--   D:Invoke("add", "RedBaerchi", 10)              -- normal
--   D:Invoke("add", "RedBaerchi", 10, "Rainbow")   -- mit Mutation
commands.add = function(player, data, configId: any, level: any, mutation: any)
	local mutationId: any = nil
	if typeof(mutation) == "string" and BaerchiConfig.MUTATIONS[mutation :: any] then
		mutationId = mutation
	end

	local baerchi = BaerchiFactory.create(tostring(configId), {
		level    = tonumber(level) or 1,
		mutation = mutationId,
	})
	if not baerchi then
		return { error = "Unbekannter configId: " .. tostring(configId) }
	end

	data.island.baerchis[baerchi.uid] = baerchi
	PlayerService.markDirty(player)

	return {
		uid      = baerchi.uid,
		configId = baerchi.configId,
		rarity   = baerchi.rarity,
		level    = baerchi.level,
		mutation = baerchi.mutation,
	}
end

-- Die Kampfwerte eines Baerchis so, wie der Kampf sie sieht. Praktisch, um
-- Promotion, Stat-Stufen, Charms und Mutation gegeneinander nachzurechnen.
commands.stats = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		return { error = "Unbekannter configId: " .. baerchi.configId }
	end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)

	return {
		configId = baerchi.configId,
		level    = baerchi.level,
		mutation = baerchi.mutation,
		promo    = baerchi.promotionLevel or 0,
		maxHp    = stats.maxHp,
		atk      = stats.atk,
		spd      = stats.spd,
		pwrProzent = math.floor(stats.pwr * 100 + 0.5),
		skill    = stats.skillId,
	}
end

-- Gebaeude-Level direkt setzen (umgeht die Kosten)
commands.building = function(player, data, buildingId: any, level: any)
	local building = data.island.buildings[buildingId]
	if not building then
		return { error = "Unbekanntes Gebaeude: " .. tostring(buildingId) }
	end

	-- clampBuildingLevel rundet mit ab: ohne das landete eine 5.5 aus der
	-- Command Bar als Kommazahl in den Daten und jedes spaetere
	-- string.format("%d", level) wuerde daran scheitern.
	building.level = EconomyConfig.clampBuildingLevel(tonumber(level) or 1)
	MapService.updateBuildingLevel(player, buildingId, building.level)
	PlayerService.markDirty(player)

	return { building = buildingId, level = building.level, look = BuildingBehavior.getLook(building.level) }
end

-- v12: Ei ins Lager legen und sofort oeffnen (es gibt keine Brut mehr)
commands.hatch = function(player, data, eggType: any)
	local egg = tostring(eggType or "BasicEgg")
	if not EggConfig.data[egg :: Types.EggType] then
		return { error = "Unbekannter Egg-Typ: " .. egg }
	end

	data.island.eggStock[egg :: Types.EggType] = (data.island.eggStock[egg :: Types.EggType] or 0) + 1
	local result = EggService.openEgg(player, egg :: Types.EggType)
	if not result then
		return { error = "Oeffnen fehlgeschlagen" }
	end

	return {
		configId = result.baerchi.configId,
		rarity   = result.baerchi.rarity,
		mutation = result.baerchi.mutation,
		neu      = result.isNew,
	}
end

-- v12: Eier ins Lager legen, ohne sie zu oeffnen (fuer Tests im Ei-Menue)
commands.egg = function(player, data, eggType: any, count: any)
	local egg = tostring(eggType or "BasicEgg")
	if not EggConfig.data[egg :: Types.EggType] then
		return { error = "Unbekannter Egg-Typ: " .. egg }
	end

	local amount = math.clamp(tonumber(count) or 1, 1, 100)
	data.island.eggStock[egg :: Types.EggType] = (data.island.eggStock[egg :: Types.EggType] or 0) + amount
	PlayerService.markDirty(player)
	return { lager = data.island.eggStock }
end

-- v12/v15: gespeicherten letzten Lauf im gewaehlten Tower setzen (0 = loeschen)
commands.pitprogress = function(player, data, stage: any)
	local reached = math.floor(tonumber(stage) or 0)
	local towerId = data.towers.selected
	data.island.towerProgress[towerId] = if reached > 0 then reached else nil
	PlayerService.markDirty(player)
	return { tower = towerId, towerProgress = data.island.towerProgress }
end

-- v15: Tower waehlen (auch einen noch geschlossenen) und ab `stage` kaempfen.
-- Die Fortsetzungs-Kosten werden vorher gutgeschrieben (Test ohne Grind).
commands.tower = function(player, data, towerId: any, stage: any)
	local id = tostring(towerId or "I")
	local def = TowerConfig.get(id)
	if not def then
		return { error = "Unbekannter Tower: " .. id .. " (I, II, III, Final)" }
	end
	local uid = data.island.equippedUid
	if not uid then
		return { error = "Kein Baerchi ausgeruestet" }
	end
	TowerService.debugOpenAll(data)
	data.towers.selected = id
	local start = math.clamp(math.floor(tonumber(stage) or 1), 1, def.stages)
	local choice = "Fresh"
	if start > 1 then
		data.island.towerProgress[id] = start
		local _, cost = CombatService.getResumeOffer(data, id, "Last")
		if cost > 0 then EconomyService.awardGummiesFlat(player, cost) end
		choice = "Last"
	end
	PlayerService.markDirty(player)
	task.spawn(PetModeService.request, player, "Fight", choice :: any)
	return {
		tower = id, ab = start, deckel = TowerConfig.getStageCap(data.rebirthCount, id, data.towers.records),
		gegnerStage1 = TowerConfig.getEnemyStats(id, start),
	}
end

-- v15: Tower-Rekord direkt setzen (Meilensteine bis dorthin werden ausgezahlt)
commands.towerrecord = function(player, data, towerId: any, stage: any)
	local id = tostring(towerId or "I")
	if not TowerConfig.get(id) then
		return { error = "Unbekannter Tower: " .. id }
	end
	TowerService.debugSetRecord(player, id, tonumber(stage) or 0)
	return { towers = data.towers }
end

-- v15: Deckel des aktuellen Rebirths
commands.rebirthcap = function(_player, data)
	local caps: { [string]: number } = {}
	for _, def in TowerConfig.TOWERS do
		caps[def.id] = TowerConfig.getStageCap(data.rebirthCount, def.id, data.towers.records)
	end
	local capTower, capStage = TowerConfig.getCap(data.rebirthCount)
	return { rebirths = data.rebirthCount, deckelTower = capTower, deckelStage = capStage, proTower = caps }
end

-- v15: Login-Bonus — so tun, als waeren `days` Tage vergangen
commands.dailyshift = function(player, _data, days: any)
	return LoginBonusService.debugShift(player, math.floor(tonumber(days) or 1))
end

-- v15: Bestenlisten sofort schreiben und neu lesen
commands.lbflush = function(_player, _data)
	return LeaderboardService.flush()
end

-- v15: Teile auf der eigenen Insel zaehlen (Budget: 250 ohne Baerchi-Figuren)
commands.parts = function(player, _data)
	return MapService.countParts(player) or { error = "kein Plot" }
end

-- Welt aufwerten: Debug-Signale an die Client-Controller (workspace-Attribute,
-- siehe WorldFXKit.onDebug). Ein Zaehler im Wert sorgt dafuer, dass derselbe
-- Befehl zweimal hintereinander auch zweimal ausloest.
local _worldSignal = 0
local function worldSignal(attribute: string, value: any)
	_worldSignal += 1
	workspace:SetAttribute(attribute, if value == nil then tostring(_worldSignal) else value)
end

commands.worldshots = function(_player, _data, index: any)
	local n = tonumber(index)
	if n == nil then
		local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
		local names = {}
		for _, shot in WorldFXConfig.WORLD_SHOTS do table.insert(names, shot.name) end
		return { hinweis = "worldshots <1..6> (0 = zurueck)", punkte = names }
	end
	_worldSignal += 1
	workspace:SetAttribute("DebugWorldShot", string.format("%d|%d", n, _worldSignal))
	return { punkt = n }
end

commands.daytime = function(_player, _data, hour: any)
	local h = tonumber(hour)
	workspace:SetAttribute("DebugDayTime", if h then h else -1)
	return { tageszeit = if h then h else "auto" }
end

commands.pitstate = function(_player, _data, state: any)
	local value = tostring(state or "auto")
	workspace:SetAttribute("DebugPitState", value)
	return { pit = value }
end

commands.neststate = function(_player, _data, state: any)
	local value = tostring(state or "auto")
	workspace:SetAttribute("DebugNestState", value)
	return { nest = value }
end

commands.arrival = function(_player, _data)
	worldSignal("DebugArrival", nil)
	return { ankunft = true }
end

commands.fish = function(_player, _data)
	worldSignal("DebugFish", nil)
	return { fisch = true }
end

-- Paket D: Insel-Stufe am Player-Attribut (wie PlotDisplayService), "auto"
-- rechnet sie aus dem Spielstand neu.
commands.islandstage = function(player, data, stage: any)
	local IslandStage = require(ReplicatedStorage.Modules.IslandStage)
	local n = tonumber(stage)
	local value = if n then math.clamp(math.floor(n), 1, IslandStage.MAX)
		else IslandStage.compute(data.towers and data.towers.records, data.rebirthCount or 0)
	player:SetAttribute("IslandStage", value)
	return { stufe = value }
end

-- Paket D: Teich voll (alle Honig-Lager voll, wie "honey"), damit der Ueberlauf laeuft
commands.pondfull = function(player, data)
	local result = commands.honey(player, data)
	return { teich = "voll", honig = result }
end

-- Paket E: Zuschauer-Baerchis an der eigenen Arena testen
commands.spectators = function(player, _data, mode: any)
	_worldSignal += 1
	workspace:SetAttribute("DebugSpectators", string.format("%d|%s|%d", player.UserId, tostring(mode or "hop"), _worldSignal))
	return { zuschauer = tostring(mode or "hop") }
end

-- Paket G: Welt-Moment wie vom Server erkannt an alle schicken (ohne den
-- Spielstand zu aendern). Erzwingt "gross", damit man jede Art sieht.
commands.moment = function(player, _data, kind: any, value: any)
	local WorldMomentService = require(ServerScriptService.Services.WorldMomentService)
	local k = tostring(kind or "hatch")
	local defaults = { hatch = "Cosmic", tower = "II", record = "I", rebirth = "1", mutation = "Galaxy" }
	local v = if value ~= nil then tostring(value) else defaults[k] or "?"
	WorldMomentService.announce(player, { kind = k :: any, value = v, number = 42 }, true)
	return { moment = k, wert = v }
end

-- Paket G: fuenf grosse Momente auf einmal (Client muss sie nacheinander zeigen)
commands.moments5 = function(player, _data)
	local WorldMomentService = require(ServerScriptService.Services.WorldMomentService)
	for _, m in { { "hatch", "Mythic" }, { "tower", "III" }, { "rebirth", "2" }, { "mutation", "Rainbow" }, { "hatch", "Omega" } } do
		WorldMomentService.announce(player, { kind = m[1] :: any, value = m[2], number = 2 }, true)
	end
	return { momente = 5 }
end

-- Paket E: Rekord-Moment am eigenen Schau-Turm
commands.record = function(player, _data)
	_worldSignal += 1
	workspace:SetAttribute("DebugRecord", string.format("%d|%d", player.UserId, _worldSignal))
	return { rekord = true }
end

-- v15: den aktuellen Spielstand in ein v14-Format zuruckverwandeln (Topf L7,
-- Presse L4, PIT 5, letzter Lauf Stage 12) und durch die Migration schicken —
-- das Ergebnis wird NICHT uebernommen, nur angezeigt (Migrations-Probe).
commands.v14save = function(_player, data)
	local HttpServiceLocal = game:GetService("HttpService")
	local copy = HttpServiceLocal:JSONDecode(HttpServiceLocal:JSONEncode(data))
	copy.version = 14
	copy.towers = nil
	copy.daily = nil
	copy.island.towerProgress = nil
	copy.island.pitRefund = nil
	copy.island.pitLevel = 5
	copy.island.pitProgress = { pitLevel = 5, reachedStage = 12 }
	copy.island.buildings.HoneyRefiner = nil
	copy.island.buildings.HoneyPot   = { id = "HoneyPot",   level = 7, honey = 4, lastProducedAt = os.time() }
	copy.island.buildings.HoneyPress = { id = "HoneyPress", level = 4, honey = 5, lastProducedAt = os.time() }
	local migrated = PlayerMigration.applyDefaults(copy)
	return {
		version   = migrated.version,
		veredler  = migrated.island.buildings.HoneyRefiner,
		erstattung = migrated.island.pitRefund,
		rekorde   = migrated.towers.records,
	}
end

commands.petmode = function(player, data)
	local pitPhase, stage = PitArenaService.getPhase(player)
	return {
		zuHause     = PetModeService.isHome(player),
		pit         = pitPhase,
		stage       = stage,
		event       = EventParticipationService.getPhase(player),
		towerProgress = data.island.towerProgress,
		eggStock    = data.island.eggStock,
		gummies     = data.gummies,
		lastEggAt   = data.island.lastEggAt,
	}
end

commands.pm = function(player, data, mode: any, resume: any)
	PetModeService.request(player, tostring(mode or "Home"), if resume then tostring(resume) :: any else nil)
	return commands.petmode(player, data)
end

commands.fight = function(player, _data, uid: any)
	CombatService.startPitRun(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

-- Alle Honig-Lager sofort fuellen (umgeht die Wartezeit).
-- Ohne das dauert jeder Level-Test 20 Sekunden pro Honig.

-- v15: Waben im Event-Pit legen und Zustand ausgeben
commands.combs = function(player, data, n: any)
	local count = if typeof(n) == "number" then math.clamp(math.floor(n), 0, 100) else 0
	if count > 0 then
		CombService.debugSpawn(count)
	end

	local recycler = data.island.recycler
	local slots = CombService.getSlotInfo()
	return {
		wabenImPit    = CombService.getWorldCount(),
		getragen      = CombService.getCarriedCount(player),
		getragenAlle  = slots.held,
		respawnQueue  = slots.queued,
		slotLimit     = slots.limit,
		recyclerLevel = recycler.level,
		warteschlange = recycler.queued,
	}
end

-- v17: naechsten UFO-Abwurf als Jackpot erzwingen; Stand des Pity-Zaehlers
commands.jackpot = function(_player, _data)
	JackpotRoll.ufo.forceNext = true
	return {
		naechsterIstJackpot = true,
		abwuerfeSeitJackpot = JackpotRoll.ufo.sinceLast,
		abwuerfeGesamt      = JackpotRoll.ufo.total,
		jackpotsGesamt      = JackpotRoll.ufo.jackpots,
		pity                = EventConfig.UFO.JACKPOT_PITY_DROPS,
	}
end

-- v17: Wabenthema setzen ("off" = normal)
commands.combtheme = function(_player, _data, themeId: any)
	local id = if typeof(themeId) == "string" and themeId ~= "off" then themeId else nil
	CombService.setTheme(id)
	local slots = CombService.getSlotInfo()
	return { thema = CombService.getTheme() or "normal", wabenImPit = slots.world, slotLimit = slots.limit }
end

-- v17: Waben einfliegen lassen (wie ein Vulkan-Ausbruch aus der Pit-Mitte)
commands.launch = function(_player, _data, n: any)
	local count = if typeof(n) == "number" then math.clamp(math.floor(n), 1, 30) else 10
	local origin = MapService.getEventPitPosition() + Vector3.new(0, 2, 0)
	return { gestartet = CombService.launchCombs(count, origin), slots = CombService.getSlotInfo() }
end

-- v15: Wabeneinheiten direkt in die Warteschlange des Recyclers legen
commands.queue = function(player, data, n: any)
	local units = if typeof(n) == "number" then math.clamp(math.floor(n), 0, 100000) else 0
	if units > 0 then
		CombRecyclerService.deposit(player, units)
	end

	local recycler = data.island.recycler
	return {
		warteschlange = recycler.queued,
		level         = recycler.level,
		gummies       = data.gummies,
	}
end

-- v15: Recycler-Level direkt setzen (ohne Kosten)
commands.recycler = function(player, data, level: any)
	local recycler = data.island.recycler
	if typeof(level) == "number" then
		recycler.level = CombConfig.clampLevel(level)
		PlayerService.markDirty(player)
	end

	return {
		level         = recycler.level,
		gummiesJeEinheit = CombConfig.getPayPerUnit(recycler.level),
		einheitenProSek  = CombConfig.getSpeed(recycler.level),
		warteschlange = recycler.queued,
	}
end

commands.honey = function(player, data)
	local filled: { [string]: number } = {}

	for _, building in data.island.buildings do
		-- Lager DIESES Gebaeudes auf DIESEM Level: der Bienenstock fasst seit
		-- v7 mehr als die anderen beiden.
		building.honey          = BuildingBehavior.getCapacity(building.id, building.level)
		building.lastProducedAt = os.time()
		filled[building.id]     = building.honey
	end

	PlayerService.markDirty(player)
	return { honey = filled }
end

-- Einen Baerchi fuettern (heilt + gibt XP), so oft wie angegeben
commands.feed = function(player, _data, uid: any, times: any)
	local count = math.clamp(tonumber(times) or 1, 1, 100)

	for _ = 1, count do
		HoneyService.feed(player, tostring(uid))
	end

	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Fusion. Die beiden letzten Argumente sind der Sperr-Schritt aus dem
-- Fusions-Menue (siehe FusionService, Regel C) und duerfen weggelassen werden —
-- dann laeuft alles automatisch.
--   D:Invoke("fuse", uidA, uidB)                   -- alles automatisch
--   D:Invoke("fuse", uidA, uidB, "ability", "B")   -- Skill kommt von B
commands.fuse = function(player, _data, uidA: any, uidB: any, lockedProperty: any, lockedFrom: any)
	local property = if lockedProperty ~= nil then tostring(lockedProperty) else nil
	local from     = if lockedFrom ~= nil then tostring(lockedFrom) else nil

	FusionService.fuse(player, tostring(uidA), tostring(uidB), property :: any, from :: any)
	return commands.list(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v8: Promotion, Charms, Event-Teilnahme
--------------------------------------------------------------------------------

-- Befoerdern. Legt die noetigen Duplikate NICHT selbst an — wer testen will,
-- ruft vorher mehrfach "add <configId>" auf. Genau so merkt man, ob die
-- Material-Pruefung tut, was sie soll.
commands.promote = function(player, _data, uid: any)
	PromotionService.promote(player, tostring(uid))
	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Charms wuerfeln. Kostet echte GoldGummies — vorher "give 0 100000".
commands.roll = function(player, _data, uid: any, times: any)
	CharmService.rollCharms(player, tostring(uid), tonumber(times) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Alle acht Slots eines Baerchis im Klartext.
commands.charms = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local bySlot: { [number]: any } = {}
	for _, charm in baerchi.charms or {} do
		bySlot[charm.slot] = charm
	end

	local out = {}
	for slot = 1, CharmConfig.SLOT_COUNT do
		local charm = bySlot[slot]
		out[slot] = {
			slot     = CharmConfig.SLOT_NUMERALS[slot],
			offen    = CharmConfig.isSlotUnlocked(slot, baerchi.promotionLevel or 0),
			abPromo  = CharmConfig.getUnlockPromotion(slot),
			rarity   = if charm then charm.rarity else nil,
			effekt   = if charm then CharmConfig.describe(charm) else nil,
			gesperrt = if charm then charm.locked else nil,
		}
	end

	return { promotion = baerchi.promotionLevel or 0, slots = out }
end

-- Einen Charm-Slot sperren/freigeben.
commands.lock = function(player, _data, uid: any, slot: any)
	CharmService.toggleLock(player, tostring(uid), tonumber(slot) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Den ausgeruesteten Baerchi zum Event schicken bzw. zurueckholen.
commands.event = function(player, _data)
	EventParticipationService.sendToEvent(player)
	return { unterwegs = true }
end

commands.recall = function(player, _data)
	EventParticipationService.recall(player)
	return { unterwegs = true }
end

--------------------------------------------------------------------------------
-- v10: Eier legen
--------------------------------------------------------------------------------

-- Legt sofort ein Ei, ohne auf das Intervall zu warten. Mehrfach aufrufen, um
-- den Plot zu fuellen und die Obergrenze zu pruefen.
commands.lay = function(player, _data, times: any)
    local count  = math.clamp(tonumber(times) or 1, 1, 30)
    local laid   = 0

    for _ = 1, count do
        if EggLayService.layNow(player) then
            laid += 1
        else
            break   -- Obergrenze erreicht oder kein Baerchi ausgeruestet
        end
    end

    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Was gerade herumliegt, plus die Werte des ausgeruesteten Legers.
commands.eggs = function(_player, data)
    local out = {}
    for _, egg in data.island.laidEggs or {} do
        table.insert(out, { uid = egg.uid, typ = egg.eggType })
    end

    local uid     = data.island.equippedUid
    local baerchi = if uid then data.island.baerchis[uid] else nil

    local rate: any = "kein Baerchi ausgeruestet"
    local chancen: any = nil

    if baerchi then
        local online  = EggCalculator.getLayIntervalSeconds(baerchi, false)
        local offline = EggCalculator.getLayIntervalSeconds(baerchi, true)

        rate = {
            configId       = baerchi.configId,
            level          = baerchi.level,
            eggStufe       = (baerchi.statLevels :: any).egg or 0,
            mutation       = baerchi.mutation,
            sekundenOnline = if online then math.floor(online + 0.5) else nil,
            sekundenOffline= if offline then math.floor(offline + 0.5) else nil,
        }

        chancen = {}
        for _, chance in EggCalculator.getChances(baerchi) do
            table.insert(chancen, string.format("%s %.0f%%", chance.eggType, chance.percent))
        end
    end

    return {
        liegen  = #out,
        maximum = EggConfig.MAX_UNCOLLECTED_EGGS,
        eier    = out,
        lager   = data.island.eggStock,
        leger   = rate,
        chancen = chancen,
    }
end

-- Alle herumliegenden Eier einsammeln (dasselbe wie der Knopf auf der Karte).
commands.collect = function(player, _data)
    EggLayService.collectAll(player)
    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Die Zeitmarke kuenstlich in die Vergangenheit setzen und danach nachrechnen
-- lassen — so laesst sich das OFFLINE-Nachholen pruefen, ohne den Server zu
-- verlassen. Der naechste Tick (max. 5s) legt dann die faelligen Eier.
--
-- Achtung: der Tick rechnet mit der ONLINE-Rate. Das echte Offline-Verhalten
-- (langsamer, siehe EggConfig.OFFLINE_SLOWDOWN) sieht man nur beim Rejoin.
commands.eggtime = function(player, data, minutes: any)
    local back = math.clamp(tonumber(minutes) or 30, 1, 10000)
    data.island.lastEggAt = os.time() - back * 60
    PlayerService.markDirty(player)

    return { zurueckgestellt = back .. " Minuten", hinweis = "naechster Tick legt nach (max. 5s)" }
end

-- Die laufende Phase sofort beenden. Zweimal aufgerufen bekommt man also aus
-- der Pause heraus ein vollstaendiges Event samt Belohnung, ohne acht Minuten
-- zu warten:
--   D:Invoke("skipevent")   -- Pause vorbei, Event laeuft
--   D:Invoke("event")       -- Baerchi hinschicken, ankommen lassen
--   D:Invoke("skipevent")   -- Event vorbei → Stat-Stufe wird vergeben
commands.skipevent = function(_player, _data)
	EventService.skipPhase()

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		belohnung    = if active then EventConfig.describeReward(active) else nil,
		naechstes    = EventService.getNext().displayName,
		restSekunden = EventService.getRemainingSeconds(),
	}
end

-- Der ganze Katalog mit Belohnung, in der Reihenfolge, in der die Events
-- laufen. Praktisch, um die ids fuer "startevent" nachzuschlagen.
commands.events = function(_player, _data)
	local katalog = {}
	for index, def in EventConfig.EVENTS do
		table.insert(katalog, string.format(
			"%d. %s (%s) — %s",
			index, def.displayName, def.id, EventConfig.describeReward(def)
		))
	end

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		restSekunden = EventService.getRemainingSeconds(),
		naechstes    = EventService.getNext().displayName,
		takt         = string.format(
			"individuelle Dauer je Event / %ds Pause",
			EventConfig.EVENT_GAP_SECONDS
		),
		katalog      = katalog,
	}
end

-- Ein BESTIMMTES Event sofort starten, statt sich durch den Zyklus zu warten.
-- Ein voller Durchlauf durch alle zehn Events dauert 80 Minuten — ohne diesen
-- Befehl waere z.B. der Mutations-Sturm praktisch nicht testbar.
--
-- Laeuft gerade ein anderes Event, wird es vorher ordentlich beendet (die
-- Anwesenden bekommen also noch ihre Belohnung, siehe EventService.startById).
commands.startevent = function(_player, _data, id: any)
	local eventId = tostring(id or "")

	if not EventService.startById(eventId) then
		local ids = {}
		for _, def in EventConfig.EVENTS do
			table.insert(ids, def.id)
		end
		return { error = "Unbekannte Event-id: " .. eventId, verfuegbar = ids }
	end

	local active = EventService.getActive()
	return {
		gestartet    = if active then active.displayName else "?",
		belohnung    = if active then EventConfig.describeReward(active) else nil,
		restSekunden = EventService.getRemainingSeconds(),
		hinweis      = "jetzt 'event' aufrufen, um den Baerchi hinzuschicken — er muss beim ENDE dort stehen",
	}
end

commands.recycle = function(player, _data, uid: any)
	RecycleService.recycle(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.upgrade = function(player, _data, buildingId: any)
	IslandService.upgradeBuilding(player, buildingId)
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.rebirth = function(player, _data)
	RebirthService.rebirth(player)
	return commands.info(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v14: Ei-Baum
--------------------------------------------------------------------------------

commands.tree = function(_player, data)
	local out = { blueprints = data.eggTree.blueprints, rebirths = data.rebirthCount }
	for _, eggId in EggConfig.getOrderedIds() do
		local p = EggTree.getProgress(data, eggId)
		local parts = {}
		for _, c in p.conditions do
			local label = c.kind .. (if c.egg then ":" .. c.egg elseif c.rarity then ":" .. c.rarity else "")
			table.insert(parts, string.format("%s %d/%d%s", label, c.have, c.need, if c.done then " ok" else ""))
		end
		out[string.format("%02d %s", EggConfig.data[eggId].sortOrder, eggId)] = string.format("%s | hatched %d | lager %d | %s",
			if p.unlocked then "FREI" else "zu", data.eggTree.hatched[eggId] or 0,
			data.island.eggStock[eggId] or 0, table.concat(parts, ", "))
	end
	return out
end

commands.unlock = function(player, data, eggType: any)
	if eggType == "all" then
		for _, eggId in EggConfig.getOrderedIds() do
			EggTreeService.forceUnlock(player, data, eggId, "debug")
		end
	elseif typeof(eggType) == "string" and EggConfig.data[eggType :: Types.EggType] then
		EggTreeService.forceUnlock(player, data, eggType :: Types.EggType, "debug")
	else
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.hatched = function(player, data, eggType: any, count: any)
	if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	data.eggTree.hatched[eggType] = math.max(0, math.floor(tonumber(count) or 0))
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.blueprint = function(player, data, amount: any)
	EggTreeService.grantBlueprint(player, data, tonumber(amount) or 1)
	PlayerService.markDirty(player)
	return { blueprints = data.eggTree.blueprints }
end

commands.useblueprint = function(player, data, eggType: any)
	local ok = EggTreeService.useBlueprint(player, eggType)
	return { ok = ok, tree = commands.tree(player, data) }
end

commands.press = function(player, data, eggType: any, path: any)
	local result = EggTreeService.press(player, eggType, path)
	return { result = result, stock = data.island.eggStock }
end

commands.setrebirth = function(player, data, count: any)
	data.rebirthCount = math.max(0, math.floor(tonumber(count) or 0))
	data.rebirthMult  = EconomyConfig.getRebirthMult(data.rebirthCount)
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

-- Spielstand fuer Tests sichern und zuruecksetzen. Die Kopie liegt nur im
-- Speicher dieses Servers (nicht im DataStore).
local HttpService = game:GetService("HttpService")
local _snapshot: string? = nil

commands.snapshot = function(_player, data)
	_snapshot = HttpService:JSONEncode(data)
	return { ok = true, bytes = #(_snapshot :: string) }
end

commands.restore = function(player, data)
	if not _snapshot then return { error = "Kein Snapshot" } end
	local saved = HttpService:JSONDecode(_snapshot :: string)
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in saved do (data :: any)[k] = v end
	MapService.rebuildIsland(player, data.island)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return { ok = true }
end

-- HBB Paket 0: feste Test-Zustaende fuer Playtests und Studio-Testschritte.
--   fresh   = Startstand eines neuen Kontos (createdAt = jetzt → Trichter misst)
--   hatch10 = fresh + zehn geoeffnete Basis-Eier
--   tower1  = hatch10 + Tower I geschafft (Rekord 30, Meilensteine ausgezahlt)
--
-- Studio spielt gegen den ECHTEN DataStore. Deshalb verlangt der Befehl einen
-- vorherigen "snapshot"; zurueck geht es mit "restore". Der Snapshot liegt nur
-- im Speicher dieses Servers — vor "Stop" also restore aufrufen.
--
-- Der Baerchi sollte zu Hause stehen (kein Kampf, kein Event), sonst haelt ein
-- anderer Service noch die alte Figur.
local TEST_STATES = { fresh = true, hatch10 = true, tower1 = true }
local TEST_HATCH_COUNT = 10
local TEST_TOWER_RECORD = 30

commands.state = function(player, data, name: any)
	local stateName = tostring(name or "")
	if not TEST_STATES[stateName] then
		return { error = "Unbekannter Zustand: " .. stateName, verfuegbar = { "fresh", "hatch10", "tower1" } }
	end
	if not _snapshot then
		return { error = "Erst D:Invoke(\"snapshot\") — Studio schreibt in den echten Spielstand" }
	end

	-- 1. fresh: alles ersetzen ausser Sitzungs-Sperre und Sprache
	local session  = (data :: any).session
	local language = data.language
	local fresh = PlayerService.buildDefaultData()
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in fresh :: any do (data :: any)[k] = v end
	;(data :: any).session = session
	data.language = language
	MapService.rebuildIsland(player, data.island)
	FunnelService.debugReset(player)

	-- 2. hatch10: ueber den echten Weg oeffnen, damit Zaehler, Index und
	-- Auto-Ausruesten genau wie im Spiel laufen.
	if stateName == "hatch10" or stateName == "tower1" then
		data.island.eggStock.BasicEgg = (data.island.eggStock.BasicEgg or 0) + TEST_HATCH_COUNT
		for _ = 1, TEST_HATCH_COUNT do
			EggService.openEgg(player, "BasicEgg")
		end
	end

	-- 3. tower1: Rekord setzen, Meilensteine wie bei "towerrecord"
	if stateName == "tower1" then
		TowerService.debugSetRecord(player, "I", TEST_TOWER_RECORD)
	end

	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return {
		ok = true,
		zustand = stateName,
		baerchis = countBaerchis(data),
		lager = data.island.eggStock,
		rekorde = data.towers.records,
		hinweis = "Zurueck mit D:Invoke(\"restore\")",
	}
end

-- Ein einzelner Kampf mit Runden-Log (Faehigkeiten pruefen).
commands.skilltest = function(_player, _data, configId: any, stage: any)
	local b = BaerchiFactory.create(tostring(configId), { level = 20 })
	if not b then return { error = "Unbekannter Baerchi" } end
	local def = BaerchiConfig.getById(b.configId)
	local stats = CombatCalculator.getEffectiveStats(b, (def :: any).baseStats)
	local es = CombatConfig.getEnemyStats(1, tonumber(stage) or 20)
	local me = { uid = "me", stats = stats, hp = stats.maxHp, charge = 0 }
	local en = { uid = "en", stats = es, hp = es.maxHp, charge = 0 }
	local r = CombatCalculator.simulate(me, en)
	local lines = {}
	for i, e in r.log do
		if i > 40 then break end
		table.insert(lines, string.format("%s r%d %s dmg %d heal %d abs %d | A %d B %d %s",
			e.actor, e.roundNumber, e.skillId or "-", e.damage, e.heal, e.absorbed,
			e.attackerHpAfter, e.defenderHpAfter, if e.effects then table.concat(e.effects, ",") else ""))
	end
	return { winner = r.winnerUid, rounds = r.rounds, skillUses = r.skillUses, log = lines }
end

commands.help = function()
	return {
		"info", "give <gummies> <gold>", "list",
		"add <configId> <level> [mutation]", "stats <uid>",
		"building <id> <level>",
		"hatch <eggType>", "egg <eggType> [anzahl]", "pitprogress <stage>", "honey", "feed <uid> <times>",
		"fight <uid>",
		"fuse <uidA> <uidB> [ability|level|eggs] [A|B]",
		"recycle <uid>", "upgrade <buildingId>", "rebirth",

		-- v8
		"promote <uid>", "charms <uid>", "roll <uid> [anzahl]", "lock <uid> <slot>",
		"event", "recall", "skipevent", "events", "startevent <eventId>",

		-- v10
		"eggs", "lay [anzahl]", "collect", "eggtime <minuten>",

		-- v12
		"petmode", "pm <Event|Fight|Home> [Fresh|Percent|Last]",

		-- v14
		"tree", "unlock <eggType|all>", "hatched <eggType> <n>", "blueprint [n]",
		"useblueprint <eggType>", "press <eggType> [Gold|Kristall|Void]", "setrebirth <n>",
		"skilltest <configId> [stage]", "snapshot", "restore",
		-- HBB Paket 0
		"state <fresh|hatch10|tower1>  (erst snapshot!)",

		-- v15
		"combs [anzahl]", "queue <einheiten>", "recycler [level]",

		-- v15 (Tower/Gebaeude/Angeben/Login-Bonus)
		"tower <I|II|III|Final> <stage>", "towerrecord <id> <stage>", "rebirthcap",
		"dailyshift <tage>", "lbflush", "parts", "v14save",

		-- v17
		"jackpot", "combtheme <themeId|off>", "launch [anzahl]",

		-- Welt aufwerten
		"worldshots [1..6|0]", "daytime <uhrzeit|auto>", "pitstate <idle|soon|live|auto>",
		"neststate <calm|boss|auto>", "arrival", "fish",
		"islandstage <1..4|auto>", "pondfull", "spectators <hop|cheer>", "record",
		"moment <hatch|tower|record|rebirth|mutation> [wert]", "moments5",
	}
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function DebugService.init()
	if not RunService:IsStudio() then
		return   -- im Live-Spiel gibt es diesen Service schlicht nicht
	end

	local existing = ServerScriptService:FindFirstChild(BINDABLE_NAME)
	if existing then existing:Destroy() end

	local bindable = Instance.new("BindableFunction")
	bindable.Name   = BINDABLE_NAME
	bindable.Parent = ServerScriptService

	bindable.OnInvoke = function(command: any, ...)
		local name = tostring(command or "help")
		local handler = commands[name]
		if not handler then
			return { error = "Unbekannter Befehl: " .. name, verfuegbar = commands.help() }
		end

		if name == "help" then
			return commands.help()
		end

		local player, data, reason = requireData()
		if not player or not data then
			return { error = reason }
		end

		local ok, result = pcall(handler, player, data, ...)
		if not ok then
			return { error = tostring(result) }
		end
		return result
	end

	print("[DebugService] Initialisiert | Command Bar: game.ServerScriptService." .. BINDABLE_NAME .. ":Invoke(\"help\")")
end

return DebugService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX47"><Properties>
<string name="Name">EggLayService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- EggLayService.luau
-- ServerScriptService/Services/EggLayService.luau
--
-- Einzige Zustaendigkeit:
--   - Den ausgeruesteten Baerchi regelmaessig ein Ei dort ablegen lassen, wo
--     er gerade steht
--   - Diese Eier einsammeln lassen (dann landen sie im Lager und sind
--     ausbruetbar)
--
-- ============================================================
-- WIE DAS LEGEN GETAKTET IST
-- ============================================================
-- Wie bei den Honig-Gebaeuden laeuft KEIN Timer pro Ei. Stattdessen steht auf
-- der Insel eine Zeitmarke (island.lastEggAt), und wie viele Eier faellig sind,
-- wird daraus nachgerechnet. Das hat drei Vorteile:
--
--   1. Es laeuft auch waehrend der Spieler offline ist weiter (langsamer, siehe
--      EggConfig.OFFLINE_SLOWDOWN) — ohne dass dafuer irgendwo ein Server
--      laufen muesste.
--   2. Ein ausgesetzter Tick (Server-Ruckler) verschiebt nichts.
--   3. Es gibt nur EINE Rechnung fuer online und offline, naemlich
--      EggCalculator — nicht zwei, die beim naechsten Balancing auseinander
--      laufen.
--
-- ============================================================
-- WARUM DIE PRODUKTION BEI VOLLEM LAGER ANHAELT
-- ============================================================
-- Liegen bereits EggConfig.MAX_UNCOLLECTED_EGGS Eier herum, wird die Zeitmarke
-- trotzdem auf jetzt gesetzt. Die Wartezeit sammelt sich also NICHT an, und wer
-- nach drei Tagen zurueckkommt, findet zwoelf Eier — nicht dreihundert.
--
-- Das ist exakt dasselbe Verhalten wie beim vollen Honig-Lager (siehe
-- HoneyService): laenger wegbleiben bringt nichts zusaetzlich. Wer mehr will,
-- kommt oefter vorbei und sammelt ein.
--
-- ============================================================
-- SEIT v12: GELEGT WIRD NUR AUF DEM PLOT
-- ============================================================
-- Ist der Baerchi am Event oder im PIT (oder auf dem Weg dorthin bzw.
-- zurueck), PAUSIERT der Lege-Timer: island.lastEggAt wird in jedem Tick um
-- die vergangene Zeit nach vorne geschoben. Kommt er heim, laeuft der Timer
-- von dort weiter, der bisherige Fortschritt bleibt — und es entsteht kein
-- Nachholen fuer die Zeit unterwegs. Der Weg zum Honig-Teich zaehlt als zu
-- Hause (PetModeService.isHome). Ist die Figur gerade nicht sichtbar (Neubau),
-- wird in dem Tick nicht gelegt; faellige Eier kommen im naechsten.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types         = require(ReplicatedStorage.Network.Types)
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local EggCalculator = require(ReplicatedStorage.Modules.EggCalculator)
local EggTree       = require(ReplicatedStorage.Modules.EggTree)
local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)
local IslandService = require(ServerScriptService.Services.IslandService)
local RateLimiter   = require(ServerScriptService.Util.RateLimiter)
-- v12: nur fuer "ist der Baerchi zu Hause?"
local PetModeService = require(ServerScriptService.Services.PetModeService)

local EggLayService = {}

--------------------------------------------------------------------------------
-- Konstanten
--------------------------------------------------------------------------------

-- Wie oft nachgesehen wird, ob ein Ei faellig ist. Muss nicht schnell sein:
-- das kuerzeste moegliche Intervall ist EggConfig.MIN_LAY_INTERVAL_SECONDS
-- (15s), und faellige Eier gehen nicht verloren — sie werden beim naechsten
-- Tick aus der Zeitmarke nachgerechnet.
local CHECK_INTERVAL = 5

-- Laufender Zaehler fuer die Ei-uid. os.time() allein reicht nicht: bei einem
-- Offline-Nachholen entstehen mehrere Eier in derselben Sekunde.
local _eggCounter = 0

-- v12: Zeitpunkt des letzten Ticks pro Spieler (fuer die Pause) und ob der
-- Baerchi im letzten Tick unterwegs war (fuer den einen Sync bei der Rueckkehr).
local _lastTick: { [Player]: number } = {}
local _wasAway: { [Player]: boolean } = {}

local function newEggUid(): string
	_eggCounter += 1
	return string.format("e_laid_%d_%d_%d", os.time(), _eggCounter, math.random(1000, 9999))
end

--------------------------------------------------------------------------------
-- Wohin das Ei faellt
--------------------------------------------------------------------------------

local function footPosOf(model: Model): Vector3
	local box, size = model:GetBoundingBox()
	return Vector3.new(box.Position.X, box.Position.Y - size.Y * 0.5, box.Position.Z)
end

-- Der Ort, an dem das naechste Ei landet: neben dem Baerchi, wo er GERADE
-- steht. Laeuft er zum Honig-Teich, liegen die Eier auf dem Weg dorthin.
--
-- Der seitliche Versatz ist Zufall im Umkreis von LAY_SCATTER_RADIUS — ohne
-- ihn laegen mehrere Eier exakt uebereinander, wenn der Baerchi laenger an
-- derselben Stelle steht, und man koennte nur das oberste anklicken.
--
-- ============================================================
-- DAS ERGEBNIS IST PLOT-RELATIV, NICHT ABSOLUT
-- ============================================================
-- Welchen der acht Plots ein Spieler bekommt, entscheidet sich bei jedem Join
-- neu. Eine Weltposition zu speichern hiesse: nach einem Rejoin liegen die
-- Eier dort, wo der Plot BEIM LEGEN war — moeglicherweise auf dem Plot eines
-- Nachbarn. Deshalb rechnet MapService.worldToPlot sie in Plot-Koordinaten um,
-- und beim Bauen wieder zurueck.
--
-- Gibt nil zurueck, wenn es gerade keine Figur und keinen Plot gibt. Dann wird
-- schlicht nicht gelegt.
local function pickDropPosition(player: Player, baerchiUid: string): Vector3?
	local figure = MapService.getBaerchiModel(player, baerchiUid)

	local origin: Vector3
	if figure then
		origin = footPosOf(figure)
	else
		-- Kein sichtbarer Baerchi (typisch beim Offline-Nachholen, bevor der
		-- Plot fertig ist): um den Plot-Mittelpunkt herum ablegen.
		local plot = MapService.getPlotCFrame(player)
		if not plot then
			return nil
		end
		origin = plot.Position
	end

	local angle    = math.random() * math.pi * 2
	local distance = math.random() * EggConfig.LAY_SCATTER_RADIUS

	local dx, dz = math.cos(angle) * distance, math.sin(angle) * distance
	local world = Vector3.new(origin.X + dx, origin.Y, origin.Z + dz)

	-- Seit der Baerchi am Becken wohnt (HONEY_POND_V2), koennte ein Ei im
	-- Honig landen. Dann auf die andere Seite des Baerchis spiegeln — dort
	-- ist es immer weiter vom Becken weg als der Baerchi selbst.
	local pond = MapService.getPondCenter(player)
	if pond then
		local keepOut = MapConfig.POND_RADIUS + MapConfig.POND_RIM_WIDTH + 1.5
		if Vector3.new(world.X - pond.X, 0, world.Z - pond.Z).Magnitude < keepOut then
			world = Vector3.new(origin.X - dx, origin.Y, origin.Z - dz)
		end
	end

	return MapService.worldToPlot(player, world)
end

--------------------------------------------------------------------------------
-- Legen
--------------------------------------------------------------------------------

-- Legt EIN Ei, wenn Platz ist. Gibt true zurueck wenn es geklappt hat.
--
-- Aendert die Daten, aber loest KEIN markDirty aus: beim Offline-Nachholen
-- entstehen mehrere Eier hintereinander, und ein Sync pro Ei waere sinnlose
-- Netzlast. Der Aufrufer synchronisiert einmal am Ende.
local function layOne(player: Player, data: Types.PlayerData, baerchi: Types.Baerchi): boolean
	local island = data.island

	if #island.laidEggs >= EggConfig.MAX_UNCOLLECTED_EGGS then
		return false
	end

	local rolled = EggCalculator.rollEggType(baerchi)
	if not rolled then
		return false
	end

	-- v14: gesperrtes Ei -> naechster freier Vorgaenger im selben Pfad
	-- (EggTree.resolveLaid). Nichts geht verloren, nichts wird uebersprungen.
	local eggType = EggTree.resolveLaid(data.eggTree, rolled)

	-- v14: Void-Identitaet — mit layUpgradeChance steigt das Ei eine Stufe
	-- auf, falls die naechste Stufe schon frei ist.
	local def = BaerchiConfig.getById(baerchi.configId)
	if def and def.layUpgradeChance and def.layUpgradeChance > 0 and math.random() < def.layUpgradeChance then
		local up = EggTree.upgradeTarget(data.eggTree, eggType, def.path)
		if up then
			eggType = up
			-- Sichtbar machen: das Omen des Phantoms (volle Show nur beim
			-- Phantom selbst, sonst ein kurzes Echo).
			local figure = MapService.getBaerchiModel(player, baerchi.uid)
			if figure then
				Remotes.SkillFXPlay:FireAllClients({
					owner    = player.UserId,
					skillId  = "PhantomOmen",
					full     = baerchi.skillId == "PhantomOmen",
					attacker = figure,
					target   = nil,
				})
			end
		end
	end

	local position = pickDropPosition(player, baerchi.uid)
	if not position then
		return false
	end

	table.insert(island.laidEggs, {
		uid     = newEggUid(),
		eggType = eggType,
		laidAt  = os.time(),
		x       = position.X,
		y       = position.Y,
		z       = position.Z,
	})

	return true
end

-- Rechnet nach, wie viele Eier seit island.lastEggAt faellig geworden sind,
-- und legt sie. Gibt zurueck, wie viele es tatsaechlich wurden und ob die
-- Obergrenze dabei gebremst hat.
--
-- `offline` steuert nur die Rate (siehe EggCalculator) — die Rechnung selbst
-- ist fuer beide Faelle dieselbe.
local function catchUp(player: Player, data: Types.PlayerData, offline: boolean): (number, boolean)
	local island  = data.island
	local uid     = island.equippedUid
	local baerchi = if uid then island.baerchis[uid] else nil

	-- Kein ausgeruesteter Baerchi: es legt niemand. Die Zeitmarke wird
	-- trotzdem nachgezogen, sonst wuerde beim naechsten Ausruesten die ganze
	-- Zwischenzeit auf einmal gutgeschrieben — fuer einen Baerchi, der da noch
	-- gar nicht stand.
	if not baerchi then
		island.lastEggAt = os.time()
		return 0, false
	end

	local interval = EggCalculator.getLayIntervalSeconds(baerchi, offline)
	if not interval then
		island.lastEggAt = os.time()
		return 0, false
	end

	local now     = os.time()
	local elapsed = now - (island.lastEggAt or now)
	if elapsed <= 0 then
		return 0, false
	end

	local due = math.floor(elapsed / interval)
	if due <= 0 then
		return 0, false
	end

	local laid    = 0
	local blocked = false

	for _ = 1, due do
		if layOne(player, data, baerchi) then
			laid += 1
		else
			blocked = true
			break
		end
	end

	-- Zeitmarke immer auf jetzt — auch wenn die Obergrenze gebremst hat.
	-- Genau das ist die Stelle, an der sich die Wartezeit NICHT ansammelt
	-- (siehe Kopf-Kommentar).
	island.lastEggAt = now

	return laid, blocked
end

--------------------------------------------------------------------------------
-- Einsammeln
--------------------------------------------------------------------------------

local function fail(player: Player, action: string, reason: Types.LocMsg?)
	Remotes.ActionFailed:FireClient(player, action, reason or Loc.msg("err.unknown"))
end

-- Nimmt EIN Ei aus der Liste und schreibt es dem Lager gut.
-- Gibt den Ei-Typ zurueck, oder nil wenn es das Ei nicht (mehr) gibt.
local function takeEgg(data: Types.PlayerData, eggUid: string): Types.EggType?
	local island = data.island

	for index, egg in island.laidEggs do
		if egg.uid == eggUid then
			table.remove(island.laidEggs, index)

			local stock = island.eggStock
			stock[egg.eggType] = (stock[egg.eggType] or 0) + 1

			return egg.eggType
		end
	end

	return nil
end

function EggLayService.collect(player: Player, eggUid: string)
	local data = PlayerService.getData(player)
	if not data then return end

	local eggType = takeEgg(data, eggUid)
	if not eggType then
		-- Kein Fehler des Spielers: zwei schnelle Klicks auf dasselbe Ei, oder
		-- ein Klick auf ein Ei, das der "alles einsammeln"-Knopf gerade
		-- weggeraeumt hat. Still ignorieren statt einen Toast zu werfen.
		return
	end

	local result: Types.EggCollectResult = {
		eggUid  = eggUid,
		eggType = eggType,
		inStock = data.island.eggStock[eggType] or 0,
	}

	Remotes.EggCollectedReceived:FireClient(player, result)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
end

function EggLayService.collectAll(player: Player)
	local data = PlayerService.getData(player)
	if not data then return end

	local eggs = data.island.laidEggs
	if #eggs == 0 then
		fail(player, "RequestCollectAllEggs", Loc.msg("err.egg_none_lying"))
		return
	end

	-- Ueber eine Kopie der uids laufen: takeEgg entfernt aus derselben Liste,
	-- ueber die wir sonst iterieren wuerden.
	local uids: { string } = {}
	for _, egg in eggs do
		table.insert(uids, egg.uid)
	end

	local last: Types.EggType? = nil
	local count = 0

	for _, uid in uids do
		local eggType = takeEgg(data, uid)
		if eggType then
			last  = eggType
			count += 1
		end
	end

	if count == 0 then
		return
	end

	-- Ein Ergebnis fuer den ganzen Schwung. `eggUid` bleibt leer: es war nicht
	-- EIN Ei, und ein erfundener Wert waere schlimmer als ein leerer.
	local result: Types.EggCollectResult = {
		eggUid  = "",
		eggType = last :: Types.EggType,
		inStock = count,
	}

	Remotes.EggCollectedReceived:FireClient(player, result)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	print("[EggLayService]", player.Name, "| alle Eier eingesammelt:", count)
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Legt sofort ein Ei, unabhaengig von der Zeitmarke. NUR fuer den Studio-Test
-- (DebugService): auf ein echtes Intervall zu warten macht das Ei-System sonst
-- praktisch unpruefbar.
function EggLayService.layNow(player: Player): boolean
	local data = PlayerService.getData(player)
	if not data then return false end

	local uid     = data.island.equippedUid
	local baerchi = if uid then data.island.baerchis[uid] else nil
	if not baerchi then return false end

	local ok = layOne(player, data, baerchi)
	if ok then
		PlayerService.markDirty(player)
	end
	return ok
end

--------------------------------------------------------------------------------
-- Takt
--------------------------------------------------------------------------------

local function tick()
	for _, player in Players:GetPlayers() do
		local data = PlayerService.getData(player)
		if not data then continue end

		local now = os.time()
		local dt  = now - (_lastTick[player] or now)
		_lastTick[player] = now

		-- v12: unterwegs (Event/PIT) -> Timer einfrieren.
		if not PetModeService.isHome(player) then
			if dt > 0 then
				data.island.lastEggAt = math.min(now, (data.island.lastEggAt or now) + dt)
			end
			_wasAway[player] = true
			continue
		end

		-- Gerade heimgekommen: einmal syncen, damit die Countdown-Anzeige
		-- (EggTimerController) die verschobene Zeitmarke bekommt.
		if _wasAway[player] then
			_wasAway[player] = nil
			PlayerService.markDirty(player)
		end

		-- Nur legen, wenn die Figur wirklich auf dem Plot steht.
		local uid = data.island.equippedUid
		if uid and not MapService.getBaerchiModel(player, uid) then
			continue
		end

		local laid = catchUp(player, data, false)
		if laid > 0 then
			-- markDirty zieht die sichtbaren Eier ueber PlotDisplayService nach.
			PlayerService.markDirty(player)
		end
	end
end

function EggLayService.init()
	-- Einsammeln per Beruehrung: MapService baut an jedem gelegten Ei einen
	-- Touched-Handler, kennt aber EggLayService nicht (Ringschluss-Gefahr,
	-- siehe MapService._eggCollectHandler). Deshalb haengt sich hier die
	-- eigentliche Sammel-Funktion ein — derselbe Weg fuehrt seit jeher zum
	-- Klick-Remote unten, nur der Ausloeser ist jetzt Beruehren statt Klicken.
	MapService.setEggCollectHandler(function(player: Player, eggUid: string)
		EggLayService.collect(player, eggUid)
	end)

	RateLimiter.connect(Remotes.RequestCollectEgg, "RequestCollectEgg", function(player, eggUid: any)
		if typeof(eggUid) ~= "string" then return end
		EggLayService.collect(player, eggUid)
	end)

	RateLimiter.connect(Remotes.RequestCollectAllEggs, "RequestCollectAllEggs", function(player)
		EggLayService.collectAll(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		_lastTick[player] = nil
		_wasAway[player]  = nil
	end)

	-- Offline-Nachholen beim Join.
	PlayerService.onDataLoaded(function(player, data)
		-- Gelegt wird vom AUSGERUESTETEN Baerchi. Ein alter Spielstand kann
		-- beim Laden noch keinen (gueltigen) haben; IslandService ruestet in
		-- seinem eigenen onDataLoaded zwar nach, aber die Reihenfolge der
		-- Callbacks ist nicht zugesichert. autoEquipIfNone ist idempotent,
		-- der zweite Aufruf tut nichts.
		IslandService.autoEquipIfNone(data)

		local secondsAway = os.time() - (data.lastSeenAt or os.time())
		local laid, blocked = catchUp(player, data, true)

		if laid > 0 then
			local report: Types.OfflineEggReport = {
				laid        = laid,
				skipped     = blocked,
				secondsAway = math.max(0, secondsAway),
			}
			Remotes.OfflineEggReportReceived:FireClient(player, report)

			print(
				"[EggLayService]", player.Name,
				"| offline gelegt:", laid,
				if blocked then "| Obergrenze erreicht" else ""
			)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)

			local ok, err = pcall(tick)
			if not ok then
				warn("[EggLayService] Tick fehlgeschlagen:", err)
			end
		end
	end)

	print(
		"[EggLayService] Initialisiert | Intervall:", CHECK_INTERVAL, "s |",
		"max", EggConfig.MAX_UNCOLLECTED_EGGS, "Eier gleichzeitig"
	)
end

return EggLayService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX48"><Properties>
<string name="Name">EggTreeService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- EggTreeService.luau
-- ServerScriptService/Services/EggTreeService.luau
--
-- Einzige Zustaendigkeit (v14, Mega Egg Tree):
--   - Knoten des Ei-Baums freischalten, sobald ihre Bedingungen erfuellt sind
--     (und dem Spieler davon erzaehlen)
--   - Die Ei-Presse: 5 gleiche Eier -> 1 Ei der naechsten Stufe im Pfad
--   - Blaupausen einsetzen (aus Events)
--
-- Was "erfuellt" heisst, rechnet ausschliesslich Modules/EggTree — dieselbe
-- Funktion, mit der das Ei-Baum-Panel im Client die Fortschrittsbalken malt.
--
-- ============================================================
-- WANN GEPRUEFT WIRD
-- ============================================================
-- Bei JEDER Datenaenderung (PlayerService.onDataChanged), genau wie
-- QuestService den Index nachzieht. Die Bedingungen haengen an drei Dingen:
-- Hatch-Zaehlern (EggService), dem Index (QuestService traegt ihn nach) und
-- dem Rebirth-Zaehler (RebirthService). Alle drei rufen ohnehin markDirty —
-- ein eigener Aufruf an jeder Stelle waere die naechste Stelle, die man
-- vergisst. Ein Durchlauf kostet 20 kleine Pruefungen, das ist nichts.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types     = require(ReplicatedStorage.Network.Types)
local Remotes   = require(ReplicatedStorage.Network.Remotes)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local EggConfig = require(ReplicatedStorage.Config.EggConfig)
local EggTree   = require(ReplicatedStorage.Modules.EggTree)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local RateLimiter   = require(ServerScriptService.Util.RateLimiter)

local EggTreeService = {}

local function fail(player: Player, action: string, reason: Types.LocMsg)
	Remotes.ActionFailed:FireClient(player, action, reason)
end

local function announce(player: Player, eggs: { Types.EggType }, reason: string)
	for _, eggType in eggs do
		local result: Types.EggUnlockResult = { eggType = eggType, reason = reason }
		Remotes.EggTreeUnlocked:FireClient(player, result)
		print("[EggTreeService]", player.Name, "| Knoten frei:", eggType, "(" .. reason .. ")")
	end
end

-- Prueft den Baum und meldet neue Knoten. Gibt die neuen Eier zurueck. Ruft
-- KEIN markDirty (laeuft auch aus onDataChanged heraus).
function EggTreeService.check(player: Player, data: Types.PlayerData, reason: string?): { Types.EggType }
	local newly = EggTree.evaluate(data)
	if #newly > 0 then
		announce(player, newly, reason or "tree")
	end
	return newly
end

-- Schaltet einen Knoten direkt frei (Rebirth-Meilenstein "schaltet das Ei
-- frei", Debug). Gibt true zurueck, wenn er vorher gesperrt war.
function EggTreeService.forceUnlock(player: Player, data: Types.PlayerData, eggType: Types.EggType, reason: string): boolean
	if not EggConfig.data[eggType] or data.eggTree.unlocked[eggType] then
		return false
	end
	data.eggTree.unlocked[eggType] = true
	announce(player, { eggType }, reason)
	return true
end

-- Eine Blaupause gutschreiben (Events, siehe WP10).
function EggTreeService.grantBlueprint(player: Player, data: Types.PlayerData, amount: number)
	data.eggTree.blueprints = math.max(0, (data.eggTree.blueprints or 0) + math.floor(amount))
	print("[EggTreeService]", player.Name, "| Blaupause +", amount, "=", data.eggTree.blueprints)
end

--------------------------------------------------------------------------------
-- Ei-Presse
--------------------------------------------------------------------------------

function EggTreeService.press(player: Player, eggType: Types.EggType, path: Types.PathId?): Types.EggPressResult?
	local data = PlayerService.getData(player)
	if not data then return nil end

	local egg = EggConfig.data[eggType]
	if not egg then
		fail(player, "RequestPressEggs", Loc.msg("err.egg_unknown_type"))
		return nil
	end

	if not EggConfig.canPress(eggType) then
		fail(player, "RequestPressEggs", Loc.msg("err.press_blocked"))
		return nil
	end

	local target = EggConfig.getNextInPath(eggType, path)
	if not target then
		fail(player, "RequestPressEggs", Loc.msg("err.press_no_next"))
		return nil
	end

	if not EggTree.isUnlocked(data.eggTree, target) then
		fail(player, "RequestPressEggs", Loc.msg("err.press_target_locked", { egg = Loc.msg("egg." .. target .. ".name") }))
		return nil
	end

	local cost  = EggConfig.PRESS.cost
	local stock = data.island.eggStock[eggType] or 0
	if stock < cost then
		fail(player, "RequestPressEggs", Loc.msg("err.press_not_enough", {
			n = cost, egg = Loc.msg("egg." .. eggType .. ".name"), have = stock,
		}))
		return nil
	end

	data.island.eggStock[eggType] = stock - cost
	data.island.eggStock[target]  = (data.island.eggStock[target] or 0) + 1
	data.eggTree.pressed[target]  = (data.eggTree.pressed[target] or 0) + 1

	local result: Types.EggPressResult = { fromEgg = eggType, toEgg = target, used = cost }
	Remotes.EggPressResultReceived:FireClient(player, result)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	print("[EggTreeService]", player.Name, "| Presse:", cost, "x", eggType, "->", target)
	return result
end

--------------------------------------------------------------------------------
-- Blaupause einsetzen
--------------------------------------------------------------------------------

function EggTreeService.useBlueprint(player: Player, eggType: Types.EggType): boolean
	local data = PlayerService.getData(player)
	if not data then return false end

	if not EggTree.canUseBlueprint(data, eggType) then
		fail(player, "RequestUseBlueprint", Loc.msg("err.blueprint_not_here"))
		return false
	end

	data.eggTree.blueprints -= 1
	data.eggTree.bypass[eggType] = true

	-- Ist das Rebirth-Gate schon erfuellt, wird der Knoten sofort frei;
	-- sonst bleibt nur noch der Rebirth uebrig (Panel zeigt das an).
	local newly = EggTree.evaluate(data)
	announce(player, newly, "blueprint")

	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return true
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function EggTreeService.init()
	PlayerService.onDataChanged(function(player, data)
		if not data.eggTree then return end
		local newly = EggTreeService.check(player, data, "tree")
		if #newly > 0 then
			-- Nicht direkt markDirty (wir laufen gerade in einem). Der zweite
			-- Durchlauf findet nichts Neues mehr und endet.
			task.defer(function()
				if player.Parent and PlayerService.getData(player) == data then
					PlayerService.markDirty(player)
					PlayerService.saveNow(player)
				end
			end)
		end
	end)

	RateLimiter.connect(Remotes.RequestPressEggs, "RequestPressEggs", function(player, eggType: any, path: any)
		if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then return end
		local wantedPath: Types.PathId? = nil
		if typeof(path) == "string" and (path == "Gold" or path == "Kristall" or path == "Void"
			or path == "Kosmos" or path == "Stamm")
		then
			wantedPath = path :: Types.PathId
		end
		EggTreeService.press(player, eggType :: Types.EggType, wantedPath)
	end)

	RateLimiter.connect(Remotes.RequestUseBlueprint, "RequestUseBlueprint", function(player, eggType: any)
		if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then return end
		EggTreeService.useBlueprint(player, eggType :: Types.EggType)
	end)

	print("[EggTreeService] Initialisiert |", #EggConfig.getOrderedIds(), "Eier im Baum")
end

return EggTreeService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX49"><Properties>
<string name="Name">EventService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- EventService.luau
-- ServerScriptService/Services/EventService.luau
--
-- Einzige Zustaendigkeit:
--   - Den Event-Zyklus fahren (Pause → Event → Pause → ...)
--   - Das Event-Pit in der Weltmitte entsprechend umfaerben (MapService)
--   - Die Countdown-Tafel darueber beschriften
--
-- Kennt weiterhin WEDER Spielerdaten NOCH Waehrung. Dass ein Event inzwischen
-- eine spielerische Auswirkung hat (Stat-Fortschritt fuer teilnehmende
-- Baerchis), aendert daran nichts: dieser Service meldet nur, WANN ein Event
-- endet — was daraufhin passiert, entscheidet allein
-- EventParticipationService ueber den onEventEnded-Callback weiter unten.
--
-- Genau diese Trennung ist der Grund, warum der Zyklus hier keine einzige
-- Zeile Spiellogik bekommt: sonst waere dieser Service beim naechsten Feature
-- ("Event gibt auch Honig") die Stelle, an der drei fremde Systeme
-- zusammenlaufen.
--
-- ============================================================
-- WARUM EIN EIGENER SERVICE UND NICHT TEIL VON MAPSERVICE
-- ============================================================
-- MapService baut und AENDERT Geometrie, entscheidet aber nirgendwo sonst
-- WANN etwas passiert — das ist ueberall sonst Sache des aufrufenden Service
-- (CombatService/PitArenaService fuer den Kampf-Ablauf, HoneyService fuer die
-- Produktions-Zeitpunkte). Der Event-Zyklus ist genau so ein "wann", also
-- bekommt er einen eigenen, kleinen Service statt MapService eine zweite
-- Zustaendigkeit aufzubuerden.

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local EventConfig = require(ReplicatedStorage.Config.EventConfig)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)  -- HBB Paket 6
local MapConfig    = require(ReplicatedStorage.Config.MapConfig)
local Remotes      = require(ReplicatedStorage.Network.Remotes)
local MapService   = require(ServerScriptService.Services.MapService)

local EventService = {}

-- Das Boss-Event, auf das das Wespen-Nest zeigt (EventConfig.EVENTS)
local WASP_QUEEN_ID = "WaspQueen"

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

-- Das gerade laufende Event, oder nil waehrend einer Pause.
local _active: EventConfig.EventDef? = nil

-- Zeitstempel (os.time()), an dem die aktuelle Phase (Event ODER Pause) endet.
local _phaseEndsAt = 0

-- Index in EventConfig.EVENTS, der als naechstes drankommt. Der Reihe nach,
-- kein Zufall — siehe EventConfig, Kommentar bei EVENTS.
local _nextIndex = 1

-- In welchem Durchlauf des Zyklus das naechste Event liegt (ab 1). Events mit
-- everyNthCycle (Boss) laufen nur in passenden Durchlaeufen; die Regel steht
-- in EventConfig.isScheduledInCycle, hier wird nur weitergezaehlt.
local _nextCycle = 1

-- Beobachter, die beim START eines Events benachrichtigt werden wollen
-- (EventParticipationService startet damit den Event-Handler).
local _onEventStarted: { (EventConfig.EventDef) -> () } = {}

-- Beobachter, die beim ENDE eines Events benachrichtigt werden wollen.
-- Aktuell genau einer: EventParticipationService, der dann die Stat-Stufen
-- an die anwesenden Baerchis verteilt.
local _onEventEnded: { (EventConfig.EventDef) -> () } = {}

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function formatCountdown(seconds: number): string
	local clamped = math.max(0, math.floor(seconds))
	local minutes = clamped // 60
	local secs    = clamped % 60
	return string.format("%d:%02d", minutes, secs)
end

-- Die drei Angaben einer Phasen-Meldung: laufendes Event (nil in der Pause),
-- Restzeit der Phase, und welches Event als naechstes kommt.
--
-- Das NAECHSTE Event gehoert mit dazu, weil der Spieler waehrend der Pause
-- entscheidet: nur wenn er weiss, was gleich laeuft, kann er seinen Baerchi
-- rechtzeitig losschicken (der Weg in die Mitte dauert selbst ein paar
-- Sekunden). Auf der Tafel steht dieselbe Information — die sieht aber nur,
-- wer gerade in die Weltmitte schaut.
local function phasePayload(): (string?, number, string)
	return
		(if _active then _active.id else nil),
		math.max(0, _phaseEndsAt - os.time()),
		EventConfig.EVENTS[_nextIndex].id
end

-- Sagt ALLEN Clients, welches Event gerade laeuft (bzw. dass Pause ist).
--
-- Nur bei einem PHASENWECHSEL und beim Join, nicht im Sekundentakt: die Uhr
-- steht sichtbar auf der Tafel in der Welt, dafuer braucht es kein Remote. Der
-- Client benutzt die Meldung ausschliesslich, um auf der Baerchi-Karte
-- anzuzeigen, was eine Teilnahme gerade bringen wuerde (siehe BaerchiPanel).
local function broadcastPhase()
	Remotes.EventPhaseChanged:FireAllClients(phasePayload())
end

-- Stellt _nextIndex auf das naechste Event, das im jeweiligen Durchlauf
-- laeuft. Beim Umlauf (letztes → erstes Event) beginnt ein neuer Durchlauf.
local function advance()
	local count = #EventConfig.EVENTS
	for _ = 1, count * 2 do
		_nextIndex += 1
		if _nextIndex > count then
			_nextIndex = 1
			_nextCycle += 1
		end
		if EventConfig.isScheduledInCycle(EventConfig.EVENTS[_nextIndex], _nextCycle) then
			return
		end
	end
end

local function startEvent()
	local def = EventConfig.EVENTS[_nextIndex]
	advance()

	_active      = def
	_phaseEndsAt = os.time() + EventConfig.getDuration(def)

	MapService.setEventPitTheme({
		floorColor = def.floorColor,
		fenceColor = def.fenceColor,
		ringColor  = def.ringColor,
	})

	broadcastPhase()

	print("[EventService] Event gestartet:", def.displayName, "|", EventConfig.describeReward(def))

	for _, callback in _onEventStarted do
		local ok, err = pcall(callback, def)
		if not ok then
			warn("[EventService] onEventStarted-Callback fehlgeschlagen:", err)
		end
	end
end

local function endEvent()
	local finished = _active
	_active      = nil
	_phaseEndsAt = os.time() + EventConfig.EVENT_GAP_SECONDS

	MapService.setEventPitTheme(nil)
	broadcastPhase()

	if finished then
		print("[EventService] Event beendet:", finished.displayName)

		-- Beobachter NACH dem Aufraeumen benachrichtigen: sie sollen einen
		-- Zustand vorfinden, in dem das Event nachweislich vorbei ist
		-- (getActive() gibt bereits nil zurueck). Jeder Callback in pcall — ein
		-- Fehler beim Verteilen der Belohnung darf den Zyklus nicht anhalten,
		-- sonst stuende die Event-Uhr fuer den ganzen Server still.
		for _, callback in _onEventEnded do
			local ok, err = pcall(callback, finished)
			if not ok then
				warn("[EventService] onEventEnded-Callback fehlgeschlagen:", err)
			end
		end
	end
end

-- Ein Tick pro Sekunde: Phase ggf. wechseln, danach die Tafel nachziehen.
-- Zeit wird immer aus os.time()/_phaseEndsAt neu gerechnet statt einfach
-- runtergezaehlt — ein einzelner ausgesetzter Tick (Server-Laghlack) darf die
-- Uhr nicht verschieben.
local function tick()
	local remaining = _phaseEndsAt - os.time()

	if remaining <= 0 then
		if _active then
			endEvent()
		else
			startEvent()
		end
		remaining = _phaseEndsAt - os.time()
	end

	-- Auf der Tafel steht IMMER auch die Belohnung — bei zehn Events im
	-- Wechsel waere "Naechstes Event / in 4:12" sonst keine Information, auf
	-- die man eine Entscheidung stuetzen kann. Waehrend der Pause wird deshalb
	-- zusaetzlich angekuendigt, WELCHES Event als naechstes kommt: nur so kann
	-- ein Spieler seinen Baerchi rechtzeitig hinschicken, wenn genau dieses
	-- Event den Stat bringt, den er braucht.
	if _active then
		MapService.setEventBanner(
			string.format("%s  •  LIVE", _active.displayName),
			string.format("noch %s", formatCountdown(remaining)),
			_active.bannerColor,
			EventConfig.describeReward(_active)
		)
	else
		local upcoming = EventConfig.EVENTS[_nextIndex]

		MapService.setEventBanner(
			string.format("Naechstes: %s", upcoming.displayName),
			string.format("in %s", formatCountdown(remaining)),
			MapConfig.EVENT_PIT_BANNER_IDLE_COLOR,
			EventConfig.describeReward(upcoming)
		)
	end

	-- HBB Paket 6: Wespen-Nest am Mast zaehlt bis zur Koenigin herunter
	-- (sprachneutral: Biene + Uhr) und leuchtet kurz davor und waehrenddessen.
	if FeatureFlags.isOn("MAP_V2_WASP_NEST") then
		local activeId = if _active then _active.id else nil
		local untilBoss = EventConfig.secondsUntilStart(WASP_QUEEN_ID, activeId, remaining, _nextIndex, _nextCycle)
		if untilBoss then
			MapService.setWaspNest(
				if untilBoss == 0 then "🐝 LIVE" else "🐝 " .. formatCountdown(untilBoss),
				untilBoss <= MapConfig.WASP_NEST.glowSeconds
			)
		end
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Das gerade laufende Event, falls eins laeuft — nil waehrend einer Pause.
-- Wird von EventParticipationService gelesen (und vom Client ueber dessen
-- Zustandsmeldungen indirekt mitbekommen).
function EventService.getActive(): EventConfig.EventDef?
	return _active
end

-- Das Event, das als NAECHSTES an der Reihe ist. Waehrend einer Pause ist das
-- der Countdown-Gegenstand auf der Tafel; waehrend eines laufenden Events ist
-- es das darauf folgende.
--
-- Gibt es immer (der Zyklus ist ein Ring), deshalb kein optionaler Rueckgabewert.
function EventService.getNext(): EventConfig.EventDef
	return EventConfig.EVENTS[_nextIndex]
end

-- Sekunden bis zum Ende der laufenden Phase (Event ODER Pause). Nie negativ.
function EventService.getRemainingSeconds(): number
	return math.max(0, _phaseEndsAt - os.time())
end

-- Beendet die laufende Phase sofort — laeuft gerade ein Event, ist es danach
-- vorbei (inklusive aller onEventEnded-Callbacks); ist gerade Pause, startet
-- sofort das naechste Event.
--
-- Nur fuer den Studio-Test gedacht (DebugService): ein Zyklus aus 3 Minuten
-- Event und 5 Minuten Pause laesst sich sonst nicht in vertretbarer Zeit
-- durchspielen. Bewusst KEIN eigener Sonderweg — es wird nur die Uhr
-- vorgestellt, den Rest macht der normale tick(). Dadurch kann dieser Aufruf
-- auch nichts kaputt machen, was im echten Ablauf nicht ohnehin passiert.
function EventService.skipPhase()
	_phaseEndsAt = os.time()
end

-- Stellt den Zyklus so, dass als naechstes GENAU dieses Event kommt, und
-- startet es sofort. Gibt false zurueck, wenn es die id nicht gibt.
--
-- Ebenfalls nur fuer den Studio-Test gedacht (DebugService): bei zehn Events
-- im Wechsel dauert ein voller Durchlauf 80 Minuten — ein bestimmtes Event
-- abzuwarten waere sonst keine Testmoeglichkeit, sondern eine Geduldsprobe.
--
-- Laeuft gerade ein Event, wird es ordentlich beendet (inklusive aller
-- onEventEnded-Callbacks, also auch der Belohnungen) statt einfach ersetzt —
-- sonst haette ein Testaufruf nebenbei die Teilnahme aller Anwesenden
-- verschluckt.
function EventService.startById(id: string): boolean
	local index: number? = nil
	for i, def in EventConfig.EVENTS do
		if def.id == id then
			index = i
			break
		end
	end

	if not index then
		return false
	end

	if _active then
		endEvent()
	end

	_nextIndex = index
	startEvent()
	return true
end

-- Registriert einen Callback, der laeuft sobald ein Event ZU ENDE ist.
--
-- Anders als PlayerService.onDataLoaded ist die Reihenfolge zu init() hier
-- UNKRITISCH: der Server startet grundsaetzlich in einer Pause (siehe init),
-- das erste Event endet also fruehestens nach EVENT_GAP + EVENT_DURATION
-- Sekunden. Bis dahin sind laengst alle Services angemeldet.
function EventService.onEventStarted(callback: (EventConfig.EventDef) -> ())
	table.insert(_onEventStarted, callback)
end

function EventService.onEventEnded(callback: (EventConfig.EventDef) -> ())
	table.insert(_onEventEnded, callback)
end

function EventService.init()
	-- Wer spaeter dazukommt, hat den letzten Phasenwechsel verpasst — also
	-- bekommt jeder neue Spieler den Stand einmal gezielt zugeschickt. Ohne
	-- das zeigte seine Baerchi-Karte bis zum naechsten Wechsel (bis zu fuenf
	-- Minuten) "gerade kein Event", obwohl das Pit vor ihm leuchtet.
	Players.PlayerAdded:Connect(function(player)
		Remotes.EventPhaseChanged:FireClient(player, phasePayload())
	end)

	print(
		"[EventService] Initialisiert |", #EventConfig.EVENTS, "Events im Wechsel",
		"(manche nur jeden n-ten Durchlauf) | individuelle Dauer,", EventConfig.EVENT_GAP_SECONDS, "s Pause"
	)
end

-- Der Zyklus laeuft erst in start(): dann steht die Welt (das Event-Pit baut
-- MapService.init) und alle onEventStarted/onEventEnded-Rueckrufe sind
-- angemeldet.
function EventService.start()
	-- Server startet in der Pause, nicht mitten in einem Event — sonst wuerde
	-- jeder frisch gestartete Server sofort mit einem laufenden Event
	-- begruesst, was sich nach einem Fehler anfuehlt statt nach Absicht.
	-- HBB Paket 6: die erste Pause eines neuen Servers ist kuerzer.
	local firstGap = if FeatureFlags.isOn("EVENT_V2_TIMER")
		then EventConfig.FIRST_GAP_SECONDS
		else EventConfig.EVENT_GAP_SECONDS
	_phaseEndsAt = os.time() + firstGap
	MapService.setEventPitTheme(nil)

	task.spawn(function()
		while true do
			local ok, err = pcall(tick)
			if not ok then
				warn("[EventService] Tick fehlgeschlagen:", err)
			end
			task.wait(1)
		end
	end)
end

return EventService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX50"><Properties>
<string name="Name">FunnelService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- FunnelService.luau
-- ServerScriptService/Services/FunnelService.luau
--
-- Einzige Zustaendigkeit:
--   - Messpunkte an Roblox Analytics melden: Onboarding-Trichter (F01–F10),
--     Zeit je Schritt und Pacing-Meilenstein in der ersten Sitzung (Paket 8)
--     und wenige UI-Ereignisse vom Client
--
-- Kontext: Der Plan "Honey Bear Brawl" (Paket 0) braucht Zahlen aus Playtest
-- und Launch: wo steigen neue Spieler aus? Deshalb misst der Trichter nur
-- Konten, die juenger als FunnelConfig.NEW_PLAYER_MAX_AGE sind.
--
-- Name bewusst NICHT "AnalyticsService": das wuerde den Roblox-Dienst gleichen
-- Namens verdecken.
--
-- API-Wahl: LogOnboardingFunnelStepEvent(player, step, stepName). Das ist der
-- Trichter-Typ fuer "einmal pro Nutzer" und braucht keine funnelSessionId —
-- genau der Fall hier. (LogFunnelStepEvent waere fuer wiederkehrende Trichter
-- wie einen Shop-Kauf gedacht.)
--
-- In Studio nimmt Roblox keine Analytics-Events an. Dort wird nur geloggt
-- (DebugConfig.FUNNEL_LOG), damit Testschritte trotzdem pruefbar sind.
--
-- Andere Services melden einen Schritt mit genau einer Zeile:
--   FunnelService.step(player, "F03_FirstEggOpened")
-- Ein Schritt zaehlt pro Sitzung hoechstens einmal; Wiederholungen sind
-- billig (eine Tabellen-Abfrage) und duerfen ueberall stehen.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local AnalyticsService  = game:GetService("AnalyticsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Remotes      = require(ReplicatedStorage.Network.Remotes)
local FunnelConfig = require(ReplicatedStorage.Config.FunnelConfig)
local DebugConfig  = require(ReplicatedStorage.Config.DebugConfig)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local RateLimiter   = require(ServerScriptService.Util.RateLimiter)

local FunnelService = {}

local IS_STUDIO = RunService:IsStudio()

-- Wie oft der Server nach der ersten Bewegung schaut. Eine Sekunde reicht:
-- F02 misst "hat sich ueberhaupt bewegt", nicht wann genau.
local MOVE_CHECK_INTERVAL = 1

-- [Player] = { [stepName] = true } — was in dieser Sitzung schon gemeldet ist
local _done: { [Player]: { [string]: boolean } } = {}
-- [Player] = Anzahl UI-Ereignisse in dieser Sitzung
local _uiCount: { [Player]: number } = {}
-- [Player] = erster gemessener Standpunkt (fuer F02)
local _firstPos: { [Player]: Vector3 } = {}
-- [Player] = os.clock() beim Join / ob es die erste Sitzung des Kontos ist
local _sessionStart: { [Player]: number } = {}
local _firstSession: { [Player]: boolean } = {}

local function log(...: any)
	if DebugConfig.FUNNEL_LOG then
		print("[FunnelService]", ...)
	end
end

local function accountAge(player: Player): number?
	local data = PlayerService.getData(player)
	if not data then return nil end
	return os.time() - (data.createdAt or os.time())
end

local function isMeasured(player: Player, stepName: string): boolean
	local age = accountAge(player)
	if not age then return false end
	if stepName == "F10_SecondSession" then
		return age <= FunnelConfig.SECOND_SESSION_MAX_AGE
	end
	return age <= FunnelConfig.NEW_PLAYER_MAX_AGE
end

-- HBB Paket 8: Zeitpunkt eines Schritts/Meilensteins melden (siehe
-- FunnelConfig.TIME_EVENT). Nur die erste Sitzung bekommt eine Zeit: dort ist
-- "Sekunden seit Join" gleich der aktiven Spielzeit, wie im Pacing-Sim.
local function logTime(player: Player, name: string)
	local started = _sessionStart[player]
	if not started then return end
	local first = _firstSession[player] == true
	local seconds = if first then math.floor(os.clock() - started) else 0
	log(player.Name, "Zeit", name, if first then string.format("%d s (Sitzung 1)", seconds) else "(spaetere Sitzung)")

	if IS_STUDIO then return end
	local ok, err = pcall(function()
		AnalyticsService:LogCustomEvent(player, FunnelConfig.TIME_EVENT, seconds, {
			[Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = name,
			[Enum.AnalyticsCustomFieldKeys.CustomField02.Name] = if first then "S1" else "S2+",
		})
	end)
	if not ok then
		warn("[FunnelService] Zeit-Event fehlgeschlagen:", name, err)
	end
end

local function highestBuildingLevel(data: any): number
	local best = 0
	for _, building in data.island.buildings do
		best = math.max(best, building.level)
	end
	return best
end

-- Sitzungsbeginn merken. Meilensteine, die schon VOR dieser Sitzung erreicht
-- waren, gelten als erledigt und melden nichts.
local function beginSession(player: Player, data: any, firstSession: boolean)
	_sessionStart[player] = os.clock()
	_firstSession[player] = firstSession
	local done = _done[player]
	if not done then
		done = {}
		_done[player] = done
	end
	local level = highestBuildingLevel(data)
	for _, milestone in FunnelConfig.PACING_MILESTONES do
		if level >= milestone.buildingLevel then done[milestone.name] = true end
	end
end

-- Pacing-Meilensteine pruefen (aus onDataChanged; billig: 3 Gebaeude)
local function checkMilestones(player: Player, data: any)
	local done = _done[player]
	if not done or not _sessionStart[player] then return end
	local level: number? = nil
	for _, milestone in FunnelConfig.PACING_MILESTONES do
		if done[milestone.name] then continue end
		level = level or highestBuildingLevel(data)
		if (level :: number) >= milestone.buildingLevel then
			done[milestone.name] = true
			-- Bis 48 h: wer 30 min/Tag spielt, erreicht Look 2 evtl. erst am Tag 2
			if isMeasured(player, "F10_SecondSession") then
				logTime(player, milestone.name)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

function FunnelService.step(player: Player, stepName: string)
	-- Abrechnung beim Verlassen (CombatService) kann nach PlayerRemoving
	-- laufen; dann nichts mehr anlegen, sonst bliebe die Tabelle haengen.
	if player.Parent == nil then return end

	local index = FunnelConfig.STEP_INDEX[stepName]
	if not index then
		warn("[FunnelService] Unbekannter Schritt:", stepName)
		return
	end

	local done = _done[player]
	if not done then
		done = {}
		_done[player] = done
	end
	if done[stepName] then return end
	-- Auch bei Veteranen merken: sonst wuerde jede Wiederholung erneut das
	-- Alter pruefen.
	done[stepName] = true

	if not isMeasured(player, stepName) then return end

	log(player.Name, string.format("Schritt %02d", index), stepName)
	if stepName ~= "F01_Join" and stepName ~= "F10_SecondSession" then
		logTime(player, stepName)
	end

	if IS_STUDIO then return end
	local ok, err = pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, index, stepName)
	end)
	if not ok then
		warn("[FunnelService] Trichter-Event fehlgeschlagen:", stepName, err)
	end
end

-- Nur fuer DebugService ("state fresh"): die Sitzung beginnt fuer den
-- Trichter von vorn, damit F01–F09 in Studio erneut erscheinen.
function FunnelService.debugReset(player: Player)
	_done[player] = {}
	_uiCount[player] = 0
	_firstPos[player] = nil
	local data = PlayerService.getData(player)
	if data then beginSession(player, data, true) end
	FunnelService.step(player, "F01_Join")
end

--------------------------------------------------------------------------------
-- UI-Ereignisse vom Client
--------------------------------------------------------------------------------

local function onUiEvent(player: Player, kind: any, name: any)
	if typeof(kind) ~= "string" or not FunnelConfig.UI_EVENT_KINDS[kind] then
		return
	end
	-- Nur IdleStanding kommt ohne Panel-Namen.
	local panel: string? = nil
	if kind ~= "IdleStanding" then
		if typeof(name) ~= "string" or not FunnelConfig.UI_PANEL_NAMES[name] then
			return
		end
		panel = name
	end

	local count = (_uiCount[player] or 0) + 1
	if count > FunnelConfig.MAX_UI_EVENTS_PER_SESSION then return end
	_uiCount[player] = count

	if not isMeasured(player, "F01_Join") then return end

	log(player.Name, "UI", kind, panel or "")

	if IS_STUDIO then return end
	local ok, err = pcall(function()
		if panel then
			AnalyticsService:LogCustomEvent(player, kind, 1, {
				[Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = panel,
			})
		else
			AnalyticsService:LogCustomEvent(player, kind)
		end
	end)
	if not ok then
		warn("[FunnelService] UI-Event fehlgeschlagen:", kind, err)
	end
end

--------------------------------------------------------------------------------
-- F02: erste Bewegung, rein serverseitig gemessen (kein Remote noetig)
--------------------------------------------------------------------------------

local function checkFirstMoves()
	for _, player in Players:GetPlayers() do
		local done = _done[player]
		if not done or done.F02_FirstMove or not done.F01_Join then continue end

		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if not root or not root:IsA("BasePart") then continue end

		local first = _firstPos[player]
		if not first then
			_firstPos[player] = root.Position
		elseif (root.Position - first).Magnitude >= FunnelConfig.FIRST_MOVE_DISTANCE then
			FunnelService.step(player, "F02_FirstMove")
		end
	end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function FunnelService.init()
	RateLimiter.connect(Remotes.RequestLogUiEvent, "RequestLogUiEvent", onUiEvent)

	-- onPlayerReady: der Stand ist fertig geladen, createdAt ist sicher gesetzt.
	PlayerService.onPlayerReady(function(player, data)
		-- Ein frisch angelegtes Konto hat createdAt ≈ jetzt. Ist es beim Join
		-- schon aelter, war der Spieler vorher schon einmal da.
		local returning = os.time() - (data.createdAt or os.time()) >= FunnelConfig.SECOND_SESSION_MIN_AGE
		beginSession(player, data, not returning)
		FunnelService.step(player, "F01_Join")
		if returning then
			FunnelService.step(player, "F10_SecondSession")
		end
	end)

	-- F04: Der erste Baerchi wird beim Oeffnen automatisch ausgeruestet
	-- (IslandService.autoEquipIfNone, ohne Remote). Ein Beobachter erfasst
	-- beide Wege — automatisch und per Knopf — mit einer Stelle. Er schreibt
	-- nichts zurueck, loest also kein markDirty aus.
	PlayerService.onDataChanged(function(player, data)
		if data.island.equippedUid ~= nil then
			FunnelService.step(player, "F04_BearEquipped")
		end
		checkMilestones(player, data)
	end)

	Players.PlayerRemoving:Connect(function(player)
		_done[player] = nil
		_uiCount[player] = nil
		_firstPos[player] = nil
		_sessionStart[player] = nil
		_firstSession[player] = nil
	end)
end

function FunnelService.start()
	task.spawn(function()
		while true do
			task.wait(MOVE_CHECK_INTERVAL)
			checkFirstMoves()
		end
	end)
end

return FunnelService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX51"><Properties>
<string name="Name">FusionService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- FusionService.luau
-- ServerScriptService/Services/FusionService.luau
--
-- Einzige Zustaendigkeit:
--   - Fusions-Requests validieren und ausfuehren
--   - Zwei Baerchis verbrauchen, einen hoeherwertigen erzeugen
--
-- ============================================================
-- FUSIONS-REGEL (verbindlich, hier dokumentiert weil sie sich nicht
-- vollstaendig aus den Configs ableiten laesst)
-- ============================================================
-- Seit v3: kein FusionLab-Gebaeude mehr. Fusion ist ein reines GUI-Feature
-- (FusionPanel/BaerchiInventory) und von Anfang an voll freigeschaltet —
-- kein Unlock-Level, kein Mythic-Level, Skill-Transfer immer an.
--   1. Es werden genau ZWEI verschiedene Baerchis derselben Rarity verbraucht.
--   2. v14: Die Rarity steigt NICHT mehr. Fusion fasst nur die Stats zusammen
--      (Wunsch des Projektinhabers: "Fusionen sollen nicht einfach Rarities
--      hochfliegen lassen, die sollen nur die Stats mergen"). Das Ergebnis
--      ist ein Baerchi DERSELBEN Rarity mit der Art (configId) des
--      levelhoeheren Inputs (bei Gleichstand: A). Hoehere Rarities kommen
--      ausschliesslich aus dem Ei-Baum.
--   3. (entfallen seit v14: Legendary + Legendary -> fester Mythic)
--   4. v14: Jede Rarity ist fusionierbar, auch Mythic bis Omega.
--   5. Ergebnis bekommt fusionBonus = EconomyConfig.getFusionStatBonus()
--      (fester Wert) und isFusionResult = true.

-- ============================================================
-- NEU (v8): "DAS BESSERE GEWINNT — STAT FUER STAT"
-- ============================================================
-- Regel A — BASISWERTE.
--   Die vier Basiswerte (hp/atk/spd/pwr) werden nicht mehr von EINEM Input
--   uebernommen, sondern JEDER EINZELN als Maximum ueber beide Inputs UND den
--   ausgewuerfelten Ergebnis-configId. Ein Fusions-Ergebnis ist damit in
--   keinem Stat schlechter als das, was hineingegangen ist.
--
--   Technisch: Basiswerte haengen sonst allein am configId. Das Ergebnis
--   bekommt deshalb ein Baerchi.baseStatOverride, das
--   CombatCalculator.getEffectiveStats bevorzugt. Fuer jeden NICHT fusionierten
--   Baerchi bleibt das Feld nil und die Rechnung ist unveraendert.
--
--   Der Ergebnis-configId zaehlt bewusst mit in das Maximum: sonst koennte ein
--   Legendary-Ergebnis aus zwei schwachen Epics schlechtere Basiswerte haben
--   als jeder andere Baerchi seiner eigenen Rarity.
--
-- Regel B — STAT-LEVEL (Feature 1, Event-Teilnahme).
--   Genauso: pro Stat das Maximum der beiden Inputs. Auch hier NICHT "der
--   weitere Input gewinnt alles" — jeder Stat einzeln. Anschliessend auf die
--   Obergrenze der ERGEBNIS-Rarity geklemmt (die ist immer hoeher, der Clamp
--   ist also reine Vorsorge).
--
-- Regel C — DER SPIELER DARF EINE SACHE SPERREN.
--   Frueher entschied dieser Service allein, welcher Skill und welches Level
--   das Ergebnis bekommt. Jetzt kann der Spieler im Fusions-Menue GENAU EINE
--   von drei Eigenschaften sperren und dabei sagen, von WELCHEM Input sie
--   kommen soll:
--       "ability" → skillId
--       "level"   → Baerchi-Level
--       "eggs"    → statLevels.egg
--   Fuer alles NICHT Gesperrte gilt die Standard-Regel "das Bessere":
--       Level   → das hoehere der beiden (frueher: der Durchschnitt)
--       Ability → Skill des levelhoeheren Inputs (unveraendert)
--       Eier    → der hoehere der beiden Werte
--
--   Wichtig: Sperren ist eine bewusste AUSNAHME von "das Bessere gewinnt". Der
--   Spieler darf damit ausdruecklich auch das SCHLECHTERE Level oder die
--   schwaechere Ability erzwingen — z.B. weil er unbedingt den Skill von A
--   will, obwohl B weiter ist. Genau das ist der Sinn der Regel; hier wird
--   deshalb NICHT stillschweigend auf das Bessere korrigiert.
--
--   Nicht sperrbar sind die Basiswerte (Regel A) und die vier Stat-Level
--   (Regel B) — die mischen sich immer automatisch.
--
-- Regel D — PROMOTION UND CHARMS FANGEN BEI NULL AN.
--   Das Ergebnis ist technisch ein NEUER Baerchi (neue uid). Es erbt weder den
--   Promotions-Stand noch die Charms seiner Eltern. Bestaetigte Entscheidung:
--   sonst liessen sich gut gewuerfelte Charms ueber Fusionen vervielfaeltigen,
--   und Promotion waere kein eigener Fortschritt mehr, sondern ein Nebenprodukt
--   der Fusion.
--
-- Regel E — DIE HOEHERE MUTATION VERERBT SICH (seit v11; vorher binaer
-- "Inverted").
--   Das Ergebnis bekommt die hoehere der beiden Mutations-Stufen
--   (BaerchiConfig.pickHigherMutation, Vergleich ueber MUTATION_ORDER). Das
--   ist dieselbe Linie wie Regel A und B ("das Bessere gewinnt") und macht
--   einen mutierten Baerchi nicht wertlos, sobald man ihn weiterfusionieren
--   will — auch nicht gegen einen Partner mit einer ANDEREN, niedrigeren
--   Mutations-Stufe.
--
--   Es entsteht dadurch KEINE Vermehrung: eine Fusion verbraucht zwei Baerchis
--   und liefert einen. Aus zwei mutierten wird einer — die Zahl der mutierten
--   Baerchis im Spiel kann ueber Fusion also nur sinken.
--
--   ANNAHME, nicht vom Projektinhaber vorgegeben: falls eine Mutation
--   stattdessen ausschliesslich aus dem Ei kommen soll, ist das eine Zeile
--   weiter unten (mutation = nil statt pickHigherMutation).

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local EconomyConfig   = require(ReplicatedStorage.Config.EconomyConfig)
local PromotionConfig = require(ReplicatedStorage.Config.PromotionConfig)
local BaerchiFactory  = require(ReplicatedStorage.Modules.BaerchiFactory)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local ActivityLock   = require(ServerScriptService.Util.ActivityLock)
local IslandService = require(ServerScriptService.Services.IslandService)
local RateLimiter   = require(ServerScriptService.Util.RateLimiter)

local FusionService = {}

export type LockedProperty = "ability" | "level" | "eggs"
export type LockedFrom     = "A" | "B"

local function fail(player: Player, reason: Types.LocMsg?)
	Remotes.ActionFailed:FireClient(player, "RequestFuseBaerchis", reason or Loc.msg("err.unknown"))
end

-- v14: Die Art des Ergebnisses — die des levelhoeheren Inputs, bei
-- Gleichstand A. Die Rarity bleibt dieselbe (Regel 2).
local function pickResultConfigId(a: Types.Baerchi, b: Types.Baerchi): string
	if b.level > a.level then
		return b.configId
	end
	return a.configId
end

--------------------------------------------------------------------------------
-- Regel A: Basiswerte Stat fuer Stat mischen
--------------------------------------------------------------------------------

-- Der wirksame Basiswert eines Inputs: sein eigenes Override, wo gesetzt,
-- sonst der Wert seines configId. Damit vererbt sich ein bereits gemischter
-- Basiswert ueber mehrere Fusionen hinweg weiter, statt bei der naechsten
-- Fusion wieder auf den Config-Wert zurueckzufallen.
local function effectiveBase(baerchi: Types.Baerchi, key: string): number
	local override = baerchi.baseStatOverride
	if override and (override :: any)[key] ~= nil then
		return (override :: any)[key]
	end

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		return 0
	end
	return (def.baseStats :: any)[key] or 0
end

local function mergeBaseStats(a: Types.Baerchi, b: Types.Baerchi, resultConfigId: string)
	local resultDef = BaerchiConfig.getById(resultConfigId)
	local merged: { [string]: number } = {}

	for _, key in { "hp", "atk", "spd", "pwr" } do
		local own = if resultDef then ((resultDef.baseStats :: any)[key] or 0) else 0
		merged[key] = math.max(own, effectiveBase(a, key), effectiveBase(b, key))
	end

	return {
		hp  = merged.hp,
		atk = merged.atk,
		spd = merged.spd,
		pwr = merged.pwr,
	}
end

--------------------------------------------------------------------------------
-- Regel B/C: Stat-Level mischen, Sperr-Auswahl anwenden
--------------------------------------------------------------------------------

local function statLevelOf(baerchi: Types.Baerchi, key: string): number
	local levels = baerchi.statLevels
	if not levels then
		return 0
	end
	return ((levels :: any)[key] or 0)
end

local function mergeStatLevels(
	a: Types.Baerchi,
	b: Types.Baerchi,
	resultRarity: Types.Rarity,
	lockedProperty: LockedProperty?,
	lockedFrom: LockedFrom?
): Types.StatLevels

	local cap    = PromotionConfig.getStatCap(resultRarity)
	local merged = PromotionConfig.newStatLevels()

	for _, key in PromotionConfig.ALL_STATS do
		(merged :: any)[key] = math.min(cap, math.max(statLevelOf(a, key), statLevelOf(b, key)))
	end

	-- Regel C: nur "eggs" greift in die Stat-Level ein — und nur dann wird der
	-- automatische Maximum-Wert ueberschrieben, ausdruecklich auch nach unten.
	if lockedProperty == "eggs" and lockedFrom then
		local source = if lockedFrom == "A" then a else b
		merged.egg = math.min(cap, statLevelOf(source, "egg"))
	end

	return merged
end

--------------------------------------------------------------------------------
-- Fusion
--------------------------------------------------------------------------------

function FusionService.fuse(
	player: Player,
	uidA: string,
	uidB: string,
	lockedProperty: LockedProperty?,
	lockedFrom: LockedFrom?
)
	local data = PlayerService.getData(player)
	if not data then return end

	if uidA == uidB then
		fail(player, Loc.msg("err.fuse_self"))
		return
	end

	local a = data.island.baerchis[uidA]
	local b = data.island.baerchis[uidB]
	if not a or not b then
		fail(player, Loc.msg("err.baerchi_not_found"))
		return
	end

	if a.rarity ~= b.rarity then
		fail(player, Loc.msg("err.fuse_rarity_mismatch"))
		return
	end

	-- v12: den ausgeruesteten Baerchi nicht wegfusionieren, waehrend er
	-- unterwegs ist (PIT, Event, Honig-Teich) — die Figur wuerde mitten im
	-- Lauf verschwinden, und ein PIT-Lauf koennte nicht mehr sauber
	-- abgerechnet werden.
	local equipped = data.island.equippedUid
	if (equipped == uidA or equipped == uidB) and not ActivityLock.isFree(player) then
		fail(player, Loc.msg("err.fuse_equipped_away"))
		return
	end

	-- Eine Sperre ohne Quelle (oder umgekehrt) ist keine gueltige Auswahl —
	-- beides zusammen oder gar nichts. Sonst muesste jede Regel unten einen
	-- dritten Fall behandeln.
	if (lockedProperty ~= nil) ~= (lockedFrom ~= nil) then
		lockedProperty = nil
		lockedFrom     = nil
	end

	local resultConfigId = pickResultConfigId(a, b)

	local resultDef = BaerchiConfig.getById(resultConfigId)
	if not resultDef then
		fail(player, Loc.msg("err.fuse_result_failed"))
		return
	end

	-- Regel C — Level.
	-- Standard ist jetzt das HOEHERE der beiden (frueher der Durchschnitt),
	-- damit die Fusion derselben Linie folgt wie die Basiswerte. Sperrt der
	-- Spieler "level", zaehlt ausschliesslich seine Wahl — auch wenn sie
	-- schlechter ist.
	local resultLevel: number
	if lockedProperty == "level" and lockedFrom then
		resultLevel = if lockedFrom == "A" then a.level else b.level
	else
		resultLevel = math.max(a.level, b.level)
	end
	resultLevel = math.clamp(resultLevel, 1, BaerchiConfig.MAX_LEVEL)

	-- Regel C — Ability.
	local skillId: string
	if lockedProperty == "ability" and lockedFrom then
		skillId = if lockedFrom == "A" then a.skillId else b.skillId
	else
		skillId = if a.level >= b.level then a.skillId else b.skillId
	end

	-- Die Rarity des Ergebnisses ist die der Inputs (beide gleich). Sie kann
	-- von der Config-Rarity abweichen, wenn das UFO einen Input schon
	-- aufgewertet hat — dann bleibt die hoehere erhalten.
	local newBaerchi = BaerchiFactory.create(resultConfigId, {
		level            = resultLevel,
		skillId          = skillId,
		isFusionResult   = true,
		fusionBonus      = EconomyConfig.getFusionStatBonus(),
		statLevels       = mergeStatLevels(a, b, a.rarity, lockedProperty, lockedFrom),
		baseStatOverride = mergeBaseStats(a, b, resultConfigId),

		-- Regel E: die hoehere Stufe gewinnt.
		mutation         = BaerchiConfig.pickHigherMutation(a.mutation, b.mutation),
	})

	-- Paket 9: das hoehere Endless-Level bleibt erhalten.
	if newBaerchi then
		local endless = math.max(a.endlessLevel or 0, b.endlessLevel or 0)
		newBaerchi.endlessLevel = if endless > 0 then endless else nil
	end

	if not newBaerchi then
		fail(player, Loc.msg("err.fuse_result_failed"))
		return
	end
	newBaerchi.rarity = a.rarity

	-- War einer der beiden Inputs der ausgeruestete Baerchi, uebernimmt das
	-- Ergebnis automatisch seinen Platz — sonst staende der Plot nach der
	-- Fusion ploetzlich leer da, obwohl gerade ein staerkerer Baerchi
	-- entstanden ist.
	local wasEquipped = data.island.equippedUid == uidA or data.island.equippedUid == uidB

	-- Erst jetzt die Inputs verbrauchen — vorher haette ein Fehler
	-- zwei Baerchis geloescht ohne Ergebnis.
	data.island.baerchis[uidA] = nil
	data.island.baerchis[uidB] = nil
	data.island.baerchis[newBaerchi.uid] = newBaerchi
	data.stats.totalFusions += 1

	if wasEquipped then
		data.island.equippedUid = newBaerchi.uid
	else
		-- Sicherheitsnetz: theoretisch kann equippedUid nach dem Entfernen
		-- ins Leere zeigen (sollte durch die Pruefung oben nicht vorkommen,
		-- schadet als Netz aber nicht).
		IslandService.autoEquipIfNone(data)
	end

	local result: Types.FusionResult = {
		resultBaerchi = newBaerchi,
		consumedUids  = { uidA, uidB },
	}

	Remotes.FusionResultReceived:FireClient(player, result)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	print(
		"[FusionService]", player.Name,
		"|", a.configId, "+", b.configId,
		"→", newBaerchi.configId, "(", newBaerchi.rarity, ") Lv.", newBaerchi.level,
		"| Bonus:", newBaerchi.fusionBonus,
		"| gesperrt:", lockedProperty or "nichts", lockedFrom or ""
	)
end

function FusionService.init()
	RateLimiter.connect(Remotes.RequestFuseBaerchis, "RequestFuseBaerchis", function(
		player, uidA: any, uidB: any, lockedProperty: any, lockedFrom: any
	)
		if typeof(uidA) ~= "string" or typeof(uidB) ~= "string" then return end

		-- Client-Eingaben streng pruefen: alles, was nicht genau einer der
		-- erlaubten Werte ist, wird zu nil (= alles automatisch). Ein
		-- erfundener Wert darf hoechstens die Sperre verlieren, nie eine
		-- unbekannte Eigenschaft setzen.
		local property: LockedProperty? = nil
		if lockedProperty == "ability" or lockedProperty == "level" or lockedProperty == "eggs" then
			property = lockedProperty
		end

		local from: LockedFrom? = nil
		if lockedFrom == "A" or lockedFrom == "B" then
			from = lockedFrom
		end

		FusionService.fuse(player, uidA, uidB, property, from)
	end)

	print("[FusionService] Initialisiert")
end

return FusionService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX52"><Properties>
<string name="Name">HoneyService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- HoneyService.luau
-- ServerScriptService/Services/HoneyService.luau
--
-- Einzige Zustaendigkeit:
--   - Honig-Produktion der Gebaeude nachrechnen
--   - Honig an einen Baerchi verfuettern: heilt ihn und gibt XP
--
-- ============================================================
-- DER KERN-LOOP DES SPIELS
-- ============================================================
--   PIT-Lauf → Baerchi kommt erschoepft zurueck (currentHp niedrig oder 0)
--   → auf dem Plot mit Honig hochfuettern → dabei steigt er im Level
--   → naechster Lauf geht tiefer.
--
-- Das ist die EINZIGE XP-Quelle im Spiel: Kaempfe geben seit v4 keine XP
-- mehr. Wer schneller leveln will, baut die Honig-Presse aus — deshalb haengt
-- die gesamte Progression an diesem Service.
--
-- ZWEI HONIG-SORTEN (seit v15, vorher drei):
-- Jedes Gebaeude hat eine eigene Rolle (siehe Config/BuildingBehavior). Fuer
-- diesen Service heisst das: WIE VIEL ein Honig heilt, haengt am Gebaeude, aus
-- dem er kommt; WIE VIEL XP er gibt, haengt am Level des Honig-Veredlers und
-- ist fuer jeden Honig gleich. Welches Gebaeude was kann, weiss dieser Service
-- nicht — er fragt BuildingBehavior und verzweigt nirgends nach einer id.
--
-- v15: AUTO-ABNAHME (Bienenstock-Faehigkeit ab Level 10): ist das Lager des
-- Bienenstocks voll, verfuettert der Takt unten einen Honig daraus an den
-- ausgeruesteten Baerchi (ohne Laufweg, ohne Meldung) — die Produktion steht
-- dann nie still.
--
-- PRODUKTION OHNE TIMER:
-- Jedes Gebaeude merkt sich in `lastProducedAt`, bis wann sein Honig schon
-- angerechnet ist. Wie viel dazugekommen ist, wird daraus jedes Mal neu
-- ausgerechnet statt in einem Timer mitgezaehlt. Dadurch produzieren die
-- Gebaeude auch waehrend der Spieler offline ist, und ein verpasster Tick
-- kann keinen Honig verschlucken. Der Loop unten stoesst das nur regelmaessig
-- an, damit die Anzeige mitlaeuft — er ist nicht die Quelle der Wahrheit.
--
-- Das Lager pro Gebaeude ist gedeckelt (BuildingBehavior.getCapacity — der
-- Bienenstock lagert mit steigendem Level mehr als die anderen beiden). Wer
-- lange weg war, findet volle Lager vor, aber nicht mehr — genau das macht
-- das regelmaessige Zurueckkommen noetig.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local DebugConfig      = require(ReplicatedStorage.Config.DebugConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)  -- Paket 9: Endless offen?

local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService     = require(ServerScriptService.Services.MapService)
-- v12: nur fuer die Frage "kaempft der gerade?" (siehe feed)
local PitArenaService = require(ServerScriptService.Services.PitArenaService)
local RateLimiter   = require(ServerScriptService.Util.RateLimiter)
local FunnelService = require(ServerScriptService.Services.FunnelService)  -- HBB: Messpunkte

-- Feier-Farbe fuer einen Level-Up (siehe MapService.celebrateBaerchi) — Gold,
-- derselbe Ton wie Theme.COLORS.goldGummy auf dem Client. Server und Client
-- duplizieren hier bewusst eine Zahl statt sich ein gemeinsames Modul zu
-- teilen: Theme ist UI-only (StarterPlayerScripts), MapService/HoneyService
-- laufen auf dem Server, ein Client→Server-Require ist in Rojo nicht moeglich.
local LEVEL_UP_CELEBRATE_COLOR = Color3.fromRGB(255, 196, 60)

local HoneyService = {}

local function fail(player: Player, reason: Types.LocMsg?)
	Remotes.ActionFailed:FireClient(player, "RequestFeedHoney", reason or Loc.msg("err.unknown"))
end

--------------------------------------------------------------------------------
-- Produktion
--------------------------------------------------------------------------------

-- Rechnet fuer alle Gebaeude eines Spielers nach, wie viel Honig seit
-- `lastProducedAt` dazugekommen ist. Gibt die Gesamtmenge zurueck, damit der
-- Aufrufer entscheiden kann ob sich ein Client-Sync ueberhaupt lohnt.
function HoneyService.accrue(data: Types.PlayerData, now: number): number
	local gained = 0

	for _, building in data.island.buildings do
		-- Pro Gebaeude eigenes Tempo UND eigenes Lager. WELCHES Gebaeude wovon
		-- abweicht, entscheidet BuildingBehavior — dieser Service verzweigt
		-- bewusst nirgends selbst nach einer BuildingId.
		local interval = BuildingBehavior.getIntervalSeconds(building.id, building.level)
		local capacity = BuildingBehavior.getCapacity(building.id, building.level)

		local honey = math.clamp(building.honey or 0, 0, capacity)
		building.honey = honey

		-- Volles Lager: die Uhr laeuft nicht weiter. Sonst haette ein Spieler
		-- nach langer Abwesenheit ein volles Lager UND zusaetzlich noch
		-- angesammelte Zeit gut, und die naechsten Honige kaemen sofort.
		if honey >= capacity then
			building.lastProducedAt = now
			continue
		end

		local last    = building.lastProducedAt or now
		local elapsed = now - last

		-- Uhr-Sprung oder frisch angelegtes Gebaeude: nicht rueckwaerts produzieren
		if elapsed < 0 then
			building.lastProducedAt = now
			continue
		end

		local produced = math.floor(elapsed / interval)
		if produced <= 0 then
			continue
		end

		local added = math.min(produced, capacity - honey)
		building.honey = honey + added

		-- Nur die verbrauchten Intervalle abziehen — der angefangene Rest
		-- bleibt stehen und geht nicht verloren.
		building.lastProducedAt = last + produced * interval
		gained += added
	end

	return gained
end

-- Gesamter Honig ueber alle Gebaeude (fuer Anzeige und Meldungen)
function HoneyService.getTotalHoney(data: Types.PlayerData): number
	local total = 0
	for _, building in data.island.buildings do
		total += building.honey or 0
	end
	return total
end

--------------------------------------------------------------------------------
-- Fuettern
--------------------------------------------------------------------------------

-- Das vom Spieler AUSGEWAEHLTE Gebaeude — nil, wenn es dort gerade keinen
-- Honig gibt.
local function pickRequestedBuilding(data: Types.PlayerData, buildingId: Types.BuildingId): Types.Building?
	-- Zwei getrennte Pruefungen statt einer verodeten: die zweite liest ein
	-- Feld des ersten, und so steht ohne Nachdenken da, dass sie nur laeuft
	-- wenn es das Gebaeude ueberhaupt gibt.
	local building = data.island.buildings[buildingId]
	if not building then
		return nil
	end
	if (building.honey or 0) <= 0 then
		return nil
	end

	return building
end

-- Die AUTOMATISCHE Wahl — nur fuer Aufrufer, die nicht fragen koennen.
--
-- Seit v7 gibt es drei unterschiedliche Honig-Sorten, und damit gibt es keine
-- immer richtige Antwort mehr: der Honigtopf heilt am meisten, die XP sind
-- ueberall gleich. Der Spieler waehlt deshalb im UI selbst (BaerchiPanel) —
-- diese Funktion ist fuer den Autopiloten, der von alleine essen geht, und fuer
-- den Studio-Debug-Befehl.
--
-- Die Regel in zwei Saetzen:
--   * Erschoepft (unter EconomyConfig.HONEY_AUTO_HEAL_HP_RATIO): der Honig, der
--     am meisten heilt. Genau dafuer hebt man den Honigtopf auf.
--   * Sonst: das VOLLSTE Lager zuerst — dort steht die Produktion still, und
--     jeder verfuetterte Honig startet sie wieder. Bei Gleichstand faellt die
--     Wahl bewusst auf den Honig, der am WENIGSTEN heilt: der Heil-Honig soll
--     fuer nach dem naechsten Kampf liegen bleiben.
local function pickAutoBuilding(data: Types.PlayerData, hpRatio: number): Types.Building?
	local needsHeal = hpRatio < EconomyConfig.HONEY_AUTO_HEAL_HP_RATIO

	local best: Types.Building? = nil
	local bestPrimary   = -math.huge
	local bestSecondary = -math.huge

	for _, building in data.island.buildings do
		local honey = building.honey or 0

		if honey > 0 then
			local heal = BuildingBehavior.getHealPercent(building.id, building.level)
			local cap  = math.max(1, BuildingBehavior.getCapacity(building.id, building.level))
			local fill = honey / cap

			local primary   = if needsHeal then heal else fill
			local secondary = if needsHeal then fill else -heal

			local better: boolean
			if best == nil then
				better = true
			else
				-- Letzter Ausweg ist die id: die Iteration ueber eine
				-- Hash-Tabelle ist nicht stabil, ohne sie spraenge die Auswahl
				-- bei Gleichstand von Aufruf zu Aufruf.
				local currentId = best.id

				if primary > bestPrimary then
					better = true
				elseif primary < bestPrimary then
					better = false
				elseif secondary > bestSecondary then
					better = true
				elseif secondary < bestSecondary then
					better = false
				else
					better = building.id < currentId
				end
			end

			if better then
				best          = building
				bestPrimary   = primary
				bestSecondary = secondary
			end
		end
	end

	return best
end

-- Versucht den Baerchi zu leveln wenn genug XP vorhanden.
-- Liegt hier, weil Honig die einzige XP-Quelle im Spiel ist.
-- Paket 9: `endlessOpen` (Final 100 geschafft) — dann fliessen XP auf
-- MAX_LEVEL ins Endless-Level statt zu verfallen.
local function tryLevelUp(baerchi: Types.Baerchi, endlessOpen: boolean): boolean
	local leveled = false

	while baerchi.level < BaerchiConfig.MAX_LEVEL
		and baerchi.xp >= BaerchiConfig.xpForNextLevel(baerchi.level) do
		baerchi.xp    -= BaerchiConfig.xpForNextLevel(baerchi.level)
		baerchi.level += 1
		leveled        = true
	end

	if baerchi.level >= BaerchiConfig.MAX_LEVEL and endlessOpen then
		while baerchi.xp >= BaerchiConfig.xpForEndlessLevel(baerchi.endlessLevel or 0) do
			baerchi.xp          -= BaerchiConfig.xpForEndlessLevel(baerchi.endlessLevel or 0)
			baerchi.endlessLevel = (baerchi.endlessLevel or 0) + 1
			leveled              = true
		end
	elseif baerchi.level >= BaerchiConfig.MAX_LEVEL then
		-- Auf Max-Level sammelt sich sonst unendlich XP an
		baerchi.xp = 0
	end

	return leveled
end

-- `buildingId` ist optional: der Spieler waehlt im UI aus, welchen Honig er
-- verfuettert. Wer nicht fragen kann (BaerchiAutopilotService, DebugService),
-- laesst es weg und bekommt die automatische Wahl.
-- `quiet` (v15, Auto-Abnahme): keine Fehlermeldung und kein Ergebnis-Remote.
function HoneyService.feed(player: Player, baerchiUid: string, buildingId: Types.BuildingId?, quiet: boolean?)
	local data = PlayerService.getData(player)
	if not data then return end

	local function reject(reason: Types.LocMsg)
		if not quiet then fail(player, reason) end
	end

	local baerchi = data.island.baerchis[baerchiUid]
	if not baerchi then
		reject(Loc.msg("err.baerchi_not_found"))
		return
	end

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		warn("[HoneyService] Unbekannter configId:", baerchi.configId)
		reject(Loc.msg("err.baerchi_data_corrupt"))
		return
	end

	-- v12: ein PIT-Lauf wird erst am Ende abgerechnet und setzt die HP dann
	-- auf den Wert nach der letzten Stage. Eine Heilung mittendrin waere
	-- danach einfach weg — also lieber gleich ablehnen.
	if PitArenaService.isFighting(player, baerchiUid) then
		reject(Loc.msg("err.honey_in_pit"))
		return
	end

	-- Erst nachrechnen: sonst faellt eine Fuetterung durch, obwohl genau
	-- jetzt ein Honig fertig geworden waere.
	HoneyService.accrue(data, os.time())

	local statsBefore = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)
	local hpBefore    = math.clamp(baerchi.currentHp, 0, statsBefore.maxHp)
	local hpRatio     = if statsBefore.maxHp > 0 then hpBefore / statsBefore.maxHp else 1

	local chosen = if buildingId
		then pickRequestedBuilding(data, buildingId)
		else pickAutoBuilding(data, hpRatio)

	if not chosen then
		reject(Loc.msg(if buildingId then "err.feed_building_empty" else "err.feed_no_honey"))
		return
	end

	local building = chosen

	-- Geheilt wird nach dem Gebaeude, aus dem der Honig KOMMT (nur der
	-- Honigtopf steigert das). Die XP haengen dagegen nicht an der Herkunft,
	-- sondern am Level der Honig-Presse und gelten fuer jeden Honig gleich —
	-- deshalb bekommt getXpPerHoney alle Gebaeude und nicht nur dieses eine.
	local healPercent = BuildingBehavior.getHealPercent(building.id, building.level)

	local heal   = math.max(1, math.floor(statsBefore.maxHp * healPercent))
	local hpNow  = math.min(statsBefore.maxHp, hpBefore + heal)
	local xp     = BuildingBehavior.getXpPerHoney(data.island.buildings)

	building.honey    -= 1
	baerchi.currentHp  = hpNow
	baerchi.xp        += xp

	local leveled = tryLevelUp(baerchi, TowerConfig.isEndlessOpen(data.towers.records))

	-- Nach einem Level-Up ist maxHp groesser. Die aktuellen HP bleiben stehen
	-- (kein Gratis-Vollheilung), der Baerchi ist danach also relativ gesehen
	-- staerker verletzt — genau deshalb lohnt weiterfuettern.
	local statsAfter = if leveled
		then CombatCalculator.getEffectiveStats(baerchi, def.baseStats)
		else statsBefore

	local result: Types.FeedResult = {
		baerchiUid = baerchiUid,
		buildingId = building.id,
		hpGained   = hpNow - hpBefore,
		xpGained   = xp,
		leveledUp  = leveled,
		newLevel   = baerchi.level,
		hpAfter    = baerchi.currentHp,
		maxHp      = statsAfter.maxHp,
	}

	if not quiet or leveled then
		Remotes.FeedResultReceived:FireClient(player, result)
	end

	-- Sichtbar auf dem Plot feiern statt nur im Toast zu vermelden — alle
	-- Spieler auf dem Server sehen es mit, nicht nur der Besitzer (siehe
	-- DESIGN_VORSCHLAG_TRENDANALYSE_2026-09-11.md Abschnitt 4).
	if leveled then
		MapService.celebrateBaerchi(player, baerchiUid, LEVEL_UP_CELEBRATE_COLOR)
	end

	FunnelService.step(player, "F07_FirstHoneyEaten")
	PlayerService.markDirty(player)

	if DebugConfig.VERBOSE_LOG then
		print(
			"[HoneyService]", player.Name,
			"| fuettert:", baerchi.configId,
			"| aus:", building.id, "Lv.", building.level,
			"| +", result.hpGained, "HP, +", xp, "XP",
			leveled and ("| LEVEL UP → " .. baerchi.level) or ""
		)
	end
end

--------------------------------------------------------------------------------
-- Loop und Offline-Ertrag
--------------------------------------------------------------------------------

local function tick()
	local now = os.time()

	for _, player in Players:GetPlayers() do
		local data = PlayerService.getData(player)
		if data then
			-- Nur syncen wenn wirklich Honig dazugekommen ist: markDirty
			-- zieht einen Client-Sync und alle onDataChanged-Beobachter nach
			-- sich, das soll nicht jede Sekunde ins Leere laufen.
			if HoneyService.accrue(data, now) > 0 then
				PlayerService.markDirty(player)
			end

			-- v15: Auto-Abnahme (Faehigkeit ab Level 10): Bienenstock bzw. seit
			-- HONEY_POND_V2 der Honig-Teich. Jedes Gebaeude mit der Faehigkeit,
			-- dessen Lager voll ist, fuettert den ausgeruesteten Baerchi.
			local uid = data.island.equippedUid
			if uid then
				for id, building in data.island.buildings do
					if BuildingBehavior.hasAbility(id, building.level, "AutoHarvest")
						and (building.honey or 0) >= BuildingBehavior.getCapacity(id, building.level)
					then
						HoneyService.feed(player, uid, id, true)
					end
				end
			end
		end
	end
end

local function startLoop()
	task.spawn(function()
		while true do
			task.wait(EconomyConfig.HONEY_INTERVAL_SECONDS)

			local ok, err = pcall(tick)
			if not ok then
				warn("[HoneyService] Tick fehlgeschlagen:", err)
			end
		end
	end)
end

-- Wird von PlayerService aufgerufen sobald die Daten geladen sind.
-- WICHTIG: laeuft bevor irgendetwas lastSeenAt ueberschreibt.
local function grantOfflineHoney(player: Player, data: Types.PlayerData)
	local now      = os.time()
	local lastSeen = data.lastSeenAt or now
	local away     = math.max(0, now - lastSeen)

	local gained = HoneyService.accrue(data, now)
	data.lastSeenAt = now

	if gained <= 0 then
		return
	end

	local report: Types.OfflineReport = {
		secondsAway = away,
		honeyGained = gained,
	}

	-- Kurz verzoegert feuern: beim Join haengt der Client sein UI erst noch
	-- an die Remotes, ein sofortiges FireClient ginge ins Leere.
	task.delay(3, function()
		if player.Parent then
			Remotes.OfflineReportReceived:FireClient(player, report)
		end
	end)

	print(
		"[HoneyService] Offline-Honig fuer", player.Name,
		"|", math.floor(away / 60), "min weg",
		"| +", gained, "Honig"
	)
end

function HoneyService.init()
	PlayerService.onDataLoaded(grantOfflineHoney)

	RateLimiter.connect(Remotes.RequestFeedHoney, "RequestFeedHoney", function(player, baerchiUid: any, buildingId: any)
		if typeof(baerchiUid) ~= "string" then return end

		-- Ohne zweites Argument bleibt es bei der automatischen Wahl (aeltere
		-- Clients, und der Weg den der Autopilot ohnehin nimmt).
		if buildingId == nil then
			HoneyService.feed(player, baerchiUid)
			return
		end

		-- Ein Client-String wird nie ungeprueft als Types.BuildingId
		-- weitergereicht — dieselbe Konvention wie bei
		-- IslandService.upgradeBuilding. Ein unbekanntes Gebaeude wird
		-- abgelehnt statt stillschweigend zur Auto-Wahl zu werden: sonst
		-- verfuettert ein Tippfehler im Client den falschen Honig.
		if typeof(buildingId) ~= "string" then return end
		if not BuildingBehavior.isValidId(buildingId) then
			fail(player, Loc.msg("err.building_unknown"))
			return
		end

		HoneyService.feed(player, baerchiUid, buildingId :: Types.BuildingId)
	end)

	startLoop()

	print(
		"[HoneyService] Initialisiert",
		"| Basis: 1 Honig alle", EconomyConfig.HONEY_INTERVAL_SECONDS, "s,",
		"Lager", EconomyConfig.HONEY_CAPACITY,
		"| Abweichungen pro Gebaeude siehe BuildingBehavior"
	)
end

return HoneyService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX53"><Properties>
<string name="Name">IslandService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- IslandService.luau
-- ServerScriptService/Services/IslandService.luau
--
-- Einzige Zustaendigkeit:
--   - Insel-Struktur veraendern: Gebaeude-Level und welcher Baerchi
--     ausgeruestet ist (v15: das PIT-Level ist entfallen, siehe TowerService)
--   - Die zugehoerigen Client-Requests entgegennehmen und validieren
--   - Nach einer Aenderung die sichtbare Insel via MapService nachziehen
--
-- Die Waehrungs-Transaktion selbst liegt in EconomyService — dieser Service
-- entscheidet nur WAS gekauft wird und was danach in der Welt passieren muss.
--
-- Equip-Baerchi gehoert hier rein statt in einen eigenen Service: es ist
-- genau wie die Gebaeude-Upgrades eine Aenderung an der
-- Insel-STRUKTUR (welcher Baerchi ueberhaupt in der Welt steht), keine neue
-- Zustaendigkeit fuer sich.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types         = require(ReplicatedStorage.Network.Types)
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local MapService     = require(ServerScriptService.Services.MapService)
local ActivityLock   = require(ServerScriptService.Util.ActivityLock)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local IslandService = {}

-- Gueltige BuildingIds als Menge — Client-Strings duerfen nie ungeprueft
-- als Types.BuildingId weiterverwendet werden.
local VALID_BUILDINGS: { [string]: boolean } = {
	Beehive      = true,
	HoneyRefiner = true,
	HoneyPond    = true,
}

local function fail(player: Player, action: string, reason: Types.LocMsg?)
	Remotes.ActionFailed:FireClient(player, action, reason or Loc.msg("err.unknown"))
end

--------------------------------------------------------------------------------
-- Gebaeude-Upgrade
--------------------------------------------------------------------------------

function IslandService.upgradeBuilding(player: Player, buildingId: Types.BuildingId)
	local data = PlayerService.getData(player)
	if not data then return end

	local ok, reason = EconomyService.upgradeBuilding(player, buildingId)
	if not ok then
		fail(player, "RequestUpgradeBuilding", reason)
		return
	end

	local newLevel = data.island.buildings[buildingId].level

	-- Level-Attribut an der Gebaeude-Part nachziehen (Client liest es direkt)
	MapService.updateBuildingLevel(player, buildingId, newLevel)
	PlayerService.saveNow(player)

	print("[IslandService]", player.Name, "| Gebaeude:", buildingId, "→ Level", newLevel)
end

--------------------------------------------------------------------------------
-- Baerchi ausruesten
--------------------------------------------------------------------------------

-- Setzt automatisch einen ausgeruesteten Baerchi, falls gerade keiner steht
-- aber welche im Inventar sind. Oeffentlich, weil EggService (erster Hatch,
-- damit der Plot nicht leer bleibt) und FusionService das brauchen (seit v12
-- kann der ausgeruestete nicht mehr verwertet werden) — und weil es hier beim Laden jedes
-- Spielstands als Sicherheitsnetz laeuft (siehe init unten).
--
-- Reine Datenfunktion ohne Remote-Antwort: der Aufrufer entscheidet selbst,
-- ob danach ein MapService.updateBaerchis noetig ist.
function IslandService.autoEquipIfNone(data: Types.PlayerData)
	local island = data.island

	if island.equippedUid and island.baerchis[island.equippedUid] then
		return   -- schon einer da, und der existiert auch wirklich
	end

	-- Deterministisch nach uid statt "irgendeiner": sonst wuerde bei jedem
	-- Aufruf ein anderer Baerchi gewinnen, weil die Iteration ueber eine
	-- Hash-Tabelle nicht stabil ist.
	local bestUid: string? = nil
	for uid in island.baerchis do
		if not bestUid or uid < bestUid then
			bestUid = uid
		end
	end

	island.equippedUid = bestUid
end

function IslandService.equipBaerchi(player: Player, baerchiUid: string)
	local data = PlayerService.getData(player)
	if not data then return end

	if not data.island.baerchis[baerchiUid] then
		fail(player, "RequestEquipBaerchi", Loc.msg("err.baerchi_not_found"))
		return
	end

	if data.island.equippedUid == baerchiUid then
		return   -- schon ausgeruestet, nichts zu tun
	end

	-- Ein Equip-Wechsel ersetzt die Figur, die JETZT auf dem Plot steht. Steckt
	-- genau die gerade in einer Bewegung (Kampf-Lauf oder Weg zum Honig-Teich,
	-- beides haelt ActivityLock), wuerde sie mitten im Schritt verschwinden.
	--
	-- Anders als beim Verwerten haengt das nicht an der uebergebenen uid: der
	-- neue Baerchi ist nie der beschaeftigte — der ALTE ist es. Deshalb hier
	-- kein uid-Vergleich, sondern nur die Frage, ob ueberhaupt gerade eine
	-- Bewegung laeuft. Ohne ausgeruesteten Baerchi laeuft auch keine, das
	-- Schloss ist dann frei und der erste Equip geht wie bisher sofort durch.
	if not ActivityLock.isFree(player) then
		fail(player, "RequestEquipBaerchi", Loc.msg("err.baerchi_busy"))
		return
	end

	data.island.equippedUid = baerchiUid

	-- Struktur-Aenderung (es steht jetzt eine ANDERE Figur auf dem Plot),
	-- kein reiner Zustandswert — deshalb der teurere Neuaufbau.
	MapService.updateBaerchis(player, data.island)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	print("[IslandService]", player.Name, "| ausgeruestet:", baerchiUid)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function IslandService.init()
	RateLimiter.connect(Remotes.RequestUpgradeBuilding, "RequestUpgradeBuilding", function(player, buildingId: any)
		if typeof(buildingId) ~= "string" then return end
		if not VALID_BUILDINGS[buildingId] then
			fail(player, "RequestUpgradeBuilding", Loc.msg("err.building_unknown"))
			return
		end
		IslandService.upgradeBuilding(player, buildingId :: Types.BuildingId)
	end)

	RateLimiter.connect(Remotes.RequestEquipBaerchi, "RequestEquipBaerchi", function(player, baerchiUid: any)
		if typeof(baerchiUid) ~= "string" then return end
		IslandService.equipBaerchi(player, baerchiUid)
	end)

	-- Sicherheitsnetz: ein alter Spielstand ohne equippedUid (oder einer
	-- dessen ausgeruesteter Baerchi inzwischen weg ist) bekommt beim Laden
	-- automatisch den naechstbesten.
	PlayerService.onDataLoaded(function(_player, data)
		IslandService.autoEquipIfNone(data)
	end)

	print("[IslandService] Initialisiert")
end

return IslandService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX54"><Properties>
<string name="Name">LeaderboardService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- LeaderboardService.luau
-- ServerScriptService/Services/LeaderboardService.luau
--
-- Einzige Zustaendigkeit:
--   - Die Bestenlisten (v15): Tower, Rebirths, Sammlung; mit Paket 9 auch
--     Endless und Endless-Woche. Werte schreiben (gedrosselt), Top-Listen
--     lesen (gecacht), dem Client auf Anfrage geben, die Tafeln beschriften
--     und die Top 10 der Vorwoche kroenen (Plot-Schild, MapService).
--
-- REGEL (seit v15, steht auch im Briefing): dieser Service ist der EINZIGE, der
-- OrderedDataStores benutzt — so wie PlayerService der einzige mit dem
-- Spieler-DataStore ist. Kein anderer Service fasst DataStoreService an.
--
-- Budget: Schreiben nur bei Aenderung und hoechstens alle WRITE_MIN_SECONDS pro
-- Spieler, Lesen serverweit alle READ_INTERVAL_SECONDS. Jeder Zugriff laeuft in
-- pcall und erst nach einer Budget-Pruefung (GetRequestBudgetForRequestType);
-- ist das Budget knapp, wird verschoben statt riskiert.
--
-- Ohne DataStore (Studio ohne API-Zugriff, unveroeffentlichter Place) gibt es
-- eine Sitzungsliste: die Werte aller Spieler, die in dieser Sitzung auf dem
-- Server waren. Das Spiel bleibt so vollstaendig testbar.

local Players             = game:GetService("Players")
local DataStoreService    = game:GetService("DataStoreService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types             = require(ReplicatedStorage.Network.Types)
local Remotes           = require(ReplicatedStorage.Network.Remotes)
local LeaderboardConfig = require(ReplicatedStorage.Config.LeaderboardConfig)
local TowerConfig       = require(ReplicatedStorage.Config.TowerConfig)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)
local RateLimiter   = require(ServerScriptService.Util.RateLimiter)

local LeaderboardService = {}

type Entry = Types.LeaderboardEntry

-- Gelesener Stand je Liste (Top N) und Zeitpunkt.
local _cache: { [string]: { entries: { Entry }, updatedAt: number } } = {}

-- Pro Spieler: zuletzt geschriebene Werte und Zeitpunkt.
local _written: { [number]: { [string]: number } } = {}
local _lastWriteAt: { [number]: number } = {}

-- Sitzungsliste (ohne DataStore) und Namens-Cache.
local _session: { [string]: { [number]: number } } = {}
local _names: { [number]: string } = {}

-- Nach Store-NAME (EndlessWeek hat jede Woche einen neuen).
local _stores: { [string]: OrderedDataStore } = {}
local _storesChecked = false
local _storesOk = false

local _lastRead = 0
local _boardIndex = 0

-- Paket 9: Krone = Top CROWN_TOP_N der Vorwoche. `_crownWeek` = fuer welche
-- (laufende) Woche `_crowned` gilt; nil = noch nicht gelesen.
local _crowned: { [number]: boolean } = {}
local _crownWeek: number? = nil

--------------------------------------------------------------------------------
-- Werte
--------------------------------------------------------------------------------

local function countKeys(t: { [string]: any }?): number
	local n = 0
	for _ in t or {} do n += 1 end
	return n
end

-- Wert eines Spielers in einer Liste (ganze Zahl, OrderedDataStore-tauglich).
function LeaderboardService.valueOf(data: Types.PlayerData, listId: string): number
	if listId == "Tower" then
		local towerId, record = TowerConfig.bestRecord(data.towers)
		if record <= 0 then return 0 end
		return TowerConfig.leaderboardValue(towerId, record)
	elseif listId == "Rebirths" then
		return math.max(0, math.floor(data.rebirthCount))
	elseif listId == "Collection" then
		return countKeys(data.discovered)
	elseif listId == "Endless" then
		return math.max(0, math.floor(data.towers.records.Endless or 0))
	elseif listId == "EndlessWeek" then
		local entry = data.towers.endlessWeek
		if entry and entry.week == LeaderboardConfig.weekOf(os.time()) then
			return math.max(0, math.floor(entry.best))
		end
		return 0
	end
	return 0
end

--------------------------------------------------------------------------------
-- DataStore (nur hier!)
--------------------------------------------------------------------------------

local function currentStoreName(listId: string): string
	return LeaderboardConfig.storeName(listId, LeaderboardConfig.weekOf(os.time()))
end

-- Store nach Namen (einmal geholt, dann gecacht). nil = nicht verfuegbar.
local function storeByName(name: string): OrderedDataStore?
	local store = _stores[name]
	if store then return store end
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(name)
	end)
	if not ok then return nil end
	_stores[name] = result
	return result
end

local function getStores(): boolean
	if _storesChecked then return _storesOk end
	_storesChecked = true
	local ok, err = pcall(function()
		for _, listId in LeaderboardConfig.LISTS do
			local name = currentStoreName(listId)
			_stores[name] = DataStoreService:GetOrderedDataStore(name)
		end
	end)
	_storesOk = ok
	if not ok then
		warn("[LeaderboardService] Keine OrderedDataStores — Sitzungsliste. Grund:", err)
	end
	return ok
end

local function hasBudget(requestType: Enum.DataStoreRequestType): boolean
	local ok, budget = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(requestType)
	end)
	return ok and (budget :: number) >= LeaderboardConfig.MIN_REQUEST_BUDGET
end

local function nameOf(userId: number): string
	local cached = _names[userId]
	if cached then return cached end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		_names[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and typeof(name) == "string" then name else ("#" .. userId)
	_names[userId] = result
	return result
end

--------------------------------------------------------------------------------
-- Schreiben
--------------------------------------------------------------------------------

-- Schreibt die geaenderten Werte eines Spielers (gedrosselt, ausser `force`).
local function writePlayer(player: Player, force: boolean)
	local data = PlayerService.getData(player)
	if not data then return end
	local userId = player.UserId
	_names[userId] = player.DisplayName

	local now = os.clock()
	if not force and now - (_lastWriteAt[userId] or -math.huge) < LeaderboardConfig.WRITE_MIN_SECONDS then
		return
	end

	local written = _written[userId] or {}
	_written[userId] = written
	local changed = false

	for _, listId in LeaderboardConfig.LISTS do
		local value = LeaderboardService.valueOf(data, listId)
		-- Nach Store-Namen gemerkt: in einer neuen Woche wird neu geschrieben.
		local name = currentStoreName(listId)

		-- Sitzungsliste immer pflegen (Studio-Ersatz und Fallback). Die
		-- Wochenliste beginnt zum Wochenwechsel leer.
		local session = _session[name] or {}
		_session[name] = session
		session[userId] = value

		if written[name] ~= value then
			if getStores() then
				local store = storeByName(name)
				if store and hasBudget(Enum.DataStoreRequestType.SetIncrementSortedAsync) then
					local ok, err = pcall(function()
						store:SetAsync(tostring(userId), value)
					end)
					if ok then
						written[name] = value
						changed = true
					else
						-- Studio ohne API-Zugriff: GetOrderedDataStore klappt, jeder
						-- Zugriff scheitert. Einmal melden, dann Sitzungsliste.
						warn("[LeaderboardService] Schreiben fehlgeschlagen — ab jetzt Sitzungsliste:", listId, err)
						_storesOk = false
					end
				end
			else
				written[name] = value
				changed = true
			end
		end
	end

	if changed then
		_lastWriteAt[userId] = now
	end
end

--------------------------------------------------------------------------------
-- Lesen
--------------------------------------------------------------------------------

local function sessionTop(listId: string): { Entry }
	local rows: { { userId: number, value: number } } = {}
	for userId, value in _session[currentStoreName(listId)] or {} do
		if value > 0 then
			table.insert(rows, { userId = userId, value = value })
		end
	end
	table.sort(rows, function(a, b)
		if a.value ~= b.value then return a.value > b.value end
		return a.userId < b.userId
	end)
	local entries: { Entry } = {}
	for rank, row in rows do
		if rank > LeaderboardConfig.TOP_N then break end
		table.insert(entries, { rank = rank, userId = row.userId, name = nameOf(row.userId), value = row.value })
	end
	return entries
end

-- Liest die Top `count` eines Stores. nil = gerade nicht moeglich.
local function readStore(name: string, count: number): { Entry }?
	if not hasBudget(Enum.DataStoreRequestType.GetSortedAsync) then
		return nil
	end
	local store = storeByName(name)
	if not store then return nil end
	local ok, result = pcall(function()
		local pages = store:GetSortedAsync(false, count)
		return pages:GetCurrentPage()
	end)
	if not ok then
		warn("[LeaderboardService] Lesen fehlgeschlagen — ab jetzt Sitzungsliste:", name, result)
		_storesOk = false
		return nil
	end
	local entries: { Entry } = {}
	for _, item in result :: { any } do
		local userId = tonumber(item.key)
		local value = tonumber(item.value) or 0
		-- Paket 9: Nullen (z. B. Endless noch nicht offen) stehen nicht in der Liste.
		if userId and value > 0 then
			table.insert(entries, { rank = #entries + 1, userId = userId, name = nameOf(userId), value = value })
		end
	end
	return entries
end

local function readList(listId: string): { Entry }?
	if not getStores() then
		return sessionTop(listId)
	end
	local entries = readStore(currentStoreName(listId), LeaderboardConfig.TOP_N)
	if entries == nil and not _storesOk then
		return sessionTop(listId)
	end
	return entries
end

-- Paket 9: Krone fuer die Top 10 der VORWOCHE (eine Woche lang). Ohne
-- DataStore (Studio) gibt es keine Vorwoche — dann kroenen die Top 10 der
-- laufenden Sitzungsliste, damit sich das testen laesst.
local function applyCrowns()
	for _, player in Players:GetPlayers() do
		MapService.setOwnerCrown(player, _crowned[player.UserId] == true)
	end
end

local function refreshCrowns()
	if not table.find(LeaderboardConfig.LISTS, "EndlessWeek") then return end
	local week = LeaderboardConfig.weekOf(os.time())
	local entries: { Entry }?
	if getStores() then
		if _crownWeek == week then return end
		entries = readStore(LeaderboardConfig.storeName("EndlessWeek", week - 1), LeaderboardConfig.CROWN_TOP_N)
	end
	if entries == nil and not (getStores() and _storesOk) then
		entries = sessionTop("EndlessWeek")
	end
	if entries == nil then return end   -- spaeter nochmal versuchen

	_crowned = {}
	for _, entry in entries do
		if entry.rank <= LeaderboardConfig.CROWN_TOP_N then
			_crowned[entry.userId] = true
		end
	end
	_crownWeek = week
	applyCrowns()
end

local function refreshAll()
	_lastRead = os.clock()
	for _, listId in LeaderboardConfig.LISTS do
		local entries = readList(listId)
		if entries then
			_cache[listId] = { entries = entries, updatedAt = os.time() }
		end
	end
	refreshCrowns()
end

function LeaderboardService.isCrowned(userId: number): boolean
	return _crowned[userId] == true
end

--------------------------------------------------------------------------------
-- Anzeige
--------------------------------------------------------------------------------

-- Wert fuer die Anzeige ("Tower III · 42", "17", "23/28").
function LeaderboardService.formatValue(listId: string, value: number): string
	if listId == "Tower" then
		local towerId, stage = TowerConfig.fromLeaderboardValue(value)
		local def = TowerConfig.get(towerId) or TowerConfig.TOWERS[1]
		return string.format("Tower %s · %d", def.numeral, stage)
	elseif listId == "Endless" or listId == "EndlessWeek" then
		return string.format("∞ · %d", value)
	end
	return tostring(value)
end

local BOARD_TITLES: { [string]: string } = {
	Tower      = "TOP 10  ·  TOWER",
	Rebirths   = "TOP 10  ·  REBIRTHS",
	Collection = "TOP 10  ·  INDEX",
	Endless    = "TOP 10  ·  ENDLESS ∞",
	EndlessWeek = "TOP 10  ·  ∞ WEEK  ·  ♛",
}

local function paintList(listId: string)
	local cached = _cache[listId]
	local lines: { string } = {}
	for _, entry in (if cached then cached.entries else {}) do
		if entry.rank > LeaderboardConfig.BOARD_TOP_N then break end
		table.insert(lines, string.format("%2d.  %s   —   %s", entry.rank, entry.name, LeaderboardService.formatValue(listId, entry.value)))
	end
	MapService.writeLeaderboardBoard(BOARD_TITLES[listId] or listId, lines, listId)
end

-- HBB Paket 5: Hat jede Liste ihre feste Tafel, werden alle beschrieben;
-- sonst wechselt die eine Tafel reihum (v15).
local function paintBoard()
	if MapService.hasLeaderboardBoard(LeaderboardConfig.LISTS[1]) then
		for _, listId in LeaderboardConfig.LISTS do
			-- Paket 9: eine Liste ohne eigene Tafel landete sonst auf der
			-- wechselnden (die es dann nicht gibt) — einfach auslassen.
			if MapService.hasLeaderboardBoard(listId) then
				paintList(listId)
			end
		end
		return
	end
	_boardIndex = (_boardIndex % #LeaderboardConfig.LISTS) + 1
	paintList(LeaderboardConfig.LISTS[_boardIndex])
end

-- Die Sicht eines Spielers auf eine Liste (Top N + eigener Rang).
function LeaderboardService.getView(player: Player, listId: string): Types.LeaderboardView?
	if not table.find(LeaderboardConfig.LISTS, listId :: any) then return nil end
	local cached = _cache[listId]
	local entries = if cached then cached.entries else {}
	local data = PlayerService.getData(player)
	local ownValue = if data then LeaderboardService.valueOf(data, listId) else 0
	local ownRank: number? = nil
	for _, entry in entries do
		if entry.userId == player.UserId then
			ownRank = entry.rank
			break
		end
	end
	return {
		listId    = listId,
		entries   = entries,
		ownRank   = ownRank,
		ownValue  = ownValue,
		updatedAt = if cached then cached.updatedAt else 0,
	}
end

-- Debug ("lbflush"): alle sofort schreiben und neu lesen.
function LeaderboardService.flush(): { [string]: number }
	for _, player in Players:GetPlayers() do
		writePlayer(player, true)
	end
	refreshAll()
	paintBoard()
	local counts: { [string]: number } = {}
	for listId, cached in _cache do
		counts[listId] = #cached.entries
	end
	return counts
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function LeaderboardService.init()
	RateLimiter.connectFunction(Remotes.GetLeaderboard, "GetLeaderboard", function(player, listId: any)
		if typeof(listId) ~= "string" then return nil end
		return LeaderboardService.getView(player, listId)
	end)

	-- Beim Verlassen zuletzt noch schreiben (ungedrosselt, wenn sich etwas
	-- geaendert hat). Laeuft vor dem Speichern, darf aber nicht yielden — daher
	-- abgekoppelt.
	PlayerService.onPlayerLeaving(function(player, _data)
		task.spawn(writePlayer, player, true)
	end)

	-- Paket 9: Krone gleich beim Betreten, nicht erst beim naechsten Lesen.
	PlayerService.onPlayerReady(function(player, _data)
		MapService.setOwnerCrown(player, _crowned[player.UserId] == true)
	end)

	Players.PlayerRemoving:Connect(function(player)
		_lastWriteAt[player.UserId] = nil
		_written[player.UserId] = nil
	end)

	print("[LeaderboardService] Initialisiert |", #LeaderboardConfig.LISTS, "Listen")
end

function LeaderboardService.start()
	task.spawn(function()
		while true do
			task.wait(LeaderboardConfig.BOARD_CYCLE_SECONDS)
			local ok, err = pcall(paintBoard)
			if not ok then
				warn("[LeaderboardService] Tafel fehlgeschlagen:", err)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(LeaderboardConfig.TICK_SECONDS)
			local ok, err = pcall(function()
				for _, player in Players:GetPlayers() do
					writePlayer(player, false)
				end
				if os.clock() - _lastRead >= LeaderboardConfig.READ_INTERVAL_SECONDS or next(_cache) == nil then
					refreshAll()
				end
			end)
			if not ok then
				warn("[LeaderboardService] Takt fehlgeschlagen:", err)
			end
		end
	end)
end

return LeaderboardService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX55"><Properties>
<string name="Name">LiveBoardService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- LiveBoardService.luau
-- ServerScriptService/Services/LiveBoardService.luau
--
-- Einzige Zustaendigkeit:
--   - Das Live-Kampf-Board auf der Hauptinsel aktuell halten (HBB Paket 6,
--     FeatureFlags.MAP_V2_LIVE_BOARD): wer kaempft gerade wo?
--
-- Liest nur: PitArenaService.liveRuns() (laufende Laeufe), schreibt nur ueber
-- MapService.writeLiveBoard. Den Text baut Modules/LiveBoardText (getestet).
-- Geschrieben wird nur bei Aenderung — sonst jede Sekunde dieselben Texte
-- an alle Clients replizieren.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local LiveBoardText = require(ReplicatedStorage.Modules.LiveBoardText)

local MapService      = require(ServerScriptService.Services.MapService)
local PitArenaService = require(ServerScriptService.Services.PitArenaService)

local LiveBoardService = {}

local _lastSignature = ""

local function refresh()
	local cfg = MapConfig.LIVE_BOARD
	local title, lines, live = LiveBoardText.build(PitArenaService.liveRuns(), cfg.lines)
	local signature = title .. "\n" .. table.concat(lines, "\n")
	if signature == _lastSignature then return end
	_lastSignature = signature
	MapService.writeLiveBoard(title, lines, live)
end

function LiveBoardService.init()
	print("[LiveBoardService] Initialisiert | aktiv:", FeatureFlags.isOn("MAP_V2_LIVE_BOARD"))
end

function LiveBoardService.start()
	if not FeatureFlags.isOn("MAP_V2_LIVE_BOARD") then return end
	task.spawn(function()
		while true do
			local ok, err = pcall(refresh)
			if not ok then
				warn("[LiveBoardService] Aktualisierung fehlgeschlagen:", err)
			end
			task.wait(MapConfig.LIVE_BOARD.refreshSeconds)
		end
	end)
end

return LiveBoardService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX56"><Properties>
<string name="Name">MapService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- MapService.luau
-- ServerScriptService/Services/MapService.luau
--
-- Einzige Zustaendigkeit:
--   - Die einzige Schnittstelle zur gebauten Welt: Welt beim Start bauen
--     lassen, Spieler-Plots vergeben, spawnen, neu aufbauen und despawnen,
--     und die sichtbaren Teile aktuell halten (Schilder, Figur, Teich, Eier,
--     Lauf-Turm, Tower-Turm, Event-Pit)
--
-- Das eigentliche BAUEN steht in den Modulen unter Util/MapBuild (MapParts,
-- WorldBuilder, PlotBuilder, PondBuilder, ArenaBuilder, FigureBuilder,
-- LaidEggBuilder). Dieser Service haelt den Zustand (welcher Spieler welchen
-- Slot und welches Plot-Model hat) und entscheidet, WANN gebaut wird. Andere
-- Services sprechen nur mit MapService, nie mit den Buildern.
--
-- Baut physische Roblox-Parts aus IslandData.
-- Kennt keine Spielerdaten ausser IslandData (und den Namen fuer das Schild).
--
-- Alle Masse, Farben und Offsets kommen aus MapConfig. Wie das plot-lokale
-- Koordinatensystem funktioniert (lokales -Z = Richtung Mitte, +Z = nach
-- aussen), steht im Kopf von MapConfig.
--
-- ZWEI ARTEN VON AKTUALISIERUNG — bewusst getrennt:
--   * NEU BAUEN (updateBaerchis, updateBuildingLooks, updateTowerShowcase):
--     teuer, nur wenn sich die Struktur aendert (ein Baerchi kommt dazu, faellt
--     weg oder steigt im Level; ein Gebaeude wechselt den Look; der Tower-Turm
--     bekommt einen neuen Look oder Rekord).
--   * IN-PLACE (updateBaerchiStates, updateBuildingSigns): billig, aendert nur
--     Beschriftung und Transparenz an bereits stehenden Teilen. Dafuer gibt es
--     die Trennung: HP und Honig aendern sich staendig, und dafuer jedes Mal
--     25 Mesh-Figuren neu zu bauen waere Verschwendung.
--   PlotDisplayService entscheidet welche der beiden noetig ist.
--
-- NEUAUFBAU WAEHREND EINER BEWEGUNG — die eine Sperre in dieser Datei:
-- updateBaerchis zerstoert die Figur und baut sie neu. Laeuft sie in dem
-- Moment gerade (Kampf-Lauf oder Weg zum Honig-Teich), verschwaende sie mitten
-- im Schritt. Die Pruefung dagegen steht EINMAL hier drin statt an jeder
-- Aufrufstelle — und der uebersprungene Neuaufbau wird nachgeholt, sobald das
-- Schloss frei ist (siehe scheduleRebuildWhenFree weiter unten). Ohne das
-- Nachholen bliebe die Beschriftung dauerhaft veraltet, weil der Aufrufer
-- (PlotDisplayService) den neuen Stand direkt danach als "dargestellt" merkt.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig = require(ReplicatedStorage.Config.MapConfig)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types     = require(ReplicatedStorage.Network.Types)

local ActivityLock = require(ServerScriptService.Util.ActivityLock)
local FigureFX     = require(ServerScriptService.Util.FigureFX)

local MapBuild       = ServerScriptService.Util.MapBuild
local MapParts       = require(MapBuild.MapParts)
local WorldBuilder   = require(MapBuild.WorldBuilder)
local PlotBuilder    = require(MapBuild.PlotBuilder)
local PondBuilder    = require(MapBuild.PondBuilder)
local ArenaBuilder   = require(MapBuild.ArenaBuilder)
local FigureBuilder  = require(MapBuild.FigureBuilder)
local LaidEggBuilder = require(MapBuild.LaidEggBuilder)
local RecyclerBuilder = require(MapBuild.RecyclerBuilder)

--------------------------------------------------------------------------------
-- Interner Zustand
--------------------------------------------------------------------------------

-- Welcher Slot gehoert welchem Spieler
local _playerSlot: { [Player]: number } = {}

-- Alle gespawnten Plot-Models, key = Player
local _plotModels: { [Player]: Model } = {}

-- Verfuegbare Slots (1 .. PLOT_COUNT), wird in init() gefuellt
local _freeSlots: { number } = {}

-- Fuer welche Spieler gerade ein Waechter darauf wartet, den wegen
-- ActivityLock uebersprungenen Figuren-Neuaufbau nachzuholen. Verhindert, dass
-- mehrere Datenaenderungen waehrend derselben Bewegung mehrere Warte-Schleifen
-- starten — eine reicht, sie liest am Ende ohnehin frische Daten.
local _pendingRebuild: { [Player]: boolean } = {}

-- Woher der nachgeholte Neuaufbau seine FRISCHEN IslandData bekommt.
--
-- Absichtlich als eingehaengte Funktion statt eines require(PlayerService):
-- PlayerService requiret bereits MapService, der umgekehrte Weg waere ein
-- Ringschluss. Ausserdem bleibt damit die Regel
-- im Kopf dieser Datei gueltig — MapService kennt weiterhin keine
-- Spielerdaten ausser IslandData. Eingehaengt wird sie von
-- PlotDisplayService.init(); ohne sie faellt nur das Nachholen aus.
local _islandDataProvider: ((Player) -> Types.IslandData?)? = nil

-- v15: zuletzt gesetzter Tower-Turm und Tower-Symbol am Plot-Schild pro
-- Spieler. MapService kennt die Tower-Daten nicht (sie liegen ausserhalb von
-- IslandData) — PlotDisplayService setzt beides; gemerkt wird es hier, damit
-- ein Neuaufbau des Plots (Rebirth) Turm und Symbol sofort wieder mitbaut.
local _showcase: { [Player]: ArenaBuilder.ShowcaseView } = {}
type Badge = { text: string, color: Color3 }
local _badge: { [Player]: Badge } = {}
local _crown: { [Player]: boolean } = {}   -- Paket 9: Top 10 der Endless-Woche

local function badgeText(player: Player, text: string): string
	return if _crown[player] then "♛ " .. text else text
end

--------------------------------------------------------------------------------
-- Plot-Inhalt
--------------------------------------------------------------------------------

-- Baut den kompletten Inhalt eines Plots (Gebaeude + Bruecke + PIT + Baerchis).
local function buildPlotContents(plotModel: Model, slot: number, islandData: Types.IslandData, owner: Player)
	local pool = PondBuilder.honeyPool(islandData)
	for _, building in islandData.buildings do
		PlotBuilder.buildBuilding(plotModel, slot, building, pool)
	end

	ArenaBuilder.buildBridge(plotModel, slot)
	ArenaBuilder.buildPit(plotModel, slot)
	PondBuilder.buildPond(plotModel, slot, islandData)
	RecyclerBuilder.build(plotModel, slot, islandData.recycler)
	FigureBuilder.renderBaerchis(plotModel, slot, islandData)
	LaidEggBuilder.renderLaidEggs(plotModel, slot, islandData, owner)

	-- v15: Tower-Turm und Symbol, falls schon bekannt (nach einem Rebirth).
	local view = _showcase[owner]
	if view then
		ArenaBuilder.buildShowcase(plotModel, slot, view)
	end
	local badge = _badge[owner]
	if badge then
		PlotBuilder.writeOwnerBadge(plotModel, badgeText(owner, badge.text), badge.color)
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

local MapService = {}

local function claimSlot(): number?
	if #_freeSlots == 0 then return nil end
	return table.remove(_freeSlots, 1)
end

local function releaseSlot(slot: number)
	table.insert(_freeSlots, slot)
	table.sort(_freeSlots)
end

function MapService.spawnIsland(player: Player, islandData: Types.IslandData)
	-- Alten Slot freigeben falls vorhanden (sollte nicht passieren, aber sicher)
	if _playerSlot[player] then
		MapService.despawnIsland(player)
	end

	local slot = claimSlot()
	if not slot then
		warn("[MapService] Kein freier Plot fuer Spieler:", player.Name)
		return
	end

	_playerSlot[player] = slot

	local plotModel = PlotBuilder.buildPlotBase(slot, player)
	_plotModels[player] = plotModel

	buildPlotContents(plotModel, slot, islandData, player)

	print("[MapService] Plot gespawnt fuer:", player.Name, "| Slot:", slot)
end

-- Baut den Plot eines Spielers komplett neu — behaelt aber seinen Slot,
-- damit er nach einem Rebirth an derselben Stelle der Map steht.
function MapService.rebuildIsland(player: Player, islandData: Types.IslandData)
	local slot = _playerSlot[player]
	if not slot then
		-- Noch kein Plot (z.B. Server voll) → normaler Spawn-Versuch
		MapService.spawnIsland(player, islandData)
		return
	end

	local oldModel = _plotModels[player]
	if oldModel then
		oldModel:Destroy()
	end

	local plotModel = PlotBuilder.buildPlotBase(slot, player)
	_plotModels[player] = plotModel

	buildPlotContents(plotModel, slot, islandData, player)

	print("[MapService] Plot neu aufgebaut fuer:", player.Name, "| Slot:", slot)
end

function MapService.despawnIsland(player: Player)
	-- Ein noch wartender Nachhol-Waechter hat hier nichts mehr zu tun. Er
	-- merkt das zwar selbst beim naechsten Durchlauf (kein Plot mehr), aber so
	-- bleibt kein Eintrag fuer einen laengst gegangenen Spieler stehen.
	_pendingRebuild[player] = nil
	_showcase[player] = nil
	_badge[player] = nil
	_crown[player] = nil

	local model = _plotModels[player]
	if model then
		model:Destroy()
		_plotModels[player] = nil
	end

	local slot = _playerSlot[player]
	if slot then
		releaseSlot(slot)
		_playerSlot[player] = nil
	end
end

-- (v15: updatePitLevel ist entfallen — es gibt kein PIT-Level mehr. Der Turm
-- auf der Arena-Insel zeigt jetzt den Tower-Rekord, siehe updateTowerShowcase.)

-- v15: den Tower-Turm auf der Arena-Insel (neu) bauen. Aufrufer ist
-- PlotDisplayService, und nur wenn sich Look oder Rekord geaendert haben
-- (Signatur). `show` = der LOOK hat gewechselt: kurze Aufwertungs-Show (ein
-- Partikel-Stoss an der Spitze, < 2 s).
function MapService.updateTowerShowcase(player: Player, view: ArenaBuilder.ShowcaseView, show: boolean?)
	_showcase[player] = view

	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end

	local built = ArenaBuilder.buildShowcase(model, slot, view)
	if show then
		local foot = ArenaBuilder.showcaseFoot(slot)
		local height = MapConfig.TOWER_SHOWCASE.plinthHeight + view.floors * MapConfig.TOWER_SHOWCASE.floorHeight
		FigureFX.burstAt(foot + Vector3.new(0, height + 2, 0), view.color, built, 60)
	end
end

-- v15: Tower-Symbol unter dem Namen auf dem Plot-Schild ("◆ III · 42").
function MapService.setOwnerBadge(player: Player, text: string, color: Color3)
	_badge[player] = { text = text, color = color }
	local model = _plotModels[player]
	if model then
		PlotBuilder.writeOwnerBadge(model, badgeText(player, text), color)
	end
end

-- Paket 9: Krone vor dem Plot-Symbol fuer die Top 10 der Endless-Woche.
-- Aufrufer ist LeaderboardService (kennt die Wochenliste).
function MapService.setOwnerCrown(player: Player, crowned: boolean)
	if (_crown[player] == true) == crowned then return end
	_crown[player] = if crowned then true else nil
	local badge = _badge[player]
	local model = _plotModels[player]
	if badge and model then
		PlotBuilder.writeOwnerBadge(model, badgeText(player, badge.text), badge.color)
	end
end

-- Farbe der kurzen Aufwertungs-Show beim Look-Wechsel (v15).
local LOOK_UPGRADE_COLOR = Color3.fromRGB(255, 220, 110)
local LOOK_UPGRADE_SPARKS = 40

-- v15: baut ein Gebaeude (oder den Recycler) NUR neu, wenn sich sein Look
-- geaendert hat (Attribut "Look" am Koerper gegen BuildingBehavior.getLook).
-- PlotDisplayService ruft das, wenn die Look-Signatur wechselt; Level-Aenderungen
-- innerhalb eines Looks laufen ueber das billige updateBuildingSigns.
-- `show` = kurze Aufwertungs-Show (ein Partikel-Stoss, < 2 s).
function MapService.updateBuildingLooks(player: Player, islandData: Types.IslandData, show: boolean?)
	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end

	local pool = PondBuilder.honeyPool(islandData)
	for _, building in islandData.buildings do
		local part = model:FindFirstChild(building.id)
		local look = BuildingBehavior.getLook(building.level)
		if part and part:IsA("BasePart") and part:GetAttribute("Look") ~= look then
			local position = part.Position
			part:Destroy()
			PlotBuilder.buildBuilding(model, slot, building, pool)
			if show then
				FigureFX.burstAt(position, LOOK_UPGRADE_COLOR, model, LOOK_UPGRADE_SPARKS)
			end
		end
	end

	local body = model:FindFirstChild(CombConfig.RECYCLER_NAME)
	local recyclerLook = BuildingBehavior.getLook(islandData.recycler.level)
	if body and body:IsA("BasePart") and body:GetAttribute("Look") ~= recyclerLook then
		local position = body.Position
		body:Destroy()
		RecyclerBuilder.build(model, slot, islandData.recycler)
		if show then
			FigureFX.burstAt(position, LOOK_UPGRADE_COLOR, model, LOOK_UPGRADE_SPARKS)
		end
	end
end

-- Haengt die Quelle fuer frische IslandData ein (siehe _islandDataProvider).
-- Wird einmal beim Start von PlotDisplayService aufgerufen.
function MapService.setIslandDataProvider(provider: (Player) -> Types.IslandData?)
	_islandDataProvider = provider
end

-- Wartet, bis die Figur des Spielers nicht mehr in einer Bewegung steckt, und
-- baut sie dann mit FRISCH gelesenen Daten neu.
--
-- Frisch gelesen ist der entscheidende Teil: waehrend der Bewegung koennen
-- weitere Aenderungen anfallen (mehrere Level-Ups waehrend eines Ess-Zyklus),
-- und nach einem Rebirth ist die alte IslandData-Tabelle gar nicht mehr die
-- des Spielers — sie einfach aufzuheben und spaeter nochmal zu rendern wuerde
-- einen veralteten Stand in die Welt stellen.
local function scheduleRebuildWhenFree(player: Player)
	if _pendingRebuild[player] then return end
	_pendingRebuild[player] = true

	task.spawn(function()
		local interval = MapConfig.FIGURE_REBUILD_RETRY_SECONDS
		local waited   = 0

		while waited < MapConfig.FIGURE_REBUILD_TIMEOUT_SECONDS do
			task.wait(interval)
			waited += interval

			-- Spieler weg oder Plot abgeraeumt: es gibt nichts mehr nachzuholen.
			if player.Parent == nil or _plotModels[player] == nil then
				break
			end

			if ActivityLock.isFree(player) then
				local provider = _islandDataProvider
				local island   = if provider then provider(player) else nil

				-- Vor dem erneuten Aufruf freigeben: updateBaerchis darf, falls
				-- inzwischen doch wieder eine Bewegung laeuft, sauber einen
				-- neuen Waechter starten.
				_pendingRebuild[player] = nil

				if island then
					MapService.updateBaerchis(player, island)
				end
				return
			end
		end

		_pendingRebuild[player] = nil
	end)
end

-- Baut die sichtbaren Baerchis eines Spielers NEU. Teuer — nur aufrufen wenn
-- sich der Bestand oder ein Level geaendert hat (siehe PlotDisplayService).
--
-- Steckt die Figur gerade in einer Bewegung, wird der Neuaufbau verschoben
-- statt sie mitten im Schritt zu ersetzen (Begruendung im Kopf der Datei).
function MapService.updateBaerchis(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	if not ActivityLock.isFree(player) then
		scheduleRebuildWhenFree(player)
		return
	end

	FigureBuilder.renderBaerchis(model, slot, islandData)
	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- Baut die herumliegenden Eier eines Spielers neu.
--
-- Anders als updateBaerchis KEINE ActivityLock-Pruefung: Eier bewegen sich
-- nicht und gehoeren niemandem, der sie gerade animiert. Sie duerfen deshalb
-- auch mitten in einem Kampf oder Weg zum Teich erscheinen und verschwinden —
-- genau das muss sogar sein, weil der Baerchi WAEHREND er laeuft legt.
function MapService.updateLaidEggs(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- Haengt den Ei-Einsammel-Handler ein: er laeuft, wenn der BESITZER eines
-- Plots sein eigenes gelegtes Ei mit der Spielfigur beruehrt. Wird einmal
-- beim Start von EggLayService aufgerufen (Pull-Callback statt require:
-- EggLayService requiret bereits MapService, der umgekehrte Weg waere ein
-- Ringschluss). Ohne Handler sammelt Beruehren einfach nichts ein.
function MapService.setEggCollectHandler(handler: (Player, string) -> ())
	LaidEggBuilder.setCollectHandler(handler)
end

-- Rechnet eine Weltposition in das Koordinatensystem des Plots um.
--
-- Gelegte Eier werden PLOT-RELATIV gespeichert, nicht in Weltkoordinaten. Der
-- Grund: welchen der acht Plots ein Spieler bekommt, entscheidet sich bei
-- jedem Join neu (siehe _freeSlots). Absolute Positionen wuerden nach einem
-- Rejoin auf einem anderen Plot liegen — im schlimmsten Fall auf dem eines
-- Nachbarn.
function MapService.worldToPlot(player: Player, worldPosition: Vector3): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end

	local plotCFrame = MapParts.plotCFrame(slot)
	if not plotCFrame then return nil end

	return plotCFrame:PointToObjectSpace(worldPosition)
end

-- Aktualisiert nur Beschriftung und Erschoepfung der bereits stehenden
-- Figuren. Billig — das ist der Weg fuer HP-Aenderungen.
function MapService.updateBaerchiStates(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return end

	for _, baerchi in islandData.baerchis do
		local figure = folder:FindFirstChild("Baerchi_" .. baerchi.uid)
		if figure and figure:IsA("Model") then
			FigureBuilder.writeBaerchiState(figure, baerchi, FigureBuilder.maxHpOf(baerchi))
		end
	end
end

-- Aktualisiert das Level-Attribut einer Gebaeude-Part (fuer Client-UI).
-- Wird nach einem Gebaeude-Upgrade aufgerufen; baut nichts neu.
function MapService.updateBuildingLevel(player: Player, buildingId: Types.BuildingId, level: number)
	local model = _plotModels[player]
	if not model then return end

	local part = model:FindFirstChild(buildingId)
	if part then
		part:SetAttribute("BuildingLevel", level)
	end
end

-- Wohin der Baerchi zum Fressen laeuft.
--
-- Das ist der Standplatz VOR dem Becken (auf den Bohlen), nicht mehr die
-- Beckenmitte. Bis der Teich ein richtiges Becken wurde, war beides dasselbe
-- — und der Baerchi stand mitten im Teich. Jetzt stuende er bis zum Bauch im
-- Beckenboden.
function MapService.getPondPosition(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return PondBuilder.pondStand(slot).Position
end

-- Mitte des Beckens (Weltposition) — z. B. damit gelegte Eier nicht im Honig
-- landen, seit der Baerchi am Becken wohnt (HONEY_POND_V2).
function MapService.getPondCenter(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return PondBuilder.pondGround(slot).Position
end

-- Fuellstand des Teichs nachziehen. Billig — das ist der Weg fuer
-- Honig-Aenderungen (siehe MapService.updateBuildingSigns, das das mit
-- aufruft, weil beides an denselben Werten haengt).
function MapService.updatePondFill(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	local pond = model:FindFirstChild("Pond")
	if not pond then return end

	local fill = pond:FindFirstChild("Fuellung")
	if fill and fill:IsA("BasePart") then
		PondBuilder.writePondFill(fill, PondBuilder.pondGround(slot), PondBuilder.pondFillRatio(islandData))
	end
end

-- Schreibt Level und Honig-Lagerstand auf die Gebaeude-Schilder.
-- Billig — das ist der Weg fuer Honig-Aenderungen.
function MapService.updateBuildingSigns(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local pool = PondBuilder.honeyPool(islandData)

	for _, building in islandData.buildings do
		local part = model:FindFirstChild(building.id)
		if part and part:IsA("BasePart") then
			part:SetAttribute("BuildingLevel", building.level)
			PlotBuilder.writeBuildingState(part, building, pool)
		end
	end

	-- Haengt an denselben Werten wie die Gebaeude-Schilder — deshalb hier
	-- gleich mit erledigt statt eines eigenen Aufrufers in PlotDisplayService.
	MapService.updatePondFill(player, islandData)
end

-- Schreibt Level, Warteschlange und Lampe des Waben-Recyclers neu.
-- Billig — der Weg fuer jede Aenderung der Warteschlange.
function MapService.updateRecycler(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local body = model:FindFirstChild(CombConfig.RECYCLER_NAME)
	if body and body:IsA("BasePart") then
		RecyclerBuilder.writeState(body, islandData.recycler)
	end
end

-- Die Anzeigetafel ueber der Arena. Bewusst ueber den exakten Pfad gesucht und
-- nicht rekursiv: unter dem Plot haengen bis zu 25 importierte Mesh-Figuren,
-- deren Teilenamen aus einer .glb stammen und die wir nicht kontrollieren.
-- Eine rekursive Suche wuerde bei einem gleichnamigen Teil das Falsche finden
-- — und muesste bei jeder der bis zu 60 Stages den ganzen Baum durchlaufen.
local function findPitBanner(player: Player): BillboardGui?
	local model = _plotModels[player]
	if not model then return nil end

	local platform = model:FindFirstChild("PitPlatform")
	if not platform then return nil end

	local anchor = platform:FindFirstChild("PitBannerAnchor")
	if not anchor then return nil end

	local banner = anchor:FindFirstChild("Banner")
	return if banner and banner:IsA("BillboardGui") then banner else nil
end

-- Die Anzeigetafel ueber der Arena beschriften und einblenden.
-- Aufgerufen von PitArenaService waehrend einer Wiedergabe; MapService kennt
-- den Kampfverlauf nicht und entscheidet deshalb nichts ueber den Inhalt.
function MapService.setPitBanner(player: Player, title: string, subtitle: string, color: Color3)
	local banner = findPitBanner(player)
	if not banner then return end

	local titleLabel = banner:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		titleLabel.Text       = title
		titleLabel.TextColor3 = color
	end

	local subLabel = banner:FindFirstChild("Sub")
	if subLabel and subLabel:IsA("TextLabel") then
		subLabel.Text = subtitle
	end

	banner.Enabled = true
end

-- Tafel wieder ausblenden. Idempotent — ein zweiter Aufruf schadet nicht.
function MapService.clearPitBanner(player: Player)
	local banner = findPitBanner(player)
	if banner then
		banner.Enabled = false
	end
end

--------------------------------------------------------------------------------
-- Event-Pit: Farbe und Anzeigetafel von aussen setzbar (EventService)
--------------------------------------------------------------------------------

-- Anders als findPitBanner gibt es das Event-Pit nur EINMAL fuer die ganze
-- Welt, nicht pro Spieler — keine Player-Suche noetig.
local function findEventPitContainer(): Model?
	local platform = workspace:FindFirstChild("Platform")
	if not platform then return nil end

	local pit = platform:FindFirstChild("EventPit")
	return if pit and pit:IsA("Model") then pit else nil
end

export type EventTheme = {
	floorColor : Color3,
	fenceColor : Color3,
	ringColor  : Color3,
}

-- Faerbt Boden, Zaun und Ring des Event-Pits um. Mit `theme = nil` kehrt es
-- zum schlichten Stall-Look zurueck (siehe MapConfig, EVENT_PIT_DEFAULT_*).
-- EventService ruft das genau zweimal pro Zyklus: einmal beim Start eines
-- Events mit dessen Farben, einmal beim Ende mit nil.
function MapService.setEventPitTheme(theme: EventTheme?)
	local container = findEventPitContainer()
	if not container then return end

	local floorColor = if theme then theme.floorColor else MapConfig.EVENT_PIT_DEFAULT_FLOOR_COLOR
	local fenceColor = if theme then theme.fenceColor else MapConfig.EVENT_PIT_DEFAULT_FENCE_COLOR
	local ringColor  = if theme then theme.ringColor  else MapConfig.EVENT_PIT_DEFAULT_RING_COLOR

	-- Material wechselt mit: Wood/SmoothPlastic im Stall-Look, Neon waehrend
	-- eines Events — sonst saehe man den Farbwechsel bei Zaun und Ring kaum,
	-- weil beide im Stall-Look bewusst matt sind.
	local activeMaterial = if theme then Enum.Material.Neon else Enum.Material.Wood
	local ringMaterial   = if theme then Enum.Material.Neon else Enum.Material.SmoothPlastic

	local floor = container:FindFirstChild("EventFloor")
	if floor and floor:IsA("BasePart") then
		floor.Color = floorColor
	end

	local ring = container:FindFirstChild("EventRing")
	if ring and ring:IsA("BasePart") then
		ring.Color    = ringColor
		ring.Material = ringMaterial
	end

	for _, child in container:GetChildren() do
		if child.Name:match("^EventFence_") and child:IsA("BasePart") then
			child.Color    = fenceColor
			child.Material = activeMaterial
		end
	end
end

-- Beschriftet die Countdown-Tafel ueber dem Event-Pit. Anders als
-- setPitBanner blendet das hier NICHT ein/aus — die Tafel steht permanent
-- (siehe buildEventPit): sie zeigt entweder den Countdown bis zum naechsten
-- Event oder Name + Restzeit des laufenden.
function MapService.setEventBanner(title: string, subtitle: string, color: Color3, reward: string?)
	local container = findEventPitContainer()
	if not container then return end

	local anchor = container:FindFirstChild("EventBannerAnchor")
	if not anchor then return end

	local banner = anchor:FindFirstChild("Banner")
	if not (banner and banner:IsA("BillboardGui")) then return end

	local titleLabel = banner:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		titleLabel.Text       = title
		titleLabel.TextColor3 = color
	end

	local subLabel = banner:FindFirstChild("Sub")
	if subLabel and subLabel:IsA("TextLabel") then
		subLabel.Text = subtitle
	end

	local rewardLabel = banner:FindFirstChild("Reward")
	if rewardLabel and rewardLabel:IsA("TextLabel") then
		rewardLabel.Text = reward or ""
	end
end

-- Weltposition der PODEST-OBERFLAECHE des Event-Pits in der Weltmitte.
--
-- Anders als getPitPosition NICHT pro Spieler: das Event-Pit gibt es einmal
-- fuer die ganze Welt (siehe findEventPitContainer). EventParticipationService
-- laesst die Figuren aller teilnehmenden Spieler auf dieselbe Flaeche laufen.
--
-- Der Y-Wert ist dieselbe Rechnung wie in buildEventPit (`floorY`), bewusst
-- aus MapConfig neu gerechnet statt aus der gebauten Geometrie gemessen: die
-- Zahl gehoert der Konfiguration, nicht dem Modell.
function MapService.getEventPitPosition(): Vector3
	local center = MapConfig.CENTER
	local floorY = MapConfig.PLATFORM_TOP_Y
		+ MapConfig.EVENT_PIT_GROUND_CLEARANCE
		+ MapConfig.EVENT_PIT_FLOOR_HEIGHT

	return Vector3.new(center.X, floorY, center.Z)
end

-- Radius der begehbaren Event-Flaeche. EventParticipationService prueft damit
-- serverseitig nach, ob eine Figur tatsaechlich noch dort steht, statt sich auf
-- ein gesetztes Flag zu verlassen.
function MapService.getEventPitRadius(): number
	return MapConfig.EVENT_PIT_RADIUS
end

-- Weltposition der Kampfflaeche dieses Spielers.
-- Wird von PitArenaService benoetigt um die Kaempfer zu platzieren.
function MapService.getPitPosition(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return MapParts.pitCenter(slot)
end

-- Das CFrame des Plots (Blickrichtung zur Plattform-Mitte).
-- PitArenaService braucht es, um die Kaempfer sinnvoll auszurichten.
function MapService.getPlotCFrame(player: Player): CFrame?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return MapParts.plotCFrame(slot)
end

-- Die stehende Figur eines Baerchis auf dem Plot, falls vorhanden.
-- PitArenaService schickt genau diese Figur in die Arena und wieder zurueck,
-- statt eine zweite Kopie zu bauen — sonst staende derselbe Baerchi doppelt
-- in der Welt.
function MapService.getBaerchiModel(player: Player, baerchiUid: string): Model?
	local model = _plotModels[player]
	if not model then return nil end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return nil end

	local figure = folder:FindFirstChild("Baerchi_" .. baerchiUid)
	if figure and figure:IsA("Model") then
		return figure
	end
	return nil
end

-- Feiert ein Ereignis (Level-Up, Promotion, Rebirth, ...) SICHTBAR auf dem
-- Plot: Partikel-Stoss, Huepfer, kurzes Aufleuchten (siehe FigureFX.celebrate).
--
-- Bewusst als eigene MapService-Funktion und nicht direkt FigureFX.celebrate
-- vom Aufrufer: der Aufrufer (HoneyService, PromotionService, RebirthService,
-- ...) soll keine Modelle aus der Welt heraussuchen muessen — genau wie bei
-- getBaerchiModel bleibt das MapServices Job. Steht die Figur gerade nicht in
-- der Welt (Plot noch nicht gebaut, Bewegung verzoegert den Neuaufbau), passiert
-- einfach nichts — kein Fehler, der Toast-Text kommt ja trotzdem an.
function MapService.celebrateBaerchi(player: Player, baerchiUid: string, color: Color3)
	local model = MapService.getBaerchiModel(player, baerchiUid)
	if not model then return end

	FigureFX.celebrate(model, color)
end

-- Beschriftung und Transparenz einer Figur mit einem AUSDRUECKLICH
-- angegebenen HP-Wert setzen — auch waehrend eines laufenden PIT-Kampfes.
--
-- Nur fuer PitArenaService: der muss die Figur beim Start der Wiedergabe auf
-- die HP zuruecksetzen, mit denen der Lauf BEGONNEN hat. Die gespeicherten HP
-- stehen zu dem Zeitpunkt laengst auf dem Endwert, der Baerchi saehe sonst
-- schon vor dem ersten Schlag erschoepft aus.
function MapService.setFigureState(model: Model, hp: number, maxHp: number)
	FigureBuilder.writeFigureState(model, hp, maxHp)
end

-- Der Ordner in der Arena, in den die Kampf-Figuren gehoeren.
function MapService.getFighterFolder(player: Player): Folder?
	local model = _plotModels[player]
	if not model then return nil end

	local pit = model:FindFirstChild("PitPlatform")
	if not pit then return nil end

	local fighters = pit:FindFirstChild("Fighters")
	if fighters and fighters:IsA("Folder") then
		return fighters
	end
	return nil
end

-- Baut den PIT-Turm auf genau `level` Etagen aus bzw. ab — idempotent: fehlt
-- eine Etage, wird sie ergaenzt; ist eine zu viel da, wird sie entfernt. Mit
-- `level = 0` verschwindet der Turm komplett.
--
-- PitArenaService ruft das bei jeder Stage mit der neuen Stufenzahl auf, und
-- mit 0 sobald ein Lauf zu Ende ist oder ein neuer beginnt — der Turm bleibt
-- also NIE zwischen zwei Laeufen stehen, genau wie die Kampf-Figuren selbst
-- (siehe clearFighters in PitArenaService).
--
-- Bewegt bei einem Aufbau auch die Anzeigetafel-Verankerung mit nach oben,
-- damit sie ueber dem gewachsenen Turm haengen bleibt statt mittendrin zu
-- stecken.
function MapService.setPitTowerLevel(player: Player, level: number)
	local slot  = _playerSlot[player]
	local model = _plotModels[player]
	if not slot or not model then return end

	local container = model:FindFirstChild("PitPlatform")
	if not container then return end

	local tower = container:FindFirstChild("Tower")
	if not (tower and tower:IsA("Folder")) then return end

	local wanted = math.max(0, math.floor(level))
	local center = MapParts.pitCenter(slot)

	for _, child in tower:GetChildren() do
		local index = tonumber(child.Name:match("^Ring_(%d+)$"))
		if not index or index > wanted then
			child:Destroy()
		end
	end

	for i = 1, wanted do
		if not tower:FindFirstChild("Ring_" .. i) then
			ArenaBuilder.buildTowerRing(tower, center, i)
		end
	end

	local anchor = container:FindFirstChild("PitBannerAnchor")
	if anchor and anchor:IsA("BasePart") then
		local topY = MapConfig.PLATFORM_TOP_Y
			+ wanted * MapConfig.PIT_TOWER_STEP_HEIGHT
			+ MapConfig.PIT_BANNER_HEIGHT
		anchor.CFrame = CFrame.new(center.X, topY, center.Z)
	end
end

-- Hoehe (Y ueber PLATFORM_TOP_Y) der Kampfflaeche bei `level` bereits
-- gewachsenen Etagen. PitArenaService braucht das, um die Kaempfer beim
-- Erklimmen jeder Stage auf die richtige Hoehe zu stellen — dieselbe Formel
-- wie in buildTowerRing, hier aber ohne selbst eine Etage zu bauen.
function MapService.getPitTowerFloorY(level: number): number
	return MapConfig.PLATFORM_TOP_Y + math.max(0, level) * MapConfig.PIT_TOWER_STEP_HEIGHT
end

-- v15: die Bestenlisten-Tafel(n) beschriften (Titel + bis zu
-- LEADERBOARD_BOARD.lines Zeilen). Aufrufer ist LeaderboardService.
-- HBB Paket 5: eine Tafel je Liste; Schluessel = listId, "_rotating" = die
-- eine wechselnde Tafel ohne MAP_V2_BOARDS.
local ROTATING = "_rotating"
local _leaderboardBoards: { [string]: BasePart } = {}
local _liveBoard: BasePart? = nil
local _waspNest: Model? = nil

local function writeBoard(board: BasePart?, title: string, lines: { string }, lineCount: number, titleColor: Color3?)
	if not board then return end
	local surface = board:FindFirstChild("Board")
	if not surface then return end

	local titleLabel = surface:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		titleLabel.Text = title
		if titleColor then titleLabel.TextColor3 = titleColor end
	end
	for i = 1, lineCount do
		local line = surface:FindFirstChild("Line" .. i)
		if line and line:IsA("TextLabel") then
			line.Text = lines[i] or ""
		end
	end
end

-- Gibt es eine feste Tafel fuer `listId`? (sonst: wechselnde Tafel)
function MapService.hasLeaderboardBoard(listId: string): boolean
	return _leaderboardBoards[listId] ~= nil
end

function MapService.writeLeaderboardBoard(title: string, lines: { string }, listId: string?)
	local board = (if listId then _leaderboardBoards[listId] else nil) or _leaderboardBoards[ROTATING]
	writeBoard(board, title, lines, MapConfig.LEADERBOARD_BOARD.lines)
end

-- HBB Paket 6: Live-Kampf-Board beschriften. Aufrufer ist LiveBoardService.
function MapService.writeLiveBoard(title: string, lines: { string }, live: boolean)
	local cfg = MapConfig.LIVE_BOARD
	writeBoard(_liveBoard, title, lines, cfg.lines, if live then cfg.liveColor else cfg.textColor)
end

-- HBB Paket 6: Schild und Leuchten des Wespen-Nests. Aufrufer ist EventService.
function MapService.setWaspNest(text: string, glowing: boolean)
	local nest = _waspNest
	if not nest then return end
	local cfg = MapConfig.WASP_NEST
	local body = nest:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		body.Material = if glowing then Enum.Material.Neon else Enum.Material.Sand
		body.Color    = if glowing then cfg.glowColor else cfg.color
	end
	local anchor = nest:FindFirstChild("SignAnchor")
	local sign = if anchor then anchor:FindFirstChild("Sign") else nil
	local title = if sign then sign:FindFirstChild("Title") else nil
	if title and title:IsA("TextLabel") then
		title.Text = text
	end
end

-- v15: Teile auf der Insel eines Spielers zaehlen (Debug-Befehl "parts",
-- Budget <= 250 pro Insel ohne Baerchi-Mesh). Getrennt nach Bereichen, damit man
-- sieht, wo das Budget hingeht. Die Figuren (importierte Meshes) zaehlen extra.
function MapService.countParts(player: Player): { [string]: number }?
	local model = _plotModels[player]
	if not model then return nil end

	local result: { [string]: number } = { total = 0, figures = 0 }
	for _, child in model:GetChildren() do
		local count = if child:IsA("BasePart") then 1 else 0
		for _, descendant in child:GetDescendants() do
			if descendant:IsA("BasePart") then count += 1 end
		end
		local key = child.Name
		if key == "Baerchis" then
			result.figures += count
		else
			result[key] = (result[key] or 0) + count
			result.total += count
		end
	end
	return result
end

function MapService.init()
	-- Freie Slots einmalig aufbauen
	for slot = 1, MapConfig.PLOT_COUNT do
		table.insert(_freeSlots, slot)
	end

	-- ============================================================
	-- GEOMETRIE-PRUEFUNG
	-- ============================================================
	-- Die Weltgeometrie haengt an einem guten Dutzend Zahlen, die voneinander
	-- abhaengen. Faellt eine aus dem Rahmen, sieht man das im fertigen Spiel als
	-- Loch im Boden oder als Insel im Nichts — und sucht dann im Code statt in
	-- der Config. Diese vier Pruefungen sagen es beim Start, im Klartext.
	--
	-- Sie WARNEN nur und brechen nicht ab: eine Welt mit einer schiefen Zahl ist
	-- immer noch spielbar, und ein harter Abbruch beim Serverstart waere die
	-- schlechtere Rueckmeldung.

	-- 1. Passt das quadratische Beet auf die runde Plot-Insel? Entscheidend ist
	--    die ECKE, nicht die Kante — eine halbe Diagonale, nicht eine halbe Seite.
	local plateCorner = math.sqrt(
		(MapConfig.PLOT_SIZE.X * 0.5) ^ 2 + (MapConfig.PLOT_SIZE.Z * 0.5) ^ 2
	)
	if plateCorner > MapConfig.PLOT_ISLAND_RADIUS then
		warn(
			"[MapService] Das Beet ragt ueber die Plot-Insel:",
			"halbe Diagonale von PLOT_SIZE =", string.format("%.1f", plateCorner),
			"> PLOT_ISLAND_RADIUS =", MapConfig.PLOT_ISLAND_RADIUS
		)
	end

	-- 2. Liegt der Plot-Ring wirklich eine Steglaenge vor der Hauptinsel?
	--    Sonst waere der Steg entweder zu kurz (Luecke) oder zu lang (er endet
	--    auf der Insel).
	local expectedRing = MapConfig.PLATFORM_RADIUS + MapConfig.ISLAND_GAP + MapConfig.PLOT_ISLAND_RADIUS
	if math.abs(MapConfig.PLOT_RING_RADIUS - expectedRing) > 0.5 then
		warn(
			"[MapService] PLOT_RING_RADIUS passt nicht zur Luecke:",
			MapConfig.PLOT_RING_RADIUS, "sollte", expectedRing, "sein",
			"(PLATFORM_RADIUS + ISLAND_GAP + PLOT_ISLAND_RADIUS)"
		)
	end

	-- 3. Beruehren sich zwei benachbarte Plot-Inseln samt Sandkante?
	local shoreRadius = MapConfig.PLOT_ISLAND_RADIUS + MapConfig.SHORE_WIDTH
	local neighbourGap = 2 * MapConfig.PLOT_RING_RADIUS
		* math.sin(math.pi / MapConfig.PLOT_COUNT) - 2 * shoreRadius
	if neighbourGap <= 0 then
		warn(
			"[MapService] Die Plot-Inseln ueberlappen sich:",
			MapConfig.PLOT_COUNT, "Inseln mit Rand", shoreRadius,
			"auf Ring", MapConfig.PLOT_RING_RADIUS
		)
	end

	-- 4. Reicht das Wasser bis hinter die aeusserste Arena?
	local worldEdge = (MapParts.pitCenter(1) - MapConfig.CENTER).Magnitude
		+ MapConfig.PIT_BASE_RADIUS + MapConfig.SHORE_WIDTH
	if worldEdge > MapConfig.WATER_RADIUS then
		warn(
			"[MapService] Die Arenen ragen ueber den Wasserrand:",
			"Weltrand =", string.format("%.0f", worldEdge),
			"> WATER_RADIUS =", MapConfig.WATER_RADIUS
		)
	end

	WorldBuilder.buildPlatform()
	WorldBuilder.buildGlobalLighting()

	-- v15: Bestenlisten-Tafel(n) (LeaderboardService beschriftet sie).
	-- HBB Paket 5/6: Positionen aus MapLayout (dort auch der Layout-Test).
	local platform = workspace:FindFirstChild("Platform") or workspace
	for _, b in MapLayout.leaderboardBoards() do
		local listId = b.listId
		local name = if listId then "LeaderboardBoard_" .. listId else "LeaderboardBoard"
		_leaderboardBoards[listId or ROTATING] = WorldBuilder.buildLeaderboardBoard(platform, b.angleDegrees, name)
	end
	if FeatureFlags.isOn("MAP_V2_LIVE_BOARD") then
		_liveBoard = WorldBuilder.buildLiveBoard(platform)
	end
	if FeatureFlags.isOn("MAP_V2_WASP_NEST") then
		_waspNest = WorldBuilder.buildWaspNest(platform, MapLayout.waspNestCenter())
	end

	-- Sicherheitsnetz: falls PlayerService den Leave-Fall mal verpasst,
	-- bleibt sonst ein Slot dauerhaft belegt.
	Players.PlayerRemoving:Connect(function(player)
		if _playerSlot[player] then
			MapService.despawnIsland(player)
		end
	end)

	print("[MapService] Initialisiert | Plots:", MapConfig.PLOT_COUNT)
end

return MapService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX57"><Properties>
<string name="Name">PitArenaService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PitArenaService.luau
-- ServerScriptService/Services/PitArenaService.luau
--
-- Einzige Zustaendigkeit:
--   - Einen von CombatService fertig simulierten PIT-Lauf in der Arena
--     abspielen und dabei den Lauf ZEITLICH fuehren: Hinweg, Stage fuer Stage,
--     Rueckweg, Zurueckholen und Abbruch
--
-- Zum Fuehren gehoert, dass dieser Service entscheidet, WANN abgerechnet und
-- WANN das Ergebnis verschickt wird — beides haengt an der Wiedergabe:
--   - Abrechnung: CombatService gibt eine Funktion (settle) mit. Sie laeuft
--     GENAU EINMAL mit der Zahl der tatsaechlich gespielten Stages: alle bei
--     normalem Ende, bis einschliesslich der laufenden beim Zurueckholen
--     (requestRecall; vor der ersten Stage: 0), und beim Verlassen so, als
--     waere die begonnene Stage zu Ende gespielt (PlayerService.onPlayerLeaving).
--     WAS abgerechnet wird, weiss nur CombatService; dieser Service fasst
--     Spielerdaten selbst nicht an.
--   - Ergebnis: Remotes.CombatResultReceived geht erst raus, wenn abgerechnet
--     ist. sendResult() ist die einzige Stelle, die es abschickt, und
--     idempotent — alle Abbruch- und Erfolgspfade duerfen es aufrufen.
--   - Phase (ToPit / InPit / Returning) und laufende Stage meldet er fuer
--     die Pet-Leiste (PetModeService liest getPhase).
--
-- Warum auf dem SERVER und nicht im Client: die Arenen liegen in derselben
-- Welt wie alle Plots. Serverseitig kann ein Nachbar ueber den Steg kommen
-- und zuschauen.
--
-- Die Figur wird nicht kopiert, sondern die ECHTE Figur vom Plot wandert in
-- die Arena und danach exakt an ihren Platz zurueck. Eine zweite Kopie waere
-- sonst gleichzeitig auf dem Plot zu sehen.
--
-- ============================================================
-- HEIMKEHR — die eigentliche Schwierigkeit
-- ============================================================
-- Der Ausgangs-Pivot der Figur darf NICHT beim Start jeder Wiedergabe frisch
-- abgelesen werden: startet ein zweiter Lauf waehrend der erste noch laeuft,
-- stuende die Figur da schon in der Arena und wuerde spaeter genau dorthin
-- "zurueckgesetzt". Deshalb merkt sich dieser Service den Platz auf dem Plot
-- getrennt (_home) und raeumt einen laufenden Lauf IMMER erst komplett auf,
-- bevor ein neuer beginnt.
--
-- Abbrechen kann die Wiedergabe ausserdem: der Spieler geht, oder der Plot
-- wird neu gebaut (dann ist die Figur weg). Beides wird geprueft, und in
-- keinem Fall bleibt etwas Halbes stehen.
--
-- ============================================================
-- ZUG UM ZUG
-- ============================================================
-- CombatService gibt pro Stage die einzelnen Zuege mit (Types.FightBeat).
-- Jede Stage wird als Folge von Stoessen gezeigt: die Baerchis laufen
-- aufeinander zu und prallen zusammen (FigureFX.clash). Unter dem eigenen
-- HP-Balken laeuft eine Ladeleiste (Util/FightBars); ist sie voll, kommt die
-- Faehigkeit mit ihrer Show (SkillFX, beim ersten Mal voll, danach als Echo).
-- WELCHE Zuege in die Zeit passen, rechnet FightTimeline.
--
-- startPlayback ist bewusst EINE lange Funktion: sie erzaehlt den Ablauf
-- eines Laufs von vorn nach hinten, und ihre Schritte teilen viel Zustand.
-- Zerlegt in viele kleine Funktionen muesste man zum Verstehen hin und her
-- springen.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)
local MapConfig   = require(ReplicatedStorage.Config.MapConfig)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local SkillConfig = require(ReplicatedStorage.Config.SkillConfig)
local SkillFXConfig = require(ReplicatedStorage.Config.SkillFXConfig)
local BaerchiMesh = require(ReplicatedStorage.Modules.BaerchiMesh)
local FightTimeline = require(ReplicatedStorage.Modules.FightTimeline)
local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)

local PlayerService   = require(ServerScriptService.Services.PlayerService)
local MapService      = require(ServerScriptService.Services.MapService)
local FigureWalker    = require(ServerScriptService.Util.FigureWalker)
local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)
local FigureFX        = require(ServerScriptService.Util.FigureFX)
local ActivityLock    = require(ServerScriptService.Util.ActivityLock)
local FightBars       = require(ServerScriptService.Util.FightBars)

-- Name unter dem PitArenaService das Bewegungs-Schloss haelt (siehe
-- ActivityLock) — verhindert dass BaerchiAutopilotService den Baerchi
-- waehrend eines Kampf-Laufs zum Honig-Teich abzieht.
local LOCK_HOLDER = "Kampf"

local PitArenaService = {}

-- HBB Paket 5 (MAP_V2_ARENA_SPRINT): auf dem Weg Plot <-> Arena sprintet der
-- Baerchi (MapConfig.ARENA_WALK_SPEED) statt zu gehen — weniger Warten je Lauf.
local function arenaWalkSpeed(): number
	return if FeatureFlags.isOn("MAP_V2_ARENA_SPRINT") then MapConfig.ARENA_WALK_SPEED else MapConfig.WALK_SPEED
end

-- Gleich viele Hopser pro SEKUNDE wie beim Gehen, dafuer weitere: schnelleres
-- Huepfen liest das Auge als Zittern (siehe MapConfig.WALK_BOB_PER_STUD).
local function arenaBobPerStud(): number
	return MapConfig.WALK_BOB_PER_STUD * MapConfig.WALK_SPEED / arenaWalkSpeed()
end

-- Laufende Wiedergabe pro Spieler. Startet ein neuer Lauf, wird der alte
-- Token ungueltig und die alte Schleife beendet sich beim naechsten Schritt.
local _runToken: { [Player]: number } = {}

-- Ergebnis, das der Client noch nicht bekommen hat. Wird gesetzt sobald ein
-- Lauf beginnt und erst gefeuert, wenn der Baerchi sichtbar am Kampf-Spot
-- angekommen ist (siehe sendResult) — vorher liefe die Kampf-UI schon,
-- waehrend er noch zur Arena unterwegs waere. Bleibt die Wiedergabe aus
-- irgendeinem Grund stecken (kein Plot, Fehler waehrend des Laufs), wird an
-- den Abbruchstellen trotzdem gesendet, damit der Client nie ganz ohne
-- Ergebnis dasteht.
--
-- Der Eintrag traegt seinen eigenen Token: `isRunning` verhindert zwar, dass
-- ueberhaupt ein zweiter Lauf waehrend eines laufenden startet, aber ohne den
-- Token wuerde selbst ein knapp daneben abgewiesener Request die
-- Abbruch-Fallbacks eines ANDEREN, spaeter gestarteten Laufs treffen und
-- dessen Ergebnis zu frueh verschicken — genau der Fehler, den sendResult
-- eigentlich beheben soll. sendResult prueft den Token deshalb mit.
-- v12: Abrechnung und Zustand des laufenden Laufs. `entered` = wie viele
-- Stages bereits BEGONNEN haben (fuer die Abrechnung bei Abbruch), `phase`
-- und `stage` fuer die Anzeige, `recall` = Spieler will zurueck.
export type SettleFn = (played: number, recalled: boolean) -> Types.PitRunResult
type Active = {
	token   : number,
	run     : Types.PitRunResult,
	settle  : SettleFn?,
	settled : Types.PitRunResult?,
	sent    : boolean,
	entered : number,
	recall  : boolean,
	beats   : { { Types.FightBeat } }?,   -- v15: Zuege je Stage (Index = Stage im Lauf)
	phase   : string,     -- "ToPit" | "InPit" | "Returning"
	stage   : number?,
}
local _active: { [Player]: Active } = {}

-- Wo die gerade kaempfende Figur auf dem Plot hingehoert. homeFoot ist der
-- Fusspunkt VOR dem Loslaufen (fuer den Weg zurueck), pivot der exakte
-- Ausgangszustand (fuer den abschliessenden Snap in restoreHome).
type Home = { model: Model, pivot: CFrame, homeFoot: Vector3 }
local _home: { [Player]: Home } = {}

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- Bringt eine noch in der Arena stehende Figur an ihren Platz auf dem Plot
-- zurueck und raeumt ihren Kampf-Balken weg. Idempotent: zweimal aufrufen
-- schadet nicht.
local function restoreHome(player: Player)
	local home = _home[player]
	if not home then return end

	_home[player] = nil

	local model = home.model
	if model.Parent ~= nil then
		FightBars.removeHealthBar(model)
		model:SetAttribute("InArena", nil)

		-- ZUERST abmelden, DANN heimsetzen — nie andersherum. Waehrend des
		-- Kampfs atmet die Figur am Kampf-Spot, ihre gemerkte Ruhelage ist also
		-- die Arena-Position. Ein spaeteres Abmelden wuerde sie genau dorthin
		-- zuruecksetzen und die Heimkehr wieder zunichtemachen.
		FigureFX.stopIdle(model)
		model:PivotTo(home.pivot)

		-- Zuhause angekommen und wieder in Ruhe: `home.pivot` ist garantiert
		-- die saubere Ruhelage, weil startPlayback das Atmen VOR dem Merken
		-- abgeschaltet hat.
		FigureFX.idleBob(model, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
	end
end

-- Alle Gegner-Figuren aus der Arena raeumen.
local function clearFighters(player: Player)
	local fighters = MapService.getFighterFolder(player)
	if not fighters then return end

	for _, child in fighters:GetChildren() do
		child:Destroy()
	end
end

-- Text auf der Anzeigetafel ueber der Arena. Die Tafel selbst gehoert
-- MapService; hier wird nur entschieden WAS draufsteht, weil nur dieser
-- Service den Verlauf des Laufs kennt.
-- v15: "Tower II · Stage 23"
local function stageTitle(towerId: string?, stage: number): string
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	return string.format("Tower %s  ·  Stage %d", def.numeral, stage)
end

local function showStage(player: Player, towerId: string?, stage: Types.PitStageResult, cleared: number)
	MapService.setPitBanner(
		player,
		stageTitle(towerId, stage.stage),
		if cleared > 0
			then string.format("%d geschafft", cleared)
			else "erster Gegner",
		MapConfig.PIT_BANNER_RUNNING
	)
end

local function showSummary(player: Player, run: Types.PitRunResult)
	-- "Geschafft" ist die Zahl gewonnener Stages. Sie kann 0 sein — dann hat
	-- der Baerchi den ersten Gegner nicht ueberlebt, und genau das soll auch
	-- dastehen statt eines beschoenigenden "0 geschafft".
	local won = run.stagesCleared > 0

	MapService.setPitBanner(
		player,
		if won
			then string.format("%d Stages geschafft", run.stagesCleared)
			else "Keine Stage geschafft",
		string.format("%d Gummies", run.gummiesWon),
		if won then MapConfig.PIT_BANNER_WIN else MapConfig.PIT_BANNER_LOSS
	)
end

-- Schickt das Kampfergebnis an den Client — idempotent, weil mehrere
-- Abbruch- und Erfolgspfade das hier alle "auf gut Glueck" aufrufen koennen.
-- Erst danach darf CombatPanel seine Stage-Wiedergabe starten; siehe die
-- Aufrufstelle in startPlayback fuer den genauen Zeitpunkt (Ankunft am
-- Kampf-Spot).
-- `token` muss zu dem Lauf gehoeren, der sendResult aufruft — sonst koennte
-- der Abbruch-Fallback eines ueberholten Laufs A das laengst neu gesetzte
-- _pendingResult eines inzwischen gestarteten Laufs B verschicken, noch
-- bevor dessen eigener Baerchi angekommen ist.
-- v12: rechnet ab (einmal) und gibt das abgerechnete Ergebnis zurueck. Ohne
-- settle-Funktion (Altaufruf) zaehlt der volle Lauf.
local function settleActive(active: Active, played: number, recalled: boolean): Types.PitRunResult
	if active.settled then
		return active.settled
	end

	local settle = active.settle
	local result = active.run
	if settle then
		local ok, res = pcall(settle, played, recalled)
		if ok then
			result = res
		else
			warn("[PitArenaService] Abrechnung fehlgeschlagen:", res)
		end
	end

	active.settled = result
	return result
end

-- Schickt das ABGERECHNETE Ergebnis an den Client — idempotent und nur fuer
-- den Lauf, zu dem der Token gehoert. Wurde noch nicht abgerechnet (Abbruch),
-- wird hier mit den bereits begonnenen Stages abgerechnet.
local function sendResult(player: Player, token: number)
	local active = _active[player]
	if not active or active.token ~= token or active.sent then return end
	active.sent = true

	local result = settleActive(active, active.entered, active.recall)
	if player.Parent ~= nil then
		Remotes.CombatResultReceived:FireClient(player, result)
	end
end

-- Den Erschoepfungs-Zustand nachziehen, der waehrend der Wiedergabe
-- unterdrueckt war.
local function refreshState(player: Player)
	local data = PlayerService.getData(player)
	if data then
		MapService.updateBaerchiStates(player, data.island)
	end
end

--------------------------------------------------------------------------------
-- Wiedergabe
--------------------------------------------------------------------------------

-- Steht die Wiedergabe noch? Prueft alles was sie abbrechen kann:
-- ein neuer Lauf, der Spieler geht, der Plot wird neu gebaut (Figur weg),
-- oder das PIT wird ausgebaut (dann ist der Kaempfer-Ordner mit zerstoert
-- worden und neue Gegner landeten unsichtbar im Nirgendwo).
local function setPhase(player: Player, token: number, phase: string, stage: number?)
	local active = _active[player]
	if active and active.token == token then
		active.phase = phase
		active.stage = stage
	end
end

local function recallWanted(player: Player, token: number): boolean
	local active = _active[player]
	return active ~= nil and active.token == token and active.recall
end

local function stillValid(player: Player, token: number, figure: Model, fighters: Folder): boolean
	if _runToken[player] ~= token then return false end
	if player.Parent == nil then return false end
	if figure.Parent == nil then return false end
	if fighters.Parent == nil then return false end
	return true
end

-- v12: Laesst den Turm Etage fuer Etage von `fromLevel` auf `toLevel` wachsen
-- (oder schrumpfen) und haelt die Figur dabei immer oben auf der aktuellen
-- Etage. Bei sehr hohen Tuermen wachsen mehrere Etagen pro Schritt, damit es
-- nie laenger als `seconds` dauert. Die Figur darf waehrenddessen NICHT im
-- Idle-Loop sein (der Aufrufer meldet sie ab und danach wieder an).
-- Gibt false zurueck, wenn die Wiedergabe unterwegs ungueltig wurde.
local function rideTower(
	player: Player, token: number, figure: Model, fighters: Folder,
	fromLevel: number, toLevel: number, seconds: number,
	selfPos: Vector3, enemyPos: Vector3
): boolean
	local distance = math.abs(toLevel - fromLevel)
	if distance == 0 then return true end

	-- Hoechstens ~20 Schritte pro Sekunde: mehr sieht niemand, und jeder
	-- Schritt baut bzw. entfernt Teile.
	local steps    = math.max(1, math.min(distance, math.floor(seconds * 20)))
	local stepTime = seconds / steps

	for step = 1, steps do
		if not stillValid(player, token, figure, fighters) then return false end

		local level = fromLevel + math.floor((toLevel - fromLevel) * step / steps + 0.5)
		MapService.setPitTowerLevel(player, level)

		local y = MapService.getPitTowerFloorY(level)
		FigurePlacement.placeLookingAt(
			figure,
			Vector3.new(selfPos.X, y, selfPos.Z),
			Vector3.new(enemyPos.X, y, enemyPos.Z)
		)
		task.wait(stepTime)
	end

	return stillValid(player, token, figure, fighters)
end

local function startPlayback(player: Player, run: Types.PitRunResult, settle: SettleFn?, beats: { { Types.FightBeat } }?)
	-- Das Hochzaehlen des Tokens steht ganz oben und vor allem, was fehlschlagen
	-- kann. Ab hier gehoert die Wiedergabe fuer diesen Spieler UNS — und nur
	-- deshalb darf die Fehlerbehandlung in play() bedenkenlos aufraeumen. Stuende
	-- der Token weiter unten und etwas darueber wuerfe, wuerde play() den Zustand
	-- einer noch laufenden aelteren Wiedergabe zerlegen, die anschliessend
	-- munter weiterliefe: Figur zurueck auf dem Plot, aber weiter Gegner in der
	-- Arena und die Tafel wieder an.
	local token = (_runToken[player] or 0) + 1
	_runToken[player] = token

	-- Ab hier ist der Client faellig fuer dieses Ergebnis. Gefeuert wird es
	-- weiter unten erst bei Ankunft am Kampf-Spot — bricht die Wiedergabe
	-- vorher ab (kein Plot, Fehler), sorgen die Abbruchstellen selbst dafuer,
	-- dass es trotzdem noch rausgeht.
	_active[player] = {
		token   = token,
		run     = run,
		settle  = settle,
		settled = nil,
		sent    = false,
		entered = 0,
		recall  = false,
		beats   = beats,
		phase   = "ToPit",
		stage   = nil,
	}

	-- Ein Kampf hat immer Vorrang vor dem automatischen Weg zum Honig-Teich:
	-- forceAcquire nimmt das Bewegungs-Schloss notfalls dem Autopilot weg.
	-- Der bemerkt das selbst (sein isCancelled prueft den Besitzer) und bricht
	-- sein Hinlaufen sauber ab, statt mit dem Kampf um die Figur zu ringen.
	ActivityLock.forceAcquire(player, LOCK_HOLDER)

	-- Einen noch laufenden Lauf komplett aufraeumen. refreshState gehoert
	-- dazu: dessen Wiedergabe hatte den Zustand der Figur unterdrueckt und
	-- kommt wegen des neuen Tokens nicht mehr dazu, ihn nachzuziehen — der
	-- alte Baerchi staende sonst mit veralteter Beschriftung auf dem Plot.
	--
	-- Das passiert bewusst VOR den Abbruchgruenden unten: auch wenn diese
	-- Wiedergabe gar nicht erst startet, muss die alte sauber beendet sein.
	restoreHome(player)
	refreshState(player)
	clearFighters(player)
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)

	-- Es gibt keine Show — Ergebnis trotzdem rausschicken UND das Schloss
	-- wieder freigeben.
	--
	-- Das Freigeben stand hier frueher nicht: forceAcquire oben nimmt das
	-- Schloss immer, die beiden Abbruchgruende unten kamen aber ohne
	-- release() zurueck. Wer also einmal ohne Plot oder ohne gerenderte Figur
	-- in einen Lauf ging, behielt "Kampf" als Schloss-Besitzer fuer den Rest
	-- der Sitzung — der Autopilot ging nie wieder essen, und seit dem
	-- ActivityLock-Schutz wuerden auch Ausruesten, Verwerten und der
	-- Figuren-Neuaufbau dauerhaft abgelehnt. Nur der Fehler-Pfad
	-- (PitArenaService.play) hat freigegeben, der stille Abbruch nicht.
	local function abortPlayback()
		-- Keine Show moeglich: der Lauf zaehlt trotzdem voll (wie vor v12),
		-- er ist ja schon entschieden.
		local active = _active[player]
		if active and active.token == token then
			active.entered = #run.stages
		end
		sendResult(player, token)
		ActivityLock.release(player, LOCK_HOLDER)
		if _active[player] and _active[player].token == token then
			_active[player] = nil
		end
	end

	local center     = MapService.getPitPosition(player)
	local plotCFrame = MapService.getPlotCFrame(player)
	local fighters   = MapService.getFighterFolder(player)
	local figure     = MapService.getBaerchiModel(player, run.baerchiUid)

	-- Fehlt irgendetwas davon (kein Plot, kein Mesh-Template, Figur nicht
	-- gerendert), gibt es einfach keine Show. Der Lauf selbst ist davon
	-- unberuehrt — er ist laengst abgerechnet.
	if not center or not plotCFrame or not fighters or not figure then
		abortPlayback()
		return
	end

	-- typeof statt nur #: kaeme ein Lauf ohne stages-Tabelle herein, waere das
	-- sonst ein Fehler mitten in der Abrechnung statt einer stillen Nicht-Show.
	if typeof(run.stages) ~= "table" or #run.stages == 0 then
		abortPlayback()
		return
	end

	-- Ruhe-Atmen abschalten, BEVOR die Heimatposition gemessen wird: die Figur
	-- schwebt sonst gerade um einen Bruchteil ihres Hubs ueber der Ruhelage,
	-- und genau dieser Versatz wanderte dann in _home.pivot — nach jedem Kampf
	-- staende sie ein Stueckchen hoeher als vorher. stopIdle setzt sie dafuer
	-- selbst auf ihre Ruhelage zurueck.
	FigureFX.stopIdle(figure)

	local homeBox, homeSize = figure:GetBoundingBox()
	local homeFoot = Vector3.new(homeBox.Position.X, homeBox.Position.Y - homeSize.Y * 0.5, homeBox.Position.Z)
	_home[player] = { model = figure, pivot = figure:GetPivot(), homeFoot = homeFoot }

	local maxHp = math.max(1, run.maxHp)

	-- v14: welche Faehigkeit gezeigt wird (SkillFX). Die volle Show laeuft
	-- beim ersten Einsatz eines Laufs, danach nur ein kurzes Echo — sonst
	-- wuerde ein Lauf mit vielen Stages Minuten dauern.
	local fxData = PlayerService.getData(player)
	local fxBaerchi = fxData and fxData.island.baerchis[run.baerchiUid]
	local fxSkillId: string? = fxBaerchi and fxBaerchi.skillId
	local fxShownFull = false

	-- v15: Ladeleiste nur, wenn die Faehigkeit ueberhaupt aufgeladen wird
	-- (Passive und Grundschlag haben charge = 0).
	local fxSkill = fxSkillId and SkillConfig.getById(fxSkillId)
	local showsCharge = fxSkill ~= nil and (fxSkill.charge or 0) > 0

	-- Die beiden Kaempfer stehen sich quer zur Bruecke gegenueber, damit man
	-- sie beim Herueberlaufen von der Seite sieht statt hintereinander.
	local side     = plotCFrame.RightVector
	local selfPos  = center - side * MapConfig.FIGHT_SPACING
	local enemyPos = center + side * MapConfig.FIGHT_SPACING

	-- Die Figur gehoert jetzt uns: MapService laesst ihren Zustand in Ruhe,
	-- bis das Attribut wieder weg ist (sonst saehe sie mitten im Kampf
	-- erschoepft aus, weil die HP serverseitig schon final sind).
	figure:SetAttribute("InArena", true)

	-- Die Figur auf den Zustand VOR dem Lauf zuruecksetzen. Die gespeicherten
	-- HP stehen zu diesem Zeitpunkt schon auf dem Endwert — ohne diese Zeile
	-- stuende der Baerchi bereits blass und mit "erschoepft" beschriftet da,
	-- bevor der erste Gegner ueberhaupt erscheint.
	MapService.setFigureState(figure, run.hpBefore, maxHp)

	task.spawn(function()
		local selfFill: Frame? = nil
		local chargeFill: Frame? = nil

		local ok, err = pcall(function()
			-- Erst hinlaufen: der Kampf soll sichtbar ERST beginnen, wenn der
			-- Baerchi an der Plattform angekommen ist, nicht durch einen
			-- Teleport. FigureWalker haelt den Fusspunkt waehrenddessen exakt
			-- auf Plot-/Bruecken-Hoehe.
			FigureWalker.walk(figure, homeFoot, selfPos, {
				speed       = arenaWalkSpeed(),
				bobPerStud  = arenaBobPerStud(),
				isCancelled = function()
					return not stillValid(player, token, figure, fighters) or recallWanted(player, token)
				end,
			})
			if not stillValid(player, token, figure, fighters) then
				sendResult(player, token)
				return
			end

			-- v12: auf dem Hinweg zurueckgeholt — noch keine Stage begonnen.
			-- Abrechnung mit 0 Stages (erstattet eine bezahlte Fortsetzung),
			-- dann von hier aus heimlaufen.
			if recallWanted(player, token) then
				sendResult(player, token)
				setPhase(player, token, "Returning", nil)
				local box, size = figure:GetBoundingBox()
				local here = Vector3.new(box.Position.X, box.Position.Y - size.Y * 0.5, box.Position.Z)
				FigureWalker.walk(figure, here, homeFoot, {
					speed       = arenaWalkSpeed(),
					bobPerStud  = arenaBobPerStud(),
					isCancelled = function() return not stillValid(player, token, figure, fighters) end,
				})
				return
			end
			setPhase(player, token, "InPit", nil)

			-- Exakte Ausrichtung zum Gegner: der Lauf endet in Laufrichtung,
			-- gekaempft wird aber gegenueber.
			FigurePlacement.placeLookingAt(figure, selfPos, enemyPos)

			-- Ab hier steht der Baerchi am Kampf-Spot und atmet dort — auch
			-- zwischen den Stages und waehrend der Nachlauf-Pause, in der er
			-- sonst reglos herumstuende. Die Ausfallschritte melden ihn dafuer
			-- selbst kurz ab und danach wieder an (FigureFX.clash).
			FigureFX.idleBob(figure, {
				height = MapConfig.IDLE_BOB_HEIGHT,
				rate   = MapConfig.IDLE_BOB_RATE,
			})

			selfFill = FightBars.attachHealthBar(figure, MapConfig.FIGHT_BAR_SELF_COLOR)
			FightBars.tweenFill(selfFill, run.hpBefore / maxHp, 0.01)
			if showsCharge then
				chargeFill = FightBars.attachChargeBar(figure)
			end

			-- (v12: das Ergebnis geht erst nach der Abrechnung am Ende raus.)

			-- Der Gegner der VORHERIGEN Stage wird erst weggeraeumt wenn der
			-- naechste erscheint. Wuerde er am Ende seiner eigenen Stage
			-- verschwinden, waere die entscheidende letzte Niederlage nie zu
			-- sehen — und in der Nachlauf-Pause staende der eigene Baerchi
			-- allein in der Arena.
			local previousEnemy: Model? = nil

			-- Zaehlt die BEREITS gewonnenen Stages fuer die Anzeigetafel.
			-- Absichtlich nicht run.stagesCleared: das ist das Endergebnis und
			-- waere waehrend der Wiedergabe die halbe Spannung vorweggenommen.
			local cleared = 0

			-- Wo der eigene Baerchi zuletzt stand — auf Bodenhoehe, solange
			-- der Turm noch nicht gewachsen ist, sonst auf der aktuellen
			-- Etage. Der Rueckweg nach der letzten Stage startet von hier,
			-- nicht von der urspruenglichen (Boden-)selfPos.
			local finalSelfPos = selfPos

			-- Aktuelle Turmhoehe (Etagen), fuer den Abstieg am Ende.
			local towerNow = 0

			-- ============================================================
			-- v12: FORTSETZUNG — DER TURM WAECHST ERST BIS ZUR STARTSTAGE
			-- ============================================================
			-- Steigt der Baerchi bei Stage 30 ein, wachsen jetzt alle 29
			-- Etagen darunter sichtbar hoch und er faehrt oben mit. Danach
			-- kaempft er auf genau der Hoehe, auf der Stage 30 bei einem Lauf
			-- von vorn stattfinden wuerde — man sieht, wie weit oben man ist.
			-- v15: gestaucht (TowerConfig.getRunFloor), bei 100 Stages hoechstens
			-- RUN_MAX_FLOORS Etagen.
			local baseLevel = TowerConfig.getRunFloor(run.towerId or "I", run.startStage or 1)
			if baseLevel > 0 and not recallWanted(player, token) then
				MapService.setPitBanner(
					player,
					stageTitle(run.towerId, run.startStage or 1),
					"Der Turm waechst …",
					MapConfig.PIT_BANNER_RUNNING
				)

				local riseSeconds = math.min(
					MapConfig.PIT_TOWER_RISE_MAX_SECONDS,
					baseLevel * MapConfig.PIT_TOWER_RISE_SECONDS_PER_LEVEL
				)

				FigureFX.stopIdle(figure)
				if not rideTower(player, token, figure, fighters, 0, baseLevel, riseSeconds, selfPos, enemyPos) then
					return
				end
				FigureFX.idleBob(figure, {
					height = MapConfig.IDLE_BOB_HEIGHT,
					rate   = MapConfig.IDLE_BOB_RATE,
				})

				towerNow     = baseLevel
				finalSelfPos = Vector3.new(selfPos.X, MapService.getPitTowerFloorY(baseLevel), selfPos.Z)
			end

			for index, stage in run.stages do
				if not stillValid(player, token, figure, fighters) then return end

				-- v12: zurueckgeholt — die vorige Stage ist fertig gespielt,
				-- weitere beginnen nicht mehr.
				if recallWanted(player, token) then break end

				local active = _active[player]
				if active and active.token == token then
					active.entered = index
				end
				setPhase(player, token, "InPit", stage.stage)

				-- Etage dieser Stage: die erste Stage kaempft noch auf der
				-- normalen Kampfflaeche (Etage 0) — sichtbar identisch mit dem
				-- Boden, den man von der Bruecke kennt. Jede weitere Stage
				-- bekommt eine neue Turmetage obendrauf (siehe MapConfig,
				-- Abschnitt "PIT-TURM").
				-- v12: absolute Etage — bei einer Fortsetzung steht der Turm
				-- schon (siehe oben), Stage 30 kaempft auf Etage 29.
				local towerLevel = TowerConfig.getRunFloor(run.towerId or "I", stage.stage)
				MapService.setPitTowerLevel(player, towerLevel)
				towerNow = towerLevel

				local floorY        = MapService.getPitTowerFloorY(towerLevel)
				local stageSelfPos  = Vector3.new(selfPos.X, floorY, selfPos.Z)
				local stageEnemyPos = Vector3.new(enemyPos.X, floorY, enemyPos.Z)
				finalSelfPos = stageSelfPos

				-- Ist der Turm inzwischen gewachsen, steht der eigene Baerchi
				-- eine Etage tiefer als er jetzt muesste — er wird VOR dem
				-- naechsten Gegner mit hochgestellt. Ruhe-Atmen dafuer kurz
				-- abmelden und an der neuen Stelle neu anmelden, sonst zoegen
				-- Idle-Loop und diese Bewegung im selben Frame an derselben
				-- Figur (dieselbe Reihenfolge wie in restoreHome).
				if towerLevel > 0 then
					FigureFX.stopIdle(figure)
					FigurePlacement.placeLookingAt(figure, stageSelfPos, stageEnemyPos)
					FigureFX.idleBob(figure, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end

				showStage(player, run.towerId, stage, cleared)

				if previousEnemy and previousEnemy.Parent then
					previousEnemy:Destroy()
				end
				previousEnemy = nil

				local enemy = BaerchiMesh.buildEnemy(stageEnemyPos, MapConfig.FIGHT_ENEMY_COLOR)
				local enemyFill: Frame? = nil

				if enemy then
					FigurePlacement.placeLookingAt(enemy, stageEnemyPos, stageSelfPos)
					enemy.Parent = fighters
					enemyFill = FightBars.attachHealthBar(enemy, MapConfig.FIGHT_BAR_ENEMY_COLOR)
					previousEnemy = enemy

					-- Auch der Gegner soll nicht wie ein Standbild dastehen,
					-- solange er noch lebt.
					FigureFX.idleBob(enemy, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end

				-- ====================================================
				-- v15: DIE STAGE ZUG UM ZUG
				-- ====================================================
				local stageBeats: { Types.FightBeat } = (beats and beats[index]) or {}
				if #stageBeats == 0 then
					-- Ohne Zuege (aelterer Aufrufer): ein einziger Stoss, der
					-- das Ergebnis zeigt — wie vor v15.
					stageBeats = { {
						actor   = if stage.won then "A" else "B",
						kind    = "hit",
						selfHp  = stage.hpAfter / maxHp,
						enemyHp = if stage.won then 0 else 0.35,
						charge  = 0,
						skillId = nil,
					} }
				end

				local plan = FightTimeline.plan(stageBeats, #run.stages, stage.won)
				local tempo = plan.tempo

				-- Kurz stehen bleiben, damit man den neuen Gegner sieht.
				task.wait(MapConfig.FIGHT_ENEMY_INTRO_SECONDS * tempo)
				if not stillValid(player, token, figure, fighters) then return end

				for _, beatIndex in plan.indices do
					local beat = stageBeats[beatIndex]
					local isSelf = beat.actor == "A"
					local attacker: Model? = if isSelf then figure else enemy
					local target:   Model? = if isSelf then enemy else figure
					local attackerHome = if isSelf then stageSelfPos else stageEnemyPos
					local targetHome   = if isSelf then stageEnemyPos else stageSelfPos
					local isSkill = FightTimeline.isSkillBeat(beat)

					-- Leisten und Treffer-Rueckmeldung genau im Aufprall.
					local function onImpact()
						local barSeconds = MapConfig.FIGHT_BEAT_SECONDS * tempo * 0.5
						FightBars.tweenFill(selfFill, beat.selfHp, barSeconds)
						FightBars.tweenFill(enemyFill, beat.enemyHp, barSeconds)
						FightBars.setCharge(chargeFill, beat.charge, barSeconds)
						if target and target.Parent ~= nil then
							FigureFX.hitFlash(target, MapConfig.FIGHT_HIT_FLASH_COLOR, MapConfig.FIGHT_HIT_FLASH_SECONDS)
						end
						local contact = (stageSelfPos + stageEnemyPos) * 0.5 + Vector3.new(0, 1.5, 0)
						FigureFX.burstAt(contact, MapConfig.FIGHT_HIT_FLASH_COLOR, fighters,
							MapConfig.FIGHT_BUMP_SPARKS * (if isSkill then 3 else 1))
						FigureFX.soundAt(contact, MapConfig.FIGHT_BUMP_SOUND,
							MapConfig.FIGHT_BUMP_VOLUME * (if isSkill then 1.6 else 1), fighters,
							0.9 + math.random() * 0.25)
					end

					if beat.kind == "stunned" then
						-- Betaeubt: kein Stoss, die Figur taumelt.
						if attacker then
							FightBars.setCharge(chargeFill, beat.charge, 0.1)
							FigureFX.stagger(attacker, MapConfig.FIGHT_BEAT_SECONDS * tempo)
						else
							task.wait(MapConfig.FIGHT_BEAT_SECONDS * tempo)
						end
					else
						-- Faehigkeit: Leiste leuchtet voll auf, die Show laeuft,
						-- dann der wuchtige Stoss.
						if isSkill and isSelf then
							FightBars.setCharge(chargeFill, 1, 0.1)
							local showId = beat.skillId or fxSkillId
							if showId then
								local full = not fxShownFull
								fxShownFull = true
								Remotes.SkillFXPlay:FireAllClients({
									owner    = player.UserId,
									skillId  = showId,
									full     = full,
									attacker = figure,
									target   = enemy,
									center   = (stageSelfPos + stageEnemyPos) / 2,
								})
								task.wait(SkillFXConfig.getDuration(showId, full) * (if full then 1 else tempo))
								if not stillValid(player, token, figure, fighters) then return end
							end
						end

						local seconds = FightTimeline.beatSeconds(beat) * tempo
						if attacker then
							FigureFX.clash(attacker, target, attackerHome, targetHome, {
								seconds   = seconds,
								gap       = MapConfig.FIGHT_CONTACT_GAP,
								hop       = MapConfig.FIGHT_HOP_HEIGHT * (if isSkill then 1.6 else 1),
								knockback = if isSkill then MapConfig.FIGHT_SKILL_KNOCKBACK else MapConfig.FIGHT_KNOCKBACK,
								step      = MapConfig.FIGHT_ENEMY_STEP_SHARE,
								onImpact  = onImpact,
							})
						else
							-- Gegner-Mesh fehlt: nur Leisten und Funken.
							onImpact()
							task.wait(seconds)
						end
					end

					if not stillValid(player, token, figure, fighters) then return end
				end

				-- Leisten auf den echten Endstand der Stage (falls Zuege
				-- ausgelassen wurden, stimmt so trotzdem alles).
				FightBars.tweenFill(selfFill, stage.hpAfter / maxHp, 0.15)
				FightBars.tweenFill(enemyFill, if stage.won then 0 else stageBeats[#stageBeats].enemyHp, 0.15)

				if stage.won then
					cleared += 1

					-- Besiegter Gegner kippt um, bevor der naechste kommt.
					-- Beim letzten Gegner macht das die Nachlauf-Pause unten.
					if index < #run.stages and enemy and enemy.Parent ~= nil then
						FigureFX.defeatCollapse(enemy, MapConfig.FIGHT_KO_SECONDS * tempo)
					end
				end
			end

			-- v12: JETZT abrechnen — mit den tatsaechlich gespielten Stages —
			-- und das Ergebnis an den Client schicken.
			local active = _active[player]
			local finalRun = run
			if active and active.token == token then
				finalRun = settleActive(active, active.entered, active.recall)
			end
			sendResult(player, token)

			-- Der letzte Gegner steht waehrend der Nachlauf-Pause noch da;
			-- weggeraeumt wird er unten von clearFighters.
			showSummary(player, finalRun)

			-- Wer die LETZTE Stage verloren hat, kippt sichtbar um, statt
			-- einfach zu verschwinden bzw. unveraendert stehenzubleiben.
			--
			-- Der eigene Baerchi kippt nur, wenn er den Lauf wirklich
			-- erschoepft beendet (hpAfter <= 0). Sonst laeuft er gleich darauf
			-- selbst nach Hause — eine umgekippte Figur, die losmarschiert,
			-- waere schlechter als gar keine Animation. Zurueckgesetzt wird die
			-- Neigung ohnehin von restoreHome.
			local lastStage = finalRun.stages[#finalRun.stages]
			local loser: Model? = nil

			if lastStage and lastStage.won then
				loser = previousEnemy
			elseif finalRun.hpAfter <= 0 then
				loser = figure
			end

			-- Das Umkippen laeuft INNERHALB der Nachlauf-Pause ab, verlaengert
			-- die Wiedergabe also nicht.
			local collapseSeconds = math.min(
				MapConfig.FIGHT_COLLAPSE_SECONDS,
				MapConfig.FIGHT_LINGER_SECONDS
			)

			if loser and loser.Parent ~= nil then
				FigureFX.defeatCollapse(loser, collapseSeconds)
				task.wait(math.max(0, MapConfig.FIGHT_LINGER_SECONDS - collapseSeconds))
			else
				task.wait(MapConfig.FIGHT_LINGER_SECONDS)
			end

			if not stillValid(player, token, figure, fighters) then return end

			-- Ueberlebt (hpAfter > 0): der Baerchi laeuft selbststaendig zu
			-- seinem Platz zurueck. Erschoepft (hpAfter <= 0): er ist ausser
			-- Gefecht und steht einfach wieder normal auf dem Plot — die
			-- anschliessende restoreHome() setzt ihn dafuer direkt zurueck,
			-- ganz ohne Lauf-Animation.
			if finalRun.hpAfter > 0 then
				setPhase(player, token, "Returning", nil)

				-- Vor dem eigenen PivotTo abmelden: sonst zoegen Idle-Loop und
				-- Lauf-Animation im selben Frame an derselben Figur. Wieder
				-- angemeldet wird sie am Ende von restoreHome, auf ihrem Platz.
				FigureFX.stopIdle(figure)

				-- v12: erst mit dem Turm wieder nach unten fahren — sonst liefe
				-- er auf Turmhoehe durch die Luft nach Hause.
				if towerNow > 0 then
					clearFighters(player)
					if not rideTower(player, token, figure, fighters, towerNow, 0, MapConfig.PIT_TOWER_FALL_SECONDS, selfPos, enemyPos) then
						return
					end
					finalSelfPos = selfPos
				end

				FigureWalker.walk(figure, finalSelfPos, homeFoot, {
					speed       = arenaWalkSpeed(),
					bobPerStud  = arenaBobPerStud(),
					isCancelled = function() return not stillValid(player, token, figure, fighters) end,
				})
			end
		end)

		if not ok then
			warn("[PitArenaService] Wiedergabe fehlgeschlagen:", err)
		end

		-- Fallback: ist die Schleife oben aus irgendeinem Grund abgebrochen
		-- oder auf einen Fehler gelaufen, BEVOR der Baerchi angekommen ist,
		-- haette der Client sonst nie ein Ergebnis bekommen. sendResult ist
		-- idempotent — war es schon raus, passiert hier nichts mehr.
		sendResult(player, token)

		-- Nur aufraeumen wenn diese Wiedergabe noch die aktuelle ist —
		-- sonst wuerde man einem bereits gestarteten neuen Lauf die Figur
		-- unter den Fuessen wegziehen.
		if _runToken[player] == token then
			restoreHome(player)
			clearFighters(player)
			MapService.setPitTowerLevel(player, 0)
			MapService.clearPitBanner(player)
			refreshState(player)
			ActivityLock.release(player, LOCK_HOLDER)
			if _active[player] and _active[player].token == token then
				_active[player] = nil
			end
		end
	end)
end

-- Laeuft fuer diesen Spieler gerade eine Wiedergabe (Hinlauf, Stages,
-- Nachlauf oder Ruecklauf)? CombatService fragt das VOR einem neuen
-- RequestStartCombat ab: der Cooldown auf diesem Remote (1s,
-- NetworkConfig) ist kuerzer als eine volle Wiedergabe — ohne diese Sperre
-- koennte ein zweiter Lauf mitten in den ersten hineinstarten und ihm die
-- Figur unter den Fuessen wegziehen.
--
-- _home ist dafuer das richtige Signal: es wird exakt fuer die Dauer einer
-- Wiedergabe gesetzt (startPlayback) und von restoreHome() wieder geleert,
-- egal ob sie normal zu Ende lief oder abgebrochen wurde.
-- HBB Paket 6: alle laufenden Laeufe fuer das Live-Kampf-Board (nur lesen).
function PitArenaService.liveRuns(): { { name: string, towerId: string?, stage: number?, phase: string } }
	local list = {}
	for player, active in _active do
		table.insert(list, {
			name    = player.DisplayName,
			towerId = active.run.towerId,
			stage   = active.stage,
			phase   = active.phase,
		})
	end
	return list
end

function PitArenaService.isRunning(player: Player): boolean
	return _home[player] ~= nil
end

-- Spielt einen fertig ausgerechneten Lauf ab. Kehrt sofort zurueck — die
-- eigentliche Wiedergabe laeuft nebenher.
--
-- Wirft NIE. Der Aufrufer (CombatService) steht mitten in der Abrechnung
-- eines Laufs: ein Fehler in dieser reinen Darstellung darf ihn nicht daran
-- hindern, die Daten zu speichern und den Client zu synchronisieren. Und er
-- darf vor allem keine Figur mit gesetztem "InArena" zuruecklassen — die
-- waere fuer den Rest der Sitzung von jeder Zustands-Aktualisierung
-- ausgenommen.
-- v15: `beats` = die Zuege je Stage (Index wie run.stages). Fehlen sie, wird
-- jede Stage als ein einziger Stoss gezeigt.
function PitArenaService.play(player: Player, run: Types.PitRunResult, settle: SettleFn?, beats: { { Types.FightBeat } }?)
	local ok, err = pcall(startPlayback, player, run, settle, beats)
	if ok then return end

	warn("[PitArenaService] Wiedergabe konnte nicht starten:", err)

	-- Aufraeumen was der abgebrochene Start schon angefasst haben koennte.
	-- Das ist nur deshalb gefahrlos, weil startPlayback den Token als ALLERSTES
	-- hochzaehlt: es gibt an dieser Stelle keine fremde Wiedergabe mehr, der
	-- man etwas wegraeumen koennte.
	--
	-- sendResult zuerst: schlug startPlayback ab, noch bevor es das Ergebnis
	-- verschicken konnte, bekaeme der Client sonst nie eins. _runToken[player]
	-- ist an dieser Stelle bereits der Token DIESES Versuchs — startPlayback
	-- setzt ihn als allerersten Schritt, bevor irgendetwas werfen kann.
	sendResult(player, _runToken[player] or 0)
	restoreHome(player)
	clearFighters(player)
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)
	refreshState(player)
	ActivityLock.release(player, LOCK_HOLDER)
	_active[player] = nil
end

-- v12: Spieler holt den Baerchi zurueck (Pet-Leiste). Auf dem Hinweg kehrt
-- er sofort um; im Kampf endet der Lauf nach der laufenden Stage. Auf dem
-- Rueckweg ist nichts mehr zu tun. true = Anfrage angenommen.
function PitArenaService.requestRecall(player: Player): boolean
	local active = _active[player]
	if not active or active.phase == "Returning" then
		return false
	end
	active.recall = true
	return true
end

-- v12: Phase des laufenden Laufs fuer die Pet-Leiste: "ToPit", "InPit",
-- "Returning" oder nil (kein Lauf). Dazu die laufende Stage (nur im Kampf).
function PitArenaService.getPhase(player: Player): (string?, number?)
	local active = _active[player]
	if not active or _home[player] == nil then
		return nil, nil
	end
	return active.phase, active.stage
end

-- v12: Ist dieser Baerchi gerade in einem noch nicht abgerechneten Lauf?
-- HoneyService lehnt Fuettern dann ab — die Abrechnung setzt die HP am Ende
-- auf den Wert nach der letzten Stage und wuerde eine Heilung dazwischen
-- ueberschreiben.
function PitArenaService.isFighting(player: Player, baerchiUid: string): boolean
	local active = _active[player]
	return active ~= nil and active.settled == nil and active.run.baerchiUid == baerchiUid
end

function PitArenaService.init()
	-- Verlaesst ein Spieler den Server mitten in der Wiedergabe, macht der
	-- Token-Vergleich die laufende Schleife ungueltig. Sein Plot wird ohnehin
	-- despawnt, aufraeumen muss hier nichts mehr.
	Players.PlayerRemoving:Connect(function(player)
		_runToken[player] = nil
		_home[player]     = nil
		_active[player]   = nil
	end)

	-- v12: geht der Spieler mitten im Lauf, wird VOR dem Speichern
	-- abgerechnet — so, als waere die gerade begonnene Stage zu Ende gespielt.
	PlayerService.onPlayerLeaving(function(player)
		local active = _active[player]
		if active then
			settleActive(active, active.entered, active.recall)
		end
	end)

	print("[PitArenaService] Initialisiert")
end

return PitArenaService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX58"><Properties>
<string name="Name">PlayerService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PlayerService.luau
-- ServerScriptService/Services/PlayerService.luau
--
-- Einzige Zustaendigkeit:
--   - Spielerdaten laden (DataStore) und im Speicher halten
--   - Spielerdaten speichern (beim Leave und periodisch)
--   - Insel spawnen/despawnen via MapService
--   - Anderen Services Zugriff auf PlayerData geben
--
-- Kein anderer Service beruehrt den DataStore. Geschrieben wird mit
-- UpdateAsync und einer Sitzungs-Sperre im Spielstand (Util/SessionLock),
-- damit zwei Server nie gegenseitig ihren Fortschritt ueberschreiben. Die
-- Migration alter Spielstaende steht in Util/PlayerMigration.
--
-- Hinweis zu onDataLoaded():
--   PlayerService darf EconomyService NICHT requiren (EconomyService requiret
--   PlayerService — das waere ein Zirkel). Services die beim Join etwas
--   gutschreiben wollen (z.B. HoneyService fuer den Offline-Honig) registrieren
--   deshalb hier einen Callback statt selbst an PlayerAdded zu haengen —
--   nur so ist garantiert dass die Daten zum Zeitpunkt des Callbacks geladen sind.

local Players       = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local QuestProgress   = require(ReplicatedStorage.Modules.QuestProgress)
local ShopRules     = require(ReplicatedStorage.Modules.ShopRules)
local ShopConfig    = require(ReplicatedStorage.Config.ShopConfig)
local MapService      = require(ServerScriptService.Services.MapService)
local RateLimiter     = require(ServerScriptService.Util.RateLimiter)
local PlayerMigration = require(ServerScriptService.Util.PlayerMigration)
local SessionLock     = require(ServerScriptService.Util.SessionLock)

--------------------------------------------------------------------------------
-- Konstanten
--------------------------------------------------------------------------------

local DATA_STORE_NAME = "PlayerData_v1"
-- v1 im Namen: wenn wir das Schema brechen, wird es v2 und alte Daten
-- werden nicht mehr geladen (sauberer als Migration fuer early dev).
-- Nicht-brechende Feld-Ergaenzungen laufen ueber
-- PlayerMigration.applyDefaults().

-- Spaetestens nach so vielen Sekunden wird auf jeden Fall gespeichert.
local SAVE_INTERVAL = 60

-- Fruehestens nach so vielen Sekunden darf derselbe Schluessel wieder
-- geschrieben werden. Roblox drosselt Schreibvorgaenge auf denselben
-- Schluessel unterhalb von etwa sechs Sekunden und verwirft sie irgendwann
-- ganz. saveNow() wird von vielen Stellen aufgerufen (Ei oeffnen,
-- fusionieren, verwerten, kaempfen, zwei Upgrades, Rebirth) — ohne diese
-- Bremse kaeme ein normal spielender Mensch auf mehrere Schreibvorgaenge
-- pro Sekunde.
local MIN_SAVE_GAP = 7

-- Wie oft nachgesehen wird ob jemand faellig ist.
local SAVE_TICK = 5

--------------------------------------------------------------------------------
-- DataStore-Zugriff
--
-- GetDataStore() wirft in einem unveroeffentlichten Place ("You must publish
-- this place to the web to access DataStore") und in Studio ohne aktivierte
-- API-Services. Frueher stand der Aufruf auf Modulebene — ein Fehler dort hat
-- PlayerService, EconomyService und damit den ganzen GameManager mitgerissen.
--
-- Deshalb: verzoegert holen, in pcall, und bei Nichtverfuegbarkeit auf einen
-- reinen Sitzungs-Speicher zurueckfallen. Das Spiel bleibt in Studio komplett
-- testbar (inklusive Leave/Rejoin und Offline-Ertrag), nur ueberlebt der
-- Fortschritt keinen Server-Neustart. Im veroeffentlichten Place greift
-- automatisch der echte DataStore.
--------------------------------------------------------------------------------

local _dataStore: DataStore? = nil
local _dataStoreChecked = false

-- Fallback wenn kein DataStore verfuegbar ist, key = "player_<UserId>"
local _sessionStore: { [string]: Types.PlayerData } = {}

local function getDataStore(): DataStore?
	if _dataStoreChecked then
		return _dataStore
	end
	_dataStoreChecked = true

	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(DATA_STORE_NAME)
	end)

	if ok then
		_dataStore = result
	else
		warn(
			"[PlayerService] DataStore nicht verfuegbar —",
			"Fortschritt wird nur fuer diese Server-Sitzung gehalten.",
			"Grund:", result
		)
	end

	return _dataStore
end

local function storageKey(player: Player): string
	return "player_" .. player.UserId
end

--------------------------------------------------------------------------------
-- Interner Zustand
-- Nur dieser Service liest/schreibt diese Tabelle.
--------------------------------------------------------------------------------

-- Alle geladenen Spielerdaten im Speicher, key = Player
local _playerData: { [Player]: Types.PlayerData } = {}

-- Timestamp des letzten Saves pro Spieler
local _lastSave: { [Player]: number } = {}

-- Spieler die gerade geladen werden (verhindert Doppel-Joins)
local _loading: { [Player]: boolean } = {}

-- Spieler deren Spielstand NICHT geladen werden konnte. Ihre Sitzung ist
-- spielbar, wird aber nie gespeichert — sonst wuerden die frischen
-- Standardwerte den echten Spielstand ueberschreiben.
local _noSave: { [Player]: boolean } = {}

-- Spieler die gespeichert werden wollen, aber gerade in der Schonfrist
-- stecken (siehe MIN_SAVE_GAP). Die Auto-Save-Schleife holt sie nach.
local _pendingSave: { [Player]: boolean } = {}

-- Callbacks anderer Services, ausgefuehrt direkt nach dem Laden
local _onDataLoaded: { (Player, Types.PlayerData) -> () } = {}

-- Callbacks anderer Services, ausgefuehrt nach allen _onDataLoaded
local _onPlayerReady: { (Player, Types.PlayerData) -> () } = {}

-- Callbacks anderer Services, ausgefuehrt bei jedem markDirty
local _onDataChanged: { (Player, Types.PlayerData) -> () } = {}

-- v12: Callbacks, die beim Verlassen (und beim Server-Shutdown) laufen,
-- BEVOR gespeichert wird. Grund: ein PIT-Lauf wird erst am Ende seiner
-- Wiedergabe abgerechnet (PitArenaService). Verlaesst der Spieler mitten im
-- Lauf, muss die Abrechnung noch in den Spielstand, bevor er geschrieben
-- wird — die Reihenfolge zweier PlayerRemoving-Verbindungen ist dafuer
-- nicht verlaesslich genug.
local _onPlayerLeaving: { (Player, Types.PlayerData) -> () } = {}

local function runLeavingCallbacks(player: Player, data: Types.PlayerData)
	for _, callback in _onPlayerLeaving do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[PlayerService] onPlayerLeaving-Callback fehlgeschlagen:", err)
		end
	end
end

--------------------------------------------------------------------------------
-- Hilfsfunktionen (privat)
--------------------------------------------------------------------------------

-- Wie oft das Laden bei einem DataStore-Fehler erneut versucht wird, und wie
-- lange dazwischen gewartet wird (verdoppelt sich jedes Mal).
local LOAD_RETRIES     = 3
local LOAD_RETRY_DELAY = 2

-- Haelt ein anderer Server den Spielstand noch (siehe Util/SessionLock), wird
-- so oft im Abstand von SESSION_WAIT_SECONDS erneut gefragt. Der Normalfall
-- ist ein schneller Serverwechsel: der alte Server schreibt beim Verlassen und
-- gibt die Sperre dabei frei, das dauert Sekunden. Insgesamt 30 Sekunden
-- reichen dafuer und sind kurz genug, dass der Spieler nicht ewig wartet.
local SESSION_WAIT_ATTEMPTS = 5
local SESSION_WAIT_SECONDS  = 6

-- In Studio ist game.JobId leer. Alle Studio-Sitzungen gelten dann als
-- derselbe Server, sonst sperrte man sich beim Neustart einer Testsitzung
-- selbst aus.
local function currentJobId(): string
	return if game.JobId ~= "" then game.JobId else "studio"
end

-- Ein Ladeversuch: liest den Spielstand und traegt im SELBEN Schreibvorgang
-- diesen Server als Halter ein (UpdateAsync ist dafuer atomar). Ergebnis:
--   "ok"     data ist der rohe Spielstand (isNew = frisch angelegt)
--   "locked" ein anderer Server haelt ihn, es wurde nichts geschrieben
--   "error"  der DataStore hat geworfen, data ist die Fehlermeldung
local function tryLoadAndClaim(store: DataStore, key: string): (string, any, boolean)
	local jobId = currentJobId()
	local outcome = "ok"
	local loaded: any = nil
	local isNew = false

	local success, err = pcall(function()
		store:UpdateAsync(key, function(old: any)
			-- Roblox kann diesen Rueckruf mehrfach aufrufen (Konflikt beim
			-- Schreiben). Deshalb setzt jeder Durchlauf alle Ergebnisse neu.
			local now = os.time()
			if old ~= nil and SessionLock.isHeldByOther(old.session, jobId, now) then
				outcome, loaded, isNew = "locked", nil, false
				return nil   -- nil = nichts schreiben
			end

			local data = if old ~= nil then old else Types.createDefaultPlayerData()
			data.session = SessionLock.claim(jobId, now)
			outcome, loaded, isNew = "ok", data, old == nil
			return data
		end)
	end)

	if not success then
		return "error", err, false
	end
	return outcome, loaded, isNew
end

-- Liefert (Spielstand, darf gespeichert werden).
local function loadFromDataStore(player: Player): (Types.PlayerData, boolean)
	local key   = storageKey(player)
	local store = getDataStore()

	-- Kein DataStore (unveroeffentlichter Place / Studio ohne API-Services):
	-- aus dem Sitzungs-Speicher lesen, damit Leave/Rejoin trotzdem testbar ist.
	if not store then
		local cached = _sessionStore[key]
		if cached then
			return PlayerMigration.applyDefaults(cached), true
		end
		return Types.createDefaultPlayerData(), true
	end

	-- Mehrfach versuchen: ein einzelner DataStore-Aussetzer (Drosselung,
	-- Roblox-Stoerung) ist haeufig und geht meist beim zweiten Versuch durch.
	-- Fehler und fremde Sperre werden getrennt gezaehlt, weil sie verschieden
	-- lange brauchen, um sich aufzuloesen.
	local lastError: any = nil
	local errors = 0
	local waits  = 0

	while true do
		local outcome, result, isNew = tryLoadAndClaim(store, key)

		if outcome == "ok" then
			-- Ein frischer Spielstand ist schon aktuell; nur alte Staende
			-- laufen durch die Migration.
			if isNew then
				return result, true
			end
			return PlayerMigration.applyDefaults(result), true
		end

		if outcome == "locked" then
			waits += 1
			if waits >= SESSION_WAIT_ATTEMPTS then
				-- Der andere Server meldet sich weiter. Ihn zu ueberschreiben
				-- hiesse, seinen Fortschritt zu loeschen. Also dieselbe
				-- Behandlung wie ein Lesefehler: spielbar, aber nie gespeichert.
				warn(
					"[PlayerService] Spielstand von", player.Name,
					"wird noch von einem anderen Server gehalten — Sitzung laeuft OHNE Speichern weiter."
				)
				return Types.createDefaultPlayerData(), false
			end
			task.wait(SESSION_WAIT_SECONDS)
		else
			errors += 1
			lastError = result
			if errors >= LOAD_RETRIES then
				break
			end
			task.wait(LOAD_RETRY_DELAY * errors)
		end

		-- Wer waehrend des Wartens geht, braucht keinen Spielstand mehr.
		if player.Parent == nil then
			return Types.createDefaultPlayerData(), false
		end
	end

	-- Auch nach allen Versuchen kein Erfolg. Der Spieler bekommt eine
	-- spielbare Sitzung, aber sie DARF NICHT GESPEICHERT werden:
	-- sonst wuerde der Auto-Save die frischen Standardwerte ueber einen
	-- vollkommen intakten Spielstand schreiben und ihn dauerhaft loeschen.
	warn(
		"[PlayerService] Laden endgueltig fehlgeschlagen fuer", player.Name,
		"— Sitzung laeuft OHNE Speichern weiter. Grund:", lastError
	)
	return Types.createDefaultPlayerData(), false
end

-- Schreibt den Spielstand. release = true beim Verlassen und beim Shutdown:
-- dann wird die Sitzungs-Sperre freigegeben, damit der naechste Server sofort
-- laden kann, statt auf ihren Ablauf zu warten.
local function saveToDataStore(player: Player, data: Types.PlayerData, release: boolean): boolean
	-- Konnte der Spielstand nicht geladen werden, wird auch nicht gespeichert.
	-- Siehe loadFromDataStore: sonst ueberschreibt eine Standard-Datei den
	-- echten Spielstand.
	if _noSave[player] then
		return false
	end

	-- Zeitstempel VOR dem Schreiben setzen. UpdateAsync haelt den Thread an;
	-- stuende die Zeile darunter, wuerde die Auto-Save-Schleife waehrend des
	-- Wartens immer wieder dieselbe Bedingung erfuellen und dutzende
	-- gleichzeitige Schreibvorgaenge auf denselben Schluessel ausloesen.
	_lastSave[player] = os.time()
	data.lastSeenAt   = os.time()

	local key   = storageKey(player)
	local store = getDataStore()

	if not store then
		_sessionStore[key] = data
		return true
	end

	-- UpdateAsync statt SetAsync: es liest den gespeicherten Stand, bevor es
	-- schreibt. Hat inzwischen ein anderer Server die Sperre uebernommen (weil
	-- unsere abgelaufen ist), wird NICHT geschrieben — dessen Stand ist neuer.
	local jobId = currentJobId()
	local lostLock = false

	local success, err = pcall(function()
		store:UpdateAsync(key, function(old: any)
			local now = os.time()
			if old ~= nil and SessionLock.isHeldByOther(old.session, jobId, now) then
				lostLock = true
				return nil
			end
			lostLock = false
			data.session = if release then nil else SessionLock.claim(jobId, now)
			return data
		end)
	end)

	if not success then
		warn("[PlayerService] DataStore-Fehler beim Speichern fuer", player.Name, ":", err)
	elseif lostLock then
		-- Ab jetzt gilt der andere Server. Diese Sitzung schreibt nie wieder,
		-- sonst wechselten sich zwei Staende gegenseitig ab.
		_noSave[player] = true
		warn(
			"[PlayerService] Sitzungs-Sperre von", player.Name,
			"liegt bei einem anderen Server — diese Sitzung speichert nicht mehr."
		)
	end

	-- HBB Paket 10: Rueckmeldung fuer Robux-Kaeufe (ShopService.processReceipt)
	return success and not lostLock
end

-- v15: wer die Login-Bonus-Sicht baut (LoginBonusService haengt sich ein —
-- dort liegt der Debug-Zeitversatz; ein require waere ein Ringschluss).
local _dailyViewProvider: ((Types.PlayerData) -> Types.DailyView)? = nil

local function dailyView(data: Types.PlayerData): Types.DailyView
	local provider = _dailyViewProvider
	if provider then
		local ok, view = pcall(provider, data)
		if ok then return view end
	end
	return { day = 1, claimable = false, streak = 0, resetIn = 0 }
end

-- Baut das Client-Paket aus den Serverdaten.
-- Stats bleiben bewusst draussen (kein Leak sensibler Serverdaten).
-- HBB Paket 10: Sicht fuer das Shop-Fenster
local function shopView(data: Types.PlayerData): Types.ShopView?
	local shop = (data :: any).shop
	if not shop then return nil end
	local now = os.time()
	return {
		freeReady  = ShopRules.freeReady(shop, now),
		nextFreeIn = ShopRules.secondsUntilNextDay(now),
		freeGold   = ShopConfig.FREE_GRAB_GOLD,
	}
end

local function buildUpdate(data: Types.PlayerData): Types.PlayerDataUpdate
	return {
		gummies      = data.gummies,
		goldGummies  = data.goldGummies,
		rebirthCount = data.rebirthCount,
		rebirthMult  = data.rebirthMult,
		rank         = data.rank,
		language     = data.language,
		island       = data.island,
		discovered   = data.discovered,
		quests       = QuestProgress.buildView(data, os.time()),
		eggTree      = data.eggTree,
		towers       = data.towers,
		daily        = dailyView(data),
		-- HBB Paket 2: Zaehler und Konto-Alter fuer Fuehrung/Freischaltung
		stats        = data.stats :: any,
		createdAt    = data.createdAt,
		uiSeen       = data.uiSeen,   -- HBB Paket 3
		shop         = shopView(data),  -- HBB Paket 10
	}
end

-- Sendet den aktuellen Spielerzustand an den Client
-- Wird nach jeder relevanten Aenderung aufgerufen
local function syncToClient(player: Player)
	local data = _playerData[player]
	if not data then return end

	Remotes.PlayerDataUpdated:FireClient(player, buildUpdate(data))
end

--------------------------------------------------------------------------------
-- Oeffentliche API
-- Andere Services rufen diese Funktionen auf.
--------------------------------------------------------------------------------

local PlayerService = {}

-- Gibt PlayerData zurueck — nil wenn noch nicht geladen
function PlayerService.getData(player: Player): Types.PlayerData?
	return _playerData[player]
end

-- Gibt PlayerData zurueck und wirft einen Fehler wenn nicht vorhanden
-- Fuer Services die sicher sind dass der Spieler eingeloggt ist
function PlayerService.getDataOrError(player: Player): Types.PlayerData
	local data = _playerData[player]
	assert(data, "[PlayerService] Keine Daten fuer Spieler: " .. player.Name)
	return data
end

-- Wird von anderen Services aufgerufen nachdem sie Daten veraendert haben.
-- Loest Client-Sync aus. Services aendern Daten direkt auf dem Objekt,
-- rufen dann markDirty() — kein Kopieren, kein Callback-Hell.
function PlayerService.markDirty(player: Player)
	syncToClient(player)

	local data = _playerData[player]
	if not data then return end

	-- Beobachter benachrichtigen (z.B. PlotDisplayService, das die Figuren und
	-- Schilder auf der Insel nachzieht). Ein Callback darf hier NICHT selbst
	-- markDirty aufrufen — das waere eine Endlosschleife.
	for _, callback in _onDataChanged do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[PlayerService] onDataChanged-Callback fehlgeschlagen:", err)
		end
	end
end

-- Nach einer wichtigen Aenderung speichern (Kauf, Kampf, Rebirth).
--
-- "Sofort" nur wenn die Schonfrist abgelaufen ist — sonst wird es lediglich
-- vorgemerkt und die Auto-Save-Schleife holt es nach, sobald sie darf. Ohne
-- das wuerde Roblox die Schreibvorgaenge irgendwann verwerfen, und dann waere
-- ausgerechnet der Fortschritt weg, den dieser Aufruf sichern sollte.
--
-- Der Leave- und der Shutdown-Weg gehen bewusst direkt auf saveToDataStore
-- und umgehen die Bremse: dort gibt es kein spaeter mehr.
function PlayerService.saveNow(player: Player)
	local data = _playerData[player]
	if not data then return end

	if os.time() - (_lastSave[player] or 0) >= MIN_SAVE_GAP then
		saveToDataStore(player, data, false)
	else
		_pendingSave[player] = true
	end
end

-- HBB Paket 10: SOFORT speichern und melden, ob es geklappt hat. Nur fuer
-- Robux-Kaeufe: Roblox verlangt, dass ein Kauf gespeichert ist, bevor
-- ProcessReceipt "gewaehrt" meldet. Umgeht bewusst MIN_SAVE_GAP (Kaeufe sind
-- selten). Blockiert, bis UpdateAsync fertig ist.
function PlayerService.saveConfirmed(player: Player): boolean
	local data = _playerData[player]
	if not data then return false end
	_pendingSave[player] = nil
	return saveToDataStore(player, data, false)
end

-- v15: LoginBonusService haengt hier ein, wie die Login-Bonus-Sicht im
-- Client-Paket gebaut wird.
function PlayerService.setDailyViewProvider(provider: (Types.PlayerData) -> Types.DailyView)
	_dailyViewProvider = provider
end

-- Frische Standard-Insel. Einzige erlaubte Quelle fuer einen Insel-Reset —
-- RebirthService benutzt dies statt Types.createDefaultPlayerData selbst
-- aufzurufen (Regel: nur PlayerService ruft die Default-Fabrik auf).
function PlayerService.buildDefaultIsland(): Types.IslandData
	return Types.createDefaultPlayerData().island
end

-- HBB Paket 0: kompletter Startstand fuer den Debug-Zustand "fresh"
-- (DebugService). Aus demselben Grund wie oben hier und nicht dort.
function PlayerService.buildDefaultData(): Types.PlayerData
	return Types.createDefaultPlayerData()
end

-- Registriert einen Callback der laeuft sobald die Daten eines Spielers
-- geladen und seine Insel gespawnt ist — aber bevor der erste Client-Sync
-- rausgeht. Hier gehoert alles hin, was die Daten beim Join noch aendert
-- (Offline-Honig, Offline-Eier, Ausruesten). Aus init() aufrufen: Spieler
-- werden erst in start() geladen, also verpasst kein Callback einen Join.
--
-- Die Callbacks laufen in Anmelde-Reihenfolge. Keiner darf sich auf einen
-- anderen verlassen; wer den fertigen Stand braucht, nimmt onPlayerReady.
function PlayerService.onDataLoaded(callback: (Player, Types.PlayerData) -> ())
	table.insert(_onDataLoaded, callback)
end

-- Registriert einen Callback der nach ALLEN onDataLoaded-Callbacks laeuft,
-- direkt vor dem ersten Client-Sync. Fuer alles, was den fertig geladenen
-- Stand nur anzeigt (Schilder, gelegte Eier in der Welt). Darf die Daten
-- nicht mehr aendern.
function PlayerService.onPlayerReady(callback: (Player, Types.PlayerData) -> ())
	table.insert(_onPlayerReady, callback)
end

-- Registriert einen Callback der bei JEDER Datenaenderung laeuft (markDirty).
-- Wird oft aufgerufen — der Callback muss selbst entscheiden ob er wirklich
-- etwas tun muss, und darf nicht seinerseits markDirty aufrufen.
function PlayerService.onDataChanged(callback: (Player, Types.PlayerData) -> ())
	table.insert(_onDataChanged, callback)
end

-- v12: Callback, der beim Verlassen VOR dem Speichern laeuft (siehe
-- _onPlayerLeaving). Darf Daten aendern, aber nicht yielden.
function PlayerService.onPlayerLeaving(callback: (Player, Types.PlayerData) -> ())
	table.insert(_onPlayerLeaving, callback)
end

--------------------------------------------------------------------------------
-- Join / Leave
--------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	if _loading[player] then return end
	_loading[player] = true

	-- Daten laden (kann einen Moment dauern).
	--
	-- Zusaetzlich in pcall: die Migration (PlayerMigration) rechnet fuer alte
	-- Spielstaende echte Kampfwerte aus. Ein einzelner kaputter Eintrag darf
	-- den Join nicht mittendrin abbrechen — sonst bliebe _loading fuer immer
	-- gesetzt, der Spieler haette nie Daten und jedes Remote liefe still ins
	-- Leere, ohne dass irgendwo ein Fehler sichtbar waere.
	local ok, data, canSave = pcall(loadFromDataStore, player)

	if not ok then
		warn("[PlayerService] Spielstand von", player.Name, "ist beschaedigt:", data)
		data    = Types.createDefaultPlayerData()
		canSave = false   -- niemals ueber einen Stand schreiben den wir nicht lesen konnten
	end

	-- Spieler kann waehrend des Ladens schon wieder weg sein
	if player.Parent == nil then
		_loading[player] = nil
		return
	end

	if not canSave then
		_noSave[player] = true
	end

	_playerData[player] = data
	_lastSave[player]   = os.time()
	_loading[player]    = nil

	-- Insel spawnen — setzt dabei auch player.RespawnLocation auf die eigene
	-- Insel (siehe MapService.buildPlotBase).
	MapService.spawnIsland(player, data.island)

	-- Erst JETZT den Charakter laden: Players.CharacterAutoLoads steht in
	-- GameManager auf false, genau damit kein Spieler zwischen Join und
	-- geladenen Daten kurz in der Weltmitte auftaucht. RespawnLocation ist ab
	-- hier gesetzt (oder, falls der Server keinen freien Plot mehr hatte,
	-- eben nicht — dann faellt LoadCharacter auf den Not-Spawn zurueck, siehe
	-- MapService.buildPlatform).
	player:LoadCharacter()

	-- Andere Services informieren (Offline-Progress etc.)
	-- pcall: ein fehlerhafter Callback darf den Join nicht abbrechen.
	for _, callback in _onDataLoaded do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[PlayerService] onDataLoaded-Callback fehlgeschlagen:", err)
		end
	end

	-- HBB Paket 10: jede geladene Sitzung zaehlt (Shop ab der zweiten)
	data.stats.sessions = (data.stats.sessions or 0) + 1

	for _, callback in _onPlayerReady do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[PlayerService] onPlayerReady-Callback fehlgeschlagen:", err)
		end
	end

	-- Ersten Sync zum Client
	syncToClient(player)

	print("[PlayerService] Spieler geladen:", player.Name,
		"| Gummies:", data.gummies,
		"| Rebirths:", data.rebirthCount)
end

local function onPlayerRemoving(player: Player)
	local data = _playerData[player]
	if data then
		runLeavingCallbacks(player, data)
		saveToDataStore(player, data, true)
		MapService.despawnIsland(player)
	end

	_playerData[player]  = nil
	_lastSave[player]    = nil
	_loading[player]     = nil
	_noSave[player]      = nil
	_pendingSave[player] = nil

	print("[PlayerService] Spieler entfernt:", player.Name)
end

--------------------------------------------------------------------------------
-- Auto-Save Loop
--------------------------------------------------------------------------------

-- Bewusst eine eigene Schleife und nicht Heartbeat: ein Speicher-Timer hat
-- nichts an der Bildwiederholrate zu suchen. Vorher lief die Pruefung 60 mal
-- pro Sekunde und ein einzelner faelliger Spieler loeste dutzende parallele
-- Schreibvorgaenge aus, weil das Schreiben den Thread anhaelt.
local function startAutoSave()
	task.spawn(function()
		while true do
			task.wait(SAVE_TICK)

			local now = os.time()
			for player, data in _playerData do
				local since = now - (_lastSave[player] or 0)

				-- Zwei Gruende zu speichern: es liegt eine Vormerkung aus
				-- saveNow vor, oder es ist einfach lange genug her.
				local wanted = _pendingSave[player] or since >= SAVE_INTERVAL

				if wanted and since >= MIN_SAVE_GAP then
					_pendingSave[player] = nil

					local ok, err = pcall(saveToDataStore, player, data, false)
					if not ok then
						warn("[PlayerService] Auto-Save fehlgeschlagen fuer", player.Name, ":", err)
					end
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function PlayerService.init()
	-- Reconnect-Fall: Client fragt seinen Zustand aktiv an.
	-- Ohne diesen Handler blockiert ein GetPlayerData-Invoke ewig.
	RateLimiter.connectFunction(Remotes.GetPlayerData, "GetPlayerData", function(player: Player)
		local data = _playerData[player]
		if not data then
			-- Noch nicht fertig geladen — Client soll auf PlayerDataUpdated warten
			return nil
		end
		return buildUpdate(data)
	end)

	-- Sicherheitsnetz: beim Server-Shutdown alle speichern
	game:BindToClose(function()
		for player, data in _playerData do
			runLeavingCallbacks(player, data)
			saveToDataStore(player, data, true)
		end
	end)

	startAutoSave()

	-- Verfuegbarkeit einmal beim Start pruefen, damit die Warnung im Log steht
	-- bevor der erste Spieler joint — und nicht mitten in einem Join auftaucht.
	if getDataStore() then
		print("[PlayerService] Initialisiert | DataStore aktiv")
	else
		print("[PlayerService] Initialisiert | OHNE DataStore — nur Sitzungs-Speicher")
	end
end

-- Erst hier werden Spieler geladen: GameManager ruft start() nach ALLEN
-- init(). Damit hat jeder Service seine Callbacks angemeldet, bevor der erste
-- Join sie ausloest — egal, wo er in der Startliste steht.
function PlayerService.start()
	-- Bereits verbundene Spieler (in Studio-Play-Solo ist der Spieler oft
	-- schon da, bevor der Server mit dem Starten fertig ist)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
end

return PlayerService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX59"><Properties>
<string name="Name">PlotDisplayService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PlotDisplayService.luau
-- ServerScriptService/Services/PlotDisplayService.luau
--
-- Einzige Zustaendigkeit:
--   - Entscheiden WANN die sichtbare Darstellung eines Plots nachgezogen
--     werden muss — und mit welchem der drei unterschiedlich teuren Wege.
--
-- Haengt an PlayerService.onDataChanged. Das feuert bei JEDER Aenderung, also
-- auch bei jedem einzelnen Gummy. Alles jedes Mal neu zu bauen waere
-- Verschwendung, deshalb merkt sich dieser Service drei Signaturen und
-- vergleicht sie:
--
--   STRUKTUR   (uid + Level jedes Baerchis)
--       → MapService.updateBaerchis: baut alle Mesh-Figuren neu. Teuer.
--         Noetig wenn ein Baerchi dazukommt, wegfaellt oder im Level steigt.
--
--   ZUSTAND    (uid + aktuelle HP)
--       → MapService.updateBaerchiStates: schreibt nur Beschriftung und
--         Erschoepfung an bestehende Figuren. Billig. HP aendern sich bei
--         jedem Fuettern und jedem PIT-Lauf — dafuer 25 Meshes neu zu bauen
--         waere absurd.
--
--   GEBAEUDE   (id + Level + Honig)
--       → MapService.updateBuildingSigns: schreibt die Schilder neu. Billig.
--         Honig aendert sich alle 20 Sekunden.
--
--   EIER       (uids der herumliegenden Eier)
--       → MapService.updateLaidEggs: baut die kleinen Kugeln neu. Billig —
--         es sind hoechstens zwoelf, und sie sind keine Meshes.
--         Aendert sich, wenn der Baerchi eines legt oder der Spieler eines
--         aufsammelt.
--
--   RECYCLER   (Level + Warteschlange des Waben-Recyclers)
--       → MapService.updateRecycler: schreibt Schild und Lampe. Billig.
--         Aendert sich jede Sekunde, solange der Recycler arbeitet.
--
--   LOOKS      (v15: Look-Stufe jedes Gebaeudes und des Recyclers)
--       → MapService.updateBuildingLooks: baut genau das Gebaeude neu, dessen
--         Look sich geaendert hat, mit kurzer Aufwertungs-Show. Haengt am
--         LOOK, nicht am Level — ein Ausbau innerhalb eines Looks schreibt nur
--         das Schild (GEBAEUDE oben).
--
--   STUFE      (Welt aufwerten, Paket D: Insel-Stufe 1..4 aus Towern und
--               Rebirths, Modules/IslandStage)
--       → Attribut "IslandStage" am Player (ueberlebt jeden Insel-Neuaufbau).
--         Die Deko baut nur der Client (PlotLifeController), der Server baut
--         dafuer kein einziges Teil.
--
--   TOWER      (v15: Look + Etagen + Schildtext des Tower-Turms)
--       → MapService.updateTowerShowcase (Neuaufbau des Turms, Show nur beim
--         Look-Wechsel) und MapService.setOwnerBadge (Symbol am Plot-Schild).
--         Aendert sich nur bei einem neuen Rekord oder Tower.
--
-- Die Figuren und Schilder selbst baut MapService — dieser Service entscheidet
-- nur WANN und WELCHE Tiefe.
--
-- EINE SACHE ENTSCHEIDET DIESER SERVICE BEWUSST NICHT: ob die Figur gerade
-- mitten in einer Bewegung steckt. Diese Sperre sitzt in
-- MapService.updateBaerchis selbst, damit sie fuer JEDEN Aufrufer gilt und
-- nicht an jeder Aufrufstelle wiederholt werden muss. Hier unten wird nur die
-- Quelle fuer frische Daten eingehaengt, mit der MapService den verschobenen
-- Neuaufbau spaeter nachholt (siehe init).
--
-- Wichtig fuer das Verstaendnis des Signatur-Vergleichs: eine verschobene
-- Darstellung gilt hier trotzdem sofort als "dargestellt". Das ist richtig, so
-- lange MapService das Nachholen uebernimmt — waere es andersherum, muesste
-- dieser Service den Zustand einer fremden Warteschlange mitverfolgen.
--
-- Ersetzt den frueheren BaerchiDisplayService, der nur die Figuren kannte und
-- inzwischen aus dem Projekt entfernt ist.

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local IslandStage      = require(ReplicatedStorage.Modules.IslandStage)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)

local PlotDisplayService = {}

type Signatures = {
	structure : string,
	state     : string,
	buildings : string,
	eggs      : string,
	recycler  : string,
	looks     : string,
	tower     : string,
	stage     : string,
}

local _signatures: { [Player]: Signatures } = {}

--------------------------------------------------------------------------------
-- Signaturen
--------------------------------------------------------------------------------

-- Was sich aendern muss, damit die Figur neu gebaut wird: welche Baerchis es
-- gibt, auf welchem Level sie stehen (das Level aendert die Groesse der
-- Beschriftung und kann spaeter das Modell aendern) — UND wer gerade
-- ausgeruestet ist, seit nur noch dieser eine sichtbar gebaut wird. Ohne
-- equippedUid hier wuerde ein Equip-Wechsel auf einen gleich hochstufigen
-- Baerchi denselben String ergeben und die Signatur haelt die Aenderung
-- faelschlich fuer bereits dargestellt.
--
-- Die MUTATION gehoert aus demselben Grund dazu: sie bestimmt Fellfarbe, Aura
-- und das Kuerzel auf dem Namensschild (siehe MapService.buildBaerchiFigure).
-- Normalerweise aendert sie sich nie nach dem Schluepfen — der Mutations-Sturm
-- (EventParticipationService) kann sie aber mitten im Spiel anheben, und ohne
-- diesen Eintrag liefe die Figur bis zum naechsten Insel-Neuaufbau in der
-- alten Farbe weiter.
local function structureSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, string.format("%s:%d:%s:%s", uid, baerchi.level, baerchi.mutation or "-", baerchi.rarity))
	end
	table.sort(parts)
	table.insert(parts, "equipped:" .. (data.island.equippedUid or ""))
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Beschriftung neu geschrieben wird.
local function stateSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, uid .. ":" .. baerchi.currentHp)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Gebaeude-Schilder neu geschrieben werden.
local function buildingSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d:%d", id, building.level, building.honey or 0))
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Eier neu gebaut werden: WELCHE Eier
-- herumliegen. Die Position gehoert bewusst nicht dazu — ein gelegtes Ei
-- bewegt sich nie, es kommt nur dazu oder verschwindet.
local function eggSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for _, egg in data.island.laidEggs or {} do
		table.insert(parts, egg.uid)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit Schild und Lampe des Waben-Recyclers neu
-- geschrieben werden: Level und Warteschlange.
local function recyclerSignature(data: Types.PlayerData): string
	local recycler = data.island.recycler
	return string.format("%d:%d", recycler.level, recycler.queued)
end

-- v15: Look-Stufen. Bewusst NICHT das Level: ein Gebaeude wird nur neu
-- gebaut, wenn es einen neuen Look bekommt (README 4.2).
local function lookSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d", id, BuildingBehavior.getLook(building.level)))
	end
	table.sort(parts)
	table.insert(parts, "Recycler:" .. BuildingBehavior.getLook(data.island.recycler.level))
	return table.concat(parts, "|")
end

-- v15: Tower-Turm: hoechster Tower (Look) und Rekord darin (Etagen + Schild).
local function towerSignature(data: Types.PlayerData): string
	local towerId, record = TowerConfig.bestRecord(data.towers)
	local highest = data.towers.highestTower
	if TowerConfig.getIndex(highest) > TowerConfig.getIndex(towerId) then
		towerId, record = highest, data.towers.records[highest] or 0
	end
	return string.format("%s:%d", towerId, record)
end

-- Paket D: Stufe der Insel-Deko
local function stageSignature(data: Types.PlayerData): string
	return tostring(IslandStage.compute(data.towers and data.towers.records, data.rebirthCount or 0))
end

local function allSignatures(data: Types.PlayerData): Signatures
	return {
		structure = structureSignature(data),
		state     = stateSignature(data),
		buildings = buildingSignature(data),
		eggs      = eggSignature(data),
		recycler  = recyclerSignature(data),
		looks     = lookSignature(data),
		tower     = towerSignature(data),
		stage     = stageSignature(data),
	}
end

-- Turm und Plot-Symbol aus dem Tower-Stand (Signatur "Tower:Rekord").
local function applyTower(player: Player, signature: string, show: boolean)
	local towerId, recordText = string.match(signature, "^([^:]+):(%d+)$")
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	local record = tonumber(recordText) or 0

	MapService.updateTowerShowcase(player, {
		look   = def.look,
		floors = TowerConfig.getShowcaseFloors(def.id, record),
		title  = string.format("%s  ·  Tower %s  ·  %d", player.DisplayName, def.numeral, record),
		color  = def.color,
	}, show)
	MapService.setOwnerBadge(player, string.format("◆ Tower %s · %d", def.numeral, record), def.color)
end

--------------------------------------------------------------------------------
-- Abgleich
--------------------------------------------------------------------------------

local function refresh(player: Player, data: Types.PlayerData)
	local current  = allSignatures(data)
	local previous = _signatures[player]

	if not previous then
		-- Noch keine Signatur (sollte nach onDataLoaded nicht vorkommen):
		-- einmal komplett nachziehen und merken.
		_signatures[player] = current
		MapService.updateBaerchis(player, data.island)
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		return
	end

	if previous.structure ~= current.structure then
		-- Neuaufbau schreibt die Zustaende gleich mit — ein zusaetzliches
		-- updateBaerchiStates waere doppelte Arbeit.
		MapService.updateBaerchis(player, data.island)

	elseif previous.state ~= current.state then
		MapService.updateBaerchiStates(player, data.island)
	end

	if previous.buildings ~= current.buildings then
		MapService.updateBuildingSigns(player, data.island)
	end

	-- Bewusst UNABHAENGIG vom Struktur-Zweig oben: updateBaerchis baut die Eier
	-- zwar mit, kann aber wegen einer laufenden Bewegung verschoben worden sein
	-- (ActivityLock). Genau dann legt der Baerchi aber weiter — und ein frisch
	-- gelegtes Ei soll nicht darauf warten, dass er ankommt.
	if previous.eggs ~= current.eggs then
		MapService.updateLaidEggs(player, data.island)
	end

	if previous.recycler ~= current.recycler then
		MapService.updateRecycler(player, data.island)
	end

	-- v15: neuer Look -> genau dieses Gebaeude neu bauen (mit Show). Nach einem
	-- Rebirth faellt der Look zurueck; rebuildIsland hat die Insel dann schon
	-- komplett neu gebaut, updateBuildingLooks findet nichts mehr zu tun.
	if previous.looks ~= current.looks then
		MapService.updateBuildingLooks(player, data.island, true)
	end

	if previous.stage ~= current.stage then
		player:SetAttribute("IslandStage", tonumber(current.stage))
	end

	if previous.tower ~= current.tower then
		local oldTower = string.match(previous.tower, "^([^:]+):")
		local newTower = string.match(current.tower, "^([^:]+):")
		applyTower(player, current.tower, oldTower ~= newTower)
	end

	_signatures[player] = current
end

function PlotDisplayService.init()
	-- MapService darf PlayerService nicht requiren (PlayerService requiret
	-- bereits MapService — das waere ein Ringschluss). Deshalb bekommt es die
	-- Lesefunktion von hier: dieser Service kennt beide ohnehin schon.
	MapService.setIslandDataProvider(function(player: Player): Types.IslandData?
		local data = PlayerService.getData(player)
		return if data then data.island else nil
	end)

	PlayerService.onPlayerReady(function(player, data)
		-- Die Figuren und Schilder stehen zu diesem Zeitpunkt schon
		-- (MapService.spawnIsland laeuft beim Join davor), aber die Daten
		-- haben sich seitdem noch geaendert: die onDataLoaded-Callbacks haben
		-- Offline-Honig gutgeschrieben und offline gelegte Eier eingetragen.
		-- Die Schilder zeigten sonst bis zum naechsten Honig-Tick den Stand von
		-- vor der Gutschrift, und die Eier laegen nur in den Daten.
		--
		-- Deshalb einmal aktiv nachziehen — und ERST DANN die Signatur
		-- merken, sonst haelt der Vergleich unten den Unterschied faelschlich
		-- fuer bereits dargestellt.
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateBaerchiStates(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)

		local signatures = allSignatures(data)
		applyTower(player, signatures.tower, false)
		player:SetAttribute("IslandStage", tonumber(signatures.stage))

		_signatures[player] = signatures
	end)

	PlayerService.onDataChanged(refresh)

	Players.PlayerRemoving:Connect(function(player)
		_signatures[player] = nil
	end)

	print("[PlotDisplayService] Initialisiert")
end

return PlotDisplayService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX60"><Properties>
<string name="Name">QuestService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- QuestService.luau
-- ServerScriptService/Services/QuestService.luau
--
-- Einzige Zustaendigkeit:
--   - Quest-Belohnungen abholen lassen (Pruefung + Auszahlung)
--   - Den Tageswechsel der Tages-Quests durchfuehren
--   - Den Index fuehren: jede configId, die ein Spieler je besessen hat, in
--     data.discovered eintragen
--
-- Was dieser Service NICHT tut: Fortschritt mitzaehlen. Der wird jedes Mal aus
-- den Spielzaehlern berechnet (shared/Modules/QuestProgress) — kein anderer
-- Service muss Quests kennen. Der Fortschritt reist ueber PlayerDataUpdated
-- zum Client, dieser Service schickt nur die Belohnungs-Meldung.
--
-- Gummies zahlt ausschliesslich EconomyService aus (awardGummiesFlat: Quest-
-- Belohnungen sind fest und bekommen KEINEN Rebirth-Multiplikator, sonst
-- wuerden sie mit jedem Rebirth die Kette entwerten).

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types         = require(ReplicatedStorage.Network.Types)
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local QuestConfig   = require(ReplicatedStorage.Config.QuestConfig)
local QuestProgress = require(ReplicatedStorage.Modules.QuestProgress)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local QuestService = {}

-- Wie oft geprueft wird, ob fuer wartende Spieler der Tag gewechselt hat.
local DAY_CHECK_INTERVAL = 60

local function fail(player: Player, reason: Types.LocMsg)
	Remotes.ActionFailed:FireClient(player, "RequestClaimQuest", reason)
end

--------------------------------------------------------------------------------
-- Tageswechsel
--------------------------------------------------------------------------------

-- Setzt die Tages-Quests zurueck, wenn der UTC-Tag ein anderer ist. Gibt true
-- zurueck, wenn sich etwas geaendert hat.
local function ensureDay(data: Types.PlayerData): boolean
	local today = QuestConfig.dayOf(os.time())
	if data.quests.day == today then
		return false
	end

	data.quests.day          = today
	data.quests.baseline     = QuestProgress.snapshot(data)
	data.quests.dailyClaimed = {}
	return true
end

--------------------------------------------------------------------------------
-- Index
--------------------------------------------------------------------------------

-- Traegt neue configIds ein. Gibt true zurueck, wenn etwas dazukam.
local function updateDiscovered(data: Types.PlayerData): boolean
	local changed = false
	for _, baerchi in data.island.baerchis do
		if not data.discovered[baerchi.configId] then
			data.discovered[baerchi.configId] = true
			changed = true
		end
	end
	return changed
end

-- Laeuft bei JEDER Datenaenderung (siehe PlayerService.onDataChanged) und darf
-- dort nicht selbst markDirty aufrufen — deshalb der Aufschub mit task.defer.
-- Er konvergiert: der zweite Durchlauf findet nichts Neues mehr.
local function onDataChanged(player: Player, data: Types.PlayerData)
	local changed = updateDiscovered(data)
	if ensureDay(data) then changed = true end

	if changed then
		task.defer(function()
			if player.Parent and PlayerService.getData(player) == data then
				PlayerService.markDirty(player)
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- Belohnung abholen
--------------------------------------------------------------------------------

function QuestService.claim(player: Player, kind: any, questId: any)
	local data = PlayerService.getData(player)
	if not data then return end

	-- Alles, was vom Client kommt, ist unbekannt.
	if (kind ~= "chain" and kind ~= "daily") or typeof(questId) ~= "string" then
		return
	end

	ensureDay(data)

	local def = QuestConfig.getById(questId)
	if not def then
		fail(player, Loc.msg("err.quest_unknown"))
		return
	end

	local isDaily = kind == "daily"

	if isDaily then
		local isDailyDef = false
		for _, d in QuestConfig.DAILY do
			if d.id == questId then isDailyDef = true end
		end
		if not isDailyDef then
			fail(player, Loc.msg("err.quest_unknown"))
			return
		end
		if data.quests.dailyClaimed[questId] then
			fail(player, Loc.msg("err.quest_already_claimed"))
			return
		end
	else
		-- Kette: nur die aktuelle Quest darf abgeholt werden, nie eine spaetere.
		local current = QuestConfig.CHAIN[data.quests.chainClaimed + 1]
		if not current or current.id ~= questId then
			fail(player, Loc.msg("err.quest_not_current"))
			return
		end
	end

	if not QuestProgress.isComplete(def, data, isDaily) then
		fail(player, Loc.msg("err.quest_not_done"))
		return
	end

	-- Zuerst als abgeholt markieren, dann auszahlen: so kann ein zweiter,
	-- gleichzeitiger Aufruf nichts doppelt bekommen.
	if isDaily then
		data.quests.dailyClaimed[questId] = true
	else
		data.quests.chainClaimed += 1
	end

	local paid = EconomyService.awardGummiesFlat(player, def.reward.gummies)

	local eggType = def.reward.eggType
	if eggType then
		data.island.eggStock[eggType] = (data.island.eggStock[eggType] or 0) + 1
	end

	-- GOLD_CHARMS_ONLY: einzige GoldGummies-Quelle (ohne Flag 0)
	local gold = QuestConfig.goldReward(def)
	local goldPaid = if gold > 0 then EconomyService.awardGoldGummies(player, gold) else 0

	local reward: Types.QuestReward = {
		questId = questId,
		gummies = paid,
		eggType = eggType,
		goldGummies = if goldPaid > 0 then goldPaid else nil,
	}
	Remotes.QuestRewardReceived:FireClient(player, reward)

	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	print("[QuestService]", player.Name, "holt", questId, "ab | +", paid, "Gummies |", goldPaid, "Gold", eggType or "")
end

--------------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------------

function QuestService.init()
	-- Vor dem ersten Sync: Tag setzen, damit der Client sofort den richtigen
	-- Stand sieht.
	PlayerService.onDataLoaded(function(_player, data)
		ensureDay(data)
		updateDiscovered(data)
	end)

	PlayerService.onDataChanged(onDataChanged)

	RateLimiter.connect(Remotes.RequestClaimQuest, "RequestClaimQuest", function(player, kind: any, questId: any)
		QuestService.claim(player, kind, questId)
	end)

	-- Wer nur im Spiel steht und nichts tut, loest keine Datenaenderung aus —
	-- ohne diese Schleife wuerden seine Tages-Quests erst bei der naechsten
	-- Aktion zurueckgesetzt.
	task.spawn(function()
		while true do
			task.wait(DAY_CHECK_INTERVAL)
			for _, player in Players:GetPlayers() do
				local data = PlayerService.getData(player)
				if data and ensureDay(data) then
					PlayerService.markDirty(player)
				end
			end
		end
	end)

	print("[QuestService] Initialisiert")
end

return QuestService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX61"><Properties>
<string name="Name">ShopService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- ShopService.luau
-- ServerScriptService/Services/ShopService.luau
--
-- Einzige Zustaendigkeit:
--   - Der Shop (HBB Paket 10, FeatureFlags.SHOP_V1): Gratis-Griff einmal pro
--     UTC-Tag (RequestClaimFreeGrab) und Robux-Goldpakete (Developer Products,
--     MarketplaceService.ProcessReceipt).
--
-- Regeln stehen in Modules/ShopRules (getestet), Zahlen in Config/ShopConfig.
-- Gold zahlt nur EconomyService aus.
--
-- ============================================================
-- ROBUX-KAEUFE: GENAU EINMAL AUSZAHLEN
-- ============================================================
-- Roblox ruft ProcessReceipt auf, bis einmal PurchaseGranted zurueckkommt —
-- auch nach Server-Absturz, auf einem anderen Server. Deshalb:
--   1. Kauf-ID schon im Spielstand gemerkt -> sofort Granted (nicht doppelt).
--   2. Sonst merken + auszahlen + SOFORT speichern (PlayerService.saveConfirmed).
--   3. Speichern gescheitert -> beides zuruecknehmen und NotProcessedYet:
--      Roblox fragt spaeter erneut, dann sauber von vorn.
-- Spieler nicht (mehr) auf diesem Server oder Stand nicht geladen ->
-- NotProcessedYet (Roblox wiederholt beim naechsten Join).
-- Es darf im ganzen Spiel nur EINEN ProcessReceipt-Callback geben: diesen.

local Players             = game:GetService("Players")
local MarketplaceService  = game:GetService("MarketplaceService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Remotes      = require(ReplicatedStorage.Network.Remotes)
local Loc          = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local ShopConfig   = require(ReplicatedStorage.Config.ShopConfig)
local ShopRules    = require(ReplicatedStorage.Modules.ShopRules)
local UnlockRules  = require(ReplicatedStorage.Modules.UnlockRules)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local ShopService = {}

-- Kaeufe, die gerade verarbeitet werden (gegen gleichzeitige Doppelaufrufe)
local _inFlight: { [string]: boolean } = {}

local function fail(player: Player, key: string)
	Remotes.ActionFailed:FireClient(player, "RequestClaimFreeGrab", Loc.msg(key))
end

--------------------------------------------------------------------------------
-- Gratis-Griff
--------------------------------------------------------------------------------

local function claimFreeGrab(player: Player)
	local data = PlayerService.getData(player)
	if not data then return end

	if not ShopRules.claimFree(data.shop, os.time()) then
		fail(player, "err.shop_free_taken")
		return
	end

	local paid = EconomyService.awardGoldGummies(player, ShopConfig.FREE_GRAB_GOLD)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	print("[ShopService]", player.Name, "Gratis-Griff | +", paid, "Gold")
end

--------------------------------------------------------------------------------
-- Robux-Kaeufe
--------------------------------------------------------------------------------

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local purchaseId = tostring(info.PurchaseId)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = PlayerService.getData(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- 1. Schon ausgezahlt (Roblox meldet erneut) -> nur bestaetigen
	if ShopRules.hasReceipt(data.shop, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if _inFlight[purchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local product = ShopConfig.byProductId(info.ProductId)
	if not product then
		warn("[ShopService] Unbekannte Product-ID (ShopConfig pruefen):", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- 2. Merken, auszahlen, sofort speichern
	_inFlight[purchaseId] = true
	ShopRules.recordPurchase(data.shop, purchaseId, ShopConfig.MAX_RECEIPTS)
	local paid = EconomyService.awardGoldGummies(player, product.gold)
	local saved = PlayerService.saveConfirmed(player)
	_inFlight[purchaseId] = nil

	if saved then
		PlayerService.markDirty(player)
		print("[ShopService]", player.Name, "Kauf", product.key, "| +", paid, "Gold | Kauf-ID", purchaseId)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	-- 3. Speichern gescheitert -> zuruecknehmen, Roblox fragt spaeter erneut
	ShopRules.forgetPurchase(data.shop, purchaseId)
	if paid > 0 then
		EconomyService.spendGoldGummies(player, paid)
	end
	warn("[ShopService] Speichern fehlgeschlagen, Kauf wird spaeter erneut verarbeitet:", purchaseId)
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

--------------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------------

function ShopService.init()
	if not FeatureFlags.isOn("SHOP_V1") then
		print("[ShopService] Aus (SHOP_V1 = false)")
		return
	end

	-- Shop-Kachel darf freigeschaltet werden (UnlockRules hat keine requires)
	UnlockRules.SHOP_ENABLED = true

	RateLimiter.connect(Remotes.RequestClaimFreeGrab, "RequestClaimFreeGrab", function(player)
		claimFreeGrab(player)
	end)

	MarketplaceService.ProcessReceipt = processReceipt

	local live = 0
	for _, product in ShopConfig.PRODUCTS do
		if product.productId ~= 0 then live += 1 end
	end
	print("[ShopService] Initialisiert | Robux-Pakete eingerichtet:", live, "von", #ShopConfig.PRODUCTS)
end

return ShopService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX62"><Properties>
<string name="Name">TowerService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- TowerService.luau
-- ServerScriptService/Services/TowerService.luau
--
-- Einzige Zustaendigkeit:
--   - Den permanenten Tower-Fortschritt fuehren (v15, ersetzt das PIT-Level):
--     Tower-Wahl, Deckel pro Rebirth (weich), Rekorde, Meilensteine (auch
--     rueckwirkend), die PIT-Erstattung aus der Migration und der
--     Rebirth-Hinweis am Deckel.
--
-- Was ein Lauf ist und wie er simuliert wird, weiss CombatService; dieser
-- Service sagt ihm nur, in welchem Tower gekaempft wird, bis wohin es Belohnung
-- gibt, und nimmt am Ende das Ergebnis entgegen (recordRun). Die Zahlen stehen
-- in Config/TowerConfig.
--
-- Die Daten (data.towers) liegen ausserhalb der Insel wie der Ei-Baum: ein
-- Rebirth setzt die Insel zurueck, Rekorde und abgeholte Meilensteine bleiben.
--
-- Auszahlungen laufen ausschliesslich ueber die zustaendigen Services:
-- Gummies/GoldGummies ueber EconomyService (Meilensteine OHNE Multiplikator,
-- awardGummiesFlat), Eier ueber EggService.grantEggs, Blaupausen ueber
-- EggTreeService.grantBlueprint.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local LeaderboardConfig = require(ReplicatedStorage.Config.LeaderboardConfig)  -- Paket 9: Woche
local EggTree     = require(ReplicatedStorage.Modules.EggTree)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local EggService     = require(ServerScriptService.Services.EggService)
local EggTreeService = require(ServerScriptService.Services.EggTreeService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local TowerService = {}

-- Nur Studio/Debug: Spielstaende, fuer die jeder Tower offen ist (Kampf in allen
-- vier Towern ohne Rebirths testen). Schluessel = die Daten-Tabelle, schwach.
local _debugOpen: { [any]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function fail(player: Player, reason: Types.LocMsg)
	Remotes.ActionFailed:FireClient(player, "RequestSelectTower", reason)
end

--------------------------------------------------------------------------------
-- Lesen
--------------------------------------------------------------------------------

-- Deckel in diesem Tower beim aktuellen Rebirth (0 = Tower noch zu).
function TowerService.getStageCap(data: Types.PlayerData, towerId: string): number
	local cap = TowerConfig.getStageCap(data.rebirthCount, towerId, data.towers.records)
	if cap <= 0 and _debugOpen[data] then
		local def = TowerConfig.get(towerId)
		return if def then def.stages else 0
	end
	return cap
end

-- Der gewaehlte Tower; ist er (z. B. nach einer Datenreparatur) nicht offen,
-- der hoechste offene.
function TowerService.getSelected(data: Types.PlayerData): string
	local selected = data.towers.selected
	if TowerConfig.isOpen(data.rebirthCount, selected, data.towers.records) or (_debugOpen[data] and TowerConfig.isValidId(selected)) then
		return selected
	end
	local capTower = TowerConfig.getCap(data.rebirthCount)
	return capTower
end

--------------------------------------------------------------------------------
-- Meilensteine
--------------------------------------------------------------------------------

-- Zahlt einen einzelnen Meilenstein aus (einmalig) und meldet ihn dem Client.
-- Gibt true zurueck, wenn er neu abgeholt wurde.
local function grantMilestone(player: Player, data: Types.PlayerData, towerId: string, stage: number): boolean
	local milestone = TowerConfig.getMilestone(towerId, stage)
	if not milestone then return false end

	local claimed = data.towers.claimed[towerId]
	if not claimed then
		claimed = {}
		data.towers.claimed[towerId] = claimed
	end
	local key = tostring(stage)
	if claimed[key] then return false end
	claimed[key] = true

	local reward: Types.TowerMilestoneReward = {
		towerId     = towerId,
		stage       = stage,
		gummies     = 0,
		goldGummies = 0,
		eggType     = nil,
		eggs        = 0,
		blueprints  = 0,
	}

	if milestone.gummies > 0 then
		reward.gummies = EconomyService.awardGummiesFlat(player, milestone.gummies)
	end
	if milestone.goldGummies > 0 then
		reward.goldGummies = EconomyService.awardGoldGummies(player, milestone.goldGummies)
	end
	if milestone.eggs > 0 then
		local eggType = EggTree.highestUnlocked(data.eggTree)
		if EggService.grantEggs(player, eggType, milestone.eggs) then
			reward.eggType = eggType
			reward.eggs = milestone.eggs
		end
	end
	if milestone.blueprints > 0 then
		EggTreeService.grantBlueprint(player, data, milestone.blueprints)
		reward.blueprints = milestone.blueprints
	end
	if milestone.endlessLevels > 0 then
		local baerchi = data.island.equippedUid and data.island.baerchis[data.island.equippedUid]
		if baerchi then
			baerchi.endlessLevel = (baerchi.endlessLevel or 0) + milestone.endlessLevels
			reward.endlessLevels = milestone.endlessLevels
		end
	end

	-- Kurz verzoegert: beim Join haengt der Client sein UI erst noch an.
	task.delay(1, function()
		if player.Parent then
			Remotes.TowerMilestoneReceived:FireClient(player, reward)
		end
	end)
	return true
end

-- Alle noch offenen Meilensteine bis einschliesslich `upTo` (rueckwirkend).
local function grantMilestonesUpTo(player: Player, data: Types.PlayerData, towerId: string, upTo: number): number
	local granted = 0
	local stage = TowerConfig.MILESTONE_EVERY
	while stage <= upTo do
		if grantMilestone(player, data, towerId, stage) then
			granted += 1
		end
		stage += TowerConfig.MILESTONE_EVERY
	end
	return granted
end

--------------------------------------------------------------------------------
-- Ergebnis eines Laufs
--------------------------------------------------------------------------------

-- Vom CombatService am Ende eines Laufs aufgerufen. `highestWon` = hoechste
-- gewonnene Stage dieses Laufs. Rekord und Meilensteine zaehlen nur bis zum
-- Deckel (weich). Gibt den neuen Rekord (nil = keiner) und zurueck, ob der Lauf
-- den Deckel erreicht hat (Rebirth-Hinweis, nur wenn der Deckel ein echtes
-- Limit ist).
function TowerService.recordRun(player: Player, data: Types.PlayerData, towerId: string, highestWon: number): (number?, boolean)
	local def = TowerConfig.get(towerId)
	if not def or highestWon <= 0 then return nil, false end

	local cap = TowerService.getStageCap(data, towerId)
	local counted = math.min(highestWon, cap)

	local newRecord: number? = nil
	local previous = data.towers.records[towerId] or 0
	if counted > previous then
		data.towers.records[towerId] = counted
		newRecord = counted
		if def.index > TowerConfig.getIndex(data.towers.highestTower) then
			data.towers.highestTower = towerId
		end
		grantMilestonesUpTo(player, data, towerId, counted)
	end

	-- Paket 9: beste Endless-Stage dieser Woche (Wochen-Bestenliste).
	if towerId == "Endless" then
		local week = LeaderboardConfig.weekOf(os.time())
		local entry = data.towers.endlessWeek
		if not entry or entry.week ~= week then
			entry = { week = week, best = 0 }
			data.towers.endlessWeek = entry
		end
		entry.best = math.max(entry.best, counted)
	end

	local capReached = highestWon >= cap and TowerConfig.isCapLimiting(data.rebirthCount, towerId)
	return newRecord, capReached
end

--------------------------------------------------------------------------------
-- Tower waehlen
--------------------------------------------------------------------------------

function TowerService.select(player: Player, towerId: string)
	local data = PlayerService.getData(player)
	if not data then return end

	if not TowerConfig.isValidId(towerId) then
		fail(player, Loc.msg("err.tower_unknown"))
		return
	end
	if not TowerConfig.isOpen(data.rebirthCount, towerId, data.towers.records) then
		if towerId == "Endless" then
			fail(player, Loc.msg("err.tower_locked_endless"))
		else
			fail(player, Loc.msg("err.tower_locked", { rebirths = TowerConfig.getOpeningRebirth(towerId) }))
		end
		return
	end
	if data.towers.selected == towerId then return end

	data.towers.selected = towerId
	PlayerService.markDirty(player)
end

-- Debug: alle Tower fuer diesen Spielstand oeffnen (bis zum Verlassen).
function TowerService.debugOpenAll(data: Types.PlayerData)
	_debugOpen[data] = true
end

-- Debug: Rekord direkt setzen (mit Meilensteinen bis dorthin).
function TowerService.debugSetRecord(player: Player, towerId: string, stage: number)
	local data = PlayerService.getData(player)
	local def = TowerConfig.get(towerId)
	if not data or not def then return end
	local value = math.clamp(math.floor(stage), 0, def.stages)
	data.towers.records[towerId] = value
	if value > 0 and def.index > TowerConfig.getIndex(data.towers.highestTower) then
		data.towers.highestTower = towerId
	end
	grantMilestonesUpTo(player, data, towerId, value)
	PlayerService.markDirty(player)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function TowerService.init()
	RateLimiter.connect(Remotes.RequestSelectTower, "RequestSelectTower", function(player, towerId: any)
		if typeof(towerId) ~= "string" then return end
		TowerService.select(player, towerId)
	end)

	PlayerService.onDataLoaded(function(player, data)
		-- 1. PIT-Erstattung aus der Migration v14 -> v15 (einmalig).
		local refund = data.island.pitRefund or 0
		if refund > 0 then
			data.island.pitRefund = 0
			local paid = EconomyService.awardGummiesFlat(player, refund)
			task.delay(4, function()
				if player.Parent then
					Remotes.EventNotice:FireClient(player, Loc.msg("msg.pit_refund", { amount = paid }), "good")
				end
			end)
			print("[TowerService]", player.Name, "| PIT-Erstattung:", paid)
		end

		-- 2. Rueckwirkende Meilensteine (migrierter Rekord, oder ein neuer
		--    Meilenstein in der Config).
		for towerId, record in data.towers.records do
			grantMilestonesUpTo(player, data, towerId, record)
		end

		-- 3. Gewaehlter Tower muss offen sein.
		data.towers.selected = TowerService.getSelected(data)
	end)

	print("[TowerService] Initialisiert |", #TowerConfig.TOWERS, "Tower")
end

return TowerService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX63"><Properties>
<string name="Name">WorldMomentService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldMomentService.luau
-- ServerScriptService/Services/WorldMomentService.luau
--
-- Einzige Zustaendigkeit:
--   - Grosse Momente eines Spielers (seltener Baerchi, neuer Tower, Rekord,
--     Rebirth, seltene Mutation) an ALLE Clients melden (Paket G, "Welt
--     aufwerten"), gedrosselt auf einen grossen Moment je Spieler und 30 s
--
-- Erkannt wird aus dem Spielstand (Modules/WorldMoments.diff): dieser
-- Service haengt an PlayerService.onDataChanged und vergleicht mit dem
-- letzten Stand. So muss kein anderer Service angefasst werden, und kein
-- Moment geht verloren, egal welcher Weg (Ei, Fusion, Event) ihn ausloest.
--
-- Was die Clients daraus machen (Lichtsaeule, Feuerwerk, Welle ...),
-- entscheidet WorldMomentController. Der Server schickt nur Art, Wert und
-- gross/klein. Ein Spieler, dessen Momente zu dicht kommen, sendet weiter,
-- aber als kleine Version (WorldMoments.throttle).

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types        = require(ReplicatedStorage.Network.Types)
local Remotes      = require(ReplicatedStorage.Network.Remotes)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local WorldMoments = require(ReplicatedStorage.Modules.WorldMoments)

local PlayerService = require(ServerScriptService.Services.PlayerService)

local WorldMomentService = {}

local _snapshots: { [Player]: WorldMoments.Snapshot } = {}
local _lastBig: { [Player]: number } = {}

-- Meldet einen Moment an alle (auch fuer den Debug-Befehl "moment").
function WorldMomentService.announce(player: Player, moment: WorldMoments.Moment, forceBig: boolean?)
	local big, last = WorldMoments.throttle(_lastBig[player], os.clock())
	if forceBig then big, last = true, os.clock() end
	_lastBig[player] = last
	Remotes.WorldMoment:FireAllClients({
		userId = player.UserId,
		kind   = moment.kind,
		value  = moment.value,
		number = moment.number,
		big    = big,
	})
end

local function onChanged(player: Player, data: Types.PlayerData)
	local after = WorldMoments.snapshot(data)
	local before = _snapshots[player]
	_snapshots[player] = after
	if not before then return end
	for _, moment in WorldMoments.diff(before, after) do
		WorldMomentService.announce(player, moment)
	end
end

function WorldMomentService.init()
	if not FeatureFlags.isOn("WORLD_G_MOMENTS") then return end

	-- Ausgangsstand beim Laden: was schon da war, ist kein neuer Moment
	PlayerService.onPlayerReady(function(player, data)
		_snapshots[player] = WorldMoments.snapshot(data)
	end)
	PlayerService.onDataChanged(onChanged)
	Players.PlayerRemoving:Connect(function(player)
		_snapshots[player] = nil
		_lastBig[player] = nil
	end)

	print("[WorldMomentService] Initialisiert")
end

return WorldMomentService
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX64"><Properties>
<string name="Name">Util</string>
</Properties>
<Item class="Folder" referent="RBX65"><Properties>
<string name="Name">MapBuild</string>
</Properties>
<Item class="ModuleScript" referent="RBX66"><Properties>
<string name="Name">ArenaBuilder</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- ArenaBuilder.luau
-- ServerScriptService/Util/MapBuild/ArenaBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Den Steg zur Arena-Insel, die PIT-Arena, die Ringe des Lauf-Turms und
--     (v15) den staendigen Tower-Turm (Angeberflaeche) bauen
--
-- Die Arena ist eine flache Kampfflaeche. Seit v15 gibt es kein PIT-Level und
-- damit keine Saeulen mehr; den Fortschritt zeigt der Tower-Turm am aeusseren
-- Rand der Insel (Look = hoechster Tower, Hoehe = Rekord, MapConfig.TOWER_LOOKS).
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)

local ArenaBuilder = {}

-- Der aeussere Steg: von der Plot-Insel des Spielers auf seine Arena-Insel.
-- Er gehoert zum Spieler und wird deshalb mit dessen Plot-Model gebaut — die
-- INNEREN Stege (Hauptinsel → Plot-Insel) stehen dagegen immer, siehe
-- buildPlatform.
function ArenaBuilder.buildBridge(plotModel: Model, slot: number)
	local islandEdge = MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS

	MapParts.buildSpan(
		plotModel,
		"Bridge",
		MapParts.outwardDirection(slot),
		islandEdge,
		islandEdge + MapConfig.ISLAND_GAP
	)
end

-- Die PIT-Arena am Ende der Bruecke. Flache runde Kampfflaeche.
--
-- Die Kampfflaeche heisst bewusst weiterhin "FightFloor": WorldController
-- haengt genau an diesem Namen seinen Kampf-Prompt auf.
function ArenaBuilder.buildPit(plotModel: Model, slot: number)
	local old = plotModel:FindFirstChild("PitPlatform")
	if old then old:Destroy() end

	local container = Instance.new("Model")
	container.Name   = "PitPlatform"
	container.Parent = plotModel

	local center = MapParts.pitCenter(slot)

	-- Die Arena-Insel: derselbe Aufbau wie jede andere Insel (Sandkante plus
	-- Scheibe), damit sie nicht wie ein Fremdkoerper im Wasser steht. Ihre
	-- Oberflaeche ist der Sockel, auf dem der Steg landet.
	-- Der Sockel liegt PIT_RIM_DROP tiefer als die Kampfflaeche, sonst waeren
	-- die beiden Oberseiten deckungsgleich und wuerden flimmern.
	local rimY = MapConfig.PLATFORM_TOP_Y - MapConfig.PIT_RIM_DROP

	MapParts.buildIsland(
		container,
		"PitBase",
		center,
		MapConfig.PIT_BASE_RADIUS,
		MapConfig.PIT_BASE_COLOR,
		Enum.Material.Slate,
		MapConfig.PIT_RIM_DROP
	)

	-- Leuchtender Ring am Sockelrand: eine etwas breitere Scheibe, die flach
	-- darunter liegt. Sichtbar bleibt nur ihr ueberstehender Rand — derselbe
	-- Trick wie bei der Sandkante, und ein Teil statt eines Dutzends Segmente.
	-- Sie sitzt eine halbe Ringhoehe unter dem Sockel: damit liegt sie
	-- zwischen Sockel und Sandkante, ohne mit einer von beiden auf gleicher
	-- Hoehe zu liegen.
	local ringRadius = MapConfig.PIT_BASE_RADIUS + MapConfig.PIT_RING_OVERHANG
	local ring = MapParts.newPart(
		"PitRing",
		Vector3.new(MapConfig.PIT_RING_HEIGHT, ringRadius * 2, ringRadius * 2),
		CFrame.new(center.X, rimY - MapConfig.PIT_RING_HEIGHT, center.Z)
			* CFrame.Angles(0, 0, math.rad(90)),
		MapConfig.PIT_RING_COLOR,
		Enum.Material.Neon
	)
	ring.Shape      = Enum.PartType.Cylinder
	ring.CanCollide = false
	ring.CanQuery   = false
	ring.Parent     = container

	-- Kampfflaeche: Oberkante auf PLATFORM_TOP_Y, also ein kleiner Absatz ueber
	-- dem Sockelring ringsum.
	local floorY = MapConfig.PLATFORM_TOP_Y - MapConfig.PIT_FLOOR_HEIGHT * 0.5
	local floor = MapParts.newPart(
		"FightFloor",
		Vector3.new(MapConfig.PIT_FLOOR_HEIGHT, MapConfig.PIT_RADIUS * 2, MapConfig.PIT_RADIUS * 2),
		CFrame.new(center.X, floorY, center.Z) * CFrame.Angles(0, 0, math.rad(90)),
		MapConfig.PIT_FLOOR_COLOR,
		Enum.Material.SmoothPlastic
	)
	floor.Shape  = Enum.PartType.Cylinder
	floor.Parent = container

	-- Leuchtender Zaun auf dem Sockelrand.
	--
	-- Zur Steg-Seite bleibt eine Luecke frei, sonst muesste man beim Betreten
	-- der Arena ueber den Zaun springen. Die Steg-Seite ist die Richtung ZUR
	-- Weltmitte, also das Gegenteil der Aussenrichtung des Plots.
	local outward    = MapParts.outwardDirection(slot)
	local inwardAngle = math.atan2(-outward.Z, -outward.X)
	local gap        = math.rad(MapConfig.PIT_FENCE_GAP_DEGREES)
	local postRadius = MapConfig.PIT_BASE_RADIUS - MapConfig.PIT_FENCE_INSET
	local postY      = rimY + MapConfig.PIT_FENCE_SIZE.Y * 0.5

	for i = 1, MapConfig.PIT_FENCE_COUNT do
		local angle = (i - 1) * (2 * math.pi / MapConfig.PIT_FENCE_COUNT)

		-- Winkelabstand zur Steg-Richtung, immer als kuerzester Weg gemessen —
		-- sonst faellt die Luecke bei manchen Plots auseinander.
		local delta = math.abs(((angle - inwardAngle + math.pi) % (2 * math.pi)) - math.pi)

		if delta > gap then
			local post = MapParts.newPart(
				"PitFence_" .. i,
				MapConfig.PIT_FENCE_SIZE,
				CFrame.new(
					center.X + postRadius * math.cos(angle),
					postY,
					center.Z + postRadius * math.sin(angle)
				),
				MapConfig.PIT_FENCE_COLOR,
				Enum.Material.Neon
			)
			post.CanCollide = false
			post.CanQuery   = false
			post.Parent     = container
		end
	end

	-- Ordner fuer die Kampf-Figuren waehrend eines Laufs. Liegt hier, damit
	-- PitArenaService nichts selbst anlegen muss und ein Neuaufbau des PIT
	-- die Figuren automatisch mitnimmt.
	local fighters = Instance.new("Folder")
	fighters.Name   = "Fighters"
	fighters.Parent = container

	-- Ordner fuer die Turm-Etagen, die waehrend eines Laufs Stage fuer Stage
	-- dazukommen (siehe MapService.setPitTowerLevel). Aus demselben Grund wie
	-- Fighters: PitArenaService legt hier nichts selbst an, und ein Neuaufbau
	-- des PIT (z. B. beim Ausbauen) raeumt einen laufenden Turm automatisch mit
	-- weg statt ihn verwaist stehen zu lassen.
	local tower = Instance.new("Folder")
	tower.Name   = "Tower"
	tower.Parent = container

	-- Anzeigetafel ueber der Arena. Sie haengt an einer eigenen unsichtbaren
	-- Part und nicht am Boden: der Boden ist ein um 90 Grad gekippter Zylinder,
	-- an dem "oben" nicht nach oben zeigt. Standardmaessig ausgeschaltet —
	-- eingeblendet wird sie nur waehrend einer Wiedergabe.
	local anchor = MapParts.newPart(
		"PitBannerAnchor",
		Vector3.new(1, 1, 1),
		CFrame.new(center.X, MapConfig.PLATFORM_TOP_Y + MapConfig.PIT_BANNER_HEIGHT, center.Z),
		MapConfig.PIT_FLOOR_COLOR,
		Enum.Material.SmoothPlastic
	)
	anchor.Transparency = 1
	anchor.CanCollide   = false
	anchor.CanQuery     = false
	anchor.CanTouch     = false
	anchor.Parent       = container

	local banner = Instance.new("BillboardGui")
	banner.Name        = "Banner"
	banner.Size        = UDim2.fromScale(MapConfig.PIT_BANNER_SIZE.X, MapConfig.PIT_BANNER_SIZE.Y)
	banner.AlwaysOnTop = false
	banner.MaxDistance = MapConfig.PIT_BANNER_DISTANCE
	banner.Adornee     = anchor
	banner.Enabled     = false
	banner.Parent      = anchor

	local bannerTitle = MapParts.newTextLabel("Title", banner, UDim2.fromScale(1, 0.6), UDim2.fromScale(0, 0))
	bannerTitle.Text  = ""
	MapParts.newTextLabel("Sub", banner, UDim2.fromScale(1, 0.4), UDim2.fromScale(0, 0.6))
end

-- Eine einzelne Turm-Etage: eine Scheibe im selben Radius wie die
-- Kampfflaeche, die direkt auf der vorherigen aufsetzt. `level` ist 1-basiert
-- — Etage 1 ist die erste Scheibe UEBER der normalen Kampfflaeche.
function ArenaBuilder.buildTowerRing(tower: Folder, center: Vector3, level: number)
	local color = MapConfig.PIT_TOWER_COLORS[((level - 1) % #MapConfig.PIT_TOWER_COLORS) + 1]
	local topY  = MapConfig.PLATFORM_TOP_Y + level * MapConfig.PIT_TOWER_STEP_HEIGHT

	local ring = MapParts.newPart(
		"Ring_" .. level,
		Vector3.new(MapConfig.PIT_TOWER_STEP_HEIGHT, MapConfig.PIT_TOWER_RADIUS * 2, MapConfig.PIT_TOWER_RADIUS * 2),
		CFrame.new(center.X, topY - MapConfig.PIT_TOWER_STEP_HEIGHT * 0.5, center.Z)
			* CFrame.Angles(0, 0, math.rad(90)),
		color,
		Enum.Material.SmoothPlastic
	)
	ring.Shape  = Enum.PartType.Cylinder
	ring.Parent = tower
end

--------------------------------------------------------------------------------
-- v15: der Tower-Turm (Angeberflaeche)
--------------------------------------------------------------------------------

export type ShowcaseView = {
	look   : string,   -- Schluessel in MapConfig.TOWER_LOOKS
	floors : number,   -- 1 .. TowerConfig.SHOWCASE_MAX_FLOORS
	title  : string,   -- Schild: "Name · Tower III · 42"
	color  : Color3,
}

-- Mitte des Turm-Fusses (Inselhoehe). HBB Paket 5: am Brueckenkopf auf der
-- Hauptinsel (MAP_V2_SHOWCASE), sonst aussen an der Arena-Insel. Die Formel
-- steht in MapLayout, damit Test und Deko-Freiraum dieselbe benutzen.
function ArenaBuilder.showcaseFoot(slot: number): Vector3
	return MapLayout.showcaseFoot(slot)
end

-- Baut den Turm neu (der alte wird ersetzt). Teile: Sockel (bis ins Wasser),
-- `floors` Etagen aus dem Look, Spitze, Schild. Rein deklarativ aus
-- MapConfig.TOWER_LOOKS — Formaenderungen nur dort.
function ArenaBuilder.buildShowcase(plotModel: Model, slot: number, view: ShowcaseView): Model
	local old = plotModel:FindFirstChild("TowerShowcase")
	if old then old:Destroy() end

	local cfg  = MapConfig.TOWER_SHOWCASE
	local look = MapConfig.TOWER_LOOKS[view.look] or MapConfig.TOWER_LOOKS.Wood
	local foot = ArenaBuilder.showcaseFoot(slot)

	local container = Instance.new("Model")
	container.Name = "TowerShowcase"
	container:SetAttribute("Look", view.look)
	container:SetAttribute("Floors", view.floors)

	-- Sockel: vom Grund der Insel bis knapp ueber die Arena, damit der Turm
	-- nicht auf dem Wasser schwebt.
	local plinthHeight = MapConfig.ISLAND_HEIGHT + cfg.plinthHeight
	local plinth = MapParts.newPart(
		"Sockel",
		Vector3.new(plinthHeight, (cfg.radius + 1.2) * 2, (cfg.radius + 1.2) * 2),
		CFrame.new(foot.X, foot.Y + cfg.plinthHeight - plinthHeight * 0.5, foot.Z) * CFrame.Angles(0, 0, math.rad(90)),
		look.plinth,
		Enum.Material.Slate
	)
	plinth.Shape    = Enum.PartType.Cylinder
	plinth.CanQuery = false
	plinth.Parent   = container

	local floors = math.clamp(math.floor(view.floors), 1, TowerConfig.SHOWCASE_MAX_FLOORS)
	local baseY  = cfg.plinthHeight
	for i = 1, floors do
		local origin = CFrame.new(foot.X, foot.Y + baseY + (i - 1) * cfg.floorHeight, foot.Z)
		MapParts.buildDecor(container, origin, look.floor)
	end

	local topY = baseY + floors * cfg.floorHeight
	MapParts.buildDecor(container, CFrame.new(foot.X, foot.Y + topY, foot.Z), look.top)

	-- Schild ueber der Spitze (Name · Tower · Rekord).
	local anchor = MapParts.newPart(
		"SignAnchor",
		Vector3.new(1, 1, 1),
		CFrame.new(foot.X, foot.Y + topY + MapParts.decorHeight(look.top) + cfg.signGap, foot.Z),
		look.accent,
		Enum.Material.SmoothPlastic
	)
	anchor.Transparency = 1
	anchor.CanCollide   = false
	anchor.CanQuery     = false
	anchor.CanTouch     = false
	anchor.Parent       = container

	local sign = Instance.new("BillboardGui")
	sign.Name        = "Sign"
	sign.Size        = UDim2.fromScale(16, 2.4)
	sign.AlwaysOnTop = false
	sign.MaxDistance = cfg.signDistance
	sign.Adornee     = anchor
	sign.Parent      = anchor

	local title = MapParts.newTextLabel("Title", sign, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	title.Text       = view.title
	title.TextColor3 = view.color

	container.Parent = plotModel
	return container
end

return ArenaBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX67"><Properties>
<string name="Name">FigureBuilder</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- FigureBuilder.luau
-- ServerScriptService/Util/MapBuild/FigureBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Die sichtbare Figur des ausgeruesteten Baerchis bauen und ihren Zustand
--     (Namensschild, HP, erschoepft) anzeigen
--
-- Es gibt pro Plot nur EINE Figur: die des ausgeruesteten Baerchis. Alle
-- anderen Baerchis sind reine Inventar-Daten.
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local BaerchiMesh      = require(ReplicatedStorage.Modules.BaerchiMesh)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local Types            = require(ReplicatedStorage.Network.Types)

local FigureFX         = require(ServerScriptService.Util.FigureFX)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local FigureBuilder = {}

-- Beschriftung und Erschoepfungs-Zustand einer bereits stehenden Figur.
-- Getrennt vom Aufbau, weil sich HP staendig aendern und ein kompletter
-- Neuaufbau der Mesh-Figuren dafuer viel zu teuer waere.
function FigureBuilder.writeFigureState(model: Model, rawHp: number, maxHp: number)
	local hp        = math.clamp(rawHp, 0, maxHp)
	local exhausted = hp <= 0

	local label = model:FindFirstChild("Health", true)
	if label and label:IsA("TextLabel") then
		label.Text = if exhausted
			then "erschoepft"
			else string.format("%d / %d HP", hp, maxHp)

		label.TextColor3 = if exhausted
			then Color3.fromRGB(255, 120, 120)
			elseif hp < maxHp * 0.34 then Color3.fromRGB(255, 205, 110)
			else Color3.fromRGB(190, 245, 195)
	end

	-- Ein erschoepfter Baerchi wird matt. Bewusst nicht komplett durchsichtig:
	-- er ist ausser Gefecht, nicht weg.
	--
	-- Die urspruengliche Transparenz jedes Teils steht als Attribut daran
	-- (gesetzt beim Aufbau). Sie einfach auf 0 zurueckzusetzen wuerde sonst
	-- absichtliche Durchsichtigkeit im importierten Modell zerstoeren — der
	-- Gummy-Baer ist genau dafuer ein Beispiel.
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local stored = part:GetAttribute("BaseTransparency")
			local base   = if typeof(stored) == "number" then stored else 0

			part.Transparency = if exhausted
				then math.max(base, MapConfig.BAERCHI_EXHAUSTED_TRANSPARENCY)
				else base
		end
	end
end

-- Wie writeFigureState, aber respektiert einen laufenden PIT-Kampf.
--
-- Waehrend eines Laufs gehoert die Figur dem PitArenaService: der Kampf ist
-- serverseitig schon ausgerechnet und die HP stehen bereits auf dem Endwert,
-- waehrend die Wiedergabe in der Arena noch laeuft. Wuerde hier
-- dazwischengeschrieben, saehe der Baerchi ab der ersten Sekunde erschoepft
-- aus statt am Ende. PitArenaService zieht den Zustand selbst nach.
function FigureBuilder.writeBaerchiState(model: Model, baerchi: Types.Baerchi, maxHp: number)
	if model:GetAttribute("InArena") == true then
		return
	end

	FigureBuilder.writeFigureState(model, baerchi.currentHp, maxHp)
end

-- Eine Baerchi-Figur: das geklonte Pet-Mesh aus BaerchiMesh.build. Welches
-- Modell das ist (eigenes fuer diese Rarity oder der gemeinsame Platzhalter)
-- und ob es eingefaerbt wird, entscheidet BaerchiMesh selbst.
--
-- JEDE BasePart der Figur traegt das Attribut "BaerchiUid" und einen eigenen
-- ClickDetector — bei einem Mesh aus mehreren Teilen waere ein einzelner
-- Hitbereich schwer zu treffen. Der Client (WorldController) liest das
-- Attribut beim Klick und schlaegt die Details in seinem eigenen Datenstand
-- nach — dafuer braucht es kein zusaetzliches Remote.
--
-- Fehlt das Mesh-Template noch, gibt BaerchiMesh.build nil zurueck — dann
-- wird diese eine Figur uebersprungen, der Rest des Plots baut sich normal.
function FigureBuilder.buildBaerchiFigure(parent: Instance, baerchi: Types.Baerchi, footPos: Vector3, facing: CFrame): Model?
	local color = BaerchiConfig.getRarityColor(baerchi.rarity)
	local def   = BaerchiConfig.getById(baerchi.configId)

	-- Ein MUTIERTER Baerchi (seit v11, ersetzt das fruehere binaere Inverted)
	-- bekommt die Farbe seiner Mutations-Stufe und leuchtet (siehe
	-- BaerchiMesh.build). Fuer alle anderen ist der vierte Parameter nil und
	-- es aendert sich nichts.
	local mutationColor = if baerchi.mutation
		then BaerchiConfig.getMutationColor(baerchi.mutation)
		else nil

	local model = BaerchiMesh.build(footPos, color, baerchi.rarity, mutationColor)
	if not model then
		return nil
	end
	model.Name = "Baerchi_" .. baerchi.uid

	-- BaerchiMesh stellt die Figur achsen-parallel hin. Hier wird sie noch in
	-- die Blickrichtung des Plots gedreht — und zwar um die senkrechte Achse
	-- DURCH footPos, nicht um den Modell-Pivot: wo der Pivot im importierten
	-- Mesh liegt, weiss dieses Modul nicht, eine Drehung darum wuerde die
	-- Figur seitlich wegschieben.
	local rotation = facing.Rotation
	local toOrigin = CFrame.new(-footPos)
	model:PivotTo(CFrame.new(footPos) * rotation * toOrigin * model:GetPivot())

	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part:SetAttribute("BaerchiUid", baerchi.uid)

			-- Ausgangs-Transparenz merken, damit der Erschoepfungs-Zustand
			-- sie spaeter nicht ueberschreibt (siehe writeBaerchiState).
			part:SetAttribute("BaseTransparency", part.Transparency)

			local click = Instance.new("ClickDetector")
			click.MaxActivationDistance = MapConfig.BAERCHI_CLICK_DISTANCE
			click.Parent = part
		end
	end

	-- Rarity-Aura: ab Rare ein dezentes Dauer-Glitzern, ab Epic zusaetzlich ein
	-- PointLight. Nutzt dieselbe Farbe wie die Koerpereinfaerbung
	-- (BaerchiConfig.getRarityColor) — Seltenheit soll auch aus der Distanz auf
	-- einen Blick erkennbar sein, nicht erst beim Ranschauen des Namensschilds.
	-- Siehe DESIGN_VORSCHLAG_TRENDANALYSE_2026-09-11.md Abschnitt 5.
	--
	-- Haengt an EINEM zentralen Part (nicht an jedem BasePart wie der
	-- ClickDetector oben): ein Glitzern pro Teilstueck des Mesh saehe wie ein
	-- Funkensturm aus, nicht wie eine Aura.
	local auraAnchor = (model.PrimaryPart :: BasePart?) or (model:FindFirstChildWhichIsA("BasePart", true) :: BasePart?)
	if auraAnchor then
		local rarityKey = baerchi.rarity :: string

		if MapConfig.RARITY_AURA_MIN_SPARKLE[rarityKey] then
			local sparkle = Instance.new("ParticleEmitter")
			sparkle.Name          = "RarityAura"
			sparkle.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
			sparkle.Color         = ColorSequence.new(color)
			sparkle.Size          = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.35),
				NumberSequenceKeypoint.new(1, 0),
			})
			sparkle.Transparency  = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			})
			sparkle.Lifetime      = NumberRange.new(0.8, 1.4)
			sparkle.Speed         = NumberRange.new(1, 3)
			sparkle.SpreadAngle   = Vector2.new(180, 180)
			sparkle.Rate          = MapConfig.RARITY_AURA_PARTICLE_RATE
			sparkle.Parent        = auraAnchor
		end

		if MapConfig.RARITY_AURA_MIN_LIGHT[rarityKey] then
			local light = Instance.new("PointLight")
			light.Name       = "RarityAuraLight"
			light.Color      = color
			light.Range      = MapConfig.RARITY_AURA_LIGHT_RANGE
			light.Brightness = MapConfig.RARITY_AURA_LIGHT_BRIGHTNESS
			light.Parent     = auraAnchor
		end

		-- Mutations-Aura (seit v11): unabhaengig von der Rarity-Aura oben, weil
		-- eine Mutation auch einen Common treffen kann, der sonst nie eine Aura
		-- haette. JEDE Mutation bekommt zumindest ein Punktlicht in ihrer
		-- eigenen Farbe; ab Multiplikator 4x (Celestial/Candy/Lava/Galaxy/
		-- Rainbow — siehe BaerchiConfig.MUTATIONS) zusaetzlich ein dichteres
		-- Glitzern, damit die seltensten Baerchis im Spiel auch aus der
		-- Distanz sofort als etwas Besonderes auffallen.
		if baerchi.mutation then
			local mutColor = BaerchiConfig.getMutationColor(baerchi.mutation)

			local mutLight = Instance.new("PointLight")
			mutLight.Name       = "MutationAuraLight"
			mutLight.Color      = mutColor
			mutLight.Range      = MapConfig.RARITY_AURA_LIGHT_RANGE
			mutLight.Brightness = MapConfig.RARITY_AURA_LIGHT_BRIGHTNESS * 1.5
			mutLight.Parent     = auraAnchor

			if BaerchiConfig.getMutationMultiplier(baerchi.mutation) >= 4 then
				local mutSparkle = Instance.new("ParticleEmitter")
				mutSparkle.Name          = "MutationAura"
				mutSparkle.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
				mutSparkle.Color         = ColorSequence.new(mutColor)
				mutSparkle.Size          = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(1, 0),
				})
				mutSparkle.Transparency  = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.15),
					NumberSequenceKeypoint.new(1, 1),
				})
				mutSparkle.Lifetime      = NumberRange.new(1.0, 1.8)
				mutSparkle.Speed         = NumberRange.new(2, 5)
				mutSparkle.SpreadAngle   = Vector2.new(180, 180)
				mutSparkle.Rate          = MapConfig.RARITY_AURA_PARTICLE_RATE * 2
				mutSparkle.Parent        = auraAnchor
			end
		end
	end

	-- Namensschild ueber dem Kopf (faellt auf den Body zurueck, falls das
	-- Template keinen Part namens "head" hat). Rekursiv gesucht: der Importer
	-- packt die Teile in eine Zwischen-Gruppe.
	--
	-- Drei Zeilen statt zwei seit dem Ei-Legen: Name+Level, HP, und ganz unten
	-- der Ei-Timer. Der Ei-Timer-Text wird HIER nur als leeres Label angelegt —
	-- befuellt wird er rein clientseitig (EggTimerController), weil er
	-- sekuendlich weiterzaehlt und dafuer keine Serverlast noetig ist (siehe
	-- Kommentar-Kopf dort).
	local labelAnchor = (model:FindFirstChild("head", true) :: BasePart?) or model.PrimaryPart
	if labelAnchor then
		local billboard = Instance.new("BillboardGui")
		billboard.Name        = "Label"
		billboard.Size        = UDim2.fromScale(6, 3.0)
		billboard.StudsOffset = Vector3.new(0, BaerchiMesh.getHeight(model) * 0.55 + 0.6, 0)
		billboard.AlwaysOnTop = false
		billboard.MaxDistance = MapConfig.BAERCHI_CLICK_DISTANCE
		billboard.Adornee     = labelAnchor
		billboard.Parent      = labelAnchor

		local name = MapParts.newTextLabel("Name", billboard, UDim2.fromScale(1, 0.36), UDim2.fromScale(0, 0))
		name.Text = string.format(
			"%s%s  Lv.%d",
			-- Das Namensschild ist die zweite Stelle, an der eine Mutation
			-- auffaellt (die erste ist die leuchtende Mutations-Farbe der
			-- Figur selbst). Beides zusammen, weil die Farbe allein bei einer
			-- Rarity mit ungewohnter Palette nicht eindeutig genug waere —
			-- und weil ein Spieler lesen koennen soll, WELCHE der acht Stufen
			-- es genau ist (die Farbe allein verraet das nicht zuverlaessig).
			if baerchi.mutation then BaerchiConfig.getMutationBadge(baerchi.mutation) .. " " else "",
			def and def.displayName or baerchi.configId,
			baerchi.level
		)

		if baerchi.mutation then
			name.TextColor3 = BaerchiConfig.getMutationColor(baerchi.mutation)
		end

		MapParts.newTextLabel("Health", billboard, UDim2.fromScale(1, 0.32), UDim2.fromScale(0, 0.36))

		local eggTimer = MapParts.newTextLabel("EggTimer", billboard, UDim2.fromScale(1, 0.32), UDim2.fromScale(0, 0.68))
		eggTimer.TextColor3 = Color3.fromRGB(255, 224, 140)   -- Ei-Gold, passend zur HUD-Farbwelt
		eggTimer.Text        = ""   -- EggTimerController fuellt das im ersten Tick
	end

	model.Parent = parent
	return model
end

-- Maximale HP eines Baerchis. Liegt hier statt inline, weil sowohl der Aufbau
-- als auch die In-Place-Aktualisierung sie brauchen.
function FigureBuilder.maxHpOf(baerchi: Types.Baerchi): number
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then return 1 end

	return CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
end

-- Baut die sichtbare Baerchi-Figur eines Plots neu: seit dem Equip-System
-- steht dort hoechstens EINE — der ausgeruestete Baerchi. Alle anderen sind
-- reiner Inventar-Datensatz und werden nicht in die Welt gebaut. Ist keiner
-- ausgeruestet (leerer Plot, z.B. direkt nach einem Rebirth), bleibt der
-- Ordner einfach leer.
function FigureBuilder.renderBaerchis(plotModel: Model, slot: number, islandData: Types.IslandData)
	local old = plotModel:FindFirstChild("Baerchis")
	if old then old:Destroy() end

	local folder = Instance.new("Folder")
	folder.Name   = "Baerchis"
	folder.Parent = plotModel

	local equippedUid = islandData.equippedUid
	local equipped = if equippedUid then islandData.baerchis[equippedUid] else nil
	if not equipped then
		return
	end

	local plotCFrame = MapParts.plotCFrame(slot)
	local home       = MapLayout.baerchiHomeOffset()   -- HONEY_POND_V2: am Becken
	local footPos    = (plotCFrame * CFrame.new(home.X, MapParts.plotSurfaceOffset() + home.Y, home.Z)).Position

	local figure = FigureBuilder.buildBaerchiFigure(folder, equipped, footPos, plotCFrame)
	if figure then
		FigureBuilder.writeBaerchiState(figure, equipped, FigureBuilder.maxHpOf(equipped))

		-- Eine frisch gebaute Figur steht — also atmet sie. Wer sie danach
		-- selbst bewegt (PitArenaService, BaerchiAutopilotService), meldet sie
		-- vorher ab und danach wieder an. Die alte Figur ist eine Zeile weiter
		-- oben zerstoert worden; ihr Registry-Eintrag raeumt sich beim
		-- naechsten Durchlauf des Idle-Loops selbst weg.
		FigureFX.idleBob(figure, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
	end
end

return FigureBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX68"><Properties>
<string name="Name">PlotBuilder</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PlotBuilder.luau
-- ServerScriptService/Util/MapBuild/PlotBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Das Grundgeruest eines Spieler-Plots (Beet, Zaun, Schild) und die
--     Honig-Gebaeude mit Schild und Honig-Tropfen bauen und beschriften
--
-- Gebaeude bestehen aus einem unsichtbaren Koerper (Name, Level, Schild,
-- Client-Prompt) und der deklarativen Deko aus MapConfig.BUILDING_DECOR plus
-- den Zusaetzen ihres Looks (v15, MapConfig.getBuildingDecor). Der Look steht
-- als Attribut "Look" am Koerper — MapService baut ein Gebaeude nur neu, wenn
-- sich der Look aendert.
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types            = require(ReplicatedStorage.Network.Types)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local PlotBuilder = {}

-- Zaun an den beiden Seiten des Plots. Vorne und hinten bleibt offen, sonst
-- kaeme man weder auf den Plot noch zur Bruecke.
function PlotBuilder.buildFence(plotModel: Model, slot: number)
	local plotCFrame = MapParts.plotCFrame(slot)
	local halfX = MapConfig.PLOT_SIZE.X * 0.5
	local halfZ = MapConfig.PLOT_SIZE.Z * 0.5

	local postY = MapParts.plotSurfaceOffset() + MapConfig.FENCE_POST_SIZE.Y * 0.5
	local steps = math.max(1, math.floor(MapConfig.PLOT_SIZE.Z / MapConfig.FENCE_POST_SPACING))

	for _, side in { -1, 1 } do
		for i = 0, steps do
			local z = -halfZ + (i / steps) * MapConfig.PLOT_SIZE.Z

			local post = MapParts.newPart(
				"FencePost",
				MapConfig.FENCE_POST_SIZE,
				plotCFrame * CFrame.new(side * halfX, postY, z),
				MapConfig.FENCE_COLOR,
				Enum.Material.Wood
			)
			post.CanCollide = false
			post.Parent     = plotModel
		end

		-- Zwei durchgehende Querlatten statt einzelner Segmente: ein Part
		-- statt acht, und optisch macht es keinen Unterschied.
		for _, heightFactor in { 0.45, 0.85 } do
			local railY = MapParts.plotSurfaceOffset() + MapConfig.FENCE_POST_SIZE.Y * heightFactor

			local rail = MapParts.newPart(
				"FenceRail",
				Vector3.new(MapConfig.FENCE_POST_SIZE.X * 0.6, MapConfig.FENCE_RAIL_HEIGHT, MapConfig.PLOT_SIZE.Z),
				plotCFrame * CFrame.new(side * halfX, railY, 0),
				MapConfig.FENCE_COLOR,
				Enum.Material.Wood
			)
			rail.CanCollide = false
			rail.Parent     = plotModel
		end
	end
end

-- Schild an der zur Mitte zeigenden Kante mit dem Namen des Besitzers.
-- v15: darunter ein kleines Tower-Symbol (hoechster Tower, siehe
-- writeOwnerBadge) — gesetzt von MapService, sobald der Tower-Stand bekannt ist.
function PlotBuilder.buildPlotSign(plotModel: Model, slot: number, ownerName: string)
	local plotCFrame = MapParts.plotCFrame(slot)
	local halfZ = MapConfig.PLOT_SIZE.Z * 0.5

	local boardSize = MapConfig.SIGN_BOARD_SIZE
	local postSize  = MapConfig.SIGN_POST_SIZE

	-- Zwei Pfosten an den Raendern, HINTER dem Brett (lokal +Z = weg von der
	-- Mitte; die Schrift zeigt nach -Z). So verdeckt kein Pfosten die Schrift.
	local postY = MapParts.plotSurfaceOffset() + postSize.Y * 0.5
	local behind = boardSize.Z * 0.5 + postSize.Z * 0.5
	for _, side in { -1, 1 } do
		local post = MapParts.newPart(
			"SignPost",
			postSize,
			plotCFrame * CFrame.new(side * (boardSize.X * 0.5 - postSize.X), postY, -halfZ + 2 + behind),
			MapConfig.SIGN_POST_COLOR,
			Enum.Material.Wood
		)
		post.CanCollide = false
		post.Parent     = plotModel
	end

	local boardY = MapParts.plotSurfaceOffset() + postSize.Y - boardSize.Y * 0.5
	local board = MapParts.newPart(
		"SignBoard",
		boardSize,
		plotCFrame * CFrame.new(0, boardY, -halfZ + 2),
		MapConfig.SIGN_COLOR,
		Enum.Material.Wood
	)
	board.CanCollide = false
	board.Parent     = plotModel

	-- Dunkle Leisten oben und unten (Rahmen statt nacktem Brett)
	for i, dy in { boardSize.Y * 0.5, -boardSize.Y * 0.5 } do
		local trim = MapParts.newPart(
			"SignTrim" .. i,
			Vector3.new(boardSize.X + 0.6, 0.45, boardSize.Z + 0.2),
			plotCFrame * CFrame.new(0, boardY + dy, -halfZ + 2),
			MapConfig.SIGN_TRIM_COLOR,
			Enum.Material.Wood
		)
		trim.CanCollide = false
		trim.Parent     = plotModel
	end

	-- Die Schrift kommt auf die Seite, die zur Plattform-Mitte zeigt. Das ist
	-- die lokale -Z-Seite des Plots und damit die Vorderseite des Boards.
	local surface = Instance.new("SurfaceGui")
	surface.Name        = "SignText"
	surface.Face        = Enum.NormalId.Front
	surface.PixelsPerStud = 40
	surface.Adornee     = board
	surface.Parent      = board

	local label = MapParts.newTextLabel("Owner", surface, UDim2.fromScale(0.9, 0.56), UDim2.fromScale(0.05, 0.08))
	label.TextColor3             = Color3.fromRGB(70, 50, 30)
	label.TextStrokeTransparency = 1
	label.Text                   = ownerName

	local badge = MapParts.newTextLabel("TowerBadge", surface, UDim2.fromScale(0.9, 0.28), UDim2.fromScale(0.05, 0.64))
	badge.TextStrokeTransparency = 1
	badge.Text                   = ""
end

-- v15: Tower-Symbol unter dem Besitzernamen ("◆ III · 42"). Billig, nur Text.
function PlotBuilder.writeOwnerBadge(plotModel: Model, text: string, color: Color3)
	local board = plotModel:FindFirstChild("SignBoard")
	local surface = board and board:FindFirstChild("SignText")
	local badge = surface and surface:FindFirstChild("TowerBadge")
	if badge and badge:IsA("TextLabel") then
		badge.Text       = text
		badge.TextColor3 = color
	end
end

-- Die Plot-Platte samt Zaun und Schild.
--
-- Das Besitzer-Attribut wird gesetzt BEVOR das Model in den Workspace kommt:
-- der Client bekommt es damit zusammen mit dem Model und muss nicht darauf
-- warten. WorldController haengt daran, ob er ueberhaupt einen Prompt baut.
function PlotBuilder.buildPlotBase(slot: number, owner: Player): Model
	local plotCFrame = MapParts.plotCFrame(slot)

	local model = Instance.new("Model")
	model.Name  = "Plot_" .. slot
	model:SetAttribute("PlotOwner", owner.UserId)

	-- Das Beet: eine quadratische Platte auf der Plot-Insel. Dunkles Gruen wie
	-- die Hauptinsel, darauf dieselben hellen Karos — nur plot-lokal gerastert,
	-- weil das Beet je nach Plot in einem anderen Winkel steht.
	local base = MapParts.newPart(
		"Base",
		MapConfig.PLOT_SIZE,
		plotCFrame * CFrame.new(0, MapConfig.PLOT_SIZE.Y * 0.5, 0),
		MapConfig.GRASS_DARK,
		Enum.Material.Grass
	)
	base.CanCollide = true
	base.Parent     = model

	MapParts.buildCheckerPlate(
		model,
		plotCFrame * CFrame.new(0, MapConfig.PLOT_SIZE.Y, 0),
		MapConfig.PLOT_SIZE.X,
		MapConfig.PLOT_SIZE.Z
	)

	model.PrimaryPart = base

	PlotBuilder.buildFence(model, slot)
	PlotBuilder.buildPlotSign(model, slot, owner.DisplayName)

	-- Der Spieler spawnt (und respawnt nach dem Tod) auf seiner EIGENEN
	-- Insel statt in der Weltmitte — siehe MapConfig.PLAYER_SPAWN_OFFSET fuer
	-- die Wahl der Stelle. Unsichtbar: sie soll wie ein normaler Fleck Wiese
	-- aussehen, kein Extra-Bodenbelag auf dem Plot.
	--
	-- `owner.RespawnLocation` direkt zu setzen (statt sich auf Roblox' eigene
	-- Naechste-SpawnLocation-Auswahl zu verlassen) ist entscheidend: mit acht
	-- SpawnLocations in der Welt (eine pro Plot) waere sonst nicht garantiert,
	-- dass ein Spieler nach dem Tod bei SEINER eigenen landet.
	--
	-- newPart baut nur ein normales Part — eine SpawnLocation braucht die
	-- eigene Roblox-Klasse (Instance.new("SpawnLocation")), deshalb hier von
	-- Hand statt ueber das gemeinsame Util.
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name          = "PlayerSpawn"
	spawnLocation.Size          = Vector3.new(6, 1, 6)
	spawnLocation.CFrame        = plotCFrame * CFrame.new(
		MapConfig.PLAYER_SPAWN_OFFSET.X,
		MapParts.plotSurfaceOffset() + MapConfig.PLAYER_SPAWN_OFFSET.Y + 0.5,
		MapConfig.PLAYER_SPAWN_OFFSET.Z
	)
	spawnLocation.Anchored      = true
	spawnLocation.CanCollide    = false
	spawnLocation.CanQuery      = false
	spawnLocation.Neutral       = true
	spawnLocation.Transparency  = 1
	spawnLocation.Duration      = 0   -- keine Unverwundbarkeits-Phase, das Spiel kennt kein PvP am Spawn
	spawnLocation.Parent        = model

	owner.RespawnLocation = spawnLocation

	model.Parent = workspace

	return model
end

-- Die Honig-Tropfen am Fuss eines Gebaeudes einmalig anlegen. Sie werden
-- danach nur noch ein- und ausgeblendet (writeBuildingState), nie neu gebaut:
-- ein Neuaufbau alle 20 Sekunden mal drei Gebaeude mal acht Spieler waere
-- fuer reine Deko viel zu teuer.
--
-- `ground` ist die Mitte der Grundflaeche des Gebaeudes, also derselbe
-- Ursprung wie fuer die Deko.
--
-- `slots` ist das GROESSTE Lager, das dieses Gebaeude je haben kann — nicht
-- sein aktuelles —, seit v15 aber hoechstens MapConfig.HONEY_DOT_MAX (das Lager
-- des Bienenstocks waechst bis 39). Ueberzaehlige Tropfen stoeren nicht:
-- sichtbar ist ein Tropfen erst, wenn wirklich Honig drin liegt
-- (writeBuildingState).
function PlotBuilder.buildHoneyDots(body: BasePart, ground: CFrame, slots: number)
	if slots <= 0 then return end

	-- Fester Abstand, bis der maximale Bogen erreicht ist — dann ruecken die
	-- Tropfen zusammen, statt sich um das ganze Gebaeude zu wickeln.
	local arc = math.min(
		math.rad(MapConfig.HONEY_DOT_ARC),
		math.rad(MapConfig.HONEY_DOT_SPACING) * math.max(1, slots - 1)
	)

	for i = 1, slots do
		-- Bogen mittig um -Z herum. Bei nur einem Punkt gibt es nichts zu
		-- verteilen — dann steht er genau vorne.
		local t     = if slots > 1 then (i - 1) / (slots - 1) - 0.5 else 0
		local angle = t * arc

		local offset = Vector3.new(
			math.sin(angle) * MapConfig.HONEY_DOT_RADIUS,
			MapConfig.HONEY_DOT_HEIGHT,
			-math.cos(angle) * MapConfig.HONEY_DOT_RADIUS
		)

		local dot = MapParts.newPart(
			"HoneyDot" .. i,
			Vector3.new(MapConfig.HONEY_DOT_SIZE, MapConfig.HONEY_DOT_SIZE, MapConfig.HONEY_DOT_SIZE),
			ground * CFrame.new(offset),
			MapConfig.HONEY_DOT_COLOR,
			Enum.Material.Neon
		)
		dot.Shape        = Enum.PartType.Ball
		dot.Transparency = 1        -- Startzustand: leeres Lager
		dot.CanCollide   = false
		dot.CanQuery     = false
		dot.CanTouch     = false
		dot.Parent       = body
	end
end

-- Alles am Gebaeude, was sich im Betrieb aendert: Schildtext, Honig-Tropfen
-- und der Vorrats-Wert fuer den Fuetter-Prompt. Getrennt vom Aufbau, weil das
-- bei JEDER Honig-Aenderung laeuft (siehe updateBuildingSigns) und deshalb
-- billig bleiben muss.
function PlotBuilder.writeBuildingState(part: BasePart, buildingData: Types.Building, pool: number)
	local config = MapConfig.BUILDING_OFFSETS[buildingData.id]
	if not config then return end

	-- Attribut statt eigenem Remote: der Client haengt seinen Fuetter-Prompt
	-- daran und bekommt jede Aenderung ohne Zutun mit.
	part:SetAttribute("HoneyPool", pool)

	-- Lager DIESES Gebaeudes auf DIESEM Level — beim Bienenstock waechst es mit.
	local capacity = BuildingBehavior.getCapacity(buildingData.id, buildingData.level)
	local honey    = math.clamp(buildingData.honey or 0, 0, capacity)

	-- Ein Tropfen pro eingelagertem Honig. Es koennen mehr Tropfen dastehen als
	-- das aktuelle Lager fasst (gebaut wird nach dem Maximal-Lager) — die
	-- ueberzaehligen bleiben unsichtbar. v15: ist das Lager groesser als
	-- HONEY_DOT_MAX, steht ein Tropfen fuer einen ANTEIL (voll = alle an).
	local dotCount = math.min(BuildingBehavior.getMaxCapacity(buildingData.id), MapConfig.HONEY_DOT_MAX)
	local lit = if capacity <= MapConfig.HONEY_DOT_MAX
		then honey
		else math.ceil(honey * MapConfig.HONEY_DOT_MAX / math.max(1, capacity))
	for i = 1, dotCount do
		local dot = part:FindFirstChild("HoneyDot" .. i)
		if dot and dot:IsA("BasePart") then
			dot.Transparency = if i <= lit then 0 else 1
		end
	end

	local sign = part:FindFirstChild("Sign")
	if not sign or not sign:IsA("BillboardGui") then return end

	local title = sign:FindFirstChild("Title")
	if title and title:IsA("TextLabel") then
		title.Text = string.format("%s  Lv.%d", config.displayName, buildingData.level)
	end

	local stock = sign:FindFirstChild("Stock")
	if stock and stock:IsA("TextLabel") then
		stock.Text = string.format("Honig %d / %d", honey, capacity)

		-- Volles Lager faellt farblich auf: dann steht die Produktion und es
		-- wird Zeit, zurueckzukommen und zu fuettern.
		stock.TextColor3 = if honey >= capacity
			then Color3.fromRGB(255, 215, 100)
			else Color3.fromRGB(235, 235, 235)
	end
end

-- Ein Gebaeude auf dem Plot.
-- Der Name der Part ist die BuildingId — der Client (WorldController) findet
-- darueber das Gebaeude fuer den ProximityPrompt.
--
-- Die Part selbst ist seit v5 unsichtbar und kollidiert nicht: sie ist nur
-- noch Trefferflaeche fuer den Prompt sowie Traeger von Name, Attribut und
-- Schild. Zu SEHEN und anzustossen ist ausschliesslich die Deko. Getrennt,
-- weil das Anklickbare und das Huebsche zwei verschiedene Dinge sind — sonst
-- muesste jede Formaenderung Ruecksicht auf die Trefferflaeche nehmen.
-- Partikel-Effekte des Looks an die gerade gebauten Deko-Teile haengen
-- (MapConfig.BUILDING_LOOK_FX / FX_PRESETS). Fehlt ein Teil, wird der Effekt
-- still uebersprungen — der Test honey_pond.test.lua faengt das vorher ab.
function PlotBuilder.addLookEffects(body: BasePart, buildingId: string, look: number)
	for _, fx in MapConfig.getLookFx(buildingId, look) do
		local target = body:FindFirstChild(fx.piece)
		local preset = MapConfig.FX_PRESETS[fx.preset]
		if target and target:IsA("BasePart") and preset then
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name          = "Fx_" .. fx.preset
			emitter.Texture       = preset.texture
			emitter.Color         = ColorSequence.new(preset.color)
			emitter.Size          = NumberSequence.new(preset.size[1], preset.size[2])
			emitter.Transparency  = NumberSequence.new(preset.transparency[1], preset.transparency[2])
			emitter.Lifetime      = NumberRange.new(preset.lifetime[1], preset.lifetime[2])
			emitter.Rate          = preset.rate
			emitter.Speed         = NumberRange.new(preset.speed[1], preset.speed[2])
			emitter.SpreadAngle   = Vector2.new(preset.spread, preset.spread)
			emitter.Acceleration  = preset.acceleration
			emitter.EmissionDirection = (Enum.NormalId :: any)[preset.emitFrom]
			emitter.LightEmission = preset.lightEmission
			emitter.Parent        = target
		end
	end
end

function PlotBuilder.buildBuilding(plotModel: Model, slot: number, buildingData: Types.Building, pool: number)
	local config = MapConfig.BUILDING_OFFSETS[buildingData.id]
	if not config then return end

	local plotCFrame = MapParts.plotCFrame(slot)
	local localY = MapParts.plotSurfaceOffset() + config.offset.Y + config.size.Y * 0.5

	local part = MapParts.newPart(
		buildingData.id,
		config.size,
		plotCFrame * CFrame.new(config.offset.X, localY, config.offset.Z),
		config.color,
		Enum.Material.SmoothPlastic
	)
	part.Transparency = 1
	part.CanCollide   = false
	part.Parent       = plotModel

	-- Ursprung von Deko UND Honig-Tropfen: Mitte der Grundflaeche des Gebaeudes
	-- auf Plot-Hoehe.
	local ground = plotCFrame * CFrame.new(
		config.offset.X,
		MapParts.plotSurfaceOffset() + config.offset.Y,
		config.offset.Z
	)

	-- v15: Grund-Deko plus die Zusaetze des aktuellen Looks.
	local look  = BuildingBehavior.getLook(buildingData.level)
	local decor = MapConfig.getBuildingDecor(buildingData.id, look)
	MapParts.buildDecor(part, ground, decor)
	PlotBuilder.addLookEffects(part, buildingData.id, look)

	PlotBuilder.buildHoneyDots(part, ground,
		math.min(BuildingBehavior.getMaxCapacity(buildingData.id), MapConfig.HONEY_DOT_MAX))

	-- Level als Attribut: der Client kann es direkt auslesen ohne eigenes Remote
	part:SetAttribute("BuildingLevel", buildingData.level)
	part:SetAttribute("Look", look)

	-- Schild ueber dem Gebaeude: Name, Level und Honig-Lagerstand. Ohne das
	-- muesste man fuer die Frage "ist schon wieder Honig da?" jedes Mal ein
	-- Panel oeffnen.
	--
	-- Die Hoehe richtet sich nach dem hoechsten Deko-Teil, nicht nach der
	-- Koerpergroesse: sonst haengt das Schild nach jeder Formaenderung falsch.
	-- StudsOffset zaehlt ab der MITTE der Part, deshalb die Halbierung.
	local topOfDecor = math.max(MapParts.decorHeight(decor), config.size.Y)

	local sign = Instance.new("BillboardGui")
	sign.Name         = "Sign"
	sign.Size         = UDim2.fromScale(9, 2.6)
	sign.StudsOffset  = Vector3.new(0, topOfDecor - config.size.Y * 0.5 + 2, 0)
	sign.AlwaysOnTop  = false
	sign.MaxDistance  = MapConfig.BUILDING_SIGN_DISTANCE
	sign.Adornee      = part
	sign.Parent       = part

	MapParts.newTextLabel("Title", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0))
	MapParts.newTextLabel("Stock", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0.5))

	PlotBuilder.writeBuildingState(part, buildingData, pool)
end

return PlotBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX69"><Properties>
<string name="Name">PondBuilder</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PondBuilder.luau
-- ServerScriptService/Util/MapBuild/PondBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Den Honig-Teich eines Plots bauen und seinen Fuellstand anzeigen
--
-- Der Fuellstand ist der gelagerte Honig aller Gebaeude (honeyPool). Der
-- ausgeruestete Baerchi isst am Steg (pondStand).
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types            = require(ReplicatedStorage.Network.Types)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local PondBuilder = {}

-- Der gesamte Honig-Vorrat einer Insel.
--
-- Wird als Attribut an JEDES Gebaeude geschrieben, nicht nur der eigene
-- Bestand: gefuettert wird auf der Baerchi-Detailkarte, und dort stehen alle
-- drei Vorraete nebeneinander zur Wahl. Wer vor dem Bienenstock steht, soll
-- deshalb sehen, dass ueberhaupt noch Honig da ist — auch wenn er im Honigtopf
-- nebenan liegt.
function PondBuilder.honeyPool(islandData: Types.IslandData): number
	local total = 0
	for _, building in islandData.buildings do
		total += math.max(0, building.honey or 0)
	end
	return total
end

-- Wie voll der Teich angezeigt wird: Anteil des GESAMTEN Honig-Vorrats an der
-- Lagermenge, die diese Insel auf ihren AKTUELLEN Leveln fasst.
--
-- Bewusst die aktuelle und nicht die theoretisch maximale Menge: der
-- Bienenstock vergroessert sein Lager mit jedem Level, und ein Teich, der nach
-- einem Ausbau ploetzlich leerer aussieht, waere die falsche Rueckmeldung.
-- So heisst "voller Teich" immer dasselbe — alle Lager sind voll.
function PondBuilder.pondFillRatio(islandData: Types.IslandData): number
	local capacity = BuildingBehavior.getTotalCapacity(islandData.buildings)
	if capacity <= 0 then return 0 end
	return math.clamp(PondBuilder.honeyPool(islandData) / capacity, 0, 1)
end

-- Der Boden-Ursprung des Teichs fuer einen Plot.
--
-- Mitte des Beckens auf Beet-Hoehe — dieselbe Rolle wie `ground` bei den
-- Gebaeuden, aber zusaetzlich GEDREHT: das lokale -Z zeigt zum Baerchi-Platz,
-- also dorthin, wo der Baerchi herkommt und beim Fressen steht. Genau
-- dieselbe Regel wie beim Plot-CFrame ("-Z zeigt dorthin, wo man herkommt"),
-- und der Grund, warum die Offsets in MapConfig.POND_DECOR ohne einen einzigen
-- Winkel auskommen.
--
-- Faellt die Richtung weg (Teich exakt auf dem Baerchi-Platz — kann nur durch
-- eine kaputte Config passieren), bleibt die Plot-Ausrichtung stehen: lieber
-- ein Teich, der in die falsche Richtung schaut, als gar keiner.
function PondBuilder.pondGround(slot: number): CFrame
	local plotCFrame = MapParts.plotCFrame(slot)

	-- Lage und Richtung aus MapLayout (HONEY_POND_V2: Teich in der Plot-Mitte
	-- hinten, Standplatz nach +Z; sonst wie bisher zum Baerchi-Platz).
	local offset = MapLayout.pondOffset()
	local center = CFrame.new(offset.X, MapParts.plotSurfaceOffset() + offset.Y, offset.Z)
	local toHome = MapLayout.pondFacing()

	-- CFrame.lookAt richtet -Z auf das Ziel aus (siehe buildPlotCFrame).
	local facing = CFrame.lookAt(center.Position, center.Position + toHome)
	return plotCFrame * facing
end

-- Der Standplatz vor dem Becken: teich-lokal auf -Z, um Beckenrand plus
-- Abstand von der Mitte entfernt. Hier landet der Baerchi, hier liegen die
-- Bohlen, und genau hier hat der Steinkranz seine Luecke.
function PondBuilder.pondStandDistance(): number
	return MapLayout.pondStandDistance()
end

function PondBuilder.pondStand(slot: number): CFrame
	return PondBuilder.pondGround(slot) * CFrame.new(0, 0, -PondBuilder.pondStandDistance())
end

-- Setzt die Fuellhoehe der "Fuellung"-Part auf den aktuellen Vorrat. Getrennt
-- vom Aufbau, weil das bei jeder Honig-Aenderung laeuft (siehe
-- updateBuildingSigns) und deshalb billig bleiben muss — kein Neuaufbau.
--
-- `ground` ist derselbe Ursprung wie beim Aufbau: die Fuellung waechst von
-- dort nach oben, statt ueber die WELT-Position herumzurechnen (die haengt
-- vom Plot-Winkel ab und ist dafuer ungeeignet).
function PondBuilder.writePondFill(fill: BasePart, ground: CFrame, ratio: number)
	-- Breiter UND hoeher (siehe MapConfig): nur hoeher waere aus der
	-- Spielerkamera kaum abzulesen, nur breiter saehe aus wie ein Aufkleber.
	local maxRadius = MapConfig.POND_RADIUS - MapConfig.POND_FILL_INSET
	local scale     = MapConfig.POND_FILL_MIN_SCALE
		+ (1 - MapConfig.POND_FILL_MIN_SCALE) * math.clamp(ratio, 0, 1)

	local radius = maxRadius * scale
	local height = MapConfig.POND_FILL_MIN_HEIGHT
		+ (MapConfig.POND_FILL_MAX_HEIGHT - MapConfig.POND_FILL_MIN_HEIGHT) * math.clamp(ratio, 0, 1)

	-- Der Honig steht AUF dem Beckenboden, nicht auf dem Beet.
	fill.CFrame = ground
		* CFrame.new(0, MapConfig.POND_FLOOR_TOP + height * 0.5, 0)
		* CFrame.Angles(0, 0, math.rad(90))
	fill.Size   = Vector3.new(height, radius * 2, radius * 2)

	fill.Transparency = if ratio <= 0 then 1 else MapConfig.POND_FILL_TRANSPARENCY
end

-- Eine der beiden flachen Scheiben des Beckens (Sandkante bzw. Beckenboden).
-- Beide sind dicker als der sichtbare Teil; der Rest steckt im Beet, damit
-- unten nichts durchscheint.
function PondBuilder.buildPondDisc(parent: Instance, ground: CFrame, name: string, radius: number, top: number, color: Color3, material: Enum.Material)
	local disc = MapParts.newPart(
		name,
		Vector3.new(MapConfig.POND_DISC_HEIGHT, radius * 2, radius * 2),
		ground * CFrame.new(0, top - MapConfig.POND_DISC_HEIGHT * 0.5, 0)
			* CFrame.Angles(0, 0, math.rad(90)),
		color,
		material
	)
	disc.Shape      = Enum.PartType.Cylinder
	disc.CanCollide = true
	disc.CanQuery   = false
	disc.Parent     = parent
end

-- Der Steinkranz: die Beckenwand.
--
-- Er laesst auf der Seite zum Baerchi-Platz eine Luecke frei — dieselbe Idee
-- wie beim Zaun um die Arena, und aus demselben Grund: durch eine Wand kommt
-- man nicht. Groessen und Farben wechseln reihum durch, damit es nach
-- gesammelten Feldsteinen aussieht und nicht nach einer Perlenkette.
function PondBuilder.buildPondStones(parent: Instance, ground: CFrame)
	local ringRadius = MapConfig.POND_RADIUS + MapConfig.POND_RIM_WIDTH * 0.5
	local gap        = math.rad(MapConfig.POND_STONE_GAP_DEGREES)

	-- Die Steine stehen bei (sin a, cos a): a = 0 ist teich-lokales +Z,
	-- a = pi ist -Z. Die Luecke liegt also bei pi.
	local gapAngle = math.pi

	for i = 1, MapConfig.POND_STONE_COUNT do
		local angle = (i - 1) * (2 * math.pi / MapConfig.POND_STONE_COUNT)

		-- Winkelabstand zur Luecke, immer als kuerzester Weg gemessen.
		local delta = math.abs(((angle - gapAngle + math.pi) % (2 * math.pi)) - math.pi)

		if delta > gap then
			local size  = MapConfig.POND_STONE_SIZES[((i - 1) % #MapConfig.POND_STONE_SIZES) + 1]
			local color = MapConfig.POND_STONE_COLORS[((i - 1) % #MapConfig.POND_STONE_COLORS) + 1]

			-- Etwas eingegraben: die Steine sollen im Sand liegen und nicht
			-- auf dem Boden balancieren. Sie sind leicht gestaucht, damit sie
			-- nach Feldsteinen aussehen und nicht nach Murmeln.
			local stone = MapParts.newPart(
				"Stein_" .. i,
				Vector3.new(size, size * 0.82, size),
				ground * CFrame.new(
					math.sin(angle) * ringRadius,
					MapConfig.POND_RIM_TOP + size * 0.30,
					math.cos(angle) * ringRadius
				),
				color,
				Enum.Material.Slate
			)
			stone.Shape      = Enum.PartType.Ball
			stone.CanCollide = true
			stone.CanQuery   = false
			stone.Parent     = parent
		end
	end
end

-- Die zwei Bohlen vor der Luecke, auf denen der Baerchi beim Fressen steht,
-- plus zwei Pfloecke daneben. Sie liegen um den Standplatz herum, den auch
-- MapService.getPondPosition zurueckgibt — eine Rechnung, kein zweiter Satz
-- Zahlen (siehe MapConfig.POND_STAND_GAP).
function PondBuilder.buildPondPlanks(parent: Instance, ground: CFrame)
	local stand = PondBuilder.pondStandDistance()
	local step: number = (MapConfig.POND_PLANK_SIZE.Z + MapConfig.POND_PLANK_GAP) * 0.5
	local y: number    = MapConfig.POND_PLANK_TOP - MapConfig.POND_PLANK_SIZE.Y * 0.5

	for i, offset in { -step, step } do
		local plank = MapParts.newPart(
			"Bohle_" .. i,
			MapConfig.POND_PLANK_SIZE,
			ground * CFrame.new(0, y, -stand + offset),
			MapConfig.POND_PLANK_COLORS[((i - 1) % #MapConfig.POND_PLANK_COLORS) + 1],
			Enum.Material.WoodPlanks
		)
		plank.CanCollide = false
		plank.CanQuery   = false
		plank.Parent     = parent
	end

	-- Pfloecke: liegende Zylinder quer zu den Bohlen, wie eingeschlagene
	-- Pfosten. UPRIGHT waere hier falsch — sie sollen liegen.
	for i, side in { -1, 1 } do
		local peg = MapParts.newPart(
			"Pflock_" .. i,
			MapConfig.POND_PEG_SIZE,
			ground * CFrame.new(side * MapConfig.POND_PEG_SPREAD, MapConfig.POND_PEG_SIZE.Y * 0.4, -stand)
				* CFrame.Angles(0, 0, math.rad(90)),
			MapConfig.POND_PLANK_COLORS[2],
			Enum.Material.Wood
		)
		peg.Shape      = Enum.PartType.Cylinder
		peg.CanCollide = false
		peg.CanQuery   = false
		peg.Parent     = parent
	end
end

-- Der Honig-Teich auf dem Plot: Sandkante, Steinkranz, abgesenkter Beckenboden
-- und darauf der Honig, dessen Flaeche und Hoehe den Gesamt-Vorrat zeigen. Der
-- ausgeruestete Baerchi laeuft zu den Bohlen davor, um zu essen (siehe
-- BaerchiAutopilotService).
function PondBuilder.buildPond(plotModel: Model, slot: number, islandData: Types.IslandData)
	local old = plotModel:FindFirstChild("Pond")
	if old then old:Destroy() end

	local ground = PondBuilder.pondGround(slot)

	local pond = Instance.new("Model")
	pond.Name   = "Pond"
	pond.Parent = plotModel

	-- Sandkante zuerst und TIEFER als der Beckenboden: nur so bleibt sie
	-- ringsum als Streifen sichtbar, ohne dass ein Ring aus Einzelteilen
	-- noetig waere — derselbe Trick wie am Ufer jeder Insel.
	PondBuilder.buildPondDisc(
		pond, ground, "Rand",
		MapConfig.POND_RADIUS + MapConfig.POND_RIM_WIDTH,
		MapConfig.POND_RIM_TOP,
		MapConfig.POND_RIM_COLOR,
		Enum.Material.Sand
	)
	PondBuilder.buildPondDisc(
		pond, ground, "Boden",
		MapConfig.POND_RADIUS,
		MapConfig.POND_FLOOR_TOP,
		MapConfig.POND_FLOOR_COLOR,
		Enum.Material.Slate
	)

	PondBuilder.buildPondStones(pond, ground)
	PondBuilder.buildPondPlanks(pond, ground)
	-- Mit HONEY_POND_V2 schmueckt der Brunnen (Gebaeude HoneyPond) das
	-- Becken; der Honigloeffel wuerde in seine Schale ragen.
	if not FeatureFlags.isOn("HONEY_POND_V2") then
		MapParts.buildDecor(pond, ground, MapConfig.POND_DECOR)
	end

	-- Als Platzhalter-Groesse angelegt — writePondFill setzt Groesse und
	-- Position gleich im Anschluss auf den echten Vorrat.
	local fill = MapParts.newPart(
		"Fuellung",
		Vector3.new(0.05, MapConfig.POND_RADIUS, MapConfig.POND_RADIUS),
		ground,
		MapConfig.POND_FILL_COLOR,
		Enum.Material.Neon
	)
	fill.Shape      = Enum.PartType.Cylinder
	fill.CanCollide = false
	fill.CanQuery   = false
	fill.CanTouch   = false
	fill.Parent     = pond

	PondBuilder.writePondFill(fill, ground, PondBuilder.pondFillRatio(islandData))
end

return PondBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX70"><Properties>
<string name="Name">ScenicBuilder</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- ScenicBuilder.luau
-- ServerScriptService/Util/MapBuild/ScenicBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Die feste Landschafts-Deko der Welt: Meeresboden, Schaumsaeume, Wege,
--     Laternen, Stegpfosten, Baeume, Buesche, Felsen, Pilze, Plot-Randdeko
--
-- Wird nur von WorldBuilder.buildPlatform aufgerufen, einmal beim Serverstart.
-- Alles landet in einem Ordner "Scenery" unter dem Platform-Model.
--
-- PERFORMANCE-REGELN, die hier fuer jede Part gelten:
--   * Anchored, CanCollide/CanQuery/CanTouch aus, CastShadow aus. Deko ist
--     reine Silhouette; nichts davon darf Physik, Klick-Raycasts oder
--     Schattenberechnung kosten.
--   * Einfache Formen (Ball, Zylinder, Block), keine MeshParts, keine Lichter.
--     "Leuchten" macht Neon + Bloom.
--   * Deterministischer Zufall (AmbienceConfig.SCENERY_SEED): jeder Server
--     baut dieselbe Welt, und es gibt keinen Netzwerk-Mehraufwand durch
--     staendig wechselnde Instanzen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local EggConfig      = require(ReplicatedStorage.Config.EggConfig)
local MapConfig      = require(ReplicatedStorage.Config.MapConfig)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)

local ScenicBuilder = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))   -- Zylinder liegen von Haus aus entlang X

type Placed = { x: number, z: number, r: number }

-- Eine Deko-Part mit allen Performance-Schaltern aus.
local function decorPart(
	name: string,
	parent: Instance,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	shape: Enum.PartType?
): Part
	local part = MapParts.newPart(name, size, cframe, color, material)
	part.Shape      = shape or Enum.PartType.Block
	part.CanCollide = false
	part.CanQuery   = false
	part.CanTouch   = false
	part.CastShadow = false
	part.Parent     = parent
	return part
end

-- Ein senkrecht stehender Zylinder: `height` ist seine Hoehe, `diameter` die Breite.
local function pole(name: string, parent: Instance, baseX: number, baseY: number, baseZ: number, height: number, diameter: number, color: Color3, material: Enum.Material): Part
	return decorPart(
		name, parent,
		Vector3.new(height, diameter, diameter),
		CFrame.new(baseX, baseY + height * 0.5, baseZ) * UPRIGHT,
		color, material, Enum.PartType.Cylinder
	)
end

local function ball(name: string, parent: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material): Part
	return decorPart(name, parent, size, cframe, color, material, Enum.PartType.Ball)
end

--------------------------------------------------------------------------------
-- Meeresboden und Schaum
--------------------------------------------------------------------------------

local function buildSeabed(parent: Instance)
	local radius = AmbienceConfig.SEABED_RADIUS
	local seabed = decorPart(
		"Seabed", parent,
		Vector3.new(2, radius * 2, radius * 2),
		CFrame.new(MapConfig.CENTER.X, AmbienceConfig.SEABED_Y, MapConfig.CENTER.Z) * UPRIGHT,
		AmbienceConfig.SEABED_COLOR,
		Enum.Material.Sand,
		Enum.PartType.Cylinder
	)
	seabed.Name = "Seabed"
end

-- Eine Schaumscheibe pro Insel. Sie liegt knapp ueber der Wasseroberflaeche und
-- unter der Sandkante: sichtbar ist nur der Rand, der ueber den Sand hinausragt.
local function buildFoam(parent: Instance, name: string, center: Vector3, islandRadius: number, phase: number)
	local radius = islandRadius + MapConfig.SHORE_WIDTH + AmbienceConfig.FOAM_REACH
	local y = MapConfig.PLATFORM_TOP_Y - MapConfig.WATER_DROP + 0.05

	local foam = decorPart(
		name, parent,
		Vector3.new(0.1, radius * 2, radius * 2),
		CFrame.new(center.X, y, center.Z) * UPRIGHT,
		AmbienceConfig.FOAM_COLOR,
		Enum.Material.SmoothPlastic,
		Enum.PartType.Cylinder
	)
	foam.Transparency = AmbienceConfig.FOAM_TRANSPARENCY
	-- Phase fuer den Client: jede Insel atmet versetzt, sonst pulsiert alles gleichzeitig.
	foam:SetAttribute("FoamPhase", phase)
end

--------------------------------------------------------------------------------
-- Streuung
--------------------------------------------------------------------------------

local function isFree(placed: { Placed }, x: number, z: number, r: number): boolean
	for _, other in placed do
		local dx = x - other.x
		local dz = z - other.z
		local minDist = r + other.r
		if dx * dx + dz * dz < minDist * minDist then
			return false
		end
	end
	return true
end

--------------------------------------------------------------------------------
-- Wege, Laternen, Stegpfosten
--------------------------------------------------------------------------------

local function buildPaths(parent: Instance)
	local fromRadius = MapConfig.EVENT_PIT_RADIUS - 1
	local toRadius   = MapConfig.PLATFORM_RADIUS - 4
	local length     = toRadius - fromRadius
	local y          = MapConfig.PLATFORM_TOP_Y + AmbienceConfig.PATH_LIFT

	for slot = 1, MapConfig.PLOT_COUNT do
		local outward = MapParts.outwardDirection(slot)
		local mid     = MapConfig.CENTER + outward * ((fromRadius + toRadius) * 0.5)
		local at      = Vector3.new(mid.X, y, mid.Z)

		decorPart(
			"Path_" .. slot, parent,
			Vector3.new(AmbienceConfig.PATH_WIDTH, 0.1, length),
			CFrame.lookAt(at, at + outward),
			AmbienceConfig.PATH_COLOR,
			Enum.Material.Cobblestone
		)
	end
end

local function buildLamps(parent: Instance, placed: { Placed })
	for slot = 1, MapConfig.PLOT_COUNT do
		local outward = MapParts.outwardDirection(slot)
		local side    = Vector3.new(-outward.Z, 0, outward.X)

		for _, radius in AmbienceConfig.LAMP_RADII do
			for _, sign in { -1, 1 } do
				local p = MapConfig.CENTER + outward * radius + side * (sign * AmbienceConfig.LAMP_SIDE)
				local baseY = MapConfig.PLATFORM_TOP_Y

				pole("LampPole", parent, p.X, baseY, p.Z, AmbienceConfig.LAMP_HEIGHT, 0.8,
					AmbienceConfig.LAMP_POLE_COLOR, Enum.Material.Wood)
				ball("LampGlow", parent, Vector3.new(2.2, 2.2, 2.2),
					CFrame.new(p.X, baseY + AmbienceConfig.LAMP_HEIGHT + 0.7, p.Z),
					AmbienceConfig.LAMP_GLOW_COLOR, Enum.Material.Neon)

				table.insert(placed, { x = p.X, z = p.Z, r = 2 })
			end
		end
	end
end

-- Pfosten mit Leuchtkappe an beiden Enden jedes inneren Stegs (Hauptinsel → Plot).
local function buildBridgePosts(parent: Instance)
	local deckTop = MapConfig.PLATFORM_TOP_Y - MapConfig.BRIDGE_SINK
	local sideOffset = (MapConfig.BRIDGE_WIDTH + MapConfig.BRIDGE_RAIL_WIDTH) * 0.5

	local fromRadius = MapConfig.PLATFORM_RADIUS
	local toRadius   = MapConfig.PLOT_RING_RADIUS - MapConfig.PLOT_ISLAND_RADIUS
	local inset      = AmbienceConfig.BRIDGE_POST_INSET

	for slot = 1, MapConfig.PLOT_COUNT do
		local outward = MapParts.outwardDirection(slot)
		local side    = Vector3.new(-outward.Z, 0, outward.X)

		for _, radius in { fromRadius + inset, toRadius - inset } do
			for _, sign in { -1, 1 } do
				local p = MapConfig.CENTER + outward * radius + side * (sign * sideOffset)

				pole("BridgePost", parent, p.X, deckTop, p.Z, AmbienceConfig.BRIDGE_POST_HEIGHT, 1.3,
					MapConfig.BRIDGE_RAIL_COLOR, Enum.Material.Wood)
				ball("BridgeCap", parent, Vector3.new(1.9, 1.9, 1.9),
					CFrame.new(p.X, deckTop + AmbienceConfig.BRIDGE_POST_HEIGHT + 0.5, p.Z),
					AmbienceConfig.LAMP_GLOW_COLOR, Enum.Material.Neon)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Hauptinsel: Baeume, Buesche, Felsen, Pilze
--------------------------------------------------------------------------------

local function buildMainIslandScenery(parent: Instance, placed: { Placed }, isOnLane: (Vector3, number) -> boolean)
	local random = Random.new(AmbienceConfig.SCENERY_SEED)

	-- Der versteckte Ei-Haendler bleibt frei, sonst steht er mitten im Busch.
	local merchant = EggConfig.MERCHANT
	local merchantAngle = math.rad(merchant.angleDegrees)
	table.insert(placed, {
		x = MapConfig.CENTER.X + merchant.radius * math.cos(merchantAngle),
		z = MapConfig.CENTER.Z + merchant.radius * math.sin(merchantAngle),
		r = AmbienceConfig.MERCHANT_CLEAR,
	})
	-- HBB Paket 5/6: Tafeln, Schau-Tuerme, neuer Haendler-Platz bleiben frei
	for _, landmark in MapLayout.landmarks() do
		table.insert(placed, { x = landmark.x, z = landmark.z, r = landmark.r + 2 })
	end

	local y = MapConfig.PLATFORM_TOP_Y

	-- Findet einen freien Platz auf dem Ring; nil, wenn nach 40 Versuchen keiner da ist.
	local function findSpot(footprint: number): (number?, number?)
		for _ = 1, 40 do
			local angle  = random:NextNumber(0, math.pi * 2)
			local radius = random:NextNumber(AmbienceConfig.SCENERY_INNER, AmbienceConfig.SCENERY_OUTER)
			local x = MapConfig.CENTER.X + radius * math.cos(angle)
			local z = MapConfig.CENTER.Z + radius * math.sin(angle)

			if not isOnLane(Vector3.new(x, y, z), AmbienceConfig.LANE_MARGIN)
				and isFree(placed, x, z, footprint) then
				table.insert(placed, { x = x, z = z, r = footprint })
				return x, z
			end
		end
		return nil, nil
	end

	-- Baeume: Stamm + zwei uebereinander gesetzte Kronen-Baelle.
	for i = 1, AmbienceConfig.TREE_COUNT do
		local x, z = findSpot(7)
		if x and z then
			local canopyColor = AmbienceConfig.TREE_CANOPY_COLORS[random:NextInteger(1, #AmbienceConfig.TREE_CANOPY_COLORS)]
			local scale = random:NextNumber(0.85, 1.25)
			local trunkHeight = 7 * scale

			pole("TreeTrunk", parent, x, y, z, trunkHeight, 1.8 * scale,
				AmbienceConfig.TREE_TRUNK_COLOR, Enum.Material.Wood)
			ball("TreeCrown", parent, Vector3.new(11, 9, 11) * scale,
				CFrame.new(x, y + trunkHeight + 2.5 * scale, z),
				canopyColor, Enum.Material.Grass)
			ball("TreeTop", parent, Vector3.new(7, 6, 7) * scale,
				CFrame.new(x, y + trunkHeight + 7 * scale, z),
				canopyColor, Enum.Material.Grass)
		end
	end

	-- Buesche: ein platter Ball.
	for i = 1, AmbienceConfig.BUSH_COUNT do
		local x, z = findSpot(3.5)
		if x and z then
			local size = random:NextNumber(4, 6.5)
			ball("Bush", parent, Vector3.new(size, size * 0.65, size),
				CFrame.new(x, y + size * 0.2, z) * CFrame.Angles(0, random:NextNumber(0, math.pi), 0),
				AmbienceConfig.BUSH_COLORS[random:NextInteger(1, #AmbienceConfig.BUSH_COLORS)],
				Enum.Material.Grass)
		end
	end

	-- Felsen: plattgedrueckte, verdrehte Baelle.
	for i = 1, AmbienceConfig.ROCK_COUNT do
		local x, z = findSpot(3.5)
		if x and z then
			local size = random:NextNumber(3, 6)
			ball("Rock", parent, Vector3.new(size, size * 0.6, size * random:NextNumber(0.7, 1.1)),
				CFrame.new(x, y + size * 0.12, z)
					* CFrame.Angles(random:NextNumber(-0.2, 0.2), random:NextNumber(0, math.pi * 2), random:NextNumber(-0.2, 0.2)),
				AmbienceConfig.ROCK_COLORS[random:NextInteger(1, #AmbienceConfig.ROCK_COLORS)],
				Enum.Material.Slate)
		end
	end

	-- Pilze: heller Stiel + roter Hut.
	for i = 1, AmbienceConfig.MUSHROOM_COUNT do
		local x, z = findSpot(2)
		if x and z then
			local scale = random:NextNumber(0.8, 1.5)
			pole("MushroomStem", parent, x, y, z, 2.2 * scale, 1.1 * scale,
				Color3.fromRGB(250, 240, 220), Enum.Material.SmoothPlastic)
			ball("MushroomCap", parent, Vector3.new(4, 2.4, 4) * scale,
				CFrame.new(x, y + 2.3 * scale, z),
				Color3.fromRGB(226, 76, 76), Enum.Material.SmoothPlastic)
		end
	end
end

--------------------------------------------------------------------------------
-- Plot-Inseln: Randdeko
--------------------------------------------------------------------------------

-- Felsen und Buesche in einem schmalen Ring am Inselrand, AUSSERHALB des Beets
-- und der Gebaeude. Die Stegachse (zur Mitte und zur Arena) bleibt frei.
local function buildPlotRims(parent: Instance)
	local random = Random.new(AmbienceConfig.SCENERY_SEED + 1)
	local y = MapConfig.PLATFORM_TOP_Y

	for slot = 1, MapConfig.PLOT_COUNT do
		local outward = MapParts.outwardDirection(slot)
		local perp    = Vector3.new(-outward.Z, 0, outward.X)
		local center  = MapConfig.CENTER + outward * MapConfig.PLOT_RING_RADIUS

		local placedCount = 0
		local attempts = 0
		while placedCount < AmbienceConfig.PLOT_RIM_COUNT and attempts < 60 do
			attempts += 1

			local angle  = random:NextNumber(0, math.pi * 2)
			local radius = random:NextNumber(AmbienceConfig.PLOT_RIM_MIN, AmbienceConfig.PLOT_RIM_MAX)
			local dx = radius * math.cos(angle)
			local dz = radius * math.sin(angle)

			-- Quer-Abstand zur Stegachse dieses Plots.
			local across = math.abs(dx * perp.X + dz * perp.Z)
			if across > AmbienceConfig.PLOT_RIM_LANE then
				local x = center.X + dx
				local z = center.Z + dz

				if placedCount % 2 == 0 then
					local size = random:NextNumber(2.4, 3.6)
					ball("RimRock", parent, Vector3.new(size, size * 0.6, size),
						CFrame.new(x, y + size * 0.1, z) * CFrame.Angles(0, random:NextNumber(0, math.pi), 0),
						AmbienceConfig.ROCK_COLORS[random:NextInteger(1, #AmbienceConfig.ROCK_COLORS)],
						Enum.Material.Slate)
				else
					local size = random:NextNumber(2.6, 3.8)
					ball("RimBush", parent, Vector3.new(size, size * 0.7, size),
						CFrame.new(x, y + size * 0.2, z),
						AmbienceConfig.BUSH_COLORS[random:NextInteger(1, #AmbienceConfig.BUSH_COLORS)],
						Enum.Material.Grass)
				end
				placedCount += 1
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

-- `isOnLane` kommt von WorldBuilder (isOnBridgeLane); als Parameter statt
-- require, damit die beiden Module sich nicht gegenseitig laden.
function ScenicBuilder.build(platform: Instance, isOnLane: (Vector3, number) -> boolean)
	if platform:FindFirstChild("Scenery") then
		return   -- schon gebaut
	end

	local folder = Instance.new("Folder")
	folder.Name = "Scenery"

	local placed: { Placed } = {}

	buildSeabed(folder)

	local foam = Instance.new("Folder")
	foam.Name = "Foam"
	foam.Parent = folder
	buildFoam(foam, "Foam_Main", MapConfig.CENTER, MapConfig.PLATFORM_RADIUS, 0)
	for slot = 1, MapConfig.PLOT_COUNT do
		local center = MapConfig.CENTER + MapParts.outwardDirection(slot) * MapConfig.PLOT_RING_RADIUS
		buildFoam(foam, "Foam_Plot" .. slot, center, MapConfig.PLOT_ISLAND_RADIUS, slot * 0.8)
	end

	buildPaths(folder)
	buildLamps(folder, placed)
	buildBridgePosts(folder)
	buildMainIslandScenery(folder, placed, isOnLane)
	buildPlotRims(folder)

	folder.Parent = platform
end

return ScenicBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX71"><Properties>
<string name="Name">WorldBuilder</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldBuilder.luau
-- ServerScriptService/Util/MapBuild/WorldBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Die feste Welt einmal beim Serverstart bauen: Wasser, Hauptinsel,
--     Plot- und Arena-Inseln samt Stegen, Blumen, Spawn, Honigmast, Event-Pit
--     und das globale Licht
--
-- Wird nur von MapService.init aufgerufen. Was pro Spieler gebaut wird, steht
-- in den anderen Buildern.
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local Lighting            = game:GetService("Lighting")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)
local SkyBuilder = require(ServerScriptService.Util.MapBuild.SkyBuilder)
local ScenicBuilder = require(ServerScriptService.Util.MapBuild.ScenicBuilder)

local WorldBuilder = {}

-- Liegt dieser Punkt auf einer der acht Bahnen von der Inselmitte zu einem Steg?
--
-- Blumen halten sich davon frei. NICHT weil sie im Weg waeren — sie
-- kollidieren nicht — sondern weil die freien Bahnen den Weg ZEIGEN: von der
-- Spawn-Mitte fuehrt zu jedem Steg eine blumenlose Gasse. Auf einer ringsum
-- gleich gruenen Insel ist das neben dem Honigmast die einzige Orientierung,
-- und sie kostet keine einzige zusaetzliche Part.
--
-- Die Bahn ist der Halbstreifen in Aussenrichtung des Plots: `along > 0` ist
-- "vor der Mitte", `across` der Abstand quer dazu.
function WorldBuilder.isOnBridgeLane(worldPosition: Vector3, margin: number): boolean
	local half = MapConfig.BRIDGE_WIDTH * 0.5 + margin

	for slot = 1, MapConfig.PLOT_COUNT do
		local outward = MapParts.outwardDirection(slot)
		local offset  = worldPosition - MapConfig.CENTER

		-- Abstand zur Steg-Achse: die Komponente quer zur Aussenrichtung.
		local along  = offset.X * outward.X + offset.Z * outward.Z
		local across = offset.X * outward.Z - offset.Z * outward.X

		if along > 0 and math.abs(across) <= half then
			return true
		end
	end
	return false
end

-- Blumen auf der freien Wiese der Hauptinsel. Rein optisch, damit die Flaeche
-- zwischen Spawn und Inselrand nicht leer wirkt. Deterministisch gesetzt
-- (fester Zufallsstartwert), damit die Welt bei jedem Server-Start gleich
-- aussieht — eine Map die sich bei jedem Neustart anders anfuehlt ist
-- verwirrend.
function WorldBuilder.buildFlowers(parent: Instance)
	if MapConfig.FLOWER_COUNT <= 0 then
		return
	end

	local random     = Random.new(MapConfig.FLOWER_SEED)
	-- Innere Kante ist jetzt der Rand des Event-Pits (frueher das kleine
	-- Spawn-Pad) — das Pit ist deutlich groesser, also braucht auch der freie
	-- Ring drumherum mehr Platz, sonst wuerden Blumen im Zaun stecken.
	local spawnEdge  = MapConfig.EVENT_PIT_RADIUS + 8
	local outerEdge  = MapConfig.PLATFORM_RADIUS - 12

	local stemY = MapConfig.PLATFORM_TOP_Y + MapConfig.FLOWER_STEM_SIZE.Y * 0.5
	local headY = MapConfig.PLATFORM_TOP_Y + MapConfig.FLOWER_STEM_SIZE.Y + MapConfig.FLOWER_HEAD_SIZE * 0.3

	local placed   = 0
	local attempts = 0

	-- Begrenzte Anzahl Versuche: liegt ein Los auf einem Steg, wird es
	-- verworfen statt verschoben — sonst haeuften sich die Blumen an den
	-- Steg-Kanten.
	while placed < MapConfig.FLOWER_COUNT and attempts < MapConfig.FLOWER_COUNT * 6 do
		attempts += 1

		local angle  = random:NextNumber(0, math.pi * 2)
		local radius = random:NextNumber(spawnEdge, outerEdge)
		local x = MapConfig.CENTER.X + radius * math.cos(angle)
		local z = MapConfig.CENTER.Z + radius * math.sin(angle)

		if not WorldBuilder.isOnBridgeLane(Vector3.new(x, MapConfig.PLATFORM_TOP_Y, z), 5) then
			local stem = MapParts.newPart(
				"FlowerStem",
				MapConfig.FLOWER_STEM_SIZE,
				CFrame.new(x, stemY, z),
				MapConfig.FLOWER_STEM_COLOR,
				Enum.Material.Grass
			)
			stem.CanCollide = false
			stem.Parent     = parent

			local color = MapConfig.FLOWER_COLORS[random:NextInteger(1, #MapConfig.FLOWER_COLORS)]
			local head = MapParts.newPart(
				"FlowerHead",
				Vector3.new(MapConfig.FLOWER_HEAD_SIZE, MapConfig.FLOWER_HEAD_SIZE, MapConfig.FLOWER_HEAD_SIZE),
				CFrame.new(x, headY, z),
				color,
				Enum.Material.SmoothPlastic
			)
			head.Shape      = Enum.PartType.Ball
			head.CanCollide = false
			head.Parent     = parent

			placed += 1
		end
	end
end

-- Das runde, eingezaeunte Podest in der Weltmitte. Siehe MapConfig, Abschnitt
-- "EVENT-PIT" fuer das Warum der Zahlen. Normalerweise ein schlichter Stall —
-- EventService faerbt Boden/Zaun/Ring waehrend eines Events um
-- (MapService.setEventPitTheme) und schreibt die Countdown-Tafel
-- (MapService.setEventBanner).
--
-- Acht Zaunluecken statt einer: das Pit liegt in der Mitte ALLER acht Stege,
-- nicht am Ende von nur einem. Jede Luecke sitzt exakt in der Aussenrichtung
-- eines Plots (outwardDirection) — wer von seiner Bruecke kommt, laeuft
-- geradewegs hinein.
function WorldBuilder.buildEventPit(parent: Instance)
	local container = Instance.new("Model")
	container.Name   = "EventPit"
	container.Parent = parent

	local center = MapConfig.CENTER

	-- Unterkante des Podests: bewusst NICHT direkt auf PLATFORM_TOP_Y (dort
	-- liegt schon die Kachel-Oberseite, siehe EVENT_PIT_GROUND_CLEARANCE) —
	-- sonst flimmert der Podestrand mit dem Rasen darunter statt sauber
	-- darueber zu stehen.
	local floorBottomY = MapConfig.PLATFORM_TOP_Y + MapConfig.EVENT_PIT_GROUND_CLEARANCE
	local floorY       = floorBottomY + MapConfig.EVENT_PIT_FLOOR_HEIGHT   -- Podest-Oberflaeche

	local floor = MapParts.newPart(
		"EventFloor",
		Vector3.new(MapConfig.EVENT_PIT_FLOOR_HEIGHT, MapConfig.EVENT_PIT_RADIUS * 2, MapConfig.EVENT_PIT_RADIUS * 2),
		CFrame.new(center.X, floorY - MapConfig.EVENT_PIT_FLOOR_HEIGHT * 0.5, center.Z)
			* CFrame.Angles(0, 0, math.rad(90)),
		MapConfig.EVENT_PIT_DEFAULT_FLOOR_COLOR,
		Enum.Material.WoodPlanks
	)
	floor.Shape = Enum.PartType.Cylinder
	floor.Parent = container

	-- Sockel-Ring am Podestfuss: anders als bei den Spieler-Arenen (dort ein
	-- SUNKENER Pit mit einem Ring, der grossteils im Boden verschwindet) steht
	-- dieses Podest ueber dem Boden — der Ring sitzt deshalb komplett OBERHALB
	-- der Grasflaeche, direkt am Fuss der Podestwand, und ist als kleiner
	-- Sockel-Kranz ringsum sichtbar statt im Boden zu verschwinden. Bleibt im
	-- Stall-Look ein mattes Braun und glimmt erst waehrend eines Events
	-- (siehe setEventPitTheme).
	local ringRadius = MapConfig.EVENT_PIT_RADIUS + MapConfig.EVENT_PIT_RING_OVERHANG
	local ring = MapParts.newPart(
		"EventRing",
		Vector3.new(MapConfig.EVENT_PIT_RING_HEIGHT, ringRadius * 2, ringRadius * 2),
		CFrame.new(center.X, floorBottomY + MapConfig.EVENT_PIT_RING_HEIGHT * 0.5, center.Z)
			* CFrame.Angles(0, 0, math.rad(90)),
		MapConfig.EVENT_PIT_DEFAULT_RING_COLOR,
		Enum.Material.SmoothPlastic
	)
	ring.Shape      = Enum.PartType.Cylinder
	ring.CanCollide = false
	ring.CanQuery   = false
	ring.Parent     = container

	-- Eine Luecken-Mitte pro Plot-Richtung.
	local gapAngles: { number } = {}
	for slot = 1, MapConfig.PLOT_COUNT do
		local outward = MapParts.outwardDirection(slot)
		table.insert(gapAngles, math.atan2(outward.Z, outward.X))
	end

	local gap        = math.rad(MapConfig.EVENT_PIT_FENCE_GAP_DEGREES)
	local postRadius = MapConfig.EVENT_PIT_RADIUS - MapConfig.EVENT_PIT_FENCE_INSET
	local postY      = floorY + MapConfig.EVENT_PIT_FENCE_SIZE.Y * 0.5

	for i = 1, MapConfig.EVENT_PIT_FENCE_COUNT do
		local angle = (i - 1) * (2 * math.pi / MapConfig.EVENT_PIT_FENCE_COUNT)

		local blocked = false
		for _, gapAngle in gapAngles do
			local delta = math.abs(((angle - gapAngle + math.pi) % (2 * math.pi)) - math.pi)
			if delta <= gap then
				blocked = true
				break
			end
		end

		if not blocked then
			local post = MapParts.newPart(
				"EventFence_" .. i,
				MapConfig.EVENT_PIT_FENCE_SIZE,
				CFrame.new(
					center.X + postRadius * math.cos(angle),
					postY,
					center.Z + postRadius * math.sin(angle)
				),
				MapConfig.EVENT_PIT_DEFAULT_FENCE_COLOR,
				Enum.Material.Wood
			)
			-- Wie beim Zaun der Spieler-Arenen (PIT_FENCE): reine Silhouette,
			-- kein Hindernis. Acht schmalere Luecken statt einer breiten lassen
			-- sonst zu wenig Spielraum, falls ein Pfosten optisch knapp am
			-- Bruecken-Rand steht.
			post.CanCollide = false
			post.CanQuery   = false
			post.Parent     = container
		end
	end

	-- Anzeigetafel: anders als bei den Spieler-Arenen IMMER eingeblendet — sie
	-- ist der einzige Ort, an dem der Event-Countdown steht, egal ob gerade
	-- ein Event laeuft oder die naechste Wartezeit herunterzaehlt.
	local anchor = MapParts.newPart(
		"EventBannerAnchor",
		Vector3.new(1, 1, 1),
		CFrame.new(center.X, floorY + MapConfig.EVENT_PIT_BANNER_HEIGHT, center.Z),
		MapConfig.EVENT_PIT_DEFAULT_FLOOR_COLOR,
		Enum.Material.SmoothPlastic
	)
	anchor.Transparency = 1
	anchor.CanCollide   = false
	anchor.CanQuery     = false
	anchor.CanTouch     = false
	anchor.Parent       = container

	local banner = Instance.new("BillboardGui")
	banner.Name        = "Banner"
	banner.Size        = UDim2.fromScale(MapConfig.EVENT_PIT_BANNER_SIZE.X, MapConfig.EVENT_PIT_BANNER_SIZE.Y)
	banner.AlwaysOnTop = false
	banner.MaxDistance = MapConfig.EVENT_PIT_BANNER_DISTANCE
	banner.Adornee     = anchor
	banner.Enabled     = true
	banner.Parent      = anchor

	-- Drei feste Zeilen: Titel, Zeit, Belohnung. Die Zeit hat eine EIGENE
	-- kurze Zeile: stand sie mit der Belohnung in einem Text, aenderte sich
	-- dessen Breite jede Sekunde und TextScaled brach abwechselnd in eine und
	-- zwei Zeilen um (Flackern, Playtest 05.10.).
	local bannerTitle = MapParts.newTextLabel("Title", banner, UDim2.fromScale(1, 0.45), UDim2.fromScale(0, 0))
	bannerTitle.Text  = "..."
	bannerTitle.TextColor3 = MapConfig.EVENT_PIT_BANNER_IDLE_COLOR
	MapParts.newTextLabel("Sub", banner, UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0.45))
	MapParts.newTextLabel("Reward", banner, UDim2.fromScale(1, 0.25), UDim2.fromScale(0, 0.75))
end

-- Die ganze feste Welt: Wasser, Hauptinsel, die acht Plot-Inseln und die acht
-- Stege dazwischen, Blumen, Spawn und Honigmast. Wird nur EINMAL beim
-- Server-Start aufgerufen, nicht pro Spieler.
--
-- Globales Post-Processing: Bloom, Farbsaettigung, dezente Sonnenstrahlen.
--
-- Einmal in MapService.init() gesetzt, wirkt auf die GESAMTE Welt — kein
-- Aufwand pro Plot oder Figur. Siehe DESIGN_VORSCHLAG_TRENDANALYSE_2026-09-11.md
-- Abschnitt 5: der grosse Hebel hier ist nicht ein einzelner Effekt, sondern
-- dass es diese Objekte bisher ueberhaupt nicht gab — Lighting stand auf den
-- Roblox-Standardwerten.
--
-- Bewusst idempotent (FindFirstChild-Pruefung wie buildPlatform): ein
-- Server-Neustart im selben Studio-Prozess soll keine zweiten Kopien anlegen.
-- Eine Tafel auf der Hauptinsel (zwei Pfosten, ein Brett mit SurfaceGui:
-- Titel + cfg.lines Zeilen), Schrift nach aussen. Beschriftet wird sie ueber
-- MapService (Bestenliste: writeLeaderboardBoard, Live: writeLiveBoard).
type BoardCfg = {
	angleDegrees : number,
	radius       : number,
	size         : Vector3,
	postHeight   : number,
	color        : Color3,
	textColor    : Color3,
	lines        : number,
}

local function buildBoard(parent: Instance, name: string, cfg: BoardCfg): BasePart
	local angle = math.rad(cfg.angleDegrees)
	local outward = Vector3.new(math.cos(angle), 0, math.sin(angle))
	local groundY = MapConfig.PLATFORM_TOP_Y
	local base = MapConfig.CENTER + outward * cfg.radius
	local center = Vector3.new(base.X, groundY + cfg.postHeight + cfg.size.Y * 0.5, base.Z)
	local frame = CFrame.lookAt(center, center + outward)

	local board = MapParts.newPart(name, cfg.size, frame, cfg.color, Enum.Material.Wood)
	board.CanCollide = true
	board.Parent = parent

	for _, side in { -1, 1 } do
		local postHeight = cfg.postHeight + cfg.size.Y
		local post = MapParts.newPart(
			name .. "Post",
			Vector3.new(0.8, postHeight, 0.8),
			frame * CFrame.new(side * (cfg.size.X * 0.5 - 0.6), -cfg.size.Y * 0.5 - cfg.postHeight + postHeight * 0.5, 0.8),
			cfg.color,
			Enum.Material.Wood
		)
		post.CanCollide = true
		post.Parent = parent
	end

	local surface = Instance.new("SurfaceGui")
	surface.Name          = "Board"
	surface.Face          = Enum.NormalId.Front
	surface.PixelsPerStud = 30
	surface.Adornee       = board
	surface.Parent        = board

	local title = MapParts.newTextLabel("Title", surface, UDim2.fromScale(1, 0.14), UDim2.fromScale(0, 0.01))
	title.TextColor3 = cfg.textColor
	title.Text = ""

	local lineHeight = 0.84 / cfg.lines
	for i = 1, cfg.lines do
		local line = MapParts.newTextLabel("Line" .. i, surface,
			UDim2.fromScale(0.94, lineHeight * 0.9), UDim2.fromScale(0.03, 0.15 + (i - 1) * lineHeight))
		line.TextXAlignment = Enum.TextXAlignment.Left
		line.TextColor3 = cfg.textColor
		line.Text = ""
	end

	return board
end

-- v15: die Bestenlisten-Tafel auf der Hauptinsel. HBB Paket 5: mit
-- `angleDegrees`/`name` mehrfach (eine feste Tafel je Liste, siehe
-- MapLayout.leaderboardBoards); ohne = die eine wechselnde Tafel wie bisher.
function WorldBuilder.buildLeaderboardBoard(parent: Instance, angleDegrees: number?, name: string?): BasePart
	local cfg = table.clone(MapConfig.LEADERBOARD_BOARD) :: any
	cfg.angleDegrees = angleDegrees or cfg.angleDegrees
	return buildBoard(parent, name or "LeaderboardBoard", cfg)
end

-- HBB Paket 6: Live-Kampf-Board (MapConfig.LIVE_BOARD)
function WorldBuilder.buildLiveBoard(parent: Instance): BasePart
	return buildBoard(parent, "LiveBoard", MapConfig.LIVE_BOARD :: any)
end

-- HBB Paket 6: Wespen-Nest am Honigmast (MapConfig.WASP_NEST). Koerper,
-- zwei Streifen, Flugloch, darueber ein Schild mit der Zeit bis zum Boss.
-- Teile: 4 + Schild-Anker. Leuchten schaltet MapService.setWaspNest um.
function WorldBuilder.buildWaspNest(parent: Instance, center: Vector3): Model
	local cfg = MapConfig.WASP_NEST
	local nest = Instance.new("Model")
	nest.Name = "WaspNest"

	local function piece(name: string, shape: Enum.PartType, size: Vector3, frame: CFrame, color: Color3): BasePart
		local part = MapParts.newPart(name, size, frame, color, Enum.Material.SmoothPlastic)
		part.Shape      = shape
		part.CanCollide = false
		part.CanQuery   = false
		part.CanTouch   = false
		part.CastShadow = false
		part.Parent     = nest
		return part
	end

	local body = piece("Body", Enum.PartType.Ball, cfg.bodySize, CFrame.new(center), cfg.color)
	body.Material = Enum.Material.Sand
	for i, dy in { 0.8, -0.8 } do
		piece("Stripe" .. i, Enum.PartType.Cylinder,
			Vector3.new(0.35, cfg.bodySize.X * 0.98, cfg.bodySize.Z * 0.98),
			CFrame.new(center + Vector3.new(0, dy, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			cfg.stripeColor)
	end
	-- Flugloch nach aussen (weg vom Mast)
	local away = Vector3.new(cfg.offset.X, 0, cfg.offset.Z)
	away = if away.Magnitude > 1e-3 then away.Unit else Vector3.new(1, 0, 0)
	piece("Hole", Enum.PartType.Ball, Vector3.new(1.2, 1.2, 1.2),
		CFrame.new(center + away * (cfg.bodySize.X * 0.47) + Vector3.new(0, -1.2, 0)),
		cfg.stripeColor)

	local anchor = MapParts.newPart("SignAnchor", Vector3.new(1, 1, 1),
		CFrame.new(center + Vector3.new(0, cfg.bodySize.Y * 0.5 + cfg.signGap, 0)), cfg.glowColor, Enum.Material.SmoothPlastic)
	anchor.Transparency = 1
	anchor.CanCollide   = false
	anchor.CanQuery     = false
	anchor.CanTouch     = false
	anchor.Parent       = nest

	local sign = Instance.new("BillboardGui")
	sign.Name        = "Sign"
	sign.Size        = UDim2.fromScale(8, 2.2)
	sign.AlwaysOnTop = false
	sign.MaxDistance = cfg.signDistance
	sign.Adornee     = anchor
	sign.Parent      = anchor
	local title = MapParts.newTextLabel("Title", sign, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	title.TextColor3 = cfg.glowColor
	title.Text = ""

	nest.Parent = parent
	return nest
end

function WorldBuilder.buildGlobalLighting()
	if Lighting:FindFirstChild("BaerchiBloom") then
		return   -- schon gesetzt
	end

	-- Himmel, Atmosphaere, Wolken, Tageszeit: siehe SkyBuilder / AmbienceConfig.
	-- (MapConfig.LIGHTING_CLOCK_TIME ist damit abgeloest: die Tageszeit steht
	-- jetzt in AmbienceConfig.CLOCK_TIME.)
	SkyBuilder.build()

	local bloom = Instance.new("BloomEffect")
	bloom.Name      = "BaerchiBloom"
	bloom.Intensity = MapConfig.LIGHTING_BLOOM_INTENSITY
	bloom.Threshold = MapConfig.LIGHTING_BLOOM_THRESHOLD
	bloom.Size      = MapConfig.LIGHTING_BLOOM_SIZE
	bloom.Parent    = Lighting

	local colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name       = "BaerchiColorCorrection"
	colorCorrection.Saturation = MapConfig.LIGHTING_SATURATION
	colorCorrection.Contrast   = MapConfig.LIGHTING_CONTRAST
	colorCorrection.Parent     = Lighting

	local sunRays = Instance.new("SunRaysEffect")
	sunRays.Name      = "BaerchiSunRays"
	sunRays.Intensity = MapConfig.LIGHTING_SUNRAYS_INTENSITY
	sunRays.Spread    = MapConfig.LIGHTING_SUNRAYS_SPREAD
	sunRays.Parent    = Lighting
end

-- WARUM DIE PLOT-INSELN HIER STEHEN UND NICHT BEI buildPlotBase:
-- Eine Insel gehoert zur Landschaft, nicht zum Spieler. Wuerden sie mit dem
-- Plot-Model eines Spielers entstehen und vergehen, waere die Welt bei zwei
-- Spielern ein Ozean mit zwei Inseln darin, und beim Verlassen verschwaende
-- mitten im Bild ein Stueck Land. Auf einer leeren Insel steht dann eben
-- nichts — den Weg dorthin gibt es trotzdem. Was dem SPIELER gehoert (Beet,
-- Zaun, Schild, Gebaeude, Arena), baut buildPlotBase darauf.
function WorldBuilder.buildPlatform()
	if workspace:FindFirstChild("Platform") then
		return   -- schon gebaut
	end

	local model = Instance.new("Model")
	model.Name = "Platform"

	-- Das Wasser zuerst: eine einzige grosse Scheibe unter allem.
	--
	-- Sie ist begehbar. Wer von einem Steg faellt, landet auf der Oberflaeche
	-- und laeuft zurueck, statt ins Leere zu stuerzen — in einem Spiel, in dem
	-- man staendig ueber schmale Stege laeuft, ist das die freundlichere
	-- Loesung (siehe MapConfig).
	local water = MapParts.newPart(
		"Water",
		Vector3.new(MapConfig.WATER_HEIGHT, MapConfig.WATER_RADIUS * 2, MapConfig.WATER_RADIUS * 2),
		CFrame.new(
			MapConfig.CENTER.X,
			MapConfig.PLATFORM_TOP_Y - MapConfig.WATER_DROP - MapConfig.WATER_HEIGHT * 0.5,
			MapConfig.CENTER.Z
		) * CFrame.Angles(0, 0, math.rad(90)),
		MapConfig.WATER_COLOR,
		Enum.Material.Water
	)
	water.Shape        = Enum.PartType.Cylinder
	water.Transparency = MapConfig.WATER_TRANSPARENCY
	water.CanQuery     = false
	water.Parent       = model

	-- Hauptinsel: dunkle Wiesenscheibe mit Sandkante, darauf die hellen Karos.
	MapParts.buildIsland(
		model,
		"Ground",
		MapConfig.CENTER,
		MapConfig.PLATFORM_RADIUS,
		MapConfig.GRASS_DARK,
		Enum.Material.Grass
	)
	MapParts.buildCheckerDisc(model, MapConfig.CENTER.X, MapConfig.CENTER.Z, MapConfig.PLATFORM_RADIUS)

	-- Die acht Plot-Inseln und die Stege dorthin.
	for slot = 1, MapConfig.PLOT_COUNT do
		local outward = MapParts.outwardDirection(slot)
		local center  = MapConfig.CENTER + outward * MapConfig.PLOT_RING_RADIUS

		MapParts.buildIsland(
			model,
			"PlotIsland_" .. slot,
			center,
			MapConfig.PLOT_ISLAND_RADIUS,
			MapConfig.PLOT_ISLAND_COLOR,
			Enum.Material.Grass
		)

		MapParts.buildSpan(
			model,
			"BridgeInner_" .. slot,
			outward,
			MapConfig.PLATFORM_RADIUS,
			MapConfig.PLOT_RING_RADIUS - MapConfig.PLOT_ISLAND_RADIUS
		)
	end

	WorldBuilder.buildFlowers(model)

	-- Das Event-Pit in der Mitte — siehe buildEventPit oben.
	WorldBuilder.buildEventPit(model)

	-- Der Honigmast steht jetzt auf dem Event-Pit-Podest statt auf einem
	-- eigenen Spawn-Pad (das gibt es nicht mehr, siehe Not-Spawn unten) — er
	-- bleibt derselbe Orientierungspunkt, den man von jeder Insel aus sieht,
	-- nur jetzt mittig im Stall statt auf einer separaten Platte.
	local mast = Instance.new("Model")
	mast.Name = "Honigmast"
	MapParts.buildDecor(
		mast,
		CFrame.new(
			MapConfig.CENTER.X,
			MapConfig.PLATFORM_TOP_Y + MapConfig.EVENT_PIT_GROUND_CLEARANCE + MapConfig.EVENT_PIT_FLOOR_HEIGHT,
			MapConfig.CENTER.Z
		),
		MapConfig.CENTER_DECOR
	)
	mast.Parent = model

	-- Not-Spawn: seit dem Insel-Spawn (siehe buildPlotBase → PLAYER_SPAWN_OFFSET
	-- und PlayerService.onPlayerAdded) spawnt hier niemand mehr normalerweise.
	-- Der einzige Fall, der diesen Pad noch braucht, ist ein voller Server
	-- (MapService.spawnIsland findet keinen freien Slot mehr) — dann bekommt
	-- der Spieler nie ein RespawnLocation gesetzt und faellt auf den naechsten
	-- SpawnLocation in der Welt zurueck. Unsichtbar, damit er nicht als
	-- zweiter Bodenbelag unter dem Event-Pit durchscheint.
	if not workspace:FindFirstChildOfClass("SpawnLocation") then
		local spawnPad = Instance.new("SpawnLocation")
		spawnPad.Name          = "FallbackSpawn"
		spawnPad.Size          = MapConfig.SPAWN_SIZE
		spawnPad.CFrame        = CFrame.new(
			MapConfig.CENTER.X,
			MapConfig.PLATFORM_TOP_Y + MapConfig.EVENT_PIT_GROUND_CLEARANCE + MapConfig.EVENT_PIT_FLOOR_HEIGHT + MapConfig.SPAWN_SIZE.Y * 0.5,
			MapConfig.CENTER.Z + MapConfig.EVENT_PIT_RADIUS * 0.5
		)
		spawnPad.Anchored      = true
		spawnPad.Transparency  = 1
		spawnPad.CanCollide    = false
		spawnPad.Color         = MapConfig.SPAWN_COLOR
		spawnPad.Material      = Enum.Material.SmoothPlastic
		spawnPad.TopSurface    = Enum.SurfaceType.Smooth
		spawnPad.BottomSurface = Enum.SurfaceType.Smooth
		spawnPad.Parent        = model
	end

	-- Landschafts-Deko (Meeresboden, Schaum, Wege, Laternen, Baeume ...).
	ScenicBuilder.build(model, WorldBuilder.isOnBridgeLane)

	model.Parent = workspace
	print(
		"[MapService] Welt gebaut | Hauptinsel:", MapConfig.PLATFORM_RADIUS,
		"| Plot-Inseln:", MapConfig.PLOT_COUNT, "bei", MapConfig.PLOT_RING_RADIUS,
		"| Wasser:", MapConfig.WATER_RADIUS
	)
end

return WorldBuilder
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="RBX72"><Properties>
<string name="Name">PlayerMigration</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PlayerMigration.luau
-- ServerScriptService/Util/PlayerMigration.luau
--
-- Einzige Zustaendigkeit:
--   - Einen geladenen Spielstand beliebiger frueherer Version auf die aktuelle
--     Struktur (Types.PlayerData) bringen
--
-- Gehoert fachlich zu PlayerService und wird nur von dort aufgerufen. Es ist
-- ein eigenes Modul, weil es eine reine Funktion ist (Tabelle rein, Tabelle
-- raus, kein DataStore, kein Spieler-Objekt) und deshalb ohne Studio getestet
-- werden kann: tools/luau-tests/migration.test.lua schickt alte Spielstaende
-- hindurch und prueft das Ergebnis gegen Types.createDefaultPlayerData.
--
-- Regel fuer neue Felder: jedes Feld, das in Types.PlayerData dazukommt, wird
-- hier nachgeruestet (oder ausdruecklich begruendet, warum nil reicht). Eine
-- Migration, die Werte UMRECHNET statt Fehlendes anzulegen, haengt an
-- data.version und darf nur einmal laufen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local PromotionConfig  = require(ReplicatedStorage.Config.PromotionConfig)
local CharmConfig      = require(ReplicatedStorage.Config.CharmConfig)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggTree          = require(ReplicatedStorage.Modules.EggTree)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local FeatureFlags     = require(ReplicatedStorage.Config.FeatureFlags)
local HoneyPondMode    = require(ReplicatedStorage.Modules.HoneyPondMode)

local PlayerMigration = {}

-- Fehlende Felder aus Default auffuellen (einfache Migration fuer neue Felder).
-- Muss jedes Feld abdecken das seit dem ersten Release in Types.luau
-- dazugekommen ist — sonst crasht alter Save-Stand beim ersten Zugriff.
function PlayerMigration.applyDefaults(data: Types.PlayerData): Types.PlayerData
	local default = Types.createDefaultPlayerData()

	-- Neue Top-Level-Felder
	if data.gummies      == nil then data.gummies      = default.gummies      end
	if data.goldGummies  == nil then data.goldGummies  = default.goldGummies  end
	if data.rebirthCount == nil then data.rebirthCount = default.rebirthCount end
	if data.rebirthMult  == nil then data.rebirthMult  = default.rebirthMult  end
	if data.rank         == nil then data.rank         = default.rank         end
	if data.island       == nil then data.island       = default.island       end
	if data.stats        == nil then data.stats        = default.stats        end
	if data.createdAt    == nil then data.createdAt    = default.createdAt    end
	if data.lastSeenAt   == nil then data.lastSeenAt   = default.lastSeenAt   end

	-- Neue Stats-Felder (dynamischer Key → bewusst ueber any, sonst meckert --!strict)
	local stats     = data.stats    :: any
	local defStats  = default.stats :: any

	-- HBB Paket 10: Sitzungszaehler. Ein Konto, das schon aelter als 10 min
	-- ist, war mindestens einmal da — es zaehlt als 1, damit Veteranen den
	-- Shop schon bei diesem Join (= Sitzung 2, PlayerService zaehlt hoch) sehen.
	if stats.sessions == nil then
		stats.sessions = if os.time() - (data.createdAt or os.time()) >= 600 then 1 else 0
	end
	for key, value in defStats do
		if stats[key] == nil then
			stats[key] = value
		end
	end

	-- highestTowerFloor gehoerte zu einem Tower-Modus, den es nicht gibt. Das
	-- Feld wird entfernt, damit es nicht bei jedem Speichern wieder im
	-- DataStore landet. Am Feld erkennbar und deshalb ohne Versions-Sprung
	-- wiederholbar; ein Wert geht nicht verloren, er war immer 0.
	stats.highestTowerFloor = nil

	-- Neue Island-Felder
	local island = data.island
	if island.baerchis  == nil then island.baerchis  = {} end
	if island.eggStock  == nil then island.eggStock  = { BasicEgg = 3 } end

	-- language: kein Nachruesten noetig — nil bedeutet "automatisch" (die
	-- Roblox-Sprache des Clients), und genau das soll ein alter Spielstand
	-- bekommen. Kein Versions-Sprung. Siehe SettingsService.
	--
	-- v6: equippedUid. Kein Nachruesten noetig — ein fehlendes Feld liest
	-- sich in Lua ohnehin als nil, und IslandService.autoEquipIfNone laeuft
	-- bei jedem Join (onDataLoaded) und ruestet automatisch den ersten
	-- vorhandenen Baerchi aus, falls noch/wieder keiner steht.

	-- ============================================================
	-- ============================================================
	-- v13: QUESTS + INDEX
	-- ============================================================
	-- Neue Felder: discovered, quests, stats.totalHatched (das Stats-Feld legt
	-- die Schleife oben schon mit 0 an). Fuer Spielstaende VOR v13 wird
	-- discovered aus den vorhandenen Baerchis gesaeet und totalHatched auf
	-- deren Anzahl gesetzt, damit Veteranen nicht bei null anfangen.
	if data.discovered == nil then
		data.discovered = {}
		for _, baerchi in data.island.baerchis do
			data.discovered[baerchi.configId] = true
		end
	end

	if (data.version or 0) < 13 then
		local owned = 0
		for _ in data.island.baerchis do owned += 1 end
		data.stats.totalHatched = math.max(data.stats.totalHatched or 0, owned)
	end

	-- HBB Paket 3: uiSeen. Leer nachruesten; UiStateService markiert beim
	-- ersten Laden eines Stands mit Fortschritt alles Sichtbare als gesehen
	-- (keine Badge-Flut fuer Veteranen). Kein Versions-Sprung.
	if data.uiSeen == nil then
		data.uiSeen = {}
	end

	-- HBB Paket 10: Shop-Teil. Leer nachruesten, kaputte Felder reparieren.
	local shop = (data :: any).shop
	if typeof(shop) ~= "table" then
		(data :: any).shop = default.shop
	else
		if typeof(shop.freeGrabDay) ~= "number" then shop.freeGrabDay = -1 end
		if typeof(shop.receipts) ~= "table" then shop.receipts = {} end
	end

	if data.quests == nil then
		data.quests = default.quests
	end

	-- ============================================================
	-- v14: EI-BAUM (Mega Egg Tree)
	-- ============================================================
	-- Neues Top-Level-Feld eggTree (ausserhalb der Insel, damit ein Rebirth
	-- es nicht loescht). Bestandsspieler bekommen die Knoten der Eier frei,
	-- die sie schon im Lager haben oder die auf ihrem Plot liegen — wer ein
	-- Goldenes Ei besitzt, soll es nicht ploetzlich "gesperrt" sehen. Die
	-- Rebirth-Knoten (Ascensions-Pfad) schaltet evaluate unten frei.
	--
	-- Gefahrlos wiederholbar: sanitize ergaenzt nur Fehlendes, und die
	-- Lager-Freischaltung laeuft nur fuer Spielstaende vor v14.
	local hadTree = data.eggTree ~= nil
	data.eggTree = EggTree.sanitize(data.eggTree)
	if not hadTree and (data.version or 0) < 14 then
		for eggType, count in island.eggStock do
			if (count or 0) > 0 and EggConfig.data[eggType] then
				data.eggTree.unlocked[eggType] = true
			end
		end
		for _, egg in (island.laidEggs or {}) do
			if EggConfig.data[egg.eggType] then
				data.eggTree.unlocked[egg.eggType] = true
			end
		end
	end
	-- Unbekannte Ei-Typen im Lager (alte Config) werden zum Basis-Ei.
	local stockAny = island.eggStock :: any
	for eggType, count in stockAny do
		if not EggConfig.data[eggType] then
			stockAny.BasicEgg = (stockAny.BasicEgg or 0) + (tonumber(count) or 0)
			stockAny[eggType] = nil
		end
	end
	EggTree.evaluate(data)

	-- v12: BRUT-SLOTS ENTFALLEN (Eier werden sofort geoeffnet)
	-- ============================================================
	-- Alte Spielstaende koennen noch laufende oder fertige Bruten in
	-- island.hatchingEggs haben. Die gehen NICHT verloren: jedes Ei wandert
	-- als ungeoeffnetes Ei zurueck ins Lager, danach wird das Feld entfernt.
	-- Ein Ei-Typ, den es nicht mehr gibt, wird zum Basis-Ei (dieselbe Regel,
	-- die frueher beim Abholen galt).
	--
	-- Gefahrlos wiederholbar: beim zweiten Durchlauf ist das Feld schon nil.
	-- Ueber `any`, weil Types.IslandData das Feld seit v12 nicht mehr kennt.
	local legacyIsland = island :: any
	if legacyIsland.hatchingEggs ~= nil then
		if typeof(legacyIsland.hatchingEggs) == "table" then
			for _, egg in legacyIsland.hatchingEggs do
				local eggType = if typeof(egg) == "table" then egg.eggType else nil
				if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then
					eggType = "BasicEgg"
				end
				local stock = island.eggStock :: any
				stock[eggType] = (stock[eggType] or 0) + 1
			end
		end
		legacyIsland.hatchingEggs = nil
	end

	-- v12: pitProgress muss nur gueltig sein, wenn es da ist (nil = kein
	-- gespeicherter Lauf). Ein halber Eintrag wird verworfen statt geraten.
	local progress = legacyIsland.pitProgress
	if progress ~= nil and (typeof(progress) ~= "table"
		or typeof(progress.pitLevel) ~= "number"
		or typeof(progress.reachedStage) ~= "number")
	then
		legacyIsland.pitProgress = nil
	end

	-- v10: gelegte Eier.
	--
	-- lastEggAt bewusst auf JETZT statt auf createdAt: ein Spielstand, der vor
	-- diesem Feature entstanden ist, hat keine Ei-Zeit — wuerde man hier
	-- createdAt einsetzen, bekaeme er beim ersten Join nach dem Update die
	-- Obergrenze auf einen Schlag geschenkt, fuer eine Zeit, in der es das
	-- Legen noch gar nicht gab.
	if island.laidEggs == nil then
		island.laidEggs = {}
	else
		-- Nur vollstaendige Eintraege behalten. Ein Ei ohne uid liesse sich nie
		-- einsammeln und laege bis in alle Ewigkeit auf dem Plot herum.
		local cleaned: { Types.LaidEgg } = {}
		for _, egg in island.laidEggs do
			if typeof(egg.uid) == "string" and #egg.uid > 0
				and typeof(egg.eggType) == "string"
				and typeof(egg.x) == "number"
				and typeof(egg.y) == "number"
				and typeof(egg.z) == "number"
			then
				table.insert(cleaned, egg)
			end
		end
		island.laidEggs = cleaned
	end

	if island.lastEggAt == nil then
		island.lastEggAt = os.time()
	end

	-- v15: Waben-Recycler. Feldweise nachgeruestet (wie lastEggAt), deshalb
	-- gefahrlos wiederholbar und ohne Versionssprung.
	local recycler = (island :: any).recycler
	if typeof(recycler) ~= "table" then
		(island :: any).recycler = { level = 1, queued = 0, progress = 0, lastProcessedAt = os.time() }
	else
		if typeof(recycler.level) ~= "number" then recycler.level = 1 end
		if typeof(recycler.queued) ~= "number" then recycler.queued = 0 end
		if typeof(recycler.progress) ~= "number" then recycler.progress = 0 end
		if typeof(recycler.lastProcessedAt) ~= "number" then recycler.lastProcessedAt = os.time() end
	end

	-- (v5 hatte hier die uid-Nachruestung der Brut-Eier — seit v12 gibt es
	-- keine Brut-Eier mehr, siehe oben.)

	-- v4: die Gebaeude sind komplett ausgetauscht. Frueher gab es Hatchery,
	-- GummyFarm, Recycler (und davor FusionLab) mit je eigener Funktion —
	-- jetzt reine Honig-Produzenten. Alte Eintraege werden entfernt und
	-- die neuen angelegt; das Level laesst sich nicht sinnvoll uebertragen,
	-- weil die Gebaeude etwas voellig anderes tun.
	--
	-- (Honigtopf und Honig-Presse bleiben hier noch stehen: die v7- und die
	-- v15-Migration weiter unten brauchen ihre Level. Entfernt werden sie erst
	-- in der v15-Zusammenlegung.)
	local OBSOLETE_BUILDINGS = { "Hatchery", "GummyFarm", "Recycler", "FusionLab" }

	if island.buildings == nil then
		island.buildings = default.island.buildings
	else
		local buildings = island.buildings :: any

		for _, obsolete in OBSOLETE_BUILDINGS do
			buildings[obsolete] = nil
		end

		for buildingId, building in default.island.buildings do
			local existing = buildings[buildingId]
			if existing == nil then
				buildings[buildingId] = {
					id             = building.id,
					level          = building.level,
					honey          = building.honey,
					lastProducedAt = building.lastProducedAt,
				}
			else
				-- v4: Honig-Felder auf bereits vorhandenen Gebaeuden nachruesten
				if existing.honey == nil then
					existing.honey = 0
				end
				if existing.lastProducedAt == nil then
					existing.lastProducedAt = os.time()
				end
			end
		end
	end

	-- v7: die drei Gebaeude haben eigene Rollen bekommen (siehe
	-- Config/BuildingBehavior). Die XP pro Honig haengen seitdem allein am Level
	-- der Honig-Presse — vorher am Level des Gebaeudes, aus dem der Honig kam,
	-- also an allen dreien.
	--
	-- Ohne Ausgleich wuerde ein laufender Spielstand dabei XP VERLIEREN: wer
	-- seinen Bienenstock auf Level 5 stehen hat und die Presse auf Level 1,
	-- bekaeme ploetzlich 30 statt 135 XP pro Honig. Deshalb erbt die Presse
	-- einmalig das hoechste Level, das dieser Spielstand bei irgendeinem
	-- Gebaeude erreicht hatte. Danach ist die XP-Ausbeute mindestens so gut wie
	-- vorher, und niemand muss etwas nachkaufen.
	--
	-- DAS IST DIE ERSTE MIGRATION, DIE AN DER VERSIONSNUMMER HAENGEN MUSS
	-- (siehe den Kommentar bei data.version am Ende dieser Funktion): sie
	-- rechnet einen Wert um, statt ein fehlendes Feld anzulegen. Liefe sie bei
	-- jedem Join erneut, wuerde die Presse jedes Mal wieder auf das Maximum
	-- hochgezogen — der Spieler koennte die anderen beiden nie ueberholen.
	if (data.version or 0) < 7 then
		local press = (island.buildings :: any).HoneyPress

		if press then
			local highest = press.level or 1

			for _, building in island.buildings do
				highest = math.max(highest, building.level or 1)
			end

			press.level = highest
		end
	end

	-- ============================================================
	-- v15: GEBAEUDE OPTION B — Honigtopf + Honig-Presse -> Honig-Veredler
	-- ============================================================
	-- Niemand verliert etwas: der Veredler bekommt das HOEHERE der beiden alten
	-- Level (er kann beides: XP wie die Presse, Heilung wie der Topf), und der
	-- eingelagerte Honig beider wird zusammengelegt (gedeckelt auf sein Lager).
	-- Haengt an der Version, weil es UMRECHNET; danach sind Topf und Presse weg.
	-- Ueber `any`, weil Types.BuildingId die alten Ids nicht mehr kennt.
	do
		local buildings = island.buildings :: any
		if (data.version or 0) < 15 then
			local pot     = buildings.HoneyPot
			local press   = buildings.HoneyPress
			local refiner = buildings.HoneyRefiner
			-- Mit HONEY_POND_V2 legt der Standard keinen Veredler mehr an; fuer
			-- die Zusammenlegung (und danach den Teich) wird er hier angelegt.
			if refiner == nil and (pot or press) then
				refiner = { id = "HoneyRefiner", level = 1, honey = 0, lastProducedAt = os.time() }
				buildings.HoneyRefiner = refiner
			end
			if refiner and (pot or press) then
				local level = math.max(refiner.level or 1,
					if pot then pot.level or 1 else 1,
					if press then press.level or 1 else 1)
				refiner.level = math.clamp(level, 1, EconomyConfig.MAX_BUILDING_LEVEL)

				local honey = (if pot then pot.honey or 0 else 0) + (if press then press.honey or 0 else 0)
				refiner.honey = math.clamp(honey, 0, BuildingBehavior.getCapacity("HoneyRefiner", refiner.level))
			end
		end

		-- Honig-Teich (HONEY_POND_V2) bzw. zurueck zu Stock + Veredler. MUSS vor
		-- dem Aufraeumen unten laufen: sonst waeren die gerade nicht geltenden
		-- Gebaeude schon geloescht statt im Ruhestand (island.retiredBuildings).
		HoneyPondMode.apply(island, FeatureFlags.isOn("HONEY_POND_V2"), os.time())
		local pond = buildings[HoneyPondMode.POND]
		if pond then
			pond.level = EconomyConfig.clampBuildingLevel(pond.level or 1)
			pond.honey = math.clamp(pond.honey or 0, 0, BuildingBehavior.getCapacity("HoneyPond", pond.level))
		end

		-- Alles, was es nicht (mehr) gibt, verschwindet — auch Topf und Presse
		-- nach der Zusammenlegung. Am Feld erkennbar, deshalb wiederholbar.
		for buildingId in buildings do
			if default.island.buildings[buildingId] == nil then
				buildings[buildingId] = nil
			end
		end

		-- Level auf den gueltigen Bereich (1-60) klemmen.
		for _, building in buildings do
			building.level = EconomyConfig.clampBuildingLevel(building.level or 1)
		end
	end

	-- ============================================================
	-- v15: TOWER STATT PIT-LEVEL
	-- ============================================================
	-- 1. Erstattung: die Summe der bezahlten PIT-Ausbaukosten landet in
	--    island.pitRefund. Die Migration fasst KEINE Waehrung an —
	--    TowerService zahlt den Betrag beim Join ueber EconomyService aus.
	-- 2. Rekord: der alte letzte Lauf (pitProgress) wird in die gleich starke
	--    Tower-Stage umgerechnet (TowerConfig.legacyPitToTower) und als
	--    permanenter Rekord eingetragen. Die zugehoerigen Meilensteine vergibt
	--    TowerService beim Join rueckwirkend.
	-- 3. pitLevel, pitProgress und stats.highestPitLevel werden entfernt.
	--
	-- Gilt reachedStage als "geschafft"? reachedStage ist die letzte Stage, in
	-- die der Baerchi eingetreten ist — gewonnen oder verloren. Bewusst
	-- grosszuegig als Rekord gezaehlt: niemand soll durch die Umstellung weniger
	-- haben (ANNAHME, im Bericht).
	data.towers = (data :: any).towers
	if typeof(data.towers) ~= "table" then
		data.towers = {
			records      = {},
			claimed      = {},
			highestTower = TowerConfig.FIRST_TOWER,
			selected     = TowerConfig.FIRST_TOWER,
		}
	end
	local towers = data.towers :: any
	if typeof(towers.records) ~= "table" then towers.records = {} end
	if typeof(towers.claimed) ~= "table" then towers.claimed = {} end

	if (data.version or 0) < 15 then
		local legacyLevel = tonumber(legacyIsland.pitLevel) or 1
		local refund = TowerConfig.legacyPitRefund(legacyLevel)
		legacyIsland.pitRefund = (tonumber(legacyIsland.pitRefund) or 0) + refund

		local legacyProgress = legacyIsland.pitProgress
		if typeof(legacyProgress) == "table" then
			local towerId, stage = TowerConfig.legacyPitToTower(
				tonumber(legacyProgress.pitLevel) or legacyLevel,
				tonumber(legacyProgress.reachedStage) or 0
			)
			if towerId and stage > 0 then
				towers.records[towerId] = math.max(tonumber(towers.records[towerId]) or 0, stage)
			end
		end
	end
	legacyIsland.pitLevel    = nil
	legacyIsland.pitProgress = nil
	stats.highestPitLevel    = nil

	-- Rekorde: nur gueltige Tower, nur Zahlen, nur bis zur Stage-Zahl.
	for towerId, record in towers.records do
		local def = TowerConfig.get(towerId)
		local value = tonumber(record)
		if not def or not value or value <= 0 then
			towers.records[towerId] = nil
		else
			towers.records[towerId] = math.clamp(math.floor(value), 0, def.stages)
		end
	end
	-- Meilensteine: Tabelle je Tower mit TEXT-Schluesseln (siehe Types).
	for towerId, claimed in towers.claimed do
		if not TowerConfig.get(towerId) or typeof(claimed) ~= "table" then
			towers.claimed[towerId] = nil
		else
			local cleaned: { [string]: boolean } = {}
			for stage, flag in claimed do
				if flag == true and tonumber(stage) then
					cleaned[tostring(math.floor(tonumber(stage) :: number))] = true
				end
			end
			towers.claimed[towerId] = cleaned
		end
	end
	-- Hoechster Tower = der hoechste mit Rekord (nie niedriger als gespeichert).
	local highest = if TowerConfig.isValidId(towers.highestTower) then towers.highestTower else TowerConfig.FIRST_TOWER
	for towerId in towers.records do
		if TowerConfig.getIndex(towerId) > TowerConfig.getIndex(highest) then
			highest = towerId
		end
	end
	towers.highestTower = highest
	if not TowerConfig.isValidId(towers.selected) then
		towers.selected = TowerConfig.FIRST_TOWER
	end

	-- Fortsetzen pro Tower (ersetzt pitProgress) und Erstattungs-Feld.
	if typeof(legacyIsland.towerProgress) ~= "table" then
		legacyIsland.towerProgress = {}
	else
		for towerId, stage in legacyIsland.towerProgress do
			if not TowerConfig.get(towerId) or typeof(stage) ~= "number" or stage < 1 then
				legacyIsland.towerProgress[towerId] = nil
			end
		end
	end
	if typeof(legacyIsland.pitRefund) ~= "number" or legacyIsland.pitRefund < 0 then
		legacyIsland.pitRefund = 0
	end

	-- v15: Login-Bonus. Feldweise, wiederholbar.
	local daily = (data :: any).daily
	if typeof(daily) ~= "table" then
		(data :: any).daily = { lastClaimDay = 0, streak = 0 }
	else
		if typeof(daily.lastClaimDay) ~= "number" then daily.lastClaimDay = 0 end
		if typeof(daily.streak) ~= "number" then daily.streak = 0 end
	end

	-- v8: die zweite Fortschrittsachse (Promotion, Stat-Level, Charms).
	--
	-- Steht bewusst VOR der currentHp-Migration weiter unten: die rechnet mit
	-- CombatCalculator.getEffectiveStats, und das liest inzwischen genau diese
	-- Felder. Es kaeme auch ohne zurecht (es faengt fehlende Felder mit 0 ab),
	-- aber ein Spielstand soll die Migration nicht in halb fertigem Zustand
	-- durchlaufen — das ist die Art Reihenfolge-Abhaengigkeit, die man erst
	-- Monate spaeter bemerkt.
	--
	-- Erkennt fehlende Felder einzeln statt an der Versionsnummer und ist
	-- deshalb gefahrlos wiederholbar (dieselbe Konvention wie v2/v4/v5).
	for _, baerchi in island.baerchis do
		if baerchi.promotionLevel == nil then
			baerchi.promotionLevel = 0
		end

		if baerchi.statLevels == nil then
			baerchi.statLevels = PromotionConfig.newStatLevels()
		else
			-- Einzelne Stat-Schluessel nachruesten: `egg` kam als letzter dazu,
			-- und ein kuenftiger fuenfter Stat soll hier ebenfalls landen, ohne
			-- dass die ganze Tabelle ersetzt (und damit der Fortschritt
			-- geloescht) wird.
			local levels = baerchi.statLevels :: any
			for _, key in PromotionConfig.ALL_STATS do
				if levels[key] == nil then
					levels[key] = 0
				end
			end
		end

		if baerchi.charms == nil then
			baerchi.charms = {}
		else
			-- Nur gueltige Eintraege behalten. Ein Charm ohne Slot oder mit
			-- einem Stat-Typ, den es nicht mehr gibt (Pool-Aenderung), waere
			-- sonst ein stiller Rechenfehler in getEffectiveStats.
			local cleaned: { Types.Charm } = {}
			for _, charm in baerchi.charms do
				local slotOk = typeof(charm.slot) == "number"
					and charm.slot >= 1
					and charm.slot <= CharmConfig.SLOT_COUNT

				if slotOk and CharmConfig.getStatDef(charm.statId) then
					if charm.locked == nil then
						charm.locked = false
					end
					table.insert(cleaned, charm)
				end
			end
			table.sort(cleaned, function(a, b)
				return a.slot < b.slot
			end)
			baerchi.charms = cleaned
		end

		-- baseStatOverride bleibt absichtlich ungesetzt: nil heisst "Basiswerte
		-- kommen wie immer aus BaerchiConfig", und genau das gilt fuer jeden
		-- Baerchi, der vor dieser Version entstanden ist — auch fuer die
		-- damaligen Fusions-Ergebnisse (die haben ihren Vorteil ueber
		-- fusionBonus, nicht ueber die Basiswerte).

		-- ============================================================
		-- v9: DEF ist weg, PWR ist da, Inverted ist neu
		-- ============================================================
		-- Anders als alles darueber RAEUMT diese Migration etwas WEG. Ein
		-- statLevels.def oder ein baseStatOverride.def aus v8 zeigt auf einen
		-- Stat, den es nicht mehr gibt — stehen bleiben duerfte er trotzdem
		-- nicht: er landete beim naechsten Speichern wieder im DataStore und
		-- waere in einem Jahr ein Feld, das niemand mehr einordnen kann.
		--
		-- Der alte def-WERT wird NICHT in pwr uebertragen. Die beiden haben
		-- nichts miteinander zu tun (Schadensreduktion gegen Ability-Staerke),
		-- und ein Baerchi mit acht DEF-Stufen haette sonst still acht Stufen
		-- eines voellig anderen Stats geschenkt bekommen. pwr faengt bei 0 an.
		local statLevels = baerchi.statLevels :: any
		if statLevels.def ~= nil then
			statLevels.def = nil
		end
		if statLevels.pwr == nil then
			statLevels.pwr = 0
		end

		local override = baerchi.baseStatOverride :: any
		if override ~= nil then
			override.def = nil

			-- Ein Fusions-Ergebnis aus v8 hat einen gemischten Basiswert fuer
			-- hp/atk/spd, aber keinen fuer pwr (den Stat gab es noch nicht).
			-- nil ist hier genau richtig: getEffectiveStats faellt dann auf den
			-- pwr-Wert seines configId zurueck.
		end

		-- ============================================================
		-- v11: MUTATION-SYSTEM ERSETZT INVERTED
		-- ============================================================
		-- Das binaere isInverted-Feld weicht dem gestuften Mutation-System
		-- (siehe BaerchiConfig.MUTATIONS). Alte Spielstaende kannten hoechstens
		-- isInverted = true.
		--
		-- ANNAHME, nicht vom Projektinhaber vorgegeben: ein zuvor invertierter
		-- Baerchi wird auf die Mutation "Diamond" abgebildet (0.3% Wurf-Chance,
		-- damit nahe an der alten INVERTED_CHANCE von 0.5% — eine exakte
		-- Entsprechung gibt es nicht, weil das alte System nur eine einzige
		-- Stufe kannte). Wer eine andere Zuordnung will, ist das hier die
		-- einzige Stelle, die es aendern muss.
		--
		-- Erkennt das alte Feld selbst (ueber `any`, weil Types.Baerchi es seit
		-- v11 nicht mehr kennt) und ist deshalb gefahrlos wiederholbar: beim
		-- ersten Durchlauf wird das alte Feld entfernt, jeder weitere Durchlauf
		-- findet es dann bereits als nil vor und tut nichts mehr.
		local legacy = baerchi :: any
		if legacy.isInverted == true and baerchi.mutation == nil then
			baerchi.mutation = "Diamond"
		end
		legacy.isInverted = nil
	end

	-- v2: fusionBonus auf allen bestehenden Baerchis
	for _, baerchi in island.baerchis do
		if baerchi.fusionBonus == nil then
			baerchi.fusionBonus = 0
		end
		if baerchi.isFusionResult == nil then
			baerchi.isFusionResult = false
		end
	end

	-- v4: currentHp auf allen bestehenden Baerchis.
	-- Sie haben unter dem neuen System noch nicht gekaempft, starten also mit
	-- vollen HP. CombatCalculator wird dafuer bewusst hier requiret: es ist
	-- ein reines Rechenmodul ohne Zustand, und maxHp soll es nur EINE Formel
	-- im ganzen Projekt geben.
	for _, baerchi in island.baerchis do
		if baerchi.currentHp == nil then
			local baerchiDef = BaerchiConfig.getById(baerchi.configId)

			if baerchiDef then
				-- In pcall: getEffectiveStats rechnet mit level und
				-- fusionBonus. Fehlt einem uralten Eintrag eines davon, waere
				-- der Fehler sonst mitten im Join — und ein einziger kaputter
				-- Baerchi wuerde den ganzen Spielstand unbrauchbar machen.
				local ok, maxHp = pcall(function()
					return CombatCalculator.getEffectiveStats(baerchi, baerchiDef.baseStats).maxHp
				end)

				baerchi.currentHp = if ok then maxHp else 0
				if not ok then
					warn("[PlayerService] Kaputter Baerchi-Eintrag migriert:", baerchi.configId, maxHp)
				end
			else
				-- Unbekannter configId (Config-Eintrag entfernt): nicht raten,
				-- lieber erschoepft starten als mit erfundenen Werten.
				baerchi.currentHp = 0
			end
		end
	end

	-- Zum Schluss die Versionsnummer nachziehen. Sie steuert heute keine der
	-- Migrationen oben — die pruefen alle einzeln auf fehlende Felder und
	-- laufen deshalb harmlos bei jedem Laden. Sie ist trotzdem wichtig: sobald
	-- eine kuenftige Migration NICHT mehr am Feld erkennbar ist (weil sie zum
	-- Beispiel Werte umrechnet statt welche anzulegen), ist diese Zahl der
	-- einzige Weg, sie nicht bei jedem Join erneut auszufuehren. Wer
	-- Types.createDefaultPlayerData um ein Feld erweitert, erhoeht sie dort.
	data.version = default.version
	return data
end

return PlayerMigration
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="Folder" referent="RBX73"><Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="Folder" referent="RBX74"><Properties>
<string name="Name">Controllers</string>
</Properties>
<Item class="ModuleScript" referent="RBX75"><Properties>
<string name="Name">AmbienceController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- AmbienceController.luau
-- StarterPlayerScripts/Controllers/AmbienceController.luau
--
-- Einzige Zustaendigkeit:
--   - Lebendige Himmels-Kulisse nur auf dem Client: treibende Wolkenpuffs,
--     ferne Schwebeinseln, schwebender Pollen um die Kamera und das leise
--     Atmen der Schaumsaeume um die Inseln
--
-- Warum auf dem Client: Kulisse ist fuer jeden Spieler gleich und hat keine
-- Spielwirkung. Gebaut auf dem Server wuerde sie repliziert und der Server
-- muesste sie bewegen; hier kostet sie das Netzwerk nichts und die Rechenzeit
-- bezahlt nur, wer sie sieht. Zahlen in AmbienceConfig.
--
-- PERFORMANCE:
--   * Alle Wolken sind EIN Model und werden pro Frame mit EINEM PivotTo
--     gedreht; die Schwebeinseln je EIN PivotTo. Keine Schleife ueber Parts.
--   * Alle Parts: Anchored, ohne Kollision, ohne Query, ohne Schatten. Die
--     Kamera-Zoom-Logik und Klick-Raycasts sehen sie nicht.
--   * Schwache Geraete (Grafikstufe < AmbienceConfig.HIGH_QUALITY_FROM) bekommen
--     weniger Wolken, weniger Inseln und keinen Pollen.
--   * Der Schaum wird nur 10 mal pro Sekunde aktualisiert.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local MapConfig      = require(ReplicatedStorage.Config.MapConfig)

local AmbienceController = {}

local FOAM_TICK = 0.1

local _folder: Folder? = nil
local _cloudModel: Model? = nil
local _cloudBase: CFrame = CFrame.new()
local _islands: { { model: Model, base: CFrame, phase: number } } = {}
local _foamParts: { { part: Part, phase: number } } = {}
local _pollenPart: Part? = nil

--------------------------------------------------------------------------------
-- Qualitaet
--------------------------------------------------------------------------------

local function isHighQuality(): boolean
	local ok, level = pcall(function()
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel.Value
	end)
	if not ok then
		return true
	end
	-- 0 = Automatisch: zaehlt als hoch, Roblox regelt dort selbst nach.
	return level == 0 or level >= AmbienceConfig.HIGH_QUALITY_FROM
end

--------------------------------------------------------------------------------
-- Bausteine
--------------------------------------------------------------------------------

local function newPart(name: string, parent: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType): Part
	local part = Instance.new("Part")
	part.Name          = name
	part.Anchored      = true
	part.CanCollide    = false
	part.CanQuery      = false
	part.CanTouch      = false
	part.CastShadow    = false
	part.Size          = size
	part.CFrame        = cframe
	part.Color         = color
	part.Material      = material
	part.Shape         = shape
	part.TopSurface    = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent        = parent
	return part
end

--------------------------------------------------------------------------------
-- Wolkenpuffs
--------------------------------------------------------------------------------

-- Ein Puff = vier bis fuenf ueberlappende, plattgedrueckte Baelle.
local function buildCloudPuff(parent: Instance, position: Vector3, random: Random)
	local scale = random:NextNumber(0.8, 1.4)
	local lumps = random:NextInteger(4, 5)

	for i = 1, lumps do
		local w = random:NextNumber(60, 110) * scale
		local offset = Vector3.new(
			(i - (lumps + 1) / 2) * 45 * scale + random:NextNumber(-12, 12),
			random:NextNumber(-6, 10),
			random:NextNumber(-20, 20)
		)
		local part = newPart(
			"Puff", parent,
			Vector3.new(w, w * 0.38, w * 0.7),
			CFrame.new(position + offset),
			AmbienceConfig.CLOUD_COLOR,
			Enum.Material.SmoothPlastic,
			Enum.PartType.Ball
		)
		part.Transparency = 0.12
	end
end

local function buildClouds(parent: Instance, count: number, random: Random)
	local model = Instance.new("Model")
	model.Name = "Clouds"

	for i = 1, count do
		-- Gleichmaessig um den Kreis verteilt, mit Zufall in Abstand und Hoehe.
		local angle  = (i - 1) / count * math.pi * 2 + random:NextNumber(-0.15, 0.15)
		local radius = random:NextNumber(AmbienceConfig.CLOUD_RING_MIN, AmbienceConfig.CLOUD_RING_MAX)
		local height = random:NextNumber(AmbienceConfig.CLOUD_HEIGHT_MIN, AmbienceConfig.CLOUD_HEIGHT_MAX)

		buildCloudPuff(model, Vector3.new(
			MapConfig.CENTER.X + radius * math.cos(angle),
			height,
			MapConfig.CENTER.Z + radius * math.sin(angle)
		), random)
	end

	model.Parent = parent
	_cloudModel = model
	_cloudBase  = model:GetPivot()
end

--------------------------------------------------------------------------------
-- Ferne Schwebeinseln
--------------------------------------------------------------------------------

local function buildFarIsland(parent: Instance, angle: number, random: Random, index: number)
	local model = Instance.new("Model")
	model.Name = "FarIsland"

	local base = Vector3.new(
		MapConfig.CENTER.X + AmbienceConfig.FAR_ISLAND_RING * math.cos(angle),
		AmbienceConfig.FAR_ISLAND_HEIGHT + random:NextNumber(-20, 40),
		MapConfig.CENTER.Z + AmbienceConfig.FAR_ISLAND_RING * math.sin(angle)
	)
	local size = random:NextNumber(70, 110)

	-- Felsbrocken darunter (ein umgedrehter, plattgedrueckter Ball), Wiese oben drauf.
	newPart("Rock", model, Vector3.new(size, size * 0.7, size),
		CFrame.new(base + Vector3.new(0, -size * 0.28, 0)),
		Color3.fromRGB(140, 130, 150), Enum.Material.Slate, Enum.PartType.Ball)
	newPart("Grass", model, Vector3.new(4, size, size),
		CFrame.new(base) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(96, 190, 92), Enum.Material.Grass, Enum.PartType.Cylinder)

	-- Ein Baum und ein Leuchtkristall, damit die Silhouette nicht langweilig ist.
	newPart("Trunk", model, Vector3.new(14, 4, 4),
		CFrame.new(base + Vector3.new(size * 0.15, 9, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(122, 84, 52), Enum.Material.Wood, Enum.PartType.Cylinder)
	newPart("Crown", model, Vector3.new(26, 20, 26),
		CFrame.new(base + Vector3.new(size * 0.15, 22, 0)),
		(index % 2 == 0) and Color3.fromRGB(255, 160, 190) or Color3.fromRGB(72, 170, 80),
		Enum.Material.Grass, Enum.PartType.Ball)

	model.Parent = parent
	table.insert(_islands, { model = model, base = model:GetPivot(), phase = random:NextNumber(0, math.pi * 2) })
end

--------------------------------------------------------------------------------
-- Pollen
--------------------------------------------------------------------------------

local function buildPollen(parent: Instance)
	local anchor = Instance.new("Part")
	anchor.Name         = "PollenAnchor"
	anchor.Anchored     = true
	anchor.CanCollide   = false
	anchor.CanQuery     = false
	anchor.CanTouch     = false
	anchor.CastShadow   = false
	anchor.Transparency = 1
	anchor.Size         = Vector3.new(140, 50, 140)
	anchor.Parent       = parent

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color         = ColorSequence.new(AmbienceConfig.POLLEN_COLOR)
	emitter.Size          = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, 0.8),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency  = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime      = NumberRange.new(8, 12)
	emitter.Rate          = AmbienceConfig.POLLEN_RATE
	emitter.Speed         = NumberRange.new(0.5, 2)
	emitter.SpreadAngle   = Vector2.new(180, 180)
	emitter.Acceleration  = Vector3.new(0, 0.3, 0)
	emitter.LightEmission = 0.6
	emitter.LockedToPart  = false
	emitter.Shape         = Enum.ParticleEmitterShape.Box
	emitter.Parent        = anchor

	_pollenPart = anchor
end

--------------------------------------------------------------------------------
-- Schaum einsammeln
--------------------------------------------------------------------------------

local function collectFoam()
	local platform = workspace:WaitForChild("Platform", 30)
	if not platform then
		return
	end
	local scenery = platform:WaitForChild("Scenery", 30)
	local foam = scenery and scenery:WaitForChild("Foam", 30)
	if not foam then
		return
	end
	for _, child in foam:GetChildren() do
		if child:IsA("Part") then
			table.insert(_foamParts, { part = child, phase = (child:GetAttribute("FoamPhase") :: number?) or 0 })
		end
	end
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function AmbienceController.init()
	local high   = isHighQuality()
	local random = Random.new(AmbienceConfig.SCENERY_SEED + 7)

	local folder = Instance.new("Folder")
	folder.Name   = "BaerchiAmbience"
	folder.Parent = workspace
	_folder = folder

	buildClouds(folder, high and AmbienceConfig.CLOUD_PUFFS_HIGH or AmbienceConfig.CLOUD_PUFFS_LOW, random)

	local islandCount = high and AmbienceConfig.FAR_ISLANDS_HIGH or AmbienceConfig.FAR_ISLANDS_LOW
	for i = 1, islandCount do
		-- Gleichmaessig verteilt, damit man von jeder Insel eine am Horizont sieht.
		buildFarIsland(folder, (i - 0.5) / islandCount * math.pi * 2, random, i)
	end

	if high then
		buildPollen(folder)
	end

	task.spawn(collectFoam)

	local clock = 0
	local foamClock = 0
	local cloudAngle = 0

	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt

		-- Wolken: ein Pivot fuer alle.
		local clouds = _cloudModel
		if clouds then
			cloudAngle += dt * AmbienceConfig.CLOUD_DRIFT_SPEED
			-- Drehung um die Weltmitte, relativ zur Ausgangslage (das Model-Pivot liegt
			-- in der Mitte seiner Teile, nicht in der Weltmitte).
			clouds:PivotTo(CFrame.new(MapConfig.CENTER) * CFrame.Angles(0, cloudAngle, 0) * CFrame.new(-MapConfig.CENTER) * _cloudBase)
		end

		-- Schwebeinseln: sanftes Auf und Ab, ein Pivot je Insel.
		for _, island in _islands do
			island.model:PivotTo(island.base * CFrame.new(0, math.sin(clock * 0.35 + island.phase) * 5, 0))
		end

		-- Pollen folgt der Kamera.
		local anchor = _pollenPart
		local camera = workspace.CurrentCamera
		if anchor and camera then
			anchor.Position = camera.CFrame.Position + Vector3.new(0, 4, 0)
		end

		-- Schaum atmet, 10 mal pro Sekunde.
		foamClock += dt
		if foamClock >= FOAM_TICK then
			foamClock = 0
			local twoPi = math.pi * 2
			for _, foam in _foamParts do
				local value = AmbienceConfig.FOAM_TRANSPARENCY
					+ math.sin(clock / AmbienceConfig.FOAM_PULSE_PERIOD * twoPi + foam.phase) * AmbienceConfig.FOAM_PULSE
				-- Welt aufwerten, Paket B: mit Schaum-Textur (WaterController)
				-- ist die Scheibe selbst unsichtbar und die Textur atmet.
				local lace = foam.part:FindFirstChild("FoamLace")
				if lace and lace:IsA("Texture") then
					lace.Transparency = value
				else
					foam.part.Transparency = value
				end
			end
		end
	end)

	print("[Ambience] Kulisse aktiv |", high and "hoch" or "niedrig")
end

return AmbienceController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX76"><Properties>
<string name="Name">ArenaLifeController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- ArenaLifeController.luau
-- StarterPlayerScripts/Controllers/ArenaLifeController.luau
--
-- Einzige Zustaendigkeit:
--   - Der Weg in den Kampf (Paket E, "Welt aufwerten"): Honig-Laternen am
--     Steg zur Arena (Welle beim Laufstart), Torbogen am Arena-Eingang,
--     Zuschauer-Baerchis auf dem Zaun (huepfen bei Faehigkeiten, jubeln bei
--     neuem Rekord) und eine wehende Flagge auf dem Schau-Turm
--
-- Woher der Client weiss, was passiert (keine neue Server-Logik):
--   * Lauf laeuft    = die Arena-Tafel ist eingeblendet
--                      (Plot_N/PitPlatform/PitBannerAnchor/Banner.Enabled,
--                      MapService.setPitBanner)
--   * Faehigkeit     = Remotes.SkillFXPlay (geht ohnehin an alle Clients),
--                      `center` liegt in dieser Arena
--   * neuer Rekord   = der Schau-Turm wird neu gebaut und die Zahl am Ende
--                      seines Schilds ist hoeher als vorher
--                      (ArenaBuilder.buildShowcase, Titel "Name · Tower III · 42")
--
-- Alles nur auf dem Client, pro besetztem Slot aus einem Pool (einmal gebaut,
-- danach ein- und ausgehaengt). Kein Server-Teil.
--
-- PERFORMANCE: EIN Takt (20x pro Sekunde) nur fuer Arenen in Sichtweite;
-- Lauf-Zustand 4x pro Sekunde. Keine Lichter, kein Emitter.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)
local Remotes       = require(ReplicatedStorage.Network.Remotes)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)

local ArenaLifeController = {}

local TICK = 0.05
local TAU = math.pi * 2

type Spectator = { model: Model, base: CFrame, armL: BasePart, armR: BasePart, phase: number }
type Arena = {
	slot: number,
	group: Folder,
	shown: boolean,
	occupied: boolean,
	lamps: { { glass: BasePart, index: number } },
	running: boolean,
	waveStart: number,
	spectators: { Spectator },
	hopUntil: number,
	cheerUntil: number,
	flag: { pole: BasePart, cloth: BasePart, base: CFrame }?,
	flagShineUntil: number,
	record: number?,
}

local _folder: Folder? = nil
local _arenas: { [number]: Arena } = {}

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- Richtung in der Arena: 0 Grad = nach aussen (weg vom Steg), 90 = zur Seite.
local function pitDir(slot: number, degrees: number): Vector3
	local a = math.rad(degrees)
	return MapLayout.outward(slot) * math.cos(a) + MapLayout.side(slot) * math.sin(a)
end

local function plotOf(slot: number): Instance?
	return workspace:FindFirstChild("Plot_" .. slot)
end

local function isRunning(slot: number): boolean
	local plot = plotOf(slot)
	local platform = plot and plot:FindFirstChild("PitPlatform")
	local anchor = platform and platform:FindFirstChild("PitBannerAnchor")
	local banner = anchor and anchor:FindFirstChild("Banner")
	return banner ~= nil and banner:IsA("BillboardGui") and banner.Enabled
end

--------------------------------------------------------------------------------
-- Bau (einmal je Slot)
--------------------------------------------------------------------------------

local function buildLamps(arena: Arena)
	if not WorldFXKit.enabled("bridgeLamps") then return end
	local cfg = WorldFXConfig.BRIDGE_LAMPS
	local slot = arena.slot
	local outward, side = MapLayout.outward(slot), MapLayout.side(slot)
	local deckTop = MapConfig.PLATFORM_TOP_Y - MapConfig.BRIDGE_SINK
	local sideOffset = (MapConfig.BRIDGE_WIDTH + MapConfig.BRIDGE_RAIL_WIDTH) * 0.5
	local from = MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS + 6
	local to = from + MapConfig.ISLAND_GAP - 12
	for i = 1, cfg.PER_SIDE do
		local r = from + (to - from) * (i - 1) / math.max(1, cfg.PER_SIDE - 1)
		for _, sign in { -1, 1 } do
			local p = MapConfig.CENTER + outward * r + side * (sign * sideOffset)
			local foot = Vector3.new(p.X, deckTop, p.Z)
			WorldFXKit.pole("LampPost", arena.group, foot, cfg.POST_HEIGHT, 0.35, MapConfig.BRIDGE_RAIL_COLOR, Enum.Material.Wood)
			local glass = WorldFXKit.ball("LampGlass", arena.group, cfg.GLASS_SIZE,
				foot + Vector3.new(0, cfg.POST_HEIGHT + cfg.GLASS_SIZE * 0.4, 0), cfg.OFF_COLOR, Enum.Material.Glass)
			table.insert(arena.lamps, { glass = glass, index = i })
		end
	end
end

local function buildArch(arena: Arena)
	if not WorldFXKit.enabled("arenaArch") then return end
	local cfg = WorldFXConfig.ARENA_ARCH
	local slot = arena.slot
	local pit = MapLayout.pitCenter(slot)
	-- auf dem Zaunring, mitten in der Zaunluecke zum Steg
	local ring = MapConfig.PIT_BASE_RADIUS - MapConfig.PIT_FENCE_INSET
	local gate = pit - MapLayout.outward(slot) * ring
	local side = MapLayout.side(slot)
	local baseY = MapConfig.PLATFORM_TOP_Y - MapConfig.PIT_RIM_DROP
	for _, sign in { -1, 1 } do
		local p = gate + side * (sign * cfg.HALF_WIDTH)
		WorldFXKit.pole("ArchPost", arena.group, Vector3.new(p.X, baseY, p.Z), cfg.HEIGHT, cfg.POST_DIAMETER, cfg.WOOD, Enum.Material.Wood)
	end
	local top = Vector3.new(gate.X, baseY + cfg.HEIGHT - 0.3, gate.Z)
	WorldFXKit.part("ArchBeam", arena.group, Vector3.new(cfg.HALF_WIDTH * 2 + 1.2, 0.8, 0.8),
		CFrame.fromMatrix(top, side, Vector3.yAxis), cfg.WOOD, Enum.Material.Wood, Enum.PartType.Cylinder)
	-- Honigwabe oben, Stirnseite zum Steg
	local comb = WorldFXKit.part("ArchComb", arena.group, Vector3.new(0.8, cfg.COMB_SIZE, cfg.COMB_SIZE),
		CFrame.fromMatrix(top + Vector3.new(0, cfg.COMB_SIZE * 0.5 + 0.2, 0), -MapLayout.outward(slot), Vector3.yAxis),
		WorldFXConfig.MAST.CELL_DAY, Enum.Material.Neon, Enum.PartType.Cylinder)
	DayCycleController.registerGlow(comb, WorldFXConfig.MAST.CELL_DAY, WorldFXConfig.MAST.CELL_NIGHT)
end

local SPECTATOR_ANGLES = { -120, -75, -30, 30, 75, 120 }   -- fern der Steg-Luecke (180 +- 34)

local function buildSpectators(arena: Arena)
	if not WorldFXKit.enabled("spectators") then return end
	local cfg = WorldFXConfig.SPECTATORS
	local slot = arena.slot
	local pit = MapLayout.pitCenter(slot)
	local ring = MapConfig.PIT_BASE_RADIUS - MapConfig.PIT_FENCE_INSET
	local seatY = MapConfig.PLATFORM_TOP_Y - MapConfig.PIT_RIM_DROP + MapConfig.PIT_FENCE_SIZE.Y
	for i = 1, math.min(cfg.COUNT, #SPECTATOR_ANGLES) do
		local dir = pitDir(slot, SPECTATOR_ANGLES[i])
		local seat = Vector3.new(pit.X, seatY, pit.Z) + dir * ring
		-- schaut zur Arena-Mitte
		local base = CFrame.lookAt(seat, Vector3.new(pit.X, seatY, pit.Z))
		local color = cfg.COLORS[(i - 1) % #cfg.COLORS + 1]
		local model = Instance.new("Model")
		model.Name = "Spectator"
		local s = cfg.SCALE
		local body = WorldFXKit.ellipsoid("Body", model, Vector3.new(1.3, 1.4, 1.1) * s, base * CFrame.new(0, 0.7 * s, 0), color)
		WorldFXKit.ball("Head", model, 1.0 * s, (base * CFrame.new(0, 1.75 * s, 0)).Position, color)
		for _, x in { -0.38, 0.38 } do
			WorldFXKit.ball("Ear", model, 0.38 * s, (base * CFrame.new(x * s, 2.25 * s, 0)).Position, color)
		end
		local armL = WorldFXKit.part("ArmL", model, Vector3.new(0.3, 0.8, 0.3) * s, base * CFrame.new(-0.7 * s, 0.9 * s, 0), color)
		local armR = WorldFXKit.part("ArmR", model, Vector3.new(0.3, 0.8, 0.3) * s, base * CFrame.new(0.7 * s, 0.9 * s, 0), color)
		model.PrimaryPart = body
		model.Parent = arena.group
		table.insert(arena.spectators, { model = model, base = model:GetPivot(), armL = armL, armR = armR, phase = i * 0.37 })
	end
end

local function buildArena(slot: number): Arena
	local group = WorldFXKit.folder("ArenaLife_" .. slot, _folder :: Folder)
	local arena: Arena = {
		slot = slot, group = group, shown = true, occupied = false,
		lamps = {}, running = false, waveStart = 0,
		spectators = {}, hopUntil = 0, cheerUntil = 0,
		flag = nil, flagShineUntil = 0, record = nil,
	}
	buildLamps(arena)
	buildArch(arena)
	buildSpectators(arena)
	return arena
end

--------------------------------------------------------------------------------
-- Schau-Turm: Flagge und Rekord
--------------------------------------------------------------------------------

local function recordOf(showcase: Instance): (number?, Color3?)
	local anchor = showcase:FindFirstChild("SignAnchor")
	local sign = anchor and anchor:FindFirstChild("Sign")
	local title = sign and sign:FindFirstChild("Title")
	if not (title and title:IsA("TextLabel")) then return nil, nil end
	local n = string.match(title.Text, "(%d+)%s*$")
	return (if n then tonumber(n) else nil), title.TextColor3
end

local function cheer(arena: Arena)
	local now = os.clock()
	arena.cheerUntil = now + WorldFXConfig.SPECTATORS.CHEER_TIME
	arena.flagShineUntil = now + WorldFXConfig.SHOWCASE_FLAG.SHINE_TIME
end

local function attachFlag(arena: Arena, showcase: Instance)
	local old = arena.flag
	if old then
		old.pole:Destroy()
		old.cloth:Destroy()
	end
	arena.flag = nil

	local record, color = recordOf(showcase)
	local previous = arena.record
	arena.record = record
	if previous and record and record > previous then
		cheer(arena)
	end

	if not (WorldFXKit.enabled("showcaseFlag") and showcase:IsA("Model")) then return end
	local cfg = WorldFXConfig.SHOWCASE_FLAG
	-- Spitze: oberste Kante der Turm-Teile (Schild-Anker ausgenommen)
	local top = -math.huge
	local foot = MapLayout.showcaseFoot(arena.slot)
	for _, part in showcase:GetChildren() do
		if part:IsA("BasePart") and part.Name ~= "SignAnchor" then
			top = math.max(top, part.Position.Y + part.Size.Y * 0.5)
		end
	end
	if top == -math.huge then return end
	local poleFoot = Vector3.new(foot.X, top - 0.2, foot.Z)
	-- Flaggen-Container haengt am Turm-Gruppen-Ordner des Schau-Turms (Hauptinsel)
	local pole = WorldFXKit.pole("FlagPole", _folder, poleFoot, cfg.POLE_HEIGHT, 0.2, Color3.fromRGB(110, 76, 48), Enum.Material.Wood)
	local side = MapLayout.side(arena.slot)
	local base = CFrame.fromMatrix(poleFoot + Vector3.new(0, cfg.POLE_HEIGHT - cfg.FLAG_SIZE.Y * 0.5, 0), side, Vector3.yAxis)
	local cloth = WorldFXKit.part("Flag", _folder, cfg.FLAG_SIZE, base * CFrame.new(cfg.FLAG_SIZE.X * 0.5, 0, 0),
		color or Color3.fromRGB(255, 214, 110), Enum.Material.Fabric)
	local flagId = WorldFXKit.textureId("flag_fabric")
	if flagId then
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local decal = Instance.new("Decal")
			decal.Texture = flagId
			decal.Face = face
			decal.Parent = cloth
		end
	end
	arena.flag = { pole = pole, cloth = cloth, base = base }
end

local function watchShowcase(arena: Arena)
	local plot = plotOf(arena.slot)
	if not plot then return end
	local current = plot:FindFirstChild("TowerShowcase")
	if current then
		attachFlag(arena, current)
	end
	plot.ChildAdded:Connect(function(child)
		if child.Name == "TowerShowcase" then
			task.wait(0.1)   -- Schild wird nach dem Model gefuellt
			if child.Parent then attachFlag(arena, child) end
		end
	end)
end

--------------------------------------------------------------------------------
-- Takt
--------------------------------------------------------------------------------

local function stepFlag(arena: Arena, now: number, clock: number)
	-- Flagge weht; beim Rekord glaenzt sie einmal auf
	local flag = arena.flag
	if not flag then return end
	local fcfg = WorldFXConfig.SHOWCASE_FLAG
	local swing = math.rad(fcfg.WAVE_DEGREES) * math.sin(clock * fcfg.WAVE_RATE * TAU + arena.slot)
	flag.cloth.CFrame = flag.base * CFrame.Angles(0, swing, 0) * CFrame.new(fcfg.FLAG_SIZE.X * 0.5, 0, 0)
	local material = if now < arena.flagShineUntil then Enum.Material.Neon else Enum.Material.Fabric
	if flag.cloth.Material ~= material then flag.cloth.Material = material end
end

local function stepArena(arena: Arena, now: number)
	-- Laternen: Welle vom Plot zur Arena, aus nach dem Lauf
	local cfg = WorldFXConfig.BRIDGE_LAMPS
	for _, lamp in arena.lamps do
		local on = arena.running and now >= arena.waveStart + (lamp.index - 1) * cfg.WAVE_STEP
		local want = if on then cfg.ON_COLOR else cfg.OFF_COLOR
		if lamp.glass.Color ~= want then
			lamp.glass.Color = want
			lamp.glass.Material = if on then Enum.Material.Neon else Enum.Material.Glass
		end
	end

	-- Zuschauer: Hopser bei einer Faehigkeit, Jubel (Arme hoch) beim Rekord
	local scfg = WorldFXConfig.SPECTATORS
	local cheering = now < arena.cheerUntil
	local hopping = now < arena.hopUntil or cheering
	for _, sp in arena.spectators do
		local lift = 0
		if hopping then
			local t = ((now + sp.phase) % scfg.HOP_TIME) / scfg.HOP_TIME
			lift = scfg.HOP_HEIGHT * 4 * t * (1 - t)
		end
		sp.model:PivotTo(sp.base * CFrame.new(0, lift, 0))
		local armAngle = if cheering then math.rad(160) else 0
		local pivot = sp.model:GetPivot()
		-- Schulter knapp ueber der Koerpermitte; Arm haengt, beim Jubel hoch
		sp.armL.CFrame = pivot * CFrame.new(-0.7, 0.35, 0) * CFrame.Angles(0, 0, -armAngle) * CFrame.new(0, -0.35, 0)
		sp.armR.CFrame = pivot * CFrame.new(0.7, 0.35, 0) * CFrame.Angles(0, 0, armAngle) * CFrame.new(0, -0.35, 0)
	end
end

--------------------------------------------------------------------------------
-- Besetzung, Sichtweite, Lauf-Zustand (4x pro Sekunde)
--------------------------------------------------------------------------------

local function setOccupied(slot: number, occupied: boolean)
	local arena = _arenas[slot]
	if not arena then
		if not occupied then return end
		arena = buildArena(slot)
		_arenas[slot] = arena
	end
	local a = arena :: Arena
	a.occupied = occupied
	if occupied then
		a.record = nil
		task.spawn(watchShowcase, a)
	else
		local flag = a.flag
		if flag then
			flag.pole:Destroy()
			flag.cloth:Destroy()
		end
		a.flag = nil
	end
end

local function refresh()
	local camera = workspace.CurrentCamera
	local folder = _folder
	if not (camera and folder) then return end
	local eye = camera.CFrame.Position
	for slot, arena in _arenas do
		local d = (MapLayout.pitCenter(slot) - eye).Magnitude
		local limit = WorldFXConfig.BRIDGE_LAMPS.SHOW_DISTANCE * (if arena.shown then 1 else 0.9)
		local want = arena.occupied and d <= limit
		if want ~= arena.shown then
			arena.shown = want
			arena.group.Parent = if want then folder else nil
		end
		local running = arena.occupied and isRunning(slot)
		if running and not arena.running then
			arena.waveStart = os.clock()
		end
		arena.running = running
	end
end

local function slotOf(child: Instance): number?
	local n = string.match(child.Name, "^Plot_(%d+)$")
	return if n then tonumber(n) else nil
end

-- Arena des Spielers mit dieser UserId (ueber das Plot-Attribut PlotOwner).
local function arenaOfUser(userId: number?): Arena?
	if not userId then return nil end
	for slot, arena in _arenas do
		local plot = plotOf(slot)
		if plot and plot:GetAttribute("PlotOwner") == userId then return arena end
	end
	return nil
end

-- Paket G (neuer Rekord): Zuschauer jubeln, Flagge glaenzt — sichtbar nur,
-- wo die Arena bzw. der Turm in Sichtweite ist.
function ArenaLifeController.celebrate(userId: number)
	local arena = arenaOfUser(userId)
	if arena then cheer(arena) end
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function ArenaLifeController.init()
	if not FeatureFlags.isOn("WORLD_E_ARENA") then return end
	_folder = WorldFXKit.folder("ArenaLife", WorldFXKit.root())

	for slot = 1, MapConfig.PLOT_COUNT do
		if workspace:FindFirstChild("Plot_" .. slot) then setOccupied(slot, true) end
	end
	workspace.ChildAdded:Connect(function(child)
		local slot = slotOf(child)
		if slot then setOccupied(slot, true) end
	end)
	workspace.ChildRemoved:Connect(function(child)
		local slot = slotOf(child)
		if slot and not workspace:FindFirstChild(child.Name) then setOccupied(slot, false) end
	end)

	-- Faehigkeit in einer Arena: die Zuschauer dort huepfen kurz
	Remotes.SkillFXPlay.OnClientEvent:Connect(function(req: any)
		if typeof(req) ~= "table" or typeof(req.owner) ~= "number" then return end
		local arena = arenaOfUser(req.owner)
		if arena then
			arena.hopUntil = os.clock() + WorldFXConfig.SPECTATORS.HOP_TIME * 2
		end
	end)

	-- Debug (Studio): "<userId>|hop|n" bzw. "<userId>|n" fuer den Rekord
	WorldFXKit.onDebug("DebugSpectators", function(value: any)
		if typeof(value) ~= "string" then return end
		local id, mode = string.match(value, "^(%d+)|(%a+)")
		local arena = arenaOfUser(tonumber(id))
		if not arena then return end
		if mode == "cheer" then cheer(arena) else arena.hopUntil = os.clock() + 2 end
	end, false)
	WorldFXKit.onDebug("DebugRecord", function(value: any)
		if typeof(value) ~= "string" then return end
		local arena = arenaOfUser(tonumber(string.match(value, "^(%d+)")))
		if arena then cheer(arena) end
	end, false)

	local acc, stateAcc, clock = 0, 1, 0
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		acc += dt
		stateAcc += dt
		if stateAcc >= 0.25 then
			stateAcc = 0
			refresh()
		end
		if acc < TICK then return end
		acc = 0
		local now = os.clock()
		for _, arena in _arenas do
			if arena.shown then
				stepArena(arena, now)
			end
			stepFlag(arena, now, clock)
		end
	end)

	print("[ArenaLife] aktiv")
end

return ArenaLifeController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX77"><Properties>
<string name="Name">ArrivalController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- ArrivalController.luau
-- StarterPlayerScripts/Controllers/ArrivalController.luau
--
-- Einzige Zustaendigkeit:
--   - Die Ankunft beim ERSTEN Betreten des Servers (Paket C, "Welt
--     aufwerten"): Honigblasen steigen um den Spieler auf, ein kleiner
--     Bienenschwarm kreist einmal gruessend um ihn und fliegt dann los —
--     dorthin, wo er als Naechstes hin soll
--
-- Ziel der Bienen: Der Spieler spawnt seit dem Insel-Spawn auf SEINER Insel
-- (MapConfig.PLAYER_SPAWN_OFFSET). Steht er dort, zeigen die Bienen zum
-- Honigmast (Herz der Welt, Event, Haendler). Steht er woanders (voller
-- Server → Not-Spawn in der Mitte), zeigen sie zur eigenen Insel.
--
-- Nur fuer diesen einen Spieler sichtbar (alles lokal), einmal pro Beitritt:
-- ein Respawn loest nichts aus (dieses Skript laeuft einmal je Beitritt).
--
-- PERFORMANCE: ein Emitter (Blasen, einmal Emit), sechs kleine Bienen aus
-- einem festen Pool, ein Takt nur waehrend der ~6 Sekunden der Ankunft.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit = require(script.Parent.WorldFXKit)

local ArrivalController = {}

local localPlayer = Players.LocalPlayer
local TAU = math.pi * 2

local _bees: { Model } = {}
local _bubbleAnchor: BasePart? = nil
local _bubbles: ParticleEmitter? = nil
local _running = false

--------------------------------------------------------------------------------
-- Pool
--------------------------------------------------------------------------------

local function buildPool(folder: Instance)
	local cfg = WorldFXConfig.ARRIVAL
	for _ = 1, cfg.BEES do
		local model = Instance.new("Model")
		model.Name = "Bee"
		local body = WorldFXKit.ellipsoid("Body", model, Vector3.new(0.5, 0.5, 0.75), CFrame.new(), cfg.BEE_COLOR,
			Enum.Material.SmoothPlastic)
		WorldFXKit.part("Stripe", model, Vector3.new(0.52, 0.16, 0.22), CFrame.new(0, 0, 0.08), cfg.STRIPE_COLOR, Enum.Material.SmoothPlastic)
		local wings = WorldFXKit.part("Wings", model, Vector3.new(0.9, 0.05, 0.3), CFrame.new(0, 0.27, -0.02), Color3.new(1, 1, 1),
			Enum.Material.SmoothPlastic)
		wings.Transparency = 0.45
		model.PrimaryPart = body
		table.insert(_bees, model)
	end

	local anchor = WorldFXKit.anchor("BubbleAnchor", folder, Vector3.new(4, 0.5, 4), Vector3.new(0, -200, 0))
	local emitter = Instance.new("ParticleEmitter")
	if WorldFXKit.applyParticleTexture(emitter, "honey_bubble") then
		emitter.Rate = 0
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 214, 110))
		emitter.LightEmission = 0.3
		emitter.Lifetime = NumberRange.new(2.2, 3.2)
		emitter.Speed = NumberRange.new(2.5, 4.5)
		emitter.SpreadAngle = Vector2.new(20, 20)
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Acceleration = Vector3.new(0, 0.6, 0)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.3, 0.7), NumberSequenceKeypoint.new(1, 0.9),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.8, 0.3), NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Parent = anchor
		_bubbles = emitter
	else
		emitter:Destroy()
	end
	_bubbleAnchor = anchor
end

--------------------------------------------------------------------------------
-- Ziel
--------------------------------------------------------------------------------

local function ownPlotSlot(): number?
	for slot = 1, MapConfig.PLOT_COUNT do
		local plot = workspace:FindFirstChild("Plot_" .. slot)
		if plot and plot:GetAttribute("PlotOwner") == localPlayer.UserId then
			return slot
		end
	end
	return nil
end

local function target(from: Vector3): Vector3
	local mast = MapConfig.CENTER + Vector3.new(0, MapConfig.PLATFORM_TOP_Y + 20, 0)
	local slot = ownPlotSlot()
	if not slot then
		return mast
	end
	local home = MapLayout.plotCenter(slot)
	local flat = Vector3.new(from.X - home.X, 0, from.Z - home.Z)
	if flat.Magnitude <= MapConfig.PLOT_ISLAND_RADIUS then
		return mast
	end
	return home + Vector3.new(0, 8, 0)
end

--------------------------------------------------------------------------------
-- Ablauf
--------------------------------------------------------------------------------

local function play(root: BasePart, folder: Instance)
	if _running then return end
	_running = true
	local cfg = WorldFXConfig.ARRIVAL

	local anchor = _bubbleAnchor
	local bubbles = _bubbles
	if anchor and bubbles then
		anchor.Position = root.Position - Vector3.new(0, 2.6, 0)
		bubbles:Emit(cfg.BUBBLES)
	end

	local goal = target(root.Position)
	local start = os.clock()
	local leaveFrom: { Vector3 } = {}
	for _, bee in _bees do
		bee.Parent = folder
	end

	local connection: RBXScriptConnection? = nil
	connection = RunService.Heartbeat:Connect(function()
		local t = os.clock() - start
		local center = if root.Parent then root.Position + Vector3.new(0, 1.5, 0) else goal
		for i, bee in _bees do
			local offset = i / #_bees * TAU
			local pos: Vector3
			local ahead: Vector3
			if t < cfg.CIRCLE_TIME then
				-- einmal gruessend rundherum, leicht auf und ab
				local a = t / cfg.CIRCLE_TIME * TAU + offset
				pos = center + Vector3.new(math.cos(a) * cfg.CIRCLE_RADIUS, math.sin(t * 4 + i) * 0.8, math.sin(a) * cfg.CIRCLE_RADIUS)
				ahead = Vector3.new(-math.sin(a), 0, math.cos(a))
				leaveFrom[i] = pos
			else
				-- dann gemeinsam zum Ziel, leicht versetzt, im Bogen
				local k = math.clamp((t - cfg.CIRCLE_TIME - i * 0.08) / cfg.FLY_TIME, 0, 1)
				local from = leaveFrom[i] or center
				local eased = k * k * (3 - 2 * k)
				pos = from:Lerp(goal, eased) + Vector3.new(0, math.sin(k * math.pi) * 6, 0)
					+ Vector3.new(math.cos(offset), 0, math.sin(offset)) * (1.5 * (1 - k))
				ahead = (goal - from)
				ahead = Vector3.new(ahead.X, 0, ahead.Z)
				ahead = if ahead.Magnitude > 1e-3 then ahead.Unit else Vector3.new(0, 0, -1)
			end
			bee:PivotTo(CFrame.lookAt(pos, pos + ahead))
		end
		if t > cfg.CIRCLE_TIME + cfg.FLY_TIME + 0.6 then
			for _, bee in _bees do
				bee.Parent = nil
			end
			_running = false
			local c = connection
			if c then c:Disconnect() end
		end
	end)
end

function ArrivalController.init()
	if not FeatureFlags.isOn("WORLD_C_HUB") then return end
	if not WorldFXKit.enabled("arrival") then return end
	local folder = WorldFXKit.folder("Arrival", WorldFXKit.root())
	buildPool(folder)

	local function playFor(character: Model)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and root:IsA("BasePart") then
			-- kurz warten: Insel und Plot sind beim ersten Spawn noch im Aufbau
			task.wait(1.2)
			play(root, folder)
		end
	end

	-- Nur der ERSTE Charakter dieses Beitritts
	local character = localPlayer.Character
	if character then
		task.spawn(playFor, character)
	else
		local first: RBXScriptConnection? = nil
		first = localPlayer.CharacterAdded:Connect(function(c)
			local conn = first
			if conn then conn:Disconnect() end
			playFor(c)
		end)
	end

	-- Debug (Studio): Ankunft erneut abspielen
	WorldFXKit.onDebug("DebugArrival", function()
		local c = localPlayer.Character
		local root = c and c:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			play(root, folder)
		end
	end, false)
end

return ArrivalController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX78"><Properties>
<string name="Name">DayCycleController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- DayCycleController.luau
-- StarterPlayerScripts/Controllers/DayCycleController.luau
--
-- Einzige Zustaendigkeit:
--   - Den Tageslauf auf dem Client zeigen (Paket A, "Welt aufwerten"): Uhr,
--     Licht, Atmosphaere, Bloom, Grund-Farbkorrektur, Wolkenfarbe, das
--     Leuchten von Laternen/Krone/Tropfen, Gluehwuermchen, Sterne und
--     Wolkenschleier
--
-- Woher die Zeit kommt: Modules/DayCycle, eine reine Funktion von
-- workspace:GetServerTimeNow(). Alle Spieler eines Servers sehen dieselbe
-- Tageszeit, ohne dass der Server etwas schickt.
--
-- Schalter: AmbienceConfig.DAY_CYCLE. Aus = dieser Controller tut nichts,
-- es bleibt der feste Himmel von SkyBuilder (16,9 Uhr).
--
-- Faehigkeiten-Shows haben Vorrang: SkillFXController legt fuer den Besitzer
-- einen EIGENEN Farbfilter "SkillFX_Sky" an, und der Boss-Himmel einen
-- eigenen "BossSky_Local". Dieser Controller schreibt nur in die Basis-
-- Effekte (BaerchiBloom, BaerchiColorCorrection, BaerchiAtmosphere) und in
-- Lighting — keine Seite ueberschreibt die andere, die Filter stapeln sich.
-- Zusaetzlich haelt der Tageslauf an, solange "SkillFX_Sky" faerbt, und
-- kehrt danach in DAY.RETURN_SECONDS weich zum aktuellen Stand zurueck: so
-- wandert das Licht nicht unter einer Show weg.
--
-- PERFORMANCE: EIN Takt (DAY.TICK, 5x pro Sekunde), Lighting-Werte sind
-- reine Property-Schreibvorgaenge. Leuchtende Teile werden nur umgefaerbt,
-- wenn sich das Leuchten um mehr als 1 % geaendert hat. Drei Emitter
-- (Gluehwuermchen, Sterne, Schleier), nur auf hoher Qualitaet.

local Lighting          = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)
local MapConfig      = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig  = require(ReplicatedStorage.Config.WorldFXConfig)
local DayCycle       = require(ReplicatedStorage.Modules.DayCycle)
local MapLayout      = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit = require(script.Parent.WorldFXKit)

local DayCycleController = {}

local SHOW_FILTER = "SkillFX_Sky"
local GLOW_STEP   = 0.01

type Glow = { part: BasePart, day: Color3, night: Color3 }

local _values: { [string]: any } = DayCycle.valuesAt(WorldFXConfig.DAY_BASE_D)
local _dusk = WorldFXConfig.DAY_BASE_D
local _glows: { Glow } = {}
local _lastGlow = -1
local _cloudParts: { BasePart } = {}
local _running = false   -- laeuft der Takt (Tageslauf an)?
local _pollen: ParticleEmitter? = nil      -- Paket F: Pollenfarbe folgt dem Tageslauf
local _lastPollen: Color3? = nil
local _lastCloud: Color3? = nil
local _override: number? = nil      -- Debug: feste Uhrzeit
local _held: { [string]: any }? = nil
local _atmScale = { density = 1, haze = 1 }   -- Paket I: klare Luft hoch oben
local _returnStart = 0
local _returnFrom: { [string]: any }? = nil

local _fireflyAnchor: BasePart? = nil
local _firefly: ParticleEmitter? = nil
local _star: ParticleEmitter? = nil
local _wisp: ParticleEmitter? = nil

--------------------------------------------------------------------------------
-- Fuer andere Controller
--------------------------------------------------------------------------------

-- Aktuelle Werte (Schluessel wie WorldFXConfig.DAY_CURVES). Ohne Tageslauf:
-- die Werte bei 16,9 Uhr.
function DayCycleController.values(): { [string]: any }
	return _values
end

-- 0 = Nachmittag, 1 = blaue Stunde.
function DayCycleController.dusk(): number
	return _dusk
end

-- Nach einem kurzen fremden Farbwechsel (Kronen-Blinken, Paket G): beim
-- naechsten Takt alle angemeldeten Teile wieder auf den Tageslauf setzen.
function DayCycleController.refreshGlow()
	_lastGlow = -1
	local glow = math.clamp(_values.glow or 0, 0, 1)
	for _, g in _glows do
		g.part.Color = g.day:Lerp(g.night, glow)
	end
end

-- Ein Neon-Teil leuchtet mit dem Tageslauf: Farbe `day` bei glow = 0,
-- `night` bei glow = 1.
function DayCycleController.registerGlow(part: BasePart, day: Color3, night: Color3)
	table.insert(_glows, { part = part, day = day, night = night })
	part.Color = day:Lerp(night, math.clamp(_values.glow or 0, 0, 1))
end

--------------------------------------------------------------------------------
-- Show-Vorrang
--------------------------------------------------------------------------------

-- Faerbt gerade ein Show-Filter? (TintColor nicht weiss oder Helligkeit/
-- Saettigung/Kontrast nicht null.)
local function showActive(): boolean
	local cc = Lighting:FindFirstChild(SHOW_FILTER)
	if not (cc and cc:IsA("ColorCorrectionEffect")) then
		return false
	end
	local tint = cc.TintColor
	return tint.R < 0.99 or tint.G < 0.99 or tint.B < 0.99
		or math.abs(cc.Brightness) > 0.01 or math.abs(cc.Saturation) > 0.01 or math.abs(cc.Contrast) > 0.01
end

-- Paket I (ZoneLightController): Faktoren auf Dichte und Dunst der
-- Atmosphaere. Gibt false zurueck, wenn der Tageslauf aus ist (dann setzt der
-- Aufrufer die Atmosphaere selbst).
function DayCycleController.setAtmosphereScale(density: number, haze: number): boolean
	_atmScale.density = density
	_atmScale.haze = haze
	return _running
end

-- Fuer andere Controller: laeuft gerade eine Faehigkeiten-Show mit Farbfilter?
-- (Paket G haelt grosse Welt-Momente solange zurueck.)
function DayCycleController.showActive(): boolean
	return showActive()
end

--------------------------------------------------------------------------------
-- Anwenden
--------------------------------------------------------------------------------

local function apply(v: { [string]: any }, clock: number)
	Lighting.ClockTime            = clock
	Lighting.Brightness           = v.brightness
	Lighting.Ambient              = v.ambient
	Lighting.OutdoorAmbient       = v.outdoorAmbient
	Lighting.ColorShift_Top       = v.colorShiftTop
	Lighting.ExposureCompensation = v.exposure

	local atm = Lighting:FindFirstChild("BaerchiAtmosphere")
	if atm and atm:IsA("Atmosphere") then
		atm.Density = v.atmDensity * _atmScale.density
		atm.Offset  = v.atmOffset
		atm.Color   = v.atmColor
		atm.Decay   = v.atmDecay
		atm.Glare   = v.atmGlare
		atm.Haze    = v.atmHaze * _atmScale.haze
	end

	local bloom = Lighting:FindFirstChild("BaerchiBloom")
	if bloom and bloom:IsA("BloomEffect") then
		bloom.Intensity = v.bloomIntensity
		bloom.Threshold = v.bloomThreshold
		bloom.Size      = v.bloomSize
	end

	local cc = Lighting:FindFirstChild("BaerchiColorCorrection")
	if cc and cc:IsA("ColorCorrectionEffect") then
		cc.Saturation = v.ccSaturation
		cc.Contrast   = v.ccContrast
		cc.TintColor  = v.ccTint
	end

	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		clouds.Color = v.terrainCloudColor
	end

	-- Wolkenpuffs (AmbienceController): nur bei spuerbarer Aenderung
	local cloud: Color3 = v.cloudColor
	local last = _lastCloud
	if #_cloudParts > 0 and (not last or math.abs(last.R - cloud.R) + math.abs(last.G - cloud.G) + math.abs(last.B - cloud.B) > 0.01) then
		_lastCloud = cloud
		for _, part in _cloudParts do
			part.Color = cloud
		end
	end

	-- Leuchten
	if WorldFXKit.enabled("lampGlow") then
		local glow = math.clamp(v.glow, 0, 1)
		if math.abs(glow - _lastGlow) > GLOW_STEP then
			_lastGlow = glow
			for _, g in _glows do
				g.part.Color = g.day:Lerp(g.night, glow)
			end
		end
	end

	-- Pollen (Paket F): nur bei spuerbarer Aenderung
	local pollen = _pollen
	local pollenColor: Color3 = v.pollenColor
	local lastPollen = _lastPollen
	if pollen and (not lastPollen or math.abs(lastPollen.R - pollenColor.R) + math.abs(lastPollen.G - pollenColor.G)
		+ math.abs(lastPollen.B - pollenColor.B) > 0.01) then
		_lastPollen = pollenColor
		pollen.Color = ColorSequence.new(pollenColor)
	end

	-- Emitter: Rate folgt der Kurve
	local firefly = _firefly
	if firefly then
		firefly.Rate = WorldFXConfig.FIREFLY_RATE * v.fireflies
	end
	local star = _star
	if star then
		star.Rate = WorldFXConfig.STAR_RATE * v.stars
	end
	local wisp = _wisp
	if wisp then
		wisp.Color = ColorSequence.new(cloud)
	end
end

--------------------------------------------------------------------------------
-- Emitter
--------------------------------------------------------------------------------

local function newEmitter(anchor: BasePart, texture: string): ParticleEmitter?
	local emitter = Instance.new("ParticleEmitter")
	if not WorldFXKit.applyParticleTexture(emitter, texture) then
		emitter:Destroy()
		return nil
	end
	emitter.LockedToPart = false
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.Rate = 0
	emitter.Parent = anchor
	return emitter
end

local function buildEmitters(folder: Instance)
	if WorldFXKit.enabled("fireflies") then
		local anchor = WorldFXKit.anchor("FireflyAnchor", folder, WorldFXConfig.FIREFLY_BOX, Vector3.new(0, -100, 0))
		local e = newEmitter(anchor, "firefly")
		if e then
			e.Color = ColorSequence.new(WorldFXConfig.FIREFLY_COLOR)
			e.LightEmission = 1
			e.Lifetime = NumberRange.new(4, 7)
			e.Speed = NumberRange.new(0.3, 1.2)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.45),
				NumberSequenceKeypoint.new(0.8, 0.45), NumberSequenceKeypoint.new(1, 0),
			})
			-- sanftes An- und Abschwellen (eine Kurve, weit unter 3 Hz)
			e.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.1),
				NumberSequenceKeypoint.new(0.6, 0.5), NumberSequenceKeypoint.new(0.8, 0.1),
				NumberSequenceKeypoint.new(1, 1),
			})
			_firefly = e
			_fireflyAnchor = anchor
		end
	end

	if WorldFXKit.enabled("stars") then
		local anchor = WorldFXKit.anchor("StarAnchor", folder, WorldFXConfig.STAR_BOX,
			Vector3.new(0, WorldFXConfig.STAR_HEIGHT, 0))
		local e = newEmitter(anchor, "star_twinkle")
		if e then
			e.Color = ColorSequence.new(Color3.new(1, 1, 1))
			e.LightEmission = 1
			e.Lifetime = NumberRange.new(10, 16)
			e.Speed = NumberRange.new(0, 0)
			e.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.15, 5),
				NumberSequenceKeypoint.new(0.85, 5), NumberSequenceKeypoint.new(1, 0),
			})
			e.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.2),
				NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(0.8, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			})
			_star = e
		end
	end

	-- Schleier nur mit hochgeladenem Wolkenbild: der Rueckfall (Funkeln)
	-- saehe als Wolke falsch aus.
	if WorldFXKit.enabled("cloudWisps") and WorldFXKit.textureId("cloud_puff_flipbook") then
		local anchor = WorldFXKit.anchor("WispAnchor", folder, WorldFXConfig.WISP_BOX,
			Vector3.new(0, WorldFXConfig.WISP_HEIGHT, 0))
		local e = newEmitter(anchor, "cloud_puff_flipbook")
		if e then
			-- nicht blaettern: jede Wolke behaelt ihre Variante
			e.FlipbookMode = Enum.ParticleFlipbookMode.OneShot
			e.FlipbookFramerate = NumberRange.new(0, 0)
			e.Rate = WorldFXConfig.WISP_RATE
			e.Lifetime = NumberRange.new(50, 70)
			e.Speed = NumberRange.new(0.5, 1.5)
			e.SpreadAngle = Vector2.new(10, 180)
			e.Size = NumberSequence.new(110)
			e.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.35),
				NumberSequenceKeypoint.new(0.8, 0.35), NumberSequenceKeypoint.new(1, 1),
			})
			_wisp = e
		end
	end
end

-- Gluehwuermchen auf offenes Wasser vor der Kamera legen. Kein Wasser in
-- Sicht: der Anker geht tief unter die Welt (Rate laeuft weiter, sieht keiner).
local function placeFireflies()
	local anchor = _fireflyAnchor
	local camera = workspace.CurrentCamera
	if not (anchor and camera) then return end
	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(1, 0, 0)
	local eye = camera.CFrame.Position
	local waterY = MapConfig.PLATFORM_TOP_Y - MapConfig.WATER_DROP + 2.5   -- knapp ueber dem Wasser
	for _, turn in { 0, 0.6, -0.6, 1.2, -1.2 } do
		local dir = CFrame.Angles(0, turn, 0):VectorToWorldSpace(flat)
		local p = eye + dir * WorldFXConfig.FIREFLY_AHEAD
		if MapLayout.isOpenWater(p.X, p.Z, 8) then
			anchor.Position = Vector3.new(p.X, waterY, p.Z)
			return
		end
	end
	anchor.Position = Vector3.new(0, -200, 0)
end

--------------------------------------------------------------------------------
-- Einsammeln: Laternen, Tropfen, Wolken
--------------------------------------------------------------------------------

local function collectGlows()
	local platform = workspace:WaitForChild("Platform", 60)
	if not platform then return end
	local scenery = platform:WaitForChild("Scenery", 30)
	if scenery then
		for _, child in scenery:GetChildren() do
			if child:IsA("BasePart") and (WorldFXConfig.LAMP_NAMES :: any)[child.Name] then
				DayCycleController.registerGlow(child, WorldFXConfig.LAMP_DAY, WorldFXConfig.LAMP_NIGHT)
			end
		end
	end
	-- Der leuchtende Tropfen auf dem Honigmast
	local mast = platform:WaitForChild("Honigmast", 30)
	local drop = mast and mast:FindFirstChild("Tropfen", true)
	if drop and drop:IsA("BasePart") then
		DayCycleController.registerGlow(drop, WorldFXConfig.MAST.CELL_DAY:Lerp(drop.Color, 0.6), WorldFXConfig.MAST.CELL_NIGHT)
	end
	_lastGlow = -1
end

local function collectClouds()
	local ambience = workspace:WaitForChild("BaerchiAmbience", 30)
	if ambience and FeatureFlags.isOn("WORLD_F_LIFE") and WorldFXKit.enabled("pollenTint") then
		local anchor = ambience:FindFirstChild("PollenAnchor")
		local emitter = anchor and anchor:FindFirstChildOfClass("ParticleEmitter")
		if emitter then _pollen = emitter end
	end
	local clouds = ambience and ambience:WaitForChild("Clouds", 30)
	if not clouds then return end
	for _, part in clouds:GetDescendants() do
		if part:IsA("BasePart") then
			table.insert(_cloudParts, part)
		end
	end
	_lastCloud = nil
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function DayCycleController.init()
	-- Debug (Studio): feste Uhrzeit fuer Screenshot-Vergleiche, "auto" = Zyklus
	WorldFXKit.onDebug("DebugDayTime", function(value: any)
		_override = if typeof(value) == "number" and value > 0 then value else nil
	end)

	if not (AmbienceConfig.DAY_CYCLE and WorldFXKit.enabled("dayCycle")) then
		print("[DayCycle] aus (fester Himmel)")
		return
	end

	_running = true
	local folder = WorldFXKit.folder("DayCycle", WorldFXKit.root())
	buildEmitters(folder)
	task.spawn(collectGlows)
	task.spawn(collectClouds)

	local acc = 0
	local fireflyAcc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < WorldFXConfig.DAY.TICK then return end
		acc = 0

		local clock = _override or DayCycle.clockAt(workspace:GetServerTimeNow())
		local d = DayCycle.duskOf(clock)
		local live = DayCycle.valuesAt(d)

		-- Show-Vorrang: anhalten, danach weich zurueck
		if showActive() then
			if not _held then
				_held = _values
			end
			return
		end
		local held = _held
		if held then
			_held = nil
			_returnFrom = held
			_returnStart = os.clock()
		end
		local from = _returnFrom
		if from then
			local t = (os.clock() - _returnStart) / WorldFXConfig.DAY.RETURN_SECONDS
			if t >= 1 then
				_returnFrom = nil
			else
				live = DayCycle.blend(from, live, t * t * (3 - 2 * t))
			end
		end

		_values = live
		_dusk = d
		apply(live, clock)

		fireflyAcc += WorldFXConfig.DAY.TICK
		if fireflyAcc >= 1 then
			fireflyAcc = 0
			if live.fireflies > 0 then
				placeFireflies()
			end
		end
	end)

	print(string.format("[DayCycle] an | %d min Zyklus, %.1f–%.1f Uhr | %s",
		WorldFXConfig.DAY.PERIOD // 60, WorldFXConfig.DAY.CLOCK_MIN, WorldFXConfig.DAY.CLOCK_MAX,
		if WorldFXKit.quality() == 1 then "hoch" else "niedrig"))
end

return DayCycleController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX79"><Properties>
<string name="Name">EventFXController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- EventFXController.luau
-- StarterPlayerScripts/Controllers/EventFXController.luau
--
-- Einzige Zustaendigkeit:
--   - Die bewegte Optik der lebendigen Events zeichnen: UFO-Patrouille,
--     fallende Abwurf-Kisten, Wespenkoenigin (samt HP-Leiste), Telegraphen der
--     Boss-Attacken, Himmel beim Boss — und Treffer am eigenen Charakter
--     ausfuehren und Event-Meldungen anzeigen.
--
-- Der Client rechnet und entscheidet nichts: Bahnen kommen aus
-- Modules/EventMotion (reine Funktionen der Serverzeit) und den Attributen,
-- die der Server einmal setzt (StartTime, Center, LandAt, Phase2At, HP).
-- Ob jemand getroffen ist, hat der Server entschieden (Remotes.EventHazardHit);
-- hier wird nur die Physik am EIGENEN Charakter ausgefuehrt, den der Client
-- besitzt.
--
-- PERFORMANCE: EIN RenderStepped fuer alles, ein PivotTo pro bewegtem Model
-- und Frame. Telegraphen sind wenige lokale Teile, die nach dem Treffer
-- verschwinden. Keine Lichter, keine Emitter.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local Lighting          = game:GetService("Lighting")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local EventMotion = require(ReplicatedStorage.Modules.EventMotion)
local Loc         = require(ReplicatedStorage.Localization.Loc)

local Theme = require(script.Parent.Parent.UI.Theme)
local Toast = require(script.Parent.Parent.UI.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify   = require(script.Parent.Parent.UI.Notify)
local Feedback = require(script.Parent.Parent.UI.Feedback)
local Moment   = require(script.Parent.Parent.UI.Moment)

local EventFXController = {}

local localPlayer = Players.LocalPlayer

--------------------------------------------------------------------------------
-- Optik (keine Balance)
--------------------------------------------------------------------------------

local UFO_FOLDER   = "EventUfo"
local QUEEN_FOLDER = "EventWaspQueen"

local QUEEN_DESCENT_HEIGHT = 60          -- waehrend der Ankuendigung von so hoch herab
local QUEEN_SPIN_WINGS     = 18          -- Fluegelschlag (Grad)

local TELEGRAPH_COLOR      = Color3.fromRGB(255, 70, 50)
local TELEGRAPH_SAFE_COLOR = Color3.fromRGB(90, 230, 120)
local TELEGRAPH_FLASH      = 0.25        -- so lange blitzt die Flaeche beim Treffer
local TELEGRAPH_THICKNESS  = 0.3
local TELEGRAPH_LIFT       = 0.35

local HP_BAR_SIZE    = UDim2.fromOffset(260, 46)
local HP_BAR_OFFSET  = Vector3.new(0, 14, 0)
local HP_BAR_COLOR   = Color3.fromRGB(255, 190, 40)
local HP_BAR_BACK    = Color3.fromRGB(30, 26, 22)

local SKY_TINT       = Color3.fromRGB(255, 205, 170)
local SKY_BRIGHTNESS = -0.12
local SKY_SATURATION = -0.15
local SKY_TWEEN      = 3

local HIT_UPWARD     = 22               -- kleiner Hopser beim Rueckstoss

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

type Crate = { model: Model, release: number, land: number, parts: { { part: BasePart, base: CFrame } }, canopy: BasePart?, landed: boolean }

local _ufo: { folder: Instance, model: Model?, start: number, center: Vector3 }? = nil
local _crates: { [Model]: Crate } = {}
local _queen: { folder: Instance, model: Model?, start: number, center: Vector3 }? = nil
local _telegraphs: { { parts: { BasePart }, hitAt: number, until_: number } } = {}
local _fxFolder: Folder? = nil

local function fxFolder(): Folder
	local folder = _fxFolder
	if folder and folder.Parent then
		return folder
	end
	local created = Instance.new("Folder")
	created.Name = "EventFX_Local"
	created.Parent = Workspace
	_fxFolder = created
	return created
end

local function localPart(props: { [string]: any }): BasePart
	local part: any = Instance.new("Part")
	part.Anchored   = true
	part.CanCollide = false
	part.CanQuery   = false
	part.CanTouch   = false
	part.CastShadow = false
	for key, value in props do
		part[key] = value
	end
	part.Parent = fxFolder()
	return part
end

--------------------------------------------------------------------------------
-- UFO und Kisten
--------------------------------------------------------------------------------

local function trackCrate(child: Instance)
	if not child:IsA("Model") or child.Name ~= "UfoDrop" then return end
	local release = child:GetAttribute("ReleaseAt")
	local land    = child:GetAttribute("LandAt")
	if typeof(release) ~= "number" or typeof(land) ~= "number" then return end

	-- Nur Kiste und Schirm fallen; Landekreis und Lichtsaeule stehen am Boden.
	local parts = {}
	for _, name in { "Crate", "Canopy" } do
		local part = child:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			table.insert(parts, { part = part, base = part.CFrame })
		end
	end
	local canopy = child:FindFirstChild("Canopy")
	_crates[child] = {
		model = child, release = release, land = land, parts = parts,
		canopy = if canopy and canopy:IsA("BasePart") then canopy else nil,
		landed = false,
	}
end

local function hookUfoFolder(folder: Instance)
	local start  = folder:GetAttribute("StartTime")
	local center = folder:GetAttribute("Center")
	if typeof(start) ~= "number" or typeof(center) ~= "Vector3" then
		-- Attribute kommen mit dem Ordner; ein Frame spaeter nochmal.
		task.defer(function()
			if folder.Parent and not _ufo then hookUfoFolder(folder) end
		end)
		return
	end
	local model = folder:FindFirstChild("Ufo")
	_ufo = { folder = folder, model = if model and model:IsA("Model") then model else nil, start = start, center = center }

	for _, child in folder:GetChildren() do
		trackCrate(child)
	end
	folder.ChildAdded:Connect(function(child)
		if child.Name == "Ufo" and child:IsA("Model") and _ufo and _ufo.folder == folder then
			_ufo.model = child
		end
		-- Kinder eines Models kommen evtl. nach dem Model an.
		task.defer(trackCrate, child)
	end)
	folder.ChildRemoved:Connect(function(child)
		if child:IsA("Model") then _crates[child] = nil end
	end)
end

local function animateUfo(now: number)
	local ufo = _ufo
	if not ufo then return end
	if not ufo.folder.Parent then
		_ufo = nil
		table.clear(_crates)
		return
	end
	local model = ufo.model
	if model and model.Parent then
		model:PivotTo(CFrame.new(EventMotion.ufoGround(ufo.center, ufo.start, now)))
	end

	for crateModel, crate in _crates do
		if not crateModel.Parent then
			_crates[crateModel] = nil
			continue
		end
		if crate.landed then continue end
		local height = if now < crate.release then EventMotion.DROP_FALL_HEIGHT else EventMotion.dropHeight(crate.release, crate.land, now)
		-- Vor dem Abwurf noch unsichtbar (unter dem UFO): ganz oben halten.
		for _, entry in crate.parts do
			entry.part.CFrame = entry.base + Vector3.new(0, height, 0)
		end
		if now >= crate.land then
			crate.landed = true
			local canopy = crate.canopy
			if canopy then canopy.Transparency = 1 end
		end
	end
end

--------------------------------------------------------------------------------
-- Wespenkoenigin
--------------------------------------------------------------------------------

local _hpFill: Frame? = nil
local _hpText: TextLabel? = nil

local function refreshHp(model: Model)
	local fill, text = _hpFill, _hpText
	if not fill or not text then return end
	local hp = model:GetAttribute("HP")
	local maxHp = model:GetAttribute("MaxHP")
	if typeof(hp) ~= "number" or typeof(maxHp) ~= "number" or maxHp <= 0 then
		fill.Size = UDim2.fromScale(1, 1)
		text.Text = Loc.t("ui.boss.name")
		return
	end
	fill.Size = UDim2.fromScale(math.clamp(hp / maxHp, 0, 1), 1)
	text.Text = Loc.t("ui.boss.hp", { hp = Loc.formatNumber(hp), max = Loc.formatNumber(maxHp) })
end

local function buildHpBar(model: Model)
	local head = model:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then return end

	local gui = Instance.new("BillboardGui")
	gui.Name        = "BossHp"
	gui.Size        = HP_BAR_SIZE
	gui.StudsOffset = HP_BAR_OFFSET
	gui.AlwaysOnTop = true
	gui.Adornee     = head
	gui.Parent      = model

	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.new(1, 0, 0, 18)
	back.Position = UDim2.new(0, 0, 1, -18)
	back.BackgroundColor3 = HP_BAR_BACK
	back.BorderSizePixel = 0
	back.Parent = gui
	Theme.corner(back, 6)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = HP_BAR_COLOR
	fill.BorderSizePixel = 0
	fill.Parent = back
	Theme.corner(fill, 6)

	local text = Theme.label("Name", gui, "")
	text.Size = UDim2.new(1, 0, 0, 24)
	text.TextXAlignment = Enum.TextXAlignment.Center
	text.TextColor3 = Theme.COLORS.goldGummy

	_hpFill, _hpText = fill, text
	refreshHp(model)
	model:GetAttributeChangedSignal("HP"):Connect(function() refreshHp(model) end)
	model:GetAttributeChangedSignal("MaxHP"):Connect(function() refreshHp(model) end)
end

local function hookQueenFolder(folder: Instance)
	local start  = folder:GetAttribute("StartTime")
	local center = folder:GetAttribute("Center")
	if typeof(start) ~= "number" or typeof(center) ~= "Vector3" then
		task.defer(function()
			if folder.Parent and not _queen then hookQueenFolder(folder) end
		end)
		return
	end
	_queen = { folder = folder, model = nil, start = start, center = center }

	local function adopt(child: Instance)
		if child.Name == "WaspQueen" and child:IsA("Model") and _queen and _queen.folder == folder then
			_queen.model = child
			task.defer(buildHpBar, child)
		end
	end
	for _, child in folder:GetChildren() do adopt(child) end
	folder.ChildAdded:Connect(adopt)
end

local function animateQueen(now: number)
	local queen = _queen
	if not queen then return end
	if not queen.folder.Parent then
		_queen = nil
		_hpFill, _hpText = nil, nil
		return
	end
	local model = queen.model
	if not model or not model.Parent then return end

	local phase2 = model:GetAttribute("Phase2At")
	local phase2At = if typeof(phase2) == "number" then phase2 else nil
	local pose: CFrame
	if now < queen.start then
		-- Ankuendigung: sinkt von oben herab auf ihre Bahn.
		local remaining = queen.start - now
		pose = EventMotion.queenPose(queen.center, queen.start, queen.start, nil)
			+ Vector3.new(0, QUEEN_DESCENT_HEIGHT * math.clamp(remaining / 20, 0, 1), 0)
	else
		pose = EventMotion.queenPose(queen.center, queen.start, now, phase2At)
	end
	model:PivotTo(pose)

	-- Fluegelschlag (lokal, rein optisch)
	local flap = math.rad(math.sin(now * 30) * QUEEN_SPIN_WINGS)
	for _, name in { "WingL", "WingR" } do
		local wing = model:FindFirstChild(name)
		if wing and wing:IsA("BasePart") then
			local sign = if name == "WingL" then 1 else -1
			wing.Transparency = 0.35 + 0.15 * math.abs(math.sin(now * 30))
			wing.CFrame = pose * CFrame.new(-5 * 1.6 * sign, 3 * 1.6, 1.6) * CFrame.Angles(0, 0, math.rad(20) * sign + flap * sign)
		end
	end
end

--------------------------------------------------------------------------------
-- Telegraphen
--------------------------------------------------------------------------------

local function disc(position: Vector3, radius: number, color: Color3, lift: number): BasePart
	return localPart({
		Name = "Telegraph", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon,
		Color = color, Transparency = 0.55,
		Size = Vector3.new(TELEGRAPH_THICKNESS, radius * 2, radius * 2),
		CFrame = CFrame.new(position + Vector3.new(0, lift, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	})
end

local function showTelegraph(t: Types.HazardTelegraph)
	local parts: { BasePart } = {}
	if t.kind == "ring" and t.center then
		table.insert(parts, disc(t.center, t.outer or 0, TELEGRAPH_COLOR, TELEGRAPH_LIFT))
		-- Innen ist sicher: gruene Scheibe knapp darueber.
		table.insert(parts, disc(t.center, t.inner or 0, TELEGRAPH_SAFE_COLOR, TELEGRAPH_LIFT + 0.05))
	elseif t.kind == "circles" and t.points then
		for _, point in t.points do
			table.insert(parts, disc(point, t.radius or 0, TELEGRAPH_COLOR, TELEGRAPH_LIFT))
		end
	elseif t.kind == "lane" and t.from and t.to then
		local from, to = t.from, t.to
		local mid = (from + to) / 2
		local length = (Vector3.new(to.X - from.X, 0, to.Z - from.Z)).Magnitude
		table.insert(parts, localPart({
			Name = "Telegraph", Material = Enum.Material.Neon, Color = TELEGRAPH_COLOR, Transparency = 0.55,
			Size = Vector3.new(t.width or 0, TELEGRAPH_THICKNESS, length),
			CFrame = CFrame.lookAt(mid + Vector3.new(0, TELEGRAPH_LIFT, 0), Vector3.new(to.X, mid.Y + TELEGRAPH_LIFT, to.Z)),
		}))
	end
	table.insert(_telegraphs, { parts = parts, hitAt = t.hitAt, until_ = t.hitAt + TELEGRAPH_FLASH })
end

local function animateTelegraphs(now: number)
	for i = #_telegraphs, 1, -1 do
		local t = _telegraphs[i]
		if now >= t.until_ then
			for _, part in t.parts do part:Destroy() end
			table.remove(_telegraphs, i)
		elseif now >= t.hitAt then
			for _, part in t.parts do part.Transparency = 0.05 end
		else
			-- pulsiert schneller, je naeher der Treffer
			local left = t.hitAt - now
			local pulse = 0.45 + 0.2 * math.sin(now * (8 + 12 / math.max(0.2, left)))
			for _, part in t.parts do
				if part.Color ~= TELEGRAPH_SAFE_COLOR then
					part.Transparency = pulse
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Treffer am eigenen Charakter
--------------------------------------------------------------------------------

local _slowToken = 0

local function onHit(info: any)
	if typeof(info) ~= "table" or typeof(info.push) ~= "Vector3" then return end
	local character = localPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not root or not root:IsA("BasePart") or not humanoid then return end

	root.AssemblyLinearVelocity = info.push + Vector3.new(0, HIT_UPWARD, 0)

	local factor  = if typeof(info.slowFactor) == "number" then info.slowFactor else 1
	local seconds = if typeof(info.slowSeconds) == "number" then info.slowSeconds else 0
	if factor < 1 and seconds > 0 then
		_slowToken += 1
		local token = _slowToken
		local before = humanoid.WalkSpeed
		local slowed = before * factor
		humanoid.WalkSpeed = slowed
		task.delay(seconds, function()
			-- Nur zuruecksetzen, wenn niemand sonst (CombService) inzwischen
			-- einen anderen Wert gesetzt hat.
			if token == _slowToken and humanoid.Parent and humanoid.WalkSpeed == slowed then
				humanoid.WalkSpeed = before
			end
		end)
	end
	Notify.emit("boss_hit", function()
		Toast.show(Loc.t("ui.boss.hit"), Theme.COLORS.bad)
	end)
end

--------------------------------------------------------------------------------
-- Himmel beim Boss
--------------------------------------------------------------------------------

local _sky: ColorCorrectionEffect? = nil

local function setBossSky(active: boolean)
	local sky = _sky
	if not sky then
		local created = Instance.new("ColorCorrectionEffect")
		created.Name = "BossSky_Local"
		created.Parent = Lighting
		sky = created
		_sky = created
	end
	local effect = sky :: ColorCorrectionEffect
	TweenService:Create(effect, TweenInfo.new(SKY_TWEEN), {
		TintColor  = if active then SKY_TINT else Color3.new(1, 1, 1),
		Brightness = if active then SKY_BRIGHTNESS else 0,
		Saturation = if active then SKY_SATURATION else 0,
	}):Play()
end

--------------------------------------------------------------------------------
-- Belohnungs-Momente (Icon-Weg von "event_notice_good")
--------------------------------------------------------------------------------

-- HBB Paket 7: Truhenfarbe je Boss-Stufe 1..4 (Bronze, Silber, Gold, Lila)
local BOSS_TIER_COLORS = {
	Color3.fromRGB(205, 127, 50), Color3.fromRGB(200, 210, 225),
	Color3.fromRGB(255, 200, 40), Color3.fromRGB(190, 110, 255),
}

-- Zeigt zu einer bekannten Belohnungsnotiz das passende Bild ohne Text.
-- Rueckgabe false = Notiz unbekannt, der Aufrufer faellt auf den Toast zurueck.
local function playRewardMoment(key: any, args: any): boolean
	if key == "msg.boss.tier" then
		-- Truhe in der Stufenfarbe; die Inhalte fliegen danach ueber den
		-- Datenstand in die Pillen.
		local tier = if typeof(args) == "table" and typeof(args.tier) == "number" then args.tier else 1
		Moment.show("chest", BOSS_TIER_COLORS[math.clamp(tier, 1, 4)], nil)
	elseif key == "msg.event.rarity_up" then
		local to = if typeof(args) == "table" and Loc.isMsg(args.to) then args.to.k else nil
		local rarity = if typeof(to) == "string" then string.gsub(to, "^rarity%.", "") else nil
		Moment.show("rarity", if rarity then Theme.rarityColor(rarity :: any) else Theme.COLORS.goldGummy, "ui.moment.rarity")
	elseif key == "msg.event.combs" then
		local n = if typeof(args) == "table" and typeof(args.n) == "number" then args.n else 1
		Feedback.gain("comb", n)
	elseif key == "msg.event.gummies" or key == "msg.ufo.drop_picked" then
		-- schon ueber den Datenstand sichtbar
	else
		return false
	end
	return true
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function EventFXController.init()
	local function onWorkspaceChild(child: Instance)
		if child.Name == UFO_FOLDER then
			hookUfoFolder(child)
		elseif child.Name == QUEEN_FOLDER then
			hookQueenFolder(child)
		end
	end
	for _, child in Workspace:GetChildren() do
		onWorkspaceChild(child)
	end
	Workspace.ChildAdded:Connect(onWorkspaceChild)

	Remotes.EventTelegraph.OnClientEvent:Connect(function(t: any)
		if typeof(t) ~= "table" or typeof(t.hitAt) ~= "number" then return end
		showTelegraph(t :: Types.HazardTelegraph)
	end)

	Remotes.EventHazardHit.OnClientEvent:Connect(onHit)

	Remotes.EventNotice.OnClientEvent:Connect(function(msg: any, style: any)
		if not Loc.isMsg(msg) and typeof(msg) ~= "string" then return end
		if style == "big" then
			Notify.emit("event_notice_big", function()
				Toast.show(msg, Theme.COLORS.goldGummy)
			end)
		elseif style == "good" then
			Notify.emit("event_notice_good", function()
				Toast.success(msg)
			end, function()
				-- Gummies und Eier fliegen schon ueber den Datenstand
				-- (UI/Feedback). Hier nur, was dort nicht sichtbar wird.
				if not (Loc.isMsg(msg) and playRewardMoment((msg :: any).k, (msg :: any).a)) then
					-- Unbekannte Belohnungsnotiz: lieber lesen als verlieren
					Toast.success(msg)
				end
			end)
		else
			Notify.emit("event_notice_info", function()
				Toast.info(msg)
			end)
		end
	end)

	Remotes.EventPhaseChanged.OnClientEvent:Connect(function(eventId: any)
		setBossSky(eventId == "WaspQueen")
	end)

	RunService.RenderStepped:Connect(function()
		local now = Workspace:GetServerTimeNow()
		animateUfo(now)
		animateQueen(now)
		animateTelegraphs(now)
	end)

	print("[EventFXController] Initialisiert")
end

return EventFXController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX80"><Properties>
<string name="Name">GuideController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- GuideController.luau
-- StarterPlayerScripts/Controllers/GuideController.luau
--
-- Einzige Zustaendigkeit:
--   - Den aktuellen Fuehrungsschritt (Modules/GuideSteps) sichtbar machen:
--     Ziel in der Welt → leuchtender Beam vom Charakter zum Ziel,
--     Ziel in der Oberflaeche → pulsierender Rahmen und Pfeil am Knopf
--
-- Kontext: HBB Paket 2. Kein Text, hoechstens ein Icon. Passiert eine Weile
-- nichts (FeedbackConfig/GUIDE_HINT_SECONDS), wird die Hervorhebung staerker
-- ("Timed Hint").
--
-- Alles hier ist rein lokal: der Beam, die Attachments und der Rahmen
-- existieren nur auf diesem Client, ohne Kollision und ohne Remote.
--
-- Mit FeatureFlags.UI_V2_GUIDE = false zeigt dieses Modul nichts.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local GuideSteps   = require(ReplicatedStorage.Modules.GuideSteps)
local EggConfig    = require(ReplicatedStorage.Config.EggConfig)

local UI          = script.Parent.Parent:WaitForChild("UI")
local Theme       = require(UI:WaitForChild("Theme"))
local UiScale     = require(UI:WaitForChild("UiScale"))
local MenuBar     = require(UI:WaitForChild("MenuBar"))
local PetBar      = require(UI:WaitForChild("PetBar"))
local ClientState = require(script.Parent.ClientState)

local GuideController = {}

-- Nach so vielen Sekunden ohne Fortschritt wird die Hervorhebung staerker.
local HINT_AFTER_SECONDS = 12
local HIGHLIGHT_COLOR = Color3.fromRGB(255, 236, 140)
local BEAM_COLOR      = Color3.fromRGB(255, 220, 90)
local LAID_EGG_ATTRIBUTE = "LaidEggUid"

local _step: string? = nil
local _stepSince = 0
-- Welt-Ziel, im Takt von evaluate() gesucht (nicht jeden Frame: die Suche
-- laeuft ueber den Workspace)
local _worldTarget: BasePart? = nil

local _frame: Frame? = nil
local _stroke: UIStroke? = nil
local _arrow: TextLabel? = nil

local _beam: Beam? = nil
local _from: Attachment? = nil
local _to: Attachment? = nil

--------------------------------------------------------------------------------
-- Ziele
--------------------------------------------------------------------------------

local function uiTarget(step: string): GuiObject?
	if step == "hatch" then
		return MenuBar.getTileAnchor("Hatch")
	elseif step == "fight" then
		return PetBar.getButton("Fight")
	elseif step == "event" then
		return PetBar.getButton("Event")
	end
	return nil
end

local function characterRoot(): BasePart?
	local character = Players.LocalPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	return if root and root:IsA("BasePart") then root else nil
end

-- Naechstes EIGENES gelegtes Ei (uid steht in den eigenen Daten).
local function nearestOwnEgg(): BasePart?
	local data = ClientState.get()
	local root = characterRoot()
	if not data or not root then return nil end
	local own: { [string]: boolean } = {}
	for _, egg in data.island.laidEggs do
		own[(egg :: any).uid] = true
	end
	local best: BasePart? = nil
	local bestDist = math.huge
	for _, descendant in Workspace:GetDescendants() do
		if descendant:IsA("BasePart") then
			local uid = descendant:GetAttribute(LAID_EGG_ATTRIBUTE)
			if typeof(uid) == "string" and own[uid] then
				local dist = (descendant.Position - root.Position).Magnitude
				if dist < bestDist then
					best, bestDist = descendant, dist
				end
			end
		end
	end
	return best
end

-- Theke des Ei-Haendlers (EggMerchantService baut das Model "EggMerchant")
local function merchantCounter(): BasePart?
	local model = Workspace:FindFirstChild("EggMerchant")
	local counter = if model then model:FindFirstChild("Counter") else nil
	return if counter and counter:IsA("BasePart") then counter else nil
end

local function worldTarget(step: string): BasePart?
	if step == "collect" then
		return nearestOwnEgg()
	elseif step == "merchant" then
		return merchantCounter()
	end
	return nil
end

--------------------------------------------------------------------------------
-- Darstellung
--------------------------------------------------------------------------------

local function clearBeam()
	if _beam then _beam:Destroy() end
	if _from then _from:Destroy() end
	if _to then _to:Destroy() end
	_beam, _from, _to = nil, nil, nil
end

local function showBeam(target: BasePart)
	local root = characterRoot()
	if not root then
		clearBeam()
		return
	end
	if _to and _to.Parent == target and _from and _from.Parent == root then
		return
	end
	clearBeam()
	local from = Instance.new("Attachment")
	from.Name = "GuideFrom"
	from.Parent = root
	local to = Instance.new("Attachment")
	to.Name = "GuideTo"
	to.Position = Vector3.new(0, 1, 0)
	to.Parent = target
	local beam = Instance.new("Beam")
	beam.Name = "GuideBeam"
	beam.Attachment0 = from
	beam.Attachment1 = to
	beam.Color = ColorSequence.new(BEAM_COLOR)
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Width0 = 0.5
	beam.Width1 = 0.5
	beam.Segments = 12
	beam.CurveSize0 = 4
	beam.Transparency = NumberSequence.new(0.15)
	beam.Parent = root
	_beam, _from, _to = beam, from, to
end

local function hideHighlight()
	if _frame then _frame.Visible = false end
	if _arrow then _arrow.Visible = false end
end

local function showHighlight(target: GuiObject, strong: boolean, t: number)
	local frame, stroke, arrow = _frame, _stroke, _arrow
	if not frame or not stroke or not arrow then return end
	if not target.Visible then
		hideHighlight()
		return
	end
	-- Bildschirm-Pixel -> Oberflaechen-Einheiten (globale UiScale)
	local pos, size = UiScale.toGui(target.AbsolutePosition), UiScale.toGui(target.AbsoluteSize)
	local pad = 6
	frame.Position = UDim2.fromOffset(pos.X - pad, pos.Y - pad)
	frame.Size = UDim2.fromOffset(size.X + pad * 2, size.Y + pad * 2)
	frame.Visible = true

	local wave = (math.sin(t * (if strong then 9 else 5)) + 1) * 0.5
	stroke.Thickness = (if strong then 5 else 3) + wave * (if strong then 4 else 2)
	stroke.Transparency = 0.1 + (1 - wave) * 0.4

	-- Pfeil zeigt von oben auf den Knopf (die Kachelleiste rechts: von links)
	local screen = frame.Parent :: GuiObject
	local fromLeft = pos.X > UiScale.toGui(screen.AbsoluteSize.X) * 0.8
	local bounce = wave * (if strong then 18 else 8)
	arrow.Visible = true
	if fromLeft then
		-- "➡" statt "➜": "➜" kann die Spielschrift nicht darstellen.
		arrow.Text = "➡"
		arrow.Position = UDim2.fromOffset(pos.X - 48 - bounce, pos.Y + size.Y * 0.5 - 20)
	else
		arrow.Text = "⬇"
		arrow.Position = UDim2.fromOffset(pos.X + size.X * 0.5 - 20, pos.Y - 46 - bounce)
	end
end

--------------------------------------------------------------------------------
-- Takt
--------------------------------------------------------------------------------

local function evaluate()
	local data = ClientState.get()
	local step: string? = nil
	if data and FeatureFlags.isOn("UI_V2_GUIDE") then
		-- HBB Paket 5: Haendler-Schritt nur mit sichtbarem Haendler
		local options = if FeatureFlags.isOn("MAP_V2_MERCHANT")
			then { merchantPrice = EggConfig.MERCHANT.priceGummies }
			else nil
		step = GuideSteps.current(data :: any, options)
	end
	if step ~= _step then
		_step = step
		_stepSince = os.clock()
	end
	_worldTarget = if step then worldTarget(step) else nil
end

local function render()
	local step = _step
	if not step then
		hideHighlight()
		clearBeam()
		return
	end
	local now = os.clock()
	local strong = now - _stepSince >= HINT_AFTER_SECONDS

	local target = uiTarget(step)
	if target then
		clearBeam()
		showHighlight(target, strong, now)
		return
	end
	hideHighlight()

	local part = _worldTarget
	if part and part.Parent then
		showBeam(part)
		local beam = _beam
		if beam then
			local w = if strong then 0.9 + math.sin(now * 8) * 0.3 else 0.5
			beam.Width0, beam.Width1 = w, w
		end
	else
		clearBeam()
	end
end

function GuideController.init(screenGui: ScreenGui)
	local frame = Theme.container("GuideHighlight", screenGui)
	frame.ZIndex = 40
	frame.Visible = false
	Theme.corner(frame, 16)
	local stroke = Instance.new("UIStroke")
	stroke.Color = HIGHLIGHT_COLOR
	stroke.Thickness = 3
	stroke.Parent = frame
	_frame, _stroke = frame, stroke

	local arrow = Theme.label("GuideArrow", screenGui, "⬇")
	arrow.Size = UDim2.fromOffset(40, 40)
	arrow.TextXAlignment = Enum.TextXAlignment.Center
	arrow.TextColor3 = HIGHLIGHT_COLOR
	arrow.ZIndex = 41
	arrow.Visible = false
	Theme.outlineText(arrow, 3)
	_arrow = arrow

	ClientState.onChanged(function()
		evaluate()
	end)

	-- Gelegte Eier tauchen ohne Datenaenderung auf/ab (Replikation): der
	-- Welt-Schritt wird deshalb im Takt neu gesucht, die Anzeige jeden Frame.
	local accumulator = 0
	RunService.RenderStepped:Connect(function(delta)
		accumulator += delta
		if accumulator >= 0.5 then
			accumulator = 0
			evaluate()
		end
		render()
	end)

	print("[GuideController] Initialisiert")
end

return GuideController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX81"><Properties>
<string name="Name">HubEventController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- HubEventController.luau
-- StarterPlayerScripts/Controllers/HubEventController.luau
--
-- Einzige Zustaendigkeit:
--   - Die Hauptinsel zeigt den Event-Zustand (Paket C, "Welt aufwerten"):
--     Wimpelkette und Lichter am Event-Pit (Ruhe / startet bald / laeuft),
--     kreisende Wespen und Puls am Wespen-Nest (ruhig / Boss bald oder da)
--
-- Der Client erfindet keine Event-Logik. Er liest, was der Server ohnehin in
-- die Welt schreibt:
--   * Event laeuft     = der Ring des Event-Pits ist Neon (MapService.setEventPitTheme),
--                        seine Farbe ist die Event-Farbe
--   * Restzeit         = die Countdown-Tafel ueber dem Pit ("in 0:45"), jede
--                        Sekunde vom Server beschrieben (EventService.tick)
--   * Boss bald/da     = das Wespen-Nest leuchtet (MapService.setWaspNest,
--                        WASP_NEST.glowSeconds vor dem Boss und waehrenddessen)
-- Warum nicht EventPhaseChanged: die Join-Meldung landet in der Warteschlange
-- und geht an den ersten Zuhoerer (PetBar), dieser Controller kaeme zu spaet.
--
-- PERFORMANCE: EIN Takt (20x pro Sekunde); die Wimpel bewegt EIN
-- workspace:BulkMoveTo, nur wenn der Pit-Rahmen in Sichtweite ist. Keine
-- Lichter, kein Emitter. Puls weit unter 3 Hz.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local SoundService      = game:GetService("SoundService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit = require(script.Parent.WorldFXKit)
-- Paket G: Event-Start als Welt-Moment (Krone blinkt, Bienen ziehen los)
local WorldMomentController = require(script.Parent.WorldMomentController)
-- Paket H: Stimmengewirr am Pit nur waehrend eines Events
local SoundscapeController = require(script.Parent.SoundscapeController)

local HubEventController = {}

local TICK = 0.05
local TAU = math.pi * 2

export type PitState = "idle" | "soon" | "live"

type Pennant = { part: BasePart, hang: CFrame, phase: number }

local _pitGroup: Instance? = nil
local _pennants: { Pennant } = {}
local _pennantParts: { BasePart } = {}
local _lanterns: { BasePart } = {}
local _lights: { BasePart } = {}
local _pitState: PitState = "idle"
local _pitStateKnown = false   -- erst nach dem ersten Lesen: ein Beitritt mitten im Event ist kein Start
local _pitOverride: PitState? = nil
local _eventColor = Color3.fromRGB(255, 214, 110)

local _nestGroup: Instance? = nil
local _nestCenter = Vector3.zero
local _wasps: { Model } = {}
local _pulse: BasePart? = nil
local _hum: Sound? = nil
local _nestBoss = false
local _nestOverride: boolean? = nil

--------------------------------------------------------------------------------
-- Event-Zustand aus der Welt lesen
--------------------------------------------------------------------------------

local _ring: BasePart? = nil
local _sub: TextLabel? = nil

local function findPitSources()
	local platform = workspace:WaitForChild("Platform", 60)
	local pit = platform and platform:WaitForChild("EventPit", 30)
	if not pit then return end
	local ring = pit:WaitForChild("EventRing", 30)
	if ring and ring:IsA("BasePart") then _ring = ring end
	local anchor = pit:WaitForChild("EventBannerAnchor", 30)
	local banner = anchor and anchor:WaitForChild("Banner", 30)
	local sub = banner and banner:WaitForChild("Sub", 30)
	if sub and sub:IsA("TextLabel") then _sub = sub end
end

-- Restzeit aus "noch 3:12" / "in 0:45" (Sprache egal: nur die Uhrzeit zaehlt).
local function remainingSeconds(): number?
	local sub = _sub
	if not sub then return nil end
	local m, s = string.match(sub.Text, "(%d+):(%d%d)")
	if not (m and s) then return nil end
	return (tonumber(m) :: number) * 60 + (tonumber(s) :: number)
end

local function readPitState(): PitState
	local override = _pitOverride
	if override then return override end
	local ring = _ring
	if ring and ring.Material == Enum.Material.Neon then
		_eventColor = ring.Color
		return "live"
	end
	local left = remainingSeconds()
	if left and left <= WorldFXConfig.PIT_FRAME.SOON_SECONDS then
		return "soon"
	end
	return "idle"
end

--------------------------------------------------------------------------------
-- Pit-Rahmen
--------------------------------------------------------------------------------

local function pitFloorY(): number
	return MapConfig.PLATFORM_TOP_Y + MapConfig.EVENT_PIT_GROUND_CLEARANCE
end

local function buildPitFrame(folder: Instance)
	local cfg = WorldFXConfig.PIT_FRAME
	local group = WorldFXKit.folder("PitFrame", folder)
	local pennantId = WorldFXKit.textureId("pennant_fabric")

	local count = MapConfig.PLOT_COUNT
	local tops: { Vector3 } = {}
	for k = 0, count - 1 do
		-- Masten in den Zaunfeldern zwischen zwei Stegen (Test: map_layout)
		local foot = MapLayout.atAngle(180 / count + k * (360 / count), cfg.POLE_RADIUS)
		foot = Vector3.new(foot.X, pitFloorY() - 0.3, foot.Z)
		WorldFXKit.pole("Pole", group, foot, cfg.POLE_HEIGHT, 0.5, cfg.POLE_COLOR, Enum.Material.Wood)
		local top = foot + Vector3.new(0, cfg.POLE_HEIGHT, 0)
		table.insert(tops, top)
		table.insert(_lanterns, WorldFXKit.ball("Lantern", group, 1.2, top + Vector3.new(0, 0.5, 0), cfg.LANTERN_OFF, Enum.Material.SmoothPlastic))
	end

	-- Kette zwischen zwei Nachbarmasten, mit Durchhang
	local colorIndex = 0
	for k = 1, count do
		local a, b = tops[k], tops[k % count + 1]
		local chord = b - a
		local along = Vector3.new(chord.X, 0, chord.Z).Unit
		local function hangAt(t: number): Vector3
			return a + chord * t - Vector3.new(0, cfg.SAG * 4 * t * (1 - t), 0)
		end
		for i = 1, cfg.PENNANTS do
			local t = i / (cfg.PENNANTS + 1)
			local hang = CFrame.fromMatrix(hangAt(t), along, Vector3.yAxis)
			colorIndex += 1
			local color = cfg.PENNANT_COLORS[(colorIndex - 1) % #cfg.PENNANT_COLORS + 1]
			local part = WorldFXKit.part("Pennant", group, cfg.PENNANT_SIZE,
				hang * CFrame.new(0, -cfg.PENNANT_SIZE.Y * 0.5, 0), color, Enum.Material.Fabric)
			if pennantId then
				part.Transparency = 1
				for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
					local decal = Instance.new("Decal")
					decal.Texture = pennantId
					decal.Face = face
					decal.Color3 = color
					decal.Parent = part
				end
			end
			table.insert(_pennants, { part = part, hang = hang, phase = k * 0.9 + i * 0.55 })
			table.insert(_pennantParts, part)
		end
		for i = 1, cfg.LIGHTS do
			local t = (i - 0.5) / cfg.LIGHTS
			table.insert(_lights, WorldFXKit.ball("Light", group, 0.45, hangAt(t) + Vector3.new(0, 0.15, 0),
				cfg.LIGHT_OFF, Enum.Material.SmoothPlastic))
		end
	end

	_pitGroup = group
	WorldFXKit.cullGroup(group, MapConfig.CENTER, cfg.SHOW_DISTANCE)
end

local function applyPitState(state: PitState)
	local cfg = WorldFXConfig.PIT_FRAME
	for _, lantern in _lanterns do
		local on = state ~= "idle"
		lantern.Color = if on then cfg.LANTERN_ON else cfg.LANTERN_OFF
		lantern.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
	if state ~= "live" then
		for _, light in _lights do
			light.Color = cfg.LIGHT_OFF
			light.Material = Enum.Material.SmoothPlastic
		end
	else
		for _, light in _lights do
			light.Material = Enum.Material.Neon
		end
	end
end

local function stepPit(clock: number)
	local group = _pitGroup
	if not (group and group.Parent) then return end
	local cfg = WorldFXConfig.PIT_FRAME

	-- Wimpel: ein gemeinsamer Wind, je Wimpel versetzt; ein BulkMoveTo
	if WorldFXKit.enabled("pitFlutter") then
		local amp = math.rad(if _pitState == "idle" then cfg.FLUTTER_CALM else cfg.FLUTTER_SOON)
		local cframes = table.create(#_pennants)
		for i, p in _pennants do
			local swing = amp * math.sin(clock * cfg.FLUTTER_RATE * TAU + p.phase)
			cframes[i] = p.hang * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -cfg.PENNANT_SIZE.Y * 0.5, 0)
		end
		workspace:BulkMoveTo(_pennantParts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end

	-- Lichterkette pulsiert langsam in der Event-Farbe
	if _pitState == "live" then
		local k = 0.5 + 0.5 * math.sin(clock * cfg.PULSE_RATE * TAU)
		local color = cfg.LIGHT_OFF:Lerp(_eventColor, 0.35 + 0.65 * k)
		for _, light in _lights do
			light.Color = color
		end
	end
end

--------------------------------------------------------------------------------
-- Wespen-Nest
--------------------------------------------------------------------------------

local function buildNest(folder: Instance)
	local platform = workspace:WaitForChild("Platform", 60)
	local nest = platform and platform:WaitForChild("WaspNest", 30)
	if not nest then return end
	local cfg = WorldFXConfig.WASP_NEST
	local group = WorldFXKit.folder("NestLife", folder)
	_nestCenter = MapLayout.waspNestCenter()

	if WorldFXKit.enabled("waspSwarm") then
		for i = 1, cfg.WASPS_BOSS do
			local model = Instance.new("Model")
			model.Name = "Wasp"
			local body = WorldFXKit.ellipsoid("Body", model, Vector3.new(0.38, 0.38, 0.62), CFrame.new(), cfg.WASP_COLOR,
				Enum.Material.SmoothPlastic)
			WorldFXKit.part("Stripe", model, Vector3.new(0.4, 0.12, 0.2), CFrame.new(0, 0, 0.05), cfg.STRIPE_COLOR, Enum.Material.SmoothPlastic)
			model.PrimaryPart = body
			model.Parent = if i <= cfg.WASPS_CALM then group else nil
			table.insert(_wasps, model)
		end
	end

	if WorldFXKit.enabled("waspPulse") then
		local body = nest:FindFirstChild("Body")
		local size = if body and body:IsA("BasePart") then body.Size * 1.18 else Vector3.new(5, 6, 5)
		local pulse = WorldFXKit.ellipsoid("Pulse", group, size, CFrame.new(_nestCenter), cfg.PULSE_COLOR,
			Enum.Material.Neon)
		pulse.Transparency = 1
		_pulse = pulse

		local humId = WorldFXConfig.SOUNDS.waspHum
		if humId ~= "" then
			local soundGroup = SoundService:FindFirstChild("WorldAmbience")
			if not soundGroup then
				local created = Instance.new("SoundGroup")
				created.Name = "WorldAmbience"
				created.Parent = SoundService
				soundGroup = created
			end
			local hum = Instance.new("Sound")
			hum.SoundId = humId
			hum.Looped = true
			hum.Volume = WorldFXConfig.SOUND_VOLUME.waspHum
			hum.RollOffMaxDistance = 60
			hum.RollOffMinDistance = 8
			hum.SoundGroup = soundGroup :: SoundGroup
			hum.Parent = pulse
			hum:Play()
			_hum = hum
		end
	end

	_nestGroup = group
	WorldFXKit.cullGroup(group, _nestCenter, cfg.SHOW_DISTANCE)

	-- Boss bald/da: das Nest leuchtet (Server)
	local body = nest:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		local function refresh()
			_nestBoss = body.Material == Enum.Material.Neon
		end
		body:GetPropertyChangedSignal("Material"):Connect(refresh)
		refresh()
	end
end

local function stepNest(clock: number)
	local group = _nestGroup
	if not (group and group.Parent) then return end
	local cfg = WorldFXConfig.WASP_NEST
	local boss = if _nestOverride ~= nil then _nestOverride else _nestBoss

	local count = if boss then cfg.WASPS_BOSS else cfg.WASPS_CALM
	for i, wasp in _wasps do
		local show = i <= count
		if show ~= (wasp.Parent ~= nil) then
			wasp.Parent = if show then group else nil
		end
		if show then
			local speed = cfg.ORBIT_SPEED * (1 + 0.18 * i) * (if boss then 1.6 else 1)
			local a = clock * speed * TAU + i * TAU / count
			local r = cfg.ORBIT_RADIUS + 0.7 * math.sin(clock * 1.3 + i)
			local pos = _nestCenter + Vector3.new(math.cos(a) * r, math.sin(clock * 2 + i * 1.7) * 1.2, math.sin(a) * r)
			local ahead = Vector3.new(-math.sin(a), 0, math.cos(a))
			wasp:PivotTo(CFrame.lookAt(pos, pos + ahead))
		end
	end

	local pulse = _pulse
	if pulse then
		pulse.Transparency = if boss then 0.6 + 0.25 * math.sin(clock * cfg.PULSE_RATE * TAU) else 1
	end
	local hum = _hum
	if hum then
		hum.Volume = WorldFXConfig.SOUND_VOLUME.waspHum * (if boss then 1.5 else 1)
	end
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function HubEventController.init()
	if not FeatureFlags.isOn("WORLD_C_HUB") then return end
	local folder = WorldFXKit.folder("HubEvents", WorldFXKit.root())

	if WorldFXKit.enabled("pitFrame") then
		buildPitFrame(folder)
		task.spawn(findPitSources)
	end
	task.spawn(buildNest, folder)

	-- Debug (Studio): Zustaende erzwingen, "auto" = aus der Welt lesen
	WorldFXKit.onDebug("DebugPitState", function(value: any)
		_pitOverride = if value == "idle" or value == "soon" or value == "live" then value else nil
		if _pitOverride == "live" then
			_eventColor = Color3.fromRGB(255, 140, 240)
		end
	end)
	WorldFXKit.onDebug("DebugNestState", function(value: any)
		_nestOverride = if value == "boss" then true elseif value == "calm" then false else nil
	end)

	local acc, stateAcc, clock = 0, 1, 0
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		acc += dt
		stateAcc += dt
		if stateAcc >= 0.5 then
			stateAcc = 0
			local state = readPitState()
			if state ~= _pitState then
				if state == "live" and _pitStateKnown then
					WorldMomentController.eventStarted()
				end
				_pitState = state
				applyPitState(state)
				SoundscapeController.setEventLive(state == "live")
			end
			_pitStateKnown = _ring ~= nil or _pitOverride ~= nil
		end
		if acc < TICK then return end
		acc = 0
		stepPit(clock)
		stepNest(clock)
	end)

	print("[HubEvents] aktiv")
end

return HubEventController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX82"><Properties>
<string name="Name">HubLandmarkController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- HubLandmarkController.luau
-- StarterPlayerScripts/Controllers/HubLandmarkController.luau
--
-- Einzige Zustaendigkeit:
--   - Die festen Wahrzeichen der Hauptinsel aufwerten (Paket C, "Welt
--     aufwerten"): Wabenkrone und Honigfaden am Honigmast, Wegweiser an den
--     Wegen, Laterne und Eierkorb am Haendler, Holzrahmen mit Krone an den
--     Tafeln und der Glanz auf Platz 1
--
-- Was auf Events reagiert (Pit-Rahmen, Wespen-Nest), steht in
-- HubEventController; die Ankunft in ArrivalController.
--
-- Alles nur auf dem Client (WorldFX_Local): kein Server-Teil, keine
-- Replikation, die Wegweiser in der Sprache des Betrachters. Positionen aus
-- MapLayout/MapConfig (Test: map_layout.test.lua), Zahlen aus WorldFXConfig.
--
-- PERFORMANCE: EIN Takt (20x pro Sekunde) fuer Tropfen und Glanz, nur wenn
-- die jeweilige Gruppe in Sichtweite ist (WorldFXKit.cullGroup). Wegweiser,
-- Haendler-Deko und Rahmen stehen still und kosten ausser Sichtweite nichts.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)
local Loc           = require(ReplicatedStorage.Localization.Loc)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)

local HubLandmarkController = {}

local localPlayer = Players.LocalPlayer
local UPRIGHT = WorldFXKit.UPRIGHT
local TICK = 0.05

-- Mast-Fuss: Oberkante des Event-Pit-Podests (wie WorldBuilder.buildPlatform)
local MAST_FOOT = Vector3.new(
	MapConfig.CENTER.X,
	MapConfig.PLATFORM_TOP_Y + MapConfig.EVENT_PIT_GROUND_CLEARANCE + MapConfig.EVENT_PIT_FLOOR_HEIGHT,
	MapConfig.CENTER.Z
)

type Drip = { group: Instance, drop: BasePart, ring: BasePart, spout: Vector3, surfaceY: number, cycleStart: number }
local _drip: Drip? = nil

type Shine = { gradient: UIGradient, group: Instance }
local _shines: { Shine } = {}

type SignLabel = { label: TextLabel, slot: number }
local _islandLabels: { SignLabel } = {}

--------------------------------------------------------------------------------
-- Honigmast: Wabenkrone
--------------------------------------------------------------------------------

-- Ein Teil, dessen +X nach `outward` zeigt (Zylinder-Stirnseite nach aussen).
local function facing(position: Vector3, outward: Vector3): CFrame
	return CFrame.fromMatrix(position, outward, Vector3.yAxis)
end

local _crownCells: { BasePart } = {}

local function buildCrown(folder: Instance)
	local cfg = WorldFXConfig.MAST
	local model = Instance.new("Model")
	model.Name = "MastCrown"
	local combId = WorldFXKit.textureId("amber_comb")

	for row = 0, 1 do
		local y = MAST_FOOT.Y + cfg.CROWN_HEIGHT + (row - 0.5) * cfg.CROWN_ROW_GAP
		for i = 0, cfg.CROWN_CELLS - 1 do
			-- zweite Reihe um eine halbe Zelle versetzt: wie echte Waben
			local angle = (i + row * 0.5) / cfg.CROWN_CELLS * math.pi * 2
			local outward = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local p = Vector3.new(MAST_FOOT.X, y, MAST_FOOT.Z) + outward * cfg.CROWN_RADIUS
			local cell = WorldFXKit.part("Comb", model, Vector3.new(cfg.CELL_DEPTH, cfg.CELL_SIZE, cfg.CELL_SIZE),
				facing(p, outward), cfg.CELL_DAY, Enum.Material.Neon, Enum.PartType.Cylinder)
			if combId then
				local decal = Instance.new("Decal")
				decal.Texture = combId
				decal.Face = Enum.NormalId.Right
				decal.Parent = cell
			end
			DayCycleController.registerGlow(cell, cfg.CELL_DAY, cfg.CELL_NIGHT)
			table.insert(_crownCells, cell)
		end
	end
	model.Parent = folder
end

--------------------------------------------------------------------------------
-- Honigmast: Faden, Tuelle, Schale, Tropfen
--------------------------------------------------------------------------------

local function buildHoneyThread(folder: Instance)
	local cfg = WorldFXConfig.MAST
	local group = WorldFXKit.folder("HoneyThread", folder)
	local angle = math.rad(cfg.THREAD_ANGLE)
	local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))

	-- Faden am Mast herab
	local length = cfg.THREAD_TOP - cfg.THREAD_BOTTOM
	local threadBase = MAST_FOOT + dir * cfg.THREAD_RADIUS + Vector3.new(0, cfg.THREAD_BOTTOM, 0)
	local thread = WorldFXKit.pole("Thread", group, threadBase, length, cfg.THREAD_WIDTH, cfg.HONEY_COLOR, Enum.Material.Glass)
	thread.Transparency = 0.15

	-- Tuelle: waagerecht vom Mast bis ueber die Schale
	local reach = cfg.SPOUT_REACH - cfg.THREAD_RADIUS
	local spoutMid = MAST_FOOT + dir * (cfg.THREAD_RADIUS + reach * 0.5) + Vector3.new(0, cfg.THREAD_BOTTOM, 0)
	WorldFXKit.part("Spout", group, Vector3.new(reach, 0.45, 0.45), facing(spoutMid, dir),
		cfg.BOWL_COLOR, Enum.Material.Wood, Enum.PartType.Cylinder)

	-- Schale auf dem Podest, darin die Honig-Oberflaeche
	local bowlCenter = MAST_FOOT + dir * cfg.SPOUT_REACH
	WorldFXKit.part("Bowl", group, Vector3.new(cfg.BOWL_HEIGHT, cfg.BOWL_RADIUS * 2, cfg.BOWL_RADIUS * 2),
		CFrame.new(bowlCenter + Vector3.new(0, cfg.BOWL_HEIGHT * 0.5, 0)) * UPRIGHT,
		cfg.BOWL_COLOR, Enum.Material.Wood, Enum.PartType.Cylinder)
	local surfaceY = bowlCenter.Y + cfg.BOWL_HEIGHT + 0.02
	local honey = WorldFXKit.part("Honey", group, Vector3.new(0.08, cfg.BOWL_RADIUS * 1.7, cfg.BOWL_RADIUS * 1.7),
		CFrame.new(bowlCenter.X, surfaceY, bowlCenter.Z) * UPRIGHT, cfg.HONEY_COLOR, Enum.Material.Glass, Enum.PartType.Cylinder)
	honey.Reflectance = 0.2

	local drop = WorldFXKit.ball("Drop", nil, cfg.DROP_SIZE, bowlCenter, cfg.HONEY_COLOR, Enum.Material.Glass)
	local ring = WorldFXKit.part("Ring", nil, Vector3.new(0.04, 0.3, 0.3), CFrame.new(), Color3.fromRGB(255, 226, 150),
		Enum.Material.Neon, Enum.PartType.Cylinder)

	_drip = {
		group = group,
		drop = drop,
		ring = ring,
		spout = MAST_FOOT + dir * cfg.SPOUT_REACH + Vector3.new(0, cfg.THREAD_BOTTOM - 0.3, 0),
		surfaceY = surfaceY,
		cycleStart = os.clock(),
	}
	WorldFXKit.cullGroup(group, MAST_FOOT, cfg.SHOW_DISTANCE)
end

-- Ein Tropfen-Zyklus: an der Tuelle wachsen, fallen, Ring in der Schale.
local function stepDrip(now: number)
	local drip = _drip
	if not drip or not drip.group.Parent then return end
	local cfg = WorldFXConfig.MAST
	local t = (now - drip.cycleStart) % cfg.DROP_INTERVAL
	local fallHeight = drip.spout.Y - drip.surfaceY
	local fallTime = math.sqrt(2 * fallHeight / workspace.Gravity)

	if t < cfg.DROP_GROW then
		local k = t / cfg.DROP_GROW
		drip.drop.Size = Vector3.one * (cfg.DROP_SIZE * (0.3 + 0.7 * k))
		drip.drop.Position = drip.spout
		drip.drop.Parent = drip.group
	elseif t < cfg.DROP_GROW + fallTime then
		local f = t - cfg.DROP_GROW
		drip.drop.Position = drip.spout - Vector3.new(0, 0.5 * workspace.Gravity * f * f, 0)
	else
		drip.drop.Parent = nil
		local k = (t - cfg.DROP_GROW - fallTime) / cfg.RING_TIME
		if k < 1 then
			local size = 0.3 + cfg.BOWL_RADIUS * 1.4 * k
			drip.ring.Size = Vector3.new(0.04, size, size)
			drip.ring.CFrame = CFrame.new(drip.spout.X, drip.surfaceY + 0.05, drip.spout.Z) * UPRIGHT
			drip.ring.Transparency = 0.3 + 0.7 * k
			drip.ring.Parent = drip.group
		else
			drip.ring.Parent = nil
		end
	end
end

--------------------------------------------------------------------------------
-- Wegweiser
--------------------------------------------------------------------------------

-- Ein Schild in Baerchi-Form, das in Richtung `dir` zeigt. Text vorn und
-- hinten, je mit dem Pfeil auf der richtigen Seite (wer auf die Vorderseite
-- schaut, hat +X links).
local function buildBoard(parent: Instance, center: Vector3, dir: Vector3, color: Color3): (TextLabel, TextLabel)
	local cfg = WorldFXConfig.SIGNPOST
	local frame = CFrame.fromMatrix(center, dir, Vector3.yAxis)
	local board = WorldFXKit.part("Board", parent, cfg.BOARD_SIZE, frame, color, Enum.Material.Wood)
	local signId = WorldFXKit.textureId("bear_sign")
	if signId then
		-- Form aus dem Bild: Teil unsichtbar, Bild vorn und hinten
		board.Transparency = 1
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local decal = Instance.new("Decal")
			decal.Texture = signId
			decal.Face = face
			decal.Color3 = color
			decal.Parent = board
		end
	else
		-- Ohren oben
		for _, side in { -1, 1 } do
			WorldFXKit.part("Ear", parent, Vector3.new(0.3, 0.75, 0.75),
				frame * CFrame.new(side * cfg.BOARD_SIZE.X * 0.3, cfg.BOARD_SIZE.Y * 0.5, 0) * CFrame.Angles(0, math.rad(90), 0),
				color, Enum.Material.Wood, Enum.PartType.Cylinder)
		end
	end

	local labels = {}
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.PixelsPerStud = 40
		gui.LightInfluence = 1
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(0.9, 0.8)
		label.Position = UDim2.fromScale(0.05, 0.1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = cfg.TEXT_COLOR
		label.Parent = gui
		table.insert(labels, label)
	end
	return labels[1], labels[2]
end

-- Pfeil links (Vorderseite) bzw. rechts (Rueckseite) an den Text haengen.
local function arrowText(front: TextLabel, back: TextLabel, text: string)
	front.Text = "◀ " .. text
	back.Text  = text .. " ▶"
end

local function bindArrow(front: TextLabel, back: TextLabel, key: string, args: { [string]: any }?)
	local function refresh()
		arrowText(front, back, Loc.t(key, args))
	end
	refresh()
	Loc.onChanged(refresh)
end

-- Beschriftung "Insel von X" / "Deine Insel" / "Freie Insel" fuer Slot `slot`.
local function islandText(slot: number): (string, boolean)
	local plot = workspace:FindFirstChild("Plot_" .. slot)
	local ownerId = if plot then plot:GetAttribute("PlotOwner") else nil
	if typeof(ownerId) ~= "number" then
		return Loc.t("world.sign.free"), false
	end
	if ownerId == localPlayer.UserId then
		return Loc.t("world.sign.home"), true
	end
	local owner = Players:GetPlayerByUserId(ownerId)
	return Loc.t("world.sign.island", { name = if owner then owner.DisplayName else "?" }), false
end

local function refreshIslandLabels()
	local cfg = WorldFXConfig.SIGNPOST
	for _, entry in _islandLabels do
		local text, home = islandText(entry.slot)
		local gui = entry.label.Parent
		local board = gui and gui.Parent
		if board and board:IsA("BasePart") then
			board.Color = if home then cfg.HOME_COLOR else cfg.WOOD
			for _, decal in board:GetChildren() do
				if decal:IsA("Decal") then decal.Color3 = board.Color end
			end
		end
		if entry.label.Name == "Front" then
			entry.label.Text = "◀ " .. text
		else
			entry.label.Text = text .. " ▶"
		end
	end
end

-- Ziel, auf das der dritte Arm zeigt: Haendler oder naechste Bestenliste.
local function sideTarget(from: Vector3): (Vector3, string)
	local m = EggConfig.MERCHANT_V2
	local best = MapLayout.atAngle(m.angleDegrees, m.radius)
	local bestDist = (best - from).Magnitude
	local key = "world.sign.merchant"
	for _, b in MapLayout.leaderboardBoards() do
		local p = MapLayout.atAngle(b.angleDegrees, MapConfig.LEADERBOARD_BOARD.radius)
		local d = (p - from).Magnitude
		if d < bestDist then
			best, bestDist, key = p, d, "world.sign.board"
		end
	end
	return best, key
end

local function flatDir(from: Vector3, to: Vector3): Vector3
	local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	return if d.Magnitude > 1e-3 then d.Unit else Vector3.new(1, 0, 0)
end

local function buildSignposts(folder: Instance)
	local cfg = WorldFXConfig.SIGNPOST
	for _, spot in MapLayout.signposts(cfg.RADIUS, cfg.SIDE) do
		local group = WorldFXKit.folder("Signpost_" .. spot.slot, folder)
		local base = spot.position
		WorldFXKit.pole("Post", group, base, cfg.POST_HEIGHT, 0.55, cfg.WOOD_DARK, Enum.Material.Wood)

		local function at(level: number): Vector3
			return base + Vector3.new(0, cfg.POST_HEIGHT - 0.9 - level * cfg.BOARD_GAP, 0)
		end

		-- 1: zur eigenen bzw. dieser Plot-Insel (nach aussen)
		local f1, b1 = buildBoard(group, at(0), spot.outward, cfg.WOOD)
		f1.Name, b1.Name = "Front", "Back"
		table.insert(_islandLabels, { label = f1, slot = spot.slot })
		table.insert(_islandLabels, { label = b1, slot = spot.slot })

		-- 2: zum Event (zur Mitte)
		local f2, b2 = buildBoard(group, at(1), -spot.outward, cfg.WOOD)
		bindArrow(f2, b2, "world.sign.event")

		-- 3: Haendler oder Bestenliste, was naeher ist
		local target, key = sideTarget(base)
		local f3, b3 = buildBoard(group, at(2), flatDir(base, target), cfg.WOOD)
		bindArrow(f3, b3, key)

		WorldFXKit.cullGroup(group, base, cfg.SHOW_DISTANCE)
	end

	refreshIslandLabels()
	Loc.onChanged(refreshIslandLabels)
	-- Plots kommen und gehen mit den Spielern
	local function onWorldChild(child: Instance)
		if string.match(child.Name, "^Plot_%d+$") then
			task.defer(refreshIslandLabels)
		end
	end
	workspace.ChildAdded:Connect(onWorldChild)
	workspace.ChildRemoved:Connect(onWorldChild)
	Players.PlayerAdded:Connect(function() task.delay(1, refreshIslandLabels) end)
end

--------------------------------------------------------------------------------
-- Haendler: Laterne und Eierkorb
--------------------------------------------------------------------------------

local function buildStallDecor(folder: Instance)
	local stand = workspace:WaitForChild("EggMerchant", 60)
	if not (stand and stand:IsA("Model")) then return end
	local counter = stand.PrimaryPart or stand:FindFirstChild("Counter")
	if not (counter and counter:IsA("BasePart")) then return end
	local cfg = WorldFXConfig.STALL

	-- Boden-CFrame des Stands (Theke steht 1,3 ueber dem Boden, siehe EggMerchantService)
	local base = counter.CFrame * CFrame.new(0, -1.3, 0)
	local group = WorldFXKit.folder("StallDecor", folder)

	-- Laterne links neben dem Stand
	local lampFoot = (base * CFrame.new(-4.2, 0, 0.6)).Position
	WorldFXKit.pole("LampPost", group, lampFoot, 4.2, 0.35, WorldFXConfig.SIGNPOST.WOOD_DARK, Enum.Material.Wood)
	local glow = WorldFXKit.ball("LampGlow", group, 1.1, lampFoot + Vector3.new(0, 4.7, 0), cfg.LANTERN_COLOR, Enum.Material.Neon)
	DayCycleController.registerGlow(glow, WorldFXConfig.LAMP_DAY, WorldFXConfig.LAMP_NIGHT)

	-- Korb rechts davor, mit drei Eiern
	local basketCF = base * CFrame.new(4.0, 0.45, -0.8)
	WorldFXKit.part("Basket", group, Vector3.new(0.9, 2.2, 2.2), basketCF * UPRIGHT, cfg.BASKET_COLOR, Enum.Material.WoodPlanks, Enum.PartType.Cylinder)
	for i, color in cfg.EGG_COLORS do
		local a = (i - 1) / #cfg.EGG_COLORS * math.pi * 2
		WorldFXKit.ellipsoid("Egg", group, Vector3.new(0.8, 1.05, 0.8),
			basketCF * CFrame.new(math.cos(a) * 0.45, 0.75, math.sin(a) * 0.45) * CFrame.Angles(math.rad(10) * math.cos(a), 0, math.rad(10) * math.sin(a)),
			color, Enum.Material.SmoothPlastic)
	end

	WorldFXKit.cullGroup(group, base.Position, cfg.SHOW_DISTANCE)
end

--------------------------------------------------------------------------------
-- Tafeln: Rahmen, Krone, Glanz auf Platz 1
--------------------------------------------------------------------------------

local function isBoard(part: Instance): boolean
	return part:IsA("BasePart") and (string.sub(part.Name, 1, 16) == "LeaderboardBoard" or part.Name == "LiveBoard")
		and part:FindFirstChild("Board") ~= nil
end

local _framed: { [Instance]: boolean } = {}

local function frameBoard(board: BasePart, folder: Instance)
	if _framed[board] then return end
	_framed[board] = true
	local cfg = WorldFXConfig.BOARD_FRAME
	local group = WorldFXKit.folder("Frame_" .. board.Name, folder)
	local cf, size = board.CFrame, board.Size
	local depth = size.Z + 0.25
	local hw, hh = size.X * 0.5, size.Y * 0.5

	-- vier Balken
	for _, sy in { -1, 1 } do
		WorldFXKit.part("Beam", group, Vector3.new(size.X + cfg.BEAM * 2, cfg.BEAM, depth),
			cf * CFrame.new(0, sy * (hh + cfg.BEAM * 0.5), 0), cfg.WOOD, Enum.Material.Wood)
	end
	for _, sx in { -1, 1 } do
		WorldFXKit.part("Beam", group, Vector3.new(cfg.BEAM, size.Y, depth),
			cf * CFrame.new(sx * (hw + cfg.BEAM * 0.5), 0, 0), cfg.WOOD, Enum.Material.Wood)
	end
	-- Honig-Ecken
	for _, sx in { -1, 1 } do
		for _, sy in { -1, 1 } do
			WorldFXKit.ball("Corner", group, cfg.CORNER_SIZE,
				(cf * CFrame.new(sx * (hw + cfg.BEAM * 0.5), sy * (hh + cfg.BEAM * 0.5), 0)).Position,
				cfg.CORNER_COLOR, Enum.Material.Glass)
		end
	end
	-- Krone oben: Reif und drei Zacken
	local top = cf * CFrame.new(0, hh + cfg.BEAM + 0.45, 0)
	WorldFXKit.part("CrownBand", group, Vector3.new(0.6, 2.4, 2.4), top * UPRIGHT, cfg.CROWN_COLOR, Enum.Material.Neon, Enum.PartType.Cylinder)
	for i = -1, 1 do
		WorldFXKit.ball("CrownTip", group, 0.6, (top * CFrame.new(i * 0.85, 0.65 - math.abs(i) * 0.15, 0)).Position,
			cfg.CROWN_COLOR, Enum.Material.Neon)
	end

	-- Glanz auf Platz 1 (nur Bestenlisten, nicht das Live-Board)
	if board.Name ~= "LiveBoard" and WorldFXKit.enabled("boardShine") then
		local gui = board:FindFirstChild("Board")
		local line = gui and gui:FindFirstChild("Line1")
		if line and line:IsA("GuiObject") then
			local shine = Instance.new("Frame")
			shine.Name = "Shine"
			shine.BackgroundColor3 = Color3.new(1, 1, 1)
			shine.BorderSizePixel = 0
			shine.Position = line.Position
			shine.Size = line.Size
			shine.ZIndex = line.ZIndex + 1
			shine.Parent = gui
			local gradient = Instance.new("UIGradient")
			gradient.Rotation = 20
			gradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.42, 1),
				NumberSequenceKeypoint.new(0.5, 0.55), NumberSequenceKeypoint.new(0.58, 1),
				NumberSequenceKeypoint.new(1, 1),
			})
			gradient.Parent = shine
			table.insert(_shines, { gradient = gradient, group = group })
		end
	end

	WorldFXKit.cullGroup(group, cf.Position, cfg.SHOW_DISTANCE)
end

local function buildBoardFrames(folder: Instance)
	local platform = workspace:WaitForChild("Platform", 60)
	if not platform then return end
	for _, child in platform:GetChildren() do
		if isBoard(child) then
			frameBoard(child :: BasePart, folder)
		end
	end
	platform.ChildAdded:Connect(function(child)
		task.defer(function()
			if isBoard(child) then frameBoard(child :: BasePart, folder) end
		end)
	end)
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

-- Paket G (Event startet): die Wabenkrone blinkt zweimal auf (2 Hz, unter
-- der 3-Hz-Grenze), danach gilt wieder der Tageslauf.
function HubLandmarkController.flashCrown()
	if #_crownCells == 0 then return end
	task.spawn(function()
		for _ = 1, 2 do
			for _, cell in _crownCells do cell.Color = Color3.fromRGB(255, 244, 200) end
			task.wait(0.25)
			DayCycleController.refreshGlow()
			task.wait(0.25)
		end
	end)
end

function HubLandmarkController.init()
	if not FeatureFlags.isOn("WORLD_C_HUB") then return end
	local folder = WorldFXKit.folder("Hub", WorldFXKit.root())

	if WorldFXKit.enabled("mastCrown") then
		buildCrown(folder)
	end
	if WorldFXKit.enabled("honeyThread") then
		buildHoneyThread(folder)
	end
	if WorldFXKit.enabled("signposts") then
		buildSignposts(folder)
	end
	if WorldFXKit.enabled("stallDecor") then
		task.spawn(buildStallDecor, folder)
	end
	if WorldFXKit.enabled("boardFrames") then
		task.spawn(buildBoardFrames, folder)
	end

	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < TICK then return end
		acc = 0
		local now = os.clock()
		stepDrip(now)
		-- Glanzstreifen wandert ueber Platz 1 (nur sichtbare Tafeln)
		local offset = ((now / WorldFXConfig.BOARD_FRAME.SHINE_PERIOD) % 1) * 2 - 1
		for _, shine in _shines do
			if shine.group.Parent then
				shine.gradient.Offset = Vector2.new(offset, 0)
			end
		end
	end)

	print("[Hub] Wahrzeichen aktiv")
end

return HubLandmarkController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX83"><Properties>
<string name="Name">LifeController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- LifeController.luau
-- StarterPlayerScripts/Controllers/LifeController.luau
--
-- Einzige Zustaendigkeit:
--   - Kleine Bewegung ueberall (Paket F, "Welt aufwerten"): Bienenschwaerme
--     zwischen Blumen und Teichen, Schmetterlinge auf der Hauptinsel, Blumen
--     nicken im Wind und weichen dem eigenen Charakter aus, Pfotenabdruecke
--     im Sand
--
-- Die Pollenfarbe folgt dem Tageslauf; das macht DayCycleController (dort
-- haengt jede Farbe, die am Tageslauf haengt).
--
-- PERFORMANCE:
--   * EIN Takt (15x pro Sekunde). Bienen, Schmetterlinge und Blumen bewegt je
--     EIN workspace:BulkMoveTo, nur was in Sichtweite ist.
--   * Bienen: hoechstens BEES.MAX_SWARMS Schwaerme in Sicht (plus
--     HOME_EXTRA auf der eigenen Insel), aus einem festen Pool.
--   * Die Blumen der Hauptinsel sind Server-Teile; sie werden nur lokal
--     gedreht (der Server setzt sie nie wieder), nichts wird repliziert.
--   * Pfotenabdruecke: Pool von FOOTPRINTS.MAX, kein Neubau.
--   * Niedrige Qualitaet: alles aus Paket F aus (WorldFXConfig.MIN_QUALITY).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local PlotLifeController = require(script.Parent.PlotLifeController)

local LifeController = {}

local localPlayer = Players.LocalPlayer
local TICK = 1 / 15
local TAU = math.pi * 2

--------------------------------------------------------------------------------
-- Orte, an denen Leben ist
--------------------------------------------------------------------------------

type Site = { position: Vector3, home: boolean }

-- Feste Orte auf der Hauptinsel (in den Wiesenstuecken zwischen den Wegen)
local function hubSites(): { Site }
	local list: { Site } = {}
	for k = 0, MapConfig.PLOT_COUNT - 1 do
		for _, r in { 70, 96 } do
			local angle = 22.5 + k * 45 + (if r == 70 then 8 else -8)
			table.insert(list, { position = MapLayout.atAngle(angle, r), home = false })
		end
	end
	return list
end

-- Orte auf den besetzten Plot-Inseln: der Teich und zwei Randpunkte
local function plotSites(): { Site }
	local list: { Site } = {}
	local home = PlotLifeController.homeSlot()
	for slot = 1, MapConfig.PLOT_COUNT do
		if workspace:FindFirstChild("Plot_" .. slot) then
			local center = MapLayout.plotCenter(slot)
			local plotCF = CFrame.lookAt(center, Vector3.new(MapConfig.CENTER.X, center.Y, MapConfig.CENTER.Z))
			local isHome = slot == home
			table.insert(list, { position = (plotCF * CFrame.new(MapLayout.pondOffset())).Position, home = isHome })
			for _, angle in { 75, 285 } do
				local p = MapLayout.islandRimPoint(slot, angle, WorldFXConfig.ISLAND_STAGE.RIM_RADIUS)
				table.insert(list, { position = p, home = isHome })
			end
		end
	end
	return list
end

--------------------------------------------------------------------------------
-- Bienen
--------------------------------------------------------------------------------

type Swarm = { parts: { BasePart }, count: number, site: Site?, phase: number, center: Vector3? }
local SWARM_SPEED = 14   -- Studs/s: so schnell zieht ein Schwarm zu seinem neuen Ort
local _rally: { position: Vector3, untilTime: number }? = nil
local _swarms: { Swarm } = {}
local _hubSites: { Site } = {}
local _swarmFolder: Folder? = nil

local function buildBees(folder: Folder)
	local cfg = WorldFXConfig.BEES
	_swarmFolder = folder
	local random = Random.new(20261009)
	for i = 1, cfg.MAX_SWARMS + cfg.HOME_EXTRA do
		local count = random:NextInteger(cfg.PER_SWARM[1], cfg.PER_SWARM[2])
		local parts: { BasePart } = {}
		for _ = 1, count do
			table.insert(parts, WorldFXKit.ellipsoid("Bee", nil, Vector3.new(0.32, 0.32, 0.5), CFrame.new(), cfg.COLOR))
			table.insert(parts, WorldFXKit.part("Wings", nil, Vector3.new(0.6, 0.04, 0.2), CFrame.new(), Color3.new(1, 1, 1)))
			parts[#parts].Transparency = 0.5
		end
		table.insert(_swarms, { parts = parts, count = count, site = nil, phase = i * 1.9 })
	end
	_hubSites = hubSites()
end

-- Alle 2 s: die naechsten Orte an die Schwaerme verteilen (eigene Insel zuerst).
local function assignSwarms()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local cfg = WorldFXConfig.BEES
	local eye = camera.CFrame.Position
	local candidates: { { site: Site, d: number } } = {}
	-- Paket G: Event startet — alle Schwaerme in Sicht ziehen zum Event-Pit
	local rally = _rally
	if rally and os.clock() < rally.untilTime then
		local site: Site = { position = rally.position, home = false }
		for _, swarm in _swarms do
			if swarm.site then swarm.site = site end
		end
		return
	end
	_rally = nil
	local all = plotSites()
	for _, s in _hubSites do table.insert(all, s) end
	for _, site in all do
		local d = (site.position - eye).Magnitude
		if d <= cfg.VIEW_DISTANCE then
			table.insert(candidates, { site = site, d = if site.home then d - 1000 else d })
		end
	end
	table.sort(candidates, function(a, b) return a.d < b.d end)

	local homeLeft = cfg.HOME_EXTRA
	local used = 0
	for i, swarm in _swarms do
		local entry = candidates[i]
		local allowed = entry ~= nil and (used < cfg.MAX_SWARMS or (entry.site.home and homeLeft > 0))
		if allowed and entry then
			if entry.site.home and used >= cfg.MAX_SWARMS then homeLeft -= 1 else used += 1 end
			if not swarm.site then swarm.center = entry.site.position end   -- neu: dort erscheinen
			swarm.site = entry.site
			for _, part in swarm.parts do part.Parent = _swarmFolder end
		else
			swarm.site = nil
			swarm.center = nil
			for _, part in swarm.parts do part.Parent = nil end
		end
	end
end

local function stepBees(clock: number, dt: number, parts: { BasePart }, cframes: { CFrame })
	local cfg = WorldFXConfig.BEES
	for _, swarm in _swarms do
		local site = swarm.site
		if site then
			-- weich zum (neuen) Ort fliegen statt zu springen
			local center = swarm.center or site.position
			local delta = site.position - center
			local step = SWARM_SPEED * dt
			center = if delta.Magnitude <= step then site.position else center + delta.Unit * step
			swarm.center = center
			for j = 1, swarm.count do
				-- Acht ueber dem Ort, jede Biene etwas schneller und versetzt
				local a = clock * cfg.SPEED * TAU * (1 + 0.17 * j) + swarm.phase + j * 1.3
				local r = cfg.SITE_RADIUS * (0.6 + 0.12 * j)
				local pos = center + Vector3.new(math.cos(a) * r, 1.8 + 0.6 * math.sin(a * 3), math.sin(a * 2) * r * 0.5)
				local ahead = Vector3.new(-math.sin(a), 0, math.cos(a * 2))
				local body = CFrame.lookAt(pos, pos + (if ahead.Magnitude > 1e-3 then ahead else Vector3.new(0, 0, 1)))
				table.insert(parts, swarm.parts[j * 2 - 1])
				table.insert(cframes, body)
				table.insert(parts, swarm.parts[j * 2])
				table.insert(cframes, body * CFrame.new(0, 0.18, 0) * CFrame.Angles(0, 0, math.rad(25) * math.sin(clock * 40 + j)))
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Schmetterlinge (Hauptinsel)
--------------------------------------------------------------------------------

type Butterfly = { wings: { BasePart }, home: Vector3, phase: number }
local _butterflies: { Butterfly } = {}

local function buildButterflies(folder: Folder)
	local cfg = WorldFXConfig.BUTTERFLIES
	for i = 1, cfg.COUNT do
		local angle = 22.5 + (i - 1) * (360 / cfg.COUNT) + 12
		local home = MapLayout.atAngle(angle, 84)
		local color = cfg.COLORS[(i - 1) % #cfg.COLORS + 1]
		local wings: { BasePart } = {}
		for _ = 1, 2 do
			table.insert(wings, WorldFXKit.part("Wing", folder, Vector3.new(0.75, 0.05, 0.55), CFrame.new(home), color))
		end
		table.insert(_butterflies, { wings = wings, home = home, phase = i * 2.1 })
	end
end

local function stepButterflies(clock: number, eye: Vector3, parts: { BasePart }, cframes: { CFrame })
	local cfg = WorldFXConfig.BUTTERFLIES
	for _, b in _butterflies do
		if (b.home - eye).Magnitude <= cfg.VIEW_DISTANCE then
			local t = clock * 0.22 + b.phase
			local pos = b.home + Vector3.new(math.cos(t) * cfg.WANDER, cfg.HEIGHT + math.sin(t * 2.7) * 0.9, math.sin(t * 1.3) * cfg.WANDER)
			local ahead = Vector3.new(-math.sin(t), 0, math.cos(t * 1.3) * 1.3)
			local body = CFrame.lookAt(pos, pos + (if ahead.Magnitude > 1e-3 then ahead else Vector3.new(0, 0, 1)))
			local flap = math.rad(55) * math.sin(clock * cfg.FLAP_RATE * TAU + b.phase)
			table.insert(parts, b.wings[1])
			table.insert(cframes, body * CFrame.Angles(0, 0, flap) * CFrame.new(-0.38, 0, 0))
			table.insert(parts, b.wings[2])
			table.insert(cframes, body * CFrame.Angles(0, 0, -flap) * CFrame.new(0.38, 0, 0))
		end
	end
end

--------------------------------------------------------------------------------
-- Blumen im Wind (Server-Blumen der Hauptinsel, nur lokal gedreht)
--------------------------------------------------------------------------------

type Flower = { stem: BasePart, head: BasePart?, foot: Vector3, stemOffset: CFrame, headOffset: CFrame?, dodge: Vector3 }
local _flowers: { Flower } = {}
local WIND = Vector3.new(1, 0, 0.35).Unit

local function collectFlowers()
	local platform = workspace:WaitForChild("Platform", 60)
	if not platform then return end
	local heads: { [string]: BasePart } = {}
	local stems: { BasePart } = {}
	local function key(p: Vector3): string
		return string.format("%d:%d", math.floor(p.X * 10 + 0.5), math.floor(p.Z * 10 + 0.5))
	end
	for _, child in platform:GetChildren() do
		if child:IsA("BasePart") then
			if child.Name == "FlowerStem" then
				table.insert(stems, child)
			elseif child.Name == "FlowerHead" then
				heads[key(child.Position)] = child
			end
		end
	end
	for _, stem in stems do
		local foot = stem.Position - Vector3.new(0, stem.Size.Y * 0.5, 0)
		local pivot = CFrame.new(foot)
		local head = heads[key(stem.Position)]
		table.insert(_flowers, {
			stem = stem,
			head = head,
			foot = foot,
			stemOffset = pivot:ToObjectSpace(stem.CFrame),
			headOffset = if head then pivot:ToObjectSpace(head.CFrame) else nil,
			dodge = Vector3.zero,
		})
	end
end

local function stepFlowers(clock: number, eye: Vector3, root: BasePart?, parts: { BasePart }, cframes: { CFrame })
	local cfg = WorldFXConfig.FLOWER_SWAY
	local axis = Vector3.new(-WIND.Z, 0, WIND.X)   -- Kippachse quer zum Wind
	local body = if root then root.Position else nil
	for _, f in _flowers do
		if (f.foot - eye).Magnitude <= cfg.VIEW_DISTANCE then
			-- gemeinsame Welle, die ueber die Insel laeuft
			local along = f.foot.X * WIND.X + f.foot.Z * WIND.Z
			local angle = math.rad(cfg.DEGREES) * math.sin(TAU * (clock * cfg.RATE - along / cfg.WAVELENGTH))
			local tilt = CFrame.fromAxisAngle(axis, angle)

			-- Ausweichen: vom Charakter weg kippen, danach langsam zurueck
			local target = Vector3.zero
			if body then
				local away = Vector3.new(f.foot.X - body.X, 0, f.foot.Z - body.Z)
				local d = away.Magnitude
				if d < cfg.DODGE_RADIUS and d > 1e-3 and math.abs(body.Y - f.foot.Y) < 6 then
					target = away.Unit * (1 - d / cfg.DODGE_RADIUS)
				end
			end
			f.dodge = f.dodge:Lerp(target, 0.25)
			if f.dodge.Magnitude > 0.01 then
				local dodgeAxis = Vector3.new(f.dodge.Z, 0, -f.dodge.X)
				tilt = CFrame.fromAxisAngle(dodgeAxis.Unit, -math.rad(cfg.DODGE_DEGREES) * f.dodge.Magnitude) * tilt
			end

			local pivot = CFrame.new(f.foot) * tilt
			table.insert(parts, f.stem)
			table.insert(cframes, pivot * f.stemOffset)
			local head, offset = f.head, f.headOffset
			if head and offset then
				table.insert(parts, head)
				table.insert(cframes, pivot * offset)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Pfotenabdruecke
--------------------------------------------------------------------------------

type Print = { part: BasePart, decal: Decal?, born: number }
local _prints: { Print } = {}
local _nextPrint = 1
local _lastPrintAt: Vector3? = nil
local _printSide = 1

local function buildPrints()
	local cfg = WorldFXConfig.FOOTPRINTS
	local pawId = WorldFXKit.textureId("paw_print")
	for _ = 1, cfg.MAX do
		local part = WorldFXKit.part("Paw", nil, Vector3.new(cfg.SIZE, 0.05, cfg.SIZE * 1.15), CFrame.new(), cfg.COLOR)
		local decal: Decal? = nil
		if pawId then
			part.Transparency = 1
			local d = Instance.new("Decal")
			d.Texture = pawId
			d.Face = Enum.NormalId.Top
			d.Color3 = cfg.COLOR
			d.Parent = part
			decal = d
		else
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		end
		table.insert(_prints, { part = part, decal = decal, born = -math.huge })
	end
end

local function stepPrints(folder: Folder, character: Model?)
	local cfg = WorldFXConfig.FOOTPRINTS
	local now = os.clock()
	-- verblassen
	for _, p in _prints do
		if p.part.Parent then
			local k = (now - p.born) / cfg.FADE
			if k >= 1 then
				p.part.Parent = nil
			elseif p.decal then
				(p.decal :: Decal).Transparency = k
			else
				p.part.Transparency = 0.25 + 0.75 * k
			end
		end
	end

	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and root:IsA("BasePart")) then return end
	if humanoid.FloorMaterial ~= Enum.Material.Sand then
		_lastPrintAt = nil
		return
	end
	local feetY = root.Position.Y - root.Size.Y * 0.5 - humanoid.HipHeight
	local here = Vector3.new(root.Position.X, feetY, root.Position.Z)
	local last = _lastPrintAt
	if last and (here - last).Magnitude < cfg.STEP then return end
	_lastPrintAt = here

	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
	local sideways = Vector3.new(-flat.Z, 0, flat.X) * (0.45 * _printSide)
	_printSide = -_printSide
	local p = _prints[_nextPrint]
	_nextPrint = _nextPrint % #_prints + 1
	local at = here + sideways + Vector3.new(0, 0.03, 0)
	p.part.CFrame = CFrame.lookAt(at, at + flat)
	p.born = now
	if p.decal then (p.decal :: Decal).Transparency = 0 else p.part.Transparency = 0.25 end
	p.part.Parent = folder
end

-- Paket G (Event startet): Bienen in Sicht fliegen `seconds` lang zu `position`.
function LifeController.rally(position: Vector3, seconds: number)
	_rally = { position = position + Vector3.new(0, 4, 0), untilTime = os.clock() + seconds }
	assignSwarms()
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function LifeController.init()
	if not FeatureFlags.isOn("WORLD_F_LIFE") then return end
	local folder = WorldFXKit.folder("Life", WorldFXKit.root())

	local bees = WorldFXKit.enabled("bees")
	local butterflies = WorldFXKit.enabled("butterflies")
	local sway = WorldFXKit.enabled("flowerSway")
	local prints = WorldFXKit.enabled("footprints")
	if bees then buildBees(WorldFXKit.folder("Bees", folder)) end
	if butterflies then buildButterflies(WorldFXKit.folder("Butterflies", folder)) end
	if sway then task.spawn(collectFlowers) end
	local printFolder = WorldFXKit.folder("Footprints", folder)
	if prints then buildPrints() end

	if not (bees or butterflies or sway or prints) then
		print("[Life] aus (niedrige Qualitaet)")
		return
	end

	local acc, assignAcc, clock = 0, 2, 0
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		acc += dt
		assignAcc += dt
		if acc < TICK then return end
		acc = 0
		local camera = workspace.CurrentCamera
		if not camera then return end
		local eye = camera.CFrame.Position

		if bees and assignAcc >= 2 then
			assignAcc = 0
			assignSwarms()
		end

		local parts: { BasePart } = {}
		local cframes: { CFrame } = {}
		if bees then stepBees(clock, TICK, parts, cframes) end
		if butterflies then stepButterflies(clock, eye, parts, cframes) end
		local character = localPlayer.Character
		if sway then
			local root = character and character:FindFirstChild("HumanoidRootPart")
			stepFlowers(clock, eye, if root and root:IsA("BasePart") then root else nil, parts, cframes)
		end
		if #parts > 0 then
			workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end
		if prints then stepPrints(printFolder, character) end
	end)

	print("[Life] aktiv | Bienen:", bees, "| Schmetterlinge:", butterflies, "| Blumen:", sway, "| Pfoten:", prints)
end

return LifeController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX84"><Properties>
<string name="Name">PlotLifeController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PlotLifeController.luau
-- StarterPlayerScripts/Controllers/PlotLifeController.luau
--
-- Einzige Zustaendigkeit:
--   - Plot-Inseln mit Persoenlichkeit (Paket D, "Welt aufwerten"):
--     Deko am Inselrand je Fortschritts-Stufe (Blumen, Pilze, Bienenhaus,
--     Bernstein-Stein), Glanz und Ueberlauf am Honig-Teich, warmer Schimmer
--     ueber der EIGENEN Insel, und leere Inseln mit Schild "Frei", Blumen und
--     Schmetterling
--
-- Die Stufe rechnet der Server (Modules/IslandStage) und schreibt sie als
-- Attribut "IslandStage" an den Player (PlotDisplayService). Gebaut wird
-- hier, nur auf dem Client: kein Server-Teil, das Teile-Budget der Insel
-- (250) bleibt unberuehrt. Neubau nur bei einem Stufenwechsel.
--
-- PERFORMANCE: EIN Takt (15x pro Sekunde) fuer Teich-Glanz, Ueberlauf und
-- Schmetterlinge, nur fuer Gruppen in Sichtweite (WorldFXKit.cullGroup).
-- Die Stufen-Deko steht still. Ein Emitter (Lichtpunkte ueber der eigenen
-- Insel). Feste Pools fuer Tropfen und Schmetterlinge.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)
local Loc           = require(ReplicatedStorage.Localization.Loc)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)
local Icons              = require(script.Parent.Parent.UI.Icons)

local PlotLifeController = {}

local localPlayer = Players.LocalPlayer
local UPRIGHT = WorldFXKit.UPRIGHT
local TICK = 1 / 15
local TAU = math.pi * 2

type Drop = { part: BasePart, phase: number }
type PlotState = {
	slot: number,
	decor: Folder?,
	uncull: (() -> ())?,
	stage: number,
	pondGroup: Folder,
	shine: BasePart,
	drops: { Drop },
	ownerConn: RBXScriptConnection?,
}
type FreeState = { group: Folder, wings: { BasePart }, phase: number, uncull: (() -> ())? }

local _folder: Folder? = nil
local _plots: { [number]: PlotState } = {}
local _free: { [number]: FreeState } = {}
local _homeSlot: number? = nil
local _homeGroup: Folder? = nil

--------------------------------------------------------------------------------
-- Deklarative Deko (WorldFXConfig.ISLAND_KINDS, wie MapParts.buildDecor)
--------------------------------------------------------------------------------

-- Blumengruppen je Slot (Model + Ausgangslage) fuer den Windstoss (Paket G)
type Sway = { model: Model, base: CFrame, rel: CFrame? }
local _sways: { [number]: { Sway } } = {}
local _gust: { [number]: number } = {}   -- Slot → Startzeit des Windstosses
local GUST_TIME = 1.6
local GUST_DEGREES = 26

local function buildKind(parent: Instance, kind: string, ground: CFrame, slot: number?)
	local pieces = (WorldFXConfig.ISLAND_KINDS :: any)[kind]
	if not pieces then return end
	if kind == "Flowers" and slot then
		-- Blumen als eigenes Model, damit sie sich als Gruppe wiegen koennen
		local model = Instance.new("Model")
		model.Name = "FlowerGroup"
		model.Parent = parent
		parent = model
		local list = _sways[slot] or {}
		_sways[slot] = list
		table.insert(list, { model = model, base = ground, rel = nil })
	end
	for _, piece in pieces do
		local cf = ground * CFrame.new(piece.offset)
		local rot = piece.rotation
		if rot then
			cf = cf * CFrame.Angles(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
		end
		local glow = piece.name == WorldFXConfig.ISLAND_GLOW_PIECE
		local part = WorldFXKit.part(piece.name, parent, piece.size, cf, piece.color,
			if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic, piece.shape)
		if piece.name == "Box" or piece.name == "Roof" or piece.name == "Stand" then
			part.Material = Enum.Material.Wood
		elseif piece.name == "Rock" then
			part.Material = Enum.Material.Slate
		end
		if glow then
			DayCycleController.registerGlow(part, piece.color, Color3.fromRGB(255, 214, 110))
		end
	end
end

-- Boden-CFrame an einem Randpunkt: -Z zeigt zur Inselmitte.
local function rimGround(slot: number, angle: number, radius: number): CFrame
	local p, toCenter = MapLayout.islandRimPoint(slot, angle, radius)
	local ground = Vector3.new(p.X, MapConfig.PLATFORM_TOP_Y, p.Z)
	return CFrame.lookAt(ground, ground + toCenter)
end

--------------------------------------------------------------------------------
-- Stufen-Deko einer besetzten Insel
--------------------------------------------------------------------------------

local function ownerOf(slot: number): Player?
	local plot = workspace:FindFirstChild("Plot_" .. slot)
	local id = plot and plot:GetAttribute("PlotOwner")
	return if typeof(id) == "number" then Players:GetPlayerByUserId(id) else nil
end

local function stageOf(slot: number): number
	local owner = ownerOf(slot)
	local stage = owner and owner:GetAttribute("IslandStage")
	return if typeof(stage) == "number" then stage else 1
end

local function rebuildDecor(state: PlotState)
	if not WorldFXKit.enabled("islandDecor") then return end
	local stage = stageOf(state.slot)
	if stage == state.stage and state.decor then return end
	state.stage = stage

	local old = state.decor
	local uncull = state.uncull
	if uncull then uncull() end
	if old then old:Destroy() end
	_sways[state.slot] = nil
	local folder = _folder :: Folder
	local group = WorldFXKit.folder("IslandDecor_" .. state.slot, folder)
	for _, item in WorldFXConfig.ISLAND_STAGE_ITEMS do
		if item.stage <= stage then
			buildKind(group, item.kind, rimGround(state.slot, item.angle, WorldFXConfig.ISLAND_STAGE.RIM_RADIUS), state.slot)
		end
	end
	state.decor = group
	state.uncull = WorldFXKit.cullGroup(group, MapLayout.plotCenter(state.slot), WorldFXConfig.ISLAND_STAGE.SHOW_DISTANCE)
end

--------------------------------------------------------------------------------
-- Honig-Teich: Glanz und Ueberlauf
--------------------------------------------------------------------------------

local function findFill(slot: number): BasePart?
	local plot = workspace:FindFirstChild("Plot_" .. slot)
	local pond = plot and plot:FindFirstChild("Pond")
	local fill = pond and pond:FindFirstChild("Fuellung")
	return if fill and fill:IsA("BasePart") then fill else nil
end

-- Fuellstand 0..1 aus der Hoehe der Fuellung (PondBuilder.writePondFill).
local function fillRatio(fill: BasePart): number
	if fill.Transparency >= 1 then return 0 end
	local span = MapConfig.POND_FILL_MAX_HEIGHT - MapConfig.POND_FILL_MIN_HEIGHT
	return math.clamp((fill.Size.X - MapConfig.POND_FILL_MIN_HEIGHT) / span, 0, 1)
end

local function buildPondLife(slot: number): (Folder, BasePart, { Drop })
	local cfg = WorldFXConfig.POND_LIFE
	local group = WorldFXKit.folder("PondLife_" .. slot, _folder :: Folder)
	local shine = WorldFXKit.part("Shine", nil, cfg.SHINE_SIZE, CFrame.new(), Color3.new(1, 1, 1),
		Enum.Material.Neon, Enum.PartType.Cylinder)
	shine.Transparency = 0.55
	local drops: { Drop } = {}
	for i = 1, cfg.OVERFLOW_DROPS do
		local part = WorldFXKit.ball("Drop", nil, cfg.DROP_SIZE, Vector3.zero, MapConfig.POND_FILL_COLOR, Enum.Material.Glass)
		table.insert(drops, { part = part, phase = (i - 1) / cfg.OVERFLOW_DROPS })
	end
	-- Sichtweite um den Teich (gerechnet wie MapLayout.pondOffset, plot-lokal)
	local center = MapLayout.plotCenter(slot)
	local plotCF = CFrame.lookAt(center, Vector3.new(MapConfig.CENTER.X, center.Y, MapConfig.CENTER.Z))
	WorldFXKit.cullGroup(group, (plotCF * CFrame.new(MapLayout.pondOffset())).Position, cfg.SHOW_DISTANCE)
	return group, shine, drops
end

local function stepPond(state: PlotState, clock: number)
	if not state.pondGroup.Parent then return end
	local cfg = WorldFXConfig.POND_LIFE
	local fill = findFill(state.slot)
	local ratio = if fill then fillRatio(fill) else 0

	if not fill or ratio <= 0 then
		state.shine.Parent = nil
		for _, drop in state.drops do drop.part.Parent = nil end
		return
	end

	local center = fill.Position
	local topY = center.Y + fill.Size.X * 0.5
	local radius = fill.Size.Y * 0.5

	-- Glanzfleck kreist langsam auf der Oberflaeche
	if WorldFXKit.enabled("pondShine") then
		local a = clock / cfg.SHINE_PERIOD * TAU
		local p = Vector3.new(center.X + math.cos(a) * radius * 0.45, topY + 0.03, center.Z + math.sin(a) * radius * 0.45)
		state.shine.CFrame = CFrame.lookAt(p, p + Vector3.new(-math.sin(a), 0, math.cos(a))) * UPRIGHT
		state.shine.Parent = state.pondGroup
	end

	-- Voll: Tropfen laufen ueber den Rand und fallen aufs Beet
	local full = ratio >= cfg.FULL_RATIO
	local rimRadius = MapConfig.POND_RADIUS + MapConfig.POND_RIM_WIDTH * 0.6
	local groundY = topY - MapConfig.POND_FILL_MAX_HEIGHT - MapConfig.POND_FLOOR_TOP + MapConfig.POND_RIM_TOP
	for i, drop in state.drops do
		if not full then
			drop.part.Parent = nil
		else
			local t = ((clock / cfg.DROP_INTERVAL) + drop.phase) % 1
			local a = (i / #state.drops) * TAU + 0.6
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			local p: Vector3
			if t < 0.6 then
				-- ueber den Rand gleiten
				local k = t / 0.6
				p = Vector3.new(center.X, topY, center.Z) + dir * (radius + (rimRadius - radius) * k)
			else
				-- hinunter fallen
				local k = (t - 0.6) / 0.4
				p = Vector3.new(center.X, topY - (topY - groundY) * k * k, center.Z) + dir * rimRadius
			end
			drop.part.Position = p
			drop.part.Parent = state.pondGroup
		end
	end
end

--------------------------------------------------------------------------------
-- Eigene Insel
--------------------------------------------------------------------------------

local function buildHome(slot: number)
	local old = _homeGroup
	if old then old:Destroy() end
	_homeGroup = nil
	_homeSlot = slot
	if not WorldFXKit.enabled("homeGlow") then return end
	local cfg = WorldFXConfig.HOME_GLOW
	local group = WorldFXKit.folder("HomeGlow", _folder :: Folder)
	local center = MapLayout.plotCenter(slot)

	-- Warmer Ring auf dem Sandsaum: die Inselplatte deckt die Mitte ab, sichtbar
	-- ist nur der Streifen zwischen Wiese und Wasser — von weitem erkennbar.
	local radius = MapConfig.PLOT_ISLAND_RADIUS + MapConfig.SHORE_WIDTH * 0.75
	local y = MapConfig.PLATFORM_TOP_Y - MapConfig.SHORE_DROP + 0.04
	local ring = WorldFXKit.part("HomeRing", group, Vector3.new(0.05, radius * 2, radius * 2),
		CFrame.new(center.X, y, center.Z) * UPRIGHT, cfg.COLOR, Enum.Material.Neon, Enum.PartType.Cylinder)
	ring.Transparency = cfg.RING_TRANSPARENCY

	-- Warme Lichtpunkte ueber der Insel (ein Emitter)
	local anchor = WorldFXKit.anchor("HomeMotes", group,
		Vector3.new(MapConfig.PLOT_ISLAND_RADIUS * 1.6, 4, MapConfig.PLOT_ISLAND_RADIUS * 1.6),
		center + Vector3.new(0, cfg.MOTE_HEIGHT, 0))
	local emitter = Instance.new("ParticleEmitter")
	if WorldFXKit.applyParticleTexture(emitter, "firefly") then
		emitter.Color = ColorSequence.new(cfg.COLOR)
		emitter.LightEmission = 0.8
		emitter.Rate = cfg.MOTE_RATE
		emitter.Lifetime = NumberRange.new(5, 8)
		emitter.Speed = NumberRange.new(0.2, 0.8)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.5), NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.3), NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Parent = anchor
	else
		emitter:Destroy()
	end
	_homeGroup = group
end

-- Paket G (Rebirth): die Blumen der Insel wiegen sich einmal stark.
function PlotLifeController.gust(slot: number)
	_gust[slot] = os.clock()
end

local function stepGusts(now: number)
	for slot, start in _gust do
		local t = (now - start) / GUST_TIME
		local list = _sways[slot]
		if list then
			local angle = if t >= 1 then 0 else math.rad(GUST_DEGREES) * math.sin(t * math.pi * 3) * (1 - t)
			for _, sway in list do
				-- Lage relativ zum Fuss einmal merken (vor dem ersten Kippen)
				local rel = sway.rel
				if not rel then
					rel = sway.base:ToObjectSpace(sway.model:GetPivot())
					sway.rel = rel
				end
				-- um den Fuss kippen, seitlich (Achse = Richtung zur Inselmitte)
				sway.model:PivotTo(sway.base * CFrame.fromAxisAngle(Vector3.new(0, 0, 1), angle) * (rel :: CFrame))
			end
		end
		if t >= 1 then _gust[slot] = nil end
	end
end

-- Fuer andere Controller (Paket F: mehr Bienen auf der eigenen Insel).
function PlotLifeController.homeSlot(): number?
	return _homeSlot
end

--------------------------------------------------------------------------------
-- Leere Insel
--------------------------------------------------------------------------------

local function buildFree(slot: number): FreeState
	local cfg = WorldFXConfig.FREE_ISLAND
	local group = WorldFXKit.folder("FreeIsland_" .. slot, _folder :: Folder)
	local center = MapLayout.plotCenter(slot)
	local facing = CFrame.lookAt(center, Vector3.new(MapConfig.CENTER.X, center.Y, MapConfig.CENTER.Z))

	-- Schild "Frei" mit Baerchi-Silhouette, zur Hauptinsel gedreht
	local wood = WorldFXConfig.SIGNPOST.WOOD
	for _, side in { -1, 1 } do
		WorldFXKit.pole("SignPost", group, (facing * CFrame.new(side * 2.4, 0, 0.3)).Position, cfg.SIGN_HEIGHT + 1, 0.4,
			WorldFXConfig.SIGNPOST.WOOD_DARK, Enum.Material.Wood)
	end
	local board = WorldFXKit.part("SignBoard", group, Vector3.new(6, 3, 0.3),
		facing * CFrame.new(0, cfg.SIGN_HEIGHT, 0), wood, Enum.Material.Wood)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.PixelsPerStud = 40
	gui.Parent = board
	local icon = Icons.make(gui, "bear", "🐻")
	icon.Size = UDim2.fromScale(0.3, 0.8)
	icon.Position = UDim2.fromScale(0.04, 0.1)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.62, 0.8)
	label.Position = UDim2.fromScale(0.36, 0.1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = WorldFXConfig.SIGNPOST.TEXT_COLOR
	label.Parent = gui
	Loc.bind(label, "world.sign.free")

	-- Ein paar Blumen am Rand
	for _, angle in cfg.FLOWER_ANGLES do
		buildKind(group, "Flowers", rimGround(slot, angle, WorldFXConfig.ISLAND_STAGE.RIM_RADIUS - 8))
	end

	-- Ein Schmetterling: zwei Fluegel, Schlag im gemeinsamen Takt
	local wings: { BasePart } = {}
	local color = WorldFXConfig.BUTTERFLIES.COLORS[(slot % #WorldFXConfig.BUTTERFLIES.COLORS) + 1]
	for _ = 1, 2 do
		table.insert(wings, WorldFXKit.part("Wing", group, Vector3.new(0.7, 0.05, 0.5), CFrame.new(center), color))
	end

	return { group = group, wings = wings, phase = slot * 1.3,
		uncull = WorldFXKit.cullGroup(group, center, cfg.SHOW_DISTANCE) }
end

local function stepFree(state: FreeState, slot: number, clock: number)
	if not state.group.Parent then return end
	local cfg = WorldFXConfig.BUTTERFLIES
	local center = MapLayout.plotCenter(slot)
	local t = clock * 0.25 + state.phase
	local pos = center + Vector3.new(math.cos(t) * cfg.WANDER, cfg.HEIGHT + math.sin(t * 2.3) * 0.8, math.sin(t * 1.4) * cfg.WANDER)
	local ahead = Vector3.new(-math.sin(t), 0, math.cos(t) * 1.4)
	local body = CFrame.lookAt(pos, pos + (if ahead.Magnitude > 1e-3 then ahead else Vector3.new(0, 0, 1)))
	local flap = math.rad(55) * math.sin(clock * cfg.FLAP_RATE * TAU)
	state.wings[1].CFrame = body * CFrame.Angles(0, 0, flap) * CFrame.new(-0.35, 0, 0)
	state.wings[2].CFrame = body * CFrame.Angles(0, 0, -flap) * CFrame.new(0.35, 0, 0)
end

--------------------------------------------------------------------------------
-- Besetzung
--------------------------------------------------------------------------------

local function setOccupied(slot: number, occupied: boolean)
	local free = _free[slot]
	if occupied then
		if free then
			-- aus der Distanz-Abschaltung nehmen, sonst haengt sie ihn wieder ein
			local uncull = free.uncull
			if uncull then uncull() end
			free.uncull = nil
			free.group.Parent = nil
		end
		local state = _plots[slot]
		if not state then
			local group, shine, drops = buildPondLife(slot)
			state = { slot = slot, decor = nil, uncull = nil, stage = 0, pondGroup = group, shine = shine, drops = drops, ownerConn = nil }
			_plots[slot] = state
		end
		local st = state :: PlotState
		-- Stufe des Besitzers beobachten
		local conn = st.ownerConn
		if conn then conn:Disconnect() end
		st.ownerConn = nil
		task.spawn(function()
			local owner: Player? = nil
			for _ = 1, 20 do
				owner = ownerOf(slot)
				if owner then break end
				task.wait(0.5)
			end
			if owner then
				st.ownerConn = owner:GetAttributeChangedSignal("IslandStage"):Connect(function()
					rebuildDecor(st)
				end)
				if owner == localPlayer then
					buildHome(slot)
				end
			end
			st.stage = 0
			rebuildDecor(st)
		end)
	else
		local state = _plots[slot]
		if state then
			local conn = state.ownerConn
			if conn then conn:Disconnect() end
			state.ownerConn = nil
			local decor = state.decor
			local uncull = state.uncull
			if uncull then uncull() end
			state.uncull = nil
			if decor then decor:Destroy() end
			state.decor = nil
			state.stage = 0
		end
		if _homeSlot == slot then
			local home = _homeGroup
			if home then home:Destroy() end
			_homeGroup = nil
			_homeSlot = nil
		end
		if WorldFXKit.enabled("freeIsland") then
			if not free then
				_free[slot] = buildFree(slot)
			elseif not free.uncull then
				free.group.Parent = _folder
				free.uncull = WorldFXKit.cullGroup(free.group, MapLayout.plotCenter(slot), WorldFXConfig.FREE_ISLAND.SHOW_DISTANCE)
			end
		end
	end
end

local function slotOf(child: Instance): number?
	local n = string.match(child.Name, "^Plot_(%d+)$")
	return if n then tonumber(n) else nil
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function PlotLifeController.init()
	if not FeatureFlags.isOn("WORLD_D_PLOTS") then return end
	_folder = WorldFXKit.folder("PlotLife", WorldFXKit.root())

	for slot = 1, MapConfig.PLOT_COUNT do
		setOccupied(slot, workspace:FindFirstChild("Plot_" .. slot) ~= nil)
	end
	workspace.ChildAdded:Connect(function(child)
		local slot = slotOf(child)
		if slot then setOccupied(slot, true) end
	end)
	workspace.ChildRemoved:Connect(function(child)
		local slot = slotOf(child)
		if slot and not workspace:FindFirstChild(child.Name) then setOccupied(slot, false) end
	end)

	-- Debug: "islandstage" setzt das Player-Attribut (wie der Server), der
	-- Neubau laeuft dann ueber denselben Weg wie im Spiel.
	local acc, clock = 0, 0
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		acc += dt
		if acc < TICK then return end
		acc = 0
		for _, state in _plots do
			stepPond(state, clock)
		end
		stepGusts(os.clock())
		for slot, free in _free do
			stepFree(free, slot, clock)
		end
	end)

	print("[PlotLife] aktiv")
end

return PlotLifeController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX85"><Properties>
<string name="Name">SoundscapeController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- SoundscapeController.luau
-- StarterPlayerScripts/Controllers/SoundscapeController.luau
--
-- Einzige Zustaendigkeit:
--   - Die leise Klang-Kulisse (Paket H, "Welt aufwerten"): je Ort ein
--     Klangteppich (Ufer, Wiese/Grillen, Honigmast, Event-Pit, Arena-Wind),
--     weich ineinander geblendet nach der Kamera-Position; dazu ab und zu
--     eine Moewe am Ufer und die Glocke beim Event-Start (Paket G)
--
-- Wie laut welche Zone ist, rechnet Modules/SoundZones (rein, getestet).
-- Hier laufen nur die Schleifen: hoechstens MAX_AUDIBLE gleichzeitig hoerbar,
-- jede folgt ihrem Ziel weich (kein harter Schnitt), alle in der Sound-Gruppe
-- "WorldAmbience" und immer leiser als die Kampf-Sounds.
--
-- Nur Klaenge mit einer in Studio GEPRUEFTEN ID (WorldFXConfig.SOUNDS). Ist
-- eine ID leer, bleibt diese Zone still — ohne IDs laeuft gar nichts, und
-- es entsteht keine einzige Sound-Instanz.
--
-- PERFORMANCE: ein Takt (5 Hz), eine Sound-Instanz je Zone (nicht positional,
-- die Mischung macht der Takt). Keine Musik (eigene Entscheidung spaeter).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local SoundService      = game:GetService("SoundService")

local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local SoundZones    = require(ReplicatedStorage.Modules.SoundZones)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)

local SoundscapeController = {}

local LOOPS = { "waves", "meadow", "crickets", "drip", "crowd", "wind" }

local _group: SoundGroup? = nil
local _loops: { [string]: Sound } = {}
local _volumes: { [string]: number } = {}
local _gull: Sound? = nil
local _bell: Sound? = nil
local _nextGull = 0
local _eventLive = false

local function soundGroup(): SoundGroup
	local existing = _group or SoundService:FindFirstChild("WorldAmbience")
	if existing and existing:IsA("SoundGroup") then
		_group = existing
		return existing
	end
	local created = Instance.new("SoundGroup")
	created.Name = "WorldAmbience"
	created.Parent = SoundService
	_group = created
	return created
end

local function newSound(key: string, looped: boolean): Sound?
	local id = WorldFXConfig.SOUNDS[key]
	if not id or id == "" then return nil end
	local sound = Instance.new("Sound")
	sound.Name = "Ambience_" .. key
	sound.SoundId = id
	sound.Looped = looped
	sound.Volume = 0
	sound.SoundGroup = soundGroup()
	sound.Parent = SoundService
	return sound
end

-- Glocke beim Event-Start (Paket G). Still ohne gepruefte ID.
function SoundscapeController.bell()
	local bell = _bell
	if bell then
		bell.Volume = (WorldFXConfig.SOUND_VOLUME :: any).bell or 0.1
		bell:Play()
	end
end

-- Laeuft gerade ein Event? (HubEventController meldet den Pit-Zustand.)
function SoundscapeController.setEventLive(live: boolean)
	_eventLive = live
end

function SoundscapeController.init()
	if not (FeatureFlags.isOn("WORLD_H_SOUND") and WorldFXKit.enabled("soundscape")) then return end

	for _, key in LOOPS do
		local sound = newSound(key, true)
		if sound then
			_loops[key] = sound
			_volumes[key] = 0
		end
	end
	_gull = newSound("gull", false)
	_bell = newSound("bell", false)

	if next(_loops) == nil and not _gull then
		print("[Soundscape] still: keine gepruefte Sound-ID in WorldFXConfig.SOUNDS")
		return
	end

	local cfg = WorldFXConfig.SOUNDSCAPE
	local random = Random.new()
	_nextGull = os.clock() + random:NextNumber(cfg.GULL_EVERY[1], cfg.GULL_EVERY[2])
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < cfg.TICK then return end
		acc = 0
		local camera = workspace.CurrentCamera
		if not camera then return end

		local weights = SoundZones.weights(camera.CFrame.Position, DayCycleController.dusk(), _eventLive)
		local target = SoundZones.audible(weights)
		for key, sound in _loops do
			local max = (WorldFXConfig.SOUND_VOLUME :: any)[key] or 0.06
			local goal = max * (target[key] or 0)
			local v = _volumes[key] + (goal - _volumes[key]) * cfg.FADE * (cfg.TICK / 0.2)
			if math.abs(v - goal) < 0.002 then v = goal end
			_volumes[key] = v
			sound.Volume = v
			if v > 0 and not sound.IsPlaying then
				sound:Play()
			elseif v == 0 and sound.IsPlaying then
				sound:Stop()
			end
		end

		-- Moewe: ab und zu, nur wenn das Ufer gerade zu hoeren ist
		local gull = _gull
		if gull and os.clock() >= _nextGull then
			_nextGull = os.clock() + random:NextNumber(cfg.GULL_EVERY[1], cfg.GULL_EVERY[2])
			if (weights.waves or 0) > 0.5 then
				gull.Volume = (WorldFXConfig.SOUND_VOLUME :: any).gull * weights.waves
				gull:Play()
			end
		end
	end)

	local count = 0
	for _ in _loops do count += 1 end
	print("[Soundscape] aktiv | Schleifen mit ID:", count, "| Moewe:", _gull ~= nil)
end

return SoundscapeController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX86"><Properties>
<string name="Name">WaterController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WaterController.luau
-- StarterPlayerScripts/Controllers/WaterController.luau
--
-- Einzige Zustaendigkeit:
--   - Wasser und Kueste lebendig machen (Paket B, "Welt aufwerten"):
--     wanderndes Glitzern und Wellenlinien auf dem Wasser, Schaum-Textur auf
--     den Saeumen, Schaum und Stegpfosten an Arena-Inseln, springender
--     Honig-Fisch, schaukelnde Bonbon-Bojen
--
-- Alles nur auf dem Client: die Server-Teile (Wasser, Schaum-Scheiben)
-- bekommen hoechstens eine lokale Textur als Kind und eine lokale Farbe; neue
-- Teile entstehen in WorldFX_Local und werden nie repliziert. Das Teile-
-- Budget der Plot-Inseln (Server) bleibt unberuehrt.
--
-- Ohne hochgeladene Textur-IDs (WorldFXConfig.TEXTURE_IDS) gibt es kein
-- Glitzern, keine Wellen und keine Schaum-Textur: das Wasser bleibt wie
-- heute. Fisch, Bojen und Arena-Kueste laufen auch ohne Bilder.
--
-- PERFORMANCE: EIN Takt (WATER.TICK, 30x pro Sekunde) fuer Textur-Versatz,
-- Fisch und Bojen; die Arena-Kueste wird 2x pro Sekunde auf Sichtweite und
-- Besetzung geprueft. Ein Emitter (Spritzer), alle Teile aus festen Pools.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local MapConfig      = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig  = require(ReplicatedStorage.Config.WorldFXConfig)
local MapLayout      = require(ReplicatedStorage.Modules.MapLayout)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)

local WaterController = {}

local WATER_Y = MapConfig.PLATFORM_TOP_Y - MapConfig.WATER_DROP
local FOAM_Y  = WATER_Y + 0.05
local UPRIGHT = WorldFXKit.UPRIGHT
local TOP_FACE = Enum.NormalId.Right   -- liegender Zylinder (UPRIGHT): +X zeigt nach oben

local _folder: Folder? = nil
local _glitter: Texture? = nil
local _waves: Texture? = nil
local _laces: { Texture } = {}

type Coast = { model: Model, occupied: boolean, shown: boolean, foam: BasePart, lace: Texture?, phase: number }
local _coasts: { [number]: Coast } = {}

type Buoy = { model: Model, base: CFrame, phase: number }
local _buoys: { Buoy } = {}

type Fish = { model: Model, active: boolean, start: number, from: Vector3, dir: Vector3 }
local _fish: Fish? = nil
local _nextFishAt = 0
local _splashAnchor: BasePart? = nil
local _splash: ParticleEmitter? = nil
local _ring: BasePart? = nil
local _ringDecal: Decal? = nil
local _ringStart = -math.huge

local _random = Random.new()

--------------------------------------------------------------------------------
-- Glitzern und Wellen
--------------------------------------------------------------------------------

local function newTexture(parent: Instance, name: string, id: string, tile: number, transparency: number): Texture
	local tex = Instance.new("Texture")
	tex.Name          = name
	tex.Texture       = id
	tex.Face          = TOP_FACE
	tex.StudsPerTileU = tile
	tex.StudsPerTileV = tile
	tex.Transparency  = transparency
	tex.Parent        = parent
	return tex
end

local function setupWater()
	local platform = workspace:WaitForChild("Platform", 60)
	local water = platform and platform:WaitForChild("Water", 30)
	if not (water and water:IsA("BasePart")) then return end
	local cfg = WorldFXConfig.WATER

	local glitterId = WorldFXKit.textureId("water_glitter")
	if glitterId and WorldFXKit.enabled("waterGlitter") then
		_glitter = newTexture(water, "Glitter", glitterId, cfg.GLITTER_TILE, cfg.GLITTER_TRANSPARENCY)
	end
	local wavesId = WorldFXKit.textureId("water_waves")
	if wavesId and WorldFXKit.enabled("waterWaves") then
		_waves = newTexture(water, "Waves", wavesId, cfg.WAVES_TILE, cfg.WAVES_TRANSPARENCY)
	end
end

--------------------------------------------------------------------------------
-- Schaum der festen Inseln (Server-Scheiben, lokal eingefaerbt)
--------------------------------------------------------------------------------

-- Gibt die Textur zurueck, falls es ein Schaum-Bild gibt. Die Scheibe wird
-- dann unsichtbar; das Atmen uebernimmt AmbienceController an der Textur.
local function dressFoam(part: BasePart): Texture?
	part.Color = WorldFXConfig.FOAM_COLOR
	local laceId = WorldFXKit.textureId("foam_lace")
	if not (laceId and WorldFXKit.enabled("foamTexture")) then
		return nil
	end
	local tex = newTexture(part, "FoamLace", laceId, WorldFXConfig.WATER.FOAM_TILE, part.Transparency)
	tex.Color3 = WorldFXConfig.FOAM_COLOR
	part.Transparency = 1
	table.insert(_laces, tex)
	return tex
end

local function setupFoam()
	local platform = workspace:WaitForChild("Platform", 60)
	local scenery = platform and platform:WaitForChild("Scenery", 30)
	local foam = scenery and scenery:WaitForChild("Foam", 30)
	if not foam then return end
	for _, child in foam:GetChildren() do
		if child:IsA("BasePart") then
			dressFoam(child)
		end
	end
end

--------------------------------------------------------------------------------
-- Arena-Insel und aeusserer Steg (pro besetztem Slot, lokal)
--------------------------------------------------------------------------------

local function buildCoast(slot: number): Coast
	local cfg = WorldFXConfig.ARENA_COAST
	local model = Instance.new("Model")
	model.Name = "ArenaCoast_" .. slot

	-- Schaum um die Arena-Insel: wie ScenicBuilder.buildFoam
	local center = MapLayout.pitCenter(slot)
	local radius = MapConfig.PIT_BASE_RADIUS + MapConfig.SHORE_WIDTH + AmbienceConfig.FOAM_REACH
	local foam = WorldFXKit.part("Foam", model, Vector3.new(0.1, radius * 2, radius * 2),
		CFrame.new(center.X, FOAM_Y, center.Z) * UPRIGHT, WorldFXConfig.FOAM_COLOR,
		Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	foam.Transparency = AmbienceConfig.FOAM_TRANSPARENCY
	local lace = dressFoam(foam)

	-- Pfosten mit Leuchtkappe an beiden Enden des aeusseren Stegs (wie
	-- ScenicBuilder.buildBridgePosts fuer die inneren Stege)
	local outward = MapLayout.outward(slot)
	local side = MapLayout.side(slot)
	local deckTop = MapConfig.PLATFORM_TOP_Y - MapConfig.BRIDGE_SINK
	local sideOffset = (MapConfig.BRIDGE_WIDTH + MapConfig.BRIDGE_RAIL_WIDTH) * 0.5
	local islandEdge = MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS
	for _, r in { islandEdge + cfg.INSET, islandEdge + MapConfig.ISLAND_GAP - cfg.INSET } do
		for _, sign in { -1, 1 } do
			local p = MapConfig.CENTER + outward * r + side * (sign * sideOffset)
			WorldFXKit.pole("Post", model, Vector3.new(p.X, deckTop, p.Z), cfg.POST_HEIGHT, cfg.POST_DIAMETER,
				MapConfig.BRIDGE_RAIL_COLOR, Enum.Material.Wood)
			local cap = WorldFXKit.ball("Cap", model, cfg.CAP_SIZE,
				Vector3.new(p.X, deckTop + cfg.POST_HEIGHT + 0.5, p.Z), WorldFXConfig.LAMP_DAY, Enum.Material.Neon)
			DayCycleController.registerGlow(cap, WorldFXConfig.LAMP_DAY, WorldFXConfig.LAMP_NIGHT)
		end
	end

	return { model = model, occupied = false, shown = false, foam = foam, lace = lace, phase = slot * 0.8 + 0.4 }
end

local function slotOf(child: Instance): number?
	local n = string.match(child.Name, "^Plot_(%d+)$")
	return if n then tonumber(n) else nil
end

local function setOccupied(slot: number, occupied: boolean)
	if not WorldFXKit.enabled("arenaCoast") then return end
	local coast = _coasts[slot]
	if not coast then
		if not occupied then return end
		coast = buildCoast(slot)
		_coasts[slot] = coast
	end
	coast.occupied = occupied
end

-- 2x pro Sekunde: sichtbar = besetzt und in Sichtweite (Pool: das Model
-- bleibt erhalten und wird nur ein- und ausgehaengt).
local function refreshCoasts()
	local camera = workspace.CurrentCamera
	local folder = _folder
	if not (camera and folder) then return end
	local eye = camera.CFrame.Position
	for slot, coast in _coasts do
		local d = (MapLayout.pitCenter(slot) - eye).Magnitude
		local limit = WorldFXConfig.ARENA_COAST.SHOW_DISTANCE * (if coast.shown then 1 else 0.9)
		local want = coast.occupied and d <= limit
		if want ~= coast.shown then
			coast.shown = want
			coast.model.Parent = if want then folder else nil
		end
	end
end

--------------------------------------------------------------------------------
-- Bonbon-Bojen
--------------------------------------------------------------------------------

local function buildBuoys(folder: Instance)
	local cfg = WorldFXConfig.BUOYS
	local positions = MapLayout.buoys(cfg.RADIUS)
	local step = if WorldFXKit.quality() == 1 then 1 else 2
	for i = 1, #positions, step do
		local p = positions[i]
		local model = Instance.new("Model")
		model.Name = "Buoy"
		local s = cfg.SIZE
		WorldFXKit.ball("Body", model, s, p + Vector3.new(0, s * 0.25, 0), cfg.BODY_COLOR, Enum.Material.SmoothPlastic)
		WorldFXKit.part("Stripe", model, Vector3.new(s * 0.32, s * 1.02, s * 1.02),
			CFrame.new(p + Vector3.new(0, s * 0.3, 0)) * UPRIGHT, cfg.STRIPE_COLOR, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		WorldFXKit.ball("Knob", model, s * 0.38, p + Vector3.new(0, s * 0.8, 0), cfg.STRIPE_COLOR, Enum.Material.SmoothPlastic)
		model.Parent = folder
		table.insert(_buoys, { model = model, base = model:GetPivot(), phase = i * 1.7 })
	end
end

--------------------------------------------------------------------------------
-- Honig-Fisch
--------------------------------------------------------------------------------

local function buildFish(folder: Instance)
	local cfg = WorldFXConfig.FISH
	local model = Instance.new("Model")
	model.Name = "HoneyFish"
	-- Koerper: runder, goldglaenzender Ball (Laengsachse = Z), Schwanz, Flosse, Auge
	local body = WorldFXKit.ellipsoid("Body", model, Vector3.new(1.3, 1.5, 2.2), CFrame.new(), cfg.COLOR,
		Enum.Material.SmoothPlastic)
	body.Reflectance = 0.25
	WorldFXKit.part("Tail", model, Vector3.new(0.2, 1.4, 1.0), CFrame.new(0, 0, 1.35), cfg.FIN_COLOR, Enum.Material.SmoothPlastic)
	WorldFXKit.part("Fin", model, Vector3.new(0.15, 0.6, 0.8), CFrame.new(0, 0.8, 0.1), cfg.FIN_COLOR, Enum.Material.SmoothPlastic)
	for _, x in { -0.5, 0.5 } do
		WorldFXKit.ball("Eye", model, 0.28, Vector3.new(x, 0.25, -0.75), Color3.fromRGB(40, 28, 20), Enum.Material.SmoothPlastic)
	end
	model.PrimaryPart = body
	_fish = { model = model, active = false, start = 0, from = Vector3.zero, dir = Vector3.new(0, 0, -1) }

	-- Spritzer: ein Emitter, wird an Absprung- und Eintauchstelle gesetzt
	local anchor = WorldFXKit.anchor("SplashAnchor", folder, Vector3.new(1, 0.2, 1), Vector3.new(0, -200, 0))
	local emitter = Instance.new("ParticleEmitter")
	if WorldFXKit.applyParticleTexture(emitter, "splash_flipbook") then
		if emitter.FlipbookLayout ~= Enum.ParticleFlipbookLayout.None then
			emitter.FlipbookMode = Enum.ParticleFlipbookMode.OneShot   -- 4 Bilder ueber die Lebenszeit
		end
		emitter.Rate = 0
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		emitter.Lifetime = NumberRange.new(0.5, 0.8)
		emitter.Speed = NumberRange.new(4, 9)
		emitter.SpreadAngle = Vector2.new(35, 35)
		emitter.Acceleration = Vector3.new(0, -30, 0)
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0.2) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		emitter.Parent = anchor
		_splash = emitter
	else
		emitter:Destroy()
	end
	_splashAnchor = anchor

	-- Ring auf der Oberflaeche: flache Scheibe; mit Ring-Bild nur das Bild
	local ring = WorldFXKit.part("Ring", nil, Vector3.new(0.05, 1, 1), CFrame.new(), Color3.new(1, 1, 1),
		Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	local ringId = WorldFXKit.textureId("water_ring")
	if ringId then
		local decal = Instance.new("Decal")
		decal.Texture = ringId
		decal.Face = TOP_FACE
		decal.Parent = ring
		ring.Transparency = 1
		_ringDecal = decal
	end
	_ring = ring
end

local function splashAt(position: Vector3, folder: Instance)
	local anchor = _splashAnchor
	local emitter = _splash
	if anchor and emitter then
		anchor.Position = Vector3.new(position.X, WATER_Y + 0.2, position.Z)
		emitter:Emit(10)
	end
	local ring = _ring
	if ring then
		ring.CFrame = CFrame.new(position.X, WATER_Y + 0.06, position.Z) * UPRIGHT
		ring.Parent = folder
		_ringStart = os.clock()
	end
end

-- Neuer Sprung: offener Wasserpunkt vor der Kamera, sonst spaeter erneut.
local function startFish(folder: Instance): boolean
	local fish = _fish
	local camera = workspace.CurrentCamera
	if not (fish and camera) or fish.active then return false end
	local cfg = WorldFXConfig.FISH
	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
	for _ = 1, 8 do
		local turn = _random:NextNumber(-0.6, 0.6)
		local dist = _random:NextNumber(cfg.DIST_MIN, cfg.DIST_MAX)
		local dir = CFrame.Angles(0, turn, 0):VectorToWorldSpace(flat)
		local p = camera.CFrame.Position + dir * dist
		local jumpAngle = _random:NextNumber(0, math.pi * 2)
		local jumpDir = Vector3.new(math.cos(jumpAngle), 0, math.sin(jumpAngle))
		local land = p + jumpDir * cfg.JUMP_LENGTH
		if MapLayout.isOpenWater(p.X, p.Z, cfg.WATER_MARGIN) and MapLayout.isOpenWater(land.X, land.Z, cfg.WATER_MARGIN) then
			fish.from = Vector3.new(p.X, WATER_Y, p.Z)
			fish.dir = jumpDir
			fish.start = os.clock()
			fish.active = true
			fish.model.Parent = folder
			splashAt(fish.from, folder)
			return true
		end
	end
	return false
end

local function stepFish(folder: Instance)
	local fish = _fish
	if not fish then return end
	local cfg = WorldFXConfig.FISH

	if fish.active then
		local t = (os.clock() - fish.start) / cfg.JUMP_TIME
		if t >= 1 then
			fish.active = false
			fish.model.Parent = nil
			splashAt(fish.from + fish.dir * cfg.JUMP_LENGTH, folder)
			_nextFishAt = os.clock() + _random:NextNumber(cfg.PAUSE_MIN, cfg.PAUSE_MAX)
		else
			-- Bogen: startet und endet knapp unter Wasser, Nase folgt der Bahn
			local height = cfg.JUMP_HEIGHT * 4 * t * (1 - t) - 0.8
			local pos = fish.from + fish.dir * (cfg.JUMP_LENGTH * t) + Vector3.new(0, height, 0)
			local slope = cfg.JUMP_HEIGHT * 4 * (1 - 2 * t) / cfg.JUMP_LENGTH
			local forward = (fish.dir + Vector3.new(0, slope, 0)).Unit
			fish.model:PivotTo(CFrame.lookAt(pos, pos + forward))
		end
	elseif os.clock() >= _nextFishAt then
		if not startFish(folder) then
			_nextFishAt = os.clock() + 5   -- kein Wasser in Sicht: gleich nochmal
		end
	end

	-- Ring waechst und verblasst
	local ring = _ring
	if ring and ring.Parent then
		local k = (os.clock() - _ringStart) / cfg.RING_TIME
		if k >= 1 then
			ring.Parent = nil
		else
			local size = 1 + cfg.RING_SIZE * k
			ring.Size = Vector3.new(0.05, size, size)
			local decal = _ringDecal
			if decal then
				decal.Transparency = k
			else
				ring.Transparency = 0.5 + 0.5 * k
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function WaterController.init()
	if not FeatureFlags.isOn("WORLD_B_WATER") then return end
	local folder = WorldFXKit.folder("Water", WorldFXKit.root())
	_folder = folder

	task.spawn(setupWater)
	task.spawn(setupFoam)

	if WorldFXKit.enabled("buoys") then
		buildBuoys(folder)
	end
	if WorldFXKit.enabled("fish") then
		buildFish(folder)
		_nextFishAt = os.clock() + _random:NextNumber(WorldFXConfig.FISH.PAUSE_MIN * 0.5, WorldFXConfig.FISH.PAUSE_MAX * 0.5)
	end

	-- Besetzte Plots (Plot_N in workspace) bekommen ihre Arena-Kueste
	for _, child in workspace:GetChildren() do
		local slot = slotOf(child)
		if slot then setOccupied(slot, true) end
	end
	workspace.ChildAdded:Connect(function(child)
		local slot = slotOf(child)
		if slot then setOccupied(slot, true) end
	end)
	workspace.ChildRemoved:Connect(function(child)
		local slot = slotOf(child)
		if slot and not workspace:FindFirstChild(child.Name) then setOccupied(slot, false) end
	end)

	-- Debug (Studio): sofort einen Fisch springen lassen
	WorldFXKit.onDebug("DebugFish", function()
		_nextFishAt = 0
	end, false)

	local cfg = WorldFXConfig.WATER
	local buoyCfg = WorldFXConfig.BUOYS
	local acc, coastAcc, clock = 0, 0, 0
	local twoPi = math.pi * 2
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		acc += dt
		coastAcc += dt
		if coastAcc >= 0.5 then
			coastAcc = 0
			refreshCoasts()
		end
		if acc < cfg.TICK then return end
		acc = 0

		local day = DayCycleController.values()

		-- Glitzern und Wellen wandern in zwei Richtungen
		local glitter = _glitter
		if glitter then
			glitter.OffsetStudsU = (clock * cfg.GLITTER_SPEED.X) % cfg.GLITTER_TILE
			glitter.OffsetStudsV = (clock * cfg.GLITTER_SPEED.Y) % cfg.GLITTER_TILE
			glitter.Transparency = 1 - (1 - cfg.GLITTER_TRANSPARENCY) * day.glitter
			glitter.Color3 = day.glitterTint
		end
		local waves = _waves
		if waves then
			waves.OffsetStudsU = (clock * cfg.WAVES_SPEED.X) % cfg.WAVES_TILE
			waves.OffsetStudsV = (clock * cfg.WAVES_SPEED.Y) % cfg.WAVES_TILE
		end
		-- Schaum treibt ganz langsam (die festen Saeume atmet AmbienceController)
		for _, lace in _laces do
			lace.OffsetStudsU = (clock * cfg.FOAM_DRIFT) % cfg.FOAM_TILE
		end
		-- Arena-Schaum atmet wie die festen Saeume
		for _, coast in _coasts do
			if coast.shown then
				local value = AmbienceConfig.FOAM_TRANSPARENCY
					+ math.sin(clock / AmbienceConfig.FOAM_PULSE_PERIOD * twoPi + coast.phase) * AmbienceConfig.FOAM_PULSE
				local lace = coast.lace
				if lace then lace.Transparency = value else coast.foam.Transparency = value end
			end
		end

		-- Bojen schaukeln
		for _, buoy in _buoys do
			local w = clock * buoyCfg.ROCK_RATE * twoPi + buoy.phase
			buoy.model:PivotTo(buoy.base
				* CFrame.new(0, math.sin(w * 0.7) * buoyCfg.BOB_HEIGHT, 0)
				* CFrame.Angles(math.rad(buoyCfg.ROCK_DEGREES) * math.sin(w), 0, math.rad(buoyCfg.ROCK_DEGREES * 0.6) * math.cos(w * 0.8)))
		end

		stepFish(folder)
	end)

	print("[Water] aktiv | Glitzer-Bild:", WorldFXKit.textureId("water_glitter") ~= nil, "| Bojen:", #_buoys, "| Fisch:", _fish ~= nil)
end

return WaterController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX87"><Properties>
<string name="Name">WorldController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldController.luau
-- StarterPlayerScripts/Controllers/WorldController.luau
--
-- Einzige Zustaendigkeit:
--   - Klicks und Naeherungs-Prompts an Objekten in der Welt in UI-Aktionen
--     uebersetzen
--
-- Es gibt drei Anker in der Welt:
--   1. Baerchi-Figuren (Attribut "BaerchiUid" an Koerper und Kopf)
--      → Detailkarte, ueber einen ClickDetector den der Server schon mitbaut
--   2. Gebaeude-Parts (Name = BuildingId, Attribute "BuildingLevel"/"HoneyPool")
--      → ein hier erzeugter ProximityPrompt (E) oeffnet das Gebaeude-Panel
--   3. Die Kampf-Plattform ("FightFloor" im Model "PitPlatform")
--      → v15: Tower-Wahl (CombatPanel), ueber einen hier erzeugten ProximityPrompt
--   4. v15: FREMDE Spieler (Charakter) und fremde Plot-Schilder
--      → Profilkarte (Inspektor, ProfilePanel), per Klick
--
-- Gelegte Eier sind ABSICHTLICH kein vierter Anker mehr: sie werden nicht
-- mehr angeklickt, sondern serverseitig per Touched eingesammelt, sobald die
-- eigene Spielfigur hindurchlaeuft (siehe MapService.buildLaidEgg). Dieser
-- Controller muss sie deshalb nicht mehr kennen — es gibt am Ei keinen
-- ClickDetector mehr, an den er sich haengen koennte.
--
-- Das Fuettern selbst ist seit dem Equip-/Honig-Teich-System keine manuelle
-- Aktion mehr: der ausgeruestete Baerchi laeuft von alleine zum Teich auf dem
-- Plot, sobald er Honig braucht (siehe BaerchiAutopilotService). Den
-- frueheren "Honig fuettern (E)"-Prompt am Gebaeude gibt es deshalb nicht
-- mehr — er waere jetzt ohnehin nur noch fuer den einen sichtbaren Baerchi
-- relevant gewesen.
--
-- Die Prompts entstehen bewusst auf dem Client: der Server braucht sie nicht
-- zu kennen, weil sie nur ein lokales Fenster oeffnen.
--
-- Besitzer-Pruefung: MapService schreibt das Attribut "PlotOwner" (UserId) an
-- jedes Plot-Model. Prompts entstehen nur am EIGENEN Plot. Vorher erschienen
-- sie auch an fremden Gebaeuden — ungefaehrlich, weil RequestUpgradeBuilding
-- und RequestStartCombat kein Insel-Argument haben und der Server immer auf
-- den Daten des anfragenden Spielers arbeitet, aber irrefuehrend: man haette
-- am Nachbar-Gebaeude sein eigenes ausgebaut.
--
-- Die Zuordnung der Baerchis laeuft ueber das Attribut "BaerchiUid", das
-- MapService an die Koerper-Part schreibt. Der Client braucht dafuer kein
-- eigenes Remote: er hat die vollstaendigen Baerchi-Daten bereits ueber
-- PlayerDataUpdated.
--
-- Ausserdem markiert dieser Controller den EIGENEN Plot mit einem Wegweiser
-- ueber dem Schild. Das gehoert bewusst hierher und nicht zu MapService: der
-- Server baut fuer alle dasselbe, aber "dein Plot" ist fuer jeden ein anderer.
-- Serverseitig muesste man dafuer acht verschiedene Schilder bauen — hier ist
-- es ein einziges Element, das nur der Besitzer sieht.

local Players   = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Loc          = require(ReplicatedStorage.Localization.Loc)

local Theme        = require(script.Parent.Parent.UI.Theme)
local BaerchiPanel = require(script.Parent.Parent.UI.BaerchiPanel)
local PanelManager = require(script.Parent.Parent.UI.PanelManager)

local WorldController = {}

local UID_ATTRIBUTE   = "BaerchiUid"
local LEVEL_ATTRIBUTE = "BuildingLevel"
local OWNER_ATTRIBUTE = "PlotOwner"
local PROMPT_DISTANCE = 14

-- v15 Inspektor: Klick auf fremde Spieler oder fremde Plot-Schilder oeffnet
-- die Profilkarte. Der ClickDetector entsteht nur lokal und heisst "Inspect",
-- damit hookClickable ihn nicht fuer eine Baerchi-Figur haelt.
local INSPECT_NAME     = "Inspect"
local INSPECT_DISTANCE = 60

-- Wegweiser auf den eigenen Plot. Die Plattform ist 480 Studs breit und
-- ueberall gleich gruen; ohne diese Marke sucht man beim ersten Join acht
-- Schilder ab, um das eigene zu finden. Reichweite deshalb so gross, dass sie
-- vom Spawn in der Mitte aus zu sehen ist (Plot-Ring: 165 Studs).
local HOME_MARKER_NAME     = "DeinPlot"
local HOME_MARKER_DISTANCE = 260
local HOME_MARKER_HEIGHT   = 7

-- Gebaeude-Part-Namen wie MapService sie vergibt (= Types.BuildingId)
local BUILDING_NAMES: { [string]: boolean } = {
	Beehive      = true,
	HoneyRefiner = true,
	HoneyPond    = true,
}

-- Bereits verbundene ClickDetectors, damit nichts doppelt haengt
local _connected: { [ClickDetector]: boolean } = {}

--------------------------------------------------------------------------------
-- Baerchi-Figuren
--------------------------------------------------------------------------------

-- Ein ClickDetector in der Welt gehoert einer Baerchi-Figur — Eier haben seit
-- dem Umstieg auf Beruehren-zum-Einsammeln keinen ClickDetector mehr (siehe
-- Kommentar-Kopf).
local function findTarget(detector: ClickDetector): string?
	local part = detector.Parent
	if not part then return nil end

	local baerchiUid = part:GetAttribute(UID_ATTRIBUTE)
	if typeof(baerchiUid) == "string" then
		return baerchiUid
	end

	return nil
end

local function tryHook(detector: ClickDetector): boolean
	if _connected[detector] then return true end

	if findTarget(detector) == nil then return false end

	_connected[detector] = true

	detector.MouseClick:Connect(function()
		-- Beim Klick NEU nachschlagen statt den Wert von oben zu benutzen: die
		-- Part kann inzwischen eine andere uid tragen (Figuren werden bei jedem
		-- Plot-Neuaufbau ersetzt).
		local current = findTarget(detector)
		if not current then return end

		BaerchiPanel.show(current)
	end)

	detector.Destroying:Connect(function()
		_connected[detector] = nil
	end)

	return true
end

local function hookClickable(instance: Instance)
	if not instance:IsA("ClickDetector") then return end
	if instance.Name == INSPECT_NAME then return end
	if tryHook(instance) then return end

	-- Replikation ist nicht sortiert: der ClickDetector kann beim Client
	-- ankommen bevor das Attribut seiner Part da ist. Deshalb einmal im
	-- naechsten Frame erneut versuchen und sonst auf eines der beiden Attribute
	-- warten — welches kommt, weiss man vorher nicht.
	task.defer(function()
		if tryHook(instance) then return end

		local part = instance.Parent
		if not part then return end

		local connection: RBXScriptConnection? = nil
		connection = part:GetAttributeChangedSignal(UID_ATTRIBUTE):Connect(function()
			if tryHook(instance) and connection then
				connection:Disconnect()
			end
		end)
	end)
end

--------------------------------------------------------------------------------
-- Gebaeude und Kampfplattform
--------------------------------------------------------------------------------

-- Ein Prompt an einer Part. `name` dient als Schutz gegen doppeltes Anhaengen:
-- die Parts werden bei jedem Plot-Neuaufbau ersetzt, und ein zweiter Prompt
-- waere ein doppeltes Fenster.
local function addPrompt(
	part: BasePart,
	name: string,
	actionText: string,
	objectText: string,
	keyCode: Enum.KeyCode,
	onTriggered: () -> ()
): ProximityPrompt?
	if part:FindFirstChild(name) then return nil end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = name
	prompt.ActionText            = actionText
	prompt.ObjectText            = objectText
	prompt.KeyboardKeyCode       = keyCode
	prompt.MaxActivationDistance = PROMPT_DISTANCE
	prompt.RequiresLineOfSight   = false
	prompt.Parent                = part

	prompt.Triggered:Connect(onTriggered)
	return prompt
end

local function addPanelPrompt(part: BasePart, actionText: string, objectText: string, panelName: string)
	addPrompt(part, "OpenPanel", actionText, objectText, Enum.KeyCode.E, function()
		PanelManager.open(panelName)
	end)
end

--------------------------------------------------------------------------------
-- Wem gehoert der Plot, in dem dieses Teil steckt?
--
-- MapService setzt das Attribut am Plot-Model, nicht an jedem Teil — also
-- nach oben laufen bis es gefunden wird. Teile ausserhalb eines Plots (die
-- Plattform selbst, Blumen) haben keinen Besitzer und liefern nil.
local function findPlotOwner(instance: Instance): number?
	local current: Instance? = instance

	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner
		end
		current = current.Parent
	end

	return nil
end

local function isOwnPlot(instance: Instance): boolean
	return findPlotOwner(instance) == Players.LocalPlayer.UserId
end

-- Der Wegweiser ueber dem eigenen Plot-Schild.
--
-- Rein lokal erzeugt: er landet nie beim Server und damit auch nie bei den
-- anderen sieben Spielern, die ja alle ihren eigenen sehen sollen. Beim
-- Neuaufbau des Plots verschwindet er mit dem Schild und wird von
-- DescendantAdded wieder angelegt — deshalb die Pruefung auf ein bereits
-- vorhandenes Exemplar.
local function addHomeMarker(board: BasePart)
	if board:FindFirstChild(HOME_MARKER_NAME) then return end

	local marker = Instance.new("BillboardGui")
	marker.Name        = HOME_MARKER_NAME
	marker.Size        = UDim2.fromScale(14, 4)
	marker.StudsOffset = Vector3.new(0, HOME_MARKER_HEIGHT, 0)
	marker.MaxDistance = HOME_MARKER_DISTANCE
	-- Durch die Landschaft hindurch sichtbar: genau dafuer ist er da. Vom
	-- Spawn aus liegt zwischen Spieler und Schild sonst der halbe Plot.
	marker.AlwaysOnTop = true
	marker.Adornee     = board
	marker.Parent      = board

	local label = Instance.new("TextLabel")
	label.Name                   = "Text"
	label.Size                   = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font                   = Theme.FONT
	label.TextScaled             = true
	label.Text                   = "\u{25BC} Dein Plot"
	label.TextColor3             = Theme.COLORS.goldGummy
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
	label.Parent                 = marker
end

--------------------------------------------------------------------------------
-- Inspektor (v15)
--------------------------------------------------------------------------------

-- Haengt einen lokalen ClickDetector an `parent` (Part oder Model), der die
-- Profilkarte von `userId` oeffnet. Der Server prueft selbst, ob der Spieler
-- auf diesem Server ist (ProfileService); hier geht es nur ums Oeffnen.
local function addInspector(parent: Instance, userId: number)
	if parent:FindFirstChild(INSPECT_NAME) then return end
	if userId == Players.LocalPlayer.UserId then return end

	local detector = Instance.new("ClickDetector")
	detector.Name                  = INSPECT_NAME
	detector.MaxActivationDistance = INSPECT_DISTANCE
	detector.Parent                = parent

	detector.MouseClick:Connect(function()
		-- Am Schild beim Klick neu nachschlagen: ein Plot kann inzwischen einem
		-- anderen Spieler gehoeren.
		local target = if parent:IsA("BasePart") then (findPlotOwner(parent) or userId) else userId
		if target == Players.LocalPlayer.UserId then return end
		PanelManager.open("Profile", target)
	end)
end

local function hookCharacter(other: Player, character: Model)
	addInspector(character, other.UserId)
end

local function hookPlayer(other: Player)
	if other == Players.LocalPlayer then return end
	if other.Character then
		hookCharacter(other, other.Character)
	end
	other.CharacterAdded:Connect(function(character)
		hookCharacter(other, character)
	end)
end

local function hookOwnedPart(instance: BasePart)
	if instance.Name == "SignBoard" then
		addHomeMarker(instance)
		return
	end

	if instance.Name == "FightFloor" then
		addPanelPrompt(instance, Loc.t("ui.tower.prompt_action"), Loc.t("ui.tower.prompt_object"), PanelManager.ARENA_PANEL)
		return
	end

	if not BUILDING_NAMES[instance.Name] then return end

	-- Fuettern passiert nicht mehr hier (siehe Kommentar-Kopf) — es bleibt nur
	-- noch das Ausbauen.
	--
	-- Jedes Gebaeude hat sein EIGENES Menue (siehe BuildingPanel), und der
	-- Prompt oeffnet genau dieses — nicht mehr eine Liste, in der man das
	-- angeklickte Gebaeude erst suchen muss.
	--
	-- Dasselbe Menue haengt auch an der Kachelleiste rechts. Der Prompt hier ist
	-- also nur noch die Abkuerzung fuer den, der ohnehin davorsteht; gehen MUSS
	-- niemand mehr.
	local buildingId = instance.Name

	local function attach()
		addPrompt(instance, "OpenPanel", "Ausbauen", buildingId, Enum.KeyCode.E, function()
			PanelManager.open(PanelManager.buildingPanelName(buildingId))
		end)
	end

	-- Das Level-Attribut setzt MapService erst NACH dem Einhaengen der Part.
	-- Beim Client kann die Part deshalb kurz ohne Attribut ankommen —
	-- dann einmal warten statt das Gebaeude zu verpassen.
	if instance:GetAttribute(LEVEL_ATTRIBUTE) ~= nil then
		attach()
		return
	end

	local connection: RBXScriptConnection? = nil
	connection = instance:GetAttributeChangedSignal(LEVEL_ATTRIBUTE):Connect(function()
		attach()
		if connection then
			connection:Disconnect()
		end
	end)
end

local function hookWorldPart(instance: Instance)
	if not instance:IsA("BasePart") then return end

	-- Nur die eigenen Gebaeude und das eigene PIT bekommen einen Prompt.
	-- Vorher erschien er an jedem fremden Plot, was schon deshalb verwirrend
	-- war weil der Server die Anfrage ohnehin immer auf die Daten des
	-- ANFRAGENDEN Spielers anwendet — man haette also am Nachbar-Gebaeude
	-- sein eigenes ausgebaut.
	if isOwnPlot(instance) then
		hookOwnedPart(instance)
		return
	end

	-- v15: fremdes Plot-Schild → Profilkarte des Besitzers
	if instance.Name == "SignBoard" then
		local owner = findPlotOwner(instance)
		if owner then
			addInspector(instance, owner)
			return
		end
	end

	-- Besitzer noch unbekannt: das kann passieren wenn das Teil beim Client
	-- ankommt bevor sein Plot-Model komplett da ist. Einmal im naechsten
	-- Frame erneut versuchen, statt den Prompt fuer immer zu verlieren.
	if findPlotOwner(instance) == nil then
		task.defer(function()
			if not instance.Parent then return end
			if isOwnPlot(instance) then
				hookOwnedPart(instance)
			elseif instance.Name == "SignBoard" then
				local owner = findPlotOwner(instance)
				if owner then addInspector(instance, owner) end
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

local function hook(instance: Instance)
	hookClickable(instance)
	hookWorldPart(instance)
end

function WorldController.init()
	-- Was schon da ist
	for _, descendant in Workspace:GetDescendants() do
		hook(descendant)
	end

	-- Und alles was der Server noch nachliefert. Die Figuren werden bei jeder
	-- Bestandsaenderung neu gebaut, also passiert das staendig.
	Workspace.DescendantAdded:Connect(hook)

	-- v15 Inspektor: fremde Spielfiguren anklickbar machen
	for _, other in Players:GetPlayers() do
		hookPlayer(other)
	end
	Players.PlayerAdded:Connect(hookPlayer)

	print("[WorldController] Initialisiert")
end

return WorldController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX88"><Properties>
<string name="Name">WorldFXKit</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldFXKit.luau
-- StarterPlayerScripts/Controllers/WorldFXKit.luau
--
-- Einzige Zustaendigkeit:
--   - Gemeinsame Bausteine der Welt-Controller ("Welt aufwerten"): Qualitaet,
--     Deko-Teile, Texturen mit Rueckfall, Distanz-Abschaltung, Debug-Signale
--
-- Kein eigener Takt, kein Zustand ausser der Liste der Distanz-Gruppen. Die
-- Controller (DayCycle, Water, Hub, WorldShot) rufen nur Funktionen auf.
--
-- PERFORMANCE-REGELN fuer alles, was hier entsteht:
--   * Anchored, ohne Kollision, Query, Touch und Schatten.
--   * Keine Light-Instanzen: Leuchten ueber Neon + Bloom.
--   * Distanz-Gruppen werden zweimal pro Sekunde geprueft (nicht pro Frame)
--     und mit Hysterese ein- und ausgehaengt (Parent), damit nichts flackert.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local WorldFXConfig  = require(ReplicatedStorage.Config.WorldFXConfig)

local WorldFXKit = {}

--------------------------------------------------------------------------------
-- Qualitaet
--------------------------------------------------------------------------------

-- 1 = hoch, 0 = niedrig. Wie AmbienceController: Grafikstufe des Spielers,
-- "Automatisch" zaehlt als hoch. Einmal beim Start gelesen.
local _quality: number? = nil

function WorldFXKit.quality(): number
	local cached = _quality
	if cached then
		return cached
	end
	local ok, level = pcall(function()
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel.Value
	end)
	local q = if not ok or level == 0 or level >= AmbienceConfig.HIGH_QUALITY_FROM then 1 else 0
	_quality = q
	return q
end

-- Laeuft die Funktion `name` (WorldFXConfig.MIN_QUALITY) auf diesem Geraet?
function WorldFXKit.enabled(name: string): boolean
	local need = (WorldFXConfig.MIN_QUALITY :: any)[name]
	if need == nil then
		warn("[WorldFXKit] unbekannte Funktion in MIN_QUALITY:", name)
		return false
	end
	return WorldFXKit.quality() >= need
end

--------------------------------------------------------------------------------
-- Texturen
--------------------------------------------------------------------------------

-- Hochgeladene ID oder nil.
function WorldFXKit.textureId(name: string): string?
	local id = WorldFXConfig.TEXTURE_IDS[name]
	if id and id ~= "" then
		return id
	end
	return nil
end

-- Bild fuer einen Partikel-Emitter: hochgeladen, sonst eingebauter Rueckfall,
-- sonst nil. Zweiter Wert: ob es das (2x2-)Flipbook ist.
function WorldFXKit.particleTexture(name: string): (string?, boolean)
	local id = WorldFXKit.textureId(name)
	if id then
		return id, WorldFXConfig.FLIPBOOKS[name] == true
	end
	return WorldFXConfig.TEXTURE_FALLBACK[name], false
end

-- Setzt Bild (und ggf. Flipbook-Layout) eines Emitters. Gibt false zurueck,
-- wenn es weder Bild noch Rueckfall gibt (Aufrufer laesst den Effekt weg).
function WorldFXKit.applyParticleTexture(emitter: ParticleEmitter, name: string): boolean
	local image, flipbook = WorldFXKit.particleTexture(name)
	if not image then
		return false
	end
	emitter.Texture = image
	if flipbook then
		emitter.FlipbookLayout = Enum.ParticleFlipbookLayout.Grid2x2
		emitter.FlipbookMode   = Enum.ParticleFlipbookMode.Loop
		emitter.FlipbookFramerate = NumberRange.new(8, 10)
		emitter.FlipbookStartRandom = true
	end
	return true
end

--------------------------------------------------------------------------------
-- Deko-Teile
--------------------------------------------------------------------------------

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))
WorldFXKit.UPRIGHT = UPRIGHT

function WorldFXKit.part(
	name: string,
	parent: Instance?,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local part = Instance.new("Part")
	part.Name          = name
	part.Anchored      = true
	part.CanCollide    = false
	part.CanQuery      = false
	part.CanTouch      = false
	part.CastShadow    = false
	part.Size          = size
	part.CFrame        = cframe
	part.Color         = color
	part.Material      = material or Enum.Material.SmoothPlastic
	part.Shape         = shape or Enum.PartType.Block
	part.TopSurface    = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent        = parent
	return part
end

-- Senkrechter Zylinder: Fuss bei `base`, Hoehe `height`.
function WorldFXKit.pole(name: string, parent: Instance?, base: Vector3, height: number, diameter: number, color: Color3, material: Enum.Material?): Part
	return WorldFXKit.part(name, parent, Vector3.new(height, diameter, diameter),
		CFrame.new(base + Vector3.new(0, height * 0.5, 0)) * UPRIGHT, color, material, Enum.PartType.Cylinder)
end

function WorldFXKit.ball(name: string, parent: Instance?, diameter: number, position: Vector3, color: Color3, material: Enum.Material?): Part
	return WorldFXKit.part(name, parent, Vector3.one * diameter, CFrame.new(position), color, material, Enum.PartType.Ball)
end

-- Laenglicher Koerper (Fisch, Biene, Wespe): Block mit Kugel-Mesh. Ein Ball-
-- Teil wird von Roblox auf gleiche Achsen gezwungen, das Mesh nicht.
function WorldFXKit.ellipsoid(name: string, parent: Instance?, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local part = WorldFXKit.part(name, parent, size, cframe, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

-- Unsichtbarer Anker fuer einen Emitter (Box-Form, Groesse = Spawn-Volumen).
function WorldFXKit.anchor(name: string, parent: Instance?, size: Vector3, position: Vector3): Part
	local part = WorldFXKit.part(name, parent, size, CFrame.new(position), Color3.new(1, 1, 1))
	part.Transparency = 1
	return part
end

function WorldFXKit.folder(name: string, parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

-- Gemeinsamer Wurzelordner aller Welt-Effekte (lokal, wird nie repliziert).
local _root: Folder? = nil
function WorldFXKit.root(): Folder
	local root = _root
	if root and root.Parent then
		return root
	end
	local created = WorldFXKit.folder("WorldFX_Local", workspace)
	_root = created
	return created
end

--------------------------------------------------------------------------------
-- Distanz-Abschaltung
--------------------------------------------------------------------------------
-- Eine Gruppe ist ein Container (Folder/Model) mit Mittelpunkt und
-- Sichtweite. Ist die Kamera weiter weg als `distance`, wird der Container
-- aus der Welt genommen (Parent = nil); naeher als 90 % davon kommt er
-- zurueck. `onChange(visible)` erlaubt dem Controller, seinen Takt fuer die
-- Gruppe auszusetzen.

type Group = { container: Instance, parent: Instance, center: Vector3, distance: number, visible: boolean, onChange: ((boolean) -> ())? }

local _groups: { Group } = {}
local _cullStarted = false
local CULL_TICK = 0.5
local HYSTERESIS = 0.9

local function cullOnce()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local eye = camera.CFrame.Position
	for _, group in _groups do
		local d = (group.center - eye).Magnitude
		local want = if group.visible then d <= group.distance else d <= group.distance * HYSTERESIS
		if want ~= group.visible then
			group.visible = want
			group.container.Parent = if want then group.parent else nil
			local cb = group.onChange
			if cb then
				task.spawn(cb, want)
			end
		end
	end
end

-- Meldet eine Gruppe an. Rueckgabe: Funktion zum Abmelden (der Container wird
-- dabei NICHT zerstoert, das macht der Aufrufer).
function WorldFXKit.cullGroup(container: Instance, center: Vector3, distance: number, onChange: ((boolean) -> ())?): () -> ()
	local group: Group = {
		container = container,
		parent = container.Parent or WorldFXKit.root(),
		center = center,
		distance = distance,
		visible = true,
		onChange = onChange,
	}
	table.insert(_groups, group)

	if not _cullStarted then
		_cullStarted = true
		local acc = 0
		RunService.Heartbeat:Connect(function(dt: number)
			acc += dt
			if acc >= CULL_TICK then
				acc = 0
				cullOnce()
			end
		end)
	end
	cullOnce()

	return function()
		local index = table.find(_groups, group)
		if index then
			table.remove(_groups, index)
		end
	end
end

-- Ist die Gruppe des Containers gerade sichtbar? (Fuer Takte, die sparen wollen.)
function WorldFXKit.isShown(container: Instance): boolean
	return container.Parent ~= nil
end

--------------------------------------------------------------------------------
-- Debug-Signale (nur Studio)
--------------------------------------------------------------------------------
-- DebugService setzt Attribute an workspace (repliziert an alle Test-Clients).
-- Name → Rueckruf bei jeder Aenderung, mit dem aktuellen Wert.
-- `isState` = true: ein schon gesetzter Wert gilt auch fuer einen spaeter
-- beitretenden Test-Client (Zustaende wie "daytime"). false: nur ein
-- Ausloeser (Fisch, Ankunft, Kamera), ein alter Wert wird beim Start ignoriert.

function WorldFXKit.onDebug(attribute: string, callback: (any) -> (), isState: boolean?)
	if not RunService:IsStudio() then
		return
	end
	workspace:GetAttributeChangedSignal(attribute):Connect(function()
		callback(workspace:GetAttribute(attribute))
	end)
	local current = workspace:GetAttribute(attribute)
	if current ~= nil and isState ~= false then
		task.defer(callback, current)
	end
end

--------------------------------------------------------------------------------
-- Mathe
--------------------------------------------------------------------------------

function WorldFXKit.lerpColor(a: Color3, b: Color3, t: number): Color3
	return a:Lerp(b, math.clamp(t, 0, 1))
end

return WorldFXKit
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX89"><Properties>
<string name="Name">WorldMomentController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldMomentController.luau
-- StarterPlayerScripts/Controllers/WorldMomentController.luau
--
-- Einzige Zustaendigkeit:
--   - Grosse Momente sichtbar machen, die der ganze Server sieht (Paket G,
--     "Welt aufwerten"): Lichtsaeule (+ Funkenring) beim seltenen Baerchi,
--     Feuerwerk beim neuen Tower, Jubel beim Rekord, Lichtwelle beim Rebirth,
--     Funkenspirale bei seltener Mutation, und am Honigmast den Event-Start
--
-- Woher: Remotes.WorldMoment (WorldMomentService erkennt die Momente aus dem
-- Spielstand). Der Event-Start kommt vom Client selbst (HubEventController
-- sieht den Pit-Ring umschalten). Der Boss-Himmel ist schon da
-- (EventFXController.setBossSky), das Nest pulsiert (HubEventController).
--
-- Regeln (Leitbild):
--   * Hoechstens EIN grosser Moment gleichzeitig; weitere warten in einer
--     kurzen Schlange (Modules/WorldMoments.Queue), kleine laufen sofort.
--   * Momente anderer Spieler verdecken nie die eigene Sicht: kein
--     Vollbild-Blitz, kein Farbfilter, nichts vor der Kamera. Sie liegen
--     ueber der Insel des Spielers in der Welt.
--   * "Momente anderer Spieler": on | small | off (WorldFXConfig.MOMENTS).
--
-- PERFORMANCE: alle Teile aus festen Pools, ein Takt (30 Hz) nur waehrend
-- ein Effekt laeuft. Keine Lichter, kein Emitter.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local TowerConfig   = require(ReplicatedStorage.Config.TowerConfig)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)
local WorldMoments  = require(ReplicatedStorage.Modules.WorldMoments)
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)

local WorldFXKit            = require(script.Parent.WorldFXKit)
local DayCycleController    = require(script.Parent.DayCycleController)
local ArenaLifeController   = require(script.Parent.ArenaLifeController)
local PlotLifeController    = require(script.Parent.PlotLifeController)
local LifeController        = require(script.Parent.LifeController)
local HubLandmarkController = require(script.Parent.HubLandmarkController)
local SoundscapeController  = require(script.Parent.SoundscapeController)

local WorldMomentController = {}

local localPlayer = Players.LocalPlayer
local UPRIGHT = WorldFXKit.UPRIGHT
local TICK = 1 / 30
local TAU = math.pi * 2

type Payload = { userId: number, kind: string, value: string, number: number?, big: boolean }
-- Ein laufender Effekt: step(t 0..1) bis fertig, dann done()
type Effect = { start: number, duration: number, step: (number) -> (), done: () -> () }

local _folder: Folder? = nil
local _effects: { Effect } = {}
local _queue = WorldMoments.newQueue()
local _pending: { [number]: Payload } = {}
local _nextId = 0

-- Pools
local _column: BasePart? = nil
local _sparks: { BasePart } = {}
local _wave: BasePart? = nil
local _line: TextLabel? = nil
local _lineUntil = 0

--------------------------------------------------------------------------------
-- Pools
--------------------------------------------------------------------------------

local SPARK_POOL = 48

local function buildPools()
	_column = WorldFXKit.part("MomentColumn", nil, Vector3.new(1, 1, 1), CFrame.new(), Color3.new(1, 1, 1),
		Enum.Material.Neon, Enum.PartType.Cylinder)
	_wave = WorldFXKit.part("MomentWave", nil, Vector3.new(0.1, 1, 1), CFrame.new(), Color3.fromRGB(255, 226, 150),
		Enum.Material.Neon, Enum.PartType.Cylinder)
	for _ = 1, SPARK_POOL do
		table.insert(_sparks, WorldFXKit.ball("Spark", nil, 0.7, Vector3.zero, Color3.new(1, 1, 1), Enum.Material.Neon))
	end
end

-- `n` freie Funken (Parent nil) holen; weniger, wenn der Pool leer ist.
local function takeSparks(n: number): { BasePart }
	local out = {}
	for _, spark in _sparks do
		if #out >= n then break end
		if spark.Parent == nil and not spark:GetAttribute("Busy") then
			spark:SetAttribute("Busy", true)
			table.insert(out, spark)
		end
	end
	return out
end

local function releaseSparks(list: { BasePart })
	for _, spark in list do
		spark.Parent = nil
		spark:SetAttribute("Busy", nil)
	end
end

local function run(duration: number, step: (number) -> (), done: () -> ())
	table.insert(_effects, { start = os.clock(), duration = duration, step = step, done = done })
end

--------------------------------------------------------------------------------
-- Orte
--------------------------------------------------------------------------------

local function slotOfUser(userId: number): number?
	for slot = 1, MapConfig.PLOT_COUNT do
		local plot = workspace:FindFirstChild("Plot_" .. slot)
		if plot and plot:GetAttribute("PlotOwner") == userId then return slot end
	end
	return nil
end

local function figurePosition(slot: number): Vector3?
	local plot = workspace:FindFirstChild("Plot_" .. slot)
	local figures = plot and plot:FindFirstChild("Baerchis")
	if figures then
		for _, child in figures:GetChildren() do
			if child:IsA("Model") then return child:GetPivot().Position end
			if child:IsA("BasePart") then return child.Position end
		end
	end
	return nil
end

local function nearCamera(position: Vector3): boolean
	local camera = workspace.CurrentCamera
	return camera ~= nil and (camera.CFrame.Position - position).Magnitude <= WorldFXConfig.MOMENTS.NEAR_DISTANCE
end

--------------------------------------------------------------------------------
-- Die Bilder
--------------------------------------------------------------------------------

-- Lichtsaeule ueber der Insel (Rarity-Farbe), ab RING_MIN zusaetzlich Funkenring
local function playHatch(slot: number, rarity: string, big: boolean)
	local cfg = WorldFXConfig.MOMENTS
	local folder = _folder :: Folder
	local center = MapLayout.plotCenter(slot)
	local color = BaerchiConfig.RARITY_COLORS[rarity :: any] or Color3.new(1, 1, 1)
	local height = cfg.COLUMN_HEIGHT * (if big then 1 else 0.5)
	local duration = if big then cfg.DURATION.hatch else 1.2

	local column = _column
	if column and column.Parent == nil then   -- belegt (kleiner Moment parallel): nur Ring
		column.Color = color
		column.Parent = folder
		run(duration, function(t)
			local h = height * math.min(1, t * 3)
			local w = cfg.COLUMN_WIDTH * (1 - 0.4 * t)
			column.Size = Vector3.new(h, w, w)
			column.CFrame = CFrame.new(center + Vector3.new(0, h * 0.5, 0)) * UPRIGHT
			column.Transparency = 0.35 + 0.65 * t * t
		end, function()
			column.Parent = nil
		end)
	end

	local ringFrom = WorldMoments.rarityIndex(cfg.RING_MIN_RARITY)
	if big and WorldMoments.rarityIndex(rarity) >= ringFrom and WorldFXKit.enabled("momentRing") then
		local sparks = takeSparks(cfg.RING_SPARKS)
		for _, s in sparks do s.Color = color; s.Parent = folder end
		run(duration, function(t)
			local r = 6 + 26 * math.sin(t * math.pi * 0.5)
			for i, s in sparks do
				local a = i / #sparks * TAU + t * 1.5
				s.Position = center + Vector3.new(math.cos(a) * r, cfg.RING_HEIGHT + 4 * t, math.sin(a) * r)
				s.Transparency = t * t
			end
		end, function() releaseSparks(sparks) end)
	end
end

-- Feuerwerk vom Schau-Turm in der Farbe des neuen Towers
local function playTower(slot: number, towerId: string, big: boolean)
	local cfg = WorldFXConfig.MOMENTS
	local folder = _folder :: Folder
	local def = TowerConfig.get(towerId)
	local color = if def then def.color else Color3.fromRGB(255, 214, 110)
	local foot = MapLayout.showcaseFoot(slot) + Vector3.new(0, 12, 0)
	local rockets = if big then cfg.FIREWORK_ROCKETS else 1
	for r = 1, rockets do
		local delay = (r - 1) * 0.35
		local offset = Vector3.new(math.cos(r * 2.1) * 4, 0, math.sin(r * 2.1) * 4)
		local burst = foot + offset + Vector3.new(0, 22 + r * 3, 0)
		task.delay(delay, function()
			local rocket = takeSparks(1)
			local sparks = takeSparks(cfg.FIREWORK_SPARKS)
			for _, s in rocket do s.Color = Color3.fromRGB(255, 240, 200); s.Parent = folder end
			run(1.9, function(t)
				if t < 0.4 then
					local k = t / 0.4
					for _, s in rocket do s.Position = (foot + offset):Lerp(burst, 1 - (1 - k) * (1 - k)) end
				else
					for _, s in rocket do s.Parent = nil end
					local k = (t - 0.4) / 0.6
					for i, s in sparks do
						s.Color = color
						s.Parent = folder
						local a = i / #sparks * TAU
						local up = math.cos(i * 1.7) * 0.6
						local dir = Vector3.new(math.cos(a), up, math.sin(a))
						s.Position = burst + dir * (9 * math.sin(k * math.pi * 0.5)) - Vector3.new(0, 4 * k * k, 0)
						s.Transparency = k
					end
				end
			end, function()
				releaseSparks(rocket)
				releaseSparks(sparks)
			end)
		end)
	end
end

-- Weiche Lichtwelle ueber die Insel, Blumen wiegen sich
local function playRebirth(slot: number, big: boolean)
	local cfg = WorldFXConfig.MOMENTS
	local folder = _folder :: Folder
	local center = MapLayout.plotCenter(slot)
	local wave = _wave
	if wave and not wave.Parent then
		wave.Parent = folder
		local maxR = cfg.WAVE_RADIUS * (if big then 1 else 0.6)
		run(if big then cfg.DURATION.rebirth else 1.2, function(t)
			local r = 2 + maxR * t
			wave.Size = Vector3.new(0.1, r * 2, r * 2)
			wave.CFrame = CFrame.new(center.X, MapConfig.PLATFORM_TOP_Y + MapConfig.PLOT_SIZE.Y + 0.08, center.Z) * UPRIGHT
			wave.Transparency = 0.55 + 0.45 * t
		end, function() wave.Parent = nil end)
	end
	PlotLifeController.gust(slot)
end

-- Funkenspirale um den Baerchi (nur in der Naehe)
local function playMutation(slot: number, mutation: string, big: boolean)
	local cfg = WorldFXConfig.MOMENTS
	local at = figurePosition(slot)
	if not at or not nearCamera(at) then return end
	local folder = _folder :: Folder
	local def = (BaerchiConfig.MUTATIONS :: any)[mutation]
	local color = if def then def.color else Color3.new(1, 1, 1)
	local sparks = takeSparks(if big then cfg.SPIRAL_SPARKS else math.ceil(cfg.SPIRAL_SPARKS / 2))
	for _, s in sparks do s.Color = color; s.Parent = folder end
	run(cfg.DURATION.mutation, function(t)
		for i, s in sparks do
			local k = math.clamp(t * 1.4 - i / #sparks * 0.4, 0, 1)
			local a = k * TAU * 2 + i / #sparks * TAU
			local r = 3 - 1.5 * k
			s.Position = at + Vector3.new(math.cos(a) * r, 0.5 + k * 6, math.sin(a) * r)
			s.Transparency = k * k
		end
	end, function() releaseSparks(sparks) end)
end

-- Zeile unten fuer die anderen Spieler ("<Name> hat einen <Rarity>-Baerchi!")
local function showLine(userId: number, rarity: string)
	local label = _line
	if not label then return end
	local player = Players:GetPlayerByUserId(userId)
	label.Text = Loc.t("world.moment.hatch", {
		name = if player then player.DisplayName else "?",
		rarity = Loc.msg("rarity." .. rarity),
	})
	label.TextColor3 = BaerchiConfig.RARITY_COLORS[rarity :: any] or Color3.new(1, 1, 1)
	label.Visible = true
	_lineUntil = os.clock() + WorldFXConfig.MOMENTS.LINE_SECONDS
end

local function play(payload: Payload, big: boolean)
	local slot = slotOfUser(payload.userId)
	if not slot then return end
	local kind = payload.kind
	if kind == "hatch" then
		playHatch(slot, payload.value, big)
	elseif kind == "tower" then
		playTower(slot, payload.value, big)
	elseif kind == "record" then
		ArenaLifeController.celebrate(payload.userId)
	elseif kind == "rebirth" then
		playRebirth(slot, big)
	elseif kind == "mutation" then
		playMutation(slot, payload.value, big)
	end
end

--------------------------------------------------------------------------------
-- Eingang
--------------------------------------------------------------------------------

local function onMoment(raw: any)
	if typeof(raw) ~= "table" or typeof(raw.userId) ~= "number" or typeof(raw.kind) ~= "string" then return end
	local payload: Payload = {
		userId = raw.userId,
		kind = raw.kind,
		value = tostring(raw.value or ""),
		number = if typeof(raw.number) == "number" then raw.number else nil,
		big = raw.big == true,
	}
	local isSelf = payload.userId == localPlayer.UserId
	if not isSelf then
		local mode = WorldFXConfig.MOMENTS.OTHERS_DEFAULT
		if mode == "off" then return end
		if mode == "small" then payload.big = false end
		if payload.kind == "hatch" then showLine(payload.userId, payload.value) end
	end

	_nextId += 1
	local entry = { id = _nextId, kind = payload.kind, big = payload.big, at = os.clock() }
	if WorldMoments.push(_queue, entry) then
		play(payload, entry.big)
	else
		_pending[entry.id] = payload
	end
end

-- Event startet: Glocke (Krone blinkt zweimal), Bienen ziehen zum Event-Pit.
-- Aufrufer: HubEventController beim Wechsel auf "live".
function WorldMomentController.eventStarted()
	if not (FeatureFlags.isOn("WORLD_G_MOMENTS") and WorldFXKit.enabled("eventBell")) then return end
	HubLandmarkController.flashCrown()
	SoundscapeController.bell()   -- leise, einmal (still ohne gepruefte ID)
	LifeController.rally(MapConfig.CENTER + Vector3.new(0, MapConfig.PLATFORM_TOP_Y, 0), 10)
end

function WorldMomentController.init()
	if not (FeatureFlags.isOn("WORLD_G_MOMENTS") and WorldFXKit.enabled("moments")) then return end
	local folder = WorldFXKit.folder("Moments", WorldFXKit.root())
	_folder = folder
	buildPools()

	-- Die Zeile unten (eigene kleine Oberflaeche, ueber nichts drueber)
	local gui = Instance.new("ScreenGui")
	gui.Name = "WorldMomentLine"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 1
	gui.Parent = localPlayer:WaitForChild("PlayerGui")
	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.Position = UDim2.new(0.5, 0, 1, -96)
	label.Size = UDim2.fromOffset(520, 28)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextStrokeTransparency = 0.4
	label.Visible = false
	label.Parent = gui
	_line = label

	Remotes.WorldMoment.OnClientEvent:Connect(onMoment)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < TICK then return end
		acc = 0
		local now = os.clock()

		-- naechster grosser Moment, sobald die Buehne frei ist — nicht waehrend
		-- die eigene Faehigkeiten-Show laeuft (wer zu lange wartet, kommt klein)
		local entry = if DayCycleController.showActive() and #_queue.waiting > 0
			and now - _queue.waiting[1].at <= WorldFXConfig.MOMENTS.MAX_WAIT
			then nil else WorldMoments.pop(_queue, now)
		if entry then
			local payload = _pending[entry.id]
			_pending[entry.id] = nil
			if payload then play(payload, entry.big) end
		end

		-- laufende Effekte
		for i = #_effects, 1, -1 do
			local e = _effects[i]
			local t = (now - e.start) / e.duration
			if t >= 1 then
				table.remove(_effects, i)
				e.done()
			else
				e.step(t)
			end
		end

		if label.Visible and now > _lineUntil then
			label.Visible = false
		end
	end)

	print("[WorldMoments] aktiv | andere Spieler:", WorldFXConfig.MOMENTS.OTHERS_DEFAULT)
end

return WorldMomentController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX90"><Properties>
<string name="Name">WorldShotController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldShotController.luau
-- StarterPlayerScripts/Controllers/WorldShotController.luau
--
-- Einzige Zustaendigkeit:
--   - Die sechs festen Kamerapunkte fuer Vorher-/Nachher-Screenshots
--     (Paket 0, "Welt aufwerten") anfahren und wieder freigeben
--
-- NUR IN STUDIO. Ausgeloest ueber den Debug-Befehl "worldshots"
-- (DebugService setzt workspace-Attribut "DebugWorldShot" = "<n>|<zaehler>").
-- n = 1..6: Kamera fest auf Punkt n, UI aus (saubere Bilder). n = 0: zurueck.
--
-- Die Punkte werden aus MapConfig/MapLayout GERECHNET, nicht als feste
-- Koordinaten gespeichert: wandert eine Insel, wandert der Bildpunkt mit, und
-- "vorher" und "nachher" zeigen trotzdem dieselbe Stelle der Welt.
-- Slot 1 = Plot bei 0 Grad (+X).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit = require(script.Parent.WorldFXKit)

local WorldShotController = {}

local localPlayer = Players.LocalPlayer

-- Wie MapParts.buildPlotCFrame (Server): Plot schaut zur Weltmitte.
local function plotCFrame(slot: number): CFrame
	local p = MapLayout.plotCenter(slot)
	return CFrame.lookAt(p, Vector3.new(MapConfig.CENTER.X, p.Y, MapConfig.CENTER.Z))
end

-- Die sechs Punkte: { Augenpunkt, Blickziel }.
function WorldShotController.shots(): { { eye: Vector3, target: Vector3 } }
	local slot = 1
	local plot = plotCFrame(slot)
	local surface = MapConfig.PLATFORM_TOP_Y + MapConfig.PLOT_SIZE.Y
	local mastTop = MapConfig.CENTER + Vector3.new(0, MapConfig.PLATFORM_TOP_Y + 30, 0)
	local outward = MapLayout.outward(slot)
	local pit = MapLayout.pitCenter(slot)
	local islandEdge = MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS

	-- 1 Spawn → Honigmast (Augenhoehe ueber dem Spawn-Punkt)
	local spawn = plot * CFrame.new(MapConfig.PLAYER_SPAWN_OFFSET.X, 0, MapConfig.PLAYER_SPAWN_OFFSET.Z)
	local eye1 = spawn.Position + Vector3.new(0, surface + 5, 0)

	-- 2 Hauptinsel schraeg von oben (ganze Insel im Bild)
	local eye2 = MapConfig.CENTER + Vector3.new(-150, 150, -150)

	-- 3 Plot-Insel aus Spielerhoehe: hinter dem Baerchi-Platz, Blick auf den Brunnen
	local pond = plot * CFrame.new(MapLayout.pondOffset())
	local facing = plot:VectorToWorldSpace(MapLayout.pondFacing())
	local eye3 = pond.Position + facing * 22 + Vector3.new(0, surface + 5.5, 0)
	local target3 = pond.Position + Vector3.new(0, surface + 1.5, 0)

	-- 4 Auf dem Steg zur Arena, Blick auf die Arena
	local eye4 = MapConfig.CENTER + outward * (islandEdge + 4) + Vector3.new(0, MapConfig.PLATFORM_TOP_Y + 5.5, 0)
	local target4 = pit + Vector3.new(0, 4, 0)

	-- 5 Arena mit Turm (seitlich, erhoeht)
	local side = MapLayout.side(slot)
	local eye5 = pit - outward * 30 + side * 45 + Vector3.new(0, 32, 0)
	local target5 = pit + Vector3.new(0, 22, 0)

	-- 6 Vom Rand der Welt zum Horizont (zwischen zwei Stegen)
	local edge = MapLayout.atAngle(22.5, MapConfig.WATER_RADIUS - 60)
	local eye6 = edge + Vector3.new(0, 7, 0)
	local target6 = MapLayout.atAngle(22.5, AmbienceConfig.FAR_ISLAND_RING) + Vector3.new(0, 70, 0)

	return {
		{ eye = eye1, target = mastTop },
		{ eye = eye2, target = MapConfig.CENTER + Vector3.new(0, 4, 0) },
		{ eye = eye3, target = target3 },
		{ eye = eye4, target = target4 },
		{ eye = eye5, target = target5 },
		{ eye = eye6, target = target6 },
	}
end

local _savedFov: number? = nil
local _hiddenGuis: { ScreenGui } = {}

local function release()
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
		local fov = _savedFov
		if fov then camera.FieldOfView = fov end
	end
	_savedFov = nil
	for _, gui in _hiddenGuis do
		gui.Enabled = true
	end
	table.clear(_hiddenGuis)
end

local function show(index: number)
	local camera = workspace.CurrentCamera
	local shot = WorldShotController.shots()[index]
	local meta = WorldFXConfig.WORLD_SHOTS[index]
	if not (camera and shot and meta) then return end

	if not _savedFov then
		_savedFov = camera.FieldOfView
	end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(shot.eye, shot.target)
	camera.FieldOfView = meta.fov

	-- UI aus fuer saubere Bilder
	if #_hiddenGuis == 0 then
		for _, gui in localPlayer:WaitForChild("PlayerGui"):GetChildren() do
			if gui:IsA("ScreenGui") and gui.Enabled then
				gui.Enabled = false
				table.insert(_hiddenGuis, gui)
			end
		end
	end
	print(string.format("[WorldShot] %s | jetzt Screenshot machen, zurueck mit worldshots 0", meta.name))
end

function WorldShotController.init()
	WorldFXKit.onDebug("DebugWorldShot", function(value: any)
		if typeof(value) ~= "string" then return end
		local n = tonumber(string.match(value, "^(%d+)")) or 0
		if n >= 1 and n <= #WorldFXConfig.WORLD_SHOTS then
			show(n)
		else
			release()
		end
	end, false)
end

return WorldShotController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX91"><Properties>
<string name="Name">ZoneLightController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- ZoneLightController.luau
-- StarterPlayerScripts/Controllers/ZoneLightController.luau
--
-- Einzige Zustaendigkeit:
--   - Licht-Feinschliff nach Ort (Paket I, "Welt aufwerten"): auf der Insel
--     wie bisher; auf dem Steg zur Arena und in der Arena etwas mehr
--     Kontrast und Saettigung; hoch oben auf dem Turm (ab Etage 30) klarere
--     Luft und weiterer Horizont
--
-- Wie es wirkt:
--   * Ein EIGENER Farbfilter "ZoneGrade" (nur Kontrast/Saettigung/eine Spur
--     Helligkeit, keine Farbe). Filter stapeln sich in Roblox: der Show-Filter
--     "SkillFX_Sky" und der Boss-Himmel faerben weiter wie bisher, ZoneGrade
--     ueberschreibt nichts und wird von nichts ueberschrieben.
--   * Die Atmosphaere fuehrt der Tageslauf; hier kommen nur Faktoren auf
--     Dichte und Dunst dazu (DayCycleController.setAtmosphereScale). Ist der
--     Tageslauf aus, setzt dieser Controller die festen Werte mal Faktor selbst.
--   * Uebergaenge ueber BLEND_SECONDS (1,5 s), nur Client.
--   * Bewusst KEINE Tiefenunschaerfe (DepthOfField) und keine anderen teuren
--     Effekte — auch nicht fuer PC.

local Lighting          = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local MapConfig      = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig  = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout      = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)

local ZoneLightController = {}

-- 0..1: wie sehr die Kamera "in der Arena" ist (Arena-Insel oder aeusserer
-- Steg), mit weicher Kante.
local function arenaWeight(p: Vector3): number
	local cfg = WorldFXConfig.ZONE_LIGHT
	local best = 0
	local islandEdge = MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS
	for slot = 1, MapConfig.PLOT_COUNT do
		local pit = MapLayout.pitCenter(slot)
		local d = math.sqrt((p.X - pit.X) ^ 2 + (p.Z - pit.Z) ^ 2)
		best = math.max(best, math.clamp((cfg.ARENA_RADIUS - d) / 15, 0, 1))
		-- aeusserer Steg: entlang der Steg-Achse zwischen Plot-Insel und Arena
		local o = MapLayout.outward(slot)
		local along = (p.X - MapConfig.CENTER.X) * o.X + (p.Z - MapConfig.CENTER.Z) * o.Z
		local across = math.abs((p.X - MapConfig.CENTER.X) * o.Z - (p.Z - MapConfig.CENTER.Z) * o.X)
		if along > islandEdge - 4 and along < islandEdge + MapConfig.ISLAND_GAP + 4 then
			best = math.max(best, math.clamp((MapConfig.BRIDGE_WIDTH - across) / 6, 0, 1))
		end
	end
	return best
end

local function highWeight(p: Vector3): number
	local cfg = WorldFXConfig.ZONE_LIGHT
	local y = p.Y - MapConfig.PLATFORM_TOP_Y
	return math.clamp((y - cfg.HIGH_FROM) / (cfg.HIGH_FULL - cfg.HIGH_FROM), 0, 1)
end

function ZoneLightController.init()
	if not (FeatureFlags.isOn("WORLD_I_ZONES") and WorldFXKit.enabled("zoneLight")) then return end
	local cfg = WorldFXConfig.ZONE_LIGHT

	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "ZoneGrade"
	grade.Parent = Lighting

	local arena, high = 0, 0
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < cfg.TICK then return end
		local step = acc
		acc = 0
		local camera = workspace.CurrentCamera
		if not camera then return end
		local p = camera.CFrame.Position

		-- weich zum Ziel (exponentiell, ~BLEND_SECONDS)
		local k = math.clamp(step / cfg.BLEND_SECONDS * 2.5, 0, 1)
		arena += (arenaWeight(p) - arena) * k
		high += (highWeight(p) - high) * k

		local island, ar = cfg.island, cfg.arena
		grade.Saturation = island.saturation + (ar.saturation - island.saturation) * arena
		grade.Contrast   = island.contrast + (ar.contrast - island.contrast) * arena
		grade.Brightness = island.brightness + (ar.brightness - island.brightness) * arena

		local density = 1 + (cfg.HIGH_DENSITY - 1) * high
		local haze = 1 + (cfg.HIGH_HAZE - 1) * high
		if not DayCycleController.setAtmosphereScale(density, haze) then
			-- Tageslauf aus: feste Werte mal Faktor
			local atm = Lighting:FindFirstChild("BaerchiAtmosphere")
			if atm and atm:IsA("Atmosphere") then
				atm.Density = AmbienceConfig.ATMOSPHERE_DENSITY * density
				atm.Haze    = AmbienceConfig.ATMOSPHERE_HAZE * haze
			end
		end
	end)

	print("[ZoneLight] aktiv")
end

return ZoneLightController
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="LocalScript" referent="RBX92"><Properties>
<string name="Name">Main</string>
<bool name="Disabled">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Main.client.luau
-- StarterPlayerScripts/Main.client.luau
--
-- Bootstrap des Clients — das Gegenstueck zu GameManager auf dem Server.
-- Einzige Stelle die die Startreihenfolge der Client-Module kennt.
--
-- ACHTUNG beim Umbenennen: die Datei darf NICHT "init.client.luau" heissen.
-- Rojo macht aus einem Ordner mit init-Datei ein Script statt eines
-- Containers — auf StarterPlayerScripts angewandt heisst das, dass der
-- gesamte Client-Teilbaum nie im Spiel ankommt. Genau das hat den
-- Server-Sync schon einmal lahmgelegt.
--
-- Reihenfolge:
--   1. ScreenGui anlegen — alle UI-Module haengen sich dort ein.
--   2. Toast zuerst, damit fruehe Fehlermeldungen schon sichtbar sind.
--   3. ClientState VOR den datengetriebenen UIs: die registrieren sich per
--      onChanged und bekommen den aktuellen Stand sofort nachgereicht.
--   4. Die Panels. Jedes meldet sich in seinem init beim PanelManager an —
--      erst danach duerfen Module laufen die Panels oeffnen wollen.
--   5. Hud und MenuBar: beide sind reine Ausloeser und brauchen die
--      angemeldeten Panels (Rebirth-Pille, Menue-Knoepfe).
--   6. ResultFeed — Toast-Meldungen fuer Recycling und Offline-Ertrag.
--      Muss vor dem ersten Serverpaket stehen, sonst geht der Offline-Report
--      des Joins verloren.
--   7. WorldController zuletzt — er braucht Panel und PanelManager.
--   8. EggTimerController — unabhaengig von allen anderen, braucht nur
--      ClientState (schon initialisiert) und die Figuren in der Welt.
--   9. SkillFXController (v14) — hoert nur auf Remotes.SkillFXPlay.
--
-- Davor, ganz am Anfang: LanguageController. Er legt die Sprache fest, bevor
-- irgendein Text gebaut wird (er braucht ClientState erst, wenn es dort
-- Daten gibt — onChanged meldet den aktuellen Stand sofort nach).

local Players = game:GetService("Players")

local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local root = script.Parent

local Controllers = root:WaitForChild("Controllers")
local UI          = root:WaitForChild("UI")

local ClientState        = require(Controllers:WaitForChild("ClientState"))
local LanguageController = require(Controllers:WaitForChild("LanguageController"))
local ResultFeed         = require(Controllers:WaitForChild("ResultFeed"))
local WorldController    = require(Controllers:WaitForChild("WorldController"))
local EggTimerController = require(Controllers:WaitForChild("EggTimerController"))
local SkillFXController  = require(Controllers:WaitForChild("SkillFXController"))
local CombController     = require(Controllers:WaitForChild("CombController"))
local AmbienceController = require(Controllers:WaitForChild("AmbienceController"))
-- Welt aufwerten (08.10.2026)
local DayCycleController    = require(Controllers:WaitForChild("DayCycleController"))
local WaterController       = require(Controllers:WaitForChild("WaterController"))
local HubLandmarkController = require(Controllers:WaitForChild("HubLandmarkController"))
local HubEventController    = require(Controllers:WaitForChild("HubEventController"))
local ArrivalController     = require(Controllers:WaitForChild("ArrivalController"))
local WorldShotController   = require(Controllers:WaitForChild("WorldShotController"))
local PlotLifeController    = require(Controllers:WaitForChild("PlotLifeController"))
local ArenaLifeController   = require(Controllers:WaitForChild("ArenaLifeController"))
local LifeController        = require(Controllers:WaitForChild("LifeController"))
local WorldMomentController = require(Controllers:WaitForChild("WorldMomentController"))
local SoundscapeController  = require(Controllers:WaitForChild("SoundscapeController"))
local ZoneLightController   = require(Controllers:WaitForChild("ZoneLightController"))
local EventFXController  = require(Controllers:WaitForChild("EventFXController"))
local LaidEggMeshController = require(Controllers:WaitForChild("LaidEggMeshController"))
local UiEventLogger      = require(Controllers:WaitForChild("UiEventLogger"))
local GuideController    = require(Controllers:WaitForChild("GuideController"))
local UpgradeHintController = require(Controllers:WaitForChild("UpgradeHintController"))

local Toast            = require(UI:WaitForChild("Toast"))
local UiScale          = require(UI:WaitForChild("UiScale"))
local ShopPanel        = require(UI:WaitForChild("ShopPanel"))
local Hud              = require(UI:WaitForChild("Hud"))
local MenuBar          = require(UI:WaitForChild("MenuBar"))
local BaerchiPanel     = require(UI:WaitForChild("BaerchiPanel"))
local BaerchiInventory = require(UI:WaitForChild("BaerchiInventory"))
local HatchPanel       = require(UI:WaitForChild("HatchPanel"))
local CombatPanel      = require(UI:WaitForChild("CombatPanel"))
local BuildingPanel    = require(UI:WaitForChild("BuildingPanel"))
local FusionPanel      = require(UI:WaitForChild("FusionPanel"))
local CharmPanel       = require(UI:WaitForChild("CharmPanel"))
local RebirthDialog    = require(UI:WaitForChild("RebirthDialog"))
local LanguagePanel    = require(UI:WaitForChild("LanguagePanel"))
local PetBar           = require(UI:WaitForChild("PetBar"))
local QuestPanel       = require(UI:WaitForChild("QuestPanel"))
local QuestTracker     = require(UI:WaitForChild("QuestTracker"))
local EggTreePanel     = require(UI:WaitForChild("EggTreePanel"))
local LeaderboardPanel = require(UI:WaitForChild("LeaderboardPanel"))
local ProfilePanel     = require(UI:WaitForChild("ProfilePanel"))
local DailyBonusPanel  = require(UI:WaitForChild("DailyBonusPanel"))
local Feedback         = require(UI:WaitForChild("Feedback"))
local Moment           = require(UI:WaitForChild("Moment"))
local ReturnSummary    = require(UI:WaitForChild("ReturnSummary"))
local HomeButton       = require(UI:WaitForChild("HomeButton"))

--------------------------------------------------------------------------------
-- Oberflaeche
--------------------------------------------------------------------------------

local screenGui = Instance.new("ScreenGui")
screenGui.Name             = "RBL"
screenGui.ResetOnSpawn     = false   -- ueberlebt den Tod des Charakters
screenGui.IgnoreGuiInset   = false   -- laesst Platz fuer die Roblox-Topbar
screenGui.ZIndexBehavior   = Enum.ZIndexBehavior.Sibling
screenGui.Parent           = playerGui

-- Playtest 05.10.: auf grossen Monitoren mitwachsen (siehe UI/UiScale)
UiScale.init(screenGui)

--------------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------------

-- Sprache ALLERERSTES: ab hier liefert Loc den Text in der Roblox-Sprache des
-- Spielers. Ohne das haetten Toast und alle Beschriftungen, die beim Aufbau
-- gesetzt werden, einen Moment lang die Standardsprache.
LanguageController.init()

Toast.init(screenGui)
ClientState.init()

BaerchiPanel.init(screenGui)
BaerchiInventory.init(screenGui)
HatchPanel.init(screenGui)
CombatPanel.init(screenGui)
BuildingPanel.init(screenGui)
FusionPanel.init(screenGui)
-- Nach BaerchiPanel: die Detailkarte oeffnet dieses Panel ueber den
-- PanelManager, es muss dafuer angemeldet sein. Die Reihenfolge der init-Aufrufe
-- entscheidet das zwar nicht (geoeffnet wird erst per Klick), aber die Liste
-- hier soll den Aufrufweg widerspiegeln.
CharmPanel.init(screenGui)
RebirthDialog.init(screenGui)
LanguagePanel.init(screenGui)
QuestPanel.init(screenGui)
-- v14: Ei-Baum (oeffnet sich aus dem Ei-Menue)
EggTreePanel.init(screenGui)
-- v15: Bestenliste, Spieler-Profil (Inspector) und Login-Bonus. Vor MenuBar,
-- damit die Menue-Kacheln die Panels schon angemeldet vorfinden.
LeaderboardPanel.init(screenGui)
ProfilePanel.init(screenGui)
DailyBonusPanel.init(screenGui)
ShopPanel.init(screenGui)          -- HBB Paket 10 (nur mit SHOP_V1)

Hud.init(screenGui)
MenuBar.init(screenGui)

-- HBB Paket 1: fliegende Icons, grosse Momente, Rueckkehr-Karte. Nach Hud
-- und MenuBar (Ziele der Icons), vor ResultFeed (der Offline-Bericht des
-- Joins kommt sonst an, bevor die Karte bereit ist).
Feedback.init(screenGui)
Moment.init(screenGui)
ReturnSummary.init(screenGui)
-- HBB Paket 5: Heim-Knopf (erscheint nur weit weg vom eigenen Plot)
HomeButton.init(screenGui)

-- v13: Quest-Karte links (braucht das Quest-Fenster, das oben angemeldet wird)
QuestTracker.init(screenGui)

-- v12: untere Pet-Leiste (Event / Fight), legt auch den PitResumeDialog an
PetBar.init(screenGui)

ResultFeed.init()
WorldController.init()
EggTimerController.init()
-- v14: Faehigkeiten-Show im PIT (unabhaengig von allem anderen)
SkillFXController.init()
-- v15: Waben im Event-Pit und Recycler (braucht Toast, ClientState und die Welt)
CombController.init(screenGui)
-- v16: Himmels-Kulisse (Wolken, Schwebeinseln, Pollen, Schaum) nur auf dem Client
AmbienceController.init()
-- Welt aufwerten: Tageslauf (Paket A) zuerst — Wasser und Hauptinsel melden
-- ihre leuchtenden Teile bei ihm an. Danach Wasser (B), Hauptinsel (C),
-- Ankunft (C) und die festen Kamerapunkte (Paket 0, nur Studio).
DayCycleController.init()
WaterController.init()
HubLandmarkController.init()
HubEventController.init()
ArrivalController.init()
-- Paket D (Plot-Inseln) vor F: die Bienen fragen nach der eigenen Insel.
PlotLifeController.init()
-- Paket G: Welt-Momente (nutzt Arena-, Insel-, Leben- und Wahrzeichen-Controller)
WorldMomentController.init()
-- Paket H: Klang-Kulisse (still, bis gepruefte Sound-IDs eingetragen sind)
SoundscapeController.init()
-- Paket I: Licht nach Zonen (nach dem Tageslauf: setzt dessen Atmosphaeren-Faktoren)
ZoneLightController.init()
ArenaLifeController.init()
LifeController.init()
WorldShotController.init()
-- v17: lebendige Events (UFO-Patrouille, Abwuerfe, Boss, Telegraphen); braucht Toast
EventFXController.init()
-- v18: Ei-Mesh der gelegten Eier (EditableMesh gibt es nur auf dem Client)
LaidEggMeshController.init()
-- HBB Paket 0: Messpunkte der Oberflaeche (Panel auf/zu, Stillstand)
UiEventLogger.init()
-- HBB Paket 2: Fuehrung ohne Text (braucht MenuBar und PetBar als Anker)
GuideController.init(screenGui)
-- HBB Paket 3: ⬆ ueber bezahlbaren eigenen Gebaeuden
UpgradeHintController.init()

print("[Client] Bereit")
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX93"><Properties>
<string name="Name">UI</string>
</Properties>
<Item class="ModuleScript" referent="RBX94"><Properties>
<string name="Name">BaerchiInventory</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- BaerchiInventory.luau
-- StarterPlayerScripts/UI/BaerchiInventory.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Baerchis des Spielers als scrollbare Liste zeigen
--   - Die Zwei-Slot-Auswahl fuer die Fusion verwalten
--   - Die zwei Reiter: "Meine Baerchis" (diese Liste) und "Index" (IndexView)
--
-- Die Liste kommt fertig sortiert aus ClientState.getBaerchiList()
-- (Rarity absteigend, dann Level) — hier wird nichts nachsortiert.
--
-- Die Fusions-Auswahl ist der einzige Zustand den dieses Modul selbst haelt.
-- Das ist erlaubt: welche zwei Zeilen gerade markiert sind, ist eine reine
-- Bedien-Information und kein Spielstand — sie steht in keinem Save und der
-- Server erfaehrt davon erst beim Bestaetigen in FusionPanel.
--
-- Neu aufgebaut wird die Liste nur wenn das Panel sichtbar ist. Kommt ein
-- Update waehrend es zu ist, wird nur ein Merker gesetzt und beim naechsten
-- Oeffnen nachgeholt — sonst baut jede Kampfrunde 25 Zeilen neu.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Unlock       = require(script.Parent.Unlock)   -- HBB Paket 3
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombatRating = require(ReplicatedStorage.Modules.CombatRating)

-- HBB Paket 4: "⚔ 1,2K" statt HP/ATK in der Zeile
local function ratingText(baerchi: Types.Baerchi): string
	local value, suffix = CombatRating.short(CombatRating.of(baerchi))
	local digits = if suffix ~= "" and value < 100 then 1 else 0
	return "⚔ " .. (if digits > 0 then Loc.formatDecimal(value, digits) else Loc.formatNumber(math.floor(value))) .. suffix
end
local IndexView    = require(script.Parent.IndexView)

local BaerchiInventory = {}

local PANEL_NAME  = "Inventory"
local ROW_HEIGHT  = 48
local TOOLBAR_H   = 32
local FOOTER_H    = 64
local TAB_H       = 32

local _root: Frame?               = nil
local _title: TextLabel?          = nil
local _scroller: ScrollingFrame?  = nil
local _empty: TextLabel?          = nil
local _footer: Frame?             = nil
local _slotLabels: { TextLabel }  = {}
local _fuseButton: TextButton?    = nil
local _modeButton: TextButton?    = nil
local _hint: TextLabel?           = nil
local _listPage: Frame?           = nil
local _tabButtons: { [string]: TextButton } = {}
local _tab = "Pets"   -- "Pets" | "Index"

local _fusionMode = false
local _selection: { string } = {}
local _dirty = true

--------------------------------------------------------------------------------
-- Auswahl
--------------------------------------------------------------------------------

local function isSelected(uid: string): boolean
	return table.find(_selection, uid) ~= nil
end

local function toggleSelection(uid: string)
	local index = table.find(_selection, uid)
	if index then
		table.remove(_selection, index)
		return
	end

	-- Der dritte Klick verdraengt die aelteste Markierung — das ist
	-- angenehmer als ein stiller "geht nicht".
	if #_selection >= 2 then
		table.remove(_selection, 1)
	end
	table.insert(_selection, uid)
end

-- Markierungen wegwerfen die es nicht mehr gibt (verwertet, fusioniert, Rebirth)
local function pruneSelection()
	for i = #_selection, 1, -1 do
		if not ClientState.getBaerchi(_selection[i]) then
			table.remove(_selection, i)
		end
	end
end

--------------------------------------------------------------------------------
-- Aufbau der Liste
--------------------------------------------------------------------------------

-- Zeigt die AKTUELLEN HP, nicht nur das Maximum: seit die HP zwischen
-- PIT-Laeufen stehen bleiben, ist "wer kann ueberhaupt noch kaempfen" die
-- eigentliche Frage beim Durchscrollen der Liste.
local function describeStats(baerchi: Types.Baerchi): string
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then return "" end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)
	-- `or stats.maxHp`: ohne den Rueckfall wuerde ein Baerchi ohne currentHp
	-- (Datenpaket von einem aelteren Serverstand) hier den Aufbau der GANZEN
	-- Liste abbrechen, weil dieser Aufruf mitten in der Zeilen-Schleife steht.
	local hp    = math.clamp(baerchi.currentHp or stats.maxHp, 0, stats.maxHp)

	return string.format("HP %d/%d\nATK %d", hp, stats.maxHp, stats.atk)
end

local function buildRow(parent: Instance, order: number, baerchi: Types.Baerchi)
	local upgradeUi = FeatureFlags.isOn("UI_V2_UPGRADE_TAB")
	-- HBB Paket 4: Farbband statt zwoelf Einzelfarben
	local color = if upgradeUi then Theme.bandColor(baerchi.rarity) else Theme.rarityColor(baerchi.rarity)
	local def   = BaerchiConfig.getById(baerchi.configId)

	local data     = ClientState.get()
	local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

	local row = Theme.panel("Row_" .. baerchi.uid, parent, Theme.COLORS.panel)
	row.Size        = UDim2.new(1, -8, 0, ROW_HEIGHT)
	row.LayoutOrder = order

	-- Markierte Zeilen bekommen einen farbigen Rand statt eines eigenen Symbols
	local stroke = row:FindFirstChildOfClass("UIStroke")
	if stroke and _fusionMode and isSelected(baerchi.uid) then
		stroke.Color     = Theme.COLORS.gummy
		stroke.Thickness = Theme.OUTLINE_THICKNESS + 2
	end

	local accent = Instance.new("Frame")
	accent.Name             = "Accent"
	accent.Size             = UDim2.new(0, 6, 1, -14)
	accent.Position         = UDim2.new(0, 8, 0, 7)
	-- Der ausgeruestete Baerchi (der einzige, der auf dem Plot steht und
	-- kaempfen/essen kann) hebt sich hier golden ab statt in Rarity-Farbe —
	-- das ist auf einen Blick wichtiger als die Rarity.
	accent.BackgroundColor3  = if equipped then Theme.COLORS.goldGummy else color
	accent.BorderSizePixel   = 0
	accent.Parent            = row
	Theme.corner(accent, 3)

	-- Eine Mutation ist in einer langen Liste die Information, die man auf
	-- keinen Fall uebersehen darf: die haeufigste Stufe trifft trotzdem nur
	-- 1 von 100 Baerchis. Deshalb hier gleich zweimal — als Kuerzel im Namen
	-- und als Farbe der Unterzeile (seit v11, ersetzt das binaere Inverted).
	local mutation = baerchi.mutation

	local name = Theme.label("Name", row,
		(if equipped then "\u{2605} " else "")
		.. (if mutation then BaerchiConfig.getMutationBadge(mutation) .. " " else "")
		.. (def and def.displayName or baerchi.configId))
	name.Position = UDim2.new(0, 22, 0, 5)
	name.Size     = UDim2.new(1, -120, 0, 21)

	local sub = Theme.label("Sub", row, string.format(
		"Lv. %d  —  %s%s",
		baerchi.level,
		baerchi.rarity,
		if mutation then "  —  " .. BaerchiConfig.getMutationDisplayName(mutation):upper() else ""
	))
	sub.Position   = UDim2.new(0, 22, 0, 26)
	sub.Size       = UDim2.new(1, -120, 0, 16)
	sub.TextColor3 = if mutation then BaerchiConfig.getMutationColor(mutation) else color

	local stats = Theme.label("Stats", row, if upgradeUi then ratingText(baerchi) else describeStats(baerchi))
	stats.AnchorPoint    = Vector2.new(1, 0.5)
	stats.Position       = UDim2.new(1, -10, 0.5, 0)
	stats.Size           = UDim2.new(0, 84, 1, -10)
	stats.TextXAlignment = Enum.TextXAlignment.Right
	stats.TextScaled     = false
	stats.TextSize       = if upgradeUi then 20 else 13
	stats.Font           = if upgradeUi then Theme.FONT else Theme.FONT_BODY
	stats.TextColor3     = if upgradeUi then Theme.COLORS.text else Theme.COLORS.textDim

	-- Die ganze Zeile ist der Knopf: ein durchsichtiger Button darueber.
	-- So bleibt der Aufbau der Zeile frei von Button-Eigenheiten.
	local hit = Instance.new("TextButton")
	hit.Name                   = "Hit"
	hit.BackgroundTransparency = 1
	hit.Text                   = ""
	hit.Size                   = UDim2.fromScale(1, 1)
	hit.ZIndex                 = 3
	hit.Parent                 = row

	hit.Activated:Connect(function()
		if _fusionMode then
			toggleSelection(baerchi.uid)
			BaerchiInventory.refresh()
		else
			PanelManager.open("Baerchi", baerchi.uid)
		end
	end)
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

local function updateFooter()
	local footer = _footer
	if footer then
		footer.Visible = _fusionMode
	end

	local scroller = _scroller
	if scroller then
		local reserved = if _fusionMode then FOOTER_H + 6 else 0
		scroller.Size = UDim2.new(1, 0, 1, -(TOOLBAR_H + 6 + reserved))
	end

	for slot = 1, 2 do
		local label = _slotLabels[slot]
		if not label then continue end

		local uid = _selection[slot]
		local baerchi = if uid then ClientState.getBaerchi(uid) else nil

		if baerchi then
			local def = BaerchiConfig.getById(baerchi.configId)
			label.Text       = string.format("%s  Lv.%d", def and def.displayName or baerchi.configId, baerchi.level)
			label.TextColor3  = Theme.rarityColor(baerchi.rarity)
		else
			label.Text       = "Slot " .. slot .. ": leer"
			label.TextColor3  = Theme.COLORS.textDim
		end
	end

	local fuseButton = _fuseButton
	if fuseButton then
		Theme.setEnabled(fuseButton, #_selection == 2)
	end

	local modeButton = _modeButton
	if modeButton then
		modeButton.Text = if _fusionMode then "Fusion: an" else "Fusion: aus"
	end

	local hint = _hint
	if hint then
		hint.Text = if _fusionMode
			then "Zwei Baerchis derselben Rarity antippen"
			else "Zeile antippen oeffnet die Karte"
	end
end

function BaerchiInventory.refresh()
	local scroller = _scroller
	local root     = _root
	if not scroller or not root then return end

	if not root.Visible then
		_dirty = true
		return
	end
	_dirty = false

	pruneSelection()

	for _, child in scroller:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local list = ClientState.getBaerchiList()

	local title = _title
	if title then
		title.Text = "Baerchis (" .. #list .. ")"
	end

	local empty = _empty
	if empty then
		empty.Visible = #list == 0
	end

	for order, baerchi in list do
		buildRow(scroller, order, baerchi)
	end

	updateFooter()
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function applyTab()
	-- HBB Paket 3: der Index-Reiter erscheint ab drei entdeckten Arten
	local indexTab = _tabButtons.Index
	if indexTab then
		Unlock.apply("index", indexTab)
		if not indexTab.Visible and _tab == "Index" then _tab = "Pets" end
	end

	local listPage = _listPage
	if listPage then
		listPage.Visible = _tab == "Pets"
	end
	IndexView.setVisible(_tab == "Index" and _root ~= nil and _root.Visible)

	for tab, button in _tabButtons do
		local active = tab == _tab
		button.BackgroundColor3 = if active then Theme.COLORS.accent else Theme.COLORS.panelLight
		button.TextColor3       = if active then Theme.COLORS.outline else Theme.COLORS.text
	end

	if _tab == "Pets" then
		BaerchiInventory.refresh()
	end
end

local function openInternal(...: any)
	local root = _root
	if not root then return end

	-- PanelManager.open("Inventory", "Index") springt direkt in den Index
	-- (zum Beispiel aus einer Quest heraus).
	local wanted, uid = ...
	if wanted == "Index" or wanted == "Pets" then
		_tab = wanted
	elseif wanted == "Fuse" then
		-- Playtest 05.10.: Fusion von der Baerchi-Karte aus. Das Fusions-
		-- Fenster selbst hat keine Auswahl; ausgewaehlt wird hier. A ist
		-- dieser Baerchi, B tippt der Spieler in der Liste an.
		_tab = "Pets"
		_fusionMode = true
		table.clear(_selection)
		if typeof(uid) == "string" then table.insert(_selection, uid) end
	end

	root.Visible = true
	applyTab()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
	IndexView.setVisible(false)
end

function BaerchiInventory.show()
	PanelManager.open(PANEL_NAME)
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function BaerchiInventory.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"BaerchiInventory", screenGui,
		Vector2.new(0.46, 0.66),
		Vector2.new(300, 300),
		Vector2.new(520, 580)
	)
	_root  = root
	_title = Theme.dialogHeader(root, "Baerchis", function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	-- Reiter-Leiste: "Meine Baerchis" | "Index"
	local tabBar = Theme.container("Tabs", body)
	tabBar.Size = UDim2.new(1, 0, 0, TAB_H)
	local tabLayout = Theme.listLayout(tabBar, 8, true)
	tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local function addTab(tab: string, key: string, order: number)
		local button = Theme.button("Tab_" .. tab, tabBar, "", Theme.COLORS.panelLight)
		button.Size        = UDim2.new(0, 150, 1, 0)
		button.LayoutOrder = order
		Loc.bind(button, key)
		button.Activated:Connect(function()
			if tab == "Index" then Unlock.markSeen("index") end
			_tab = tab
			applyTab()
		end)
		_tabButtons[tab] = button
	end
	addTab("Pets",  "ui.inventory.tab_pets",  1)
	addTab("Index", "ui.inventory.tab_index", 2)

	-- Beide Seiten teilen sich die Flaeche unter den Reitern.
	local pages = Theme.container("Pages", body)
	pages.Position = UDim2.new(0, 0, 0, TAB_H + 8)
	pages.Size     = UDim2.new(1, 0, 1, -(TAB_H + 8))

	local listPage = Theme.container("ListPage", pages)
	listPage.Size = UDim2.fromScale(1, 1)
	_listPage = listPage

	IndexView.build(pages, root)

	-- Werkzeugleiste: Fusions-Modus an/aus
	local toolbar = Theme.container("Toolbar", listPage)
	toolbar.Size = UDim2.new(1, 0, 0, TOOLBAR_H)

	local modeButton = Theme.button("FusionMode", toolbar, "Fusion: aus", Theme.COLORS.gummy)
	modeButton.Size = UDim2.new(0, 130, 1, 0)
	_modeButton = modeButton

	local hint = Theme.bodyText("Hint", toolbar, "Zeile antippen oeffnet die Karte")
	_hint = hint
	hint.Position       = UDim2.new(0, 140, 0, 0)
	hint.Size           = UDim2.new(1, -140, 1, 0)
	hint.TextYAlignment = Enum.TextYAlignment.Center

	modeButton.Activated:Connect(function()
		_fusionMode = not _fusionMode
		if not _fusionMode then
			table.clear(_selection)
		end
		BaerchiInventory.refresh()
	end)

	-- Liste
	local scroller = Theme.scroller("List", listPage)
	scroller.Position = UDim2.new(0, 0, 0, TOOLBAR_H + 6)
	scroller.Size     = UDim2.new(1, 0, 1, -(TOOLBAR_H + 6))
	_scroller = scroller

	local layout = Theme.listLayout(scroller, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local empty = Theme.bodyText("Empty", listPage, "Noch keine Baerchis. Leg im Eier-Menue ein Ei in die Brueterei.")
	empty.Position = UDim2.new(0, 4, 0, TOOLBAR_H + 16)
	empty.Size     = UDim2.new(1, -8, 0, 40)
	empty.Visible  = false
	_empty = empty

	-- Fussleiste fuer die Fusions-Auswahl
	local footer = Theme.panel("FusionFooter", listPage, Theme.COLORS.panel)
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Position    = UDim2.new(0, 0, 1, 0)
	footer.Size        = UDim2.new(1, -8, 0, FOOTER_H)
	footer.Visible     = false
	_footer = footer

	for slot = 1, 2 do
		local label = Theme.label("Slot" .. slot, footer, "Slot " .. slot .. ": leer")
		label.Position   = UDim2.new(0, 10, 0, 6 + (slot - 1) * 22)
		label.Size       = UDim2.new(1, -140, 0, 20)
		label.TextColor3  = Theme.COLORS.textDim
		_slotLabels[slot] = label
	end

	local fuseButton = Theme.button("Fuse", footer, "Fusionieren", Theme.COLORS.gummy)
	fuseButton.AnchorPoint = Vector2.new(1, 0.5)
	fuseButton.Position    = UDim2.new(1, -10, 0.5, 0)
	fuseButton.Size        = UDim2.new(0, 116, 0, 34)
	_fuseButton = fuseButton

	fuseButton.Activated:Connect(function()
		if #_selection < 2 then return end
		PanelManager.open("Fusion", _selection[1], _selection[2])
	end)

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	-- Bestandsaenderungen: sichtbar sofort nachziehen, sonst nur merken
	ClientState.onChanged(function()
		local current = _root
		if current and current.Visible then
			BaerchiInventory.refresh()
		else
			_dirty = true
		end
	end)

	print("[BaerchiInventory] Initialisiert")
end

return BaerchiInventory
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX95"><Properties>
<string name="Name">BaerchiPanel</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- BaerchiPanel.luau
-- StarterPlayerScripts/UI/BaerchiPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Detailkarte eines einzelnen Baerchis anzeigen
--   - Die Aktionen die genau diesen Baerchi betreffen ausloesen: ausruesten,
--     befoerdern, mit Honig fuettern und verwerten
--
-- SEIT v12 laufen "Zum Event" und "In den PIT" NICHT mehr ueber diese Karte,
-- sondern ueber die untere Pet-Leiste (PetBar). Der ausgeruestete Baerchi kann
-- ausserdem nicht mehr verwertet werden (Ei-Baum-Konzept, Pet-Regeln): der
-- Knopf ist bei ihm gesperrt, der Server lehnt es zusaetzlich ab.
--
-- FUETTERN IST SEIT v7 EINE ENTSCHEIDUNG, kein einzelner Knopf mehr: die drei
-- Gebaeude liefern unterschiedlichen Honig (siehe Config/BuildingBehavior).
-- Deshalb steht hier pro Gebaeude ein eigener Knopf mit seinem eigenen
-- Bestand, in derselben Farbe wie seine Karte im Gebaeude-Panel. Welchen Honig
-- der Spieler verfuettert, entscheidet er — nicht mehr der Server.
--
-- SEIT v8 zeigt die Karte die ZWEITE Fortschrittsachse mit: fuenf Sterne
-- (Promotion), acht Charm-Slots und ein Balken je Stat-Level. Damit wuchs sie
-- ueber die Hoehe eines Handy-Bildschirms hinaus — der Inhalt liegt deshalb
-- jetzt in einem Scroller statt direkt im Rahmen. Das ist der Grund, warum
-- `body` hier eine ScrollingFrame ist und die Zeilen `1, -8` breit sind.
--
-- Wird von WorldController geoeffnet, wenn der Spieler eine Figur auf seiner
-- Insel anklickt, und aus dem Inventar heraus. Die Karte liest ihre Daten
-- ueber die uid aus ClientState — kein zusaetzlicher Server-Roundtrip noetig.
--
-- Die Karte bleibt beim Datenwechsel offen und aktualisiert sich mit (z.B.
-- waehrend eines Kampfes steigt XP), und schliesst sich automatisch wenn der
-- Baerchi verschwindet (verwertet oder fusioniert).
--
-- Die Kampf-Wiedergabe gehoert bewusst NICHT hierher: sie haengt am
-- CombatResultReceived-Listener in CombatPanel und laeuft deshalb egal von
-- wo der Kampf gestartet wurde.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local SkillConfig      = require(ReplicatedStorage.Config.SkillConfig)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local PromotionConfig  = require(ReplicatedStorage.Config.PromotionConfig)
local CharmConfig      = require(ReplicatedStorage.Config.CharmConfig)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggCalculator    = require(ReplicatedStorage.Modules.EggCalculator)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify        = require(script.Parent.Notify)
local Feedback      = require(script.Parent.Feedback)
local Moment        = require(script.Parent.Moment)
local ReturnSummary = require(script.Parent.ReturnSummary)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Unlock       = require(script.Parent.Unlock)   -- HBB Paket 3
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombatRating = require(ReplicatedStorage.Modules.CombatRating)
local Loc          = require(ReplicatedStorage.Localization.Loc)

-- HBB Paket 4: Kampfwert im Kopf, "Staerker machen" (Befoerdern + Fusion)
local _ratingLabel: TextLabel? = nil
local _ratingRow: Frame? = nil
local _upgradeRow: Frame? = nil

local BaerchiPanel = {}

local PANEL_NAME = "Baerchi"

local _root: Frame?      = nil
local _openUid: string?  = nil

-- Referenzen auf die Felder der Karte
local _titleLabel: TextLabel?  = nil
local _rarityLabel: TextLabel? = nil
local _levelLabel: TextLabel?  = nil
local _statsLabel: TextLabel?  = nil
local _skillLabel: TextLabel?  = nil
local _valueLabel: TextLabel?  = nil
local _xpFill: Frame?          = nil
local _xpText: TextLabel?      = nil
local _hpFill: Frame?          = nil
local _hpText: TextLabel?      = nil
local _accentBar: Frame?       = nil
local _fusionBadge: Frame?         = nil
local _mutationBadge: Frame?       = nil
local _mutationBadgeText: TextLabel? = nil
local _equipButton: TextButton? = nil
local _recycleButton: TextButton? = nil

-- v8: Promotion, Stat-Level, Charms
local _stars: { Frame }            = {}
local _promoteButton: TextButton?  = nil
local _promoteHint: TextLabel?     = nil
type CharmTile = {
	tile   : Frame,
	letter : TextLabel,
}
local _charmSlots: { CharmTile }   = {}
local _charmButton: TextButton?    = nil

-- v10: Eier legen
local _eggRateLabel: TextLabel?    = nil
local _eggChanceLabel: TextLabel?  = nil
local _eggCountLabel: TextLabel?   = nil
local _collectButton: TextButton?  = nil

type StatRow = {
	key  : string,
	fill : Frame,
	text : TextLabel,
}
local _statRows: { StatRow } = {}

-- Ein Fuetter-Knopf pro Gebaeude, key = BuildingId. Text und Verfuegbarkeit
-- ziehen bei jedem Datenwechsel nach (siehe fill).
local _feedButtons: { [string]: TextButton } = {}

--------------------------------------------------------------------------------
-- Inhalt fuellen
--------------------------------------------------------------------------------

-- Wie viele Duplikate fuer die naechste Promotion da sind. Dieselbe Bedingung
-- wie PromotionService.getMaterials: gleicher configId, andere uid, nicht der
-- ausgeruestete Baerchi.
local function countMaterials(target: Types.Baerchi): number
	local data = ClientState.get()
	if not data then return 0 end

	local count = 0
	for uid, baerchi in data.island.baerchis do
		if uid ~= target.uid
			and baerchi.configId == target.configId
			and uid ~= data.island.equippedUid
		then
			count += 1
		end
	end
	return count
end

local function fillPromotion(baerchi: Types.Baerchi)
	local promotion = baerchi.promotionLevel or 0
	local states    = PromotionConfig.getStarStates(promotion)

	for index, star in _stars do
		star.BackgroundColor3 = PromotionConfig.STAR_COLORS[states[index]]
			or PromotionConfig.STAR_COLORS.empty
	end

	local maxed = promotion >= PromotionConfig.MAX_PROMOTION

	if _promoteHint then
		if maxed then
			_promoteHint.Text       = string.format("Promotion %d/%d — voll befoerdert",
				promotion, PromotionConfig.MAX_PROMOTION)
			_promoteHint.TextColor3 = Theme.COLORS.goldGummy
		else
			local cost = PromotionConfig.getDuplicateCost(baerchi.rarity, promotion + 1)
			local have = countMaterials(baerchi)

			_promoteHint.Text = string.format(
				"Promotion %d/%d  —  naechste Stufe: %d Duplikate (du hast %d)",
				promotion, PromotionConfig.MAX_PROMOTION, cost, have
			)
			_promoteHint.TextColor3 = if have >= cost then Theme.COLORS.good else Theme.COLORS.textDim
		end
	end

	if _promoteButton then
		local ready = false
		if not maxed then
			local cost = PromotionConfig.getDuplicateCost(baerchi.rarity, promotion + 1)
			ready = countMaterials(baerchi) >= cost
		end

		_promoteButton.Text = if maxed then "Voll befoerdert" else "Befoerdern"
		Theme.setEnabled(_promoteButton, ready)
	end
end

local function fillStatLevels(baerchi: Types.Baerchi)
	local cap    = PromotionConfig.getStatCap(baerchi.rarity)
	local levels = baerchi.statLevels

	for _, row in _statRows do
		local value = if levels then (((levels :: any)[row.key]) or 0) else 0
		local ratio = if cap > 0 then math.clamp(value / cap, 0, 1) else 0

		row.fill.Size = UDim2.fromScale(ratio, 1)

		-- EGG hebt sich farblich ab: es ist der einzige der fuenf Stats, der
		-- nichts mit dem Kampf zu tun hat, sondern mit dem Ei-Legen.
		row.fill.BackgroundColor3 = if row.key == "egg"
			then Theme.COLORS.goldGummy
			else Theme.rarityColor(baerchi.rarity)

		local label = PromotionConfig.STAT_LABELS[row.key] or string.upper(row.key)
		row.text.Text = string.format("%s  %d / %d", label, value, cap)
	end
end

local function fillCharms(baerchi: Types.Baerchi)
	local promotion = baerchi.promotionLevel or 0

	-- `or {}`: ein Datenpaket von einem aelteren Serverstand haette das Feld
	-- nicht (dieselbe Vorsichtsmassnahme wie bei currentHp weiter unten).
	local charms: { Types.Charm } = baerchi.charms or {}

	local bySlot: { [number]: Types.Charm } = {}
	for _, charm in charms do
		bySlot[charm.slot] = charm
	end

	local unlocked = 0

	for slot, entry in _charmSlots do
		local isOpen = CharmConfig.isSlotUnlocked(slot, promotion)
		local charm  = if isOpen then bySlot[slot] else nil

		if isOpen then unlocked += 1 end

		if not isOpen then
			entry.letter.Text          = "-"
			entry.letter.TextColor3    = Theme.COLORS.textDim
			entry.tile.BackgroundColor3 = Theme.COLORS.disabled
		elseif not charm then
			entry.letter.Text          = "?"
			entry.letter.TextColor3    = Theme.COLORS.text
			entry.tile.BackgroundColor3 = Theme.COLORS.panelLight
		else
			entry.letter.Text          = CharmConfig.RARITY_LETTER[charm.rarity] or "?"
			entry.letter.TextColor3    = Theme.COLORS.outline
			entry.tile.BackgroundColor3 = CharmConfig.RARITY_COLORS[charm.rarity]
				or Theme.COLORS.panelLight
		end
	end

	if _charmButton then
		_charmButton.Text = string.format("Charms (%d/%d offen)", unlocked, CharmConfig.SLOT_COUNT)
		Theme.setEnabled(_charmButton, true)
	end
end

-- Der Ei-Abschnitt: wie schnell dieser Baerchi legt und was dabei herauskommen
-- kann. Beide Zahlen kommen aus EggCalculator — dieselbe Rechnung, die der
-- Server benutzt. Eine nachgebaute Formel hier waere beim naechsten Balancing
-- sofort falsch.
local function fillEgg(baerchi: Types.Baerchi)
	local data     = ClientState.get()
	local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

	if _eggRateLabel then
		local interval = EggCalculator.getLayIntervalSeconds(baerchi, false)

		if not interval then
			_eggRateLabel.Text       = "Dieser Baerchi legt keine Eier."
			_eggRateLabel.TextColor3 = Theme.COLORS.textDim
		else
			_eggRateLabel.Text = string.format(
				"Legt alle %s%s",
				Theme.formatDuration(interval),
				if equipped then "" else "  (nur der ausgeruestete legt wirklich)"
			)
			_eggRateLabel.TextColor3 = if equipped then Theme.COLORS.goldGummy else Theme.COLORS.textDim
		end
	end

	if _eggChanceLabel then
		local chances = EggCalculator.getChances(baerchi)

		if #chances == 0 then
			_eggChanceLabel.Text = ""
		else
			local parts: { string } = {}
			for _, chance in chances do
				local def = EggConfig.data[chance.eggType]
				table.insert(parts, string.format(
					"%s %d%%",
					if def then def.shortName else chance.eggType,
					math.floor(chance.percent + 0.5)
				))
			end
			_eggChanceLabel.Text = table.concat(parts, "   ")
		end
	end

	if _eggCountLabel then
		local laid = if data then #(data.island.laidEggs or {}) else 0

		_eggCountLabel.Text = string.format(
			"%d / %d Eier liegen auf deinem Plot",
			laid, EggConfig.MAX_UNCOLLECTED_EGGS
		)
		_eggCountLabel.TextColor3 = if laid >= EggConfig.MAX_UNCOLLECTED_EGGS
			then Theme.COLORS.bad
			else Theme.COLORS.textDim
	end

	if _collectButton then
		local laid = if data then #(data.island.laidEggs or {}) else 0
		_collectButton.Text = if laid > 0
			then string.format("Alle %d Eier einsammeln", laid)
			else "Keine Eier da"
		Theme.setEnabled(_collectButton, laid > 0)
	end
end

local function fill(baerchi: Types.Baerchi)
	local def = BaerchiConfig.getById(baerchi.configId)
	local color = Theme.rarityColor(baerchi.rarity)

	-- HBB Paket 3: Charms und Verwerten erst, wenn sie gebraucht werden
	if _charmButton then Unlock.apply("charms", _charmButton) end
	if _recycleButton then Unlock.apply("recycling", _recycleButton) end

	-- HBB Paket 4: Farbband statt zwoelf Einzelfarben, Kampfwert gross
	local upgradeUi = FeatureFlags.isOn("UI_V2_UPGRADE_TAB")
	if upgradeUi then
		color = Theme.bandColor(baerchi.rarity)
	end
	local ratingLabel = _ratingLabel
	if ratingLabel then
		if _ratingRow then _ratingRow.Visible = upgradeUi end
		local value, suffix = CombatRating.short(CombatRating.of(baerchi))
		local digits = if suffix ~= "" and value < 100 then 1 else 0
		ratingLabel.Text = "⚔ " .. (if digits > 0 then Loc.formatDecimal(value, digits) else Loc.formatNumber(math.floor(value))) .. suffix
		ratingLabel.TextColor3 = color
	end
	local upgradeRow = _upgradeRow
	if upgradeRow then
		upgradeRow.Visible = upgradeUi and Unlock.isVisible("tab_upgrade")
	end

	if _accentBar   then _accentBar.BackgroundColor3 = color end
	if _titleLabel  then _titleLabel.Text  = def and def.displayName or baerchi.configId end
	if _rarityLabel then
		_rarityLabel.Text       = string.upper(baerchi.rarity)
		_rarityLabel.TextColor3 = color
	end
	if _levelLabel then
		_levelLabel.Text = string.format("Level %d / %d", baerchi.level, BaerchiConfig.MAX_LEVEL)
		if baerchi.level >= BaerchiConfig.MAX_LEVEL and (baerchi.endlessLevel or 0) > 0 then
			-- Paket 9: Endless-Level dahinter
			_levelLabel.Text ..= "  " .. Loc.t("ui.baerchi.endless_level", { n = baerchi.endlessLevel or 0 })
		end
	end

	-- Nur der ausgeruestete Baerchi steht auf dem Plot, kaempft und isst von
	-- alleine am Teich — der Knopf zeigt, ob das dieser hier ist, und ruestet
	-- ihn sonst aus.
	if _equipButton then
		local data     = ClientState.get()
		local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

		_equipButton.Text = if equipped then "Ausgeruestet" else "Ausruesten"
		Theme.setEnabled(_equipButton, not equipped)
	end

	-- Kampfwerte inklusive Fusions-Bonus, damit die Karte zeigt was im PIT zaehlt.
	-- Bewusst ueber CombatCalculator.getEffectiveStats: das ist dieselbe Funktion
	-- die der Server fuer den Kampf benutzt — eine nachgebaute Formel hier waere
	-- beim naechsten Balancing sofort falsch. Seit v8 stecken darin auch
	-- Promotion, Stat-Level und Charms.
	local stats = if def then CombatCalculator.getEffectiveStats(baerchi, def.baseStats) else nil

	if _statsLabel and stats then
		-- Eine Verteidigung gibt es nicht mehr (siehe BaerchiConfig): die drei
		-- Zahlen, die einen Kampf entscheiden, sind Schaden pro Treffer,
		-- Angriffstempo und Ability-Staerke.
		_statsLabel.Text = string.format("ATK %d    SPD %.2f    PWR %d%%",
			stats.atk, stats.spd, math.floor(stats.pwr * 100 + 0.5))
	end

	-- HP-Balken. Die HP bleiben zwischen PIT-Laeufen stehen: ein leerer Balken
	-- heisst erschoepft, und dann geht kein neuer Lauf mehr los bevor
	-- gefuettert wurde. Das ist die wichtigste Zahl auf dieser Karte.
	if _hpFill and _hpText and stats then
		-- `or stats.maxHp`: currentHp gibt es erst seit v4. Ein Datenpaket von
		-- einem aelteren Serverstand haette das Feld nicht, und math.clamp
		-- wuerde an nil scheitern statt den Baerchi einfach voll anzuzeigen.
		local hp    = math.clamp(baerchi.currentHp or stats.maxHp, 0, stats.maxHp)
		local ratio = if stats.maxHp > 0 then hp / stats.maxHp else 0

		_hpFill.Size = UDim2.fromScale(ratio, 1)
		_hpFill.BackgroundColor3 = if ratio <= 0
			then Theme.COLORS.bad
			elseif ratio < 0.34 then Theme.COLORS.goldGummy
			else Theme.COLORS.good

		_hpText.Text = if hp <= 0
			then string.format("erschoepft  —  0 / %d HP", stats.maxHp)
			else string.format("%d / %d HP", hp, stats.maxHp)
	end

	if _skillLabel then
		local skill = SkillConfig.getById(baerchi.skillId)
		_skillLabel.Text = skill and (skill.displayName .. " — " .. skill.description)
			or baerchi.skillId
	end

	-- XP-Balken
	-- Paket 9: auf Max-Level sammeln sich XP nur mit offenem Endless (sonst
	-- immer 0) — dann zeigt der Balken den Weg zum naechsten Endless-Level.
	local endlessXp = baerchi.level >= BaerchiConfig.MAX_LEVEL
		and ((baerchi.endlessLevel or 0) > 0 or baerchi.xp > 0)
	local needed = if endlessXp
		then BaerchiConfig.xpForEndlessLevel(baerchi.endlessLevel or 0)
		else BaerchiConfig.xpForNextLevel(baerchi.level)
	local ratio  = if baerchi.level >= BaerchiConfig.MAX_LEVEL and not endlessXp
		then 1
		else math.clamp(baerchi.xp / math.max(needed, 1), 0, 1)

	if _xpFill then
		_xpFill.Size            = UDim2.fromScale(ratio, 1)
		_xpFill.BackgroundColor3 = color
	end
	if _xpText then
		_xpText.Text = if endlessXp
			then string.format("%s / %s XP", Theme.formatNumber(baerchi.xp), Theme.formatNumber(needed))
			elseif baerchi.level >= BaerchiConfig.MAX_LEVEL
			then "MAX"
			else string.format("%d / %d XP", baerchi.xp, needed)
	end

	-- Verwertungs-Wert, damit man vor dem Verwerten weiss was es bringt.
	-- Feste Quote seit v4 (kein Recycler-Gebaeude mehr).
	if _valueLabel then
		local value = math.floor(
			EconomyConfig.getBaerchiBaseValue(baerchi.rarity, baerchi.level)
			* EconomyConfig.RECYCLE_RETURN
		)
		_valueLabel.Text = "Verwerten bringt: " .. Theme.formatNumber(value) .. " Gummies"
	end

	-- Pet-Regel (v12): der ausgeruestete Baerchi ist der, der Eier legt — er
	-- darf nicht verwertet werden, sonst stuende der Spieler ohne Leger da.
	-- Tauschen geht ueber "Ausruesten" bei einem anderen. Der Server lehnt es
	-- ohnehin ab, das Ausgrauen spart nur den Klick ins Leere.
	if _recycleButton then
		local data     = ClientState.get()
		local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

		_recycleButton.Text = if equipped then "Ausgeruestet — nicht verwertbar" else "Verwerten"
		Theme.setEnabled(_recycleButton, not equipped)
	end

	if _fusionBadge then
		_fusionBadge.Visible = baerchi.isFusionResult
	end

	if _mutationBadge then
		local mutation = baerchi.mutation
		_mutationBadge.Visible = mutation ~= nil
		if mutation then
			_mutationBadge.BackgroundColor3 = BaerchiConfig.getMutationColor(mutation)
			if _mutationBadgeText then
				_mutationBadgeText.Text = BaerchiConfig.getMutationDisplayName(mutation):upper()
			end
		end
	end

	fillPromotion(baerchi)
	fillStatLevels(baerchi)
	fillCharms(baerchi)
	fillEgg(baerchi)

	-- Fuetter-Knoepfe: jeder zeigt seinen EIGENEN Bestand und ist nur
	-- anklickbar, wenn dort auch etwas liegt. Leere Lager auszugrauen erspart
	-- den Klick ins Leere — abgelehnt wuerde er ohnehin, aber erst nach dem
	-- Weg zum Server.
	local data = ClientState.get()

	-- Nur Gebaeude, die es auf dieser Insel gibt (HONEY_POND_V2: nur der
	-- Teich); die Knoepfe teilen sich die Zeile gleichmaessig.
	local shown = 0
	for id in _feedButtons do
		if data and data.island.buildings[id :: Types.BuildingId] then shown += 1 end
	end
	for id, button in _feedButtons do
		local building = if data then data.island.buildings[id :: Types.BuildingId] else nil
		local honey = if building then (building.honey or 0) else 0

		local config = MapConfig.BUILDING_OFFSETS[id]
		button.Visible = building ~= nil
		button.Size = UDim2.new(1 / math.max(1, shown), -6, 1, 0)
		button.Text = string.format("%s %d", if config then config.shortName else id, honey)
		Theme.setEnabled(button, honey > 0)
	end
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function closeInternal()
	_openUid = nil
	local root = _root
	if root then root.Visible = false end
end

local function showInternal(...: any)
	local argument = ...
	if typeof(argument) ~= "string" then return end

	local uid = argument :: string
	local baerchi = ClientState.getBaerchi(uid)
	if not baerchi then
		-- unbekannte uid (fremde Insel oder veralteter Klick)
		PanelManager.close(PANEL_NAME)
		return
	end

	_openUid = uid
	fill(baerchi)

	local root = _root
	if root then root.Visible = true end
end

function BaerchiPanel.close()
	PanelManager.close(PANEL_NAME)
end

function BaerchiPanel.show(uid: string)
	-- Gehoert der Baerchi gar nicht diesem Spieler (Klick auf die Figur eines
	-- Nachbarn auf der gemeinsamen Plattform), passiert einfach nichts.
	--
	-- Frueher lief der Aufruf trotzdem durch: PanelManager.open schliesst
	-- zuerst alle anderen Panels und showInternal machte danach mangels
	-- Daten wieder zu — dem Spieler verschwand also sein gerade offenes
	-- Fenster, sobald er einen fremden Baerchi anklickte.
	if not ClientState.getBaerchi(uid) then
		return
	end

	PanelManager.open(PANEL_NAME, uid)
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function BaerchiPanel.init(screenGui: ScreenGui)
	local root = Theme.panel("BaerchiPanel", screenGui, Theme.COLORS.panelDeep)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position    = UDim2.fromScale(0.5, 0.5)
	-- Playtest 05.10.: die einspaltige Karte war zu schmal und lang. Jetzt
	-- zwei Spalten: links wer der Baerchi ist und wie er staerker wird,
	-- rechts Zustand, Werte, Eier und Aktionen.
	root.Size        = UDim2.fromScale(0.72, 0.74)
	root.Visible     = false
	root.ZIndex      = 10

	-- Seit v8 passt der Inhalt nicht mehr garantiert in den Rahmen (Sterne,
	-- fuenf Stat-Balken, acht Charm-Slots kamen dazu). Statt die Karte immer
	-- weiter wachsen zu lassen, scrollt sie: die Mindesthoehe muss deshalb nur
	-- noch fuer eine bequem lesbare Flaeche reichen, nicht mehr fuer JEDE
	-- Zeile gleichzeitig.
	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MinSize = Vector2.new(560, 400)
	sizeConstraint.MaxSize = Vector2.new(920, 680)
	sizeConstraint.Parent  = root

	-- Farbiger Rarity-Streifen am oberen Rand
	local accent = Instance.new("Frame")
	accent.Name             = "Accent"
	accent.Size             = UDim2.new(1, 0, 0, 10)
	accent.BackgroundColor3  = Theme.COLORS.accent
	accent.BorderSizePixel   = 0
	accent.Parent            = root
	Theme.corner(accent, 10)
	_accentBar = accent

	local shell = Theme.container("Body", root)
	shell.Position = UDim2.new(0, 0, 0, 16)
	shell.Size     = UDim2.new(1, 0, 1, -16)
	Theme.padding(shell, 14)

	-- Zwei Spalten, jede scrollt fuer sich. `row()` haengt an die Spalte, die
	-- gerade in `column` steht (umgeschaltet vor dem Abschnitt "Zustand").
	local leftColumn = Theme.scroller("Content", shell)
	leftColumn.Size = UDim2.new(0.5, -6, 1, 0)
	local rightColumn = Theme.scroller("ContentRight", shell)
	rightColumn.Position = UDim2.new(0.5, 6, 0, 0)
	rightColumn.Size = UDim2.new(0.5, -6, 1, 0)
	for _, columnFrame in { leftColumn, rightColumn } do
		local layout = Theme.listLayout(columnFrame, 6)
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	end
	local column: ScrollingFrame = leftColumn

	local nextOrder = 0
	local function row(height: number): Frame
		nextOrder += 1
		local entry = Theme.container("Row", column)
		-- -8: Platz fuer den Scrollbalken, sonst ragt jede Zeile darunter
		-- (Konvention aus Theme.scroller).
		entry.Size        = UDim2.new(1, -8, 0, height)
		entry.LayoutOrder = nextOrder
		return entry
	end

	local function section(text: string)
		local holder = row(16)
		local label  = Theme.sectionLabel("Section", holder, text)
		label.Size = UDim2.fromScale(1, 1)
	end

	-- Name
	local titleRow = row(34)
	_titleLabel = Theme.label("Title", titleRow, "—")
	_titleLabel.Size = UDim2.fromScale(1, 1)

	-- HBB Paket 4: Kampfwert (eine Zahl statt fuenf Werte)
	local ratingRow = row(40)
	ratingRow.Visible = false
	local ratingLabel = Theme.label("Rating", ratingRow, "")
	ratingLabel.Size = UDim2.fromScale(1, 1)
	Theme.outlineText(ratingLabel, 3)
	local ratingLimit = ratingLabel:FindFirstChildOfClass("UITextSizeConstraint")
	if ratingLimit then ratingLimit.MaxTextSize = 36 end
	_ratingLabel = ratingLabel
	_ratingRow = ratingRow

	-- Rarity + Fusions-Badge nebeneinander
	local rarityRow = row(22)
	_rarityLabel = Theme.label("Rarity", rarityRow, "—")
	_rarityLabel.Size       = UDim2.new(0.6, 0, 1, 0)
	_rarityLabel.Font       = Theme.FONT
	_rarityLabel.TextColor3 = Theme.COLORS.accent

	local badge = Theme.panel("FusionBadge", rarityRow, Theme.COLORS.gummy)
	badge.AnchorPoint = Vector2.new(1, 0.5)
	badge.Position    = UDim2.new(1, 0, 0.5, 0)
	badge.Size        = UDim2.new(0, 76, 0, 20)
	badge.Visible     = false
	local badgeText = Theme.label("Text", badge, "FUSION")
	badgeText.Size           = UDim2.fromScale(1, 1)
	badgeText.TextXAlignment = Enum.TextXAlignment.Center
	badgeText.TextColor3     = Theme.COLORS.outline
	_fusionBadge = badge

	-- Mutations-Badge (seit v11, ersetzt das binaere INVERTED-Badge). Sitzt
	-- LINKS neben dem Fusions-Badge statt an derselben Stelle: ein Baerchi
	-- kann beides gleichzeitig sein (die hoehere Mutations-Stufe zweier
	-- Inputs vererbt sich an das Fusions-Ergebnis, siehe FusionService
	-- Regel E). Etwas breiter als frueher, weil "CELESTIAL"/"BLOODROT" laenger
	-- sind als "INVERTED".
	local mutBadge = Theme.panel("MutationBadge", rarityRow, Theme.COLORS.accent)
	mutBadge.AnchorPoint = Vector2.new(1, 0.5)
	mutBadge.Position    = UDim2.new(1, -86, 0.5, 0)
	mutBadge.Size        = UDim2.new(0, 96, 0, 20)
	mutBadge.Visible     = false
	local mutText = Theme.label("Text", mutBadge, "MUTATION")
	mutText.Size           = UDim2.fromScale(1, 1)
	mutText.TextXAlignment = Enum.TextXAlignment.Center
	mutText.TextColor3     = Theme.COLORS.outline
	_mutationBadge     = mutBadge
	_mutationBadgeText = mutText

	-- Level
	local levelRow = row(22)
	_levelLabel = Theme.label("Level", levelRow, "—")
	_levelLabel.Size = UDim2.fromScale(1, 1)

	-- Ausruesten: nur der ausgeruestete Baerchi steht auf dem Plot. Steht
	-- gleich unter dem Level, weil es die erste Entscheidung ist, die man bei
	-- einem neuen Baerchi trifft.
	local equipRow = row(28)
	local equip = Theme.button("Equip", equipRow, "Ausruesten", Theme.COLORS.accent)
	equip.Size = UDim2.new(1, 0, 1, 0)
	_equipButton = equip
	equip.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Remotes.RequestEquipBaerchi:FireServer(uid)
	end)

	-- HBB Paket 4: "Baerchi staerker machen" — Befoerdern (unten, wie bisher)
	-- und Fusion an einer Stelle. Die Fusion oeffnet das bestehende
	-- Inventar im Fusions-Modus mit diesem Baerchi als A (Playtest 05.10.:
	-- direkt ins Fusions-Fenster ging B nicht auszuwaehlen).
	local upgradeRow = row(34)
	upgradeRow.Visible = false
	local fuse = Theme.button("UpgradeFuse", upgradeRow, "⬆ + 🐻", Theme.COLORS.gummy)
	fuse.Size = UDim2.new(1, 0, 1, 0)
	fuse.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Unlock.markSeen("tab_upgrade")
		-- Auswahl des zweiten Baerchis passiert im Inventar (Fusions-Modus)
		PanelManager.open("Inventory", "Fuse", uid)
	end)
	_upgradeRow = upgradeRow

	-- ---------------------------------------------------------------- Promotion
	section("Promotion")

	-- Fuenf Sterne. Zehn Stufen werden darauf abgebildet, indem die Sterne ein
	-- zweites Mal umgefaerbt werden (siehe PromotionConfig.getStarStates) —
	-- diese Umrechnung passiert dort, nicht hier.
	local starRow = row(26)
	local starLayout = Theme.listLayout(starRow, 6, true)
	starLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	for index = 1, PromotionConfig.STAR_COUNT do
		local star = Theme.panel("Star_" .. index, starRow, PromotionConfig.STAR_COLORS.empty)
		star.Size        = UDim2.new(0, 26, 0, 26)
		star.LayoutOrder = index
		Theme.corner(star, 13)
		table.insert(_stars, star)
	end

	local promoteHintRow = row(30)
	_promoteHint = Theme.bodyText("PromoteHint", promoteHintRow, "")
	_promoteHint.Size = UDim2.fromScale(1, 1)

	local promoteRow = row(32)
	local promote = Theme.button("Promote", promoteRow, "Befoerdern", Theme.COLORS.goldGummy)
	promote.Size = UDim2.new(1, 0, 1, 0)
	_promoteButton = promote
	promote.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Remotes.RequestPromoteBaerchi:FireServer(uid)
	end)

	-- ------------------------------------------------------------ Battle Charms
	section("Battle Charms")

	local charmRow = row(30)
	local charmLayout = Theme.listLayout(charmRow, 4, true)
	charmLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	for slot = 1, CharmConfig.SLOT_COUNT do
		local tile = Theme.panel("Charm_" .. slot, charmRow, Theme.COLORS.disabled)
		tile.Size        = UDim2.new(0, 28, 0, 28)
		tile.LayoutOrder = slot
		Theme.corner(tile, 8)

		local letter = Theme.label("Letter", tile, "-")
		letter.Size           = UDim2.fromScale(1, 1)
		letter.TextXAlignment = Enum.TextXAlignment.Center
		letter.TextScaled     = false
		letter.TextSize       = 14

		table.insert(_charmSlots, { tile = tile, letter = letter })
	end

	local charmButtonRow = row(30)
	local charms = Theme.button("Charms", charmButtonRow, "Charms", Theme.COLORS.growth)
	charms.Size = UDim2.new(1, 0, 1, 0)
	_charmButton = charms
	charms.Activated:Connect(function()
		Unlock.markSeen("charms")
		local uid = _openUid
		if not uid then return end
		PanelManager.open("Charms", uid)
	end)

	-- ------------------------------------------------------------------- Werte
	column = rightColumn
	section("Zustand")

	-- HP-Balken (steht bewusst ueber dem XP-Balken: ob der Baerchi kaempfen
	-- kann, ist die haeufigere Frage als wie weit er zum naechsten Level ist)
	local hpRow = row(22)
	local hp = Theme.progress(hpRow)
	hp.track.Size = UDim2.new(1, 0, 1, 0)
	_hpFill = hp.fill
	_hpText = hp.text

	-- XP-Balken
	local xpRow = row(22)
	local xp = Theme.progress(xpRow)
	xp.track.Size = UDim2.new(1, 0, 1, 0)
	_xpFill = xp.fill
	_xpText = xp.text

	-- HBB Paket 4: Einzelwerte (ATK/SPD/PWR) und Stat-Stufen in einem
	-- Aufklapper. Der Kampfwert oben ist die eine Zahl, die man meistens
	-- braucht; wer es genau wissen will, klappt auf. Ohne UI_V2_UPGRADE_TAB
	-- bleibt alles offen wie bisher.
	local detailRows: { Frame } = {}
	local toggleRow = row(26)
	local toggle = Theme.button("DetailsToggle", toggleRow, "", Theme.COLORS.panelLight)
	toggle.Size = UDim2.fromScale(1, 1)
	toggle.TextColor3 = Theme.COLORS.text
	local expanded = not FeatureFlags.isOn("UI_V2_UPGRADE_TAB")
	toggleRow.Visible = not expanded
	local function applyDetails()
		toggle.Text = (if expanded then "▾  " else "▸  ") .. Loc.t("ui.card.details")
		for _, detail in detailRows do
			detail.Visible = expanded
		end
	end
	toggle.Activated:Connect(function()
		expanded = not expanded
		applyDetails()
	end)

	-- Kampfwerte
	local statsRow = row(22)
	table.insert(detailRows, statsRow)
	_statsLabel = Theme.label("Stats", statsRow, "—")
	_statsLabel.Size      = UDim2.fromScale(1, 1)
	_statsLabel.TextColor3 = Theme.COLORS.textDim

	-- ------------------------------------------------------------- Stat-Level
	local statHeader = row(16)
	table.insert(detailRows, statHeader)
	local statHeaderLabel = Theme.sectionLabel("Section", statHeader, "Stat-Stufen (Event-Teilnahme)")
	statHeaderLabel.Size = UDim2.fromScale(1, 1)

	for _, key in PromotionConfig.ALL_STATS do
		local statRow = row(20)
		table.insert(detailRows, statRow)
		local bar     = Theme.progress(statRow)
		bar.track.Size = UDim2.new(1, 0, 1, 0)
		bar.text.TextScaled = false
		bar.text.TextSize   = 13

		table.insert(_statRows, { key = key, fill = bar.fill, text = bar.text })
	end
	applyDetails()

	-- Skill
	section("Skill")
	local skillRow = row(40)
	_skillLabel = Theme.bodyText("Skill", skillRow, "—")
	_skillLabel.Size = UDim2.fromScale(1, 1)

	-- -------------------------------------------------------------------- Eier
	section("Eier legen")

	local eggRateRow = row(20)
	_eggRateLabel = Theme.label("EggRate", eggRateRow, "")
	_eggRateLabel.Size       = UDim2.fromScale(1, 1)
	_eggRateLabel.TextScaled = false
	_eggRateLabel.TextSize   = 14

	local eggChanceRow = row(20)
	_eggChanceLabel = Theme.label("EggChances", eggChanceRow, "")
	_eggChanceLabel.Size       = UDim2.fromScale(1, 1)
	_eggChanceLabel.TextScaled = false
	_eggChanceLabel.TextSize   = 13
	_eggChanceLabel.TextColor3 = Theme.COLORS.textDim

	local eggCountRow = row(18)
	_eggCountLabel = Theme.label("EggCount", eggCountRow, "")
	_eggCountLabel.Size       = UDim2.fromScale(1, 1)
	_eggCountLabel.TextScaled = false
	_eggCountLabel.TextSize   = 13

	local collectRow = row(30)
	local collect = Theme.button("CollectEggs", collectRow, "Alle Eier einsammeln", Theme.COLORS.goldGummy)
	collect.Size = UDim2.new(1, 0, 1, 0)
	_collectButton = collect
	collect.Activated:Connect(function()
		-- Ohne uid: der Server nimmt alles, was gerade herumliegt. Einzelne
		-- Eier sammelt man durch Anklicken in der Welt ein (WorldController).
		Remotes.RequestCollectAllEggs:FireServer()
	end)

	-- ----------------------------------------------------------------- Aktionen
	section("Aktionen")

	-- Verwertungs-Wert
	local valueRow = row(20)
	_valueLabel = Theme.label("Value", valueRow, "—")
	_valueLabel.Size       = UDim2.fromScale(1, 1)
	_valueLabel.TextColor3 = Theme.COLORS.textDim

	-- Ein Fuetter-Knopf pro Gebaeude statt eines einzigen: die drei liefern
	-- unterschiedlichen Honig, und welchen man verfuettert, ist seit v7 eine
	-- echte Entscheidung. Reihenfolge und Namen kommen aus MapConfig, die
	-- Farben aus Theme — dieselben wie auf den Karten im Gebaeude-Panel, damit
	-- man Knopf und Gebaeude sofort zusammenbringt.
	local feedHint = row(18)
	local hint = Theme.label("FeedHint", feedHint, "Fuettern — Honig aus dem Topf heilt am meisten")
	hint.Size       = UDim2.fromScale(1, 1)
	hint.TextColor3 = Theme.COLORS.textDim

	local feedRow = row(38)
	Theme.listLayout(feedRow, 6, true)

	for _, id in MapConfig.BUILDING_ORDER do
		-- Text und Verfuegbarkeit setzt fill() — hier steht nur ein Platzhalter,
		-- damit der Knopf nicht ohne Beschriftung aufblitzt.
		local button = Theme.button("Feed_" .. id, feedRow, "—", Theme.buildingColor(id))
		button.Size = UDim2.new(1 / 3, -6, 1, 0)

		button.Activated:Connect(function()
			local uid = _openUid
			if not uid then return end
			Remotes.RequestFeedHoney:FireServer(uid, id)
		end)

		_feedButtons[id] = button
	end

	-- Verwerten und Schliessen: beides beendet die Karte
	local exitRow = row(36)

	local recycle = Theme.button("Recycle", exitRow, "Verwerten", Theme.COLORS.panelLight)
	recycle.Size       = UDim2.new(1, 0, 1, 0)
	recycle.TextColor3 = Theme.COLORS.text
	_recycleButton = recycle
	recycle.Activated:Connect(function()
		Unlock.markSeen("recycling")
		local uid = _openUid
		if not uid then return end

		Remotes.RequestRecycleBaerchi:FireServer(uid)

		-- Sofort zumachen: bei Erfolg waere die Karte gleich leer, bei
		-- Ablehnung sagt es der Toast. Die Erfolgsmeldung kommt aus
		-- ResultFeed (RecycleResultReceived).
		BaerchiPanel.close()
	end)

	-- Schliessen
	local closeRow = row(34)
	local close = Theme.button("Close", closeRow, "Schliessen", Theme.COLORS.panelLight)
	close.Size       = UDim2.new(1, 0, 1, 0)
	close.TextColor3 = Theme.COLORS.text
	close.Activated:Connect(BaerchiPanel.close)

	_root = root

	PanelManager.register(PANEL_NAME, {
		open  = showInternal,
		close = closeInternal,
	})

	-- Offene Karte mitziehen: XP steigt im Kampf, und ein verwerteter oder
	-- fusionierter Baerchi existiert nicht mehr — dann zumachen.
	ClientState.onChanged(function()
		local uid = _openUid
		if not uid then return end

		local baerchi = ClientState.getBaerchi(uid)
		if baerchi then
			fill(baerchi)
		else
			BaerchiPanel.close()
		end
	end)

	Remotes.PromotionResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.PromotionResult

		if #typed.unlockedSlots > 0 then
			local numerals: { string } = {}
			for _, slot in typed.unlockedSlots do
				table.insert(numerals, CharmConfig.SLOT_NUMERALS[slot] or tostring(slot))
			end

			Notify.emit("promotion_slot", function()
				Toast.success(string.format(
					"Promotion %d/%d  —  Charm-Slot %s frei",
					typed.newPromotion, PromotionConfig.MAX_PROMOTION,
					table.concat(numerals, ", ")
				))
			end, function()
				Moment.show("slot", Theme.COLORS.goldGummy, "ui.moment.new")
			end)
		else
			Notify.emit("promotion", function()
				Toast.success(string.format(
					"Promotion %d/%d", typed.newPromotion, PromotionConfig.MAX_PROMOTION
				))
			end, function()
				Feedback.gain("star", typed.newPromotion)
			end)
		end
	end)

	Remotes.EggCollectedReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.EggCollectResult
		local def   = EggConfig.data[typed.eggType]

		-- Leere eggUid heisst "alles auf einmal" (siehe EggLayService.collectAll):
		-- dann steht in inStock die ANZAHL der eingesammelten Eier, nicht der
		-- Lagerbestand einer Sorte.
		-- Neuer Weg: das Ei fliegt ueber den Datenstand zur Eier-Kachel
		-- (UI/Feedback), deshalb hier nur der alte Text.
		if typed.eggUid == "merchant" then
			-- Kauf beim versteckten Haendler (EggMerchantService)
			Notify.emit("egg_bought", function()
				Toast.success(string.format("%s gekauft — liegt im Lager",
					if def then def.displayName else typed.eggType))
			end)
		elseif typed.eggUid == "" then
			Notify.emit("egg_collected_all", function()
				Toast.success(string.format("%d Eier eingesammelt", typed.inStock))
			end)
		else
			Notify.emit("egg_collected", function()
				Toast.success(string.format(
					"%s eingesammelt  (%d im Lager)",
					if def then def.displayName else typed.eggType,
					typed.inStock
				))
			end)
		end
	end)

	Remotes.OfflineEggReportReceived.OnClientEvent:Connect(function(report: any)
		if typeof(report) ~= "table" then return end
		local typed = report :: Types.OfflineEggReport

		Notify.emit("offline_eggs", function()
			Toast.success(string.format(
				"%d Eier waehrend deiner Abwesenheit gelegt%s",
				typed.laid,
				if typed.skipped then " (Platz war voll)" else ""
			))
		end, function()
			if typed.laid > 0 then
				ReturnSummary.addEggs(typed.secondsAway, typed.laid)
			end
		end)
	end)

	Remotes.EventStatGained.OnClientEvent:Connect(function(gain: any)
		if typeof(gain) ~= "table" then return end
		local typed = gain :: Types.EventStatGain

		-- Zwischenmeldung waehrend eines Events: nur der Text, kein "vorbei".
		if typed.midEvent then
			if typed.rarityUp then
				local rarity = typed.rarityUp :: string
				Notify.emit("event_mid_rarity", function()
					Toast.success(typed.bonusText or "")
				end, function()
					Moment.show("rarity", Theme.rarityColor(rarity :: any), "ui.moment.rarity")
				end)
			elseif typed.bonusText then
				local text = typed.bonusText :: string
				Notify.emit("event_mid", function()
					Toast.info(text)
				end)
			end
			return
		end

		-- Die Meldung wird aus bis zu zwei Teilen zusammengesetzt: Stat-Stufe
		-- und Bonus. Beide koennen einzeln fehlen — `statKey` ist nil, wenn
		-- schon jeder Stat am Rarity-Cap steht (dann gab es nur den Bonus),
		-- `bonusText` fehlt bei den reinen Trainings-Events. Deshalb hier
		-- zusammensetzen statt eines festen Satzes.
		local eventDef  = EventConfig.getById(typed.eventId)
		local eventName = if eventDef then eventDef.displayName else typed.eventId

		local parts: { string } = {}

		local statKey = typed.statKey
		if statKey then
			table.insert(parts, string.format(
				"%s Stufe %d / %d",
				PromotionConfig.STAT_LABELS[statKey] or statKey,
				typed.newLevel, typed.cap
			))
		end

		if typed.bonusText then
			table.insert(parts, typed.bonusText)
		end

		if #parts == 0 then
			table.insert(parts, "alle Stats stehen schon am Maximum")
		end

		-- HBB Paket 1: neuer Weg = Mutation als grosser Moment, Stat-Stufe
		-- als Zahl ueber dem Baerchi. Eier/Gummies des Bonus fliegen ueber
		-- den Datenstand (UI/Feedback).
		Notify.emit("event_end", function()
			Toast.success(string.format(
				"%s vorbei: %s",
				eventName,
				table.concat(parts, "  •  ")
			))
		end, function()
			local mutation = typed.mutation
			if mutation then
				Notify.emit("event_end_mutation", function() end, function()
					Moment.show("mutation", BaerchiConfig.getMutationColor(mutation), "ui.moment.mutation")
				end)
			end
			if statKey then
				Feedback.gain("stat", 1, nil, PromotionConfig.STAT_LABELS[statKey] or statKey)
			end
		end)
	end)

	print("[BaerchiPanel] Initialisiert")
end

return BaerchiPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX96"><Properties>
<string name="Name">BuildingPanel</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- BuildingPanel.luau
-- StarterPlayerScripts/UI/BuildingPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Fuer JEDES Honig-Gebaeude ein eigenes Menue bauen und aktuell halten
--
-- v15: zwei Gebaeude (Bienenstock, Honig-Veredler), Level 1-60 mit Look-Stufe
-- und Meilenstein-Faehigkeiten. Das fruehere Menue der Kampfplattform
-- (PIT-Level) ist entfallen — die Tower-Wahl liegt im CombatPanel. Der Recycler
-- wird an seinem eigenen Prompt ausgebaut (CombController).
--
-- ============================================================
-- WARUM EIGENE MENUES STATT EINER LISTE
-- ============================================================
-- Bis v7 gab es EIN Panel mit drei untereinander gestapelten Karten. Das war
-- richtig, solange die drei Gebaeude dasselbe taten — man wollte sie ja
-- vergleichen. Seit jedes eine eigene Rolle hat (Vorrat / Heilung / Wachstum,
-- siehe Config/BuildingBehavior), vergleicht man nicht mehr, sondern
-- entscheidet sich: "ich brauche jetzt Heilung". Dafuer will man EIN Fenster
-- sehen, das ganz diesem Gebaeude gehoert — mit seiner Farbe, seinem Level und
-- seinem Honig, gross statt in einer Zeile.
--
-- Trotzdem gibt es nur DIESE eine Datei: sie baut viermal dasselbe Geruest mit
-- unterschiedlichen Farben und Inhalten. Drei fast gleiche Panel-Module waeren
-- dieselbe Dopplung, die dieses Projekt an anderen Stellen schon aufgeloest
-- hat.
--
-- Jedes Menue meldet sich unter PanelManager.buildingPanelName(id) an. Diesen
-- Namen benutzen auch die Menueleiste und der Prompt am Gebaeude in der Welt —
-- deshalb steht er im PanelManager und nicht hier.
--
-- ============================================================
-- OHNE HINLAUFEN BEDIENBAR
-- ============================================================
-- Jedes Menue kann BEIDES: ausbauen und den ausgeruesteten Baerchi mit dem
-- Honig genau dieses Gebaeudes fuettern. Zusammen mit den Knoepfen in der
-- Menueleiste heisst das: der Spieler muss zu keinem Gebaeude mehr hinlaufen.
-- Die Prompts in der Welt bleiben trotzdem — wer davorsteht, soll es auch
-- dort anklicken koennen.
--
-- Dieses Modul rechnet nichts aus und formuliert nichts selbst: Effekt-Saetze
-- kommen aus BuildingBehavior, Preise aus EconomyConfig, Namen aus MapConfig,
-- Farben aus Theme. Ein hier nachgebauter Text waere beim naechsten Balancing
-- sofort falsch.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local MapConfig        = require(ReplicatedStorage.Config.MapConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local BuildingPanel = {}

-- Feste Reihenfolge. Die Gebaeude in IslandData liegen in einer Hash-Tabelle
-- und kommen damit nicht stabil heraus.
--
-- Nur die ids stehen hier: Name kommt aus MapConfig (dasselbe Schild traegt
-- ihn in der Welt), Farbe aus Theme.buildingColor (dieselbe faerbt die
-- Fuetter-Knoepfe auf der Baerchi-Karte).
local BUILDINGS: { { id: Types.BuildingId } } = {
	{ id = "Beehive"      },
	{ id = "HoneyRefiner" },
	{ id = "HoneyPond"    },
}

-- Alles, was ein einzelnes Menue zum Aktualisieren braucht.
type Menu = {
	root       : Frame,
	levelBadge : TextLabel,
	subLabel   : TextLabel,
	honeyFill  : Frame,
	honeyText  : TextLabel,
	nowText    : TextLabel,
	nextText   : TextLabel,
	priceText  : TextLabel,
	abilities  : TextLabel,
	upgrade    : TextButton,
	feed       : TextButton?,
}

local _menus: { [string]: Menu } = {}

--------------------------------------------------------------------------------
-- Hilfstexte
--------------------------------------------------------------------------------

local function displayName(buildingId: string): string
	local key = "building." .. buildingId .. ".name"
	if Loc.has(key) then
		return Loc.t(key)
	end
	local config = MapConfig.BUILDING_OFFSETS[buildingId]
	return if config then config.displayName else buildingId
end

-- v15: Meilenstein-Faehigkeiten als eine Zeile ("Lv.10 Auto-Abnahme ✓ ·
-- Lv.30 Goldene Tropfen (bald)").
local function abilitiesText(buildingId: string, level: number): string
	local parts: { string } = {}
	for _, ability in BuildingBehavior.getAbilities(buildingId) do
		local name = Loc.t("ability." .. ability.id)
		local state = if not ability.implemented then Loc.t("ui.ability.soon")
			elseif level >= ability.level then "✓"
			else ""
		table.insert(parts, string.format("Lv.%d %s %s", ability.level, name, state))
	end
	return table.concat(parts, "  ·  ")
end

local function priceText(costGummies: number, costGoldGummies: number): string
	local parts: { string } = {}

	if costGummies > 0 then
		table.insert(parts, Theme.formatNumber(costGummies) .. " Gummies")
	end
	if costGoldGummies > 0 then
		table.insert(parts, Theme.formatNumber(costGoldGummies) .. " GoldGummies")
	end
	if #parts == 0 then
		return "kostenlos"
	end

	return table.concat(parts, " + ")
end

local function canPay(data: Types.PlayerDataUpdate, costGummies: number, costGoldGummies: number): boolean
	if costGummies > 0 and data.gummies < costGummies then return false end
	if costGoldGummies > 0 and data.goldGummies < costGoldGummies then return false end
	return true
end

--------------------------------------------------------------------------------
-- Das Geruest eines Menues
--------------------------------------------------------------------------------

-- Baut ein Menue in der Farbe `accent`. `withFeed` legt zusaetzlich den
-- Fuetter-Knopf an — die Kampfplattform hat keinen Honig.
local function buildMenu(
	screenGui: ScreenGui,
	panelName: string,
	title: string,
	accent: Color3,
	withFeed: boolean,
	onUpgrade: () -> (),
	onFeed: (() -> ())?
): Menu
	local root = Theme.dialog(
		panelName, screenGui,
		Vector2.new(0.40, 0.62),
		Vector2.new(300, 400),
		Vector2.new(440, 520)
	)

	-- Der Rand des ganzen Fensters traegt die Gebaeudefarbe: schon bevor man
	-- liest, sieht man welches Gebaeude offen ist.
	local outline = root:FindFirstChildOfClass("UIStroke")
	if outline then
		outline.Color = Theme.shade(accent, -0.35)
	end

	--------------------------------------------------------------------------
	-- Kopfbalken mit Verlauf
	--------------------------------------------------------------------------

	local header = Theme.panel("Banner", root, accent)
	header.Size     = UDim2.new(1, 0, 0, 74)
	header.Position = UDim2.fromScale(0, 0)
	Theme.gradient(header, Theme.shade(accent, 0.30), Theme.shade(accent, -0.18))

	-- Rundes Emblem mit der Stufe darin. Zwei Fliegen: es macht den Kopf bunt
	-- UND beantwortet die haeufigste Frage ("auf welcher Stufe bin ich?"),
	-- ohne dass man Text lesen muss.
	local badge = Theme.panel("Badge", header, Theme.shade(accent, -0.30))
	badge.AnchorPoint = Vector2.new(0, 0.5)
	badge.Position    = UDim2.new(0, 12, 0.5, 0)
	badge.Size        = UDim2.new(0, 50, 0, 50)
	Theme.corner(badge, 25)

	local levelBadge = Theme.label("Level", badge, "1")
	levelBadge.Size           = UDim2.fromScale(1, 1)
	levelBadge.TextXAlignment = Enum.TextXAlignment.Center

	local titleLabel = Theme.label("Title", header, title)
	titleLabel.Position   = UDim2.new(0, 72, 0, 12)
	titleLabel.Size       = UDim2.new(1, -118, 0, 30)
	titleLabel.TextColor3 = Theme.COLORS.outline

	local subLabel = Theme.sectionLabel("Sub", header, "Stufe 1 von 10", Theme.shade(accent, -0.45))
	subLabel.Position = UDim2.new(0, 72, 0, 42)
	subLabel.Size     = UDim2.new(1, -118, 0, 20)

	local close = Theme.button("Close", header, "X", Theme.shade(accent, -0.30))
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position    = UDim2.new(1, -10, 0, 10)
	close.Size        = UDim2.new(0, 32, 0, 28)
	close.TextColor3  = Theme.COLORS.text
	close.Activated:Connect(function()
		PanelManager.close(panelName)
	end)

	--------------------------------------------------------------------------
	-- Inhalt
	--------------------------------------------------------------------------

	local body = Theme.container("Body", root)
	body.Position = UDim2.new(0, 0, 0, 74)
	body.Size     = UDim2.new(1, 0, 1, -74)
	Theme.padding(body, 14)

	local layout = Theme.listLayout(body, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local order = 0
	local function row(height: number): Frame
		order += 1
		local frame = Theme.container("Row", body)
		frame.Size        = UDim2.new(1, 0, 0, height)
		frame.LayoutOrder = order
		return frame
	end

	-- Honig-Balken: der Wert, den man beim Reinschauen zuerst sucht.
	local honeyHead = row(18)
	Theme.sectionLabel("HoneyHead", honeyHead, "Honig im Lager", accent).Size = UDim2.fromScale(1, 1)

	local honeyRow  = row(26)
	local honeyBar  = Theme.progress(honeyRow, accent)
	honeyBar.track.Size = UDim2.new(1, 0, 1, 0)

	-- Was das Gebaeude JETZT kann
	local nowHead = row(18)
	Theme.sectionLabel("NowHead", nowHead, "Was es kann", accent).Size = UDim2.fromScale(1, 1)

	local nowRow  = row(38)
	local nowText = Theme.bodyText("Now", nowRow, "")
	nowText.Size      = UDim2.fromScale(1, 1)
	nowText.TextColor3 = Theme.COLORS.text

	-- Was die naechste Stufe braechte
	local nextHead = row(18)
	Theme.sectionLabel("NextHead", nextHead, "Naechste Stufe", accent).Size = UDim2.fromScale(1, 1)

	local nextRow  = row(38)
	local nextText = Theme.bodyText("Next", nextRow, "")
	nextText.Size = UDim2.fromScale(1, 1)

	local priceRow   = row(22)
	local priceLabel = Theme.label("Price", priceRow, "")
	priceLabel.Size     = UDim2.fromScale(1, 1)
	priceLabel.TextSize = 16
	priceLabel.TextScaled = false

	-- v15: Meilenstein-Faehigkeiten dieses Gebaeudes
	local abilityRow  = row(30)
	local abilityText = Theme.bodyText("Abilities", abilityRow, "")
	abilityText.Size       = UDim2.fromScale(1, 1)
	abilityText.TextColor3 = Theme.COLORS.textDim

	-- Die Knoepfe ganz unten, in der Reihenfolge, in der man sie braucht.
	local upgradeRow = row(44)
	local upgrade    = Theme.bigButton("Upgrade", upgradeRow, "AUSBAUEN", accent)
	upgrade.Size = UDim2.new(1, 0, 1, 0)
	upgrade.Activated:Connect(onUpgrade)

	local feedButton: TextButton? = nil
	if withFeed and onFeed then
		local feedRow = row(38)
		local feed    = Theme.bigButton("Feed", feedRow, "Honig fuettern", Theme.shade(accent, -0.10))
		feed.Size = UDim2.new(1, 0, 1, 0)
		feed.Activated:Connect(onFeed)
		feedButton = feed
	end

	return {
		root       = root,
		levelBadge = levelBadge,
		subLabel   = subLabel,
		honeyFill  = honeyBar.fill,
		honeyText  = honeyBar.text,
		nowText    = nowText,
		nextText   = nextText,
		priceText  = priceLabel,
		abilities  = abilityText,
		upgrade    = upgrade,
		feed       = feedButton,
	}
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

local function refreshBuilding(buildingId: Types.BuildingId)
	local menu = _menus[PanelManager.buildingPanelName(buildingId)]
	if not menu or not menu.root.Visible then return end

	local data = ClientState.get()
	if not data then return end

	local building = data.island.buildings[buildingId]
	local level    = if building then building.level else 1
	local honey    = if building then (building.honey or 0) else 0
	local capacity = math.max(1, BuildingBehavior.getCapacity(buildingId, level))

	menu.levelBadge.Text = tostring(level)
	menu.subLabel.Text   = Loc.t("ui.building.level_look", {
		level = level, max = EconomyConfig.MAX_BUILDING_LEVEL, look = BuildingBehavior.getLook(level),
	})
	menu.abilities.Text  = abilitiesText(buildingId, level)

	menu.honeyFill.Size = UDim2.fromScale(math.clamp(honey / capacity, 0, 1), 1)
	menu.honeyText.Text = string.format("%d / %d", honey, capacity)

	menu.nowText.Text = BuildingBehavior.describeEffect(buildingId, level)

	local next_ = BuildingBehavior.getUpgrade(buildingId, level + 1)

	if next_ then
		local affordable = canPay(data, next_.costGummies, next_.costGoldGummies)

		menu.nextText.Text   = next_.effect
		menu.priceText.Text  = priceText(next_.costGummies, next_.costGoldGummies)
		menu.priceText.TextColor3 = if affordable then Theme.COLORS.good else Theme.COLORS.bad

		menu.upgrade.Text = "AUSBAUEN"
		Theme.setEnabled(menu.upgrade, affordable)
	else
		menu.nextText.Text        = "Hoechste Stufe erreicht."
		menu.priceText.Text       = ""
		menu.upgrade.Text         = "VOLL AUSGEBAUT"
		Theme.setEnabled(menu.upgrade, false)
	end

	local feed = menu.feed
	if feed then
		feed.Text = string.format("Fuettern  (%d Honig)", honey)
		Theme.setEnabled(feed, honey > 0 and data.island.equippedUid ~= nil)
	end
end

-- Oeffentlich, damit ClientState alle Menues auf einmal nachziehen kann.
function BuildingPanel.refresh()
	for _, entry in BUILDINGS do
		refreshBuilding(entry.id)
	end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function BuildingPanel.init(screenGui: ScreenGui)
	for _, entry in BUILDINGS do
		local id        = entry.id
		local panelName = PanelManager.buildingPanelName(id)

		local menu = buildMenu(
			screenGui, panelName, displayName(id), Theme.buildingColor(id), true,
			function()
				Remotes.RequestUpgradeBuilding:FireServer(id)
			end,
			function()
				-- Gefuettert wird immer der ausgeruestete Baerchi: nur der steht
				-- in der Welt, und nur er kaempft. Wer einen anderen meint,
				-- ruestet ihn erst aus — dieselbe Regel wie beim Autopiloten.
				local data = ClientState.get()
				local uid  = if data then data.island.equippedUid else nil
				if not uid then return end

				Remotes.RequestFeedHoney:FireServer(uid, id)
			end
		)

		_menus[panelName] = menu

		PanelManager.register(panelName, {
			open = function()
				menu.root.Visible = true
				refreshBuilding(id)
			end,
			close = function()
				menu.root.Visible = false
			end,
		})
	end

	ClientState.onChanged(function()
		BuildingPanel.refresh()
	end)

	print("[BuildingPanel] Initialisiert |", #BUILDINGS, "Gebaeude-Menues")
end

return BuildingPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX97"><Properties>
<string name="Name">CombatPanel</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- CombatPanel.luau
-- StarterPlayerScripts/UI/CombatPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die Tower-Wahl zeigen (v15): eine Karte pro Tower mit Look-Farbe,
--     Rekord, Deckel des aktuellen Rebirths und naechstem Meilenstein
--   - Nach einem Lauf eine kurze Ergebnis-Meldung zeigen (Toast), am Deckel den
--     Rebirth-Hinweis mit Knopf zum RebirthDialog, und Meilenstein-Toasts
--
-- Gestartet und zurueckgeholt wird weiterhin ueber den Fight-Knopf der unteren
-- Pet-Leiste (PetBar). Dieses Panel waehlt nur, WOHIN er schickt
-- (RequestSelectTower). Ob ein Tower offen ist, prueft der Server; die Karten
-- rechnen mit denselben Funktionen aus TowerConfig nur fuer die Anzeige.
--
-- Der Ergebnis-Listener haengt am Modul, nicht am Panel: ein Lauf soll seine
-- Meldung auch bringen, wenn das Panel zu ist.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local EggConfig   = require(ReplicatedStorage.Config.EggConfig)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local Moment       = require(script.Parent.Moment)
local PanelManager = require(script.Parent.PanelManager)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local Icons        = require(script.Parent.Icons)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local CombatPanel = {}

local PANEL_NAME   = "Combat"
local REBIRTH_PANEL = "Rebirth"
local CARD_HEIGHT  = 78

type Card = {
	frame  : Frame,
	stroke : UIStroke?,
	title  : TextLabel,
	info   : TextLabel,
	button : TextButton,
}

local _root: Frame?        = nil
local _info: TextLabel?    = nil
local _hint: Frame?        = nil
local _cards: { [string]: Card } = {}

-- HBB Paket 2: bezahlter Wiedereinstieg ab der letzten Stage als kleiner
-- Knopf (frueher eine Option im PitResumeDialog). Der kostenlose Einstieg
-- ab 65 % laeuft jetzt ohne Frage ueber den Fight-Knopf.
local _resume: TextButton? = nil
local _resumeHint: TextLabel? = nil

local function refreshResume(data: Types.PlayerDataUpdate)
	local button, hintText = _resume, _resumeHint
	if not button or not hintText then return end
	local reached = PitResumeDialog.getProgress(data)
	local towerId = if data.towers then data.towers.selected else TowerConfig.FIRST_TOWER
	local cost = if reached then TowerConfig.getResumeCost(towerId, reached, data.rebirthMult) else 0
	local show = FeatureFlags.isOn("UI_V2_GUIDE") and reached ~= nil and reached > 1 and cost > 0
	button.Visible = show
	hintText.Visible = not show
	if show then
		button.Text = string.format("⏩ %d   %s", reached :: number, Theme.formatNumber(cost))
		Theme.setEnabled(button, cost <= data.gummies)
	end
end

--------------------------------------------------------------------------------
-- Karten
--------------------------------------------------------------------------------

local function towerName(def: TowerConfig.TowerDef): string
	return Loc.t("tower." .. def.id .. ".name")
end

local function buildCard(parent: Instance, def: TowerConfig.TowerDef, order: number): Card
	local frame = Theme.panel("Tower_" .. def.id, parent, Theme.COLORS.panel)
	frame.Size        = UDim2.new(1, -8, 0, CARD_HEIGHT)
	frame.LayoutOrder = order

	-- Farbstreifen links in der Look-Farbe des Towers
	local stripe = Theme.panel("Stripe", frame, def.color)
	stripe.Size     = UDim2.new(0, 14, 1, -12)
	stripe.Position = UDim2.new(0, 6, 0, 6)

	local title = Theme.label("Title", frame, "")
	title.Position   = UDim2.new(0, 28, 0, 6)
	title.Size       = UDim2.new(1, -150, 0, 26)
	title.TextColor3 = Theme.shade(def.color, -0.1)
	Theme.outlineText(title)

	local info = Theme.bodyText("Info", frame, "")
	info.Position = UDim2.new(0, 28, 0, 34)
	info.Size     = UDim2.new(1, -150, 0, CARD_HEIGHT - 38)
	info.TextSize = 13

	local button = Theme.bigButton("Choose", frame, "", def.color)
	button.AnchorPoint = Vector2.new(1, 0.5)
	button.Position    = UDim2.new(1, -10, 0.5, 0)
	button.Size        = UDim2.new(0, 110, 0, 40)
	button.Activated:Connect(function()
		if not button.Active then return end
		Remotes.RequestSelectTower:FireServer(def.id)
	end)

	return {
		frame  = frame,
		stroke = frame:FindFirstChildOfClass("UIStroke"),
		title  = title,
		info   = info,
		button = button,
	}
end

local function refreshCard(card: Card, def: TowerConfig.TowerDef, data: Types.PlayerDataUpdate)
	local towers = data.towers
	local record = if towers then towers.records[def.id] or 0 else 0
	local cap    = TowerConfig.getStageCap(data.rebirthCount, def.id, if towers then towers.records else nil)
	local open   = cap > 0
	local selected = towers ~= nil and towers.selected == def.id
	local endless = def.id == "Endless"   -- HBB Paket 9: ohne Obergrenze

	card.title.Text = if endless then towerName(def) else string.format("%s  (%d)", towerName(def), def.stages)

	if open then
		local claimed = if towers then towers.claimed[def.id] else nil
		local nextStage = TowerConfig.nextMilestoneStage(def.id, claimed, record + 1)
		local lines = {
			if endless
				then Loc.t("ui.tower.record_endless", { record = record })
				else Loc.t("ui.tower.record_cap", { record = record, cap = cap, stages = def.stages }),
		}
		if nextStage then
			table.insert(lines, Loc.t("ui.tower.next_milestone", { stage = nextStage }))
		end
		card.info.Text = table.concat(lines, "\n")
		card.button.Text = if selected then Loc.t("ui.tower.selected") else Loc.t("ui.tower.choose")
		Theme.setEnabled(card.button, not selected)
	else
		card.info.Text = if endless
			then Loc.t("ui.tower.locked_endless")
			else Loc.t("ui.tower.locked", { rebirths = TowerConfig.getOpeningRebirth(def.id) })
		card.button.Text = Loc.t("ui.tower.locked_short")
		Theme.setEnabled(card.button, false)
	end

	local stroke = card.stroke
	if stroke then
		stroke.Color     = if selected then Theme.COLORS.good else Theme.COLORS.outline
		stroke.Thickness = if selected then Theme.OUTLINE_THICKNESS + 2 else Theme.OUTLINE_THICKNESS
	end
end

function CombatPanel.refresh()
	local root = _root
	if not root or not root.Visible then return end

	local data = ClientState.get()
	if not data then return end

	local capTower, capStage = TowerConfig.getCap(data.rebirthCount)
	local capDef = TowerConfig.get(capTower) or TowerConfig.TOWERS[1]
	local info = _info
	if info then
		info.Text = Loc.t("ui.tower.cap_line", { rebirths = data.rebirthCount, tower = towerName(capDef), stage = capStage })
	end

	refreshResume(data)

	for _, def in TowerConfig.TOWERS do
		local card = _cards[def.id]
		if card then refreshCard(card, def, data) end
	end
end

--------------------------------------------------------------------------------
-- Ergebnis des Laufs
--------------------------------------------------------------------------------

local function showCapHint(result: Types.PitRunResult)
	local hint = _hint
	if not hint then return end
	local label = hint:FindFirstChild("Text")
	if label and label:IsA("TextLabel") then
		label.Text = Loc.t("ui.tower.cap_reached", { stage = result.capStage or 0 })
	end
	hint.Visible = true
	task.delay(12, function()
		hint.Visible = false
	end)
end

local function showResult(result: Types.PitRunResult)
	local cleared = result.stagesCleared or 0
	local def = TowerConfig.get(result.towerId or "") or TowerConfig.TOWERS[1]
	local parts = {
		"Tower " .. def.numeral,
		Loc.tn("msg.tower_cleared", cleared),
		"+" .. Theme.formatNumber(result.gummiesWon or 0) .. " Gummies",
	}
	if (result.goldGummiesWon or 0) > 0 then
		table.insert(parts, "+" .. Theme.formatNumber(result.goldGummiesWon) .. " GoldGummies")
	end
	if result.newRecord then
		table.insert(parts, Loc.t("msg.tower_new_record", { stage = result.newRecord }))
	end
	if result.recalled then
		table.insert(parts, Loc.t("msg.tower_recalled"))
	end

	local text = table.concat(parts, "  •  ")
	-- Gummies/GoldGummies fliegen ueber den Datenstand (UI/Feedback); der
	-- neue Rekord ist der Moment, den man sehen soll.
	Notify.emit("tower_result", function()
		if cleared > 0 then Toast.success(text) else Toast.info(text) end
	end, function()
		if result.newRecord then
			Notify.emit("tower_record", function() end, function()
				Moment.show("record", Theme.COLORS.goldGummy, "ui.moment.record")
			end)
		end
	end)

	if result.capReached then
		showCapHint(result)
	end
end

local function showMilestone(reward: Types.TowerMilestoneReward)
	local def = TowerConfig.get(reward.towerId) or TowerConfig.TOWERS[1]
	local parts: { string } = {}
	if reward.gummies > 0 then table.insert(parts, "+" .. Theme.formatNumber(reward.gummies) .. " Gummies") end
	if reward.goldGummies > 0 then table.insert(parts, "+" .. Theme.formatNumber(reward.goldGummies) .. " GoldGummies") end
	if reward.eggType and reward.eggs > 0 then
		local egg = EggConfig.data[reward.eggType]
		table.insert(parts, string.format("+%d %s", reward.eggs, Loc.name("egg." .. reward.eggType .. ".name", if egg then egg.displayName else reward.eggType)))
	end
	if reward.blueprints > 0 then table.insert(parts, Loc.t("msg.tower_blueprint")) end
	if (reward.endlessLevels or 0) > 0 then
		table.insert(parts, Loc.t("msg.tower_endless_level", { n = reward.endlessLevels or 0 }))
	end
	Notify.emit("tower_milestone", function()
		Toast.success(Loc.t("msg.tower_milestone", { tower = def.numeral, stage = reward.stage, reward = table.concat(parts, ", ") }))
	end, function()
		Moment.show("milestone", Theme.COLORS.goldGummy, "ui.moment.milestone")
	end)
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local root = _root
	if not root then return end

	root.Visible = true
	CombatPanel.refresh()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function CombatPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"CombatPanel", screenGui,
		Vector2.new(0.50, 0.70),
		Vector2.new(320, 420),
		Vector2.new(560, 600)
	)
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.tower.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	local info = Theme.bodyText("Info", body, "")
	info.Size = UDim2.new(1, -8, 0, 34)
	_info = info

	local scroller = Theme.scroller("List", body)
	scroller.Position = UDim2.new(0, 0, 0, 38)
	scroller.Size     = UDim2.new(1, 0, 1, -84)

	local layout = Theme.listLayout(scroller, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	for order, def in TowerConfig.TOWERS do
		_cards[def.id] = buildCard(scroller, def, order)
	end

	local hintText = Theme.bodyText("Hint", body, Loc.t("ui.tower.hint"))
	hintText.AnchorPoint = Vector2.new(0.5, 1)
	hintText.Position    = UDim2.new(0.5, 0, 1, 0)
	hintText.Size        = UDim2.new(1, -8, 0, 40)
	_resumeHint = hintText

	local resume = Theme.bigButton("ResumeLast", body, "", Theme.COLORS.goldGummy)
	resume.AnchorPoint = Vector2.new(0.5, 1)
	resume.Position    = UDim2.new(0.5, 0, 1, -2)
	resume.Size        = UDim2.new(0, 200, 0, 40)
	resume.Visible     = false
	if Icons.has("gummy") then
		local coin = Icons.make(resume, "gummy")
		coin.AnchorPoint = Vector2.new(1, 0.5)
		coin.Position    = UDim2.new(1, -6, 0.5, 0)
		coin.Size        = UDim2.fromOffset(28, 28)
		coin.ZIndex      = 4
	end
	resume.Activated:Connect(function()
		if not resume.Active then return end
		Remotes.RequestPetMode:FireServer("Fight", "Last")
		PanelManager.close(PANEL_NAME)
	end)
	_resume = resume

	-- Rebirth-Hinweis am Deckel: eigenes kleines Fenster unten in der Mitte,
	-- unabhaengig davon, ob das Panel offen ist.
	local hint = Theme.panel("CapHint", screenGui, Theme.COLORS.panel)
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position    = UDim2.new(0.5, 0, 1, -110)
	hint.Size        = UDim2.fromOffset(420, 70)
	hint.Visible     = false
	hint.ZIndex      = 15
	_hint = hint

	local hintLabel = Theme.bodyText("Text", hint, "")
	hintLabel.Position = UDim2.new(0, 10, 0, 8)
	hintLabel.Size     = UDim2.new(1, -140, 1, -16)
	hintLabel.TextColor3 = Theme.COLORS.text

	local rebirthButton = Theme.bigButton("Rebirth", hint, Loc.t("ui.tower.to_rebirth"), Theme.COLORS.goldGummy)
	rebirthButton.AnchorPoint = Vector2.new(1, 0.5)
	rebirthButton.Position    = UDim2.new(1, -10, 0.5, 0)
	rebirthButton.Size        = UDim2.new(0, 116, 0, 44)
	rebirthButton.Activated:Connect(function()
		hint.Visible = false
		PanelManager.open(REBIRTH_PANEL)
	end)

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	ClientState.onChanged(function()
		CombatPanel.refresh()
	end)

	Loc.onChanged(function()
		CombatPanel.refresh()
	end)

	Remotes.CombatResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.PitRunResult

		-- Auf dem Hinweg zurueckgeholt: es gab keinen Kampf.
		if typed.recalled and (typeof(typed.stages) ~= "table" or #typed.stages == 0) then
			return
		end

		showResult(typed)
	end)

	Remotes.TowerMilestoneReceived.OnClientEvent:Connect(function(reward: any)
		if typeof(reward) ~= "table" then return end
		showMilestone(reward :: Types.TowerMilestoneReward)
	end)

	print("[CombatPanel] Initialisiert |", #TowerConfig.TOWERS, "Tower")
end

return CombatPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX98"><Properties>
<string name="Name">DailyBonusPanel</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- DailyBonusPanel.luau
-- StarterPlayerScripts/UI/DailyBonusPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Das Fenster des taeglichen Login-Bonus (v15): sieben Felder (heutiges
--     hervorgehoben, abgeholte abgehakt, kommende grau) und der Abholen-Knopf.
--
-- Oeffnet sich beim Join von selbst, wenn heute noch nicht abgeholt ist (der
-- Server liefert die Sicht im PlayerDataUpdate: Types.DailyView). Ob abgeholt
-- werden darf, entscheidet der Server (RequestClaimDailyBonus).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local LoginBonusConfig = require(ReplicatedStorage.Config.LoginBonusConfig)
local FeatureFlags     = require(ReplicatedStorage.Config.FeatureFlags)
local GuideSteps       = require(ReplicatedStorage.Modules.GuideSteps)

local TweenService = game:GetService("TweenService")

local Theme        = require(script.Parent.Theme)
local Icons        = require(script.Parent.Icons)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local DailyBonusPanel = {}

local PANEL_NAME = "DailyBonus"

local _root: Frame? = nil
local _cells: { Frame } = {}
local _pulses: { [Frame]: Tween } = {}
local _claim: TextButton? = nil
local _status: TextLabel? = nil
local _autoOpened = false

-- Playtest 05.10.: statt reiner Textzeilen je Tag ein grosses Icon, eine
-- grosse Zahl und die Extras klein darunter. Hauptbild: Tag 7 Geschenk,
-- sonst Gummies, sonst Ei.
local function dayVisual(day: number): (string, string, string)
	local reward = LoginBonusConfig.getDay(day)
	local extras: { string } = {}
	if reward.eggs and reward.eggType then table.insert(extras, string.format("+%d %s", reward.eggs, Loc.t("ui.daily.egg"))) end
	if reward.highestEgg then table.insert(extras, Loc.t("ui.daily.best_egg")) end
	if reward.blueprintChance then table.insert(extras, Loc.t("ui.daily.blueprint_chance", { pct = math.floor(reward.blueprintChance * 100 + 0.5) })) end
	if reward.goldGummies then table.insert(extras, "+" .. Loc.formatNumber(reward.goldGummies) .. " GG") end

	local icon = if day == LoginBonusConfig.CYCLE_DAYS then "gift"
		elseif reward.gummies then "gummy"
		elseif reward.eggType then "egg"
		else "goldgummy"
	local amount = if reward.gummies then Theme.formatNumber(reward.gummies)
		elseif reward.eggs then string.format("%dx", reward.eggs)
		elseif reward.goldGummies then Loc.formatNumber(reward.goldGummies)
		else ""
	return icon, amount, table.concat(extras, "\n")
end

local function refresh()
	local data = ClientState.get()
	local view: Types.DailyView? = if data then data.daily else nil
	if not view then return end

	for day, cell in _cells do
		local done = day <= view.streak and not (view.claimable and day == view.day)
		local today = day == view.day
		local claimed = done or (today and not view.claimable)
		local open = today and view.claimable
		cell.BackgroundColor3 = if open then Theme.COLORS.goldGummy
			elseif claimed then Theme.COLORS.good
			elseif day == LoginBonusConfig.CYCLE_DAYS then Theme.shade(Theme.COLORS.goldGummy, -0.35)
			else Theme.COLORS.panelLight

		local mark = cell:FindFirstChild("Mark")
		if mark and mark:IsA("GuiObject") then
			mark.Visible = claimed
		end
		local stroke = cell:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if open then Color3.fromRGB(255, 245, 190) else Theme.COLORS.outline
			stroke.Thickness = if open then 4 else Theme.OUTLINE_THICKNESS
		end
		-- Kommende Tage etwas gedaempft, damit "heute" heraussticht
		local icon = cell:FindFirstChild("Icon", true)
		if icon and icon:IsA("ImageLabel") then
			icon.ImageTransparency = if claimed or open then 0 else 0.25
		end
		local pulse = _pulses[cell]
		if pulse then
			if open then pulse:Play() else
				pulse:Cancel()
				local scale = cell:FindFirstChildOfClass("UIScale")
				if scale then scale.Scale = 1 end
			end
		end
	end

	local claim, status = _claim, _status
	if claim then
		claim.Text = if view.claimable then Loc.t("ui.daily.claim", { day = view.day }) else Loc.t("ui.daily.claimed")
		Theme.setEnabled(claim, view.claimable)
	end
	if status then
		status.Text = Loc.t("ui.daily.reset_in", { time = Loc.formatDuration(view.resetIn) })
	end

	-- HBB Paket 2: ein Konto, das an diesem UTC-Tag angelegt wurde, sieht
	-- in den ersten Minuten kein Popup. Das Fenster kommt erst nach dem
	-- ersten beendeten Kampf (dann aendern sich die Daten und refresh
	-- laeuft erneut). Server-Logik unveraendert, nur der Zeitpunkt.
	if view.claimable and not _autoOpened and FeatureFlags.isOn("UI_V2_GUIDE") and data then
		local createdAt = (data :: any).createdAt
		local today = math.floor(workspace:GetServerTimeNow() / 86400)
		local createdToday = typeof(createdAt) == "number" and math.floor(createdAt / 86400) == today
		if createdToday and not GuideSteps.hasFought(data :: any) then
			return
		end
	end

	-- Beim Join einmal von selbst oeffnen, wenn noch nicht abgeholt.
	if view.claimable and not _autoOpened then
		_autoOpened = true
		task.delay(2, function()
			PanelManager.open(PANEL_NAME)
		end)
	end
end

function DailyBonusPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog("DailyBonusPanel", screenGui, Vector2.new(0.6, 0.46), Vector2.new(340, 280), Vector2.new(680, 380))
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.daily.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	local row = Theme.container("Days", body)
	row.Size = UDim2.new(1, 0, 0.62, 0)
	local layout = Theme.listLayout(row, 6, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	for day = 1, LoginBonusConfig.CYCLE_DAYS do
		local cell = Theme.panel("Day" .. day, row, Theme.COLORS.disabled)
		cell.Size = UDim2.new(1 / LoginBonusConfig.CYCLE_DAYS, -6, 1, 0)
		cell.LayoutOrder = day

		local iconName, amount, extra = dayVisual(day)
		local isBig = day == LoginBonusConfig.CYCLE_DAYS

		local head = Theme.label("Head", cell, Loc.t("ui.daily.day", { day = day }))
		head.Position = UDim2.new(0, 4, 0, 4)
		head.Size = UDim2.new(1, -8, 0, 18)
		head.TextXAlignment = Enum.TextXAlignment.Center

		-- Hauptgewinn: Krone ueber dem Tag-7-Feld
		if isBig then
			local crown = Icons.make(cell, "crown", "♛")
			crown.Name = "Crown"
			crown.AnchorPoint = Vector2.new(0.5, 0.5)
			crown.Position = UDim2.new(0.5, 0, 0, -4)
			crown.Size = UDim2.fromOffset(30, 30)
			crown.ZIndex = 4
		end

		local holder = Instance.new("Frame")
		holder.Name = "IconHolder"
		holder.BackgroundTransparency = 1
		holder.AnchorPoint = Vector2.new(0.5, 0)
		holder.Position = UDim2.new(0.5, 0, 0, 26)
		holder.Size = UDim2.new(if isBig then 0.95 else 0.8, 0, 0.38, 0)
		holder.Parent = cell
		local icon = Icons.make(holder, iconName, "★")
		icon.Size = UDim2.fromScale(1, 1)

		local amountLabel = Theme.label("Amount", cell, amount)
		amountLabel.AnchorPoint = Vector2.new(0.5, 0)
		amountLabel.Position = UDim2.new(0.5, 0, 0.38, 30)
		amountLabel.Size = UDim2.new(1, -6, 0, 22)
		amountLabel.TextXAlignment = Enum.TextXAlignment.Center

		local text = Theme.bodyText("Reward", cell, extra)
		text.Position = UDim2.new(0, 3, 0.38, 54)
		text.Size = UDim2.new(1, -6, 0.62, -58)
		text.TextSize = 11
		text.TextColor3 = Theme.COLORS.text
		text.TextXAlignment = Enum.TextXAlignment.Center

		-- Abgeholt: Haken oben rechts
		local mark = Icons.make(cell, "check", "✓")
		mark.Name = "Mark"
		mark.AnchorPoint = Vector2.new(1, 0)
		mark.Position = UDim2.new(1, 4, 0, -6)
		mark.Size = UDim2.fromOffset(24, 24)
		mark.ZIndex = 4
		mark.Visible = false

		-- Heute abholbar: sanftes Pulsieren
		local scale = Instance.new("UIScale")
		scale.Parent = cell
		_pulses[cell] = TweenService:Create(scale,
			TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.06 })

		table.insert(_cells, cell)
	end

	local claim = Theme.bigButton("Claim", body, "", Theme.COLORS.good)
	claim.AnchorPoint = Vector2.new(0.5, 1)
	claim.Position = UDim2.new(0.5, 0, 1, -22)
	claim.Size = UDim2.new(0.6, 0, 0, 40)
	claim.Activated:Connect(function()
		if not claim.Active then return end
		Remotes.RequestClaimDailyBonus:FireServer()
	end)
	_claim = claim

	local status = Theme.bodyText("Status", body, "")
	status.AnchorPoint = Vector2.new(0.5, 1)
	status.Position = UDim2.new(0.5, 0, 1, 0)
	status.Size = UDim2.new(1, 0, 0, 18)
	status.TextXAlignment = Enum.TextXAlignment.Center
	_status = status

	PanelManager.register(PANEL_NAME, {
		open = function()
			root.Visible = true
			refresh()
		end,
		close = function()
			root.Visible = false
		end,
	})

	ClientState.onChanged(function()
		refresh()
	end)

	Remotes.DailyBonusReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.DailyBonusResult
		local parts: { string } = {}
		if typed.gummies > 0 then table.insert(parts, "+" .. Loc.formatNumber(typed.gummies) .. " Gummies") end
		if typed.goldGummies > 0 then table.insert(parts, "+" .. Loc.formatNumber(typed.goldGummies) .. " GoldGummies") end
		if typed.eggs > 0 and typed.eggType then
			table.insert(parts, string.format("+%d %s", typed.eggs, Loc.name("egg." .. typed.eggType .. ".name", typed.eggType)))
		end
		if typed.blueprint then table.insert(parts, Loc.t("msg.tower_blueprint")) end
		-- Inhalte (Gummies, GoldGummies, Eier) fliegen ueber den Datenstand.
		Notify.emit("daily_claimed", function()
			Toast.success(Loc.t("msg.daily_claimed", { day = typed.day, reward = table.concat(parts, ", ") }))
		end)
	end)

	print("[DailyBonusPanel] Initialisiert")
end

return DailyBonusPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX99"><Properties>
<string name="Name">EggTreePanel</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- EggTreePanel.luau
-- StarterPlayerScripts/UI/EggTreePanel.luau
--
-- v14 (Mega Egg Tree, WP5): das Ei-Baum-Fenster.
--
-- Links der Baum: 20 Knoten in Pfad-Reihen, Linien zwischen Vorgaenger und
-- Nachfolger. Freie Knoten in ihrer Ei-Farbe, gesperrte abgedunkelt mit
-- Schloss, "bereit" (alle Bedingungen erfuellt) leuchtend umrandet.
--
-- Rechts die Detail-Karte des gewaehlten Knotens: was ihm noch fehlt
-- (Fortschrittsbalken je Bedingung), was herausfaellt (Drop-Vorschau mit
-- Chancen), wie viele im Lager liegen, und drei Aktionen: Oeffnen, Pressen
-- (5 -> 1 der naechsten Stufe), Blaupause einsetzen.
--
-- Die Bedingungen rechnet Modules/EggTree — dieselbe Funktion, die der
-- Server zum Freischalten benutzt. Das Panel kann also nie etwas anderes
-- anzeigen, als der Server tut. Es aktualisiert sich live ueber ClientState.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local Loc             = require(ReplicatedStorage.Localization.Loc)
local EggConfig       = require(ReplicatedStorage.Config.EggConfig)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local EggTree         = require(ReplicatedStorage.Modules.EggTree)
local IndexCalculator = require(ReplicatedStorage.Modules.IndexCalculator)

local Theme          = require(script.Parent.Theme)
local EggIcon = require(script.Parent.EggIcon)
local PanelManager   = require(script.Parent.PanelManager)
local HatchAnimation = require(script.Parent.HatchAnimation)
local ClientState    = require(script.Parent.Parent.Controllers.ClientState)

local EggTreePanel = {}

local PANEL_NAME = "EggTree"
EggTreePanel.PANEL_NAME = PANEL_NAME

local NODE_W   = 112
local NODE_H   = 64
local STEP_X   = 132
local STEP_Y   = 84
local MARGIN   = 18
local DETAIL_W = 270

-- Position (Spalte, Zeile) jedes Knotens im Raster. Folgt dem Bild aus dem
-- Konzept: Stamm oben links, drei Pfade darunter, Kosmos rechts in der
-- Mitte, Ascension als eigene Reihe unten.
local LAYOUT: { [string]: { col: number, row: number } } = {
	BasicEgg         = { col = 0, row = 0 },
	SugarEgg         = { col = 1, row = 0 },
	GoldenEgg        = { col = 2, row = 1 },
	PlatinumEgg      = { col = 3, row = 1 },
	SunEgg           = { col = 4, row = 1 },
	ZenithEgg        = { col = 5, row = 1 },
	CrystalEgg       = { col = 3, row = 2 },
	PrismEgg         = { col = 4, row = 2 },
	AuroraEgg        = { col = 5, row = 2 },
	MistEgg          = { col = 2, row = 3 },
	VoidEgg          = { col = 3, row = 3 },
	ShadowEgg        = { col = 4, row = 3 },
	AbyssEgg         = { col = 5, row = 3 },
	CometEgg         = { col = 6, row = 2 },
	NovaEgg          = { col = 7, row = 2 },
	GalaxyEgg        = { col = 8, row = 2 },
	AscensionEgg     = { col = 1, row = 4.4 },
	TranscendenceEgg = { col = 2, row = 4.4 },
	EternityEgg      = { col = 3, row = 4.4 },
	OmegaEgg         = { col = 4, row = 4.4 },
}

-- Reihen-Beschriftung links (Pfad und sein Ziel).
local ROW_LABELS: { { row: number, path: string } } = {
	{ row = 0,   path = "Stamm" },
	{ row = 1,   path = "Gold" },
	{ row = 2,   path = "Kristall" },
	{ row = 3,   path = "Void" },
	{ row = 4.4, path = "Ascension" },
}

local _root: Frame?            = nil
local _canvas: ScrollingFrame? = nil
local _detail: ScrollingFrame? = nil
local _header: TextLabel?      = nil
local _selected: Types.EggType = "BasicEgg"
local _nodes: { [string]: { frame: Frame, stroke: UIStroke, lock: TextLabel, count: TextLabel, name: TextLabel } } = {}

local function nodeCenter(eggId: string): Vector2
	local p = LAYOUT[eggId]
	return Vector2.new(MARGIN + 70 + p.col * STEP_X + NODE_W / 2, MARGIN + p.row * STEP_Y + NODE_H / 2)
end

local function eggName(eggId: string): string
	local def = EggConfig.data[eggId :: Types.EggType]
	return Loc.name("egg." .. eggId .. ".name", def and def.displayName or eggId)
end

local function rarityName(rarity: string): string
	return Loc.name("rarity." .. rarity, rarity)
end

--------------------------------------------------------------------------------
-- Linien
--------------------------------------------------------------------------------

local function line(parent: Instance, a: Vector2, b: Vector2, color: Color3, thickness: number)
	local d = b - a
	local len = d.Magnitude
	local f = Instance.new("Frame")
	f.Name = "Edge"
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
	f.Size = UDim2.fromOffset(len, thickness)
	f.Rotation = math.deg(math.atan2(d.Y, d.X))
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.ZIndex = 11
	f.Parent = parent
end

--------------------------------------------------------------------------------
-- Baum aufbauen (einmalig)
--------------------------------------------------------------------------------

local function buildTree(canvas: ScrollingFrame)
	local maxCol, maxRow = 0, 0
	for _, p in LAYOUT do
		maxCol = math.max(maxCol, p.col)
		maxRow = math.max(maxRow, p.row)
	end
	canvas.CanvasSize = UDim2.fromOffset(MARGIN * 2 + 70 + (maxCol + 1) * STEP_X, MARGIN * 2 + (maxRow + 1) * STEP_Y)

	for _, rl in ROW_LABELS do
		local label = Theme.label("Row_" .. rl.path, canvas, Loc.name("path." .. rl.path, rl.path))
		label.Position = UDim2.fromOffset(4, MARGIN + rl.row * STEP_Y + 8)
		label.Size = UDim2.fromOffset(74, 22)
		label.TextColor3 = BaerchiConfig.getPathColor(rl.path)
		label.ZIndex = 12
		local goal = Theme.bodyText("Goal", canvas, Loc.name("path." .. rl.path .. ".goal", ""))
		goal.Position = UDim2.fromOffset(4, MARGIN + rl.row * STEP_Y + 30)
		goal.Size = UDim2.fromOffset(74, 32)
		goal.TextSize = 11
		goal.ZIndex = 12
	end

	-- Kanten zuerst (liegen unter den Knoten).
	for eggId, def in EggConfig.data do
		if def.parent and LAYOUT[def.parent] then
			line(canvas, nodeCenter(def.parent), nodeCenter(eggId), Theme.COLORS.panelLight, 3)
		end
	end
	local comet = EggConfig.TREE.CometEgg
	if comet and comet.hatchAnyOf then
		for _, req in comet.hatchAnyOf.of do
			line(canvas, nodeCenter(req.egg), nodeCenter("CometEgg"), BaerchiConfig.getPathColor("Kosmos"), 2)
		end
	end

	for eggId, def in EggConfig.data do
		-- Sonder-Eier (EggConfig: special) haben keinen Platz im Baum.
		if not LAYOUT[eggId] then continue end
		local c = nodeCenter(eggId)
		local frame = Theme.panel("Node_" .. eggId, canvas, Theme.COLORS.panel)
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromOffset(c.X, c.Y)
		frame.Size = UDim2.fromOffset(NODE_W, NODE_H)
		frame.ZIndex = 13
		local stroke = frame:FindFirstChildOfClass("UIStroke") :: UIStroke

		local swatch = EggIcon.make(frame, eggId, 38, 14)
		swatch.AnchorPoint = Vector2.new(0, 0.5)
		swatch.Position = UDim2.new(0, 6, 0.5, 0)

		local name = Theme.label("Name", frame, eggName(eggId))
		name.Position = UDim2.fromOffset(42, 6)
		name.Size = UDim2.new(1, -46, 0, 22)
		name.ZIndex = 14

		local count = Theme.label("Count", frame, "")
		count.Position = UDim2.fromOffset(42, 32)
		count.Size = UDim2.new(1, -46, 0, 20)
		count.TextColor3 = Theme.COLORS.good
		count.ZIndex = 14

		local lock = Theme.label("Lock", frame, "")
		lock.AnchorPoint = Vector2.new(1, 0)
		lock.Position = UDim2.new(1, -4, 0, 2)
		lock.Size = UDim2.fromOffset(40, 16)
		lock.TextXAlignment = Enum.TextXAlignment.Right
		lock.TextColor3 = Theme.COLORS.textDim
		lock.ZIndex = 15

		local click = Instance.new("TextButton")
		click.Name = "Click"
		click.BackgroundTransparency = 1
		click.Text = ""
		click.Size = UDim2.fromScale(1, 1)
		click.ZIndex = 16
		click.Parent = frame
		click.Activated:Connect(function()
			_selected = eggId
			EggTreePanel.refresh()
		end)

		_nodes[eggId] = { frame = frame, stroke = stroke, lock = lock, count = count, name = name }
	end
end

--------------------------------------------------------------------------------
-- Detail-Karte
--------------------------------------------------------------------------------

local function conditionText(c: EggTree.Condition): string
	if c.kind == "hatch" then
		return Loc.t("ui.tree.cond_hatch", { egg = eggName(c.egg :: string), have = c.have, need = c.need })
	elseif c.kind == "hatchAny" then
		return Loc.t("ui.tree.cond_any", { have = c.have, need = c.need })
	elseif c.kind == "index" then
		return Loc.t("ui.tree.cond_index", { rarity = rarityName(c.rarity :: string), have = c.have, need = c.need })
	elseif c.kind == "rebirth" then
		return Loc.t("ui.tree.cond_rebirth", { have = c.have, need = c.need })
	elseif c.kind == "blueprint" then
		return Loc.t("ui.tree.cond_blueprint")
	end
	return c.kind
end

local function addRow(parent: Instance, order: number, height: number): Frame
	local row = Theme.container("Row" .. order, parent)
	row.Size = UDim2.new(1, -8, 0, height)
	row.LayoutOrder = order
	return row
end

local function buildDetail(detail: ScrollingFrame, data: Types.PlayerDataUpdate)
	for _, child in detail:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	local eggId = _selected
	local def = EggConfig.data[eggId]
	if not def then return end
	local progress = EggTree.getProgress(data, eggId)
	local stock = data.island.eggStock[eggId] or 0
	local order = 0
	local function nextOrder(): number order += 1 return order end

	local title = Theme.label("Title", addRow(detail, nextOrder(), 28), eggName(eggId))
	title.Size = UDim2.fromScale(1, 1)
	title.TextColor3 = def.color
	Theme.outlineText(title)

	local sub = Theme.bodyText("Sub", addRow(detail, nextOrder(), 36), Loc.t("ui.tree.path_line", {
		path = Loc.name("path." .. def.path, def.path),
		goal = Loc.name("path." .. def.path .. ".goal", ""),
		avg  = Loc.formatDecimal(EggTree.expectedRarity(eggId), 2),
	}))
	sub.Size = UDim2.fromScale(1, 1)

	local status = Theme.label("Status", addRow(detail, nextOrder(), 22),
		if progress.unlocked then Loc.t("ui.tree.unlocked")
		elseif progress.ready then Loc.t("ui.tree.ready")
		else Loc.t("ui.tree.locked"))
	status.Size = UDim2.fromScale(1, 1)
	status.TextColor3 = if progress.unlocked then Theme.COLORS.good else Theme.COLORS.goldGummy

	-- Bedingungen
	if not progress.unlocked and #progress.conditions > 0 then
		Theme.sectionLabel("CondHead", addRow(detail, nextOrder(), 16), Loc.t("ui.tree.needs")).Size = UDim2.fromScale(1, 1)
		for _, c in progress.conditions do
			local row = addRow(detail, nextOrder(), 26)
			local bar = Theme.progress(row, if c.done then Theme.COLORS.good else Theme.COLORS.accent)
			bar.track.Size = UDim2.fromScale(1, 1)
			bar.fill.Size = UDim2.fromScale(math.clamp(c.have / math.max(1, c.need), 0, 1), 1)
			bar.text.Text = conditionText(c)
			if c.parts then
				for _, part in c.parts do
					local prow = addRow(detail, nextOrder(), 20)
					local pl = Theme.bodyText("Part", prow, string.format("   %s %s  %d/%d",
						if part.done then "✓" else "·", eggName(part.egg), part.have, part.need))
					pl.Size = UDim2.fromScale(1, 1)
					pl.TextSize = 12
				end
			end
		end
	end

	-- Lager + Aktionen
	local stockRow = addRow(detail, nextOrder(), 22)
	local stockLabel = Theme.label("Stock", stockRow, Loc.t("ui.tree.in_stock", { n = stock }))
	stockLabel.Size = UDim2.fromScale(1, 1)
	stockLabel.TextColor3 = if stock > 0 then Theme.COLORS.good else Theme.COLORS.textDim

	local openRow = addRow(detail, nextOrder(), 34)
	local openBtn = Theme.bigButton("Open", openRow, Loc.t("ui.tree.open"), Theme.COLORS.accent)
	openBtn.Size = UDim2.fromScale(1, 1)
	Theme.setEnabled(openBtn, stock > 0)
	openBtn.Activated:Connect(function()
		local now = ClientState.get()
		if not now or (now.island.eggStock[eggId] or 0) <= 0 then return end
		HatchAnimation.request(eggId)
		Remotes.RequestHatchEgg:FireServer(eggId)
	end)

	-- Presse: beim Zucker-Ei zwei Wege (Gold / Void)
	if EggConfig.canPress(eggId :: any) then
		local targets: { { path: string?, egg: Types.EggType } } = {}
		if eggId == "SugarEgg" then
			for _, path in { "Gold", "Void" } do
				local t = EggConfig.getNextInPath(eggId, path :: any)
				if t then table.insert(targets, { path = path, egg = t }) end
			end
		else
			local t = EggConfig.getNextInPath(eggId)
			if t then table.insert(targets, { path = nil, egg = t }) end
		end
		for _, target in targets do
			local row = addRow(detail, nextOrder(), 32)
			local free = EggTree.isUnlocked(data.eggTree, target.egg)
			local btn = Theme.button("Press", row, Loc.t("ui.tree.press", {
				n = EggConfig.PRESS.cost, egg = eggName(target.egg),
			}), Theme.COLORS.goldGummy)
			btn.Size = UDim2.fromScale(1, 1)
			Theme.setEnabled(btn, free and stock >= EggConfig.PRESS.cost)
			btn.Activated:Connect(function()
				Remotes.RequestPressEggs:FireServer(eggId, target.path)
			end)
		end
	end

	-- Blaupause
	if EggTree.canUseBlueprint(data, eggId) then
		local row = addRow(detail, nextOrder(), 32)
		local btn = Theme.button("Blueprint", row, Loc.t("ui.tree.use_blueprint", { n = data.eggTree.blueprints }),
			BaerchiConfig.getPathColor("Kosmos"))
		btn.TextColor3 = Theme.COLORS.text
		btn.Size = UDim2.fromScale(1, 1)
		btn.Activated:Connect(function()
			Remotes.RequestUseBlueprint:FireServer(eggId)
		end)
	end

	-- Drop-Vorschau
	Theme.sectionLabel("DropHead", addRow(detail, nextOrder(), 16), Loc.t("ui.tree.drops")).Size = UDim2.fromScale(1, 1)
	for _, node in IndexCalculator.buildTree() do
		if node.eggId == eggId then
			for _, drop in node.drops do
				local bdef = BaerchiConfig.getById(drop.configId)
				if bdef then
					local row = addRow(detail, nextOrder(), 20)
					local known = data.discovered and data.discovered[drop.configId]
					local name = if known then Loc.name("baerchi." .. drop.configId .. ".name", bdef.displayName) else "???"
					local pct = drop.chance * 100
					local pctText = if pct >= 10 then Loc.formatNumber(math.round(pct)) .. "%" else Loc.formatDecimal(pct, 1) .. "%"
					local l = Theme.bodyText("Drop", row, string.format("%s  •  %s  •  %s", pctText, name, rarityName(bdef.rarity)))
					l.Size = UDim2.fromScale(1, 1)
					l.TextSize = 12
					l.TextColor3 = BaerchiConfig.getRarityColor(bdef.rarity)
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

function EggTreePanel.refresh()
	local root = _root
	if not root or not root.Visible then return end
	local data = ClientState.get()
	if not data or not data.eggTree then return end

	if _header then
		_header.Text = Loc.t("ui.tree.title_bp", { n = data.eggTree.blueprints or 0 })
	end

	for eggId, node in _nodes do
		local progress = EggTree.getProgress(data, eggId :: Types.EggType)
		local def = EggConfig.data[eggId :: Types.EggType]
		local stock = data.island.eggStock[eggId :: Types.EggType] or 0
		node.count.Text = if stock > 0 then "x" .. stock else ""
		node.name.Text = eggName(eggId)
		if progress.unlocked then
			node.frame.BackgroundColor3 = Theme.shade(def.color, -0.55)
			node.lock.Text = ""
			node.stroke.Color = Theme.COLORS.outline
			node.stroke.Thickness = 2
		else
			node.frame.BackgroundColor3 = Theme.COLORS.panelDeep
			node.lock.Text = if progress.ready then "!" else Loc.t("ui.tree.lock_short")
			node.stroke.Color = if progress.ready then Theme.COLORS.goldGummy else Theme.COLORS.outline
			node.stroke.Thickness = if progress.ready then 3 else 2
		end
		if eggId == _selected then
			node.stroke.Color = Theme.COLORS.text
			node.stroke.Thickness = 3
		end
	end

	if _detail then
		buildDetail(_detail, data)
	end
end

local function openInternal(eggId: any)
	local root = _root
	if not root then return end
	if typeof(eggId) == "string" and EggConfig.data[eggId :: Types.EggType] then
		_selected = eggId :: Types.EggType
	end
	root.Visible = true
	EggTreePanel.refresh()
end

local function closeInternal()
	if _root then _root.Visible = false end
end

function EggTreePanel.init(screenGui: ScreenGui)
	local root = Theme.dialog("EggTreePanel", screenGui, Vector2.new(0.9, 0.84), Vector2.new(560, 360), Vector2.new(1240, 720))
	_root = root

	_header = Theme.dialogHeader(root, Loc.t("ui.tree.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	local canvas = Instance.new("ScrollingFrame")
	canvas.Name = "Canvas"
	canvas.BackgroundTransparency = 1
	canvas.BorderSizePixel = 0
	canvas.ScrollBarThickness = 6
	canvas.ScrollBarImageColor3 = Theme.COLORS.panelLight
	canvas.ScrollingDirection = Enum.ScrollingDirection.XY
	canvas.Size = UDim2.new(1, -DETAIL_W - 10, 1, 0)
	canvas.ZIndex = 10
	canvas.Parent = body
	_canvas = canvas

	local detailHost = Theme.panel("Detail", body, Theme.COLORS.panel)
	detailHost.AnchorPoint = Vector2.new(1, 0)
	detailHost.Position = UDim2.new(1, 0, 0, 0)
	detailHost.Size = UDim2.new(0, DETAIL_W, 1, 0)
	detailHost.ZIndex = 10
	local detail = Theme.scroller("List", detailHost)
	detail.Position = UDim2.fromOffset(8, 8)
	detail.Size = UDim2.new(1, -12, 1, -16)
	detail.ZIndex = 11
	local layout = Theme.listLayout(detail, 4)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	_detail = detail

	buildTree(canvas)

	PanelManager.register(PANEL_NAME, { open = openInternal, close = closeInternal })

	ClientState.onChanged(function()
		EggTreePanel.refresh()
	end)
	Loc.onChanged(function()
		if _header then _header.Text = Loc.t("ui.tree.title") end
		EggTreePanel.refresh()
	end)

	print("[EggTreePanel] Initialisiert |", #EggConfig.getOrderedIds(), "Knoten")
end

return EggTreePanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX100"><Properties>
<string name="Name">Feedback</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- Feedback.luau
-- StarterPlayerScripts/UI/Feedback.luau
--
-- Einzige Zustaendigkeit:
--   - Gewinne ohne Text zeigen: Icon fliegt zur passenden Pille/Kachel,
--     eine Zahl ("+25") steigt auf, Honig/XP/Stufen als Zahl ueber dem Baerchi
--
-- Kontext: HBB Paket 1. Ein Kind soll Belohnungen sehen, nicht lesen.
--
-- Zwei Quellen:
--   1. Waehrungen und Eier erkennt dieses Modul selbst am Datenstand
--      (ClientState): steigt `gummies`, `goldGummies` oder die Summe im
--      Ei-Lager, fliegt ein Icon. So braucht keine Belohnungsstelle eigenen
--      Code, und nichts wird doppelt gezeigt.
--   2. Alles, was keine Pille hat (XP, Honig, Level, Stat-Stufe, Waben,
--      Ausbau), meldet der Aufrufer mit Feedback.gain(kind, amount, origin?).
--
-- Leistung: ein fester Pool wiederverwendeter Elemente und EINE Schleife pro
-- Frame. Kein Thread und kein Tween pro Icon.
--
-- Mit FeatureFlags.UI_V2_FEEDBACK = false zeigt dieses Modul nichts.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local GuiService        = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local Types          = require(ReplicatedStorage.Network.Types)
local FeedbackConfig = require(ReplicatedStorage.Config.FeedbackConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)

local Theme       = require(script.Parent.Theme)
local UiScale     = require(script.Parent.UiScale)
local Icons       = require(script.Parent.Icons)
local Hud         = require(script.Parent.Hud)
local MenuBar     = require(script.Parent.MenuBar)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local Feedback = {}

export type Origin = GuiObject | Vector3 | BasePart

-- Wie jede Art aussieht. `icon` = Name in Icons, `text` = Rueckfall/Praefix.
-- `me` = Zahl ueber dem eigenen Charakter statt ueber dem Baerchi.
local LOOK: { [string]: { icon: string?, text: string, color: Color3, float: boolean, me: boolean? } } = {
	gummies     = { icon = "gummy",     text = "G",  color = Theme.COLORS.gummy,     float = false },
	goldGummies = { icon = "goldgummy", text = "$",  color = Theme.COLORS.goldGummy, float = false },
	eggs        = { icon = "egg",       text = "EI", color = Theme.COLORS.text,      float = false },
	xp          = { icon = nil,         text = "XP", color = Theme.COLORS.growth,    float = true },
	honey       = { icon = "honey",     text = "",   color = Theme.COLORS.volume,    float = true },
	level       = { icon = nil,         text = "Lv", color = Theme.COLORS.good,      float = true },
	stat        = { icon = nil,         text = "",   color = Theme.COLORS.accent,    float = true },
	comb        = { icon = "honey",     text = "",   color = Theme.COLORS.volume,    float = true, me = true },
	upgrade     = { icon = nil,         text = "⬆",  color = Theme.COLORS.good,      float = true, me = true },
	star        = { icon = nil,         text = "★",  color = Theme.COLORS.goldGummy, float = true },
}

-- Groesse eines fliegenden Icons (px)
local ICON_SIZE = 38
-- Wie hoch die Zahl ueber den Startpunkt steigt (px)
local NUMBER_RISE = 46
-- Wie hoch die Zahl ueber dem Baerchi steigt (Studs)
local FLOAT_RISE = 3
local FLOAT_BASE = 4

type Flyer = {
	frame  : Frame,
	icon   : GuiObject,
	number : TextLabel,
	busy   : boolean,
	t0     : number,
	from   : Vector2,
	to     : Vector2?,
	kind   : string,
	landed : boolean,
}

type Floater = {
	gui    : BillboardGui,
	label  : TextLabel,
	busy   : boolean,
	t0     : number,
}

local _layer: Frame? = nil
local _flyers: { Flyer } = {}
local _floaters: { Floater } = {}

-- Sammeln gleicher Gewinne im MERGE_WINDOW
local _pending: { [string]: { amount: number, origin: Origin?, due: number, suffix: string? } } = {}

-- Letzter bekannter Stand fuer die Erkennung aus ClientState
local _last: { gummies: number, goldGummies: number, eggs: number }? = nil

-- Zwischenspeicher fuer die Figur des ausgeruesteten Baerchis
local _bearPart: BasePart? = nil
local _bearUid: string? = nil

local function enabled(): boolean
	return FeatureFlags.isOn("UI_V2_FEEDBACK")
end

local function formatAmount(kind: string, amount: number, suffix: string?): string
	if suffix then
		return "+" .. Theme.formatNumber(amount) .. " " .. suffix
	end
	local look = LOOK[kind]
	local prefix = if look then look.text else ""
	if kind == "level" then
		return prefix .. " " .. Theme.formatNumber(amount)
	elseif kind == "upgrade" or kind == "star" then
		return prefix .. " " .. Theme.formatNumber(amount)
	elseif kind == "xp" then
		return "+" .. Theme.formatNumber(amount) .. " " .. prefix
	end
	return "+" .. Theme.formatNumber(amount)
end

--------------------------------------------------------------------------------
-- Positionen
--------------------------------------------------------------------------------

local function guiCenter(gui: GuiObject): Vector2
	-- Bildschirm-Pixel -> Oberflaechen-Einheiten (globale UiScale)
	return UiScale.toGui(gui.AbsolutePosition + gui.AbsoluteSize * 0.5)
end

local function worldToScreen(position: Vector3): Vector2?
	local camera = Workspace.CurrentCamera
	if not camera then return nil end
	local point, visible = camera:WorldToViewportPoint(position)
	if not visible then return nil end
	-- Die ScreenGui laesst Platz fuer die Topbar (IgnoreGuiInset = false):
	-- Viewport-Koordinaten muessen um diesen Rand verschoben werden.
	local inset = GuiService:GetGuiInset()
	return UiScale.toGui(Vector2.new(point.X, point.Y) - inset)
end

local function defaultOrigin(): Vector2
	local layer = _layer
	if not layer then return Vector2.zero end
	local size = UiScale.toGui(layer.AbsoluteSize)
	-- Ueber der Pet-Leiste, wo der Blick ohnehin ist
	return Vector2.new(size.X * 0.5, size.Y * 0.72)
end

local function resolveOrigin(origin: Origin?): Vector2
	if typeof(origin) == "Instance" then
		if origin:IsA("GuiObject") then
			return guiCenter(origin)
		elseif origin:IsA("BasePart") then
			return worldToScreen(origin.Position) or defaultOrigin()
		end
	elseif typeof(origin) == "Vector3" then
		return worldToScreen(origin) or defaultOrigin()
	end
	return defaultOrigin()
end

local function targetFor(kind: string): GuiObject?
	local anchor = Hud.getPillAnchor(kind)
	if anchor then return anchor end
	if kind == "eggs" then
		return MenuBar.getTileAnchor("Hatch")
	end
	return nil
end

local function pulseTarget(kind: string, target: GuiObject?)
	if Hud.getPillAnchor(kind) then
		Hud.pulse(kind)
	elseif target then
		local scale = target:FindFirstChild("PulseScale")
		if not scale then
			local created = Instance.new("UIScale")
			created.Name = "PulseScale"
			created.Parent = target
			scale = created
		end
		local uiScale = scale :: UIScale
		uiScale.Scale = 1.15
	end
end

-- Sucht die Figur des eigenen, ausgeruesteten Baerchis (Attribut BaerchiUid,
-- siehe WorldController). Bleibt zwischengespeichert, bis sie verschwindet.
local function findBearPart(): BasePart?
	local data = ClientState.get()
	local uid = if data then data.island.equippedUid else nil
	if not uid then return nil end
	local cached = _bearPart
	if cached and cached.Parent and _bearUid == uid then
		return cached
	end
	_bearPart = nil
	_bearUid = uid
	for _, descendant in Workspace:GetDescendants() do
		if descendant:IsA("BasePart") and descendant:GetAttribute("BaerchiUid") == uid then
			_bearPart = descendant
			return descendant
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Pools
--------------------------------------------------------------------------------

local function makeFlyer(layer: Frame): Flyer
	local frame = Instance.new("Frame")
	frame.Name = "Flyer"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromOffset(ICON_SIZE, ICON_SIZE)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Visible = false
	frame.ZIndex = 60
	frame.Parent = layer

	local number = Theme.label("Number", layer, "")
	number.AnchorPoint = Vector2.new(0.5, 0.5)
	number.Size = UDim2.fromOffset(120, 34)
	number.TextXAlignment = Enum.TextXAlignment.Center
	number.ZIndex = 61
	number.Visible = false
	Theme.outlineText(number, 2)

	return {
		frame = frame, icon = frame, number = number, busy = false,
		t0 = 0, from = Vector2.zero, to = nil, kind = "", landed = false,
	}
end

local function setFlyerLook(flyer: Flyer, kind: string)
	if flyer.kind == kind and flyer.icon ~= flyer.frame then return end
	if flyer.icon ~= flyer.frame then
		flyer.icon:Destroy()
	end
	local look = LOOK[kind]
	local iconName = if look then look.icon else nil
	local icon = Icons.make(flyer.frame, iconName or "", if look then look.text else "?")
	icon.Size = UDim2.fromScale(1, 1)
	icon.ZIndex = 60
	flyer.icon = icon
	flyer.kind = kind
end

local function makeFloater(): Floater
	local gui = Instance.new("BillboardGui")
	gui.Name = "FeedbackFloat"
	gui.Size = UDim2.fromOffset(160, 44)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Enabled = false
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local label = Theme.label("Text", gui, "")
	label.Size = UDim2.fromScale(1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Center
	Theme.outlineText(label, 2)

	return { gui = gui, label = label, busy = false, t0 = 0 }
end

--------------------------------------------------------------------------------
-- Ausloesen
--------------------------------------------------------------------------------

local function launchFlyer(kind: string, amount: number, origin: Origin?)
	local free: Flyer? = nil
	for _, flyer in _flyers do
		if not flyer.busy then
			free = flyer
			break
		end
	end
	-- Alle belegt: die Pille zaehlt den Wert ohnehin hoch. Kein siebtes Icon.
	if not free then return end

	local target = targetFor(kind)
	local from = resolveOrigin(origin)
	setFlyerLook(free, kind)
	free.busy   = true
	free.landed = false
	free.t0     = os.clock()
	free.from   = from
	free.to     = if target then guiCenter(target) else nil
	free.frame.Position = UDim2.fromOffset(from.X, from.Y)
	free.frame.Visible  = true

	local look = LOOK[kind]
	free.number.Text       = formatAmount(kind, amount)
	free.number.TextColor3 = if look then look.color else Theme.COLORS.text
	free.number.Position   = UDim2.fromOffset(from.X, from.Y - 20)
	free.number.TextTransparency = 0
	free.number.Visible    = true
end

local function characterPart(): BasePart?
	local character = Players.LocalPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then return root end
	return nil
end

local function launchFloater(kind: string, amount: number, suffix: string?)
	local look0 = LOOK[kind]
	local part = if look0 and look0.me then characterPart() else findBearPart()
	if not part then return end
	local free: Floater? = nil
	for _, floater in _floaters do
		if not floater.busy then
			free = floater
			break
		end
	end
	if not free then return end
	local look = LOOK[kind]
	free.busy = true
	free.t0 = os.clock()
	free.gui.Adornee = part
	free.gui.StudsOffset = Vector3.new(0, FLOAT_BASE, 0)
	free.gui.Enabled = true
	free.label.Text = formatAmount(kind, amount, suffix)
	free.label.TextColor3 = if look then look.color else Theme.COLORS.text
	free.label.TextTransparency = 0
end

local function flush(kind: string)
	local entry = _pending[kind]
	_pending[kind] = nil
	if not entry or entry.amount == 0 then return end
	local look = LOOK[kind]
	if look and look.float then
		launchFloater(kind, entry.amount, entry.suffix)
	else
		launchFlyer(kind, entry.amount, entry.origin)
	end
end

-- Oeffentlich: einen Gewinn zeigen. Gleiche Arten innerhalb des
-- MERGE_WINDOW werden zu einer Zahl addiert. Bei "level", "upgrade" und
-- "star" ist `amount` die neue Stufe (wird nicht addiert, sondern ersetzt).
-- `suffix`: kurzes Kuerzel hinter der Zahl ("+1 ATK"); nur Zahlen und
-- sprachneutrale Kuerzel, keine Woerter.
function Feedback.gain(kind: string, amount: number, origin: Origin?, suffix: string?)
	if not enabled() then return end
	if not LOOK[kind] then
		warn("[Feedback] Unbekannte Art:", kind)
		return
	end
	local entry = _pending[kind]
	if entry then
		if kind == "level" or kind == "upgrade" or kind == "star" then
			entry.amount = amount
		else
			entry.amount += amount
		end
		entry.origin = origin or entry.origin
		entry.suffix = suffix or entry.suffix
	else
		_pending[kind] = { amount = amount, origin = origin, due = os.clock() + FeedbackConfig.MERGE_WINDOW, suffix = suffix }
	end
end

--------------------------------------------------------------------------------
-- Die eine Schleife
--------------------------------------------------------------------------------

local function easeOut(t: number): number
	return 1 - (1 - t) * (1 - t)
end

local function step()
	local now = os.clock()

	for kind, entry in _pending do
		if now >= entry.due then
			flush(kind)
		end
	end

	local fly = FeedbackConfig.FLY_SECONDS
	local rise = FeedbackConfig.NUMBER_SECONDS
	for _, flyer in _flyers do
		if not flyer.busy then continue end
		local t = now - flyer.t0

		-- Zahl: steigt am Startpunkt auf und blendet aus
		local tn = math.clamp(t / rise, 0, 1)
		flyer.number.Position = UDim2.fromOffset(flyer.from.X, flyer.from.Y - 20 - NUMBER_RISE * easeOut(tn))
		flyer.number.TextTransparency = math.max(0, (tn - 0.6) / 0.4)

		-- Icon: Bogen zum Ziel (ohne Ziel: nur kurz aufsteigen)
		local tf = math.clamp(t / fly, 0, 1)
		local to = flyer.to or (flyer.from - Vector2.new(0, 80))
		local mid = (flyer.from + to) * 0.5 + Vector2.new(0, -90)
		local e = easeOut(tf)
		local a = flyer.from:Lerp(mid, e)
		local b = mid:Lerp(to, e)
		local p = a:Lerp(b, e)
		flyer.frame.Position = UDim2.fromOffset(p.X, p.Y)
		local size = ICON_SIZE * (1 - 0.35 * tf)
		flyer.frame.Size = UDim2.fromOffset(size, size)

		if tf >= 1 and not flyer.landed then
			flyer.landed = true
			flyer.frame.Visible = false
			pulseTarget(flyer.kind, targetFor(flyer.kind))
		end
		if tf >= 1 and tn >= 1 then
			flyer.busy = false
			flyer.number.Visible = false
		end
	end

	local floatTime = FeedbackConfig.FLOAT_SECONDS
	for _, floater in _floaters do
		if not floater.busy then continue end
		local t = math.clamp((now - floater.t0) / floatTime, 0, 1)
		floater.gui.StudsOffset = Vector3.new(0, FLOAT_BASE + FLOAT_RISE * easeOut(t), 0)
		floater.label.TextTransparency = math.max(0, (t - 0.6) / 0.4)
		if t >= 1 then
			floater.busy = false
			floater.gui.Enabled = false
			floater.gui.Adornee = nil
		end
	end

	-- Puls der Kacheln zurueckfedern (Pillen machen das selbst per Tween)
	local tile = MenuBar.getTileAnchor("Hatch")
	if tile then
		local scale = tile:FindFirstChild("PulseScale")
		if scale and scale:IsA("UIScale") and scale.Scale > 1 then
			scale.Scale = math.max(1, scale.Scale - 0.6 * (1 / 60))
		end
	end
end

--------------------------------------------------------------------------------
-- Erkennung aus dem Datenstand
--------------------------------------------------------------------------------

local function countEggs(data: Types.PlayerDataUpdate): number
	local total = 0
	for _, n in data.island.eggStock do
		total += n
	end
	return total
end

local function onData(data: Types.PlayerDataUpdate)
	local now = { gummies = data.gummies, goldGummies = data.goldGummies, eggs = countEggs(data) }
	local last = _last
	_last = now
	-- Erster Stand nach dem Join ist kein Gewinn
	if not last then return end
	if now.gummies > last.gummies then Feedback.gain("gummies", now.gummies - last.gummies) end
	if now.goldGummies > last.goldGummies then Feedback.gain("goldGummies", now.goldGummies - last.goldGummies) end
	if now.eggs > last.eggs then Feedback.gain("eggs", now.eggs - last.eggs) end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function Feedback.init(screenGui: ScreenGui)
	local layer = Theme.container("FeedbackLayer", screenGui)
	layer.Size = UDim2.fromScale(1, 1)
	layer.ZIndex = 60
	_layer = layer

	for _ = 1, FeedbackConfig.MAX_ICONS do
		table.insert(_flyers, makeFlyer(layer))
	end
	for _ = 1, FeedbackConfig.MAX_FLOATS do
		table.insert(_floaters, makeFloater())
	end

	ClientState.onChanged(onData)
	RunService.RenderStepped:Connect(step)

	print("[Feedback] Initialisiert")
end

return Feedback
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX101"><Properties>
<string name="Name">FightStartPrompt</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- FightStartPrompt.luau
-- StarterPlayerScripts/UI/FightStartPrompt.luau
--
-- Einzige Zustaendigkeit:
--   - Das kleine Feld beim Fight-Klick (FeatureFlags.FIGHT_RESUME_PROMPT):
--     "Ab Stage X weiter" gegen Gummies. Klickt der Spieler nichts, ist es
--     nach AUTO_SECONDS weg und der Lauf startet bei Stage 1.
--
-- Entscheidung Projektinhaber 05.10.: Stages schafft man durch STAERKERE
-- Baerchis. Der Einstieg weiter oben ist eine bewusste Spieler-Entscheidung
-- gegen Waehrung, nie der Standard. (Vorher startete der Fight-Knopf ohne
-- Frage ab 65 % des letzten Laufs und buchte dafuer Gummies ab.)
--
-- Kosten und Start-Stage rechnet PitResumeDialog.offer — dieselbe Rechnung,
-- mit der der Server abbucht. Bezahlbar entscheidet am Ende der Server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local Loc = require(ReplicatedStorage.Localization.Loc)

local Theme           = require(script.Parent.Theme)
local Icons           = require(script.Parent.Icons)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local ClientState     = require(script.Parent.Parent.Controllers.ClientState)

local FightStartPrompt = {}

FightStartPrompt.AUTO_SECONDS = 7

local _root: Frame? = nil
local _resume: TextButton? = nil
local _cost: TextLabel? = nil
local _bar: Frame? = nil
local _onChoose: ((PitResumeDialog.Choice) -> ())? = nil
local _openedAt = 0
local _token = 0

local function finish(choice: PitResumeDialog.Choice)
	local callback = _onChoose
	_onChoose = nil
	_token += 1
	local root = _root
	if root then root.Visible = false end
	if callback then callback(choice) end
end

function FightStartPrompt.isOpen(): boolean
	return _onChoose ~= nil
end

-- Sofort mit Stage 1 starten (zweiter Fight-Klick waehrend das Feld offen ist)
function FightStartPrompt.chooseFresh()
	if _onChoose then finish("Fresh") end
end

-- Oeffnet das Feld, wenn es einen letzten Lauf ueber Stage 1 gibt. Gibt
-- false zurueck, wenn es nichts anzubieten gibt (Aufrufer startet dann
-- selbst bei Stage 1).
function FightStartPrompt.open(onChoose: (PitResumeDialog.Choice) -> ()): boolean
	local root, resume, cost = _root, _resume, _cost
	local data = ClientState.get()
	if not root or not resume or not cost or not data then return false end
	local reached = PitResumeDialog.getProgress(data)
	if not reached or reached <= 1 then return false end

	local stage, price = PitResumeDialog.offer(data, "Last")
	resume.Text = Loc.t("ui.fight.resume", { stage = stage })
	cost.Text = Theme.formatNumber(price)
	Theme.setEnabled(resume, price <= data.gummies)

	_onChoose = onChoose
	_openedAt = os.clock()
	_token += 1
	local token = _token
	root.Visible = true

	task.delay(FightStartPrompt.AUTO_SECONDS, function()
		if token == _token and _onChoose then
			finish("Fresh")
		end
	end)
	return true
end

function FightStartPrompt.init(screenGui: ScreenGui, anchorAbove: GuiObject)
	local root = Theme.panel("FightStartPrompt", screenGui, Theme.COLORS.panelDeep)
	root.AnchorPoint = Vector2.new(0.5, 1)
	root.Position = UDim2.new(0.5, 0, 1, -(anchorAbove.Size.Y.Offset + 26))
	root.Size = UDim2.fromOffset(300, 96)
	root.Visible = false
	root.ZIndex = 6
	_root = root

	local resume = Theme.bigButton("Resume", root, "", Theme.COLORS.goldGummy)
	resume.Position = UDim2.new(0, 8, 0, 8)
	resume.Size = UDim2.new(1, -16, 0, 44)
	resume.Activated:Connect(function()
		if resume.Active then finish("Last") end
	end)
	_resume = resume

	-- Kosten rechts im Knopf: Gummi-Icon + Zahl
	local coin = Icons.make(resume, "gummy", "G")
	coin.AnchorPoint = Vector2.new(1, 0.5)
	coin.Position = UDim2.new(1, -56, 0.5, 0)
	coin.Size = UDim2.fromOffset(24, 24)
	local cost = Theme.label("Cost", resume, "")
	cost.AnchorPoint = Vector2.new(1, 0.5)
	cost.Position = UDim2.new(1, -8, 0.5, 0)
	cost.Size = UDim2.fromOffset(46, 24)
	_cost = cost

	local fresh = Theme.button("Fresh", root, Loc.t("ui.fight.fresh"), Theme.COLORS.panelLight)
	fresh.Position = UDim2.new(0, 8, 0, 58)
	fresh.Size = UDim2.new(0.42, 0, 0, 26)
	fresh.TextColor3 = Theme.COLORS.text
	Loc.bind(fresh, "ui.fight.fresh")
	fresh.Activated:Connect(function() finish("Fresh") end)

	-- Ablaufbalken: zeigt, dass es gleich von selbst bei Stage 1 losgeht
	local track = Instance.new("Frame")
	track.Name = "Timer"
	track.BackgroundColor3 = Theme.COLORS.panelLight
	track.BorderSizePixel = 0
	track.Position = UDim2.new(0.42, 16, 0, 66)
	track.Size = UDim2.new(0.58, -24, 0, 10)
	track.Parent = root
	Theme.corner(track, 5)
	local bar = Instance.new("Frame")
	bar.BackgroundColor3 = Theme.COLORS.goldGummy
	bar.BorderSizePixel = 0
	bar.Size = UDim2.fromScale(1, 1)
	bar.Parent = track
	Theme.corner(bar, 5)
	_bar = bar

	RunService.RenderStepped:Connect(function()
		if not _onChoose then return end
		local left = math.clamp(1 - (os.clock() - _openedAt) / FightStartPrompt.AUTO_SECONDS, 0, 1)
		local b = _bar
		if b then b.Size = UDim2.fromScale(left, 1) end
	end)

end

return FightStartPrompt
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX102"><Properties>
<string name="Name">HomeButton</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- HomeButton.luau
-- StarterPlayerScripts/UI/HomeButton.luau
--
-- Einzige Zustaendigkeit:
--   - Den Heim-Knopf zeigen, wenn der Spieler weit weg von seinem Plot ist,
--     und RequestGoHome senden
--
-- Kontext: HBB Paket 5 (MAP_V2_HOME). Der Knopf erscheint erst ab
-- SHOW_DISTANCE Studs Abstand zum eigenen Spawn-Pad (Player.RespawnLocation,
-- von PlotBuilder gesetzt). Ob der Teleport erlaubt ist (getragene Waben),
-- entscheidet der Server.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes      = require(ReplicatedStorage.Network.Remotes)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local Loc          = require(ReplicatedStorage.Localization.Loc)

local Theme = require(script.Parent.Theme)

local HomeButton = {}

local SHOW_DISTANCE = 60
local CHECK_SECONDS = 0.5
-- Breiter als hoch: das Wort ("Maison") braucht Platz
local SIZE = Vector2.new(104, 56)

function HomeButton.init(screenGui: ScreenGui)
	-- Playtest 05.10.: Wort statt Haus-Emoji (das Emoji war winzig und unklar)
	local button = Theme.bigButton("HomeButton", screenGui, Loc.t("ui.home.button"), Theme.COLORS.good)
	Loc.bind(button, "ui.home.button")
	button.AnchorPoint = Vector2.new(0, 1)
	button.Position    = UDim2.new(0, 16, 1, -16)
	button.Size        = UDim2.fromOffset(SIZE.X, SIZE.Y)
	button.Visible     = false
	button.ZIndex      = 5
	button.Activated:Connect(function()
		Remotes.RequestGoHome:FireServer()
	end)

	task.spawn(function()
		local player = Players.LocalPlayer
		while true do
			task.wait(CHECK_SECONDS)
			local show = false
			if FeatureFlags.isOn("MAP_V2_HOME") then
				local spawn = player.RespawnLocation
				local character = player.Character
				local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
				if spawn and root and root:IsA("BasePart") then
					show = (root.Position - spawn.Position).Magnitude > SHOW_DISTANCE
				end
			end
			button.Visible = show
		end
	end)
end

return HomeButton
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX103"><Properties>
<string name="Name">IndexView</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- IndexView.luau
-- StarterPlayerScripts/UI/IndexView.luau
--
-- Einzige Zustaendigkeit:
--   - Den Index zeichnen: pro Ei eine Reihe Baerchis mit Wahrscheinlichkeit,
--     entdeckte in Farbe, unentdeckte als schwarze Silhouette
--   - Das kleine Fenster mit den Eiern, aus denen ein Baerchi faellt
--     (PC: Maus drueberhalten, Handy: antippen)
--
-- Zweck ist Orientierung: wer eine schwarze Silhouette sieht, tippt sie an und
-- weiss sofort, WELCHES Ei er oeffnen muss. Der Index liest nur — er schaltet
-- nichts frei. Entdeckt ist ein Baerchi, sobald der Server ihn in
-- data.discovered vermerkt hat (QuestService).
--
-- Die Daten (welche Eier, welche Chancen) kommen komplett aus
-- IndexCalculator/EggConfig; dieses Modul kennt keine einzige Baerchi-id.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types           = require(ReplicatedStorage.Network.Types)
local Loc             = require(ReplicatedStorage.Localization.Loc)
local EggConfig       = require(ReplicatedStorage.Config.EggConfig)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local IndexCalculator = require(ReplicatedStorage.Modules.IndexCalculator)
local BaerchiMesh     = require(ReplicatedStorage.Modules.BaerchiMesh)

local Theme       = require(script.Parent.Theme)
local UiScale     = require(script.Parent.UiScale)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local IndexView = {}

local TILE_W   = 78
local TILE_H   = 104
local VIEW     = 62
local POP_W    = 210

local _page: Frame?        = nil
local _scroller: ScrollingFrame? = nil
local _summary: TextLabel? = nil
local _popup: Frame?       = nil
local _popupHost: Frame?   = nil

-- Antippen haelt das Fenster fest (Handy); Hover zeigt es nur solange die Maus
-- drauf ist.
local _pinnedId: string? = nil
local _shownId: string?  = nil
local _signature = ""

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function percent(chance: number): string
	local p = chance * 100
	if math.abs(p - math.round(p)) < 0.05 then
		return Loc.formatNumber(math.round(p)) .. "%"
	end
	return Loc.formatDecimal(p, 1) .. "%"
end

local function isDiscovered(configId: string): boolean
	local data = ClientState.get()
	return data ~= nil and data.discovered ~= nil and data.discovered[configId] == true
end

-- Macht aus einem gebauten Baerchi eine schwarze Silhouette.
local function blacken(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Color    = Color3.new(0.04, 0.04, 0.06)
			d.Material = Enum.Material.SmoothPlastic
			if d:IsA("MeshPart") then
				d.TextureID = ""
			end
		elseif d:IsA("Decal") or d:IsA("Texture") or d:IsA("SurfaceAppearance") then
			d:Destroy()
		end
	end
end

-- Zeigt einen Baerchi in einem ViewportFrame. Gibt false zurueck, wenn kein
-- Modell gebaut werden konnte (fehlendes Template) — der Aufrufer zeigt dann
-- ein Fragezeichen.
local function fillViewport(vp: ViewportFrame, configId: string, discovered: boolean): boolean
	local def = BaerchiConfig.getById(configId)
	if not def then return false end

	local ok, model = pcall(function()
		return BaerchiMesh.build(Vector3.zero, Theme.rarityColor(def.rarity), def.rarity, nil)
	end)
	if not ok or not model then return false end

	if not discovered then
		blacken(model)
	end
	model.Parent = vp

	local cf, size = model:GetBoundingBox()
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	local radius = math.max(size.X, size.Y, size.Z)
	local distance = radius / (2 * math.tan(math.rad(camera.FieldOfView / 2))) * 1.15
	-- Leicht von vorne-oben, damit man Gesicht und Koerper sieht.
	local dir = Vector3.new(0.35, 0.25, 1).Unit
	camera.CFrame = CFrame.lookAt(cf.Position + dir * distance, cf.Position)
	camera.Parent = vp
	vp.CurrentCamera = camera
	return true
end

--------------------------------------------------------------------------------
-- Das Fenster "faellt aus diesen Eiern"
--------------------------------------------------------------------------------

local function hidePopup()
	local popup = _popup
	if popup then popup.Visible = false end
	_shownId = nil
end

local function showPopup(configId: string, anchor: GuiObject)
	local popup, host = _popup, _popupHost
	if not popup or not host then return end

	local def = BaerchiConfig.getById(configId)
	if not def then return end

	for _, child in popup:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	local found = isDiscovered(configId)
	local color = Theme.rarityColor(def.rarity)

	local title = Theme.label("Title", popup,
		if found then Loc.name("baerchi." .. configId .. ".name", def.displayName) else Loc.t("ui.index.unknown"))
	title.Position = UDim2.new(0, 10, 0, 6)
	title.Size     = UDim2.new(1, -20, 0, 22)

	local rarity = Theme.label("Rarity", popup, Loc.name("rarity." .. def.rarity, def.rarity))
	rarity.Position   = UDim2.new(0, 10, 0, 28)
	rarity.Size       = UDim2.new(1, -20, 0, 16)
	rarity.TextColor3 = color

	local header = Theme.bodyText("DropsFrom", popup, Loc.t("ui.index.drops_from"))
	header.Position = UDim2.new(0, 10, 0, 50)
	header.Size     = UDim2.new(1, -20, 0, 16)

	local data   = ClientState.get()
	local sources = IndexCalculator.sourcesOf(configId)
	local y = 68

	for _, source in sources do
		local eggDef = EggConfig.data[source.eggId :: Types.EggType]
		local row = Theme.container("Src_" .. source.eggId, popup)
		row.Position = UDim2.new(0, 10, 0, y)
		row.Size     = UDim2.new(1, -20, 0, 22)

		local dot = Theme.panel("Dot", row, if eggDef then eggDef.color else Theme.COLORS.accent)
		dot.Position = UDim2.new(0, 0, 0.5, -7)
		dot.Size     = UDim2.new(0, 14, 0, 14)
		Theme.corner(dot, 7)

		local name = Theme.label("Name", row, Loc.name("egg." .. source.eggId .. ".name", source.eggId))
		name.Position = UDim2.new(0, 22, 0, 0)
		name.Size     = UDim2.new(1, -90, 1, 0)
		name.TextSize = 14

		local chance = Theme.label("Chance", row, percent(source.chance))
		chance.AnchorPoint    = Vector2.new(1, 0)
		chance.Position       = UDim2.new(1, 0, 0, 0)
		chance.Size           = UDim2.new(0, 64, 1, 0)
		chance.TextXAlignment = Enum.TextXAlignment.Right
		chance.TextColor3     = Theme.COLORS.goldGummy

		y += 22

		-- Hat der Spieler dieses Ei gerade im Lager? Dann ist das der
		-- naechste Schritt, und genau den soll das Fenster zeigen.
		local stock = if data then (data.island.eggStock :: any)[source.eggId] or 0 else 0
		if stock > 0 then
			local have = Theme.bodyText("Have", popup, Loc.t("ui.index.you_have", { n = stock }))
			have.Position   = UDim2.new(0, 32, 0, y - 4)
			have.Size       = UDim2.new(1, -42, 0, 14)
			have.TextSize   = 12
			have.TextColor3 = Theme.COLORS.good
			y += 14
		end
	end

	if #sources == 0 then
		local none = Theme.bodyText("None", popup, Loc.t("ui.index.no_source"))
		none.Position = UDim2.new(0, 10, 0, y)
		none.Size     = UDim2.new(1, -20, 0, 30)
		y += 30
	end

	popup.Size = UDim2.new(0, POP_W, 0, y + 10)

	-- Neben die Kachel setzen und im Dialog halten.
	-- Bildschirm-Pixel -> Oberflaechen-Einheiten (globale UiScale)
	local hostPos  = UiScale.toGui(host.AbsolutePosition)
	local hostSize = UiScale.toGui(host.AbsoluteSize)
	local aPos, aSize = UiScale.toGui(anchor.AbsolutePosition), UiScale.toGui(anchor.AbsoluteSize)

	local x = aPos.X - hostPos.X + aSize.X + 6
	if x + POP_W > hostSize.X then
		x = aPos.X - hostPos.X - POP_W - 6
	end
	x = math.clamp(x, 4, math.max(4, hostSize.X - POP_W - 4))
	local py = math.clamp(aPos.Y - hostPos.Y, 4, math.max(4, hostSize.Y - (y + 10) - 4))

	popup.Position = UDim2.new(0, x, 0, py)
	popup.Visible  = true
	_shownId = configId
end

--------------------------------------------------------------------------------
-- Eine Kachel
--------------------------------------------------------------------------------

local function buildTile(parent: Instance, order: number, drop: IndexCalculator.Drop)
	local def = BaerchiConfig.getById(drop.configId)
	if not def then return end

	local found = isDiscovered(drop.configId)
	local color = Theme.rarityColor(def.rarity)

	local tile = Theme.panel("Tile_" .. drop.configId, parent, Theme.COLORS.panel)
	tile.LayoutOrder = order

	local stroke = tile:FindFirstChildOfClass("UIStroke")
	if stroke and found then stroke.Color = color end

	local vp = Instance.new("ViewportFrame")
	vp.Name                   = "Preview"
	vp.BackgroundColor3       = if found then Theme.shade(color, -0.55) else Color3.fromRGB(70, 66, 92)
	vp.BackgroundTransparency = 0
	vp.BorderSizePixel        = 0
	vp.Ambient                = Color3.fromRGB(180, 180, 190)
	vp.LightColor             = Color3.fromRGB(255, 255, 255)
	vp.AnchorPoint            = Vector2.new(0.5, 0)
	vp.Position               = UDim2.new(0.5, 0, 0, 5)
	vp.Size                   = UDim2.new(0, VIEW, 0, VIEW)
	vp.Parent                 = tile
	Theme.corner(vp, 10)

	if not fillViewport(vp, drop.configId, found) then
		local q = Theme.label("Q", vp, if found then "B" else "?")
		q.Size           = UDim2.fromScale(1, 1)
		q.TextXAlignment = Enum.TextXAlignment.Center
		q.TextColor3     = if found then color else Theme.COLORS.textDim
	end

	local name = Theme.label("Name", tile,
		if found then Loc.name("baerchi." .. drop.configId .. ".name", def.displayName) else Loc.t("ui.index.unknown"))
	name.Position       = UDim2.new(0, 3, 0, VIEW + 7)
	name.Size           = UDim2.new(1, -6, 0, 14)
	name.TextXAlignment = Enum.TextXAlignment.Center
	name.TextColor3     = if found then Theme.COLORS.text else Theme.COLORS.textDim

	local chance = Theme.label("Chance", tile, percent(drop.chance))
	chance.Position       = UDim2.new(0, 3, 0, VIEW + 22)
	chance.Size           = UDim2.new(1, -6, 0, 14)
	chance.TextXAlignment = Enum.TextXAlignment.Center
	chance.TextColor3     = Theme.COLORS.goldGummy

	local hit = Instance.new("TextButton")
	hit.Name                   = "Hit"
	hit.BackgroundTransparency = 1
	hit.Text                   = ""
	hit.Size                   = UDim2.fromScale(1, 1)
	hit.ZIndex                 = 5
	hit.Parent                 = tile

	-- Maus: Hover zeigt, Verlassen versteckt (ausser angetippt).
	hit.MouseEnter:Connect(function()
		if _pinnedId == nil then
			showPopup(drop.configId, tile)
		end
	end)
	hit.MouseLeave:Connect(function()
		if _pinnedId == nil and _shownId == drop.configId then
			hidePopup()
		end
	end)
	-- Handy (und Mausklick): antippen haelt fest, nochmal antippen schliesst.
	hit.Activated:Connect(function()
		if _pinnedId == drop.configId then
			_pinnedId = nil
			hidePopup()
		else
			_pinnedId = drop.configId
			showPopup(drop.configId, tile)
		end
	end)
end

--------------------------------------------------------------------------------
-- Aufbau / Aktualisieren
--------------------------------------------------------------------------------

local function currentSignature(): string
	local data = ClientState.get()
	local keys: { string } = {}
	if data and data.discovered then
		for id in data.discovered do table.insert(keys, id) end
	end
	table.sort(keys)
	return table.concat(keys, ",") .. "|" .. Loc.getLanguage()
end

function IndexView.refresh(force: boolean?)
	local scroller, page = _scroller, _page
	if not scroller or not page or not page.Visible then return end

	local signature = currentSignature()
	if not force and signature == _signature then return end
	_signature = signature

	hidePopup()
	_pinnedId = nil

	for _, child in scroller:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	local tree  = IndexCalculator.buildTree()
	local total = #IndexCalculator.allPets()
	local found = 0
	for _, configId in IndexCalculator.allPets() do
		if isDiscovered(configId) then found += 1 end
	end

	local summary = _summary
	if summary then
		summary.Text = Loc.t("ui.index.progress", { found = found, total = total })
	end

	for order, node in tree do
		local eggDef = EggConfig.data[node.eggId :: Types.EggType]

		local section = Theme.container("Egg_" .. node.eggId, scroller)
		section.LayoutOrder   = order
		section.Size          = UDim2.new(1, -8, 0, 0)
		section.AutomaticSize = Enum.AutomaticSize.Y
		local sl = Theme.listLayout(section, 4)
		sl.HorizontalAlignment = Enum.HorizontalAlignment.Left

		local head = Theme.container("Head", section)
		head.LayoutOrder = 1
		head.Size        = UDim2.new(1, 0, 0, 24)

		local dot = Theme.panel("Dot", head, if eggDef then eggDef.color else Theme.COLORS.accent)
		dot.Position = UDim2.new(0, 2, 0.5, -9)
		dot.Size     = UDim2.new(0, 18, 0, 18)
		Theme.corner(dot, 9)

		local sectionFound = 0
		for _, drop in node.drops do
			if isDiscovered(drop.configId) then sectionFound += 1 end
		end

		local title = Theme.label("Title", head,
			Loc.name("egg." .. node.eggId .. ".name", node.eggId)
			.. "  (" .. sectionFound .. "/" .. #node.drops .. ")")
		title.Position = UDim2.new(0, 28, 0, 0)
		title.Size     = UDim2.new(1, -30, 1, 0)

		local grid = Theme.container("Grid", section)
		grid.LayoutOrder   = 2
		grid.Size          = UDim2.new(1, 0, 0, 0)
		grid.AutomaticSize = Enum.AutomaticSize.Y

		local layout = Instance.new("UIGridLayout")
		layout.CellSize            = UDim2.new(0, TILE_W, 0, TILE_H)
		layout.CellPadding         = UDim2.new(0, 6, 0, 6)
		layout.SortOrder           = Enum.SortOrder.LayoutOrder
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
		layout.Parent              = grid

		for i, drop in node.drops do
			buildTile(grid, i, drop)
		end
	end
end

-- Fuer BaerchiInventory: Seite zeigen/verstecken.
function IndexView.setVisible(visible: boolean)
	local page = _page
	if not page then return end
	page.Visible = visible
	if visible then
		IndexView.refresh(true)
	else
		hidePopup()
		_pinnedId = nil
	end
end

-- `host` ist der Dialog, in dem das Fenster liegen darf (damit es nicht vom
-- Scroller abgeschnitten wird); `parent` ist die Flaeche fuer die Seite.
function IndexView.build(parent: Instance, host: Frame): Frame
	local page = Theme.container("IndexPage", parent)
	page.Size    = UDim2.fromScale(1, 1)
	page.Visible = false
	_page = page

	local summary = Theme.label("Summary", page, "")
	summary.Size    = UDim2.new(1, 0, 0, 22)
	summary.TextSize = 16
	_summary = summary

	local scroller = Theme.scroller("IndexList", page)
	scroller.Position = UDim2.new(0, 0, 0, 28)
	scroller.Size     = UDim2.new(1, 0, 1, -28)
	_scroller = scroller

	local layout = Theme.listLayout(scroller, 10)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	-- Das Fenster haengt am Dialog, ganz oben.
	local popup = Theme.panel("DropPopup", host, Theme.COLORS.panelDeep)
	popup.Visible = false
	popup.ZIndex  = 50
	popup.Active  = false
	_popup     = popup
	_popupHost = host

	ClientState.onChanged(function()
		IndexView.refresh(false)
	end)
	Loc.onChanged(function()
		IndexView.refresh(true)
	end)

	return page
end

return IndexView
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX104"><Properties>
<string name="Name">LeaderboardPanel</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- LeaderboardPanel.luau
-- StarterPlayerScripts/UI/LeaderboardPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die Bestenlisten im Menue zeigen (v15): drei Reiter (Tower, Rebirths,
--     Sammlung), Top 50 und der eigene Rang.
--
-- Die Daten holt das Panel beim Oeffnen und beim Reiterwechsel ueber die
-- RemoteFunction GetLeaderboard (der Server antwortet aus seinem Cache, der
-- alle 120 s aufgefrischt wird). Ein Klick auf einen Namen eines Spielers auf
-- diesem Server oeffnet seine Profilkarte (Inspektor).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types             = require(ReplicatedStorage.Network.Types)
local Remotes           = require(ReplicatedStorage.Network.Remotes)
local Loc               = require(ReplicatedStorage.Localization.Loc)
local LeaderboardConfig = require(ReplicatedStorage.Config.LeaderboardConfig)
local TowerConfig       = require(ReplicatedStorage.Config.TowerConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)

local LeaderboardPanel = {}

local PANEL_NAME = "Leaderboard"
local ROW_HEIGHT = 26

local _root: Frame? = nil
local _scroller: ScrollingFrame? = nil
local _own: TextLabel? = nil
local _tabs: { [string]: TextButton } = {}
local _list = "Tower"
local _requestId = 0

local function formatValue(listId: string, value: number): string
	if listId == "Tower" then
		local towerId, stage = TowerConfig.fromLeaderboardValue(value)
		local def = TowerConfig.get(towerId) or TowerConfig.TOWERS[1]
		return string.format("Tower %s · %d", def.numeral, stage)
	end
	return Loc.formatNumber(value)
end

local function render(view: Types.LeaderboardView?)
	local scroller = _scroller
	if not scroller then return end
	for _, child in scroller:GetChildren() do
		if child:IsA("Frame") then child:Destroy() end
	end

	local own = _own
	if not view then
		if own then own.Text = Loc.t("ui.leaderboard.loading") end
		return
	end

	for _, entry in view.entries do
		local mine = entry.userId == Players.LocalPlayer.UserId
		local row = Theme.panel("Row" .. entry.rank, scroller, if mine then Theme.COLORS.panelLight else Theme.COLORS.panel)
		row.Size        = UDim2.new(1, -8, 0, ROW_HEIGHT)
		row.LayoutOrder = entry.rank

		local rank = Theme.label("Rank", row, "#" .. entry.rank)
		rank.Position = UDim2.new(0, 8, 0, 3)
		rank.Size     = UDim2.new(0, 44, 1, -6)
		rank.TextColor3 = if entry.rank <= 3 then Theme.COLORS.goldGummy else Theme.COLORS.textDim

		local name = Instance.new("TextButton")
		name.Name = "Name"
		name.BackgroundTransparency = 1
		name.Font = Theme.FONT
		name.TextScaled = true
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextColor3 = Theme.COLORS.text
		name.Text = entry.name
		name.Position = UDim2.new(0, 56, 0, 3)
		name.Size     = UDim2.new(0.55, -56, 1, -6)
		name.Parent   = row
		name.Activated:Connect(function()
			if Players:GetPlayerByUserId(entry.userId) and entry.userId ~= Players.LocalPlayer.UserId then
				PanelManager.open("Profile", entry.userId)
			end
		end)

		local value = Theme.label("Value", row, formatValue(view.listId, entry.value))
		value.AnchorPoint    = Vector2.new(1, 0)
		value.Position       = UDim2.new(1, -8, 0, 3)
		value.Size           = UDim2.new(0.42, 0, 1, -6)
		value.TextXAlignment = Enum.TextXAlignment.Right
	end

	if own then
		own.Text = if view.ownRank
			then Loc.t("ui.leaderboard.own_rank", { rank = view.ownRank, value = formatValue(view.listId, view.ownValue) })
			else Loc.t("ui.leaderboard.own_unranked", { value = formatValue(view.listId, view.ownValue) })
	end
end

local function load(listId: string)
	_list = listId
	for id, tab in _tabs do
		tab.BackgroundColor3 = if id == listId then Theme.COLORS.accent else Theme.COLORS.panelLight
	end
	render(nil)

	_requestId += 1
	local myRequest = _requestId
	task.spawn(function()
		local ok, view = pcall(function()
			return Remotes.GetLeaderboard:InvokeServer(listId)
		end)
		if myRequest ~= _requestId then return end   -- inzwischen anderer Reiter
		render(if ok and typeof(view) == "table" then view :: Types.LeaderboardView else nil)
	end)
end

function LeaderboardPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog("LeaderboardPanel", screenGui, Vector2.new(0.46, 0.72), Vector2.new(320, 420), Vector2.new(520, 640))
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.leaderboard.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	local tabs = Theme.container("Tabs", body)
	tabs.Size = UDim2.new(1, 0, 0, 30)
	local tabLayout = Theme.listLayout(tabs, 6, true)
	tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	for order, listId in LeaderboardConfig.LISTS do
		local tab = Theme.button("Tab_" .. listId, tabs, Loc.t("ui.leaderboard.list." .. listId), Theme.COLORS.panelLight)
		-- Paket 9: 5 Listen passen nur schmaler (gleich breit, 6 px Luecke)
		tab.Size = UDim2.new(1 / #LeaderboardConfig.LISTS, -6, 1, 0)
		tab.TextScaled = true
		tab.LayoutOrder = order
		tab.TextColor3 = Theme.COLORS.text
		tab.Activated:Connect(function() load(listId) end)
		_tabs[listId] = tab
	end

	local scroller = Theme.scroller("List", body)
	scroller.Position = UDim2.new(0, 0, 0, 38)
	scroller.Size     = UDim2.new(1, 0, 1, -72)
	local layout = Theme.listLayout(scroller, 4)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	_scroller = scroller

	local own = Theme.label("Own", body, "")
	own.AnchorPoint = Vector2.new(0, 1)
	own.Position    = UDim2.new(0, 4, 1, 0)
	own.Size        = UDim2.new(1, -8, 0, 26)
	own.TextColor3  = Theme.COLORS.goldGummy
	_own = own

	PanelManager.register(PANEL_NAME, {
		open = function()
			root.Visible = true
			load(_list)
		end,
		close = function()
			root.Visible = false
		end,
	})

	print("[LeaderboardPanel] Initialisiert")
end

return LeaderboardPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX105"><Properties>
<string name="Name">MenuBar</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- MenuBar.luau
-- StarterPlayerScripts/UI/MenuBar.luau
--
-- Einzige Zustaendigkeit:
--   - Die schmale Kachelleiste am rechten Bildschirmrand: Eier und Baerchis
--
-- ============================================================
-- WARUM NUR ZWEI KACHELN
-- ============================================================
-- Vorher standen hier sieben Kacheln (Eier, Baerchis, Kampf, drei Gebaeude,
-- Arena). Fuer einen neuen Spieler war das eine Wand aus Knoepfen ohne Antwort
-- auf "was mache ich jetzt?". Drei Dinge sind weggefallen:
--   - Gebaeude und Arena: Man oeffnet sie, indem man am Gebaeude selbst den
--     Prompt benutzt (WorldController). Eine zweite Tuer dorthin ist ueberfluessig.
--   - Kampf: Die PetBar unten ist der bessere Kampf-Knopf.
-- Uebrig bleiben die zwei Dinge, die man von ueberall aus braucht: Eier
-- (zum Schluepfen) und Baerchis (Sammlung, Fusion und der Index).
--
-- Welches Panel offen ist, weiss weiterhin ausschliesslich der PanelManager.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)

local Theme        = require(script.Parent.Theme)
local UiScale      = require(script.Parent.UiScale)
local PanelManager = require(script.Parent.PanelManager)
local Icons        = require(script.Parent.Icons)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Unlock       = require(script.Parent.Unlock)

-- HBB Paket 3: Kachel (Panel-Name) → Element-Id der Freischaltung
local TILE_ELEMENT: { [string]: string } = {
	Hatch = "tile_eggs", Inventory = "tile_bears", EggTree = "tile_tree",
	Leaderboard = "tile_leaderboard", DailyBonus = "tile_daily",
	Shop = "tile_shop",
}

local MenuBar = {}

-- Groessen. TILE ist gleichzeitig die Antippflaeche — darunter wird es auf dem
-- Handy zur Geduldsprobe.
local TILE   = 54
local LABEL  = 16
local GAP    = 6
local WIDTH  = 76

-- Was eine Kachel anzeigt: `value` ist die Beschriftung IN der Kachel,
-- `alert` laesst das rote Ausrufezeichen erscheinen.
type Live = (Types.PlayerDataUpdate) -> (string, boolean)

type Entry = {
	panel  : string,
	-- Beschriftung unter der Kachel. Eine Funktion statt eines Strings, weil
	-- sie bei jedem Sprachwechsel neu ausgewertet wird.
	title  : () -> string,
	color  : Color3,
	symbol : string,
	-- Name des Bild-Icons (siehe Icons); `symbol` ist der Text-Rueckfall
	icon   : string,
	live   : Live?,
}

type Tile = {
	entry : Entry,
	-- Die Beschriftung IN der Kachel ist das Text-Feld des Knopfes selbst: ein
	-- eigenes Label darueber wuerde die Klicks abfangen.
	tile  : TextButton,
	alert : Frame,
	label : TextLabel,
	-- true, wenn die Kachel ein Bild zeigt: dann bleibt ihr Text leer
	image : boolean,
}

local _tiles: { Tile } = {}

--------------------------------------------------------------------------------
-- Die Eintraege
--------------------------------------------------------------------------------

local function buildEntries(): { Entry }
	return {
		{ panel = "Hatch",     title = function() return Loc.t("ui.menu.eggs") end,     color = Theme.COLORS.gummy,  symbol = "EI", icon = "egg" },
		{ panel = "Inventory", title = function() return Loc.t("ui.menu.baerchis") end, color = Theme.COLORS.accent, symbol = "BA", icon = "bear" },
		-- v14: Ei-Baum. Das "!" zeigt eine ungenutzte Blaupause an.
		{ panel = "EggTree", title = function() return Loc.t("ui.menu.tree") end, color = Theme.COLORS.growth, symbol = "BAUM", icon = "tree",
			live = function(data: Types.PlayerDataUpdate)
				local bp = if data.eggTree then data.eggTree.blueprints or 0 else 0
				return "BAUM", bp > 0
			end },
		-- v15: Bestenlisten und Login-Bonus ("!" = heute noch nicht abgeholt)
		{ panel = "Leaderboard", title = function() return Loc.t("ui.menu.leaderboard") end, color = Theme.COLORS.goldGummy, symbol = "TOP", icon = "trophy" },
		{ panel = "DailyBonus", title = function() return Loc.t("ui.menu.daily") end, color = Theme.COLORS.gummy, symbol = "7", icon = "gift",
			live = function(data: Types.PlayerDataUpdate)
				local daily = data.daily
				return if daily then tostring(daily.day) else "7", daily ~= nil and daily.claimable
			end },
		-- HBB Paket 10: Shop ("!" = Gratis-Griff heute noch offen). Sichtbar ab
		-- der 2. Sitzung und nur mit SHOP_V1 (UnlockRules "tile_shop").
		{ panel = "Shop", title = function() return Loc.t("ui.menu.shop") end, color = Theme.COLORS.goldGummy, symbol = "GG", icon = "goldgummy",
			live = function(data: Types.PlayerDataUpdate)
				local shop = data.shop
				return "GG", shop ~= nil and shop.freeReady
			end },
	}
end

--------------------------------------------------------------------------------
-- Eine Kachel
--------------------------------------------------------------------------------

local function buildTile(parent: Instance, order: number, entry: Entry): Tile
	local slot = Theme.container("Slot_" .. entry.panel, parent)
	slot.Size        = UDim2.new(1, 0, 0, TILE + LABEL + 2)
	slot.LayoutOrder = order

	local button = Theme.button("Tile", slot, entry.symbol, entry.color)
	button.AnchorPoint = Vector2.new(0.5, 0)
	button.Position    = UDim2.new(0.5, 0, 0, 0)
	button.Size        = UDim2.new(0, TILE, 0, TILE)
	button.TextColor3  = Theme.COLORS.outline
	Theme.gradient(button, Theme.shade(entry.color, 0.34), Theme.shade(entry.color, -0.16))

	-- Bild-Icon gross in die Kachel. Ohne Asset bleibt das Text-Kuerzel stehen.
	local hasImage = Icons.has(entry.icon)
	if hasImage then
		button.Text = ""
		local icon = Icons.make(button, entry.icon)
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position    = UDim2.fromScale(0.5, 0.52)
		icon.Size        = UDim2.fromScale(0.86, 0.86)
		icon.ZIndex      = 3
	end

	button.Activated:Connect(function()
		local element = TILE_ELEMENT[entry.panel]
		if element then Unlock.markSeen(element) end
		PanelManager.toggle(entry.panel)
	end)

	-- Rotes Ausrufezeichen oben rechts, wie man es aus dem Genre kennt.
	-- Startet unsichtbar und wird von refresh() geschaltet.
	local alert = Theme.panel("Alert", slot, Theme.COLORS.bad)
	alert.AnchorPoint = Vector2.new(1, 0)
	alert.Position    = UDim2.new(0.5, TILE * 0.5 + 5, 0, -4)
	alert.Size        = UDim2.new(0, 20, 0, 20)
	alert.Visible     = false
	alert.ZIndex      = 3
	Theme.corner(alert, 10)

	local bang = Theme.label("Bang", alert, "!")
	bang.Size           = UDim2.fromScale(1, 1)
	bang.TextXAlignment = Enum.TextXAlignment.Center
	bang.ZIndex         = 4

	local label = Theme.label("Name", slot, entry.title())
	label.Position       = UDim2.new(0, 0, 0, TILE + 1)
	label.Size           = UDim2.new(1, 0, 0, LABEL)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextScaled     = false
	label.TextSize       = 14
	Theme.outlineText(label)

	return { entry = entry, tile = button, alert = alert, label = label, image = hasImage }
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

local function refresh(data: Types.PlayerDataUpdate)
	for _, tile in _tiles do
		-- HBB Paket 3: Kachel erst zeigen, wenn sie gebraucht wird; neue
		-- Kacheln tragen das "!" bis zum ersten Antippen.
		local element = TILE_ELEMENT[tile.entry.panel]
		local isNew = false
		if element then
			local slot = tile.tile.Parent
			if slot and slot:IsA("GuiObject") then
				Unlock.apply(element, slot)
			end
			isNew = Unlock.isNew(element)
			tile.alert.Visible = isNew
		end

		local live = tile.entry.live
		if live then
			local ok, value, alert = pcall(live, data)

			-- In pcall: eine kaputte Kachel darf nicht die ganze Leiste
			-- lahmlegen. Ein alter Spielstand ohne ein Gebaeude waere sonst
			-- genau so ein Fall.
			if ok then
				if not tile.image then
					tile.tile.Text = value
				end
				tile.alert.Visible = alert or isNew
			end
		end
	end
end

--------------------------------------------------------------------------------
-- HBB Paket 1: Ziel fliegender Icons (Eier fliegen zur Eier-Kachel)
--------------------------------------------------------------------------------

function MenuBar.getTileAnchor(panel: string): GuiObject?
	for _, tile in _tiles do
		if tile.entry.panel == panel then
			return tile.tile
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function MenuBar.init(screenGui: ScreenGui)
	local entries = buildEntries()
	local slot    = TILE + LABEL + 2
	local height  = #entries * slot + (#entries - 1) * GAP

	local root = Theme.container("MenuBar", screenGui)
	root.AnchorPoint = Vector2.new(1, 0)
	-- Rechte Kante, unter den Rang-/Rebirth-Pillen. Y bewusst als Pixel-Offset:
	-- die Pillen darueber sind ebenfalls pixelhoch, mit Scale wuerde die Leiste
	-- je nach Bildschirmhoehe hineinrutschen.
	root.Position = UDim2.new(0.988, 0, 0, 108)
	root.Size     = UDim2.new(0, WIDTH, 0, height)

	local layout = Theme.listLayout(root, GAP)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	-- Auf niedrigen Fenstern (Handy quer, kleines Studio-Fenster) schrumpfen,
	-- damit die Leiste nicht ueber den unteren Rand ragt.
	local scale = Instance.new("UIScale")
	scale.Parent = root
	local function rescale()
		local room = UiScale.toGui(screenGui.AbsoluteSize.Y) - 108 - 12
		scale.Scale = math.clamp(room / height, 0.55, 1)
	end
	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
	rescale()

	for order, entry in entries do
		table.insert(_tiles, buildTile(root, order, entry))
	end

	ClientState.onChanged(refresh)

	-- HBB Paket 3: ein Panel, das sich von selbst oeffnet (Login-Bonus u.a.), gilt
	-- ebenso als gesehen wie eines, das per Kachel geoeffnet wurde.
	PanelManager.onOpened(function(name)
		local element = TILE_ELEMENT[name]
		if element then Unlock.markSeen(element) end
	end)

	-- Sprachwechsel: nur die Beschriftungen neu setzen (die Zahlen in den
	-- Kacheln sind sprachunabhaengig)
	Loc.onChanged(function()
		for _, tile in _tiles do
			tile.label.Text = tile.entry.title()
		end
	end)

	print("[MenuBar] Initialisiert |", #entries, "Kacheln")
end

return MenuBar
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX106"><Properties>
<string name="Name">PetBar</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PetBar.luau
-- StarterPlayerScripts/UI/PetBar.luau
--
-- Einzige Zustaendigkeit:
--   - Die untere Pet-Leiste: zwei grosse Knoepfe "Event" und "Fight", die den
--     ausgeruesteten Baerchi hinschicken bzw. zurueckholen.
--
-- Die Leiste ZEIGT nur an, was der Server meldet (PetModeChanged) — was ein
-- Klick bedeutet, entscheidet PetModeService. Der Client schickt nur, welcher
-- Knopf gedrueckt wurde, und beim Fight-Knopf ggf. die Wahl aus der
-- Fortsetzungs-Frage (PitResumeDialog).
--
-- Zustaende je Knopf:
--   normal        Normalfarbe, Klick schickt hin
--   unterwegs/da  leuchtet, Text "Zurueckholen"
--   wartet        der Baerchi geht erst heim und dann hierher; Klick bricht ab
--   gesperrt      grau, kleine Zeile mit dem Grund

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local FeatureFlags      = require(ReplicatedStorage.Config.FeatureFlags)

local Remotes          = require(ReplicatedStorage.Network.Remotes)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)

local Theme           = require(script.Parent.Theme)
local UiScale         = require(script.Parent.UiScale)
local Icons           = require(script.Parent.Icons)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local FightStartPrompt = require(script.Parent.FightStartPrompt)
local ClientState     = require(script.Parent.Parent.Controllers.ClientState)
local Unlock          = require(script.Parent.Unlock)

local PetBar = {}

local BUTTON_WIDTH  = 210
local BUTTON_HEIGHT = 68    -- Mindesthoehe 56 px fuer Touch
local GAP           = 14

local EVENT_COLOR = Color3.fromRGB(120, 190, 255)
local FIGHT_COLOR = Color3.fromRGB(255,  96,  96)
local GLOW_COLOR  = Color3.fromRGB(255, 236, 140)

type ButtonView = {
	button : TextButton,
	title  : TextLabel,
	sub    : TextLabel,
	stroke : UIStroke,
	color  : Color3,
	icon   : GuiObject,
}

local _event: ButtonView? = nil
local _fight: ButtonView? = nil

-- Letzte Server-Meldung (PetModeChanged)
local _state   = "Home"
local _pending: string? = nil
local _stage: number? = nil
local _tower: string? = nil   -- v15: Tower des laufenden Kampfs (vom Server)
local _from: string? = nil
local _abducting = false

-- Event-Zyklus (EventPhaseChanged)
local _eventId: string? = nil
local _nextEventId: string? = nil
local _phaseEndsAt = 0

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- HBB Paket 6: Icon je Event fuer den Timer am Knopf (Name aus UI/Icons,
-- sonst das Zeichen als Rueckfall). Die Wespenkoenigin bekommt ein eigenes.
local EVENT_ICON: { [string]: { name: string, fallback: string } } = {
	Ufo            = { name = "ufo",   fallback = "UFO" },
	HotEgg         = { name = "egg",   fallback = "🥚" },
	MutationsSturm = { name = "",      fallback = "🌪" },
	Koenigshuegel  = { name = "crown", fallback = "♛" },
	Schatzgraeber  = { name = "gift",  fallback = "💎" },
	WaspQueen      = { name = "",      fallback = "🐝" },
}

local function clock(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

local function eventLine(): string
	local remaining = _phaseEndsAt - os.clock()
	if _eventId then
		local def = EventConfig.getById(_eventId)
		return string.format("%s  %s", if def then def.displayName else _eventId, clock(remaining))
	end
	if _nextEventId then
		return "Naechstes Event in " .. clock(remaining)
	end
	return ""
end

-- "Tower II" fuer eine Tower-Id.
local function towerLabel(towerId: string?): string
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	return "Tower " .. def.numeral
end

-- HP-Anteil des ausgeruesteten Baerchis (nil = keiner da) und der gewaehlte
-- Tower (v15, ersetzt das PIT-Level).
local function fighterInfo(): (number?, string)
	local data = ClientState.get()
	if not data then return nil, "I" end

	local tower = if data.towers then data.towers.selected else "I"
	local uid = data.island.equippedUid
	local baerchi = if uid then data.island.baerchis[uid] else nil
	local def = if baerchi then BaerchiConfig.getById(baerchi.configId) else nil
	if not baerchi or not def then
		return nil, tower
	end

	local maxHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
	local hp = math.clamp(baerchi.currentHp or maxHp, 0, maxHp)
	return hp / math.max(1, maxHp), tower
end

local function paint(view: ButtonView, title: string, sub: string, mode: "normal" | "active" | "waiting" | "disabled")
	view.title.Text = title
	view.sub.Text   = sub

	if mode == "disabled" then
		view.button.Active           = false
		view.button.AutoButtonColor  = false
		view.button.BackgroundColor3 = Theme.COLORS.disabled
		view.stroke.Color            = Theme.COLORS.outline
		view.stroke.Thickness        = Theme.OUTLINE_THICKNESS
		view.title.TextTransparency  = 0.35
		Icons.tint(view.icon, Color3.fromRGB(140, 140, 150))
		return
	end

	Icons.tint(view.icon, Color3.new(1, 1, 1))

	view.button.Active          = true
	view.button.AutoButtonColor = false
	view.title.TextTransparency = 0

	if mode == "active" then
		view.button.BackgroundColor3 = Theme.shade(view.color, 0.15)
		view.stroke.Color            = GLOW_COLOR
		view.stroke.Thickness        = 5
	elseif mode == "waiting" then
		view.button.BackgroundColor3 = Theme.shade(view.color, -0.25)
		view.stroke.Color            = GLOW_COLOR
		view.stroke.Thickness        = 3
	else
		view.button.BackgroundColor3 = view.color
		view.stroke.Color            = Theme.COLORS.outline
		view.stroke.Thickness        = Theme.OUTLINE_THICKNESS
	end
end

--------------------------------------------------------------------------------
-- Anzeige
--------------------------------------------------------------------------------

local _eventIconKey: string? = nil

-- Tauscht das Icon des Event-Knopfs gegen das des kommenden/laufenden Events.
local function setEventIcon(view: ButtonView, eventId: string?)
	local key = eventId or "Ufo"
	if _eventIconKey == key then return end
	_eventIconKey = key
	local look = EVENT_ICON[key] or EVENT_ICON.Ufo
	local old = view.icon
	local icon = Icons.make(view.button, look.name, look.fallback)
	icon.AnchorPoint = old.AnchorPoint
	icon.Position    = old.Position
	icon.Size        = old.Size
	icon.ZIndex      = old.ZIndex
	old:Destroy()
	view.icon = icon
end

local function refresh()
	local event, fight = _event, _fight
	if not event or not fight then return end

	-- HBB Paket 3: der Event-Knopf erscheint erst nach dem ersten Kampf
	Unlock.apply("button_event", event.button)

	local hpRatio, selectedTower = fighterInfo()
	local hasPet = hpRatio ~= nil

	-- --------------------------------------------------------------- Event
	if not hasPet then
		paint(event, "Event", "Kein Baerchi ausgeruestet", "disabled")
	elseif _abducting then
		paint(event, "Event", "Vom UFO entfuehrt …", "disabled")
	elseif _state == "ToEvent" then
		paint(event, "Zurueckholen", "laeuft hin • " .. eventLine(), "active")
	elseif _state == "AtEvent" then
		paint(event, "Zurueckholen", eventLine(), "active")
	elseif _pending == "Event" then
		paint(event, "wartet …", "erst heim, dann hin • Klick bricht ab", "waiting")
	elseif _state == "Returning" and _from == "Event" then
		paint(event, "Event", "kommt heim …", "normal")
	elseif FeatureFlags.isOn("EVENT_V2_TIMER") then
		-- HBB Paket 6: Icon des kommenden bzw. laufenden Events + Restzeit,
		-- keine Woerter.
		setEventIcon(event, _eventId or _nextEventId)
		paint(event, clock(_phaseEndsAt - os.clock()), "", "normal")
	else
		paint(event, "Event", eventLine(), "normal")
	end

	-- --------------------------------------------------------------- Fight
	local hpText = if hpRatio then string.format("HP %d%%  •  %s", math.floor(hpRatio * 100 + 0.5), towerLabel(selectedTower)) else ""

	if not hasPet then
		paint(fight, "Fight", "Kein Baerchi ausgeruestet", "disabled")
	elseif _state == "ToPit" then
		paint(fight, "Zurueckholen", "laeuft in den PIT …", "active")
	elseif _state == "InPit" then
		paint(fight, "Zurueckholen", if _stage then towerLabel(_tower or selectedTower) .. " · Stage " .. _stage else towerLabel(_tower or selectedTower), "active")
	elseif _pending == "Fight" then
		paint(fight, "wartet …", "erst heim, dann PIT • Klick bricht ab", "waiting")
	elseif _state == "Returning" and _from == "Fight" then
		paint(fight, "Fight", "kommt heim …", "normal")
	elseif (hpRatio or 0) <= 0 then
		paint(fight, "Fight", "Zu erschoepft — erst Honig", "disabled")
	else
		paint(fight, "Fight", hpText, "normal")
	end
end

--------------------------------------------------------------------------------
-- Klicks
--------------------------------------------------------------------------------

local function onEventClicked()
	Unlock.markSeen("button_event")
	Remotes.RequestPetMode:FireServer("Event")
end

local function onFightClicked()
	-- Zurueckholen oder einen vorgemerkten Wechsel abbrechen: keine Frage.
	if _state == "ToPit" or _state == "InPit" or _pending == "Fight" then
		Remotes.RequestPetMode:FireServer("Fight")
		return
	end

	-- Neuer Lauf: gibt es einen letzten Lauf in diesem Tower, zuerst die
	-- Fortsetzungs-Frage.
	local data = ClientState.get()

	-- Entscheidung 05.10. (FIGHT_RESUME_PROMPT): Standard ist IMMER Stage 1.
	-- Der Einstieg ab der letzten Stage gegen Gummies ist ein kleines Feld,
	-- das nach 7 s von selbst verschwindet (dann Stage 1). Ein zweiter
	-- Fight-Klick waehrend das Feld offen ist, startet sofort bei Stage 1.
	if FeatureFlags.isOn("FIGHT_RESUME_PROMPT") then
		if FightStartPrompt.isOpen() then
			FightStartPrompt.chooseFresh()
			return
		end
		local opened = FightStartPrompt.open(function(choice)
			Remotes.RequestPetMode:FireServer("Fight", choice)
		end)
		if not opened then
			Remotes.RequestPetMode:FireServer("Fight", "Fresh")
		end
		return
	end

	-- HBB Paket 2: keine Frage mehr. Mit gespeichertem Lauf geht es
	-- kostenlos ab 65 % weiter; der bezahlte Einstieg ab der letzten Stage
	-- ist ein eigener kleiner Knopf im Tower-Fenster (CombatPanel). Der
	-- Server rechnet beide Wege unveraendert.
	if FeatureFlags.isOn("UI_V2_GUIDE") then
		local choice = if data and PitResumeDialog.getProgress(data) then "Percent" else "Fresh"
		Remotes.RequestPetMode:FireServer("Fight", choice)
		return
	end

	if data and PitResumeDialog.getProgress(data) then
		PitResumeDialog.open(function(choice)
			Remotes.RequestPetMode:FireServer("Fight", choice)
		end)
		return
	end

	Remotes.RequestPetMode:FireServer("Fight", "Fresh")
end

--------------------------------------------------------------------------------
-- HBB Paket 2: Anker fuer die Fuehrung (GuideController)
--------------------------------------------------------------------------------

function PetBar.getButton(mode: string): GuiObject?
	local view = if mode == "Fight" then _fight elseif mode == "Event" then _event else nil
	return if view then view.button else nil
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

local function buildButton(parent: Instance, name: string, color: Color3, order: number, onClick: () -> (), iconName: string, fallback: string): ButtonView
	local button = Theme.bigButton(name, parent, "", color)
	button.Size        = UDim2.fromOffset(BUTTON_WIDTH, BUTTON_HEIGHT)
	button.LayoutOrder = order

	local stroke = button:FindFirstChildOfClass("UIStroke") :: UIStroke

	-- Icon links, ragt oben ueber den Knopf hinaus
	local icon = Icons.make(button, iconName, fallback)
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.Position    = UDim2.new(0, 6, 0.5, -6)
	icon.Size        = UDim2.fromOffset(60, 60)
	icon.ZIndex      = 4

	local title = Theme.label("Title", button, name)
	title.Position       = UDim2.new(0, 64, 0, 6)
	title.Size           = UDim2.new(1, -72, 0, 30)
	title.TextXAlignment = Enum.TextXAlignment.Center
	title.TextColor3     = Theme.COLORS.text
	Theme.outlineText(title)

	local sub = Theme.label("Sub", button, "")
	sub.Position       = UDim2.new(0, 64, 1, -26)
	sub.Size           = UDim2.new(1, -70, 0, 18)
	sub.TextXAlignment = Enum.TextXAlignment.Center
	sub.TextScaled     = false
	sub.TextSize       = 12
	sub.Font           = Theme.FONT_BODY
	sub.TextColor3     = Theme.COLORS.outline
	sub.TextTruncate   = Enum.TextTruncate.AtEnd

	button.Activated:Connect(function()
		if not button.Active then return end
		onClick()
	end)

	return { button = button, title = title, sub = sub, stroke = stroke, color = color, icon = icon }
end

function PetBar.init(screenGui: ScreenGui)
	local bar = Theme.container("PetBar", screenGui)
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position    = UDim2.new(0.5, 0, 1, -14)
	bar.Size        = UDim2.fromOffset(BUTTON_WIDTH * 2 + GAP, BUTTON_HEIGHT)
	bar.ZIndex      = 5

	-- Auf schmalen Bildschirmen (Handy) mitskalieren statt ueber den Rand
	local scale = Instance.new("UIScale")
	scale.Parent = bar
	local function rescale()
		local width = UiScale.toGui(screenGui.AbsoluteSize.X)
		scale.Scale = math.clamp((width - 32) / (BUTTON_WIDTH * 2 + GAP), 0.6, 1)
	end
	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
	rescale()

	local layout = Theme.listLayout(bar, GAP, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	_event = buildButton(bar, "Event", EVENT_COLOR, 1, onEventClicked, "ufo", "UFO")
	_fight = buildButton(bar, "Fight", FIGHT_COLOR, 2, onFightClicked, "swords", "X")
	FightStartPrompt.init(screenGui, bar)

	PitResumeDialog.init(screenGui)

	Remotes.PetModeChanged.OnClientEvent:Connect(function(state: any, pending: any, info: any)
		_state   = if typeof(state) == "string" then state else "Home"
		_pending = if typeof(pending) == "string" then pending else nil
		local typedInfo = if typeof(info) == "table" then info else {}
		_stage     = if typeof(typedInfo.stage) == "number" then typedInfo.stage else nil
		_tower     = if typeof(typedInfo.tower) == "string" then typedInfo.tower else nil
		_from      = if typeof(typedInfo.from) == "string" then typedInfo.from else nil
		_abducting = typedInfo.abducting == true

		-- Laeuft der Baerchi los, ist eine offene Fortsetzungs-Frage hinfaellig.
		if _state ~= "Home" and _state ~= "Returning" and PitResumeDialog.isOpen() then
			PitResumeDialog.close()
		end

		refresh()
	end)

	Remotes.EventPhaseChanged.OnClientEvent:Connect(function(eventId: any, remaining: any, nextEventId: any)
		_eventId     = if typeof(eventId) == "string" then eventId else nil
		_nextEventId = if typeof(nextEventId) == "string" then nextEventId else nil
		_phaseEndsAt = os.clock() + (if typeof(remaining) == "number" then remaining else 0)
		refresh()
	end)

	ClientState.onChanged(refresh)

	-- Restzeit des Events jede Sekunde nachziehen
	local accumulator = 0
	RunService.Heartbeat:Connect(function(delta)
		accumulator += delta
		if accumulator < 1 then return end
		accumulator = 0
		refresh()
	end)

	refresh()
	print("[PetBar] Initialisiert")
end

return PetBar
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX107"><Properties>
<string name="Name">PitResumeDialog</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PitResumeDialog.luau
-- StarterPlayerScripts/UI/PitResumeDialog.luau
--
-- Einzige Zustaendigkeit:
--   - Vor einem PIT-Lauf fragen, wo eingestiegen wird: von vorn, ab 65 % des
--     letzten Laufs oder ab der letzten erreichten Stage (gegen Gummies).
--
-- v15: pro Tower. Erscheint nur, wenn es im GEWAEHLTEN Tower einen
-- gespeicherten letzten Lauf gibt (island.towerProgress), auch nach einer
-- Niederlage oder einem Zurueckholen. Startstage und Kosten rechnet
-- TowerConfig — dieselben
-- Funktionen benutzt der Server beim Abbuchen. Nicht bezahlbare Optionen sind
-- sichtbar, aber nicht klickbar. Abbrechen schliesst den Dialog, der Baerchi
-- bleibt zu Hause.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local Theme       = require(script.Parent.Theme)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local PitResumeDialog = {}

export type Choice = "Fresh" | "Percent" | "Last"

local _root: Frame? = nil
local _hpLabel: TextLabel? = nil
local _options: { [Choice]: TextButton } = {}
local _onChoose: ((Choice) -> ())? = nil

local function selectedTower(data: Types.PlayerDataUpdate): string
	return if data.towers then data.towers.selected else TowerConfig.FIRST_TOWER
end

-- Die letzte erreichte Stage im gewaehlten Tower (nil = kein Lauf gespeichert).
function PitResumeDialog.getProgress(data: Types.PlayerDataUpdate): number?
	local progress = data.island.towerProgress
	local reached = if progress then progress[selectedTower(data)] else nil
	if typeof(reached) == "number" and reached >= 1 then
		return reached
	end
	return nil
end

-- Start-Stage und Gummi-Kosten einer Option — dieselbe Rechnung wie
-- CombatService.getResumeOffer (TowerConfig). Oeffentlich fuer FightStartPrompt.
local function offer(data: Types.PlayerDataUpdate, choice: Choice): (number, number)
	if choice == "Fresh" then
		return 1, 0
	end
	local reached = PitResumeDialog.getProgress(data)
	if not reached then
		return 1, 0
	end
	local towerId = selectedTower(data)
	local def = TowerConfig.get(towerId)
	local stage = if choice == "Last"
		then reached
		else TowerConfig.getResumePercentStage(reached)
	stage = math.clamp(stage, 1, if def then def.stages else 1)
	return stage, TowerConfig.getResumeCost(towerId, stage, data.rebirthMult)
end

local LABELS: { [Choice]: string } = {
	Fresh   = "Von vorn",
	Percent = "Ab 65 % des letzten Laufs",
	Last    = "Ab der letzten Stufe",
}

local function fill()
	local data = ClientState.get()
	if not data then return end

	for choice, button in _options do
		local stage, cost = offer(data, choice)
		local affordable = cost <= data.gummies

		button.Text = string.format("%s  —  Stage %d  —  %s",
			LABELS[choice], stage,
			if cost > 0 then Theme.formatNumber(cost) .. " Gummies" else "kostenlos")
		Theme.setEnabled(button, affordable)
	end

	local hpLabel = _hpLabel
	if hpLabel then
		local uid = data.island.equippedUid
		local baerchi = if uid then data.island.baerchis[uid] else nil
		local def = if baerchi then BaerchiConfig.getById(baerchi.configId) else nil
		local reached = PitResumeDialog.getProgress(data)
		if baerchi and def then
			local maxHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
			local hp = math.clamp(baerchi.currentHp or maxHp, 0, maxHp)
			hpLabel.Text = string.format("Tower %s  •  Letzter Lauf: Stage %d  •  HP %d / %d (%d%%)",
				(TowerConfig.get(selectedTower(data)) or TowerConfig.TOWERS[1]).numeral,
				reached or 0,
				hp, maxHp, math.floor(hp / math.max(1, maxHp) * 100 + 0.5))
		end
	end
end

function PitResumeDialog.offer(data: Types.PlayerDataUpdate, choice: Choice): (number, number)
	return offer(data, choice)
end

function PitResumeDialog.close()
	_onChoose = nil
	local root = _root
	if root then root.Visible = false end
end

-- Oeffnet den Dialog. `onChoose` bekommt die gewaehlte Option.
function PitResumeDialog.open(onChoose: (Choice) -> ())
	local root = _root
	if not root then return end
	_onChoose = onChoose
	fill()
	root.Visible = true
end

function PitResumeDialog.isOpen(): boolean
	return _root ~= nil and (_root :: Frame).Visible
end

function PitResumeDialog.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"PitResumeDialog", screenGui,
		Vector2.new(0.46, 0.42),
		Vector2.new(300, 280),
		Vector2.new(520, 340)
	)
	root.ZIndex = 20
	_root = root

	Theme.dialogHeader(root, "Wo soll er einsteigen?", PitResumeDialog.close)

	local body = Theme.dialogBody(root)
	local layout = Theme.listLayout(body, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local hp = Theme.bodyText("Hp", body, "")
	hp.Size        = UDim2.new(1, 0, 0, 20)
	hp.LayoutOrder = 0
	_hpLabel = hp

	local colors: { [Choice]: Color3 } = {
		Fresh   = Theme.COLORS.accent,
		Percent = Theme.COLORS.goldGummy,
		Last    = Theme.COLORS.bad,
	}

	for order, choice in { "Fresh", "Percent", "Last" } :: { Choice } do
		local button = Theme.bigButton("Option_" .. choice, body, LABELS[choice], colors[choice])
		button.Size        = UDim2.new(1, 0, 0, 44)
		button.LayoutOrder = order
		button.Activated:Connect(function()
			if not button.Active then return end
			local callback = _onChoose
			PitResumeDialog.close()
			if callback then callback(choice) end
		end)
		_options[choice] = button
	end

	local cancel = Theme.button("Cancel", body, "Abbrechen", Theme.COLORS.panelLight)
	cancel.Size        = UDim2.new(1, 0, 0, 34)
	cancel.LayoutOrder = 10
	cancel.TextColor3  = Theme.COLORS.text
	cancel.Activated:Connect(PitResumeDialog.close)

	ClientState.onChanged(function()
		if PitResumeDialog.isOpen() then fill() end
	end)

	print("[PitResumeDialog] Initialisiert")
end

return PitResumeDialog
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX108"><Properties>
<string name="Name">QuestPanel</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- QuestPanel.luau
-- StarterPlayerScripts/UI/QuestPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Das Quest-Fenster: die aktuelle Einsteiger-Quest und die Tages-Quests
--     mit Fortschritt und "Abholen"-Knopf
--   - Belohnungs-Text einer Quest (fuer Fenster, Tracker und Toast)
--
-- Das Fenster rechnet nichts: Fortschritt, Ziel und "abgeholt" liefert der
-- Server fertig in ClientState.get().quests (siehe QuestProgress). Auch ob
-- abholbar ist, prueft am Ende der Server — der Knopf hier ist nur die Anzeige.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local QuestConfig = require(ReplicatedStorage.Config.QuestConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local QuestPanel = {}

local PANEL_NAME = "Quests"
local ROW_H      = 78

local _root: Frame?              = nil
local _scroller: ScrollingFrame? = nil
local _receivedAt = os.clock()

--------------------------------------------------------------------------------
-- Hilfen (auch vom Tracker benutzt)
--------------------------------------------------------------------------------

function QuestPanel.title(questId: string): string
	return Loc.t("quest." .. questId .. ".title")
end

function QuestPanel.hint(questId: string): string
	return Loc.t("quest." .. questId .. ".hint")
end

function QuestPanel.rewardText(questId: string): string
	local def = QuestConfig.getById(questId)
	if not def then return "" end

	local eggType = def.reward.eggType
	local text = if eggType
		then Loc.t("ui.quest.reward_with_egg", {
			n   = def.reward.gummies,
			egg = Loc.name("egg." .. eggType .. ".name", eggType),
		})
		else Loc.t("ui.quest.reward_gummies", { n = def.reward.gummies })
	-- GOLD_CHARMS_ONLY: Tages-Quests zeigen ihr Gold dazu
	local gold = QuestConfig.goldReward(def)
	if gold > 0 then
		text ..= "  " .. Loc.t("ui.quest.reward_gold", { n = gold })
	end
	return text
end

function QuestPanel.claim(entry: Types.QuestEntry)
	Remotes.RequestClaimQuest:FireServer(entry.kind, entry.id)
end

--------------------------------------------------------------------------------
-- Zeile
--------------------------------------------------------------------------------

local function buildRow(parent: Instance, order: number, entry: Types.QuestEntry)
	local done = entry.progress >= entry.target

	local row = Theme.panel("Quest_" .. entry.id, parent, Theme.COLORS.panel)
	row.Size        = UDim2.new(1, -8, 0, ROW_H)
	row.LayoutOrder = order

	local title = Theme.label("Title", row, QuestPanel.title(entry.id))
	title.Position = UDim2.new(0, 10, 0, 6)
	title.Size     = UDim2.new(1, -130, 0, 20)

	local reward = Theme.bodyText("Reward", row, QuestPanel.rewardText(entry.id))
	reward.Position   = UDim2.new(0, 10, 0, 28)
	reward.Size       = UDim2.new(1, -130, 0, 16)
	reward.TextSize   = 13
	reward.TextColor3 = Theme.COLORS.goldGummy

	local bar = Theme.progress(row, if done then Theme.COLORS.good else Theme.COLORS.accent)
	bar.track.Position = UDim2.new(0, 10, 1, -26)
	bar.track.Size     = UDim2.new(1, -130, 0, 18)
	bar.fill.Size      = UDim2.fromScale(math.clamp(entry.progress / math.max(1, entry.target), 0, 1), 1)
	bar.text.Text      = Loc.formatNumber(entry.progress) .. " / " .. Loc.formatNumber(entry.target)
	bar.text.TextScaled = false
	bar.text.TextSize   = 12

	if entry.claimed then
		local tag = Theme.label("Done", row, Loc.t("ui.quest.claimed"))
		tag.AnchorPoint    = Vector2.new(1, 0.5)
		tag.Position       = UDim2.new(1, -12, 0.5, 0)
		tag.Size           = UDim2.new(0, 100, 0, 24)
		tag.TextXAlignment = Enum.TextXAlignment.Center
		tag.TextColor3     = Theme.COLORS.good
	else
		local button = Theme.bigButton("Claim", row, Loc.t("ui.quest.claim_short"), Theme.COLORS.good)
		button.AnchorPoint = Vector2.new(1, 0.5)
		button.Position    = UDim2.new(1, -10, 0.5, 0)
		button.Size        = UDim2.new(0, 104, 0, 38)
		Theme.setEnabled(button, done)
		button.Activated:Connect(function()
			if done then QuestPanel.claim(entry) end
		end)
	end
end

local function buildSection(parent: Instance, order: number, text: string)
	local label = Theme.label("Section_" .. order, parent, text)
	label.LayoutOrder = order
	label.Size        = UDim2.new(1, -8, 0, 24)
	label.TextColor3  = Theme.COLORS.accent
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

function QuestPanel.refresh()
	local scroller, root = _scroller, _root
	if not scroller or not root or not root.Visible then return end

	for _, child in scroller:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	local data = ClientState.get()
	if not data or not data.quests then return end
	local quests = data.quests

	local order = 1
	buildSection(scroller, order, Loc.t("ui.quest.section_chain") .. "  "
		.. quests.chainDone .. "/" .. quests.chainTotal)
	order += 1

	if quests.chain then
		buildRow(scroller, order, quests.chain)
		order += 1
		local hint = Theme.bodyText("Hint", scroller, QuestPanel.hint(quests.chain.id))
		hint.LayoutOrder = order
		hint.Size        = UDim2.new(1, -8, 0, 34)
		order += 1
	else
		local all = Theme.bodyText("AllDone", scroller, Loc.t("ui.quest.chain_done"))
		all.LayoutOrder = order
		all.Size        = UDim2.new(1, -8, 0, 22)
		order += 1
	end

	buildSection(scroller, order, Loc.t("ui.quest.section_daily"))
	order += 1

	for _, entry in quests.daily do
		buildRow(scroller, order, entry)
		order += 1
	end

	local remaining = math.max(0, quests.dailyResetIn - (os.clock() - _receivedAt))
	local resets = Theme.bodyText("Resets", scroller, Loc.t("ui.quest.resets_in", { time = Loc.formatDuration(remaining) }))
	resets.LayoutOrder = order
	resets.Size        = UDim2.new(1, -8, 0, 20)
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function QuestPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog("QuestPanel", screenGui,
		Vector2.new(0.46, 0.7), Vector2.new(300, 320), Vector2.new(480, 560))
	_root = root

	local title = Theme.dialogHeader(root, "", function()
		PanelManager.close(PANEL_NAME)
	end)
	Loc.bind(title, "ui.quest.panel_title")

	local body = Theme.dialogBody(root)

	local scroller = Theme.scroller("List", body)
	scroller.Size = UDim2.fromScale(1, 1)
	_scroller = scroller
	local layout = Theme.listLayout(scroller, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	PanelManager.register(PANEL_NAME, {
		open = function()
			root.Visible = true
			QuestPanel.refresh()
		end,
		close = function()
			root.Visible = false
		end,
	})

	ClientState.onChanged(function()
		_receivedAt = os.clock()
		QuestPanel.refresh()
	end)
	Loc.onChanged(function()
		QuestPanel.refresh()
	end)

	print("[QuestPanel] Initialisiert")
end

return QuestPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX109"><Properties>
<string name="Name">QuestTracker</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- QuestTracker.luau
-- StarterPlayerScripts/UI/QuestTracker.luau
--
-- Einzige Zustaendigkeit:
--   - Die kleine Quest-Karte links: immer EINE aktuelle Aufgabe mit Hinweis,
--     Fortschritt und (wenn geschafft) dem Abholen-Knopf
--   - Der Zugang zum Quest-Fenster (Karte antippen)
--   - Der Toast bei ausgezahlter Belohnung
--
-- Das ist die Antwort auf "was mache ich jetzt?": der Spieler muss nichts
-- oeffnen, die naechste sinnvolle Aufgabe steht immer im Bild. Die Karte
-- rechnet nichts, sie zeigt ClientState.get().quests.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")

local Types   = require(ReplicatedStorage.Network.Types)
local Remotes = require(ReplicatedStorage.Network.Remotes)
local Loc     = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local QuestConfig  = require(ReplicatedStorage.Config.QuestConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local Icons        = require(script.Parent.Icons)
local QuestPanel   = require(script.Parent.QuestPanel)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local QuestTracker = {}

local CARD_W = 236
-- Playtest 05.10.: 124 liess "Abholen" und "Tagesbonus" ineinander laufen
local CARD_H = 142

local _card: Frame?          = nil
local _header: TextLabel?    = nil
local _title: TextLabel?     = nil
local _hint: TextLabel?      = nil
local _bar: Theme.Progress?  = nil
local _claim: TextButton?    = nil
local _daily: TextButton?    = nil
local _alert: Frame?         = nil
local _pulse: Tween?         = nil

local function dailyReady(quests: Types.QuestView): (number, number)
	local done, claimable = 0, 0
	for _, entry in quests.daily do
		if entry.claimed then
			done += 1
		elseif entry.progress >= entry.target then
			claimable += 1
		end
	end
	return done, claimable
end

local _bonusOpen = false

-- HBB Paket 2: kompakte Karte (Icon + Zaehler + Belohnungs-Icon). Antippen
-- klappt den Volltext fuer EXPAND_SECONDS auf; ein zweites Antippen oeffnet
-- wie bisher das Quest-Fenster.
local EXPAND_SECONDS = 6
local _expanded = false
local _expandToken = 0
local _questIcon: Frame? = nil
local _reward: Frame? = nil
local _rewardIcon: Frame? = nil
local _rewardLabel: TextLabel? = nil
local _claimCheck: GuiObject? = nil

local function compact(): boolean
	return FeatureFlags.isOn("UI_V2_GUIDE") and not _expanded
end

local function setIcon(holder: Frame?, name: string, fallback: string)
	if not holder then return end
	if holder:GetAttribute("IconName") == name then return end
	holder:SetAttribute("IconName", name)
	for _, child in holder:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	local icon = Icons.make(holder, name, fallback)
	icon.Size = UDim2.fromScale(1, 1)
	icon.ZIndex = 4
end

local function refresh(data: Types.PlayerDataUpdate)
	local quests = data.quests
	local header, title, hint, bar, claim, daily, alert =
		_header, _title, _hint, _bar, _claim, _daily, _alert
	if not quests or not header or not title or not hint or not bar or not claim or not daily or not alert then
		return
	end

	local chain = quests.chain
	if chain then
		local done = chain.progress >= chain.target
		header.Text = Loc.t("ui.quest.header", { done = quests.chainDone + 1, total = quests.chainTotal })
		title.Text  = QuestPanel.title(chain.id)
		hint.Text   = if done then QuestPanel.rewardText(chain.id) else QuestPanel.hint(chain.id)
		hint.TextColor3 = if done then Theme.COLORS.goldGummy else Theme.COLORS.textDim

		bar.track.Visible = not done
		claim.Visible     = done
		bar.fill.Size     = UDim2.fromScale(math.clamp(chain.progress / math.max(1, chain.target), 0, 1), 1)
		bar.text.Text     = Loc.formatNumber(chain.progress) .. " / " .. Loc.formatNumber(chain.target)

		claim:SetAttribute("QuestId", chain.id)
	else
		header.Text = Loc.t("ui.quest.panel_title")
		title.Text  = Loc.t("ui.quest.chain_done")
		hint.Text   = ""
		bar.track.Visible = false
		claim.Visible     = false
	end

	-- HBB Paket 2: kompakte Darstellung
	local isCompact = compact()
	header.Visible = not isCompact
	title.Visible  = not isCompact
	hint.Visible   = not isCompact
	local questIcon, reward, rewardIcon, rewardLabel, check = _questIcon, _reward, _rewardIcon, _rewardLabel, _claimCheck
	if questIcon and reward and rewardLabel and check then
		local def = if chain then QuestConfig.getById(chain.id) else nil
		questIcon.Visible = isCompact and def ~= nil
		reward.Visible    = isCompact and def ~= nil
		check.Visible     = isCompact and claim.Visible
		claim.TextTransparency = if isCompact then 1 else 0
		if def then
			setIcon(questIcon, QuestConfig.METRIC_ICON[def.metric] or "scroll", "?")
			if def.reward.eggType then
				setIcon(rewardIcon, "egg", "EI")
				rewardLabel.Text = "+" .. Loc.formatNumber(def.reward.gummies)
			else
				setIcon(rewardIcon, "gummy", "G")
				rewardLabel.Text = "+" .. Loc.formatNumber(def.reward.gummies)
			end
		end
		-- Der Abholen-Knopf bleibt, wo er ist (sein Puls-Tween setzt die Groesse).
		if isCompact then
			bar.track.Position = UDim2.new(0, 64, 0, 18)
			bar.track.Size     = UDim2.new(1, -74, 0, 22)
		else
			bar.track.Position = UDim2.new(0, 10, 0, 80)
			bar.track.Size     = UDim2.new(1, -20, 0, 18)
		end
	end

	local doneCount, claimable = dailyReady(quests)
	-- v15: ist der Login-Bonus noch nicht abgeholt, zeigt der untere Knopf
	-- darauf (und oeffnet das Bonus-Fenster statt der Quests).
	local bonusOpen = data.daily ~= nil and data.daily.claimable
	_bonusOpen = bonusOpen
	if isCompact then
		-- Nur Zeichen und Zahlen: Geschenk = Login-Bonus, Rolle = Tagesquests
		daily.Text = if bonusOpen then "🎁" else string.format("📜 %d/%d", doneCount, #quests.daily)
	else
		daily.Text = if bonusOpen
			then Loc.t("ui.daily.tracker_hint")
			else Loc.t("ui.quest.daily_link", { done = doneCount, total = #quests.daily })
	end

	-- Rotes "!" am Karten-Rand: irgendetwas ist abholbereit.
	local chainReady = chain ~= nil and chain.progress >= chain.target
	alert.Visible = chainReady or claimable > 0 or bonusOpen
end

function QuestTracker.init(screenGui: ScreenGui)
	local card = Theme.panel("QuestTracker", screenGui, Theme.COLORS.panelDeep)
	card.Position = UDim2.new(0.012, 12, 0, 148)
	card.Size     = UDim2.new(0, CARD_W, 0, CARD_H)
	card.ZIndex   = 2
	_card = card

	-- Die ganze Karte ist antippbar (oeffnet das Quest-Fenster); die Knoepfe
	-- darauf liegen hoeher und fangen ihre eigenen Klicks ab.
	local hit = Instance.new("TextButton")
	hit.Name                   = "Hit"
	hit.BackgroundTransparency = 1
	hit.Text                   = ""
	hit.Size                   = UDim2.fromScale(1, 1)
	hit.ZIndex                 = 2
	hit.Parent                 = card
	hit.Activated:Connect(function()
		-- HBB Paket 2: erst aufklappen (Volltext), dann erst das Fenster
		if compact() then
			_expanded = true
			_expandToken += 1
			local token = _expandToken
			local data = ClientState.get()
			if data then refresh(data) end
			task.delay(EXPAND_SECONDS, function()
				if token ~= _expandToken then return end
				_expanded = false
				local current = ClientState.get()
				if current then refresh(current) end
			end)
			return
		end
		PanelManager.toggle("Quests")
	end)

	-- Schriftrolle links oben, ragt ueber die Ecke der Karte hinaus
	local icon = Icons.make(card, "scroll", "?")
	icon.Position = UDim2.new(0, -10, 0, -12)
	icon.Size     = UDim2.fromOffset(40, 40)
	icon.ZIndex   = 4

	local header = Theme.label("Header", card, "")
	header.Position   = UDim2.new(0, 36, 0, 5)
	header.Size       = UDim2.new(1, -46, 0, 14)
	header.TextColor3 = Theme.COLORS.accent
	_header = header

	local title = Theme.label("Title", card, "")
	title.Position = UDim2.new(0, 36, 0, 20)
	title.Size     = UDim2.new(1, -46, 0, 22)
	Theme.outlineText(title, 2)
	_title = title

	local hint = Theme.bodyText("Hint", card, "")
	hint.Position  = UDim2.new(0, 10, 0, 44)
	hint.Size      = UDim2.new(1, -20, 0, 32)
	hint.TextSize  = 12
	_hint = hint

	local bar = Theme.progress(card, Theme.COLORS.accent)
	bar.track.Position = UDim2.new(0, 10, 0, 80)
	bar.track.Size     = UDim2.new(1, -20, 0, 18)
	bar.text.TextScaled = false
	bar.text.TextSize   = 12
	_bar = bar

	local claim = Theme.bigButton("Claim", card, "", Theme.COLORS.good)
	-- Mittig verankert: das Pulsieren waechst nach beiden Seiten statt nach rechts unten
	claim.AnchorPoint = Vector2.new(0.5, 0)
	claim.Position = UDim2.new(0.5, 0, 0, 78)
	claim.Size     = UDim2.new(1, -20, 0, 28)
	claim.ZIndex   = 3
	claim.Visible  = false
	Loc.bind(claim, "ui.quest.claim")
	_claim = claim
	claim.Activated:Connect(function()
		local id = claim:GetAttribute("QuestId")
		if typeof(id) == "string" then
			Remotes.RequestClaimQuest:FireServer("chain", id)
		end
	end)

	-- Sanftes Pulsieren, damit ein abholbarer Knopf auffaellt.
	_pulse = TweenService:Create(claim, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Size = UDim2.new(1, -14, 0, 30),
	})
	_pulse:Play()

	local daily = Theme.button("Daily", card, "", Theme.COLORS.panelLight)
	daily.Position   = UDim2.new(0, 10, 1, -30)
	daily.Size       = UDim2.new(1, -20, 0, 22)
	daily.TextColor3 = Theme.COLORS.text
	daily.ZIndex     = 3
	_daily = daily
	daily.Activated:Connect(function()
		PanelManager.toggle(if _bonusOpen then "DailyBonus" else "Quests")
	end)

	local alert = Theme.panel("Alert", card, Theme.COLORS.bad)
	alert.AnchorPoint = Vector2.new(1, 0)
	alert.Position    = UDim2.new(1, 6, 0, -6)
	alert.Size        = UDim2.new(0, 22, 0, 22)
	alert.Visible     = false
	alert.ZIndex      = 4
	Theme.corner(alert, 11)
	local bang = Theme.label("Bang", alert, "!")
	bang.Size           = UDim2.fromScale(1, 1)
	bang.TextXAlignment = Enum.TextXAlignment.Center
	bang.ZIndex         = 5
	_alert = alert

	-- HBB Paket 2: Elemente der kompakten Karte
	local questIcon = Theme.container("QuestIcon", card)
	questIcon.Position = UDim2.new(0, 8, 0, 8)
	questIcon.Size     = UDim2.fromOffset(50, 50)
	questIcon.ZIndex   = 3
	questIcon.Visible  = false
	_questIcon = questIcon

	local reward = Theme.container("Reward", card)
	reward.Position = UDim2.new(0, 64, 0, 46)
	reward.Size     = UDim2.new(1, -74, 0, 28)
	reward.ZIndex   = 3
	reward.Visible  = false
	_reward = reward
	local rewardIcon = Theme.container("Icon", reward)
	rewardIcon.Size = UDim2.fromOffset(28, 28)
	_rewardIcon = rewardIcon
	local rewardLabel = Theme.label("Amount", reward, "")
	rewardLabel.Position = UDim2.new(0, 34, 0, 2)
	rewardLabel.Size     = UDim2.new(1, -34, 1, -4)
	rewardLabel.TextColor3 = Theme.COLORS.goldGummy
	Theme.outlineText(rewardLabel, 2)
	_rewardLabel = rewardLabel

	local check = Icons.make(claim, "check", "✓")
	check.AnchorPoint = Vector2.new(0.5, 0.5)
	check.Position    = UDim2.fromScale(0.5, 0.5)
	check.Size        = UDim2.fromOffset(24, 24)
	check.ZIndex      = 4
	check.Visible     = false
	_claimCheck = check

	ClientState.onChanged(refresh)
	Loc.onChanged(function()
		local data = ClientState.get()
		if data then refresh(data) end
	end)

	Remotes.QuestRewardReceived.OnClientEvent:Connect(function(reward: Types.QuestReward)
		-- Gummies und Eier der Quest fliegen ueber den Datenstand.
		Notify.emit("quest_reward", function()
			Toast.success(Loc.t("ui.quest.toast", { text = QuestPanel.rewardText(reward.questId) }))
		end)
	end)

	print("[QuestTracker] Initialisiert")
end

return QuestTracker
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX110"><Properties>
<string name="Name">ShopPanel</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- ShopPanel.luau
-- StarterPlayerScripts/UI/ShopPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Das Shop-Fenster (HBB Paket 10, FeatureFlags.SHOP_V1): Gratis-Griff
--     (einmal pro UTC-Tag GoldGummies) und Robux-Goldpakete.
--
-- Was abholbar ist, entscheidet der Server (PlayerDataUpdate.shop,
-- RequestClaimFreeGrab). Robux-Kaeufe startet der Client nur
-- (PromptProductPurchase); ausgezahlt wird ausschliesslich in
-- ShopService.processReceipt. Pakete mit productId 0 sind nicht eingerichtet
-- und erscheinen nicht.
--
-- Erklaert nebenbei, WOFUER GoldGummies sind (Playtest 05.10.: "keine Ahnung,
-- woher man die bekommt"): eine Zeile unter dem Gratis-Griff.

local Players            = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local TweenService       = game:GetService("TweenService")

local Types        = require(ReplicatedStorage.Network.Types)
local Remotes      = require(ReplicatedStorage.Network.Remotes)
local Loc          = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local ShopConfig   = require(ReplicatedStorage.Config.ShopConfig)
local UnlockRules  = require(ReplicatedStorage.Modules.UnlockRules)

local Theme        = require(script.Parent.Theme)
local Icons        = require(script.Parent.Icons)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local ShopPanel = {}

local PANEL_NAME = "Shop"

local _root: Frame? = nil
local _freeButton: TextButton? = nil
local _freeStatus: TextLabel? = nil
local _pulse: Tween? = nil

local function refresh()
	local data = ClientState.get()
	local view: Types.ShopView? = if data then (data :: any).shop else nil
	local button, status = _freeButton, _freeStatus
	if not view or not button or not status then return end

	button.Text = if view.freeReady then Loc.t("ui.shop.free_claim") else Loc.t("ui.shop.free_taken")
	Theme.setEnabled(button, view.freeReady)
	status.Text = if view.freeReady
		then Loc.t("ui.shop.free_hint")
		else Loc.t("ui.shop.free_next", { time = Loc.formatDuration(view.nextFreeIn) })

	local pulse = _pulse
	if pulse then
		if view.freeReady then pulse:Play() else pulse:Cancel() end
	end
end

local function buildPack(parent: Instance, order: number, product: ShopConfig.Product)
	local card = Theme.panel("Pack_" .. product.key, parent, Theme.COLORS.panel)
	card.LayoutOrder = order
	card.Size = UDim2.new(1 / 3, -8, 1, 0)

	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Position = UDim2.new(0.5, 0, 0, 8)
	holder.Size = UDim2.new(0.6, 0, 0.42, 0)
	holder.Parent = card
	local icon = Icons.make(holder, product.icon, "GG")
	icon.Size = UDim2.fromScale(1, 1)

	local amount = Theme.label("Amount", card, "+" .. Loc.formatNumber(product.gold))
	amount.AnchorPoint = Vector2.new(0.5, 0)
	amount.Position = UDim2.new(0.5, 0, 0.45, 8)
	amount.Size = UDim2.new(1, -8, 0, 22)
	amount.TextXAlignment = Enum.TextXAlignment.Center

	local buy = Theme.bigButton("Buy", card, Loc.t("ui.shop.buy"), Theme.COLORS.goldGummy)
	buy.AnchorPoint = Vector2.new(0.5, 1)
	buy.Position = UDim2.new(0.5, 0, 1, -8)
	buy.Size = UDim2.new(1, -16, 0, 34)
	buy.Activated:Connect(function()
		MarketplaceService:PromptProductPurchase(Players.LocalPlayer, product.productId)
	end)

	-- Preis in Robux aus dem Dashboard nachladen (massgeblich ist nur dieser)
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(product.productId, Enum.InfoType.Product)
		end)
		if ok and typeof(info) == "table" and typeof((info :: any).PriceInRobux) == "number" then
			buy.Text = "R$ " .. Loc.formatNumber((info :: any).PriceInRobux)
		end
	end)
end

function ShopPanel.init(screenGui: ScreenGui)
	if not FeatureFlags.isOn("SHOP_V1") then return end
	-- Shop-Kachel darf freigeschaltet werden (UnlockRules hat keine requires)
	UnlockRules.SHOP_ENABLED = true

	local root = Theme.dialog("ShopPanel", screenGui, Vector2.new(0.56, 0.6), Vector2.new(360, 340), Vector2.new(640, 480))
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.shop.title"), function()
		PanelManager.close(PANEL_NAME)
	end)
	local body = Theme.dialogBody(root)

	-- Gratis-Griff: grosse Karte oben
	local free = Theme.panel("Free", body, Theme.COLORS.goldGummy)
	free.Size = UDim2.new(1, 0, 0.46, 0)
	Theme.gradient(free, Color3.fromRGB(255, 236, 160), Color3.fromRGB(255, 190, 60))
	local scale = Instance.new("UIScale")
	scale.Parent = free
	_pulse = TweenService:Create(scale, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.03 })

	local giftHolder = Instance.new("Frame")
	giftHolder.BackgroundTransparency = 1
	giftHolder.Position = UDim2.new(0, 12, 0.1, 0)
	giftHolder.Size = UDim2.new(0.22, 0, 0.8, 0)
	giftHolder.Parent = free
	local gift = Icons.make(giftHolder, "gift", "🎁")
	gift.Size = UDim2.fromScale(1, 1)

	local freeTitle = Theme.label("Title", free, Loc.t("ui.shop.free_title", { n = ShopConfig.FREE_GRAB_GOLD }))
	freeTitle.Position = UDim2.new(0.27, 0, 0.08, 0)
	freeTitle.Size = UDim2.new(0.7, 0, 0.3, 0)
	freeTitle.TextColor3 = Theme.COLORS.outline

	local freeButton = Theme.bigButton("Claim", free, "", Theme.COLORS.good)
	freeButton.Position = UDim2.new(0.27, 0, 0.42, 0)
	freeButton.Size = UDim2.new(0.68, 0, 0.3, 0)
	freeButton.Activated:Connect(function()
		if not freeButton.Active then return end
		Remotes.RequestClaimFreeGrab:FireServer()
	end)
	_freeButton = freeButton

	local status = Theme.bodyText("Status", free, "")
	status.Position = UDim2.new(0.27, 0, 0.76, 0)
	status.Size = UDim2.new(0.7, 0, 0.22, 0)
	status.TextColor3 = Theme.COLORS.outline
	status.TextSize = 12
	_freeStatus = status

	-- Robux-Pakete (nur eingerichtete)
	local live: { ShopConfig.Product } = {}
	for _, product in ShopConfig.PRODUCTS do
		if product.productId ~= 0 then table.insert(live, product) end
	end
	if #live > 0 then
		local row = Theme.container("Packs", body)
		row.Position = UDim2.new(0, 0, 0.5, 0)
		row.Size = UDim2.new(1, 0, 0.5, 0)
		local layout = Theme.listLayout(row, 8, true)
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		for order, product in live do
			buildPack(row, order, product)
		end
	else
		local soon = Theme.bodyText("Soon", body, Loc.t("ui.shop.more_soon"))
		soon.Position = UDim2.new(0, 0, 0.54, 0)
		soon.Size = UDim2.new(1, 0, 0, 40)
		soon.TextXAlignment = Enum.TextXAlignment.Center
	end

	PanelManager.register(PANEL_NAME, {
		open = function()
			root.Visible = true
			refresh()
		end,
		close = function()
			root.Visible = false
			local pulse = _pulse
			if pulse then pulse:Cancel() end
		end,
	})

	ClientState.onChanged(function()
		if root.Visible then refresh() end
	end)

	print("[ShopPanel] Initialisiert | Pakete:", #live)
end

return ShopPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX111"><Properties>
<string name="Name">Theme</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- Theme.luau
-- StarterPlayerScripts/UI/Theme.luau
--
-- Einzige Zustaendigkeit:
--   - Farben, Schrift und Baustein-Helfer fuer das gesamte UI
--
-- Kein UI-Modul definiert eigene Farben oder baut Frames von Hand —
-- alles laeuft hier durch. Wenn der Look sich aendert, aendert er sich hier.
--
-- Die Rarity-Farben kommen bewusst NICHT von hier, sondern aus
-- BaerchiConfig.RARITY_COLORS: der Server faerbt die Figuren auf der Insel
-- mit denselben Werten, und die duerfen nicht auseinanderlaufen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")

local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local Types         = require(ReplicatedStorage.Network.Types)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local RarityBandConfig = require(ReplicatedStorage.Config.RarityBandConfig)  -- HBB Paket 4

local Theme = {}

--------------------------------------------------------------------------------
-- Farben
--------------------------------------------------------------------------------

Theme.COLORS = {
	-- Flaechen
	panel      = Color3.fromRGB( 52,  46,  78),
	panelDeep  = Color3.fromRGB( 38,  34,  58),
	panelLight = Color3.fromRGB( 72,  64, 104),

	-- Rahmen (der dicke dunkle Cartoon-Rand)
	outline    = Color3.fromRGB( 24,  20,  38),

	-- Schrift
	text       = Color3.fromRGB(255, 255, 255),
	textDim    = Color3.fromRGB(188, 182, 210),

	-- Waehrungen
	gummy      = Color3.fromRGB(255, 105, 150),
	goldGummy  = Color3.fromRGB(255, 196,  60),

	-- Zustaende
	good       = Color3.fromRGB( 76, 217, 100),
	bad        = Color3.fromRGB(255,  82,  82),
	accent     = Color3.fromRGB(120, 190, 255),

	-- Die drei Gebaeude-Rollen (siehe Theme.buildingColor). Benannt nach der
	-- ROLLE, nicht nach dem Gebaeude: die Farbe soll sagen WOFUER sein Honig
	-- gut ist.
	volume     = Color3.fromRGB(255, 186,  62),   -- Vorrat
	healing    = Color3.fromRGB( 92, 222, 160),   -- Heilung
	growth     = Color3.fromRGB(178, 148, 255),   -- Wachstum

	-- Ausgegrauter Button (siehe Theme.setEnabled)
	disabled   = Color3.fromRGB( 84,  80, 104),
}

Theme.FONT      = Enum.Font.FredokaOne
Theme.FONT_BODY = Enum.Font.GothamMedium

-- Dicke des Cartoon-Rands
Theme.OUTLINE_THICKNESS = 3
Theme.CORNER_RADIUS     = 14

function Theme.rarityColor(rarity: Types.Rarity): Color3
	return BaerchiConfig.getRarityColor(rarity)
end

-- Akzentfarbe eines Honig-Gebaeudes.
--
-- Die Zuordnung steht an EINER Stelle, genau wie bei rarityColor: das
-- Gebaeude-Panel faerbt damit seine Karten, die Baerchi-Detailkarte ihre
-- Fuetter-Knoepfe. Zwei getrennte Listen waeren die naechste Stelle, an der
-- Farbe und Gebaeude auseinanderlaufen.
--
-- Was die Farben BEDEUTEN, steht bei den Rollen in Config/BuildingBehavior:
-- Bienenstock = Vorrat, Honigtopf = Heilung, Honig-Presse = Wachstum.
local BUILDING_COLORS: { [string]: Color3 } = {
	Beehive    = Theme.COLORS.volume,
	HoneyRefiner = Theme.COLORS.growth,
	HoneyPond  = Theme.COLORS.goldGummy,   -- Honig-Teich / -Brunnen (HONEY_POND_V2)
}

-- HBB Paket 4: Farben der fuenf Rarity-Baender (Zuordnung in
-- Config/RarityBandConfig). Kraeftig und weit auseinander, damit ein Kind
-- sie ohne Text unterscheidet.
Theme.BAND_COLORS = {
	Color3.fromRGB(176, 190, 204),   -- 1 grau
	Color3.fromRGB( 46, 155, 255),   -- 2 blau
	Color3.fromRGB(255, 176,  32),   -- 3 gold
	Color3.fromRGB(168,  85, 247),   -- 4 lila
	Color3.fromRGB(255,  70, 110),   -- 5 rot-pink
}

function Theme.bandColor(rarity: string): Color3
	return Theme.BAND_COLORS[RarityBandConfig.bandOf(rarity)] or Theme.BAND_COLORS[1]
end

function Theme.buildingColor(buildingId: string): Color3
	return BUILDING_COLORS[buildingId] or Theme.COLORS.accent
end

--------------------------------------------------------------------------------
-- Bausteine
--------------------------------------------------------------------------------

function Theme.corner(parent: Instance, radius: number?): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or Theme.CORNER_RADIUS)
	corner.Parent = parent
	return corner
end

function Theme.stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color        = color or Theme.COLORS.outline
	stroke.Thickness    = thickness or Theme.OUTLINE_THICKNESS
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent       = parent
	return stroke
end

-- Hellere bzw. dunklere Variante einer Farbe. `amount` > 0 hellt auf, < 0
-- dunkelt ab, jeweils 0..1. Damit muss keine Farbvariante von Hand gepflegt
-- werden — jede Flaeche kann sich ihre Abstufung aus der Grundfarbe holen.
function Theme.shade(color: Color3, amount: number): Color3
	if amount >= 0 then
		return color:Lerp(Color3.new(1, 1, 1), math.clamp(amount, 0, 1))
	end
	return color:Lerp(Color3.new(0, 0, 0), math.clamp(-amount, 0, 1))
end

-- Farbverlauf ueber eine Flaeche.
--
-- Der kuerzeste Weg von "Platzhalter" zu "Spiel": eine flache Farbe sieht aus
-- wie ein unfertiges Rechteck, dieselbe Farbe mit einem Verlauf sieht aus wie
-- ein Knopf. Wird fuer die Kopfbalken und die grossen Knoepfe der
-- Gebaeude-Menues benutzt.
--
-- `rotation` in Grad: 90 = von oben nach unten (Standard).
function Theme.gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	-- Ein vorhandener Verlauf wird ueberschrieben statt gestapelt: zwei
	-- UIGradients multiplizieren sich und machen den Knopf dunkel. So kann
	-- Theme.button schon einen Grundverlauf setzen, und bigButton oder eine
	-- Kachel faerbt ihn nur um.
	local gradient = parent:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, top),
		ColorSequenceKeypoint.new(1, bottom),
	})
	gradient.Rotation = rotation or 90
	gradient.Parent   = parent
	return gradient
end

function Theme.padding(parent: Instance, px: number): UIPadding
	local padding = Instance.new("UIPadding")
	padding.PaddingTop    = UDim.new(0, px)
	padding.PaddingBottom = UDim.new(0, px)
	padding.PaddingLeft   = UDim.new(0, px)
	padding.PaddingRight  = UDim.new(0, px)
	padding.Parent        = parent
	return padding
end

function Theme.listLayout(parent: Instance, padding: number, horizontal: boolean?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.FillDirection       = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	layout.SortOrder           = Enum.SortOrder.LayoutOrder
	layout.Padding             = UDim.new(0, padding)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment   = Enum.VerticalAlignment.Top
	layout.Parent              = parent
	return layout
end

-- Durchsichtiger Container ohne Rand
function Theme.container(name: string, parent: Instance): Frame
	local frame = Instance.new("Frame")
	frame.Name                   = name
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel        = 0
	frame.Parent                 = parent
	return frame
end

-- Gefuellte Flaeche mit Rundung und Cartoon-Rand
function Theme.panel(name: string, parent: Instance, color: Color3?): Frame
	local frame = Instance.new("Frame")
	frame.Name            = name
	frame.BackgroundColor3 = color or Theme.COLORS.panel
	frame.BorderSizePixel = 0
	frame.Parent          = parent

	Theme.corner(frame)
	Theme.stroke(frame)
	-- Leichter Verlauf: eine flache Flaeche wirkt wie ein Platzhalter, mit
	-- hellerer Oberkante wie ein Spielelement.
	-- (Ein UIGradient MULTIPLIZIERT sich auf die Hintergrundfarbe: weiss =
	-- unveraendert, grau = dunkler. Deshalb neutrale Farben, nicht shade().)
	Theme.gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(196, 196, 208))
	return frame
end

-- Heller Glanzstreifen auf der oberen Haelfte eines Knopfes — der kleine
-- Kniff, der aus einem Rechteck einen "Cartoon-Knopf" macht. Faengt keine
-- Klicks ab (Frame, nicht aktiv).
function Theme.shine(parent: GuiObject, radius: number?): Frame
	local shine = Instance.new("Frame")
	shine.Name                   = "Shine"
	shine.AnchorPoint            = Vector2.new(0.5, 0)
	shine.Position               = UDim2.new(0.5, 0, 0, 3)
	shine.Size                   = UDim2.new(1, -10, 0.42, 0)
	shine.BackgroundColor3       = Color3.new(1, 1, 1)
	shine.BackgroundTransparency = 0.82
	shine.BorderSizePixel        = 0
	shine.Active                 = false
	shine.Parent                 = parent
	Theme.corner(shine, radius or 8)
	return shine
end

-- Weiches Anwachsen beim Drueberfahren, Eindruecken beim Druecken. Ein
-- UIScale statt Size, damit Layouts und Tweens an der Groesse unberuehrt bleiben.
local PRESS_TWEEN = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function Theme.pressable(button: GuiButton, hover: number?)
	local grow = hover or 1.06
	local scale = Instance.new("UIScale")
	scale.Name   = "PressScale"
	scale.Parent = button

	local function to(target: number)
		TweenService:Create(scale, PRESS_TWEEN, { Scale = target }):Play()
	end

	button.MouseEnter:Connect(function()
		if button.Active then to(grow) end
	end)
	button.MouseLeave:Connect(function()
		to(1)
	end)
	button.MouseButton1Down:Connect(function()
		if button.Active then to(0.93) end
	end)
	button.MouseButton1Up:Connect(function()
		if button.Active then to(grow) end
	end)
end

function Theme.label(name: string, parent: Instance, text: string?): TextLabel
	local label = Instance.new("TextLabel")
	label.Name                   = name
	label.BackgroundTransparency = 1
	label.Font                   = Theme.FONT
	label.Text                   = text or ""
	label.TextColor3             = Theme.COLORS.text
	label.TextScaled             = true
	label.TextXAlignment         = Enum.TextXAlignment.Left
	label.Parent                 = parent

	-- Verhindert absurd grosse Schrift auf hohen Frames
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 28
	constraint.MinTextSize = 8
	constraint.Parent      = label

	return label
end

-- Kleiner, mehrzeiliger Fliesstext (Beschreibungen, Effekt-Texte).
-- Bewusst mit fester TextSize statt TextScaled: umgebrochener Text
-- wird sonst je nach Zeilenzahl unterschiedlich gross.
function Theme.bodyText(name: string, parent: Instance, text: string?): TextLabel
	local label = Instance.new("TextLabel")
	label.Name                   = name
	label.BackgroundTransparency = 1
	label.Font                   = Theme.FONT_BODY
	label.Text                   = text or ""
	label.TextColor3             = Theme.COLORS.textDim
	label.TextScaled             = false
	label.TextSize               = 14
	label.TextWrapped            = true
	label.TextXAlignment         = Enum.TextXAlignment.Left
	label.TextYAlignment         = Enum.TextYAlignment.Top
	label.Parent                 = parent
	return label
end

function Theme.button(name: string, parent: Instance, text: string, color: Color3?): TextButton
	local button = Instance.new("TextButton")
	button.Name             = name
	button.BackgroundColor3  = color or Theme.COLORS.accent
	button.BorderSizePixel   = 0
	button.Font              = Theme.FONT
	button.Text              = text
	button.TextColor3        = Theme.COLORS.outline
	button.TextScaled        = true
	button.AutoButtonColor   = true
	button.Parent            = parent

	Theme.corner(button, 12)
	Theme.stroke(button)

	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 24
	constraint.MinTextSize = 8
	constraint.Parent      = button

	-- Cartoon-Look: Verlauf + Glanzstreifen + Hover/Druck-Animation.
	-- AutoButtonColor aus: der Standard-Abdunkler faerbt sonst den ganzen
	-- Verlauf grau; die Animation uebernimmt das Feedback.
	-- Neutraler Verlauf (multipliziert sich auf die Knopffarbe, siehe panel).
	Theme.gradient(button, Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 190, 200))
	Theme.shine(button, 9)
	button.AutoButtonColor = false
	Theme.pressable(button)

	return button
end

-- Button ausgrauen bzw. wieder freigeben.
--
-- Das ist reiner Komfort: der Server prueft jede Anfrage selbst und schickt
-- bei Ablehnung ein ActionFailed (→ Toast). Ein ausgegrauter Button ist nur
-- die freundliche Vorwarnung, nie die Absicherung.
--
-- Die urspruengliche Farbe wird beim ersten Ausgrauen als Attribut gemerkt,
-- damit der Aufrufer sie nicht selbst mitschleppen muss.
-- Grosser, bunter Aktionsknopf mit Verlauf — der Knopf, um den herum ein
-- Menue gebaut wird ("AUSBAUEN", "FUETTERN"). Bewusst deutlich hoeher und
-- kraeftiger als Theme.button: in einem Menue soll auf einen Blick klar sein,
-- was der Hauptzweck ist.
function Theme.bigButton(name: string, parent: Instance, text: string, color: Color3): TextButton
	local button = Theme.button(name, parent, text, color)
	Theme.gradient(button, Theme.shade(color, 0.28), Theme.shade(color, -0.12))
	return button
end

-- Dunkler Umriss um die Schrift — der Look, den Roblox-Spiele fuer Beschriftungen
-- ueber bunten Flaechen benutzen. Ohne ihn verschwindet weisser Text auf gelben
-- Kacheln, und mit ihm wirkt jede Beschriftung wie aufgeklebt statt wie
-- hineingerechnet.
function Theme.outlineText(label: TextLabel, thickness: number?): TextLabel
	label.TextStrokeColor3       = Theme.COLORS.outline
	label.TextStrokeTransparency = 0
	label.RichText               = false

	local stroke = Instance.new("UIStroke")
	stroke.Color         = Theme.COLORS.outline
	stroke.Thickness     = thickness or 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent        = label

	return label
end

-- Kleine Grossbuchstaben-Ueberschrift ueber einem Abschnitt einer Karte.
function Theme.sectionLabel(name: string, parent: Instance, text: string, color: Color3?): TextLabel
	local label = Theme.label(name, parent, string.upper(text))
	label.TextColor3 = color or Theme.COLORS.textDim
	label.TextScaled = false
	label.TextSize   = 13
	label.Font       = Theme.FONT
	return label
end

function Theme.setEnabled(button: TextButton, enabled: boolean)
	local stored = button:GetAttribute("EnabledColor")
	if typeof(stored) ~= "Color3" then
		stored = button.BackgroundColor3
		button:SetAttribute("EnabledColor", stored)
	end

	button.Active          = enabled
	local shine = button:FindFirstChild("Shine")
	if shine and shine:IsA("GuiObject") then
		shine.Visible = enabled
	end
	button.BackgroundColor3 = if enabled then (stored :: Color3) else Theme.COLORS.disabled
	button.TextTransparency = if enabled then 0 else 0.4

	-- Ein Verlauf (Theme.bigButton) multipliziert sich auf die Hintergrundfarbe
	-- und wuerde den ausgegrauten Knopf weiter bunt aussehen lassen. Deshalb
	-- geht er beim Ausgrauen mit aus.
	local gradient = button:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Enabled = enabled
	end
end

-- Scrollbare Liste. Der Aufrufer haengt ein Theme.listLayout hinein und
-- setzt seine Zeilen auf UDim2.new(1, -8, 0, hoehe) — die -8 lassen Platz
-- fuer den Scrollbalken, sonst ragt jede Zeile darunter.
function Theme.scroller(name: string, parent: Instance): ScrollingFrame
	local scroller = Instance.new("ScrollingFrame")
	scroller.Name                   = name
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel        = 0
	scroller.ScrollBarThickness     = 6
	scroller.ScrollBarImageColor3   = Theme.COLORS.panelLight
	scroller.CanvasSize             = UDim2.new()
	scroller.AutomaticCanvasSize    = Enum.AutomaticSize.Y
	scroller.ScrollingDirection     = Enum.ScrollingDirection.Y
	scroller.Parent                 = parent
	return scroller
end

export type Progress = {
	track : Frame,
	fill  : Frame,
	text  : TextLabel,
}

-- Fortschrittsbalken mit Text darueber (Brut-Timer, XP, Kampf-HP).
function Theme.progress(parent: Instance, fillColor: Color3?): Progress
	local track = Theme.panel("Track", parent, Theme.COLORS.panelDeep)
	track.ClipsDescendants = true   -- damit der Fuellbalken die Rundung nicht ueberragt

	local fill = Instance.new("Frame")
	fill.Name             = "Fill"
	fill.Size             = UDim2.fromScale(0, 1)
	fill.BackgroundColor3  = fillColor or Theme.COLORS.accent
	fill.BorderSizePixel   = 0
	fill.Parent            = track
	Theme.corner(fill, 12)
	Theme.gradient(fill, Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 170, 185))
	Theme.shine(fill, 6).Size = UDim2.new(1, -8, 0.4, 0)

	local text = Theme.label("Text", track, "")
	text.Size           = UDim2.fromScale(1, 1)
	text.TextXAlignment = Enum.TextXAlignment.Center
	text.ZIndex         = 3
	Theme.outlineText(text, 2)

	return { track = track, fill = fill, text = text }
end

--------------------------------------------------------------------------------
-- Dialoge
--------------------------------------------------------------------------------

-- Zentriertes Panel, standardmaessig unsichtbar. Groesse in Scale, damit es
-- auf Handy und Monitor passt; die Constraints halten es lesbar.
function Theme.dialog(name: string, parent: Instance, scale: Vector2, minSize: Vector2, maxSize: Vector2): Frame
	local root = Theme.panel(name, parent, Theme.COLORS.panelDeep)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position    = UDim2.fromScale(0.5, 0.5)
	root.Size        = UDim2.fromScale(scale.X, scale.Y)
	root.Visible     = false
	root.ZIndex      = 10

	local constraint = Instance.new("UISizeConstraint")
	constraint.MinSize = minSize
	constraint.MaxSize = maxSize
	constraint.Parent  = root

	return root
end

-- Kopfzeile eines Dialogs: Titel links, Schliessen-Kreuz rechts.
-- Gibt das Titel-Label zurueck, damit der Aufrufer es spaeter aendern kann.
function Theme.dialogHeader(root: Frame, title: string, onClose: () -> ()): TextLabel
	-- Farbiger Titelbalken hinter der Kopfzeile (zuerst gebaut, liegt darum
	-- unter Titel und Kreuz).
	local band = Instance.new("Frame")
	band.Name             = "TitleBand"
	band.Position         = UDim2.new(0, 6, 0, 5)
	band.Size             = UDim2.new(1, -12, 0, 42)
	band.BackgroundColor3 = Color3.fromRGB(122, 104, 204)
	band.BorderSizePixel  = 0
	band.Parent           = root
	Theme.corner(band, 12)
	Theme.stroke(band, Theme.COLORS.outline, 2)
	Theme.gradient(band, Color3.fromRGB(255, 255, 255), Color3.fromRGB(176, 170, 215))
	Theme.shine(band, 8).Size = UDim2.new(1, -12, 0.36, 0)

	local header = Theme.container("Header", root)
	header.Position = UDim2.new(0, 14, 0, 11)
	header.Size     = UDim2.new(1, -28, 0, 30)

	local label = Theme.label("Title", header, title)
	label.Size = UDim2.new(1, -44, 1, 0)
	Theme.outlineText(label, 2)

	local close = Theme.button("Close", header, "X", Theme.COLORS.bad)
	close.AnchorPoint = Vector2.new(1, 0.5)
	close.Position    = UDim2.new(1, 0, 0.5, 0)
	close.Size        = UDim2.new(0, 34, 0, 30)
	close.TextColor3  = Theme.COLORS.text
	close.Activated:Connect(onClose)

	return label
end

-- Inhaltsflaeche unter der Kopfzeile.
function Theme.dialogBody(root: Frame): Frame
	local body = Theme.container("Body", root)
	body.Position = UDim2.new(0, 14, 0, 48)
	body.Size     = UDim2.new(1, -28, 1, -62)
	return body
end

--------------------------------------------------------------------------------
-- Formatierung
--------------------------------------------------------------------------------

-- Grosse Zahlen lesbar machen: 1234567 → "1.234.567" (de/es), "1,234,567" (en),
-- "1 234 567" (fr). Das Trennzeichen kommt aus der Sprache des Spielers — die
-- Logik steht in Loc, damit Server-Texte und UI dieselbe Formatierung teilen.
-- Bleibt als Theme-Funktion bestehen, damit kein UI-Modul umgeschrieben werden
-- muss, das schon formatNumber benutzt.
function Theme.formatNumber(value: number): string
	return Loc.formatNumber(value)
end

-- Restzeiten: "45s", "2m 05s", "1h 12m" (Einheiten je nach Sprache)
function Theme.formatDuration(seconds: number): string
	return Loc.formatDuration(seconds)
end

return Theme
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX112"><Properties>
<string name="Name">UiScale</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- UiScale.luau
-- StarterPlayerScripts/UI/UiScale.luau
--
-- Einzige Zustaendigkeit:
--   - Die ganze Oberflaeche (eine ScreenGui "RBL") mit der Bildschirmhoehe
--     mitwachsen lassen, und Bildschirm-Pixel in Oberflaechen-Einheiten
--     umrechnen.
--
-- Warum: Alle Panels sind in festen Pixeln gebaut. Auf einem grossen Monitor
-- (1440p/4K) wirkte die UI dadurch winzig (Playtest 05.10.), in Studio mit
-- kleinem Fenster nicht. Ein UIScale direkt an der ScreenGui vergroessert
-- alles gleichmaessig. Nur NACH OBEN (>= 1): kleine Bildschirme regeln
-- MenuBar und PetBar schon selbst.
--
-- WICHTIG fuer jede Stelle, die AbsolutePosition/AbsoluteSize oder
-- Kamera-Pixel in eine Position (UDim2.fromOffset) zurueckschreibt: diese
-- Werte sind echte Bildschirm-Pixel und muessen durch UiScale.toGui, sonst
-- landet das Element um den Faktor daneben. Betrifft heute GuideController,
-- Feedback, IndexView, MenuBar, PetBar.

local UiScale = {}

-- Bei dieser Bildschirmhoehe (Pixel, ohne Topbar) ist die UI 1:1 gebaut.
local REFERENCE_HEIGHT = 820
local MAX_SCALE = 1.6

local _scale = 1
local _uiScale: UIScale? = nil

function UiScale.get(): number
	return _scale
end

-- Bildschirm-Pixel -> Oberflaechen-Einheiten (Vector2 oder Zahl)
function UiScale.toGui<T>(value: T): T
	return ((value :: any) / _scale) :: any
end

function UiScale.init(screenGui: ScreenGui)
	local scale = Instance.new("UIScale")
	scale.Name = "GlobalScale"
	scale.Parent = screenGui
	_uiScale = scale

	local function update()
		local height = screenGui.AbsoluteSize.Y
		_scale = math.clamp(height / REFERENCE_HEIGHT, 1, MAX_SCALE)
		scale.Scale = _scale
	end
	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	update()
end

return UiScale
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
</roblox>