	["baerchi.PhantomBaerchi.name"] = "Baerchi Fantôme",
	["baerchi.SeraphBaerchi.name"] = "Baerchi Séraphin",
	["baerchi.NorthernLightBaerchi.name"] = "Baerchi Aurore Boréale",
