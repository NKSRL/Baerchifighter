--------------------------------------------------------------------------------
-- Progression (Level-Cap, Stat-Wachstum, XP-Kurve)
--------------------------------------------------------------------------------

local MAX_LEVEL = 50

-- Stat-Wachstum pro Level — die Zahlen dahinter wendet CombatCalculator an.
--
-- HP und ATK wachsen EXPONENTIELL: jedes Level gibt +10% auf den Wert des
-- vorherigen Levels, also stat = basis * 1.1^(level-1). Das ist auf Level 10
-- das 2,4-fache, auf Level 20 das 6,1-fache und auf Level 50 (Cap) das
-- 106-fache des Grundwerts. Die PIT-Gegner skalieren mit derselben Kurve
-- mit, sonst waere ab Level 15 jede Stage trivial.
--
-- SPD und PWR wachsen bewusst NICHT mit 10%, sondern klein und linear.
--
-- Beide sind Werte, bei denen ein Prozentwachstum entgleist: SPD ist die
-- Angriffsgeschwindigkeit (die rundenbasierte Simulation wertet sie aktuell
-- noch gar nicht aus), und PWR multipliziert den Skill-Schaden, der seinerseits
-- schon am exponentiell wachsenden ATK haengt — 10% pro Level darauf waere
-- exponentielles Wachstum auf exponentiellem Wachstum.
--
-- Auf Level 50 macht das +0.98 SPD und +0.147 PWR. Der Loewenanteil beider
-- Werte kommt also weiterhin vom Baerchi selbst und von seinen Stat-Stufen
-- (PromotionConfig), nicht vom Level.
local STAT_GROWTH_PER_LEVEL = 0.10
local SPD_PER_LEVEL         = 0.02
local PWR_PER_LEVEL         = 0.003

-- XP-Kurve: benoetigte XP um von `level` auf `level + 1` zu kommen.
--
-- Bewusst flach am Anfang: bis Level 6-7 soll ein Baerchi sehr schnell
-- kommen (zusammen ca. 730 XP), damit man frueh mehrere PIT-Stages am Stueck
-- schafft. Danach zieht die Kurve exponentiell an und wird zum Idle-Ziel.
-- XP gibt es NICHT mehr aus Kaempfen, sondern nur noch ueber Honig
-- (siehe HoneyService) — die Kurve haengt also direkt an der
-- Honig-Produktion der Gebaeude.
local XP_CURVE_BASE   = 60
local XP_CURVE_FACTOR = 1.28

local function xpForNextLevel(level: number): number
	return math.floor(XP_CURVE_BASE * math.pow(XP_CURVE_FACTOR, math.max(level, 1) - 1))
end

-- Paket 9 (FeatureFlags.ENDLESS): Endless-Level ueber Level 50 hinaus.
-- Zaehlt nur auf MAX_LEVEL, bleibt ueber Rebirths (RebirthService setzt nur
-- level/xp zurueck) und kommt aus Honig-XP (sobald Final 100 geschafft ist)
-- und aus jeder 10. Endless-Stage. +1 Endless-Level wirkt wie +1 Level
-- (CombatCalculator) und ist im Tower-Modell etwa +2 Endless-Stages wert.
-- Faktor per tools/sim/progression_pacing.lua abgestimmt.
local ENDLESS_XP_BASE   = 340     -- x xpForNextLevel(MAX_LEVEL)
local ENDLESS_XP_FACTOR = 1.02

local function xpForEndlessLevel(endlessLevel: number): number
	return math.floor(xpForNextLevel(MAX_LEVEL) * ENDLESS_XP_BASE * math.pow(ENDLESS_XP_FACTOR, math.max(endlessLevel, 0)))
end

--------------------------------------------------------------------------------
-- Rarity-Kette (Grundlage der Fusions-Regel)
--------------------------------------------------------------------------------

local RARITY_ORDER: { Types.Rarity } = {
	"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic",
	"Divine", "Cosmic", "Secret", "Godly", "Eternal", "Omega",
}

-- Eine Farbe pro Rarity — benutzt von BEIDEN Seiten:
-- Server faerbt damit die Baerchi-Parts auf der Insel,
-- Client faerbt damit Rahmen, Badges und Karten im UI.
-- Deshalb hier und nicht im Client-Theme: sonst laufen die Farben auseinander.
local RARITY_COLORS: { [Types.Rarity]: Color3 } = {
	Common    = Color3.fromRGB(176, 190, 204),   -- Grau-Blau
	Uncommon  = Color3.fromRGB( 76, 217, 100),   -- Gruen
	Rare      = Color3.fromRGB( 46, 155, 255),   -- Blau
	Epic      = Color3.fromRGB(168,  85, 247),   -- Lila
	Legendary = Color3.fromRGB(255, 176,  32),   -- Gold
	Mythic    = Color3.fromRGB(255,  59, 107),   -- Pink-Rot
	Divine    = Color3.fromRGB(255, 244, 190),   -- Himmlisches Hellgold
	Cosmic    = Color3.fromRGB( 92,  72, 255),   -- Tiefes Indigo
	Secret    = Color3.fromRGB( 30,  34,  48),   -- Fast-Schwarz
	Godly     = Color3.fromRGB( 40, 235, 220),   -- Tuerkis-Leuchten
	Eternal   = Color3.fromRGB(255, 120,  40),   -- Gluehendes Orange
	Omega     = Color3.fromRGB(255, 255, 255),   -- Weiss
}

local function getRarityColor(rarity: Types.Rarity): Color3
	return RARITY_COLORS[rarity] or RARITY_COLORS.Common
end

--------------------------------------------------------------------------------
-- Mutation (ersetzt seit v11 das binaere Inverted-System)
--------------------------------------------------------------------------------

-- Ein MUTIERTER Baerchi ist derselbe Baerchi, nur durchweg besser — genau wie
-- vorher Inverted. Neu ist die STUFUNG: acht Stufen statt einem einzigen
-- Bonus, jede mit eigenem Multiplikator, eigener Farbe und eigener Seltenheit
-- (Vorbild: das Mutations-System aus "Steal a Brainrot"). Wie bei Inverted
-- ist es KEINE eigene Rarity und KEINE eigene Art: jeder configId kann jede
-- Stufe tragen, die Rarity bleibt dabei unveraendert.
--
-- ANNAHME, nicht vom Projektinhaber vorgegeben (Zahlen/Farben/Namen sind mein
-- Entwurf aus DESIGN_VORSCHLAG_TRENDANALYSE_2026-09-11.md, Abschnitt 3):
--
--   * `multiplier` ist der Anteil, um den HP/ATK/EGG steigen (multiplier - 1
--     als Bonus, siehe getMutationBonus) — SPD/PWR bekommen davon nur ein
--     Drittel, aus demselben Grund wie frueher bei INVERTED_BONUS (sie
--     multiplizieren sich bereits mit anderen Werten).
--   * `weight` ist ein Gewicht in einem Wurf ueber ALLE Stufen PLUS einem
--     riesigen "keine Mutation"-Gewicht (siehe rollMutation) — kein Wurf pro
--     Stufe einzeln. Die Summe aus allen Gewichten (inkl. "keine Mutation")
--     ist absichtlich eine runde Million, damit die Prozentzahlen unten
--     nachrechenbar bleiben.
--   * Celestial und Candy teilen sich denselben Multiplikator (4x), genau wie
--     Lava und Galaxy (6x) — das ist Absicht: zwei kosmetisch verschiedene
--     "Geschmacksrichtungen" derselben Machtstufe, kein Tippfehler.
--   * Rainbow bekommt eine einzelne repraesentative Farbe statt eines
--     echten Farbwechsels — ein zyklisches ColorSequence/Tween-Rainbow waere
--     ein separater Studio-Effekt und ist hier bewusst NICHT mit umgesetzt.
--
-- Wer andere Zahlen will: alles Balancing steckt ausschliesslich in dieser
-- Tabelle, nirgendwo sonst im Code.
export type MutationDef = {
	id          : Types.MutationId,
	displayName : string,
	badge       : string,    -- kurzes Kuerzel fuers Namensschild, z.B. "[GOLD]"
	multiplier  : number,    -- 1.25 = +25% auf HP/ATK/EGG (siehe getMutationBonus)
	color       : Color3,
	weight      : number,    -- Gewicht im Gesamtwurf (siehe rollMutation)
}

-- Reihenfolge = Seltenheits-/Staerke-Kette, genau wie RARITY_ORDER bei Rarity.
-- FusionService.pickHigherMutation vergleicht Baerchis ueber den Index hier.
local MUTATION_ORDER: { Types.MutationId } = {
	"Gold", "Diamond", "Bloodrot", "Celestial", "Candy", "Lava", "Galaxy", "Rainbow",
}

local MUTATIONS: { [Types.MutationId]: MutationDef } = {
	Gold = {
		id = "Gold", displayName = "Gold", badge = "[GOLD]",
		multiplier = 1.25, color = Color3.fromRGB(255, 215, 0), weight = 10000,
	},
	Diamond = {
		id = "Diamond", displayName = "Diamond", badge = "[DIA]",
		multiplier = 1.50, color = Color3.fromRGB(120, 224, 255), weight = 3000,
	},
	Bloodrot = {
		id = "Bloodrot", displayName = "Bloodrot", badge = "[BLOOD]",
		multiplier = 2.00, color = Color3.fromRGB(139, 0, 0), weight = 1200,
	},
	Celestial = {
		id = "Celestial", displayName = "Celestial", badge = "[CEL]",
		multiplier = 4.00, color = Color3.fromRGB(147, 112, 219), weight = 400,
	},
	Candy = {
		id = "Candy", displayName = "Candy", badge = "[CANDY]",
		multiplier = 4.00, color = Color3.fromRGB(255, 105, 180), weight = 300,
	},
	Lava = {
		id = "Lava", displayName = "Lava", badge = "[LAVA]",
		multiplier = 6.00, color = Color3.fromRGB(255, 69, 0), weight = 70,
	},
	Galaxy = {
		id = "Galaxy", displayName = "Galaxy", badge = "[GAL]",
		multiplier = 6.00, color = Color3.fromRGB(106, 27, 154), weight = 25,
	},
	Rainbow = {
		id = "Rainbow", displayName = "Rainbow", badge = "[RBW]",
		multiplier = 10.00, color = Color3.fromRGB(255, 0, 170), weight = 5,
	},
}

-- Gewicht des "gar keine Mutation"-Falls im Gesamtwurf (siehe rollMutation).
-- Zusammen mit den Gewichten oben ergibt das genau 1_000_000 — macht die
-- Gesamtchance auf IRGENDEINE Mutation genau 15_000 / 1_000_000 = 1.5%.
local NO_MUTATION_WEIGHT = 985000

-- Wuerfelt EINMAL ueber alle acht Stufen plus "keine Mutation" und gibt die
-- getroffene Stufe zurueck (nil = keine). Bewusst EIN Wurf und nicht "erst
-- pruefen OB, dann WELCHE": das mischt Gesamtchance und Stufen-Verteilung in
-- einer einzigen, leicht nachrechenbaren Tabelle, genau wie EggConfig.rollEggType
-- es fuer Ei-Typen macht.
--
-- Bewusst hier und nicht in EggService: die Chancen sind ein Konfig-Wert,
-- EggService ruft nur auf (dieselbe Aufteilung wie vorher bei rollInverted).
local function rollMutation(): Types.MutationId?
	local total = NO_MUTATION_WEIGHT
	for _, id in MUTATION_ORDER do
		total += MUTATIONS[id].weight
	end

	local roll = math.random() * total
	local cumulative = NO_MUTATION_WEIGHT

	if roll < cumulative then
		return nil
	end

	for _, id in MUTATION_ORDER do
		cumulative += MUTATIONS[id].weight
		if roll < cumulative then
			return id
		end
	end

	return nil   -- sollte durch Rundungsfehler praktisch nie erreicht werden
end

-- Wuerfelt eine Mutation OHNE die Moeglichkeit "keine": das Ergebnis ist
-- garantiert eine der acht Stufen, verteilt nach denselben Gewichten wie in
-- rollMutation (Gold am haeufigsten, Rainbow am seltensten).
--
-- Gebraucht vom Mutations-Sturm-Event (siehe EventConfig und
-- EventParticipationService): dort ist die Frage OB schon durch die
-- Event-Chance beantwortet, hier geht es nur noch um WELCHE Stufe. Mit
-- rollMutation waere das Ergebnis auch dann in 98.5% der Faelle nil und das
-- ganze Event praktisch wirkungslos.
local function rollMutationTier(): Types.MutationId
	local total = 0
	for _, id in MUTATION_ORDER do
		total += MUTATIONS[id].weight
	end

	local roll = math.random() * total
	local cumulative = 0

	for _, id in MUTATION_ORDER do
		cumulative += MUTATIONS[id].weight
		if roll < cumulative then
			return id
		end
	end

	-- Nur durch Rundungsfehler erreichbar: die haeufigste Stufe.
	return MUTATION_ORDER[1]
end

-- Die Fellfarbe/Leuchtfarbe einer Mutations-Stufe. Server (Figur auf der
-- Insel) und Client (Rahmen und Badges im UI) benutzen dieselbe Funktion —
-- genau wie bei getRarityColor, aus demselben Grund: zwei getrennte
-- Berechnungen laufen beim naechsten Farbwechsel auseinander.
--
-- nil (keine Mutation) gibt es hier bewusst nicht: der Aufrufer weiss selbst,
-- ob er ueberhaupt eine Farbe braucht (siehe `if baerchi.mutation then ...`
-- an jeder Aufrufstelle) — eine Fallback-Farbe hier waere eine zweite,
-- unnoetige Fallunterscheidung.
local function getMutationColor(mutation: Types.MutationId): Color3
	return MUTATIONS[mutation].color
end

local function getMutationDisplayName(mutation: Types.MutationId): string
	return MUTATIONS[mutation].displayName
end

local function getMutationBadge(mutation: Types.MutationId): string
	return MUTATIONS[mutation].badge
end

-- Der reine Multiplikator ("x1.25", "x10") fuer die Anzeige. 1.0 fuer nil
-- (keine Mutation) — dadurch kann ein Aufrufer immer damit multiplizieren,
-- ohne vorher auf nil zu pruefen.
local function getMutationMultiplier(mutation: Types.MutationId?): number
	if not mutation then
		return 1.0
	end
	return MUTATIONS[mutation].multiplier
end

-- Was eine Mutation an den vier Basiswerten PLUS Ei-Tempo aendert, als Anteil
-- (0.25 = +25%) — direkt einsetzbar wie zuvor INVERTED_BONUS.
--
-- HP/ATK/EGG bekommen den vollen Multiplikator-Anteil, SPD/PWR nur ein
-- Drittel davon — siehe Kommentar-Kopf, derselbe Grund wie beim alten
-- INVERTED_BONUS (hp/atk/egg = 15%, spd/pwr = 5%, exakt Faktor 3).
--
-- nil (keine Mutation) gibt einen Nullbonus zurueck — Aufrufer koennen das
-- Ergebnis deshalb IMMER anwenden, ohne vorher auf nil zu pruefen (siehe
-- CombatCalculator.getEffectiveStats).
local function getMutationBonus(mutation: Types.MutationId?): { hp: number, atk: number, spd: number, pwr: number, egg: number }
	local extra = getMutationMultiplier(mutation) - 1.0
	return {
		hp  = extra,
		atk = extra,
		spd = extra / 3,
		pwr = extra / 3,
		egg = extra,
	}
end

-- Index in MUTATION_ORDER (1 = Gold, ... 8 = Rainbow). 0 fuer nil (keine
-- Mutation) — dadurch ist "keine Mutation" garantiert die niedrigste Stufe
-- in jedem Vergleich, ohne dass der Aufrufer nil gesondert behandeln muss.
local function getMutationRank(mutation: Types.MutationId?): number
	if not mutation then
		return 0
	end
	for index, id in MUTATION_ORDER do
		if id == mutation then
			return index
		end
	end
	return 0
end

-- Die hoehere der beiden Mutationen (fuer FusionService, "das Bessere
-- gewinnt" — dieselbe Linie wie Regel A/B, nur jetzt gestuft statt binaer).
-- Bei Gleichstand (z.B. beide nil, oder beide dieselbe Stufe) gewinnt `a`.
local function pickHigherMutation(a: Types.MutationId?, b: Types.MutationId?): Types.MutationId?
	if getMutationRank(b) > getMutationRank(a) then
		return b
	end
	return a
end

-- v14: Fusion erhoeht die Rarity NICHT mehr (Wunsch des Projektinhabers:
-- "Fusionen sollen nur die Stats mergen"). Die fruehere Konstante
-- FUSION_MYTHIC_RESULT ist entfallen — Mythics fallen jetzt aus Eiern.

-- v14: die Pfade, in Anzeige-Reihenfolge, mit Farbe und Ziel. Server und
-- Client nutzen dieselbe Tabelle (Ei-Baum-Panel, Index, Panel-Badges).
local PATHS: { { id: Types.PathId, color: Color3, goal: string } } = {
	{ id = "Stamm",     color = Color3.fromRGB(238, 214, 170), goal = "start" },
	{ id = "Gold",      color = Color3.fromRGB(255, 196,  60), goal = "strong" },
	{ id = "Kristall",  color = Color3.fromRGB(120, 220, 255), goal = "fast" },
	{ id = "Void",      color = Color3.fromRGB(150,  90, 230), goal = "rare" },
	{ id = "Kosmos",    color = Color3.fromRGB( 92,  72, 255), goal = "all" },
	{ id = "Ascension", color = Color3.fromRGB(196, 128, 255), goal = "rebirth" },
	-- v17: Sonder-Eier aus Events (kein Baerchi hat diesen Pfad)
	{ id = "Event",     color = Color3.fromRGB(255, 214,  60), goal = "event" },
}

local function getPathColor(path: string?): Color3
	for _, p in PATHS do
		if p.id == path then return p.color end
	end
	return PATHS[1].color
end

local function getRarityIndex(rarity: Types.Rarity): number
	for i, r in RARITY_ORDER do
		if r == rarity then
			return i
		end
	end
	return 1
end

-- Naechsthoehere Rarity — nil wenn schon am Ende der Kette (Mythic)
local function getNextRarity(rarity: Types.Rarity): Types.Rarity?
	local idx = getRarityIndex(rarity)
	return RARITY_ORDER[idx + 1]
end

--------------------------------------------------------------------------------
-- Hilfsfunktionen fuer Services
--------------------------------------------------------------------------------

local function getById(id: string): BaerchiDef?
	return BAERCHIS[id]
end

local function getByRarity(rarity: Types.Rarity): { BaerchiDef }
	local result: { BaerchiDef } = {}
	for _, def in BAERCHIS do
		if def.rarity == rarity then
			table.insert(result, def)
		end
	end
	-- Deterministische Reihenfolge: die Iteration ueber eine Hash-Tabelle
	-- ist in Luau nicht garantiert stabil, ein Gacha-Roll darf davon nicht abhaengen.
	table.sort(result, function(a, b)
		return a.id < b.id
	end)
	return result
end

local function getByEggSource(eggType: Types.EggType): { BaerchiDef }
	local result: { BaerchiDef } = {}
	for _, def in BAERCHIS do
		for _, source in def.eggSource do
			if source == eggType then
				table.insert(result, def)
				break
			end
		end
	end
	table.sort(result, function(a, b)
		return a.id < b.id
	end)
	return result
end

return {
	data         = BAERCHIS,
	MAX_LEVEL    = MAX_LEVEL,

	STAT_GROWTH_PER_LEVEL = STAT_GROWTH_PER_LEVEL,
	SPD_PER_LEVEL         = SPD_PER_LEVEL,
	PWR_PER_LEVEL         = PWR_PER_LEVEL,

	MUTATIONS      = MUTATIONS,
	MUTATION_ORDER = MUTATION_ORDER,

	rollMutation            = rollMutation,
	rollMutationTier        = rollMutationTier,
	getMutationColor        = getMutationColor,
	getMutationDisplayName  = getMutationDisplayName,
	getMutationBadge        = getMutationBadge,
	getMutationMultiplier   = getMutationMultiplier,
	getMutationBonus        = getMutationBonus,
	getMutationRank         = getMutationRank,
	pickHigherMutation      = pickHigherMutation,

	RARITY_ORDER  = RARITY_ORDER,
	RARITY_COLORS = RARITY_COLORS,
	PATHS         = PATHS,
	getPathColor  = getPathColor,

	getRarityColor = getRarityColor,
	xpForNextLevel = xpForNextLevel,
	ENDLESS_XP_BASE   = ENDLESS_XP_BASE,
	ENDLESS_XP_FACTOR = ENDLESS_XP_FACTOR,
	xpForEndlessLevel = xpForEndlessLevel,
	getRarityIndex = getRarityIndex,
	getNextRarity  = getNextRarity,
	getById        = getById,
	getByRarity    = getByRarity,
	getByEggSource = getByEggSource,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX6"><Properties>
<string name="Name">BuildingBehavior</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- BuildingBehavior.luau
-- ReplicatedStorage/Config/BuildingBehavior.luau
--
-- Einzige Zustaendigkeit:
--   - Alles, was pro Types.BuildingId unterschiedlich ist: was ein Gebaeude
--     kann, was sein Ausbau kostet, wie sein Effekt heisst, welche Look-Stufe
--     es hat und welche Meilenstein-Faehigkeiten es freischaltet.
--
-- ============================================================
-- ZWEI HONIG-GEBAEUDE (v15, Option B)
-- ============================================================
-- Bis v14 gab es drei: Bienenstock (Vorrat), Honigtopf (Heilung), Honig-Presse
-- (XP). Die Entscheidung "Heil-Honig oder XP-Honig?" war schwach, und jedes
-- Gebaeude braucht in Prompt 4 sechs Looks. Seit v15:
--
--   Beehive       VORRAT    Lager waechst, und es produziert schneller.
--
--   HoneyRefiner  VEREDELN  Sein Level hebt die XP JEDES Honigs (die alte
--                           Kurve der Presse) und die Heilung SEINES Honigs
--                           (die alte Achse des Topfs, 25 % -> 60 % auf Level 10,
--                           -> 100 % auf Level 60). Name "Honig-Veredler" ist
--                           ein Platzhalter (steht nur in Strings/MapConfig).
--
-- Damit niemand Honig verliert, produziert der Veredler im Tempo von Topf und
-- Presse zusammen (halbes Intervall, doppeltes Lager). Die Gesamtmenge Honig
-- pro Minute ist dieselbe wie bis v14.
--
-- Das dritte Gebaeude, der Waben-Recycler, hat seine Zahlen in CombConfig; nur
-- seine Meilenstein-Faehigkeiten stehen hier (MILESTONES.Recycler), damit alle
-- Faehigkeiten an einer Stelle sind.
--
-- ============================================================
-- WARUM ALLES HIER STEHT
-- ============================================================
-- Kein Service und kein Panel verzweigt nach einer BuildingId. Ein Gebaeude
-- aendern heisst: EINEN Eintrag in BEHAVIORS anfassen. Die Abhaengigkeit geht
-- nur in EINE Richtung: BuildingBehavior kennt EconomyConfig (Basiswerte,
-- Kostenkurve, XP-Kurve, Look-Stufen), EconomyConfig kennt BuildingBehavior
-- nicht.

local EconomyConfig = require(script.Parent.EconomyConfig)
local Types         = require(script.Parent.Parent.Network.Types)

--------------------------------------------------------------------------------
-- Abweichungen der einzelnen Gebaeude
--------------------------------------------------------------------------------

-- Bienenstock — Vorrat. Bis Level 10 wie bisher (Lager 5 -> 14, je Ausbau ein
-- Platz; Intervall 20 s -> 8 s). Danach langsamer weiter: +1 Lager je
-- BEEHIVE_CAPACITY_STEP Level und Intervall bis BEEHIVE_MIN_INTERVAL_L60.
local BEEHIVE_CAPACITY_L10        = 14
local BEEHIVE_CAPACITY_STEP       = 2      -- ab Level 11: alle 2 Level +1 Platz (L60 = 39)
local BEEHIVE_INTERVAL_L10        = 8
local BEEHIVE_MIN_INTERVAL_L60    = 4

-- Honig-Veredler — Tempo/Lager wie Topf + Presse zusammen.
local REFINER_INTERVAL_FACTOR = 0.5    -- halbes Basis-Intervall (= zwei Gebaeude)
local REFINER_CAPACITY        = 10     -- doppeltes Basis-Lager
-- Heilung SEINES Honigs: Basis (Level 1) -> 60 % (Level 10) -> 100 % (Level 60)
local REFINER_HEAL_L10 = 0.60
local REFINER_HEAL_L60 = 1.00

--------------------------------------------------------------------------------
-- Meilenstein-Faehigkeiten (README 4.3) — Daten + Effekt-Hook
--------------------------------------------------------------------------------
-- Pro Gebaeude: ab welchem Level welche Faehigkeit gilt. `implemented = false`
-- heisst: nur als Daten da, der Effekt kommt spaeter (Liste im Bericht). Ein
-- Service fragt mit BuildingBehavior.hasAbility(...) — er muss nie selbst
-- wissen, auf welchem Level etwas freigeschaltet wird.
export type Ability = {
	id          : string,
	level       : number,
	implemented : boolean,
}

local MILESTONES: { [string]: { Ability } } = {
	Beehive = {
		-- Volles Lager wird automatisch an den ausgeruesteten Baerchi verfuettert
		-- (XP + Heilung), die Produktion steht also nie still (HoneyService).
		{ id = "AutoHarvest",   level = 10, implemented = true },
		{ id = "GoldenDrops",   level = 30, implemented = false },
	},
	HoneyRefiner = {
		{ id = "RefinerBoost",  level = 10, implemented = false },
		{ id = "RoyalJelly",    level = 30, implemented = false },
		{ id = "NectarOfAges",  level = 60, implemented = false },
	},
	-- Honig-Teich (HONEY_POND_V2): die Faehigkeiten von Stock und Veredler
	-- zusammen, auf denselben Leveln.
	HoneyPond = {
		{ id = "AutoHarvest",   level = 10, implemented = true },
		{ id = "RefinerBoost",  level = 10, implemented = false },
		{ id = "GoldenDrops",   level = 30, implemented = false },
		{ id = "RoyalJelly",    level = 30, implemented = false },
		{ id = "NectarOfAges",  level = 60, implemented = false },
	},
	Recycler = {
		-- Groesserer Aufheb-Radius fuer Waben im Event-Pit (CombService).
		{ id = "CollectRadius", level = 20, implemented = true },
		{ id = "AutoDeposit",   level = 45, implemented = false },
	},
}

--------------------------------------------------------------------------------
-- Kleine Rechen-Hilfen
--------------------------------------------------------------------------------

local MAX = EconomyConfig.MAX_BUILDING_LEVEL

-- Linear von `fromValue` (Level fromLevel) nach `toValue` (Level toLevel).
local function lerpLevel(fromLevel: number, fromValue: number, toLevel: number, toValue: number, level: number): number
	local span = math.max(1, toLevel - fromLevel)
	local t = math.clamp((level - fromLevel) / span, 0, 1)
	return fromValue + (toValue - fromValue) * t
end

local function clampLevel(level: number): number
	return EconomyConfig.clampBuildingLevel(level)
end

local function roundToInt(value: number): number
	return math.floor(value + 0.5)
end

local function percentText(value: number): string
	return tostring(roundToInt(value * 100)) .. "%"
end

--------------------------------------------------------------------------------
-- Verhaltens-Objekte
--------------------------------------------------------------------------------

export type Behavior = {
	-- Sekunden, bis dieses Gebaeude auf diesem Level den naechsten Honig hat.
	getIntervalSeconds : (level: number) -> number,

	-- Wie viel Honig dieses Gebaeude auf diesem Level lagern kann.
	getCapacity : (level: number) -> number,

	-- Anteil der maximalen HP, den EIN Honig AUS DIESEM Gebaeude heilt.
	getHealPercent : (level: number) -> number,

	-- Faktor, den dieses Gebaeude zur XP JEDES Honigs beitraegt (1 = keiner).
	getXpMultiplier : (level: number) -> number,

	-- Der Effekt dieses Gebaeudes auf diesem Level, in eigenen Worten
	-- (deutsch; das UI zeigt die lokalisierten Werte selbst an).
	describe : (level: number) -> string,
}

local BASE_INTERVAL = EconomyConfig.HONEY_INTERVAL_SECONDS
local BASE_CAPACITY = EconomyConfig.HONEY_CAPACITY
local BASE_HEAL     = EconomyConfig.HONEY_HEAL_PERCENT

local function baseInterval(_level: number): number  return BASE_INTERVAL end
local function baseCapacity(_level: number): number  return BASE_CAPACITY end
local function baseHeal(_level: number): number      return BASE_HEAL end
local function noXpBonus(_level: number): number     return 1 end

--------------------------------------------------------------------------------
-- Beehive — Vorrat
--------------------------------------------------------------------------------

local function beehiveInterval(level: number): number
	local l = clampLevel(level)
	if l <= 10 then
		return lerpLevel(1, BASE_INTERVAL, 10, BEEHIVE_INTERVAL_L10, l)
	end
	return lerpLevel(10, BEEHIVE_INTERVAL_L10, MAX, BEEHIVE_MIN_INTERVAL_L60, l)
end

local function beehiveCapacity(level: number): number
	local l = clampLevel(level)
	if l <= 10 then
		return roundToInt(lerpLevel(1, BASE_CAPACITY, 10, BEEHIVE_CAPACITY_L10, l))
	end
	return BEEHIVE_CAPACITY_L10 + math.floor((l - 10) / BEEHIVE_CAPACITY_STEP)
end

local function beehiveDescribe(level: number): string
	return string.format(
		"Lager: %d Honig  —  alle %.1f s ein neuer",
		beehiveCapacity(level),
		beehiveInterval(level)
	)
end

--------------------------------------------------------------------------------
-- HoneyRefiner — Veredeln (XP fuer jeden Honig + Heilung seines Honigs)
--------------------------------------------------------------------------------

local function refinerInterval(_level: number): number
	return BASE_INTERVAL * REFINER_INTERVAL_FACTOR
end

local function refinerCapacity(_level: number): number
	return REFINER_CAPACITY
end

local function refinerHeal(level: number): number
	local l = clampLevel(level)
	if l <= 10 then
		return lerpLevel(1, BASE_HEAL, 10, REFINER_HEAL_L10, l)
	end
	return lerpLevel(10, REFINER_HEAL_L10, MAX, REFINER_HEAL_L60, l)
end

-- Der Multiplikator ist die XP-Kurve, bezogen auf ihren eigenen Startwert:
-- Level 1 = Faktor 1, Level 10 = 25x (wie die alte Presse), danach weiter.
local function refinerXpMultiplier(level: number): number
	local base = EconomyConfig.getHoneyXp(1)
	if base <= 0 then return 1 end
	return EconomyConfig.getHoneyXp(level) / base
end

local function refinerDescribe(level: number): string
	return string.format(
		"+%s XP auf jeden Honig  —  sein Honig heilt %s",
		percentText(refinerXpMultiplier(level) - 1),
		percentText(refinerHeal(level))
	)
end

--------------------------------------------------------------------------------
-- HoneyPond — Honig-Teich (HONEY_POND_V2): Stock + Veredler in einem
--------------------------------------------------------------------------------
-- Auf Level L genau so viel wie Stock UND Veredler auf Level L: dieselbe
-- Honigmenge pro Minute (Raten addiert), beide Lager, XP und Heilung wie der
-- Veredler. Ein Ausbau kostet dafuer POND_COST_FACTOR x die Grundkosten
-- (statt zwei Gebaeude einzeln). tools/luau-tests/honey_pond.test.lua prueft
-- die Gleichheit; tools/sim/progression_pacing.lua den Kostenfaktor.

local function pondInterval(level: number): number
	local perSecond = 1 / beehiveInterval(level) + 1 / refinerInterval(level)
	return 1 / perSecond
end

local function pondCapacity(level: number): number
	return beehiveCapacity(level) + refinerCapacity(level)
end

local function pondDescribe(level: number): string
	return string.format(
		"Lager: %d Honig  —  alle %.1f s ein neuer  —  +%s XP  —  heilt %s",
		pondCapacity(level),
		pondInterval(level),
		percentText(refinerXpMultiplier(level) - 1),
		percentText(refinerHeal(level))
	)
end

-- Kosten eines Teich-Ausbaus relativ zu EconomyConfig.HONEY_UPGRADE_COSTS,
-- abgestimmt mit progression_pacing (Bericht docs/HBB_HONIG_TEICH_2026-10-05.md):
--   bis Level 10: 1,2 — Look 2 (L10) nach ~24 min, also in der ERSTEN Sitzung
--   ab Level 11:  2,2 — der Teich kann so viel wie zwei Gebaeude; mit 2,2
--                 halten Look 3-6 ihre Zielzeiten (Look 4 ~8 h, Look 6 Woche 8)
local POND_COST_FACTOR_EARLY = 1.2
local POND_COST_FACTOR       = 2.2

local function pondCostFactor(level: number): number
	return if level <= 10 then POND_COST_FACTOR_EARLY else POND_COST_FACTOR
end

--------------------------------------------------------------------------------
-- Die Tabelle
--------------------------------------------------------------------------------

local BEHAVIORS: { [Types.BuildingId]: Behavior } = {
	Beehive = {
		getIntervalSeconds = beehiveInterval,
		getCapacity        = beehiveCapacity,
		getHealPercent     = baseHeal,
		getXpMultiplier    = noXpBonus,
		describe           = beehiveDescribe,
	},

	HoneyRefiner = {
		getIntervalSeconds = refinerInterval,
		getCapacity        = refinerCapacity,
		getHealPercent     = refinerHeal,
		getXpMultiplier    = refinerXpMultiplier,
		describe           = refinerDescribe,
	},

	HoneyPond = {
		getIntervalSeconds = pondInterval,
		getCapacity        = pondCapacity,
		getHealPercent     = refinerHeal,
		getXpMultiplier    = refinerXpMultiplier,
		describe           = pondDescribe,
	},
}

-- Fallback fuer kaputte Spielstaende mit einer id, die es nicht (mehr) gibt:
-- lieber die Basis-Mechanik als ein Fehler mitten in der Honig-Abrechnung.
local DEFAULT_BEHAVIOR: Behavior = {
	getIntervalSeconds = baseInterval,
	getCapacity        = baseCapacity,
	getHealPercent     = baseHeal,
	getXpMultiplier    = noXpBonus,
	describe           = function(_level: number): string return "Produziert Honig" end,
}

--------------------------------------------------------------------------------
-- Ausbau-Kosten und -Texte, pro Gebaeude
--------------------------------------------------------------------------------
-- Die KOSTEN sind fuer alle gleich (EconomyConfig.HONEY_UPGRADE_COSTS), der
-- Effekt-Text ist die describe() des Gebaeudes auf der gekauften Stufe —
-- Anzeige und Wirkung koennen nicht auseinanderlaufen.

export type UpgradeDef = {
	costGummies     : number,
	costGoldGummies : number,
	effect          : string,   -- was DIESE Stufe kann (erzeugt aus describe)
}

local BUILDING_UPGRADES: { [Types.BuildingId]: { [number]: UpgradeDef } } = {
	Beehive      = {},
	HoneyRefiner = {},
	HoneyPond    = {},
}

for id, table_ in BUILDING_UPGRADES do
	local behavior = BEHAVIORS[id]
	for level, cost in EconomyConfig.HONEY_UPGRADE_COSTS do
		local factor = if id == "HoneyPond" then pondCostFactor(level) else 1
		table_[level] = {
			costGummies     = cost.gummies * factor,
			costGoldGummies = cost.goldGummies * factor,
			effect          = behavior.describe(level),
		}
	end
end


--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

local BuildingBehavior = {}

BuildingBehavior.BUILDING_UPGRADES = BUILDING_UPGRADES
BuildingBehavior.MILESTONES        = MILESTONES
BuildingBehavior.POND_COST_FACTOR  = POND_COST_FACTOR
BuildingBehavior.pondCostFactor    = pondCostFactor

function BuildingBehavior.get(buildingId: Types.BuildingId): Behavior
	return BEHAVIORS[buildingId] or DEFAULT_BEHAVIOR
end

-- Ist das ein Gebaeude, das es wirklich gibt? Fuer Strings, die vom Client
-- kommen — die duerfen nie ungeprueft als Types.BuildingId weiterlaufen.
function BuildingBehavior.isValidId(value: string): boolean
	return BEHAVIORS[value :: Types.BuildingId] ~= nil
end

function BuildingBehavior.getIntervalSeconds(buildingId: Types.BuildingId, level: number): number
	return BuildingBehavior.get(buildingId).getIntervalSeconds(level)
end

function BuildingBehavior.getCapacity(buildingId: Types.BuildingId, level: number): number
	return BuildingBehavior.get(buildingId).getCapacity(level)
end

-- Groesstes Lager, das dieses Gebaeude je haben kann.
function BuildingBehavior.getMaxCapacity(buildingId: Types.BuildingId): number
	return BuildingBehavior.getCapacity(buildingId, EconomyConfig.MAX_BUILDING_LEVEL)
end

function BuildingBehavior.getHealPercent(buildingId: Types.BuildingId, level: number): number
	return BuildingBehavior.get(buildingId).getHealPercent(level)
end

function BuildingBehavior.getXpMultiplier(buildingId: Types.BuildingId, level: number): number
	return BuildingBehavior.get(buildingId).getXpMultiplier(level)
end

function BuildingBehavior.describeEffect(buildingId: Types.BuildingId, level: number): string
	return BuildingBehavior.get(buildingId).describe(level)
end

function BuildingBehavior.getUpgrade(buildingId: Types.BuildingId, targetLevel: number): UpgradeDef?
	local upgrades = BUILDING_UPGRADES[buildingId]
	if not upgrades then return nil end
	return upgrades[targetLevel]
end

-- v15: Look-Stufe (1-6) eines Gebaeude-Levels. Gilt fuer Bienenstock,
-- Veredler UND Recycler (gleiche Stufen). PlotDisplayService baut ein Gebaeude
-- nur neu, wenn sich DIESE Zahl aendert, nicht bei jedem Level.
function BuildingBehavior.getLook(level: number): number
	return EconomyConfig.getLook(level)
end

-- v15: Hat dieses Gebaeude (oder "Recycler") auf diesem Level die Faehigkeit?
-- Nur umgesetzte Faehigkeiten zaehlen — eine reine Daten-Faehigkeit hat noch
-- keinen Effekt und darf deshalb auch keinen ausloesen.
function BuildingBehavior.hasAbility(buildingKey: string, level: number, abilityId: string): boolean
	for _, ability in MILESTONES[buildingKey] or {} do
		if ability.id == abilityId then
			return ability.implemented and level >= ability.level
		end
	end
	return false
end

-- Alle Faehigkeiten eines Gebaeudes mit Freischalt-Level (fuers Panel).
function BuildingBehavior.getAbilities(buildingKey: string): { Ability }
	return MILESTONES[buildingKey] or {}
end

-- XP, die EIN Honig gibt — egal aus welchem Gebaeude er kommt.
--
-- Die Multiplikatoren ALLER Gebaeude werden aufmultipliziert. Heute traegt nur
-- der Veredler etwas bei (der Bienenstock gibt 1).
function BuildingBehavior.getXpPerHoney(buildings: { [Types.BuildingId]: Types.Building }): number
	local multiplier = 1

	for id, building in buildings do
		multiplier *= BuildingBehavior.getXpMultiplier(id, building.level)
	end

	-- RUNDEN, nicht abschneiden: Basis mal Quotient landet in Fliesskomma knapp
	-- NEBEN der ganzen Zahl (30 * (65/30) = 64.999...).
	return math.max(1, math.floor(EconomyConfig.getHoneyXp(1) * multiplier + 0.5))
end

-- Gesamtes Lager einer Insel ueber alle Gebaeude — fuer die Teich-Anzeige.
function BuildingBehavior.getTotalCapacity(buildings: { [Types.BuildingId]: Types.Building }): number
	local total = 0

	for id, building in buildings do
		total += BuildingBehavior.getCapacity(id, building.level)
	end

	return total
end

return BuildingBehavior
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX7"><Properties>
<string name="Name">CharmConfig</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- CharmConfig.luau
-- ReplicatedStorage/Config/CharmConfig.luau
--
-- Alle Zahlen der Battle-Charms an einer Stelle:
--   - acht Slots und ab welcher Promotions-Stufe jeder freigeschaltet wird
--   - die Rarity-Odds eines Wurfs
--   - der Pool moeglicher Stat-Typen und ihre Wertebereiche je Rarity
--   - was ein Wurf kostet
--
-- ============================================================
-- EIN SLOT IST NICHT AN EINEN STAT-TYP GEBUNDEN
-- ============================================================
-- Wichtigste Regel, vom Projektinhaber ausdruecklich klargestellt: die acht
-- Slots haben KEINEN festen Stat-Typ. Jeder Wurf zieht zweimal unabhaengig —
-- erst eine Rarity (RARITY_ODDS), dann einen Stat-Typ (STAT_POOL) — und zwar
-- fuer jeden Slot gleich, egal welcher Slot-Index es ist.
--
-- Die "Promotion Tiers"-Tabelle aus der Vorlage ist deshalb hier NUR eine
-- Freischalt-Liste (SLOT_UNLOCK_PROMOTION): sie sagt, ab wann ein Slot
-- ueberhaupt benutzbar ist — nicht, was darin sitzt.
--
-- ============================================================
-- KEINE NEUE WAEHRUNG
-- ============================================================
-- Die Vorlage kennt eine eigene Ressource ("Charm Dust"). In Baerchi Fighter
-- gibt es die bewusst NICHT — der Projektinhaber will das Ressourcen-System
-- einfach halten. Ein Wurf kostet direkt GoldGummies, die bereits bestehende
-- zweite Waehrung (seit GOLD_CHARMS_ONLY nur noch aus den Tages-Quests).
--
-- ============================================================
-- WARUM NUR VIER STAT-TYPEN
-- ============================================================
-- Die Vorlage zeigt Boni wie "Crit DMG" oder "Movement Speed" — beides gibt es
-- in Baerchi Fighter gar nicht (keine Krits, die Figuren laufen mit
-- MapConfig.WALK_SPEED). Ein Charm, der auf nichts wirkt, waere ein stiller
-- Fehler, der erst beim Balancing auffaellt. Deshalb enthaelt der Pool
-- ausschliesslich Boni, die CombatCalculator.getEffectiveStats auch wirklich
-- anwendet. Neue Typen sind ein Eintrag in STAT_POOL plus eine Zeile dort —
-- mehr braucht es nicht.

local Types = require(script.Parent.Parent.Network.Types)

--------------------------------------------------------------------------------
-- Slots
--------------------------------------------------------------------------------

local SLOT_COUNT = 8

-- Ab welcher PROMOTIONS-STUFE (0-10, nicht Sterne!) ein Slot benutzbar ist.
-- Die Zahlen kommen 1:1 aus der "Promotion Tiers"-Tabelle der Vorlage:
-- Slot I ist von Anfang an offen, II ab 2, III ab 4, IV ab 6, V und VI ab 8,
-- VII und VIII ab 10.
local SLOT_UNLOCK_PROMOTION: { number } = { 0, 2, 4, 6, 8, 8, 10, 10 }

-- Roemische Ziffern fuer die Slot-Beschriftung (I-VIII), wie in der Vorlage.
local SLOT_NUMERALS: { string } = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII" }

--------------------------------------------------------------------------------
-- Rarity eines Charms
--------------------------------------------------------------------------------

-- Eigene Rarity-Kette, absichtlich NICHT Types.Rarity: ein Charm hat sechs
-- Stufen mit anderen Namen ("Super Rare", "Ascended") als ein Baerchi. Sie in
-- einen Topf zu werfen waere die naechste Stelle, an der eine Baerchi-Aenderung
-- versehentlich die Charm-Odds verschiebt.
local RARITY_ORDER: { Types.CharmRarity } = {
	"Common", "Uncommon", "Rare", "SuperRare", "Legendary", "Ascended",
}

-- Wahrscheinlichkeit je Wurf, in Prozent. Zahlen 1:1 aus der Vorlage
-- (Bild 3: "Each slot rolls a rarity, then a stat").
-- Summe = 100.0 — die Pruefung dazu steht in rollRarity.
local RARITY_ODDS: { [Types.CharmRarity]: number } = {
	Common    = 49.8,
	Uncommon  = 26.9,
	Rare      = 17.9,
	SuperRare =  4.3,
	Legendary =  1.0,
	Ascended  =  0.1,
}

-- Kurzbuchstabe fuer das Slot-Icon (C / U / R / S / L / A), wie in der Vorlage.
local RARITY_LETTER: { [Types.CharmRarity]: string } = {
	Common    = "C",
	Uncommon  = "U",
	Rare      = "R",
	SuperRare = "S",
	Legendary = "L",
	Ascended  = "A",
}

local RARITY_LABEL: { [Types.CharmRarity]: string } = {
	Common    = "Common",
	Uncommon  = "Uncommon",
	Rare      = "Rare",
	SuperRare = "Super Rare",
	Legendary = "Legendary",
	Ascended  = "Ascended",
}

local RARITY_COLORS: { [Types.CharmRarity]: Color3 } = {
	Common    = Color3.fromRGB(176, 190, 204),
	Uncommon  = Color3.fromRGB( 76, 217, 100),
	Rare      = Color3.fromRGB( 46, 155, 255),
	SuperRare = Color3.fromRGB(168,  85, 247),
	Legendary = Color3.fromRGB(255, 176,  32),
	Ascended  = Color3.fromRGB(255,  59, 107),
}

-- Wie stark ein Charm dieser Rarity ist, als Faktor auf den Grundwert des
-- Stat-Typs (siehe STAT_POOL). Ein Ascended-Charm ist damit fuenfmal so stark
-- wie ein Common desselben Typs.
local RARITY_POWER: { [Types.CharmRarity]: number } = {
	Common    = 1.0,
	Uncommon  = 1.6,
	Rare      = 2.4,
	SuperRare = 3.4,
	Legendary = 4.4,
	Ascended  = 6.0,
}

--------------------------------------------------------------------------------
-- Stat-Typen
--------------------------------------------------------------------------------

-- `mode`:
--   "percent" — der Wert ist ein Faktor auf den Basiswert (0.014 = +1.4%)
--   "flat"    — der Wert wird direkt addiert
--
-- `base` ist der Wert eines COMMON-Charms dieses Typs; die Rarity
-- multipliziert ihn (RARITY_POWER), und rollValue streut zusaetzlich
-- +/- SPREAD, damit zwei Charms derselben Rarity nicht identisch sind.
export type CharmStatDef = {
	id          : string,
	displayName : string,
	target      : "hp" | "atk" | "spd" | "pwr",
	mode        : "percent" | "flat",
	base        : number,
}

-- Die vier Ziele sind genau die vier Basiswerte des Spiels. Eine
-- Schadensabwehr gibt es NICHT — es gibt keine Verteidigung mehr (siehe
-- BaerchiConfig): wer einen Tank will, wuerfelt auf HP-Boost.
local STAT_POOL: { CharmStatDef } = {
	{ id = "HpBoost",   displayName = "HP-Boost",         target = "hp",  mode = "percent", base = 0.014 },
	{ id = "AtkBoost",  displayName = "ATK-Boost",        target = "atk", mode = "percent", base = 0.012 },
	{ id = "SpdBoost",  displayName = "Angriffs-Tempo",   target = "spd", mode = "flat",    base = 0.020 },

	-- Flach, nicht prozentual: PWR ist selbst schon ein Multiplikator auf den
	-- Skill-Schaden. "+8% auf einen Multiplikator" waere eine Zahl, die
	-- niemand im Kopf nachrechnet — "+2.4 Prozentpunkte Ability-Schaden"
	-- dagegen schon.
	{ id = "PwrBoost",  displayName = "Ability-Staerke",  target = "pwr", mode = "flat",    base = 0.008 },
}

-- Streuung um den errechneten Wert (0.25 = +/- 25%).
local SPREAD = 0.25

--------------------------------------------------------------------------------
-- Kosten
--------------------------------------------------------------------------------

-- Ein Wurf wuerfelt ALLE freigeschalteten und nicht gesperrten Slots des
-- Baerchis auf einmal neu — genau wie in der Vorlage ("rerolls every slot you
-- have not locked"). Deshalb ist der Preis pro WURF, nicht pro Slot.
local ROLL_COST_GOLD_GUMMIES = 25

-- "Auto Roll" ist serverseitig einfach ein Wurf-Paket: der Client schickt eine
-- Anzahl, der Server wuerfelt so oft hintereinander, bis die Anzahl erreicht
-- ist ODER die GoldGummies nicht mehr reichen, und meldet das Ergebnis
-- gesammelt zurueck.
--
-- Bewusst so statt eines Dauer-Timers auf dem Client: ein Auto-Roll, der pro
-- Wurf ein Remote feuert, laeuft sofort in den RateLimiter (siehe
-- NetworkConfig) und wuerde entweder haengen oder halb durchlaufen. Ein Paket
-- ist eine Anfrage, eine Abrechnung, ein Ergebnis.
local AUTO_ROLL_COUNT = 20

--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

local function getUnlockPromotion(slot: number): number
	return SLOT_UNLOCK_PROMOTION[slot] or math.huge
end

local function isSlotUnlocked(slot: number, promotionLevel: number): boolean
	if slot < 1 or slot > SLOT_COUNT then
		return false
	end
	return (promotionLevel or 0) >= getUnlockPromotion(slot)
end

-- Wie viele Slots bei diesem Promotions-Stand offen sind.
local function countUnlockedSlots(promotionLevel: number): number
	local count = 0
	for slot = 1, SLOT_COUNT do
		if isSlotUnlocked(slot, promotionLevel) then
			count += 1
		end
	end
	return count
end

local function getStatDef(statId: string): CharmStatDef?
	for _, def in STAT_POOL do
		if def.id == statId then
			return def
		end
	end
	return nil
end

-- Wuerfelt eine Rarity anhand von RARITY_ODDS.
--
-- Geht die Kette bewusst von der SELTENSTEN zur haeufigsten durch und
-- vergleicht gegen die aufsummierte Wahrscheinlichkeit: so faellt ein
-- Rundungsrest (die Odds summieren sich auf exakt 100.0, aber math.random gibt
-- Werte bis knapp darunter) immer auf Common zurueck und nie auf einen
-- Ascended.
local function rollRarity(): Types.CharmRarity
	local roll        = math.random() * 100
	local accumulated = 0

	for i = #RARITY_ORDER, 1, -1 do
		local rarity = RARITY_ORDER[i]
		accumulated += RARITY_ODDS[rarity] or 0
		if roll < accumulated then
			return rarity
		end
	end

	return "Common"
end

local function rollStatDef(): CharmStatDef
	return STAT_POOL[math.random(1, #STAT_POOL)]
end

-- Der konkrete Bonus-Wert eines Charms: Grundwert des Typs, mal Rarity-Staerke,
-- plus/minus SPREAD.
local function rollValue(statDef: CharmStatDef, rarity: Types.CharmRarity): number
	local power  = RARITY_POWER[rarity] or 1
	local center = statDef.base * power
	local factor = 1 + (math.random() * 2 - 1) * SPREAD

	-- Auf vier Nachkommastellen runden: sonst stehen im Spielstand Zahlen mit
	-- fuenfzehn Stellen, die kein Mensch und keine Anzeige braucht.
	return math.floor(center * factor * 10000 + 0.5) / 10000
end

-- Wuerfelt einen kompletten Charm fuer einen Slot.
local function rollCharm(slot: number): Types.Charm
	local rarity  = rollRarity()
	local statDef = rollStatDef()

	return {
		slot   = slot,
		rarity = rarity,
		statId = statDef.id,
		value  = rollValue(statDef, rarity),
		locked = false,
	}
end

-- Lesbarer Effekt-Text ("+3.4% HP-Boost"). Server und Client benutzen
-- denselben, damit die Anzeige nicht zweimal formatiert wird.
local function describe(charm: Types.Charm): string
	local statDef = getStatDef(charm.statId)
	if not statDef then
		return charm.statId
	end

	-- Als Prozent anzuzeigen sind zwei Faelle: echte Prozent-Charms (HP/ATK)
	-- und PWR. PWR ist zwar technisch ein FLACHER Zuschlag, aber der Wert
	-- selbst ist ein Anteil (0.05 = 5% mehr Ability-Schaden) — als "+0.048"
	-- koennte ihn niemand einordnen.
	if statDef.mode == "percent" or statDef.target == "pwr" then
		return string.format("+%.1f%% %s", charm.value * 100, statDef.displayName)
	end
	return string.format("+%.3f %s", charm.value, statDef.displayName)
end

return {
	SLOT_COUNT            = SLOT_COUNT,
	SLOT_UNLOCK_PROMOTION = SLOT_UNLOCK_PROMOTION,
	SLOT_NUMERALS         = SLOT_NUMERALS,

	RARITY_ORDER   = RARITY_ORDER,
	RARITY_ODDS    = RARITY_ODDS,
	RARITY_LETTER  = RARITY_LETTER,
	RARITY_LABEL   = RARITY_LABEL,
	RARITY_COLORS  = RARITY_COLORS,
	RARITY_POWER   = RARITY_POWER,

	STAT_POOL = STAT_POOL,
	SPREAD    = SPREAD,

	ROLL_COST_GOLD_GUMMIES = ROLL_COST_GOLD_GUMMIES,
	AUTO_ROLL_COUNT        = AUTO_ROLL_COUNT,

	getUnlockPromotion = getUnlockPromotion,
	isSlotUnlocked     = isSlotUnlocked,
	countUnlockedSlots = countUnlockedSlots,
	getStatDef         = getStatDef,
	rollRarity         = rollRarity,
	rollCharm          = rollCharm,
	describe           = describe,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX8"><Properties>
<string name="Name">EconomyConfig</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- EconomyConfig.luau
-- ReplicatedStorage/Config/EconomyConfig.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Preise, Kosten und Ertraege, die nicht zu einem eigenen System
--     gehoeren: Rebirth, Honig, Gebaeude-Ausbau (Level 1-60), Recycling,
--     Fusion, Rang.
-- EconomyService liest nur von hier — keine Zahl ist im Service selbst.
--
-- Seit v15 stehen die Zahlen des Kampfs (Stage-Gummies, GoldGummies pro Lauf,
-- Fortsetzen) in Config/TowerConfig — das PIT-Level gibt es nicht mehr.
--
-- Die "effect"-Strings in BUILDING_UPGRADES werden aus HONEY_XP ERZEUGT und
-- nicht von Hand gepflegt. Frueher standen Text und Zahl getrennt da und
-- liefen beim Balancing auseinander — das kann jetzt nicht mehr passieren.

local Types = require(script.Parent.Parent.Network.Types)
local FeatureFlags = require(script.Parent.FeatureFlags)

--------------------------------------------------------------------------------
-- Rebirth
--------------------------------------------------------------------------------

-- Gummies-Kosten fuer Rebirth n (Index = rebirthCount + 1).
--
-- v15: NEU KALIBRIERT fuer das Tower-System (tools/sim/progression_pacing.lua,
-- Profil "Normal" 90 min/Tag). Mit dem Tower-Einkommen waeren die alten Preise
-- (10.000 / 35.000 / ...) nach Minuten bezahlt gewesen. Ziel-Dauer eines
-- Lebens: Rebirth 1 nach ~3 h aktiver Zeit (Spieltag 2-3), danach 3,5 / 4,5 /
-- 6 h; die Rebirths 4-6 und 14-15 werden vom Tower-Deckel bzw. der
-- Baerchi-Staerke begrenzt, ihre Preise sind geglaettet. ANNAHME, im Bericht.
local REBIRTH_COST_GUMMIES: { number } = {
	1_500_000,             -- Rebirth 1
	230_000_000,           -- Rebirth 2
	4_400_000_000,         -- Rebirth 3
	25_000_000_000,        -- Rebirth 4
	120_000_000_000,       -- Rebirth 5
	300_000_000_000,       -- Rebirth 6
	570_000_000_000,       -- Rebirth 7 (oeffnet den Final-Tower)
	1_160_000_000_000,     -- Rebirth 8
	1_600_000_000_000,     -- Rebirth 9
	3_500_000_000_000,     -- Rebirth 10
	6_500_000_000_000,     -- Rebirth 11
	11_000_000_000_000,    -- Rebirth 12
	17_000_000_000_000,    -- Rebirth 13
	25_000_000_000_000,    -- Rebirth 14
	40_000_000_000_000,    -- Rebirth 15 (Final-Deckel 100)
}

-- Multiplikator nach Rebirth n (Index = rebirthCount nach dem Reset)
local REBIRTH_MULTIPLIERS: { number } = {
	1.0,   -- kein Rebirth
	1.5,   -- nach Rebirth 1
	2.25,  -- nach Rebirth 2
	3.50,  -- nach Rebirth 3
	5.50,  -- nach Rebirth 4
	8.00,  -- nach Rebirth 5+
}

-- Gummies mit denen ein Spieler nach dem Rebirth startet.
-- Bewusst identisch mit dem Startwert eines neuen Spielers.
local REBIRTH_START_GUMMIES = 100

-- ============================================================
-- v14: REBIRTH-KURVE BIS 100
-- ============================================================
-- Bis v13 waren die Kosten ab Rebirth 5 flach (1 Mio) und der Multiplikator
-- stoppte bei x8. Fuer die Ascensions-Eier bei Rebirth 50 bis 100 geht die
-- Kurve jetzt weiter:
--
--   Kosten  Rebirth n (n >= 16) = Kosten 15 x REBIRTH_COST_GROWTH ^ (n - 15)
--   Multi   nach Rebirth n (n >= 6) = 8 x REBIRTH_MULT_GROWTH ^ (n - 5)
--
-- (v15: die Kosten-Tabelle oben reicht bis Rebirth 15, danach waechst sie wie
-- bisher mit 1.13. Die Multiplikatoren sind unveraendert.)
--
-- Warum diese beiden Zahlen: die Zeit fuer einen Rebirth ist ungefaehr
-- Kosten / (Einkommen x Multiplikator). Waechst die Kosten-Kurve nur ein
-- kleines Stueck schneller als der Multiplikator (1.13 gegen 1.12), wird
-- jeder Rebirth nur knapp 1% laenger als der vorige: Rebirth 100 dauert
-- etwa 2,3-mal so lange wie Rebirth 6. Gerechnet in tools/sim/rebirth_curve.lua
-- (Tabelle im Bericht MEGA_EGG_TREE_UMGESETZT).
--
-- Gerundet wird auf drei gueltige Stellen, damit im UI "1.130.000" steht und
-- nicht "1.129.999".
local REBIRTH_COST_GROWTH = 1.13
local REBIRTH_MULT_GROWTH = 1.12

-- v14: REBIRTH-MEILENSTEINE. Bei welchem rebirthCount (NACH dem Rebirth) es
-- welche Eier gibt. `unlock` = dieser Meilenstein schaltet den Knoten des
-- Eis im Ei-Baum frei (zusaetzlich zur normalen Rebirth-Bedingung, die bei
-- derselben Zahl liegt — doppelt haelt besser, falls jemand eine der beiden
-- Zahlen verschiebt).
--
-- Die Ascensions-Eier sind nicht kaufbar und werden fast nie gelegt — das
-- hier ist ihre Hauptquelle. Transzendenz, Ewigkeit und Omega gibt es NUR hier.
export type RebirthMilestone = {
	eggs   : { { eggType: Types.EggType, count: number } },
	unlock : { Types.EggType }?,
}

local REBIRTH_MILESTONES: { [number]: RebirthMilestone } = {
	[1]   = { eggs = { { eggType = "AscensionEgg", count = 1 } } },
	[3]   = { eggs = { { eggType = "AscensionEgg", count = 1 } } },
	[5]   = { eggs = { { eggType = "AscensionEgg", count = 2 } } },
	[10]  = { eggs = { { eggType = "AscensionEgg", count = 3 } } },
	[15]  = { eggs = { { eggType = "TranscendenceEgg", count = 1 } }, unlock = { "TranscendenceEgg" } },
	[20]  = { eggs = { { eggType = "AscensionEgg", count = 5 } } },
	[25]  = { eggs = { { eggType = "TranscendenceEgg", count = 2 } } },
	[30]  = { eggs = { { eggType = "EternityEgg", count = 1 } }, unlock = { "EternityEgg" } },
	[40]  = { eggs = { { eggType = "TranscendenceEgg", count = 3 }, { eggType = "EternityEgg", count = 1 } } },
	[50]  = { eggs = { { eggType = "OmegaEgg", count = 1 }, { eggType = "EternityEgg", count = 2 } }, unlock = { "OmegaEgg" } },
	[75]  = { eggs = { { eggType = "OmegaEgg", count = 2 } } },
	[100] = { eggs = { { eggType = "OmegaEgg", count = 3 } } },
}

-- Fuer alte Stellen, die nur die Ascensions-Eier kennen (wird von
-- getAscensionEggReward weiter gelesen).
local REBIRTH_ASCENSION_MILESTONES: { [number]: number } = {}
for n, milestone in REBIRTH_MILESTONES do
	for _, entry in milestone.eggs do
		if entry.eggType == "AscensionEgg" then
			REBIRTH_ASCENSION_MILESTONES[n] = (REBIRTH_ASCENSION_MILESTONES[n] or 0) + entry.count
		end
	end
end

--------------------------------------------------------------------------------
-- Honig (Gebaeude-Produktion und Fuetterung)
--------------------------------------------------------------------------------

-- Sekunden bis ein Gebaeude einen weiteren Honig hergestellt hat — die
-- gemeinsame Basis fuer alle drei. Auch der Takt, in dem HoneyService seinen
-- Nachrechen-Loop laufen laesst.
--
-- Ob ein einzelnes Gebaeude davon ABWEICHT (aktuell: nur der Honigtopf wird
-- mit steigendem Level schneller), steht nicht mehr hier, sondern in
-- Config/BuildingBehavior.luau — ein Eintrag pro Gebaeude statt einer
-- if-Kette. Diese Datei kennt BuildingBehavior bewusst NICHT: die
-- Abhaengigkeit geht nur in die andere Richtung, sonst waere es ein
-- Ringschluss.
local HONEY_INTERVAL_SECONDS = 20

-- BASIS-Lager eines Gebaeudes. Ist das Lager voll, steht die Produktion bis
-- wieder gefuettert wird — genau das macht das regelmaessige Zurueckkommen zum
-- Plot noetig.
--
-- Der Bienenstock waechst darueber hinaus (BuildingBehavior); fuer die anderen
-- beiden ist das der endgueltige Wert.
local HONEY_CAPACITY = 5

-- BASIS-Anteil der maximalen HP, den ein Honig heilt. Vier Honig bringen einen
-- erschoepften Baerchi also wieder auf volle Kraft.
--
-- Der Honigtopf heilt mit steigendem Level mehr (BuildingBehavior); fuer die
-- anderen beiden bleibt es bei diesem Wert.
local HONEY_HEAL_PERCENT = 0.25

-- Ab welchem HP-Anteil der Autopilot beim Fuettern bewusst den Honig mit der
-- STAERKSTEN Heilung nimmt, statt den, dessen Lager am vollsten ist.
--
-- Der Autopilot ist der einzige, der nicht fragen kann, welchen Honig der
-- Spieler verfuettern will — im UI waehlt der Spieler selbst (BaerchiPanel).
local HONEY_AUTO_HEAL_HP_RATIO = 0.5

-- Die XP-Kurve fuer EINEN Honig. Index = Level des HONIG-VEREDLERS (bis v14:
-- der Honig-Presse; die Migration uebernimmt das hoehere Level von Topf und
-- Presse, siehe PlayerMigration).
--
-- BuildingBehavior rechnet daraus den Multiplikator des Veredlers, der auf
-- JEDEN Honig wirkt. Level 1-10 sind unveraendert seit v7; ab Level 11 waechst
-- die Kurve mit HONEY_XP_GROWTH pro Level weiter (siehe getHoneyXp).
--
-- Zusammen mit der XP-Kurve in BaerchiConfig (ca. 730 XP bis Level 7) heisst
-- Level 1: rund 24 Honig bis Level 7 — bei drei Gebaeuden gut zweieinhalb
-- Minuten. Genau so schnell soll der Einstieg sein.
local HONEY_XP: { number } = {
	[1]  = 30,
	[2]  = 45,
	[3]  = 65,
	[4]  = 95,
	[5]  = 135,
	[6]  = 190,
	[7]  = 265,
	[8]  = 370,
	[9]  = 520,
	[10] = 750,
}

-- v15: XP-Zuwachs pro Veredler-Level ab Level 11 (Level 30 ≈ 12.300, Level 60
-- ≈ 820.000 XP pro Honig). Kalibriert mit tools/sim/progression_pacing.lua: ein
-- hoher Veredler bringt einen frisch zurueckgesetzten Baerchi nach einem
-- Rebirth in Minuten statt Stunden wieder auf Level 50.
local HONEY_XP_GROWTH = 1.15

--------------------------------------------------------------------------------
-- Gebaeude-Upgrades (v15: Level 1-60)
--------------------------------------------------------------------------------

local MAX_BUILDING_LEVEL = 60

-- Kosten fuer das Upgrade AUF dieses Level. Beginnt bei Index 2, weil Level 1
-- der Startzustand ist — deshalb bewusst als Map und nicht als Array.
--
-- Die KOSTENKURVE gilt fuer ALLE Gebaeude inklusive Recycler (CombConfig): sie
-- kosten gleich viel, koennen aber Verschiedenes. Die Ausbau-Tabellen mit
-- Effekt-Text baut BuildingBehavior aus dieser Kurve.
--
-- Level 2-10 sind seit v7 unveraendert (Vorgabe: bestehende Spielstaende).
-- Ab Level 11 setzt sich die Kurve exponentiell fort (unten erzeugt), flacher
-- als bisher (x2,3 je Level bis 10, danach COST_GROWTH_AFTER_10).
local HONEY_UPGRADE_COSTS: { [number]: { gummies: number, goldGummies: number } } = {
	[2]  = { gummies = 250,    goldGummies = 0  },
	[3]  = { gummies = 700,    goldGummies = 0  },
	[4]  = { gummies = 1_800,  goldGummies = 0  },
	[5]  = { gummies = 4_500,  goldGummies = 3  },
	[6]  = { gummies = 11_000, goldGummies = 8  },
	[7]  = { gummies = 26_000, goldGummies = 16 },
	[8]  = { gummies = 60_000, goldGummies = 30 },
	[9]  = { gummies = 140_000,goldGummies = 55 },
	[10] = { gummies = 320_000,goldGummies = 95 },
}

-- v15: Fortsetzung der Kostenkurve ab Level 11. ANNAHME, per
-- tools/sim/progression_pacing.lua kalibriert auf die Look-Zielzeiten (README
-- 4.4): Look 3 (L20) ~Tag 2-3, Look 4 (L30) ~Woche 1, Look 5 (L45) ~Woche 2-3,
-- Look 6 (L60) ~Woche 5-8 bei 1,5 h aktiver Spielzeit pro Tag.
-- Zwei Abschnitte: bis Level 30 flacher (Look 3 und 4 sollen in der ersten
-- Woche kommen), danach steiler (Look 5 und 6 sind das Langzeitziel).
-- GOLD_CHARMS_ONLY: ohne Gold-Kosten bremsen nur noch die Gummies; 1,23 haelt
-- Look 4 (L30) bei ~6,3 h statt 5,9 h (progression_pacing, Profil Normal).
local COST_GROWTH_AFTER_10 = if FeatureFlags.isOn("GOLD_CHARMS_ONLY") then 1.23 else 1.22   -- Level 11-30
local COST_GROWTH_AFTER_30 = 1.33   -- Level 31-60
local GOLD_GROWTH_AFTER_10 = 1.035

-- v15: Look-Stufen der Gebaeude (Modelle kommen in Prompt 4). Index = Look,
-- Wert = erstes Level dieses Looks: 1-9 / 10-19 / 20-29 / 30-44 / 45-59 / 60.
local LOOK_THRESHOLDS: { number } = { 1, 10, 20, 30, 45, 60 }

-- Die fertigen Ausbau-Tabellen (Kosten + Effekt-Text) stehen seit v7 in
-- Config/BuildingBehavior.luau, eine pro Gebaeude. Sie muessen dort stehen und
-- nicht hier, weil ihr Effekt-Text die Mechanik des jeweiligen Gebaeudes
-- beschreibt — und die kennt nur BuildingBehavior. Umgekehrt duerfte diese
-- Datei BuildingBehavior gar nicht requiren: das waere ein Ringschluss.

--------------------------------------------------------------------------------
-- Feste Werte fuer die Funktionen die kein Gebaeude mehr haben
--------------------------------------------------------------------------------

-- (v12: HATCH_SLOTS ist entfallen — Eier werden sofort geoeffnet.)

-- Recycling laeuft ebenfalls ueber das GUI: fester Anteil des Baerchi-Werts,
-- der als Gummies zurueckkommt (frueher Recycler-Level-abhaengig).
local RECYCLE_RETURN = 0.40

-- Basiswert eines Baerchis auf Level 1, nach Rarity (in Gummies).
-- Das Recycling gibt davon RECYCLE_RETURN zurueck.
local RECYCLE_BASE_VALUE: { [Types.Rarity]: number } = {
	Common    = 25,
	Uncommon  = 60,
	Rare      = 150,
	Epic      = 500,
	Legendary = 2_000,
	Mythic    = 8_000,
	Divine    = 20_000,
	Cosmic    = 50_000,
	Secret    = 120_000,
	Godly     = 300_000,
	Eternal   = 750_000,
	Omega     = 2_000_000,
}

-- Wertzuwachs pro Baerchi-Level: value * (1 + (level-1) * RECYCLE_LEVEL_BONUS)
local RECYCLE_LEVEL_BONUS = 0.10

--------------------------------------------------------------------------------
-- Fusion
--------------------------------------------------------------------------------

-- Fester Stat-Bonus den JEDES Fusions-Ergebnis mitbekommt. Fusion ist seit v3
-- kein Gebaeude mehr, sondern ein reines GUI-Feature ohne Unlock-Level.
local FUSION_STAT_BONUS = 0.50

-- (v15: der Abschnitt "PIT" ist entfallen. Stage-Gummies, GoldGummies pro Lauf
-- und Fortsetzen stehen in Config/TowerConfig, die alten PIT-Ausbaukosten nur
-- noch fuer die Erstattung in TowerConfig.LEGACY_PIT_UPGRADE_COSTS.)

--------------------------------------------------------------------------------
-- Rang-Schwellwerte (Arena PvP)
--------------------------------------------------------------------------------

export type RankTierDef = {
	tier        : number,
	name        : string,
	minPoints   : number,
	rewardGummies     : number,   -- Saisonende-Belohnung
	rewardGoldGummies : number,
}

local RANK_TIERS: { RankTierDef } = {
	{ tier=1, name="Gummy Hatchling", minPoints=0,    rewardGummies=500,   rewardGoldGummies=0  },
	{ tier=2, name="Sugar Brawler",   minPoints=100,  rewardGummies=1500,  rewardGoldGummies=5  },
	{ tier=3, name="Crystal Fighter", minPoints=300,  rewardGummies=4000,  rewardGoldGummies=15 },
	{ tier=4, name="Golden Champion", minPoints=700,  rewardGummies=10000, rewardGoldGummies=40 },
	{ tier=5, name="Cosmic Legend",   minPoints=1500, rewardGummies=30000, rewardGoldGummies=100},
}

--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

-- Level auf den gueltigen Bereich einer Effekt-Tabelle klemmen.
-- Schuetzt vor kaputten Save-Daten mit Level 0 oder 99.
local function clampBuildingLevel(level: number): number
	return math.clamp(math.floor(level), 1, MAX_BUILDING_LEVEL)
end

-- Auf drei gueltige Stellen runden (1129999 -> 1130000).
local function roundSignificant(value: number): number
	if value < 1000 then return math.floor(value + 0.5) end
	local digits = math.floor(math.log10(value)) + 1
	local factor = 10 ^ (digits - 3)
	return math.floor(value / factor + 0.5) * factor
end

-- v15: Ausbaukosten ab Level 11 erzeugen (einmal beim Laden).
do
	local base = HONEY_UPGRADE_COSTS[10]
	for level = 11, MAX_BUILDING_LEVEL do
		local steps = level - 10
		local early = math.min(steps, 20)
		local late  = math.max(0, steps - 20)
		HONEY_UPGRADE_COSTS[level] = {
			gummies     = roundSignificant(base.gummies * COST_GROWTH_AFTER_10 ^ early * COST_GROWTH_AFTER_30 ^ late),
			goldGummies = roundSignificant(base.goldGummies * GOLD_GROWTH_AFTER_10 ^ steps),
		}
	end
	-- GOLD_CHARMS_ONLY: Ausbauten kosten nur noch Gummies. Erst NACH dem
	-- Erzeugen nullen, damit die alte Kurve bei ausgeschaltetem Flag gleich bleibt.
	-- Gilt fuer alle drei Gebaeude und den Recycler (CombConfig liest diese Tabelle).
	if FeatureFlags.isOn("GOLD_CHARMS_ONLY") then
		for _, cost in HONEY_UPGRADE_COSTS do
			cost.goldGummies = 0
		end
	end
end

-- Look-Stufe (1-6) eines Gebaeude-Levels.
local function getLook(level: number): number
	local look = 1
	for index, from in LOOK_THRESHOLDS do
		if level >= from then
			look = index
		end
	end
	return look
end

-- Kosten fuer den NAECHSTEN Rebirth (rebirthCount = bisherige Anzahl).
local function getRebirthCost(rebirthCount: number): number
	local n = rebirthCount + 1
	if n <= #REBIRTH_COST_GUMMIES then
		return REBIRTH_COST_GUMMIES[n]
	end
	local last = REBIRTH_COST_GUMMIES[#REBIRTH_COST_GUMMIES]
	return roundSignificant(last * REBIRTH_COST_GROWTH ^ (n - #REBIRTH_COST_GUMMIES))
end

-- Multiplikator NACH `rebirthCount` Rebirths.
local function getRebirthMult(rebirthCount: number): number
	local idx = rebirthCount + 1
	if idx <= #REBIRTH_MULTIPLIERS then
		return REBIRTH_MULTIPLIERS[idx]
	end
	local last = REBIRTH_MULTIPLIERS[#REBIRTH_MULTIPLIERS]
	local raw = last * REBIRTH_MULT_GROWTH ^ (idx - #REBIRTH_MULTIPLIERS)
	-- Zwei Nachkommastellen reichen fuer die Anzeige "x8,96".
	if raw < 100 then
		return math.floor(raw * 100 + 0.5) / 100
	end
	return roundSignificant(raw)
end

-- Wie viele AscensionEggs es fuer das Erreichen dieses rebirthCount gibt
local function getAscensionEggReward(rebirthCount: number): number
	return REBIRTH_ASCENSION_MILESTONES[rebirthCount] or 0
end

-- v14: der komplette Meilenstein (alle Ei-Sorten) oder nil.
local function getRebirthMilestone(rebirthCount: number): RebirthMilestone?
	return REBIRTH_MILESTONES[rebirthCount]
end

-- XP die ein Honig bei diesem Veredler-Level gibt (Level 1-10 aus der
-- Tabelle, danach mit HONEY_XP_GROWTH weiter).
local function getHoneyXp(buildingLevel: number): number
	local level = clampBuildingLevel(buildingLevel)
	if level <= #HONEY_XP then
		return HONEY_XP[level]
	end
	return math.floor(HONEY_XP[#HONEY_XP] * HONEY_XP_GROWTH ^ (level - #HONEY_XP) + 0.5)
end

-- Fester Wert seit v3 (siehe FUSION_STAT_BONUS oben) — keine Level-Eingabe
-- mehr noetig. Als Funktion belassen statt die Konstante direkt zu lesen,
-- damit FusionService/FusionPanel nicht wissen muessen OB es ein fester
-- Wert oder eine Berechnung ist.
local function getFusionStatBonus(): number
	return FUSION_STAT_BONUS
end

-- Gummy-Wert eines Baerchis wenn er komplett (100%) verwertet wuerde
local function getBaerchiBaseValue(rarity: Types.Rarity, level: number): number
	local base = RECYCLE_BASE_VALUE[rarity] or RECYCLE_BASE_VALUE.Common
	return math.floor(base * (1 + (math.max(level, 1) - 1) * RECYCLE_LEVEL_BONUS))
end

local function getRankForPoints(points: number): RankTierDef
	local result = RANK_TIERS[1]
	for _, tier in RANK_TIERS do
		if points >= tier.minPoints then
			result = tier
		end
	end
	return result
end

return {
	REBIRTH_COST_GUMMIES         = REBIRTH_COST_GUMMIES,
	REBIRTH_MULTIPLIERS          = REBIRTH_MULTIPLIERS,
	REBIRTH_START_GUMMIES        = REBIRTH_START_GUMMIES,
	REBIRTH_ASCENSION_MILESTONES = REBIRTH_ASCENSION_MILESTONES,
	REBIRTH_MILESTONES           = REBIRTH_MILESTONES,
	REBIRTH_COST_GROWTH          = REBIRTH_COST_GROWTH,
	REBIRTH_MULT_GROWTH          = REBIRTH_MULT_GROWTH,
	getRebirthMilestone          = getRebirthMilestone,

	HONEY_INTERVAL_SECONDS   = HONEY_INTERVAL_SECONDS,
	HONEY_CAPACITY           = HONEY_CAPACITY,
	HONEY_HEAL_PERCENT       = HONEY_HEAL_PERCENT,
	HONEY_AUTO_HEAL_HP_RATIO = HONEY_AUTO_HEAL_HP_RATIO,
	HONEY_XP                 = HONEY_XP,
	HONEY_XP_GROWTH          = HONEY_XP_GROWTH,

	HONEY_UPGRADE_COSTS  = HONEY_UPGRADE_COSTS,
	MAX_BUILDING_LEVEL   = MAX_BUILDING_LEVEL,
	COST_GROWTH_AFTER_10 = COST_GROWTH_AFTER_10,
	COST_GROWTH_AFTER_30 = COST_GROWTH_AFTER_30,
	GOLD_GROWTH_AFTER_10 = GOLD_GROWTH_AFTER_10,
	LOOK_THRESHOLDS      = LOOK_THRESHOLDS,
	getLook              = getLook,

	RECYCLE_RETURN      = RECYCLE_RETURN,
	RECYCLE_BASE_VALUE  = RECYCLE_BASE_VALUE,
	RECYCLE_LEVEL_BONUS = RECYCLE_LEVEL_BONUS,

	FUSION_STAT_BONUS = FUSION_STAT_BONUS,

	RANK_TIERS = RANK_TIERS,

	clampBuildingLevel    = clampBuildingLevel,
	roundSignificant      = roundSignificant,
	getRebirthCost        = getRebirthCost,
	getRebirthMult        = getRebirthMult,
	getAscensionEggReward = getAscensionEggReward,
	getHoneyXp            = getHoneyXp,
	getFusionStatBonus    = getFusionStatBonus,
	getBaerchiBaseValue   = getBaerchiBaseValue,
	getRankForPoints      = getRankForPoints,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX9"><Properties>
<string name="Name">EggConfig</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- EggConfig.luau
-- ReplicatedStorage/Config/EggConfig.luau
--
-- Egg-Typen mit Hatch-Wahrscheinlichkeiten.
-- Getrennt von BaerchiConfig: Egg-Balance != Baerchi-Balance.
-- GachaRoller liest die HatchTable.
--
-- Seit v12 (Ei-Baum Block A) gibt es weder Brutzeiten noch Kaufpreise: ein
-- Ei im Lager wird per Klick sofort geoeffnet, und kein Ei ist im Menue
-- kaufbar. Einzige Ausnahme ist das Basis-Ei beim versteckten Haendler
-- (MERCHANT ganz unten).
--
-- Seit v10 steht hier ausserdem alles, was das EI-LEGEN steuert (Abschnitt
-- ganz unten). Bewusst hier und nicht in einer eigenen Datei: es ist
-- dieselbe Domaene — welche Eier es gibt, woher sie kommen und was aus ihnen
-- schluepft. Was der EINZELNE Baerchi legt (Tempo und Chancen), gehoert
-- dagegen zu ihm und steht in BaerchiConfig.

local Types         = require(script.Parent.Parent.Network.Types)
-- v14: die hatchTables werden aus den Baerchis BERECHNET (Rarity + Pfad).
-- BaerchiConfig kennt EggConfig nicht, es gibt also keinen Ringschluss.
local BaerchiConfig = require(script.Parent.BaerchiConfig)
local FeatureFlags  = require(script.Parent.FeatureFlags)

-- Wahrscheinlichkeiten muessen pro Egg genau 1.0 ergeben.
-- Format: { configId = Gewichtung }  (wird von GachaRoller normalisiert)
export type HatchTable = { [string]: number }

export type EggDef = {
	id          : Types.EggType,
	displayName : string,
	-- v14: BERECHNET aus RARITY_DIST und den Pfaden der Baerchis (siehe
	-- buildHatchTables). In der Tabelle unten steht deshalb nur {}.
	hatchTable  : HatchTable,
	path        : Types.PathId,    -- v14
	parent      : Types.EggType?,  -- v14: Vorgaenger im Baum
	tier        : number,          -- v14: Stufe (1 = Basis ... 11 = Omega), fuer Panel und Vergleiche
	-- Anzeige-Reihenfolge im Ei-Menue (aufsteigend). Ersetzt seit v12 die
	-- Sortierung nach Brutdauer, die es nicht mehr gibt.
	sortOrder   : number,
	description : string,

	-- Farbe des gelegten Eis in der Welt (MapService) und der Anzeige im UI.
	-- Steht hier statt im Client-Theme, weil Server und Client dieselbe Farbe
	-- brauchen — dieselbe Begruendung wie bei BaerchiConfig.RARITY_COLORS.
	color       : Color3,
	shortName   : string,   -- kurze Beschriftung ueber dem gelegten Ei

	-- v17: SONDER-EI ausserhalb des Baums (UFO-Jackpot). Hat keinen
	-- TREE-Eintrag, wird nie freigeschaltet, nie gelegt, nie gepresst und nie
	-- als "hoechstes Ei" oder Sprung-Ei gewaehlt. Man bekommt es nur direkt
	-- (Jackpot) und kann es wie jedes Ei aus dem Lager oeffnen.
	special     : boolean?,
}

--------------------------------------------------------------------------------
-- v14: DER EI-BAUM (Mega Egg Tree)
--------------------------------------------------------------------------------
--
-- STAMM        Basis ──► Zucker ─┬──────────────────────────────┐
--                                │                              │
-- GOLD-PFAD                      ▼                              │
--                             Golden ──► Platin ──► Sonnen ──► Zenit ─────┐
--                                │                                          │
-- KRISTALL-PFAD                  ▼                                          │
--                             Kristall ──► Prisma ──► Aurora ───────────────┤
--                                                                           │
-- VOID-PFAD            Zucker ──► Nebel ──► Void ──► Schatten ──► Abyss ────┤
--                                                                           │
-- KOSMOS-PFAD          (zwei der drei Endeier Zenit / Aurora / Abyss)       ▼
--                                           Komet ──► Nova ──► Galaxie
--
-- ASCENSIONS-PFAD (nur Rebirth)   Ascension ──► Transzendenz ──► Ewigkeit ──► Omega
--
-- Jedes Ei hat:
--   path        Pfad (Types.PathId)
--   parent      Vorgaenger im Baum (nil = Wurzel). Fuer Lege-Fallback und
--               Ei-Presse: "eine Stufe tiefer" ist immer der parent.
--   rarityDist  Rarity-Verteilung in Prozent (jede Zeile = 100). Daraus
--               wird die hatchTable BERECHNET (siehe buildHatchTables) —
--               von Hand gepflegt wird nur noch diese eine Zeile pro Ei.
--
-- Wie ein Knoten frei wird, steht in TREE weiter unten.

local RARITY_DIST: { [Types.EggType]: { [string]: number } } = {
	BasicEgg         = { Common = 70, Uncommon = 25, Rare = 5 },
	SugarEgg         = { Uncommon = 50, Rare = 38, Epic = 12 },
	GoldenEgg        = { Rare = 45, Epic = 45, Legendary = 10 },
	PlatinumEgg      = { Epic = 40, Legendary = 50, Mythic = 10 },
	SunEgg           = { Legendary = 60, Mythic = 33, Divine = 7 },
	ZenithEgg        = { Mythic = 70, Divine = 26, Cosmic = 4 },
	CrystalEgg       = { Epic = 55, Legendary = 40, Mythic = 5 },
	PrismEgg         = { Legendary = 65, Mythic = 30, Divine = 5 },
	AuroraEgg        = { Mythic = 72, Divine = 24, Cosmic = 4 },
	MistEgg          = { Epic = 65, Legendary = 35 },
	VoidEgg          = { Legendary = 60, Mythic = 36, Divine = 4 },
	ShadowEgg        = { Mythic = 65, Divine = 30, Cosmic = 5 },
	AbyssEgg         = { Divine = 70, Cosmic = 25, Secret = 5 },
	CometEgg         = { Divine = 55, Cosmic = 40, Secret = 5 },
	NovaEgg          = { Cosmic = 70, Secret = 27, Godly = 3 },
	GalaxyEgg        = { Secret = 75, Godly = 23, Eternal = 2 },
	AscensionEgg     = { Legendary = 85, Mythic = 15 },
	TranscendenceEgg = { Secret = 60, Godly = 38, Eternal = 2 },
	EternityEgg      = { Godly = 80, Eternal = 19, Omega = 1 },
	OmegaEgg         = { Eternal = 70, Omega = 30 },
	-- v17: UFO-Jackpot (Sonder-Ei). Breit gestreut von Epic bis Godly: fuer
	-- Fruehspieler ein Riesensprung, fuer Spaetspieler eine echte Chance auf
	-- ein Late-Game-Pet (Cosmic+ 8 %). Ø ~ Mythic. ANNAHME, eine Zeile.
	UfoJackpotEgg    = { Epic = 30, Legendary = 30, Mythic = 20, Divine = 12, Cosmic = 5, Secret = 2.5, Godly = 0.5 },
}

-- Gewicht eines Baerchis innerhalb seiner Rarity: 3, wenn sein Pfad zum
-- Pfad des Eis passt, sonst 1. Ascensions-Eier sind neutral (alle 1).
local PATH_MATCH_WEIGHT = 3

local EGGS: { [Types.EggType]: EggDef } = {

	-- ============================================================
	-- STAMM
	-- ============================================================
	BasicEgg = {
		id = "BasicEgg", displayName = "Basis-Ei", path = "Stamm", parent = nil, tier = 1, sortOrder = 1,
		description = "Ein ganz normales Ei. Was wird wohl raus kommen?",
		color = Color3.fromRGB(238, 232, 214), shortName = "Basis", hatchTable = {},
	},
	SugarEgg = {
		id = "SugarEgg", displayName = "Zucker-Ei", path = "Stamm", parent = "BasicEgg", tier = 2, sortOrder = 2,
		description = "Schmeckt suess. Der Inhalt auch.",
		color = Color3.fromRGB(255, 168, 205), shortName = "Zucker", hatchTable = {},
	},

	-- ============================================================
	-- GOLD-PFAD (stark)
	-- ============================================================
	GoldenEgg = {
		id = "GoldenEgg", displayName = "Goldenes Ei", path = "Gold", parent = "SugarEgg", tier = 3, sortOrder = 3,
		description = "Glitzert verdaechtig. Rare oder besser garantiert.",
		color = Color3.fromRGB(255, 205, 74), shortName = "Gold", hatchTable = {},
	},
	PlatinumEgg = {
		id = "PlatinumEgg", displayName = "Platin-Ei", path = "Gold", parent = "GoldenEgg", tier = 4, sortOrder = 4,
		description = "Schwer wie Blei, wertvoller als Gold.",
		color = Color3.fromRGB(214, 222, 232), shortName = "Platin", hatchTable = {},
	},
	SunEgg = {
		id = "SunEgg", displayName = "Sonnen-Ei", path = "Gold", parent = "PlatinumEgg", tier = 5, sortOrder = 5,
		description = "Warm in der Hand. Sehr warm.",
		color = Color3.fromRGB(255, 150, 40), shortName = "Sonne", hatchTable = {},
	},
	ZenithEgg = {
		id = "ZenithEgg", displayName = "Zenit-Ei", path = "Gold", parent = "SunEgg", tier = 6, sortOrder = 6,
		description = "Der hoechste Punkt des Gold-Pfads.",
		color = Color3.fromRGB(255, 236, 140), shortName = "Zenit", hatchTable = {},
	},

	-- ============================================================
	-- KRISTALL-PFAD (schnell)
	-- ============================================================
	CrystalEgg = {
		id = "CrystalEgg", displayName = "Kristall-Ei", path = "Kristall", parent = "GoldenEgg", tier = 4, sortOrder = 7,
		description = "Durchsichtig. Man sieht schon fast was drin ist.",
		color = Color3.fromRGB(150, 226, 255), shortName = "Kristall", hatchTable = {},
	},
	PrismEgg = {
		id = "PrismEgg", displayName = "Prisma-Ei", path = "Kristall", parent = "CrystalEgg", tier = 5, sortOrder = 8,
		description = "Bricht das Licht in sieben Farben.",
		color = Color3.fromRGB(190, 160, 255), shortName = "Prisma", hatchTable = {},
	},
	AuroraEgg = {
		id = "AuroraEgg", displayName = "Aurora-Ei", path = "Kristall", parent = "PrismEgg", tier = 6, sortOrder = 9,
		description = "Leuchtet wie der Himmel im Norden.",
		color = Color3.fromRGB(110, 255, 190), shortName = "Aurora", hatchTable = {},
	},

	-- ============================================================
	-- VOID-PFAD (selten)
	-- ============================================================
	MistEgg = {
		id = "MistEgg", displayName = "Nebel-Ei", path = "Void", parent = "SugarEgg", tier = 3, sortOrder = 10,
		description = "Fuehlt sich kalt und feucht an.",
		color = Color3.fromRGB(170, 175, 200), shortName = "Nebel", hatchTable = {},
	},
	VoidEgg = {
		id = "VoidEgg", displayName = "Void-Ei", path = "Void", parent = "MistEgg", tier = 4, sortOrder = 11,
		description = "Schwaerzer als schwarz.",
		color = Color3.fromRGB(70, 40, 110), shortName = "Void", hatchTable = {},
	},
	ShadowEgg = {
		id = "ShadowEgg", displayName = "Schatten-Ei", path = "Void", parent = "VoidEgg", tier = 5, sortOrder = 12,
		description = "Wirft keinen Schatten. Es IST einer.",
		color = Color3.fromRGB(45, 40, 60), shortName = "Schatten", hatchTable = {},
	},
	AbyssEgg = {
		id = "AbyssEgg", displayName = "Abyss-Ei", path = "Void", parent = "ShadowEgg", tier = 6, sortOrder = 13,
		description = "Ganz unten. Darunter kommt nichts mehr.",
		color = Color3.fromRGB(20, 30, 70), shortName = "Abyss", hatchTable = {},
	},

	-- ============================================================
	-- KOSMOS-PFAD (Allrounder)
	-- ============================================================
	CometEgg = {
		id = "CometEgg", displayName = "Kometen-Ei", path = "Kosmos", parent = nil, tier = 7, sortOrder = 14,
		description = "Zieht einen Schweif aus Funken hinter sich her.",
		color = Color3.fromRGB(120, 180, 255), shortName = "Komet", hatchTable = {},
	},
	NovaEgg = {
		id = "NovaEgg", displayName = "Nova-Ei", path = "Kosmos", parent = "CometEgg", tier = 8, sortOrder = 15,
		description = "Kurz vor dem Explodieren.",
		color = Color3.fromRGB(255, 240, 255), shortName = "Nova", hatchTable = {},
	},
	GalaxyEgg = {
		id = "GalaxyEgg", displayName = "Galaxie-Ei", path = "Kosmos", parent = "NovaEgg", tier = 9, sortOrder = 16,
		description = "Ein ganzes Universum in einer Schale.",
		color = Color3.fromRGB(110, 40, 180), shortName = "Galaxie", hatchTable = {},
	},

	-- ============================================================
	-- ASCENSIONS-PFAD (nur Rebirth)
	-- ============================================================
	AscensionEgg = {
		id = "AscensionEgg", displayName = "Ascensions-Ei", path = "Ascension", parent = nil, tier = 5, sortOrder = 17,
		description = "Verdient, nicht gekauft. Legendary garantiert.",
		color = Color3.fromRGB(196, 128, 255), shortName = "Ascension", hatchTable = {},
	},
	TranscendenceEgg = {
		id = "TranscendenceEgg", displayName = "Transzendenz-Ei", path = "Ascension", parent = "AscensionEgg", tier = 9, sortOrder = 18,
		description = "Jenseits von allem, was man kaufen kann.",
		color = Color3.fromRGB(255, 200, 255), shortName = "Transz.", hatchTable = {},
	},
	EternityEgg = {
		id = "EternityEgg", displayName = "Ewigkeits-Ei", path = "Ascension", parent = "TranscendenceEgg", tier = 10, sortOrder = 19,
		description = "Es war schon immer da. Es bleibt fuer immer.",
		color = Color3.fromRGB(255, 120, 40), shortName = "Ewigkeit", hatchTable = {},
	},
	OmegaEgg = {
		id = "OmegaEgg", displayName = "Omega-Ei", path = "Ascension", parent = "EternityEgg", tier = 11, sortOrder = 20,
		description = "Das letzte Ei. 30% Omega.",
		color = Color3.fromRGB(255, 255, 255), shortName = "Omega", hatchTable = {},
	},

	-- ============================================================
	-- SONDER-EIER (v17, nicht im Baum)
	-- ============================================================
	UfoJackpotEgg = {
		id = "UfoJackpotEgg", displayName = "UFO-Jackpot-Ei", path = "Event", parent = nil, tier = 0, sortOrder = 21,
		description = "Vom UFO abgeworfen. Ein ganz seltener Fund.",
		color = Color3.fromRGB(255, 214, 60), shortName = "Jackpot", hatchTable = {},
		special = true,
	},
}

--------------------------------------------------------------------------------
-- Freischaltung (TREE)
--------------------------------------------------------------------------------
--
-- Ein Knoten wird frei, wenn ALLE Bedingungen gelten:
--   hatch     Vorgaenger-Eier so oft GEOEFFNET (eggTree.hatched). Bei
--             `hatchAnyOf` reicht es, wenn `need` der Eintraege erfuellt sind
--             (Kometen-Ei: zwei der drei Endeier).
--   index     so viele VERSCHIEDENE Baerchis dieser Rarity entdeckt (Index)
--   rebirth   mindestens so viele Rebirths
--
-- Eine Blaupause ersetzt hatch und index, NICHT das Rebirth-Gate.
-- Einmal frei, bleibt ein Knoten frei (auch nach Rebirth).
--
-- Die Hatch-Zahlen sind mit tools/sim/egg_tree_sim.lua gegen die echten
-- Lege-Intervalle bestimmt (siehe Bericht MEGA_EGG_TREE_UMGESETZT): die
-- Platzhalter aus dem Konzept (15, 12, 10, 6 ...) waren so klein, dass der
-- ganze Baum ohne Rebirth-Gates in ~16 Spielstunden frei war — die Eier
-- haetten nie gebremst. Jetzt braucht das Ei-Sammeln etwa die Haelfte bis
-- zwei Drittel der Zeit bis zum jeweiligen Rebirth-Gate, beides zaehlt.

export type HatchReq = { egg: Types.EggType, count: number }
export type TreeNode = {
	hatch      : { HatchReq }?,
	hatchAnyOf : { need: number, of: { HatchReq } }?,
	index      : { rarity: Types.Rarity, count: number }?,
	rebirth    : number?,
	start      : boolean?,        -- von Anfang an frei
}

local TREE: { [Types.EggType]: TreeNode } = {
	BasicEgg    = { start = true },
	SugarEgg    = { start = true },

	GoldenEgg   = { hatch = { { egg = "SugarEgg",    count = 15 } }, index = { rarity = "Rare",      count = 1 } },
	PlatinumEgg = { hatch = { { egg = "GoldenEgg",   count = 25 } }, index = { rarity = "Epic",      count = 2 } },
	SunEgg      = { hatch = { { egg = "PlatinumEgg", count = 25 } }, index = { rarity = "Legendary", count = 2 }, rebirth = 3 },
	ZenithEgg   = { hatch = { { egg = "SunEgg",      count = 40 } }, index = { rarity = "Mythic",    count = 2 }, rebirth = 6 },

	CrystalEgg  = { hatch = { { egg = "GoldenEgg",   count = 20 } }, index = { rarity = "Legendary", count = 1 } },
	PrismEgg    = { hatch = { { egg = "CrystalEgg",  count = 30 } }, index = { rarity = "Legendary", count = 2 }, rebirth = 3 },
	AuroraEgg   = { hatch = { { egg = "PrismEgg",    count = 40 } }, index = { rarity = "Mythic",    count = 2 }, rebirth = 6 },

	MistEgg     = { hatch = { { egg = "SugarEgg",    count = 15 } }, index = { rarity = "Epic",      count = 1 } },
	VoidEgg     = { hatch = { { egg = "MistEgg",     count = 20 } }, index = { rarity = "Legendary", count = 1 }, rebirth = 2 },
	ShadowEgg   = { hatch = { { egg = "VoidEgg",     count = 40 } }, index = { rarity = "Mythic",    count = 2 }, rebirth = 6 },
	AbyssEgg    = { hatch = { { egg = "ShadowEgg",   count = 40 } }, index = { rarity = "Divine",    count = 2 }, rebirth = 8 },

	CometEgg    = {
		hatchAnyOf = { need = 2, of = {
			{ egg = "ZenithEgg", count = 30 },
			{ egg = "AuroraEgg", count = 30 },
			{ egg = "AbyssEgg",  count = 30 },
		} },
		index = { rarity = "Divine", count = 3 }, rebirth = 10,
	},
	NovaEgg     = { hatch = { { egg = "CometEgg", count = 120 } }, index = { rarity = "Cosmic", count = 3 }, rebirth = 15 },
	GalaxyEgg   = { hatch = { { egg = "NovaEgg",  count = 200 } }, index = { rarity = "Secret", count = 2 }, rebirth = 25 },

	AscensionEgg     = { rebirth = 1 },
	TranscendenceEgg = { rebirth = 15 },
	EternityEgg      = { rebirth = 30 },
	OmegaEgg         = { rebirth = 50 },
}

-- Kinder je Ei (fuer Panel und "naechste Stufe"). Kometen-Ei hat keinen
-- parent, haengt im Panel aber an allen drei Endeiern.
local CHILDREN: { [string]: { Types.EggType } } = {}

--------------------------------------------------------------------------------
-- hatchTables BERECHNEN
--------------------------------------------------------------------------------

local function buildHatchTables()
	-- Baerchis je Rarity, deterministisch sortiert.
	local byRarity: { [string]: { any } } = {}
	for id, def in BaerchiConfig.data do
		byRarity[def.rarity] = byRarity[def.rarity] or {}
		table.insert(byRarity[def.rarity], def)
	end
	for _, list in byRarity do
		table.sort(list, function(a, b) return a.id < b.id end)
	end

	for eggId, egg in EGGS do
		local dist = RARITY_DIST[eggId]
		local hatch: HatchTable = {}
		for rarity, percent in dist do
			local pets = byRarity[rarity]
			assert(pets and #pets > 0, "EggConfig: keine Baerchis der Rarity " .. rarity .. " fuer " .. eggId)
			local total = 0
			local weights = {}
			for _, def in pets do
				local w = 1
				if egg.path ~= "Ascension" and def.path == egg.path then
					w = PATH_MATCH_WEIGHT
				end
				weights[def.id] = w
				total += w
			end
			for id, w in weights do
				hatch[id] = (hatch[id] or 0) + percent * w / total
			end
		end
		egg.hatchTable = hatch
	end

	-- eggSource der Baerchis nachtragen (frueher von Hand gepflegt).
	for _, def in BaerchiConfig.data do
		table.clear(def.eggSource)
	end
	local eggIds = {}
	for eggId in EGGS do table.insert(eggIds, eggId) end
	table.sort(eggIds, function(a, b) return EGGS[a].sortOrder < EGGS[b].sortOrder end)
	for _, eggId in eggIds do
		for configId in EGGS[eggId].hatchTable do
			local def = BaerchiConfig.data[configId]
			if def then table.insert(def.eggSource, eggId) end
		end
	end

	for eggId, egg in EGGS do
		if egg.parent then
			CHILDREN[egg.parent] = CHILDREN[egg.parent] or {}
			table.insert(CHILDREN[egg.parent], eggId)
		end
	end
	for _, list in CHILDREN do
		table.sort(list, function(a, b) return EGGS[a].sortOrder < EGGS[b].sortOrder end)
	end
end

buildHatchTables()

-- Alle Ei-IDs des BAUMS in Anzeige-Reihenfolge (ohne Sonder-Eier: Baum,
-- Freischaltung, Sprung-Ei und Panel kennen nur diese).
local function getOrderedIds(): { Types.EggType }
	local ids: { Types.EggType } = {}
	for eggId, egg in EGGS do
		if not egg.special then table.insert(ids, eggId) end
	end
	table.sort(ids, function(a, b) return EGGS[a].sortOrder < EGGS[b].sortOrder end)
	return ids
end

local function getChildren(eggType: Types.EggType): { Types.EggType }
	return CHILDREN[eggType] or {}
end

-- Die "naechste Stufe" eines Eis im SELBEN Pfad (Ei-Presse, Lege-Aufstieg).
-- Golden hat zwei Kinder (Platin im eigenen Pfad, Kristall im naechsten):
-- bevorzugt wird das Kind im eigenen Pfad. Fuer Stamm-Eier (Zucker) und
-- Endeier gibt es mehrere bzw. keine — dann entscheidet `preferPath`
-- bzw. es gibt nil.
local function getNextInPath(eggType: Types.EggType, preferPath: string?): Types.EggType?
	local egg = EGGS[eggType]
	if not egg then return nil end
	local kids = CHILDREN[eggType]
	if not kids or #kids == 0 then return nil end
	local want = preferPath or egg.path
	for _, kid in kids do
		if EGGS[kid].path == want then return kid end
	end
	-- Zucker-Ei ohne Wunsch-Pfad: zwei Wege (Gold oder Void), keiner ist "der"
	-- naechste. Der Aufrufer muss einen Pfad angeben.
	return nil
end

--------------------------------------------------------------------------------
-- Ei-Presse (v14)
--------------------------------------------------------------------------------
-- 5 gleiche Eier werden zu 1 Ei der naechsten Stufe im selben Pfad gepresst.
-- Nur, wenn das Ziel-Ei schon freigeschaltet ist, und nie im Ascensions-Pfad
-- (dessen Eier gibt es nur ueber Rebirth-Meilensteine). Beim Zucker-Ei
-- waehlt der Spieler, ob Gold- oder Void-Pfad.
local PRESS = {
	cost          = 5,
	blockedPaths  = { Ascension = true, Event = true },
	-- Playtest 05.10. (Schalter PRESS_NO_BASIC_EGG): Basis-Eier gibt es beim
	-- Haendler unbegrenzt fuer Gummies. Waeren sie pressbar, liesse sich jedes
	-- Gummi-Polster ueber die Presse in immer bessere Eier tauschen.
	blockedEggs   = { BasicEgg = true } :: { [string]: boolean },
}

-- Darf `eggType` gepresst werden? Einzige Regel fuer Server (EggTreeService)
-- und Anzeige (EggTreePanel).
local function canPress(eggType: Types.EggType): boolean
	local egg = EGGS[eggType]
	if not egg or PRESS.blockedPaths[egg.path] then return false end
	if PRESS.blockedEggs[eggType] and FeatureFlags.isOn("PRESS_NO_BASIC_EGG") then return false end
	return true
end

-- Hilfsfunktion: Hatch-Table als normalisierte Gewichtungs-Liste
-- GachaRoller benutzt dies direkt
local function getNormalizedTable(eggType: Types.EggType): { configId: string, weight: number }
	local def = EGGS[eggType]
	assert(def, "EggConfig: unbekannter EggType " .. eggType)

	local total = 0
	for _, w in def.hatchTable do total += w end

	local result = {}
	for id, w in def.hatchTable do
		table.insert(result, { configId = id, weight = w / total })
	end
	return result
end

--------------------------------------------------------------------------------
-- EIER LEGEN
--------------------------------------------------------------------------------
--
-- Der ausgeruestete Baerchi legt regelmaessig ein Ei dort ab, wo er gerade
-- steht. Es bleibt als anklickbares Objekt in der Welt liegen, bis der Spieler
-- es einsammelt — dann landet es in island.eggStock und laesst sich wie ein
-- gekauftes Ei ausbrueten.
--
-- Die Zahlen HIER gelten fuer alle Baerchis. Was ein EINZELNER legt und wie
-- schnell, steht bei ihm in BaerchiConfig (layIntervalSeconds / eggTable).
--
-- ============================================================
-- WARUM DAS LEVEL HIER LINEAR WIRKT UND NICHT EXPONENTIELL
-- ============================================================
-- HP und ATK wachsen mit 1.1^(level-1), auf Level 50 also auf das 106-fache.
-- Das ist dort richtig, weil die PIT-Gegner mit derselben Kurve mitwachsen —
-- es gibt eine Gegenseite.
--
-- Beim Ei-Legen gibt es die nicht. Dieselbe Kurve wuerde bedeuten: ein
-- Level-50-Baerchi legt 106-mal so schnell, also alle zwei bis neun Sekunden.
-- Der individuelle Grundwert jedes Baerchis waere damit bedeutungslos, und die
-- Obergrenze unten waere binnen einer Minute erreicht — die ganze Mechanik
-- liefe leer.
--
-- Deshalb addiert jedes Level hier 10% des GRUNDWERTS statt 10% des Vorwerts:
-- auf Level 50 legt ein Baerchi knapp 6-mal so schnell wie auf Level 1. Das
-- ist spuerbar, laesst die Unterschiede zwischen den Baerchis aber bestehen.
--
-- Wer das doch exponentiell haben will: LAY_LEVEL_GAIN durch
-- CombatCalculator.getLevelGrowth ersetzen — es ist genau eine Zeile in
-- EggCalculator.
local LAY_LEVEL_GAIN = 0.10

-- Was eine EGG-Stat-Stufe bringt (waechst ueber Event-Teilnahme, gedeckelt
-- durch die Rarity — siehe PromotionConfig). Ein Legendary am Cap (24) legt
-- damit knapp dreimal so schnell.
--
-- Die Zahl steht bewusst NICHT in PromotionConfig.STAT_LEVEL_GAIN wie die
-- vier Kampf-Stats: die wirken alle in CombatCalculator, diese hier wirkt
-- ausschliesslich im Ei-System. Sie neben den Kampfwerten abzulegen waere die
-- naechste Stelle, an der jemand beim Balancing am falschen Wert dreht.
local LAY_STAT_LEVEL_GAIN = 0.08

-- Wie viel langsamer offline gelegt wird.
--
-- Die Produktion laeuft weiter, waehrend der Spieler weg ist (dasselbe
-- Zeitstempel-Verfahren wie beim Honig, kein Server-Loop noetig) — aber
-- gebremst. Anwesenheit soll sich lohnen, ohne dass Abwesenheit bestraft wird.
local OFFLINE_SLOWDOWN = 2.5

-- Wie viele NICHT eingesammelte Eier gleichzeitig herumliegen duerfen.
--
-- Ist die Grenze erreicht, hoert der Baerchi auf zu legen — genau wie ein
-- volles Honig-Lager die Produktion anhaelt. Laenger wegbleiben bringt also
-- nichts zusaetzlich, und der Plot wird nie zum Ei-Teppich.
local MAX_UNCOLLECTED_EGGS = 12

-- Absolute Untergrenze, egal wie viel Level, Stufen und Charms
-- zusammenkommen. Reines Sicherheitsnetz gegen eine Kombination, an die beim
-- Balancing niemand gedacht hat — kein Balancing-Wert.
local MIN_LAY_INTERVAL_SECONDS = 15

-- Wie weit ein gelegtes Ei seitlich neben dem Baerchi landet (Studs). Ohne
-- diesen Versatz laegen mehrere Eier exakt uebereinander, wenn der Baerchi
-- laenger an derselben Stelle steht.
local LAY_SCATTER_RADIUS = 4.5

-- Groesse des Eis in der Welt. Bewusst klein: es sollen bis zu zwoelf davon
-- auf einem Plot liegen koennen, ohne dass man den Baerchi nicht mehr sieht.
local LAY_EGG_SIZE = Vector3.new(1.7, 2.3, 1.7)

-- Ab welcher Entfernung die Beschriftung ueber einem Ei ausgeblendet wird.
local LAY_LABEL_DISTANCE = 60

-- Gewichtete Ei-Auswahl fuer einen Baerchi.
--
-- `eggTable` kommt aus BaerchiConfig und ist pro Baerchi verschieden. Die
-- Gewichte muessen sich zu nichts Bestimmtem addieren — hier wird normalisiert,
-- damit man in der Config mit runden Zahlen arbeiten kann.
--
-- Gibt nil zurueck, wenn die Tabelle leer oder unbrauchbar ist. Der Aufrufer
-- legt dann kein Ei, statt eines zu erfinden.
local function rollEggType(eggTable: { { eggType: Types.EggType, weight: number } }): Types.EggType?
	local total = 0
	for _, entry in eggTable do
		if entry.weight > 0 then
			total += entry.weight
		end
	end

	if total <= 0 then
		return nil
	end

	local roll        = math.random() * total
	local accumulated = 0

	for _, entry in eggTable do
		if entry.weight > 0 then
			accumulated += entry.weight
			if roll < accumulated then
				return entry.eggType
			end
		end
	end

	-- Rundungsrest: der letzte gueltige Eintrag.
	for i = #eggTable, 1, -1 do
		if eggTable[i].weight > 0 then
			return eggTable[i].eggType
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- VERSTECKTER BASIS-EI-HAENDLER (v12)
--------------------------------------------------------------------------------
--
-- Die einzige Kaufmoeglichkeit fuer ein Ei im ganzen Spiel. Bewusst ohne
-- Marker, ohne Menue-Eintrag und ohne HUD-Hinweis: die meisten Spieler
-- brauchen ihn nie, weil ihr ausgeruesteter Baerchi Eier legt und nie
-- verwertet werden kann. Er ist ein Notanker, kein Laden.
--
-- Lage: am Rand der Hauptinsel, genau zwischen zwei Plot-Stegen (die Stege
-- liegen bei 0, 45, 90 ... Grad, der Haendler bei 157,5 Grad, also mittig
-- dazwischen). Dort laeuft niemand auf dem Weg zum eigenen Plot vorbei.
-- ANNAHME: der genaue Ort war offen (EI_BAUM_KONZEPT, Abschnitt 12), das ist
-- mein Vorschlag und laesst sich hier mit zwei Zahlen verschieben.
local MERCHANT = {
	eggType          = "BasicEgg" :: Types.EggType,
	priceGummies     = 50,      -- heutiger Basis-Preis, anpassbar
	angleDegrees     = 157.5,   -- Winkel um die Weltmitte (siehe oben)
	radius           = 108,     -- Abstand zur Weltmitte, knapp vor der Sandkante (Inselradius 120)
	promptDistance   = 8,       -- ab hier erscheint "E" am Stand
	-- Der Server prueft die Entfernung zusaetzlich selbst: ein Kauf von weiter
	-- weg wird abgelehnt, egal was der Client behauptet. Etwas groesser als
	-- promptDistance, damit Latenz keinen ehrlichen Kauf scheitern laesst.
	maxBuyDistance   = 14,
}

-- HBB Paket 5 (MAP_V2_MERCHANT): sichtbarer Standort des Haendlers. Auf dem
-- Ring zwischen Event-Pit-Zaun (Radius 50) und Bestenlisten-Tafel (Radius 80,
-- 22,5 Grad), mittig zwischen zwei Stegen (alle 45 Grad, Luecke +-9 Grad):
-- jeder, der zum Event laeuft, kommt daran vorbei. Abstand zur Tafel ca. 59
-- Studs, zum Pit-Zaun ca. 16 Studs. Mit dem Flag aus gilt MERCHANT oben.
-- Das Schild ueber dem Stand zeigt nur ein Ei (Bild, kein Text).
local MERCHANT_V2 = {
	angleDegrees = 67.5,
	radius       = 66,
	signImage    = "rbxassetid://136964848925363",   -- dasselbe Ei wie UI/Icons.egg
	signHeight   = 9,
	signSize     = 5,     -- Studs
}

return {
	data               = EGGS,
	MERCHANT           = MERCHANT,
	MERCHANT_V2        = MERCHANT_V2,
	getNormalizedTable = getNormalizedTable,

	-- v14: Ei-Baum
	RARITY_DIST        = RARITY_DIST,
	PATH_MATCH_WEIGHT  = PATH_MATCH_WEIGHT,
	TREE               = TREE,
	PRESS              = PRESS,
	canPress           = canPress,
	getOrderedIds      = getOrderedIds,
	getChildren        = getChildren,
	getNextInPath      = getNextInPath,
	isSpecial          = function(eggType: Types.EggType): boolean
		local egg = EGGS[eggType]
		return egg ~= nil and egg.special == true
	end,

	LAY_LEVEL_GAIN           = LAY_LEVEL_GAIN,
	LAY_STAT_LEVEL_GAIN      = LAY_STAT_LEVEL_GAIN,
	OFFLINE_SLOWDOWN         = OFFLINE_SLOWDOWN,
	MAX_UNCOLLECTED_EGGS     = MAX_UNCOLLECTED_EGGS,
	MIN_LAY_INTERVAL_SECONDS = MIN_LAY_INTERVAL_SECONDS,
	LAY_SCATTER_RADIUS       = LAY_SCATTER_RADIUS,
	LAY_EGG_SIZE             = LAY_EGG_SIZE,
	LAY_LABEL_DISTANCE       = LAY_LABEL_DISTANCE,

	rollEggType = rollEggType,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX10"><Properties>
<string name="Name">EventConfig</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- EventConfig.luau
-- ReplicatedStorage/Config/EventConfig.luau
--
-- Der Event-Zyklus (Stand 2026-10-04, siehe Projekt-Docs
-- EVENT_UND_RARITY_IDEEN_2026-10-02 und README_EVENTS_GEBAEUDE_TOWER_PLAN):
-- SECHS Events im festen Wechsel, das Boss-Event nur in jedem zweiten
-- Durchlauf (everyNthCycle). Ein Durchlauf ohne Boss dauert ~41 min, mit ~46.
--
--   UFO             Flaggschiff, 4 Min. Patrouilliert ueber dem Pit, der Beam
--                   wandert mit; Entfuehrung = +1 auf ALLE Stats und
--                   Rarity-Up-Chance. Alle 30 s ein Ei-Abwurf (1 % Jackpot).
--   Hot Egg         Heisses Ei wird weitergegeben -> Gutes Ei. Waben werden
--                   zu Lava (x3), alle ~30 s ein Vulkan-Ausbruch.
--   Mutations-Sturm Blitze mutieren Baerchis, Chance sinkt mit Rarity -> Mutation
--   Koenigshuegel   Wer am laengsten oben steht -> Gutes Ei
--   Schatzgraeber   Baerchis graben, Bomben schicken sie heim -> Gutes Ei
--   Wespenkoenigin  Boss-Kampf fuer alle (jeder zweite Durchlauf): Baerchis
--                   kaempfen, Spieler weichen Telegraphen aus. Belohnung nach
--                   Schadensanteil.
--
-- EventService faehrt nur die Uhr, EventParticipationService teilt aus und
-- startet die Event-Handler (Services/EventHandlers/*). WAS es gibt und alle
-- Zahlen stehen ausschliesslich hier.
--
-- Der alte 10-Events-Katalog steht im Projekt-Doc EVENT_KATALOG_2026-09-16.

local Types           = require(script.Parent.Parent.Network.Types)
local EggConfig       = require(script.Parent.EggConfig)
local PromotionConfig = require(script.Parent.PromotionConfig)

--------------------------------------------------------------------------------
-- Typen
--------------------------------------------------------------------------------

--   kind = "honey"        amount  = Honig je Gebaeude (aufs Lager gedeckelt)
--   kind = "eggs"         amount  = Anzahl, eggType = welche Sorte
--   kind = "gummies"      amount  = Basisbetrag, wird mit rebirthMult vergeben
--   kind = "goldGummies"  amount  = Betrag (kein Multiplikator)
--   kind = "mutation"     chance  = Basis-Wahrscheinlichkeit auf EINEN Mutations-Wurf
--                         (wird mit MUTATION_RARITY_FACTOR[rarity] multipliziert)
--
-- v14 (Ei-Baum, WP10): bei kind = "eggs" darf statt einer festen Sorte
--   eggPick = "highest"   das hoechste freie Ei des Spielers (ohne Ascension)
--   eggPick = "jump"      ein SPRUNG-EI: eine Stufe ueber dem hoechsten freien
--                         Ei eines Pfads. Laesst sich oeffnen, schaltet den
--                         Knoten aber nicht frei. Gibt es keins (alles frei),
--                         wird es zu "highest".
-- stehen, und blueprintChance gibt eine Chance auf eine Blaupause dazu.
export type EventBonus = {
	kind    : "honey" | "eggs" | "gummies" | "goldGummies" | "mutation",
	amount  : number?,
	eggType : Types.EggType?,
	eggPick : ("highest" | "jump")?,
	blueprintChance : number?,
	chance  : number?,
}

-- v14: NOTFALL-EI. Bei jeder Ei-Belohnung eines Events gibt es mit dieser
-- Chance ZUSAETZLICH ein Basis-Ei. Das Konzept sah "statt" vor — zusaetzlich
-- erfuellt denselben Zweck (Notanker fuer das Basis-Ei), ohne dass ein
-- Spieler sein gutes Ei verliert. ANNAHME, eine Zeile hier.
local EMERGENCY_BASIC_EGG_CHANCE = 0.05

export type EventDef = {
	id          : string,
	displayName : string,

	floorColor  : Color3,
	fenceColor  : Color3,
	ringColor   : Color3,
	bannerColor : Color3,

	-- "bounce" | "lean" | "spin": rein kosmetisch (Idle-Bewegung am Event).
	action      : "bounce" | "lean" | "spin",
	actionText  : string,

	-- Dauer DIESES Events in Sekunden (individuell je Event).
	durationSeconds : number,

	-- Welcher Handler (Services/EventHandlers/<handler>) das Event steuert.
	handler     : string,

	-- true NUR beim UFO: Stat-Stufen + Rarity-Up. Alle anderen Events geben
	-- keine Stat-Stufe.
	statGain    : boolean,

	-- Legacy-Feld (frueher Stat-Fokus je Event). Bleibt nil.
	statFocus   : string?,

	-- Zusatz-Ertrag ("gutes Ei" bzw. Mutations-Wurf), oder nil.
	bonus       : EventBonus?,

	-- Ein Satz fuer Tafel/UI. Hat Vorrang vor der automatisch gebauten Zeile.
	rewardText  : string?,

	-- Laeuft nur in jedem n-ten Durchlauf des Zyklus (nil = jeder). Der Zyklus
	-- zaehlt ab 1; mit 2 kommt das Event im 2., 4., 6. ... Durchlauf.
	everyNthCycle : number?,
}

--------------------------------------------------------------------------------
-- Zeiten
--------------------------------------------------------------------------------

-- Standard-Dauer, falls ein Event keine eigene hat (und fuer Debug-Ausgaben).
local EVENT_DURATION_SECONDS = 180
local EVENT_GAP_SECONDS      = 300
-- HBB Paket 6: Pause vor dem ERSTEN Event eines frisch gestarteten Servers.
-- Kuerzer, damit die ersten Spieler eines neuen Servers nicht fuenf Minuten
-- auf das erste Event warten. Alle spaeteren Pausen und die Boss-Haeufigkeit
-- (everyNthCycle) bleiben unveraendert. Gilt nur mit FeatureFlags.EVENT_V2_TIMER.
local FIRST_GAP_SECONDS      = 75

--------------------------------------------------------------------------------
-- UFO-Event
--------------------------------------------------------------------------------

local UFO = {
	-- So viele Sekunden Beam-Fortschritt braucht ein Baerchi zur Entfuehrung.
	-- Der Fortschritt muss nicht am Stueck laufen (Kaempfe pausieren ihn nur).
	-- 20 statt 30: der Ring wandert, der Baerchi verliert beim Nachlaufen Zeit.
	BEAM_REQUIRED_SECONDS = 20,

	-- PATROUILLE: Lissajous-Bahn ueber dem Pit (Studs, Sekunden), reine
	-- Funktion der Serverzeit (Modules/EventMotion). Halbachsen so, dass der
	-- Beam-Ring immer im Pit bleibt (Pit-Radius 50, Ring 11); schnellster
	-- Punkt ~2,5 Studs/s, ein Baerchi laeuft am Event 26.
	PATROL_RADIUS_X = 24,
	PATROL_RADIUS_Z = 18,
	PATROL_PERIOD_X = 90,
	PATROL_PERIOD_Z = 60,
	-- Ein Baerchi im Beam laeuft nach, sobald er weiter als dieser Anteil des
	-- Ring-Radius von der Ring-Mitte steht; Ziel ist die Ring-Mitte so viele
	-- Sekunden voraus.
	FOLLOW_SHARE      = 0.55,
	FOLLOW_LEAD_SECONDS = 1.5,

	-- EI-ABWURF: alle DROP_INTERVAL_SECONDS (erster nach DROP_FIRST_SECONDS,
	-- 8 pro Event). DROP_TELEGRAPH_SECONDS vorher erscheint der Landekreis an
	-- der vorhergesagten UFO-Position. Aufheben: Spieler-CHARAKTER innerhalb
	-- DROP_PICKUP_RADIUS, erster gewinnt (Server prueft im Takt).
	DROP_FIRST_SECONDS      = 15,
	DROP_INTERVAL_SECONDS   = 30,
	DROP_TELEGRAPH_SECONDS  = 3,
	DROP_PICKUP_RADIUS      = 5,
	DROP_PICKUP_MAX_HEIGHT  = 8,
	DROP_CHECK_SECONDS      = 0.1,
	DROP_EGG                = "BasicEgg" :: Types.EggType,

	-- JACKPOT: goldene Kiste mit dem UFO-Jackpot-Ei. Pity: spaetestens der
	-- JACKPOT_PITY_DROPS-te Abwurf (serverweit, Laufzeit-Zaehler, wird nach
	-- jedem Jackpot zurueckgesetzt).
	JACKPOT_CHANCE     = 0.01,
	JACKPOT_PITY_DROPS = 100,
	JACKPOT_EGG        = "UfoJackpotEgg" :: Types.EggType,

	-- War so lange KEIN Baerchi im Beam (oder kommt einer zu spaet), schliesst
	-- das UFO den Beam und setzt ihn zurueck: alle Countdowns beginnen neu.
	BEAM_IDLE_TIMEOUT_SECONDS = 75,

	-- Fixe Kampfdauer, wenn sich ein Baerchi im Beam und ein anderer beruehren.
	-- Waehrenddessen pausiert der Beam-Fortschritt.
	FIGHT_SECONDS = 3,

	-- Nach der Entfuehrung: Wartezeit, bevor das Baerchi wieder aufs Plot gesetzt wird.
	ABDUCT_WAIT_SECONDS = 10,

	-- Beim Absetzen: +1 auf jeden dieser Stats (begrenzt durch STAT_CAP).
	STAT_GAIN_PER_STAT = 1,

	-- Radius des Beam-Rings (Anteil des Podest-Radius) und Beruehrungsabstand.
	BEAM_RADIUS_FACTOR = 0.22,
	TOUCH_DISTANCE     = 5,

	-- Takt der Beam-Pruefung. Der Fortschritt waechst je Takt um genau diesen
	-- Wert, die Summe pro Sekunde bleibt also gleich; der Takt bestimmt nur,
	-- wie fein Beruehrungen und Beam-Grenze erkannt werden.
	TICK_SECONDS = 0.25,

	-- Der Verlierer eines Kampfs laeuft zurueck und darf so lange nicht
	-- wieder zum Beam.
	LOSER_COOLDOWN_SECONDS = 4,

	-- Dasselbe Paar kaempft fruehestens nach FIGHT_SECONDS + so vielen
	-- Sekunden erneut gegeneinander.
	PAIR_COOLDOWN_EXTRA_SECONDS = 6,

	-- Nach einem Beam-Reset bleibt der Beam so lange geschlossen.
	BEAM_REOPEN_SECONDS = 4,
}

-- Rarity-Up-Chance beim Absetzen des entfuehrten Baerchis. Aufstieg immer nur
-- EINE Stufe. Chance je AKTUELLER Rarity. Common->Uncommon 55 % und
-- Secret->Godly 0,5 % vom Projektinhaber, Rest Interpolation.
local RARITY_UP_CHANCE: { [string]: number } = {
	Common    = 0.55,
	Uncommon  = 0.40,
	Rare      = 0.28,
	Epic      = 0.18,
	Legendary = 0.11,
	Mythic    = 0.065,
	Divine    = 0.035,
	Cosmic    = 0.015,
	Secret    = 0.005,
	Godly     = 0.0025,
	Eternal   = 0.001,
	Omega     = 0,
}

--------------------------------------------------------------------------------
-- Mutations-Sturm
--------------------------------------------------------------------------------

-- Faktor auf die Mutationschance: je hoeher die Rarity, desto geringer.
local MUTATION_RARITY_FACTOR: { [string]: number } = {
	Common    = 1.00,
	Uncommon  = 0.80,
	Rare      = 0.60,
	Epic      = 0.40,
	Legendary = 0.25,
	Mythic    = 0.15,
	Divine    = 0.10,
	Cosmic    = 0.06,
	Secret    = 0.03,
	Godly     = 0.015,
	Eternal   = 0.008,
	Omega     = 0.004,
}

-- Duelle (UFO, Koenigshuegel): die Kampfkraft beider Seiten wird mit einem
-- Zufallsfaktor 1 ± POWER_SPREAD multipliziert. 0.2 = auch der Schwaechere
-- gewinnt manchmal, wenn der Abstand klein ist.
local DUEL = {
	POWER_SPREAD = 0.2,
}

local STORM = {
	-- Alle so viele Sekunden schlaegt ein Blitz in einen Teilnehmer ein (nur
	-- Optik); der Mutations-Wurf selbst faellt am Event-Ende.
	STRIKE_INTERVAL_SECONDS = 20,
}

--------------------------------------------------------------------------------
-- Hot Egg
--------------------------------------------------------------------------------

local HOT_EGG = {
	CHECK_INTERVAL_SECONDS = 0.5,
	-- Nach einer Weitergabe darf das Ei kurz nicht zurueck.
	PASS_COOLDOWN_SECONDS  = 2.0,
	TOUCH_DISTANCE         = 5,

	-- Wabenthema waehrend des Events (CombConfig.THEMES).
	COMB_THEME = "HotEgg",

	-- VULKAN-AUSBRUCH: alle ERUPTION_INTERVAL_SECONDS ein Warnring in der
	-- Mitte, ERUPTION_WARN_SECONDS spaeter fliegen ERUPTION_MIN..MAX
	-- Lava-Waben in alle Richtungen (landen als normale Waben im Slot-Modell).
	ERUPTION_INTERVAL_SECONDS = 30,
	ERUPTION_WARN_SECONDS     = 2,
	ERUPTION_MIN              = 8,
	ERUPTION_MAX              = 10,
}

--------------------------------------------------------------------------------
-- Koenigshuegel
--------------------------------------------------------------------------------

local KING = {
	-- Radius des Huegels (Anteil des Podest-Radius).
	HILL_RADIUS_FACTOR = 0.30,
	TICK_SECONDS       = 1,

	-- Zwei Baerchis auf dem Huegel, die sich so nahe kommen, kaempfen.
	TOUCH_DISTANCE = 6,
	-- Fixe Dauer eines Huegel-Duells.
	DUEL_SECONDS = 3,
	-- Der Verlierer muss runter und darf so lange nicht wieder hoch.
	LOSER_COOLDOWN_SECONDS = 6,
	-- Ein Herausforderer bleibt so weit vor dem Koenig stehen (innerhalb von
	-- TOUCH_DISTANCE, damit das Duell ausgeloest wird).
	CHALLENGE_DISTANCE = 4,
}

--------------------------------------------------------------------------------
-- Schatzgraeber
--------------------------------------------------------------------------------

local TREASURE = {
	-- Basis-Sekunden pro Fundstelle; hoeheres Level = schneller.
	BASE_DIG_SECONDS      = 14,
	DIG_SECONDS_PER_LEVEL = 0.15,
	MIN_DIG_SECONDS       = 6,
	-- Fundstellen je Spieler (hoeheres Level -> mehr).
	BASE_SITES            = 5,
	LEVEL_PER_EXTRA_SITE  = 10,
	MAX_SITES             = 9,
	-- Anteil der Fundstellen, in denen eine Bombe liegt.
	BOMB_SHARE            = 0.15,
	-- Fundstellen liegen in diesem Ring um die Event-Mitte (Anteil des
	-- Podest-Radius): nicht direkt in der Mitte und nicht am Zaun.
	SITE_MIN_RADIUS_FACTOR = 0.25,
	SITE_MAX_RADIUS_FACTOR = 0.80,
	-- Belohnung nach Funden (ueberlebt man bis Ende): hoechste passende Stufe.
	-- Bei Bombe geht ALLES verloren.
	-- v14: hoechstes freies Ei statt fest Golden/Kristall; ab 5 Funden ein
	-- Sprung-Ei mit 10% Chance auf eine Blaupause.
	REWARDS = {
		{ minFinds = 1, eggPick = "highest", amount = 1 },
		{ minFinds = 3, eggPick = "highest", amount = 2 },
		{ minFinds = 5, eggPick = "jump",    amount = 1, blueprintChance = 0.10 },
	},
}

--------------------------------------------------------------------------------
-- Wespenkoenigin (Boss-Event)
--------------------------------------------------------------------------------
-- Ablauf: ANNOUNCE_SECONDS Ankuendigung (Himmel dunkelt), dann Kampf bis zum
-- Sieg oder Event-Ende. Die Baerchis am Event kaempfen automatisch, ihr
-- Schaden kommt aus dem echten Kampfmodell (Modules/BossBalance ueber
-- CombatCalculator). Die Spieler weichen Telegraphen aus: ein Treffer stoesst
-- zurueck, bremst und setzt den Schaden des eigenen Baerchis kurz aus. Wer
-- mit seinem Charakter im Pit steht, feuert an (CHEER_FACTOR).

local WASP_QUEEN = {
	ANNOUNCE_SECONDS = 20,
	TICK_SECONDS     = 0.5,

	-- Ziel-Kampfdauer, aus der die HP berechnet werden:
	--   HP = Spieler x mittlere DPS x TARGET_FIGHT_SECONDS x HP_FACTOR
	-- (Spieler = Baerchis am Event beim Kampfbeginn). Wer spaeter dazukommt,
	-- erhoeht die HP um seine DPS x Restzeit bis zum Ziel (mind. LATE_JOIN_MIN_SECONDS).
	-- 135 statt 150: Treffer setzen Schaden aus, und Anfaenger weichen
	-- schlechter aus; mit 135 liegt der Kampf ueber alle Staerken bei
	-- ~125-170 s (tools/sim/boss_balance.lua).
	TARGET_FIGHT_SECONDS  = 135,
	HP_FACTOR             = 1.0,
	-- v15 (vorbereitet, AUS): Boss-HP-Faktor nach dem hoechsten Tower der
	-- Teilnehmer (Index 1-4 = I, II, III, Final). Standard ueberall 1 — erst
	-- nach dem Playtest einschalten (BossBalance.towerHpFactor).
	TOWER_HP_FACTOR       = { 1.0, 1.0, 1.0, 1.0 },
	MIN_HP                = 400,
	LATE_JOIN_MIN_SECONDS = 30,

	CHEER_FACTOR     = 1.25,
	HIT_STUN_SECONDS = 3,
	-- Treffer am Spieler: Rueckstoss (Studs/s) und Bremse (Anteil, Sekunden).
	KNOCKBACK_SPEED  = 70,
	SLOW_FACTOR      = 0.5,
	SLOW_SECONDS     = 2,

	-- Phase 2 ab diesem HP-Anteil: schnellere Attacken, Waben-Regen (Koenigsgelee).
	PHASE2_AT              = 0.5,
	PHASE1_ATTACK_INTERVAL = 6,
	PHASE2_ATTACK_INTERVAL = 4,
	TELEGRAPH_SECONDS      = 2,
	RAIN_THEME             = "WaspQueen",
	RAIN_INTERVAL_SECONDS  = 8,
	RAIN_COUNT             = 6,

	-- Attacken (Studs). Schockwelle: Ring um den Boden unter der Koenigin.
	-- Stachel-Salve: Kreise auf Spielerpositionen. Schwarm: Bahn quer durchs Pit.
	SHOCK_INNER        = 7,
	SHOCK_OUTER        = 17,
	STING_RADIUS       = 6,
	STING_COUNT        = 3,
	STING_COUNT_PHASE2 = 5,
	SWARM_WIDTH        = 9,

	-- Bewegung (Modules/EventMotion): Kreis ueber dem Pit.
	ORBIT_RADIUS        = 14,
	ORBIT_PERIOD        = 32,
	ORBIT_PERIOD_PHASE2 = 20,

	-- Belohnung nach Schadensanteil. Unter MIN_DAMAGE_SHARE gibt es nichts.
	-- Teilnahme: Gummies (mit Rebirth-Multiplikator) und Wabeneinheiten in den
	-- Recycler, je GUMMIES_BASE/COMB_UNITS_BASE mal Anteil x Teilnehmerzahl
	-- (ein Durchschnitts-Teilnehmer bekommt genau die Basis), begrenzt auf
	-- SHARE_FACTOR_MIN..MAX. Die besten TOP_RANKS bekommen ein Sprung-Ei und
	-- einen Rarity-Up-Wurf (RARITY_UP_FACTOR x EventConfig.RARITY_UP_CHANCE).
	-- Sieg: jeder bekommt sein hoechstes Ei, mit JACKPOT_CHANCE stattdessen das
	-- Jackpot-Ei. Niederlage: nur Teilnahme x DEFEAT_FACTOR.
	MIN_DAMAGE_SHARE  = 0.02,
	GUMMIES_BASE      = 300,
	COMB_UNITS_BASE   = 15,
	SHARE_FACTOR_MIN  = 0.5,
	SHARE_FACTOR_MAX  = 2.0,
	TOP_RANKS         = 3,
	RARITY_UP_FACTOR  = 0.5,
	JACKPOT_CHANCE    = 0.01,
	DEFEAT_FACTOR     = 0.5,
}

-- HBB Paket 7: Belohnungsstufen am Boss (Modules/BossTiers), ZUSAETZLICH zur
-- Belohnung nach Schadensanteil oben. Gilt nur mit FeatureFlags.BOSS_TIERS.
-- Schwellen relativ zum eigenen Potenzial (DPS x Zeit am Boss).
-- Belohnungen nur aus vorhandenen Bausteinen; Gummies sind Basisbetraege
-- (EconomyService wendet den Rebirth-Multiplikator an). Kumuliert: Stufe 3
-- hat zusammen zwei Basis-Eier, Stufe 4 dazu einen Mutations-Wurf.
local BOSS_TIERS = {
	T2 = 0.05,
	T3 = 0.25,
	T4 = 0.60,
	-- Aktivitaet: Charakter alle CHECK_SECONDS mehr als MOVE_STUDS bewegt
	-- (Player.Idled gibt es nur auf dem Client)
	ACTIVE_WINDOW_SECONDS = 60,
	ACTIVE_CHECK_SECONDS  = 2,
	ACTIVE_MOVE_STUDS     = 4,
	REWARDS = {
		[1] = { gummies = 40,  combUnits = 3, basicEggs = 0, mutationRoll = false },
		[2] = { gummies = 60,  combUnits = 4, basicEggs = 1, mutationRoll = false },
		[3] = { gummies = 80,  combUnits = 5, basicEggs = 2, mutationRoll = false },
		[4] = { gummies = 100, combUnits = 6, basicEggs = 2, mutationRoll = true },
	} :: { [number]: { gummies: number, combUnits: number, basicEggs: number, mutationRoll: boolean } },
	-- Wurf wie beim Mutations-Sturm (gleiche Chance, gleiche Rarity-Daempfung)
	MUTATION_CHANCE = 0.20,
}

--------------------------------------------------------------------------------
-- Der Katalog
--------------------------------------------------------------------------------

local EVENTS: { EventDef } = {

	-- ---------------------------------------------------------------- 1
	{
		id              = "Ufo",
		displayName     = "UFO",
		floorColor      = Color3.fromRGB( 18,  34,  64),
		fenceColor      = Color3.fromRGB( 90, 255, 160),
		ringColor       = Color3.fromRGB(120, 255, 190),
		bannerColor     = Color3.fromRGB(150, 255, 200),
		action          = "spin",
		actionText      = "wartet im Strahl des UFOs",
		durationSeconds = 240,
		handler         = "Ufo",
		statGain        = true,
		statFocus       = nil,
		bonus           = nil,
		rewardText      = "+1 auf alle Stats  •  Chance auf Rarity-Up",
	},

	-- ---------------------------------------------------------------- 2
	{
		id              = "HotEgg",
		displayName     = "Hot Egg",
		floorColor      = Color3.fromRGB(120,  30,  22),
		fenceColor      = Color3.fromRGB(255, 100,  40),
		ringColor       = Color3.fromRGB(255,  80,  40),
		bannerColor     = Color3.fromRGB(255, 140,  90),
		action          = "bounce",
		actionText      = "jongliert das heisse Ei",
		durationSeconds = 180,
		handler         = "HotEgg",
		statGain        = false,
		statFocus       = nil,
		bonus           = { kind = "eggs", eggPick = "highest", amount = 1 },
		rewardText      = "Wer das Ei am Ende haelt: 1x dein hoechstes Ei",
	},

	-- ---------------------------------------------------------------- 3
	{
		id              = "MutationsSturm",
		displayName     = "Mutations-Sturm",
		floorColor      = Color3.fromRGB( 90,  20,  90),
		fenceColor      = Color3.fromRGB(255,  60, 220),
		ringColor       = Color3.fromRGB(255, 100, 235),
		bannerColor     = Color3.fromRGB(255, 140, 240),
		action          = "spin",
		actionText      = "steht mitten im schimmernden Sturm",
		durationSeconds = 180,
		handler         = "MutationsSturm",
		statGain        = false,
		statFocus       = nil,
		bonus           = { kind = "mutation", chance = 0.20 },
		rewardText      = nil,
	},

	-- ---------------------------------------------------------------- 4
	{
		id              = "Koenigshuegel",
		displayName     = "Koenigshuegel",
		floorColor      = Color3.fromRGB( 60,  70,  30),
		fenceColor      = Color3.fromRGB(255, 215,  70),
		ringColor       = Color3.fromRGB(255, 225, 110),
		bannerColor     = Color3.fromRGB(255, 232, 140),
		action          = "bounce",
		actionText      = "kaempft um den Huegel",
		durationSeconds = 180,
		handler         = "Koenigshuegel",
		statGain        = false,
		statFocus       = nil,
		bonus           = { kind = "eggs", eggPick = "jump", amount = 1, blueprintChance = 0.10 },
		rewardText      = "Wer am laengsten oben steht: 1 Sprung-Ei  •  Chance auf Blaupause",
	},

	-- ---------------------------------------------------------------- 5
	{
		id              = "Schatzgraeber",
		displayName     = "Schatzgraeber",
		floorColor      = Color3.fromRGB(110,  78,  40),
		fenceColor      = Color3.fromRGB(230, 180, 100),
		ringColor       = Color3.fromRGB(240, 200, 120),
		bannerColor     = Color3.fromRGB(245, 215, 150),
		action          = "lean",
		actionText      = "graebt nach Schaetzen",
		durationSeconds = 180,
		handler         = "Schatzgraeber",
		statGain        = false,
		statFocus       = nil,
		bonus           = nil,
		rewardText      = "Eier je nach Funden  •  Vorsicht, Bomben!",
	},

	-- ---------------------------------------------------------------- 6
	{
		id              = "WaspQueen",
		displayName     = "Wespenkoenigin",
		floorColor      = Color3.fromRGB( 60,  44,  20),
		fenceColor      = Color3.fromRGB(255, 200,  40),
		ringColor       = Color3.fromRGB(255, 170,  30),
		bannerColor     = Color3.fromRGB(255, 210,  90),
		action          = "bounce",
		actionText      = "kaempft gegen die Wespenkoenigin",
		durationSeconds = 240,
		handler         = "WaspQueen",
		statGain        = false,
		statFocus       = nil,
		bonus           = { kind = "eggs", eggPick = "highest", amount = 1 },
		rewardText      = "Boss! Belohnung nach Schaden  •  Sieg: dein hoechstes Ei (1 % Jackpot)",
		everyNthCycle   = 2,
	},
}

--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

local function getById(id: string): EventDef?
	for _, def in EVENTS do
		if def.id == id then
			return def
		end
	end
	return nil
end

-- Laeuft dieses Event im Durchlauf `cycle` (ab 1 gezaehlt)?
local function isScheduledInCycle(def: EventDef, cycle: number): boolean
	local n = def.everyNthCycle
	if not n or n <= 1 then return true end
	return cycle % n == 0
end

local function getDuration(def: EventDef): number
	return def.durationSeconds or EVENT_DURATION_SECONDS
end

-- HBB Paket 6: Sekunden, bis Event `targetId` das naechste Mal STARTET
-- (0 = laeuft gerade). Rein, nach demselben Ablauf wie EventService:
-- Event -> Pause (EVENT_GAP_SECONDS) -> naechstes geplantes Event.
--   activeId  laufendes Event oder nil (Pause)
--   remaining Restsekunden der aktuellen Phase
--   nextIndex/nextCycle  Stand von EventService (_nextIndex, _nextCycle)
-- nil, wenn das Event im Zyklus nie vorkommt.
local function secondsUntilStart(targetId: string, activeId: string?, remaining: number,
	nextIndex: number, nextCycle: number): number?
	if activeId == targetId then return 0 end
	local t = math.max(0, remaining)
	if activeId then
		t += EVENT_GAP_SECONDS   -- erst endet das laufende Event, dann Pause
	end

	local index, cycle = nextIndex, nextCycle
	local count = #EVENTS
	for _ = 1, count * 8 do
		local def = EVENTS[index]
		if isScheduledInCycle(def, cycle) then
			if def.id == targetId then return t end
			t += getDuration(def) + EVENT_GAP_SECONDS
		end
		index += 1
		if index > count then
			index = 1
			cycle += 1
		end
	end
	return nil
end

local function getRarityUpChance(rarity: string): number
	return RARITY_UP_CHANCE[rarity] or 0
end

local function getMutationFactor(rarity: string): number
	return MUTATION_RARITY_FACTOR[rarity] or 1
end

local function describeBonus(bonus: EventBonus?): string?
	if not bonus then
		return nil
	end

	local amount = bonus.amount or 0

	if bonus.kind == "honey" then
		return string.format("%d Honig je Gebaeude", amount)

	elseif bonus.kind == "eggs" then
		if bonus.eggPick == "jump" then
			return string.format("%dx Sprung-Ei", amount)
		elseif bonus.eggPick == "highest" then
			return string.format("%dx dein hoechstes Ei", amount)
		end
		local eggType = bonus.eggType or "BasicEgg"
		local eggDef  = EggConfig.data[eggType]
		return string.format("%dx %s", amount, if eggDef then eggDef.displayName else eggType)

	elseif bonus.kind == "gummies" then
		return string.format("%d Gummies", amount)

	elseif bonus.kind == "goldGummies" then
		return string.format("%d GoldGummies", amount)

	elseif bonus.kind == "mutation" then
		return string.format(
			"bis zu %d%% Chance auf eine Mutation (sinkt mit Rarity)",
			math.floor((bonus.chance or 0) * 100 + 0.5)
		)
	end

	return nil
end

-- Die vollstaendige Belohnung in einer Zeile, fuer Tafel und UI.
local function describeReward(def: EventDef): string
	if def.rewardText then
		return def.rewardText
	end

	local bonusPart = describeBonus(def.bonus)
	if bonusPart then
		return bonusPart
	end

	return "Belohnung unbekannt"
end

return {
	EMERGENCY_BASIC_EGG_CHANCE = EMERGENCY_BASIC_EGG_CHANCE,
	EVENT_DURATION_SECONDS = EVENT_DURATION_SECONDS,
	EVENT_GAP_SECONDS      = EVENT_GAP_SECONDS,
	FIRST_GAP_SECONDS      = FIRST_GAP_SECONDS,
	BOSS_TIERS             = BOSS_TIERS,
	EVENTS                 = EVENTS,

	UFO                    = UFO,
	DUEL                   = DUEL,
	RARITY_UP_CHANCE       = RARITY_UP_CHANCE,
	MUTATION_RARITY_FACTOR = MUTATION_RARITY_FACTOR,
	STORM                  = STORM,
	HOT_EGG                = HOT_EGG,
	KING                   = KING,
	TREASURE               = TREASURE,
	WASP_QUEEN             = WASP_QUEEN,

	getById           = getById,
	getDuration       = getDuration,
	isScheduledInCycle = isScheduledInCycle,
	secondsUntilStart  = secondsUntilStart,
	getRarityUpChance = getRarityUpChance,
	getMutationFactor = getMutationFactor,
	describeBonus     = describeBonus,
	describeReward    = describeReward,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX11"><Properties>
<string name="Name">FeatureFlags</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- FeatureFlags.luau
-- ReplicatedStorage/Config/FeatureFlags.luau
--
-- Einzige Zustaendigkeit:
--   - Schalter fuer jede sichtbare Aenderung aus dem Honey-Bear-Brawl-Plan
--
-- Jede neue Anzeige haengt an genau einem Schalter. `true` = neuer Weg,
-- `false` = das Spiel verhaelt sich wie vor dem jeweiligen Paket. So bleibt
-- jede Aenderung einzeln zuruecknehmbar, ohne Code anzufassen.
--
-- Liegt in ReplicatedStorage, weil Server UND Client dieselbe Antwort brauchen
-- (z.B. Boss-Stufen: Server zahlt aus, Client zeigt die Truhe).
--
-- Ein unbekannter Name ist ein Tippfehler. In Studio bricht isOn dann mit
-- einem Fehler ab, damit er sofort auffaellt; im Live-Spiel gilt der Schalter
-- still als aus, damit ein Tippfehler keinen Server abstuerzen laesst.

local RunService = game:GetService("RunService")

local FLAGS: { [string]: boolean } = {
	-- Paket 1: Icons und Zahlen statt Text-Toasts
	UI_V2_FEEDBACK    = true,
	-- Paket 2: Beam-Fuehrung, Quest-Tracker mit Icons, ruhige Dialoge
	UI_V2_GUIDE       = true,
	-- Paket 3: Elemente erscheinen erst, wenn man sie braucht
	UI_V2_PROGRESSIVE = true,
	-- Paket 4: Upgrade-Tab, Kampfwert-Zahl, Rarity-Baender
	UI_V2_UPGRADE_TAB = true,

	-- Paket 5: Map ohne Umbau
	MAP_V2_MERCHANT   = true,
	MAP_V2_HOME       = true,
	MAP_V2_SHOWCASE   = true,
	MAP_V2_BOARDS     = true,
	MAP_V2_ARENA_SPRINT = true,   -- Baerchi sprintet zur Arena und zurueck
	-- Paket 6
	MAP_V2_LIVE_BOARD = true,
	MAP_V2_WASP_NEST  = true,
	EVENT_V2_TIMER    = true,

	-- Honig-Teich statt Stock + Veredler: EIN Gebaeude, Looks bis zum
	-- Honig-Springbrunnen, Baerchi wohnt am Becken (kein Hin- und Herlaufen).
	-- Bericht: docs/HBB_HONIG_TEICH_2026-10-05.md
	HONEY_POND_V2      = true,

	-- Entscheidung 05.10.: Laeufe starten immer bei Stage 1. Ab der letzten
	-- Stage nur per Klick gegen Gummies (kleines Feld, 7 s, UI/FightStartPrompt).
	FIGHT_RESUME_PROMPT = true,

	-- HBB Paket 10: Shop mit Gratis-Griff (GoldGummies) und Robux-Paketen
	-- (Pakete erst sichtbar, wenn ShopConfig eine Product-ID hat).
	-- Bericht: docs/HBB_PAKET_10_SHOP_2026-10-05.md
	SHOP_V1            = true,

	-- Playtest 05.10.: Basis-Eier (unbegrenzt beim Haendler) nicht pressbar
	PRESS_NO_BASIC_EGG = true,

	-- Paket 7: Boss-Belohnung nach Stufen
	BOSS_TIERS        = true,

	-- GoldGummies nur noch aus Tages-Quests (spaeter: Gratis-Griff im Shop)
	-- und nur noch fuer Charms. Keine Gold-Kosten bei Gebaeuden/Recycler, kein
	-- Gold aus Tower-Laeufen, Meilensteinen oder Login-Bonus.
	-- Bericht: docs/HBB_GOLD_NUR_CHARMS_2026-10-05.md
	GOLD_CHARMS_ONLY  = true,

	-- Paket 8/9: neue Pacing-Werte. Bleibt aus, bis der Mensch die Tabelle
	-- freigegeben hat (Stopp-Punkt im Plan).
	PACING_V2         = false,
	-- Paket 9: Endless-Tower (Stage 101+), freigegeben 05.10.
	-- Bericht: docs/HBB_PAKET_9_ENDLESS_2026-10-05.md
	ENDLESS           = true,

	-- Welt aufwerten (08.10.2026), je Paket ein Schalter. Reine Client-Optik.
	-- Paket A (Tageslauf) haengt am Schalter AmbienceConfig.DAY_CYCLE.
	-- Bericht: claude/WELT_AUFGEWERTET_UMGESETZT_2026-10-09.md
	WORLD_B_WATER     = true,   -- Glitzern, Schaum, Arena-Kueste, Fisch, Bojen
	WORLD_C_HUB       = true,   -- Mastkrone, Honigfaden, Ankunft, Wegweiser, Pit-Rahmen, Haendler, Nest, Tafeln
	WORLD_D_PLOTS     = true,   -- Insel-Stufen, Teich-Glanz/Ueberlauf, eigene Insel, leere Inseln
	WORLD_E_ARENA     = true,   -- Steg-Laternen, Torbogen, Zuschauer, Flagge am Schau-Turm
	WORLD_F_LIFE      = true,   -- Bienen, Schmetterlinge, Blumen im Wind, Pollenfarbe, Pfotenabdruecke
	WORLD_G_MOMENTS   = true,   -- Welt-Momente: Lichtsaeule, Feuerwerk, Welle, Spirale, Event-Glocke
	WORLD_H_SOUND     = true,   -- Klang-Kulisse nach Zonen (laeuft nur mit gepruefter Sound-ID)
	WORLD_I_ZONES     = true,   -- Licht-Feinschliff nach Zonen (Insel / Arena / Turm)
}

local FeatureFlags = {}

FeatureFlags.FLAGS = FLAGS

function FeatureFlags.isOn(name: string): boolean
	local value = FLAGS[name]
	if value == nil then
		if RunService:IsStudio() then
			error("[FeatureFlags] Unbekannter Schalter: " .. tostring(name), 2)
		end
		return false
	end
	return value
end

return FeatureFlags
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX12"><Properties>
<string name="Name">FunnelConfig</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- FunnelConfig.luau
-- ReplicatedStorage/Config/FunnelConfig.luau
--
-- Einzige Zustaendigkeit:
--   - Namen und Grenzen der Messpunkte (Onboarding-Trichter, UI-Ereignisse)
--
-- Daten statt Code: Schritte, erlaubte UI-Ereignisse und Kontingente stehen
-- hier, damit man sie aendern kann, ohne FunnelService anzufassen.
--
-- Liegt in ReplicatedStorage, weil der Client die erlaubten Ereignis-Arten
-- und Panel-Namen kennen muss, um gar nicht erst Unsinn zu senden. Geprueft
-- wird trotzdem nur auf dem Server.

local EconomyConfig = require(script.Parent.EconomyConfig)

-- Reihenfolge = Schrittnummer im Trichter. Nie umsortieren, sobald Daten
-- im Dashboard liegen: Roblox ordnet nach der Nummer.
local STEPS: { string } = {
	"F01_Join",
	"F02_FirstMove",
	"F03_FirstEggOpened",
	"F04_BearEquipped",
	"F05_FirstFightStarted",
	"F06_FirstFightEnded",
	"F07_FirstHoneyEaten",
	"F08_EventButtonPressed",
	"F09_FirstEventCompleted",
	"F10_SecondSession",
}

local STEP_INDEX: { [string]: number } = {}
for index, name in STEPS do
	STEP_INDEX[name] = index
end

return {
	STEPS      = STEPS,
	STEP_INDEX = STEP_INDEX,

	-- HBB Paket 8: WANN passiert etwas in der ersten Sitzung? Jeder Schritt
	-- (ausser F01/F10) und jeder Pacing-Meilenstein unten meldet zusaetzlich
	-- das Custom Event TIME_EVENT: Wert = Sekunden seit Join, CustomField01 =
	-- Name, CustomField02 = "S1" (erste Sitzung, Wert = aktive Zeit) oder
	-- "S2+" (spaetere Sitzung, Wert 0 — nur der Anteil zaehlt). Der Sim
	-- (tools/sim/progression_pacing.lua) sagt fuer Look 2 ~28 min voraus.
	TIME_EVENT = "SecondsSinceJoin",
	-- Gebaeude-Meilensteine: erreicht, sobald irgendein Gebaeude dieses Level
	-- hat. Nicht im Trichter, weil die Reihenfolge nicht feststeht.
	PACING_MILESTONES = {
		{ name = "P_FirstUpgrade", buildingLevel = 2 },
		{ name = "P_Look2",        buildingLevel = EconomyConfig.LOOK_THRESHOLDS[2] },
	} :: { { name: string, buildingLevel: number } },

	-- Nur Konten, die juenger sind, landen im Trichter: er soll den ersten
	-- Eindruck messen, nicht Veteranen.
	NEW_PLAYER_MAX_AGE = 24 * 3600,

	-- F10 ist die Rueckkehr. Ein Kind, das am naechsten Nachmittag wiederkommt,
	-- ist oft schon aelter als 24 h — deshalb ein eigenes, laengeres Fenster
	-- (Annahme: Tag-1-Rueckkehr, Roblox misst D1 bis 48 h).
	SECOND_SESSION_MAX_AGE = 48 * 3600,
	-- Ab diesem Alter des Kontos beim Join gilt ein Join als zweite Sitzung
	-- (eine frische Anlage hat createdAt ≈ jetzt).
	SECOND_SESSION_MIN_AGE = 10 * 60,

	-- F02: so weit muss sich der Charakter vom ersten gemessenen Punkt
	-- entfernen, damit es als Bewegung zaehlt (Studs).
	FIRST_MOVE_DISTANCE = 6,

	-- UI-Ereignisse vom Client (RequestLogUiEvent)
	UI_EVENT_KINDS = {
		PanelOpened = true,
		PanelQuickClose = true,
		IdleStanding = true,
	} :: { [string]: boolean },

	-- Panel-Namen aus PanelManager. Alles andere lehnt der Server ab, damit
	-- ein manipulierter Client keine beliebigen Strings ins Dashboard schreibt.
	UI_PANEL_NAMES = {
		Hatch = true, Inventory = true, Baerchi = true, Fusion = true,
		Charms = true, Combat = true, Rebirth = true, Language = true,
		Quests = true, EggTree = true, Leaderboard = true, Profile = true,
		DailyBonus = true, Shop = true,
		Building_Beehive = true, Building_HoneyRefiner = true, Building_HoneyPond = true,
	} :: { [string]: boolean },

	-- Schliessen unter dieser Zeit = "aus Versehen geoeffnet / nicht verstanden"
	QUICK_CLOSE_SECONDS = 3,
	-- Stillstand bis zum Ereignis IdleStanding
	IDLE_SECONDS = 20,
	-- Hoechstens so viele UI-Ereignisse pro Sitzung und Spieler (Kontingent
	-- der Custom Events schonen)
	MAX_UI_EVENTS_PER_SESSION = 50,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX13"><Properties>
<string name="Name">LeaderboardConfig</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- LeaderboardConfig.luau
-- ReplicatedStorage/Config/LeaderboardConfig.luau
--
-- Einzige Zustaendigkeit:
--   - Die Zahlen der Bestenlisten (v15): welche Listen, wie viele Plaetze, wie
--     oft geschrieben und gelesen wird, wie oft die Tafel am Spawn umschaltet.
--
-- Benutzt von LeaderboardService (einziger Nutzer von OrderedDataStores) und
-- vom LeaderboardPanel (Anzeige). Die Werte je Liste rechnet LeaderboardService
-- aus dem Spielstand:
--   Tower       Tower-Index x 1000 + Rekord (TowerConfig.leaderboardValue)
--   Rebirths    rebirthCount
--   Collection  Anzahl Index-Eintraege (data.discovered)
--   Endless     Endless-Rekord (Paket 9, FeatureFlags.ENDLESS)
--   EndlessWeek beste Endless-Stage dieser Woche (Montag 00:00 UTC neu),
--               ein OrderedDataStore je Woche (storeName)

local FeatureFlags = require(script.Parent.FeatureFlags)

local LeaderboardConfig = {}

export type ListId = "Tower" | "Rebirths" | "Collection" | "Endless" | "EndlessWeek"

LeaderboardConfig.LISTS = { "Tower", "Rebirths", "Collection" } :: { ListId }
if FeatureFlags.isOn("ENDLESS") then
	table.insert(LeaderboardConfig.LISTS, "Endless")
	table.insert(LeaderboardConfig.LISTS, "EndlessWeek")
end

-- Name des OrderedDataStores je Liste. Versions-Suffix, damit eine spaetere
-- Umstellung der Wertformel mit leeren Listen startet statt mit Altwerten.
LeaderboardConfig.STORE_NAMES = {
	Tower      = "LB_Tower_v1",
	Rebirths   = "LB_Rebirths_v1",
	Collection = "LB_Collection_v1",
	Endless    = "LB_Endless_v1",
	EndlessWeek = "LB_EndlessWeek_v1_W",   -- + Wochennummer (storeName)
} :: { [string]: string }

-- Paket 9: Wochen. Woche 0 begann Montag, 05.01.1970 00:00 UTC (os.time 0
-- ist ein Donnerstag, +4 Tage).
LeaderboardConfig.WEEK_SECONDS = 7 * 86400
LeaderboardConfig.WEEK_START   = 4 * 86400
-- So viele der Vorwoche tragen diese Woche die Krone am Plot-Schild.
LeaderboardConfig.CROWN_TOP_N  = 10

function LeaderboardConfig.weekOf(now: number): number
	return (now - LeaderboardConfig.WEEK_START) // LeaderboardConfig.WEEK_SECONDS
end

function LeaderboardConfig.secondsUntilNextWeek(now: number): number
	local week = LeaderboardConfig.weekOf(now)
	return LeaderboardConfig.WEEK_START + (week + 1) * LeaderboardConfig.WEEK_SECONDS - now
end

-- Name des OrderedDataStores einer Liste (`week` nur fuer EndlessWeek).
function LeaderboardConfig.storeName(listId: string, week: number): string
	local base = LeaderboardConfig.STORE_NAMES[listId]
	return if listId == "EndlessWeek" then base .. tostring(week) else base
end

LeaderboardConfig.TOP_N        = 50   -- Plaetze im Panel
LeaderboardConfig.BOARD_TOP_N  = 10   -- Plaetze auf der Tafel am Spawn

-- Schreiben: nur bei Aenderung und hoechstens alle WRITE_MIN_SECONDS pro Spieler.
LeaderboardConfig.WRITE_MIN_SECONDS = 60
-- Lesen: serverweit hoechstens alle READ_INTERVAL_SECONDS (Cache dazwischen).
LeaderboardConfig.READ_INTERVAL_SECONDS = 120
-- Takt, in dem faellige Schreibvorgaenge abgearbeitet werden.
LeaderboardConfig.TICK_SECONDS = 10
-- Tafel am Spawn: alle BOARD_CYCLE_SECONDS die naechste Liste.
LeaderboardConfig.BOARD_CYCLE_SECONDS = 15

-- Unter diesem Rest-Budget wird nicht geschrieben/gelesen (fuer den
-- Spieler-DataStore muss Luft bleiben).
LeaderboardConfig.MIN_REQUEST_BUDGET = 4

return LeaderboardConfig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX14"><Properties>
<string name="Name">LoginBonusConfig</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- LoginBonusConfig.luau
-- ReplicatedStorage/Config/LoginBonusConfig.luau
--
-- Einzige Zustaendigkeit:
--   - Die Zahlen des taeglichen Login-Bonus (v15): 7-Tage-Zyklus nach UTC-Tag,
--     Belohnung je Tag, Gnadenfrist.
--
-- Die Regeln (welcher Tag ist dran, darf heute abgeholt werden) rechnet
-- Modules/LoginBonusCalc — rein und testbar (tools/luau-tests/login_bonus.test.lua).
-- Ausgezahlt wird in LoginBonusService ueber EconomyService (Gummies MIT
-- Rebirth-Multiplikator, damit der Bonus auch nach vielen Rebirths noch zaehlt),
-- EggService (Eier) und EggTreeService (Blaupause).
--
-- ANNAHMEN (Startwerte, im Bericht gelistet):
--   * Tag 1-6 steigen Gummies, GoldGummies und Basis-Eier.
--   * Tag 7: das hoechste freie Ei im Ei-Baum + 25 % Chance auf eine Blaupause.
--   * Ein verpasster Tag wird verziehen (Gnadenfrist): wer am uebernaechsten
--     UTC-Tag abholt, macht mit dem naechsten Tag weiter. Wer zwei oder mehr
--     Tage verpasst, faengt wieder bei Tag 1 an.

local Types = require(script.Parent.Parent.Network.Types)
local FeatureFlags = require(script.Parent.FeatureFlags)

local LoginBonusConfig = {}

export type DayReward = {
	gummies     : number?,                               -- Basis (x rebirthMult)
	goldGummies : number?,
	eggType     : Types.EggType?,                        -- feste Sorte
	eggs        : number?,                               -- Anzahl dieser Sorte
	highestEgg  : number?,                               -- Anzahl "hoechstes freies Ei"
	blueprintChance : number?,                           -- 0..1
}

LoginBonusConfig.CYCLE_DAYS = 7

-- Wie viele UTC-Tage nach der letzten Abholung die Serie noch weiterlaeuft:
-- 1 = gestern abgeholt (normal), 2 = einen Tag verpasst (Gnadenfrist, "48 h").
LoginBonusConfig.GRACE_DAYS = 2

LoginBonusConfig.SECONDS_PER_DAY = 86400

LoginBonusConfig.DAYS = {
	[1] = { gummies = 500 },
	[2] = { gummies = 1_500, goldGummies = 5 },
	[3] = { gummies = 3_000, eggType = "BasicEgg", eggs = 3 },
	[4] = { gummies = 6_000, goldGummies = 15 },
	[5] = { goldGummies = 25, eggType = "BasicEgg", eggs = 5 },
	[6] = { gummies = 15_000, goldGummies = 40 },
	[7] = { goldGummies = 60, highestEgg = 1, blueprintChance = 0.25 },
} :: { [number]: DayReward }

-- GOLD_CHARMS_ONLY: dieselbe Woche ohne GoldGummies. Tage, die nur Gold
-- hatten (5, 7), bekommen Gummies in der Reihe 500 / 1.500 / 3.000 / 6.000 /
-- 10.000 / 15.000 / 30.000; Eier und Blaupause bleiben.
LoginBonusConfig.DAYS_V2 = {
	[1] = { gummies = 500 },
	[2] = { gummies = 1_500 },
	[3] = { gummies = 3_000, eggType = "BasicEgg", eggs = 3 },
	[4] = { gummies = 6_000 },
	[5] = { gummies = 10_000, eggType = "BasicEgg", eggs = 5 },
	[6] = { gummies = 15_000 },
	[7] = { gummies = 30_000, highestEgg = 1, blueprintChance = 0.25 },
} :: { [number]: DayReward }

function LoginBonusConfig.getDay(day: number): DayReward
	local days = if FeatureFlags.isOn("GOLD_CHARMS_ONLY") then LoginBonusConfig.DAYS_V2 else LoginBonusConfig.DAYS
	return days[math.clamp(math.floor(day), 1, LoginBonusConfig.CYCLE_DAYS)]
end

return LoginBonusConfig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX15"><Properties>
<string name="Name">MapConfig</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- MapConfig.luau
-- ReplicatedStorage/Config/MapConfig.luau
--
-- Alle Positionen, Groessen und visuellen Werte fuer die Map.
-- MapService hat keine einzige hardcodierte Zahl.
--
-- ============================================================
-- WELT-AUFBAU: INSELN IM WASSER
-- ============================================================
-- Drei Ringe aus Inseln, alle mit Holzstegen verbunden, rundherum Wasser:
--
--                        (A)
--                         |
--                        [P]
--                         |
--             (A)—[P]— (( C )) —[P]—(A)      8 mal, alle 45 Grad
--                         |
--                        [P]
--                         |
--                        (A)
--
--   (( C ))  Hauptinsel: Spawn, Honigmast, freie Karo-Wiese. Hier landen
--            alle und hier laufen sich alle ueber den Weg.
--   [P]      Plot-Insel: eine pro Spieler, mit dem eigenen Beet, den drei
--            Gebaeuden und dem Honig-Teich.
--   (A)      Arena-Insel: die eigene PIT-Arena, ein Stueck weiter draussen.
--
-- WARUM INSELN STATT EINER PLATTFORM
-- Vorher war alles eine einzige 480 Studs breite Scheibe, auf der die Plots
-- als Rechtecke lagen. Das las sich aus der Spielerkamera als eine grosse
-- gruene Flaeche mit Markierungen darauf — man sah nicht, wo der eigene
-- Bereich anfaengt. Getrennte Inseln beantworten das ohne ein einziges
-- Schild: was zu mir gehoert, ist das, was am Ende MEINES Stegs liegt.
--
-- Alle drei Abstaende sind derselbe Wert (ISLAND_GAP) und damit auch alle
-- Stege gleich lang. Ein Steg ueberbrueckt IMMER genau eine Luecke — es gibt
-- keine zweite Laengen-Zahl mehr, die davon abweichen koennte.
--
-- Die Wiese ist KARIERT (zwei Gruentoene). Gebaut wird nur die helle Haelfte
-- als flache Teile auf der dunklen Inselscheibe; das Raster liegt in
-- Weltkoordinaten, laeuft also ueber alle Inseln durch. Die frueheren
-- Lego-Noppen sind dafuer weg: Noppen UND Karos uebereinander ergeben nur
-- Unruhe, und das Karo ist das, was die Flaeche gliedert.
--
-- ============================================================
-- PLOT-LOKALES KOORDINATENSYSTEM (wichtig!)
-- ============================================================
-- Jeder Plot bekommt in MapService ein eigenes CFrame, das zur Plattform-
-- MITTE schaut. Alle Offsets hier unten sind deshalb LOKAL zu diesem Plot:
--
--     lokales -Z  = Richtung Plattform-Mitte
--     lokales +Z  = nach aussen (Richtung Rand → Bruecke → PIT)
--     lokales +X  = seitlich (rechts, wenn man vom Plot zur Mitte schaut)
--
-- Nur dadurch stehen die Gebaeude bei allen 8 Winkeln richtig herum statt
-- verdreht. Das Y in den Offsets ist eine ZUSATZ-Hoehe ueber dem Plot-Boden;
-- die eigentliche Standhoehe rechnet MapService selbst aus der jeweiligen
-- Teilegroesse aus, damit nichts schwebt oder im Boden steckt.

--------------------------------------------------------------------------------
-- Hauptinsel, Wasser, Karo-Wiese
--------------------------------------------------------------------------------

local CENTER = Vector3.new(0, 0, 0)

-- Oberkante JEDER Insel. Alles andere wird relativ dazu berechnet —
-- die Welt laesst sich damit an einer einzigen Zahl hoch/runter schieben.
local PLATFORM_TOP_Y = 0

-- War 150. Von der eigenen Plot-Insel bis zur Mitte war das ein spuerbar
-- langer Fussmarsch quer ueber die Hauptinsel — genau die Strecke, die am
-- meisten zaehlt, weil man sie bei jedem Ei, jedem Ausruesten und jedem
-- Rebirth-Blick zur Mitte zuruecklegt. 120 kuerzt das um ein Fuenftel, ohne
-- die Hauptinsel eng wirken zu lassen (das Spawn-Pad ist 24 Studs breit,
-- bleibt also weiterhin ein kleiner Punkt darauf).
local PLATFORM_RADIUS = 120

-- Wie dick eine Insel ist. Sie steckt damit sichtbar im Wasser statt wie eine
-- Scheibe darauf zu liegen — bei 16 Studs sieht man von der Kamerahoehe eines
-- Spielers eine richtige Kante, keinen Strich.
local ISLAND_HEIGHT = 16

-- Abstand zwischen zwei Inseln UND damit die Laenge jedes Stegs. Ein Steg
-- ueberbrueckt immer genau eine Luecke, deshalb gibt es nur diese eine Zahl.
-- War 44 (rund drei Sekunden bei WALK_SPEED). 34 bleibt immer noch lang genug,
-- dass die Inseln spuerbar getrennt wirken, kuerzt aber jede der beiden
-- Bruecken pro Weg (Hauptinsel→Plot, Plot→Arena) um gut zwei Sekunden.
local ISLAND_GAP = 34

-- ============================================================
-- KARO-WIESE
-- ============================================================
-- Zwei Gruentoene im Schachbrett. Gebaut werden NUR die hellen Felder als
-- flache Teile — die dunkle Haelfte ist die Inselscheibe selbst. Das halbiert
-- die Teilezahl gegenueber "jedes Feld ein Teil" bei exakt demselben Bild.
--
-- GRASS_TILE gilt fuer die ganze Welt, und das Raster liegt in WELT-
-- Koordinaten mit Ursprung im Weltmittelpunkt: die Karos laufen dadurch ueber
-- alle Inseln durch, statt auf jeder neu anzusetzen. Nur die Plot-Beete
-- rastern plot-lokal (siehe unten) — sonst laege das Karo auf einem gedrehten
-- Beet schief.
--
-- 24 Studs sind bewusst gross: bei 12 wirkt die Wiese aus der Spielerkamera
-- wie ein Muster statt wie Felder, und die Teilezahl vervierfacht sich.
--
-- Das Beet auf der Plot-Insel rastert FEINER (PLOT_GRASS_TILE). Es ist die
-- Flaeche, auf der man selbst steht und auf die man die ganze Zeit schaut;
-- 24er-Felder waeren darauf nur drei Reihen und wuerden gar nicht mehr als
-- Karo lesen. Dieselbe Ueberlegung wie bei einem Teppich gegenueber einer
-- Wiese. 72 / 18 geht glatt auf, es bleibt kein Reststreifen an einer Kante.
local GRASS_TILE      = 24
local PLOT_GRASS_TILE = 18
local GRASS_HEIGHT    = 0.08   -- wie weit ein helles Feld ueber der Scheibe liegt
local GRASS_DARK      = Color3.fromRGB( 58, 140,  62)
local GRASS_LIGHT     = Color3.fromRGB( 92, 178,  82)

-- Sandkante am Wasser: eine BREITERE Scheibe, die ein Stueck tiefer liegt.
-- Ringsum bleibt dadurch ein Sandstreifen sichtbar, ohne dass dafuer ein Ring
-- aus Einzelteilen gebaut werden muesste.
--
-- SHORE_DROP und WATER_DROP bilden zusammen eine Treppe: Wiese 0, Sand -1,
-- Wasser -2.6. Beide Stufen sind niedrig genug, dass eine Roblox-Figur sie
-- ohne Springen hochgeht — wer ins Wasser faellt, laeuft einfach zurueck an
-- Land. Waeren sie hoeher, waere jeder Fehltritt eine Sackgasse.
local SHORE_WIDTH = 8
local SHORE_DROP  = 1.0
local SHORE_COLOR = Color3.fromRGB(238, 214, 158)

-- Das Wasser ist EINE grosse Scheibe unter allem.
--
-- Sie ist begehbar (CanCollide): wer vom Steg faellt, landet auf der
-- Oberflaeche und laeuft zurueck, statt ins Leere zu stuerzen. In einem Spiel,
-- in dem man staendig ueber schmale Stege laeuft, ist das die freundlichere
-- Loesung — ein Sturz waere reine Strafe ohne Spielinhalt.
--
-- WATER_RADIUS muss die aeusserste Arena mit Sandkante umschliessen; das
-- prueft MapService beim Start. War 700 — mit der kleineren Welt reicht 650
-- fuer denselben grosszuegigen Rand offenen Wassers dahinter.
local WATER_RADIUS       = 650
local WATER_DROP         = 2.6    -- wie weit unter Inselhoehe die Oberflaeche liegt
local WATER_HEIGHT       = 10
local WATER_COLOR        = Color3.fromRGB(64, 164, 214)
local WATER_TRANSPARENCY = 0.28

-- Not-Spawn in der Mitte der Wiese. Greift nur noch, wenn ein Spieler
-- ausnahmsweise KEINEN eigenen Plot bekommt (Server voll, siehe
-- MapService.spawnIsland) — der normale Weg ist seit dem Insel-Spawn
-- (siehe PLAYER_SPAWN_OFFSET unten) die eigene Insel, nicht mehr die Mitte.
-- Unsichtbar, damit sie nicht als zweiter Bodenbelag unter dem Event-Pit
-- durchscheint.
local SPAWN_SIZE = Vector3.new(10, 1, 10)
local SPAWN_COLOR = Color3.fromRGB(240, 230, 200)

-- ============================================================
-- EVENT-PIT: DER STALL IN DER MITTE
-- ============================================================
-- Ein rundes, eingezaeuntes Podest genau in der Weltmitte, unter dem
-- Honigmast. Normalerweise ein schlichter Holz-Stall — sobald ein Event
-- laeuft, faerbt EventService Boden, Zaun und Ring in dessen Farben um
-- (siehe MapService.setEventPitTheme) und die Anzeigetafel darueber zeigt
-- Name und Restzeit. Ausserhalb eines Events zeigt dieselbe Tafel den
-- Countdown bis zum naechsten (siehe MapService.setEventBanner).
--
-- Acht Zaunluecken statt einer (wie bei den Spieler-Arenen): das Pit steht
-- in der Mitte aller acht Stege, nicht am Ende von nur einem. Jede Luecke
-- liegt genau in der Aussenrichtung eines Plots — wer von seiner Bruecke
-- kommt, laeuft geradewegs hinein statt am Zaun entlang zu suchen.
--
-- Podesthoehe 2 Studs, derselbe Trick wie beim Plot-Beet (PLOT_SIZE.Y):
-- ein klarer Schritt nach oben statt eines Absenk-Tricks, niedrig genug zum
-- Hochlaufen ohne Springen.
local EVENT_PIT_RADIUS       = 50
local EVENT_PIT_FLOOR_HEIGHT = 2

-- Sicherheitsabstand zwischen dem Karo-Rasen (GRASS_HEIGHT ueber
-- PLATFORM_TOP_Y) und der Podest-Unterkante — derselbe Grundgedanke wie
-- BRIDGE_SINK/GRASS_HEIGHT selbst: ohne diesen Puffer laege die Unterkante
-- GENAU auf Rasenhoehe, und ein paar Karo-Kacheln direkt am Podestrand
-- wuerden mit der Unterkante flimmern bzw. leicht durchscheinen — genau der
-- "das Pit steckt teilweise im Boden"-Effekt. Mit dem Puffer liegt die
-- Unterkante immer sauber ueber dem Rasen, egal welche Kachel gerade
-- darunterliegt.
local EVENT_PIT_GROUND_CLEARANCE = 0.3

-- Stall-Look: gedeckte Stroh-/Holztoene, kein Glimmen. Erst ein Event macht
-- daraus etwas Auffaelliges (siehe EventConfig.EVENTS).
local EVENT_PIT_DEFAULT_FLOOR_COLOR = Color3.fromRGB(178, 150, 100)
local EVENT_PIT_DEFAULT_FENCE_COLOR = Color3.fromRGB(150, 105, 60)
local EVENT_PIT_DEFAULT_RING_COLOR  = Color3.fromRGB(120,  98,  70)

local EVENT_PIT_RING_OVERHANG = 1.6
local EVENT_PIT_RING_HEIGHT   = 0.7

local EVENT_PIT_FENCE_COUNT       = 28
local EVENT_PIT_FENCE_SIZE        = Vector3.new(1.0, 5.0, 1.0)
local EVENT_PIT_FENCE_GAP_DEGREES = 9     -- Oeffnung je Bruecken-Richtung, halber Winkel je Seite
local EVENT_PIT_FENCE_INSET       = 1.6

-- Anzeigetafel: anders als bei den Spieler-Arenen IMMER eingeblendet — sie
-- ist der einzige Ort, an dem der Event-Countdown steht.
-- Playtest 05.10.: bei 16 lag die Tafel im Honigmast (Spitze ~33) und die
-- Schrift lief durch ihn hindurch. 38 = Unterkante ueber dem Tropfen.
local EVENT_PIT_BANNER_HEIGHT   = 38
local EVENT_PIT_BANNER_SIZE     = Vector2.new(22, 6)
local EVENT_PIT_BANNER_DISTANCE = 300
local EVENT_PIT_BANNER_IDLE_COLOR = Color3.fromRGB(230, 220, 200)

--------------------------------------------------------------------------------
-- Spieler-Plots
--------------------------------------------------------------------------------

local PLOT_COUNT = 8

-- Jeder Plot ist eine eigene RUNDE Insel; darauf liegt das quadratische Beet.
--
-- PLOT_ISLAND_RADIUS muss die ECKEN des Beetes decken, nicht seine Kanten:
-- bei 72x72 liegt eine Ecke 50.9 Studs von der Mitte. 58 laesst also rund
-- 7 Studs Wiesenrand ums Beet, dahinter kommt die Sandkante. Zu knapp, und
-- das Beet ragt an vier Stellen ueber die Insel; MapService prueft das beim
-- Start.
local PLOT_ISLAND_RADIUS = 58

-- Abstand der Insel-MITTE zur Weltmitte. Ergibt sich aus den Radien und der
-- Luecke: Hauptinsel-Rand + Steg + halbe Plot-Insel.
--     120 + 34 + 58 = 212
-- MapService rechnet das beim Start nach und warnt, wenn es nicht passt.
-- PLOT_ISLAND_RADIUS selbst bleibt unangetastet: er haengt fest an PLOT_SIZE
-- (die Insel muss die Beet-Ecken decken) — an dieser Zahl zu drehen wuerde das
-- Beet ueber den Inselrand ragen lassen, nicht nur den Weg dorthin verkuerzen.
local PLOT_RING_RADIUS = 212
local PLOT_SIZE        = Vector3.new(72, 2, 72)

-- Der Wiesenrand der Plot-Insel, auf dem das Beet steht. Etwas dunkler als das
-- Karo, damit das Beet als eigene Flaeche liest und nicht mit der Insel
-- verschwimmt.
local PLOT_ISLAND_COLOR = Color3.fromRGB(70, 152, 70)

-- Zaun an den beiden SEITEN des Plots (lokales +X und -X). Vorne (+Z, Richtung
-- Bruecke) und hinten (-Z, Richtung Mitte) bleibt bewusst offen — sonst muesste
-- man ueber den Zaun springen um auf den eigenen Plot oder zur Bruecke zu kommen.
local FENCE_POST_SIZE    = Vector3.new(1.2, 5, 1.2)
local FENCE_POST_SPACING = 9
local FENCE_RAIL_HEIGHT  = 0.8
local FENCE_COLOR        = Color3.fromRGB(225, 215, 190)

-- Schild an der zur Mitte zeigenden Kante: zeigt, wem der Plot gehoert
local SIGN_POST_SIZE  = Vector3.new(0.8, 7, 0.8)
-- Playtest 05.10.: 16 breit wirkte langgezogen, und EIN Pfosten in der Mitte
-- ragte vorne durch die Schrift. Jetzt 12 breit, zwei Pfosten HINTER dem Brett
-- an den Raendern, dunkle Leisten oben und unten.
local SIGN_BOARD_SIZE = Vector3.new(12, 5.2, 0.6)
local SIGN_TRIM_COLOR = Color3.fromRGB(150, 105, 60)
local SIGN_POST_COLOR = Color3.fromRGB(150, 105, 60)
local SIGN_COLOR      = Color3.fromRGB(245, 235, 205)

-- Blumen auf der freien Wiese der Hauptinsel. Rein optisch, deterministisch
-- gesetzt (fester Zufallsstartwert), damit die Welt bei jedem Server-Start
-- gleich aussieht.
--
-- Weniger als vorher (90), weil die Hauptinsel nur noch ein Fuenftel der
-- frueheren Flaeche hat: dieselbe Zahl waere jetzt ein Blumenfeld, und die
-- Karos darunter waeren nicht mehr zu sehen.
local FLOWER_COUNT      = 46
local FLOWER_SEED       = 20260903
local FLOWER_STEM_SIZE  = Vector3.new(0.4, 3, 0.4)
local FLOWER_HEAD_SIZE  = 1.8
local FLOWER_STEM_COLOR = Color3.fromRGB(70, 150, 55)
local FLOWER_COLORS: { Color3 } = {
	Color3.fromRGB(255, 235, 120),
	Color3.fromRGB(255, 160, 190),
	Color3.fromRGB(180, 165, 255),
	Color3.fromRGB(255, 255, 255),
}

--------------------------------------------------------------------------------
-- Gebaeude auf dem Plot (Offsets im PLOT-LOKALEN Raum, siehe Kopf)
--------------------------------------------------------------------------------

-- Die zwei Honig-Gebaeude (v15: Bienenstock und Honig-Veredler) stehen ab dem
-- ersten Join auf dem Plot (siehe Types.createDefaultPlayerData). Der dritte
-- Ausbau, der Waben-Recycler, steht vorne am Steg (CombConfig.RECYCLER_OFFSET). Sie stehen in einer Reihe an der zur Mitte
-- zeigenden Seite (-Z), damit die vordere Haelfte des Plots (+Z) frei bleibt
-- fuer die Baerchis und den Weg zur Bruecke.
--
-- Der Part-Name ist die BuildingId — der Client findet darueber das Gebaeude
-- fuer den ProximityPrompt. Wer hier einen Schluessel aendert, muss ihn auch
-- in Types.BuildingId, BuildingBehavior und IslandService.VALID_BUILDINGS
-- aendern; tools/check_consistency.py prueft alle Listen gegeneinander.
-- displayName steht bewusst HIER und nicht im Client: das Schild in der Welt
-- (MapService) und das Gebaeude-Panel (BuildingPanel) benennen dasselbe
-- Objekt. Zwei getrennte Listen waeren die naechste Stelle, an der etwas
-- auseinanderlaeuft.
-- shortName steht aus demselben Grund hier wie displayName: seit v7 waehlt der
-- Spieler auf der Baerchi-Detailkarte aus, welchen Honig er verfuettert, und
-- auf einen Knopf von einem Drittel Kartenbreite passt "Honig-Presse" nicht.
-- Eine zweite Namensliste im Client waere die naechste Stelle, an der etwas
-- auseinanderlaeuft.
local BUILDING_OFFSETS: { [string]: { offset: Vector3, size: Vector3, color: Color3, displayName: string, shortName: string } } = {
	Beehive = {
		offset      = Vector3.new(-22, 0, -22),
		size        = Vector3.new(12, 11, 12),
		color       = Color3.fromRGB(240, 190, 70),    -- Bienenstock-Gelb
		displayName = "Bienenstock",
		shortName   = "Stock",
	},
	-- v15: Honigtopf + Honig-Presse -> Honig-Veredler ("Honig-Veredler" ist ein
	-- Platzhalter-Name). Steht dort, wo die Presse stand; die Mitte (frueher
	-- der Topf) bleibt frei.
	HoneyRefiner = {
		offset      = Vector3.new(22, 0, -22),
		size        = Vector3.new(12, 11, 12),
		color       = Color3.fromRGB(205, 135, 45),    -- Honig-Orange
		displayName = "Honig-Veredler",
		shortName   = "Veredler",
	},
	-- Honig-Teich (HONEY_POND_V2): ersetzt Stock und Veredler. Steht mitten im
	-- hinteren Plot-Teil (wo die beiden standen), damit sein Brunnen vom Steg
	-- aus zu sehen ist. Der Koerper ist so gross wie Becken + Steinkranz; die
	-- Look-Deko (BUILDING_LOOK_DECOR.HoneyPond) waechst darin bis zum
	-- Honig-Springbrunnen. Das Becken selbst baut PondBuilder an derselben Stelle.
	HoneyPond = {
		offset      = Vector3.new(0, 0, -14),
		size        = Vector3.new(20, 15, 20),
		color       = Color3.fromRGB(255, 190, 60),    -- Honig-Gold
		displayName = "Honig-Brunnen",
		shortName   = "Brunnen",
	},
}

-- Feste Reihenfolge fuer alles was die Gebaeude AUFLISTET (Panel, Schilder).
-- Die Gebaeude-Tabelle in IslandData ist eine Hash-Tabelle und damit nicht
-- stabil sortiert.
local BUILDING_ORDER: { string } = { "Beehive", "HoneyRefiner", "HoneyPond" }

--------------------------------------------------------------------------------
-- Aussehen der Gebaeude
--------------------------------------------------------------------------------

-- Die Part aus BUILDING_OFFSETS ist seit v5 nur noch der unsichtbare Koerper:
-- sie traegt Namen, Attribut und Schild, und der Client haengt seinen
-- ProximityPrompt daran. Sie kollidiert NICHT — dagegen laufen kann man nur
-- an den Teilen, die hier `solid = true` tragen. WIE ein Gebaeude aussieht
-- steht also hier, als reine Beschreibung, ohne eine Zeile Code.
--
-- Warum getrennt: der Klotz von vorher war der Grund, dass alle drei Gebaeude
-- gleich aussahen und man sie nur am Schild unterscheiden konnte. Wer die Form
-- aendern will, aendert diese Liste und fasst MapService nicht an.
--
-- Koordinaten sind GEBAEUDE-lokal: Ursprung ist die Mitte der Grundflaeche auf
-- Plot-Hoehe, +Y ist nach oben, -Z zeigt zur Plattform-Mitte (also zu der
-- Seite, von der der Spieler kommt) und +Z zu den Baerchis.
--
-- shape/rotation: ein Cylinder liegt in Roblox von Haus aus entlang X. Damit
-- er STEHT, braucht er rotation = Vector3.new(0, 0, 90) — die Size ist dann
-- (Hoehe, Durchmesser, Durchmesser). Das ist die haeufigste Stolperfalle hier.
-- solid: dagegen laeuft man. Standard ist false, weil die meisten Teile nur
-- Zierrat sind (Wimpel, Flugloch, Honig-Fuellung) und man daran sonst haengen
-- bliebe. Der KOERPER selbst kollidiert seit v5 nicht mehr: er ist ein Kasten
-- in der Groesse aus BUILDING_OFFSETS und passt damit nicht mehr zur
-- sichtbaren Form — bei der offenen Presse etwa wuerde man mitten in der Luft
-- zwischen den Pfosten stehenbleiben. Also markiert die Config genau die
-- Teile, die den Umriss ausmachen.
export type DecorPiece = {
	name     : string,
	shape    : Enum.PartType,
	size     : Vector3,
	offset   : Vector3,
	color    : Color3,
	material : Enum.Material?,
	rotation : Vector3?,   -- Grad, optional
	solid    : boolean?,   -- Standard: false
}

local UPRIGHT = Vector3.new(0, 0, 90)   -- macht aus einem liegenden einen stehenden Cylinder

local WOOD       = Color3.fromRGB(160, 110, 65)
local WOOD_DARK  = Color3.fromRGB(118,  80,  46)
local HONEY      = Color3.fromRGB(245, 175,  45)
local HONEY_DEEP = Color3.fromRGB(205, 135,  45)
local METAL      = Color3.fromRGB(150, 152, 158)

