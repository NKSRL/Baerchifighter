		{ name = "Pfosten3",    shape = Enum.PartType.Block,    size = Vector3.new( 1.2, 7.0,  1.2), offset = Vector3.new(-3.9, 4.10,  3.9), color = WOOD_DARK, material = Enum.Material.Wood, solid = true },
