	["ev.label.hot_egg"]          = "¡HUEVO CALIENTE!",
	["ev.label.on_top"]           = "{s}s arriba",
	["ev.label.digging"]          = "Excavando {i}/{n}",
	["ev.ufo.abducted"]           = "OVNI: ¡están abduciendo a tu Baerchi!",
	["ev.ufo.fight_lost"]         = "Combate perdido - progreso del rayo reiniciado",
	["ev.ufo.fight_won"]          = "¡Combate ganado!",
