	["skill.SugarRush.desc"]              = "Doppelte Angriffsgeschwindigkeit für 2 Aktionen.",
	["skill.GummyShield.desc"]            = "Absorbiert 50% des Schadens für 2 Aktionen.",
	["skill.IceSlam.desc"]                = "1.5x Schaden und betäubt den Gegner für eine Aktion.",
