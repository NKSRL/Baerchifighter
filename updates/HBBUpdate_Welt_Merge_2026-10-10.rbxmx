	["skill.BasicPunch.desc"]             = "Un coup simple. Toujours là.",
	["skill.SugarRush.desc"]              = "Vitesse d'attaque doublée pendant 2 actions.",
	["skill.GummyShield.desc"]            = "Absorbe 50 % des dégâts pendant 2 actions.",
	["skill.IceSlam.desc"]                = "1.5x dégâts et étourdit l'ennemi pendant une action.",
	["skill.FireBite.desc"]               = "Enflamme l'ennemi pendant 3 actions.",
