	["msg.charm_rolled.one"]       = "{n} lancer  —  {gold} GoldGummies",
	["msg.charm_rolled.other"]     = "{n} lancers  —  {gold} GoldGummies",
	["ui.building.honey_stock"]    = "Miel en stock",
	["ui.building.now"]            = "Ce qu'il fait",
	["ui.building.next"]           = "Niveau suivant",
	["ui.building.upgrade_btn"]    = "AMÉLIORER",
