	["ui.building.maxed_btn"]      = "AMÉLIORATION MAX",
	["ui.pit_resume.title"]        = "Où doit-il commencer ?",
	["ui.pit_resume.fresh"]        = "Depuis le début",
	["ui.pit_resume.percent"]      = "À 65 % de la dernière course",
	["ui.pit_resume.last"]         = "Depuis le dernier niveau",
	["ui.pit_resume.option"]       = "{label}  —  Niveau {stage}  —  {cost}",
	["ui.pit_resume.status"]       = "Tour {tower}  •  Dernière course : niveau {stage}  •  HP {hp} / {max} ({pct} %)",
	["ui.hatch.result_sub"]        = "Niv. {level}{mutation}\nde {egg}",
	["ui.hatch.timeout"]           = "Pas de réponse du serveur — l'oeuf est toujours en stock",
