	["ui.fusion.result_detail"]          = "{rarity}  —  Niveau {level}\nBonus de stats +{bonus} %\nNiveaux : HP {hp}  ATK {atk}  SPD {spd}  PWR {pwr}  EGG {egg}  (max {cap})",
	["msg.fusion_done"]                  = "Fusion : {name} ({rarity}) Niv. {level}",

	----------------------------------------------------------------------------
	-- UI-Qualitaet: Charms, Gebaeude, Tower-Einstieg, Eier, Pet-Leiste, Welt
	----------------------------------------------------------------------------
	["ui.charm.title_baerchi"]     = "{name}  —  Promotion {p}/{max}",
	["ui.charm.slot_empty"]        = "vide — inclus au prochain lancer",
	["ui.charm.hint_all_locked"]   = "Tous les emplacements ouverts sont verrouillés — touche-en un pour le libérer.",
	["ui.charm.hint_roll"]         = "Un lancer relance les {n} emplacements ouverts. Touche un emplacement pour le verrouiller.",
