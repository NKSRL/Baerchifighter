-- v17 (lebendige Events)
local JackpotRoll               = require(ServerScriptService.Util.JackpotRoll)

-- HBB Paket 0
local FunnelService             = require(ServerScriptService.Services.FunnelService)

local DebugService = {}

local BINDABLE_NAME = "RBLDebug"

--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

-- Der erste Spieler im Server. Fuer Solo-Tests in Studio genau richtig.
local function firstPlayer(): Player?
	return Players:GetPlayers()[1]
end

local function requireData(): (Player?, Types.PlayerData?, string?)
	local player = firstPlayer()
	if not player then
		return nil, nil, "Kein Spieler im Spiel — laeuft der Play-Modus?"
	end

	local data = PlayerService.getData(player)
	if not data then
		return player, nil, "Daten fuer " .. player.Name .. " noch nicht geladen"
	end

	return player, data, nil
end

local function countBaerchis(data: Types.PlayerData): number
	local n = 0
	for _ in data.island.baerchis do n += 1 end
	return n
end

--------------------------------------------------------------------------------
-- Befehle
--------------------------------------------------------------------------------

local commands: { [string]: (Player, Types.PlayerData, ...any) -> any } = {}

commands.info = function(player, data)
	local buildings: { [string]: number } = {}
	for id, building in data.island.buildings do
		buildings[id] = building.level
	end

	return {
		player       = player.Name,
		gummies      = data.gummies,
		goldGummies  = data.goldGummies,
		rebirthCount = data.rebirthCount,
		rebirthMult  = data.rebirthMult,
		baerchis     = countBaerchis(data),
		towers       = data.towers,
		towerProgress = data.island.towerProgress,
		buildings    = buildings,
		eggStock     = data.island.eggStock,
	}
end

-- Waehrung schenken. Ohne rebirthMult, du bekommst exakt die Zahl.
commands.give = function(player, _data, gummies: any, gold: any)
	EconomyService.awardGummiesFlat(player, tonumber(gummies) or 100000)
	EconomyService.awardGoldGummies(player, tonumber(gold) or 1000)
	return commands.info(player, PlayerService.getDataOrError(player))
end

-- Alle Baerchis als flache Liste (uid zum Weiterverwenden)
commands.list = function(_player, data)
	local out = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(out, {
			uid      = uid,
			configId = baerchi.configId,
			rarity   = baerchi.rarity,
			level    = baerchi.level,
			xp       = baerchi.xp,
			fusion   = baerchi.isFusionResult,
			bonus    = baerchi.fusionBonus,

			-- v8: die zweite Fortschrittsachse. `charms` bewusst nur als Anzahl
			-- — die Detailwerte holt man sich ueber "charms <uid>", sonst wird
			-- die Liste in der Command Bar unlesbar.
			promo    = baerchi.promotionLevel or 0,
			stats    = baerchi.statLevels,
			charms   = #(baerchi.charms or {}),
			mutation = baerchi.mutation,
		})
	end
	table.sort(out, function(a, b) return a.uid < b.uid end)
	return out
end

-- Baerchi direkt erzeugen, ohne Ei.
--
-- Das dritte Argument setzt eine Mutation (siehe BaerchiConfig.MUTATIONS fuer
-- gueltige Namen: Gold/Diamond/Bloodrot/Celestial/Candy/Lava/Galaxy/Rainbow).
-- Ohne diesen Weg waeren Mutationen in Studio praktisch nicht testbar: die
-- Gesamtchance beim Schluepfen liegt bei 1.5%, die seltenste Stufe (Rainbow)
-- bei 0.0005% — man muesste also im Schnitt 200'000 Eier ausbrueten.
--   D:Invoke("add", "RedBaerchi", 10)              -- normal
--   D:Invoke("add", "RedBaerchi", 10, "Rainbow")   -- mit Mutation
commands.add = function(player, data, configId: any, level: any, mutation: any)
	local mutationId: any = nil
	if typeof(mutation) == "string" and BaerchiConfig.MUTATIONS[mutation :: any] then
		mutationId = mutation
	end

	local baerchi = BaerchiFactory.create(tostring(configId), {
		level    = tonumber(level) or 1,
		mutation = mutationId,
	})
	if not baerchi then
		return { error = "Unbekannter configId: " .. tostring(configId) }
	end

	data.island.baerchis[baerchi.uid] = baerchi
	PlayerService.markDirty(player)

	return {
		uid      = baerchi.uid,
		configId = baerchi.configId,
		rarity   = baerchi.rarity,
		level    = baerchi.level,
		mutation = baerchi.mutation,
	}
end

-- Die Kampfwerte eines Baerchis so, wie der Kampf sie sieht. Praktisch, um
-- Promotion, Stat-Stufen, Charms und Mutation gegeneinander nachzurechnen.
commands.stats = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		return { error = "Unbekannter configId: " .. baerchi.configId }
	end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)

	return {
		configId = baerchi.configId,
		level    = baerchi.level,
		mutation = baerchi.mutation,
		promo    = baerchi.promotionLevel or 0,
		maxHp    = stats.maxHp,
		atk      = stats.atk,
		spd      = stats.spd,
		pwrProzent = math.floor(stats.pwr * 100 + 0.5),
		skill    = stats.skillId,
	}
end

-- Gebaeude-Level direkt setzen (umgeht die Kosten)
commands.building = function(player, data, buildingId: any, level: any)
	local building = data.island.buildings[buildingId]
	if not building then
		return { error = "Unbekanntes Gebaeude: " .. tostring(buildingId) }
	end

	-- clampBuildingLevel rundet mit ab: ohne das landete eine 5.5 aus der
	-- Command Bar als Kommazahl in den Daten und jedes spaetere
	-- string.format("%d", level) wuerde daran scheitern.
	building.level = EconomyConfig.clampBuildingLevel(tonumber(level) or 1)
	MapService.updateBuildingLevel(player, buildingId, building.level)
	PlayerService.markDirty(player)

	return { building = buildingId, level = building.level, look = BuildingBehavior.getLook(building.level) }
end

-- v12: Ei ins Lager legen und sofort oeffnen (es gibt keine Brut mehr)
commands.hatch = function(player, data, eggType: any)
	local egg = tostring(eggType or "BasicEgg")
	if not EggConfig.data[egg :: Types.EggType] then
		return { error = "Unbekannter Egg-Typ: " .. egg }
	end

	data.island.eggStock[egg :: Types.EggType] = (data.island.eggStock[egg :: Types.EggType] or 0) + 1
	local result = EggService.openEgg(player, egg :: Types.EggType)
	if not result then
		return { error = "Oeffnen fehlgeschlagen" }
	end

	return {
		configId = result.baerchi.configId,
		rarity   = result.baerchi.rarity,
		mutation = result.baerchi.mutation,
		neu      = result.isNew,
	}
end

-- v12: Eier ins Lager legen, ohne sie zu oeffnen (fuer Tests im Ei-Menue)
commands.egg = function(player, data, eggType: any, count: any)
	local egg = tostring(eggType or "BasicEgg")
	if not EggConfig.data[egg :: Types.EggType] then
		return { error = "Unbekannter Egg-Typ: " .. egg }
	end

	local amount = math.clamp(tonumber(count) or 1, 1, 100)
	data.island.eggStock[egg :: Types.EggType] = (data.island.eggStock[egg :: Types.EggType] or 0) + amount
	PlayerService.markDirty(player)
	return { lager = data.island.eggStock }
end

-- v12/v15: gespeicherten letzten Lauf im gewaehlten Tower setzen (0 = loeschen)
commands.pitprogress = function(player, data, stage: any)
	local reached = math.floor(tonumber(stage) or 0)
	local towerId = data.towers.selected
	data.island.towerProgress[towerId] = if reached > 0 then reached else nil
	PlayerService.markDirty(player)
	return { tower = towerId, towerProgress = data.island.towerProgress }
end

-- v15: Tower waehlen (auch einen noch geschlossenen) und ab `stage` kaempfen.
-- Die Fortsetzungs-Kosten werden vorher gutgeschrieben (Test ohne Grind).
commands.tower = function(player, data, towerId: any, stage: any)
	local id = tostring(towerId or "I")
	local def = TowerConfig.get(id)
	if not def then
		return { error = "Unbekannter Tower: " .. id .. " (I, II, III, Final)" }
	end
	local uid = data.island.equippedUid
	if not uid then
		return { error = "Kein Baerchi ausgeruestet" }
	end
	TowerService.debugOpenAll(data)
	data.towers.selected = id
	local start = math.clamp(math.floor(tonumber(stage) or 1), 1, def.stages)
	local choice = "Fresh"
	if start > 1 then
		data.island.towerProgress[id] = start
		local _, cost = CombatService.getResumeOffer(data, id, "Last")
		if cost > 0 then EconomyService.awardGummiesFlat(player, cost) end
		choice = "Last"
	end
	PlayerService.markDirty(player)
	task.spawn(PetModeService.request, player, "Fight", choice :: any)
	return {
		tower = id, ab = start, deckel = TowerConfig.getStageCap(data.rebirthCount, id, data.towers.records),
		gegnerStage1 = TowerConfig.getEnemyStats(id, start),
	}
end

-- v15: Tower-Rekord direkt setzen (Meilensteine bis dorthin werden ausgezahlt)
commands.towerrecord = function(player, data, towerId: any, stage: any)
	local id = tostring(towerId or "I")
	if not TowerConfig.get(id) then
		return { error = "Unbekannter Tower: " .. id }
	end
	TowerService.debugSetRecord(player, id, tonumber(stage) or 0)
	return { towers = data.towers }
end

-- v15: Deckel des aktuellen Rebirths
commands.rebirthcap = function(_player, data)
	local caps: { [string]: number } = {}
	for _, def in TowerConfig.TOWERS do
		caps[def.id] = TowerConfig.getStageCap(data.rebirthCount, def.id, data.towers.records)
	end
	local capTower, capStage = TowerConfig.getCap(data.rebirthCount)
	return { rebirths = data.rebirthCount, deckelTower = capTower, deckelStage = capStage, proTower = caps }
end

-- Sammel-Update 05.10. (Paket 4.1): beste Stage dieses Lebens setzen und die
-- Rebirth-Bedingung zeigen. D:Invoke("stagebest", "I", 30)
commands.stagebest = function(player, data, towerId: any, stage: any)
	if typeof(towerId) == "string" and TowerConfig.get(towerId) then
		data.island.stageBest[towerId] = math.max(0, math.floor(tonumber(stage) or 0))
		PlayerService.markDirty(player)
	end
	local reqTower, reqStage = TowerConfig.getRebirthRequirement(data.rebirthCount, data.towers.records)
	return {
		stageBest  = data.island.stageBest,
		bedingung  = reqTower .. "/" .. reqStage,
		bereit     = TowerConfig.isRebirthReady(data.rebirthCount, data.island.stageBest, data.towers.records),
	}
end

-- Sammel-Update 05.10. (Paket 8): Inkubator-Stand; "done" macht alle Eier fertig.
commands.incubator = function(player, data, action: any)
	local incubator = data.island.incubator
	if action == "done" then
		for _, entry in incubator.slots do entry.finishAt = os.time() end
		PlayerService.markDirty(player)
	elseif action == "breed" then
		-- INCUBATOR_BREED: jedes Baerchi im Inkubator bruetet sofort ein Ei.
		-- Lazy require: kein weiterer Modul-Local (200er-Grenze).
		local made = require(ServerScriptService.Services.IncubatorService).breedNow(player)
		return { gebruetet = made, baerchis = incubator.breeders }
	end
	return { level = incubator.level, plaetze = incubator.slots, baerchis = incubator.breeders }
end

-- v15: Login-Bonus — so tun, als waeren `days` Tage vergangen
commands.dailyshift = function(player, _data, days: any)
	return LoginBonusService.debugShift(player, math.floor(tonumber(days) or 1))
end

-- v15: Bestenlisten sofort schreiben und neu lesen
commands.lbflush = function(_player, _data)
	return LeaderboardService.flush()
end

-- v15: Teile auf der eigenen Insel zaehlen (Budget: 250 ohne Baerchi-Figuren)
commands.parts = function(player, _data)
	return MapService.countParts(player) or { error = "kein Plot" }
end

-- Welt aufwerten: Debug-Signale an die Client-Controller (workspace-Attribute,
-- siehe WorldFXKit.onDebug). Ein Zaehler im Wert sorgt dafuer, dass derselbe
-- Befehl zweimal hintereinander auch zweimal ausloest.
local _worldSignal = 0
local function worldSignal(attribute: string, value: any)
	_worldSignal += 1
	workspace:SetAttribute(attribute, if value == nil then tostring(_worldSignal) else value)
end

commands.worldshots = function(_player, _data, index: any)
	local n = tonumber(index)
	if n == nil then
		local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
		local names = {}
		for _, shot in WorldFXConfig.WORLD_SHOTS do table.insert(names, shot.name) end
		return { hinweis = "worldshots <1..6> (0 = zurueck)", punkte = names }
	end
	_worldSignal += 1
	workspace:SetAttribute("DebugWorldShot", string.format("%d|%d", n, _worldSignal))
	return { punkt = n }
end

commands.daytime = function(_player, _data, hour: any)
	local h = tonumber(hour)
	workspace:SetAttribute("DebugDayTime", if h then h else -1)
	return { tageszeit = if h then h else "auto" }
end

commands.pitstate = function(_player, _data, state: any)
	local value = tostring(state or "auto")
	workspace:SetAttribute("DebugPitState", value)
	return { pit = value }
end

commands.neststate = function(_player, _data, state: any)
	local value = tostring(state or "auto")
	workspace:SetAttribute("DebugNestState", value)
	return { nest = value }
end

commands.arrival = function(_player, _data)
	worldSignal("DebugArrival", nil)
	return { ankunft = true }
end

commands.fish = function(_player, _data)
	worldSignal("DebugFish", nil)
	return { fisch = true }
end

-- Paket D: Insel-Stufe am Player-Attribut (wie PlotDisplayService), "auto"
-- rechnet sie aus dem Spielstand neu.
commands.islandstage = function(player, data, stage: any)
	local IslandStage = require(ReplicatedStorage.Modules.IslandStage)
	local n = tonumber(stage)
	local value = if n then math.clamp(math.floor(n), 1, IslandStage.MAX)
		else IslandStage.compute(data.towers and data.towers.records, data.rebirthCount or 0)
	player:SetAttribute("IslandStage", value)
	return { stufe = value }
end

-- Paket D: Teich voll (alle Honig-Lager voll, wie "honey"), damit der Ueberlauf laeuft
commands.pondfull = function(player, data)
	local result = commands.honey(player, data)
	return { teich = "voll", honig = result }
end

-- Paket E: Zuschauer-Baerchis an der eigenen Arena testen
commands.spectators = function(player, _data, mode: any)
	_worldSignal += 1
	workspace:SetAttribute("DebugSpectators", string.format("%d|%s|%d", player.UserId, tostring(mode or "hop"), _worldSignal))
	return { zuschauer = tostring(mode or "hop") }
end

-- Paket G: Welt-Moment wie vom Server erkannt an alle schicken (ohne den
-- Spielstand zu aendern). Erzwingt "gross", damit man jede Art sieht.
commands.moment = function(player, _data, kind: any, value: any)
	local WorldMomentService = require(ServerScriptService.Services.WorldMomentService)
	local k = tostring(kind or "hatch")
	local defaults = { hatch = "Cosmic", tower = "II", record = "I", rebirth = "1", mutation = "Galaxy" }
	local v = if value ~= nil then tostring(value) else defaults[k] or "?"
	WorldMomentService.announce(player, { kind = k :: any, value = v, number = 42 }, true)
	return { moment = k, wert = v }
end

-- Paket G: fuenf grosse Momente auf einmal (Client muss sie nacheinander zeigen)
commands.moments5 = function(player, _data)
	local WorldMomentService = require(ServerScriptService.Services.WorldMomentService)
	for _, m in { { "hatch", "Mythic" }, { "tower", "III" }, { "rebirth", "2" }, { "mutation", "Rainbow" }, { "hatch", "Omega" } } do
		WorldMomentService.announce(player, { kind = m[1] :: any, value = m[2], number = 2 }, true)
	end
	return { momente = 5 }
end

-- Paket E: Rekord-Moment am eigenen Schau-Turm
commands.record = function(player, _data)
	_worldSignal += 1
	workspace:SetAttribute("DebugRecord", string.format("%d|%d", player.UserId, _worldSignal))
	return { rekord = true }
end

-- v15: den aktuellen Spielstand in ein v14-Format zuruckverwandeln (Topf L7,
-- Presse L4, PIT 5, letzter Lauf Stage 12) und durch die Migration schicken —
-- das Ergebnis wird NICHT uebernommen, nur angezeigt (Migrations-Probe).
commands.v14save = function(_player, data)
	local HttpServiceLocal = game:GetService("HttpService")
	local copy = HttpServiceLocal:JSONDecode(HttpServiceLocal:JSONEncode(data))
	copy.version = 14
	copy.towers = nil
	copy.daily = nil
	copy.island.towerProgress = nil
	copy.island.pitRefund = nil
	copy.island.pitLevel = 5
	copy.island.pitProgress = { pitLevel = 5, reachedStage = 12 }
	copy.island.buildings.HoneyRefiner = nil
	copy.island.buildings.HoneyPot   = { id = "HoneyPot",   level = 7, honey = 4, lastProducedAt = os.time() }
	copy.island.buildings.HoneyPress = { id = "HoneyPress", level = 4, honey = 5, lastProducedAt = os.time() }
	local migrated = PlayerMigration.applyDefaults(copy)
	return {
		version   = migrated.version,
		veredler  = migrated.island.buildings.HoneyRefiner,
		erstattung = migrated.island.pitRefund,
		rekorde   = migrated.towers.records,
	}
end

commands.petmode = function(player, data)
	local pitPhase, stage = PitArenaService.getPhase(player)
	return {
		zuHause     = PetModeService.isHome(player),
		pit         = pitPhase,
		stage       = stage,
		event       = EventParticipationService.getPhase(player),
		-- Sammel-Update Paket 1.1: wer haelt die Figur gerade? (UFO-Einfrieren)
		lockHalter  = ActivityLock.owner(player) or "frei",
		entfuehrt   = EventParticipationService.isAbducting(player),
		towerProgress = data.island.towerProgress,
		eggStock    = data.island.eggStock,
		gummies     = data.gummies,
		lastEggAt   = data.island.lastEggAt,
	}
end

commands.pm = function(player, data, mode: any, resume: any)
	PetModeService.request(player, tostring(mode or "Home"), if resume then tostring(resume) :: any else nil)
	return commands.petmode(player, data)
end

commands.fight = function(player, _data, uid: any)
	CombatService.startPitRun(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

-- Alle Honig-Lager sofort fuellen (umgeht die Wartezeit).
-- Ohne das dauert jeder Level-Test 20 Sekunden pro Honig.

-- v15: Waben im Event-Pit legen und Zustand ausgeben
commands.combs = function(player, data, n: any)
	local count = if typeof(n) == "number" then math.clamp(math.floor(n), 0, 100) else 0
	if count > 0 then
		CombService.debugSpawn(count)
	end

	local recycler = data.island.recycler
	local slots = CombService.getSlotInfo()
	return {
		wabenImPit    = CombService.getWorldCount(),
		getragen      = CombService.getCarriedCount(player),
		getragenAlle  = slots.held,
		respawnQueue  = slots.queued,
		slotLimit     = slots.limit,
		recyclerLevel = recycler.level,
		warteschlange = recycler.queued,
	}
end

-- v17: naechsten UFO-Abwurf als Jackpot erzwingen; Stand des Pity-Zaehlers
commands.jackpot = function(_player, _data)
	JackpotRoll.ufo.forceNext = true
	return {
		naechsterIstJackpot = true,
		abwuerfeSeitJackpot = JackpotRoll.ufo.sinceLast,
		abwuerfeGesamt      = JackpotRoll.ufo.total,
		jackpotsGesamt      = JackpotRoll.ufo.jackpots,
		pity                = EventConfig.UFO.JACKPOT_PITY_DROPS,
	}
end

-- v17: Wabenthema setzen ("off" = normal)
commands.combtheme = function(_player, _data, themeId: any)
	local id = if typeof(themeId) == "string" and themeId ~= "off" then themeId else nil
	CombService.setTheme(id)
	local slots = CombService.getSlotInfo()
	return { thema = CombService.getTheme() or "normal", wabenImPit = slots.world, slotLimit = slots.limit }
end

-- v17: Waben einfliegen lassen (wie ein Vulkan-Ausbruch aus der Pit-Mitte)
commands.launch = function(_player, _data, n: any)
	local count = if typeof(n) == "number" then math.clamp(math.floor(n), 1, 30) else 10
	local origin = MapService.getEventPitPosition() + Vector3.new(0, 2, 0)
	return { gestartet = CombService.launchCombs(count, origin), slots = CombService.getSlotInfo() }
end

-- v15: Wabeneinheiten direkt in die Warteschlange des Recyclers legen
commands.queue = function(player, data, n: any)
	local units = if typeof(n) == "number" then math.clamp(math.floor(n), 0, 100000) else 0
	if units > 0 then
		CombRecyclerService.deposit(player, units)
	end

	local recycler = data.island.recycler
	return {
		warteschlange = recycler.queued,
		level         = recycler.level,
		gummies       = data.gummies,
	}
end

-- v15: Recycler-Level direkt setzen (ohne Kosten)
commands.recycler = function(player, data, level: any)
	local recycler = data.island.recycler
	if typeof(level) == "number" then
		recycler.level = CombConfig.clampLevel(level)
		PlayerService.markDirty(player)
	end

	return {
		level         = recycler.level,
		gummiesJeEinheit = CombConfig.getPayPerUnit(recycler.level),
		einheitenProSek  = CombConfig.getSpeed(recycler.level),
		warteschlange = recycler.queued,
	}
end

commands.honey = function(player, data)
	local filled: { [string]: number } = {}

	for _, building in data.island.buildings do
		-- Lager DIESES Gebaeudes auf DIESEM Level: der Bienenstock fasst seit
		-- v7 mehr als die anderen beiden.
		building.honey          = BuildingBehavior.getCapacity(building.id, building.level)
		building.lastProducedAt = os.time()
		filled[building.id]     = building.honey
	end

	PlayerService.markDirty(player)
	return { honey = filled }
end

-- Einen Baerchi fuettern (heilt + gibt XP), so oft wie angegeben
commands.feed = function(player, _data, uid: any, times: any)
	local count = math.clamp(tonumber(times) or 1, 1, 100)

	for _ = 1, count do
		HoneyService.feed(player, tostring(uid))
	end

	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Fusion. Die beiden letzten Argumente sind der Sperr-Schritt aus dem
-- Fusions-Menue (siehe FusionService, Regel C) und duerfen weggelassen werden —
-- dann laeuft alles automatisch.
--   D:Invoke("fuse", uidA, uidB)                   -- alles automatisch
--   D:Invoke("fuse", uidA, uidB, "ability", "B")   -- Skill kommt von B
commands.fuse = function(player, _data, uidA: any, uidB: any, lockedProperty: any, lockedFrom: any)
	local property = if lockedProperty ~= nil then tostring(lockedProperty) else nil
	local from     = if lockedFrom ~= nil then tostring(lockedFrom) else nil

	FusionService.fuse(player, tostring(uidA), tostring(uidB), property :: any, from :: any)
	return commands.list(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v8: Promotion, Charms, Event-Teilnahme
--------------------------------------------------------------------------------

-- Befoerdern. Legt die noetigen Duplikate NICHT selbst an — wer testen will,
-- ruft vorher mehrfach "add <configId>" auf. Genau so merkt man, ob die
-- Material-Pruefung tut, was sie soll.
commands.promote = function(player, _data, uid: any)
	PromotionService.promote(player, tostring(uid))
	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Charms wuerfeln. Kostet echte GoldGummies — vorher "give 0 100000".
commands.roll = function(player, _data, uid: any, times: any)
	CharmService.rollCharms(player, tostring(uid), tonumber(times) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Alle acht Slots eines Baerchis im Klartext.
commands.charms = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local bySlot: { [number]: any } = {}
	for _, charm in baerchi.charms or {} do
		bySlot[charm.slot] = charm
	end

	local out = {}
	for slot = 1, CharmConfig.SLOT_COUNT do
		local charm = bySlot[slot]
		out[slot] = {
			slot     = CharmConfig.SLOT_NUMERALS[slot],
			offen    = CharmConfig.isSlotUnlocked(slot, baerchi.promotionLevel or 0),
			abPromo  = CharmConfig.getUnlockPromotion(slot),
			rarity   = if charm then charm.rarity else nil,
			effekt   = if charm then CharmConfig.describe(charm) else nil,
			gesperrt = if charm then charm.locked else nil,
		}
	end

	return { promotion = baerchi.promotionLevel or 0, slots = out }
end

-- Einen Charm-Slot sperren/freigeben.
commands.lock = function(player, _data, uid: any, slot: any)
	CharmService.toggleLock(player, tostring(uid), tonumber(slot) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Den ausgeruesteten Baerchi zum Event schicken bzw. zurueckholen.
commands.event = function(player, _data)
	EventParticipationService.sendToEvent(player)
	return { unterwegs = true }
end

commands.recall = function(player, _data)
	EventParticipationService.recall(player)
	return { unterwegs = true }
end

--------------------------------------------------------------------------------
-- v10: Eier legen
--------------------------------------------------------------------------------

-- Legt sofort ein Ei, ohne auf das Intervall zu warten. Mehrfach aufrufen, um
-- den Plot zu fuellen und die Obergrenze zu pruefen.
commands.lay = function(player, _data, times: any)
    local count  = math.clamp(tonumber(times) or 1, 1, 30)
    local laid   = 0

    for _ = 1, count do
        if EggLayService.layNow(player) then
            laid += 1
        else
            break   -- Obergrenze erreicht oder kein Baerchi ausgeruestet
        end
    end

    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Was gerade herumliegt, plus die Werte des ausgeruesteten Legers.
commands.eggs = function(_player, data)
    local out = {}
    for _, egg in data.island.laidEggs or {} do
        table.insert(out, { uid = egg.uid, typ = egg.eggType })
    end

    local uid     = data.island.equippedUid
    local baerchi = if uid then data.island.baerchis[uid] else nil

    local rate: any = "kein Baerchi ausgeruestet"
    local chancen: any = nil

    if baerchi then
        local online  = EggCalculator.getLayIntervalSeconds(baerchi, false)
        local offline = EggCalculator.getLayIntervalSeconds(baerchi, true)

        rate = {
            configId       = baerchi.configId,
            level          = baerchi.level,
            eggStufe       = (baerchi.statLevels :: any).egg or 0,
            mutation       = baerchi.mutation,
            sekundenOnline = if online then math.floor(online + 0.5) else nil,
            sekundenOffline= if offline then math.floor(offline + 0.5) else nil,
        }

        chancen = {}
        for _, chance in EggCalculator.getChances(baerchi) do
            table.insert(chancen, string.format("%s %.0f%%", chance.eggType, chance.percent))
        end
    end

    return {
        liegen  = #out,
        maximum = EggConfig.MAX_UNCOLLECTED_EGGS,
        eier    = out,
        lager   = data.island.eggStock,
        leger   = rate,
        chancen = chancen,
    }
end

-- Alle herumliegenden Eier einsammeln (dasselbe wie der Knopf auf der Karte).
commands.collect = function(player, _data)
    EggLayService.collectAll(player)
    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Die Zeitmarke kuenstlich in die Vergangenheit setzen und danach nachrechnen
-- lassen — so laesst sich das OFFLINE-Nachholen pruefen, ohne den Server zu
-- verlassen. Der naechste Tick (max. 5s) legt dann die faelligen Eier.
--
-- Achtung: der Tick rechnet mit der ONLINE-Rate. Das echte Offline-Verhalten
-- (langsamer, siehe EggConfig.OFFLINE_SLOWDOWN) sieht man nur beim Rejoin.
commands.eggtime = function(player, data, minutes: any)
    local back = math.clamp(tonumber(minutes) or 30, 1, 10000)
    data.island.lastEggAt = os.time() - back * 60
    PlayerService.markDirty(player)

    return { zurueckgestellt = back .. " Minuten", hinweis = "naechster Tick legt nach (max. 5s)" }
end

-- Die laufende Phase sofort beenden. Zweimal aufgerufen bekommt man also aus
-- der Pause heraus ein vollstaendiges Event samt Belohnung, ohne acht Minuten
-- zu warten:
--   D:Invoke("skipevent")   -- Pause vorbei, Event laeuft
--   D:Invoke("event")       -- Baerchi hinschicken, ankommen lassen
--   D:Invoke("skipevent")   -- Event vorbei → Stat-Stufe wird vergeben
commands.skipevent = function(_player, _data)
	EventService.skipPhase()

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		belohnung    = if active then Loc.resolve(EventConfig.describeReward(active)) else nil,
		naechstes    = EventService.getNext().displayName,
		restSekunden = EventService.getRemainingSeconds(),
	}
end

-- Der ganze Katalog mit Belohnung, in der Reihenfolge, in der die Events
-- laufen. Praktisch, um die ids fuer "startevent" nachzuschlagen.
commands.events = function(_player, _data)
	local katalog = {}
	for index, def in EventConfig.EVENTS do
		table.insert(katalog, string.format(
			"%d. %s (%s) — %s",
			index, def.displayName, def.id, Loc.resolve(EventConfig.describeReward(def))
		))
	end

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		restSekunden = EventService.getRemainingSeconds(),
		naechstes    = EventService.getNext().displayName,
		takt         = string.format(
			"individuelle Dauer je Event / %ds Pause",
			EventConfig.EVENT_GAP_SECONDS
		),
		katalog      = katalog,
	}
end

-- Ein BESTIMMTES Event sofort starten, statt sich durch den Zyklus zu warten.
-- Ein voller Durchlauf durch alle zehn Events dauert 80 Minuten — ohne diesen
-- Befehl waere z.B. der Mutations-Sturm praktisch nicht testbar.
--
-- Laeuft gerade ein anderes Event, wird es vorher ordentlich beendet (die
-- Anwesenden bekommen also noch ihre Belohnung, siehe EventService.startById).
commands.startevent = function(_player, _data, id: any)
	local eventId = tostring(id or "")

	if not EventService.startById(eventId) then
		local ids = {}
		for _, def in EventConfig.EVENTS do
			table.insert(ids, def.id)
		end
		return { error = "Unbekannte Event-id: " .. eventId, verfuegbar = ids }
	end

	local active = EventService.getActive()
	return {
		gestartet    = if active then active.displayName else "?",
		belohnung    = if active then Loc.resolve(EventConfig.describeReward(active)) else nil,
		restSekunden = EventService.getRemainingSeconds(),
		hinweis      = "jetzt 'event' aufrufen, um den Baerchi hinzuschicken — er muss beim ENDE dort stehen",
	}
end

commands.recycle = function(player, _data, uid: any)
	RecycleService.recycle(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.upgrade = function(player, _data, buildingId: any)
	IslandService.upgradeBuilding(player, buildingId)
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.rebirth = function(player, _data)
	RebirthService.rebirth(player)
	return commands.info(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v14: Ei-Baum
--------------------------------------------------------------------------------

commands.tree = function(_player, data)
	local out = { blueprints = data.eggTree.blueprints, rebirths = data.rebirthCount }
	for _, eggId in EggConfig.getOrderedIds() do
		local p = EggTree.getProgress(data, eggId)
		local parts = {}
		for _, c in p.conditions do
			local label = c.kind .. (if c.egg then ":" .. c.egg elseif c.rarity then ":" .. c.rarity else "")
			table.insert(parts, string.format("%s %d/%d%s", label, c.have, c.need, if c.done then " ok" else ""))
		end
		out[string.format("%02d %s", EggConfig.data[eggId].sortOrder, eggId)] = string.format("%s | hatched %d | lager %d | %s",
			if p.unlocked then "FREI" else "zu", data.eggTree.hatched[eggId] or 0,
			data.island.eggStock[eggId] or 0, table.concat(parts, ", "))
	end
	return out
end

commands.unlock = function(player, data, eggType: any)
	if eggType == "all" then
		for _, eggId in EggConfig.getOrderedIds() do
			EggTreeService.forceUnlock(player, data, eggId, "debug")
		end
	elseif typeof(eggType) == "string" and EggConfig.data[eggType :: Types.EggType] then
		EggTreeService.forceUnlock(player, data, eggType :: Types.EggType, "debug")
	else
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.hatched = function(player, data, eggType: any, count: any)
	if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	data.eggTree.hatched[eggType] = math.max(0, math.floor(tonumber(count) or 0))
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.blueprint = function(player, data, amount: any)
	EggTreeService.grantBlueprint(player, data, tonumber(amount) or 1)
	PlayerService.markDirty(player)
	return { blueprints = data.eggTree.blueprints }
end

commands.useblueprint = function(player, data, eggType: any)
	local ok = EggTreeService.useBlueprint(player, eggType)
	return { ok = ok, tree = commands.tree(player, data) }
end

commands.press = function(player, data, eggType: any, path: any)
	local result = EggTreeService.press(player, eggType, path)
	return { result = result, stock = data.island.eggStock }
end

commands.setrebirth = function(player, data, count: any)
	data.rebirthCount = math.max(0, math.floor(tonumber(count) or 0))
	data.rebirthMult  = EconomyConfig.getRebirthMult(data.rebirthCount)
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

-- Spielstand fuer Tests sichern und zuruecksetzen. Die Kopie liegt nur im
-- Speicher dieses Servers (nicht im DataStore).
local HttpService = game:GetService("HttpService")
local _snapshot: string? = nil

commands.snapshot = function(_player, data)
	_snapshot = HttpService:JSONEncode(data)
	return { ok = true, bytes = #(_snapshot :: string) }
end

commands.restore = function(player, data)
	if not _snapshot then return { error = "Kein Snapshot" } end
	local saved = HttpService:JSONDecode(_snapshot :: string)
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in saved do (data :: any)[k] = v end
	MapService.rebuildIsland(player, data.island)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return { ok = true }
end

-- HBB Paket 0: feste Test-Zustaende fuer Playtests und Studio-Testschritte.
--   fresh   = Startstand eines neuen Kontos (createdAt = jetzt → Trichter misst)
--   hatch10 = fresh + zehn geoeffnete Basis-Eier
--   tower1  = hatch10 + Tower I geschafft (Rekord 30, Meilensteine ausgezahlt)
--
-- Studio spielt gegen den ECHTEN DataStore. Deshalb verlangt der Befehl einen
-- vorherigen "snapshot"; zurueck geht es mit "restore". Der Snapshot liegt nur
-- im Speicher dieses Servers — vor "Stop" also restore aufrufen.
--
-- Der Baerchi sollte zu Hause stehen (kein Kampf, kein Event), sonst haelt ein
-- anderer Service noch die alte Figur.
local TEST_STATES = { fresh = true, hatch10 = true, tower1 = true }
local TEST_HATCH_COUNT = 10
local TEST_TOWER_RECORD = 30

commands.state = function(player, data, name: any)
	local stateName = tostring(name or "")
	if not TEST_STATES[stateName] then
		return { error = "Unbekannter Zustand: " .. stateName, verfuegbar = { "fresh", "hatch10", "tower1" } }
	end
	if not _snapshot then
		return { error = "Erst D:Invoke(\"snapshot\") — Studio schreibt in den echten Spielstand" }
	end

	-- 1. fresh: alles ersetzen ausser Sitzungs-Sperre und Sprache
	local session  = (data :: any).session
	local language = data.language
	local fresh = PlayerService.buildDefaultData()
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in fresh :: any do (data :: any)[k] = v end
	;(data :: any).session = session
	data.language = language
	MapService.rebuildIsland(player, data.island)
	FunnelService.debugReset(player)

	-- 2. hatch10: ueber den echten Weg oeffnen, damit Zaehler, Index und
	-- Auto-Ausruesten genau wie im Spiel laufen.
	if stateName == "hatch10" or stateName == "tower1" then
		data.island.eggStock.BasicEgg = (data.island.eggStock.BasicEgg or 0) + TEST_HATCH_COUNT
		for _ = 1, TEST_HATCH_COUNT do
			EggService.openEgg(player, "BasicEgg")
		end
	end

	-- 3. tower1: Rekord setzen, Meilensteine wie bei "towerrecord"
	if stateName == "tower1" then
		TowerService.debugSetRecord(player, "I", TEST_TOWER_RECORD)
	end

	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return {
		ok = true,
		zustand = stateName,
		baerchis = countBaerchis(data),
		lager = data.island.eggStock,
		rekorde = data.towers.records,
		hinweis = "Zurueck mit D:Invoke(\"restore\")",
	}
end

-- Ein einzelner Kampf mit Runden-Log (Faehigkeiten pruefen).
commands.skilltest = function(_player, _data, configId: any, stage: any)
	local b = BaerchiFactory.create(tostring(configId), { level = 20 })
	if not b then return { error = "Unbekannter Baerchi" } end
	local def = BaerchiConfig.getById(b.configId)
	local stats = CombatCalculator.getEffectiveStats(b, (def :: any).baseStats)
	local es = CombatConfig.getEnemyStats(1, tonumber(stage) or 20)
	local me = { uid = "me", stats = stats, hp = stats.maxHp, charge = 0 }
	local en = { uid = "en", stats = es, hp = es.maxHp, charge = 0 }
	local r = CombatCalculator.simulate(me, en)
	local lines = {}
	for i, e in r.log do
		if i > 40 then break end
		table.insert(lines, string.format("%s r%d %s dmg %d heal %d abs %d | A %d B %d %s",
			e.actor, e.roundNumber, e.skillId or "-", e.damage, e.heal, e.absorbed,
			e.attackerHpAfter, e.defenderHpAfter, if e.effects then table.concat(e.effects, ",") else ""))
	end
	return { winner = r.winnerUid, rounds = r.rounds, skillUses = r.skillUses, log = lines }
end

commands.help = function()
	return {
		"info", "give <gummies> <gold>", "list",
		"add <configId> <level> [mutation]", "stats <uid>",
		"building <id> <level>",
		"hatch <eggType>", "egg <eggType> [anzahl]", "pitprogress <stage>", "honey", "feed <uid> <times>",
		"fight <uid>",
		"fuse <uidA> <uidB> [ability|level|eggs] [A|B]",
		"recycle <uid>", "upgrade <buildingId>", "rebirth",

		-- v8
		"promote <uid>", "charms <uid>", "roll <uid> [anzahl]", "lock <uid> <slot>",
		"event", "recall", "skipevent", "events", "startevent <eventId>",

		-- v10
		"eggs", "lay [anzahl]", "collect", "eggtime <minuten>",

		-- v12
		"petmode", "pm <Event|Fight|Home> [Fresh|Percent|Last]",

		-- v14
		"tree", "unlock <eggType|all>", "hatched <eggType> <n>", "blueprint [n]",
		"useblueprint <eggType>", "press <eggType> [Gold|Kristall|Void]", "setrebirth <n>",
		"skilltest <configId> [stage]", "snapshot", "restore",
		-- HBB Paket 0
		"state <fresh|hatch10|tower1>  (erst snapshot!)",

		-- v15
		"combs [anzahl]", "queue <einheiten>", "recycler [level]",

		-- v15 (Tower/Gebaeude/Angeben/Login-Bonus)
		"tower <I|II|III|Final> <stage>", "towerrecord <id> <stage>", "rebirthcap",
		"dailyshift <tage>", "lbflush", "parts", "v14save",

		-- v17
		"jackpot", "combtheme <themeId|off>", "launch [anzahl]",

		-- Welt aufwerten
		"worldshots [1..6|0]", "daytime <uhrzeit|auto>", "pitstate <idle|soon|live|auto>",
		"neststate <calm|boss|auto>", "arrival", "fish",
		"islandstage <1..4|auto>", "pondfull", "spectators <hop|cheer>", "record",
		"moment <hatch|tower|record|rebirth|mutation> [wert]", "moments5",
	}
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function DebugService.init()
	if not RunService:IsStudio() then
		return   -- im Live-Spiel gibt es diesen Service schlicht nicht
	end

	local existing = ServerScriptService:FindFirstChild(BINDABLE_NAME)
	if existing then existing:Destroy() end

	local bindable = Instance.new("BindableFunction")
	bindable.Name   = BINDABLE_NAME
	bindable.Parent = ServerScriptService

	bindable.OnInvoke = function(command: any, ...)
		local name = tostring(command or "help")
		local handler = commands[name]
		if not handler then
			return { error = "Unbekannter Befehl: " .. name, verfuegbar = commands.help() }
		end

		if name == "help" then
			return commands.help()
		end

		local player, data, reason = requireData()
		if not player or not data then
			return { error = reason }
		end

		local ok, result = pcall(handler, player, data, ...)
		if not ok then
			return { error = tostring(result) }
		end
		return result
	end

	print("[DebugService] Initialisiert | Command Bar: game.ServerScriptService." .. BINDABLE_NAME .. ":Invoke(\"help\")")
end

return DebugService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX26"><Properties>
<string name="Name">PlotDisplayService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PlotDisplayService.luau
-- ServerScriptService/Services/PlotDisplayService.luau
--
-- Einzige Zustaendigkeit:
--   - Entscheiden WANN die sichtbare Darstellung eines Plots nachgezogen
--     werden muss — und mit welchem der drei unterschiedlich teuren Wege.
--
-- Haengt an PlayerService.onDataChanged. Das feuert bei JEDER Aenderung, also
-- auch bei jedem einzelnen Gummy. Alles jedes Mal neu zu bauen waere
-- Verschwendung, deshalb merkt sich dieser Service drei Signaturen und
-- vergleicht sie:
--
--   STRUKTUR   (uid + Level jedes Baerchis)
--       → MapService.updateBaerchis: baut alle Mesh-Figuren neu. Teuer.
--         Noetig wenn ein Baerchi dazukommt, wegfaellt oder im Level steigt.
--
--   ZUSTAND    (uid + aktuelle HP)
--       → MapService.updateBaerchiStates: schreibt nur Beschriftung und
--         Erschoepfung an bestehende Figuren. Billig. HP aendern sich bei
--         jedem Fuettern und jedem PIT-Lauf — dafuer 25 Meshes neu zu bauen
--         waere absurd.
--
--   GEBAEUDE   (id + Level + Honig)
--       → MapService.updateBuildingSigns: schreibt die Schilder neu. Billig.
--         Honig aendert sich alle 20 Sekunden.
--
--   EIER       (uids der herumliegenden Eier)
--       → MapService.updateLaidEggs: baut die kleinen Kugeln neu. Billig —
--         es sind hoechstens zwoelf, und sie sind keine Meshes.
--         Aendert sich, wenn der Baerchi eines legt oder der Spieler eines
--         aufsammelt.
--
--   RECYCLER   (Level + Warteschlange des Waben-Recyclers)
--       → MapService.updateRecycler: schreibt Schild und Lampe. Billig.
--         Aendert sich jede Sekunde, solange der Recycler arbeitet.
--
--   LOOKS      (v15: Look-Stufe jedes Gebaeudes und des Recyclers)
--       → MapService.updateBuildingLooks: baut genau das Gebaeude neu, dessen
--         Look sich geaendert hat, mit kurzer Aufwertungs-Show. Haengt am
--         LOOK, nicht am Level — ein Ausbau innerhalb eines Looks schreibt nur
--         das Schild (GEBAEUDE oben).
--
--   STUFE      (Welt aufwerten, Paket D: Insel-Stufe 1..4 aus Towern und
--               Rebirths, Modules/IslandStage)
--       → Attribut "IslandStage" am Player (ueberlebt jeden Insel-Neuaufbau).
--         Die Deko baut nur der Client (PlotLifeController), der Server baut
--         dafuer kein einziges Teil.
--
--   TOWER      (v15: Look + Etagen + Schildtext des Tower-Turms)
--       → MapService.updateTowerShowcase (Neuaufbau des Turms, Show nur beim
--         Look-Wechsel) und MapService.setOwnerBadge (Symbol am Plot-Schild).
--         Aendert sich nur bei einem neuen Rekord oder Tower.
--
-- Die Figuren und Schilder selbst baut MapService — dieser Service entscheidet
-- nur WANN und WELCHE Tiefe.
--
-- EINE SACHE ENTSCHEIDET DIESER SERVICE BEWUSST NICHT: ob die Figur gerade
-- mitten in einer Bewegung steckt. Diese Sperre sitzt in
-- MapService.updateBaerchis selbst, damit sie fuer JEDEN Aufrufer gilt und
-- nicht an jeder Aufrufstelle wiederholt werden muss. Hier unten wird nur die
-- Quelle fuer frische Daten eingehaengt, mit der MapService den verschobenen
-- Neuaufbau spaeter nachholt (siehe init).
--
-- Wichtig fuer das Verstaendnis des Signatur-Vergleichs: eine verschobene
-- Darstellung gilt hier trotzdem sofort als "dargestellt". Das ist richtig, so
-- lange MapService das Nachholen uebernimmt — waere es andersherum, muesste
-- dieser Service den Zustand einer fremden Warteschlange mitverfolgen.
--
-- Ersetzt den frueheren BaerchiDisplayService, der nur die Figuren kannte und
-- inzwischen aus dem Projekt entfernt ist.

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local IncubatorRules = require(ReplicatedStorage.Modules.IncubatorRules)   -- Paket 8
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local IslandStage      = require(ReplicatedStorage.Modules.IslandStage)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)

local PlotDisplayService = {}

type Signatures = {
	incubator : string,   -- Sammel-Update Paket 8
	structure : string,
	state     : string,
	buildings : string,
	eggs      : string,
	recycler  : string,
	looks     : string,
	tower     : string,
	stage     : string,
}

local _signatures: { [Player]: Signatures } = {}

--------------------------------------------------------------------------------
-- Signaturen
--------------------------------------------------------------------------------

-- Was sich aendern muss, damit die Figur neu gebaut wird: welche Baerchis es
-- gibt, auf welchem Level sie stehen (das Level aendert die Groesse der
-- Beschriftung und kann spaeter das Modell aendern) — UND wer gerade
-- ausgeruestet ist, seit nur noch dieser eine sichtbar gebaut wird. Ohne
-- equippedUid hier wuerde ein Equip-Wechsel auf einen gleich hochstufigen
-- Baerchi denselben String ergeben und die Signatur haelt die Aenderung
-- faelschlich fuer bereits dargestellt.
--
-- Die MUTATION gehoert aus demselben Grund dazu: sie bestimmt Fellfarbe, Aura
-- und das Kuerzel auf dem Namensschild (siehe MapService.buildBaerchiFigure).
-- Normalerweise aendert sie sich nie nach dem Schluepfen — der Mutations-Sturm
-- (EventParticipationService) kann sie aber mitten im Spiel anheben, und ohne
-- diesen Eintrag liefe die Figur bis zum naechsten Insel-Neuaufbau in der
-- alten Farbe weiter.
local function structureSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, string.format("%s:%d:%s:%s", uid, baerchi.level, baerchi.mutation or "-", baerchi.rarity))
	end
	table.sort(parts)
	table.insert(parts, "equipped:" .. (data.island.equippedUid or ""))
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Beschriftung neu geschrieben wird.
local function stateSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, uid .. ":" .. baerchi.currentHp)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Gebaeude-Schilder neu geschrieben werden.
local function buildingSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d:%d", id, building.level, building.honey or 0))
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Eier neu gebaut werden: WELCHE Eier
-- herumliegen. Die Position gehoert bewusst nicht dazu — ein gelegtes Ei
-- bewegt sich nie, es kommt nur dazu oder verschwindet.
local function eggSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for _, egg in data.island.laidEggs or {} do
		table.insert(parts, egg.uid)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit Schild und Lampe des Waben-Recyclers neu
-- geschrieben werden: Level und Warteschlange.
local function recyclerSignature(data: Types.PlayerData): string
	local recycler = data.island.recycler
	return string.format("%d:%d", recycler.level, recycler.queued)
end

-- v15: Look-Stufen. Bewusst NICHT das Level: ein Gebaeude wird nur neu
-- gebaut, wenn es einen neuen Look bekommt (README 4.2).
local function lookSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d", id, BuildingBehavior.getLook(building.level)))
	end
	table.sort(parts)
	table.insert(parts, "Recycler:" .. BuildingBehavior.getLook(data.island.recycler.level))
	return table.concat(parts, "|")
end

-- v15: Tower-Turm: hoechster Tower (Look) und Rekord darin (Etagen + Schild).
local function towerSignature(data: Types.PlayerData): string
	local towerId, record = TowerConfig.bestRecord(data.towers)
	local highest = data.towers.highestTower
	if TowerConfig.getIndex(highest) > TowerConfig.getIndex(towerId) then
		towerId, record = highest, data.towers.records[highest] or 0
	end
	return string.format("%s:%d", towerId, record)
end

-- Sammel-Update Paket 8: Inkubator — belegte Plaetze (Ei + Zeitmarken),
-- Level und Platz-Zahl. Fortschritt rechnet der Client selbst.
local function incubatorSignature(data: Types.PlayerData): string
	local incubator = data.island.incubator
	if not incubator then return "" end
	local parts: { string } = { tostring(incubator.level), tostring(IncubatorRules.slotCountFor(data)) }
	for _, entry in incubator.slots do
		table.insert(parts, string.format("%d=%s@%d", entry.slot, entry.eggType, entry.finishAt))
	end
	-- INCUBATOR_BREED: Baerchis in den Plaetzen (Figur, Takt, letzte Brut)
	for _, entry in incubator.breeders or {} do
		local baerchi = data.island.baerchis[entry.uid]
		table.insert(parts, string.format("b%d=%s:%s:%s@%d", entry.slot, entry.uid,
			if baerchi then baerchi.rarity else "?", if baerchi then tostring(baerchi.mutation) else "",
			entry.lastEggAt))
	end
	return table.concat(parts, "|")
end

-- Paket D: Stufe der Insel-Deko
local function stageSignature(data: Types.PlayerData): string
	return tostring(IslandStage.compute(data.towers and data.towers.records, data.rebirthCount or 0))
end

local function allSignatures(data: Types.PlayerData): Signatures
	return {
		incubator = incubatorSignature(data),
		structure = structureSignature(data),
		state     = stateSignature(data),
		buildings = buildingSignature(data),
		eggs      = eggSignature(data),
		recycler  = recyclerSignature(data),
		looks     = lookSignature(data),
		tower     = towerSignature(data),
		stage     = stageSignature(data),
	}
end

-- Turm und Plot-Symbol aus dem Tower-Stand (Signatur "Tower:Rekord").
local function applyTower(player: Player, signature: string, show: boolean)
	local towerId, recordText = string.match(signature, "^([^:]+):(%d+)$")
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	local record = tonumber(recordText) or 0

	MapService.updateTowerShowcase(player, {
		look   = def.look,
		floors = TowerConfig.getShowcaseFloors(def.id, record),
		title  = Loc.msg("ui.world.showcase_title", {
			name = player.DisplayName, tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record,
		}),
		color  = def.color,
	}, show)
	MapService.setOwnerBadge(player, Loc.msg("ui.world.owner_badge", {
		tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record,
	}), def.color)
end

--------------------------------------------------------------------------------
-- Abgleich
--------------------------------------------------------------------------------

local function refresh(player: Player, data: Types.PlayerData)
	local current  = allSignatures(data)
	local previous = _signatures[player]

	if not previous then
		-- Noch keine Signatur (sollte nach onDataLoaded nicht vorkommen):
		-- einmal komplett nachziehen und merken.
		_signatures[player] = current
		MapService.updateBaerchis(player, data.island)
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		return
	end

	if previous.structure ~= current.structure then
		-- Neuaufbau schreibt die Zustaende gleich mit — ein zusaetzliches
		-- updateBaerchiStates waere doppelte Arbeit.
		MapService.updateBaerchis(player, data.island)

	elseif previous.state ~= current.state then
		MapService.updateBaerchiStates(player, data.island)
	end

	if previous.buildings ~= current.buildings then
		MapService.updateBuildingSigns(player, data.island)
	end

	-- Bewusst UNABHAENGIG vom Struktur-Zweig oben: updateBaerchis baut die Eier
	-- zwar mit, kann aber wegen einer laufenden Bewegung verschoben worden sein
	-- (ActivityLock). Genau dann legt der Baerchi aber weiter — und ein frisch
	-- gelegtes Ei soll nicht darauf warten, dass er ankommt.
	if previous.eggs ~= current.eggs then
		MapService.updateLaidEggs(player, data.island)
	end

	if previous.recycler ~= current.recycler then
		MapService.updateRecycler(player, data.island)
	end

	if previous.incubator ~= current.incubator then
		MapService.updateIncubator(player, data.island, IncubatorRules.slotCountFor(data))
	end

	-- v15: neuer Look -> genau dieses Gebaeude neu bauen (mit Show). Nach einem
	-- Rebirth faellt der Look zurueck; rebuildIsland hat die Insel dann schon
	-- komplett neu gebaut, updateBuildingLooks findet nichts mehr zu tun.
	if previous.looks ~= current.looks then
		MapService.updateBuildingLooks(player, data.island, true)
	end

	if previous.stage ~= current.stage then
		player:SetAttribute("IslandStage", tonumber(current.stage))
	end

	if previous.tower ~= current.tower then
		local oldTower = string.match(previous.tower, "^([^:]+):")
		local newTower = string.match(current.tower, "^([^:]+):")
		applyTower(player, current.tower, oldTower ~= newTower)
	end

	_signatures[player] = current
end

function PlotDisplayService.init()
	-- MapService darf PlayerService nicht requiren (PlayerService requiret
	-- bereits MapService — das waere ein Ringschluss). Deshalb bekommt es die
	-- Lesefunktion von hier: dieser Service kennt beide ohnehin schon.
	MapService.setIslandDataProvider(function(player: Player): Types.IslandData?
		local data = PlayerService.getData(player)
		return if data then data.island else nil
	end)
	-- Sammel-Update Paket 8: Platz-Zahl des Inkubators (Level, Rebirths, Index).
	MapService.setIncubatorSlotProvider(function(player: Player): number
		local data = PlayerService.getData(player)
		return if data then IncubatorRules.slotCountFor(data) else 1
	end)

	PlayerService.onPlayerReady(function(player, data)
		-- Die Figuren und Schilder stehen zu diesem Zeitpunkt schon
		-- (MapService.spawnIsland laeuft beim Join davor), aber die Daten
		-- haben sich seitdem noch geaendert: die onDataLoaded-Callbacks haben
		-- Offline-Honig gutgeschrieben und offline gelegte Eier eingetragen.
		-- Die Schilder zeigten sonst bis zum naechsten Honig-Tick den Stand von
		-- vor der Gutschrift, und die Eier laegen nur in den Daten.
		--
		-- Deshalb einmal aktiv nachziehen — und ERST DANN die Signatur
		-- merken, sonst haelt der Vergleich unten den Unterschied faelschlich
		-- fuer bereits dargestellt.
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateBaerchiStates(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		MapService.updateIncubator(player, data.island, IncubatorRules.slotCountFor(data))

		local signatures = allSignatures(data)
		applyTower(player, signatures.tower, false)
		player:SetAttribute("IslandStage", tonumber(signatures.stage))

		_signatures[player] = signatures
	end)

	PlayerService.onDataChanged(refresh)

	Players.PlayerRemoving:Connect(function(player)
		_signatures[player] = nil
	end)

	print("[PlotDisplayService] Initialisiert")
end

return PlotDisplayService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX27"><Properties>
<string name="Name">WorldMomentService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldMomentService.luau
-- ServerScriptService/Services/WorldMomentService.luau
--
-- Einzige Zustaendigkeit:
--   - Grosse Momente eines Spielers (seltener Baerchi, neuer Tower, Rekord,
--     Rebirth, seltene Mutation) an ALLE Clients melden (Paket G, "Welt
--     aufwerten"), gedrosselt auf einen grossen Moment je Spieler und 30 s
--
-- Erkannt wird aus dem Spielstand (Modules/WorldMoments.diff): dieser
-- Service haengt an PlayerService.onDataChanged und vergleicht mit dem
-- letzten Stand. So muss kein anderer Service angefasst werden, und kein
-- Moment geht verloren, egal welcher Weg (Ei, Fusion, Event) ihn ausloest.
--
-- Was die Clients daraus machen (Lichtsaeule, Feuerwerk, Welle ...),
-- entscheidet WorldMomentController. Der Server schickt nur Art, Wert und
-- gross/klein. Ein Spieler, dessen Momente zu dicht kommen, sendet weiter,
-- aber als kleine Version (WorldMoments.throttle).

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types        = require(ReplicatedStorage.Network.Types)
local Remotes      = require(ReplicatedStorage.Network.Remotes)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local WorldMoments = require(ReplicatedStorage.Modules.WorldMoments)

local PlayerService = require(ServerScriptService.Services.PlayerService)

local WorldMomentService = {}

local _snapshots: { [Player]: WorldMoments.Snapshot } = {}
local _lastBig: { [Player]: number } = {}

-- Meldet einen Moment an alle (auch fuer den Debug-Befehl "moment").
function WorldMomentService.announce(player: Player, moment: WorldMoments.Moment, forceBig: boolean?)
	local big, last = WorldMoments.throttle(_lastBig[player], os.clock())
	if forceBig then big, last = true, os.clock() end
	_lastBig[player] = last
	Remotes.WorldMoment:FireAllClients({
		userId = player.UserId,
		kind   = moment.kind,
		value  = moment.value,
		number = moment.number,
		big    = big,
	})
end

local function onChanged(player: Player, data: Types.PlayerData)
	local after = WorldMoments.snapshot(data)
	local before = _snapshots[player]
	_snapshots[player] = after
	if not before then return end
	for _, moment in WorldMoments.diff(before, after) do
		WorldMomentService.announce(player, moment)
	end
end

function WorldMomentService.init()
	if not FeatureFlags.isOn("WORLD_G_MOMENTS") then return end

	-- Ausgangsstand beim Laden: was schon da war, ist kein neuer Moment
	PlayerService.onPlayerReady(function(player, data)
		_snapshots[player] = WorldMoments.snapshot(data)
	end)
	PlayerService.onDataChanged(onChanged)
	Players.PlayerRemoving:Connect(function(player)
		_snapshots[player] = nil
		_lastBig[player] = nil
	end)

	print("[WorldMomentService] Initialisiert")
end

return WorldMomentService
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="Folder" referent="RBX28"><Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="Folder" referent="RBX29"><Properties>
<string name="Name">Controllers</string>
</Properties>
<Item class="ModuleScript" referent="RBX30"><Properties>
<string name="Name">AmbienceController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- AmbienceController.luau
-- StarterPlayerScripts/Controllers/AmbienceController.luau
--
-- Einzige Zustaendigkeit:
--   - Lebendige Himmels-Kulisse nur auf dem Client: treibende Wolkenpuffs,
--     ferne Schwebeinseln, schwebender Pollen um die Kamera und das leise
--     Atmen der Schaumsaeume um die Inseln
--
-- Warum auf dem Client: Kulisse ist fuer jeden Spieler gleich und hat keine
-- Spielwirkung. Gebaut auf dem Server wuerde sie repliziert und der Server
-- muesste sie bewegen; hier kostet sie das Netzwerk nichts und die Rechenzeit
-- bezahlt nur, wer sie sieht. Zahlen in AmbienceConfig.
--
-- PERFORMANCE:
--   * Alle Wolken sind EIN Model und werden pro Frame mit EINEM PivotTo
--     gedreht; die Schwebeinseln je EIN PivotTo. Keine Schleife ueber Parts.
--   * Alle Parts: Anchored, ohne Kollision, ohne Query, ohne Schatten. Die
--     Kamera-Zoom-Logik und Klick-Raycasts sehen sie nicht.
--   * Schwache Geraete (Grafikstufe < AmbienceConfig.HIGH_QUALITY_FROM) bekommen
--     weniger Wolken, weniger Inseln und keinen Pollen.
--   * Der Schaum wird nur 10 mal pro Sekunde aktualisiert.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local MapConfig      = require(ReplicatedStorage.Config.MapConfig)

local AmbienceController = {}

local FOAM_TICK = 0.1

local _folder: Folder? = nil
local _cloudModel: Model? = nil
local _cloudBase: CFrame = CFrame.new()
local _islands: { { model: Model, base: CFrame, phase: number } } = {}
local _foamParts: { { part: Part, phase: number } } = {}
local _pollenPart: Part? = nil

--------------------------------------------------------------------------------
-- Qualitaet
--------------------------------------------------------------------------------

local function isHighQuality(): boolean
	local ok, level = pcall(function()
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel.Value
	end)
	if not ok then
		return true
	end
	-- 0 = Automatisch: zaehlt als hoch, Roblox regelt dort selbst nach.
	return level == 0 or level >= AmbienceConfig.HIGH_QUALITY_FROM
end

--------------------------------------------------------------------------------
-- Bausteine
--------------------------------------------------------------------------------

local function newPart(name: string, parent: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType): Part
	local part = Instance.new("Part")
	part.Name          = name
	part.Anchored      = true
	part.CanCollide    = false
	part.CanQuery      = false
	part.CanTouch      = false
	part.CastShadow    = false
	part.Size          = size
	part.CFrame        = cframe
	part.Color         = color
	part.Material      = material
	part.Shape         = shape
	part.TopSurface    = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent        = parent
	return part
end

--------------------------------------------------------------------------------
-- Wolkenpuffs
--------------------------------------------------------------------------------

-- Ein Puff = vier bis fuenf ueberlappende, plattgedrueckte Baelle.
local function buildCloudPuff(parent: Instance, position: Vector3, random: Random)
	local scale = random:NextNumber(0.8, 1.4)
	local lumps = random:NextInteger(4, 5)

	for i = 1, lumps do
		local w = random:NextNumber(60, 110) * scale
		local offset = Vector3.new(
			(i - (lumps + 1) / 2) * 45 * scale + random:NextNumber(-12, 12),
			random:NextNumber(-6, 10),
			random:NextNumber(-20, 20)
		)
		local part = newPart(
			"Puff", parent,
			Vector3.new(w, w * 0.38, w * 0.7),
			CFrame.new(position + offset),
			AmbienceConfig.CLOUD_COLOR,
			Enum.Material.SmoothPlastic,
			Enum.PartType.Ball
		)
		part.Transparency = 0.12
	end
end

local function buildClouds(parent: Instance, count: number, random: Random)
	local model = Instance.new("Model")
	model.Name = "Clouds"

	for i = 1, count do
		-- Gleichmaessig um den Kreis verteilt, mit Zufall in Abstand und Hoehe.
		local angle  = (i - 1) / count * math.pi * 2 + random:NextNumber(-0.15, 0.15)
		local radius = random:NextNumber(AmbienceConfig.CLOUD_RING_MIN, AmbienceConfig.CLOUD_RING_MAX)
		local height = random:NextNumber(AmbienceConfig.CLOUD_HEIGHT_MIN, AmbienceConfig.CLOUD_HEIGHT_MAX)

		buildCloudPuff(model, Vector3.new(
			MapConfig.CENTER.X + radius * math.cos(angle),
			height,
			MapConfig.CENTER.Z + radius * math.sin(angle)
		), random)
	end

	model.Parent = parent
	_cloudModel = model
	_cloudBase  = model:GetPivot()
end

--------------------------------------------------------------------------------
-- Ferne Schwebeinseln
--------------------------------------------------------------------------------

local function buildFarIsland(parent: Instance, angle: number, random: Random, index: number)
	local model = Instance.new("Model")
	model.Name = "FarIsland"

	local base = Vector3.new(
		MapConfig.CENTER.X + AmbienceConfig.FAR_ISLAND_RING * math.cos(angle),
		AmbienceConfig.FAR_ISLAND_HEIGHT + random:NextNumber(-20, 40),
		MapConfig.CENTER.Z + AmbienceConfig.FAR_ISLAND_RING * math.sin(angle)
	)
	local size = random:NextNumber(70, 110)

	-- Felsbrocken darunter (ein umgedrehter, plattgedrueckter Ball), Wiese oben drauf.
	newPart("Rock", model, Vector3.new(size, size * 0.7, size),
		CFrame.new(base + Vector3.new(0, -size * 0.28, 0)),
		Color3.fromRGB(140, 130, 150), Enum.Material.Slate, Enum.PartType.Ball)
	newPart("Grass", model, Vector3.new(4, size, size),
		CFrame.new(base) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(96, 190, 92), Enum.Material.Grass, Enum.PartType.Cylinder)

	-- Ein Baum und ein Leuchtkristall, damit die Silhouette nicht langweilig ist.
	newPart("Trunk", model, Vector3.new(14, 4, 4),
		CFrame.new(base + Vector3.new(size * 0.15, 9, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(122, 84, 52), Enum.Material.Wood, Enum.PartType.Cylinder)
	newPart("Crown", model, Vector3.new(26, 20, 26),
		CFrame.new(base + Vector3.new(size * 0.15, 22, 0)),
		(index % 2 == 0) and Color3.fromRGB(255, 160, 190) or Color3.fromRGB(72, 170, 80),
		Enum.Material.Grass, Enum.PartType.Ball)

	model.Parent = parent
	table.insert(_islands, { model = model, base = model:GetPivot(), phase = random:NextNumber(0, math.pi * 2) })
end

--------------------------------------------------------------------------------
-- Pollen
--------------------------------------------------------------------------------

local function buildPollen(parent: Instance)
	local anchor = Instance.new("Part")
	anchor.Name         = "PollenAnchor"
	anchor.Anchored     = true
	anchor.CanCollide   = false
	anchor.CanQuery     = false
	anchor.CanTouch     = false
	anchor.CastShadow   = false
	anchor.Transparency = 1
	anchor.Size         = Vector3.new(140, 50, 140)
	anchor.Parent       = parent

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color         = ColorSequence.new(AmbienceConfig.POLLEN_COLOR)
	emitter.Size          = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, 0.8),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency  = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime      = NumberRange.new(8, 12)
	emitter.Rate          = AmbienceConfig.POLLEN_RATE
	emitter.Speed         = NumberRange.new(0.5, 2)
	emitter.SpreadAngle   = Vector2.new(180, 180)
	emitter.Acceleration  = Vector3.new(0, 0.3, 0)
	emitter.LightEmission = 0.6
	emitter.LockedToPart  = false
	emitter.Shape         = Enum.ParticleEmitterShape.Box
	emitter.Parent        = anchor

	_pollenPart = anchor
end

--------------------------------------------------------------------------------
-- Schaum einsammeln
--------------------------------------------------------------------------------

local function collectFoam()
	local platform = workspace:WaitForChild("Platform", 30)
	if not platform then
		return
	end
	local scenery = platform:WaitForChild("Scenery", 30)
	local foam = scenery and scenery:WaitForChild("Foam", 30)
	if not foam then
		return
	end
	for _, child in foam:GetChildren() do
		if child:IsA("Part") then
			table.insert(_foamParts, { part = child, phase = (child:GetAttribute("FoamPhase") :: number?) or 0 })
		end
	end
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function AmbienceController.init()
	local high   = isHighQuality()
	local random = Random.new(AmbienceConfig.SCENERY_SEED + 7)

	local folder = Instance.new("Folder")
	folder.Name   = "BaerchiAmbience"
	folder.Parent = workspace
	_folder = folder

	buildClouds(folder, high and AmbienceConfig.CLOUD_PUFFS_HIGH or AmbienceConfig.CLOUD_PUFFS_LOW, random)

	local islandCount = high and AmbienceConfig.FAR_ISLANDS_HIGH or AmbienceConfig.FAR_ISLANDS_LOW
	for i = 1, islandCount do
		-- Gleichmaessig verteilt, damit man von jeder Insel eine am Horizont sieht.
		buildFarIsland(folder, (i - 0.5) / islandCount * math.pi * 2, random, i)
	end

	if high then
		buildPollen(folder)
	end

	task.spawn(collectFoam)

	local clock = 0
	local foamClock = 0
	local cloudAngle = 0

	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt

		-- Wolken: ein Pivot fuer alle.
		local clouds = _cloudModel
		if clouds then
			cloudAngle += dt * AmbienceConfig.CLOUD_DRIFT_SPEED
			-- Drehung um die Weltmitte, relativ zur Ausgangslage (das Model-Pivot liegt
			-- in der Mitte seiner Teile, nicht in der Weltmitte).
			clouds:PivotTo(CFrame.new(MapConfig.CENTER) * CFrame.Angles(0, cloudAngle, 0) * CFrame.new(-MapConfig.CENTER) * _cloudBase)
		end

		-- Schwebeinseln: sanftes Auf und Ab, ein Pivot je Insel.
		for _, island in _islands do
			island.model:PivotTo(island.base * CFrame.new(0, math.sin(clock * 0.35 + island.phase) * 5, 0))
		end

		-- Pollen folgt der Kamera.
		local anchor = _pollenPart
		local camera = workspace.CurrentCamera
		if anchor and camera then
			anchor.Position = camera.CFrame.Position + Vector3.new(0, 4, 0)
		end

		-- Schaum atmet, 10 mal pro Sekunde.
		foamClock += dt
		if foamClock >= FOAM_TICK then
			foamClock = 0
			local twoPi = math.pi * 2
			for _, foam in _foamParts do
				local value = AmbienceConfig.FOAM_TRANSPARENCY
					+ math.sin(clock / AmbienceConfig.FOAM_PULSE_PERIOD * twoPi + foam.phase) * AmbienceConfig.FOAM_PULSE
				-- Welt aufwerten, Paket B: mit Schaum-Textur (WaterController)
				-- ist die Scheibe selbst unsichtbar und die Textur atmet.
				local lace = foam.part:FindFirstChild("FoamLace")
				if lace and lace:IsA("Texture") then
					lace.Transparency = value
				else
					foam.part.Transparency = value
				end
			end
		end
	end)

	print("[Ambience] Kulisse aktiv |", high and "hoch" or "niedrig")
end

return AmbienceController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX31"><Properties>
<string name="Name">ArenaLifeController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- ArenaLifeController.luau
-- StarterPlayerScripts/Controllers/ArenaLifeController.luau
--
-- Einzige Zustaendigkeit:
--   - Der Weg in den Kampf (Paket E, "Welt aufwerten"): Honig-Laternen am
--     Steg zur Arena (Welle beim Laufstart), Torbogen am Arena-Eingang,
--     Zuschauer-Baerchis auf dem Zaun (huepfen bei Faehigkeiten, jubeln bei
--     neuem Rekord) und eine wehende Flagge auf dem Schau-Turm
--
-- Woher der Client weiss, was passiert (keine neue Server-Logik):
--   * Lauf laeuft    = die Arena-Tafel ist eingeblendet
--                      (Plot_N/PitPlatform/PitBannerAnchor/Banner.Enabled,
--                      MapService.setPitBanner)
--   * Faehigkeit     = Remotes.SkillFXPlay (geht ohnehin an alle Clients),
--                      `center` liegt in dieser Arena
--   * neuer Rekord   = der Schau-Turm wird neu gebaut und die Zahl am Ende
--                      seines Schilds ist hoeher als vorher
--                      (ArenaBuilder.buildShowcase, Titel "Name · Tower III · 42")
--
-- Alles nur auf dem Client, pro besetztem Slot aus einem Pool (einmal gebaut,
-- danach ein- und ausgehaengt). Kein Server-Teil.
--
-- PERFORMANCE: EIN Takt (20x pro Sekunde) nur fuer Arenen in Sichtweite;
-- Lauf-Zustand 4x pro Sekunde. Keine Lichter, kein Emitter.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)
local Remotes       = require(ReplicatedStorage.Network.Remotes)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)

local ArenaLifeController = {}

local TICK = 0.05
local TAU = math.pi * 2

type Spectator = { model: Model, base: CFrame, armL: BasePart, armR: BasePart, phase: number }
type Arena = {
	slot: number,
	group: Folder,
	shown: boolean,
	occupied: boolean,
	lamps: { { glass: BasePart, index: number } },
	running: boolean,
	waveStart: number,
	spectators: { Spectator },
	hopUntil: number,
	cheerUntil: number,
	flag: { pole: BasePart, cloth: BasePart, base: CFrame }?,
	flagShineUntil: number,
	record: number?,
}

local _folder: Folder? = nil
local _arenas: { [number]: Arena } = {}

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- Richtung in der Arena: 0 Grad = nach aussen (weg vom Steg), 90 = zur Seite.
local function pitDir(slot: number, degrees: number): Vector3
	local a = math.rad(degrees)
	return MapLayout.outward(slot) * math.cos(a) + MapLayout.side(slot) * math.sin(a)
end

local function plotOf(slot: number): Instance?
	return workspace:FindFirstChild("Plot_" .. slot)
end

local function isRunning(slot: number): boolean
	local plot = plotOf(slot)
	local platform = plot and plot:FindFirstChild("PitPlatform")
	local anchor = platform and platform:FindFirstChild("PitBannerAnchor")
	local banner = anchor and anchor:FindFirstChild("Banner")
	return banner ~= nil and banner:IsA("BillboardGui") and banner.Enabled
end

--------------------------------------------------------------------------------
-- Bau (einmal je Slot)
--------------------------------------------------------------------------------

local function buildLamps(arena: Arena)
	if not WorldFXKit.enabled("bridgeLamps") then return end
	local cfg = WorldFXConfig.BRIDGE_LAMPS
	local slot = arena.slot
	local outward, side = MapLayout.outward(slot), MapLayout.side(slot)
	local deckTop = MapConfig.PLATFORM_TOP_Y - MapConfig.BRIDGE_SINK
	local sideOffset = (MapConfig.BRIDGE_WIDTH + MapConfig.BRIDGE_RAIL_WIDTH) * 0.5
	local from = MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS + 6
	local to = from + MapConfig.ISLAND_GAP - 12
	for i = 1, cfg.PER_SIDE do
		local r = from + (to - from) * (i - 1) / math.max(1, cfg.PER_SIDE - 1)
		for _, sign in { -1, 1 } do
			local p = MapConfig.CENTER + outward * r + side * (sign * sideOffset)
			local foot = Vector3.new(p.X, deckTop, p.Z)
			WorldFXKit.pole("LampPost", arena.group, foot, cfg.POST_HEIGHT, 0.35, MapConfig.BRIDGE_RAIL_COLOR, Enum.Material.Wood)
			local glass = WorldFXKit.ball("LampGlass", arena.group, cfg.GLASS_SIZE,
				foot + Vector3.new(0, cfg.POST_HEIGHT + cfg.GLASS_SIZE * 0.4, 0), cfg.OFF_COLOR, Enum.Material.Glass)
			table.insert(arena.lamps, { glass = glass, index = i })
		end
	end
end

local function buildArch(arena: Arena)
	if not WorldFXKit.enabled("arenaArch") then return end
	local cfg = WorldFXConfig.ARENA_ARCH
	local slot = arena.slot
	local pit = MapLayout.pitCenter(slot)
	-- auf dem Zaunring, mitten in der Zaunluecke zum Steg
	local ring = MapConfig.PIT_BASE_RADIUS - MapConfig.PIT_FENCE_INSET
	local gate = pit - MapLayout.outward(slot) * ring
	local side = MapLayout.side(slot)
	local baseY = MapConfig.PLATFORM_TOP_Y - MapConfig.PIT_RIM_DROP
	for _, sign in { -1, 1 } do
		local p = gate + side * (sign * cfg.HALF_WIDTH)
		WorldFXKit.pole("ArchPost", arena.group, Vector3.new(p.X, baseY, p.Z), cfg.HEIGHT, cfg.POST_DIAMETER, cfg.WOOD, Enum.Material.Wood)
	end
	local top = Vector3.new(gate.X, baseY + cfg.HEIGHT - 0.3, gate.Z)
	WorldFXKit.part("ArchBeam", arena.group, Vector3.new(cfg.HALF_WIDTH * 2 + 1.2, 0.8, 0.8),
		CFrame.fromMatrix(top, side, Vector3.yAxis), cfg.WOOD, Enum.Material.Wood, Enum.PartType.Cylinder)
	-- Honigwabe oben, Stirnseite zum Steg
	local comb = WorldFXKit.part("ArchComb", arena.group, Vector3.new(0.8, cfg.COMB_SIZE, cfg.COMB_SIZE),
		CFrame.fromMatrix(top + Vector3.new(0, cfg.COMB_SIZE * 0.5 + 0.2, 0), -MapLayout.outward(slot), Vector3.yAxis),
		WorldFXConfig.MAST.CELL_DAY, Enum.Material.Neon, Enum.PartType.Cylinder)
	DayCycleController.registerGlow(comb, WorldFXConfig.MAST.CELL_DAY, WorldFXConfig.MAST.CELL_NIGHT)
end

local SPECTATOR_ANGLES = { -120, -75, -30, 30, 75, 120 }   -- fern der Steg-Luecke (180 +- 34)

local function buildSpectators(arena: Arena)
	if not WorldFXKit.enabled("spectators") then return end
	local cfg = WorldFXConfig.SPECTATORS
	local slot = arena.slot
	local pit = MapLayout.pitCenter(slot)
	local ring = MapConfig.PIT_BASE_RADIUS - MapConfig.PIT_FENCE_INSET
	local seatY = MapConfig.PLATFORM_TOP_Y - MapConfig.PIT_RIM_DROP + MapConfig.PIT_FENCE_SIZE.Y
	for i = 1, math.min(cfg.COUNT, #SPECTATOR_ANGLES) do
		local dir = pitDir(slot, SPECTATOR_ANGLES[i])
		local seat = Vector3.new(pit.X, seatY, pit.Z) + dir * ring
		-- schaut zur Arena-Mitte
		local base = CFrame.lookAt(seat, Vector3.new(pit.X, seatY, pit.Z))
		local color = cfg.COLORS[(i - 1) % #cfg.COLORS + 1]
		local model = Instance.new("Model")
		model.Name = "Spectator"
		local s = cfg.SCALE
		local body = WorldFXKit.ellipsoid("Body", model, Vector3.new(1.3, 1.4, 1.1) * s, base * CFrame.new(0, 0.7 * s, 0), color)
		WorldFXKit.ball("Head", model, 1.0 * s, (base * CFrame.new(0, 1.75 * s, 0)).Position, color)
		for _, x in { -0.38, 0.38 } do
			WorldFXKit.ball("Ear", model, 0.38 * s, (base * CFrame.new(x * s, 2.25 * s, 0)).Position, color)
		end
		local armL = WorldFXKit.part("ArmL", model, Vector3.new(0.3, 0.8, 0.3) * s, base * CFrame.new(-0.7 * s, 0.9 * s, 0), color)
		local armR = WorldFXKit.part("ArmR", model, Vector3.new(0.3, 0.8, 0.3) * s, base * CFrame.new(0.7 * s, 0.9 * s, 0), color)
		model.PrimaryPart = body
		model.Parent = arena.group
		table.insert(arena.spectators, { model = model, base = model:GetPivot(), armL = armL, armR = armR, phase = i * 0.37 })
	end
end

local function buildArena(slot: number): Arena
	local group = WorldFXKit.folder("ArenaLife_" .. slot, _folder :: Folder)
	local arena: Arena = {
		slot = slot, group = group, shown = true, occupied = false,
		lamps = {}, running = false, waveStart = 0,
		spectators = {}, hopUntil = 0, cheerUntil = 0,
		flag = nil, flagShineUntil = 0, record = nil,
	}
	buildLamps(arena)
	buildArch(arena)
	buildSpectators(arena)
	return arena
end

--------------------------------------------------------------------------------
-- Schau-Turm: Flagge und Rekord
--------------------------------------------------------------------------------

local function recordOf(showcase: Instance): (number?, Color3?)
	local anchor = showcase:FindFirstChild("SignAnchor")
	local sign = anchor and anchor:FindFirstChild("Sign")
	local title = sign and sign:FindFirstChild("Title")
	if not (title and title:IsA("TextLabel")) then return nil, nil end
	local n = string.match(title.Text, "(%d+)%s*$")
	return (if n then tonumber(n) else nil), title.TextColor3
end

local function cheer(arena: Arena)
	local now = os.clock()
	arena.cheerUntil = now + WorldFXConfig.SPECTATORS.CHEER_TIME
	arena.flagShineUntil = now + WorldFXConfig.SHOWCASE_FLAG.SHINE_TIME
end

local function attachFlag(arena: Arena, showcase: Instance)
	local old = arena.flag
	if old then
		old.pole:Destroy()
		old.cloth:Destroy()
	end
	arena.flag = nil

	local record, color = recordOf(showcase)
	local previous = arena.record
	arena.record = record
	if previous and record and record > previous then
		cheer(arena)
	end

	if not (WorldFXKit.enabled("showcaseFlag") and showcase:IsA("Model")) then return end
	local cfg = WorldFXConfig.SHOWCASE_FLAG
	-- Spitze: oberste Kante der Turm-Teile (Schild-Anker ausgenommen)
	local top = -math.huge
	local foot = MapLayout.showcaseFoot(arena.slot)
	for _, part in showcase:GetChildren() do
		if part:IsA("BasePart") and part.Name ~= "SignAnchor" then
			top = math.max(top, part.Position.Y + part.Size.Y * 0.5)
		end
	end
	if top == -math.huge then return end
	local poleFoot = Vector3.new(foot.X, top - 0.2, foot.Z)
	-- Flaggen-Container haengt am Turm-Gruppen-Ordner des Schau-Turms (Hauptinsel)
	local pole = WorldFXKit.pole("FlagPole", _folder, poleFoot, cfg.POLE_HEIGHT, 0.2, Color3.fromRGB(110, 76, 48), Enum.Material.Wood)
	local side = MapLayout.side(arena.slot)
	local base = CFrame.fromMatrix(poleFoot + Vector3.new(0, cfg.POLE_HEIGHT - cfg.FLAG_SIZE.Y * 0.5, 0), side, Vector3.yAxis)
	local cloth = WorldFXKit.part("Flag", _folder, cfg.FLAG_SIZE, base * CFrame.new(cfg.FLAG_SIZE.X * 0.5, 0, 0),
		color or Color3.fromRGB(255, 214, 110), Enum.Material.Fabric)
	local flagId = WorldFXKit.textureId("flag_fabric")
	if flagId then
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local decal = Instance.new("Decal")
			decal.Texture = flagId
			decal.Face = face
			decal.Parent = cloth
		end
	end
	arena.flag = { pole = pole, cloth = cloth, base = base }
end

local function watchShowcase(arena: Arena)
	local plot = plotOf(arena.slot)
	if not plot then return end
	local current = plot:FindFirstChild("TowerShowcase")
	if current then
		attachFlag(arena, current)
	end
	plot.ChildAdded:Connect(function(child)
		if child.Name == "TowerShowcase" then
			task.wait(0.1)   -- Schild wird nach dem Model gefuellt
			if child.Parent then attachFlag(arena, child) end
		end
	end)
end

--------------------------------------------------------------------------------
-- Takt
--------------------------------------------------------------------------------

local function stepFlag(arena: Arena, now: number, clock: number)
	-- Flagge weht; beim Rekord glaenzt sie einmal auf
	local flag = arena.flag
	if not flag then return end
	local fcfg = WorldFXConfig.SHOWCASE_FLAG
	local swing = math.rad(fcfg.WAVE_DEGREES) * math.sin(clock * fcfg.WAVE_RATE * TAU + arena.slot)
	flag.cloth.CFrame = flag.base * CFrame.Angles(0, swing, 0) * CFrame.new(fcfg.FLAG_SIZE.X * 0.5, 0, 0)
	local material = if now < arena.flagShineUntil then Enum.Material.Neon else Enum.Material.Fabric
	if flag.cloth.Material ~= material then flag.cloth.Material = material end
end

local function stepArena(arena: Arena, now: number)
	-- Laternen: Welle vom Plot zur Arena, aus nach dem Lauf
	local cfg = WorldFXConfig.BRIDGE_LAMPS
	for _, lamp in arena.lamps do
		local on = arena.running and now >= arena.waveStart + (lamp.index - 1) * cfg.WAVE_STEP
		local want = if on then cfg.ON_COLOR else cfg.OFF_COLOR
		if lamp.glass.Color ~= want then
			lamp.glass.Color = want
			lamp.glass.Material = if on then Enum.Material.Neon else Enum.Material.Glass
		end
	end

	-- Zuschauer: Hopser bei einer Faehigkeit, Jubel (Arme hoch) beim Rekord
	local scfg = WorldFXConfig.SPECTATORS
	local cheering = now < arena.cheerUntil
	local hopping = now < arena.hopUntil or cheering
	for _, sp in arena.spectators do
		local lift = 0
		if hopping then
			local t = ((now + sp.phase) % scfg.HOP_TIME) / scfg.HOP_TIME
			lift = scfg.HOP_HEIGHT * 4 * t * (1 - t)
		end
		sp.model:PivotTo(sp.base * CFrame.new(0, lift, 0))
		local armAngle = if cheering then math.rad(160) else 0
		local pivot = sp.model:GetPivot()
		-- Schulter knapp ueber der Koerpermitte; Arm haengt, beim Jubel hoch
		sp.armL.CFrame = pivot * CFrame.new(-0.7, 0.35, 0) * CFrame.Angles(0, 0, -armAngle) * CFrame.new(0, -0.35, 0)
		sp.armR.CFrame = pivot * CFrame.new(0.7, 0.35, 0) * CFrame.Angles(0, 0, armAngle) * CFrame.new(0, -0.35, 0)
	end
end

--------------------------------------------------------------------------------
-- Besetzung, Sichtweite, Lauf-Zustand (4x pro Sekunde)
--------------------------------------------------------------------------------

local function setOccupied(slot: number, occupied: boolean)
	local arena = _arenas[slot]
	if not arena then
		if not occupied then return end
		arena = buildArena(slot)
		_arenas[slot] = arena
	end
	local a = arena :: Arena
	a.occupied = occupied
	if occupied then
		a.record = nil
		task.spawn(watchShowcase, a)
	else
		local flag = a.flag
		if flag then
			flag.pole:Destroy()
			flag.cloth:Destroy()
		end
		a.flag = nil
	end
end

local function refresh()
	local camera = workspace.CurrentCamera
	local folder = _folder
	if not (camera and folder) then return end
	local eye = camera.CFrame.Position
	for slot, arena in _arenas do
		local d = (MapLayout.pitCenter(slot) - eye).Magnitude
		local limit = WorldFXConfig.BRIDGE_LAMPS.SHOW_DISTANCE * (if arena.shown then 1 else 0.9)
		local want = arena.occupied and d <= limit
		if want ~= arena.shown then
			arena.shown = want
			arena.group.Parent = if want then folder else nil
		end
		local running = arena.occupied and isRunning(slot)
		if running and not arena.running then
			arena.waveStart = os.clock()
		end
		arena.running = running
	end
end

local function slotOf(child: Instance): number?
	local n = string.match(child.Name, "^Plot_(%d+)$")
	return if n then tonumber(n) else nil
end

-- Arena des Spielers mit dieser UserId (ueber das Plot-Attribut PlotOwner).
local function arenaOfUser(userId: number?): Arena?
	if not userId then return nil end
	for slot, arena in _arenas do
		local plot = plotOf(slot)
		if plot and plot:GetAttribute("PlotOwner") == userId then return arena end
	end
	return nil
end

-- Paket G (neuer Rekord): Zuschauer jubeln, Flagge glaenzt — sichtbar nur,
-- wo die Arena bzw. der Turm in Sichtweite ist.
function ArenaLifeController.celebrate(userId: number)
	local arena = arenaOfUser(userId)
	if arena then cheer(arena) end
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function ArenaLifeController.init()
	if not FeatureFlags.isOn("WORLD_E_ARENA") then return end
	_folder = WorldFXKit.folder("ArenaLife", WorldFXKit.root())

	for slot = 1, MapConfig.PLOT_COUNT do
		if workspace:FindFirstChild("Plot_" .. slot) then setOccupied(slot, true) end
	end
	workspace.ChildAdded:Connect(function(child)
		local slot = slotOf(child)
		if slot then setOccupied(slot, true) end
	end)
	workspace.ChildRemoved:Connect(function(child)
		local slot = slotOf(child)
		if slot and not workspace:FindFirstChild(child.Name) then setOccupied(slot, false) end
	end)

	-- Faehigkeit in einer Arena: die Zuschauer dort huepfen kurz
	Remotes.SkillFXPlay.OnClientEvent:Connect(function(req: any)
		if typeof(req) ~= "table" or typeof(req.owner) ~= "number" then return end
		local arena = arenaOfUser(req.owner)
		if arena then
			arena.hopUntil = os.clock() + WorldFXConfig.SPECTATORS.HOP_TIME * 2
		end
	end)

	-- Debug (Studio): "<userId>|hop|n" bzw. "<userId>|n" fuer den Rekord
	WorldFXKit.onDebug("DebugSpectators", function(value: any)
		if typeof(value) ~= "string" then return end
		local id, mode = string.match(value, "^(%d+)|(%a+)")
		local arena = arenaOfUser(tonumber(id))
		if not arena then return end
		if mode == "cheer" then cheer(arena) else arena.hopUntil = os.clock() + 2 end
	end, false)
	WorldFXKit.onDebug("DebugRecord", function(value: any)
		if typeof(value) ~= "string" then return end
		local arena = arenaOfUser(tonumber(string.match(value, "^(%d+)")))
		if arena then cheer(arena) end
	end, false)

	local acc, stateAcc, clock = 0, 1, 0
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		acc += dt
		stateAcc += dt
		if stateAcc >= 0.25 then
			stateAcc = 0
			refresh()
		end
		if acc < TICK then return end
		acc = 0
		local now = os.clock()
		for _, arena in _arenas do
			if arena.shown then
				stepArena(arena, now)
			end
			stepFlag(arena, now, clock)
		end
	end)

	print("[ArenaLife] aktiv")
end

return ArenaLifeController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX32"><Properties>
<string name="Name">ArrivalController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- ArrivalController.luau
-- StarterPlayerScripts/Controllers/ArrivalController.luau
--
-- Einzige Zustaendigkeit:
--   - Die Ankunft beim ERSTEN Betreten des Servers (Paket C, "Welt
--     aufwerten"): Honigblasen steigen um den Spieler auf, ein kleiner
--     Bienenschwarm kreist einmal gruessend um ihn und fliegt dann los —
--     dorthin, wo er als Naechstes hin soll
--
-- Ziel der Bienen: Der Spieler spawnt seit dem Insel-Spawn auf SEINER Insel
-- (MapConfig.PLAYER_SPAWN_OFFSET). Steht er dort, zeigen die Bienen zum
-- Honigmast (Herz der Welt, Event, Haendler). Steht er woanders (voller
-- Server → Not-Spawn in der Mitte), zeigen sie zur eigenen Insel.
--
-- Nur fuer diesen einen Spieler sichtbar (alles lokal), einmal pro Beitritt:
-- ein Respawn loest nichts aus (dieses Skript laeuft einmal je Beitritt).
--
-- PERFORMANCE: ein Emitter (Blasen, einmal Emit), sechs kleine Bienen aus
-- einem festen Pool, ein Takt nur waehrend der ~6 Sekunden der Ankunft.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit = require(script.Parent.WorldFXKit)

local ArrivalController = {}

local localPlayer = Players.LocalPlayer
local TAU = math.pi * 2

local _bees: { Model } = {}
local _bubbleAnchor: BasePart? = nil
local _bubbles: ParticleEmitter? = nil
local _running = false

--------------------------------------------------------------------------------
-- Pool
--------------------------------------------------------------------------------

local function buildPool(folder: Instance)
	local cfg = WorldFXConfig.ARRIVAL
	for _ = 1, cfg.BEES do
		local model = Instance.new("Model")
		model.Name = "Bee"
		local body = WorldFXKit.ellipsoid("Body", model, Vector3.new(0.5, 0.5, 0.75), CFrame.new(), cfg.BEE_COLOR,
			Enum.Material.SmoothPlastic)
		WorldFXKit.part("Stripe", model, Vector3.new(0.52, 0.16, 0.22), CFrame.new(0, 0, 0.08), cfg.STRIPE_COLOR, Enum.Material.SmoothPlastic)
		local wings = WorldFXKit.part("Wings", model, Vector3.new(0.9, 0.05, 0.3), CFrame.new(0, 0.27, -0.02), Color3.new(1, 1, 1),
			Enum.Material.SmoothPlastic)
		wings.Transparency = 0.45
		model.PrimaryPart = body
		table.insert(_bees, model)
	end

	local anchor = WorldFXKit.anchor("BubbleAnchor", folder, Vector3.new(4, 0.5, 4), Vector3.new(0, -200, 0))
	local emitter = Instance.new("ParticleEmitter")
	if WorldFXKit.applyParticleTexture(emitter, "honey_bubble") then
		emitter.Rate = 0
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 214, 110))
		emitter.LightEmission = 0.3
		emitter.Lifetime = NumberRange.new(2.2, 3.2)
		emitter.Speed = NumberRange.new(2.5, 4.5)
		emitter.SpreadAngle = Vector2.new(20, 20)
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Acceleration = Vector3.new(0, 0.6, 0)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.3, 0.7), NumberSequenceKeypoint.new(1, 0.9),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.8, 0.3), NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Parent = anchor
		_bubbles = emitter
	else
		emitter:Destroy()
	end
	_bubbleAnchor = anchor
end

--------------------------------------------------------------------------------
-- Ziel
--------------------------------------------------------------------------------

local function ownPlotSlot(): number?
	for slot = 1, MapConfig.PLOT_COUNT do
		local plot = workspace:FindFirstChild("Plot_" .. slot)
		if plot and plot:GetAttribute("PlotOwner") == localPlayer.UserId then
			return slot
		end
	end
	return nil
end

local function target(from: Vector3): Vector3
	local mast = MapConfig.CENTER + Vector3.new(0, MapConfig.PLATFORM_TOP_Y + 20, 0)
	local slot = ownPlotSlot()
	if not slot then
		return mast
	end
	local home = MapLayout.plotCenter(slot)
	local flat = Vector3.new(from.X - home.X, 0, from.Z - home.Z)
	if flat.Magnitude <= MapConfig.PLOT_ISLAND_RADIUS then
		return mast
	end
	return home + Vector3.new(0, 8, 0)
end

--------------------------------------------------------------------------------
-- Ablauf
--------------------------------------------------------------------------------

local function play(root: BasePart, folder: Instance)
	if _running then return end
	_running = true
	local cfg = WorldFXConfig.ARRIVAL

	local anchor = _bubbleAnchor
	local bubbles = _bubbles
	if anchor and bubbles then
		anchor.Position = root.Position - Vector3.new(0, 2.6, 0)
		bubbles:Emit(cfg.BUBBLES)
	end

	local goal = target(root.Position)
	local start = os.clock()
	local leaveFrom: { Vector3 } = {}
	for _, bee in _bees do
		bee.Parent = folder
	end

	local connection: RBXScriptConnection? = nil
	connection = RunService.Heartbeat:Connect(function()
		local t = os.clock() - start
		local center = if root.Parent then root.Position + Vector3.new(0, 1.5, 0) else goal
		for i, bee in _bees do
			local offset = i / #_bees * TAU
			local pos: Vector3
			local ahead: Vector3
			if t < cfg.CIRCLE_TIME then
				-- einmal gruessend rundherum, leicht auf und ab
				local a = t / cfg.CIRCLE_TIME * TAU + offset
				pos = center + Vector3.new(math.cos(a) * cfg.CIRCLE_RADIUS, math.sin(t * 4 + i) * 0.8, math.sin(a) * cfg.CIRCLE_RADIUS)
				ahead = Vector3.new(-math.sin(a), 0, math.cos(a))
				leaveFrom[i] = pos
			else
				-- dann gemeinsam zum Ziel, leicht versetzt, im Bogen
				local k = math.clamp((t - cfg.CIRCLE_TIME - i * 0.08) / cfg.FLY_TIME, 0, 1)
				local from = leaveFrom[i] or center
				local eased = k * k * (3 - 2 * k)
				pos = from:Lerp(goal, eased) + Vector3.new(0, math.sin(k * math.pi) * 6, 0)
					+ Vector3.new(math.cos(offset), 0, math.sin(offset)) * (1.5 * (1 - k))
				ahead = (goal - from)
				ahead = Vector3.new(ahead.X, 0, ahead.Z)
				ahead = if ahead.Magnitude > 1e-3 then ahead.Unit else Vector3.new(0, 0, -1)
			end
			bee:PivotTo(CFrame.lookAt(pos, pos + ahead))
		end
		if t > cfg.CIRCLE_TIME + cfg.FLY_TIME + 0.6 then
			for _, bee in _bees do
				bee.Parent = nil
			end
			_running = false
			local c = connection
			if c then c:Disconnect() end
		end
	end)
end

function ArrivalController.init()
	if not FeatureFlags.isOn("WORLD_C_HUB") then return end
	if not WorldFXKit.enabled("arrival") then return end
	local folder = WorldFXKit.folder("Arrival", WorldFXKit.root())
	buildPool(folder)

	local function playFor(character: Model)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and root:IsA("BasePart") then
			-- kurz warten: Insel und Plot sind beim ersten Spawn noch im Aufbau
			task.wait(1.2)
			play(root, folder)
		end
	end

	-- Nur der ERSTE Charakter dieses Beitritts
	local character = localPlayer.Character
	if character then
		task.spawn(playFor, character)
	else
		local first: RBXScriptConnection? = nil
		first = localPlayer.CharacterAdded:Connect(function(c)
			local conn = first
			if conn then conn:Disconnect() end
			playFor(c)
		end)
	end

	-- Debug (Studio): Ankunft erneut abspielen
	WorldFXKit.onDebug("DebugArrival", function()
		local c = localPlayer.Character
		local root = c and c:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			play(root, folder)
		end
	end, false)
end

return ArrivalController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX33"><Properties>
<string name="Name">DayCycleController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- DayCycleController.luau
-- StarterPlayerScripts/Controllers/DayCycleController.luau
--
-- Einzige Zustaendigkeit:
--   - Den Tageslauf auf dem Client zeigen (Paket A, "Welt aufwerten"): Uhr,
--     Licht, Atmosphaere, Bloom, Grund-Farbkorrektur, Wolkenfarbe, das
--     Leuchten von Laternen/Krone/Tropfen, Gluehwuermchen, Sterne und
--     Wolkenschleier
--
-- Woher die Zeit kommt: Modules/DayCycle, eine reine Funktion von
-- workspace:GetServerTimeNow(). Alle Spieler eines Servers sehen dieselbe
-- Tageszeit, ohne dass der Server etwas schickt.
--
-- Schalter: AmbienceConfig.DAY_CYCLE. Aus = dieser Controller tut nichts,
-- es bleibt der feste Himmel von SkyBuilder (16,9 Uhr).
--
-- Faehigkeiten-Shows haben Vorrang: SkillFXController legt fuer den Besitzer
-- einen EIGENEN Farbfilter "SkillFX_Sky" an, und der Boss-Himmel einen
-- eigenen "BossSky_Local". Dieser Controller schreibt nur in die Basis-
-- Effekte (BaerchiBloom, BaerchiColorCorrection, BaerchiAtmosphere) und in
-- Lighting — keine Seite ueberschreibt die andere, die Filter stapeln sich.
-- Zusaetzlich haelt der Tageslauf an, solange "SkillFX_Sky" faerbt, und
-- kehrt danach in DAY.RETURN_SECONDS weich zum aktuellen Stand zurueck: so
-- wandert das Licht nicht unter einer Show weg.
--
-- PERFORMANCE: EIN Takt (DAY.TICK, 5x pro Sekunde), Lighting-Werte sind
-- reine Property-Schreibvorgaenge. Leuchtende Teile werden nur umgefaerbt,
-- wenn sich das Leuchten um mehr als 1 % geaendert hat. Drei Emitter
-- (Gluehwuermchen, Sterne, Schleier), nur auf hoher Qualitaet.

local Lighting          = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)
local MapConfig      = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig  = require(ReplicatedStorage.Config.WorldFXConfig)
local DayCycle       = require(ReplicatedStorage.Modules.DayCycle)
local MapLayout      = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit = require(script.Parent.WorldFXKit)

local DayCycleController = {}

local SHOW_FILTER = "SkillFX_Sky"
local GLOW_STEP   = 0.01

type Glow = { part: BasePart, day: Color3, night: Color3 }

local _values: { [string]: any } = DayCycle.valuesAt(WorldFXConfig.DAY_BASE_D)
local _dusk = WorldFXConfig.DAY_BASE_D
local _glows: { Glow } = {}
local _lastGlow = -1
local _cloudParts: { BasePart } = {}
local _running = false   -- laeuft der Takt (Tageslauf an)?
local _pollen: ParticleEmitter? = nil      -- Paket F: Pollenfarbe folgt dem Tageslauf
local _lastPollen: Color3? = nil
local _lastCloud: Color3? = nil
local _override: number? = nil      -- Debug: feste Uhrzeit
local _held: { [string]: any }? = nil
local _atmScale = { density = 1, haze = 1 }   -- Paket I: klare Luft hoch oben
local _returnStart = 0
local _returnFrom: { [string]: any }? = nil

local _fireflyAnchor: BasePart? = nil
local _firefly: ParticleEmitter? = nil
local _star: ParticleEmitter? = nil
local _wisp: ParticleEmitter? = nil

--------------------------------------------------------------------------------
-- Fuer andere Controller
--------------------------------------------------------------------------------

-- Aktuelle Werte (Schluessel wie WorldFXConfig.DAY_CURVES). Ohne Tageslauf:
-- die Werte bei 16,9 Uhr.
function DayCycleController.values(): { [string]: any }
	return _values
end

-- 0 = Nachmittag, 1 = blaue Stunde.
function DayCycleController.dusk(): number
	return _dusk
end

-- Nach einem kurzen fremden Farbwechsel (Kronen-Blinken, Paket G): beim
-- naechsten Takt alle angemeldeten Teile wieder auf den Tageslauf setzen.
function DayCycleController.refreshGlow()
	_lastGlow = -1
	local glow = math.clamp(_values.glow or 0, 0, 1)
	for _, g in _glows do
		g.part.Color = g.day:Lerp(g.night, glow)
	end
end

-- Ein Neon-Teil leuchtet mit dem Tageslauf: Farbe `day` bei glow = 0,
-- `night` bei glow = 1.
function DayCycleController.registerGlow(part: BasePart, day: Color3, night: Color3)
	table.insert(_glows, { part = part, day = day, night = night })
	part.Color = day:Lerp(night, math.clamp(_values.glow or 0, 0, 1))
end

--------------------------------------------------------------------------------
-- Show-Vorrang
--------------------------------------------------------------------------------

-- Faerbt gerade ein Show-Filter? (TintColor nicht weiss oder Helligkeit/
-- Saettigung/Kontrast nicht null.)
local function showActive(): boolean
	local cc = Lighting:FindFirstChild(SHOW_FILTER)
	if not (cc and cc:IsA("ColorCorrectionEffect")) then
		return false
	end
	local tint = cc.TintColor
	return tint.R < 0.99 or tint.G < 0.99 or tint.B < 0.99
		or math.abs(cc.Brightness) > 0.01 or math.abs(cc.Saturation) > 0.01 or math.abs(cc.Contrast) > 0.01
end

-- Paket I (ZoneLightController): Faktoren auf Dichte und Dunst der
-- Atmosphaere. Gibt false zurueck, wenn der Tageslauf aus ist (dann setzt der
-- Aufrufer die Atmosphaere selbst).
function DayCycleController.setAtmosphereScale(density: number, haze: number): boolean
	_atmScale.density = density
	_atmScale.haze = haze
	return _running
end

-- Fuer andere Controller: laeuft gerade eine Faehigkeiten-Show mit Farbfilter?
-- (Paket G haelt grosse Welt-Momente solange zurueck.)
function DayCycleController.showActive(): boolean
	return showActive()
end

--------------------------------------------------------------------------------
-- Anwenden
--------------------------------------------------------------------------------

local function apply(v: { [string]: any }, clock: number)
	Lighting.ClockTime            = clock
	Lighting.Brightness           = v.brightness
	Lighting.Ambient              = v.ambient
	Lighting.OutdoorAmbient       = v.outdoorAmbient
	Lighting.ColorShift_Top       = v.colorShiftTop
	Lighting.ExposureCompensation = v.exposure

	local atm = Lighting:FindFirstChild("BaerchiAtmosphere")
	if atm and atm:IsA("Atmosphere") then
		atm.Density = v.atmDensity * _atmScale.density
		atm.Offset  = v.atmOffset
		atm.Color   = v.atmColor
		atm.Decay   = v.atmDecay
		atm.Glare   = v.atmGlare
		atm.Haze    = v.atmHaze * _atmScale.haze
	end

	local bloom = Lighting:FindFirstChild("BaerchiBloom")
	if bloom and bloom:IsA("BloomEffect") then
		bloom.Intensity = v.bloomIntensity
		bloom.Threshold = v.bloomThreshold
		bloom.Size      = v.bloomSize
	end

	local cc = Lighting:FindFirstChild("BaerchiColorCorrection")
	if cc and cc:IsA("ColorCorrectionEffect") then
		cc.Saturation = v.ccSaturation
		cc.Contrast   = v.ccContrast
		cc.TintColor  = v.ccTint
	end

	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		clouds.Color = v.terrainCloudColor
	end

	-- Wolkenpuffs (AmbienceController): nur bei spuerbarer Aenderung
	local cloud: Color3 = v.cloudColor
	local last = _lastCloud
	if #_cloudParts > 0 and (not last or math.abs(last.R - cloud.R) + math.abs(last.G - cloud.G) + math.abs(last.B - cloud.B) > 0.01) then
		_lastCloud = cloud
		for _, part in _cloudParts do
			part.Color = cloud
		end
	end

	-- Leuchten
	if WorldFXKit.enabled("lampGlow") then
		local glow = math.clamp(v.glow, 0, 1)
		if math.abs(glow - _lastGlow) > GLOW_STEP then
			_lastGlow = glow
			for _, g in _glows do
				g.part.Color = g.day:Lerp(g.night, glow)
			end
		end
	end

	-- Pollen (Paket F): nur bei spuerbarer Aenderung
	local pollen = _pollen
	local pollenColor: Color3 = v.pollenColor
	local lastPollen = _lastPollen
	if pollen and (not lastPollen or math.abs(lastPollen.R - pollenColor.R) + math.abs(lastPollen.G - pollenColor.G)
		+ math.abs(lastPollen.B - pollenColor.B) > 0.01) then
		_lastPollen = pollenColor
		pollen.Color = ColorSequence.new(pollenColor)
	end

	-- Emitter: Rate folgt der Kurve
	local firefly = _firefly
	if firefly then
		firefly.Rate = WorldFXConfig.FIREFLY_RATE * v.fireflies
	end
	local star = _star
	if star then
		star.Rate = WorldFXConfig.STAR_RATE * v.stars
	end
	local wisp = _wisp
	if wisp then
		wisp.Color = ColorSequence.new(cloud)
	end
end

--------------------------------------------------------------------------------
-- Emitter
--------------------------------------------------------------------------------

local function newEmitter(anchor: BasePart, texture: string): ParticleEmitter?
	local emitter = Instance.new("ParticleEmitter")
	if not WorldFXKit.applyParticleTexture(emitter, texture) then
		emitter:Destroy()
		return nil
	end
	emitter.LockedToPart = false
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.Rate = 0
	emitter.Parent = anchor
	return emitter
end

local function buildEmitters(folder: Instance)
	if WorldFXKit.enabled("fireflies") then
		local anchor = WorldFXKit.anchor("FireflyAnchor", folder, WorldFXConfig.FIREFLY_BOX, Vector3.new(0, -100, 0))
		local e = newEmitter(anchor, "firefly")
		if e then
			e.Color = ColorSequence.new(WorldFXConfig.FIREFLY_COLOR)
			e.LightEmission = 1
			e.Lifetime = NumberRange.new(4, 7)
			e.Speed = NumberRange.new(0.3, 1.2)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.45),
				NumberSequenceKeypoint.new(0.8, 0.45), NumberSequenceKeypoint.new(1, 0),
			})
			-- sanftes An- und Abschwellen (eine Kurve, weit unter 3 Hz)
			e.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.1),
				NumberSequenceKeypoint.new(0.6, 0.5), NumberSequenceKeypoint.new(0.8, 0.1),
				NumberSequenceKeypoint.new(1, 1),
			})
			_firefly = e
			_fireflyAnchor = anchor
		end
	end

	if WorldFXKit.enabled("stars") then
		local anchor = WorldFXKit.anchor("StarAnchor", folder, WorldFXConfig.STAR_BOX,
			Vector3.new(0, WorldFXConfig.STAR_HEIGHT, 0))
		local e = newEmitter(anchor, "star_twinkle")
		if e then
			e.Color = ColorSequence.new(Color3.new(1, 1, 1))
			e.LightEmission = 1
			e.Lifetime = NumberRange.new(10, 16)
			e.Speed = NumberRange.new(0, 0)
			e.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.15, 5),
				NumberSequenceKeypoint.new(0.85, 5), NumberSequenceKeypoint.new(1, 0),
			})
			e.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.2),
				NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(0.8, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			})
			_star = e
		end
	end

	-- Schleier nur mit hochgeladenem Wolkenbild: der Rueckfall (Funkeln)
	-- saehe als Wolke falsch aus.
	if WorldFXKit.enabled("cloudWisps") and WorldFXKit.textureId("cloud_puff_flipbook") then
		local anchor = WorldFXKit.anchor("WispAnchor", folder, WorldFXConfig.WISP_BOX,
			Vector3.new(0, WorldFXConfig.WISP_HEIGHT, 0))
		local e = newEmitter(anchor, "cloud_puff_flipbook")
		if e then
			-- nicht blaettern: jede Wolke behaelt ihre Variante
			e.FlipbookMode = Enum.ParticleFlipbookMode.OneShot
			e.FlipbookFramerate = NumberRange.new(0, 0)
			e.Rate = WorldFXConfig.WISP_RATE
			e.Lifetime = NumberRange.new(50, 70)
			e.Speed = NumberRange.new(0.5, 1.5)
			e.SpreadAngle = Vector2.new(10, 180)
			e.Size = NumberSequence.new(110)
			e.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.35),
				NumberSequenceKeypoint.new(0.8, 0.35), NumberSequenceKeypoint.new(1, 1),
			})
			_wisp = e
		end
	end
end

-- Gluehwuermchen auf offenes Wasser vor der Kamera legen. Kein Wasser in
-- Sicht: der Anker geht tief unter die Welt (Rate laeuft weiter, sieht keiner).
local function placeFireflies()
	local anchor = _fireflyAnchor
	local camera = workspace.CurrentCamera
	if not (anchor and camera) then return end
	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(1, 0, 0)
	local eye = camera.CFrame.Position
	local waterY = MapConfig.PLATFORM_TOP_Y - MapConfig.WATER_DROP + 2.5   -- knapp ueber dem Wasser
	for _, turn in { 0, 0.6, -0.6, 1.2, -1.2 } do
		local dir = CFrame.Angles(0, turn, 0):VectorToWorldSpace(flat)
		local p = eye + dir * WorldFXConfig.FIREFLY_AHEAD
		if MapLayout.isOpenWater(p.X, p.Z, 8) then
			anchor.Position = Vector3.new(p.X, waterY, p.Z)
			return
		end
	end
	anchor.Position = Vector3.new(0, -200, 0)
end

--------------------------------------------------------------------------------
-- Einsammeln: Laternen, Tropfen, Wolken
--------------------------------------------------------------------------------

local function collectGlows()
	local platform = workspace:WaitForChild("Platform", 60)
	if not platform then return end
	local scenery = platform:WaitForChild("Scenery", 30)
	if scenery then
		for _, child in scenery:GetChildren() do
			if child:IsA("BasePart") and (WorldFXConfig.LAMP_NAMES :: any)[child.Name] then
				DayCycleController.registerGlow(child, WorldFXConfig.LAMP_DAY, WorldFXConfig.LAMP_NIGHT)
			end
		end
	end
	-- Der leuchtende Tropfen auf dem Honigmast
	local mast = platform:WaitForChild("Honigmast", 30)
	local drop = mast and mast:FindFirstChild("Tropfen", true)
	if drop and drop:IsA("BasePart") then
		DayCycleController.registerGlow(drop, WorldFXConfig.MAST.CELL_DAY:Lerp(drop.Color, 0.6), WorldFXConfig.MAST.CELL_NIGHT)
	end
	_lastGlow = -1
end

local function collectClouds()
	local ambience = workspace:WaitForChild("BaerchiAmbience", 30)
	if ambience and FeatureFlags.isOn("WORLD_F_LIFE") and WorldFXKit.enabled("pollenTint") then
		local anchor = ambience:FindFirstChild("PollenAnchor")
		local emitter = anchor and anchor:FindFirstChildOfClass("ParticleEmitter")
		if emitter then _pollen = emitter end
	end
	local clouds = ambience and ambience:WaitForChild("Clouds", 30)
	if not clouds then return end
	for _, part in clouds:GetDescendants() do
		if part:IsA("BasePart") then
			table.insert(_cloudParts, part)
		end
	end
	_lastCloud = nil
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function DayCycleController.init()
	-- Debug (Studio): feste Uhrzeit fuer Screenshot-Vergleiche, "auto" = Zyklus
	WorldFXKit.onDebug("DebugDayTime", function(value: any)
		_override = if typeof(value) == "number" and value > 0 then value else nil
	end)

	if not (AmbienceConfig.DAY_CYCLE and WorldFXKit.enabled("dayCycle")) then
		print("[DayCycle] aus (fester Himmel)")
		return
	end

	_running = true
	local folder = WorldFXKit.folder("DayCycle", WorldFXKit.root())
	buildEmitters(folder)
	task.spawn(collectGlows)
	task.spawn(collectClouds)

	local acc = 0
	local fireflyAcc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < WorldFXConfig.DAY.TICK then return end
		acc = 0

		local clock = _override or DayCycle.clockAt(workspace:GetServerTimeNow())
		local d = DayCycle.duskOf(clock)
		local live = DayCycle.valuesAt(d)

		-- Show-Vorrang: anhalten, danach weich zurueck
		if showActive() then
			if not _held then
				_held = _values
			end
			return
		end
		local held = _held
		if held then
			_held = nil
			_returnFrom = held
			_returnStart = os.clock()
		end
		local from = _returnFrom
		if from then
			local t = (os.clock() - _returnStart) / WorldFXConfig.DAY.RETURN_SECONDS
			if t >= 1 then
				_returnFrom = nil
			else
				live = DayCycle.blend(from, live, t * t * (3 - 2 * t))
			end
		end

		_values = live
		_dusk = d
		apply(live, clock)

		fireflyAcc += WorldFXConfig.DAY.TICK
		if fireflyAcc >= 1 then
			fireflyAcc = 0
			if live.fireflies > 0 then
				placeFireflies()
			end
		end
	end)

	print(string.format("[DayCycle] an | %d min Zyklus, %.1f–%.1f Uhr | %s",
		WorldFXConfig.DAY.PERIOD // 60, WorldFXConfig.DAY.CLOCK_MIN, WorldFXConfig.DAY.CLOCK_MAX,
		if WorldFXKit.quality() == 1 then "hoch" else "niedrig"))
end

return DayCycleController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX34"><Properties>
<string name="Name">HubEventController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- HubEventController.luau
-- StarterPlayerScripts/Controllers/HubEventController.luau
--
-- Einzige Zustaendigkeit:
--   - Die Hauptinsel zeigt den Event-Zustand (Paket C, "Welt aufwerten"):
--     Wimpelkette und Lichter am Event-Pit (Ruhe / startet bald / laeuft),
--     kreisende Wespen und Puls am Wespen-Nest (ruhig / Boss bald oder da)
--
-- Der Client erfindet keine Event-Logik. Er liest, was der Server ohnehin in
-- die Welt schreibt:
--   * Event laeuft     = der Ring des Event-Pits ist Neon (MapService.setEventPitTheme),
--                        seine Farbe ist die Event-Farbe
--   * Restzeit         = die Countdown-Tafel ueber dem Pit ("in 0:45"), jede
--                        Sekunde vom Server beschrieben (EventService.tick)
--   * Boss bald/da     = das Wespen-Nest leuchtet (MapService.setWaspNest,
--                        WASP_NEST.glowSeconds vor dem Boss und waehrenddessen)
-- Warum nicht EventPhaseChanged: die Join-Meldung landet in der Warteschlange
-- und geht an den ersten Zuhoerer (PetBar), dieser Controller kaeme zu spaet.
--
-- PERFORMANCE: EIN Takt (20x pro Sekunde); die Wimpel bewegt EIN
-- workspace:BulkMoveTo, nur wenn der Pit-Rahmen in Sichtweite ist. Keine
-- Lichter, kein Emitter. Puls weit unter 3 Hz.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local SoundService      = game:GetService("SoundService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit = require(script.Parent.WorldFXKit)
-- Paket G: Event-Start als Welt-Moment (Krone blinkt, Bienen ziehen los)
local WorldMomentController = require(script.Parent.WorldMomentController)
-- Paket H: Stimmengewirr am Pit nur waehrend eines Events
local SoundscapeController = require(script.Parent.SoundscapeController)

local HubEventController = {}

local TICK = 0.05
local TAU = math.pi * 2

export type PitState = "idle" | "soon" | "live"

type Pennant = { part: BasePart, hang: CFrame, phase: number }

local _pitGroup: Instance? = nil
local _pennants: { Pennant } = {}
local _pennantParts: { BasePart } = {}
local _lanterns: { BasePart } = {}
local _lights: { BasePart } = {}
local _pitState: PitState = "idle"
local _pitStateKnown = false   -- erst nach dem ersten Lesen: ein Beitritt mitten im Event ist kein Start
local _pitOverride: PitState? = nil
local _eventColor = Color3.fromRGB(255, 214, 110)

local _nestGroup: Instance? = nil
local _nestCenter = Vector3.zero
local _wasps: { Model } = {}
local _pulse: BasePart? = nil
local _hum: Sound? = nil
local _nestBoss = false
local _nestOverride: boolean? = nil

--------------------------------------------------------------------------------
-- Event-Zustand aus der Welt lesen
--------------------------------------------------------------------------------

local _ring: BasePart? = nil
local _sub: TextLabel? = nil

local function findPitSources()
	local platform = workspace:WaitForChild("Platform", 60)
	local pit = platform and platform:WaitForChild("EventPit", 30)
	if not pit then return end
	local ring = pit:WaitForChild("EventRing", 30)
	if ring and ring:IsA("BasePart") then _ring = ring end
	local anchor = pit:WaitForChild("EventBannerAnchor", 30)
	local banner = anchor and anchor:WaitForChild("Banner", 30)
	local sub = banner and banner:WaitForChild("Sub", 30)
	if sub and sub:IsA("TextLabel") then _sub = sub end
end

-- Restzeit aus "noch 3:12" / "in 0:45" (Sprache egal: nur die Uhrzeit zaehlt).
local function remainingSeconds(): number?
	local sub = _sub
	if not sub then return nil end
	local m, s = string.match(sub.Text, "(%d+):(%d%d)")
	if not (m and s) then return nil end
	return (tonumber(m) :: number) * 60 + (tonumber(s) :: number)
end

local function readPitState(): PitState
	local override = _pitOverride
	if override then return override end
	local ring = _ring
	if ring and ring.Material == Enum.Material.Neon then
		_eventColor = ring.Color
		return "live"
	end
	local left = remainingSeconds()
	if left and left <= WorldFXConfig.PIT_FRAME.SOON_SECONDS then
		return "soon"
	end
	return "idle"
end

--------------------------------------------------------------------------------
-- Pit-Rahmen
--------------------------------------------------------------------------------

local function pitFloorY(): number
	return MapConfig.PLATFORM_TOP_Y + MapConfig.EVENT_PIT_GROUND_CLEARANCE
end

local function buildPitFrame(folder: Instance)
	local cfg = WorldFXConfig.PIT_FRAME
	local group = WorldFXKit.folder("PitFrame", folder)
	local pennantId = WorldFXKit.textureId("pennant_fabric")

	local count = MapConfig.PLOT_COUNT
	local tops: { Vector3 } = {}
	for k = 0, count - 1 do
		-- Masten in den Zaunfeldern zwischen zwei Stegen (Test: map_layout)
		local foot = MapLayout.atAngle(180 / count + k * (360 / count), cfg.POLE_RADIUS)
		foot = Vector3.new(foot.X, pitFloorY() - 0.3, foot.Z)
		WorldFXKit.pole("Pole", group, foot, cfg.POLE_HEIGHT, 0.5, cfg.POLE_COLOR, Enum.Material.Wood)
		local top = foot + Vector3.new(0, cfg.POLE_HEIGHT, 0)
		table.insert(tops, top)
		table.insert(_lanterns, WorldFXKit.ball("Lantern", group, 1.2, top + Vector3.new(0, 0.5, 0), cfg.LANTERN_OFF, Enum.Material.SmoothPlastic))
	end

	-- Kette zwischen zwei Nachbarmasten, mit Durchhang
	local colorIndex = 0
	for k = 1, count do
		local a, b = tops[k], tops[k % count + 1]
		local chord = b - a
		local along = Vector3.new(chord.X, 0, chord.Z).Unit
		local function hangAt(t: number): Vector3
			return a + chord * t - Vector3.new(0, cfg.SAG * 4 * t * (1 - t), 0)
		end
		for i = 1, cfg.PENNANTS do
			local t = i / (cfg.PENNANTS + 1)
			local hang = CFrame.fromMatrix(hangAt(t), along, Vector3.yAxis)
			colorIndex += 1
			local color = cfg.PENNANT_COLORS[(colorIndex - 1) % #cfg.PENNANT_COLORS + 1]
			local part = WorldFXKit.part("Pennant", group, cfg.PENNANT_SIZE,
				hang * CFrame.new(0, -cfg.PENNANT_SIZE.Y * 0.5, 0), color, Enum.Material.Fabric)
			if pennantId then
				part.Transparency = 1
				for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
					local decal = Instance.new("Decal")
					decal.Texture = pennantId
					decal.Face = face
					decal.Color3 = color
					decal.Parent = part
				end
			end
			table.insert(_pennants, { part = part, hang = hang, phase = k * 0.9 + i * 0.55 })
			table.insert(_pennantParts, part)
		end
		for i = 1, cfg.LIGHTS do
			local t = (i - 0.5) / cfg.LIGHTS
			table.insert(_lights, WorldFXKit.ball("Light", group, 0.45, hangAt(t) + Vector3.new(0, 0.15, 0),
				cfg.LIGHT_OFF, Enum.Material.SmoothPlastic))
		end
	end

	_pitGroup = group
	WorldFXKit.cullGroup(group, MapConfig.CENTER, cfg.SHOW_DISTANCE)
end

local function applyPitState(state: PitState)
	local cfg = WorldFXConfig.PIT_FRAME
	for _, lantern in _lanterns do
		local on = state ~= "idle"
		lantern.Color = if on then cfg.LANTERN_ON else cfg.LANTERN_OFF
		lantern.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
	if state ~= "live" then
		for _, light in _lights do
			light.Color = cfg.LIGHT_OFF
			light.Material = Enum.Material.SmoothPlastic
		end
	else
		for _, light in _lights do
			light.Material = Enum.Material.Neon
		end
	end
end

local function stepPit(clock: number)
	local group = _pitGroup
	if not (group and group.Parent) then return end
	local cfg = WorldFXConfig.PIT_FRAME

	-- Wimpel: ein gemeinsamer Wind, je Wimpel versetzt; ein BulkMoveTo
	if WorldFXKit.enabled("pitFlutter") then
		local amp = math.rad(if _pitState == "idle" then cfg.FLUTTER_CALM else cfg.FLUTTER_SOON)
		local cframes = table.create(#_pennants)
		for i, p in _pennants do
			local swing = amp * math.sin(clock * cfg.FLUTTER_RATE * TAU + p.phase)
			cframes[i] = p.hang * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -cfg.PENNANT_SIZE.Y * 0.5, 0)
		end
		workspace:BulkMoveTo(_pennantParts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end

	-- Lichterkette pulsiert langsam in der Event-Farbe
	if _pitState == "live" then
		local k = 0.5 + 0.5 * math.sin(clock * cfg.PULSE_RATE * TAU)
		local color = cfg.LIGHT_OFF:Lerp(_eventColor, 0.35 + 0.65 * k)
		for _, light in _lights do
			light.Color = color
		end
	end
end

--------------------------------------------------------------------------------
-- Wespen-Nest
--------------------------------------------------------------------------------

local function buildNest(folder: Instance)
	local platform = workspace:WaitForChild("Platform", 60)
	local nest = platform and platform:WaitForChild("WaspNest", 30)
	if not nest then return end
	local cfg = WorldFXConfig.WASP_NEST
	local group = WorldFXKit.folder("NestLife", folder)
	_nestCenter = MapLayout.waspNestCenter()

	if WorldFXKit.enabled("waspSwarm") then
		for i = 1, cfg.WASPS_BOSS do
			local model = Instance.new("Model")
			model.Name = "Wasp"
			local body = WorldFXKit.ellipsoid("Body", model, Vector3.new(0.38, 0.38, 0.62), CFrame.new(), cfg.WASP_COLOR,
				Enum.Material.SmoothPlastic)
			WorldFXKit.part("Stripe", model, Vector3.new(0.4, 0.12, 0.2), CFrame.new(0, 0, 0.05), cfg.STRIPE_COLOR, Enum.Material.SmoothPlastic)
			model.PrimaryPart = body
			model.Parent = if i <= cfg.WASPS_CALM then group else nil
			table.insert(_wasps, model)
		end
	end

	if WorldFXKit.enabled("waspPulse") then
		local body = nest:FindFirstChild("Body")
		local size = if body and body:IsA("BasePart") then body.Size * 1.18 else Vector3.new(5, 6, 5)
		local pulse = WorldFXKit.ellipsoid("Pulse", group, size, CFrame.new(_nestCenter), cfg.PULSE_COLOR,
			Enum.Material.Neon)
		pulse.Transparency = 1
		_pulse = pulse

		local humId = WorldFXConfig.SOUNDS.waspHum
		if humId ~= "" then
			local soundGroup = SoundService:FindFirstChild("WorldAmbience")
			if not soundGroup then
				local created = Instance.new("SoundGroup")
				created.Name = "WorldAmbience"
				created.Parent = SoundService
				soundGroup = created
			end
			local hum = Instance.new("Sound")
			hum.SoundId = humId
			hum.Looped = true
			hum.Volume = WorldFXConfig.SOUND_VOLUME.waspHum
			hum.RollOffMaxDistance = 60
			hum.RollOffMinDistance = 8
			hum.SoundGroup = soundGroup :: SoundGroup
			hum.Parent = pulse
			hum:Play()
			_hum = hum
		end
	end

	_nestGroup = group
	WorldFXKit.cullGroup(group, _nestCenter, cfg.SHOW_DISTANCE)

	-- Boss bald/da: das Nest leuchtet (Server)
	local body = nest:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		local function refresh()
			_nestBoss = body.Material == Enum.Material.Neon
		end
		body:GetPropertyChangedSignal("Material"):Connect(refresh)
		refresh()
	end
end

local function stepNest(clock: number)
	local group = _nestGroup
	if not (group and group.Parent) then return end
	local cfg = WorldFXConfig.WASP_NEST
	local boss = if _nestOverride ~= nil then _nestOverride else _nestBoss

	local count = if boss then cfg.WASPS_BOSS else cfg.WASPS_CALM
	for i, wasp in _wasps do
		local show = i <= count
		if show ~= (wasp.Parent ~= nil) then
			wasp.Parent = if show then group else nil
		end
		if show then
			local speed = cfg.ORBIT_SPEED * (1 + 0.18 * i) * (if boss then 1.6 else 1)
			local a = clock * speed * TAU + i * TAU / count
			local r = cfg.ORBIT_RADIUS + 0.7 * math.sin(clock * 1.3 + i)
			local pos = _nestCenter + Vector3.new(math.cos(a) * r, math.sin(clock * 2 + i * 1.7) * 1.2, math.sin(a) * r)
			local ahead = Vector3.new(-math.sin(a), 0, math.cos(a))
			wasp:PivotTo(CFrame.lookAt(pos, pos + ahead))
		end
	end

	local pulse = _pulse
	if pulse then
		pulse.Transparency = if boss then 0.6 + 0.25 * math.sin(clock * cfg.PULSE_RATE * TAU) else 1
	end
	local hum = _hum
	if hum then
		hum.Volume = WorldFXConfig.SOUND_VOLUME.waspHum * (if boss then 1.5 else 1)
	end
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function HubEventController.init()
	if not FeatureFlags.isOn("WORLD_C_HUB") then return end
	local folder = WorldFXKit.folder("HubEvents", WorldFXKit.root())

	if WorldFXKit.enabled("pitFrame") then
		buildPitFrame(folder)
		task.spawn(findPitSources)
	end
	task.spawn(buildNest, folder)

	-- Debug (Studio): Zustaende erzwingen, "auto" = aus der Welt lesen
	WorldFXKit.onDebug("DebugPitState", function(value: any)
		_pitOverride = if value == "idle" or value == "soon" or value == "live" then value else nil
		if _pitOverride == "live" then
			_eventColor = Color3.fromRGB(255, 140, 240)
		end
	end)
	WorldFXKit.onDebug("DebugNestState", function(value: any)
		_nestOverride = if value == "boss" then true elseif value == "calm" then false else nil
	end)

	local acc, stateAcc, clock = 0, 1, 0
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		acc += dt
		stateAcc += dt
		if stateAcc >= 0.5 then
			stateAcc = 0
			local state = readPitState()
			if state ~= _pitState then
				if state == "live" and _pitStateKnown then
					WorldMomentController.eventStarted()
				end
				_pitState = state
				applyPitState(state)
				SoundscapeController.setEventLive(state == "live")
			end
			_pitStateKnown = _ring ~= nil or _pitOverride ~= nil
		end
		if acc < TICK then return end
		acc = 0
		stepPit(clock)
		stepNest(clock)
	end)

	print("[HubEvents] aktiv")
end

return HubEventController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX35"><Properties>
<string name="Name">HubLandmarkController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- HubLandmarkController.luau
-- StarterPlayerScripts/Controllers/HubLandmarkController.luau
--
-- Einzige Zustaendigkeit:
--   - Die festen Wahrzeichen der Hauptinsel aufwerten (Paket C, "Welt
--     aufwerten"): Wabenkrone und Honigfaden am Honigmast, Wegweiser an den
--     Wegen, Laterne und Eierkorb am Haendler, Holzrahmen mit Krone an den
--     Tafeln und der Glanz auf Platz 1
--
-- Was auf Events reagiert (Pit-Rahmen, Wespen-Nest), steht in
-- HubEventController; die Ankunft in ArrivalController.
--
-- Alles nur auf dem Client (WorldFX_Local): kein Server-Teil, keine
-- Replikation, die Wegweiser in der Sprache des Betrachters. Positionen aus
-- MapLayout/MapConfig (Test: map_layout.test.lua), Zahlen aus WorldFXConfig.
--
-- PERFORMANCE: EIN Takt (20x pro Sekunde) fuer Tropfen und Glanz, nur wenn
-- die jeweilige Gruppe in Sichtweite ist (WorldFXKit.cullGroup). Wegweiser,
-- Haendler-Deko und Rahmen stehen still und kosten ausser Sichtweite nichts.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)
local Loc           = require(ReplicatedStorage.Localization.Loc)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)

local HubLandmarkController = {}

local localPlayer = Players.LocalPlayer
local UPRIGHT = WorldFXKit.UPRIGHT
local TICK = 0.05

-- Mast-Fuss: Oberkante des Event-Pit-Podests (wie WorldBuilder.buildPlatform)
local MAST_FOOT = Vector3.new(
	MapConfig.CENTER.X,
	MapConfig.PLATFORM_TOP_Y + MapConfig.EVENT_PIT_GROUND_CLEARANCE + MapConfig.EVENT_PIT_FLOOR_HEIGHT,
	MapConfig.CENTER.Z
)

type Drip = { group: Instance, drop: BasePart, ring: BasePart, spout: Vector3, surfaceY: number, cycleStart: number }
local _drip: Drip? = nil

type Shine = { gradient: UIGradient, group: Instance }
local _shines: { Shine } = {}

type SignLabel = { label: TextLabel, slot: number }
local _islandLabels: { SignLabel } = {}

--------------------------------------------------------------------------------
-- Honigmast: Wabenkrone
--------------------------------------------------------------------------------

-- Ein Teil, dessen +X nach `outward` zeigt (Zylinder-Stirnseite nach aussen).
local function facing(position: Vector3, outward: Vector3): CFrame
	return CFrame.fromMatrix(position, outward, Vector3.yAxis)
end

local _crownCells: { BasePart } = {}

local function buildCrown(folder: Instance)
	local cfg = WorldFXConfig.MAST
	local model = Instance.new("Model")
	model.Name = "MastCrown"
	local combId = WorldFXKit.textureId("amber_comb")

	for row = 0, 1 do
		local y = MAST_FOOT.Y + cfg.CROWN_HEIGHT + (row - 0.5) * cfg.CROWN_ROW_GAP
		for i = 0, cfg.CROWN_CELLS - 1 do
			-- zweite Reihe um eine halbe Zelle versetzt: wie echte Waben
			local angle = (i + row * 0.5) / cfg.CROWN_CELLS * math.pi * 2
			local outward = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local p = Vector3.new(MAST_FOOT.X, y, MAST_FOOT.Z) + outward * cfg.CROWN_RADIUS
			local cell = WorldFXKit.part("Comb", model, Vector3.new(cfg.CELL_DEPTH, cfg.CELL_SIZE, cfg.CELL_SIZE),
				facing(p, outward), cfg.CELL_DAY, Enum.Material.Neon, Enum.PartType.Cylinder)
			if combId then
				local decal = Instance.new("Decal")
				decal.Texture = combId
				decal.Face = Enum.NormalId.Right
				decal.Parent = cell
			end
			DayCycleController.registerGlow(cell, cfg.CELL_DAY, cfg.CELL_NIGHT)
			table.insert(_crownCells, cell)
		end
	end
	model.Parent = folder
end

--------------------------------------------------------------------------------
-- Honigmast: Faden, Tuelle, Schale, Tropfen
--------------------------------------------------------------------------------

local function buildHoneyThread(folder: Instance)
	local cfg = WorldFXConfig.MAST
	local group = WorldFXKit.folder("HoneyThread", folder)
	local angle = math.rad(cfg.THREAD_ANGLE)
	local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))

	-- Faden am Mast herab
	local length = cfg.THREAD_TOP - cfg.THREAD_BOTTOM
	local threadBase = MAST_FOOT + dir * cfg.THREAD_RADIUS + Vector3.new(0, cfg.THREAD_BOTTOM, 0)
	local thread = WorldFXKit.pole("Thread", group, threadBase, length, cfg.THREAD_WIDTH, cfg.HONEY_COLOR, Enum.Material.Glass)
	thread.Transparency = 0.15

	-- Tuelle: waagerecht vom Mast bis ueber die Schale
	local reach = cfg.SPOUT_REACH - cfg.THREAD_RADIUS
	local spoutMid = MAST_FOOT + dir * (cfg.THREAD_RADIUS + reach * 0.5) + Vector3.new(0, cfg.THREAD_BOTTOM, 0)
	WorldFXKit.part("Spout", group, Vector3.new(reach, 0.45, 0.45), facing(spoutMid, dir),
		cfg.BOWL_COLOR, Enum.Material.Wood, Enum.PartType.Cylinder)

	-- Schale auf dem Podest, darin die Honig-Oberflaeche
	local bowlCenter = MAST_FOOT + dir * cfg.SPOUT_REACH
	WorldFXKit.part("Bowl", group, Vector3.new(cfg.BOWL_HEIGHT, cfg.BOWL_RADIUS * 2, cfg.BOWL_RADIUS * 2),
		CFrame.new(bowlCenter + Vector3.new(0, cfg.BOWL_HEIGHT * 0.5, 0)) * UPRIGHT,
		cfg.BOWL_COLOR, Enum.Material.Wood, Enum.PartType.Cylinder)
	local surfaceY = bowlCenter.Y + cfg.BOWL_HEIGHT + 0.02
	local honey = WorldFXKit.part("Honey", group, Vector3.new(0.08, cfg.BOWL_RADIUS * 1.7, cfg.BOWL_RADIUS * 1.7),
		CFrame.new(bowlCenter.X, surfaceY, bowlCenter.Z) * UPRIGHT, cfg.HONEY_COLOR, Enum.Material.Glass, Enum.PartType.Cylinder)
	honey.Reflectance = 0.2

	local drop = WorldFXKit.ball("Drop", nil, cfg.DROP_SIZE, bowlCenter, cfg.HONEY_COLOR, Enum.Material.Glass)
	local ring = WorldFXKit.part("Ring", nil, Vector3.new(0.04, 0.3, 0.3), CFrame.new(), Color3.fromRGB(255, 226, 150),
		Enum.Material.Neon, Enum.PartType.Cylinder)

	_drip = {
		group = group,
		drop = drop,
		ring = ring,
		spout = MAST_FOOT + dir * cfg.SPOUT_REACH + Vector3.new(0, cfg.THREAD_BOTTOM - 0.3, 0),
		surfaceY = surfaceY,
		cycleStart = os.clock(),
	}
	WorldFXKit.cullGroup(group, MAST_FOOT, cfg.SHOW_DISTANCE)
end

-- Ein Tropfen-Zyklus: an der Tuelle wachsen, fallen, Ring in der Schale.
local function stepDrip(now: number)
	local drip = _drip
	if not drip or not drip.group.Parent then return end
	local cfg = WorldFXConfig.MAST
	local t = (now - drip.cycleStart) % cfg.DROP_INTERVAL
	local fallHeight = drip.spout.Y - drip.surfaceY
	local fallTime = math.sqrt(2 * fallHeight / workspace.Gravity)

	if t < cfg.DROP_GROW then
		local k = t / cfg.DROP_GROW
		drip.drop.Size = Vector3.one * (cfg.DROP_SIZE * (0.3 + 0.7 * k))
		drip.drop.Position = drip.spout
		drip.drop.Parent = drip.group
	elseif t < cfg.DROP_GROW + fallTime then
		local f = t - cfg.DROP_GROW
		drip.drop.Position = drip.spout - Vector3.new(0, 0.5 * workspace.Gravity * f * f, 0)
	else
		drip.drop.Parent = nil
		local k = (t - cfg.DROP_GROW - fallTime) / cfg.RING_TIME
		if k < 1 then
			local size = 0.3 + cfg.BOWL_RADIUS * 1.4 * k
			drip.ring.Size = Vector3.new(0.04, size, size)
			drip.ring.CFrame = CFrame.new(drip.spout.X, drip.surfaceY + 0.05, drip.spout.Z) * UPRIGHT
			drip.ring.Transparency = 0.3 + 0.7 * k
			drip.ring.Parent = drip.group
		else
			drip.ring.Parent = nil
		end
	end
end

--------------------------------------------------------------------------------
-- Wegweiser
--------------------------------------------------------------------------------

-- Ein Schild in Baerchi-Form, das in Richtung `dir` zeigt. Text vorn und
-- hinten, je mit dem Pfeil auf der richtigen Seite (wer auf die Vorderseite
-- schaut, hat +X links).
local function buildBoard(parent: Instance, center: Vector3, dir: Vector3, color: Color3): (TextLabel, TextLabel)
	local cfg = WorldFXConfig.SIGNPOST
	local frame = CFrame.fromMatrix(center, dir, Vector3.yAxis)
	local board = WorldFXKit.part("Board", parent, cfg.BOARD_SIZE, frame, color, Enum.Material.Wood)
	local signId = WorldFXKit.textureId("bear_sign")
	if signId then
		-- Form aus dem Bild: Teil unsichtbar, Bild vorn und hinten
		board.Transparency = 1
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local decal = Instance.new("Decal")
			decal.Texture = signId
			decal.Face = face
			decal.Color3 = color
			decal.Parent = board
		end
	else
		-- Ohren oben
		for _, side in { -1, 1 } do
			WorldFXKit.part("Ear", parent, Vector3.new(0.3, 0.75, 0.75),
				frame * CFrame.new(side * cfg.BOARD_SIZE.X * 0.3, cfg.BOARD_SIZE.Y * 0.5, 0) * CFrame.Angles(0, math.rad(90), 0),
				color, Enum.Material.Wood, Enum.PartType.Cylinder)
		end
	end

	local labels = {}
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.PixelsPerStud = 40
		gui.LightInfluence = 1
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(0.9, 0.8)
		label.Position = UDim2.fromScale(0.05, 0.1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = cfg.TEXT_COLOR
		label.Parent = gui
		table.insert(labels, label)
	end
	return labels[1], labels[2]
end

-- Pfeil links (Vorderseite) bzw. rechts (Rueckseite) an den Text haengen.
local function arrowText(front: TextLabel, back: TextLabel, text: string)
	front.Text = "◀ " .. text
	back.Text  = text .. " ▶"
end

local function bindArrow(front: TextLabel, back: TextLabel, key: string, args: { [string]: any }?)
	local function refresh()
		arrowText(front, back, Loc.t(key, args))
	end
	refresh()
	Loc.onChanged(refresh)
end

-- Beschriftung "Insel von X" / "Deine Insel" / "Freie Insel" fuer Slot `slot`.
local function islandText(slot: number): (string, boolean)
	local plot = workspace:FindFirstChild("Plot_" .. slot)
	local ownerId = if plot then plot:GetAttribute("PlotOwner") else nil
	if typeof(ownerId) ~= "number" then
		return Loc.t("world.sign.free"), false
	end
	if ownerId == localPlayer.UserId then
		return Loc.t("world.sign.home"), true
	end
	local owner = Players:GetPlayerByUserId(ownerId)
	return Loc.t("world.sign.island", { name = if owner then owner.DisplayName else "?" }), false
end

local function refreshIslandLabels()
	local cfg = WorldFXConfig.SIGNPOST
	for _, entry in _islandLabels do
		local text, home = islandText(entry.slot)
		local gui = entry.label.Parent
		local board = gui and gui.Parent
		if board and board:IsA("BasePart") then
			board.Color = if home then cfg.HOME_COLOR else cfg.WOOD
			for _, decal in board:GetChildren() do
				if decal:IsA("Decal") then decal.Color3 = board.Color end
			end
		end
		if entry.label.Name == "Front" then
			entry.label.Text = "◀ " .. text
		else
			entry.label.Text = text .. " ▶"
		end
	end
end

-- Ziel, auf das der dritte Arm zeigt: Haendler oder naechste Bestenliste.
local function sideTarget(from: Vector3): (Vector3, string)
	local m = EggConfig.MERCHANT_V2
	local best = MapLayout.atAngle(m.angleDegrees, m.radius)
	local bestDist = (best - from).Magnitude
	local key = "world.sign.merchant"
	for _, b in MapLayout.leaderboardBoards() do
		local p = MapLayout.atAngle(b.angleDegrees, MapConfig.LEADERBOARD_BOARD.radius)
		local d = (p - from).Magnitude
		if d < bestDist then
			best, bestDist, key = p, d, "world.sign.board"
		end
	end
	return best, key
end

local function flatDir(from: Vector3, to: Vector3): Vector3
	local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	return if d.Magnitude > 1e-3 then d.Unit else Vector3.new(1, 0, 0)
end

local function buildSignposts(folder: Instance)
	local cfg = WorldFXConfig.SIGNPOST
	for _, spot in MapLayout.signposts(cfg.RADIUS, cfg.SIDE) do
		local group = WorldFXKit.folder("Signpost_" .. spot.slot, folder)
		local base = spot.position
		WorldFXKit.pole("Post", group, base, cfg.POST_HEIGHT, 0.55, cfg.WOOD_DARK, Enum.Material.Wood)

		local function at(level: number): Vector3
			return base + Vector3.new(0, cfg.POST_HEIGHT - 0.9 - level * cfg.BOARD_GAP, 0)
		end

		-- 1: zur eigenen bzw. dieser Plot-Insel (nach aussen)
		local f1, b1 = buildBoard(group, at(0), spot.outward, cfg.WOOD)
		f1.Name, b1.Name = "Front", "Back"
		table.insert(_islandLabels, { label = f1, slot = spot.slot })
		table.insert(_islandLabels, { label = b1, slot = spot.slot })

		-- 2: zum Event (zur Mitte)
		local f2, b2 = buildBoard(group, at(1), -spot.outward, cfg.WOOD)
		bindArrow(f2, b2, "world.sign.event")

		-- 3: Haendler oder Bestenliste, was naeher ist
		local target, key = sideTarget(base)
		local f3, b3 = buildBoard(group, at(2), flatDir(base, target), cfg.WOOD)
		bindArrow(f3, b3, key)

		WorldFXKit.cullGroup(group, base, cfg.SHOW_DISTANCE)
	end

	refreshIslandLabels()
	Loc.onChanged(refreshIslandLabels)
	-- Plots kommen und gehen mit den Spielern
	local function onWorldChild(child: Instance)
		if string.match(child.Name, "^Plot_%d+$") then
			task.defer(refreshIslandLabels)
		end
	end
	workspace.ChildAdded:Connect(onWorldChild)
	workspace.ChildRemoved:Connect(onWorldChild)
	Players.PlayerAdded:Connect(function() task.delay(1, refreshIslandLabels) end)
end

--------------------------------------------------------------------------------
-- Haendler: Laterne und Eierkorb
--------------------------------------------------------------------------------

local function buildStallDecor(folder: Instance)
	local stand = workspace:WaitForChild("EggMerchant", 60)
	if not (stand and stand:IsA("Model")) then return end
	local counter = stand.PrimaryPart or stand:FindFirstChild("Counter")
	if not (counter and counter:IsA("BasePart")) then return end
	local cfg = WorldFXConfig.STALL

	-- Boden-CFrame des Stands (Theke steht 1,3 ueber dem Boden, siehe EggMerchantService)
	local base = counter.CFrame * CFrame.new(0, -1.3, 0)
	local group = WorldFXKit.folder("StallDecor", folder)

	-- Laterne links neben dem Stand
	local lampFoot = (base * CFrame.new(-4.2, 0, 0.6)).Position
	WorldFXKit.pole("LampPost", group, lampFoot, 4.2, 0.35, WorldFXConfig.SIGNPOST.WOOD_DARK, Enum.Material.Wood)
	local glow = WorldFXKit.ball("LampGlow", group, 1.1, lampFoot + Vector3.new(0, 4.7, 0), cfg.LANTERN_COLOR, Enum.Material.Neon)
	DayCycleController.registerGlow(glow, WorldFXConfig.LAMP_DAY, WorldFXConfig.LAMP_NIGHT)

	-- Korb rechts davor, mit drei Eiern
	local basketCF = base * CFrame.new(4.0, 0.45, -0.8)
	WorldFXKit.part("Basket", group, Vector3.new(0.9, 2.2, 2.2), basketCF * UPRIGHT, cfg.BASKET_COLOR, Enum.Material.WoodPlanks, Enum.PartType.Cylinder)
	for i, color in cfg.EGG_COLORS do
		local a = (i - 1) / #cfg.EGG_COLORS * math.pi * 2
		WorldFXKit.ellipsoid("Egg", group, Vector3.new(0.8, 1.05, 0.8),
			basketCF * CFrame.new(math.cos(a) * 0.45, 0.75, math.sin(a) * 0.45) * CFrame.Angles(math.rad(10) * math.cos(a), 0, math.rad(10) * math.sin(a)),
			color, Enum.Material.SmoothPlastic)
	end

	WorldFXKit.cullGroup(group, base.Position, cfg.SHOW_DISTANCE)
end

--------------------------------------------------------------------------------
-- Tafeln: Rahmen, Krone, Glanz auf Platz 1
--------------------------------------------------------------------------------

local function isBoard(part: Instance): boolean
	return part:IsA("BasePart") and (string.sub(part.Name, 1, 16) == "LeaderboardBoard" or part.Name == "LiveBoard")
		and part:FindFirstChild("Board") ~= nil
end

local _framed: { [Instance]: boolean } = {}

local function frameBoard(board: BasePart, folder: Instance)
	if _framed[board] then return end
	_framed[board] = true
	local cfg = WorldFXConfig.BOARD_FRAME
	local group = WorldFXKit.folder("Frame_" .. board.Name, folder)
	local cf, size = board.CFrame, board.Size
	local depth = size.Z + 0.25
	local hw, hh = size.X * 0.5, size.Y * 0.5

	-- vier Balken
	for _, sy in { -1, 1 } do
		WorldFXKit.part("Beam", group, Vector3.new(size.X + cfg.BEAM * 2, cfg.BEAM, depth),
			cf * CFrame.new(0, sy * (hh + cfg.BEAM * 0.5), 0), cfg.WOOD, Enum.Material.Wood)
	end
	for _, sx in { -1, 1 } do
		WorldFXKit.part("Beam", group, Vector3.new(cfg.BEAM, size.Y, depth),
			cf * CFrame.new(sx * (hw + cfg.BEAM * 0.5), 0, 0), cfg.WOOD, Enum.Material.Wood)
	end
	-- Honig-Ecken
	for _, sx in { -1, 1 } do
		for _, sy in { -1, 1 } do
			WorldFXKit.ball("Corner", group, cfg.CORNER_SIZE,
				(cf * CFrame.new(sx * (hw + cfg.BEAM * 0.5), sy * (hh + cfg.BEAM * 0.5), 0)).Position,
				cfg.CORNER_COLOR, Enum.Material.Glass)
		end
	end
	-- Krone oben: Reif und drei Zacken
	local top = cf * CFrame.new(0, hh + cfg.BEAM + 0.45, 0)
	WorldFXKit.part("CrownBand", group, Vector3.new(0.6, 2.4, 2.4), top * UPRIGHT, cfg.CROWN_COLOR, Enum.Material.Neon, Enum.PartType.Cylinder)
	for i = -1, 1 do
		WorldFXKit.ball("CrownTip", group, 0.6, (top * CFrame.new(i * 0.85, 0.65 - math.abs(i) * 0.15, 0)).Position,
			cfg.CROWN_COLOR, Enum.Material.Neon)
	end

	-- Glanz auf Platz 1 (nur Bestenlisten, nicht das Live-Board)
	if board.Name ~= "LiveBoard" and WorldFXKit.enabled("boardShine") then
		local gui = board:FindFirstChild("Board")
		local line = gui and gui:FindFirstChild("Line1")
		if line and line:IsA("GuiObject") then
			local shine = Instance.new("Frame")
			shine.Name = "Shine"
			shine.BackgroundColor3 = Color3.new(1, 1, 1)
			shine.BorderSizePixel = 0
			shine.Position = line.Position
			shine.Size = line.Size
			shine.ZIndex = line.ZIndex + 1
			shine.Parent = gui
			local gradient = Instance.new("UIGradient")
			gradient.Rotation = 20
			gradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.42, 1),
				NumberSequenceKeypoint.new(0.5, 0.55), NumberSequenceKeypoint.new(0.58, 1),
				NumberSequenceKeypoint.new(1, 1),
			})
			gradient.Parent = shine
			table.insert(_shines, { gradient = gradient, group = group })
		end
	end

	WorldFXKit.cullGroup(group, cf.Position, cfg.SHOW_DISTANCE)
end

local function buildBoardFrames(folder: Instance)
	local platform = workspace:WaitForChild("Platform", 60)
	if not platform then return end
	for _, child in platform:GetChildren() do
		if isBoard(child) then
			frameBoard(child :: BasePart, folder)
		end
	end
	platform.ChildAdded:Connect(function(child)
		task.defer(function()
			if isBoard(child) then frameBoard(child :: BasePart, folder) end
		end)
	end)
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

-- Paket G (Event startet): die Wabenkrone blinkt zweimal auf (2 Hz, unter
-- der 3-Hz-Grenze), danach gilt wieder der Tageslauf.
function HubLandmarkController.flashCrown()
	if #_crownCells == 0 then return end
	task.spawn(function()
		for _ = 1, 2 do
			for _, cell in _crownCells do cell.Color = Color3.fromRGB(255, 244, 200) end
			task.wait(0.25)
			DayCycleController.refreshGlow()
			task.wait(0.25)
		end
	end)
end

function HubLandmarkController.init()
	if not FeatureFlags.isOn("WORLD_C_HUB") then return end
	local folder = WorldFXKit.folder("Hub", WorldFXKit.root())

	if WorldFXKit.enabled("mastCrown") then
		buildCrown(folder)
	end
	if WorldFXKit.enabled("honeyThread") then
		buildHoneyThread(folder)
	end
	if WorldFXKit.enabled("signposts") then
		buildSignposts(folder)
	end
	if WorldFXKit.enabled("stallDecor") then
		task.spawn(buildStallDecor, folder)
	end
	if WorldFXKit.enabled("boardFrames") then
		task.spawn(buildBoardFrames, folder)
	end

	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < TICK then return end
		acc = 0
		local now = os.clock()
		stepDrip(now)
		-- Glanzstreifen wandert ueber Platz 1 (nur sichtbare Tafeln)
		local offset = ((now / WorldFXConfig.BOARD_FRAME.SHINE_PERIOD) % 1) * 2 - 1
		for _, shine in _shines do
			if shine.group.Parent then
				shine.gradient.Offset = Vector2.new(offset, 0)
			end
		end
	end)

	print("[Hub] Wahrzeichen aktiv")
end

return HubLandmarkController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX36"><Properties>
<string name="Name">LifeController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- LifeController.luau
-- StarterPlayerScripts/Controllers/LifeController.luau
--
-- Einzige Zustaendigkeit:
--   - Kleine Bewegung ueberall (Paket F, "Welt aufwerten"): Bienenschwaerme
--     zwischen Blumen und Teichen, Schmetterlinge auf der Hauptinsel, Blumen
--     nicken im Wind und weichen dem eigenen Charakter aus, Pfotenabdruecke
--     im Sand
--
-- Die Pollenfarbe folgt dem Tageslauf; das macht DayCycleController (dort
-- haengt jede Farbe, die am Tageslauf haengt).
--
-- PERFORMANCE:
--   * EIN Takt (15x pro Sekunde). Bienen, Schmetterlinge und Blumen bewegt je
--     EIN workspace:BulkMoveTo, nur was in Sichtweite ist.
--   * Bienen: hoechstens BEES.MAX_SWARMS Schwaerme in Sicht (plus
--     HOME_EXTRA auf der eigenen Insel), aus einem festen Pool.
--   * Die Blumen der Hauptinsel sind Server-Teile; sie werden nur lokal
--     gedreht (der Server setzt sie nie wieder), nichts wird repliziert.
--   * Pfotenabdruecke: Pool von FOOTPRINTS.MAX, kein Neubau.
--   * Niedrige Qualitaet: alles aus Paket F aus (WorldFXConfig.MIN_QUALITY).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local PlotLifeController = require(script.Parent.PlotLifeController)

local LifeController = {}

local localPlayer = Players.LocalPlayer
local TICK = 1 / 15
local TAU = math.pi * 2

--------------------------------------------------------------------------------
-- Orte, an denen Leben ist
--------------------------------------------------------------------------------

type Site = { position: Vector3, home: boolean }

-- Feste Orte auf der Hauptinsel (in den Wiesenstuecken zwischen den Wegen)
local function hubSites(): { Site }
	local list: { Site } = {}
	for k = 0, MapConfig.PLOT_COUNT - 1 do
		for _, r in { 70, 96 } do
			local angle = 22.5 + k * 45 + (if r == 70 then 8 else -8)
			table.insert(list, { position = MapLayout.atAngle(angle, r), home = false })
		end
	end
	return list
end

-- Orte auf den besetzten Plot-Inseln: der Teich und zwei Randpunkte
local function plotSites(): { Site }
	local list: { Site } = {}
	local home = PlotLifeController.homeSlot()
	for slot = 1, MapConfig.PLOT_COUNT do
		if workspace:FindFirstChild("Plot_" .. slot) then
			local center = MapLayout.plotCenter(slot)
			local plotCF = CFrame.lookAt(center, Vector3.new(MapConfig.CENTER.X, center.Y, MapConfig.CENTER.Z))
			local isHome = slot == home
			table.insert(list, { position = (plotCF * CFrame.new(MapLayout.pondOffset())).Position, home = isHome })
			for _, angle in { 75, 285 } do
				local p = MapLayout.islandRimPoint(slot, angle, WorldFXConfig.ISLAND_STAGE.RIM_RADIUS)
				table.insert(list, { position = p, home = isHome })
			end
		end
	end
	return list
end

--------------------------------------------------------------------------------
-- Bienen
--------------------------------------------------------------------------------

type Swarm = { parts: { BasePart }, count: number, site: Site?, phase: number, center: Vector3? }
local SWARM_SPEED = 14   -- Studs/s: so schnell zieht ein Schwarm zu seinem neuen Ort
local _rally: { position: Vector3, untilTime: number }? = nil
local _swarms: { Swarm } = {}
local _hubSites: { Site } = {}
local _swarmFolder: Folder? = nil

local function buildBees(folder: Folder)
	local cfg = WorldFXConfig.BEES
	_swarmFolder = folder
	local random = Random.new(20261009)
	for i = 1, cfg.MAX_SWARMS + cfg.HOME_EXTRA do
		local count = random:NextInteger(cfg.PER_SWARM[1], cfg.PER_SWARM[2])
		local parts: { BasePart } = {}
		for _ = 1, count do
			table.insert(parts, WorldFXKit.ellipsoid("Bee", nil, Vector3.new(0.32, 0.32, 0.5), CFrame.new(), cfg.COLOR))
			table.insert(parts, WorldFXKit.part("Wings", nil, Vector3.new(0.6, 0.04, 0.2), CFrame.new(), Color3.new(1, 1, 1)))
			parts[#parts].Transparency = 0.5
		end
		table.insert(_swarms, { parts = parts, count = count, site = nil, phase = i * 1.9 })
	end
	_hubSites = hubSites()
end

-- Alle 2 s: die naechsten Orte an die Schwaerme verteilen (eigene Insel zuerst).
local function assignSwarms()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local cfg = WorldFXConfig.BEES
	local eye = camera.CFrame.Position
	local candidates: { { site: Site, d: number } } = {}
	-- Paket G: Event startet — alle Schwaerme in Sicht ziehen zum Event-Pit
	local rally = _rally
	if rally and os.clock() < rally.untilTime then
		local site: Site = { position = rally.position, home = false }
		for _, swarm in _swarms do
			if swarm.site then swarm.site = site end
		end
		return
	end
	_rally = nil
	local all = plotSites()
	for _, s in _hubSites do table.insert(all, s) end
	for _, site in all do
		local d = (site.position - eye).Magnitude
		if d <= cfg.VIEW_DISTANCE then
			table.insert(candidates, { site = site, d = if site.home then d - 1000 else d })
		end
	end
	table.sort(candidates, function(a, b) return a.d < b.d end)

	local homeLeft = cfg.HOME_EXTRA
	local used = 0
	for i, swarm in _swarms do
		local entry = candidates[i]
		local allowed = entry ~= nil and (used < cfg.MAX_SWARMS or (entry.site.home and homeLeft > 0))
		if allowed and entry then
			if entry.site.home and used >= cfg.MAX_SWARMS then homeLeft -= 1 else used += 1 end
			if not swarm.site then swarm.center = entry.site.position end   -- neu: dort erscheinen
			swarm.site = entry.site
			for _, part in swarm.parts do part.Parent = _swarmFolder end
		else
			swarm.site = nil
			swarm.center = nil
			for _, part in swarm.parts do part.Parent = nil end
		end
	end
end

local function stepBees(clock: number, dt: number, parts: { BasePart }, cframes: { CFrame })
	local cfg = WorldFXConfig.BEES
	for _, swarm in _swarms do
		local site = swarm.site
		if site then
			-- weich zum (neuen) Ort fliegen statt zu springen
			local center = swarm.center or site.position
			local delta = site.position - center
			local step = SWARM_SPEED * dt
			center = if delta.Magnitude <= step then site.position else center + delta.Unit * step
			swarm.center = center
			for j = 1, swarm.count do
				-- Acht ueber dem Ort, jede Biene etwas schneller und versetzt
				local a = clock * cfg.SPEED * TAU * (1 + 0.17 * j) + swarm.phase + j * 1.3
				local r = cfg.SITE_RADIUS * (0.6 + 0.12 * j)
				local pos = center + Vector3.new(math.cos(a) * r, 1.8 + 0.6 * math.sin(a * 3), math.sin(a * 2) * r * 0.5)
				local ahead = Vector3.new(-math.sin(a), 0, math.cos(a * 2))
				local body = CFrame.lookAt(pos, pos + (if ahead.Magnitude > 1e-3 then ahead else Vector3.new(0, 0, 1)))
				table.insert(parts, swarm.parts[j * 2 - 1])
				table.insert(cframes, body)
				table.insert(parts, swarm.parts[j * 2])
				table.insert(cframes, body * CFrame.new(0, 0.18, 0) * CFrame.Angles(0, 0, math.rad(25) * math.sin(clock * 40 + j)))
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Schmetterlinge (Hauptinsel)
--------------------------------------------------------------------------------

type Butterfly = { wings: { BasePart }, home: Vector3, phase: number }
local _butterflies: { Butterfly } = {}

local function buildButterflies(folder: Folder)
	local cfg = WorldFXConfig.BUTTERFLIES
	for i = 1, cfg.COUNT do
		local angle = 22.5 + (i - 1) * (360 / cfg.COUNT) + 12
		local home = MapLayout.atAngle(angle, 84)
		local color = cfg.COLORS[(i - 1) % #cfg.COLORS + 1]
		local wings: { BasePart } = {}
		for _ = 1, 2 do
			table.insert(wings, WorldFXKit.part("Wing", folder, Vector3.new(0.75, 0.05, 0.55), CFrame.new(home), color))
		end
		table.insert(_butterflies, { wings = wings, home = home, phase = i * 2.1 })
	end
end

local function stepButterflies(clock: number, eye: Vector3, parts: { BasePart }, cframes: { CFrame })
	local cfg = WorldFXConfig.BUTTERFLIES
	for _, b in _butterflies do
		if (b.home - eye).Magnitude <= cfg.VIEW_DISTANCE then
			local t = clock * 0.22 + b.phase
			local pos = b.home + Vector3.new(math.cos(t) * cfg.WANDER, cfg.HEIGHT + math.sin(t * 2.7) * 0.9, math.sin(t * 1.3) * cfg.WANDER)
			local ahead = Vector3.new(-math.sin(t), 0, math.cos(t * 1.3) * 1.3)
			local body = CFrame.lookAt(pos, pos + (if ahead.Magnitude > 1e-3 then ahead else Vector3.new(0, 0, 1)))
			local flap = math.rad(55) * math.sin(clock * cfg.FLAP_RATE * TAU + b.phase)
			table.insert(parts, b.wings[1])
			table.insert(cframes, body * CFrame.Angles(0, 0, flap) * CFrame.new(-0.38, 0, 0))
			table.insert(parts, b.wings[2])
			table.insert(cframes, body * CFrame.Angles(0, 0, -flap) * CFrame.new(0.38, 0, 0))
		end
	end
end

--------------------------------------------------------------------------------
-- Blumen im Wind (Server-Blumen der Hauptinsel, nur lokal gedreht)
--------------------------------------------------------------------------------

type Flower = { stem: BasePart, head: BasePart?, foot: Vector3, stemOffset: CFrame, headOffset: CFrame?, dodge: Vector3 }
local _flowers: { Flower } = {}
local WIND = Vector3.new(1, 0, 0.35).Unit

local function collectFlowers()
	local platform = workspace:WaitForChild("Platform", 60)
	if not platform then return end
	local heads: { [string]: BasePart } = {}
	local stems: { BasePart } = {}
	local function key(p: Vector3): string
		return string.format("%d:%d", math.floor(p.X * 10 + 0.5), math.floor(p.Z * 10 + 0.5))
	end
	for _, child in platform:GetChildren() do
		if child:IsA("BasePart") then
			if child.Name == "FlowerStem" then
				table.insert(stems, child)
			elseif child.Name == "FlowerHead" then
				heads[key(child.Position)] = child
			end
		end
	end
	for _, stem in stems do
		local foot = stem.Position - Vector3.new(0, stem.Size.Y * 0.5, 0)
		local pivot = CFrame.new(foot)
		local head = heads[key(stem.Position)]
		table.insert(_flowers, {
			stem = stem,
			head = head,
			foot = foot,
			stemOffset = pivot:ToObjectSpace(stem.CFrame),
			headOffset = if head then pivot:ToObjectSpace(head.CFrame) else nil,
			dodge = Vector3.zero,
		})
	end
end

local function stepFlowers(clock: number, eye: Vector3, root: BasePart?, parts: { BasePart }, cframes: { CFrame })
	local cfg = WorldFXConfig.FLOWER_SWAY
	local axis = Vector3.new(-WIND.Z, 0, WIND.X)   -- Kippachse quer zum Wind
	local body = if root then root.Position else nil
	for _, f in _flowers do
		if (f.foot - eye).Magnitude <= cfg.VIEW_DISTANCE then
			-- gemeinsame Welle, die ueber die Insel laeuft
			local along = f.foot.X * WIND.X + f.foot.Z * WIND.Z
			local angle = math.rad(cfg.DEGREES) * math.sin(TAU * (clock * cfg.RATE - along / cfg.WAVELENGTH))
			local tilt = CFrame.fromAxisAngle(axis, angle)

			-- Ausweichen: vom Charakter weg kippen, danach langsam zurueck
			local target = Vector3.zero
			if body then
				local away = Vector3.new(f.foot.X - body.X, 0, f.foot.Z - body.Z)
				local d = away.Magnitude
				if d < cfg.DODGE_RADIUS and d > 1e-3 and math.abs(body.Y - f.foot.Y) < 6 then
					target = away.Unit * (1 - d / cfg.DODGE_RADIUS)
				end
			end
			f.dodge = f.dodge:Lerp(target, 0.25)
			if f.dodge.Magnitude > 0.01 then
				local dodgeAxis = Vector3.new(f.dodge.Z, 0, -f.dodge.X)
				tilt = CFrame.fromAxisAngle(dodgeAxis.Unit, -math.rad(cfg.DODGE_DEGREES) * f.dodge.Magnitude) * tilt
			end

			local pivot = CFrame.new(f.foot) * tilt
			table.insert(parts, f.stem)
			table.insert(cframes, pivot * f.stemOffset)
			local head, offset = f.head, f.headOffset
			if head and offset then
				table.insert(parts, head)
				table.insert(cframes, pivot * offset)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Pfotenabdruecke
--------------------------------------------------------------------------------

type Print = { part: BasePart, decal: Decal?, born: number }
local _prints: { Print } = {}
local _nextPrint = 1
local _lastPrintAt: Vector3? = nil
local _printSide = 1

local function buildPrints()
	local cfg = WorldFXConfig.FOOTPRINTS
	local pawId = WorldFXKit.textureId("paw_print")
	for _ = 1, cfg.MAX do
		local part = WorldFXKit.part("Paw", nil, Vector3.new(cfg.SIZE, 0.05, cfg.SIZE * 1.15), CFrame.new(), cfg.COLOR)
		local decal: Decal? = nil
		if pawId then
			part.Transparency = 1
			local d = Instance.new("Decal")
			d.Texture = pawId
			d.Face = Enum.NormalId.Top
			d.Color3 = cfg.COLOR
			d.Parent = part
			decal = d
		else
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		end
		table.insert(_prints, { part = part, decal = decal, born = -math.huge })
	end
end

local function stepPrints(folder: Folder, character: Model?)
	local cfg = WorldFXConfig.FOOTPRINTS
	local now = os.clock()
	-- verblassen
	for _, p in _prints do
		if p.part.Parent then
			local k = (now - p.born) / cfg.FADE
			if k >= 1 then
				p.part.Parent = nil
			elseif p.decal then
				(p.decal :: Decal).Transparency = k
			else
				p.part.Transparency = 0.25 + 0.75 * k
			end
		end
	end

	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and root:IsA("BasePart")) then return end
	if humanoid.FloorMaterial ~= Enum.Material.Sand then
		_lastPrintAt = nil
		return
	end
	local feetY = root.Position.Y - root.Size.Y * 0.5 - humanoid.HipHeight
	local here = Vector3.new(root.Position.X, feetY, root.Position.Z)
	local last = _lastPrintAt
	if last and (here - last).Magnitude < cfg.STEP then return end
	_lastPrintAt = here

	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
	local sideways = Vector3.new(-flat.Z, 0, flat.X) * (0.45 * _printSide)
	_printSide = -_printSide
	local p = _prints[_nextPrint]
	_nextPrint = _nextPrint % #_prints + 1
	local at = here + sideways + Vector3.new(0, 0.03, 0)
	p.part.CFrame = CFrame.lookAt(at, at + flat)
	p.born = now
	if p.decal then (p.decal :: Decal).Transparency = 0 else p.part.Transparency = 0.25 end
	p.part.Parent = folder
end

-- Paket G (Event startet): Bienen in Sicht fliegen `seconds` lang zu `position`.
function LifeController.rally(position: Vector3, seconds: number)
	_rally = { position = position + Vector3.new(0, 4, 0), untilTime = os.clock() + seconds }
	assignSwarms()
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function LifeController.init()
	if not FeatureFlags.isOn("WORLD_F_LIFE") then return end
	local folder = WorldFXKit.folder("Life", WorldFXKit.root())

	local bees = WorldFXKit.enabled("bees")
	local butterflies = WorldFXKit.enabled("butterflies")
	local sway = WorldFXKit.enabled("flowerSway")
	local prints = WorldFXKit.enabled("footprints")
	if bees then buildBees(WorldFXKit.folder("Bees", folder)) end
	if butterflies then buildButterflies(WorldFXKit.folder("Butterflies", folder)) end
	if sway then task.spawn(collectFlowers) end
	local printFolder = WorldFXKit.folder("Footprints", folder)
	if prints then buildPrints() end

	if not (bees or butterflies or sway or prints) then
		print("[Life] aus (niedrige Qualitaet)")
		return
	end

	local acc, assignAcc, clock = 0, 2, 0
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		acc += dt
		assignAcc += dt
		if acc < TICK then return end
		acc = 0
		local camera = workspace.CurrentCamera
		if not camera then return end
		local eye = camera.CFrame.Position

		if bees and assignAcc >= 2 then
			assignAcc = 0
			assignSwarms()
		end

		local parts: { BasePart } = {}
		local cframes: { CFrame } = {}
		if bees then stepBees(clock, TICK, parts, cframes) end
		if butterflies then stepButterflies(clock, eye, parts, cframes) end
		local character = localPlayer.Character
		if sway then
			local root = character and character:FindFirstChild("HumanoidRootPart")
			stepFlowers(clock, eye, if root and root:IsA("BasePart") then root else nil, parts, cframes)
		end
		if #parts > 0 then
			workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end
		if prints then stepPrints(printFolder, character) end
	end)

	print("[Life] aktiv | Bienen:", bees, "| Schmetterlinge:", butterflies, "| Blumen:", sway, "| Pfoten:", prints)
end

return LifeController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX37"><Properties>
<string name="Name">PlotLifeController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PlotLifeController.luau
-- StarterPlayerScripts/Controllers/PlotLifeController.luau
--
-- Einzige Zustaendigkeit:
--   - Plot-Inseln mit Persoenlichkeit (Paket D, "Welt aufwerten"):
--     Deko am Inselrand je Fortschritts-Stufe (Blumen, Pilze, Bienenhaus,
--     Bernstein-Stein), Glanz und Ueberlauf am Honig-Teich, warmer Schimmer
--     ueber der EIGENEN Insel, und leere Inseln mit Schild "Frei", Blumen und
--     Schmetterling
--
-- Die Stufe rechnet der Server (Modules/IslandStage) und schreibt sie als
-- Attribut "IslandStage" an den Player (PlotDisplayService). Gebaut wird
-- hier, nur auf dem Client: kein Server-Teil, das Teile-Budget der Insel
-- (250) bleibt unberuehrt. Neubau nur bei einem Stufenwechsel.
--
-- PERFORMANCE: EIN Takt (15x pro Sekunde) fuer Teich-Glanz, Ueberlauf und
-- Schmetterlinge, nur fuer Gruppen in Sichtweite (WorldFXKit.cullGroup).
-- Die Stufen-Deko steht still. Ein Emitter (Lichtpunkte ueber der eigenen
-- Insel). Feste Pools fuer Tropfen und Schmetterlinge.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)
local Loc           = require(ReplicatedStorage.Localization.Loc)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)
local Icons              = require(script.Parent.Parent.UI.Icons)

local PlotLifeController = {}

local localPlayer = Players.LocalPlayer
local UPRIGHT = WorldFXKit.UPRIGHT
local TICK = 1 / 15
local TAU = math.pi * 2

type Drop = { part: BasePart, phase: number }
type PlotState = {
	slot: number,
	decor: Folder?,
	uncull: (() -> ())?,
	stage: number,
	pondGroup: Folder,
	shine: BasePart,
	drops: { Drop },
	ownerConn: RBXScriptConnection?,
}
type FreeState = { group: Folder, wings: { BasePart }, phase: number, uncull: (() -> ())? }

local _folder: Folder? = nil
local _plots: { [number]: PlotState } = {}
local _free: { [number]: FreeState } = {}
local _homeSlot: number? = nil
local _homeGroup: Folder? = nil

--------------------------------------------------------------------------------
-- Deklarative Deko (WorldFXConfig.ISLAND_KINDS, wie MapParts.buildDecor)
--------------------------------------------------------------------------------

-- Blumengruppen je Slot (Model + Ausgangslage) fuer den Windstoss (Paket G)
type Sway = { model: Model, base: CFrame, rel: CFrame? }
local _sways: { [number]: { Sway } } = {}
local _gust: { [number]: number } = {}   -- Slot → Startzeit des Windstosses
local GUST_TIME = 1.6
local GUST_DEGREES = 26

local function buildKind(parent: Instance, kind: string, ground: CFrame, slot: number?)
	local pieces = (WorldFXConfig.ISLAND_KINDS :: any)[kind]
	if not pieces then return end
	if kind == "Flowers" and slot then
		-- Blumen als eigenes Model, damit sie sich als Gruppe wiegen koennen
		local model = Instance.new("Model")
		model.Name = "FlowerGroup"
		model.Parent = parent
		parent = model
		local list = _sways[slot] or {}
		_sways[slot] = list
		table.insert(list, { model = model, base = ground, rel = nil })
	end
	for _, piece in pieces do
		local cf = ground * CFrame.new(piece.offset)
		local rot = piece.rotation
		if rot then
			cf = cf * CFrame.Angles(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
		end
		local glow = piece.name == WorldFXConfig.ISLAND_GLOW_PIECE
		local part = WorldFXKit.part(piece.name, parent, piece.size, cf, piece.color,
			if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic, piece.shape)
		if piece.name == "Box" or piece.name == "Roof" or piece.name == "Stand" then
			part.Material = Enum.Material.Wood
		elseif piece.name == "Rock" then
			part.Material = Enum.Material.Slate
		end
		if glow then
			DayCycleController.registerGlow(part, piece.color, Color3.fromRGB(255, 214, 110))
		end
	end
end

-- Boden-CFrame an einem Randpunkt: -Z zeigt zur Inselmitte.
local function rimGround(slot: number, angle: number, radius: number): CFrame
	local p, toCenter = MapLayout.islandRimPoint(slot, angle, radius)
	local ground = Vector3.new(p.X, MapConfig.PLATFORM_TOP_Y, p.Z)
	return CFrame.lookAt(ground, ground + toCenter)
end

--------------------------------------------------------------------------------
-- Stufen-Deko einer besetzten Insel
--------------------------------------------------------------------------------

local function ownerOf(slot: number): Player?
	local plot = workspace:FindFirstChild("Plot_" .. slot)
	local id = plot and plot:GetAttribute("PlotOwner")
	return if typeof(id) == "number" then Players:GetPlayerByUserId(id) else nil
end

local function stageOf(slot: number): number
	local owner = ownerOf(slot)
	local stage = owner and owner:GetAttribute("IslandStage")
	return if typeof(stage) == "number" then stage else 1
end

local function rebuildDecor(state: PlotState)
	if not WorldFXKit.enabled("islandDecor") then return end
	local stage = stageOf(state.slot)
	if stage == state.stage and state.decor then return end
	state.stage = stage

	local old = state.decor
	local uncull = state.uncull
	if uncull then uncull() end
	if old then old:Destroy() end
	_sways[state.slot] = nil
	local folder = _folder :: Folder
	local group = WorldFXKit.folder("IslandDecor_" .. state.slot, folder)
	for _, item in WorldFXConfig.ISLAND_STAGE_ITEMS do
		if item.stage <= stage then
			buildKind(group, item.kind, rimGround(state.slot, item.angle, WorldFXConfig.ISLAND_STAGE.RIM_RADIUS), state.slot)
		end
	end
	state.decor = group
	state.uncull = WorldFXKit.cullGroup(group, MapLayout.plotCenter(state.slot), WorldFXConfig.ISLAND_STAGE.SHOW_DISTANCE)
end

--------------------------------------------------------------------------------
-- Honig-Teich: Glanz und Ueberlauf
--------------------------------------------------------------------------------

local function findFill(slot: number): BasePart?
	local plot = workspace:FindFirstChild("Plot_" .. slot)
	local pond = plot and plot:FindFirstChild("Pond")
	local fill = pond and pond:FindFirstChild("Fuellung")
	return if fill and fill:IsA("BasePart") then fill else nil
end

-- Fuellstand 0..1 aus der Hoehe der Fuellung (PondBuilder.writePondFill).
local function fillRatio(fill: BasePart): number
	if fill.Transparency >= 1 then return 0 end
	local span = MapConfig.POND_FILL_MAX_HEIGHT - MapConfig.POND_FILL_MIN_HEIGHT
	return math.clamp((fill.Size.X - MapConfig.POND_FILL_MIN_HEIGHT) / span, 0, 1)
end

local function buildPondLife(slot: number): (Folder, BasePart, { Drop })
	local cfg = WorldFXConfig.POND_LIFE
	local group = WorldFXKit.folder("PondLife_" .. slot, _folder :: Folder)
	local shine = WorldFXKit.part("Shine", nil, cfg.SHINE_SIZE, CFrame.new(), Color3.new(1, 1, 1),
		Enum.Material.Neon, Enum.PartType.Cylinder)
	shine.Transparency = 0.55
	local drops: { Drop } = {}
	for i = 1, cfg.OVERFLOW_DROPS do
		local part = WorldFXKit.ball("Drop", nil, cfg.DROP_SIZE, Vector3.zero, MapConfig.POND_FILL_COLOR, Enum.Material.Glass)
		table.insert(drops, { part = part, phase = (i - 1) / cfg.OVERFLOW_DROPS })
	end
	-- Sichtweite um den Teich (gerechnet wie MapLayout.pondOffset, plot-lokal)
	local center = MapLayout.plotCenter(slot)
	local plotCF = CFrame.lookAt(center, Vector3.new(MapConfig.CENTER.X, center.Y, MapConfig.CENTER.Z))
	WorldFXKit.cullGroup(group, (plotCF * CFrame.new(MapLayout.pondOffset())).Position, cfg.SHOW_DISTANCE)
	return group, shine, drops
end

local function stepPond(state: PlotState, clock: number)
	if not state.pondGroup.Parent then return end
	local cfg = WorldFXConfig.POND_LIFE
	local fill = findFill(state.slot)
	local ratio = if fill then fillRatio(fill) else 0

	if not fill or ratio <= 0 then
		state.shine.Parent = nil
		for _, drop in state.drops do drop.part.Parent = nil end
		return
	end

	local center = fill.Position
	local topY = center.Y + fill.Size.X * 0.5
	local radius = fill.Size.Y * 0.5

	-- Glanzfleck kreist langsam auf der Oberflaeche
	if WorldFXKit.enabled("pondShine") then
		local a = clock / cfg.SHINE_PERIOD * TAU
		local p = Vector3.new(center.X + math.cos(a) * radius * 0.45, topY + 0.03, center.Z + math.sin(a) * radius * 0.45)
		state.shine.CFrame = CFrame.lookAt(p, p + Vector3.new(-math.sin(a), 0, math.cos(a))) * UPRIGHT
		state.shine.Parent = state.pondGroup
	end

	-- Voll: Tropfen laufen ueber den Rand und fallen aufs Beet
	local full = ratio >= cfg.FULL_RATIO
	local rimRadius = MapConfig.POND_RADIUS + MapConfig.POND_RIM_WIDTH * 0.6
	local groundY = topY - MapConfig.POND_FILL_MAX_HEIGHT - MapConfig.POND_FLOOR_TOP + MapConfig.POND_RIM_TOP
	for i, drop in state.drops do
		if not full then
			drop.part.Parent = nil
		else
			local t = ((clock / cfg.DROP_INTERVAL) + drop.phase) % 1
			local a = (i / #state.drops) * TAU + 0.6
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			local p: Vector3
			if t < 0.6 then
				-- ueber den Rand gleiten
				local k = t / 0.6
				p = Vector3.new(center.X, topY, center.Z) + dir * (radius + (rimRadius - radius) * k)
			else
				-- hinunter fallen
				local k = (t - 0.6) / 0.4
				p = Vector3.new(center.X, topY - (topY - groundY) * k * k, center.Z) + dir * rimRadius
			end
			drop.part.Position = p
			drop.part.Parent = state.pondGroup
		end
	end
end

--------------------------------------------------------------------------------
-- Eigene Insel
--------------------------------------------------------------------------------

local function buildHome(slot: number)
	local old = _homeGroup
	if old then old:Destroy() end
	_homeGroup = nil
	_homeSlot = slot
	if not WorldFXKit.enabled("homeGlow") then return end
	local cfg = WorldFXConfig.HOME_GLOW
	local group = WorldFXKit.folder("HomeGlow", _folder :: Folder)
	local center = MapLayout.plotCenter(slot)

	-- Warmer Ring auf dem Sandsaum: die Inselplatte deckt die Mitte ab, sichtbar
	-- ist nur der Streifen zwischen Wiese und Wasser — von weitem erkennbar.
	local radius = MapConfig.PLOT_ISLAND_RADIUS + MapConfig.SHORE_WIDTH * 0.75
	local y = MapConfig.PLATFORM_TOP_Y - MapConfig.SHORE_DROP + 0.04
	local ring = WorldFXKit.part("HomeRing", group, Vector3.new(0.05, radius * 2, radius * 2),
		CFrame.new(center.X, y, center.Z) * UPRIGHT, cfg.COLOR, Enum.Material.Neon, Enum.PartType.Cylinder)
	ring.Transparency = cfg.RING_TRANSPARENCY

	-- Warme Lichtpunkte ueber der Insel (ein Emitter)
	local anchor = WorldFXKit.anchor("HomeMotes", group,
		Vector3.new(MapConfig.PLOT_ISLAND_RADIUS * 1.6, 4, MapConfig.PLOT_ISLAND_RADIUS * 1.6),
		center + Vector3.new(0, cfg.MOTE_HEIGHT, 0))
	local emitter = Instance.new("ParticleEmitter")
	if WorldFXKit.applyParticleTexture(emitter, "firefly") then
		emitter.Color = ColorSequence.new(cfg.COLOR)
		emitter.LightEmission = 0.8
		emitter.Rate = cfg.MOTE_RATE
		emitter.Lifetime = NumberRange.new(5, 8)
		emitter.Speed = NumberRange.new(0.2, 0.8)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.5), NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.3), NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Parent = anchor
	else
		emitter:Destroy()
	end
	_homeGroup = group
end

-- Paket G (Rebirth): die Blumen der Insel wiegen sich einmal stark.
function PlotLifeController.gust(slot: number)
	_gust[slot] = os.clock()
end

local function stepGusts(now: number)
	for slot, start in _gust do
		local t = (now - start) / GUST_TIME
		local list = _sways[slot]
		if list then
			local angle = if t >= 1 then 0 else math.rad(GUST_DEGREES) * math.sin(t * math.pi * 3) * (1 - t)
			for _, sway in list do
				-- Lage relativ zum Fuss einmal merken (vor dem ersten Kippen)
				local rel = sway.rel
				if not rel then
					rel = sway.base:ToObjectSpace(sway.model:GetPivot())
					sway.rel = rel
				end
				-- um den Fuss kippen, seitlich (Achse = Richtung zur Inselmitte)
				sway.model:PivotTo(sway.base * CFrame.fromAxisAngle(Vector3.new(0, 0, 1), angle) * (rel :: CFrame))
			end
		end
		if t >= 1 then _gust[slot] = nil end
	end
end

-- Fuer andere Controller (Paket F: mehr Bienen auf der eigenen Insel).
function PlotLifeController.homeSlot(): number?
	return _homeSlot
end

--------------------------------------------------------------------------------
-- Leere Insel
--------------------------------------------------------------------------------

local function buildFree(slot: number): FreeState
	local cfg = WorldFXConfig.FREE_ISLAND
	local group = WorldFXKit.folder("FreeIsland_" .. slot, _folder :: Folder)
	local center = MapLayout.plotCenter(slot)
	local facing = CFrame.lookAt(center, Vector3.new(MapConfig.CENTER.X, center.Y, MapConfig.CENTER.Z))

	-- Schild "Frei" mit Baerchi-Silhouette, zur Hauptinsel gedreht
	local wood = WorldFXConfig.SIGNPOST.WOOD
	for _, side in { -1, 1 } do
		WorldFXKit.pole("SignPost", group, (facing * CFrame.new(side * 2.4, 0, 0.3)).Position, cfg.SIGN_HEIGHT + 1, 0.4,
			WorldFXConfig.SIGNPOST.WOOD_DARK, Enum.Material.Wood)
	end
	local board = WorldFXKit.part("SignBoard", group, Vector3.new(6, 3, 0.3),
		facing * CFrame.new(0, cfg.SIGN_HEIGHT, 0), wood, Enum.Material.Wood)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.PixelsPerStud = 40
	gui.Parent = board
	local icon = Icons.make(gui, "bear", "🐻")
	icon.Size = UDim2.fromScale(0.3, 0.8)
	icon.Position = UDim2.fromScale(0.04, 0.1)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.62, 0.8)
	label.Position = UDim2.fromScale(0.36, 0.1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = WorldFXConfig.SIGNPOST.TEXT_COLOR
	label.Parent = gui
	Loc.bind(label, "world.sign.free")

	-- Ein paar Blumen am Rand
	for _, angle in cfg.FLOWER_ANGLES do
		buildKind(group, "Flowers", rimGround(slot, angle, WorldFXConfig.ISLAND_STAGE.RIM_RADIUS - 8))
	end

	-- Ein Schmetterling: zwei Fluegel, Schlag im gemeinsamen Takt
	local wings: { BasePart } = {}
	local color = WorldFXConfig.BUTTERFLIES.COLORS[(slot % #WorldFXConfig.BUTTERFLIES.COLORS) + 1]
	for _ = 1, 2 do
		table.insert(wings, WorldFXKit.part("Wing", group, Vector3.new(0.7, 0.05, 0.5), CFrame.new(center), color))
	end

	return { group = group, wings = wings, phase = slot * 1.3,
		uncull = WorldFXKit.cullGroup(group, center, cfg.SHOW_DISTANCE) }
end

local function stepFree(state: FreeState, slot: number, clock: number)
	if not state.group.Parent then return end
	local cfg = WorldFXConfig.BUTTERFLIES
	local center = MapLayout.plotCenter(slot)
	local t = clock * 0.25 + state.phase
	local pos = center + Vector3.new(math.cos(t) * cfg.WANDER, cfg.HEIGHT + math.sin(t * 2.3) * 0.8, math.sin(t * 1.4) * cfg.WANDER)
	local ahead = Vector3.new(-math.sin(t), 0, math.cos(t) * 1.4)
	local body = CFrame.lookAt(pos, pos + (if ahead.Magnitude > 1e-3 then ahead else Vector3.new(0, 0, 1)))
	local flap = math.rad(55) * math.sin(clock * cfg.FLAP_RATE * TAU)
	state.wings[1].CFrame = body * CFrame.Angles(0, 0, flap) * CFrame.new(-0.35, 0, 0)
	state.wings[2].CFrame = body * CFrame.Angles(0, 0, -flap) * CFrame.new(0.35, 0, 0)
end

--------------------------------------------------------------------------------
-- Besetzung
--------------------------------------------------------------------------------

local function setOccupied(slot: number, occupied: boolean)
	local free = _free[slot]
	if occupied then
		if free then
			-- aus der Distanz-Abschaltung nehmen, sonst haengt sie ihn wieder ein
			local uncull = free.uncull
			if uncull then uncull() end
			free.uncull = nil
			free.group.Parent = nil
		end
		local state = _plots[slot]
		if not state then
			local group, shine, drops = buildPondLife(slot)
			state = { slot = slot, decor = nil, uncull = nil, stage = 0, pondGroup = group, shine = shine, drops = drops, ownerConn = nil }
			_plots[slot] = state
		end
		local st = state :: PlotState
		-- Stufe des Besitzers beobachten
		local conn = st.ownerConn
		if conn then conn:Disconnect() end
		st.ownerConn = nil
		task.spawn(function()
			local owner: Player? = nil
			for _ = 1, 20 do
				owner = ownerOf(slot)
				if owner then break end
				task.wait(0.5)
			end
			if owner then
				st.ownerConn = owner:GetAttributeChangedSignal("IslandStage"):Connect(function()
					rebuildDecor(st)
				end)
				if owner == localPlayer then
					buildHome(slot)
				end
			end
			st.stage = 0
			rebuildDecor(st)
		end)
	else
		local state = _plots[slot]
		if state then
			local conn = state.ownerConn
			if conn then conn:Disconnect() end
			state.ownerConn = nil
			local decor = state.decor
			local uncull = state.uncull
			if uncull then uncull() end
			state.uncull = nil
			if decor then decor:Destroy() end
			state.decor = nil
			state.stage = 0
		end
		if _homeSlot == slot then
			local home = _homeGroup
			if home then home:Destroy() end
			_homeGroup = nil
			_homeSlot = nil
		end
		if WorldFXKit.enabled("freeIsland") then
			if not free then
				_free[slot] = buildFree(slot)
			elseif not free.uncull then
				free.group.Parent = _folder
				free.uncull = WorldFXKit.cullGroup(free.group, MapLayout.plotCenter(slot), WorldFXConfig.FREE_ISLAND.SHOW_DISTANCE)
			end
		end
	end
end

local function slotOf(child: Instance): number?
	local n = string.match(child.Name, "^Plot_(%d+)$")
	return if n then tonumber(n) else nil
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function PlotLifeController.init()
	if not FeatureFlags.isOn("WORLD_D_PLOTS") then return end
	_folder = WorldFXKit.folder("PlotLife", WorldFXKit.root())

	for slot = 1, MapConfig.PLOT_COUNT do
		setOccupied(slot, workspace:FindFirstChild("Plot_" .. slot) ~= nil)
	end
	workspace.ChildAdded:Connect(function(child)
		local slot = slotOf(child)
		if slot then setOccupied(slot, true) end
	end)
	workspace.ChildRemoved:Connect(function(child)
		local slot = slotOf(child)
		if slot and not workspace:FindFirstChild(child.Name) then setOccupied(slot, false) end
	end)

	-- Debug: "islandstage" setzt das Player-Attribut (wie der Server), der
	-- Neubau laeuft dann ueber denselben Weg wie im Spiel.
	local acc, clock = 0, 0
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		acc += dt
		if acc < TICK then return end
		acc = 0
		for _, state in _plots do
			stepPond(state, clock)
		end
		stepGusts(os.clock())
		for slot, free in _free do
			stepFree(free, slot, clock)
		end
	end)

	print("[PlotLife] aktiv")
end

return PlotLifeController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX38"><Properties>
<string name="Name">SoundscapeController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- SoundscapeController.luau
-- StarterPlayerScripts/Controllers/SoundscapeController.luau
--
-- Einzige Zustaendigkeit:
--   - Die leise Klang-Kulisse (Paket H, "Welt aufwerten"): je Ort ein
--     Klangteppich (Ufer, Wiese/Grillen, Honigmast, Event-Pit, Arena-Wind),
--     weich ineinander geblendet nach der Kamera-Position; dazu ab und zu
--     eine Moewe am Ufer und die Glocke beim Event-Start (Paket G)
--
-- Wie laut welche Zone ist, rechnet Modules/SoundZones (rein, getestet).
-- Hier laufen nur die Schleifen: hoechstens MAX_AUDIBLE gleichzeitig hoerbar,
-- jede folgt ihrem Ziel weich (kein harter Schnitt), alle in der Sound-Gruppe
-- "WorldAmbience" und immer leiser als die Kampf-Sounds.
--
-- Nur Klaenge mit einer in Studio GEPRUEFTEN ID (WorldFXConfig.SOUNDS). Ist
-- eine ID leer, bleibt diese Zone still — ohne IDs laeuft gar nichts, und
-- es entsteht keine einzige Sound-Instanz.
--
-- PERFORMANCE: ein Takt (5 Hz), eine Sound-Instanz je Zone (nicht positional,
-- die Mischung macht der Takt). Keine Musik (eigene Entscheidung spaeter).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local SoundService      = game:GetService("SoundService")

local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local SoundZones    = require(ReplicatedStorage.Modules.SoundZones)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)

local SoundscapeController = {}

local LOOPS = { "waves", "meadow", "crickets", "drip", "crowd", "wind" }

local _group: SoundGroup? = nil
local _loops: { [string]: Sound } = {}
local _volumes: { [string]: number } = {}
local _gull: Sound? = nil
local _bell: Sound? = nil
local _nextGull = 0
local _eventLive = false

local function soundGroup(): SoundGroup
	local existing = _group or SoundService:FindFirstChild("WorldAmbience")
	if existing and existing:IsA("SoundGroup") then
		_group = existing
		return existing
	end
	local created = Instance.new("SoundGroup")
	created.Name = "WorldAmbience"
	created.Parent = SoundService
	_group = created
	return created
end

local function newSound(key: string, looped: boolean): Sound?
	local id = WorldFXConfig.SOUNDS[key]
	if not id or id == "" then return nil end
	local sound = Instance.new("Sound")
	sound.Name = "Ambience_" .. key
	sound.SoundId = id
	sound.Looped = looped
	sound.Volume = 0
	sound.SoundGroup = soundGroup()
	sound.Parent = SoundService
	return sound
end

-- Glocke beim Event-Start (Paket G). Still ohne gepruefte ID.
function SoundscapeController.bell()
	local bell = _bell
	if bell then
		bell.Volume = (WorldFXConfig.SOUND_VOLUME :: any).bell or 0.1
		bell:Play()
	end
end

-- Laeuft gerade ein Event? (HubEventController meldet den Pit-Zustand.)
function SoundscapeController.setEventLive(live: boolean)
	_eventLive = live
end

function SoundscapeController.init()
	if not (FeatureFlags.isOn("WORLD_H_SOUND") and WorldFXKit.enabled("soundscape")) then return end

	for _, key in LOOPS do
		local sound = newSound(key, true)
		if sound then
			_loops[key] = sound
			_volumes[key] = 0
		end
	end
	_gull = newSound("gull", false)
	_bell = newSound("bell", false)

	if next(_loops) == nil and not _gull then
		print("[Soundscape] still: keine gepruefte Sound-ID in WorldFXConfig.SOUNDS")
		return
	end

	local cfg = WorldFXConfig.SOUNDSCAPE
	local random = Random.new()
	_nextGull = os.clock() + random:NextNumber(cfg.GULL_EVERY[1], cfg.GULL_EVERY[2])
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < cfg.TICK then return end
		acc = 0
		local camera = workspace.CurrentCamera
		if not camera then return end

		local weights = SoundZones.weights(camera.CFrame.Position, DayCycleController.dusk(), _eventLive)
		local target = SoundZones.audible(weights)
		for key, sound in _loops do
			local max = (WorldFXConfig.SOUND_VOLUME :: any)[key] or 0.06
			local goal = max * (target[key] or 0)
			local v = _volumes[key] + (goal - _volumes[key]) * cfg.FADE * (cfg.TICK / 0.2)
			if math.abs(v - goal) < 0.002 then v = goal end
			_volumes[key] = v
			sound.Volume = v
			if v > 0 and not sound.IsPlaying then
				sound:Play()
			elseif v == 0 and sound.IsPlaying then
				sound:Stop()
			end
		end

		-- Moewe: ab und zu, nur wenn das Ufer gerade zu hoeren ist
		local gull = _gull
		if gull and os.clock() >= _nextGull then
			_nextGull = os.clock() + random:NextNumber(cfg.GULL_EVERY[1], cfg.GULL_EVERY[2])
			if (weights.waves or 0) > 0.5 then
				gull.Volume = (WorldFXConfig.SOUND_VOLUME :: any).gull * weights.waves
				gull:Play()
			end
		end
	end)

	local count = 0
	for _ in _loops do count += 1 end
	print("[Soundscape] aktiv | Schleifen mit ID:", count, "| Moewe:", _gull ~= nil)
end

return SoundscapeController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX39"><Properties>
<string name="Name">WaterController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WaterController.luau
-- StarterPlayerScripts/Controllers/WaterController.luau
--
-- Einzige Zustaendigkeit:
--   - Wasser und Kueste lebendig machen (Paket B, "Welt aufwerten"):
--     wanderndes Glitzern und Wellenlinien auf dem Wasser, Schaum-Textur auf
--     den Saeumen, Schaum und Stegpfosten an Arena-Inseln, springender
--     Honig-Fisch, schaukelnde Bonbon-Bojen
--
-- Alles nur auf dem Client: die Server-Teile (Wasser, Schaum-Scheiben)
-- bekommen hoechstens eine lokale Textur als Kind und eine lokale Farbe; neue
-- Teile entstehen in WorldFX_Local und werden nie repliziert. Das Teile-
-- Budget der Plot-Inseln (Server) bleibt unberuehrt.
--
-- Ohne hochgeladene Textur-IDs (WorldFXConfig.TEXTURE_IDS) gibt es kein
-- Glitzern, keine Wellen und keine Schaum-Textur: das Wasser bleibt wie
-- heute. Fisch, Bojen und Arena-Kueste laufen auch ohne Bilder.
--
-- PERFORMANCE: EIN Takt (WATER.TICK, 30x pro Sekunde) fuer Textur-Versatz,
-- Fisch und Bojen; die Arena-Kueste wird 2x pro Sekunde auf Sichtweite und
-- Besetzung geprueft. Ein Emitter (Spritzer), alle Teile aus festen Pools.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local MapConfig      = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig  = require(ReplicatedStorage.Config.WorldFXConfig)
local MapLayout      = require(ReplicatedStorage.Modules.MapLayout)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)

local WaterController = {}

local WATER_Y = MapConfig.PLATFORM_TOP_Y - MapConfig.WATER_DROP
local FOAM_Y  = WATER_Y + 0.05
local UPRIGHT = WorldFXKit.UPRIGHT
local TOP_FACE = Enum.NormalId.Right   -- liegender Zylinder (UPRIGHT): +X zeigt nach oben

local _folder: Folder? = nil
local _glitter: Texture? = nil
local _waves: Texture? = nil
local _laces: { Texture } = {}

type Coast = { model: Model, occupied: boolean, shown: boolean, foam: BasePart, lace: Texture?, phase: number }
local _coasts: { [number]: Coast } = {}

type Buoy = { model: Model, base: CFrame, phase: number }
local _buoys: { Buoy } = {}

type Fish = { model: Model, active: boolean, start: number, from: Vector3, dir: Vector3 }
local _fish: Fish? = nil
local _nextFishAt = 0
local _splashAnchor: BasePart? = nil
local _splash: ParticleEmitter? = nil
local _ring: BasePart? = nil
local _ringDecal: Decal? = nil
local _ringStart = -math.huge

local _random = Random.new()

--------------------------------------------------------------------------------
-- Glitzern und Wellen
--------------------------------------------------------------------------------

local function newTexture(parent: Instance, name: string, id: string, tile: number, transparency: number): Texture
	local tex = Instance.new("Texture")
	tex.Name          = name
	tex.Texture       = id
	tex.Face          = TOP_FACE
	tex.StudsPerTileU = tile
	tex.StudsPerTileV = tile
	tex.Transparency  = transparency
	tex.Parent        = parent
	return tex
end

local function setupWater()
	local platform = workspace:WaitForChild("Platform", 60)
	local water = platform and platform:WaitForChild("Water", 30)
	if not (water and water:IsA("BasePart")) then return end
	local cfg = WorldFXConfig.WATER

	local glitterId = WorldFXKit.textureId("water_glitter")
	if glitterId and WorldFXKit.enabled("waterGlitter") then
		_glitter = newTexture(water, "Glitter", glitterId, cfg.GLITTER_TILE, cfg.GLITTER_TRANSPARENCY)
	end
	local wavesId = WorldFXKit.textureId("water_waves")
	if wavesId and WorldFXKit.enabled("waterWaves") then
		_waves = newTexture(water, "Waves", wavesId, cfg.WAVES_TILE, cfg.WAVES_TRANSPARENCY)
	end
end

--------------------------------------------------------------------------------
-- Schaum der festen Inseln (Server-Scheiben, lokal eingefaerbt)
--------------------------------------------------------------------------------

-- Gibt die Textur zurueck, falls es ein Schaum-Bild gibt. Die Scheibe wird
-- dann unsichtbar; das Atmen uebernimmt AmbienceController an der Textur.
local function dressFoam(part: BasePart): Texture?
	part.Color = WorldFXConfig.FOAM_COLOR
	local laceId = WorldFXKit.textureId("foam_lace")
	if not (laceId and WorldFXKit.enabled("foamTexture")) then
		return nil
	end
	local tex = newTexture(part, "FoamLace", laceId, WorldFXConfig.WATER.FOAM_TILE, part.Transparency)
	tex.Color3 = WorldFXConfig.FOAM_COLOR
	part.Transparency = 1
	table.insert(_laces, tex)
	return tex
end

local function setupFoam()
	local platform = workspace:WaitForChild("Platform", 60)
	local scenery = platform and platform:WaitForChild("Scenery", 30)
	local foam = scenery and scenery:WaitForChild("Foam", 30)
	if not foam then return end
	for _, child in foam:GetChildren() do
		if child:IsA("BasePart") then
			dressFoam(child)
		end
	end
end

--------------------------------------------------------------------------------
-- Arena-Insel und aeusserer Steg (pro besetztem Slot, lokal)
--------------------------------------------------------------------------------

local function buildCoast(slot: number): Coast
	local cfg = WorldFXConfig.ARENA_COAST
	local model = Instance.new("Model")
	model.Name = "ArenaCoast_" .. slot

	-- Schaum um die Arena-Insel: wie ScenicBuilder.buildFoam
	local center = MapLayout.pitCenter(slot)
	local radius = MapConfig.PIT_BASE_RADIUS + MapConfig.SHORE_WIDTH + AmbienceConfig.FOAM_REACH
	local foam = WorldFXKit.part("Foam", model, Vector3.new(0.1, radius * 2, radius * 2),
		CFrame.new(center.X, FOAM_Y, center.Z) * UPRIGHT, WorldFXConfig.FOAM_COLOR,
		Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	foam.Transparency = AmbienceConfig.FOAM_TRANSPARENCY
	local lace = dressFoam(foam)

	-- Pfosten mit Leuchtkappe an beiden Enden des aeusseren Stegs (wie
	-- ScenicBuilder.buildBridgePosts fuer die inneren Stege)
	local outward = MapLayout.outward(slot)
	local side = MapLayout.side(slot)
	local deckTop = MapConfig.PLATFORM_TOP_Y - MapConfig.BRIDGE_SINK
	local sideOffset = (MapConfig.BRIDGE_WIDTH + MapConfig.BRIDGE_RAIL_WIDTH) * 0.5
	local islandEdge = MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS
	for _, r in { islandEdge + cfg.INSET, islandEdge + MapConfig.ISLAND_GAP - cfg.INSET } do
		for _, sign in { -1, 1 } do
			local p = MapConfig.CENTER + outward * r + side * (sign * sideOffset)
			WorldFXKit.pole("Post", model, Vector3.new(p.X, deckTop, p.Z), cfg.POST_HEIGHT, cfg.POST_DIAMETER,
				MapConfig.BRIDGE_RAIL_COLOR, Enum.Material.Wood)
			local cap = WorldFXKit.ball("Cap", model, cfg.CAP_SIZE,
				Vector3.new(p.X, deckTop + cfg.POST_HEIGHT + 0.5, p.Z), WorldFXConfig.LAMP_DAY, Enum.Material.Neon)
			DayCycleController.registerGlow(cap, WorldFXConfig.LAMP_DAY, WorldFXConfig.LAMP_NIGHT)
		end
	end

	return { model = model, occupied = false, shown = false, foam = foam, lace = lace, phase = slot * 0.8 + 0.4 }
end

local function slotOf(child: Instance): number?
	local n = string.match(child.Name, "^Plot_(%d+)$")
	return if n then tonumber(n) else nil
end

local function setOccupied(slot: number, occupied: boolean)
	if not WorldFXKit.enabled("arenaCoast") then return end
	local coast = _coasts[slot]
	if not coast then
		if not occupied then return end
		coast = buildCoast(slot)
		_coasts[slot] = coast
	end
	coast.occupied = occupied
end

-- 2x pro Sekunde: sichtbar = besetzt und in Sichtweite (Pool: das Model
-- bleibt erhalten und wird nur ein- und ausgehaengt).
local function refreshCoasts()
	local camera = workspace.CurrentCamera
	local folder = _folder
	if not (camera and folder) then return end
	local eye = camera.CFrame.Position
	for slot, coast in _coasts do
		local d = (MapLayout.pitCenter(slot) - eye).Magnitude
		local limit = WorldFXConfig.ARENA_COAST.SHOW_DISTANCE * (if coast.shown then 1 else 0.9)
		local want = coast.occupied and d <= limit
		if want ~= coast.shown then
			coast.shown = want
			coast.model.Parent = if want then folder else nil
		end
	end
end

--------------------------------------------------------------------------------
-- Bonbon-Bojen
--------------------------------------------------------------------------------

local function buildBuoys(folder: Instance)
	local cfg = WorldFXConfig.BUOYS
	local positions = MapLayout.buoys(cfg.RADIUS)
	local step = if WorldFXKit.quality() == 1 then 1 else 2
	for i = 1, #positions, step do
		local p = positions[i]
		local model = Instance.new("Model")
		model.Name = "Buoy"
		local s = cfg.SIZE
		WorldFXKit.ball("Body", model, s, p + Vector3.new(0, s * 0.25, 0), cfg.BODY_COLOR, Enum.Material.SmoothPlastic)
		WorldFXKit.part("Stripe", model, Vector3.new(s * 0.32, s * 1.02, s * 1.02),
			CFrame.new(p + Vector3.new(0, s * 0.3, 0)) * UPRIGHT, cfg.STRIPE_COLOR, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		WorldFXKit.ball("Knob", model, s * 0.38, p + Vector3.new(0, s * 0.8, 0), cfg.STRIPE_COLOR, Enum.Material.SmoothPlastic)
		model.Parent = folder
		table.insert(_buoys, { model = model, base = model:GetPivot(), phase = i * 1.7 })
	end
end

--------------------------------------------------------------------------------
-- Honig-Fisch
--------------------------------------------------------------------------------

local function buildFish(folder: Instance)
	local cfg = WorldFXConfig.FISH
	local model = Instance.new("Model")
	model.Name = "HoneyFish"
	-- Koerper: runder, goldglaenzender Ball (Laengsachse = Z), Schwanz, Flosse, Auge
	local body = WorldFXKit.ellipsoid("Body", model, Vector3.new(1.3, 1.5, 2.2), CFrame.new(), cfg.COLOR,
		Enum.Material.SmoothPlastic)
	body.Reflectance = 0.25
	WorldFXKit.part("Tail", model, Vector3.new(0.2, 1.4, 1.0), CFrame.new(0, 0, 1.35), cfg.FIN_COLOR, Enum.Material.SmoothPlastic)
	WorldFXKit.part("Fin", model, Vector3.new(0.15, 0.6, 0.8), CFrame.new(0, 0.8, 0.1), cfg.FIN_COLOR, Enum.Material.SmoothPlastic)
	for _, x in { -0.5, 0.5 } do
		WorldFXKit.ball("Eye", model, 0.28, Vector3.new(x, 0.25, -0.75), Color3.fromRGB(40, 28, 20), Enum.Material.SmoothPlastic)
	end
	model.PrimaryPart = body
	_fish = { model = model, active = false, start = 0, from = Vector3.zero, dir = Vector3.new(0, 0, -1) }

	-- Spritzer: ein Emitter, wird an Absprung- und Eintauchstelle gesetzt
	local anchor = WorldFXKit.anchor("SplashAnchor", folder, Vector3.new(1, 0.2, 1), Vector3.new(0, -200, 0))
	local emitter = Instance.new("ParticleEmitter")
	if WorldFXKit.applyParticleTexture(emitter, "splash_flipbook") then
		if emitter.FlipbookLayout ~= Enum.ParticleFlipbookLayout.None then
			emitter.FlipbookMode = Enum.ParticleFlipbookMode.OneShot   -- 4 Bilder ueber die Lebenszeit
		end
		emitter.Rate = 0
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		emitter.Lifetime = NumberRange.new(0.5, 0.8)
		emitter.Speed = NumberRange.new(4, 9)
		emitter.SpreadAngle = Vector2.new(35, 35)
		emitter.Acceleration = Vector3.new(0, -30, 0)
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0.2) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		emitter.Parent = anchor
		_splash = emitter
	else
		emitter:Destroy()
	end
	_splashAnchor = anchor

	-- Ring auf der Oberflaeche: flache Scheibe; mit Ring-Bild nur das Bild
	local ring = WorldFXKit.part("Ring", nil, Vector3.new(0.05, 1, 1), CFrame.new(), Color3.new(1, 1, 1),
		Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	local ringId = WorldFXKit.textureId("water_ring")
	if ringId then
		local decal = Instance.new("Decal")
		decal.Texture = ringId
		decal.Face = TOP_FACE
		decal.Parent = ring
		ring.Transparency = 1
		_ringDecal = decal
	end
	_ring = ring
end

local function splashAt(position: Vector3, folder: Instance)
	local anchor = _splashAnchor
	local emitter = _splash
	if anchor and emitter then
		anchor.Position = Vector3.new(position.X, WATER_Y + 0.2, position.Z)
		emitter:Emit(10)
	end
	local ring = _ring
	if ring then
		ring.CFrame = CFrame.new(position.X, WATER_Y + 0.06, position.Z) * UPRIGHT
		ring.Parent = folder
		_ringStart = os.clock()
	end
end

-- Neuer Sprung: offener Wasserpunkt vor der Kamera, sonst spaeter erneut.
local function startFish(folder: Instance): boolean
	local fish = _fish
	local camera = workspace.CurrentCamera
	if not (fish and camera) or fish.active then return false end
	local cfg = WorldFXConfig.FISH
	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
	for _ = 1, 8 do
		local turn = _random:NextNumber(-0.6, 0.6)
		local dist = _random:NextNumber(cfg.DIST_MIN, cfg.DIST_MAX)
		local dir = CFrame.Angles(0, turn, 0):VectorToWorldSpace(flat)
		local p = camera.CFrame.Position + dir * dist
		local jumpAngle = _random:NextNumber(0, math.pi * 2)
		local jumpDir = Vector3.new(math.cos(jumpAngle), 0, math.sin(jumpAngle))
		local land = p + jumpDir * cfg.JUMP_LENGTH
		if MapLayout.isOpenWater(p.X, p.Z, cfg.WATER_MARGIN) and MapLayout.isOpenWater(land.X, land.Z, cfg.WATER_MARGIN) then
			fish.from = Vector3.new(p.X, WATER_Y, p.Z)
			fish.dir = jumpDir
			fish.start = os.clock()
			fish.active = true
			fish.model.Parent = folder
			splashAt(fish.from, folder)
			return true
		end
	end
	return false
end

local function stepFish(folder: Instance)
	local fish = _fish
	if not fish then return end
	local cfg = WorldFXConfig.FISH

	if fish.active then
		local t = (os.clock() - fish.start) / cfg.JUMP_TIME
		if t >= 1 then
			fish.active = false
			fish.model.Parent = nil
			splashAt(fish.from + fish.dir * cfg.JUMP_LENGTH, folder)
			_nextFishAt = os.clock() + _random:NextNumber(cfg.PAUSE_MIN, cfg.PAUSE_MAX)
		else
			-- Bogen: startet und endet knapp unter Wasser, Nase folgt der Bahn
			local height = cfg.JUMP_HEIGHT * 4 * t * (1 - t) - 0.8
			local pos = fish.from + fish.dir * (cfg.JUMP_LENGTH * t) + Vector3.new(0, height, 0)
			local slope = cfg.JUMP_HEIGHT * 4 * (1 - 2 * t) / cfg.JUMP_LENGTH
			local forward = (fish.dir + Vector3.new(0, slope, 0)).Unit
			fish.model:PivotTo(CFrame.lookAt(pos, pos + forward))
		end
	elseif os.clock() >= _nextFishAt then
		if not startFish(folder) then
			_nextFishAt = os.clock() + 5   -- kein Wasser in Sicht: gleich nochmal
		end
	end

	-- Ring waechst und verblasst
	local ring = _ring
	if ring and ring.Parent then
		local k = (os.clock() - _ringStart) / cfg.RING_TIME
		if k >= 1 then
			ring.Parent = nil
		else
			local size = 1 + cfg.RING_SIZE * k
			ring.Size = Vector3.new(0.05, size, size)
			local decal = _ringDecal
			if decal then
				decal.Transparency = k
			else
				ring.Transparency = 0.5 + 0.5 * k
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function WaterController.init()
	if not FeatureFlags.isOn("WORLD_B_WATER") then return end
	local folder = WorldFXKit.folder("Water", WorldFXKit.root())
	_folder = folder

	task.spawn(setupWater)
	task.spawn(setupFoam)

	if WorldFXKit.enabled("buoys") then
		buildBuoys(folder)
	end
	if WorldFXKit.enabled("fish") then
		buildFish(folder)
		_nextFishAt = os.clock() + _random:NextNumber(WorldFXConfig.FISH.PAUSE_MIN * 0.5, WorldFXConfig.FISH.PAUSE_MAX * 0.5)
	end

	-- Besetzte Plots (Plot_N in workspace) bekommen ihre Arena-Kueste
	for _, child in workspace:GetChildren() do
		local slot = slotOf(child)
		if slot then setOccupied(slot, true) end
	end
	workspace.ChildAdded:Connect(function(child)
		local slot = slotOf(child)
		if slot then setOccupied(slot, true) end
	end)
	workspace.ChildRemoved:Connect(function(child)
		local slot = slotOf(child)
		if slot and not workspace:FindFirstChild(child.Name) then setOccupied(slot, false) end
	end)

	-- Debug (Studio): sofort einen Fisch springen lassen
	WorldFXKit.onDebug("DebugFish", function()
		_nextFishAt = 0
	end, false)

	local cfg = WorldFXConfig.WATER
	local buoyCfg = WorldFXConfig.BUOYS
	local acc, coastAcc, clock = 0, 0, 0
	local twoPi = math.pi * 2
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		acc += dt
		coastAcc += dt
		if coastAcc >= 0.5 then
			coastAcc = 0
			refreshCoasts()
		end
		if acc < cfg.TICK then return end
		acc = 0

		local day = DayCycleController.values()

		-- Glitzern und Wellen wandern in zwei Richtungen
		local glitter = _glitter
		if glitter then
			glitter.OffsetStudsU = (clock * cfg.GLITTER_SPEED.X) % cfg.GLITTER_TILE
			glitter.OffsetStudsV = (clock * cfg.GLITTER_SPEED.Y) % cfg.GLITTER_TILE
			glitter.Transparency = 1 - (1 - cfg.GLITTER_TRANSPARENCY) * day.glitter
			glitter.Color3 = day.glitterTint
		end
		local waves = _waves
		if waves then
			waves.OffsetStudsU = (clock * cfg.WAVES_SPEED.X) % cfg.WAVES_TILE
			waves.OffsetStudsV = (clock * cfg.WAVES_SPEED.Y) % cfg.WAVES_TILE
		end
		-- Schaum treibt ganz langsam (die festen Saeume atmet AmbienceController)
		for _, lace in _laces do
			lace.OffsetStudsU = (clock * cfg.FOAM_DRIFT) % cfg.FOAM_TILE
		end
		-- Arena-Schaum atmet wie die festen Saeume
		for _, coast in _coasts do
			if coast.shown then
				local value = AmbienceConfig.FOAM_TRANSPARENCY
					+ math.sin(clock / AmbienceConfig.FOAM_PULSE_PERIOD * twoPi + coast.phase) * AmbienceConfig.FOAM_PULSE
				local lace = coast.lace
				if lace then lace.Transparency = value else coast.foam.Transparency = value end
			end
		end

		-- Bojen schaukeln
		for _, buoy in _buoys do
			local w = clock * buoyCfg.ROCK_RATE * twoPi + buoy.phase
			buoy.model:PivotTo(buoy.base
				* CFrame.new(0, math.sin(w * 0.7) * buoyCfg.BOB_HEIGHT, 0)
				* CFrame.Angles(math.rad(buoyCfg.ROCK_DEGREES) * math.sin(w), 0, math.rad(buoyCfg.ROCK_DEGREES * 0.6) * math.cos(w * 0.8)))
		end

		stepFish(folder)
	end)

	print("[Water] aktiv | Glitzer-Bild:", WorldFXKit.textureId("water_glitter") ~= nil, "| Bojen:", #_buoys, "| Fisch:", _fish ~= nil)
end

return WaterController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX40"><Properties>
<string name="Name">WorldFXKit</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldFXKit.luau
-- StarterPlayerScripts/Controllers/WorldFXKit.luau
--
-- Einzige Zustaendigkeit:
--   - Gemeinsame Bausteine der Welt-Controller ("Welt aufwerten"): Qualitaet,
--     Deko-Teile, Texturen mit Rueckfall, Distanz-Abschaltung, Debug-Signale
--
-- Kein eigener Takt, kein Zustand ausser der Liste der Distanz-Gruppen. Die
-- Controller (DayCycle, Water, Hub, WorldShot) rufen nur Funktionen auf.
--
-- PERFORMANCE-REGELN fuer alles, was hier entsteht:
--   * Anchored, ohne Kollision, Query, Touch und Schatten.
--   * Keine Light-Instanzen: Leuchten ueber Neon + Bloom.
--   * Distanz-Gruppen werden zweimal pro Sekunde geprueft (nicht pro Frame)
--     und mit Hysterese ein- und ausgehaengt (Parent), damit nichts flackert.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local WorldFXConfig  = require(ReplicatedStorage.Config.WorldFXConfig)

local WorldFXKit = {}

--------------------------------------------------------------------------------
-- Qualitaet
--------------------------------------------------------------------------------

-- 1 = hoch, 0 = niedrig. Wie AmbienceController: Grafikstufe des Spielers,
-- "Automatisch" zaehlt als hoch. Einmal beim Start gelesen.
local _quality: number? = nil

function WorldFXKit.quality(): number
	local cached = _quality
	if cached then
		return cached
	end
	local ok, level = pcall(function()
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel.Value
	end)
	local q = if not ok or level == 0 or level >= AmbienceConfig.HIGH_QUALITY_FROM then 1 else 0
	_quality = q
	return q
end

-- Laeuft die Funktion `name` (WorldFXConfig.MIN_QUALITY) auf diesem Geraet?
function WorldFXKit.enabled(name: string): boolean
	local need = (WorldFXConfig.MIN_QUALITY :: any)[name]
	if need == nil then
		warn("[WorldFXKit] unbekannte Funktion in MIN_QUALITY:", name)
		return false
	end
	return WorldFXKit.quality() >= need
end

--------------------------------------------------------------------------------
-- Texturen
--------------------------------------------------------------------------------

-- Hochgeladene ID oder nil.
function WorldFXKit.textureId(name: string): string?
	local id = WorldFXConfig.TEXTURE_IDS[name]
	if id and id ~= "" then
		return id
	end
	return nil
end

-- Bild fuer einen Partikel-Emitter: hochgeladen, sonst eingebauter Rueckfall,
-- sonst nil. Zweiter Wert: ob es das (2x2-)Flipbook ist.
function WorldFXKit.particleTexture(name: string): (string?, boolean)
	local id = WorldFXKit.textureId(name)
	if id then
		return id, WorldFXConfig.FLIPBOOKS[name] == true
	end
	return WorldFXConfig.TEXTURE_FALLBACK[name], false
end

-- Setzt Bild (und ggf. Flipbook-Layout) eines Emitters. Gibt false zurueck,
-- wenn es weder Bild noch Rueckfall gibt (Aufrufer laesst den Effekt weg).
function WorldFXKit.applyParticleTexture(emitter: ParticleEmitter, name: string): boolean
	local image, flipbook = WorldFXKit.particleTexture(name)
	if not image then
		return false
	end
	emitter.Texture = image
	if flipbook then
		emitter.FlipbookLayout = Enum.ParticleFlipbookLayout.Grid2x2
		emitter.FlipbookMode   = Enum.ParticleFlipbookMode.Loop
		emitter.FlipbookFramerate = NumberRange.new(8, 10)
		emitter.FlipbookStartRandom = true
	end
	return true
end

--------------------------------------------------------------------------------
-- Deko-Teile
--------------------------------------------------------------------------------

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))
WorldFXKit.UPRIGHT = UPRIGHT

function WorldFXKit.part(
	name: string,
	parent: Instance?,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local part = Instance.new("Part")
	part.Name          = name
	part.Anchored      = true
	part.CanCollide    = false
	part.CanQuery      = false
	part.CanTouch      = false
	part.CastShadow    = false
	part.Size          = size
	part.CFrame        = cframe
	part.Color         = color
	part.Material      = material or Enum.Material.SmoothPlastic
	part.Shape         = shape or Enum.PartType.Block
	part.TopSurface    = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent        = parent
	return part
end

-- Senkrechter Zylinder: Fuss bei `base`, Hoehe `height`.
function WorldFXKit.pole(name: string, parent: Instance?, base: Vector3, height: number, diameter: number, color: Color3, material: Enum.Material?): Part
	return WorldFXKit.part(name, parent, Vector3.new(height, diameter, diameter),
		CFrame.new(base + Vector3.new(0, height * 0.5, 0)) * UPRIGHT, color, material, Enum.PartType.Cylinder)
end

function WorldFXKit.ball(name: string, parent: Instance?, diameter: number, position: Vector3, color: Color3, material: Enum.Material?): Part
	return WorldFXKit.part(name, parent, Vector3.one * diameter, CFrame.new(position), color, material, Enum.PartType.Ball)
end

-- Laenglicher Koerper (Fisch, Biene, Wespe): Block mit Kugel-Mesh. Ein Ball-
-- Teil wird von Roblox auf gleiche Achsen gezwungen, das Mesh nicht.
function WorldFXKit.ellipsoid(name: string, parent: Instance?, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local part = WorldFXKit.part(name, parent, size, cframe, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

-- Unsichtbarer Anker fuer einen Emitter (Box-Form, Groesse = Spawn-Volumen).
function WorldFXKit.anchor(name: string, parent: Instance?, size: Vector3, position: Vector3): Part
	local part = WorldFXKit.part(name, parent, size, CFrame.new(position), Color3.new(1, 1, 1))
	part.Transparency = 1
	return part
end

function WorldFXKit.folder(name: string, parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

-- Gemeinsamer Wurzelordner aller Welt-Effekte (lokal, wird nie repliziert).
local _root: Folder? = nil
function WorldFXKit.root(): Folder
	local root = _root
	if root and root.Parent then
		return root
	end
	local created = WorldFXKit.folder("WorldFX_Local", workspace)
	_root = created
	return created
end

--------------------------------------------------------------------------------
-- Distanz-Abschaltung
--------------------------------------------------------------------------------
-- Eine Gruppe ist ein Container (Folder/Model) mit Mittelpunkt und
-- Sichtweite. Ist die Kamera weiter weg als `distance`, wird der Container
-- aus der Welt genommen (Parent = nil); naeher als 90 % davon kommt er
-- zurueck. `onChange(visible)` erlaubt dem Controller, seinen Takt fuer die
-- Gruppe auszusetzen.

type Group = { container: Instance, parent: Instance, center: Vector3, distance: number, visible: boolean, onChange: ((boolean) -> ())? }

local _groups: { Group } = {}
local _cullStarted = false
local CULL_TICK = 0.5
local HYSTERESIS = 0.9

local function cullOnce()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local eye = camera.CFrame.Position
	for _, group in _groups do
		local d = (group.center - eye).Magnitude
		local want = if group.visible then d <= group.distance else d <= group.distance * HYSTERESIS
		if want ~= group.visible then
			group.visible = want
			group.container.Parent = if want then group.parent else nil
			local cb = group.onChange
			if cb then
				task.spawn(cb, want)
			end
		end
	end
end

-- Meldet eine Gruppe an. Rueckgabe: Funktion zum Abmelden (der Container wird
-- dabei NICHT zerstoert, das macht der Aufrufer).
function WorldFXKit.cullGroup(container: Instance, center: Vector3, distance: number, onChange: ((boolean) -> ())?): () -> ()
	local group: Group = {
		container = container,
		parent = container.Parent or WorldFXKit.root(),
		center = center,
		distance = distance,
		visible = true,
		onChange = onChange,
	}
	table.insert(_groups, group)

	if not _cullStarted then
		_cullStarted = true
		local acc = 0
		RunService.Heartbeat:Connect(function(dt: number)
			acc += dt
			if acc >= CULL_TICK then
				acc = 0
				cullOnce()
			end
		end)
	end
	cullOnce()

	return function()
		local index = table.find(_groups, group)
		if index then
			table.remove(_groups, index)
		end
	end
end

-- Ist die Gruppe des Containers gerade sichtbar? (Fuer Takte, die sparen wollen.)
function WorldFXKit.isShown(container: Instance): boolean
	return container.Parent ~= nil
end

--------------------------------------------------------------------------------
-- Debug-Signale (nur Studio)
--------------------------------------------------------------------------------
-- DebugService setzt Attribute an workspace (repliziert an alle Test-Clients).
-- Name → Rueckruf bei jeder Aenderung, mit dem aktuellen Wert.
-- `isState` = true: ein schon gesetzter Wert gilt auch fuer einen spaeter
-- beitretenden Test-Client (Zustaende wie "daytime"). false: nur ein
-- Ausloeser (Fisch, Ankunft, Kamera), ein alter Wert wird beim Start ignoriert.

function WorldFXKit.onDebug(attribute: string, callback: (any) -> (), isState: boolean?)
	if not RunService:IsStudio() then
		return
	end
	workspace:GetAttributeChangedSignal(attribute):Connect(function()
		callback(workspace:GetAttribute(attribute))
	end)
	local current = workspace:GetAttribute(attribute)
	if current ~= nil and isState ~= false then
		task.defer(callback, current)
	end
end

--------------------------------------------------------------------------------
-- Mathe
--------------------------------------------------------------------------------

function WorldFXKit.lerpColor(a: Color3, b: Color3, t: number): Color3
	return a:Lerp(b, math.clamp(t, 0, 1))
end

return WorldFXKit
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX41"><Properties>
<string name="Name">WorldMomentController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldMomentController.luau
-- StarterPlayerScripts/Controllers/WorldMomentController.luau
--
-- Einzige Zustaendigkeit:
--   - Grosse Momente sichtbar machen, die der ganze Server sieht (Paket G,
--     "Welt aufwerten"): Lichtsaeule (+ Funkenring) beim seltenen Baerchi,
--     Feuerwerk beim neuen Tower, Jubel beim Rekord, Lichtwelle beim Rebirth,
--     Funkenspirale bei seltener Mutation, und am Honigmast den Event-Start
--
-- Woher: Remotes.WorldMoment (WorldMomentService erkennt die Momente aus dem
-- Spielstand). Der Event-Start kommt vom Client selbst (HubEventController
-- sieht den Pit-Ring umschalten). Der Boss-Himmel ist schon da
-- (EventFXController.setBossSky), das Nest pulsiert (HubEventController).
--
-- Regeln (Leitbild):
--   * Hoechstens EIN grosser Moment gleichzeitig; weitere warten in einer
--     kurzen Schlange (Modules/WorldMoments.Queue), kleine laufen sofort.
--   * Momente anderer Spieler verdecken nie die eigene Sicht: kein
--     Vollbild-Blitz, kein Farbfilter, nichts vor der Kamera. Sie liegen
--     ueber der Insel des Spielers in der Welt.
--   * "Momente anderer Spieler": on | small | off (WorldFXConfig.MOMENTS).
--
-- PERFORMANCE: alle Teile aus festen Pools, ein Takt (30 Hz) nur waehrend
-- ein Effekt laeuft. Keine Lichter, kein Emitter.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local TowerConfig   = require(ReplicatedStorage.Config.TowerConfig)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)
local WorldMoments  = require(ReplicatedStorage.Modules.WorldMoments)
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)

local WorldFXKit            = require(script.Parent.WorldFXKit)
local DayCycleController    = require(script.Parent.DayCycleController)
local ArenaLifeController   = require(script.Parent.ArenaLifeController)
local PlotLifeController    = require(script.Parent.PlotLifeController)
local LifeController        = require(script.Parent.LifeController)
local HubLandmarkController = require(script.Parent.HubLandmarkController)
local SoundscapeController  = require(script.Parent.SoundscapeController)

local WorldMomentController = {}

local localPlayer = Players.LocalPlayer
local UPRIGHT = WorldFXKit.UPRIGHT
local TICK = 1 / 30
local TAU = math.pi * 2

type Payload = { userId: number, kind: string, value: string, number: number?, big: boolean }
-- Ein laufender Effekt: step(t 0..1) bis fertig, dann done()
type Effect = { start: number, duration: number, step: (number) -> (), done: () -> () }

local _folder: Folder? = nil
local _effects: { Effect } = {}
local _queue = WorldMoments.newQueue()
local _pending: { [number]: Payload } = {}
local _nextId = 0

-- Pools
local _column: BasePart? = nil
local _sparks: { BasePart } = {}
local _wave: BasePart? = nil
local _line: TextLabel? = nil
local _lineUntil = 0

--------------------------------------------------------------------------------
-- Pools
--------------------------------------------------------------------------------

local SPARK_POOL = 48

local function buildPools()
	_column = WorldFXKit.part("MomentColumn", nil, Vector3.new(1, 1, 1), CFrame.new(), Color3.new(1, 1, 1),
		Enum.Material.Neon, Enum.PartType.Cylinder)
	_wave = WorldFXKit.part("MomentWave", nil, Vector3.new(0.1, 1, 1), CFrame.new(), Color3.fromRGB(255, 226, 150),
		Enum.Material.Neon, Enum.PartType.Cylinder)
	for _ = 1, SPARK_POOL do
		table.insert(_sparks, WorldFXKit.ball("Spark", nil, 0.7, Vector3.zero, Color3.new(1, 1, 1), Enum.Material.Neon))
	end
end

-- `n` freie Funken (Parent nil) holen; weniger, wenn der Pool leer ist.
local function takeSparks(n: number): { BasePart }
	local out = {}
	for _, spark in _sparks do
		if #out >= n then break end
		if spark.Parent == nil and not spark:GetAttribute("Busy") then
			spark:SetAttribute("Busy", true)
			table.insert(out, spark)
		end
	end
	return out
end

local function releaseSparks(list: { BasePart })
	for _, spark in list do
		spark.Parent = nil
		spark:SetAttribute("Busy", nil)
	end
end

local function run(duration: number, step: (number) -> (), done: () -> ())
	table.insert(_effects, { start = os.clock(), duration = duration, step = step, done = done })
end

--------------------------------------------------------------------------------
-- Orte
--------------------------------------------------------------------------------

local function slotOfUser(userId: number): number?
	for slot = 1, MapConfig.PLOT_COUNT do
		local plot = workspace:FindFirstChild("Plot_" .. slot)
		if plot and plot:GetAttribute("PlotOwner") == userId then return slot end
	end
	return nil
end

local function figurePosition(slot: number): Vector3?
	local plot = workspace:FindFirstChild("Plot_" .. slot)
	local figures = plot and plot:FindFirstChild("Baerchis")
	if figures then
		for _, child in figures:GetChildren() do
			if child:IsA("Model") then return child:GetPivot().Position end
			if child:IsA("BasePart") then return child.Position end
		end
	end
	return nil
end

local function nearCamera(position: Vector3): boolean
	local camera = workspace.CurrentCamera
	return camera ~= nil and (camera.CFrame.Position - position).Magnitude <= WorldFXConfig.MOMENTS.NEAR_DISTANCE
end

--------------------------------------------------------------------------------
-- Die Bilder
--------------------------------------------------------------------------------

-- Lichtsaeule ueber der Insel (Rarity-Farbe), ab RING_MIN zusaetzlich Funkenring
local function playHatch(slot: number, rarity: string, big: boolean)
	local cfg = WorldFXConfig.MOMENTS
	local folder = _folder :: Folder
	local center = MapLayout.plotCenter(slot)
	local color = BaerchiConfig.RARITY_COLORS[rarity :: any] or Color3.new(1, 1, 1)
	local height = cfg.COLUMN_HEIGHT * (if big then 1 else 0.5)
	local duration = if big then cfg.DURATION.hatch else 1.2

	local column = _column
	if column and column.Parent == nil then   -- belegt (kleiner Moment parallel): nur Ring
		column.Color = color
		column.Parent = folder
		run(duration, function(t)
			local h = height * math.min(1, t * 3)
			local w = cfg.COLUMN_WIDTH * (1 - 0.4 * t)
			column.Size = Vector3.new(h, w, w)
			column.CFrame = CFrame.new(center + Vector3.new(0, h * 0.5, 0)) * UPRIGHT
			column.Transparency = 0.35 + 0.65 * t * t
		end, function()
			column.Parent = nil
		end)
	end

	local ringFrom = WorldMoments.rarityIndex(cfg.RING_MIN_RARITY)
	if big and WorldMoments.rarityIndex(rarity) >= ringFrom and WorldFXKit.enabled("momentRing") then
		local sparks = takeSparks(cfg.RING_SPARKS)
		for _, s in sparks do s.Color = color; s.Parent = folder end
		run(duration, function(t)
			local r = 6 + 26 * math.sin(t * math.pi * 0.5)
			for i, s in sparks do
				local a = i / #sparks * TAU + t * 1.5
				s.Position = center + Vector3.new(math.cos(a) * r, cfg.RING_HEIGHT + 4 * t, math.sin(a) * r)
				s.Transparency = t * t
			end
		end, function() releaseSparks(sparks) end)
	end
end

-- Feuerwerk vom Schau-Turm in der Farbe des neuen Towers
local function playTower(slot: number, towerId: string, big: boolean)
	local cfg = WorldFXConfig.MOMENTS
	local folder = _folder :: Folder
	local def = TowerConfig.get(towerId)
	local color = if def then def.color else Color3.fromRGB(255, 214, 110)
	local foot = MapLayout.showcaseFoot(slot) + Vector3.new(0, 12, 0)
	local rockets = if big then cfg.FIREWORK_ROCKETS else 1
	for r = 1, rockets do
		local delay = (r - 1) * 0.35
		local offset = Vector3.new(math.cos(r * 2.1) * 4, 0, math.sin(r * 2.1) * 4)
		local burst = foot + offset + Vector3.new(0, 22 + r * 3, 0)
		task.delay(delay, function()
			local rocket = takeSparks(1)
			local sparks = takeSparks(cfg.FIREWORK_SPARKS)
			for _, s in rocket do s.Color = Color3.fromRGB(255, 240, 200); s.Parent = folder end
			run(1.9, function(t)
				if t < 0.4 then
					local k = t / 0.4
					for _, s in rocket do s.Position = (foot + offset):Lerp(burst, 1 - (1 - k) * (1 - k)) end
				else
					for _, s in rocket do s.Parent = nil end
					local k = (t - 0.4) / 0.6
					for i, s in sparks do
						s.Color = color
						s.Parent = folder
						local a = i / #sparks * TAU
						local up = math.cos(i * 1.7) * 0.6
						local dir = Vector3.new(math.cos(a), up, math.sin(a))
						s.Position = burst + dir * (9 * math.sin(k * math.pi * 0.5)) - Vector3.new(0, 4 * k * k, 0)
						s.Transparency = k
					end
				end
			end, function()
				releaseSparks(rocket)
				releaseSparks(sparks)
			end)
		end)
	end
end

-- Weiche Lichtwelle ueber die Insel, Blumen wiegen sich
local function playRebirth(slot: number, big: boolean)
	local cfg = WorldFXConfig.MOMENTS
	local folder = _folder :: Folder
	local center = MapLayout.plotCenter(slot)
	local wave = _wave
	if wave and not wave.Parent then
		wave.Parent = folder
		local maxR = cfg.WAVE_RADIUS * (if big then 1 else 0.6)
		run(if big then cfg.DURATION.rebirth else 1.2, function(t)
			local r = 2 + maxR * t
			wave.Size = Vector3.new(0.1, r * 2, r * 2)
			wave.CFrame = CFrame.new(center.X, MapConfig.PLATFORM_TOP_Y + MapConfig.PLOT_SIZE.Y + 0.08, center.Z) * UPRIGHT
			wave.Transparency = 0.55 + 0.45 * t
		end, function() wave.Parent = nil end)
	end
	PlotLifeController.gust(slot)
end

-- Funkenspirale um den Baerchi (nur in der Naehe)
local function playMutation(slot: number, mutation: string, big: boolean)
	local cfg = WorldFXConfig.MOMENTS
	local at = figurePosition(slot)
	if not at or not nearCamera(at) then return end
	local folder = _folder :: Folder
	local def = (BaerchiConfig.MUTATIONS :: any)[mutation]
	local color = if def then def.color else Color3.new(1, 1, 1)
	local sparks = takeSparks(if big then cfg.SPIRAL_SPARKS else math.ceil(cfg.SPIRAL_SPARKS / 2))
	for _, s in sparks do s.Color = color; s.Parent = folder end
	run(cfg.DURATION.mutation, function(t)
		for i, s in sparks do
			local k = math.clamp(t * 1.4 - i / #sparks * 0.4, 0, 1)
			local a = k * TAU * 2 + i / #sparks * TAU
			local r = 3 - 1.5 * k
			s.Position = at + Vector3.new(math.cos(a) * r, 0.5 + k * 6, math.sin(a) * r)
			s.Transparency = k * k
		end
	end, function() releaseSparks(sparks) end)
end

-- Zeile unten fuer die anderen Spieler ("<Name> hat einen <Rarity>-Baerchi!")
local function showLine(userId: number, rarity: string)
	local label = _line
	if not label then return end
	local player = Players:GetPlayerByUserId(userId)
	label.Text = Loc.t("world.moment.hatch", {
		name = if player then player.DisplayName else "?",
		rarity = Loc.msg("rarity." .. rarity),
	})
	label.TextColor3 = BaerchiConfig.RARITY_COLORS[rarity :: any] or Color3.new(1, 1, 1)
	label.Visible = true
	_lineUntil = os.clock() + WorldFXConfig.MOMENTS.LINE_SECONDS
end

local function play(payload: Payload, big: boolean)
	local slot = slotOfUser(payload.userId)
	if not slot then return end
	local kind = payload.kind
	if kind == "hatch" then
		playHatch(slot, payload.value, big)
	elseif kind == "tower" then
		playTower(slot, payload.value, big)
	elseif kind == "record" then
		ArenaLifeController.celebrate(payload.userId)
	elseif kind == "rebirth" then
		playRebirth(slot, big)
	elseif kind == "mutation" then
		playMutation(slot, payload.value, big)
	end
end

--------------------------------------------------------------------------------
-- Eingang
--------------------------------------------------------------------------------

local function onMoment(raw: any)
	if typeof(raw) ~= "table" or typeof(raw.userId) ~= "number" or typeof(raw.kind) ~= "string" then return end
	local payload: Payload = {
		userId = raw.userId,
		kind = raw.kind,
		value = tostring(raw.value or ""),
		number = if typeof(raw.number) == "number" then raw.number else nil,
		big = raw.big == true,
	}
	local isSelf = payload.userId == localPlayer.UserId
	if not isSelf then
		local mode = WorldFXConfig.MOMENTS.OTHERS_DEFAULT
		if mode == "off" then return end
		if mode == "small" then payload.big = false end
		if payload.kind == "hatch" then showLine(payload.userId, payload.value) end
	end

	_nextId += 1
	local entry = { id = _nextId, kind = payload.kind, big = payload.big, at = os.clock() }
	if WorldMoments.push(_queue, entry) then
		play(payload, entry.big)
	else
		_pending[entry.id] = payload
	end
end

-- Event startet: Glocke (Krone blinkt zweimal), Bienen ziehen zum Event-Pit.
-- Aufrufer: HubEventController beim Wechsel auf "live".
function WorldMomentController.eventStarted()
	if not (FeatureFlags.isOn("WORLD_G_MOMENTS") and WorldFXKit.enabled("eventBell")) then return end
	HubLandmarkController.flashCrown()
	SoundscapeController.bell()   -- leise, einmal (still ohne gepruefte ID)
	LifeController.rally(MapConfig.CENTER + Vector3.new(0, MapConfig.PLATFORM_TOP_Y, 0), 10)
end

function WorldMomentController.init()
	if not (FeatureFlags.isOn("WORLD_G_MOMENTS") and WorldFXKit.enabled("moments")) then return end
	local folder = WorldFXKit.folder("Moments", WorldFXKit.root())
	_folder = folder
	buildPools()

	-- Die Zeile unten (eigene kleine Oberflaeche, ueber nichts drueber)
	local gui = Instance.new("ScreenGui")
	gui.Name = "WorldMomentLine"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 1
	gui.Parent = localPlayer:WaitForChild("PlayerGui")
	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.Position = UDim2.new(0.5, 0, 1, -96)
	label.Size = UDim2.fromOffset(520, 28)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextStrokeTransparency = 0.4
	label.Visible = false
	label.Parent = gui
	_line = label

	Remotes.WorldMoment.OnClientEvent:Connect(onMoment)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < TICK then return end
		acc = 0
		local now = os.clock()

		-- naechster grosser Moment, sobald die Buehne frei ist — nicht waehrend
		-- die eigene Faehigkeiten-Show laeuft (wer zu lange wartet, kommt klein)
		local entry = if DayCycleController.showActive() and #_queue.waiting > 0
			and now - _queue.waiting[1].at <= WorldFXConfig.MOMENTS.MAX_WAIT
			then nil else WorldMoments.pop(_queue, now)
		if entry then
			local payload = _pending[entry.id]
			_pending[entry.id] = nil
			if payload then play(payload, entry.big) end
		end

		-- laufende Effekte
		for i = #_effects, 1, -1 do
			local e = _effects[i]
			local t = (now - e.start) / e.duration
			if t >= 1 then
				table.remove(_effects, i)
				e.done()
			else
				e.step(t)
			end
		end

		if label.Visible and now > _lineUntil then
			label.Visible = false
		end
	end)

	print("[WorldMoments] aktiv | andere Spieler:", WorldFXConfig.MOMENTS.OTHERS_DEFAULT)
end

return WorldMomentController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX42"><Properties>
<string name="Name">WorldShotController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldShotController.luau
-- StarterPlayerScripts/Controllers/WorldShotController.luau
--
-- Einzige Zustaendigkeit:
--   - Die sechs festen Kamerapunkte fuer Vorher-/Nachher-Screenshots
--     (Paket 0, "Welt aufwerten") anfahren und wieder freigeben
--
-- NUR IN STUDIO. Ausgeloest ueber den Debug-Befehl "worldshots"
-- (DebugService setzt workspace-Attribut "DebugWorldShot" = "<n>|<zaehler>").
-- n = 1..6: Kamera fest auf Punkt n, UI aus (saubere Bilder). n = 0: zurueck.
--
-- Die Punkte werden aus MapConfig/MapLayout GERECHNET, nicht als feste
-- Koordinaten gespeichert: wandert eine Insel, wandert der Bildpunkt mit, und
-- "vorher" und "nachher" zeigen trotzdem dieselbe Stelle der Welt.
-- Slot 1 = Plot bei 0 Grad (+X).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit = require(script.Parent.WorldFXKit)

local WorldShotController = {}

local localPlayer = Players.LocalPlayer

-- Wie MapParts.buildPlotCFrame (Server): Plot schaut zur Weltmitte.
local function plotCFrame(slot: number): CFrame
	local p = MapLayout.plotCenter(slot)
	return CFrame.lookAt(p, Vector3.new(MapConfig.CENTER.X, p.Y, MapConfig.CENTER.Z))
end

-- Die sechs Punkte: { Augenpunkt, Blickziel }.
function WorldShotController.shots(): { { eye: Vector3, target: Vector3 } }
	local slot = 1
	local plot = plotCFrame(slot)
	local surface = MapConfig.PLATFORM_TOP_Y + MapConfig.PLOT_SIZE.Y
	local mastTop = MapConfig.CENTER + Vector3.new(0, MapConfig.PLATFORM_TOP_Y + 30, 0)
	local outward = MapLayout.outward(slot)
	local pit = MapLayout.pitCenter(slot)
	local islandEdge = MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS

	-- 1 Spawn → Honigmast (Augenhoehe ueber dem Spawn-Punkt)
	local spawn = plot * CFrame.new(MapConfig.PLAYER_SPAWN_OFFSET.X, 0, MapConfig.PLAYER_SPAWN_OFFSET.Z)
	local eye1 = spawn.Position + Vector3.new(0, surface + 5, 0)

	-- 2 Hauptinsel schraeg von oben (ganze Insel im Bild)
	local eye2 = MapConfig.CENTER + Vector3.new(-150, 150, -150)

	-- 3 Plot-Insel aus Spielerhoehe: hinter dem Baerchi-Platz, Blick auf den Brunnen
	local pond = plot * CFrame.new(MapLayout.pondOffset())
	local facing = plot:VectorToWorldSpace(MapLayout.pondFacing())
	local eye3 = pond.Position + facing * 22 + Vector3.new(0, surface + 5.5, 0)
	local target3 = pond.Position + Vector3.new(0, surface + 1.5, 0)

	-- 4 Auf dem Steg zur Arena, Blick auf die Arena
	local eye4 = MapConfig.CENTER + outward * (islandEdge + 4) + Vector3.new(0, MapConfig.PLATFORM_TOP_Y + 5.5, 0)
	local target4 = pit + Vector3.new(0, 4, 0)

	-- 5 Arena mit Turm (seitlich, erhoeht)
	local side = MapLayout.side(slot)
	local eye5 = pit - outward * 30 + side * 45 + Vector3.new(0, 32, 0)
	local target5 = pit + Vector3.new(0, 22, 0)

	-- 6 Vom Rand der Welt zum Horizont (zwischen zwei Stegen)
	local edge = MapLayout.atAngle(22.5, MapConfig.WATER_RADIUS - 60)
	local eye6 = edge + Vector3.new(0, 7, 0)
	local target6 = MapLayout.atAngle(22.5, AmbienceConfig.FAR_ISLAND_RING) + Vector3.new(0, 70, 0)

	return {
		{ eye = eye1, target = mastTop },
		{ eye = eye2, target = MapConfig.CENTER + Vector3.new(0, 4, 0) },
		{ eye = eye3, target = target3 },
		{ eye = eye4, target = target4 },
		{ eye = eye5, target = target5 },
		{ eye = eye6, target = target6 },
	}
end

local _savedFov: number? = nil
local _hiddenGuis: { ScreenGui } = {}

local function release()
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
		local fov = _savedFov
		if fov then camera.FieldOfView = fov end
	end
	_savedFov = nil
	for _, gui in _hiddenGuis do
		gui.Enabled = true
	end
	table.clear(_hiddenGuis)
end

local function show(index: number)
	local camera = workspace.CurrentCamera
	local shot = WorldShotController.shots()[index]
	local meta = WorldFXConfig.WORLD_SHOTS[index]
	if not (camera and shot and meta) then return end

	if not _savedFov then
		_savedFov = camera.FieldOfView
	end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(shot.eye, shot.target)
	camera.FieldOfView = meta.fov

	-- UI aus fuer saubere Bilder
	if #_hiddenGuis == 0 then
		for _, gui in localPlayer:WaitForChild("PlayerGui"):GetChildren() do
			if gui:IsA("ScreenGui") and gui.Enabled then
				gui.Enabled = false
				table.insert(_hiddenGuis, gui)
			end
		end
	end
	print(string.format("[WorldShot] %s | jetzt Screenshot machen, zurueck mit worldshots 0", meta.name))
end

function WorldShotController.init()
	WorldFXKit.onDebug("DebugWorldShot", function(value: any)
		if typeof(value) ~= "string" then return end
		local n = tonumber(string.match(value, "^(%d+)")) or 0
		if n >= 1 and n <= #WorldFXConfig.WORLD_SHOTS then
			show(n)
		else
			release()
		end
	end, false)
end

return WorldShotController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX43"><Properties>
<string name="Name">ZoneLightController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- ZoneLightController.luau
-- StarterPlayerScripts/Controllers/ZoneLightController.luau
--
-- Einzige Zustaendigkeit:
--   - Licht-Feinschliff nach Ort (Paket I, "Welt aufwerten"): auf der Insel
--     wie bisher; auf dem Steg zur Arena und in der Arena etwas mehr
--     Kontrast und Saettigung; hoch oben auf dem Turm (ab Etage 30) klarere
--     Luft und weiterer Horizont
--
-- Wie es wirkt:
--   * Ein EIGENER Farbfilter "ZoneGrade" (nur Kontrast/Saettigung/eine Spur
--     Helligkeit, keine Farbe). Filter stapeln sich in Roblox: der Show-Filter
--     "SkillFX_Sky" und der Boss-Himmel faerben weiter wie bisher, ZoneGrade
--     ueberschreibt nichts und wird von nichts ueberschrieben.
--   * Die Atmosphaere fuehrt der Tageslauf; hier kommen nur Faktoren auf
--     Dichte und Dunst dazu (DayCycleController.setAtmosphereScale). Ist der
--     Tageslauf aus, setzt dieser Controller die festen Werte mal Faktor selbst.
--   * Uebergaenge ueber BLEND_SECONDS (1,5 s), nur Client.
--   * Bewusst KEINE Tiefenunschaerfe (DepthOfField) und keine anderen teuren
--     Effekte — auch nicht fuer PC.

local Lighting          = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local MapConfig      = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig  = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout      = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)

local ZoneLightController = {}

-- 0..1: wie sehr die Kamera "in der Arena" ist (Arena-Insel oder aeusserer
-- Steg), mit weicher Kante.
local function arenaWeight(p: Vector3): number
	local cfg = WorldFXConfig.ZONE_LIGHT
	local best = 0
	local islandEdge = MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS
	for slot = 1, MapConfig.PLOT_COUNT do
		local pit = MapLayout.pitCenter(slot)
		local d = math.sqrt((p.X - pit.X) ^ 2 + (p.Z - pit.Z) ^ 2)
		best = math.max(best, math.clamp((cfg.ARENA_RADIUS - d) / 15, 0, 1))
		-- aeusserer Steg: entlang der Steg-Achse zwischen Plot-Insel und Arena
		local o = MapLayout.outward(slot)
		local along = (p.X - MapConfig.CENTER.X) * o.X + (p.Z - MapConfig.CENTER.Z) * o.Z
		local across = math.abs((p.X - MapConfig.CENTER.X) * o.Z - (p.Z - MapConfig.CENTER.Z) * o.X)
		if along > islandEdge - 4 and along < islandEdge + MapConfig.ISLAND_GAP + 4 then
			best = math.max(best, math.clamp((MapConfig.BRIDGE_WIDTH - across) / 6, 0, 1))
		end
	end
	return best
end

local function highWeight(p: Vector3): number
	local cfg = WorldFXConfig.ZONE_LIGHT
	local y = p.Y - MapConfig.PLATFORM_TOP_Y
	return math.clamp((y - cfg.HIGH_FROM) / (cfg.HIGH_FULL - cfg.HIGH_FROM), 0, 1)
end

function ZoneLightController.init()
	if not (FeatureFlags.isOn("WORLD_I_ZONES") and WorldFXKit.enabled("zoneLight")) then return end
	local cfg = WorldFXConfig.ZONE_LIGHT

	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "ZoneGrade"
	grade.Parent = Lighting

	local arena, high = 0, 0
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < cfg.TICK then return end
		local step = acc
		acc = 0
		local camera = workspace.CurrentCamera
		if not camera then return end
		local p = camera.CFrame.Position

		-- weich zum Ziel (exponentiell, ~BLEND_SECONDS)
		local k = math.clamp(step / cfg.BLEND_SECONDS * 2.5, 0, 1)
		arena += (arenaWeight(p) - arena) * k
		high += (highWeight(p) - high) * k

		local island, ar = cfg.island, cfg.arena
		grade.Saturation = island.saturation + (ar.saturation - island.saturation) * arena
		grade.Contrast   = island.contrast + (ar.contrast - island.contrast) * arena
		grade.Brightness = island.brightness + (ar.brightness - island.brightness) * arena

		local density = 1 + (cfg.HIGH_DENSITY - 1) * high
		local haze = 1 + (cfg.HIGH_HAZE - 1) * high
		if not DayCycleController.setAtmosphereScale(density, haze) then
			-- Tageslauf aus: feste Werte mal Faktor
			local atm = Lighting:FindFirstChild("BaerchiAtmosphere")
			if atm and atm:IsA("Atmosphere") then
				atm.Density = AmbienceConfig.ATMOSPHERE_DENSITY * density
				atm.Haze    = AmbienceConfig.ATMOSPHERE_HAZE * haze
			end
		end
	end)

	print("[ZoneLight] aktiv")
end

return ZoneLightController
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="LocalScript" referent="RBX44"><Properties>
<string name="Name">Main</string>
<bool name="Disabled">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Main.client.luau
-- StarterPlayerScripts/Main.client.luau
--
-- Bootstrap des Clients — das Gegenstueck zu GameManager auf dem Server.
-- Einzige Stelle die die Startreihenfolge der Client-Module kennt.
--
-- ACHTUNG beim Umbenennen: die Datei darf NICHT "init.client.luau" heissen.
-- Rojo macht aus einem Ordner mit init-Datei ein Script statt eines
-- Containers — auf StarterPlayerScripts angewandt heisst das, dass der
-- gesamte Client-Teilbaum nie im Spiel ankommt. Genau das hat den
-- Server-Sync schon einmal lahmgelegt.
--
-- Reihenfolge:
--   1. ScreenGui anlegen — alle UI-Module haengen sich dort ein.
--   2. Toast zuerst, damit fruehe Fehlermeldungen schon sichtbar sind.
--   3. ClientState VOR den datengetriebenen UIs: die registrieren sich per
--      onChanged und bekommen den aktuellen Stand sofort nachgereicht.
--   4. Die Panels. Jedes meldet sich in seinem init beim PanelManager an —
--      erst danach duerfen Module laufen die Panels oeffnen wollen.
--   5. Hud und MenuBar: beide sind reine Ausloeser und brauchen die
--      angemeldeten Panels (Rebirth-Pille, Menue-Knoepfe).
--   6. ResultFeed — Toast-Meldungen fuer Recycling und Offline-Ertrag.
--      Muss vor dem ersten Serverpaket stehen, sonst geht der Offline-Report
--      des Joins verloren.
--   7. WorldController zuletzt — er braucht Panel und PanelManager.
--   8. EggTimerController — unabhaengig von allen anderen, braucht nur
--      ClientState (schon initialisiert) und die Figuren in der Welt.
--   9. SkillFXController (v14) — hoert nur auf Remotes.SkillFXPlay.
--
-- Davor, ganz am Anfang: LanguageController. Er legt die Sprache fest, bevor
-- irgendein Text gebaut wird (er braucht ClientState erst, wenn es dort
-- Daten gibt — onChanged meldet den aktuellen Stand sofort nach).

local Players = game:GetService("Players")

local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local root = script.Parent

local Controllers = root:WaitForChild("Controllers")
local UI          = root:WaitForChild("UI")

local ClientState        = require(Controllers:WaitForChild("ClientState"))
local LanguageController = require(Controllers:WaitForChild("LanguageController"))
local ResultFeed         = require(Controllers:WaitForChild("ResultFeed"))
local WorldController    = require(Controllers:WaitForChild("WorldController"))
local EggTimerController = require(Controllers:WaitForChild("EggTimerController"))
local SkillFXController  = require(Controllers:WaitForChild("SkillFXController"))
local CombController     = require(Controllers:WaitForChild("CombController"))
local AmbienceController = require(Controllers:WaitForChild("AmbienceController"))
-- Welt aufwerten (08.10.2026)
local DayCycleController    = require(Controllers:WaitForChild("DayCycleController"))
local WaterController       = require(Controllers:WaitForChild("WaterController"))
local HubLandmarkController = require(Controllers:WaitForChild("HubLandmarkController"))
local HubEventController    = require(Controllers:WaitForChild("HubEventController"))
local ArrivalController     = require(Controllers:WaitForChild("ArrivalController"))
local WorldShotController   = require(Controllers:WaitForChild("WorldShotController"))
local PlotLifeController    = require(Controllers:WaitForChild("PlotLifeController"))
local ArenaLifeController   = require(Controllers:WaitForChild("ArenaLifeController"))
local LifeController        = require(Controllers:WaitForChild("LifeController"))
local WorldMomentController = require(Controllers:WaitForChild("WorldMomentController"))
local SoundscapeController  = require(Controllers:WaitForChild("SoundscapeController"))
local ZoneLightController   = require(Controllers:WaitForChild("ZoneLightController"))
local EventFXController  = require(Controllers:WaitForChild("EventFXController"))
local LaidEggMeshController = require(Controllers:WaitForChild("LaidEggMeshController"))
local UiEventLogger      = require(Controllers:WaitForChild("UiEventLogger"))
local GuideController    = require(Controllers:WaitForChild("GuideController"))
local UpgradeHintController = require(Controllers:WaitForChild("UpgradeHintController"))
local IncubatorController   = require(Controllers:WaitForChild("IncubatorController"))   -- Sammel-Update 8
local AreaSignController    = require(Controllers:WaitForChild("AreaSignController"))    -- Sammel-Update 3.8

local Toast            = require(UI:WaitForChild("Toast"))
local UiScale          = require(UI:WaitForChild("UiScale"))
local ShopPanel        = require(UI:WaitForChild("ShopPanel"))
local Hud              = require(UI:WaitForChild("Hud"))
local MenuBar          = require(UI:WaitForChild("MenuBar"))
local BaerchiPanel     = require(UI:WaitForChild("BaerchiPanel"))
local BaerchiInventory = require(UI:WaitForChild("BaerchiInventory"))
local HatchPanel       = require(UI:WaitForChild("HatchPanel"))
local CombatPanel      = require(UI:WaitForChild("CombatPanel"))
local BuildingPanel    = require(UI:WaitForChild("BuildingPanel"))
local FusionPanel      = require(UI:WaitForChild("FusionPanel"))
local CharmPanel       = require(UI:WaitForChild("CharmPanel"))
local RebirthDialog    = require(UI:WaitForChild("RebirthDialog"))
local LanguagePanel    = require(UI:WaitForChild("LanguagePanel"))
local PetBar           = require(UI:WaitForChild("PetBar"))
local QuestPanel       = require(UI:WaitForChild("QuestPanel"))
local QuestTracker     = require(UI:WaitForChild("QuestTracker"))
local HudRow           = require(UI:WaitForChild("HudRow"))
local EggTreePanel     = require(UI:WaitForChild("EggTreePanel"))
local LeaderboardPanel = require(UI:WaitForChild("LeaderboardPanel"))
local ProfilePanel     = require(UI:WaitForChild("ProfilePanel"))
local DailyBonusPanel  = require(UI:WaitForChild("DailyBonusPanel"))
local Feedback         = require(UI:WaitForChild("Feedback"))
local Moment           = require(UI:WaitForChild("Moment"))
local ReturnSummary    = require(UI:WaitForChild("ReturnSummary"))
local HomeButton       = require(UI:WaitForChild("HomeButton"))
local RebirthButton    = require(UI:WaitForChild("RebirthButton"))   -- Sammel-Update 2.7
local IncubatorPanel   = require(UI:WaitForChild("IncubatorPanel"))  -- Sammel-Update 8
local CurrencyHint     = require(UI:WaitForChild("CurrencyHint"))    -- Sammel-Update 3.4

--------------------------------------------------------------------------------
-- Oberflaeche
--------------------------------------------------------------------------------

local screenGui = Instance.new("ScreenGui")
screenGui.Name             = "RBL"
screenGui.ResetOnSpawn     = false   -- ueberlebt den Tod des Charakters
screenGui.IgnoreGuiInset   = false   -- laesst Platz fuer die Roblox-Topbar
screenGui.ZIndexBehavior   = Enum.ZIndexBehavior.Sibling
screenGui.Parent           = playerGui

-- Playtest 05.10.: auf grossen Monitoren mitwachsen (siehe UI/UiScale)
UiScale.init(screenGui)

--------------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------------

-- Sprache ALLERERSTES: ab hier liefert Loc den Text in der Roblox-Sprache des
-- Spielers. Ohne das haetten Toast und alle Beschriftungen, die beim Aufbau
-- gesetzt werden, einen Moment lang die Standardsprache.
LanguageController.init()

-- Vom Server gebaute Welt-Texte (Tafeln, Schilder, Prompts) in der Sprache
-- dieses Spielers anzeigen (siehe Localization/WorldText)
require(game:GetService("ReplicatedStorage"):WaitForChild("Localization"):WaitForChild("WorldText")).startClient()

Toast.init(screenGui)
ClientState.init()

BaerchiPanel.init(screenGui)
BaerchiInventory.init(screenGui)
HatchPanel.init(screenGui)
CombatPanel.init(screenGui)
BuildingPanel.init(screenGui)
FusionPanel.init(screenGui)
-- Nach BaerchiPanel: die Detailkarte oeffnet dieses Panel ueber den
-- PanelManager, es muss dafuer angemeldet sein. Die Reihenfolge der init-Aufrufe
-- entscheidet das zwar nicht (geoeffnet wird erst per Klick), aber die Liste
-- hier soll den Aufrufweg widerspiegeln.
CharmPanel.init(screenGui)
RebirthDialog.init(screenGui)
LanguagePanel.init(screenGui)
QuestPanel.init(screenGui)
-- v14: Ei-Baum (oeffnet sich aus dem Ei-Menue)
EggTreePanel.init(screenGui)
-- v15: Bestenliste, Spieler-Profil (Inspector) und Login-Bonus. Vor MenuBar,
-- damit die Menue-Kacheln die Panels schon angemeldet vorfinden.
LeaderboardPanel.init(screenGui)
ProfilePanel.init(screenGui)
DailyBonusPanel.init(screenGui)
ShopPanel.init(screenGui)          -- HBB Paket 10 (nur mit SHOP_V1)
IncubatorPanel.init(screenGui)     -- Sammel-Update Paket 8

Hud.init(screenGui)
MenuBar.init(screenGui)

-- HBB Paket 1: fliegende Icons, grosse Momente, Rueckkehr-Karte. Nach Hud
-- und MenuBar (Ziele der Icons), vor ResultFeed (der Offline-Bericht des
-- Joins kommt sonst an, bevor die Karte bereit ist).
Feedback.init(screenGui)
Moment.init(screenGui)
ReturnSummary.init(screenGui)
-- HBB Paket 5: Heim-Knopf (erscheint nur weit weg vom eigenen Plot)
HomeButton.init(screenGui)
RebirthButton.init(screenGui)   -- Sammel-Update 2.7: fester Rebirth-Knopf
CurrencyHint.init(screenGui)    -- Sammel-Update 3.4: Waehrungs-Hinweise

-- v13: Quest-Karte links (braucht das Quest-Fenster, das oben angemeldet wird)
QuestTracker.init(screenGui)
-- HUD_ROW_V2: Zahnrad · Quests · Shop in einer Zeile (versteckt die Quest-Karte)
HudRow.init(screenGui)

-- v12: untere Pet-Leiste (Event / Fight), legt auch den PitResumeDialog an
PetBar.init(screenGui)

ResultFeed.init()
WorldController.init()
EggTimerController.init()
IncubatorController.init()   -- Sammel-Update Paket 8
AreaSignController.init()    -- Sammel-Update Paket 3.8
-- v14: Faehigkeiten-Show im PIT (unabhaengig von allem anderen)
SkillFXController.init()
-- v15: Waben im Event-Pit und Recycler (braucht Toast, ClientState und die Welt)
CombController.init(screenGui)
-- v16: Himmels-Kulisse (Wolken, Schwebeinseln, Pollen, Schaum) nur auf dem Client
AmbienceController.init()
-- Welt aufwerten: Tageslauf (Paket A) zuerst — Wasser und Hauptinsel melden
-- ihre leuchtenden Teile bei ihm an. Danach Wasser (B), Hauptinsel (C),
-- Ankunft (C) und die festen Kamerapunkte (Paket 0, nur Studio).
DayCycleController.init()
WaterController.init()
HubLandmarkController.init()
HubEventController.init()
ArrivalController.init()
-- Paket D (Plot-Inseln) vor F: die Bienen fragen nach der eigenen Insel.
PlotLifeController.init()
-- Paket G: Welt-Momente (nutzt Arena-, Insel-, Leben- und Wahrzeichen-Controller)
WorldMomentController.init()
-- Paket H: Klang-Kulisse (still, bis gepruefte Sound-IDs eingetragen sind)
SoundscapeController.init()
-- Paket I: Licht nach Zonen (nach dem Tageslauf: setzt dessen Atmosphaeren-Faktoren)
ZoneLightController.init()
ArenaLifeController.init()
LifeController.init()
WorldShotController.init()
-- v17: lebendige Events (UFO-Patrouille, Abwuerfe, Boss, Telegraphen); braucht Toast
EventFXController.init()
-- v18: Ei-Mesh der gelegten Eier (EditableMesh gibt es nur auf dem Client)
LaidEggMeshController.init()
-- HBB Paket 0: Messpunkte der Oberflaeche (Panel auf/zu, Stillstand)
UiEventLogger.init()
-- HBB Paket 2: Fuehrung ohne Text (braucht MenuBar und PetBar als Anker)
GuideController.init(screenGui)
-- HBB Paket 3: ⬆ ueber bezahlbaren eigenen Gebaeuden
UpgradeHintController.init()

print("[Client] Bereit")
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</roblox>