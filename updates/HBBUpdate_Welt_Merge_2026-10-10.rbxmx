	----------------------------------------------------------------------------
	["baerchi.RedBaerchi.name"]     = "Red Baerchi",
	["baerchi.GreenBaerchi.name"]   = "Green Baerchi",
	["baerchi.YellowBaerchi.name"]  = "Yellow Baerchi",
	["baerchi.BlueBaerchi.name"]    = "Blue Baerchi",
