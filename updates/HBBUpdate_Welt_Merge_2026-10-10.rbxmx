	["skill.BearHug.name"]                = "Bear Hug",
	["skill.Revive.name"]                 = "Revive",
	["skill.BasicPunch.desc"]             = "A simple punch. Always there.",
	["skill.SugarRush.desc"]              = "Double attack speed for 2 actions.",
	["skill.GummyShield.desc"]            = "Absorbs 50% of damage for 2 actions.",
	["skill.IceSlam.desc"]                = "1.5x damage and stuns the enemy for one action.",
	["skill.FireBite.desc"]               = "Sets the enemy on fire for 3 actions.",
	["skill.SugarStorm.desc"]             = "A sugar whirlwind hits everything around the Baerchi.",
	["skill.ShardBlast.desc"]             = "2.2x damage. Slow to charge, but devastating.",
	["skill.GoldRush.desc"]               = "Steals 25% of the enemy's HP and heals with it.",
	["skill.BlackHole.desc"]              = "Sucks everything in. The strongest AoE in the game.",
	["skill.ChromaBlast.desc"]            = "3x damage. Every colour at once.",
	["skill.TitanMode.desc"]              = "Absorbs 90% damage for 3 actions. Indestructible.",
	["skill.BigBang.desc"]                = "20% chance of an instant K.O. Otherwise 2.5x damage.",
	["skill.BearHug.desc"]                = "Heals 30% of max HP. The friendliest skill.",
	["skill.Revive.desc"]                 = "Comes back once per fight with 50% HP.",
	["skill.PhoenixRebirth.desc"]         = "Survives once per fight on 1 HP and strikes back with a burst of fire.",
	["skill.GlacierFrost.desc"]           = "Slows the enemy by 40% for 3 of its actions.",
	["skill.PhantomOmen.desc"]            = "Passive: laid eggs have a 25% chance to go up one tier.",
	["skill.SeraphGrace.desc"]            = "Heals 22% of max HP.",
	["skill.AuroraVeil.desc"]             = "+50% SPD and +30% PWR for 3 actions.",
	["skill.EclipseShroud.desc"]          = "Lowers the enemy's attack by 35% for 3 of its actions.",
	["skill.CometImpact.desc"]            = "The first impact hits for 4.5x ATK, later ones for 1.6x.",
	["skill.NebulaBurn.desc"]             = "Wraps the enemy in burning mist (4 actions).",
	["skill.PulsarPulse.desc"]            = "Every pulse hits harder than the last.",
	["skill.ShadeSlash.desc"]             = "Below 30% enemy HP the slash hits for 4x ATK.",
	["skill.RiddleBeam.desc"]             = "A beam of symbols, 2.6x damage.",
	["skill.TitanFist.desc"]              = "A fist from the sky, 3.6x damage.",
	["skill.GenesisWave.desc"]            = "Every wave builds on the last.",
	["skill.ChronosRift.desc"]            = "Tears time open, 3x damage.",
	["skill.InfinityBarrage.desc"]        = "Five hits in a row, 0.6x ATK each.",
	["skill.OmegaStrike.desc"]            = "A single strike. 7x damage.",
	["skill.BasicPunch.drawback"]         = "No upside spikes.",
	["skill.SugarRush.drawback"]          = "Deals no extra damage itself, long cooldown.",
	["skill.GummyShield.drawback"]        = "No damage, gap between shields.",
	["skill.IceSlam.drawback"]            = "Long cooldown.",
	["skill.FireBite.drawback"]           = "Damage comes later; a new burn replaces the old one.",
	["skill.SugarStorm.drawback"]         = "Long cooldown.",
	["skill.ShardBlast.drawback"]         = "Cooldown 3.",
	["skill.GoldRush.drawback"]           = "Weak against nearly beaten enemies.",
	["skill.BlackHole.drawback"]          = "Very long cooldown.",
	["skill.ChromaBlast.drawback"]        = "Cooldown 4.",
	["skill.TitanMode.drawback"]          = "No damage, very long cooldown.",
	["skill.BigBang.drawback"]            = "Down to luck, cooldown 10.",
	["skill.BearHug.drawback"]            = "No damage.",
	["skill.Revive.drawback"]             = "Only once per fight.",
	["skill.PhoenixRebirth.drawback"]     = "Only once per fight, and then he's left on 1 HP.",
	["skill.GlacierFrost.drawback"]       = "No damage.",
	["skill.PhantomOmen.drawback"]        = "No effect in fights.",
	["skill.SeraphGrace.drawback"]        = "No damage, PWR doesn't boost healing.",
	["skill.AuroraVeil.drawback"]         = "Costs 8% of max HP.",
	["skill.EclipseShroud.drawback"]      = "No damage.",
	["skill.CometImpact.drawback"]        = "Only the first use is strong.",
	["skill.NebulaBurn.drawback"]         = "The damage is delayed.",
	["skill.PulsarPulse.drawback"]        = "Weak start.",
	["skill.ShadeSlash.drawback"]         = "Only average against healthy enemies.",
	["skill.RiddleBeam.drawback"]         = "Cooldown 4.",
	["skill.TitanFist.drawback"]          = "Cooldown 6.",
	["skill.GenesisWave.drawback"]        = "Needs long fights.",
	["skill.ChronosRift.drawback"]        = "Cooldown 5.",
	["skill.InfinityBarrage.drawback"]    = "Cooldown 5.",
	["skill.OmegaStrike.drawback"]        = "Cooldown 9 — only normal hits in between.",
