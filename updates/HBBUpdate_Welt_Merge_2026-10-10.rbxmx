<Item class="ModuleScript" referent="RBX4"><Properties>
<string name="Name">AmbienceConfig</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- AmbienceConfig.luau
-- ReplicatedStorage/Config/AmbienceConfig.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Zahlen fuer Himmel, Licht-Stimmung, Landschafts-Deko und die
--     Client-Atmosphaere (Wolken, Pollen, Schaum)
--
-- Reine Optik, keine Spielbalance. Gelesen von SkyBuilder und ScenicBuilder
-- (Server, einmal beim Start) und AmbienceController (Client, laufend).
-- Die Performance-Regler stehen unten: "QUALITAET".

local AmbienceConfig = {}

--------------------------------------------------------------------------------
-- HIMMEL UND LICHT ("goldene Stunde")
--------------------------------------------------------------------------------
-- Die Atmosphaere macht den Himmel: tiefblau oben, rosa-goldener Horizont.
-- Das kostet keine einzige Part und keine Textur.
AmbienceConfig.CLOCK_TIME        = 16.9    -- spaeter Nachmittag, lange weiche Schatten

-- Welt aufwerten, Paket A: langsamer Tageslauf NUR auf dem Client
-- (DayCycleController, Zahlen in WorldFXConfig.DAY). Pendelt zwischen
-- goldenem Nachmittag und blauer Stunde, nie Nacht. Aus = fester Himmel wie
-- bisher (CLOCK_TIME). Der feste Himmel unten bleibt der Startwert, den der
-- Server setzt; 16,9 Uhr ist ein Punkt im Zyklus (Test day_cycle.test.lua).
AmbienceConfig.DAY_CYCLE         = true
AmbienceConfig.BRIGHTNESS        = 2.4
AmbienceConfig.AMBIENT           = Color3.fromRGB(120, 118, 150)
AmbienceConfig.OUTDOOR_AMBIENT   = Color3.fromRGB(150, 150, 185)
AmbienceConfig.COLOR_SHIFT_TOP   = Color3.fromRGB(255, 225, 190)
AmbienceConfig.DIFFUSE_SCALE     = 0.6
AmbienceConfig.SPECULAR_SCALE    = 0.5
AmbienceConfig.SHADOW_SOFTNESS   = 0.25
AmbienceConfig.GEO_LATITUDE      = 20

AmbienceConfig.ATMOSPHERE_DENSITY = 0.30
AmbienceConfig.ATMOSPHERE_OFFSET  = 0.25
AmbienceConfig.ATMOSPHERE_COLOR   = Color3.fromRGB(255, 200, 200)
AmbienceConfig.ATMOSPHERE_DECAY   = Color3.fromRGB(255, 140, 120)
AmbienceConfig.ATMOSPHERE_GLARE   = 0.5
AmbienceConfig.ATMOSPHERE_HAZE    = 1.6

AmbienceConfig.STAR_COUNT         = 2500
AmbienceConfig.SUN_SIZE           = 18
AmbienceConfig.MOON_SIZE          = 10

-- Echte Wolken (Terrain-Clouds): eine Zeile Instanz, GPU-seitig, praktisch gratis.
AmbienceConfig.CLOUDS_COVER   = 0.6
AmbienceConfig.CLOUDS_DENSITY = 0.65
AmbienceConfig.CLOUDS_COLOR   = Color3.fromRGB(255, 235, 235)

--------------------------------------------------------------------------------
-- MEERESBODEN UND SCHAUM (Server, je 1 Part pro Insel)
--------------------------------------------------------------------------------
-- Ohne Boden schaut man durch das Wasser ins Nichts. Der Boden liegt knapp
-- unter der Wasserunterkante und laesst das Wasser tuerkis tief wirken.
AmbienceConfig.SEABED_Y       = -13.2
AmbienceConfig.SEABED_COLOR   = Color3.fromRGB(52, 150, 168)
AmbienceConfig.SEABED_RADIUS  = 720

-- Schaumsaum: eine weisse, flache Scheibe je Insel, die ueber den Sand hinaus
-- ragt. Der Client laesst die Durchsichtigkeit leise atmen.
AmbienceConfig.FOAM_REACH         = 3.5    -- wie weit der Schaum ueber die Sandkante hinausreicht
AmbienceConfig.FOAM_COLOR         = Color3.fromRGB(255, 255, 255)
AmbienceConfig.FOAM_TRANSPARENCY  = 0.55
AmbienceConfig.FOAM_PULSE         = 0.2    -- +/- Schwankung
AmbienceConfig.FOAM_PULSE_PERIOD  = 4.5    -- Sekunden

--------------------------------------------------------------------------------
-- LANDSCHAFT (Server, einmal beim Start, deterministisch)
--------------------------------------------------------------------------------
AmbienceConfig.SCENERY_SEED = 20261004

-- Hauptinsel: Baeume, Buesche, Felsen, Pilze. Zwischen Event-Pit und Inselrand.
AmbienceConfig.TREE_COUNT     = 22
AmbienceConfig.BUSH_COUNT     = 26
AmbienceConfig.ROCK_COUNT     = 16
AmbienceConfig.MUSHROOM_COUNT = 12
AmbienceConfig.SCENERY_INNER  = 64      -- Abstand zur Mitte, ab dem Deko erlaubt ist (Pit = 50 + Ring)
AmbienceConfig.SCENERY_OUTER  = 108     -- bis hier (Insel = 120, Sandkante, Handler bei 108)
AmbienceConfig.LANE_MARGIN    = 9       -- Abstand zur Wegachse, den Deko freihaelt
AmbienceConfig.MERCHANT_CLEAR = 16      -- Freiraum um den versteckten Ei-Haendler

AmbienceConfig.TREE_TRUNK_COLOR   = Color3.fromRGB(122, 84, 52)
AmbienceConfig.TREE_CANOPY_COLORS = {
	Color3.fromRGB( 72, 170,  80),
	Color3.fromRGB( 96, 190,  92),
	Color3.fromRGB(255, 160, 190),   -- Bluetenbaum
}
AmbienceConfig.BUSH_COLORS = {
	Color3.fromRGB(64, 156, 72),
	Color3.fromRGB(84, 176, 84),
	Color3.fromRGB(110, 190, 90),
}
AmbienceConfig.ROCK_COLORS = {
	Color3.fromRGB(150, 150, 162),
	Color3.fromRGB(132, 132, 148),
}

-- Wege: helle Pflasterbahn von der Event-Pit-Kante bis zum Steg, acht Stueck.
-- Sie zeigen den Weg (wie die blumenfreien Gassen) und brechen das Gruen auf.
AmbienceConfig.PATH_WIDTH     = 10
AmbienceConfig.PATH_COLOR     = Color3.fromRGB(222, 196, 146)
AmbienceConfig.PATH_LIFT      = 0.14   -- ueber der Wiese (Karo liegt bei 0.08)

-- Laternen entlang der Wege (Pfosten + leuchtende Kugel, ohne PointLight).
AmbienceConfig.LAMP_RADII     = { 72, 100 }
AmbienceConfig.LAMP_SIDE      = 7.5
AmbienceConfig.LAMP_HEIGHT    = 6
AmbienceConfig.LAMP_POLE_COLOR = Color3.fromRGB(110, 76, 48)
AmbienceConfig.LAMP_GLOW_COLOR = Color3.fromRGB(255, 205, 110)

-- Stegpfosten: vier je Steg (an beiden Enden, beide Seiten) mit Leuchtkappe.
AmbienceConfig.BRIDGE_POST_HEIGHT = 4.6
AmbienceConfig.BRIDGE_POST_INSET  = 3

-- Plot-Inseln: Felsen und Schilf am Rand. Haelt die Stegachse frei.
AmbienceConfig.PLOT_RIM_COUNT   = 9
AmbienceConfig.PLOT_RIM_MIN     = 55
AmbienceConfig.PLOT_RIM_MAX     = 57
AmbienceConfig.PLOT_RIM_LANE    = 10    -- Halbbreite der freien Stegachse

--------------------------------------------------------------------------------
-- CLIENT-ATMOSPHAERE
--------------------------------------------------------------------------------
-- Wolkenpuffs und ferne Schwebeinseln: laufen nur beim Spieler, kosten den
-- Server nichts und werden nicht repliziert.
AmbienceConfig.CLOUD_PUFFS_HIGH   = 18
AmbienceConfig.CLOUD_PUFFS_LOW    = 8
AmbienceConfig.CLOUD_RING_MIN     = 750
AmbienceConfig.CLOUD_RING_MAX     = 1250
AmbienceConfig.CLOUD_HEIGHT_MIN   = 110
AmbienceConfig.CLOUD_HEIGHT_MAX   = 300
AmbienceConfig.CLOUD_COLOR        = Color3.fromRGB(255, 232, 236)
AmbienceConfig.CLOUD_DRIFT_SPEED  = 0.0035   -- Radiant pro Sekunde (eine Runde ~ 30 Minuten)

AmbienceConfig.FAR_ISLANDS_HIGH   = 5
AmbienceConfig.FAR_ISLANDS_LOW    = 2
AmbienceConfig.FAR_ISLAND_RING    = 1050
AmbienceConfig.FAR_ISLAND_HEIGHT  = 140

-- Pollen / Glitzer, der um die Kamera schwebt (ein ParticleEmitter).
AmbienceConfig.POLLEN_RATE        = 7
AmbienceConfig.POLLEN_COLOR       = Color3.fromRGB(255, 226, 140)

--------------------------------------------------------------------------------
-- QUALITAET
--------------------------------------------------------------------------------
-- Ab dieser Roblox-Grafikstufe (1..10) laeuft die "hohe" Variante. Darunter
-- (schwache Handys) gibt es weniger Wolken und keine Partikel. Auto-Qualitaet
-- (Stufe 0) zaehlt als hoch.
AmbienceConfig.HIGH_QUALITY_FROM  = 4

return AmbienceConfig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX5"><Properties>
<string name="Name">FeatureFlags</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- FeatureFlags.luau
-- ReplicatedStorage/Config/FeatureFlags.luau
--
-- Einzige Zustaendigkeit:
--   - Schalter fuer jede sichtbare Aenderung aus dem Honey-Bear-Brawl-Plan
--
-- Jede neue Anzeige haengt an genau einem Schalter. `true` = neuer Weg,
-- `false` = das Spiel verhaelt sich wie vor dem jeweiligen Paket. So bleibt
-- jede Aenderung einzeln zuruecknehmbar, ohne Code anzufassen.
--
-- Liegt in ReplicatedStorage, weil Server UND Client dieselbe Antwort brauchen
-- (z.B. Boss-Stufen: Server zahlt aus, Client zeigt die Truhe).
--
-- Ein unbekannter Name ist ein Tippfehler. In Studio bricht isOn dann mit
-- einem Fehler ab, damit er sofort auffaellt; im Live-Spiel gilt der Schalter
-- still als aus, damit ein Tippfehler keinen Server abstuerzen laesst.

local RunService = game:GetService("RunService")

local FLAGS: { [string]: boolean } = {
	-- Paket 1: Icons und Zahlen statt Text-Toasts
	UI_V2_FEEDBACK    = true,
	-- Paket 2: Beam-Fuehrung, Quest-Tracker mit Icons, ruhige Dialoge
	UI_V2_GUIDE       = true,
	-- Paket 3: Elemente erscheinen erst, wenn man sie braucht
	UI_V2_PROGRESSIVE = true,
	-- Paket 4: Upgrade-Tab, Kampfwert-Zahl, Rarity-Baender
	UI_V2_UPGRADE_TAB = true,

	-- Paket 5: Map ohne Umbau
	MAP_V2_MERCHANT   = true,
	MAP_V2_HOME       = true,
	MAP_V2_SHOWCASE   = true,
	MAP_V2_BOARDS     = true,
	MAP_V2_ARENA_SPRINT = true,   -- Baerchi sprintet zur Arena und zurueck
	-- Paket 6
	MAP_V2_LIVE_BOARD = true,
	MAP_V2_WASP_NEST  = true,
	EVENT_V2_TIMER    = true,

	-- Honig-Teich statt Stock + Veredler: EIN Gebaeude, Looks bis zum
	-- Honig-Springbrunnen, Baerchi wohnt am Becken (kein Hin- und Herlaufen).
	-- Bericht: docs/HBB_HONIG_TEICH_2026-10-05.md
	HONEY_POND_V2      = true,

	-- Entscheidung 05.10.: Laeufe starten immer bei Stage 1. Ab der letzten
	-- Stage nur per Klick gegen Gummies (kleines Feld, 7 s, UI/FightStartPrompt).
	FIGHT_RESUME_PROMPT = true,

	-- HBB Paket 10: Shop mit Gratis-Griff (GoldGummies) und Robux-Paketen
	-- (Pakete erst sichtbar, wenn ShopConfig eine Product-ID hat).
	-- Bericht: docs/HBB_PAKET_10_SHOP_2026-10-05.md
	SHOP_V1            = true,

	-- Playtest 05.10.: Basis-Eier (unbegrenzt beim Haendler) nicht pressbar
	PRESS_NO_BASIC_EGG = true,

	-- Paket 7: Boss-Belohnung nach Stufen
	BOSS_TIERS        = true,

	-- GoldGummies nur noch aus Tages-Quests (spaeter: Gratis-Griff im Shop)
	-- und nur noch fuer Charms. Keine Gold-Kosten bei Gebaeuden/Recycler, kein
	-- Gold aus Tower-Laeufen, Meilensteinen oder Login-Bonus.
	-- Bericht: docs/HBB_GOLD_NUR_CHARMS_2026-10-05.md
	GOLD_CHARMS_ONLY  = true,

	-- Paket 8/9: neue Pacing-Werte. Bleibt aus, bis der Mensch die Tabelle
	-- freigegeben hat (Stopp-Punkt im Plan).
	PACING_V2         = false,
	-- Paket 9: Endless-Tower (Stage 101+), freigegeben 05.10.
	-- Bericht: docs/HBB_PAKET_9_ENDLESS_2026-10-05.md
	ENDLESS           = true,

	-- Sammel-Update 05.10. (docs/SAMMEL_UPDATE_UMGESETZT_2026-10-05.md):
	-- Paket 8: Inkubator auf dem Plot. Aus = Eier gehen wie vorher sofort auf,
	-- der Inkubator wird weder gebaut noch angeboten.
	INCUBATOR         = true,
	-- Paket 7: Index-Belohnungen (Abholen im Index).
	INDEX_REWARDS     = true,
	-- Paket 5.2: Kampf um die Mitte — gegnerische Event-Baerchis stossen
	-- Spieler ohne eigenen Baerchi im Event-Pit.
	PIT_BRAWL         = true,
	-- Paket 3.8: Bereichs-Schilder (zwei Woerter) auf der Hauptinsel.
	AREA_SIGNS        = true,
	-- Wunsch 05.10.: Baerchi darf mehrmals ins selbe UFO; nach dem Absetzen
	-- ist sein Level fuer EventConfig.UFO.DROP_WEAKEN_SECONDS halbiert.
	-- Aus = wie vorher (wer schon an Bord war, geht heim).
	UFO_REJOIN        = true,
	-- Wunsch 05.10.: aufgeraeumtes HUD. Honig-Brunnen nur vor Ort verbessern
	-- (E, kein Fenster, Schild mit Level und Preis), keine Kacheln "Verbessern"
	-- und "Inkubator" mehr, Quests als kleiner Knopf neben dem Zahnrad, Shop
	-- daneben (eine Zeile), groessere Kacheln rechts.
	HUD_ROW_V2        = true,
	-- Wunsch 05.10.: Inkubator = Baerchi hineinsetzen, er bruetet je nach
	-- Rarity im Takt zusaetzliche Eier (IncubatorConfig.BREED_*). Eier gehen
	-- wieder sofort auf (kein Brueten von Eiern mehr). Aus = Ei-Inkubator wie
	-- im Sammel-Update.
	INCUBATOR_BREED   = true,
	-- Welt aufwerten (08.10.2026), je Paket ein Schalter. Reine Client-Optik.
	-- Paket A (Tageslauf) haengt am Schalter AmbienceConfig.DAY_CYCLE.
	-- Bericht: claude/WELT_AUFGEWERTET_UMGESETZT_2026-10-09.md
	WORLD_B_WATER     = true,   -- Glitzern, Schaum, Arena-Kueste, Fisch, Bojen
	WORLD_C_HUB       = true,   -- Mastkrone, Honigfaden, Ankunft, Wegweiser, Pit-Rahmen, Haendler, Nest, Tafeln
	WORLD_D_PLOTS     = true,   -- Insel-Stufen, Teich-Glanz/Ueberlauf, eigene Insel, leere Inseln
	WORLD_E_ARENA     = true,   -- Steg-Laternen, Torbogen, Zuschauer, Flagge am Schau-Turm
	WORLD_F_LIFE      = true,   -- Bienen, Schmetterlinge, Blumen im Wind, Pollenfarbe, Pfotenabdruecke
	WORLD_G_MOMENTS   = true,   -- Welt-Momente: Lichtsaeule, Feuerwerk, Welle, Spirale, Event-Glocke
	WORLD_H_SOUND     = true,   -- Klang-Kulisse nach Zonen (laeuft nur mit gepruefter Sound-ID)
	WORLD_I_ZONES     = true,   -- Licht-Feinschliff nach Zonen (Insel / Arena / Turm)
}

local FeatureFlags = {}

FeatureFlags.FLAGS = FLAGS

function FeatureFlags.isOn(name: string): boolean
	local value = FLAGS[name]
	if value == nil then
		if RunService:IsStudio() then
			error("[FeatureFlags] Unbekannter Schalter: " .. tostring(name), 2)
		end
		return false
	end
	return value
end

return FeatureFlags
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX6"><Properties>
<string name="Name">WorldFXConfig</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldFXConfig.luau
-- ReplicatedStorage/Config/WorldFXConfig.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Optik-Zahlen fuer "Welt aufwerten" (Auftrag 08.10.2026): Tageslauf,
--     Wasser und Kueste, Hauptinsel, Texturen, Qualitaetsstufen, feste
--     Kamerapunkte fuer Screenshots
--
-- Reine Optik, keine Spielbalance. Gelesen von Modules/DayCycle und den
-- Client-Controllern DayCycleController, WaterController, HubController und
-- WorldShotController. Nichts davon laeuft auf dem Server (ausser der
-- Debug-Befehl, der nur Attribute setzt).
--
-- Warum nicht AmbienceConfig: die bleibt fuer den festen Himmel und die
-- Server-Landschaft (SkyBuilder/ScenicBuilder). Der Hauptschalter DAY_CYCLE
-- steht trotzdem dort, weil er den festen Himmel abloest.
-- Warum nicht MapConfig: die steht bei 191 von 200 lokalen Namen.

local WorldFXConfig = {}

--------------------------------------------------------------------------------
-- TEXTUREN
--------------------------------------------------------------------------------
-- Gezeichnet von tools/textures/make_world_textures.py, abgelegt unter
-- assets/world/<paket>/. Hochladen: Studio → Asset Manager → Bulk Import (Typ
-- Image), dann die ID hier eintragen ("rbxassetid://123").
--
-- Leerer String = noch nicht hochgeladen: dann gilt FALLBACK (eine eingebaute
-- Roblox-Textur) oder der Aufrufer laesst das Bild ganz weg und zeigt nur
-- Farbe/Neon. Alles laeuft also auch ohne Upload.
WorldFXConfig.TEXTURE_IDS = {
	-- Paket A
	cloud_puff_flipbook = "",
	firefly             = "",
	star_twinkle        = "",
	-- Paket B
	water_glitter       = "",
	water_waves         = "",
	foam_lace           = "",
	splash_flipbook     = "",
	water_ring          = "",
	-- Paket C
	amber_comb          = "",
	honey_drop          = "",
	honey_bubble        = "",
	bee_flipbook        = "",
	wasp_flipbook       = "",
	pennant_fabric      = "",
	stall_stripes       = "",
	bear_sign           = "",
	shine_strip         = "",
	-- Paket E–F (D braucht keine: Blumen, Pilze, Bienenhaus sind Formen)
	flag_fabric         = "",
	paw_print           = "",
} :: { [string]: string }

-- Eingebaute Roblox-Texturen als Rueckfall fuer Partikel. Was hier fehlt, hat
-- keinen Bild-Rueckfall (der Aufrufer zeigt dann nur Farbe).
WorldFXConfig.TEXTURE_FALLBACK = {
	firefly         = "rbxasset://textures/particles/sparkles_main.dds",
	star_twinkle    = "rbxasset://textures/particles/sparkles_main.dds",
	splash_flipbook = "rbxasset://textures/particles/smoke_main.dds",
	honey_bubble    = "rbxasset://textures/particles/sparkles_main.dds",
} :: { [string]: string }

-- Ob die Textur ein Flipbook (2x2) ist. Nur dann setzt der Aufrufer das
-- Layout; mit dem Rueckfall-Bild bleibt es ein Einzelbild.
WorldFXConfig.FLIPBOOKS = {
	cloud_puff_flipbook = true,
	splash_flipbook     = true,
	bee_flipbook        = true,
	wasp_flipbook       = true,
} :: { [string]: boolean }

--------------------------------------------------------------------------------
-- QUALITAET
--------------------------------------------------------------------------------
-- Ab welcher Stufe eine Funktion laeuft. Stufe 0 = niedrig (schwaches Handy,
-- Grafikstufe unter AmbienceConfig.HIGH_QUALITY_FROM), Stufe 1 = hoch.
-- Grundstimmung (Tageslauf, Licht, Wasser-Glitzern) laeuft immer; Beiwerk
-- faellt auf niedriger Stufe weg. Diese Tabelle ist zugleich die Liste fuer
-- den Bericht (Paket J).
WorldFXConfig.MIN_QUALITY = {
	dayCycle      = 0,   -- A: Uhrzeit, Licht, Atmosphaere, Bloom, Farbe
	lampGlow      = 0,   -- A: Laternen/Tropfen leuchten in der blauen Stunde
	fireflies     = 1,   -- A: Gluehwuermchen ueber dem Wasser
	stars         = 1,   -- A: funkelnde Sterne in der blauen Stunde
	cloudWisps    = 1,   -- A: weiche Wolkenschleier mit rosa Rand
	waterGlitter  = 0,   -- B: Glitzer-Textur auf dem Wasser
	waterWaves    = 1,   -- B: zweites Wellenmuster
	foamTexture   = 0,   -- B: Schaum-Textur auf den Saeumen
	arenaCoast    = 0,   -- B: Schaum + Pfosten an Arena-Insel und aeusserem Steg
	fish          = 1,   -- B: springender Honig-Fisch
	buoys         = 0,   -- B: Bonbon-Bojen (niedrig: halb so viele)
	mastCrown     = 0,   -- C: Wabenkrone am Honigmast
	honeyThread   = 1,   -- C: Honigfaden, Tropfen, Ringe in der Schale
	arrival       = 0,   -- C: Ankunft (Blasen + Bienen), einmal pro Server
	signposts     = 0,   -- C: Wegweiser
	pitFrame      = 0,   -- C: Wimpelkette und Lichter am Event-Pit
	pitFlutter    = 1,   -- C: Wimpel flattern (niedrig: haengen still)
	stallDecor    = 0,   -- C: Laterne und Eierkorb am Haendler
	waspSwarm     = 1,   -- C: kreisende Wespen am Nest
	waspPulse     = 0,   -- C: Nest pulsiert vor/waehrend des Boss
	boardFrames   = 0,   -- C: Holzrahmen + Krone an den Tafeln
	boardShine    = 1,   -- C: Glanzstreifen auf Platz 1
	islandDecor   = 0,   -- D: Insel-Stufen (Blumen, Pilze, Bienenhaus, Bernstein)
	pondShine     = 1,   -- D: Glanz auf dem Honig, Tropfen ueber den Rand
	homeGlow      = 0,   -- D: warmer Schimmer ueber der eigenen Insel
	freeIsland    = 0,   -- D: Schild "Frei", Blumen, Schmetterling auf leeren Inseln
	bridgeLamps   = 0,   -- E: Laternen am Steg zur Arena (Welle beim Lauf)
	arenaArch     = 0,   -- E: Torbogen an der Arena
	spectators    = 1,   -- E: Zuschauer-Baerchis auf dem Zaun
	showcaseFlag  = 0,   -- E: Flagge auf dem Schau-Turm (weht nur ab Stufe 1)
	bees          = 1,   -- F: Bienenschwaerme
	butterflies   = 1,   -- F: Schmetterlinge
	flowerSway    = 1,   -- F: Blumen nicken im Wind, weichen dem Spieler aus
	pollenTint    = 0,   -- F: Pollenfarbe folgt dem Tageslauf
	footprints    = 1,   -- F: Pfotenabdruecke im Sand
	moments       = 0,   -- G: Welt-Momente (Saeule, Feuerwerk, Welle, Spirale)
	momentRing    = 1,   -- G: Funkenring ab Cosmic (niedrig: nur Saeule)
	eventBell     = 0,   -- G: Event-Start am Honigmast (Krone blinkt, Bienen ziehen los)
	soundscape    = 0,   -- H: Klang-Kulisse (still ohne gepruefte IDs)
	zoneLight     = 0,   -- I: Kontrast/Saettigung in der Arena, klare Luft hoch oben
}

--------------------------------------------------------------------------------
-- PAKET A: TAGESLAUF
--------------------------------------------------------------------------------
-- Die Uhr pendelt weich (Kosinus) zwischen CLOCK_MIN und CLOCK_MAX und wieder
-- zurueck, ein voller Hin- und Rueckweg dauert PERIOD Sekunden. Gerechnet aus
-- workspace:GetServerTimeNow(): alle Spieler eines Servers sehen dieselbe
-- Tageszeit, und es gibt nie einen Sprung (Kosinus ist ueberall glatt).
WorldFXConfig.DAY = {
	PERIOD      = 20 * 60,
	CLOCK_MIN   = 14.5,    -- goldener Nachmittag
	CLOCK_MAX   = 19.0,    -- blaue Stunde (nie richtige Nacht)
	TICK        = 0.2,     -- so oft wird Lighting nachgefuehrt (Sekunden)
	RETURN_SECONDS = 2.0,  -- weicher Rueckweg nach einer Faehigkeiten-Show
}

-- Kurven ueber "Daemmerung" d = 0 (14,5 Uhr) .. 1 (19 Uhr). Jede Kurve ist
-- eine Liste {d, Wert}, aufsteigend; dazwischen wird weich (smoothstep)
-- interpoliert. Bei d = 0.5333 (= 16,9 Uhr, der bisherige feste Himmel)
-- stehen genau die alten Werte aus AmbienceConfig/MapConfig — der Test
-- day_cycle.test.lua prueft das, damit der bekannte Look Teil des Zyklus bleibt.
local BASE = 2.4 / 4.5   -- 16,9 Uhr

WorldFXConfig.DAY_BASE_D = BASE

WorldFXConfig.DAY_CURVES = {
	-- Lighting
	brightness = { { 0, 2.6 }, { BASE, 2.4 }, { 0.8, 2.1 }, { 1, 1.7 } },
	ambient = {
		{ 0, Color3.fromRGB(126, 122, 146) }, { BASE, Color3.fromRGB(120, 118, 150) },
		{ 1, Color3.fromRGB(112, 116, 168) },
	},
	-- Aussenlicht bleibt in der blauen Stunde HELL (nur blauer): Eier, Waben
	-- und Prompts muessen so gut lesbar sein wie am Nachmittag.
	outdoorAmbient = {
		{ 0, Color3.fromRGB(158, 156, 176) }, { BASE, Color3.fromRGB(150, 150, 185) },
		{ 0.8, Color3.fromRGB(162, 146, 182) }, { 1, Color3.fromRGB(150, 160, 214) },
	},
