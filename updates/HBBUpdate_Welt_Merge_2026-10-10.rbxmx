	["ui.world.owner_badge"]      = "◆ {tower} · {record}",
	["ui.merchant.buy"]           = "Comprar {egg} ({n} Gummies)",
	["ui.merchant.stand"]         = "Puesto de huevos",
	["err.merchant_too_far"]      = "Demasiado lejos del vendedor",
