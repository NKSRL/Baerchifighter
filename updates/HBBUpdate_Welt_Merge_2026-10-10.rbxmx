	["ui.fusion.preview_detail"]         = "Niveau {level}  —  bonus de stats +{bonus} %\nLa rareté reste la même. Stats de base et niveaux : le meilleur des deux pour chaque stat.\nPromotion et charms repartent de zéro.",
	["ui.fusion.empty"]                  = "vide",
