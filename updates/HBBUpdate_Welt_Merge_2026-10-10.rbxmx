	["ui.world.honey_stock"]      = "Miel {n} / {max}",
	["ui.world.combs_queued"]     = "Rayons : {n}",
	["ui.world.gummies_per_comb"] = "{n} Gummies par rayon",
	["ui.world.showcase_title"]   = "{name}  ·  {tower}  ·  {record}",
	["ui.world.owner_badge"]      = "◆ {tower} · {record}",
	["ui.merchant.buy"]           = "Acheter {egg} ({n} Gummies)",
	["ui.merchant.stand"]         = "Stand d'oeufs",
