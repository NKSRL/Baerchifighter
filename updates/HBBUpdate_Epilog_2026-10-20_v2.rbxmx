-- fr.luau
-- ReplicatedStorage/Localization/Strings/fr.luau
--
-- Français. Mêmes clés et mêmes {placeholders} que de.luau — voir l'en-tête
-- de ce fichier pour les conventions. Les termes du jeu ("Baerchi", "Gummies",
-- "Honey Crystals", "PIT", "Rebirth") restent identiques dans toutes les langues.
-- Pas de "œ" : la police du jeu ne le garantit pas, on écrit "oe".

return {
	----------------------------------------------------------------------------
	-- Langue
	----------------------------------------------------------------------------
	["ui.language.title"] = "Langue",
	["ui.language.auto"]  = "Automatique (Roblox)",
	["ui.settings.title"] = "Paramètres",
	["ui.audio.section"] = "Son",
	["ui.audio.music"] = "Musique",
	["ui.audio.sfx"] = "Effets",
	["ui.audio.mute"] = "Muet",

	----------------------------------------------------------------------------
	-- Temps
	----------------------------------------------------------------------------
	["time.s"]  = "{s} s",
	["time.ms"] = "{m} min {s} s",
	["time.hm"] = "{h} h {m} min",

	----------------------------------------------------------------------------
	-- Barre de menu
	----------------------------------------------------------------------------
	["ui.menu.eggs"]    = "Oeufs",
	["ui.menu.baerchis"] = "Baerchis",
	["ui.menu.fight"]   = "Combat",
	["ui.menu.arena"]   = "Arène",

	----------------------------------------------------------------------------
	-- Rebirth
	----------------------------------------------------------------------------
	["ui.rebirth.title"]   = "Rebirth",
	["ui.rebirth.status"]  = "Rebirth {count}  —  Multiplicateur x{mult:d2}",
	["ui.rebirth.cost"]    = "Coûte {cost} Paw Coins  (tu as {have})",
	["ui.rebirth.loss"]    = "Perdu : tous les niveaux des bâtiments, les niveaux de tes Baerchis et tes Paw Coins (retour à {start}) — dépense-les avant !\nConservé : tes Baerchis, tous les œufs (incubateur compris), les améliorations de l'incubateur, l'arbre des œufs, les records de tour, les Honey Crystals, le rang et les stats.",
	["ui.rebirth.reward"]  = "Ensuite : Multiplicateur x{mult:d2}",
	["ui.rebirth.reward_eggs.one"]   = "Ensuite : Multiplicateur x{mult:d2}  —  +{n} Oeuf d'Ascension",
	["ui.rebirth.reward_eggs.other"] = "Ensuite : Multiplicateur x{mult:d2}  —  +{n} Oeufs d'Ascension",
	["ui.rebirth.cancel"]  = "Annuler",
	["ui.rebirth.confirm"] = "Rebirth !",

	----------------------------------------------------------------------------
	-- Messages (toasts)
	----------------------------------------------------------------------------
	["msg.recycled"]       = "Recyclé : +{gummies} Paw Coins",
	["msg.recycled_gold"]  = "Recyclé : +{gummies} Paw Coins  et  +{gold} Honey Crystals",
	["msg.offline_honey"]  = "Pendant ton absence ({time}) : +{honey} miel",
