	["skill.BearHug.name"]                = "Abrazo de oso",
	["skill.Revive.name"]                 = "Resurrección",
	["skill.BasicPunch.desc"]             = "Un golpe sencillo. Siempre ahí.",
	["skill.SugarRush.desc"]              = "Doble velocidad de ataque durante 2 acciones.",
	["skill.GummyShield.desc"]            = "Absorbe el 50 % del daño durante 2 acciones.",
	["skill.IceSlam.desc"]                = "1.5x de daño y aturde al enemigo durante una acción.",
	["skill.FireBite.desc"]               = "Prende fuego al enemigo durante 3 acciones.",
	["skill.SugarStorm.desc"]             = "Un torbellino de azúcar golpea todo alrededor del Baerchi.",
	["skill.ShardBlast.desc"]             = "2.2x de daño. Lento de cargar, pero devastador.",
	["skill.GoldRush.desc"]               = "Roba el 25 % de los HP enemigos y se cura con ellos.",
	["skill.BlackHole.desc"]              = "Lo absorbe todo. El AoE más fuerte del juego.",
	["skill.ChromaBlast.desc"]            = "3x de daño. Todos los colores a la vez.",
	["skill.TitanMode.desc"]              = "Absorbe el 90 % del daño durante 3 acciones. Indestructible.",
	["skill.BigBang.desc"]                = "20 % de probabilidad de K.O. inmediato. Si no, 2.5x de daño.",
	["skill.BearHug.desc"]                = "Cura el 30 % de los HP máximos. La habilidad más amable.",
	["skill.Revive.desc"]                 = "Vuelve una vez por combate con el 50 % de HP.",
	["skill.PhoenixRebirth.desc"]         = "Sobrevive una vez por combate con 1 HP y contraataca con una llamarada.",
	["skill.GlacierFrost.desc"]           = "Ralentiza al enemigo un 40 % durante 3 de sus acciones.",
	["skill.PhantomOmen.desc"]            = "Pasiva: los huevos puestos tienen un 25 % de probabilidad de subir un nivel.",
	["skill.SeraphGrace.desc"]            = "Cura el 22 % de los HP máximos.",
	["skill.AuroraVeil.desc"]             = "+50 % SPD y +30 % PWR durante 3 acciones.",
	["skill.EclipseShroud.desc"]          = "Reduce el ataque enemigo un 35 % durante 3 de sus acciones.",
	["skill.CometImpact.desc"]            = "El primer impacto golpea con 4.5x ATK, los siguientes con 1.6x.",
	["skill.NebulaBurn.desc"]             = "Envuelve al enemigo en niebla ardiente (4 acciones).",
	["skill.PulsarPulse.desc"]            = "Cada pulso golpea más fuerte que el anterior.",
	["skill.ShadeSlash.desc"]             = "Con menos del 30 % de HP enemigo, el tajo golpea con 4x ATK.",
	["skill.RiddleBeam.desc"]             = "Un rayo de símbolos, 2.6x de daño.",
	["skill.TitanFist.desc"]              = "Un puño caído del cielo, 3.6x de daño.",
	["skill.GenesisWave.desc"]            = "Cada ola se suma a la anterior.",
	["skill.ChronosRift.desc"]            = "Rasga el tiempo, 3x de daño.",
	["skill.InfinityBarrage.desc"]        = "Cinco golpes seguidos, 0.6x ATK cada uno.",
	["skill.OmegaStrike.desc"]            = "Un solo golpe. 7x de daño.",
	["skill.BasicPunch.drawback"]         = "Sin picos de poder.",
	["skill.SugarRush.drawback"]          = "No hace daño extra por sí mismo, cooldown largo.",
	["skill.GummyShield.drawback"]        = "Sin daño, hueco entre escudos.",
	["skill.IceSlam.drawback"]            = "Cooldown largo.",
	["skill.FireBite.drawback"]           = "El daño llega después; una nueva quemadura sustituye a la anterior.",
	["skill.SugarStorm.drawback"]         = "Cooldown largo.",
