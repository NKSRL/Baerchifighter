-- Befoerdern. Legt die noetigen Duplikate NICHT selbst an — wer testen will,
-- ruft vorher mehrfach "add <configId>" auf. Genau so merkt man, ob die
-- Material-Pruefung tut, was sie soll.
commands.promote = function(player, _data, uid: any)
	PromotionService.promote(player, tostring(uid))
	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Charms wuerfeln. Kostet echte GoldGummies — vorher "give 0 100000".
commands.roll = function(player, _data, uid: any, times: any)
	CharmService.rollCharms(player, tostring(uid), tonumber(times) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Alle acht Slots eines Baerchis im Klartext.
commands.charms = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local bySlot: { [number]: any } = {}
	for _, charm in baerchi.charms or {} do
		bySlot[charm.slot] = charm
	end

	local out = {}
	for slot = 1, CharmConfig.SLOT_COUNT do
		local charm = bySlot[slot]
		out[slot] = {
			slot     = CharmConfig.SLOT_NUMERALS[slot],
			offen    = CharmConfig.isSlotUnlocked(slot, baerchi.promotionLevel or 0),
			abPromo  = CharmConfig.getUnlockPromotion(slot),
			rarity   = if charm then charm.rarity else nil,
			effekt   = if charm then CharmConfig.describe(charm) else nil,
			gesperrt = if charm then charm.locked else nil,
		}
	end

	return { promotion = baerchi.promotionLevel or 0, slots = out }
end

-- Einen Charm-Slot sperren/freigeben.
commands.lock = function(player, _data, uid: any, slot: any)
	CharmService.toggleLock(player, tostring(uid), tonumber(slot) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Den ausgeruesteten Baerchi zum Event schicken bzw. zurueckholen.
commands.event = function(player, _data)
	EventParticipationService.sendToEvent(player)
	return { unterwegs = true }
end

commands.recall = function(player, _data)
	EventParticipationService.recall(player)
	return { unterwegs = true }
end

--------------------------------------------------------------------------------
-- v10: Eier legen
--------------------------------------------------------------------------------

-- Legt sofort ein Ei, ohne auf das Intervall zu warten. Mehrfach aufrufen, um
-- den Plot zu fuellen und die Obergrenze zu pruefen.
commands.lay = function(player, _data, times: any)
    local count  = math.clamp(tonumber(times) or 1, 1, 30)
    local laid   = 0

    for _ = 1, count do
        if EggLayService.layNow(player) then
            laid += 1
        else
            break   -- Obergrenze erreicht oder kein Baerchi ausgeruestet
        end
    end

    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Was gerade herumliegt, plus die Werte des ausgeruesteten Legers.
commands.eggs = function(_player, data)
    local out = {}
    for _, egg in data.island.laidEggs or {} do
        table.insert(out, { uid = egg.uid, typ = egg.eggType })
    end

    local uid     = data.island.equippedUid
    local baerchi = if uid then data.island.baerchis[uid] else nil

    local rate: any = "kein Baerchi ausgeruestet"
    local chancen: any = nil

    if baerchi then
        local online  = EggCalculator.getLayIntervalSeconds(baerchi, false)
        local offline = EggCalculator.getLayIntervalSeconds(baerchi, true)

        rate = {
            configId       = baerchi.configId,
            level          = baerchi.level,
            eggStufe       = (baerchi.statLevels :: any).egg or 0,
            mutation       = baerchi.mutation,
            sekundenOnline = if online then math.floor(online + 0.5) else nil,
            sekundenOffline= if offline then math.floor(offline + 0.5) else nil,
        }

        chancen = {}
        for _, chance in EggCalculator.getChances(baerchi) do
            table.insert(chancen, string.format("%s %.0f%%", chance.eggType, chance.percent))
        end
    end

    return {
        liegen  = #out,
        maximum = EggConfig.MAX_UNCOLLECTED_EGGS,
        eier    = out,
        lager   = data.island.eggStock,
        leger   = rate,
        chancen = chancen,
    }
end

-- Alle herumliegenden Eier einsammeln (dasselbe wie der Knopf auf der Karte).
commands.collect = function(player, _data)
    EggLayService.collectAll(player)
    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Die Zeitmarke kuenstlich in die Vergangenheit setzen und danach nachrechnen
-- lassen — so laesst sich das OFFLINE-Nachholen pruefen, ohne den Server zu
-- verlassen. Der naechste Tick (max. 5s) legt dann die faelligen Eier.
--
-- Achtung: der Tick rechnet mit der ONLINE-Rate. Das echte Offline-Verhalten
-- (langsamer, siehe EggConfig.OFFLINE_SLOWDOWN) sieht man nur beim Rejoin.
commands.eggtime = function(player, data, minutes: any)
    local back = math.clamp(tonumber(minutes) or 30, 1, 10000)
    data.island.lastEggAt = os.time() - back * 60
    PlayerService.markDirty(player)

    return { zurueckgestellt = back .. " Minuten", hinweis = "naechster Tick legt nach (max. 5s)" }
end

-- Die laufende Phase sofort beenden. Zweimal aufgerufen bekommt man also aus
-- der Pause heraus ein vollstaendiges Event samt Belohnung, ohne acht Minuten
-- zu warten:
--   D:Invoke("skipevent")   -- Pause vorbei, Event laeuft
--   D:Invoke("event")       -- Baerchi hinschicken, ankommen lassen
--   D:Invoke("skipevent")   -- Event vorbei → Stat-Stufe wird vergeben
commands.skipevent = function(_player, _data)
	EventService.skipPhase()

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		belohnung    = if active then Loc.resolve(EventConfig.describeReward(active)) else nil,
		naechstes    = EventService.getNext().displayName,
		restSekunden = EventService.getRemainingSeconds(),
	}
end

-- Der ganze Katalog mit Belohnung, in der Reihenfolge, in der die Events
-- laufen. Praktisch, um die ids fuer "startevent" nachzuschlagen.
commands.events = function(_player, _data)
	local katalog = {}
	for index, def in EventConfig.EVENTS do
		table.insert(katalog, string.format(
			"%d. %s (%s) — %s",
			index, def.displayName, def.id, Loc.resolve(EventConfig.describeReward(def))
		))
	end

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		restSekunden = EventService.getRemainingSeconds(),
		naechstes    = EventService.getNext().displayName,
		takt         = string.format(
			"individuelle Dauer je Event / %ds Pause",
			EventConfig.EVENT_GAP_SECONDS
		),
		katalog      = katalog,
	}
end

-- Ein BESTIMMTES Event sofort starten, statt sich durch den Zyklus zu warten.
-- Ein voller Durchlauf durch alle zehn Events dauert 80 Minuten — ohne diesen
-- Befehl waere z.B. der Mutations-Sturm praktisch nicht testbar.
--
-- Laeuft gerade ein anderes Event, wird es vorher ordentlich beendet (die
-- Anwesenden bekommen also noch ihre Belohnung, siehe EventService.startById).
commands.startevent = function(_player, _data, id: any)
	local eventId = tostring(id or "")

	if not EventService.startById(eventId) then
		local ids = {}
		for _, def in EventConfig.EVENTS do
			table.insert(ids, def.id)
		end
		return { error = "Unbekannte Event-id: " .. eventId, verfuegbar = ids }
	end

	local active = EventService.getActive()
	return {
		gestartet    = if active then active.displayName else "?",
		belohnung    = if active then Loc.resolve(EventConfig.describeReward(active)) else nil,
		restSekunden = EventService.getRemainingSeconds(),
		hinweis      = "jetzt 'event' aufrufen, um den Baerchi hinzuschicken — er muss beim ENDE dort stehen",
	}
end

commands.recycle = function(player, _data, uid: any)
	RecycleService.recycle(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.upgrade = function(player, _data, buildingId: any)
	IslandService.upgradeBuilding(player, buildingId)
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.rebirth = function(player, _data)
	RebirthService.rebirth(player)
	return commands.info(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v14: Ei-Baum
--------------------------------------------------------------------------------

commands.tree = function(_player, data)
	local out = { blueprints = data.eggTree.blueprints, rebirths = data.rebirthCount }
	for _, eggId in EggConfig.getOrderedIds() do
		local p = EggTree.getProgress(data, eggId)
		local parts = {}
		for _, c in p.conditions do
			local label = c.kind .. (if c.egg then ":" .. c.egg elseif c.rarity then ":" .. c.rarity else "")
			table.insert(parts, string.format("%s %d/%d%s", label, c.have, c.need, if c.done then " ok" else ""))
		end
		out[string.format("%02d %s", EggConfig.data[eggId].sortOrder, eggId)] = string.format("%s | hatched %d | lager %d | %s",
			if p.unlocked then "FREI" else "zu", data.eggTree.hatched[eggId] or 0,
			data.island.eggStock[eggId] or 0, table.concat(parts, ", "))
	end
	return out
end

commands.unlock = function(player, data, eggType: any)
	if eggType == "all" then
		for _, eggId in EggConfig.getOrderedIds() do
			EggTreeService.forceUnlock(player, data, eggId, "debug")
		end
	elseif typeof(eggType) == "string" and EggConfig.data[eggType :: Types.EggType] then
		EggTreeService.forceUnlock(player, data, eggType :: Types.EggType, "debug")
	else
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.hatched = function(player, data, eggType: any, count: any)
	if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	data.eggTree.hatched[eggType] = math.max(0, math.floor(tonumber(count) or 0))
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.blueprint = function(player, data, amount: any)
	EggTreeService.grantBlueprint(player, data, tonumber(amount) or 1)
	PlayerService.markDirty(player)
	return { blueprints = data.eggTree.blueprints }
end

commands.useblueprint = function(player, data, eggType: any)
	local ok = EggTreeService.useBlueprint(player, eggType)
	return { ok = ok, tree = commands.tree(player, data) }
end

commands.press = function(player, data, eggType: any, path: any)
	local result = EggTreeService.press(player, eggType, path)
	return { result = result, stock = data.island.eggStock }
end

commands.setrebirth = function(player, data, count: any)
	data.rebirthCount = math.max(0, math.floor(tonumber(count) or 0))
	data.rebirthMult  = EconomyConfig.getRebirthMult(data.rebirthCount)
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

-- Spielstand fuer Tests sichern und zuruecksetzen. Die Kopie liegt nur im
-- Speicher dieses Servers (nicht im DataStore).
local HttpService = game:GetService("HttpService")
local _snapshot: string? = nil

commands.snapshot = function(_player, data)
	_snapshot = HttpService:JSONEncode(data)
	return { ok = true, bytes = #(_snapshot :: string) }
end

commands.restore = function(player, data)
	if not _snapshot then return { error = "Kein Snapshot" } end
	local saved = HttpService:JSONDecode(_snapshot :: string)
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in saved do (data :: any)[k] = v end
	MapService.rebuildIsland(player, data.island)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return { ok = true }
end

-- HBB Paket 0: feste Test-Zustaende fuer Playtests und Studio-Testschritte.
--   fresh   = Startstand eines neuen Kontos (createdAt = jetzt → Trichter misst)
--   hatch10 = fresh + zehn geoeffnete Basis-Eier
--   tower1  = hatch10 + Tower I geschafft (Rekord 30, Meilensteine ausgezahlt)
--
-- Studio spielt gegen den ECHTEN DataStore. Deshalb verlangt der Befehl einen
-- vorherigen "snapshot"; zurueck geht es mit "restore". Der Snapshot liegt nur
-- im Speicher dieses Servers — vor "Stop" also restore aufrufen.
--
-- Der Baerchi sollte zu Hause stehen (kein Kampf, kein Event), sonst haelt ein
-- anderer Service noch die alte Figur.
local TEST_STATES = { fresh = true, hatch10 = true, tower1 = true }
local TEST_HATCH_COUNT = 10
local TEST_TOWER_RECORD = 30

commands.state = function(player, data, name: any)
	local stateName = tostring(name or "")
	if not TEST_STATES[stateName] then
		return { error = "Unbekannter Zustand: " .. stateName, verfuegbar = { "fresh", "hatch10", "tower1" } }
	end
	if not _snapshot then
		return { error = "Erst D:Invoke(\"snapshot\") — Studio schreibt in den echten Spielstand" }
	end

	-- 1. fresh: alles ersetzen ausser Sitzungs-Sperre und Sprache
	local session  = (data :: any).session
	local language = data.language
	local fresh = PlayerService.buildDefaultData()
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in fresh :: any do (data :: any)[k] = v end
	;(data :: any).session = session
	data.language = language
	MapService.rebuildIsland(player, data.island)
	FunnelService.debugReset(player)

	-- 2. hatch10: ueber den echten Weg oeffnen, damit Zaehler, Index und
	-- Auto-Ausruesten genau wie im Spiel laufen.
	if stateName == "hatch10" or stateName == "tower1" then
		data.island.eggStock.BasicEgg = (data.island.eggStock.BasicEgg or 0) + TEST_HATCH_COUNT
		for _ = 1, TEST_HATCH_COUNT do
			EggService.openEgg(player, "BasicEgg")
		end
	end

	-- 3. tower1: Rekord setzen, Meilensteine wie bei "towerrecord"
	if stateName == "tower1" then
		TowerService.debugSetRecord(player, "I", TEST_TOWER_RECORD)
	end

	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return {
		ok = true,
		zustand = stateName,
		baerchis = countBaerchis(data),
		lager = data.island.eggStock,
		rekorde = data.towers.records,
		hinweis = "Zurueck mit D:Invoke(\"restore\")",
	}
end

-- Ein einzelner Kampf mit Runden-Log (Faehigkeiten pruefen).
commands.skilltest = function(_player, _data, configId: any, stage: any)
	local b = BaerchiFactory.create(tostring(configId), { level = 20 })
	if not b then return { error = "Unbekannter Baerchi" } end
	local def = BaerchiConfig.getById(b.configId)
	local stats = CombatCalculator.getEffectiveStats(b, (def :: any).baseStats)
	local es = CombatConfig.getEnemyStats(1, tonumber(stage) or 20)
	local me = { uid = "me", stats = stats, hp = stats.maxHp, charge = 0 }
	local en = { uid = "en", stats = es, hp = es.maxHp, charge = 0 }
	local r = CombatCalculator.simulate(me, en)
	local lines = {}
	for i, e in r.log do
		if i > 40 then break end
		table.insert(lines, string.format("%s r%d %s dmg %d heal %d abs %d | A %d B %d %s",
			e.actor, e.roundNumber, e.skillId or "-", e.damage, e.heal, e.absorbed,
			e.attackerHpAfter, e.defenderHpAfter, if e.effects then table.concat(e.effects, ",") else ""))
	end
	return { winner = r.winnerUid, rounds = r.rounds, skillUses = r.skillUses, log = lines }
end

commands.help = function()
	return {
		"info", "give <gummies> <gold>", "list",
		"add <configId> <level> [mutation]", "stats <uid>",
		"building <id> <level>",
		"hatch <eggType>", "egg <eggType> [anzahl]", "pitprogress <stage>", "honey", "feed <uid> <times>",
		"fight <uid>", "skill <uid|equipped> <skillId>",
		"fuse <uidA> <uidB> [ability|level|eggs] [A|B]",
		"recycle <uid>", "upgrade <buildingId>", "rebirth",

		-- v8
		"promote <uid>", "charms <uid>", "roll <uid> [anzahl]", "lock <uid> <slot>",
		"event", "recall", "skipevent", "events", "startevent <eventId>",

		-- v10
		"eggs", "lay [anzahl]", "collect", "eggtime <minuten>",

		-- v12
		"petmode", "pm <Event|Fight|Home> [Fresh|Percent|Last]",

		-- v14
		"tree", "unlock <eggType|all>", "hatched <eggType> <n>", "blueprint [n]",
		"useblueprint <eggType>", "press <eggType> [Gold|Kristall|Void]", "setrebirth <n>",
		"skilltest <configId> [stage]", "snapshot", "restore",
		-- HBB Paket 0
		"state <fresh|hatch10|tower1>  (erst snapshot!)",

		-- v15
		"combs [anzahl]", "queue <einheiten>", "recycler [level]",

		-- v15 (Tower/Gebaeude/Angeben/Login-Bonus)
		"tower <I|II|III|Final> <stage>", "towerrecord <id> <stage>", "rebirthcap",
		"epilog <start|reset|state|launch [fast]|scan|summit|summitoff|bridge|bridgeinstant|bridgeoff|terminal [zustand]|speed N|audit|on|off>  (20.10. Final-Epilog)",
		"pass <on|off|reset> [KEY]  (08.10.: Gamepass Gratis-Skip testen)",
		"dailyshift <tage>", "lbflush", "parts", "v14save",

		-- v17
		"jackpot", "combtheme <themeId|off>", "launch [anzahl]",

		-- Welt aufwerten
		"worldshots [1..6|0]", "daytime <uhrzeit|auto>", "pitstate <idle|soon|live|auto>",
		"neststate <calm|boss|auto>", "arrival", "fish",
		"islandstage <1..4|auto>", "pondfull", "spectators <hop|cheer>", "record",
		"moment <hatch|tower|record|rebirth|mutation> [wert]", "moments5",
	}
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function DebugService.init()
	if not RunService:IsStudio() then
		return   -- im Live-Spiel gibt es diesen Service schlicht nicht
	end

	local existing = ServerScriptService:FindFirstChild(BINDABLE_NAME)
	if existing then existing:Destroy() end

	local bindable = Instance.new("BindableFunction")
	bindable.Name   = BINDABLE_NAME
	bindable.Parent = ServerScriptService

	bindable.OnInvoke = function(command: any, ...)
		local name = tostring(command or "help")
		local handler = commands[name]
		if not handler then
			return { error = "Unbekannter Befehl: " .. name, verfuegbar = commands.help() }
		end

		if name == "help" then
			return commands.help()
		end

		local player, data, reason = requireData()
		if not player or not data then
			return { error = reason }
		end

		local ok, result = pcall(handler, player, data, ...)
		if not ok then
			return { error = tostring(result) }
		end
		return result
	end

	print("[DebugService] Initialisiert | Command Bar: game.ServerScriptService." .. BINDABLE_NAME .. ":Invoke(\"help\")")
end

return DebugService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">EpilogService</string><ProtectedString name="Source"><![CDATA[--!strict
-- EpilogService.luau
-- ServerScriptService/Services/EpilogService.luau
--
-- Einzige Zustaendigkeit (Prompt 1 von 7, Final-Epilog):
--   - Den Zustandsautomaten des Epilogs fuehren: none -> pending -> seen ->
--     launched (Regeln in Modules/EpilogRules, hier nur Verdrahtung).
--   - Den Final-100-Sieg ATOMAR festhalten (Endless offen + pending), bevor
--     irgendein Effekt beginnt, dann EpilogStart mit Token schicken.
--   - Token ausgeben und pruefen (EpilogSeen / EpilogSkip / RequestPressLaunch);
--     Ungueltiges still verwerfen (Zaehler im Log, kein Kick).
--   - Die Endless-Meldung (TowerUnlocked) zurueckhalten, bis die Sequenz
--     vorbei ist (Verzoegerungs-Hook fuer Prompt 5/6).
--   - Schnittstellen/Stubs fuer Prompt 2-6 (restore, Gipfel, Insel, Knopf).
--
-- Nicht hier: Gipfel/Insel/Bruecke/Terminal (Prompt 2-4), Kamera (5), Knopf-
-- Finale und Welt-Betreten (6), Texte/Audio (7). Der Server ist autoritativ,
-- der Client bekommt nur Token + Zustand. Nichts wird geloescht.
--
-- Abhaengigkeiten: PlayerService, Remotes, Config. KEIN require auf
-- TowerService (der ruft uns auf) — sonst ein Ringschluss.

local HttpService       = game:GetService("HttpService")
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace         = game:GetService("Workspace")

local Types         = require(ReplicatedStorage.Network.Types)
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local EpilogConfig  = require(ReplicatedStorage.Config.EpilogConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local TowerConfig   = require(ReplicatedStorage.Config.TowerConfig)
local EpilogRules   = require(ReplicatedStorage.Modules.EpilogRules)
local EpilogRoute   = require(ReplicatedStorage.Modules.EpilogRoute)
local MapConfig     = require(ReplicatedStorage.Config.MapConfig)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local MapService     = require(ServerScriptService.Services.MapService)
local PitArenaService = require(ServerScriptService.Services.PitArenaService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)
local EpilogIslandBuilder = require(ServerScriptService.Util.MapBuild.EpilogIslandBuilder)
local EpilogTerminalBuilder = require(ServerScriptService.Util.MapBuild.EpilogTerminalBuilder)
local FigureFX      = require(ServerScriptService.Util.FigureFX)
local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)

local EpilogService = {}

local S = EpilogConfig.STATE

--------------------------------------------------------------------------------
-- Zustand im Speicher (nie gespeichert, beim Verlassen freigegeben)
--------------------------------------------------------------------------------

-- Token pro Spieler (Rules.newToken)
local _tokens: { [Player]: any } = {}
-- Zeitpunkt (os.clock) der letzten Start-Entscheidung — Race-Schutz
local _lastStartClock: { [Player]: number } = {}
-- Endless-Meldung zurueckgehalten: Spieler -> Liste Tower-Ids
local _deferred: { [Player]: { string } } = {}
-- Verworfene Anfragen (Log-Zaehler, kein Kick)
local _rejected: { [Player]: number } = {}
local _rejectedTotal = 0

-- Prompt 5: laufende Kamerafahrt je Spieler (nur im Speicher). Der Server fuehrt den
-- Zeitplan (Teleport, Bruecke, Begleiter, Wachhund); die Kamera macht der Client.
type Seq = {
	startClock : number,        -- os.clock() beim EpilogStart
	speed      : number,        -- Zeitraffer (Debug), sonst 1
	route      : any,           -- MapService.getEpilogRoute (Zahlen-Tabellen)
	thread     : thread?,       -- Zeitplan
	companion  : thread?,       -- Begleiter-Lauf
	cancelled  : boolean,
	skipped    : boolean,
	arrived    : boolean,       -- Ankunft ist abgeschlossen (Insel, Bruecke, Terminal, Avatar)
}
local _seq: { [Player]: Seq } = {}
-- Zeitraffer fuer den naechsten Start (nur Debug: epilog speed N)
local _speed: { [Player]: number } = {}
-- Debug-Bericht des Clients (epilog audit): wartender Aufrufer
local _auditWait: { [Player]: { thread: thread, done: boolean } } = {}

-- Laufendes Finale je Spieler (nur im Speicher). Zeit f = Sekunden seit dem gueltigen Druck.
type Fin = {
	startClock : number,
	speed      : number,
	jump       : number,          -- Sekunden, die ein Skip vorgezogen hat
	token      : string,          -- gueltig nur fuer EpilogSkip waehrend des Finales
	thread     : thread?,
	cancelled  : boolean,
	skipped    : boolean,
	phase      : string,          -- "finale" | "return"
	conns      : { RBXScriptConnection },
}
local _fin: { [Player]: Fin } = {}
local _lastPress: { [Player]: number } = {}

-- Prompt 6 haengt hier den Knopf-Ablauf ein (nach gueltigem Token + State "seen").
local _pressHandler: ((Player, Types.PlayerData) -> ())? = nil
-- Prompt 2/3 haengen hier das Platzieren auf Gipfel/Insel ein.
local _placeHandler: ((Player, Types.PlayerData, string) -> ())? = nil

local function isEnabled(): boolean
	return FeatureFlags.isOn(EpilogConfig.FLAG)
end

local function reject(player: Player, what: string, why: string)
	_rejected[player] = (_rejected[player] or 0) + 1
	_rejectedTotal += 1
	if _rejected[player] <= 5 then   -- Log-Flood-Schutz wie im RateLimiter
		print("[EpilogService] verworfen:", player.Name, "|", what, "|", why,
			"| gesamt:", _rejected[player])
	end
end

--------------------------------------------------------------------------------
-- Lesen
--------------------------------------------------------------------------------

function EpilogService.getState(data: Types.PlayerData): string
	local epilog = data.epilog
	return if epilog and EpilogRules.isValidState(epilog.state) then epilog.state else S.NONE
end

-- Laeuft fuer diesen Spieler gerade eine Sequenz (pending/seen, Flag an)?
function EpilogService.isSequenceActive(player: Player): boolean
	if not isEnabled() then return false end
	local data = PlayerService.getData(player)
	if not data then return false end
	local state = EpilogService.getState(data)
	return state == S.PENDING or state == S.SEEN
end

function EpilogService.getRejectedCount(): number
	return _rejectedTotal
end

--------------------------------------------------------------------------------
-- Verzoegerte Endless-Meldung (Hook fuer Prompt 5/6)
--------------------------------------------------------------------------------

-- Von TowerService vor jedem TowerUnlocked aufgerufen. true = die Meldung ist
-- zurueckgestellt (TowerService feuert dann NICHT). Nur Endless wird gehalten,
-- nur solange die Sequenz offen ist.
function EpilogService.deferUnlockNotice(player: Player, towerId: string): boolean
	if towerId ~= "Endless" or not EpilogService.isSequenceActive(player) then
		return false
	end
	local list = _deferred[player]
	if not list then
		list = {}
		_deferred[player] = list
	end
	if not table.find(list, towerId) then
		table.insert(list, towerId)
	end
	-- Notfall-Freigabe, falls niemand sie holt (z. B. Client ohne Epilog-Anzeige).
	task.delay(EpilogConfig.DEFER_MAX_SECONDS, function()
		EpilogService.releaseDeferred(player)
	end)
	return true
end

-- Gibt zurueckgehaltene Meldungen frei (Prompt 5/6: nach Rueckweg bzw. Finale;
-- hier auch bei "launched" und per Notfall-Timer). Mehrfachaufruf harmlos.
function EpilogService.releaseDeferred(player: Player)
	local list = _deferred[player]
	if not list then return end
	_deferred[player] = nil
	if player.Parent == nil then return end
	for _, towerId in list do
		Remotes.TowerUnlocked:FireClient(player, towerId)
	end
end

--------------------------------------------------------------------------------
-- Token
--------------------------------------------------------------------------------

-- `backdate` (Sekunden): nur fuer den Debug-Zeitraffer, damit die Mindestzeit fuer EpilogSeen
-- nicht an der verkuerzten Sequenz scheitert.
local function issueToken(player: Player, backdate: number?): string
	local guid = HttpService:GenerateGUID(false)
	_tokens[player] = EpilogRules.newToken(guid, player.UserId, os.time() - (backdate or 0))
	return guid
end

--------------------------------------------------------------------------------
-- Sieg: Phase 1-3
--------------------------------------------------------------------------------

-- Von TowerService.recordRun aufgerufen (synchron, im selben Schreibvorgang wie
-- der Rekord; vor dem Speichern des CombatService). Gibt true zurueck, wenn
-- eine NEUE Sequenz beginnt. Kein task.wait vor der Mutation.
function EpilogService.onFinalClear(player: Player, data: Types.PlayerData, towerId: string, stage: number): boolean
	if not isEnabled() then return false end
	local def = TowerConfig.get(EpilogConfig.TOWER_ID)
	if not def or not EpilogRules.isTrigger(towerId, stage, def.stages) then return false end

	-- Race: zwei Final-Clears kurz hintereinander -> hoechstens eine Sequenz
	-- (der Zustand schuetzt schon; das hier faengt zusaetzlich Debug/Doppelaufruf).
	local nowClock = os.clock()
	local last = _lastStartClock[player]
	if last and nowClock - last < EpilogConfig.START_DEBOUNCE_SECONDS then
		return false
	end

	-- Phase 2: EINE Mutation (Endless offen + pending + firstClearAt).
	local started = EpilogRules.applyFinalClear(data, os.time())
	if not started then
		-- Phase 3: Zustand war nicht "none" -> nur der normale Sieg-Moment.
		return false
	end
	_lastStartClock[player] = nowClock

	-- Prompt 2 / Phase 1: der Run-Turm bleibt stehen und bekommt den Gipfel. Das
	-- MUSS synchron hier passieren (der Abbau beginnt kurz nach der Abrechnung).
	-- Ein Fehler im Bau darf die Abrechnung nie verhindern.
	local okSummit, errSummit = pcall(MapService.setSummit, player, true, true)
	if not okSummit then
		warn("[EpilogService] Gipfel konnte nicht gebaut werden:", errSummit)
	end

	-- Phase 3: Start erst NACH dem Speichern melden. task.defer: der Speicherstoss
	-- beginnt erst, wenn die Abrechnung des Laufs (recordRun, Meilensteine,
	-- CombatService-Save) durch ist; UpdateAsync haelt den Thread an und soll sie
	-- nicht blockieren. Bis dahin steht der Stand vollstaendig im Speicher.
	task.defer(function()
		local ok = PlayerService.saveConfirmed(player)
		if not ok then
			warn("[EpilogService] Speichern nach Final 100 meldete Fehler fuer", player.Name,
				"- Stand liegt im Speicher, naechster Auto-Save holt ihn nach")
		end
		if player.Parent == nil then return end
		EpilogService.beginFull(player)
	end)
	print("[EpilogService]", player.Name, "| Final", stage, "geschafft -> pending (Sequenz startet)")
	return true
end

--------------------------------------------------------------------------------
-- Fortschritt: seen / launched
--------------------------------------------------------------------------------

-- EpilogSeen: Spieler hat Insel/Terminal erreicht. pending -> seen.
local function handleSeen(player: Player, token: any)
	local data = PlayerService.getData(player)
	if not data or not isEnabled() then return end
	if EpilogService.getState(data) ~= S.PENDING then
		reject(player, "EpilogSeen", "falscher Zustand: " .. EpilogService.getState(data))
		return
	end
	local ok, why = EpilogRules.checkToken(_tokens[player], token, player.UserId, "seen", os.time())
	if not ok then
		reject(player, "EpilogSeen", why)
		return
	end
	EpilogRules.consumeSeen(_tokens[player])
	if EpilogRules.transition(data.epilog, S.SEEN, os.time()) then
		PlayerService.markDirty(player)
		PlayerService.saveNow(player)
	end
end

-- EpilogSkip: Kamerafahrt uebersprungen. Aendert den Zustand NICHT (Skip darf
-- nie den Weg zu Endless/Welt 2 verbauen). Prompt 5: der Server springt zur Ankunft
-- (Insel, Bruecke, Terminal fertig, Avatar und Begleiter davor) - nie ueber den Knopf
-- hinweg, und nicht vor Sekunde 12 der Sequenz.
local function handleSkip(player: Player, token: any)
	local data = PlayerService.getData(player)
	if not data or not isEnabled() then return end
	-- Prompt 6: waehrend des Finales (State "launched") gilt der Skip dem Finale
	if EpilogService.skipFinale(player, token) then return end
	local state = EpilogService.getState(data)
	if state ~= S.PENDING and state ~= S.SEEN then
		reject(player, "EpilogSkip", "falscher Zustand: " .. state)
		return
	end
	local ok, why = EpilogRules.checkToken(_tokens[player], token, player.UserId, "skip", os.time())
	if not ok then
		reject(player, "EpilogSkip", why)
		return
	end
	local seq = _seq[player]
	if not seq or seq.cancelled or seq.skipped or seq.arrived then
		reject(player, "EpilogSkip", "keine_laufende_fahrt")
		return
	end
	local Q = EpilogConfig.SEQUENCE
	local elapsed = (os.clock() - seq.startClock) * seq.speed
	if elapsed < Q.skipFromSeconds - Q.skipTolerance * seq.speed then
		reject(player, "EpilogSkip", "zu_frueh")
		return
	end
	EpilogService.skipToArrival(player, seq)
end

-- RequestPressLaunch (C->S): Knopf gehalten. Nur mit gueltigem Token, State pending/seen,
-- lebendem Spieler und Abstand < 14 Studs zum Terminal (Pruefung in startFinale). Ein
-- zweiter Druck waehrend des Finales ist ein no-op. Ohne Token wirkt nichts.
local function handlePress(player: Player, token: any)
	local data = PlayerService.getData(player)
	if not data or not isEnabled() then return end
	local state = EpilogService.getState(data)
	if state ~= S.PENDING and state ~= S.SEEN then
		if _fin[player] == nil then
			reject(player, "RequestPressLaunch", "falscher Zustand: " .. state)
		end
		return
	end
	local ok, why = EpilogRules.checkToken(_tokens[player], token, player.UserId, "press", os.time())
	if not ok then
		reject(player, "RequestPressLaunch", why)
		return
	end
	EpilogService.startFinale(player, "remote", false)
end

-- Knopf-Finale: seen -> launched UND World2 frei in einer Mutation, dann
-- speichern, melden und zurueckgehaltene Meldungen freigeben. Wird von
-- Prompt 6 (nach dem Halten) und vom Debug-Befehl benutzt. false = nicht erlaubt.
function EpilogService.markLaunched(player: Player, keepDeferred: boolean?): boolean
	local data = PlayerService.getData(player)
	if not data then return false end
	local now = os.time()
	-- Ein Druck vor EpilogSeen (Spieler war schneller als die Meldung): pending -> seen nachholen
	if EpilogService.getState(data) == S.PENDING then
		EpilogRules.transition(data.epilog, S.SEEN, now)
	end
	if not EpilogRules.applyLaunch(data, now) then return false end
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	_tokens[player] = nil
	Remotes.World2Unlocked:FireClient(player, EpilogConfig.WORLD2_ID)
	if keepDeferred ~= true then EpilogService.releaseDeferred(player) end
	print("[EpilogService]", player.Name, "| launched -> Welt 2 frei")
	return true
end

--------------------------------------------------------------------------------
-- Gipfel (Prompt 2)
--------------------------------------------------------------------------------

-- Setzt Avatar und Begleiter-Baerchi auf den Gipfel. Wartet (hoechstens
-- `maxWait` s) auf den Charakter; der Builder holt spaeter auch jeden Respawn
-- selbst auf den Gipfel zurueck.
function EpilogService.teleportWhenReady(player: Player, maxWait: number?)
	local waited = 0
	while player.Parent ~= nil and waited < (maxWait or 15) do
		local data = PlayerService.getData(player)
		if data and MapService.hasSummit(player) and player.Character
			and player.Character:FindFirstChild("HumanoidRootPart") then
			MapService.teleportToSummit(player, data.island.equippedUid)
			return
		end
		task.wait(0.25)
		waited += 0.25
	end
end

--------------------------------------------------------------------------------
-- Kamerafahrt (Prompt 5): Zeitplan des Servers
--------------------------------------------------------------------------------
-- Der Server fuehrt nur, was autoritativ sein muss: Teleport beim Flash, Insel und
-- Bruecke ab Sekunde 5, den Begleiter-Baerchi und die Ankunft. Kamera, Lauf des Avatars
-- (Humanoid:MoveTo auf dem Client) und Effekte macht der Client (EpilogController).
-- Kommt der Avatar nicht an (Tod, Haenger, Skip), setzt der Server ihn vor das Terminal.

local function clampSpeed(speed: number?): number
	local Q = EpilogConfig.SEQUENCE
	return math.clamp(speed or 1, Q.minSpeed, Q.maxSpeed)
end

local function seqAlive(player: Player, seq: Seq): boolean
	return _seq[player] == seq and not seq.cancelled and not seq.skipped and player.Parent ~= nil
end

-- Wartet bis Sekunde `t` der Sequenz (durch den Zeitraffer geteilt). false = Fahrt vorbei.
local function waitUntil(player: Player, seq: Seq, t: number): boolean
	local remaining = seq.startClock + t / seq.speed - os.clock()
	if remaining > 0 then task.wait(remaining) end
	return seqAlive(player, seq)
end

local function sequenceSeconds(seq: Seq): number
	return (os.clock() - seq.startClock) * seq.speed
end

local function stopThreads(seq: Seq)
	local current = coroutine.running()
	if seq.thread and seq.thread ~= current then pcall(task.cancel, seq.thread) end
	if seq.companion and seq.companion ~= current then pcall(task.cancel, seq.companion) end
	seq.thread = nil
	seq.companion = nil
end

-- Fahrt abbrechen (Verlassen, Debug-Reset): nichts wird nachgeholt.
function EpilogService.cancelSequence(player: Player)
	local seq = _seq[player]
	if not seq then return end
	seq.cancelled = true
	stopThreads(seq)
	_seq[player] = nil
end

function EpilogService.hasSequence(player: Player): boolean
	return _seq[player] ~= nil
end

-- Der Begleiter-Baerchi laeuft `companionAhead` Studs vor dem Avatar ueber den Weg (gleiches
-- Tempoprofil wie der Avatar, Hopser wie FigureWalker). Eine Heartbeat-Schleife, ein Thread.
local function walkCompanion(player: Player, seq: Seq)
	local Q = EpilogConfig.SEQUENCE
	local data = PlayerService.getData(player)
	local uid = data and data.island.equippedUid
	local model = if uid then MapService.getBaerchiModel(player, uid) else nil
	local pts = seq.route and seq.route.points
	if not model or not pts or #pts < 2 then return end

	local route = EpilogRoute.new(pts)
	local duration = Q.arriveAt - Q.walkAt
	local profile = EpilogRoute.profile(route.length, duration, Q.walkFactors)
	local sideStart = EpilogConfig.SUMMIT.companionSide
	FigureFX.stopIdle(model)

	local lastFacing = CFrame.new()
	while seqAlive(player, seq) and model.Parent ~= nil do
		local tau = sequenceSeconds(seq) - Q.walkAt
		if tau >= duration then break end
		local s = math.min(route.length, EpilogRoute.distanceAt(profile, math.max(tau, 0)) + Q.companionAhead)
		local p = EpilogRoute.pointAt(route, s)
		local dir = EpilogRoute.directionAt(route, s)
		local foot = Vector3.new(p[1], p[2], p[3])
		-- Anfangs steht er neben dem Avatar (Gipfel): die Seitenverschiebung gleitet in 1,5 s weg
		local lateral = sideStart * (1 - math.clamp(tau / 1.5, 0, 1))
		foot += Vector3.new(-dir[3], 0, dir[1]) * lateral
		local travelled = EpilogRoute.distanceAt(profile, math.max(tau, 0))
		local bob = math.abs(math.sin(travelled * MapConfig.WALK_BOB_PER_STUD * math.pi)) * MapConfig.WALK_BOB_HEIGHT
		lastFacing = CFrame.lookAt(Vector3.zero, Vector3.new(dir[1], 0, dir[3]))
			* CFrame.Angles(math.rad(MapConfig.WALK_LEAN_DEGREES), 0, 0)
		FigurePlacement.place(model, foot + Vector3.new(0, bob, 0), lastFacing)
		RunService.Heartbeat:Wait()
	end
	-- Am Ziel wieder sanft wippen (bei Skip/Ankunft setzt teleportToIsland die Figur ohnehin neu)
	if seqAlive(player, seq) and model.Parent ~= nil then
		FigureFX.idleBob(model, { height = MapConfig.IDLE_BOB_HEIGHT, rate = MapConfig.IDLE_BOB_RATE })
	end
end

-- Ankunft sichern: Insel, Bruecke und Terminal stehen, Avatar und Begleiter sind vor dem
-- Terminal. `force` (Skip) setzt den Avatar immer um, sonst nur, wenn er nicht angekommen ist.
local function finishArrival(player: Player, seq: Seq, force: boolean)
	if seq.arrived then return end
	seq.arrived = true
	local data = PlayerService.getData(player)
	if not data or not MapService.hasSummit(player) then return end
	if not MapService.hasIsland(player) then MapService.buildIsland(player, false) end
	if not MapService.isBridgeComplete(player) then MapService.buildBridgeInstant(player) end
	if not MapService.hasTerminal(player) then MapService.buildTerminal(player) end

	local pts = seq.route and seq.route.points
	local last = pts and pts[#pts]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local near = false
	if last and root and root:IsA("BasePart") then
		local d = root.Position - Vector3.new(last[1], last[2], last[3])
		near = Vector3.new(d.X, 0, d.Z).Magnitude <= EpilogConfig.SEQUENCE.arriveRadius
	end
	if force or not near then
		MapService.teleportToIsland(player, data.island.equippedUid)
	end
end

-- Skip (nach der Pruefung in handleSkip): Zeitplan und Begleiter-Lauf stoppen, Ankunft herstellen.
function EpilogService.skipToArrival(player: Player, seq: Seq)
	seq.skipped = true
	stopThreads(seq)
	task.spawn(function()
		finishArrival(player, seq, true)
		-- Eintrag bleibt bis zum Ende der Phase 5 (der Client spielt sie noch)
		local remaining = EpilogConfig.SEQUENCE.endAt - EpilogConfig.SEQUENCE.arriveAt
		task.wait(remaining / seq.speed)
		if _seq[player] == seq then _seq[player] = nil end
	end)
end

local function runSequence(player: Player, seq: Seq)
	local Q = EpilogConfig.SEQUENCE
	if not waitUntil(player, seq, Q.teleportAt) then return end
	EpilogService.teleportWhenReady(player)
	if not waitUntil(player, seq, Q.bridgeAt) then return end
	EpilogService.runBridgeSequence(player)
	if not waitUntil(player, seq, Q.walkAt) then return end
	seq.companion = task.spawn(walkCompanion, player, seq)
	if not waitUntil(player, seq, Q.arriveAt + 0.5) then return end
	finishArrival(player, seq, false)
	if not waitUntil(player, seq, Q.endAt) then return end
	if _seq[player] == seq then _seq[player] = nil end
end

-- Komplette Sequenz-Eroeffnung nach dem Sieg (Prompt 2): erst warten, bis die
-- Kampf-Wiedergabe vorbei ist (der Baerchi ist wieder heim), dann EpilogStart
-- und Teleport (nach EpilogConfig.SUMMIT.teleportDelay, Prompt 5 stellt ihn auf
-- den Flash-Hoehepunkt).
function EpilogService.beginFull(player: Player)
	local waited = 0
	while PitArenaService.isRunning(player) and waited < 60 and player.Parent ~= nil do
		task.wait(0.25)
		waited += 0.25
	end
	if player.Parent == nil then return end
	local data = PlayerService.getData(player)
	if not data or EpilogService.getState(data) ~= S.PENDING then return end
	if not MapService.hasSummit(player) then
		MapService.setSummit(player, true, false)
	end
	-- Prompt 5: Kamerafahrt mit Zeitplan. Ohne Wegdaten (oder mit SEQUENCE.enabled = false)
	-- laeuft der alte Ablauf (Teleport, Bruecke ohne Kamera).
	local Q = EpilogConfig.SEQUENCE
	local route = if Q.enabled then MapService.getEpilogRoute(player) else nil
	if route then
		_seq[player] = nil
		local speed = clampSpeed(_speed[player])
		local seq: Seq = {
			startClock = os.clock(), speed = speed, route = route, thread = nil, companion = nil,
			cancelled = false, skipped = false, arrived = false,
		}
		_seq[player] = seq
		Remotes.EpilogStart:FireClient(player, {
			token = issueToken(player, if speed > 1 then EpilogConfig.SEEN_MIN_SECONDS else 0),
			mode  = EpilogConfig.MODE.FULL,
			state = S.PENDING,
			speed = speed,
			startAt = Workspace:GetServerTimeNow(),
			skipFrom = Q.skipFromSeconds,
			route = route,
		})
		seq.thread = task.spawn(runSequence, player, seq)
		return
	end
	Remotes.EpilogStart:FireClient(player, {
		token = issueToken(player),
		mode  = EpilogConfig.MODE.FULL,
		state = S.PENDING,
	})
	local delay = EpilogConfig.SUMMIT.teleportDelay
	if delay > 0 then task.wait(delay) end
	EpilogService.teleportWhenReady(player)
	-- Prompt 3: Insel entsteht mit dem Sequenzstart, dann waechst die Bruecke.
	if EpilogConfig.BRIDGE.autoStart then
		EpilogService.runBridgeSequence(player)
	end
end

--------------------------------------------------------------------------------
-- Insel und Bruecke (Prompt 3)
--------------------------------------------------------------------------------

-- Erlaubnis fuer den Brueckenbau: Epilog an UND state "pending"/"seen".
local function bridgeAllowed(player: Player): boolean
	if not isEnabled() then return false end
	local data = PlayerService.getData(player)
	if not data then return false end
	local state = EpilogService.getState(data)
	return state == S.PENDING or state == S.SEEN
end

-- Setzt den Avatar vor das Terminal auf die Insel (wartet auf den Charakter).
function EpilogService.placeOnIsland(player: Player, maxWait: number?)
	local waited = 0
	while player.Parent ~= nil and waited < (maxWait or 15) do
		local data = PlayerService.getData(player)
		if data and MapService.isBridgeComplete(player) and player.Character
			and player.Character:FindFirstChild("HumanoidRootPart") then
			MapService.teleportToIsland(player, data.island.equippedUid)
			return
		end
		task.wait(0.25)
		waited += 0.25
	end
end

--------------------------------------------------------------------------------
-- Prompt 6: Knopf-Finale (Server entscheidet, speichert und raeumt auf)
--------------------------------------------------------------------------------

local function finTime(fin: Fin): number
	return (os.clock() - fin.startClock) * fin.speed + fin.jump
end

local function finAlive(player: Player, fin: Fin): boolean
	return _fin[player] == fin and not fin.cancelled and player.Parent ~= nil
end

-- Wartet bis Finale-Zeit `t`. false = abgebrochen/Spieler weg.
local function finWait(player: Player, fin: Fin, t: number): boolean
	while finAlive(player, fin) do
		if finTime(fin) >= t then return true end
		task.wait(0.05)
	end
	return false
end

function EpilogService.isFinaleRunning(player: Player): boolean
	return _fin[player] ~= nil
end

-- Schluss des Finales (normal oder Abbruch): Rakete weg, Gipfel/Insel/Terminal weg,
-- Avatar auf dem Plot, Client beenden. Idempotent. Der Spielstand bleibt "launched".
local function finishFinale(player: Player, fin: Fin, aborted: boolean)
	if _fin[player] ~= fin then return end
	_fin[player] = nil
	fin.cancelled = true
	for _, c in fin.conns do c:Disconnect() end
	table.clear(fin.conns)
	if fin.thread and fin.thread ~= coroutine.running() then
		pcall(task.cancel, fin.thread)
	end
	if player.Parent == nil then return end
	MapService.destroyRocket(player)
	-- Auch bei Abbruch (Tod/Skip-Fehler) keine Reste: alles sofort weg
	if MapService.hasSummit(player) or MapService.hasIsland(player) or MapService.hasTerminal(player) then
		MapService.setSummit(player, false)
	end
	MapService.placeOnPlotIfFar(player, EpilogConfig.FINALE.plotMaxDistance)
	EpilogService.releaseDeferred(player)
	Remotes.EpilogLaunchResult:FireClient(player, { ok = true, phase = "end", aborted = aborted })
end

function EpilogService.cancelFinale(player: Player)
	local fin = _fin[player]
	if not fin then return end
	_fin[player] = nil
	fin.cancelled = true
	for _, c in fin.conns do c:Disconnect() end
	table.clear(fin.conns)
	if fin.thread and fin.thread ~= coroutine.running() then
		pcall(task.cancel, fin.thread)
	end
	if player.Parent ~= nil then
		MapService.destroyRocket(player)
	end
end

local function runFinale(player: Player, fin: Fin)
	local F = EpilogConfig.FINALE
	local T = EpilogConfig.TERMINAL
	local data = PlayerService.getData(player)

	-- Phase 2: Countdown 3 ... 2 ... 1 (Terminal-Bildschirm, Lampen, Bildschirmrand)
	for i, t in F.countTimes do
		if not finWait(player, fin, t) then return end
		MapService.setTerminalCountdown(player, #F.countTimes - i + 1)
	end
	-- Beat vor dem Hoehepunkt: 0,3 s Stille
	if not finWait(player, fin, F.silenceAt) then return end
	MapService.setTerminalCountdown(player, 0)

	-- Phase 3: Start. Die Rakete zuendet; der Client faehrt sie in die Wolken.
	if not finWait(player, fin, F.launchAt) then return end
	MapService.launchRocket(player, true)
	if not finWait(player, fin, F.launchEnd + 0.5) then return end
	MapService.launchRocket(player, false)
	MapService.destroyRocket(player)

	-- Phase 4: Feier (Banner/Himmel/Portal macht der Client). Terminal: "WELT 2 OFFEN".
	if not finWait(player, fin, F.returnAt) then return end
	MapService.setTerminalState(player, T.STATE.DONE)
	EpilogService.releaseDeferred(player)   -- verzoegerte Endless-Meldung jetzt zeigen
	fin.phase = "return"
	Remotes.EpilogLaunchResult:FireClient(player, { ok = true, phase = "return" })

	-- Phase 5: Rueckweg. Flash, Avatar + Begleiter auf den Gipfel ("Zurueck"), Bruecke und
	-- Insel bauen sich ab, danach faehrt der Turm ab (Lift).
	if not finWait(player, fin, F.returnTeleportAt) then return end
	if not MapService.hasSummit(player) then MapService.setSummit(player, true, false) end
	local uid = if data then data.island.equippedUid else nil
	MapService.teleportToSummit(player, uid)
	local removed = false
	MapService.removeIsland(player, true, function() removed = true end)
	local waited = 0
	while not removed and waited < EpilogConfig.BRIDGE.removeSeconds + 4 and finAlive(player, fin) do
		task.wait(0.1)
		waited += 0.1
	end
	if not finAlive(player, fin) then return end
	if MapService.hasSummit(player) then
		MapService.lowerSummit(player, uid, F.lowerSeconds)
	end
	finishFinale(player, fin, false)
end

-- Gemeinsame Pruefung fuer Prompt und Remote. Gibt true oder false + Grund. `force` (Debug)
-- ueberspringt Abstand und Rate-Limit.
local function canStartFinale(player: Player, force: boolean): (boolean, string)
	local F = EpilogConfig.FINALE
	if not isEnabled() or not F.enabled then return false, "disabled" end
	local data = PlayerService.getData(player)
	if not data then return false, "no_data" end
	if _fin[player] then return false, "already_running" end   -- doppelte Anfrage = no-op
	if not bridgeAllowed(player) then return false, "state_not_allowed" end
	if not MapService.hasTerminal(player) then return false, "no_terminal" end
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return false, "dead"
	end
	if not force then
		local last = _lastPress[player]
		if last and os.clock() - last < F.pressCooldownSeconds then return false, "rate_limit" end
		local mount = MapService.getTerminalMount(player)
		if not mount or (root.Position - mount.Position).Magnitude > F.pressMaxDistance then
			return false, "too_far"
		end
	end
	return true, "ok"
end

-- Phase 1: Freigabe. Prueft, schreibt "launched" + Welt 2 in EINER Mutation, speichert und
-- startet den Ablauf. Rueckgabe true = angenommen. Doppelte/ungueltige Anfragen aendern nichts.
function EpilogService.startFinale(player: Player, source: string, force: boolean?): boolean
	_lastPress[player] = if force == true then _lastPress[player] else os.clock()
	local ok, why = canStartFinale(player, force == true)
	if not ok then
		if why ~= "already_running" then reject(player, "startFinale:" .. source, why) end
		return false
	end
	if not EpilogService.markLaunched(player, true) then
		reject(player, "startFinale:" .. source, "launch_refused")
		return false
	end
	-- Ein noch laufender Anfahrts-Ablauf endet hier (Insel/Terminal bleiben stehen).
	EpilogService.cancelSequence(player)

	local F = EpilogConfig.FINALE
	local speed = math.clamp(_speed[player] or 1, F.minSpeed, F.maxSpeed)
	local fin: Fin = {
		startClock = os.clock(), speed = speed, jump = 0,
		token = HttpService:GenerateGUID(false), thread = nil,
		cancelled = false, skipped = false, phase = "finale", conns = {},
	}
	_fin[player] = fin

	-- Abbruch bei Tod / Charakterwechsel: sofort aufraeumen, State bleibt "launched"
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if humanoid then
		table.insert(fin.conns, humanoid.Died:Connect(function()
			finishFinale(player, fin, true)
		end))
	end
	table.insert(fin.conns, player.CharacterRemoving:Connect(function()
		finishFinale(player, fin, true)
	end))

	MapService.setTerminalState(player, EpilogConfig.TERMINAL.STATE.FIRED)
	MapService.buildRocket(player)
	local info = MapService.getEpilogRoute(player)
	local rocketBase = MapService.getRocketBase(player)
	Remotes.EpilogLaunchResult:FireClient(player, {
		ok = true, phase = "start", token = fin.token, speed = speed,
		startAt = Workspace:GetServerTimeNow(), skipFrom = F.skipFromSeconds,
		route = info, rocketBase = rocketBase,
	})
	fin.thread = task.spawn(function()
		local okRun, err = pcall(runFinale, player, fin)
		if not okRun then
			warn("[EpilogService] Finale fehlgeschlagen fuer", player.Name, ":", err)
			finishFinale(player, fin, true)
		end
	end)
	print("[EpilogService]", player.Name, "| Knopf (", source, ") -> launched, Finale laeuft")
	return true
end

-- Skip des Finales (ab Sekunde skipFromSeconds): springt zum Rueckweg. Token pflicht.
function EpilogService.skipFinale(player: Player, token: any): boolean
	local fin = _fin[player]
	if not fin then return false end
	if typeof(token) ~= "string" or token ~= fin.token then
		reject(player, "EpilogSkip", "finale_wrong_token")
		return true
	end
	local F = EpilogConfig.FINALE
	local f = finTime(fin)
	if fin.phase ~= "finale" or fin.skipped then
		reject(player, "EpilogSkip", "finale_nicht_skippbar")
		return true
	end
	if f < F.skipFromSeconds - F.skipTolerance * fin.speed then
		reject(player, "EpilogSkip", "finale_zu_frueh")
		return true
	end
	fin.skipped = true
	fin.jump += math.max(0, F.returnAt - f)
	return true
end

-- Prompt 4 -> 6: Startwunsch vom Terminal (Prompt voll gehalten, 1,2 s). Der Prompt ist
-- serverseitig, ein Token ist hier nicht noetig. true = angenommen.
function EpilogService.onLaunchRequested(player: Player): boolean
	if MapService.getTerminalState(player) ~= EpilogConfig.TERMINAL.STATE.ARMED then
		reject(player, "onLaunchRequested", "not_armed")
		return false
	end
	return EpilogService.startFinale(player, "prompt", false)
end

-- Insel enthuellen (3 s), danach die Bruecke Planke fuer Planke wachsen lassen.
-- `onDone` laeuft, wenn der Lichtimpuls die Insel erreicht hat. Prompt 5 ruft das
-- zum Kamera-Zeitpunkt (BRIDGE.autoStart = false). Bedingungen (Zustand, lebt,
-- am Gipfel) prueft EpilogIslandBuilder; hier wird nur kurz gewartet, bis sie stimmen.
function EpilogService.runBridgeSequence(player: Player, onDone: (() -> ())?)
	task.spawn(function()
		if not MapService.hasIsland(player) then
			if not MapService.buildIsland(player, true) then
				warn("[EpilogService] Insel konnte nicht gebaut werden fuer", player.Name)
				return
			end
		end
		local waited = 0
		local limit = EpilogConfig.BRIDGE.retrySeconds + EpilogConfig.ISLAND.revealSeconds
		while player.Parent ~= nil and waited < limit do
			local ok, why = MapService.growBridge(player, function()
				-- Prompt 4: das Terminal steht, sobald die Bruecke fertig ist
				MapService.buildTerminal(player)
				if onDone then onDone() end
			end)
			if ok or (why ~= "island_not_revealed" and why ~= "player_not_at_summit" and why ~= "player_dead") then
				if not ok and why ~= "already_growing" and why ~= "already_complete" then
					warn("[EpilogService] Bruecke nicht gebaut:", why)
				end
				return
			end
			task.wait(0.5)
			waited += 0.5
		end
	end)
end

--------------------------------------------------------------------------------
-- Schnittstellen/Stubs fuer Prompt 2-6
--------------------------------------------------------------------------------

-- Prompt 6: Ablauf nach gueltigem Knopfdruck.
function EpilogService.setPressHandler(handler: (Player, Types.PlayerData) -> ())
	_pressHandler = handler
end

-- Prompt 2/3: platziert den Spieler (state, ohne Kamerafahrt). "pending" ->
-- Gipfel, "seen" -> Insel. Der Handler baut die Teile bei Bedarf auf.
function EpilogService.setPlaceHandler(handler: (Player, Types.PlayerData, string) -> ())
	_placeHandler = handler
end

-- Wiedereinstieg beim Join mit "pending"/"seen": KEINE Kamerafahrt. Stub: die
-- Platzierung kommt aus Prompt 2 (Gipfel) und 3 (Insel). Schickt ein frisches
-- Token mit mode = "restore" (Client in Prompt 5 baut daraus die ruhige Szene).
function EpilogService.restore(player: Player)
	if not isEnabled() then return end
	local data = PlayerService.getData(player)
	if not data then return end
	local state = EpilogService.getState(data)
	-- Prompt 6: "launched" (Spieler kam beim Finale/Rueckweg heraus): Gipfel, Insel, Terminal
	-- und Rakete gibt es nach dem Join nicht mehr; sicherheitshalber alles wegraeumen, den
	-- Turm freigeben und den Avatar auf den Plot setzen. Keine Effekte, keine Fahrt.
	if state == S.LAUNCHED then
		if _fin[player] == nil then
			MapService.setSummit(player, false)
			MapService.placeOnPlotIfFar(player, EpilogConfig.FINALE.plotMaxDistance)
		end
		return
	end
	if state ~= S.PENDING and state ~= S.SEEN then return end

	-- Prompt 2: "pending" -> Gipfel samt Teleport, ohne Fahrt. "seen" -> Insel
	-- (Prompt 3, ueber den Platzier-Handler).
	if state == S.PENDING then
		if MapService.setSummit(player, true, false) then
			-- ANNAHME (Prompt 3): auch bei "pending" steht die Bruecke fertig da, sonst
			-- haengt der Spieler ohne Kamerafahrt auf dem Gipfel fest. Der Avatar
			-- steht auf dem Gipfel und kann hinueber laufen.
			MapService.buildIsland(player, false)
			MapService.buildBridgeInstant(player)
			MapService.buildTerminal(player)   -- Prompt 4
			task.spawn(EpilogService.teleportWhenReady, player)
		end
	elseif state == S.SEEN then
		-- Prompt 3: Insel + fertige Bruecke sofort, Avatar vor das Terminal.
		if MapService.setSummit(player, true, false) then
			MapService.buildIsland(player, false)
			MapService.buildBridgeInstant(player)
			MapService.buildTerminal(player)   -- Prompt 4
			task.spawn(EpilogService.placeOnIsland, player)
		end
	end
	local handler = _placeHandler
	if handler then
		local ok, err = pcall(handler, player, data, state)
		if not ok then
			warn("[EpilogService] Platzieren fehlgeschlagen fuer", player.Name, ":", err)
		end
	end
	Remotes.EpilogStart:FireClient(player, {
		token = issueToken(player),
		mode  = EpilogConfig.MODE.RESTORE,
		state = state,
	})
end

--------------------------------------------------------------------------------
-- Debug (nur ueber DebugService)
--------------------------------------------------------------------------------

-- start: erzwingt eine NEUE Sequenz (state -> pending), unabhaengig vom Rekord.
function EpilogService.debugStart(player: Player): (boolean, string)
	local data = PlayerService.getData(player)
	if not data then return false, "no_data" end
	if EpilogService.getState(data) ~= S.NONE then
		return false, "state_not_none:" .. EpilogService.getState(data)
	end
	_lastStartClock[player] = nil
	local started = EpilogRules.applyFinalClear(data, os.time())
	PlayerService.markDirty(player)
	if started then
		MapService.setSummit(player, true, true)
		task.spawn(EpilogService.beginFull, player)
	end
	return started, "ok"
end

function EpilogService.debugReset(player: Player)
	local data = PlayerService.getData(player)
	if not data then return end
	EpilogService.cancelSequence(player)
	EpilogService.cancelFinale(player)
	EpilogRules.reset(data.epilog)
	MapService.setSummit(player, false)
	_tokens[player] = nil
	_lastStartClock[player] = nil
	EpilogService.releaseDeferred(player)
	PlayerService.markDirty(player)
end

-- launch: spielt das Knopf-Finale (Prompt 6) von hier aus: baut bei Bedarf Gipfel, Insel,
-- Bruecke und Terminal sofort, setzt den Avatar vor das Terminal und loest den Knopf aus.
-- `launch fast`: wie bisher nur Spielstand (launched + Welt 2), ohne Finale (Folgen testen).
function EpilogService.debugLaunch(player: Player, mode: string?): boolean
	local data = PlayerService.getData(player)
	if not data then return false end
	local state = EpilogService.getState(data)
	if state == S.LAUNCHED then return false end
	if state == S.NONE then
		EpilogRules.applyFinalClear(data, os.time())
		state = S.PENDING
	end
	if mode == "fast" then
		if state == S.PENDING then
			EpilogRules.transition(data.epilog, S.SEEN, os.time())
		end
		MapService.setSummit(player, false)   -- ohne Finale: Gipfel sofort weg
		return EpilogService.markLaunched(player)
	end
	if _fin[player] then return false end
	if not MapService.hasSummit(player) then MapService.setSummit(player, true, false) end
	if not MapService.hasIsland(player) then MapService.buildIsland(player, false) end
	if not MapService.isBridgeComplete(player) then MapService.buildBridgeInstant(player) end
	if not MapService.hasTerminal(player) then MapService.buildTerminal(player) end
	EpilogService.placeOnIsland(player, 5)
	MapService.setTerminalState(player, EpilogConfig.TERMINAL.STATE.ARMED)
	return EpilogService.startFinale(player, "debug", true)
end

-- summit [off]: Gipfel ohne Zustandswechsel bauen/entfernen (Test).
function EpilogService.debugSummit(player: Player, on: boolean): boolean
	local ok = MapService.setSummit(player, on, true)
	if ok and on then task.spawn(EpilogService.teleportWhenReady, player) end
	return ok
end

-- bridge [instant|off]: Insel + Bruecke testen (verlangt state pending/seen,
-- also vorher `epilog start`). Setzt den Avatar auf den Gipfel und laesst die
-- Bruecke wachsen; "instant" baut sofort, "off" baut animiert ab.
function EpilogService.debugBridge(player: Player, act: string): (boolean, string)
	local data = PlayerService.getData(player)
	if not data then return false, "no_data" end
	if act == "bridgeoff" then
		MapService.removeIsland(player, true)
		return true, "removing"
	end
	if not bridgeAllowed(player) then
		return false, "state_not_pending_or_seen (epilog start first)"
	end
	if not MapService.hasSummit(player) then
		MapService.setSummit(player, true, false)
	end
	if act == "bridgeinstant" then
		MapService.buildIsland(player, false)
		local ok, why = MapService.buildBridgeInstant(player)
		task.spawn(EpilogService.teleportWhenReady, player)
		return ok, why
	end
	task.spawn(function()
		EpilogService.teleportWhenReady(player)
		EpilogService.runBridgeSequence(player)
	end)
	return true, "started"
end

-- terminal [zustand]: Terminal testen (verlangt state pending/seen). Ohne Zustand:
-- `ready`. "fired" spielt die Ausloese-Animation (erst armed, dann fired). Baut bei
-- Bedarf Gipfel, Insel und Bruecke sofort. Speichert nichts.
function EpilogService.debugTerminal(player: Player, wanted: string?): (boolean, string)
	local ST = EpilogConfig.TERMINAL.STATE
	local data = PlayerService.getData(player)
	if not data then return false, "no_data" end
	if wanted == "off" then
		EpilogTerminalBuilder.destroy(player)
		return true, "removed"
	end
	if not bridgeAllowed(player) then
		return false, "state_not_pending_or_seen (epilog start first)"
	end
	local target = wanted or ST.READY
	local valid = false
	for _, v in ST do if v == target then valid = true end end
	if not valid then return false, "unknown_state" end
	if not MapService.hasSummit(player) then MapService.setSummit(player, true, false) end
	if not MapService.hasIsland(player) then MapService.buildIsland(player, false) end
	if not MapService.isBridgeComplete(player) then MapService.buildBridgeInstant(player) end
	if not MapService.hasTerminal(player) then MapService.buildTerminal(player) end
	if not MapService.hasTerminal(player) then return false, "terminal_not_built" end
	if target == ST.FIRED then
		MapService.setTerminalState(player, ST.ARMED)
		task.delay(EpilogConfig.TERMINAL.debugArmedSeconds, function()
			if MapService.hasTerminal(player) then MapService.setTerminalState(player, ST.FIRED) end
		end)
		return true, "armed -> fired"
	end
	MapService.setTerminalState(player, target)
	return true, target
end

-- speed N: Zeitraffer fuer den naechsten Start (0,5 bis 5). Zeitplan, Lauf und Kamera
-- laufen dann N-mal so schnell; das Token wird zurueckdatiert, damit EpilogSeen durchgeht.
function EpilogService.debugSpeed(player: Player, value: any): number
	local n = tonumber(value)
	_speed[player] = if n then clampSpeed(n) else nil
	return _speed[player] or 1
end

-- audit: fragt den Client nach Kamera-, Lighting-, Steuerungs- und Verbindungszustand
-- (muss nach jedem Durchlauf sauber sein) und haengt den Serverstand an.
function EpilogService.debugAudit(player: Player): { [string]: any }
	local waiting = { thread = coroutine.running(), done = false }
	_auditWait[player] = waiting
	Remotes.EpilogDebug:FireClient(player, { cmd = "audit" })
	task.delay(3, function()
		if _auditWait[player] == waiting and not waiting.done then
			waiting.done = true
			_auditWait[player] = nil
			task.spawn(waiting.thread, { fehler = "no_client_reply" })
		end
	end)
	local report = coroutine.yield()
	local seq = _seq[player]
	return {
		client = report,
		server = {
			fahrtLaeuft = seq ~= nil,
			uebersprungen = seq ~= nil and seq.skipped,
			angekommen = seq ~= nil and seq.arrived,
			zeitraffer = _speed[player] or 1,
			endlessGehalten = _deferred[player] ~= nil,
			finaleLaeuft = _fin[player] ~= nil,
			finalePhase = if _fin[player] then _fin[player].phase else nil,
		},
	}
end

-- Gibt das aktuelle Token zurueck (nur Studio-Test der Remotes).
function EpilogService.debugToken(player: Player): any
	local entry = _tokens[player]
	return if entry then entry.id else nil
end

-- Sicherungs-Scan: Spieler mit Final-Rekord >= 100, aber Zustand "none"
-- (z. B. Flag war beim Sieg aus). Meldet nur, aendert nichts.
function EpilogService.debugScan(player: Player, data: Types.PlayerData): { [string]: any }
	local def = TowerConfig.get(EpilogConfig.TOWER_ID)
	local record = data.towers.records[EpilogConfig.TOWER_ID] or 0
	return {
		finalRekord   = record,
		endlessOffen  = data.towers.unlocked.Endless == true,
		endlessRekord = data.towers.records.Endless or 0,
		epilogState   = EpilogService.getState(data),
		luecke        = def ~= nil and record >= def.stages and EpilogService.getState(data) == S.NONE,
		welt2         = data.worlds.unlocked[EpilogConfig.WORLD2_ID] == true,
		verworfen     = _rejectedTotal,
		-- Prompt 2
		gipfel        = MapService.hasSummit(player),
		gipfelTeile   = MapService.countSummitParts(player),
		turmGehalten  = MapService.getTowerHold(player),
		reste         = MapService.epilogLeftover(player),
		-- Prompt 3
		insel         = MapService.hasIsland(player),
		bruecke       = MapService.isBridgeComplete(player),
		brueckeWaechst = MapService.isBridgeGrowing(player),
		inselTeile    = (MapService.countIslandParts(player)),
		brueckenTeile = select(2, MapService.countIslandParts(player)),
		workspace     = EpilogIslandBuilder.scanWorkspace(),
		-- Prompt 4
		terminal      = MapService.hasTerminal(player),
		terminalZustand = MapService.getTerminalState(player),
		terminalTeile = MapService.countTerminalParts(player),
		-- Prompt 6
		finaleLaeuft  = _fin[player] ~= nil,
		raketeTeile   = MapService.countRocketParts(player),
	}
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function EpilogService.init()
	RateLimiter.connect(Remotes.EpilogSeen, "EpilogSeen", function(player, token: any)
		handleSeen(player, token)
	end)
	RateLimiter.connect(Remotes.EpilogSkip, "EpilogSkip", function(player, token: any)
		handleSkip(player, token)
	end)
	RateLimiter.connect(Remotes.RequestPressLaunch, "RequestPressLaunch", function(player, token: any)
		handlePress(player, token)
	end)

	-- Prompt 5 (Debug): Bericht des Clients, nur wenn der Server ihn angefordert hat.
	RateLimiter.connect(Remotes.EpilogDebugReport, "EpilogDebugReport", function(player, report: any)
		local waiting = _auditWait[player]
		if not waiting or waiting.done or typeof(report) ~= "table" then return end
		waiting.done = true
		_auditWait[player] = nil
		task.spawn(waiting.thread, report)
	end)

	-- Prompt 3: die Bruecke wird nur gebaut, solange der Zustand es erlaubt.
	EpilogIslandBuilder.setGuard(bridgeAllowed)
	-- Prompt 4: Terminal-Prompt nur bei erlaubtem Zustand; Startwunsch geht an onLaunchRequested.
	EpilogTerminalBuilder.setAccessCheck(bridgeAllowed)
	EpilogTerminalBuilder.setLaunchHandler(function(player: Player)
		EpilogService.onLaunchRequested(player)
	end)

	-- Wiedereinstieg: NACH allen onDataLoaded (Plot und Charakter stehen dann).
	PlayerService.onPlayerReady(function(player, _data)
		EpilogService.restore(player)
	end)

	-- Cleanup: Token/Cache frei. Die Sequenz ueberlebt das Verlassen nur ueber
	-- den gespeicherten Zustand.
	Players.PlayerRemoving:Connect(function(player)
		EpilogService.cancelSequence(player)
		EpilogService.cancelFinale(player)
		_lastPress[player] = nil
		_speed[player] = nil
		_auditWait[player] = nil
		_tokens[player] = nil
		_lastStartClock[player] = nil
		_deferred[player] = nil
		_rejected[player] = nil
	end)

	print("[EpilogService] Initialisiert | Schalter", EpilogConfig.FLAG, "=", isEnabled())
end

return EpilogService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">MapService</string><ProtectedString name="Source"><![CDATA[--!strict
-- MapService.luau
-- ServerScriptService/Services/MapService.luau
--
-- Einzige Zustaendigkeit:
--   - Die einzige Schnittstelle zur gebauten Welt: Welt beim Start bauen
--     lassen, Spieler-Plots vergeben, spawnen, neu aufbauen und despawnen,
--     und die sichtbaren Teile aktuell halten (Schilder, Figur, Teich, Eier,
--     Lauf-Turm, Tower-Turm, Event-Pit)
--
-- Das eigentliche BAUEN steht in den Modulen unter Util/MapBuild (MapParts,
-- WorldBuilder, PlotBuilder, PondBuilder, ArenaBuilder, FigureBuilder,
-- LaidEggBuilder). Dieser Service haelt den Zustand (welcher Spieler welchen
-- Slot und welches Plot-Model hat) und entscheidet, WANN gebaut wird. Andere
-- Services sprechen nur mit MapService, nie mit den Buildern.
--
-- Baut physische Roblox-Parts aus IslandData.
-- Kennt keine Spielerdaten ausser IslandData (und den Namen fuer das Schild).
--
-- Alle Masse, Farben und Offsets kommen aus MapConfig. Wie das plot-lokale
-- Koordinatensystem funktioniert (lokales -Z = Richtung Mitte, +Z = nach
-- aussen), steht im Kopf von MapConfig.
--
-- ZWEI ARTEN VON AKTUALISIERUNG — bewusst getrennt:
--   * NEU BAUEN (updateBaerchis, updateBuildingLooks, updateTowerShowcase):
--     teuer, nur wenn sich die Struktur aendert (ein Baerchi kommt dazu, faellt
--     weg oder steigt im Level; ein Gebaeude wechselt den Look; der Tower-Turm
--     bekommt einen neuen Look oder Rekord).
--   * IN-PLACE (updateBaerchiStates, updateBuildingSigns): billig, aendert nur
--     Beschriftung und Transparenz an bereits stehenden Teilen. Dafuer gibt es
--     die Trennung: HP und Honig aendern sich staendig, und dafuer jedes Mal
--     25 Mesh-Figuren neu zu bauen waere Verschwendung.
--   PlotDisplayService entscheidet welche der beiden noetig ist.
--
-- NEUAUFBAU WAEHREND EINER BEWEGUNG — die eine Sperre in dieser Datei:
-- updateBaerchis zerstoert die Figur und baut sie neu. Laeuft sie in dem
-- Moment gerade (Kampf-Lauf oder Weg zum Honig-Teich), verschwaende sie mitten
-- im Schritt. Die Pruefung dagegen steht EINMAL hier drin statt an jeder
-- Aufrufstelle — und der uebersprungene Neuaufbau wird nachgeholt, sobald das
-- Schloss frei ist (siehe scheduleRebuildWhenFree weiter unten). Ohne das
-- Nachholen bliebe die Beschriftung dauerhaft veraltet, weil der Aufrufer
-- (PlotDisplayService) den neuen Stand direkt danach als "dargestellt" merkt.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig = require(ReplicatedStorage.Config.MapConfig)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types     = require(ReplicatedStorage.Network.Types)
local WorldText = require(ReplicatedStorage.Localization.WorldText)
local Loc       = require(ReplicatedStorage.Localization.Loc)

local ActivityLock = require(ServerScriptService.Util.ActivityLock)
local FigureFX     = require(ServerScriptService.Util.FigureFX)

local MapBuild       = ServerScriptService.Util.MapBuild
local MapParts       = require(MapBuild.MapParts)
local WorldBuilder   = require(MapBuild.WorldBuilder)
local PlotBuilder    = require(MapBuild.PlotBuilder)
local PondBuilder    = require(MapBuild.PondBuilder)
local ArenaBuilder   = require(MapBuild.ArenaBuilder)
local FigureBuilder  = require(MapBuild.FigureBuilder)
local LaidEggBuilder = require(MapBuild.LaidEggBuilder)
local IncubatorConfig = require(ReplicatedStorage.Config.IncubatorConfig)
local RecyclerBuilder = require(MapBuild.RecyclerBuilder)
local IncubatorBuilder = require(MapBuild.IncubatorBuilder)   -- Sammel-Update Paket 8
local TerminalBuilder  = require(MapBuild.TerminalBuilder)    -- 08.10. Tower-Terminal
local EpilogSummitBuilder = require(MapBuild.EpilogSummitBuilder)   -- 20.10. Final-Epilog: Gipfel
local EpilogIslandBuilder = require(MapBuild.EpilogIslandBuilder)   -- 20.10. Final-Epilog: Insel + Bruecke
local EpilogTerminalBuilder = require(MapBuild.EpilogTerminalBuilder)   -- 20.10. Final-Epilog: Start-Terminal
local EpilogFinaleBuilder = require(MapBuild.EpilogFinaleBuilder)   -- 20.10. Final-Epilog P6: Rakete

--------------------------------------------------------------------------------
-- Interner Zustand
--------------------------------------------------------------------------------

-- Welcher Slot gehoert welchem Spieler
local _playerSlot: { [Player]: number } = {}

-- Alle gespawnten Plot-Models, key = Player
local _plotModels: { [Player]: Model } = {}

-- Verfuegbare Slots (1 .. PLOT_COUNT), wird in init() gefuellt
local _freeSlots: { number } = {}

-- Fuer welche Spieler gerade ein Waechter darauf wartet, den wegen
-- ActivityLock uebersprungenen Figuren-Neuaufbau nachzuholen. Verhindert, dass
-- mehrere Datenaenderungen waehrend derselben Bewegung mehrere Warte-Schleifen
-- starten — eine reicht, sie liest am Ende ohnehin frische Daten.
local _pendingRebuild: { [Player]: boolean } = {}

-- Woher der nachgeholte Neuaufbau seine FRISCHEN IslandData bekommt.
--
-- Absichtlich als eingehaengte Funktion statt eines require(PlayerService):
-- PlayerService requiret bereits MapService, der umgekehrte Weg waere ein
-- Ringschluss. Ausserdem bleibt damit die Regel
-- im Kopf dieser Datei gueltig — MapService kennt weiterhin keine
-- Spielerdaten ausser IslandData. Eingehaengt wird sie von
-- PlotDisplayService.init(); ohne sie faellt nur das Nachholen aus.
local _islandDataProvider: ((Player) -> Types.IslandData?)? = nil

-- v15: zuletzt gesetzter Tower-Turm und Tower-Symbol am Plot-Schild pro
-- Spieler. MapService kennt die Tower-Daten nicht (sie liegen ausserhalb von
-- IslandData) — PlotDisplayService setzt beides; gemerkt wird es hier, damit
-- ein Neuaufbau des Plots (Rebirth) Turm und Symbol sofort wieder mitbaut.
local _showcase: { [Player]: ArenaBuilder.ShowcaseView } = {}

-- 20.10. Final-Epilog (Prompt 2): Etagenzahl, auf der der Run-Turm stehen BLEIBT
-- (Gipfel). Solange gesetzt, kann setPitTowerLevel den Turm nicht unter diese
-- Hoehe abbauen. nil = Verhalten wie immer.
local _towerHold: { [Player]: number } = {}
-- Sammel-Update Paket 8: Platz-Zahl des Inkubators (siehe setIncubatorSlotProvider)
local _incubatorSlots: (Player) -> number = function(_player: Player): number return 1 end
type Badge = { text: string, color: Color3 }
local _badge: { [Player]: Badge } = {}
local _crown: { [Player]: boolean } = {}   -- Paket 9: Top 10 der Endless-Woche
-- 08.10.: zuletzt gesetzter Terminal-Zustand (Neuaufbau nach Rebirth baut ihn mit)
local _terminal: { [Player]: TerminalBuilder.TerminalView } = {}

local function badgeText(player: Player, text: string | Types.LocMsg): string | Types.LocMsg
	return if _crown[player] then Loc.msg("fmt.append", { a = "♛", b = text }) else text
end

--------------------------------------------------------------------------------
-- Plot-Inhalt
--------------------------------------------------------------------------------

-- Baut den kompletten Inhalt eines Plots (Gebaeude + Bruecke + PIT + Baerchis).
local function buildPlotContents(plotModel: Model, slot: number, islandData: Types.IslandData, owner: Player)
	local pool = PondBuilder.honeyPool(islandData)
	for _, building in islandData.buildings do
		PlotBuilder.buildBuilding(plotModel, slot, building, pool)
	end

	ArenaBuilder.buildBridge(plotModel, slot)
	ArenaBuilder.buildPit(plotModel, slot)
	-- 20.10. Final-Epilog: ein Neuaufbau (Ausbau, Rebirth) darf den gehaltenen
	-- Turm samt Gipfel nicht verlieren.
	local hold = _towerHold[owner]
	if hold then
		local pit = plotModel:FindFirstChild("PitPlatform")
		local tower = if pit then pit:FindFirstChild("Tower") else nil
		if tower and tower:IsA("Folder") then
			local center = MapParts.pitCenter(slot)
			for i = 1, hold do
				ArenaBuilder.buildTowerRing(tower, center, i)
			end
		end
		EpilogSummitBuilder.build(plotModel, slot, owner, { animate = false })
		-- Prompt 3: Insel und Bruecke wieder auf den Stand von vorher bringen
		EpilogIslandBuilder.restoreAfterRebuild(plotModel)
		EpilogTerminalBuilder.restoreAfterRebuild(plotModel)   -- Prompt 4
	end
	PondBuilder.buildPond(plotModel, slot, islandData)
	RecyclerBuilder.build(plotModel, slot, islandData.recycler)
	-- Sammel-Update Paket 8: Inkubator (Plaetze liefert der Daten-Lieferant,
	-- weil sie auch an Rebirths und Index haengen, die nicht in der Insel stehen).
	if FeatureFlags.isOn("INCUBATOR") and islandData.incubator then
		IncubatorBuilder.build(plotModel, slot, islandData.incubator, _incubatorSlots(owner), islandData.baerchis)
	end
	-- 08.10.: Tower-Terminal am Stegbeginn (Zustand nur als Attribute)
	if FeatureFlags.isOn("TOWER_TERMINAL") then
		TerminalBuilder.build(plotModel, slot, _terminal[owner])
	end
	FigureBuilder.renderBaerchis(plotModel, slot, islandData)
	LaidEggBuilder.renderLaidEggs(plotModel, slot, islandData, owner)

	-- v15: Tower-Turm und Symbol, falls schon bekannt (nach einem Rebirth).
	local view = _showcase[owner]
	if view then
		ArenaBuilder.buildShowcase(plotModel, slot, view)
	end
	local badge = _badge[owner]
	if badge then
		PlotBuilder.writeOwnerBadge(plotModel, badgeText(owner, badge.text), badge.color)
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

local MapService = {}

local function claimSlot(): number?
	if #_freeSlots == 0 then return nil end
	return table.remove(_freeSlots, 1)
end

local function releaseSlot(slot: number)
	table.insert(_freeSlots, slot)
	table.sort(_freeSlots)
end

function MapService.spawnIsland(player: Player, islandData: Types.IslandData)
	-- Alten Slot freigeben falls vorhanden (sollte nicht passieren, aber sicher)
	if _playerSlot[player] then
		MapService.despawnIsland(player)
	end

	local slot = claimSlot()
	if not slot then
		warn("[MapService] Kein freier Plot fuer Spieler:", player.Name)
		return
	end

	_playerSlot[player] = slot

	local plotModel = PlotBuilder.buildPlotBase(slot, player)
	_plotModels[player] = plotModel

	buildPlotContents(plotModel, slot, islandData, player)

	print("[MapService] Plot gespawnt fuer:", player.Name, "| Slot:", slot)
end

-- Baut den Plot eines Spielers komplett neu — behaelt aber seinen Slot,
-- damit er nach einem Rebirth an derselben Stelle der Map steht.
function MapService.rebuildIsland(player: Player, islandData: Types.IslandData)
	local slot = _playerSlot[player]
	if not slot then
		-- Noch kein Plot (z.B. Server voll) → normaler Spawn-Versuch
		MapService.spawnIsland(player, islandData)
		return
	end

	local oldModel = _plotModels[player]
	if oldModel then
		oldModel:Destroy()
	end

	local plotModel = PlotBuilder.buildPlotBase(slot, player)
	_plotModels[player] = plotModel

	buildPlotContents(plotModel, slot, islandData, player)

	print("[MapService] Plot neu aufgebaut fuer:", player.Name, "| Slot:", slot)
end

function MapService.despawnIsland(player: Player)
	-- Ein noch wartender Nachhol-Waechter hat hier nichts mehr zu tun. Er
	-- merkt das zwar selbst beim naechsten Durchlauf (kein Plot mehr), aber so
	-- bleibt kein Eintrag fuer einen laengst gegangenen Spieler stehen.
	_pendingRebuild[player] = nil
	_showcase[player] = nil
	_badge[player] = nil
	_crown[player] = nil
	_terminal[player] = nil
	_towerHold[player] = nil
	EpilogTerminalBuilder.destroy(player)
	EpilogIslandBuilder.destroy(player)
	EpilogSummitBuilder.destroy(player)

	local model = _plotModels[player]
	if model then
		model:Destroy()
		_plotModels[player] = nil
	end

	local slot = _playerSlot[player]
	if slot then
		releaseSlot(slot)
		_playerSlot[player] = nil
	end
end

-- (v15: updatePitLevel ist entfallen — es gibt kein PIT-Level mehr. Der Turm
-- auf der Arena-Insel zeigt jetzt den Tower-Rekord, siehe updateTowerShowcase.)

-- v15: den Tower-Turm auf der Arena-Insel (neu) bauen. Aufrufer ist
-- PlotDisplayService, und nur wenn sich Look oder Rekord geaendert haben
-- (Signatur). `show` = der LOOK hat gewechselt: kurze Aufwertungs-Show (ein
-- Partikel-Stoss an der Spitze, < 2 s).
function MapService.updateTowerShowcase(player: Player, view: ArenaBuilder.ShowcaseView, show: boolean?)
	_showcase[player] = view

	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end

	local built = ArenaBuilder.buildShowcase(model, slot, view)
	if show then
		local foot = ArenaBuilder.showcaseFoot(slot)
		local height = MapConfig.TOWER_SHOWCASE.plinthHeight + view.floors * MapConfig.TOWER_SHOWCASE.floorHeight
		FigureFX.burstAt(foot + Vector3.new(0, height + 2, 0), view.color, built, 60)
	end
end

-- v15: Tower-Symbol unter dem Namen auf dem Plot-Schild ("◆ III · 42").
function MapService.setOwnerBadge(player: Player, text: string | Types.LocMsg, color: Color3)
	_badge[player] = { text = text, color = color }
	local model = _plotModels[player]
	if model then
		PlotBuilder.writeOwnerBadge(model, badgeText(player, text), color)
	end
end

-- Paket 9: Krone vor dem Plot-Symbol fuer die Top 10 der Endless-Woche.
-- Aufrufer ist LeaderboardService (kennt die Wochenliste).
function MapService.setOwnerCrown(player: Player, crowned: boolean)
	if (_crown[player] == true) == crowned then return end
	_crown[player] = if crowned then true else nil
	local badge = _badge[player]
	local model = _plotModels[player]
	if badge and model then
		PlotBuilder.writeOwnerBadge(model, badgeText(player, badge.text), badge.color)
	end
end

-- Farbe der kurzen Aufwertungs-Show beim Look-Wechsel (v15).
local LOOK_UPGRADE_COLOR = Color3.fromRGB(255, 220, 110)
local LOOK_UPGRADE_SPARKS = 40

-- v15: baut ein Gebaeude (oder den Recycler) NUR neu, wenn sich sein Look
-- geaendert hat (Attribut "Look" am Koerper gegen BuildingBehavior.getLook).
-- PlotDisplayService ruft das, wenn die Look-Signatur wechselt; Level-Aenderungen
-- innerhalb eines Looks laufen ueber das billige updateBuildingSigns.
-- `show` = kurze Aufwertungs-Show (ein Partikel-Stoss, < 2 s).
function MapService.updateBuildingLooks(player: Player, islandData: Types.IslandData, show: boolean?)
	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end

	local pool = PondBuilder.honeyPool(islandData)
	for _, building in islandData.buildings do
		local part = model:FindFirstChild(building.id)
		local look = BuildingBehavior.getLook(building.level)
		if part and part:IsA("BasePart") and part:GetAttribute("Look") ~= look then
			local position = part.Position
			part:Destroy()
			PlotBuilder.buildBuilding(model, slot, building, pool)
			if building.id == "HoneyPond" then
				PondBuilder.buildPond(model, slot, islandData)
			end
			if show then
				FigureFX.burstAt(position, LOOK_UPGRADE_COLOR, model, LOOK_UPGRADE_SPARKS)
			end
		end
	end

	local body = model:FindFirstChild(CombConfig.RECYCLER_NAME)
	local recyclerLook = BuildingBehavior.getLook(islandData.recycler.level)
	if body and body:IsA("BasePart") and body:GetAttribute("Look") ~= recyclerLook then
		local position = body.Position
		body:Destroy()
		RecyclerBuilder.build(model, slot, islandData.recycler)
		if show then
			FigureFX.burstAt(position, LOOK_UPGRADE_COLOR, model, LOOK_UPGRADE_SPARKS)
		end
	end
end

-- Haengt die Quelle fuer frische IslandData ein (siehe _islandDataProvider).
-- Wird einmal beim Start von PlotDisplayService aufgerufen.
function MapService.setIslandDataProvider(provider: (Player) -> Types.IslandData?)
	_islandDataProvider = provider
end

-- Wartet, bis die Figur des Spielers nicht mehr in einer Bewegung steckt, und
-- baut sie dann mit FRISCH gelesenen Daten neu.
--
-- Frisch gelesen ist der entscheidende Teil: waehrend der Bewegung koennen
-- weitere Aenderungen anfallen (mehrere Level-Ups waehrend eines Ess-Zyklus),
-- und nach einem Rebirth ist die alte IslandData-Tabelle gar nicht mehr die
-- des Spielers — sie einfach aufzuheben und spaeter nochmal zu rendern wuerde
-- einen veralteten Stand in die Welt stellen.
local function scheduleRebuildWhenFree(player: Player)
	if _pendingRebuild[player] then return end
	_pendingRebuild[player] = true

	task.spawn(function()
		local interval = MapConfig.FIGURE_REBUILD_RETRY_SECONDS
		local waited   = 0

		while waited < MapConfig.FIGURE_REBUILD_TIMEOUT_SECONDS do
			task.wait(interval)
			waited += interval

			-- Spieler weg oder Plot abgeraeumt: es gibt nichts mehr nachzuholen.
			if player.Parent == nil or _plotModels[player] == nil then
				break
			end

			if ActivityLock.isFree(player) then
				local provider = _islandDataProvider
				local island   = if provider then provider(player) else nil

				-- Vor dem erneuten Aufruf freigeben: updateBaerchis darf, falls
				-- inzwischen doch wieder eine Bewegung laeuft, sauber einen
				-- neuen Waechter starten.
				_pendingRebuild[player] = nil

				if island then
					MapService.updateBaerchis(player, island)
				end
				return
			end
		end

		_pendingRebuild[player] = nil
	end)
end

-- Baut die sichtbaren Baerchis eines Spielers NEU. Teuer — nur aufrufen wenn
-- sich der Bestand oder ein Level geaendert hat (siehe PlotDisplayService).
--
-- Steckt die Figur gerade in einer Bewegung, wird der Neuaufbau verschoben
-- statt sie mitten im Schritt zu ersetzen (Begruendung im Kopf der Datei).
function MapService.updateBaerchis(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	if not ActivityLock.isFree(player) then
		scheduleRebuildWhenFree(player)
		return
	end

	FigureBuilder.renderBaerchis(model, slot, islandData)
	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- 14.10. (Befehle jederzeit): Baut die Figur SOFORT neu — ohne auf eine laufende
-- Bewegung zu warten. Nur fuer den Fall, dass der Aufrufer die Bewegung vorher
-- selbst beendet hat (Ausruesten eines anderen Baerchis: die alte Figur wird
-- verworfen, die neue steht am Heimplatz). Alle anderen Aenderungen laufen ueber
-- updateBaerchis bzw. updateBaerchiLabels und fassen die Figur nicht an.
function MapService.replaceBaerchis(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	FigureBuilder.renderBaerchis(model, slot, islandData)
	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- 14.10.: Namensschild (Level, Mutations-Kuerzel) der stehenden Figur nachziehen.
-- Billig und ohne ActivityLock-Pruefung: die Figur wird nicht bewegt oder
-- ersetzt, ein Level-Aufstieg darf also auch mitten auf einem Weg sichtbar werden.
function MapService.updateBaerchiLabels(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return end

	for _, baerchi in islandData.baerchis do
		local figure = folder:FindFirstChild("Baerchi_" .. baerchi.uid)
		if figure and figure:IsA("Model") then
			FigureBuilder.writeBaerchiName(figure, baerchi)
		end
	end
end

-- 14.10.: Heimplatz des ausgeruesteten Baerchis (Fusspunkt, Plot-Ausrichtung).
-- Davon laufen alle Wege aus und dorthin kehren sie zurueck — unabhaengig davon,
-- wo die Figur gerade steht, wenn ein Weg beginnt (Umlenken mitten im Lauf).
function MapService.getBaerchiHome(player: Player): (Vector3?, CFrame?)
	local slot = _playerSlot[player]
	if not slot then return nil, nil end
	return FigureBuilder.homeFoot(slot)
end

-- Baut die herumliegenden Eier eines Spielers neu.
--
-- Anders als updateBaerchis KEINE ActivityLock-Pruefung: Eier bewegen sich
-- nicht und gehoeren niemandem, der sie gerade animiert. Sie duerfen deshalb
-- auch mitten in einem Kampf oder Weg zum Teich erscheinen und verschwinden —
-- genau das muss sogar sein, weil der Baerchi WAEHREND er laeuft legt.
function MapService.updateLaidEggs(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- Haengt den Ei-Einsammel-Handler ein: er laeuft, wenn der BESITZER eines
-- Plots sein eigenes gelegtes Ei mit der Spielfigur beruehrt. Wird einmal
-- beim Start von EggLayService aufgerufen (Pull-Callback statt require:
-- EggLayService requiret bereits MapService, der umgekehrte Weg waere ein
-- Ringschluss). Ohne Handler sammelt Beruehren einfach nichts ein.
-- 14.10.: alle gelegten Eier (Part, Besitzer, uid) durchlaufen (fuer den Sammel-Sweep).
function MapService.forEachLaidEgg(fn: (BasePart, Player, string) -> ())
	LaidEggBuilder.forEachLaid(fn)
end

function MapService.setEggCollectHandler(handler: (Player, string) -> ())
	LaidEggBuilder.setCollectHandler(handler)
end

-- Rechnet eine Weltposition in das Koordinatensystem des Plots um.
--
-- Gelegte Eier werden PLOT-RELATIV gespeichert, nicht in Weltkoordinaten. Der
-- Grund: welchen der acht Plots ein Spieler bekommt, entscheidet sich bei
-- jedem Join neu (siehe _freeSlots). Absolute Positionen wuerden nach einem
-- Rejoin auf einem anderen Plot liegen — im schlimmsten Fall auf dem eines
-- Nachbarn.
function MapService.worldToPlot(player: Player, worldPosition: Vector3): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end

	local plotCFrame = MapParts.plotCFrame(slot)
	if not plotCFrame then return nil end

	return plotCFrame:PointToObjectSpace(worldPosition)
end

-- Aktualisiert nur Beschriftung und Erschoepfung der bereits stehenden
-- Figuren. Billig — das ist der Weg fuer HP-Aenderungen.
function MapService.updateBaerchiStates(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return end

	for _, baerchi in islandData.baerchis do
		local figure = folder:FindFirstChild("Baerchi_" .. baerchi.uid)
		if figure and figure:IsA("Model") then
			FigureBuilder.writeBaerchiState(figure, baerchi, FigureBuilder.maxHpOf(baerchi))
		end
	end
end

-- Aktualisiert das Level-Attribut einer Gebaeude-Part (fuer Client-UI).
-- Wird nach einem Gebaeude-Upgrade aufgerufen; baut nichts neu.
function MapService.updateBuildingLevel(player: Player, buildingId: Types.BuildingId, level: number)
	local model = _plotModels[player]
	if not model then return end

	local part = model:FindFirstChild(buildingId)
	if part then
		part:SetAttribute("BuildingLevel", level)
	end
end

-- Wohin der Baerchi zum Fressen laeuft.
--
-- Das ist der Standplatz VOR dem Becken (auf den Bohlen), nicht mehr die
-- Beckenmitte. Bis der Teich ein richtiges Becken wurde, war beides dasselbe
-- — und der Baerchi stand mitten im Teich. Jetzt stuende er bis zum Bauch im
-- Beckenboden.
function MapService.getPondPosition(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	-- NEW_MODELS_V3: der Baerchi trinkt vom Steg des Brunnen-Meshs, mitten
	-- ueber dem Honig (Steg liegt ~1.5 Studs hoch, Mitte bei 6.3 von der
	-- Beckenmitte). Heimplatz bleibt vor dem Steg (MapLayout.baerchiHomeOffset).
	local RS = game:GetService("ReplicatedStorage")
	if require(RS.Config.FeatureFlags).isOn("NEW_MODELS_V3")
		and RS:FindFirstChild("Assets") and RS.Assets:FindFirstChild("Fountains") then
		local k = PondBuilder.standFactor(_plotModels[player])
		return (PondBuilder.pondGround(slot) * CFrame.new(0, 1.5 * k, -6.3 * k)).Position
	end
	return PondBuilder.pondStand(slot).Position
end

-- Mitte des Beckens (Weltposition) — z. B. damit gelegte Eier nicht im Honig
-- landen, seit der Baerchi am Becken wohnt (HONEY_POND_V2).
function MapService.getPondCenter(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return PondBuilder.pondGround(slot).Position
end

-- Fuellstand des Teichs nachziehen. Billig — das ist der Weg fuer
-- Honig-Aenderungen (siehe MapService.updateBuildingSigns, das das mit
-- aufruft, weil beides an denselben Werten haengt).
function MapService.updatePondFill(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	local pond = model:FindFirstChild("Pond")
	if not pond then return end

	-- Ausbau macht den Brunnen groesser
	local building = islandData.buildings["HoneyPond" :: any]
	if building then PondBuilder.growFountain(model, building.level) end

	local fill = pond:FindFirstChild("Fuellung")
	if fill and fill:IsA("BasePart") then
		PondBuilder.writePondFill(fill, PondBuilder.pondGround(slot), PondBuilder.pondFillRatio(islandData))
	end
end

-- Schreibt Level und Honig-Lagerstand auf die Gebaeude-Schilder.
-- Billig — das ist der Weg fuer Honig-Aenderungen.
function MapService.updateBuildingSigns(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local pool = PondBuilder.honeyPool(islandData)

	for _, building in islandData.buildings do
		local part = model:FindFirstChild(building.id)
		if part and part:IsA("BasePart") then
			part:SetAttribute("BuildingLevel", building.level)
			PlotBuilder.writeBuildingState(part, building, pool)
		end
	end

	-- Haengt an denselben Werten wie die Gebaeude-Schilder — deshalb hier
	-- gleich mit erledigt statt eines eigenen Aufrufers in PlotDisplayService.
	MapService.updatePondFill(player, islandData)
end

-- Sammel-Update Paket 8: Inkubator-Stand schreiben (Eier, Zeitmarken,
-- verfuegbare Plaetze). Billig; fehlt das Modell, wird es gebaut.
function MapService.updateIncubator(player: Player, islandData: Types.IslandData, slotCount: number)
	if not FeatureFlags.isOn("INCUBATOR") or not islandData.incubator then return end
	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end
	local existing = model:FindFirstChild(IncubatorConfig.MODEL_NAME)
	if existing and existing:IsA("Model") and not IncubatorBuilder.needsRebuild(existing, islandData.incubator) then
		IncubatorBuilder.writeState(existing, islandData.incubator, slotCount, islandData.baerchis)
	else
		IncubatorBuilder.build(model, slot, islandData.incubator, slotCount, islandData.baerchis)
	end
end

-- INCUBATOR_BREED: das Inkubator-Modell auf dem Plot des Spielers (Ort der
-- gebrueteten Eier), oder nil.
function MapService.getIncubatorModel(player: Player): Model?
	local model = _plotModels[player]
	local found = if model then model:FindFirstChild(IncubatorConfig.MODEL_NAME) else nil
	return if found and found:IsA("Model") then found else nil
end

-- Liefert die Platz-Zahl des Inkubators (setzt PlotDisplayService, weil sie
-- auch an Rebirths und Index-Belohnungen haengt).
function MapService.setIncubatorSlotProvider(provider: (Player) -> number)
	_incubatorSlots = provider
end

-- 08.10.: Zustand des Tower-Terminals (Attribute, kein Neubau). Aufrufer ist
-- PlotDisplayService bei geaenderter Signatur.
function MapService.updateTerminal(player: Player, view: TerminalBuilder.TerminalView)
	_terminal[player] = view
	local model = _plotModels[player]
	local terminal = if model then model:FindFirstChild(TerminalBuilder.MODEL_NAME) else nil
	if terminal and terminal:IsA("Model") then
		TerminalBuilder.writeState(terminal, view)
	end
end

-- Schreibt Level, Warteschlange und Lampe des Waben-Recyclers neu.
-- Billig — der Weg fuer jede Aenderung der Warteschlange.
function MapService.updateRecycler(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local body = model:FindFirstChild(CombConfig.RECYCLER_NAME)
	if body and body:IsA("BasePart") then
		RecyclerBuilder.writeState(body, islandData.recycler)
	end
end

-- Die Anzeigetafel ueber der Arena. Bewusst ueber den exakten Pfad gesucht und
-- nicht rekursiv: unter dem Plot haengen bis zu 25 importierte Mesh-Figuren,
-- deren Teilenamen aus einer .glb stammen und die wir nicht kontrollieren.
-- Eine rekursive Suche wuerde bei einem gleichnamigen Teil das Falsche finden
-- — und muesste bei jeder der bis zu 60 Stages den ganzen Baum durchlaufen.
local function findPitBanner(player: Player): BillboardGui?
	local model = _plotModels[player]
	if not model then return nil end

	local platform = model:FindFirstChild("PitPlatform")
	if not platform then return nil end

	local anchor = platform:FindFirstChild("PitBannerAnchor")
	if not anchor then return nil end

	local banner = anchor:FindFirstChild("Banner")
	return if banner and banner:IsA("BillboardGui") then banner else nil
end

-- Die Anzeigetafel ueber der Arena beschriften und einblenden.
-- Aufgerufen von PitArenaService waehrend einer Wiedergabe; MapService kennt
-- den Kampfverlauf nicht und entscheidet deshalb nichts ueber den Inhalt.
-- Titel und Untertitel duerfen Nachrichten (LocMsg) sein: die Tafel sieht
-- jeder Spieler, und jeder liest sie in seiner Sprache (siehe WorldText).
function MapService.setPitBanner(player: Player, title: string | Types.LocMsg, subtitle: string | Types.LocMsg, color: Color3)
	local banner = findPitBanner(player)
	if not banner then return end

	local titleLabel = banner:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		WorldText.set(titleLabel, title)
		titleLabel.TextColor3 = color
	end

	local subLabel = banner:FindFirstChild("Sub")
	if subLabel and subLabel:IsA("TextLabel") then
		WorldText.set(subLabel, subtitle)
	end

	banner.Enabled = true
end

-- Tafel wieder ausblenden. Idempotent — ein zweiter Aufruf schadet nicht.
function MapService.clearPitBanner(player: Player)
	local banner = findPitBanner(player)
	if banner then
		banner.Enabled = false
	end
end

--------------------------------------------------------------------------------
-- Event-Pit: Farbe und Anzeigetafel von aussen setzbar (EventService)
--------------------------------------------------------------------------------

-- Anders als findPitBanner gibt es das Event-Pit nur EINMAL fuer die ganze
-- Welt, nicht pro Spieler — keine Player-Suche noetig.
local function findEventPitContainer(): Model?
	local platform = workspace:FindFirstChild("Platform")
	if not platform then return nil end

	local pit = platform:FindFirstChild("EventPit")
	return if pit and pit:IsA("Model") then pit else nil
end

export type EventTheme = {
	floorColor : Color3,
	fenceColor : Color3,
	ringColor  : Color3,
}

-- Faerbt Boden, Zaun und Ring des Event-Pits um. Mit `theme = nil` kehrt es
-- zum schlichten Stall-Look zurueck (siehe MapConfig, EVENT_PIT_DEFAULT_*).
-- EventService ruft das genau zweimal pro Zyklus: einmal beim Start eines
-- Events mit dessen Farben, einmal beim Ende mit nil.
function MapService.setEventPitTheme(theme: EventTheme?)
	local container = findEventPitContainer()
	if not container then return end

	local floorColor = if theme then theme.floorColor else MapConfig.EVENT_PIT_DEFAULT_FLOOR_COLOR
	local fenceColor = if theme then theme.fenceColor else MapConfig.EVENT_PIT_DEFAULT_FENCE_COLOR
	local ringColor  = if theme then theme.ringColor  else MapConfig.EVENT_PIT_DEFAULT_RING_COLOR

	-- Material wechselt mit: Wood/SmoothPlastic im Stall-Look, Neon waehrend
	-- eines Events — sonst saehe man den Farbwechsel bei Zaun und Ring kaum,
	-- weil beide im Stall-Look bewusst matt sind.
	local activeMaterial = if theme then Enum.Material.Neon else Enum.Material.Wood
	local ringMaterial   = if theme then Enum.Material.Neon else Enum.Material.SmoothPlastic

	local floor = container:FindFirstChild("EventFloor")
	if floor and floor:IsA("BasePart") then
		floor.Color = floorColor
	end

	local ring = container:FindFirstChild("EventRing")
	if ring and ring:IsA("BasePart") then
		ring.Color    = ringColor
		ring.Material = ringMaterial
	end

	for _, child in container:GetChildren() do
		if child.Name:match("^EventFence_") and child:IsA("BasePart") then
			child.Color    = fenceColor
			child.Material = activeMaterial
		end
	end
end

-- Beschriftet die Countdown-Tafel ueber dem Event-Pit. Anders als
-- setPitBanner blendet das hier NICHT ein/aus — die Tafel steht permanent
-- (siehe buildEventPit): sie zeigt entweder den Countdown bis zum naechsten
-- Event oder Name + Restzeit des laufenden.
function MapService.setEventBanner(title: string | Types.LocMsg, subtitle: string | Types.LocMsg, color: Color3, reward: (string | Types.LocMsg)?)
	local container = findEventPitContainer()
	if not container then return end

	local anchor = container:FindFirstChild("EventBannerAnchor")
	if not anchor then return end

	local banner = anchor:FindFirstChild("Banner")
	if not (banner and banner:IsA("BillboardGui")) then return end

	local titleLabel = banner:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		WorldText.set(titleLabel, title)
		titleLabel.TextColor3 = color
	end

	local subLabel = banner:FindFirstChild("Sub")
	if subLabel and subLabel:IsA("TextLabel") then
		WorldText.set(subLabel, subtitle)
	end

	local rewardLabel = banner:FindFirstChild("Reward")
	if rewardLabel and rewardLabel:IsA("TextLabel") then
		WorldText.set(rewardLabel, reward or "")
	end
end

-- Weltposition der PODEST-OBERFLAECHE des Event-Pits in der Weltmitte.
--
-- Anders als getPitPosition NICHT pro Spieler: das Event-Pit gibt es einmal
-- fuer die ganze Welt (siehe findEventPitContainer). EventParticipationService
-- laesst die Figuren aller teilnehmenden Spieler auf dieselbe Flaeche laufen.
--
-- Der Y-Wert ist dieselbe Rechnung wie in buildEventPit (`floorY`), bewusst
-- aus MapConfig neu gerechnet statt aus der gebauten Geometrie gemessen: die
-- Zahl gehoert der Konfiguration, nicht dem Modell.
function MapService.getEventPitPosition(): Vector3
	local center = MapConfig.CENTER
	local floorY = MapConfig.PLATFORM_TOP_Y
		+ MapConfig.EVENT_PIT_GROUND_CLEARANCE
		+ MapConfig.EVENT_PIT_FLOOR_HEIGHT

	return Vector3.new(center.X, floorY, center.Z)
end

-- Radius der begehbaren Event-Flaeche. EventParticipationService prueft damit
-- serverseitig nach, ob eine Figur tatsaechlich noch dort steht, statt sich auf
-- ein gesetztes Flag zu verlassen.
function MapService.getEventPitRadius(): number
	return MapConfig.EVENT_PIT_RADIUS
end

-- Weltposition der Kampfflaeche dieses Spielers.
-- Wird von PitArenaService benoetigt um die Kaempfer zu platzieren.
function MapService.getPitPosition(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return MapParts.pitCenter(slot)
end

-- Das CFrame des Plots (Blickrichtung zur Plattform-Mitte).
-- PitArenaService braucht es, um die Kaempfer sinnvoll auszurichten.
function MapService.getPlotCFrame(player: Player): CFrame?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return MapParts.plotCFrame(slot)
end

-- Die stehende Figur eines Baerchis auf dem Plot, falls vorhanden.
-- PitArenaService schickt genau diese Figur in die Arena und wieder zurueck,
-- statt eine zweite Kopie zu bauen — sonst staende derselbe Baerchi doppelt
-- in der Welt.
function MapService.getBaerchiModel(player: Player, baerchiUid: string): Model?
	local model = _plotModels[player]
	if not model then return nil end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return nil end

	local figure = folder:FindFirstChild("Baerchi_" .. baerchiUid)
	if figure and figure:IsA("Model") then
		return figure
	end
	return nil
end

-- Feiert ein Ereignis (Level-Up, Promotion, Rebirth, ...) SICHTBAR auf dem
-- Plot: Partikel-Stoss, Huepfer, kurzes Aufleuchten (siehe FigureFX.celebrate).
--
-- Bewusst als eigene MapService-Funktion und nicht direkt FigureFX.celebrate
-- vom Aufrufer: der Aufrufer (HoneyService, PromotionService, RebirthService,
-- ...) soll keine Modelle aus der Welt heraussuchen muessen — genau wie bei
-- getBaerchiModel bleibt das MapServices Job. Steht die Figur gerade nicht in
-- der Welt (Plot noch nicht gebaut, Bewegung verzoegert den Neuaufbau), passiert
-- einfach nichts — kein Fehler, der Toast-Text kommt ja trotzdem an.
function MapService.celebrateBaerchi(player: Player, baerchiUid: string, color: Color3)
	local model = MapService.getBaerchiModel(player, baerchiUid)
	if not model then return end

	FigureFX.celebrate(model, color)
end

-- Beschriftung und Transparenz einer Figur mit einem AUSDRUECKLICH
-- angegebenen HP-Wert setzen — auch waehrend eines laufenden PIT-Kampfes.
--
-- Nur fuer PitArenaService: der muss die Figur beim Start der Wiedergabe auf
-- die HP zuruecksetzen, mit denen der Lauf BEGONNEN hat. Die gespeicherten HP
-- stehen zu dem Zeitpunkt laengst auf dem Endwert, der Baerchi saehe sonst
-- schon vor dem ersten Schlag erschoepft aus.
function MapService.setFigureState(model: Model, hp: number, maxHp: number)
	FigureBuilder.writeFigureState(model, hp, maxHp)
end

-- Der Ordner in der Arena, in den die Kampf-Figuren gehoeren.
function MapService.getFighterFolder(player: Player): Folder?
	local model = _plotModels[player]
	if not model then return nil end

	local pit = model:FindFirstChild("PitPlatform")
	if not pit then return nil end

	local fighters = pit:FindFirstChild("Fighters")
	if fighters and fighters:IsA("Folder") then
		return fighters
	end
	return nil
end

-- Baut den PIT-Turm auf genau `level` Etagen aus bzw. ab — idempotent: fehlt
-- eine Etage, wird sie ergaenzt; ist eine zu viel da, wird sie entfernt. Mit
-- `level = 0` verschwindet der Turm komplett.
--
-- PitArenaService ruft das bei jeder Stage mit der neuen Stufenzahl auf, und
-- mit 0 sobald ein Lauf zu Ende ist oder ein neuer beginnt — der Turm bleibt
-- also NIE zwischen zwei Laeufen stehen, genau wie die Kampf-Figuren selbst
-- (siehe clearFighters in PitArenaService).
--
-- Bewegt bei einem Aufbau auch die Anzeigetafel-Verankerung mit nach oben,
-- damit sie ueber dem gewachsenen Turm haengen bleibt statt mittendrin zu
-- stecken.
function MapService.setPitTowerLevel(player: Player, level: number)
	-- 20.10. Final-Epilog: ein gehaltener Turm wird nie unter die Haltehoehe abgebaut.
	local hold = _towerHold[player]
	if hold then
		level = math.max(math.floor(level), hold)
	end

	local slot  = _playerSlot[player]
	local model = _plotModels[player]
	if not slot or not model then return end

	local container = model:FindFirstChild("PitPlatform")
	if not container then return end

	local tower = container:FindFirstChild("Tower")
	if not (tower and tower:IsA("Folder")) then return end

	local wanted = math.max(0, math.floor(level))
	local center = MapParts.pitCenter(slot)

	for _, child in tower:GetChildren() do
		local index = tonumber(child.Name:match("^Ring_(%d+)$"))
		if not index or index > wanted then
			child:Destroy()
		end
	end

	for i = 1, wanted do
		if not tower:FindFirstChild("Ring_" .. i) then
			ArenaBuilder.buildTowerRing(tower, center, i)
		end
	end

	-- 12.10.: Hoehe fuer das Flugfeld am Arena-Rand (TowerFlightController):
	-- der Client schiesst den eigenen Charakter auf die Turm-Spitze.
	container:SetAttribute("TowerLevel", wanted)
	container:SetAttribute("TowerTopY", MapService.getPitTowerFloorY(wanted))

	local anchor = container:FindFirstChild("PitBannerAnchor")
	if anchor and anchor:IsA("BasePart") then
		local topY = MapConfig.PLATFORM_TOP_Y
			+ wanted * MapConfig.PIT_TOWER_STEP_HEIGHT
			+ MapConfig.PIT_BANNER_HEIGHT
		anchor.CFrame = CFrame.new(center.X, topY, center.Z)
	end
end

-- 20.10. Final-Epilog (Prompt 2) ---------------------------------------------

-- Etagen, auf denen der Turm gehalten wird (nil = nicht gehalten).
function MapService.getTowerHold(player: Player): number?
	return _towerHold[player]
end

-- Gipfel an/aus. An: der Run-Turm bleibt auf `EpilogSummitBuilder.holdFloors()`
-- Etagen stehen (fehlende Etagen werden ergaenzt), der Gipfel wird gebaut (mit
-- `animate` in 1,5 s). Aus: Sperre fort, Gipfel weg, Turm faehrt auf 0 (wie ein
-- normaler Lauf-Abschluss). Gibt false zurueck, wenn der Spieler keinen Plot hat.
function MapService.setSummit(player: Player, on: boolean, animate: boolean?): boolean
	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return false end

	if on then
		local floors = EpilogSummitBuilder.holdFloors()
		_towerHold[player] = floors
		MapService.setPitTowerLevel(player, floors)
		EpilogSummitBuilder.build(model, slot, player, { animate = animate == true })
	else
		_towerHold[player] = nil
		EpilogTerminalBuilder.destroy(player)
		EpilogIslandBuilder.destroy(player)   -- Prompt 3: Insel/Bruecke zuerst, sie haengen am Gipfel
		EpilogSummitBuilder.destroy(player)
		MapService.setPitTowerLevel(player, 0)
	end
	return true
end

function MapService.hasSummit(player: Player): boolean
	return EpilogSummitBuilder.exists(player)
end

-- Avatar + Begleiter-Baerchi (Uid) auf den Gipfel setzen.
function MapService.teleportToSummit(player: Player, companionUid: string?): boolean
	local companion = if companionUid then MapService.getBaerchiModel(player, companionUid) else nil
	return EpilogSummitBuilder.teleportPlayerToSummit(player, companion)
end

-- Finale (Prompt 6): der Turm faehrt in PIT_TOWER_FALL_SECONDS x 3 ab, der
-- Spieler steht als Lift darauf. Blockiert bis zum Ende; danach fehlt Gipfel
-- UND Sperre. false = kein Gipfel.
function MapService.lowerSummit(player: Player, companionUid: string?, seconds: number?): boolean
	local hold = _towerHold[player]
	if not hold or not EpilogSummitBuilder.exists(player) then return false end
	EpilogTerminalBuilder.destroy(player)
	EpilogIslandBuilder.destroy(player)   -- Prompt 3: falls Insel/Bruecke noch stehen (Prompt 6 baut sie vorher ab)
	local companion = if companionUid then MapService.getBaerchiModel(player, companionUid) else nil
	local ok = EpilogSummitBuilder.lowerWithPlayer(player, hold, function(level: number)
		_towerHold[player] = if level > 0 then level else nil
		MapService.setPitTowerLevel(player, level)
	end, { seconds = seconds, companion = companion })
	_towerHold[player] = nil
	if _plotModels[player] then MapService.setPitTowerLevel(player, 0) end
	return ok
end

-- `epilog scan`: liegt ein Ordner Epilog im Plot, obwohl weder Gipfel noch
-- Haltesperre bestehen? (Reste nach einem Abbau)
function MapService.epilogLeftover(player: Player): boolean
	local model = _plotModels[player]
	if not model then return false end
	local folder = model:FindFirstChild("Epilog")
	return folder ~= nil and not EpilogSummitBuilder.exists(player) and _towerHold[player] == nil
		and not EpilogIslandBuilder.exists(player) and #folder:GetChildren() > 0
end

-- Prompt 3: Insel und Bruecke --------------------------------------------------
-- Alle Aufrufe gehen ueber den Plot des Spielers; die Regeln (Zustand, Radius)
-- prueft EpilogIslandBuilder selbst.

function MapService.buildIsland(player: Player, animate: boolean?): boolean
	local model = _plotModels[player]
	if not model then return false end
	return EpilogIslandBuilder.buildIsland(model, { animate = animate == true }) ~= nil
end

function MapService.growBridge(player: Player, onDone: (() -> ())?): (boolean, string)
	local model = _plotModels[player]
	if not model then return false, "no_plot" end
	return EpilogIslandBuilder.growBridge(model, onDone)
end

function MapService.buildBridgeInstant(player: Player): (boolean, string)
	local model = _plotModels[player]
	if not model then return false, "no_plot" end
	return EpilogIslandBuilder.buildBridgeInstant(model)
end

function MapService.removeIsland(player: Player, animated: boolean, onDone: (() -> ())?)
	local model = _plotModels[player]
	if not model then
		EpilogIslandBuilder.destroy(player)
		if onDone then task.defer(onDone) end
		return
	end
	EpilogIslandBuilder.removeAll(model, animated, onDone)
end

function MapService.teleportToIsland(player: Player, companionUid: string?): boolean
	local companion = if companionUid then MapService.getBaerchiModel(player, companionUid) else nil
	return EpilogIslandBuilder.teleportPlayerToIsland(player, companion)
end

function MapService.getBridgeWaypoints(player: Player): { Vector3 }
	local model = _plotModels[player]
	return if model then EpilogIslandBuilder.getBridgeWaypoints(model) else {}
end

-- Prompt 5: Kamera-/Laufdaten fuer den Client (Zahlen-Tabellen, siehe EpilogIslandBuilder.getRouteInfo)
function MapService.getEpilogRoute(player: Player): any
	local model = _plotModels[player]
	return if model then EpilogIslandBuilder.getRouteInfo(model) else nil
end

function MapService.getTerminalMount(player: Player): CFrame?
	local model = _plotModels[player]
	return if model then EpilogIslandBuilder.getTerminalMount(model) else nil
end

function MapService.hasIsland(player: Player): boolean
	return EpilogIslandBuilder.exists(player)
end

function MapService.isBridgeComplete(player: Player): boolean
	return EpilogIslandBuilder.isComplete(player)
end

function MapService.isBridgeGrowing(player: Player): boolean
	return EpilogIslandBuilder.isGrowing(player)
end

-- Prompt 4: Start-Terminal auf der Insel ---------------------------------------

function MapService.buildTerminal(player: Player, startState: string?): boolean
	local model = _plotModels[player]
	if not model then return false end
	return EpilogTerminalBuilder.build(model, startState) ~= nil
end

function MapService.setTerminalState(player: Player, state: string): boolean
	return EpilogTerminalBuilder.setState(player, state)
end

function MapService.getTerminalState(player: Player): string?
	return EpilogTerminalBuilder.getState(player)
end

function MapService.hasTerminal(player: Player): boolean
	return EpilogTerminalBuilder.exists(player)
end

function MapService.setTerminalCountdown(player: Player, number: number): boolean
	return EpilogTerminalBuilder.setCountdown(player, number)
end

-- Prompt 6: Rakete im Schacht neben dem Terminal; `launch` zuendet die Emitter.
function MapService.buildRocket(player: Player): boolean
	local model = _plotModels[player]
	if not model then return false end
	return EpilogFinaleBuilder.build(model, player) ~= nil
end

function MapService.launchRocket(player: Player, on: boolean)
	EpilogFinaleBuilder.launch(player, on)
end

function MapService.getRocketBase(player: Player): { number }?
	return EpilogFinaleBuilder.getBase(player)
end

function MapService.destroyRocket(player: Player)
	EpilogFinaleBuilder.destroy(player)
end

function MapService.countRocketParts(player: Player): number
	return EpilogFinaleBuilder.countParts(player)
end

-- Avatar auf den Plot setzen (Spawn des Plots), falls er weiter als `maxDistance` davon
-- steht. true = bewegt.
function MapService.placeOnPlotIfFar(player: Player, maxDistance: number): boolean
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local spawn = player.RespawnLocation
	if not (character and root and root:IsA("BasePart") and spawn) then return false end
	if (root.Position - spawn.Position).Magnitude <= maxDistance then return false end
	character:PivotTo(spawn.CFrame + Vector3.new(0, 4, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	return true
end

function MapService.countTerminalParts(player: Player): number
	return EpilogTerminalBuilder.countParts(player)
end

-- (Teile Insel, Teile Bruecke) fuer `epilog scan`.
function MapService.countIslandParts(player: Player): (number, number)
	return EpilogIslandBuilder.countParts(player)
end

-- Teile des Gipfels (fuer `epilog scan`).
function MapService.countSummitParts(player: Player): number
	return EpilogSummitBuilder.countParts(player)
end

-- Hoehe (Y ueber PLATFORM_TOP_Y) der Kampfflaeche bei `level` bereits
-- gewachsenen Etagen. PitArenaService braucht das, um die Kaempfer beim
-- Erklimmen jeder Stage auf die richtige Hoehe zu stellen — dieselbe Formel
-- wie in buildTowerRing, hier aber ohne selbst eine Etage zu bauen.
function MapService.getPitTowerFloorY(level: number): number
	return MapConfig.PLATFORM_TOP_Y + math.max(0, level) * MapConfig.PIT_TOWER_STEP_HEIGHT
end

-- v15: die Bestenlisten-Tafel(n) beschriften (Titel + bis zu
-- LEADERBOARD_BOARD.lines Zeilen). Aufrufer ist LeaderboardService.
-- HBB Paket 5: eine Tafel je Liste; Schluessel = listId, "_rotating" = die
-- eine wechselnde Tafel ohne MAP_V2_BOARDS.
local ROTATING = "_rotating"
local _leaderboardBoards: { [string]: BasePart } = {}
local _liveBoard: BasePart? = nil
local _waspNest: Model? = nil

local function writeBoard(board: BasePart?, title: string, lines: { string }, lineCount: number, titleColor: Color3?)
	if not board then return end
	local surface = board:FindFirstChild("Board")
	if not surface then return end

	local titleLabel = surface:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		titleLabel.Text = title
		if titleColor then titleLabel.TextColor3 = titleColor end
	end
	for i = 1, lineCount do
		local line = surface:FindFirstChild("Line" .. i)
		if line and line:IsA("TextLabel") then
			line.Text = lines[i] or ""
		end
	end
end

-- Gibt es eine feste Tafel fuer `listId`? (sonst: wechselnde Tafel)
function MapService.hasLeaderboardBoard(listId: string): boolean
	return _leaderboardBoards[listId] ~= nil
end

function MapService.writeLeaderboardBoard(title: string, lines: { string }, listId: string?)
	local board = (if listId then _leaderboardBoards[listId] else nil) or _leaderboardBoards[ROTATING]
	writeBoard(board, title, lines, MapConfig.LEADERBOARD_BOARD.lines)
end

-- HBB Paket 6: Live-Kampf-Board beschriften. Aufrufer ist LiveBoardService.
function MapService.writeLiveBoard(title: string, lines: { string }, live: boolean)
	local cfg = MapConfig.LIVE_BOARD
	writeBoard(_liveBoard, title, lines, cfg.lines, if live then cfg.liveColor else cfg.textColor)
end

-- HBB Paket 6: Schild und Leuchten des Wespen-Nests. Aufrufer ist EventService.
function MapService.setWaspNest(text: string, glowing: boolean)
	local nest = _waspNest
	if not nest then return end
	local cfg = MapConfig.WASP_NEST
	local body = nest:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		body.Material = if glowing then Enum.Material.Neon else Enum.Material.Sand
		body.Color    = if glowing then cfg.glowColor else cfg.color
	end
	local anchor = nest:FindFirstChild("SignAnchor")
	local sign = if anchor then anchor:FindFirstChild("Sign") else nil
	local title = if sign then sign:FindFirstChild("Title") else nil
	if title and title:IsA("TextLabel") then
		title.Text = text
	end
end

-- v15: Teile auf der Insel eines Spielers zaehlen (Debug-Befehl "parts",
-- Budget <= 250 pro Insel ohne Baerchi-Mesh). Getrennt nach Bereichen, damit man
-- sieht, wo das Budget hingeht. Die Figuren (importierte Meshes) zaehlen extra.
function MapService.countParts(player: Player): { [string]: number }?
	local model = _plotModels[player]
	if not model then return nil end

	local result: { [string]: number } = { total = 0, figures = 0 }
	for _, child in model:GetChildren() do
		local count = if child:IsA("BasePart") then 1 else 0
		for _, descendant in child:GetDescendants() do
			if descendant:IsA("BasePart") then count += 1 end
		end
		local key = child.Name
		if key == "Baerchis" then
			result.figures += count
		else
			result[key] = (result[key] or 0) + count
			result.total += count
		end
	end
	return result
end

function MapService.init()
	-- Freie Slots einmalig aufbauen
	for slot = 1, MapConfig.PLOT_COUNT do
		table.insert(_freeSlots, slot)
	end

	-- ============================================================
	-- GEOMETRIE-PRUEFUNG
	-- ============================================================
	-- Die Weltgeometrie haengt an einem guten Dutzend Zahlen, die voneinander
	-- abhaengen. Faellt eine aus dem Rahmen, sieht man das im fertigen Spiel als
	-- Loch im Boden oder als Insel im Nichts — und sucht dann im Code statt in
	-- der Config. Diese vier Pruefungen sagen es beim Start, im Klartext.
	--
	-- Sie WARNEN nur und brechen nicht ab: eine Welt mit einer schiefen Zahl ist
	-- immer noch spielbar, und ein harter Abbruch beim Serverstart waere die
	-- schlechtere Rueckmeldung.

	-- 1. Passt das quadratische Beet auf die runde Plot-Insel? Entscheidend ist
	--    die ECKE, nicht die Kante — eine halbe Diagonale, nicht eine halbe Seite.
	local plateCorner = math.sqrt(
		(MapConfig.PLOT_SIZE.X * 0.5) ^ 2 + (MapConfig.PLOT_SIZE.Z * 0.5) ^ 2
	)
	if plateCorner > MapConfig.PLOT_ISLAND_RADIUS then
		warn(
			"[MapService] Das Beet ragt ueber die Plot-Insel:",
			"halbe Diagonale von PLOT_SIZE =", string.format("%.1f", plateCorner),
			"> PLOT_ISLAND_RADIUS =", MapConfig.PLOT_ISLAND_RADIUS
		)
	end

	-- 2. Liegt der Plot-Ring wirklich eine Steglaenge vor der Hauptinsel?
	--    Sonst waere der Steg entweder zu kurz (Luecke) oder zu lang (er endet
	--    auf der Insel).
	local expectedRing = MapConfig.PLATFORM_RADIUS + MapConfig.ISLAND_GAP + MapConfig.PLOT_ISLAND_RADIUS
	if math.abs(MapConfig.PLOT_RING_RADIUS - expectedRing) > 0.5 then
		warn(
			"[MapService] PLOT_RING_RADIUS passt nicht zur Luecke:",
			MapConfig.PLOT_RING_RADIUS, "sollte", expectedRing, "sein",
			"(PLATFORM_RADIUS + ISLAND_GAP + PLOT_ISLAND_RADIUS)"
		)
	end

	-- 3. Beruehren sich zwei benachbarte Plot-Inseln samt Sandkante?
	local shoreRadius = MapConfig.PLOT_ISLAND_RADIUS + MapConfig.SHORE_WIDTH
	local neighbourGap = 2 * MapConfig.PLOT_RING_RADIUS
		* math.sin(math.pi / MapConfig.PLOT_COUNT) - 2 * shoreRadius
	if neighbourGap <= 0 then
		warn(
			"[MapService] Die Plot-Inseln ueberlappen sich:",
			MapConfig.PLOT_COUNT, "Inseln mit Rand", shoreRadius,
			"auf Ring", MapConfig.PLOT_RING_RADIUS
		)
	end

	-- 4. Reicht das Wasser bis hinter die aeusserste Arena?
	local worldEdge = (MapParts.pitCenter(1) - MapConfig.CENTER).Magnitude
		+ MapConfig.PIT_BASE_RADIUS + MapConfig.SHORE_WIDTH
	if worldEdge > MapConfig.WATER_RADIUS then
		warn(
			"[MapService] Die Arenen ragen ueber den Wasserrand:",
			"Weltrand =", string.format("%.0f", worldEdge),
			"> WATER_RADIUS =", MapConfig.WATER_RADIUS
		)
	end

	WorldBuilder.buildPlatform()
	WorldBuilder.buildGlobalLighting()

	-- v15: Bestenlisten-Tafel(n) (LeaderboardService beschriftet sie).
	-- HBB Paket 5/6: Positionen aus MapLayout (dort auch der Layout-Test).
	local platform = workspace:FindFirstChild("Platform") or workspace
	for _, b in MapLayout.leaderboardBoards() do
		local listId = b.listId
		local name = if listId then "LeaderboardBoard_" .. listId else "LeaderboardBoard"
		_leaderboardBoards[listId or ROTATING] = WorldBuilder.buildLeaderboardBoard(platform, b.angleDegrees, name)
	end
	if FeatureFlags.isOn("MAP_V2_LIVE_BOARD") then
		_liveBoard = WorldBuilder.buildLiveBoard(platform)
	end
	if FeatureFlags.isOn("MAP_V2_WASP_NEST") then
		_waspNest = WorldBuilder.buildWaspNest(platform, MapLayout.waspNestCenter())
	end

	-- Sicherheitsnetz: falls PlayerService den Leave-Fall mal verpasst,
	-- bleibt sonst ein Slot dauerhaft belegt.
	Players.PlayerRemoving:Connect(function(player)
		if _playerSlot[player] then
			MapService.despawnIsland(player)
		end
	end)

	print("[MapService] Initialisiert | Plots:", MapConfig.PLOT_COUNT)
end

return MapService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">PitArenaService</string><ProtectedString name="Source"><![CDATA[--!strict
-- PitArenaService.luau
-- ServerScriptService/Services/PitArenaService.luau
--
-- Einzige Zustaendigkeit:
--   - Einen von CombatService fertig simulierten PIT-Lauf in der Arena
--     abspielen und dabei den Lauf ZEITLICH fuehren: Hinweg, Stage fuer Stage,
--     Rueckweg, Zurueckholen und Abbruch
--
-- Zum Fuehren gehoert, dass dieser Service entscheidet, WANN abgerechnet und
-- WANN das Ergebnis verschickt wird — beides haengt an der Wiedergabe:
--   - Abrechnung: CombatService gibt eine Funktion (settle) mit. Sie laeuft
--     GENAU EINMAL mit der Zahl der tatsaechlich gespielten Stages: alle bei
--     normalem Ende, bis einschliesslich der laufenden beim Zurueckholen
--     (requestRecall; vor der ersten Stage: 0), und beim Verlassen so, als
--     waere die begonnene Stage zu Ende gespielt (PlayerService.onPlayerLeaving).
--     WAS abgerechnet wird, weiss nur CombatService; dieser Service fasst
--     Spielerdaten selbst nicht an.
--   - Ergebnis: Remotes.CombatResultReceived geht erst raus, wenn abgerechnet
--     ist. sendResult() ist die einzige Stelle, die es abschickt, und
--     idempotent — alle Abbruch- und Erfolgspfade duerfen es aufrufen.
--   - Phase (ToPit / InPit / Returning) und laufende Stage meldet er fuer
--     die Pet-Leiste (PetModeService liest getPhase).
--
-- Warum auf dem SERVER und nicht im Client: die Arenen liegen in derselben
-- Welt wie alle Plots. Serverseitig kann ein Nachbar ueber den Steg kommen
-- und zuschauen.
--
-- Die Figur wird nicht kopiert, sondern die ECHTE Figur vom Plot wandert in
-- die Arena und danach exakt an ihren Platz zurueck. Eine zweite Kopie waere
-- sonst gleichzeitig auf dem Plot zu sehen.
--
-- ============================================================
-- HEIMKEHR — die eigentliche Schwierigkeit
-- ============================================================
-- Der Ausgangs-Pivot der Figur darf NICHT beim Start jeder Wiedergabe frisch
-- abgelesen werden: startet ein zweiter Lauf waehrend der erste noch laeuft,
-- stuende die Figur da schon in der Arena und wuerde spaeter genau dorthin
-- "zurueckgesetzt". Deshalb merkt sich dieser Service den Platz auf dem Plot
-- getrennt (_home) und raeumt einen laufenden Lauf IMMER erst komplett auf,
-- bevor ein neuer beginnt.
--
-- Abbrechen kann die Wiedergabe ausserdem: der Spieler geht, oder der Plot
-- wird neu gebaut (dann ist die Figur weg). Beides wird geprueft, und in
-- keinem Fall bleibt etwas Halbes stehen.
--
-- ============================================================
-- ZUG UM ZUG
-- ============================================================
-- CombatService gibt pro Stage die einzelnen Zuege mit (Types.FightBeat).
-- Jede Stage wird als Folge von Stoessen gezeigt: die Baerchis laufen
-- aufeinander zu und prallen zusammen (FigureFX.clash). Unter dem eigenen
-- HP-Balken laeuft eine Ladeleiste (Util/FightBars); ist sie voll, kommt die
-- Faehigkeit mit ihrer Show (SkillFX, beim ersten Mal voll, danach als Echo).
-- WELCHE Zuege in die Zeit passen, rechnet FightTimeline.
--
-- startPlayback ist bewusst EINE lange Funktion: sie erzaehlt den Ablauf
-- eines Laufs von vorn nach hinten, und ihre Schritte teilen viel Zustand.
-- Zerlegt in viele kleine Funktionen muesste man zum Verstehen hin und her
-- springen.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)
local MapConfig   = require(ReplicatedStorage.Config.MapConfig)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local SkillConfig = require(ReplicatedStorage.Config.SkillConfig)
local SkillFXConfig = require(ReplicatedStorage.Config.SkillFXConfig)
local BaerchiMesh = require(ReplicatedStorage.Modules.BaerchiMesh)
local FightTimeline = require(ReplicatedStorage.Modules.FightTimeline)
local Audio       = require(ReplicatedStorage.Audio)
local Types       = require(ReplicatedStorage.Network.Types)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local Remotes     = require(ReplicatedStorage.Network.Remotes)

local PlayerService   = require(ServerScriptService.Services.PlayerService)
local MapService      = require(ServerScriptService.Services.MapService)
local FigureWalker    = require(ServerScriptService.Util.FigureWalker)
local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)
local RateLimiter     = require(ServerScriptService.Util.RateLimiter)   -- Paket 4.3
local FigureFX        = require(ServerScriptService.Util.FigureFX)
local ActivityLock    = require(ServerScriptService.Util.ActivityLock)
local FightBars       = require(ServerScriptService.Util.FightBars)
local PlotRoutes      = require(ServerScriptService.Util.PlotRoutes)   -- 14.10.: ein Wegeplaner fuer alle

-- Name unter dem PitArenaService das Bewegungs-Schloss haelt (siehe
-- ActivityLock) — verhindert dass BaerchiAutopilotService den Baerchi
-- waehrend eines Kampf-Laufs zum Honig-Teich abzieht.
local LOCK_HOLDER = "Kampf"

local PitArenaService = {}

-- HBB Paket 5 (MAP_V2_ARENA_SPRINT): auf dem Weg Plot <-> Arena sprintet der
-- Baerchi (MapConfig.ARENA_WALK_SPEED) statt zu gehen — weniger Warten je Lauf.
local function arenaWalkSpeed(): number
	return if FeatureFlags.isOn("MAP_V2_ARENA_SPRINT") then MapConfig.ARENA_WALK_SPEED else MapConfig.WALK_SPEED
end

-- Gleich viele Hopser pro SEKUNDE wie beim Gehen, dafuer weitere: schnelleres
-- Huepfen liest das Auge als Zittern (siehe MapConfig.WALK_BOB_PER_STUD).
local function arenaBobPerStud(): number
	return MapConfig.WALK_BOB_PER_STUD * MapConfig.WALK_SPEED / arenaWalkSpeed()
end

-- 14.10.: Die Wege Plot <-> Arena plant PlotRoutes.route (von JEDEM Punkt der
-- Achse zu jedem anderen, auch mitten auf dem Steg oder vom Event aus). Frueher
-- hatte dieser Service eine eigene, nur fuer Heimplatz <-> Arena taugliche Kette.

-- Laufende Wiedergabe pro Spieler. Startet ein neuer Lauf, wird der alte
-- Token ungueltig und die alte Schleife beendet sich beim naechsten Schritt.
local _runToken: { [Player]: number } = {}

-- Ergebnis, das der Client noch nicht bekommen hat. Wird gesetzt sobald ein
-- Lauf beginnt und erst gefeuert, wenn der Baerchi sichtbar am Kampf-Spot
-- angekommen ist (siehe sendResult) — vorher liefe die Kampf-UI schon,
-- waehrend er noch zur Arena unterwegs waere. Bleibt die Wiedergabe aus
-- irgendeinem Grund stecken (kein Plot, Fehler waehrend des Laufs), wird an
-- den Abbruchstellen trotzdem gesendet, damit der Client nie ganz ohne
-- Ergebnis dasteht.
--
-- Der Eintrag traegt seinen eigenen Token: `isRunning` verhindert zwar, dass
-- ueberhaupt ein zweiter Lauf waehrend eines laufenden startet, aber ohne den
-- Token wuerde selbst ein knapp daneben abgewiesener Request die
-- Abbruch-Fallbacks eines ANDEREN, spaeter gestarteten Laufs treffen und
-- dessen Ergebnis zu frueh verschicken — genau der Fehler, den sendResult
-- eigentlich beheben soll. sendResult prueft den Token deshalb mit.
-- v12: Abrechnung und Zustand des laufenden Laufs. `entered` = wie viele
-- Stages bereits BEGONNEN haben (fuer die Abrechnung bei Abbruch), `phase`
-- und `stage` fuer die Anzeige, `recall` = Spieler will zurueck.
export type SettleFn = (played: number, recalled: boolean) -> Types.PitRunResult
type Active = {
	token   : number,
	run     : Types.PitRunResult,
	settle  : SettleFn?,
	settled : Types.PitRunResult?,
	sent    : boolean,
	entered : number,
	completed : number,   -- 14.10.: VOLLSTAENDIG gespielte Stages (harter Abbruch rechnet nur diese ab)
	recall  : boolean,
	handoff : boolean,    -- 14.10.: Zurueckholen = Uebergabe an ein anderes Ziel, nicht heimlaufen
	onStage : ((number) -> ())?,   -- 14.10.: nach JEDER fertigen Stage (Auszahlung je Stage)
	beats   : { { Types.FightBeat } }?,   -- v15: Zuege je Stage (Index = Stage im Lauf)
	phase   : string,     -- "ToPit" | "InPit" | "Returning"
	stage   : number?,
}
local _active: { [Player]: Active } = {}

-- Wo die gerade kaempfende Figur auf dem Plot hingehoert: der KANONISCHE
-- Heimplatz (MapService.getBaerchiHome), nicht der Punkt, an dem sie zufaellig
-- losgelaufen ist — sie kann ja von einem Event oder vom Teich kommen.
type Home = { model: Model, homeFoot: Vector3, facing: CFrame }
local _home: { [Player]: Home } = {}

-- 14.10.: wer die Figur nach einer Uebergabe (handoff) weiterfuehrt. Gesetzt von
-- PetModeService (Pull-Hook statt require — der haengt schon von uns ab).
local _handoffHandler: ((Player) -> ())? = nil

-- Sammel-Update 05.10. (Paket 4.3, "schnell den Tower hochfliegen"): Tempo
-- der Wiedergabe je Spieler (1, 2, 4 oder 0 = "Ergebnis sofort"). Die
-- Abrechnung aendert sich NICHT: sie steht ohnehin fest, bevor die Wiedergabe
-- beginnt, und wird am Ende ausgezahlt — schneller abspielen heisst nur
-- schneller ankommen. Gilt ab der naechsten Stage, gemerkt fuer die Sitzung.
local VALID_SPEEDS: { [number]: number } = { [1] = 1, [2] = 2, [4] = 4, [0] = 40 }
local _speed: { [Player]: number } = {}

local function speedFactor(player: Player): number
	return VALID_SPEEDS[_speed[player] or 1] or 1
end

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- Bringt eine noch in der Arena stehende Figur an ihren Platz auf dem Plot
-- zurueck und raeumt ihren Kampf-Balken weg. Idempotent: zweimal aufrufen
-- schadet nicht.
local function restoreHome(player: Player, keepPosition: boolean?)
	local home = _home[player]
	if not home then return end

	_home[player] = nil

	local model = home.model
	if model.Parent ~= nil then
		FightBars.removeHealthBar(model)
		model:SetAttribute("InArena", nil)

		-- ZUERST abmelden, DANN heimsetzen — nie andersherum. Waehrend des
		-- Kampfs atmet die Figur am Kampf-Spot, ihre gemerkte Ruhelage ist also
		-- die Arena-Position. Ein spaeteres Abmelden wuerde sie genau dorthin
		-- zuruecksetzen und die Heimkehr wieder zunichtemachen.
		FigureFX.stopIdle(model)

		-- 14.10. Uebergabe an ein anderes Ziel: die Figur bleibt, wo sie steht —
		-- der naechste Weg startet von hier. Das Atmen setzt der naechste
		-- Besitzer der Figur.
		if keepPosition then
			return
		end

		FigurePlacement.place(model, home.homeFoot, home.facing)
		FigureFX.idleBob(model, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
	end
end


local function clearFighters(player: Player)
	local fighters = MapService.getFighterFolder(player)
	if not fighters then return end

	for _, child in fighters:GetChildren() do
		child:Destroy()
	end
end

-- Text auf der Anzeigetafel ueber der Arena. Die Tafel selbst gehoert
-- MapService; hier wird nur entschieden WAS draufsteht, weil nur dieser
-- Service den Verlauf des Laufs kennt.
-- v15: "Tower II · Stage 23"
-- Tafel-Texte sind Nachrichten (LocMsg): die Tafel sieht jeder Spieler auf
-- der Plattform, und jeder liest sie in seiner Sprache (MapService/WorldText).
local function stageTitle(towerId: string?, stage: number): Types.LocMsg
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	return Loc.msg("ui.pitboard.stage", { tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), stage = stage })
end

local function showStage(player: Player, towerId: string?, stage: Types.PitStageResult, cleared: number)
	MapService.setPitBanner(
		player,
		stageTitle(towerId, stage.stage),
		-- Sammel-Update 2.4: die Tafel sehen alle Spieler, jeder in seiner
		-- Sprache — deshalb Symbole und Zahlen statt deutscher Woerter.
		if cleared > 0
			then string.format("✔ %d", cleared)
			else "⚔ 1",
		MapConfig.PIT_BANNER_RUNNING
	)
end

local function showSummary(player: Player, run: Types.PitRunResult)
	-- "Geschafft" ist die Zahl gewonnener Stages. Sie kann 0 sein — dann hat
	-- der Baerchi den ersten Gegner nicht ueberlebt, und genau das soll auch
	-- dastehen statt eines beschoenigenden "0 geschafft".
	local won = run.stagesCleared > 0

	MapService.setPitBanner(
		player,
		if won
			then Loc.msg("fmt.append", { a = "✔", b = Loc.msg("ui.pitboard.won", { n = run.stagesCleared }) })
			else Loc.msg("fmt.append", { a = "✖", b = Loc.msg("ui.pitboard.none") }),
		Loc.msg("event.bonus.gummies", { n = run.gummiesWon }),
		if won then MapConfig.PIT_BANNER_WIN else MapConfig.PIT_BANNER_LOSS
	)
end

-- Schickt das Kampfergebnis an den Client — idempotent, weil mehrere
-- Abbruch- und Erfolgspfade das hier alle "auf gut Glueck" aufrufen koennen.
-- Erst danach darf CombatPanel seine Stage-Wiedergabe starten; siehe die
-- Aufrufstelle in startPlayback fuer den genauen Zeitpunkt (Ankunft am
-- Kampf-Spot).
-- `token` muss zu dem Lauf gehoeren, der sendResult aufruft — sonst koennte
-- der Abbruch-Fallback eines ueberholten Laufs A das laengst neu gesetzte
-- _pendingResult eines inzwischen gestarteten Laufs B verschicken, noch
-- bevor dessen eigener Baerchi angekommen ist.
-- v12: rechnet ab (einmal) und gibt das abgerechnete Ergebnis zurueck. Ohne
-- settle-Funktion (Altaufruf) zaehlt der volle Lauf.
local function settleActive(active: Active, played: number, recalled: boolean): Types.PitRunResult
	if active.settled then
		return active.settled
	end

	local settle = active.settle
	local result = active.run
	if settle then
		local ok, res = pcall(settle, played, recalled)
		if ok then
			result = res
		else
			warn("[PitArenaService] Abrechnung fehlgeschlagen:", res)
		end
	end

	active.settled = result
	return result
end

-- Schickt das ABGERECHNETE Ergebnis an den Client — idempotent und nur fuer
-- den Lauf, zu dem der Token gehoert. Wurde noch nicht abgerechnet (Abbruch),
-- wird hier mit den bereits begonnenen Stages abgerechnet.
local function sendResult(player: Player, token: number)
	local active = _active[player]
	if not active or active.token ~= token or active.sent then return end
	active.sent = true

	local result = settleActive(active, active.entered, active.recall)
	if player.Parent ~= nil then
		Remotes.CombatResultReceived:FireClient(player, result)
	end
end

-- Den Erschoepfungs-Zustand nachziehen, der waehrend der Wiedergabe
-- unterdrueckt war.
local function refreshState(player: Player)
	local data = PlayerService.getData(player)
	if data then
		MapService.updateBaerchiStates(player, data.island)
	end
end

--------------------------------------------------------------------------------
-- Wiedergabe
--------------------------------------------------------------------------------

-- Steht die Wiedergabe noch? Prueft alles was sie abbrechen kann:
-- ein neuer Lauf, der Spieler geht, der Plot wird neu gebaut (Figur weg),
-- oder das PIT wird ausgebaut (dann ist der Kaempfer-Ordner mit zerstoert
-- worden und neue Gegner landeten unsichtbar im Nirgendwo).
local function setPhase(player: Player, token: number, phase: string, stage: number?)
	local active = _active[player]
	if active and active.token == token then
		active.phase = phase
		active.stage = stage
	end
end

local function recallWanted(player: Player, token: number): boolean
	local active = _active[player]
	return active ~= nil and active.token == token and active.recall
end

local function stillValid(player: Player, token: number, figure: Model, fighters: Folder): boolean
	if _runToken[player] ~= token then return false end
	if player.Parent == nil then return false end
	if figure.Parent == nil then return false end
	if fighters.Parent == nil then return false end
	return true
end

-- v12: Laesst den Turm Etage fuer Etage von `fromLevel` auf `toLevel` wachsen
-- (oder schrumpfen) und haelt die Figur dabei immer oben auf der aktuellen
-- Etage. Bei sehr hohen Tuermen wachsen mehrere Etagen pro Schritt, damit es
-- nie laenger als `seconds` dauert. Die Figur darf waehrenddessen NICHT im
-- Idle-Loop sein (der Aufrufer meldet sie ab und danach wieder an).
-- Gibt false zurueck, wenn die Wiedergabe unterwegs ungueltig wurde.
local function rideTower(
	player: Player, token: number, figure: Model, fighters: Folder,
	fromLevel: number, toLevel: number, seconds: number,
	selfPos: Vector3, enemyPos: Vector3
): boolean
	local distance = math.abs(toLevel - fromLevel)
	if distance == 0 then return true end

	-- Hoechstens ~20 Schritte pro Sekunde: mehr sieht niemand, und jeder
	-- Schritt baut bzw. entfernt Teile.
	local steps    = math.max(1, math.min(distance, math.floor(seconds * 20)))
	local stepTime = seconds / steps

	for step = 1, steps do
		if not stillValid(player, token, figure, fighters) then return false end

		local level = fromLevel + math.floor((toLevel - fromLevel) * step / steps + 0.5)
		MapService.setPitTowerLevel(player, level)

		local y = MapService.getPitTowerFloorY(level)
		FigurePlacement.placeLookingAt(
			figure,
			Vector3.new(selfPos.X, y, selfPos.Z),
			Vector3.new(enemyPos.X, y, enemyPos.Z)
		)
		task.wait(stepTime)
	end

	return stillValid(player, token, figure, fighters)
end

local function startPlayback(player: Player, run: Types.PitRunResult, settle: SettleFn?, beats: { { Types.FightBeat } }?, onStage: ((number) -> ())?)
	-- Das Hochzaehlen des Tokens steht ganz oben und vor allem, was fehlschlagen
	-- kann. Ab hier gehoert die Wiedergabe fuer diesen Spieler UNS — und nur
	-- deshalb darf die Fehlerbehandlung in play() bedenkenlos aufraeumen. Stuende
	-- der Token weiter unten und etwas darueber wuerfe, wuerde play() den Zustand
	-- einer noch laufenden aelteren Wiedergabe zerlegen, die anschliessend
	-- munter weiterliefe: Figur zurueck auf dem Plot, aber weiter Gegner in der
	-- Arena und die Tafel wieder an.
	local token = (_runToken[player] or 0) + 1
	_runToken[player] = token

	-- Ab hier ist der Client faellig fuer dieses Ergebnis. Gefeuert wird es
	-- weiter unten erst bei Ankunft am Kampf-Spot — bricht die Wiedergabe
	-- vorher ab (kein Plot, Fehler), sorgen die Abbruchstellen selbst dafuer,
	-- dass es trotzdem noch rausgeht.
	_active[player] = {
		token   = token,
		run     = run,
		settle  = settle,
		settled = nil,
		sent    = false,
		entered = 0,
		completed = 0,
		recall  = false,
		handoff = false,
		onStage = onStage,
		beats   = beats,
		phase   = "ToPit",
		stage   = nil,
	}

	-- Ein Kampf hat immer Vorrang vor dem automatischen Weg zum Honig-Teich:
	-- forceAcquire nimmt das Bewegungs-Schloss notfalls dem Autopilot weg.
	-- Der bemerkt das selbst (sein isCancelled prueft den Besitzer) und bricht
	-- sein Hinlaufen sauber ab, statt mit dem Kampf um die Figur zu ringen.
	ActivityLock.forceAcquire(player, LOCK_HOLDER)

	-- Einen noch laufenden Lauf komplett aufraeumen. refreshState gehoert
	-- dazu: dessen Wiedergabe hatte den Zustand der Figur unterdrueckt und
	-- kommt wegen des neuen Tokens nicht mehr dazu, ihn nachzuziehen — der
	-- alte Baerchi staende sonst mit veralteter Beschriftung auf dem Plot.
	--
	-- Das passiert bewusst VOR den Abbruchgruenden unten: auch wenn diese
	-- Wiedergabe gar nicht erst startet, muss die alte sauber beendet sein.
	restoreHome(player)
	refreshState(player)
	clearFighters(player)
	-- 20.10. Final-Epilog: ein neuer Lauf waehrend der Sequenz beendet den
	-- Gipfel (der Turm muss wieder wachsen koennen). Der Epilog-Stand bleibt
	-- gespeichert; EpilogService.restore baut den Gipfel bei Bedarf neu.
	if MapService.getTowerHold(player) then
		MapService.setSummit(player, false)
	end
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)

	-- Es gibt keine Show — Ergebnis trotzdem rausschicken UND das Schloss
	-- wieder freigeben.
	--
	-- Das Freigeben stand hier frueher nicht: forceAcquire oben nimmt das
	-- Schloss immer, die beiden Abbruchgruende unten kamen aber ohne
	-- release() zurueck. Wer also einmal ohne Plot oder ohne gerenderte Figur
	-- in einen Lauf ging, behielt "Kampf" als Schloss-Besitzer fuer den Rest
	-- der Sitzung — der Autopilot ging nie wieder essen, und seit dem
	-- ActivityLock-Schutz wuerden auch Ausruesten, Verwerten und der
	-- Figuren-Neuaufbau dauerhaft abgelehnt. Nur der Fehler-Pfad
	-- (PitArenaService.play) hat freigegeben, der stille Abbruch nicht.
	local function abortPlayback()
		-- Keine Show moeglich: der Lauf zaehlt trotzdem voll (wie vor v12),
		-- er ist ja schon entschieden.
		local active = _active[player]
		if active and active.token == token then
			active.entered = #run.stages
		end
		sendResult(player, token)
		ActivityLock.release(player, LOCK_HOLDER)
		if _active[player] and _active[player].token == token then
			_active[player] = nil
		end
	end

	local center     = MapService.getPitPosition(player)
	local plotCFrame = MapService.getPlotCFrame(player)
	local fighters   = MapService.getFighterFolder(player)
	local figure     = MapService.getBaerchiModel(player, run.baerchiUid)

	-- Fehlt irgendetwas davon (kein Plot, kein Mesh-Template, Figur nicht
	-- gerendert), gibt es einfach keine Show. Der Lauf selbst ist davon
	-- unberuehrt — er ist laengst abgerechnet.
	if not center or not plotCFrame or not fighters or not figure then
		abortPlayback()
		return
	end

	-- typeof statt nur #: kaeme ein Lauf ohne stages-Tabelle herein, waere das
	-- sonst ein Fehler mitten in der Abrechnung statt einer stillen Nicht-Show.
	if typeof(run.stages) ~= "table" or #run.stages == 0 then
		abortPlayback()
		return
	end

	-- Ruhe-Atmen abschalten, BEVOR die Heimatposition gemessen wird: die Figur
	-- schwebt sonst gerade um einen Bruchteil ihres Hubs ueber der Ruhelage,
	-- und genau dieser Versatz wanderte dann in _home.pivot — nach jedem Kampf
	-- staende sie ein Stueckchen hoeher als vorher. stopIdle setzt sie dafuer
	-- selbst auf ihre Ruhelage zurueck.
	FigureFX.stopIdle(figure)

	-- 14.10. Der Lauf startet dort, wo die Figur JETZT steht (vom Event, vom
	-- Teich, mitten im Weg) — heim geht es aber zum kanonischen Heimplatz.
	local startFoot = FigurePlacement.footOf(figure)   -- Sammel-Update 1.2
	local hf, hc = MapService.getBaerchiHome(player)
	local homeFoot: Vector3 = hf or startFoot
	local homeFacing: CFrame = hc or figure:GetPivot()
	_home[player] = { model = figure, homeFoot = homeFoot, facing = homeFacing }

	local maxHp = math.max(1, run.maxHp)

	-- v14: welche Faehigkeit gezeigt wird (SkillFX). Die volle Show laeuft
	-- beim ersten Einsatz eines Laufs, danach nur ein kurzes Echo — sonst
	-- wuerde ein Lauf mit vielen Stages Minuten dauern.
	local fxData = PlayerService.getData(player)
	local fxBaerchi = fxData and fxData.island.baerchis[run.baerchiUid]
	local fxSkillId: string? = fxBaerchi and fxBaerchi.skillId
	local fxShownFull = false

	-- v15: Ladeleiste nur, wenn die Faehigkeit ueberhaupt aufgeladen wird
	-- (Passive und Grundschlag haben charge = 0).
	local fxSkill = fxSkillId and SkillConfig.getById(fxSkillId)
	local showsCharge = fxSkill ~= nil and (fxSkill.charge or 0) > 0

	-- Die beiden Kaempfer stehen sich quer zur Bruecke gegenueber, damit man
	-- sie beim Herueberlaufen von der Seite sieht statt hintereinander.
	local laneFrame: CFrame = plotCFrame   -- 12.10.: fuer die Laufwege (arenaRoute)
	local side     = plotCFrame.RightVector
	local selfPos  = center - side * MapConfig.FIGHT_SPACING
	local enemyPos = center + side * MapConfig.FIGHT_SPACING

	-- Die Figur gehoert jetzt uns: MapService laesst ihren Zustand in Ruhe,
	-- bis das Attribut wieder weg ist (sonst saehe sie mitten im Kampf
	-- erschoepft aus, weil die HP serverseitig schon final sind).
	figure:SetAttribute("InArena", true)

	-- Die Figur auf den Zustand VOR dem Lauf zuruecksetzen. Die gespeicherten
	-- HP stehen zu diesem Zeitpunkt schon auf dem Endwert — ohne diese Zeile
	-- stuende der Baerchi bereits blass und mit "erschoepft" beschriftet da,
	-- bevor der erste Gegner ueberhaupt erscheint.
	MapService.setFigureState(figure, run.hpBefore, maxHp)

	-- 14.10. true, sobald die Figur bewusst NICHT heimgelaufen ist (Uebergabe):
	-- dann stellt die Aufraeum-Phase sie nicht auf den Heimplatz zurueck.
	local handedOff = false

	task.spawn(function()
		local selfFill: Frame? = nil
		local chargeFill: Frame? = nil

		local ok, err = pcall(function()
			-- Erst hinlaufen: der Kampf soll sichtbar ERST beginnen, wenn der
			-- Baerchi an der Plattform angekommen ist, nicht durch einen
			-- Teleport. FigureWalker haelt den Fusspunkt waehrenddessen exakt
			-- auf Plot-/Bruecken-Hoehe.
			FigureWalker.walkPath(figure, PlotRoutes.route(laneFrame, startFoot, selfPos), {
				speed       = arenaWalkSpeed(),
				bobPerStud  = arenaBobPerStud(),
				isCancelled = function()
					return not stillValid(player, token, figure, fighters) or recallWanted(player, token)
				end,
			})
			if not stillValid(player, token, figure, fighters) then
				sendResult(player, token)
				return
			end

			-- v12: auf dem Hinweg zurueckgeholt — noch keine Stage begonnen.
			-- Abrechnung mit 0 Stages (erstattet eine bezahlte Fortsetzung),
			-- dann von hier aus heimlaufen.
			if recallWanted(player, token) then
				sendResult(player, token)
				local pending = _active[player]
				if pending and pending.token == token and pending.handoff then
					-- 14.10. Anderes Ziel gewaehlt: nicht heimlaufen, die Figur
					-- bleibt genau hier und wird dort weitergefuehrt.
					handedOff = true
					return
				end
				setPhase(player, token, "Returning", nil)
				local here = FigurePlacement.footOf(figure)
				FigureWalker.walkPath(figure, PlotRoutes.route(laneFrame, here, homeFoot), {
					speed       = arenaWalkSpeed(),
					bobPerStud  = arenaBobPerStud(),
					isCancelled = function() return not stillValid(player, token, figure, fighters) end,
				})
				return
			end
			setPhase(player, token, "InPit", nil)

			-- Exakte Ausrichtung zum Gegner: der Lauf endet in Laufrichtung,
			-- gekaempft wird aber gegenueber.
			FigurePlacement.placeLookingAt(figure, selfPos, enemyPos)

			-- Ab hier steht der Baerchi am Kampf-Spot und atmet dort — auch
			-- zwischen den Stages und waehrend der Nachlauf-Pause, in der er
			-- sonst reglos herumstuende. Die Ausfallschritte melden ihn dafuer
			-- selbst kurz ab und danach wieder an (FigureFX.clash).
			FigureFX.idleBob(figure, {
				height = MapConfig.IDLE_BOB_HEIGHT,
				rate   = MapConfig.IDLE_BOB_RATE,
			})

			selfFill = FightBars.attachHealthBar(figure, MapConfig.FIGHT_BAR_SELF_COLOR)
			FightBars.tweenFill(selfFill, run.hpBefore / maxHp, 0.01)
			if showsCharge then
				chargeFill = FightBars.attachChargeBar(figure)
			end

			-- (v12: das Ergebnis geht erst nach der Abrechnung am Ende raus.)

			-- Der Gegner der VORHERIGEN Stage wird erst weggeraeumt wenn der
			-- naechste erscheint. Wuerde er am Ende seiner eigenen Stage
			-- verschwinden, waere die entscheidende letzte Niederlage nie zu
			-- sehen — und in der Nachlauf-Pause staende der eigene Baerchi
			-- allein in der Arena.
			local previousEnemy: Model? = nil

			-- Zaehlt die BEREITS gewonnenen Stages fuer die Anzeigetafel.
			-- Absichtlich nicht run.stagesCleared: das ist das Endergebnis und
			-- waere waehrend der Wiedergabe die halbe Spannung vorweggenommen.
			local cleared = 0

			-- Wo der eigene Baerchi zuletzt stand — auf Bodenhoehe, solange
			-- der Turm noch nicht gewachsen ist, sonst auf der aktuellen
			-- Etage. Der Rueckweg nach der letzten Stage startet von hier,
			-- nicht von der urspruenglichen (Boden-)selfPos.
			local finalSelfPos = selfPos

			-- Aktuelle Turmhoehe (Etagen), fuer den Abstieg am Ende.
			local towerNow = 0

			-- ============================================================
			-- v12: FORTSETZUNG — DER TURM WAECHST ERST BIS ZUR STARTSTAGE
			-- ============================================================
			-- Steigt der Baerchi bei Stage 30 ein, wachsen jetzt alle 29
			-- Etagen darunter sichtbar hoch und er faehrt oben mit. Danach
			-- kaempft er auf genau der Hoehe, auf der Stage 30 bei einem Lauf
			-- von vorn stattfinden wuerde — man sieht, wie weit oben man ist.
			-- v15: gestaucht (TowerConfig.getRunFloor), bei 100 Stages hoechstens
			-- RUN_MAX_FLOORS Etagen.
			local baseLevel = TowerConfig.getRunFloor(run.towerId or "I", run.startStage or 1)
			if baseLevel > 0 and not recallWanted(player, token) then
				MapService.setPitBanner(
					player,
					stageTitle(run.towerId, run.startStage or 1),
					"⬆ …",
					MapConfig.PIT_BANNER_RUNNING
				)

				local riseSeconds = math.min(
					MapConfig.PIT_TOWER_RISE_MAX_SECONDS,
					baseLevel * MapConfig.PIT_TOWER_RISE_SECONDS_PER_LEVEL
				)

				FigureFX.stopIdle(figure)
				if not rideTower(player, token, figure, fighters, 0, baseLevel, riseSeconds, selfPos, enemyPos) then
					return
				end
				FigureFX.idleBob(figure, {
					height = MapConfig.IDLE_BOB_HEIGHT,
					rate   = MapConfig.IDLE_BOB_RATE,
				})

				towerNow     = baseLevel
				finalSelfPos = Vector3.new(selfPos.X, MapService.getPitTowerFloorY(baseLevel), selfPos.Z)
			end

			for index, stage in run.stages do
				if not stillValid(player, token, figure, fighters) then return end

				-- v12: zurueckgeholt — die vorige Stage ist fertig gespielt,
				-- weitere beginnen nicht mehr.
				if recallWanted(player, token) then break end

				local active = _active[player]
				if active and active.token == token then
					active.entered = index
				end
				setPhase(player, token, "InPit", stage.stage)

				-- Etage dieser Stage: die erste Stage kaempft noch auf der
				-- normalen Kampfflaeche (Etage 0) — sichtbar identisch mit dem
				-- Boden, den man von der Bruecke kennt. Jede weitere Stage
				-- bekommt eine neue Turmetage obendrauf (siehe MapConfig,
				-- Abschnitt "PIT-TURM").
				-- v12: absolute Etage — bei einer Fortsetzung steht der Turm
				-- schon (siehe oben), Stage 30 kaempft auf Etage 29.
				local towerLevel = TowerConfig.getRunFloor(run.towerId or "I", stage.stage)
				MapService.setPitTowerLevel(player, towerLevel)
				towerNow = towerLevel

				local floorY        = MapService.getPitTowerFloorY(towerLevel)
				local stageSelfPos  = Vector3.new(selfPos.X, floorY, selfPos.Z)
				local stageEnemyPos = Vector3.new(enemyPos.X, floorY, enemyPos.Z)
				finalSelfPos = stageSelfPos

				-- Ist der Turm inzwischen gewachsen, steht der eigene Baerchi
				-- eine Etage tiefer als er jetzt muesste — er wird VOR dem
				-- naechsten Gegner mit hochgestellt. Ruhe-Atmen dafuer kurz
				-- abmelden und an der neuen Stelle neu anmelden, sonst zoegen
				-- Idle-Loop und diese Bewegung im selben Frame an derselben
				-- Figur (dieselbe Reihenfolge wie in restoreHome).
				if towerLevel > 0 then
					FigureFX.stopIdle(figure)
					FigurePlacement.placeLookingAt(figure, stageSelfPos, stageEnemyPos)
					FigureFX.idleBob(figure, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end

				showStage(player, run.towerId, stage, cleared)

				if previousEnemy and previousEnemy.Parent then
					previousEnemy:Destroy()
				end
				previousEnemy = nil

				local enemy = BaerchiMesh.buildEnemy(stageEnemyPos, MapConfig.FIGHT_ENEMY_COLOR)
				local enemyFill: Frame? = nil

				if enemy then
					FigurePlacement.placeLookingAt(enemy, stageEnemyPos, stageSelfPos)
					enemy.Parent = fighters
					enemyFill = FightBars.attachHealthBar(enemy, MapConfig.FIGHT_BAR_ENEMY_COLOR)
					previousEnemy = enemy

					-- Auch der Gegner soll nicht wie ein Standbild dastehen,
					-- solange er noch lebt.
					FigureFX.idleBob(enemy, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end

				-- ====================================================
				-- v15: DIE STAGE ZUG UM ZUG
				-- ====================================================
				local stageBeats: { Types.FightBeat } = (beats and beats[index]) or {}
				if #stageBeats == 0 then
					-- Ohne Zuege (aelterer Aufrufer): ein einziger Stoss, der
					-- das Ergebnis zeigt — wie vor v15.
					stageBeats = { {
						actor   = if stage.won then "A" else "B",
						kind    = "hit",
						selfHp  = stage.hpAfter / maxHp,
						enemyHp = if stage.won then 0 else 0.35,
						charge  = 0,
						skillId = nil,
					} }
				end

				local plan = FightTimeline.plan(stageBeats, #run.stages, stage.won)
				local fast  = speedFactor(player)   -- Paket 4.3
				local tempo = plan.tempo / fast

				-- Kurz stehen bleiben, damit man den neuen Gegner sieht.
				task.wait(MapConfig.FIGHT_ENEMY_INTRO_SECONDS * tempo)
				if not stillValid(player, token, figure, fighters) then return end

				for _, beatIndex in plan.indices do
					local beat = stageBeats[beatIndex]
					local isSelf = beat.actor == "A"
					local attacker: Model? = if isSelf then figure else enemy
					local target:   Model? = if isSelf then enemy else figure
					local attackerHome = if isSelf then stageSelfPos else stageEnemyPos
					local targetHome   = if isSelf then stageEnemyPos else stageSelfPos
					local isSkill = FightTimeline.isSkillBeat(beat)

					-- Leisten und Treffer-Rueckmeldung genau im Aufprall.
					local function onImpact()
						local barSeconds = MapConfig.FIGHT_BEAT_SECONDS * tempo * 0.5
						FightBars.tweenFill(selfFill, beat.selfHp, barSeconds)
						FightBars.tweenFill(enemyFill, beat.enemyHp, barSeconds)
						FightBars.setCharge(chargeFill, beat.charge, barSeconds)
						if target and target.Parent ~= nil then
							FigureFX.hitFlash(target, MapConfig.FIGHT_HIT_FLASH_COLOR, MapConfig.FIGHT_HIT_FLASH_SECONDS)
						end
						local contact = (stageSelfPos + stageEnemyPos) * 0.5 + Vector3.new(0, 1.5, 0)
						FigureFX.burstAt(contact, MapConfig.FIGHT_HIT_FLASH_COLOR, fighters,
							MapConfig.FIGHT_BUMP_SPARKS * (if isSkill then 3 else 1))
						-- Audio-Rework 16.10.: weicher Treffer-Klang aus Audio.SFX; die
						-- Cooldown-Bremse sitzt in FigureFX.soundAt.
						local bumpName = if isSkill then "hitHeavy" else "hit"
						FigureFX.soundAt(contact, Audio.sfxId(bumpName),
							Audio.SFX[bumpName].volume, fighters,
							0.92 + math.random() * 0.16)
					end

					if beat.kind == "stunned" then
						-- Betaeubt: kein Stoss, die Figur taumelt.
						if attacker then
							FightBars.setCharge(chargeFill, beat.charge, 0.1)
							FigureFX.stagger(attacker, MapConfig.FIGHT_BEAT_SECONDS * tempo)
						else
							task.wait(MapConfig.FIGHT_BEAT_SECONDS * tempo)
						end
					else
						-- Faehigkeit mit Show (v15.1): die Show IST der Angriff.
						-- Leisten, Treffer-Blitz und Rueckstoss des Gegners
						-- kommen im Einschlag-Moment der Show
						-- (SkillFXConfig.getImpactTime), danach gibt es keinen
						-- zweiten Stoss mehr. Gesamtdauer wie in
						-- tools/sim/fight_timeline.lua:
						-- max(Show-Ende, Einschlag + Zugdauer).
						local showPlayed = false
						if isSkill and isSelf then
							FightBars.setCharge(chargeFill, 1, 0.1)
							local showId = beat.skillId or fxSkillId
							if showId then
								-- Paket 4.3: im Schnelldurchlauf nur das kurze Echo
								local full = not fxShownFull and fast <= 1
								fxShownFull = true
								local scale = if full then 1 else tempo
								Remotes.SkillFXPlay:FireAllClients({
									owner    = player.UserId,
									skillId  = showId,
									full     = full,
									attacker = figure,
									target   = enemy,
									center   = (stageSelfPos + stageEnemyPos) / 2,
									-- Finisher/Opener hat gegriffen (Client: violetter
									-- Schnitt, staerkerer Komet). Nur Optik.
									bonus    = beat.bonus == true,
								})
								local showSeconds   = SkillFXConfig.getDuration(showId, full) * scale
								local impactSeconds = math.min(SkillFXConfig.getImpactTime(showId, full) * scale, showSeconds)
								task.wait(impactSeconds)
								if not stillValid(player, token, figure, fighters) then return end

								local recoilSeconds = FightTimeline.beatSeconds(beat) * tempo
								if enemy and enemy.Parent ~= nil then
									onImpact()
									FigureFX.recoil(enemy, stageEnemyPos, stageSelfPos,
										MapConfig.FIGHT_SKILL_KNOCKBACK, MapConfig.FIGHT_HOP_HEIGHT * 1.6, recoilSeconds)
								else
									onImpact()
									task.wait(recoilSeconds)
								end
								local rest = showSeconds - impactSeconds - recoilSeconds
								if rest > 0 then task.wait(rest) end
								if not stillValid(player, token, figure, fighters) then return end
								showPlayed = true
							end
						end

						local seconds = FightTimeline.beatSeconds(beat) * tempo
						if showPlayed then
							-- Treffer kam schon in der Show (siehe oben).
						elseif attacker then
							FigureFX.clash(attacker, target, attackerHome, targetHome, {
								seconds   = seconds,
								gap       = MapConfig.FIGHT_CONTACT_GAP,
								hop       = MapConfig.FIGHT_HOP_HEIGHT * (if isSkill then 1.6 else 1),
								knockback = if isSkill then MapConfig.FIGHT_SKILL_KNOCKBACK else MapConfig.FIGHT_KNOCKBACK,
								step      = MapConfig.FIGHT_ENEMY_STEP_SHARE,
								onImpact  = onImpact,
							})
						else
							-- Gegner-Mesh fehlt: nur Leisten und Funken.
							onImpact()
							task.wait(seconds)
						end
					end

					if not stillValid(player, token, figure, fighters) then return end
				end

				-- Leisten auf den echten Endstand der Stage (falls Zuege
				-- ausgelassen wurden, stimmt so trotzdem alles).
				FightBars.tweenFill(selfFill, stage.hpAfter / maxHp, 0.15)
				FightBars.tweenFill(enemyFill, if stage.won then 0 else stageBeats[#stageBeats].enemyHp, 0.15)

				-- 14.10. Diese Stage ist FERTIG gespielt: sofort abrechnen (Gummies
				-- gehen gleich an den Spieler, nicht erst am Ende des Laufs).
				local doneNow = _active[player]
				if doneNow and doneNow.token == token and _runToken[player] == token then
					doneNow.completed = index
					local hook = doneNow.onStage
					if hook then
						local okHook, errHook = pcall(hook, index)
						if not okHook then
							warn("[PitArenaService] Stage-Auszahlung fehlgeschlagen:", errHook)
						end
					end
				end

				if stage.won then
					cleared += 1

					-- Besiegter Gegner kippt um, bevor der naechste kommt.
					-- Beim letzten Gegner macht das die Nachlauf-Pause unten.
					if index < #run.stages and enemy and enemy.Parent ~= nil then
						FigureFX.defeatCollapse(enemy, MapConfig.FIGHT_KO_SECONDS * tempo)
					end
				end
			end

			-- v12: JETZT abrechnen — mit den tatsaechlich gespielten Stages —
			-- und das Ergebnis an den Client schicken.
			local active = _active[player]
			local finalRun = run
			if active and active.token == token then
				finalRun = settleActive(active, active.entered, active.recall)
			end
			sendResult(player, token)

			-- Der letzte Gegner steht waehrend der Nachlauf-Pause noch da;
			-- weggeraeumt wird er unten von clearFighters.
			showSummary(player, finalRun)

			-- Wer die LETZTE Stage verloren hat, kippt sichtbar um, statt
			-- einfach zu verschwinden bzw. unveraendert stehenzubleiben.
			--
			-- Der eigene Baerchi kippt nur, wenn er den Lauf wirklich
			-- erschoepft beendet (hpAfter <= 0). Sonst laeuft er gleich darauf
			-- selbst nach Hause — eine umgekippte Figur, die losmarschiert,
			-- waere schlechter als gar keine Animation. Zurueckgesetzt wird die
			-- Neigung ohnehin von restoreHome.
			local lastStage = finalRun.stages[#finalRun.stages]
			local loser: Model? = nil

			if lastStage and lastStage.won then
				loser = previousEnemy
			elseif finalRun.hpAfter <= 0 then
				loser = figure
			end

			-- Das Umkippen laeuft INNERHALB der Nachlauf-Pause ab, verlaengert
			-- die Wiedergabe also nicht.
			local collapseSeconds = math.min(
				MapConfig.FIGHT_COLLAPSE_SECONDS,
				MapConfig.FIGHT_LINGER_SECONDS
			)

			if loser and loser.Parent ~= nil then
				FigureFX.defeatCollapse(loser, collapseSeconds)
				task.wait(math.max(0, MapConfig.FIGHT_LINGER_SECONDS - collapseSeconds))
			else
				task.wait(MapConfig.FIGHT_LINGER_SECONDS)
			end

			if not stillValid(player, token, figure, fighters) then return end

			-- Ueberlebt (hpAfter > 0): der Baerchi laeuft selbststaendig zu
			-- seinem Platz zurueck. Erschoepft (hpAfter <= 0): er ist ausser
			-- Gefecht und steht einfach wieder normal auf dem Plot — die
			-- anschliessende restoreHome() setzt ihn dafuer direkt zurueck,
			-- ganz ohne Lauf-Animation.
			-- 20.10. Final-Epilog: bleibt der Turm stehen (Gipfel), faehrt der Baerchi
			-- nicht mit ihm hinunter; restoreHome unten setzt ihn heim.
			if finalRun.hpAfter > 0 and not MapService.getTowerHold(player) then
				setPhase(player, token, "Returning", nil)

				-- Vor dem eigenen PivotTo abmelden: sonst zoegen Idle-Loop und
				-- Lauf-Animation im selben Frame an derselben Figur. Wieder
				-- angemeldet wird sie am Ende von restoreHome, auf ihrem Platz.
				FigureFX.stopIdle(figure)

				-- v12: erst mit dem Turm wieder nach unten fahren — sonst liefe
				-- er auf Turmhoehe durch die Luft nach Hause.
				if towerNow > 0 then
					clearFighters(player)
					if not rideTower(player, token, figure, fighters, towerNow, 0, MapConfig.PIT_TOWER_FALL_SECONDS, selfPos, enemyPos) then
						return
					end
					finalSelfPos = selfPos
				end

				local current = _active[player]
				if current and current.token == token and current.handoff then
					-- 14.10. Uebergabe an ein anderes Ziel: Stage zu Ende gespielt,
					-- Turm runter — aber nicht heim.
					handedOff = true
					return
				end

				FigureWalker.walkPath(figure, PlotRoutes.route(laneFrame, finalSelfPos, homeFoot), {
					speed       = arenaWalkSpeed(),
					bobPerStud  = arenaBobPerStud(),
					isCancelled = function() return not stillValid(player, token, figure, fighters) end,
				})
			end
		end)

		if not ok then
			warn("[PitArenaService] Wiedergabe fehlgeschlagen:", err)
		end

		-- Fallback: ist die Schleife oben aus irgendeinem Grund abgebrochen
		-- oder auf einen Fehler gelaufen, BEVOR der Baerchi angekommen ist,
		-- haette der Client sonst nie ein Ergebnis bekommen. sendResult ist
		-- idempotent — war es schon raus, passiert hier nichts mehr.
		sendResult(player, token)

		-- Nur aufraeumen wenn diese Wiedergabe noch die aktuelle ist —
		-- sonst wuerde man einem bereits gestarteten neuen Lauf die Figur
		-- unter den Fuessen wegziehen.
		if _runToken[player] == token then
			local ending = _active[player]
			local wantsHandoff = ending ~= nil and ending.token == token and ending.handoff
			restoreHome(player, handedOff)
			clearFighters(player)
			MapService.setPitTowerLevel(player, 0)
			MapService.clearPitBanner(player)
			refreshState(player)
			ActivityLock.release(player, LOCK_HOLDER)
			if _active[player] and _active[player].token == token then
				_active[player] = nil
			end

			-- 14.10. Das Ziel der Uebergabe uebernimmt JETZT (gleicher Frame: das
			-- Schloss ist frei, aber noch niemand hat es sich geholt).
			local handler = _handoffHandler
			if wantsHandoff and handler then
				task.spawn(handler, player)
			end
		end
	end)
end

-- Laeuft fuer diesen Spieler gerade eine Wiedergabe (Hinlauf, Stages,
-- Nachlauf oder Ruecklauf)? CombatService fragt das VOR einem neuen
-- RequestStartCombat ab: der Cooldown auf diesem Remote (1s,
-- NetworkConfig) ist kuerzer als eine volle Wiedergabe — ohne diese Sperre
-- koennte ein zweiter Lauf mitten in den ersten hineinstarten und ihm die
-- Figur unter den Fuessen wegziehen.
--
-- _home ist dafuer das richtige Signal: es wird exakt fuer die Dauer einer
-- Wiedergabe gesetzt (startPlayback) und von restoreHome() wieder geleert,
-- egal ob sie normal zu Ende lief oder abgebrochen wurde.
-- HBB Paket 6: alle laufenden Laeufe fuer das Live-Kampf-Board (nur lesen).
function PitArenaService.liveRuns(): { { name: string, towerId: string?, stage: number?, phase: string } }
	local list = {}
	for player, active in _active do
		table.insert(list, {
			name    = player.DisplayName,
			towerId = active.run.towerId,
			stage   = active.stage,
			phase   = active.phase,
		})
	end
	return list
end

function PitArenaService.isRunning(player: Player): boolean
	return _home[player] ~= nil
end

-- Spielt einen fertig ausgerechneten Lauf ab. Kehrt sofort zurueck — die
-- eigentliche Wiedergabe laeuft nebenher.
--
-- Wirft NIE. Der Aufrufer (CombatService) steht mitten in der Abrechnung
-- eines Laufs: ein Fehler in dieser reinen Darstellung darf ihn nicht daran
-- hindern, die Daten zu speichern und den Client zu synchronisieren. Und er
-- darf vor allem keine Figur mit gesetztem "InArena" zuruecklassen — die
-- waere fuer den Rest der Sitzung von jeder Zustands-Aktualisierung
-- ausgenommen.
-- v15: `beats` = die Zuege je Stage (Index wie run.stages). Fehlen sie, wird
-- jede Stage als ein einziger Stoss gezeigt.
function PitArenaService.play(player: Player, run: Types.PitRunResult, settle: SettleFn?, beats: { { Types.FightBeat } }?, onStage: ((number) -> ())?)
	local ok, err = pcall(startPlayback, player, run, settle, beats, onStage)
	if ok then return end

	warn("[PitArenaService] Wiedergabe konnte nicht starten:", err)

	-- Aufraeumen was der abgebrochene Start schon angefasst haben koennte.
	-- Das ist nur deshalb gefahrlos, weil startPlayback den Token als ALLERSTES
	-- hochzaehlt: es gibt an dieser Stelle keine fremde Wiedergabe mehr, der
	-- man etwas wegraeumen koennte.
	--
	-- sendResult zuerst: schlug startPlayback ab, noch bevor es das Ergebnis
	-- verschicken konnte, bekaeme der Client sonst nie eins. _runToken[player]
	-- ist an dieser Stelle bereits der Token DIESES Versuchs — startPlayback
	-- setzt ihn als allerersten Schritt, bevor irgendetwas werfen kann.
	sendResult(player, _runToken[player] or 0)
	restoreHome(player)
	clearFighters(player)
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)
	refreshState(player)
	ActivityLock.release(player, LOCK_HOLDER)
	_active[player] = nil
end

-- v12: Spieler holt den Baerchi zurueck (Pet-Leiste). Auf dem Hinweg kehrt
-- er sofort um; im Kampf endet der Lauf nach der laufenden Stage. Auf dem
-- Rueckweg ist nichts mehr zu tun. true = Anfrage angenommen.
function PitArenaService.requestRecall(player: Player, handoff: boolean?): boolean
	local active = _active[player]
	if not active or active.phase == "Returning" then
		return false
	end
	active.recall  = true
	-- 14.10. handoff = der Spieler hat ein ANDERES Ziel gewaehlt: nach der
	-- laufenden Stage geht der Baerchi nicht heim, sondern direkt dorthin.
	-- Ein spaeteres "Heim" nimmt den Wunsch wieder zurueck (handoff = false).
	active.handoff = handoff == true
	return true
end

-- 14.10. Ein vorgemerktes Zurueckholen widerrufen (Spieler drueckt das Ziel noch
-- einmal): nur solange es noch nicht gegriffen hat, also zwischen den Stages
-- noch nicht abgerechnet wurde. true = der Baerchi kaempft einfach weiter.
function PitArenaService.cancelRecall(player: Player): boolean
	local active = _active[player]
	if not active or active.phase ~= "InPit" or active.settled ~= nil then
		return false
	end
	active.recall  = false
	active.handoff = false
	return true
end

-- 14.10. Harte Uebergabe: der Lauf endet SOFORT (Equip, direkter Wechsel auf
-- dem Hin- oder Rueckweg). Abgerechnet wird nur, was VOLLSTAENDIG gespielt
-- wurde — die angefangene Stage zaehlt nicht. Die Figur bleibt, wo sie steht.
function PitArenaService.releaseFigure(player: Player)
	local active = _active[player]
	if not active then return end

	local token = active.token
	_runToken[player] = token + 1   -- die alte Wiedergabe-Schleife endet beim naechsten Schritt

	-- Das Ergebnis geht HIER raus, nicht ueber den Fallback der alten Schleife
	-- (der wuerde mit den begonnenen statt den fertigen Stages abrechnen). Die
	-- Abrechnung yieldet (Speichern): `sent` vorher setzen.
	active.sent = true
	local result = settleActive(active, active.completed, true)
	if player.Parent ~= nil then
		Remotes.CombatResultReceived:FireClient(player, result)
	end

	restoreHome(player, true)
	clearFighters(player)
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)
	refreshState(player)
	ActivityLock.release(player, LOCK_HOLDER)
	_active[player] = nil
end

function PitArenaService.setHandoffHandler(handler: (Player) -> ())
	_handoffHandler = handler
end

-- v12: Phase des laufenden Laufs fuer die Pet-Leiste: "ToPit", "InPit",
-- "Returning" oder nil (kein Lauf). Dazu die laufende Stage (nur im Kampf).
function PitArenaService.getPhase(player: Player): (string?, number?)
	local active = _active[player]
	if not active or _home[player] == nil then
		return nil, nil
	end
	return active.phase, active.stage
end

-- v12: Ist dieser Baerchi gerade in einem noch nicht abgerechneten Lauf?
-- HoneyService lehnt Fuettern dann ab — die Abrechnung setzt die HP am Ende
-- auf den Wert nach der letzten Stage und wuerde eine Heilung dazwischen
-- ueberschreiben.
function PitArenaService.isFighting(player: Player, baerchiUid: string): boolean
	local active = _active[player]
	return active ~= nil and active.settled == nil and active.run.baerchiUid == baerchiUid
end

function PitArenaService.init()
	-- Verlaesst ein Spieler den Server mitten in der Wiedergabe, macht der
	-- Token-Vergleich die laufende Schleife ungueltig. Sein Plot wird ohnehin
	-- despawnt, aufraeumen muss hier nichts mehr.
	Players.PlayerRemoving:Connect(function(player)
		_runToken[player] = nil
		_home[player]     = nil
		_active[player]   = nil
		_speed[player]    = nil
	end)

	-- Paket 4.3: Tempo-Knopf der Pet-Leiste (PetBar).
	RateLimiter.connect(Remotes.RequestPitSpeed, "RequestPitSpeed", function(player, speed: any)
		if typeof(speed) ~= "number" or VALID_SPEEDS[speed] == nil then return end
		_speed[player] = speed
	end)

	-- v12: geht der Spieler mitten im Lauf, wird VOR dem Speichern
	-- abgerechnet — so, als waere die gerade begonnene Stage zu Ende gespielt.
	PlayerService.onPlayerLeaving(function(player)
		local active = _active[player]
		if active then
			settleActive(active, active.entered, active.recall)
		end
	end)

	print("[PitArenaService] Initialisiert")
end

return PitArenaService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source"><![CDATA[--!strict
-- PlayerService.luau
-- ServerScriptService/Services/PlayerService.luau
--
-- Einzige Zustaendigkeit:
--   - Spielerdaten laden (DataStore) und im Speicher halten
--   - Spielerdaten speichern (beim Leave und periodisch)
--   - Insel spawnen/despawnen via MapService
--   - Anderen Services Zugriff auf PlayerData geben
--
-- Kein anderer Service beruehrt den DataStore. Geschrieben wird mit
-- UpdateAsync und einer Sitzungs-Sperre im Spielstand (Util/SessionLock),
-- damit zwei Server nie gegenseitig ihren Fortschritt ueberschreiben. Die
-- Migration alter Spielstaende steht in Util/PlayerMigration.
--
-- Hinweis zu onDataLoaded():
--   PlayerService darf EconomyService NICHT requiren (EconomyService requiret
--   PlayerService — das waere ein Zirkel). Services die beim Join etwas
--   gutschreiben wollen (z.B. HoneyService fuer den Offline-Honig) registrieren
--   deshalb hier einen Callback statt selbst an PlayerAdded zu haengen —
--   nur so ist garantiert dass die Daten zum Zeitpunkt des Callbacks geladen sind.

local Players       = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local QuestProgress   = require(ReplicatedStorage.Modules.QuestProgress)
local ShopRules     = require(ReplicatedStorage.Modules.ShopRules)
local ShopConfig    = require(ReplicatedStorage.Config.ShopConfig)
local MapService      = require(ServerScriptService.Services.MapService)
local RateLimiter     = require(ServerScriptService.Util.RateLimiter)
local PlayerMigration = require(ServerScriptService.Util.PlayerMigration)
local SessionLock     = require(ServerScriptService.Util.SessionLock)

--------------------------------------------------------------------------------
-- Konstanten
--------------------------------------------------------------------------------

local DATA_STORE_NAME = "PlayerData_v1"
-- v1 im Namen: wenn wir das Schema brechen, wird es v2 und alte Daten
-- werden nicht mehr geladen (sauberer als Migration fuer early dev).
-- Nicht-brechende Feld-Ergaenzungen laufen ueber
-- PlayerMigration.applyDefaults().

-- Spaetestens nach so vielen Sekunden wird auf jeden Fall gespeichert.
local SAVE_INTERVAL = 60

-- Fruehestens nach so vielen Sekunden darf derselbe Schluessel wieder
-- geschrieben werden. Roblox drosselt Schreibvorgaenge auf denselben
-- Schluessel unterhalb von etwa sechs Sekunden und verwirft sie irgendwann
-- ganz. saveNow() wird von vielen Stellen aufgerufen (Ei oeffnen,
-- fusionieren, verwerten, kaempfen, zwei Upgrades, Rebirth) — ohne diese
-- Bremse kaeme ein normal spielender Mensch auf mehrere Schreibvorgaenge
-- pro Sekunde.
local MIN_SAVE_GAP = 7

-- Wie oft nachgesehen wird ob jemand faellig ist.
local SAVE_TICK = 5

--------------------------------------------------------------------------------
-- DataStore-Zugriff
--
-- GetDataStore() wirft in einem unveroeffentlichten Place ("You must publish
-- this place to the web to access DataStore") und in Studio ohne aktivierte
-- API-Services. Frueher stand der Aufruf auf Modulebene — ein Fehler dort hat
-- PlayerService, EconomyService und damit den ganzen GameManager mitgerissen.
--
-- Deshalb: verzoegert holen, in pcall, und bei Nichtverfuegbarkeit auf einen
-- reinen Sitzungs-Speicher zurueckfallen. Das Spiel bleibt in Studio komplett
-- testbar (inklusive Leave/Rejoin und Offline-Ertrag), nur ueberlebt der
-- Fortschritt keinen Server-Neustart. Im veroeffentlichten Place greift
-- automatisch der echte DataStore.
--------------------------------------------------------------------------------

local _dataStore: DataStore? = nil
local _dataStoreChecked = false

-- Fallback wenn kein DataStore verfuegbar ist, key = "player_<UserId>"
local _sessionStore: { [string]: Types.PlayerData } = {}

local function getDataStore(): DataStore?
	if _dataStoreChecked then
		return _dataStore
	end
	_dataStoreChecked = true

	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(DATA_STORE_NAME)
	end)

	if ok then
		_dataStore = result
	else
		warn(
			"[PlayerService] DataStore nicht verfuegbar —",
			"Fortschritt wird nur fuer diese Server-Sitzung gehalten.",
			"Grund:", result
		)
	end

	return _dataStore
end

local function storageKey(player: Player): string
	return "player_" .. player.UserId
end

--------------------------------------------------------------------------------
-- Interner Zustand
-- Nur dieser Service liest/schreibt diese Tabelle.
--------------------------------------------------------------------------------

-- Alle geladenen Spielerdaten im Speicher, key = Player
local _playerData: { [Player]: Types.PlayerData } = {}

-- Timestamp des letzten Saves pro Spieler
local _lastSave: { [Player]: number } = {}

-- Spieler die gerade geladen werden (verhindert Doppel-Joins)
local _loading: { [Player]: boolean } = {}

-- Spieler deren Spielstand NICHT geladen werden konnte. Ihre Sitzung ist
-- spielbar, wird aber nie gespeichert — sonst wuerden die frischen
-- Standardwerte den echten Spielstand ueberschreiben.
local _noSave: { [Player]: boolean } = {}

-- Spieler die gespeichert werden wollen, aber gerade in der Schonfrist
-- stecken (siehe MIN_SAVE_GAP). Die Auto-Save-Schleife holt sie nach.
local _pendingSave: { [Player]: boolean } = {}

-- Callbacks anderer Services, ausgefuehrt direkt nach dem Laden
local _onDataLoaded: { (Player, Types.PlayerData) -> () } = {}

-- Callbacks anderer Services, ausgefuehrt nach allen _onDataLoaded
local _onPlayerReady: { (Player, Types.PlayerData) -> () } = {}

-- Callbacks anderer Services, ausgefuehrt bei jedem markDirty
local _onDataChanged: { (Player, Types.PlayerData) -> () } = {}

-- v12: Callbacks, die beim Verlassen (und beim Server-Shutdown) laufen,
-- BEVOR gespeichert wird. Grund: ein PIT-Lauf wird erst am Ende seiner
-- Wiedergabe abgerechnet (PitArenaService). Verlaesst der Spieler mitten im
-- Lauf, muss die Abrechnung noch in den Spielstand, bevor er geschrieben
-- wird — die Reihenfolge zweier PlayerRemoving-Verbindungen ist dafuer
-- nicht verlaesslich genug.
local _onPlayerLeaving: { (Player, Types.PlayerData) -> () } = {}

local function runLeavingCallbacks(player: Player, data: Types.PlayerData)
	for _, callback in _onPlayerLeaving do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[PlayerService] onPlayerLeaving-Callback fehlgeschlagen:", err)
		end
	end
end

--------------------------------------------------------------------------------
-- Hilfsfunktionen (privat)
--------------------------------------------------------------------------------

-- Wie oft das Laden bei einem DataStore-Fehler erneut versucht wird, und wie
-- lange dazwischen gewartet wird (verdoppelt sich jedes Mal).
local LOAD_RETRIES     = 3
local LOAD_RETRY_DELAY = 2

-- Haelt ein anderer Server den Spielstand noch (siehe Util/SessionLock), wird
-- so oft im Abstand von SESSION_WAIT_SECONDS erneut gefragt. Der Normalfall
-- ist ein schneller Serverwechsel: der alte Server schreibt beim Verlassen und
-- gibt die Sperre dabei frei, das dauert Sekunden. Insgesamt 30 Sekunden
-- reichen dafuer und sind kurz genug, dass der Spieler nicht ewig wartet.
local SESSION_WAIT_ATTEMPTS = 5
local SESSION_WAIT_SECONDS  = 6

-- In Studio ist game.JobId leer. Alle Studio-Sitzungen gelten dann als
-- derselbe Server, sonst sperrte man sich beim Neustart einer Testsitzung
-- selbst aus.
local function currentJobId(): string
	return if game.JobId ~= "" then game.JobId else "studio"
end

-- Ein Ladeversuch: liest den Spielstand und traegt im SELBEN Schreibvorgang
-- diesen Server als Halter ein (UpdateAsync ist dafuer atomar). Ergebnis:
--   "ok"     data ist der rohe Spielstand (isNew = frisch angelegt)
--   "locked" ein anderer Server haelt ihn, es wurde nichts geschrieben
--   "error"  der DataStore hat geworfen, data ist die Fehlermeldung
local function tryLoadAndClaim(store: DataStore, key: string): (string, any, boolean)
	local jobId = currentJobId()
	local outcome = "ok"
	local loaded: any = nil
	local isNew = false

	local success, err = pcall(function()
		store:UpdateAsync(key, function(old: any)
			-- Roblox kann diesen Rueckruf mehrfach aufrufen (Konflikt beim
			-- Schreiben). Deshalb setzt jeder Durchlauf alle Ergebnisse neu.
			local now = os.time()
			if old ~= nil and SessionLock.isHeldByOther(old.session, jobId, now) then
				outcome, loaded, isNew = "locked", nil, false
				return nil   -- nil = nichts schreiben
			end

			local data = if old ~= nil then old else Types.createDefaultPlayerData()
			data.session = SessionLock.claim(jobId, now)
			outcome, loaded, isNew = "ok", data, old == nil
			return data
		end)
	end)

	if not success then
		return "error", err, false
	end
	return outcome, loaded, isNew
end

-- Liefert (Spielstand, darf gespeichert werden).
local function loadFromDataStore(player: Player): (Types.PlayerData, boolean)
	local key   = storageKey(player)
	local store = getDataStore()

	-- Kein DataStore (unveroeffentlichter Place / Studio ohne API-Services):
	-- aus dem Sitzungs-Speicher lesen, damit Leave/Rejoin trotzdem testbar ist.
	if not store then
		local cached = _sessionStore[key]
		if cached then
			return PlayerMigration.applyDefaults(cached), true
		end
		return Types.createDefaultPlayerData(), true
	end

	-- Mehrfach versuchen: ein einzelner DataStore-Aussetzer (Drosselung,
	-- Roblox-Stoerung) ist haeufig und geht meist beim zweiten Versuch durch.
	-- Fehler und fremde Sperre werden getrennt gezaehlt, weil sie verschieden
	-- lange brauchen, um sich aufzuloesen.
	local lastError: any = nil
	local errors = 0
	local waits  = 0

	while true do
		local outcome, result, isNew = tryLoadAndClaim(store, key)

		if outcome == "ok" then
			-- Ein frischer Spielstand ist schon aktuell; nur alte Staende
			-- laufen durch die Migration.
			if isNew then
				return result, true
			end
			return PlayerMigration.applyDefaults(result), true
		end

		if outcome == "locked" then
			waits += 1
			if waits >= SESSION_WAIT_ATTEMPTS then
				-- Der andere Server meldet sich weiter. Ihn zu ueberschreiben
				-- hiesse, seinen Fortschritt zu loeschen. Also dieselbe
				-- Behandlung wie ein Lesefehler: spielbar, aber nie gespeichert.
				warn(
					"[PlayerService] Spielstand von", player.Name,
					"wird noch von einem anderen Server gehalten — Sitzung laeuft OHNE Speichern weiter."
				)
				return Types.createDefaultPlayerData(), false
			end
			task.wait(SESSION_WAIT_SECONDS)
		else
			errors += 1
			lastError = result
			if errors >= LOAD_RETRIES then
				break
			end
			task.wait(LOAD_RETRY_DELAY * errors)
		end

		-- Wer waehrend des Wartens geht, braucht keinen Spielstand mehr.
		if player.Parent == nil then
			return Types.createDefaultPlayerData(), false
		end
	end

	-- Auch nach allen Versuchen kein Erfolg. Der Spieler bekommt eine
	-- spielbare Sitzung, aber sie DARF NICHT GESPEICHERT werden:
	-- sonst wuerde der Auto-Save die frischen Standardwerte ueber einen
	-- vollkommen intakten Spielstand schreiben und ihn dauerhaft loeschen.
	warn(
		"[PlayerService] Laden endgueltig fehlgeschlagen fuer", player.Name,
		"— Sitzung laeuft OHNE Speichern weiter. Grund:", lastError
	)
	return Types.createDefaultPlayerData(), false
end

-- Schreibt den Spielstand. release = true beim Verlassen und beim Shutdown:
-- dann wird die Sitzungs-Sperre freigegeben, damit der naechste Server sofort
-- laden kann, statt auf ihren Ablauf zu warten.
local function saveToDataStore(player: Player, data: Types.PlayerData, release: boolean): boolean
	-- Konnte der Spielstand nicht geladen werden, wird auch nicht gespeichert.
	-- Siehe loadFromDataStore: sonst ueberschreibt eine Standard-Datei den
	-- echten Spielstand.
	if _noSave[player] then
		return false
	end

	-- Zeitstempel VOR dem Schreiben setzen. UpdateAsync haelt den Thread an;
	-- stuende die Zeile darunter, wuerde die Auto-Save-Schleife waehrend des
	-- Wartens immer wieder dieselbe Bedingung erfuellen und dutzende
	-- gleichzeitige Schreibvorgaenge auf denselben Schluessel ausloesen.
	_lastSave[player] = os.time()
	data.lastSeenAt   = os.time()

	local key   = storageKey(player)
	local store = getDataStore()

	if not store then
		_sessionStore[key] = data
		return true
	end

	-- UpdateAsync statt SetAsync: es liest den gespeicherten Stand, bevor es
	-- schreibt. Hat inzwischen ein anderer Server die Sperre uebernommen (weil
	-- unsere abgelaufen ist), wird NICHT geschrieben — dessen Stand ist neuer.
	local jobId = currentJobId()
	local lostLock = false

	local success, err = pcall(function()
		store:UpdateAsync(key, function(old: any)
			local now = os.time()
			if old ~= nil and SessionLock.isHeldByOther(old.session, jobId, now) then
				lostLock = true
				return nil
			end
			lostLock = false
			data.session = if release then nil else SessionLock.claim(jobId, now)
			return data
		end)
	end)

	if not success then
		warn("[PlayerService] DataStore-Fehler beim Speichern fuer", player.Name, ":", err)
	elseif lostLock then
		-- Ab jetzt gilt der andere Server. Diese Sitzung schreibt nie wieder,
		-- sonst wechselten sich zwei Staende gegenseitig ab.
		_noSave[player] = true
		warn(
			"[PlayerService] Sitzungs-Sperre von", player.Name,
			"liegt bei einem anderen Server — diese Sitzung speichert nicht mehr."
		)
	end

	-- HBB Paket 10: Rueckmeldung fuer Robux-Kaeufe (ShopService.processReceipt)
	return success and not lostLock
end

-- v15: wer die Login-Bonus-Sicht baut (LoginBonusService haengt sich ein —
-- dort liegt der Debug-Zeitversatz; ein require waere ein Ringschluss).
local _dailyViewProvider: ((Types.PlayerData) -> Types.DailyView)? = nil

local function dailyView(data: Types.PlayerData): Types.DailyView
	local provider = _dailyViewProvider
	if provider then
		local ok, view = pcall(provider, data)
		if ok then return view end
	end
	return { day = 1, claimable = false, streak = 0, resetIn = 0 }
end

-- Baut das Client-Paket aus den Serverdaten.
-- Stats bleiben bewusst draussen (kein Leak sensibler Serverdaten).
-- HBB Paket 10: Sicht fuer das Shop-Fenster
local function shopView(data: Types.PlayerData): Types.ShopView?
	local shop = (data :: any).shop
	if not shop then return nil end
	local now = os.time()
	return {
		freeReady  = ShopRules.freeReady(shop, now),
		nextFreeIn = ShopRules.secondsUntilNextDay(now),
		freeGold   = ShopConfig.FREE_GRAB_GOLD,
	}
end

local function buildUpdate(data: Types.PlayerData): Types.PlayerDataUpdate
	return {
		gummies      = data.gummies,
		goldGummies  = data.goldGummies,
		rebirthCount = data.rebirthCount,
		rebirthMult  = data.rebirthMult,
		rank         = data.rank,
		language     = data.language,
		audio        = data.audio,
		island       = data.island,
		discovered   = data.discovered,
		quests       = QuestProgress.buildView(data, os.time()),
		eggTree      = data.eggTree,
		towers       = data.towers,
		epilog       = data.epilog,   -- v18
		worlds       = data.worlds,   -- v18
		daily        = dailyView(data),
		-- HBB Paket 2: Zaehler und Konto-Alter fuer Fuehrung/Freischaltung
		stats        = data.stats :: any,
		createdAt    = data.createdAt,
		uiSeen       = data.uiSeen,   -- HBB Paket 3
		shop         = shopView(data),  -- HBB Paket 10
		indexClaimed = data.indexClaimed,   -- Sammel-Update Paket 7
	}
end

-- Sendet den aktuellen Spielerzustand an den Client
-- Wird nach jeder relevanten Aenderung aufgerufen
local function syncToClient(player: Player)
	local data = _playerData[player]
	if not data then return end

	Remotes.PlayerDataUpdated:FireClient(player, buildUpdate(data))
end

--------------------------------------------------------------------------------
-- Oeffentliche API
-- Andere Services rufen diese Funktionen auf.
--------------------------------------------------------------------------------

local PlayerService = {}

-- Gibt PlayerData zurueck — nil wenn noch nicht geladen
function PlayerService.getData(player: Player): Types.PlayerData?
	return _playerData[player]
end

-- Gibt PlayerData zurueck und wirft einen Fehler wenn nicht vorhanden
-- Fuer Services die sicher sind dass der Spieler eingeloggt ist
function PlayerService.getDataOrError(player: Player): Types.PlayerData
	local data = _playerData[player]
	assert(data, "[PlayerService] Keine Daten fuer Spieler: " .. player.Name)
	return data
end

-- Wird von anderen Services aufgerufen nachdem sie Daten veraendert haben.
-- Loest Client-Sync aus. Services aendern Daten direkt auf dem Objekt,
-- rufen dann markDirty() — kein Kopieren, kein Callback-Hell.
function PlayerService.markDirty(player: Player)
	syncToClient(player)

	local data = _playerData[player]
	if not data then return end

	-- Beobachter benachrichtigen (z.B. PlotDisplayService, das die Figuren und
	-- Schilder auf der Insel nachzieht). Ein Callback darf hier NICHT selbst
	-- markDirty aufrufen — das waere eine Endlosschleife.
	for _, callback in _onDataChanged do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[PlayerService] onDataChanged-Callback fehlgeschlagen:", err)
		end
	end
end

-- Nach einer wichtigen Aenderung speichern (Kauf, Kampf, Rebirth).
--
-- "Sofort" nur wenn die Schonfrist abgelaufen ist — sonst wird es lediglich
-- vorgemerkt und die Auto-Save-Schleife holt es nach, sobald sie darf. Ohne
-- das wuerde Roblox die Schreibvorgaenge irgendwann verwerfen, und dann waere
-- ausgerechnet der Fortschritt weg, den dieser Aufruf sichern sollte.
--
-- Der Leave- und der Shutdown-Weg gehen bewusst direkt auf saveToDataStore
-- und umgehen die Bremse: dort gibt es kein spaeter mehr.
function PlayerService.saveNow(player: Player)
	local data = _playerData[player]
	if not data then return end

	if os.time() - (_lastSave[player] or 0) >= MIN_SAVE_GAP then
		saveToDataStore(player, data, false)
	else
		_pendingSave[player] = true
	end
end

-- HBB Paket 10: SOFORT speichern und melden, ob es geklappt hat. Nur fuer
-- Robux-Kaeufe: Roblox verlangt, dass ein Kauf gespeichert ist, bevor
-- ProcessReceipt "gewaehrt" meldet. Umgeht bewusst MIN_SAVE_GAP (Kaeufe sind
-- selten). Blockiert, bis UpdateAsync fertig ist.
function PlayerService.saveConfirmed(player: Player): boolean
	local data = _playerData[player]
	if not data then return false end
	_pendingSave[player] = nil
	return saveToDataStore(player, data, false)
end

-- v15: LoginBonusService haengt hier ein, wie die Login-Bonus-Sicht im
-- Client-Paket gebaut wird.
function PlayerService.setDailyViewProvider(provider: (Types.PlayerData) -> Types.DailyView)
	_dailyViewProvider = provider
end

-- Frische Standard-Insel. Einzige erlaubte Quelle fuer einen Insel-Reset —
-- RebirthService benutzt dies statt Types.createDefaultPlayerData selbst
-- aufzurufen (Regel: nur PlayerService ruft die Default-Fabrik auf).
function PlayerService.buildDefaultIsland(): Types.IslandData
	return Types.createDefaultPlayerData().island
end

-- HBB Paket 0: kompletter Startstand fuer den Debug-Zustand "fresh"
-- (DebugService). Aus demselben Grund wie oben hier und nicht dort.
function PlayerService.buildDefaultData(): Types.PlayerData
	return Types.createDefaultPlayerData()
end

-- Registriert einen Callback der laeuft sobald die Daten eines Spielers
-- geladen und seine Insel gespawnt ist — aber bevor der erste Client-Sync
-- rausgeht. Hier gehoert alles hin, was die Daten beim Join noch aendert
-- (Offline-Honig, Offline-Eier, Ausruesten). Aus init() aufrufen: Spieler
-- werden erst in start() geladen, also verpasst kein Callback einen Join.
--
-- Die Callbacks laufen in Anmelde-Reihenfolge. Keiner darf sich auf einen
-- anderen verlassen; wer den fertigen Stand braucht, nimmt onPlayerReady.
function PlayerService.onDataLoaded(callback: (Player, Types.PlayerData) -> ())
	table.insert(_onDataLoaded, callback)
end

-- Registriert einen Callback der nach ALLEN onDataLoaded-Callbacks laeuft,
-- direkt vor dem ersten Client-Sync. Fuer alles, was den fertig geladenen
-- Stand nur anzeigt (Schilder, gelegte Eier in der Welt). Darf die Daten
-- nicht mehr aendern.
function PlayerService.onPlayerReady(callback: (Player, Types.PlayerData) -> ())
	table.insert(_onPlayerReady, callback)
end

-- Registriert einen Callback der bei JEDER Datenaenderung laeuft (markDirty).
-- Wird oft aufgerufen — der Callback muss selbst entscheiden ob er wirklich
-- etwas tun muss, und darf nicht seinerseits markDirty aufrufen.
function PlayerService.onDataChanged(callback: (Player, Types.PlayerData) -> ())
	table.insert(_onDataChanged, callback)
end

-- v12: Callback, der beim Verlassen VOR dem Speichern laeuft (siehe
-- _onPlayerLeaving). Darf Daten aendern, aber nicht yielden.
function PlayerService.onPlayerLeaving(callback: (Player, Types.PlayerData) -> ())
	table.insert(_onPlayerLeaving, callback)
end

--------------------------------------------------------------------------------
-- Join / Leave
--------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	if _loading[player] then return end
	_loading[player] = true

	-- Daten laden (kann einen Moment dauern).
	--
	-- Zusaetzlich in pcall: die Migration (PlayerMigration) rechnet fuer alte
	-- Spielstaende echte Kampfwerte aus. Ein einzelner kaputter Eintrag darf
	-- den Join nicht mittendrin abbrechen — sonst bliebe _loading fuer immer
	-- gesetzt, der Spieler haette nie Daten und jedes Remote liefe still ins
	-- Leere, ohne dass irgendwo ein Fehler sichtbar waere.
	local ok, data, canSave = pcall(loadFromDataStore, player)

	if not ok then
		warn("[PlayerService] Spielstand von", player.Name, "ist beschaedigt:", data)
		data    = Types.createDefaultPlayerData()
		canSave = false   -- niemals ueber einen Stand schreiben den wir nicht lesen konnten
	end

	-- Spieler kann waehrend des Ladens schon wieder weg sein
	if player.Parent == nil then
		_loading[player] = nil
		return
	end

	if not canSave then
		_noSave[player] = true
	end

	_playerData[player] = data
	_lastSave[player]   = os.time()
	_loading[player]    = nil

	-- Insel spawnen — setzt dabei auch player.RespawnLocation auf die eigene
	-- Insel (siehe MapService.buildPlotBase).
	MapService.spawnIsland(player, data.island)

	-- Erst JETZT den Charakter laden: Players.CharacterAutoLoads steht in
	-- GameManager auf false, genau damit kein Spieler zwischen Join und
	-- geladenen Daten kurz in der Weltmitte auftaucht. RespawnLocation ist ab
	-- hier gesetzt (oder, falls der Server keinen freien Plot mehr hatte,
	-- eben nicht — dann faellt LoadCharacter auf den Not-Spawn zurueck, siehe
	-- MapService.buildPlatform).
	player:LoadCharacter()

	-- Andere Services informieren (Offline-Progress etc.)
	-- pcall: ein fehlerhafter Callback darf den Join nicht abbrechen.
	for _, callback in _onDataLoaded do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[PlayerService] onDataLoaded-Callback fehlgeschlagen:", err)
		end
	end

	-- HBB Paket 10: jede geladene Sitzung zaehlt (Shop ab der zweiten)
	data.stats.sessions = (data.stats.sessions or 0) + 1

	for _, callback in _onPlayerReady do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[PlayerService] onPlayerReady-Callback fehlgeschlagen:", err)
		end
	end

	-- Ersten Sync zum Client
	syncToClient(player)

	print("[PlayerService] Spieler geladen:", player.Name,
		"| Gummies:", data.gummies,
		"| Rebirths:", data.rebirthCount)
end

local function onPlayerRemoving(player: Player)
	local data = _playerData[player]
	if data then
		runLeavingCallbacks(player, data)
		saveToDataStore(player, data, true)
		MapService.despawnIsland(player)
	end

	_playerData[player]  = nil
	_lastSave[player]    = nil
	_loading[player]     = nil
	_noSave[player]      = nil
	_pendingSave[player] = nil

	print("[PlayerService] Spieler entfernt:", player.Name)
end

--------------------------------------------------------------------------------
-- Auto-Save Loop
--------------------------------------------------------------------------------

-- Bewusst eine eigene Schleife und nicht Heartbeat: ein Speicher-Timer hat
-- nichts an der Bildwiederholrate zu suchen. Vorher lief die Pruefung 60 mal
-- pro Sekunde und ein einzelner faelliger Spieler loeste dutzende parallele
-- Schreibvorgaenge aus, weil das Schreiben den Thread anhaelt.
local function startAutoSave()
	task.spawn(function()
		while true do
			task.wait(SAVE_TICK)

			local now = os.time()
			for player, data in _playerData do
				local since = now - (_lastSave[player] or 0)

				-- Zwei Gruende zu speichern: es liegt eine Vormerkung aus
				-- saveNow vor, oder es ist einfach lange genug her.
				local wanted = _pendingSave[player] or since >= SAVE_INTERVAL

				if wanted and since >= MIN_SAVE_GAP then
					_pendingSave[player] = nil

					local ok, err = pcall(saveToDataStore, player, data, false)
					if not ok then
						warn("[PlayerService] Auto-Save fehlgeschlagen fuer", player.Name, ":", err)
					end
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function PlayerService.init()
	-- Reconnect-Fall: Client fragt seinen Zustand aktiv an.
	-- Ohne diesen Handler blockiert ein GetPlayerData-Invoke ewig.
	RateLimiter.connectFunction(Remotes.GetPlayerData, "GetPlayerData", function(player: Player)
		local data = _playerData[player]
		if not data then
			-- Noch nicht fertig geladen — Client soll auf PlayerDataUpdated warten
			return nil
		end
		return buildUpdate(data)
	end)

	-- Sicherheitsnetz: beim Server-Shutdown alle speichern
	game:BindToClose(function()
		for player, data in _playerData do
			runLeavingCallbacks(player, data)
			saveToDataStore(player, data, true)
		end
	end)

	startAutoSave()

	-- Verfuegbarkeit einmal beim Start pruefen, damit die Warnung im Log steht
	-- bevor der erste Spieler joint — und nicht mitten in einem Join auftaucht.
	if getDataStore() then
		print("[PlayerService] Initialisiert | DataStore aktiv")
	else
		print("[PlayerService] Initialisiert | OHNE DataStore — nur Sitzungs-Speicher")
	end
end

-- Erst hier werden Spieler geladen: GameManager ruft start() nach ALLEN
-- init(). Damit hat jeder Service seine Callbacks angemeldet, bevor der erste
-- Join sie ausloest — egal, wo er in der Startliste steht.
function PlayerService.start()
	-- Bereits verbundene Spieler (in Studio-Play-Solo ist der Spieler oft
	-- schon da, bevor der Server mit dem Starten fertig ist)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
end

return PlayerService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">PlotDisplayService</string><ProtectedString name="Source"><![CDATA[--!strict
-- PlotDisplayService.luau
-- ServerScriptService/Services/PlotDisplayService.luau
--
-- Einzige Zustaendigkeit:
--   - Entscheiden WANN die sichtbare Darstellung eines Plots nachgezogen
--     werden muss — und mit welchem der drei unterschiedlich teuren Wege.
--
-- Haengt an PlayerService.onDataChanged. Das feuert bei JEDER Aenderung, also
-- auch bei jedem einzelnen Gummy. Alles jedes Mal neu zu bauen waere
-- Verschwendung, deshalb merkt sich dieser Service drei Signaturen und
-- vergleicht sie:
--
--   STRUKTUR   (uid + Level jedes Baerchis)
--       → MapService.updateBaerchis: baut alle Mesh-Figuren neu. Teuer.
--         Noetig wenn ein Baerchi dazukommt, wegfaellt oder im Level steigt.
--
--   ZUSTAND    (uid + aktuelle HP)
--       → MapService.updateBaerchiStates: schreibt nur Beschriftung und
--         Erschoepfung an bestehende Figuren. Billig. HP aendern sich bei
--         jedem Fuettern und jedem PIT-Lauf — dafuer 25 Meshes neu zu bauen
--         waere absurd.
--
--   GEBAEUDE   (id + Level + Honig)
--       → MapService.updateBuildingSigns: schreibt die Schilder neu. Billig.
--         Honig aendert sich alle 20 Sekunden.
--
--   EIER       (uids der herumliegenden Eier)
--       → MapService.updateLaidEggs: baut die kleinen Kugeln neu. Billig —
--         es sind hoechstens zwoelf, und sie sind keine Meshes.
--         Aendert sich, wenn der Baerchi eines legt oder der Spieler eines
--         aufsammelt.
--
--   RECYCLER   (Level + Warteschlange des Waben-Recyclers)
--       → MapService.updateRecycler: schreibt Schild und Lampe. Billig.
--         Aendert sich jede Sekunde, solange der Recycler arbeitet.
--
--   LOOKS      (v15: Look-Stufe jedes Gebaeudes und des Recyclers)
--       → MapService.updateBuildingLooks: baut genau das Gebaeude neu, dessen
--         Look sich geaendert hat, mit kurzer Aufwertungs-Show. Haengt am
--         LOOK, nicht am Level — ein Ausbau innerhalb eines Looks schreibt nur
--         das Schild (GEBAEUDE oben).
--
--   STUFE      (Welt aufwerten, Paket D: Insel-Stufe 1..4 aus Towern und
--               Rebirths, Modules/IslandStage)
--       → Attribut "IslandStage" am Player (ueberlebt jeden Insel-Neuaufbau).
--         Die Deko baut nur der Client (PlotLifeController), der Server baut
--         dafuer kein einziges Teil.
--
--   TOWER      (v15: Look + Etagen + Schildtext des Tower-Turms)
--       → MapService.updateTowerShowcase (Neuaufbau des Turms, Show nur beim
--         Look-Wechsel) und MapService.setOwnerBadge (Symbol am Plot-Schild).
--         Aendert sich nur bei einem neuen Rekord oder Tower.
--
--   TERMINAL   (08.10.: Zustand, gewaehlter Tower, Rekord, Fortschritt)
--      → MapService.updateTerminal: schreibt nur Attribute, kein Neubau.
--
-- Die Figuren und Schilder selbst baut MapService — dieser Service entscheidet
-- nur WANN und WELCHE Tiefe.
--
-- EINE SACHE ENTSCHEIDET DIESER SERVICE BEWUSST NICHT: ob die Figur gerade
-- mitten in einer Bewegung steckt. Diese Sperre sitzt in
-- MapService.updateBaerchis selbst, damit sie fuer JEDEN Aufrufer gilt und
-- nicht an jeder Aufrufstelle wiederholt werden muss. Hier unten wird nur die
-- Quelle fuer frische Daten eingehaengt, mit der MapService den verschobenen
-- Neuaufbau spaeter nachholt (siehe init).
--
-- Wichtig fuer das Verstaendnis des Signatur-Vergleichs: eine verschobene
-- Darstellung gilt hier trotzdem sofort als "dargestellt". Das ist richtig, so
-- lange MapService das Nachholen uebernimmt — waere es andersherum, muesste
-- dieser Service den Zustand einer fremden Warteschlange mitverfolgen.
--
-- Ersetzt den frueheren BaerchiDisplayService, der nur die Figuren kannte und
-- inzwischen aus dem Projekt entfernt ist.

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local IncubatorRules = require(ReplicatedStorage.Modules.IncubatorRules)   -- Paket 8
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local IslandStage      = require(ReplicatedStorage.Modules.IslandStage)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)
local WorldService  = require(ServerScriptService.Services.WorldService)   -- 20.10. Final-Epilog P6: Welt-2-Abzeichen

local PlotDisplayService = {}

type Signatures = {
	incubator : string,   -- Sammel-Update Paket 8
	structure : string,
	labels    : string,   -- 14.10. Level im Namensschild, live waehrend der Bewegung
	state     : string,
	buildings : string,
	eggs      : string,
	recycler  : string,
	looks     : string,
	tower     : string,
	stage     : string,
	terminal  : string,   -- 08.10. Tower-Terminal
}

local _signatures: { [Player]: Signatures } = {}

--------------------------------------------------------------------------------
-- Signaturen
--------------------------------------------------------------------------------

-- Was sich aendern muss, damit die Figur neu gebaut wird: welche Baerchis es
-- gibt, auf welchem Level sie stehen (das Level aendert die Groesse der
-- Beschriftung und kann spaeter das Modell aendern) — UND wer gerade
-- ausgeruestet ist, seit nur noch dieser eine sichtbar gebaut wird. Ohne
-- equippedUid hier wuerde ein Equip-Wechsel auf einen gleich hochstufigen
-- Baerchi denselben String ergeben und die Signatur haelt die Aenderung
-- faelschlich fuer bereits dargestellt.
--
-- Die MUTATION gehoert aus demselben Grund dazu: sie bestimmt Fellfarbe, Aura
-- und das Kuerzel auf dem Namensschild (siehe MapService.buildBaerchiFigure).
-- Normalerweise aendert sie sich nie nach dem Schluepfen — der Mutations-Sturm
-- (EventParticipationService) kann sie aber mitten im Spiel anheben, und ohne
-- diesen Eintrag liefe die Figur bis zum naechsten Insel-Neuaufbau in der
-- alten Farbe weiter.
--
-- 14.10. Nur noch die Identitaet des AUSGERUESTETEN Baerchis: nur er hat eine
-- Figur. Fuettern/Befoerdern darf die laufende Figur nicht neu bauen (das
-- Level steht im Schild, siehe labelSignature).
local function structureSignature(data: Types.PlayerData): string
	local equipped = data.island.equippedUid and data.island.baerchis[data.island.equippedUid]
	if not equipped then
		return "equipped:"
	end
	-- R3: die Baerchi-ID gehoert dazu — sie bestimmt Look und Zubehoer der Figur.
	return string.format("equipped:%s|%s|%s|%s", data.island.equippedUid, equipped.rarity, equipped.mutation or "-", equipped.configId)
end

-- Level des ausgeruesteten Baerchis: nur die Beschriftung aendert sich.
local function labelSignature(data: Types.PlayerData): string
	local equipped = data.island.equippedUid and data.island.baerchis[data.island.equippedUid]
	if not equipped then
		return ""
	end
	return string.format("%s:%d", data.island.equippedUid, equipped.level)
end

-- Was sich aendern muss, damit die Beschriftung neu geschrieben wird.
local function stateSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, uid .. ":" .. baerchi.currentHp)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Gebaeude-Schilder neu geschrieben werden.
local function buildingSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d:%d", id, building.level, building.honey or 0))
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Eier neu gebaut werden: WELCHE Eier
-- herumliegen. Die Position gehoert bewusst nicht dazu — ein gelegtes Ei
-- bewegt sich nie, es kommt nur dazu oder verschwindet.
local function eggSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for _, egg in data.island.laidEggs or {} do
		table.insert(parts, egg.uid)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit Schild und Lampe des Waben-Recyclers neu
-- geschrieben werden: Level und Warteschlange.
local function recyclerSignature(data: Types.PlayerData): string
	local recycler = data.island.recycler
	return string.format("%d:%d", recycler.level, recycler.queued)
end

-- v15: Look-Stufen. Bewusst NICHT das Level: ein Gebaeude wird nur neu
-- gebaut, wenn es einen neuen Look bekommt (README 4.2).
local function lookSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d", id, BuildingBehavior.getLook(building.level)))
	end
	table.sort(parts)
	table.insert(parts, "Recycler:" .. BuildingBehavior.getLook(data.island.recycler.level))
	return table.concat(parts, "|")
end

-- v15: Tower-Turm: hoechster Tower (Look) und Rekord darin (Etagen + Schild).
local function towerSignature(player: Player, data: Types.PlayerData): string
	local towerId, record = TowerConfig.bestRecord(data.towers)
	local highest = data.towers.highestTower
	if TowerConfig.getIndex(highest) > TowerConfig.getIndex(towerId) then
		towerId, record = highest, data.towers.records[highest] or 0
	end
	-- Prompt 6: Welt 2 frei -> Plot-Abzeichen bekommt "Welt 2" (Signatur-Anhang)
	return string.format("%s:%d%s", towerId, record, if WorldService.isWorld2Unlocked(player) then ":W2" else "")
end

-- Sammel-Update Paket 8: Inkubator — belegte Plaetze (Ei + Zeitmarken),
-- Level und Platz-Zahl. Fortschritt rechnet der Client selbst.
local function incubatorSignature(data: Types.PlayerData): string
	local incubator = data.island.incubator
	if not incubator then return "" end
	-- 15.10. Solo-Inkubator: Stufe (Modell), Lager-Fuellstand, Baerchi (Figur,
	-- Takt, letzte Brut)
	local parts: { string } = { tostring(IncubatorRules.levelOf(incubator)), tostring(IncubatorRules.storedTotal(incubator)) }
	for _, entry in incubator.breeders or {} do
		local baerchi = data.island.baerchis[entry.uid]
		table.insert(parts, string.format("b%d=%s:%s:%s@%d", entry.slot, entry.uid,
			if baerchi then baerchi.rarity else "?", if baerchi then tostring(baerchi.mutation) else "",
			entry.lastEggAt))
	end
	return table.concat(parts, "|")
end

-- Paket D: Stufe der Insel-Deko
local function stageSignature(data: Types.PlayerData): string
	return tostring(IslandStage.compute(data.towers and data.towers.records, data.rebirthCount or 0))
end

-- 08.10.: Tower-Terminal — Zustand, gewaehlter Tower, Rekord, Fortschritt.
local function terminalView(data: Types.PlayerData): { state: string, tower: string, record: number, nextTower: string, newTower: string, progress: number, needed: number }
	local towers = data.towers
	-- 12.10.: Freischaltung pro Leben (TOWER_UNLOCK_PER_LIFE) — nach einem
	-- Rebirth zeigt das Terminal wieder "Schaffe Tower I x/30".
	local progressRecords = TowerConfig.unlockRecords(towers, data.island)
	local nextTower, newTower = "", ""
	for _, def in TowerConfig.TOWERS do
		if newTower == "" and TowerConfig.isNew(def.id, towers) then
			newTower = def.id
		end
		if nextTower == "" and not TowerConfig.isUnlockedByClear(def.id, progressRecords, towers.unlocked) then
			nextTower = def.id
		end
	end
	local _, progress, needed = TowerConfig.getUnlockProgress(nextTower, progressRecords)
	return {
		state     = TowerConfig.terminalState(towers, progressRecords),
		tower     = towers.selected,
		record    = towers.records[towers.selected] or 0,
		nextTower = nextTower,
		newTower  = newTower,
		progress  = progress,
		needed    = needed,
	}
end

local function terminalSignature(data: Types.PlayerData): string
	local v = terminalView(data)
	return string.format("%s|%s|%d|%s|%s|%d|%d", v.state, v.tower, v.record, v.nextTower, v.newTower, v.progress, v.needed)
end

local function allSignatures(player: Player, data: Types.PlayerData): Signatures
	return {
		terminal  = terminalSignature(data),
		incubator = incubatorSignature(data),
		structure = structureSignature(data),
		labels    = labelSignature(data),
		state     = stateSignature(data),
		buildings = buildingSignature(data),
		eggs      = eggSignature(data),
		recycler  = recyclerSignature(data),
		looks     = lookSignature(data),
		tower     = towerSignature(player, data),
		stage     = stageSignature(data),
	}
end

-- Turm und Plot-Symbol aus dem Tower-Stand (Signatur "Tower:Rekord").
local function applyTower(player: Player, signature: string, show: boolean)
	local towerId, recordText = string.match(signature, "^([^:]+):(%d+)")
	local world2 = string.sub(signature, -3) == ":W2"
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	local record = tonumber(recordText) or 0

	MapService.updateTowerShowcase(player, {
		look   = def.look,
		floors = TowerConfig.getShowcaseFloors(def.id, record),
		title  = Loc.msg("ui.world.showcase_title", {
			name = player.DisplayName, tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record,
		}),
		color  = def.color,
	}, show)
	local badge = if world2 then Loc.msg("ui.world.owner_badge_w2", {
		tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record, world = Loc.msg("epilog.world2.badge"),
	}) else Loc.msg("ui.world.owner_badge", {
		tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record,
	})
	MapService.setOwnerBadge(player, badge, def.color)
end

--------------------------------------------------------------------------------
-- Abgleich
--------------------------------------------------------------------------------

local function refresh(player: Player, data: Types.PlayerData)
	local current  = allSignatures(player, data)
	local previous = _signatures[player]

	if not previous then
		-- Noch keine Signatur (sollte nach onDataLoaded nicht vorkommen):
		-- einmal komplett nachziehen und merken.
		_signatures[player] = current
		MapService.updateBaerchis(player, data.island)
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		return
	end

	if previous.structure ~= current.structure then
		-- Neuaufbau schreibt die Zustaende gleich mit — ein zusaetzliches
		-- updateBaerchiStates waere doppelte Arbeit.
		MapService.updateBaerchis(player, data.island)

	elseif previous.state ~= current.state then
		MapService.updateBaerchiStates(player, data.island)
	end

	if previous.labels ~= current.labels then
		MapService.updateBaerchiLabels(player, data.island)
	end

	if previous.buildings ~= current.buildings then
		MapService.updateBuildingSigns(player, data.island)
	end

	-- Bewusst UNABHAENGIG vom Struktur-Zweig oben: updateBaerchis baut die Eier
	-- zwar mit, kann aber wegen einer laufenden Bewegung verschoben worden sein
	-- (ActivityLock). Genau dann legt der Baerchi aber weiter — und ein frisch
	-- gelegtes Ei soll nicht darauf warten, dass er ankommt.
	if previous.eggs ~= current.eggs then
		MapService.updateLaidEggs(player, data.island)
	end

	if previous.recycler ~= current.recycler then
		MapService.updateRecycler(player, data.island)
	end

	if previous.incubator ~= current.incubator then
		MapService.updateIncubator(player, data.island, IncubatorRules.slotCountFor(data))
	end

	-- v15: neuer Look -> genau dieses Gebaeude neu bauen (mit Show). Nach einem
	-- Rebirth faellt der Look zurueck; rebuildIsland hat die Insel dann schon
	-- komplett neu gebaut, updateBuildingLooks findet nichts mehr zu tun.
	if previous.looks ~= current.looks then
		MapService.updateBuildingLooks(player, data.island, true)
	end

	if previous.stage ~= current.stage then
		player:SetAttribute("IslandStage", tonumber(current.stage))
	end

	if previous.terminal ~= current.terminal then
		MapService.updateTerminal(player, terminalView(data))
	end

	if previous.tower ~= current.tower then
		local oldTower = string.match(previous.tower, "^([^:]+):")
		local newTower = string.match(current.tower, "^([^:]+):")
		applyTower(player, current.tower, oldTower ~= newTower)
	end

	_signatures[player] = current
end

function PlotDisplayService.init()
	-- MapService darf PlayerService nicht requiren (PlayerService requiret
	-- bereits MapService — das waere ein Ringschluss). Deshalb bekommt es die
	-- Lesefunktion von hier: dieser Service kennt beide ohnehin schon.
	MapService.setIslandDataProvider(function(player: Player): Types.IslandData?
		local data = PlayerService.getData(player)
		return if data then data.island else nil
	end)
	-- Sammel-Update Paket 8: Platz-Zahl des Inkubators (Level, Rebirths, Index).
	MapService.setIncubatorSlotProvider(function(player: Player): number
		local data = PlayerService.getData(player)
		return if data then IncubatorRules.slotCountFor(data) else 1
	end)

	PlayerService.onPlayerReady(function(player, data)
		-- Die Figuren und Schilder stehen zu diesem Zeitpunkt schon
		-- (MapService.spawnIsland laeuft beim Join davor), aber die Daten
		-- haben sich seitdem noch geaendert: die onDataLoaded-Callbacks haben
		-- Offline-Honig gutgeschrieben und offline gelegte Eier eingetragen.
		-- Die Schilder zeigten sonst bis zum naechsten Honig-Tick den Stand von
		-- vor der Gutschrift, und die Eier laegen nur in den Daten.
		--
		-- Deshalb einmal aktiv nachziehen — und ERST DANN die Signatur
		-- merken, sonst haelt der Vergleich unten den Unterschied faelschlich
		-- fuer bereits dargestellt.
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateBaerchiStates(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		MapService.updateIncubator(player, data.island, IncubatorRules.slotCountFor(data))

		local signatures = allSignatures(player, data)
		applyTower(player, signatures.tower, false)
		player:SetAttribute("IslandStage", tonumber(signatures.stage))
		MapService.updateTerminal(player, terminalView(data))

		_signatures[player] = signatures
	end)

	PlayerService.onDataChanged(refresh)

	Players.PlayerRemoving:Connect(function(player)
		_signatures[player] = nil
	end)

	print("[PlotDisplayService] Initialisiert")
end

return PlotDisplayService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">ProfileService</string><ProtectedString name="Source"><![CDATA[--!strict
-- ProfileService.luau
-- ServerScriptService/Services/ProfileService.luau
--
-- Einzige Zustaendigkeit:
--   - Die Profilkarte eines Spielers fuer den Inspektor bauen (v15): Klick auf
--     einen anderen Spieler (Charakter oder Plot-Schild) -> GetPlayerProfile.
--
-- Nur Spieler auf DIESEM Server, nur aus den Daten im Speicher, rate-limited.
-- Es gehen nie rohe PlayerData an einen fremden Client — die Karte enthaelt
-- genau die Felder aus Types.PlayerProfileCard (kein Gummy-Stand, keine uids,
-- keine Statistiken).

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local RateLimiter   = require(ServerScriptService.Util.RateLimiter)
local WorldService = require(ServerScriptService.Services.WorldService)   -- 20.10. Final-Epilog P6

local ProfileService = {}

-- Wie viele Baerchis die Karte als "Top" zeigt.
local TOP_COUNT = 3

local _indexTotal: number? = nil
local function indexTotal(): number
	if _indexTotal then return _indexTotal end
	local n = 0
	for _ in BaerchiConfig.data do n += 1 end
	_indexTotal = n
	return n
end

-- Grobe Staerke fuer die Sortierung: geometrisches Mittel aus HP, ATK und SPD
-- (dieselben Kampfwerte, die der Kampf sieht).
local function describe(baerchi: Types.Baerchi): Types.ProfileBaerchi?
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then return nil end
	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)
	return {
		configId  = baerchi.configId,
		rarity    = baerchi.rarity,
		mutation  = baerchi.mutation,
		level     = baerchi.level,
		promotion = baerchi.promotionLevel or 0,
		power     = math.floor((math.max(1, stats.maxHp) * math.max(1, stats.atk) * math.max(0.1, stats.spd)) ^ (1 / 3)),
	}
end

function ProfileService.buildCard(target: Player): Types.PlayerProfileCard?
	local data = PlayerService.getData(target)
	if not data then return nil end

	local all: { Types.ProfileBaerchi } = {}
	local equipped: Types.ProfileBaerchi? = nil
	for uid, baerchi in data.island.baerchis do
		local entry = describe(baerchi)
		if entry then
			table.insert(all, entry)
			if uid == data.island.equippedUid then
				equipped = entry
			end
		end
	end
	table.sort(all, function(a, b) return a.power > b.power end)
	local top: { Types.ProfileBaerchi } = {}
	for i = 1, math.min(TOP_COUNT, #all) do
		table.insert(top, all[i])
	end

	local towerId, record = TowerConfig.bestRecord(data.towers)
	local indexCount = 0
	for _ in data.discovered do indexCount += 1 end

	return {
		userId       = target.UserId,
		name         = target.DisplayName,
		equipped     = equipped,
		highestTower = towerId,
		towerRecord  = record,
		rebirths     = data.rebirthCount,
		indexCount   = indexCount,
		indexTotal   = indexTotal(),
		world2       = WorldService.isWorld2Unlocked(target),   -- Prompt 6 (nur lesen)
		top          = top,
	}
end

function ProfileService.init()
	RateLimiter.connectFunction(Remotes.GetPlayerProfile, "GetPlayerProfile", function(_player, userId: any)
		if typeof(userId) ~= "number" then return nil end
		local target = Players:GetPlayerByUserId(userId)
		if not target then return nil end   -- nur Spieler auf diesem Server
		return ProfileService.buildCard(target)
	end)

	print("[ProfileService] Initialisiert")
end

return ProfileService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">TowerService</string><ProtectedString name="Source"><![CDATA[--!strict
-- TowerService.luau
-- ServerScriptService/Services/TowerService.luau
--
-- Einzige Zustaendigkeit:
--   - Den permanenten Tower-Fortschritt fuehren (v15, ersetzt das PIT-Level):
--     Tower-Wahl, Freischaltung (08.10.: durch Schaffen des vorherigen
--     Towers, towers.unlocked, Meldung TowerUnlocked; ohne
--     FeatureFlags.TOWER_UNLOCK_BY_CLEAR der alte Deckel pro Rebirth),
--     Rekorde, Meilensteine (auch rueckwirkend) und die PIT-Erstattung aus
--     der Migration.
--
-- Was ein Lauf ist und wie er simuliert wird, weiss CombatService; dieser
-- Service sagt ihm nur, in welchem Tower gekaempft wird, bis wohin es Belohnung
-- gibt, und nimmt am Ende das Ergebnis entgegen (recordRun). Die Zahlen stehen
-- in Config/TowerConfig.
--
-- Die Daten (data.towers) liegen ausserhalb der Insel wie der Ei-Baum: ein
-- Rebirth setzt die Insel zurueck, Rekorde und abgeholte Meilensteine bleiben.
--
-- Auszahlungen laufen ausschliesslich ueber die zustaendigen Services:
-- Gummies/GoldGummies ueber EconomyService (Meilensteine OHNE Multiplikator,
-- awardGummiesFlat), Eier ueber EggService.grantEggs, Blaupausen ueber
-- EggTreeService.grantBlueprint.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local LeaderboardConfig = require(ReplicatedStorage.Config.LeaderboardConfig)  -- Paket 9: Woche
local EggTree     = require(ReplicatedStorage.Modules.EggTree)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local EggService     = require(ServerScriptService.Services.EggService)
local EggTreeService = require(ServerScriptService.Services.EggTreeService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)
local EpilogService  = require(ServerScriptService.Services.EpilogService)   -- 20.10. Final-Epilog

local TowerService = {}

-- Nur Studio/Debug: Spielstaende, fuer die jeder Tower offen ist (Kampf in allen
-- vier Towern ohne Rebirths testen). Schluessel = die Daten-Tabelle, schwach.
local _debugOpen: { [any]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function fail(player: Player, reason: Types.LocMsg)
	Remotes.ActionFailed:FireClient(player, "RequestSelectTower", reason)
end

--------------------------------------------------------------------------------
-- Lesen
--------------------------------------------------------------------------------

-- Deckel in diesem Tower (0 = Tower noch zu). 08.10.: mit
-- TOWER_UNLOCK_BY_CLEAR die volle Stage-Zahl jedes freigeschalteten Towers.
function TowerService.getStageCap(data: Types.PlayerData, towerId: string): number
	local cap = TowerConfig.getStageCap(data.rebirthCount, towerId, TowerConfig.unlockRecords(data.towers, data.island), data.towers.unlocked)
	if cap <= 0 and _debugOpen[data] then
		local def = TowerConfig.get(towerId)
		return if def then def.stages else 0
	end
	return cap
end

-- Der gewaehlte Tower; ist er (z. B. nach einer Datenreparatur) nicht offen,
-- der hoechste offene.
function TowerService.getSelected(data: Types.PlayerData): string
	local selected = data.towers.selected
	if TowerConfig.isOpen(data.rebirthCount, selected, TowerConfig.unlockRecords(data.towers, data.island), data.towers.unlocked) or (_debugOpen[data] and TowerConfig.isValidId(selected)) then
		return selected
	end
	-- Sonst der hoechste offene Tower (Tower I ist immer offen)
	local best = TowerConfig.FIRST_TOWER :: string
	for _, def in TowerConfig.TOWERS do
		if TowerConfig.isOpen(data.rebirthCount, def.id, TowerConfig.unlockRecords(data.towers, data.island), data.towers.unlocked) then
			best = def.id
		end
	end
	return best
end

--------------------------------------------------------------------------------
-- Freischaltung (08.10.)
--------------------------------------------------------------------------------

-- Traegt die Tower ein, die `towerId` mit seinem Rekord oeffnet. `announce`:
-- dem Spieler melden (TowerUnlocked → Feier-Moment, "NEU"-Abzeichen). Beim
-- Join nur still nachtragen, sonst kaeme die Meldung bei jedem Betreten.
local function applyUnlocks(player: Player, data: Types.PlayerData, towerId: string, announce: boolean)
	if not FeatureFlags.isOn("TOWER_UNLOCK_BY_CLEAR") then return end
	local towers = data.towers
	if typeof(towers.unlocked) ~= "table" then towers.unlocked = {} end
	-- 12.10.: mit TOWER_UNLOCK_PER_LIFE zaehlt die beste Stage dieses Lebens
	local progress = TowerConfig.unlockRecords(towers, data.island)
	for _, nextId in TowerConfig.unlocksAfterClear(towerId, progress[towerId] or 0) do
		if towers.unlocked[nextId] ~= true then
			towers.unlocked[nextId] = true
			if announce then
				-- Nach dem Lauf-Ergebnis zeigen (Ergebnis-Toast zuerst)
				task.delay(1.5, function()
					if player.Parent then
						-- 20.10. Final-Epilog: die Endless-Meldung wartet, bis die
						-- Sequenz vorbei ist (EpilogService.releaseDeferred).
						if EpilogService.deferUnlockNotice(player, nextId) then return end
						Remotes.TowerUnlocked:FireClient(player, nextId)
					end
				end)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Meilensteine
--------------------------------------------------------------------------------

-- Zahlt einen einzelnen Meilenstein aus (einmalig) und meldet ihn dem Client.
-- Gibt true zurueck, wenn er neu abgeholt wurde.
local function grantMilestone(player: Player, data: Types.PlayerData, towerId: string, stage: number): boolean
	local milestone = TowerConfig.getMilestone(towerId, stage)
	if not milestone then return false end

	local claimed = data.towers.claimed[towerId]
	if not claimed then
		claimed = {}
		data.towers.claimed[towerId] = claimed
	end
	local key = tostring(stage)
	if claimed[key] then return false end
	claimed[key] = true

	local reward: Types.TowerMilestoneReward = {
		towerId     = towerId,
		stage       = stage,
		gummies     = 0,
		goldGummies = 0,
		eggType     = nil,
		eggs        = 0,
		blueprints  = 0,
	}

	if milestone.gummies > 0 then
		reward.gummies = EconomyService.awardGummiesFlat(player, milestone.gummies)
	end
	if milestone.goldGummies > 0 then
		reward.goldGummies = EconomyService.awardGoldGummies(player, milestone.goldGummies)
	end
	if milestone.eggs > 0 then
		local eggType = EggTree.highestUnlocked(data.eggTree)
		if EggService.grantEggs(player, eggType, milestone.eggs) then
			reward.eggType = eggType
			reward.eggs = milestone.eggs
		end
	end
	if milestone.blueprints > 0 then
		EggTreeService.grantBlueprint(player, data, milestone.blueprints)
		reward.blueprints = milestone.blueprints
	end
	if milestone.endlessLevels > 0 then
		local baerchi = data.island.equippedUid and data.island.baerchis[data.island.equippedUid]
		if baerchi then
			baerchi.endlessLevel = (baerchi.endlessLevel or 0) + milestone.endlessLevels
			reward.endlessLevels = milestone.endlessLevels
		end
	end

	-- Kurz verzoegert: beim Join haengt der Client sein UI erst noch an.
	task.delay(1, function()
		if player.Parent then
			Remotes.TowerMilestoneReceived:FireClient(player, reward)
		end
	end)
	return true
end

-- Alle noch offenen Meilensteine bis einschliesslich `upTo` (rueckwirkend).
local function grantMilestonesUpTo(player: Player, data: Types.PlayerData, towerId: string, upTo: number): number
	local granted = 0
	local stage = TowerConfig.MILESTONE_EVERY
	while stage <= upTo do
		if grantMilestone(player, data, towerId, stage) then
			granted += 1
		end
		stage += TowerConfig.MILESTONE_EVERY
	end
	return granted
end

--------------------------------------------------------------------------------
-- Ergebnis eines Laufs
--------------------------------------------------------------------------------

-- Vom CombatService am Ende eines Laufs aufgerufen. `highestWon` = hoechste
-- gewonnene Stage dieses Laufs. Rekord und Meilensteine zaehlen nur bis zum
-- Deckel (weich). Gibt den neuen Rekord (nil = keiner) und zurueck, ob der Lauf
-- den Deckel erreicht hat (Rebirth-Hinweis, nur wenn der Deckel ein echtes
-- Limit ist).
function TowerService.recordRun(player: Player, data: Types.PlayerData, towerId: string, highestWon: number): (number?, boolean)
	local def = TowerConfig.get(towerId)
	if not def or highestWon <= 0 then return nil, false end

	local cap = TowerService.getStageCap(data, towerId)
	local counted = math.min(highestWon, cap)

	-- Sammel-Update 05.10. (Paket 4.1): beste Stage dieses Lebens fuer die
	-- Rebirth-Bedingung. Ungedeckelt: die Bedingung liegt ohnehin unter dem
	-- Deckel, und ein Spieler, der darueber kaempft, hat sie erst recht erfuellt.
	local island = data.island
	if typeof(island.stageBest) ~= "table" then island.stageBest = {} end
	island.stageBest[towerId] = math.max(island.stageBest[towerId] or 0, highestWon)

	local newRecord: number? = nil
	local previous = data.towers.records[towerId] or 0
	if counted > previous then
		data.towers.records[towerId] = counted
		newRecord = counted
		if def.index > TowerConfig.getIndex(data.towers.highestTower) then
			data.towers.highestTower = towerId
		end
		grantMilestonesUpTo(player, data, towerId, counted)
	end
	-- 12.10.: nach einem Rebirth oeffnet das erneute Schaffen den naechsten
	-- Tower wieder, auch ohne neuen Rekord (bereits offene meldet es nicht).
	applyUnlocks(player, data, towerId, true)

	-- 20.10. Final-Epilog (Prompt 1): Final 100 in einem serverseitig gueltigen
	-- Lauf. AUSSERHALB von "counted > previous", damit auch ein Sieg nach
	-- `epilog reset` (Rekord steht schon auf 100) die Sequenz wiederholen kann;
	-- ein zweiter Sieg ohne Reset loest nichts aus (Zustand != "none").
	-- Synchron, im selben Schreibvorgang wie der Rekord: Endless offen +
	-- state = pending. Der Rest (Speichern, EpilogStart) folgt in EpilogService.
	EpilogService.onFinalClear(player, data, towerId, counted)

	-- Paket 9: beste Endless-Stage dieser Woche (Wochen-Bestenliste).
	if towerId == "Endless" then
		local week = LeaderboardConfig.weekOf(os.time())
		local entry = data.towers.endlessWeek
		if not entry or entry.week ~= week then
			entry = { week = week, best = 0 }
			data.towers.endlessWeek = entry
		end
		entry.best = math.max(entry.best, counted)
	end

	local capReached = highestWon >= cap and TowerConfig.isCapLimiting(data.rebirthCount, towerId)
	return newRecord, capReached
end

--------------------------------------------------------------------------------
-- Tower waehlen
--------------------------------------------------------------------------------

function TowerService.select(player: Player, towerId: string)
	local data = PlayerService.getData(player)
	if not data then return end

	if not TowerConfig.isValidId(towerId) then
		fail(player, Loc.msg("err.tower_unknown"))
		return
	end
	if not TowerConfig.isOpen(data.rebirthCount, towerId, TowerConfig.unlockRecords(data.towers, data.island), data.towers.unlocked)
		and not _debugOpen[data] then
		if towerId == "Endless" then
			fail(player, Loc.msg("err.tower_locked_endless"))
		elseif FeatureFlags.isOn("TOWER_UNLOCK_BY_CLEAR") then
			local prev, _, needed = TowerConfig.getUnlockProgress(towerId, TowerConfig.unlockRecords(data.towers, data.island))
			fail(player, Loc.msg("err.tower_locked_clear", {
				tower = Loc.msg("tower." .. (prev or TowerConfig.FIRST_TOWER) .. ".name"),
				stages = needed,
			}))
		else
			fail(player, Loc.msg("err.tower_locked", { rebirths = TowerConfig.getOpeningRebirth(towerId) }))
		end
		return
	end
	if data.towers.selected == towerId then return end

	data.towers.selected = towerId
	PlayerService.markDirty(player)
end

-- Debug: alle Tower fuer diesen Spielstand oeffnen (bis zum Verlassen).
function TowerService.debugOpenAll(data: Types.PlayerData)
	_debugOpen[data] = true
end

-- Debug (12.10.): nach "stagebest" die Freischaltung nachziehen (mit Meldung)
function TowerService.debugApplyUnlocks(player: Player, towerId: string)
	local data = PlayerService.getData(player)
	if not data then return end
	applyUnlocks(player, data, towerId, true)
	PlayerService.markDirty(player)
end

-- Debug: Rekord direkt setzen (mit Meilensteinen bis dorthin).
function TowerService.debugSetRecord(player: Player, towerId: string, stage: number)
	local data = PlayerService.getData(player)
	local def = TowerConfig.get(towerId)
	if not data or not def then return end
	local value = math.clamp(math.floor(stage), 0, def.stages)
	data.towers.records[towerId] = value
	-- 12.10.: mit TOWER_UNLOCK_PER_LIFE zaehlt fuer die Freischaltung die
	-- beste Stage dieses Lebens — ein Debug-Rekord gilt als "geschafft"
	if typeof(data.island.stageBest) ~= "table" then data.island.stageBest = {} end
	data.island.stageBest[towerId] = math.max(data.island.stageBest[towerId] or 0, value)
	if value > 0 and def.index > TowerConfig.getIndex(data.towers.highestTower) then
		data.towers.highestTower = towerId
	end
	grantMilestonesUpTo(player, data, towerId, value)
	applyUnlocks(player, data, towerId, true)
	PlayerService.markDirty(player)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function TowerService.init()
	RateLimiter.connect(Remotes.RequestSelectTower, "RequestSelectTower", function(player, towerId: any)
		if typeof(towerId) ~= "string" then return end
		TowerService.select(player, towerId)
	end)

	PlayerService.onDataLoaded(function(player, data)
		-- 0. 20.10. Endless-Absicherung: Final 100 einmal geschafft heisst Endless
		--    offen (towers.unlocked), egal wie der Spielstand dorthin kam.
		if TowerConfig.isEndlessOpen(data.towers.records) then
			data.towers.unlocked.Endless = true
		end

		-- 1. PIT-Erstattung aus der Migration v14 -> v15 (einmalig).
		local refund = data.island.pitRefund or 0
		if refund > 0 then
			data.island.pitRefund = 0
			local paid = EconomyService.awardGummiesFlat(player, refund)
			task.delay(4, function()
				if player.Parent then
					Remotes.EventNotice:FireClient(player, Loc.msg("msg.pit_refund", { amount = paid }), "good")
				end
			end)
			print("[TowerService]", player.Name, "| PIT-Erstattung:", paid)
		end

		-- 2. Rueckwirkende Meilensteine (migrierter Rekord, oder ein neuer
		--    Meilenstein in der Config).
		for towerId, record in data.towers.records do
			grantMilestonesUpTo(player, data, towerId, record)
			applyUnlocks(player, data, towerId, false)
		end

		-- 3. Gewaehlter Tower muss offen sein.
		data.towers.selected = TowerService.getSelected(data)
	end)

	print("[TowerService] Initialisiert |", #TowerConfig.TOWERS, "Tower")
end

return TowerService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">WorldService</string><ProtectedString name="Source"><![CDATA[--!strict
-- WorldService.luau
-- ServerScriptService/Services/WorldService.luau
--
-- Einzige Zustaendigkeit (Prompt 6 von 7, Final-Epilog): Auskunft, welche Welten ein
-- Spieler freigeschaltet hat. NUR LESEN: geschrieben wird `worlds.unlocked.World2`
-- ausschliesslich von EpilogRules.applyLaunch (ueber EpilogService nach dem Knopfdruck).
-- Der Zugang zu Welt 2 (Betreten) haengt spaeter hier dran; es gibt noch keinen Teleport.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local EpilogConfig = require(ReplicatedStorage.Config.EpilogConfig)
local PlayerService = require(ServerScriptService.Services.PlayerService)

local WorldService = {}

-- worldId: "World2" (EpilogConfig.WORLD2_ID). Unbekannte Ids sind nie frei.
function WorldService.isUnlocked(player: Player, worldId: string): boolean
	local data = PlayerService.getData(player)
	if not data then return false end
	local worlds = (data :: any).worlds
	if typeof(worlds) ~= "table" or typeof(worlds.unlocked) ~= "table" then return false end
	return worlds.unlocked[worldId] == true
end

function WorldService.isWorld2Unlocked(player: Player): boolean
	return WorldService.isUnlocked(player, EpilogConfig.WORLD2_ID)
end

return WorldService
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX42"><Properties><string name="Name">Util</string></Properties><Item class="Folder" referent="RBX40"><Properties><string name="Name">MapBuild</string></Properties><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">EpilogFinaleBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- EpilogFinaleBuilder.luau
-- ServerScriptService/Util/MapBuild/EpilogFinaleBuilder.luau
--
-- Einzige Zustaendigkeit (Prompt 6 von 7, Final-Epilog):
--   - Die kleine Cartoon-Rakete samt Schacht neben dem Terminal bauen (Server-Teile,
--     ohne Kollision, 2 Emitter) und wieder zerstoeren. Die Bewegung (Aufstieg in die
--     Wolken) macht der Client per Tween auf seiner Kopie; der Server steuert nur
--     Sichtbarkeit und Emitter (`launch`).
--   - Alles haengt am Epilog-Ordner des Plots und geht mit der Insel (onTeardown) weg.
--
-- Mit Mesh-Vorlage (ReplicatedStorage.Assets.EpilogRakete, MeshPart Epilog_Rakete, Pivot
-- Unterseite) ein Teil + Schacht; ohne Vorlage Primitive (hoechstens FINALE.rocket.parts).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EpilogConfig = require(ReplicatedStorage.Config.EpilogConfig)

local EpilogMeshes        = require(script.Parent.EpilogMeshes)
local EpilogIslandBuilder = require(script.Parent.EpilogIslandBuilder)

local EpilogFinaleBuilder = {}

local R = EpilogConfig.FINALE.rocket

type State = {
	model    : Model,
	rocket   : Model,
	base     : CFrame,      -- Fuss der Rakete (Mitte Schacht)
	emitters : { ParticleEmitter },
	lamp     : PointLight,
}

local _state: { [Player]: State } = {}

local function particleTexture(): string
	local A = EpilogConfig.ASSETS
	return if A.cloudTex ~= "" then A.cloudTex else A.particleFallback
end

local function part(name: string, size: Vector3, cf: CFrame, color: Color3, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

function EpilogFinaleBuilder.exists(player: Player): boolean
	local s = _state[player]
	return s ~= nil and s.model.Parent ~= nil
end

function EpilogFinaleBuilder.countParts(player: Player): number
	local s = _state[player]
	if not s then return 0 end
	local n = 0
	for _, d in s.model:GetDescendants() do
		if d:IsA("BasePart") then n += 1 end
	end
	return n
end

function EpilogFinaleBuilder.destroy(player: Player)
	local s = _state[player]
	if not s then return end
	_state[player] = nil
	if s.model.Parent ~= nil then s.model:Destroy() end
end

-- Baut Schacht und Rakete (Rakete steht im Schacht, Emitter aus). nil ohne Insel.
function EpilogFinaleBuilder.build(plot: Model, owner: Player): Model?
	if not EpilogIslandBuilder.exists(owner) then return nil end
	local info = EpilogIslandBuilder.getRouteInfo(plot)
	local folder = plot:FindFirstChild("Epilog")
	if not info or not (folder and folder:IsA("Folder")) then return nil end
	EpilogFinaleBuilder.destroy(owner)

	local dir = Vector3.new(info.dir[1], 0, info.dir[3])
	local side = Vector3.new(-dir.Z, 0, dir.X)
	local island = Vector3.new(info.island[1], info.island[2], info.island[3])
	-- Schacht neben der Insel-Mitte (Terminal steht hinter der Mitte, Rakete seitlich davon)
	local foot = island + side * R.sideOffset + dir * R.alongOffset
	local base = CFrame.lookAt(foot, foot + dir)

	local model = Instance.new("Model")
	model.Name = "Rakete"
	local rocket = Instance.new("Model")
	rocket.Name = "Epilog_Rakete"
	rocket.Parent = model

	-- Schacht: dunkle Scheibe in der Wiese mit goldenem Rand (liegend, Zylinderachse = Y)
	local lay = CFrame.Angles(0, 0, math.rad(90))
	local c = EpilogConfig.TERMINAL.colors
	local shaft = part("Epilog_Rakete_Schacht", Vector3.new(0.3, 4.2, 4.2), base * CFrame.new(0, 0.05, 0) * lay, R.shaftColor, model)
	shaft.Shape = Enum.PartType.Cylinder
	local rim = part("Epilog_Rakete_Rand", Vector3.new(0.2, 4.9, 4.9), base * CFrame.new(0, 0.02, 0) * lay, c.gold, model)
	rim.Shape = Enum.PartType.Cylinder

	local tex = EpilogMeshes.meshPart(EpilogConfig.ASSETS.rocketTemplate, "Epilog_Rakete")
	local anchor: BasePart
	if tex then
		-- Vorlage: Groesse auf R.height skalieren (Pivot der Vorlage = Unterseite, das
		-- MeshPart selbst steht mit der Mitte auf halber Hoehe)
		local k = R.height / math.max(0.01, tex.Size.Y)
		EpilogMeshes.setup(tex, "Epilog_Rakete_Huelle", tex.Size * k, base * CFrame.new(0, R.height / 2 + 0.1, 0))
		tex.CanQuery = false
		tex.Parent = rocket
		anchor = tex
	else
		local h, r = R.height, R.radius
		-- Rumpf (Zylinder, Achse nach oben), Nase (Kugel), Bullauge, drei Flossen
		local body = part("Epilog_Rakete_Rumpf", Vector3.new(h * 0.62, r * 2, r * 2),
			base * CFrame.new(0, h * 0.31 + 0.1, 0) * lay, R.bodyColor, rocket)
		body.Shape = Enum.PartType.Cylinder
		local nose = part("Epilog_Rakete_Nase", Vector3.new(r * 2, r * 2, r * 2),
			base * CFrame.new(0, h * 0.62 + r * 0.6 + 0.1, 0), R.noseColor, rocket)
		nose.Shape = Enum.PartType.Ball
		local win = part("Epilog_Rakete_Bullauge", Vector3.new(r * 0.9, r * 0.9, r * 0.5),
			base * CFrame.new(0, h * 0.45 + 0.1, -r * 0.85), R.windowColor, rocket)
		win.Shape = Enum.PartType.Ball
		win.Material = Enum.Material.Neon
		for i = 0, 2 do
			local fin = Instance.new("WedgePart")
			fin.Name = "Epilog_Rakete_Flosse" .. (i + 1)
			fin.Size = Vector3.new(0.3, r * 1.6, r * 1.6)
			fin.CFrame = base * CFrame.Angles(0, math.rad(120 * i), 0)
				* CFrame.new(0, r * 0.8 + 0.1, -r - 0.5)
			fin.Color = R.finColor
			fin.Material = Enum.Material.SmoothPlastic
			fin.Anchored, fin.CanCollide, fin.CanTouch, fin.CanQuery, fin.CastShadow = true, false, false, false, false
			fin.Parent = rocket
		end
		anchor = body
	end
	rocket.PrimaryPart = anchor

	-- Zwei Emitter am Fuss: Feuer und Rauch (aus, bis `launch`)
	local attach = Instance.new("Attachment")
	attach.Name = "Duese"
	attach.CFrame = anchor.CFrame:ToObjectSpace(base * CFrame.new(0, 0.1, 0) * CFrame.Angles(math.pi, 0, 0))   -- Y zeigt nach unten
	attach.Parent = anchor
	local fire = Instance.new("ParticleEmitter")
	fire.Name = "Feuer"
	fire.Texture = particleTexture()
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 196, 60), Color3.fromRGB(226, 44, 44))
	fire.LightEmission = 1
	fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3.2), NumberSequenceKeypoint.new(1, 0.4) })
	fire.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	fire.Lifetime = NumberRange.new(0.3, 0.55)
	fire.Speed = NumberRange.new(18, 26)
	fire.SpreadAngle = Vector2.new(8, 8)
	fire.Rate = 70
	fire.Enabled = false
	fire.Parent = attach
	local smoke = Instance.new("ParticleEmitter")
	smoke.Name = "Rauch"
	smoke.Texture = particleTexture()
	smoke.Color = ColorSequence.new(Color3.fromRGB(246, 240, 232))
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 9) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	smoke.Lifetime = NumberRange.new(1.0, 1.8)
	smoke.Speed = NumberRange.new(6, 12)
	smoke.SpreadAngle = Vector2.new(20, 20)
	smoke.Rate = 30
	smoke.Enabled = false
	smoke.Parent = attach
	local lamp = Instance.new("PointLight")
	lamp.Color = Color3.fromRGB(255, 160, 60)
	lamp.Range = 24
	lamp.Brightness = 0
	lamp.Parent = anchor

	model:SetAttribute("EpilogRocketBase", base.Position)
	model.Parent = folder

	_state[owner] = { model = model, rocket = rocket, base = base, emitters = { fire, smoke }, lamp = lamp }
	EpilogIslandBuilder.onTeardown(owner, function()
		EpilogFinaleBuilder.destroy(owner)
	end)
	return model
end

-- Fuss der Rakete als Zahlen-Tabelle {x, y, z} (fuer den Client), nil ohne Rakete.
function EpilogFinaleBuilder.getBase(player: Player): { number }?
	local s = _state[player]
	if not s then return nil end
	local p = s.base.Position
	return { p.X, p.Y, p.Z }
end

-- Feuer an/aus (der Client steuert die Bewegung selbst).
function EpilogFinaleBuilder.launch(player: Player, on: boolean)
	local s = _state[player]
	if not s then return end
	for _, e in s.emitters do e.Enabled = on end
	s.lamp.Brightness = if on then 3 else 0
	s.model:SetAttribute("EpilogRocketLaunched", on)
end

return EpilogFinaleBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">EpilogIslandBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- EpilogIslandBuilder.luau
-- ServerScriptService/Util/MapBuild/EpilogIslandBuilder.luau
--
-- Einzige Zustaendigkeit (Prompt 3 von 7, Final-Epilog):
--   - Die kleine schwebende Insel ueber dem Gipfel bauen (Enthuellung aus Nebel),
--     die Bruecke dorthin Planke fuer Planke wachsen lassen — ERST NACH dem
--     gespeicherten Sieg —, beides wieder restlos abbauen, dem Avatar den Weg
--     (Wegpunkte) und dem Terminal (Prompt 4) seinen Platz (Mount) nennen.
--
-- Die Geometrie steht in Modules/EpilogIslandLayout (reine Rechnung, getestet),
-- die Masse in Config/EpilogConfig.ISLAND / .BRIDGE. Hier wird nur gebaut. Alle
-- Teile liegen im Ordner `Epilog` des Plots: Modell `Insel` (Koerper + Fangboden)
-- und Modell `Bruecke` (Planken, Gelaender). Das Modell `Bruecke` existiert erst,
-- wenn die erste Planke entsteht (Instance.new zur Wachstumszeit; vorher gibt es
-- weder Teile noch Kollision).
--
-- ANTI-EXPLOIT (Kern):
--   * growBridge / buildBridgeInstant bauen nur, wenn `guard(player)` (gesetzt von
--     EpilogService: epilog.state "pending"/"seen") es erlaubt. Ohne Guard: nie.
--   * growBridge verlangt zusaetzlich: Spieler lebt und steht im Radius des Gipfels.
--   * Die Insel liegt ausser jeder Sprungweite (Luft EpilogConfig.ISLAND.edgeGap).
--     Betritt jemand die Wiese vor der fertigen Bruecke, wird er zum Gipfel
--     zurueckgesetzt. Der Fangboden unter Bruecke und Insel holt Abgestuerzte
--     zurueck (zum Gipfel, bei fertiger Bruecke zum Brueckenansatz).
--   * Kein Teil der Bruecke liegt vorab versteckt im Workspace.
--
-- Dieses Modul kennt MapService NICHT (MapService benutzt es). Ein Spieler gehoert
-- zum Plot ueber das Attribut `PlotOwner` (UserId). Server baut und loescht;
-- Funken sind kurze Emit()-Stoesse (hoechstens maxEmitters gleichzeitig), das
-- Wippen der Deko macht der Client (Controllers/EpilogIslandFX, Tag `EpilogDeco`).

local Players             = game:GetService("Players")
local TweenService        = game:GetService("TweenService")
local CollectionService   = game:GetService("CollectionService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace           = game:GetService("Workspace")

local MapConfig    = require(ReplicatedStorage.Config.MapConfig)
local EpilogConfig = require(ReplicatedStorage.Config.EpilogConfig)
local Layout       = require(ReplicatedStorage.Modules.EpilogIslandLayout)

local MapParts             = require(script.Parent.MapParts)
local EpilogMeshes         = require(script.Parent.EpilogMeshes)
local EpilogSummitBuilder  = require(script.Parent.EpilogSummitBuilder)
local FigureFX             = require(ServerScriptService.Util.FigureFX)

local EpilogIslandBuilder = {}

-- Tags (fuer den Client und fuer `epilog scan`)
local TAG_ISLAND = "EpilogInsel"
local TAG_BRIDGE = "EpilogBruecke"
local TAG_DECO   = "EpilogDeco"

type State = {
	owner      : Player,
	plot       : Model,
	folder     : Folder,
	gipfel     : Model,
	layout     : Layout.Result,
	insel      : Model,
	body       : Model,
	wiese      : Part,
	rim        : Part,
	catchFloor : Part,
	bridge     : Model?,
	planks     : { BasePart },
	rails      : { Part },
	conns      : { RBXScriptConnection },
	cleanups   : { () -> () },
	thread     : thread?,
	revealed   : boolean,
	growing    : boolean,
	complete   : boolean,
	arrived    : boolean,
	removing   : boolean,
	emitters   : number,
	lastCatch  : number,
	rng        : Random,
}

local _state: { [Player]: State } = {}
-- Welche Stufe der Spieler hatte ("island" | "bridge"). Ueberlebt einen Neuaufbau
-- des Plots (Rebirth), damit die Teile danach wieder da sind. destroy() loescht ihn.
local _stage: { [Player]: string } = {}
local _guard: ((Player) -> boolean)? = nil
local _arrivalHandler: ((Player) -> ())? = nil

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function ownerOfPlot(plot: Model): Player?
	local id = plot:GetAttribute("PlotOwner")
	if typeof(id) ~= "number" then return nil end
	return Players:GetPlayerByUserId(id)
end

local function colorFor(key: string): Color3
	local I = EpilogConfig.ISLAND.colors :: { [string]: Color3 }
	local B = EpilogConfig.BRIDGE.colors :: { [string]: Color3 }
	return I[key] or B[key] or Color3.fromRGB(255, 255, 255)
end

local function particleTexture(): string
	local A = EpilogConfig.ASSETS
	return if A.cloudTex ~= "" then A.cloudTex else A.particleFallback
end

-- Ordner `Epilog` und Gipfel-Modell eines Plots (Gipfel liefert Mitte, Hoehe, Richtung).
local function gipfelOf(plot: Model): (Folder?, Model?)
	local folder = plot:FindFirstChild("Epilog")
	if not (folder and folder:IsA("Folder")) then return nil, nil end
	local gipfel = folder:FindFirstChild("Gipfel")
	if gipfel and gipfel:IsA("Model") then return folder, gipfel end
	return folder, nil
end

local function layoutOf(gipfel: Model): Layout.Result?
	local floorY = gipfel:GetAttribute("FloorY")
	local angle  = gipfel:GetAttribute("BridgeAngle")
	local rig = gipfel:FindFirstChild("Rig")
	if typeof(floorY) ~= "number" or typeof(angle) ~= "number" or not (rig and rig:IsA("BasePart")) then
		return nil
	end
	return Layout.compute(rig.Position.X, rig.Position.Z, floorY, angle, MapConfig.PIT_TOWER_RADIUS)
end

local function toVec(p: { number }): Vector3
	return Vector3.new(p[1], p[2], p[3])
end

local function cframeOf(piece: Layout.Piece): CFrame
	local cf = CFrame.new(piece.pos[1], piece.pos[2], piece.pos[3])
	if piece.kind == "Disc" then
		return cf * CFrame.Angles(0, 0, math.rad(90))
	end
	return cf * CFrame.Angles(0, piece.yaw, 0) * CFrame.Angles(0, 0, piece.pitch)
end

local function makePart(piece: Layout.Piece): Part
	local size: Vector3
	if piece.kind == "Disc" then
		size = Vector3.new(piece.size[1], piece.size[2], piece.size[2])
	elseif piece.kind == "Ball" then
		size = Vector3.new(piece.size[1], piece.size[1], piece.size[1])
	else
		size = Vector3.new(piece.size[1], piece.size[2], piece.size[3])
	end
	local part = MapParts.newPart(piece.name, size, cframeOf(piece), colorFor(piece.colorKey),
		(Enum.Material :: any)[piece.material])
	if piece.kind == "Disc" then part.Shape = Enum.PartType.Cylinder end
	if piece.kind == "Ball" then part.Shape = Enum.PartType.Ball end
	part.CanCollide = piece.collide
	part.CanTouch   = false
	part.CastShadow = false
	if piece.hidden then
		part.Transparency = 1
		part.CanQuery     = false
	elseif not piece.collide then
		part.CanQuery = false
	end
	return part
end

local function characterOf(player: Player): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	if not character then return nil, nil, nil end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") and humanoid then
		return character, root, humanoid
	end
	return nil, nil, nil
end

-- Avatar sicher auf eine Stelle setzen (Geschwindigkeit null, nicht sitzend).
local function placeAvatar(player: Player, pos: Vector3, lookAt: Vector3): boolean
	local character, root, humanoid = characterOf(player)
	if not character or not root or not humanoid then return false end
	humanoid.Sit = false
	root.AssemblyLinearVelocity  = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	character:PivotTo(CFrame.lookAt(pos, Vector3.new(lookAt.X, pos.Y, lookAt.Z)))
	root.AssemblyLinearVelocity = Vector3.zero
	humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	return true
end

-- Figur auf eine Stelle stellen, Unterkante auf `bottomY`.
local function placeFigure(model: Model, x: number, z: number, bottomY: number, lookDir: Vector3)
	FigureFX.stopIdle(model)
	model:PivotTo(CFrame.lookAt(Vector3.new(x, bottomY + 2, z), Vector3.new(x, bottomY + 2, z) + lookDir))
	local boxCf, boxSize = model:GetBoundingBox()
	local bottom = boxCf.Position.Y - boxSize.Y / 2
	model:PivotTo(model:GetPivot() + Vector3.new(0, bottomY - bottom, 0))
	FigureFX.idleBob(model, { height = MapConfig.IDLE_BOB_HEIGHT, rate = MapConfig.IDLE_BOB_RATE })
end

local function isAlive(player: Player): boolean
	local _, root, humanoid = characterOf(player)
	return root ~= nil and humanoid ~= nil and humanoid.Health > 0
end

-- Steht der Spieler im Radius des Gipfels (Etage + Gipfelring, in Hoehe +-15)?
local function nearSummit(state: State): boolean
	local _, root = characterOf(state.owner)
	if not root then return false end
	local rig = state.gipfel:FindFirstChild("Rig")
	if not (rig and rig:IsA("BasePart")) then return false end
	local dx, dz = root.Position.X - rig.Position.X, root.Position.Z - rig.Position.Z
	local reach = MapConfig.PIT_TOWER_RADIUS + EpilogConfig.SUMMIT.extraRing + 2
	return math.sqrt(dx * dx + dz * dz) <= reach and math.abs(root.Position.Y - rig.Position.Y) <= 15
end

local function allowed(player: Player): boolean
	local guard = _guard
	if not guard then return false end   -- ohne Guard (EpilogService) wird nie gebaut
	local ok, result = pcall(guard, player)
	return ok and result == true
end

--------------------------------------------------------------------------------
-- Zustand / Aufraeumen
--------------------------------------------------------------------------------

-- Erlaubnis fuer Brueckenbau (EpilogService: state "pending" oder "seen").
function EpilogIslandBuilder.setGuard(guard: (Player) -> boolean)
	_guard = guard
end

-- Wird einmal gerufen, wenn der Avatar die Insel zum ersten Mal betritt
-- (Prompt 6: Terminal-Reveal).
function EpilogIslandBuilder.setArrivalHandler(handler: (Player) -> ())
	_arrivalHandler = handler
end

-- Registriert eine Aufraeum-Funktion, die beim Abbau/Zerstoeren der Insel laeuft.
-- false = keine Insel.
function EpilogIslandBuilder.onTeardown(player: Player, fn: () -> ()): boolean
	local state = _state[player]
	if not state then return false end
	table.insert(state.cleanups, fn)
	return true
end

function EpilogIslandBuilder.exists(player: Player): boolean
	local state = _state[player]
	return state ~= nil and state.insel.Parent ~= nil
end

function EpilogIslandBuilder.isComplete(player: Player): boolean
	local state = _state[player]
	return state ~= nil and state.complete
end

function EpilogIslandBuilder.isGrowing(player: Player): boolean
	local state = _state[player]
	return state ~= nil and state.growing
end

function EpilogIslandBuilder.stageOf(player: Player): string?
	return _stage[player]
end

-- Trennt Verbindungen, bricht den Faden ab und zerstoert die Teile. Die Stufe
-- bleibt gemerkt (Neuaufbau des Plots). Idempotent.
-- Weitere Teile der Insel (z. B. das Terminal aus Prompt 4) melden sich hier an,
-- damit sie mit der Insel verschwinden.
local function runCleanups(state: State)
	local list = state.cleanups
	state.cleanups = {}
	for _, fn in list do
		local ok, err = pcall(fn)
		if not ok then warn("[EpilogIslandBuilder] Aufraeumen fehlgeschlagen:", err) end
	end
end

local function teardown(player: Player)
	local state = _state[player]
	if not state then return end
	_state[player] = nil
	runCleanups(state)
	if state.thread then
		pcall(task.cancel, state.thread)
	end
	for _, conn in state.conns do
		conn:Disconnect()
	end
	if state.bridge and state.bridge.Parent ~= nil then state.bridge:Destroy() end
	if state.insel.Parent ~= nil then state.insel:Destroy() end
	if state.folder.Parent ~= nil and #state.folder:GetChildren() == 0 then
		state.folder:Destroy()
	end
end

-- Alles weg, sofort, und die Stufe vergessen (Leave, Reset, Abschluss).
function EpilogIslandBuilder.destroy(player: Player)
	teardown(player)
	_stage[player] = nil
end

--------------------------------------------------------------------------------
-- Funken (hoechstens maxEmitters gleichzeitig)
--------------------------------------------------------------------------------

local function sparks(state: State, part: BasePart)
	local B = EpilogConfig.BRIDGE
	if state.emitters >= B.maxEmitters then return end
	state.emitters += 1

	local rng = state.rng
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, B.plankThick / 2 + 0.2, 0)
	attachment.Parent = part

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture      = particleTexture()
	emitter.Color        = ColorSequence.new(B.colors.spark)
	emitter.LightEmission = 0.8
	emitter.Size         = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5 + rng:NextNumber() * 0.3),
		NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime     = NumberRange.new(B.sparkLife * 0.6, B.sparkLife)
	emitter.Speed        = NumberRange.new(5 + rng:NextNumber() * 3, 9 + rng:NextNumber() * 5)   -- Muster zufaellig
	emitter.SpreadAngle  = Vector2.new(30 + rng:NextNumber() * 60, 30 + rng:NextNumber() * 60)
	emitter.Acceleration = Vector3.new(0, -14, 0)
	emitter.Rate         = 0
	emitter.Parent       = attachment
	emitter:Emit(B.sparkCount + rng:NextInteger(-2, 2))

	task.delay(B.sparkLife + 0.1, function()
		state.emitters = math.max(0, state.emitters - 1)
		emitter:Destroy()
		attachment:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- Insel
--------------------------------------------------------------------------------

-- Fangboden: wer faellt, wird zurueckgeholt (Gipfel; bei fertiger Bruecke zum Ansatz).
local function onCatch(state: State, hit: BasePart)
	local owner = state.owner
	if _state[owner] ~= state or state.removing then return end
	if Players:GetPlayerFromCharacter(hit.Parent) ~= owner then return end
	local now = os.clock()
	if now - state.lastCatch < EpilogConfig.ISLAND.catchCooldown then return end
	state.lastCatch = now
	if state.complete then
		local wp = state.layout.waypoints[3]   -- Ende des Brueckenansatzes
		local forward = toVec(state.layout.waypoints[4])
		placeAvatar(owner, toVec(wp) + Vector3.new(0, EpilogConfig.SUMMIT.spawnLift, 0), forward)
	else
		EpilogSummitBuilder.teleportPlayerToSummit(owner, nil)
	end
end

local function glowRim(state: State)
	local I = EpilogConfig.ISLAND
	TweenService:Create(state.rim, TweenInfo.new(I.glowSeconds, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ Color = I.colors.rimGlow }):Play()
	local light = state.wiese:FindFirstChild("Inselglanz")
	if light and light:IsA("PointLight") then
		TweenService:Create(light, TweenInfo.new(I.glowSeconds), { Brightness = I.lightBrightness * 1.8 }):Play()
	end
	state.insel:SetAttribute("Arrived", true)
end

local function onWiese(state: State, hit: BasePart)
	local owner = state.owner
	if _state[owner] ~= state or state.removing then return end
	if Players:GetPlayerFromCharacter(hit.Parent) ~= owner then return end
	if not state.complete then
		-- Insel vor der fertigen Bruecke betreten (Exploit): zurueck zum Gipfel
		local now = os.clock()
		if now - state.lastCatch < EpilogConfig.ISLAND.catchCooldown then return end
		state.lastCatch = now
		EpilogSummitBuilder.teleportPlayerToSummit(owner, nil)
		return
	end
	if state.arrived then return end
	state.arrived = true
	glowRim(state)
	local handler = _arrivalHandler
	if handler then task.spawn(handler, owner) end
end

-- Nebel-Puff waehrend der Enthuellung (ein Emitter).
local function cloudPuff(state: State, seconds: number)
	local I = EpilogConfig.ISLAND
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, 1, 0)
	attachment.Parent = state.wiese
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture      = particleTexture()
	emitter.Color        = ColorSequence.new(I.colors.cloud)
	emitter.LightEmission = 0.3
	emitter.Size         = NumberSequence.new({ NumberSequenceKeypoint.new(0, 6), NumberSequenceKeypoint.new(1, 14) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime     = NumberRange.new(1.4, 2.2)
	emitter.Speed        = NumberRange.new(1, 3)
	emitter.SpreadAngle  = Vector2.new(180, 180)
	emitter.Rate         = 18
	emitter.Parent       = attachment
	task.delay(seconds, function()
		emitter.Enabled = false
		task.delay(2.4, function()
			emitter:Destroy()
			attachment:Destroy()
		end)
	end)
end

-- Baut die Insel. `opts.animate`: waechst in revealSeconds aus Nebel auf Vollgroesse
-- (Groessen-Tween, kein Mesh-Tausch); sonst steht sie sofort da (Wiederaufnahme).
-- Verlangt den Gipfel im Plot. Einzeiler: EpilogIslandBuilder.buildIsland(plot)
function EpilogIslandBuilder.buildIsland(plot: Model, opts: { animate: boolean? }?): Model?
	local owner = ownerOfPlot(plot)
	if not owner then return nil end
	local folder, gipfel = gipfelOf(plot)
	if not folder or not gipfel then return nil end
	local layout = layoutOf(gipfel)
	if not layout then return nil end
	teardown(owner)

	local I = EpilogConfig.ISLAND
	local animate = opts ~= nil and opts.animate == true

	local insel = Instance.new("Model")
	insel.Name = "Insel"
	local body = Instance.new("Model")
	body.Name = "Inselkoerper"

	-- Optional: Mesh-Huelle aus der Vorlage (Fels, Kristalle, Buesche, Wiesenmesh).
	-- Das Blender-Modell ist fuer Bruecke in +X gebaut; Roblox-yaw = -Brueckenwinkel.
	local A = EpilogConfig.ASSETS
	local bridgeAngle = math.atan2(layout.terminal.pos[3] - layout.center[3], layout.terminal.pos[1] - layout.center[1])
	local skin = EpilogMeshes.islandSkin(toVec(layout.center), -bridgeAngle, I.diameter, A.islandTemplate)

	local wiese: Part? = nil
	local rim: Part? = nil
	local pad: Part? = nil
	local catchFloor: Part? = nil
	for _, piece in layout.island do
		-- mit Huelle ersetzt sie Fels, Kristalle und Buesche (Primitive entfallen)
		if skin and (string.match(piece.name, "^Fels_") or string.match(piece.name, "^Kristall_")
			or string.match(piece.name, "^Busch_")) then
			continue
		end
		local part = makePart(piece)
		if piece.hidden then
			catchFloor = part
			part.CanTouch = true
			part.Parent = insel         -- ausserhalb des skalierten Koerpers
		else
			part.Parent = body
		end
		if piece.name == "Wiese" then
			wiese = part
			part.CanTouch = true
			if skin then part.Transparency = 1 end   -- bleibt als unsichtbarer Boden unter dem Wiesenmesh
		end
		if piece.name == "Inselrand" then rim = part end
		if piece.name == "Podest" then pad = part end
		if piece.deco then CollectionService:AddTag(part, TAG_DECO) end
	end
	if not (wiese and rim and pad and catchFloor) then
		insel:Destroy()
		body:Destroy()
		if skin then for _, c in skin do c.part:Destroy() end end
		return nil
	end
	if skin then
		local fromConfig = EpilogMeshes.colorsFromConfig(A.islandTemplate)
		local keys: { [string]: string } = {
			Epilog_Insel_Wiese = "grass", Epilog_Insel_Fels = "rock", Epilog_Insel_Kristall = "crystal",
			Epilog_Insel_Busch1 = "bush", Epilog_Insel_Busch2 = "bush", Epilog_Insel_Busch3 = "bush",
		}
		for _, c in skin do
			-- Vertexfarben der FBX bleiben unveraendert (Color weiss), ausser die Vorlage will Config-Farben
			c.part.Color = if fromConfig then colorFor(keys[c.name]) else Color3.new(1, 1, 1)
			c.part.Material = Enum.Material.SmoothPlastic
			c.part.Parent = body
			if c.name ~= "Epilog_Insel_Wiese" and c.name ~= "Epilog_Insel_Fels" then
				CollectionService:AddTag(c.part, TAG_DECO)
			end
		end
	end
	body.PrimaryPart = wiese
	body.Parent = insel

	-- Mount fuer das Terminal (Prompt 4) und sanftes Gold-Licht aus Richtung des Terminals
	local mount = Instance.new("Attachment")
	mount.Name = "TerminalMount"
	mount.WorldCFrame = CFrame.lookAt(toVec(layout.terminal.pos), toVec(layout.terminal.look))
	mount.Parent = pad
	local light = Instance.new("PointLight")
	light.Name       = "Inselglanz"
	light.Color      = I.lightColor
	light.Range      = I.lightRange
	light.Brightness = I.lightBrightness
	light.Shadows    = false
	light.Parent     = wiese

	insel:SetAttribute("Revealed", false)
	insel:SetAttribute("Arrived", false)
	CollectionService:AddTag(insel, TAG_ISLAND)

	local state: State = {
		owner = owner, plot = plot, folder = folder, gipfel = gipfel, layout = layout,
		insel = insel, body = body, wiese = wiese, rim = rim, catchFloor = catchFloor,
		bridge = nil, planks = {}, rails = {}, conns = {}, cleanups = {}, thread = nil,
		revealed = false, growing = false, complete = false, arrived = false, removing = false,
		emitters = 0, lastCatch = 0, rng = Random.new(),
	}
	_state[owner] = state
	_stage[owner] = "island"

	if animate then body:ScaleTo(I.revealStart) end
	insel.Parent = folder

	table.insert(state.conns, catchFloor.Touched:Connect(function(hit: BasePart) onCatch(state, hit) end))
	table.insert(state.conns, wiese.Touched:Connect(function(hit: BasePart) onWiese(state, hit) end))
	-- Faellt der Gipfel weg (Plot-Neuaufbau, Abbau), geht die Insel mit.
	table.insert(state.conns, gipfel.Destroying:Connect(function()
		task.defer(function()
			if _state[owner] == state then teardown(owner) end
		end)
	end))

	if not animate then
		state.revealed = true
		insel:SetAttribute("Revealed", true)
		return insel
	end

	-- Phase 1: aus dem Nebel aufwachsen (ease out)
	state.thread = task.spawn(function()
		cloudPuff(state, I.revealSeconds)
		for step = 1, I.revealSteps do
			if _state[owner] ~= state or state.removing then return end
			local t = step / I.revealSteps
			local eased = 1 - (1 - t) * (1 - t)
			body:ScaleTo(I.revealStart + (1 - I.revealStart) * eased)
			task.wait(I.revealSeconds / I.revealSteps)
		end
		if _state[owner] == state then
			body:ScaleTo(1)
			state.revealed = true
			insel:SetAttribute("Revealed", true)
		end
	end)
	return insel
end

--------------------------------------------------------------------------------
-- Bruecke
--------------------------------------------------------------------------------

local function ensureBridgeModel(state: State): Model
	local bridge = state.bridge
	if bridge and bridge.Parent ~= nil then return bridge end
	local model = Instance.new("Model")
	model.Name = "Bruecke"
	model:SetAttribute("Planks", 0)
	model:SetAttribute("Complete", false)
	CollectionService:AddTag(model, TAG_BRIDGE)
	model.Parent = state.folder
	state.bridge = model
	return model
end

local function plankCFrame(plank: Layout.Plank): CFrame
	return CFrame.new(plank.pos[1], plank.pos[2], plank.pos[3])
		* CFrame.Angles(0, plank.yaw, 0) * CFrame.Angles(0, 0, plank.pitch)
end

local function newPlank(state: State, plank: Layout.Plank, cf: CFrame): BasePart
	local size = Vector3.new(plank.size[1], plank.size[2], plank.size[3])
	local part: BasePart
	local mesh = EpilogMeshes.meshPart(EpilogConfig.ASSETS.plankTemplate, "Epilog_Plank")
	if mesh then
		-- Mesh-Planke (Holz mit Goldrand): Vertexfarben, ausser die Vorlage will Config-Farben
		EpilogMeshes.setup(mesh, "Planke_" .. plank.index, size, cf)
		mesh.Material = Enum.Material.WoodPlanks
		mesh.Color = if EpilogMeshes.colorsFromConfig(EpilogConfig.ASSETS.plankTemplate)
			then colorFor(plank.colorKey) else Color3.new(1, 1, 1)
		part = mesh
	else
		part = MapParts.newPart("Planke_" .. plank.index, size, cf, colorFor(plank.colorKey), Enum.Material.WoodPlanks)
	end
	part.CanCollide = false
	part.CanTouch   = false
	part.CanQuery   = true
	part.CastShadow = false
	part.Parent = ensureBridgeModel(state)
	table.insert(state.planks, part)
	return part
end

local function addRails(state: State, fadeIn: boolean)
	local B = EpilogConfig.BRIDGE
	local bridge = ensureBridgeModel(state)
	for _, piece in state.layout.rails do
		local part = makePart(piece)
		part.CanCollide = true
		part.Transparency = if fadeIn then 1 else B.railAlpha
		part.Parent = bridge
		table.insert(state.rails, part)
		if fadeIn then
			TweenService:Create(part, TweenInfo.new(B.railFade, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
				{ Transparency = B.railAlpha }):Play()
		end
	end
end

local function markComplete(state: State)
	state.complete = true
	_stage[state.owner] = "bridge"
	local bridge = state.bridge
	if bridge then
		bridge:SetAttribute("Planks", #state.planks)
		bridge:SetAttribute("Complete", true)
	end
end

-- Laesst die Bruecke Planke fuer Planke wachsen (Phase 2/3). `onDone` laeuft nach
-- dem Lichtimpuls. Gibt (false, Grund) zurueck, wenn eine Bedingung fehlt — der
-- Grund ist ein Code, kein Spielertext. Einzeiler: EpilogIslandBuilder.growBridge(plot, onDone)
function EpilogIslandBuilder.growBridge(plot: Model, onDone: (() -> ())?): (boolean, string)
	local owner = ownerOfPlot(plot)
	if not owner then return false, "no_owner" end
	local state = _state[owner]
	if not state then return false, "no_island" end
	if state.removing then return false, "removing" end
	if state.complete then return false, "already_complete" end
	if state.growing then return false, "already_growing" end
	if not state.revealed then return false, "island_not_revealed" end
	if not allowed(owner) then return false, "state_not_allowed" end
	if not isAlive(owner) then return false, "player_dead" end
	if not nearSummit(state) then return false, "player_not_at_summit" end

	state.growing = true
	ensureBridgeModel(state)

	local B = EpilogConfig.BRIDGE
	state.thread = task.spawn(function()
		if B.startDelay > 0 then task.wait(B.startDelay) end
		for i, plank in state.layout.planks do
			if _state[owner] ~= state or state.removing then return end
			local final = plankCFrame(plank)
			local part = newPlank(state, plank, final + Vector3.new(0, B.springDrop, 0))
			-- Aufsetz-Federn: faellt mit Overshoot (Back) auf seinen Platz
			TweenService:Create(part, TweenInfo.new(B.springSeconds, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ CFrame = final }):Play()
			task.delay(B.springSeconds, function()
				if _state[owner] ~= state or part.Parent == nil then return end
				part.CanCollide = true
				sparks(state, part)
			end)
			if state.bridge then state.bridge:SetAttribute("Planks", i) end
			if i < #state.layout.planks then task.wait(B.growInterval) end
		end
		task.wait(B.springSeconds)
		if _state[owner] ~= state or state.removing then return end

		-- Phase 3: Verbindung — Gelaender erscheint, Lichtimpuls laeuft zur Insel
		addRails(state, true)
		state.growing = false
		markComplete(state)

		local pulse = makePart(state.layout.pulse)
		pulse.Parent = ensureBridgeModel(state)
		local to = state.layout.pulseTo
		local n = state.layout.normal
		local target = CFrame.new(to[1] + n[1] * 0.2, to[2] + n[2] * 0.2, to[3] + n[3] * 0.2)
			* CFrame.Angles(0, state.layout.pulse.yaw, 0) * CFrame.Angles(0, 0, state.layout.pulse.pitch)
		local tween = TweenService:Create(pulse, TweenInfo.new(B.pulseSeconds, Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut), { CFrame = target })
		tween:Play()
		task.wait(B.pulseSeconds)
		if pulse.Parent ~= nil then pulse:Destroy() end
		if _state[owner] ~= state then return end
		if onDone then
			local ok, err = pcall(onDone)
			if not ok then warn("[EpilogIslandBuilder] onDone fehlgeschlagen:", err) end
		end
	end)
	return true, "ok"
end

-- Fertige Bruecke sofort (ohne Animation): Wiederaufnahme ("seen"/"pending") und
-- Neuaufbau des Plots. Gleiche Bedingung wie growBridge (Guard), aber ohne
-- Positionspruefung — der Spieler steht dabei noch nicht am Gipfel.
function EpilogIslandBuilder.buildBridgeInstant(plot: Model): (boolean, string)
	local owner = ownerOfPlot(plot)
	if not owner then return false, "no_owner" end
	local state = _state[owner]
	if not state then return false, "no_island" end
	if state.removing then return false, "removing" end
	if state.complete then return true, "already_complete" end
	if not allowed(owner) then return false, "state_not_allowed" end

	if state.thread then pcall(task.cancel, state.thread); state.thread = nil end
	state.growing = false
	state.revealed = true
	state.insel:SetAttribute("Revealed", true)
	state.body:ScaleTo(1)

	-- eventuell begonnene Planken ersetzen: sauber von vorn
	local bridge = state.bridge
	if bridge and bridge.Parent ~= nil then
		bridge:Destroy()
		state.bridge = nil
		table.clear(state.planks)
		table.clear(state.rails)
	end
	ensureBridgeModel(state)
	for _, plank in state.layout.planks do
		local part = newPlank(state, plank, plankCFrame(plank))
		part.CanCollide = true
	end
	addRails(state, false)
	markComplete(state)
	return true, "ok"
end

-- Baut nach einem Neuaufbau des Plots (Rebirth, Ausbau) wieder auf, was vorher
-- stand. Von MapService nach dem Gipfel-Bau gerufen.
function EpilogIslandBuilder.restoreAfterRebuild(plot: Model)
	local owner = ownerOfPlot(plot)
	if not owner then return end
	local stage = _stage[owner]
	teardown(owner)   -- alte Verweise lassen (Teile starben mit dem alten Plot)
	if not stage then return end
	if EpilogIslandBuilder.buildIsland(plot, { animate = false }) and stage == "bridge" then
		EpilogIslandBuilder.buildBridgeInstant(plot)
	end
end

--------------------------------------------------------------------------------
-- Abbau
--------------------------------------------------------------------------------

-- Baut Bruecke und Insel ab. `animated`: in umgekehrter Reihenfolge (Planken von
-- der Insel zum Gipfel, dann schrumpft die Insel), ca. removeSeconds; sonst sofort.
-- Nicht blockierend; `onDone` laeuft am Ende. Danach: 0 Reste.
function EpilogIslandBuilder.removeAll(plot: Model, animated: boolean, onDone: (() -> ())?)
	local owner = ownerOfPlot(plot)
	if not owner then return end
	local state = _state[owner]
	if not state then
		_stage[owner] = nil
		if onDone then task.defer(onDone) end
		return
	end
	if not animated then
		EpilogIslandBuilder.destroy(owner)
		if onDone then task.defer(onDone) end
		return
	end
	if state.removing then return end
	state.removing = true
	state.insel:SetAttribute("Revealed", false)   -- der Client hoert auf zu wippen
	if state.thread then pcall(task.cancel, state.thread); state.thread = nil end

	local B, I = EpilogConfig.BRIDGE, EpilogConfig.ISLAND
	state.thread = task.spawn(function()
		for _, rail in state.rails do rail:Destroy() end
		table.clear(state.rails)
		local count = #state.planks
		local plankTime = B.removeSeconds * 0.7
		for index = count, 1, -1 do
			local part = state.planks[index]
			if part and part.Parent ~= nil then
				part.CanCollide = false
				TweenService:Create(part, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
					{ Transparency = 1, CFrame = part.CFrame + Vector3.new(0, B.springDrop, 0) }):Play()
				task.delay(0.3, function() if part.Parent ~= nil then part:Destroy() end end)
			end
			task.wait(plankTime / math.max(1, count))
		end
		runCleanups(state)   -- Terminal u. a. verschwinden, bevor die Insel schrumpft
		local steps = I.revealSteps
		local shrinkTime = B.removeSeconds * 0.3
		for step = 1, steps do
			if _state[owner] ~= state then return end
			local t = step / steps
			state.body:ScaleTo(math.max(0.02, 1 - (1 - I.revealStart) * t * 1.0))
			task.wait(shrinkTime / steps)
		end
		if _state[owner] == state then
			EpilogIslandBuilder.destroy(owner)
		end
		if onDone then
			local ok, err = pcall(onDone)
			if not ok then warn("[EpilogIslandBuilder] onDone (Abbau) fehlgeschlagen:", err) end
		end
	end)
end

--------------------------------------------------------------------------------
-- Auskunft fuer Prompt 4-6
--------------------------------------------------------------------------------

-- Wegpunkte fuer den Avatar (Fusspunkte auf der Oberflaeche), vom Gipfel ueber
-- Ansatz und Planken bis vor das Terminal. Auch ohne gebaute Insel gueltig (der
-- Gipfel genuegt), damit Kamera/Wegfuehrung vorab planen koennen.
function EpilogIslandBuilder.getBridgeWaypoints(plot: Model): { Vector3 }
	local _, gipfel = gipfelOf(plot)
	if not gipfel then return {} end
	local layout = layoutOf(gipfel)
	if not layout then return {} end
	local list: { Vector3 } = {}
	for _, wp in layout.waypoints do
		table.insert(list, toVec(wp))
	end
	return list
end

-- Kamera- und Laufdaten fuer Prompt 5 (reine Zahlen-Tabellen {x, y, z}, gehen per
-- EpilogStart an den Client): Weg vom Avatar-Startpunkt auf dem Gipfel bis vor das
-- Terminal, Gipfelmitte (Avatar-Mitte nach dem Teleport), Brueckenrichtung, Inselmitte,
-- Terminal samt Blickziel. Auch ohne gebaute Insel gueltig (der Gipfel genuegt).
function EpilogIslandBuilder.getRouteInfo(plot: Model): {
	points : { { number } }, summit : { number }, dir : { number },
	island : { number }, terminalPos : { number }, terminalLook : { number },
}?
	local _, gipfel = gipfelOf(plot)
	if not gipfel then return nil end
	local layout = layoutOf(gipfel)
	if not layout then return nil end
	local angle = gipfel:GetAttribute("BridgeAngle")
	if typeof(angle) ~= "number" then return nil end
	local rig = gipfel:FindFirstChild("Rig")
	local spawnAtt = rig and rig:FindFirstChild("Spawn")
	local summit: Vector3
	if spawnAtt and spawnAtt:IsA("Attachment") then
		summit = spawnAtt.WorldPosition
	else
		local first = layout.waypoints[1]
		summit = Vector3.new(first[1], first[2] + EpilogConfig.SUMMIT.spawnLift, first[3])
	end
	local lift = EpilogConfig.SUMMIT.spawnLift
	local points: { { number } } = { { summit.X, summit.Y - lift, summit.Z } }
	for _, wp in layout.waypoints do
		table.insert(points, { wp[1], wp[2], wp[3] })
	end
	return {
		points = points,
		summit = { summit.X, summit.Y, summit.Z },
		dir = { math.cos(angle), 0, math.sin(angle) },
		island = { layout.center[1], layout.center[2], layout.center[3] },
		terminalPos = { layout.terminal.pos[1], layout.terminal.pos[2], layout.terminal.pos[3] },
		terminalLook = { layout.terminal.look[1], layout.terminal.look[2], layout.terminal.look[3] },
	}
end

-- Weltlage des Terminals (Prompt 4): Fusspunkt auf dem Podest, Blick zur Bruecke.
function EpilogIslandBuilder.getTerminalMount(plot: Model): CFrame?
	local _, gipfel = gipfelOf(plot)
	if not gipfel then return nil end
	local layout = layoutOf(gipfel)
	if not layout then return nil end
	return CFrame.lookAt(toVec(layout.terminal.pos), toVec(layout.terminal.look))
end

-- Setzt Avatar (und Begleiter-Baerchi) vor das Terminal auf die Insel. Nur bei
-- fertiger Bruecke (sonst koennte man die Insel vorab "teleportieren").
function EpilogIslandBuilder.teleportPlayerToIsland(player: Player, companion: Model?): boolean
	local state = _state[player]
	if not state or state.insel.Parent == nil or not state.complete then return false end
	local layout = state.layout
	local arrival = toVec(layout.waypoints[#layout.waypoints])
	local lookAt = toVec(layout.terminal.pos)
	if not placeAvatar(player, arrival + Vector3.new(0, EpilogConfig.SUMMIT.spawnLift, 0), lookAt) then
		return false
	end
	if companion and companion.Parent ~= nil then
		local dir = (lookAt - arrival) * Vector3.new(1, 0, 1)
		dir = if dir.Magnitude > 0.01 then dir.Unit else Vector3.new(1, 0, 0)
		local side = Vector3.new(-dir.Z, 0, dir.X) * EpilogConfig.SUMMIT.companionSide
		placeFigure(companion, arrival.X + side.X, arrival.Z + side.Z, layout.topY, dir)
	end
	return true
end

-- Teile fuer `parts` und `epilog scan`: (Insel, Bruecke).
function EpilogIslandBuilder.countParts(player: Player): (number, number)
	local state = _state[player]
	if not state then return 0, 0 end
	local function count(root: Instance?): number
		if not root then return 0 end
		local n = 0
		for _, d in root:GetDescendants() do
			if d:IsA("BasePart") then n += 1 end
		end
		return n
	end
	return count(state.insel), count(state.bridge)
end

-- `epilog scan`: sucht im GANZEN Workspace nach Insel-/Brueckenresten, auch ohne
-- Zustand (vor dem Sieg muss alles 0 sein). Nur Debug.
function EpilogIslandBuilder.scanWorkspace(): { [string]: number }
	local islands, bridges, planks, parts, folders = 0, 0, 0, 0, 0
	for _, d in Workspace:GetDescendants() do
		if d:IsA("Folder") and d.Name == "Epilog" then
			folders += 1
		elseif d:IsA("Model") and d.Parent and d.Parent.Name == "Epilog" then
			if d.Name == "Insel" then islands += 1 elseif d.Name == "Bruecke" then bridges += 1 end
		elseif d:IsA("BasePart") then
			if string.match(d.Name, "^Planke_%d+$") then planks += 1 end
		end
	end
	for _, tag in { TAG_ISLAND, TAG_BRIDGE } do
		for _, tagged in CollectionService:GetTagged(tag) do
			for _, d in tagged:GetDescendants() do
				if d:IsA("BasePart") then parts += 1 end
			end
		end
	end
	return { inselModelle = islands, brueckenModelle = bridges, planken = planks,
		taggedTeile = parts, ordnerEpilog = folders }
end

return EpilogIslandBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">EpilogMeshes</string><ProtectedString name="Source"><![CDATA[--!strict
-- EpilogMeshes: optionale Mesh-Vorlagen fuer Insel, Planke und Terminal (Epilog).
--
-- Die Vorlagen liegen als Modelle in ReplicatedStorage.Assets (Studio-Import der
-- FBX aus assets/epilog/, siehe docs/HBB_EPILOG_ASSETS_2026-10-20.md):
--   EpilogIsland   -> MeshParts Epilog_Insel_Wiese/_Fels/_Kristall/_Busch1-3
--   EpilogPlank    -> MeshPart  Epilog_Plank
--   EpilogTerminal -> MeshParts Epilog_Terminal_<Teil> (Namen wie EpilogTerminalLayout)
-- Fehlt eine Vorlage (oder ein Teil darin), liefert dieses Modul nil und der Aufrufer
-- baut wie bisher die Primitive. Es wird nie etwas veraendert oder geloescht.
--
-- Massstab ist egal: Insel und Planke werden ueber ihre bekannten Referenzmasse
-- angepasst, das Terminal ueber die Teilgroessen aus dem Layout (Size wird gesetzt).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EpilogMeshes = {}

-- Breite der Wiese im Blender-Modell (Epilog_Insel_Wiese, Studs bei Importmassstab 1).
local WIESE_REF_BREITE = 24.86
-- Nenndurchmesser, auf den das Blender-Modell gebaut ist (EpilogConfig.ISLAND.diameter).
local INSEL_REF_DURCHMESSER = 24

local ISLAND_PARTS = {
	"Epilog_Insel_Wiese", "Epilog_Insel_Fels", "Epilog_Insel_Kristall",
	"Epilog_Insel_Busch1", "Epilog_Insel_Busch2", "Epilog_Insel_Busch3",
}

function EpilogMeshes.template(name: string): Instance?
	if name == "" then return nil end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then return nil end
	return assets:FindFirstChild(name)
end

-- Klon des MeshParts `partName` aus der Vorlage `templateName` (nil, wenn es fehlt
-- oder kein Mesh hat).
function EpilogMeshes.meshPart(templateName: string, partName: string): MeshPart?
	local root = EpilogMeshes.template(templateName)
	if not root then return nil end
	for _, d in root:GetDescendants() do
		if d.Name == partName and d:IsA("MeshPart") and d.MeshId ~= "" then
			return d:Clone()
		end
	end
	return nil
end

-- Gemeinsame Grundeinstellung fuer ein Mesh-Teil im Epilog.
function EpilogMeshes.setup(part: MeshPart, name: string, size: Vector3, cframe: CFrame)
	part.Name          = name
	part.Size          = size
	part.CFrame        = cframe
	part.Anchored      = true
	part.CanCollide    = false
	part.CanTouch      = false
	part.CastShadow    = false
	part.TopSurface    = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

-- true, wenn die Vorlage die Farben aus der Config will (Attribut FarbenAusConfig):
-- fuer den Fall, dass Studio die Vertexfarben der FBX nicht uebernimmt.
function EpilogMeshes.colorsFromConfig(templateName: string): boolean
	local root = EpilogMeshes.template(templateName)
	return root ~= nil and root:GetAttribute("FarbenAusConfig") == true
end

-- Insel-Huelle: Klone der sechs Teile, passend auf die Insel gesetzt.
--   top    = Mitte der Wiesenoberkante
--   yaw    = Drehung um Y (Blender-Modell: Bruecke liegt in +X, Roblox yaw = -Bruecken-Winkel)
--   diameter = Durchmesser der Wiese
-- Gibt eine Liste { name, MeshPart } zurueck oder nil, wenn die Vorlage unvollstaendig ist.
function EpilogMeshes.islandSkin(top: Vector3, yaw: number, diameter: number, templateName: string)
	: { { name: string, part: MeshPart } }?
	local clones: { { name: string, part: MeshPart } } = {}
	for _, name in ISLAND_PARTS do
		local m = EpilogMeshes.meshPart(templateName, name)
		if not m then
			for _, c in clones do c.part:Destroy() end
			return nil
		end
		table.insert(clones, { name = name, part = m })
	end
	local wiese = clones[1].part
	local importScale = wiese.Size.X / WIESE_REF_BREITE        -- Studs je Blender-Einheit
	local f = (diameter / INSEL_REF_DURCHMESSER) / importScale  -- Faktor auf die Vorlagenmasse
	local originCF = CFrame.new(wiese.CFrame:PointToWorldSpace(Vector3.new(0, wiese.Size.Y / 2, 0)))
		* wiese.CFrame.Rotation
	local target = CFrame.new(top) * CFrame.Angles(0, yaw, 0)
	for _, c in clones do
		local part = c.part
		local rel = originCF:ToObjectSpace(part.CFrame)
		local size = part.Size * f
		local cf = target * CFrame.new(rel.Position * f) * rel.Rotation
		EpilogMeshes.setup(part, c.name, size, cf)
	end
	return clones
end

return EpilogMeshes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">EpilogSummitBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- EpilogSummitBuilder.luau
-- ServerScriptService/Util/MapBuild/EpilogSummitBuilder.luau
--
-- Einzige Zustaendigkeit (Prompt 2 von 7, Final-Epilog):
--   - Den Gipfel auf der obersten Etage des Final-Run-Turms bauen, den Avatar
--     samt Begleiter-Baerchi dorthin setzen, bei der Abfahrt als Lift mit nach
--     unten nehmen und alles wieder restlos entfernen.
--
-- Die Geometrie steht in Modules/EpilogSummitLayout (reine Rechnung, getestet),
-- die Masse in Config/EpilogConfig.SUMMIT. Hier wird nur gebaut. Alle Teile
-- liegen im Modell `Gipfel` im Ordner `Epilog` des Plots (Vertrag: Epilog ->
-- Gipfel, Bruecke, Insel, Terminal). Der Server baut, der Client schaut nur zu.
--
-- Dieses Modul kennt MapService NICHT (MapService benutzt es). Den Turm selbst
-- (Etagen, Sperre) fuehrt MapService; hier wird er nur ueber `setLevel`
-- (Parameter von lowerWithPlayer) verkleinert.
--
-- Cleanup: destroy(player) zerstoert Modell, trennt alle Verbindungen und
-- bricht den Aufbau-Faden ab. Der Ordner `Epilog` geht mit, wenn nichts anderes
-- (Insel, Terminal aus Prompt 3/4) mehr darin liegt.

local Players           = game:GetService("Players")
local Lighting          = game:GetService("Lighting")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig    = require(ReplicatedStorage.Config.MapConfig)
local EpilogConfig = require(ReplicatedStorage.Config.EpilogConfig)
local TowerConfig  = require(ReplicatedStorage.Config.TowerConfig)
local Layout       = require(ReplicatedStorage.Modules.EpilogSummitLayout)

local MapParts = require(script.Parent.MapParts)
local FigureFX = require(ServerScriptService.Util.FigureFX)

local EpilogSummitBuilder = {}

type State = {
	owner    : Player,
	plot     : Model,
	folder   : Folder,
	model    : Model,
	layout   : Layout.Result,
	floorY   : number,
	center   : Vector3,
	bridgeDir: Vector3,
	conns    : { RBXScriptConnection },
	thread   : thread?,
	lowering : boolean,
	lastCatch: number,
}

local _state: { [Player]: State } = {}

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- Etagen des gehaltenen Turms: die oberste Etage des Final-Laufs bei Stage 100.
function EpilogSummitBuilder.holdFloors(): number
	local def = TowerConfig.get(EpilogConfig.TOWER_ID)
	return TowerConfig.getRunFloor(EpilogConfig.TOWER_ID, if def then def.stages else 100)
end

function EpilogSummitBuilder.floorYOf(level: number): number
	return MapConfig.PLATFORM_TOP_Y + math.max(0, level) * MapConfig.PIT_TOWER_STEP_HEIGHT
end

local function colorFor(key: string): Color3
	local colors = EpilogConfig.SUMMIT.colors :: { [string]: Color3 }
	if key == "crystal" then
		-- Look des Final-Towers (nicht fest verdrahtet)
		local def = TowerConfig.get(EpilogConfig.TOWER_ID)
		local look = if def then MapConfig.TOWER_LOOKS[def.look] else nil
		return if look then look.accent else colors.rim
	end
	return colors[key] or colors.plate
end

local function isNight(): boolean
	local t = Lighting.ClockTime
	return t < EpilogConfig.SUMMIT.dayFrom or t >= EpilogConfig.SUMMIT.dayTo
end

local function makePart(piece: Layout.Piece): Part
	local cf = CFrame.new(piece.pos[1], piece.pos[2], piece.pos[3])
	local size: Vector3
	if piece.kind == "Disc" then
		size = Vector3.new(piece.size[1], piece.size[2], piece.size[2])
		cf = cf * CFrame.Angles(0, 0, math.rad(90))
	else
		size = Vector3.new(piece.size[1], piece.size[2], piece.size[3])
		cf = cf * CFrame.Angles(0, piece.yaw, 0)
	end
	local part = MapParts.newPart(piece.name, size, cf, colorFor(piece.colorKey),
		(Enum.Material :: any)[piece.material])
	if piece.kind == "Disc" then part.Shape = Enum.PartType.Cylinder end
	part.CanCollide = piece.collide
	part.CanTouch   = false
	part.CastShadow = false
	if piece.hidden then
		part.Transparency = 1
		part.CanQuery     = false
	elseif not piece.collide then
		part.CanQuery = false
	end
	return part
end

local function characterOf(player: Player): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	if not character then return nil, nil, nil end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") and humanoid then
		return character, root, humanoid
	end
	return nil, nil, nil
end

-- Figur auf eine Stelle stellen, Unterkante auf `bottomY` (Figuren haben
-- unterschiedliche Pivots).
local function placeFigure(model: Model, x: number, z: number, bottomY: number, lookDir: Vector3)
	FigureFX.stopIdle(model)
	model:PivotTo(CFrame.lookAt(Vector3.new(x, bottomY + 2, z), Vector3.new(x, bottomY + 2, z) + lookDir))
	local boxCf, boxSize = model:GetBoundingBox()
	local bottom = boxCf.Position.Y - boxSize.Y / 2
	model:PivotTo(model:GetPivot() + Vector3.new(0, bottomY - bottom, 0))
	FigureFX.idleBob(model, { height = MapConfig.IDLE_BOB_HEIGHT, rate = MapConfig.IDLE_BOB_RATE })
end

--------------------------------------------------------------------------------
-- Teleport
--------------------------------------------------------------------------------

-- Setzt den Avatar (und den Begleiter-Baerchi) auf den Spawn in der Mitte des
-- Gipfels. Sicherheits-Reset: Geschwindigkeit null, nicht sitzend, Humanoid
-- steht auf. false = kein Gipfel oder kein Charakter.
function EpilogSummitBuilder.teleportPlayerToSummit(player: Player, companion: Model?): boolean
	local state = _state[player]
	if not state or state.model.Parent == nil then return false end
	local character, root, humanoid = characterOf(player)
	if not character or not root or not humanoid then return false end

	local spawn = state.layout.spawn
	local spawnPos = Vector3.new(spawn[1], spawn[2], spawn[3])
	humanoid.Sit = false
	root.AssemblyLinearVelocity  = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	character:PivotTo(CFrame.lookAt(spawnPos, spawnPos + state.bridgeDir))
	root.AssemblyLinearVelocity = Vector3.zero
	humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

	if companion and companion.Parent ~= nil then
		local side = Vector3.new(-state.bridgeDir.Z, 0, state.bridgeDir.X) * EpilogConfig.SUMMIT.companionSide
		placeFigure(companion, state.center.X + side.X, state.center.Z + side.Z,
			state.layout.plateTop, state.bridgeDir)
	end
	return true
end

--------------------------------------------------------------------------------
-- Bauen
--------------------------------------------------------------------------------

function EpilogSummitBuilder.exists(player: Player): boolean
	local state = _state[player]
	return state ~= nil and state.model.Parent ~= nil
end

-- Raeumt Zustand, Verbindungen, Faden und Teile weg. Idempotent.
function EpilogSummitBuilder.destroy(player: Player)
	local state = _state[player]
	if not state then return end
	_state[player] = nil

	if state.thread then
		pcall(task.cancel, state.thread)
	end
	for _, conn in state.conns do
		conn:Disconnect()
	end
	if state.model.Parent ~= nil then
		state.model:Destroy()
	end
	-- Der Ordner Epilog geht mit, wenn Insel/Terminal (Prompt 3/4) nichts darin lassen.
	if state.folder.Parent ~= nil and #state.folder:GetChildren() == 0 then
		state.folder:Destroy()
	end
end

-- Baut den Gipfel auf die Etage `holdFloors()`. `opts.animate`: sanftes
-- Einblenden (1,5 s); sonst steht alles sofort da (Wiederaufnahme, Neuaufbau).
-- Einzeiler: EpilogSummitBuilder.build(plot, slot, owner)
function EpilogSummitBuilder.build(plot: Model, slot: number, owner: Player, opts: { animate: boolean? }?): Model
	EpilogSummitBuilder.destroy(owner)

	local C = EpilogConfig.SUMMIT
	local animate = opts ~= nil and opts.animate == true

	local center = MapParts.pitCenter(slot)
	local outward = MapParts.outwardDirection(slot)
	local bridgeAngle = math.atan2(outward.Z, outward.X) + math.rad(C.bridgeOutwardDeg)
	local floorY = EpilogSummitBuilder.floorYOf(EpilogSummitBuilder.holdFloors())
	local layout = Layout.compute(center.X, center.Z, floorY, MapConfig.PIT_TOWER_RADIUS, bridgeAngle)

	local folder = plot:FindFirstChild("Epilog")
	if not (folder and folder:IsA("Folder")) then
		folder = Instance.new("Folder")
		folder.Name   = "Epilog"
		folder.Parent = plot
	end

	local model = Instance.new("Model")
	model.Name = "Gipfel"
	model:SetAttribute("FloorY", floorY)
	model:SetAttribute("BridgeAngle", bridgeAngle)
	model:SetAttribute("Ready", false)

	local fadeParts: { BasePart } = {}
	local rig: Part? = nil
	local catchFloor: Part? = nil
	for _, piece in layout.pieces do
		local part = makePart(piece)
		part.Parent = model
		if piece.name == "Rig" then rig = part end
		if piece.name == "Fangboden" then
			catchFloor = part
			part.CanTouch = true
		end
		if not piece.hidden then
			table.insert(fadeParts, part)
			if animate then part.Transparency = 1 end
		end
	end

	-- Kamera- und Spawn-Anker (Prompt 5 liest sie am Teil "Rig").
	if rig then
		for _, anchor in layout.anchors do
			local att = Instance.new("Attachment")
			att.Name = anchor.name
			att.WorldCFrame = CFrame.lookAt(
				Vector3.new(anchor.pos[1], anchor.pos[2], anchor.pos[3]),
				Vector3.new(anchor.target[1], anchor.target[2], anchor.target[3])
			)
			att.Parent = rig
		end
		-- Ein weiches Licht; nachts staerker. Einmalig beim Bau, kein Dauerprozess.
		local light = Instance.new("PointLight")
		light.Name       = "Gipfellicht"
		light.Color      = C.colors.rim
		light.Range      = C.lightRange
		light.Brightness = if isNight() then C.lightBrightnessNight else C.lightBrightnessDay
		light.Shadows    = false
		light.Parent     = rig
	end

	model.PrimaryPart = rig
	model.Parent = folder

	local state: State = {
		owner = owner, plot = plot, folder = folder :: Folder, model = model, layout = layout,
		floorY = floorY, center = center,
		bridgeDir = Vector3.new(math.cos(bridgeAngle), 0, math.sin(bridgeAngle)),
		conns = {}, thread = nil, lowering = false, lastCatch = 0,
	}
	_state[owner] = state

	-- Fangboden: wer trotz Gelaender faellt, wird zum Gipfel zurueckgeholt.
	if catchFloor then
		table.insert(state.conns, catchFloor.Touched:Connect(function(hit: BasePart)
			if state.lowering or _state[owner] ~= state then return end
			local who = Players:GetPlayerFromCharacter(hit.Parent)
			if who ~= owner then return end
			local now = os.clock()
			if now - state.lastCatch < C.catchCooldown then return end
			state.lastCatch = now
			EpilogSummitBuilder.teleportPlayerToSummit(owner, nil)
		end))
	end

	-- Respawn: der Spieler steht wieder auf dem Gipfel (der Gipfel bleibt).
	table.insert(state.conns, owner.CharacterAdded:Connect(function(character)
		task.defer(function()
			if _state[owner] ~= state or state.lowering then return end
			if character:WaitForChild("HumanoidRootPart", 10) == nil then return end
			task.wait(0.2)
			if _state[owner] == state and owner.Character == character then
				EpilogSummitBuilder.teleportPlayerToSummit(owner, nil)
			end
		end)
	end))

	if not animate then
		model:SetAttribute("Ready", true)
		return model
	end

	-- Phase 1 halten, Phase 2 aufwerten (gestaffelt einblenden), Phase 3 bereit.
	state.thread = task.spawn(function()
		task.wait(C.holdSeconds)
		local count = #fadeParts
		local fadeTime = C.decorSeconds * 0.45
		local stagger = (C.decorSeconds - fadeTime) / math.max(1, count - 1)
		for i, part in fadeParts do
			if _state[owner] ~= state then return end
			TweenService:Create(part, TweenInfo.new(fadeTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
				{ Transparency = 0 }):Play()
			if i < count then task.wait(stagger) end
		end
		task.wait(fadeTime + C.readySeconds)
		if _state[owner] == state then
			model:SetAttribute("Ready", true)
		end
	end)
	return model
end

--------------------------------------------------------------------------------
-- Finale: Abfahrt mit dem Spieler als Lift
--------------------------------------------------------------------------------

-- Der Turm faehrt von `fromLevel` auf 0 (Dauer PIT_TOWER_FALL_SECONDS x
-- lowerFactor, ueberschreibbar). Gipfel, Avatar und Begleiter fahren mit.
-- `setLevel(level)` verkleinert die Etagen (MapService). Blockiert bis zum
-- Ende, danach ist der Gipfel zerstoert. Prompt 6 ruft MapService.lowerSummit,
-- das dies mit setLevel aufruft. false = kein Gipfel.
function EpilogSummitBuilder.lowerWithPlayer(
	player: Player, fromLevel: number, setLevel: (number) -> (),
	opts: { seconds: number?, companion: Model? }?
): boolean
	local state = _state[player]
	if not state or state.model.Parent == nil then return false end
	state.lowering = true

	local seconds = (opts and opts.seconds) or MapConfig.PIT_TOWER_FALL_SECONDS * EpilogConfig.SUMMIT.lowerFactor
	local companion = opts and opts.companion
	local steps = math.max(1, math.min(fromLevel, math.floor(seconds * 20)))
	local stepTime = seconds / steps
	local previous = fromLevel
	if companion then FigureFX.stopIdle(companion) end

	for step = 1, steps do
		if _state[player] ~= state then return false end
		local level = fromLevel - math.floor(fromLevel * step / steps + 0.5)
		setLevel(level)
		local dy = EpilogSummitBuilder.floorYOf(level) - EpilogSummitBuilder.floorYOf(previous)
		previous = level
		state.model:PivotTo(state.model:GetPivot() + Vector3.new(0, dy, 0))
		local character = player.Character
		if character and character.Parent ~= nil then
			character:PivotTo(character:GetPivot() + Vector3.new(0, dy, 0))
			local _, root = characterOf(player)
			if root then root.AssemblyLinearVelocity = Vector3.zero end
		end
		if companion and companion.Parent ~= nil then
			companion:PivotTo(companion:GetPivot() + Vector3.new(0, dy, 0))
		end
		task.wait(stepTime)
	end

	if companion and companion.Parent ~= nil then
		FigureFX.idleBob(companion, { height = MapConfig.IDLE_BOB_HEIGHT, rate = MapConfig.IDLE_BOB_RATE })
	end
	EpilogSummitBuilder.destroy(player)
	return true
end

-- Zaehlt Teile (fuer `parts` und `epilog scan`): Teile im Gipfel.
function EpilogSummitBuilder.countParts(player: Player): number
	local state = _state[player]
	if not state then return 0 end
	local n = 0
	for _, d in state.model:GetDescendants() do
		if d:IsA("BasePart") then n += 1 end
	end
	return n
end

return EpilogSummitBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">EpilogTerminalBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- EpilogTerminalBuilder.luau
-- ServerScriptService/Util/MapBuild/EpilogTerminalBuilder.luau
--
-- Einzige Zustaendigkeit (Prompt 4 von 7, Final-Epilog):
--   - Das Start-Terminal mit dem grossen roten Knopf auf die Insel bauen (21 Teile,
--     deklarativ aus Modules/EpilogTerminalLayout), seinen Zustand als Attribut
--     `EpilogTerminalState` fuehren (idle, ready, armed, fired, done) und den
--     ProximityPrompt "Freigabe erteilen" (Halten 1,2 s) serverseitig bedienen.
--
-- Wie TerminalBuilder (Tower-Terminal): Der Server baut das Modell EINMAL und
-- schreibt nur Attribute. Bildschirmtext, Lampen, Klappe, Knopf-Bewegung und Glow
-- macht der Client (Controllers/EpilogTerminalController) aus dem Attribut. Das
-- alte Tower-Terminal wird nicht beruehrt.
--
-- Zustaende:
--   idle   Ruhe: Schirm "FREIGABE ERFORDERLICH", Lampen rot blinkend, Klappe zu
--   ready  Spieler < nearDistance: Lampen gelb, "BEREIT", Klappe ein Stueck offen
--   armed  Spieler haelt den Prompt: Klappe ganz auf (Loslassen -> zurueck)
--   fired  Halten abgeschlossen: Knopf gesenkt, Lampen gruen, "FREIGABE ERTEILT"
--   done   Prompt 6: "WELT 2 OFFEN", dauerhaft gruen
-- Dieses Modul speichert NICHTS. Was bei `fired` passiert, entscheidet der
-- Startwunsch-Handler (EpilogService.onLaunchRequested, Prompt 6).
--
-- Anti-Exploit: Der Prompt ist nur fuer den Plot-Besitzer, nur wenn `accessCheck`
-- (EpilogService: Flag an, state pending/seen) zustimmt und der Spieler lebt.
--
-- Cleanup: destroy/teardown zerstoert Modell, trennt Verbindungen, bricht den
-- Pruef-Faden ab. Mit der Insel (EpilogIslandBuilder.onTeardown) verschwindet auch
-- das Terminal. Dieses Modul kennt MapService NICHT.

local Players             = game:GetService("Players")
local Lighting            = game:GetService("Lighting")
local CollectionService   = game:GetService("CollectionService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local EpilogConfig = require(ReplicatedStorage.Config.EpilogConfig)
local Layout       = require(ReplicatedStorage.Modules.EpilogTerminalLayout)
local Loc          = require(ReplicatedStorage.Localization.Loc)
local WorldText    = require(ReplicatedStorage.Localization.WorldText)

local MapParts            = require(script.Parent.MapParts)
local EpilogMeshes         = require(script.Parent.EpilogMeshes)
local EpilogIslandBuilder = require(script.Parent.EpilogIslandBuilder)

local EpilogTerminalBuilder = {}

local T  = EpilogConfig.TERMINAL
local ST = T.STATE

type State = {
	owner  : Player,
	plot   : Model,
	folder : Folder,
	model  : Model,
	prompt : ProximityPrompt,
	knob   : BasePart,
	conns  : { RBXScriptConnection },
	thread : thread?,
	state  : string,
}

local _state: { [Player]: State } = {}
-- Zustand, der einen Neuaufbau des Plots (Rebirth) ueberlebt. destroy() loescht ihn.
local _memo: { [Player]: string } = {}
local _accessCheck: ((Player) -> boolean)? = nil
local _launchHandler: ((Player) -> ())? = nil

local VALID: { [string]: boolean } = {}
for _, v in ST do VALID[v] = true end

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function ownerOfPlot(plot: Model): Player?
	local id = plot:GetAttribute("PlotOwner")
	if typeof(id) ~= "number" then return nil end
	return Players:GetPlayerByUserId(id)
end

local function isNight(): boolean
	local t = Lighting.ClockTime
	return t < T.dayFrom or t >= T.dayTo
end

local function particleTexture(): string
	local A = EpilogConfig.ASSETS
	return if A.cloudTex ~= "" then A.cloudTex else A.particleFallback
end

local function localCFrame(piece: Layout.Piece): CFrame
	local cf = CFrame.new(piece.pos[1], piece.pos[2], piece.pos[3])
		* CFrame.Angles(piece.rot[1], piece.rot[2], piece.rot[3])
	if piece.kind == "Disc" then
		cf = cf * CFrame.Angles(0, 0, math.rad(90))   -- Achse = lokales Y
	end
	return cf
end

-- Teile mit Albedo-Textur (gebuerstetes Grau): Farbe wird dann zum Tint der Textur
local TEXTURED: { [string]: boolean } = {
	Epilog_Terminal_Sockel = true, Epilog_Terminal_Korpus = true, Epilog_Terminal_Konsole = true,
}
local TEXTURE_GREY = 0.6   -- mittlere Helligkeit der Albedo-Textur

-- Mesh-Teil aus der Vorlage (jedes Mesh ist im Teil-Koordinatensystem gebaut, Scheiben
-- mit Achse X): gleiche Lage/Ausrichtung wie das Primitiv, daher bleibt der Client unveraendert.
local function meshFor(piece: Layout.Piece, size: Vector3, cf: CFrame): MeshPart?
	if piece.hidden then return nil end
	local mesh = EpilogMeshes.meshPart(EpilogConfig.ASSETS.terminalTemplate, piece.name)
	if not mesh then return nil end
	EpilogMeshes.setup(mesh, piece.name, size, cf)
	mesh.Material = (Enum.Material :: any)[piece.material]
	local color = T.colors[piece.colorKey]
	if TEXTURED[piece.name] then
		local albedo = EpilogConfig.ASSETS.terminalAlbedo
		if albedo ~= "" then mesh.TextureID = albedo end
		if mesh.TextureID ~= "" then
			color = Color3.new(math.min(1, color.R / TEXTURE_GREY), math.min(1, color.G / TEXTURE_GREY),
				math.min(1, color.B / TEXTURE_GREY))
		end
	end
	mesh.Color = color
	if piece.collide then mesh.CollisionFidelity = Enum.CollisionFidelity.Box end
	return mesh
end

local function makePart(piece: Layout.Piece, mount: CFrame): BasePart
	local size: Vector3
	if piece.kind == "Disc" then
		size = Vector3.new(piece.size[1], piece.size[2], piece.size[2])
	elseif piece.kind == "Ball" then
		size = Vector3.new(piece.size[1], piece.size[1], piece.size[1])
	else
		size = Vector3.new(piece.size[1], piece.size[2], piece.size[3])
	end
	local cf = mount * localCFrame(piece)
	local part: BasePart? = meshFor(piece, size, cf)
	if not part then
		local prim = MapParts.newPart(piece.name, size, cf, T.colors[piece.colorKey],
			(Enum.Material :: any)[piece.material])
		if piece.kind == "Disc" then prim.Shape = Enum.PartType.Cylinder end
		if piece.kind == "Ball" then prim.Shape = Enum.PartType.Ball end
		part = prim
	end
	assert(part, "Terminalteil")
	part.CanCollide   = piece.collide
	part.CanTouch     = false
	part.CastShadow   = false
	part.Transparency = piece.transparency
	if not piece.collide and not piece.hidden then part.CanQuery = false end
	if piece.hidden then part.CanQuery = true end   -- der Prompt braucht die Flaeche
	return part
end

local function characterRoot(player: Player): (BasePart?, Humanoid?)
	local character = player.Character
	if not character then return nil, nil end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") and humanoid then return root, humanoid end
	return nil, nil
end

local function accessOk(player: Player): boolean
	local check = _accessCheck
	if not check then return false end   -- ohne Pruefung (EpilogService) ist der Prompt aus
	local ok, result = pcall(check, player)
	if not (ok and result == true) then return false end
	local root, humanoid = characterRoot(player)
	return root ~= nil and humanoid ~= nil and humanoid.Health > 0
end

local function promptWanted(state: State): boolean
	local s = state.state
	return (s == ST.IDLE or s == ST.READY or s == ST.ARMED) and accessOk(state.owner)
end

--------------------------------------------------------------------------------
-- Auskunft / Einstellungen
--------------------------------------------------------------------------------

-- Pruefung, ob der Spieler den Knopf bedienen darf (EpilogService).
function EpilogTerminalBuilder.setAccessCheck(check: (Player) -> boolean)
	_accessCheck = check
end

-- Wird gerufen, wenn der Prompt voll gehalten wurde (EpilogService.onLaunchRequested).
function EpilogTerminalBuilder.setLaunchHandler(handler: (Player) -> ())
	_launchHandler = handler
end

function EpilogTerminalBuilder.exists(player: Player): boolean
	local s = _state[player]
	return s ~= nil and s.model.Parent ~= nil
end

function EpilogTerminalBuilder.getState(player: Player): string?
	local s = _state[player]
	return if s then s.state else nil
end

function EpilogTerminalBuilder.countParts(player: Player): number
	local s = _state[player]
	if not s then return 0 end
	local n = 0
	for _, d in s.model:GetDescendants() do
		if d:IsA("BasePart") then n += 1 end
	end
	return n
end

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

-- Setzt den Zustand (Attribut am Modell; der Client animiert). false bei
-- unbekanntem Zustand oder ohne Terminal. Speichert nichts.
function EpilogTerminalBuilder.setState(player: Player, newState: string): boolean
	local s = _state[player]
	if not s or s.model.Parent == nil or not VALID[newState] then return false end
	s.state = newState
	_memo[player] = newState
	s.model:SetAttribute(T.ATTRIBUTE, newState)
	s.prompt.Enabled = promptWanted(s)
	return true
end

-- Prompt 6: Countdown-Zahl (3, 2, 1; 0 = keine) als Attribut `EpilogCountdown`. Der Client
-- zeigt sie auf dem Bildschirm und schaltet die Lampen von Gelb auf Gruen. Speichert nichts.
function EpilogTerminalBuilder.setCountdown(player: Player, number: number): boolean
	local s = _state[player]
	if not s or s.model.Parent == nil then return false end
	s.model:SetAttribute(T.COUNTDOWN_ATTRIBUTE, math.max(0, math.floor(number)))
	return true
end

--------------------------------------------------------------------------------
-- Zerstoeren
--------------------------------------------------------------------------------

-- Wie destroy, aber der Zustand bleibt gemerkt (Neuaufbau des Plots).
local function teardown(player: Player)
	local s = _state[player]
	if not s then return end
	_state[player] = nil
	if s.thread then pcall(task.cancel, s.thread) end
	for _, conn in s.conns do conn:Disconnect() end
	if s.model.Parent ~= nil then s.model:Destroy() end
	if s.folder.Parent ~= nil and #s.folder:GetChildren() == 0 then s.folder:Destroy() end
end

function EpilogTerminalBuilder.destroy(player: Player)
	teardown(player)
	_memo[player] = nil
end

--------------------------------------------------------------------------------
-- Bauen
--------------------------------------------------------------------------------

-- Baut das Terminal auf den Mount der Insel (Insel muss stehen). `startState`
-- (Standard idle). Einzeiler: EpilogTerminalBuilder.build(plot)
function EpilogTerminalBuilder.build(plot: Model, startState: string?): Model?
	local owner = ownerOfPlot(plot)
	if not owner then return nil end
	if not EpilogIslandBuilder.exists(owner) then return nil end
	local mount = EpilogIslandBuilder.getTerminalMount(plot)
	if not mount then return nil end
	local folder = plot:FindFirstChild("Epilog")
	if not (folder and folder:IsA("Folder")) then return nil end
	teardown(owner)

	local layout = Layout.compute()
	local model = Instance.new("Model")
	model.Name = "Terminal"

	local parts: { [string]: BasePart } = {}
	for _, piece in layout.pieces do
		local part = makePart(piece, mount)
		part.Parent = model
		parts[piece.name] = part
	end
	local knob = parts["Epilog_Terminal_Knopf"]
	local korpus = parts["Epilog_Terminal_Korpus"]
	local trigger = parts["Epilog_Terminal_Ausloeser"]
	local pivot = parts["Epilog_Terminal_Sockel"]

	-- Scharnier der Klappe (Drehachse lokale X-Achse der Konsole): der Client dreht
	-- die Klappe darum.
	local hinge = Instance.new("Attachment")
	hinge.Name = "Scharnier"
	hinge.WorldCFrame = mount * CFrame.new(layout.hinge.pos[1], layout.hinge.pos[2], layout.hinge.pos[3])
		* CFrame.Angles(layout.hinge.rx, 0, 0)
	hinge.Parent = korpus

	-- Roter Glow-Kegel nach oben (ein Licht), nachts deutlicher
	local light = Instance.new("SpotLight")
	light.Name       = "Knopflicht"
	light.Face       = Enum.NormalId.Right       -- Zylinderachse = Konsolen-Normale
	light.Color      = T.colors.red
	light.Angle      = T.lightAngle
	light.Range      = T.lightRange
	light.Brightness = if isNight() then T.lightBrightnessNight else T.lightBrightnessDay
	light.Shadows    = false
	light.Parent     = knob

	-- Ein Emitter (aus bis fired/done; der Client schaltet ihn)
	local att = Instance.new("Attachment")
	att.Name = "Funken"
	att.Parent = knob
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name          = "Funken"
	emitter.Enabled       = false
	emitter.Texture       = particleTexture()
	emitter.Color         = ColorSequence.new(T.colors.gold)
	emitter.LightEmission = 0.8
	emitter.Size          = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency  = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime      = NumberRange.new(0.8, 1.4)
	emitter.Speed         = NumberRange.new(3, 6)
	emitter.SpreadAngle   = Vector2.new(25, 25)
	emitter.EmissionDirection = Enum.NormalId.Right
	emitter.Rate          = 10
	emitter.Parent        = att

	-- Prompt: serverseitig, Halten 1,2 s, Distanz 8, ohne Sichtlinie
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = "Freigabe"
	prompt.HoldDuration          = T.prompt.hold
	prompt.MaxActivationDistance = T.prompt.distance
	prompt.RequiresLineOfSight   = false
	prompt.ClickablePrompt       = true
	prompt.Exclusivity           = Enum.ProximityPromptExclusivity.OnePerButton
	prompt.KeyboardKeyCode       = Enum.KeyCode.E
	prompt.Enabled               = false
	WorldText.set(prompt, Loc.msg("epilog.terminal.prompt_action"), "ActionText")
	WorldText.set(prompt, Loc.msg("epilog.terminal.prompt_object"), "ObjectText")
	prompt.Parent = trigger

	model.PrimaryPart = pivot
	local initial = startState or _memo[owner] or ST.IDLE
	if not VALID[initial] then initial = ST.IDLE end
	model:SetAttribute(T.ATTRIBUTE, initial)
	model:SetAttribute("PlotOwner", owner.UserId)
	CollectionService:AddTag(model, T.TAG)
	model.Parent = folder

	local state: State = {
		owner = owner, plot = plot, folder = folder, model = model, prompt = prompt, knob = knob,
		conns = {}, thread = nil, state = initial,
	}
	_state[owner] = state
	_memo[owner] = initial
	prompt.Enabled = promptWanted(state)

	-- Halten beginnt: Klappe auf. Loslassen vor Ablauf: zurueck.
	table.insert(state.conns, prompt.PromptButtonHoldBegan:Connect(function(who: Player)
		if who ~= owner or _state[owner] ~= state then return end
		if not promptWanted(state) then return end
		if state.state == ST.IDLE or state.state == ST.READY then
			EpilogTerminalBuilder.setState(owner, ST.ARMED)
		end
	end))
	table.insert(state.conns, prompt.PromptButtonHoldEnded:Connect(function(who: Player)
		if who ~= owner or _state[owner] ~= state then return end
		if state.state == ST.ARMED then   -- nach erfolgreichem Halten steht der Zustand schon auf fired
			EpilogTerminalBuilder.setState(owner, ST.READY)
		end
	end))
	table.insert(state.conns, prompt.Triggered:Connect(function(who: Player)
		if who ~= owner or _state[owner] ~= state then return end
		if not promptWanted(state) then return end
		local handler = _launchHandler
		if handler then
			local ok, err = pcall(handler, owner)
			if not ok then warn("[EpilogTerminalBuilder] Startwunsch fehlgeschlagen:", err) end
		end
	end))

	-- Annaeherung + Prompt-Freigabe: zweimal pro Sekunde, kein Frame-Loop.
	state.thread = task.spawn(function()
		while _state[owner] == state and model.Parent ~= nil do
			task.wait(T.checkSeconds)
			if _state[owner] ~= state then return end
			prompt.Enabled = promptWanted(state)
			local root = characterRoot(owner)
			if root and accessOk(owner) then
				local dist = (root.Position - knob.Position).Magnitude
				if state.state == ST.IDLE and dist < T.nearDistance then
					EpilogTerminalBuilder.setState(owner, ST.READY)
				elseif state.state == ST.READY and dist > T.farDistance then
					EpilogTerminalBuilder.setState(owner, ST.IDLE)
				end
			elseif state.state == ST.READY or state.state == ST.ARMED then
				EpilogTerminalBuilder.setState(owner, ST.IDLE)   -- tot, weg oder nicht mehr erlaubt
			end
		end
	end)

	-- Verschwindet die Insel, geht das Terminal mit (der Zustand bleibt fuer den Neuaufbau gemerkt).
	EpilogIslandBuilder.onTeardown(owner, function()
		if _state[owner] == state then teardown(owner) end
	end)
	return model
end

-- Nach einem Neuaufbau des Plots (Rebirth): Terminal im gemerkten Zustand wieder bauen.
function EpilogTerminalBuilder.restoreAfterRebuild(plot: Model)
	local owner = ownerOfPlot(plot)
	if not owner then return end
	local memo = _memo[owner]
	if not memo then return end
	EpilogTerminalBuilder.build(plot, memo)
end

return EpilogTerminalBuilder
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">PlayerMigration</string><ProtectedString name="Source"><![CDATA[--!strict
-- PlayerMigration.luau
-- ServerScriptService/Util/PlayerMigration.luau
--
-- Einzige Zustaendigkeit:
--   - Einen geladenen Spielstand beliebiger frueherer Version auf die aktuelle
--     Struktur (Types.PlayerData) bringen
--
-- Gehoert fachlich zu PlayerService und wird nur von dort aufgerufen. Es ist
-- ein eigenes Modul, weil es eine reine Funktion ist (Tabelle rein, Tabelle
-- raus, kein DataStore, kein Spieler-Objekt) und deshalb ohne Studio getestet
-- werden kann: tools/luau-tests/migration.test.lua schickt alte Spielstaende
-- hindurch und prueft das Ergebnis gegen Types.createDefaultPlayerData.
--
-- Regel fuer neue Felder: jedes Feld, das in Types.PlayerData dazukommt, wird
-- hier nachgeruestet (oder ausdruecklich begruendet, warum nil reicht). Eine
-- Migration, die Werte UMRECHNET statt Fehlendes anzulegen, haengt an
-- data.version und darf nur einmal laufen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local PromotionConfig  = require(ReplicatedStorage.Config.PromotionConfig)
local CharmConfig      = require(ReplicatedStorage.Config.CharmConfig)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggTree          = require(ReplicatedStorage.Modules.EggTree)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local FeatureFlags     = require(ReplicatedStorage.Config.FeatureFlags)
local HoneyPondMode    = require(ReplicatedStorage.Modules.HoneyPondMode)
local EpilogConfig     = require(ReplicatedStorage.Config.EpilogConfig)   -- v18
local EpilogRules      = require(ReplicatedStorage.Modules.EpilogRules)   -- v18

local PlayerMigration = {}

-- Fehlende Felder aus Default auffuellen (einfache Migration fuer neue Felder).
-- Muss jedes Feld abdecken das seit dem ersten Release in Types.luau
-- dazugekommen ist — sonst crasht alter Save-Stand beim ersten Zugriff.
function PlayerMigration.applyDefaults(data: Types.PlayerData): Types.PlayerData
	local default = Types.createDefaultPlayerData()

	-- Neue Top-Level-Felder
	if data.gummies      == nil then data.gummies      = default.gummies      end
	if data.goldGummies  == nil then data.goldGummies  = default.goldGummies  end
	if data.rebirthCount == nil then data.rebirthCount = default.rebirthCount end
	if data.rebirthMult  == nil then data.rebirthMult  = default.rebirthMult  end
	if data.rank         == nil then data.rank         = default.rank         end
	if data.island       == nil then data.island       = default.island       end
	if data.stats        == nil then data.stats        = default.stats        end
	if data.createdAt    == nil then data.createdAt    = default.createdAt    end
	if data.lastSeenAt   == nil then data.lastSeenAt   = default.lastSeenAt   end

	-- Neue Stats-Felder (dynamischer Key → bewusst ueber any, sonst meckert --!strict)
	local stats     = data.stats    :: any
	local defStats  = default.stats :: any

	-- HBB Paket 10: Sitzungszaehler. Ein Konto, das schon aelter als 10 min
	-- ist, war mindestens einmal da — es zaehlt als 1, damit Veteranen den
	-- Shop schon bei diesem Join (= Sitzung 2, PlayerService zaehlt hoch) sehen.
	if stats.sessions == nil then
		stats.sessions = if os.time() - (data.createdAt or os.time()) >= 600 then 1 else 0
	end
	for key, value in defStats do
		if stats[key] == nil then
			stats[key] = value
		end
	end

	-- highestTowerFloor gehoerte zu einem Tower-Modus, den es nicht gibt. Das
	-- Feld wird entfernt, damit es nicht bei jedem Speichern wieder im
	-- DataStore landet. Am Feld erkennbar und deshalb ohne Versions-Sprung
	-- wiederholbar; ein Wert geht nicht verloren, er war immer 0.
	stats.highestTowerFloor = nil

	-- Neue Island-Felder
	local island = data.island
	if island.baerchis  == nil then island.baerchis  = {} end
	if island.eggStock  == nil then island.eggStock  = { BasicEgg = 3 } end

	-- language: kein Nachruesten noetig — nil bedeutet "automatisch" (die
	-- Roblox-Sprache des Clients), und genau das soll ein alter Spielstand
	-- bekommen. Kein Versions-Sprung. Siehe SettingsService.
	--
	-- v6: equippedUid. Kein Nachruesten noetig — ein fehlendes Feld liest
	-- sich in Lua ohnehin als nil, und IslandService.autoEquipIfNone laeuft
	-- bei jedem Join (onDataLoaded) und ruestet automatisch den ersten
	-- vorhandenen Baerchi aus, falls noch/wieder keiner steht.

	-- ============================================================
	-- ============================================================
	-- v13: QUESTS + INDEX
	-- ============================================================
	-- Neue Felder: discovered, quests, stats.totalHatched (das Stats-Feld legt
	-- die Schleife oben schon mit 0 an). Fuer Spielstaende VOR v13 wird
	-- discovered aus den vorhandenen Baerchis gesaeet und totalHatched auf
	-- deren Anzahl gesetzt, damit Veteranen nicht bei null anfangen.
	if data.discovered == nil then
		data.discovered = {}
		for _, baerchi in data.island.baerchis do
			data.discovered[baerchi.configId] = true
		end
	end

	if (data.version or 0) < 13 then
		local owned = 0
		for _ in data.island.baerchis do owned += 1 end
		data.stats.totalHatched = math.max(data.stats.totalHatched or 0, owned)
	end

	-- HBB Paket 3: uiSeen. Leer nachruesten; UiStateService markiert beim
	-- ersten Laden eines Stands mit Fortschritt alles Sichtbare als gesehen
	-- (keine Badge-Flut fuer Veteranen). Kein Versions-Sprung.
	if data.uiSeen == nil then
		data.uiSeen = {}
	end

	-- HBB Paket 10: Shop-Teil. Leer nachruesten, kaputte Felder reparieren.
	local shop = (data :: any).shop
	if typeof(shop) ~= "table" then
		(data :: any).shop = default.shop
	else
		if typeof(shop.freeGrabDay) ~= "number" then shop.freeGrabDay = -1 end
		if typeof(shop.receipts) ~= "table" then shop.receipts = {} end
	end

	if data.quests == nil then
		data.quests = default.quests
	end

	-- ============================================================
	-- v14: EI-BAUM (Mega Egg Tree)
	-- ============================================================
	-- Neues Top-Level-Feld eggTree (ausserhalb der Insel, damit ein Rebirth
	-- es nicht loescht). Bestandsspieler bekommen die Knoten der Eier frei,
	-- die sie schon im Lager haben oder die auf ihrem Plot liegen — wer ein
	-- Goldenes Ei besitzt, soll es nicht ploetzlich "gesperrt" sehen. Die
	-- Rebirth-Knoten (Ascensions-Pfad) schaltet evaluate unten frei.
	--
	-- Gefahrlos wiederholbar: sanitize ergaenzt nur Fehlendes, und die
	-- Lager-Freischaltung laeuft nur fuer Spielstaende vor v14.
	local hadTree = data.eggTree ~= nil
	data.eggTree = EggTree.sanitize(data.eggTree)
	if not hadTree and (data.version or 0) < 14 then
		for eggType, count in island.eggStock do
			if (count or 0) > 0 and EggConfig.data[eggType] then
				data.eggTree.unlocked[eggType] = true
			end
		end
		for _, egg in (island.laidEggs or {}) do
			if EggConfig.data[egg.eggType] then
				data.eggTree.unlocked[egg.eggType] = true
			end
		end
	end
	-- Unbekannte Ei-Typen im Lager (alte Config) werden zum Basis-Ei.
	local stockAny = island.eggStock :: any
	for eggType, count in stockAny do
		if not EggConfig.data[eggType] then
			stockAny.BasicEgg = (stockAny.BasicEgg or 0) + (tonumber(count) or 0)
			stockAny[eggType] = nil
		end
	end
	EggTree.evaluate(data)

	-- v12: BRUT-SLOTS ENTFALLEN (Eier werden sofort geoeffnet)
	-- ============================================================
	-- Alte Spielstaende koennen noch laufende oder fertige Bruten in
	-- island.hatchingEggs haben. Die gehen NICHT verloren: jedes Ei wandert
	-- als ungeoeffnetes Ei zurueck ins Lager, danach wird das Feld entfernt.
	-- Ein Ei-Typ, den es nicht mehr gibt, wird zum Basis-Ei (dieselbe Regel,
	-- die frueher beim Abholen galt).
	--
	-- Gefahrlos wiederholbar: beim zweiten Durchlauf ist das Feld schon nil.
	-- Ueber `any`, weil Types.IslandData das Feld seit v12 nicht mehr kennt.
	local legacyIsland = island :: any
	if legacyIsland.hatchingEggs ~= nil then
		if typeof(legacyIsland.hatchingEggs) == "table" then
			for _, egg in legacyIsland.hatchingEggs do
				local eggType = if typeof(egg) == "table" then egg.eggType else nil
				if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then
					eggType = "BasicEgg"
				end
				local stock = island.eggStock :: any
				stock[eggType] = (stock[eggType] or 0) + 1
			end
		end
		legacyIsland.hatchingEggs = nil
	end

	-- v12: pitProgress muss nur gueltig sein, wenn es da ist (nil = kein
	-- gespeicherter Lauf). Ein halber Eintrag wird verworfen statt geraten.
	local progress = legacyIsland.pitProgress
	if progress ~= nil and (typeof(progress) ~= "table"
		or typeof(progress.pitLevel) ~= "number"
		or typeof(progress.reachedStage) ~= "number")
	then
		legacyIsland.pitProgress = nil
	end

	-- v10: gelegte Eier.
	--
	-- lastEggAt bewusst auf JETZT statt auf createdAt: ein Spielstand, der vor
	-- diesem Feature entstanden ist, hat keine Ei-Zeit — wuerde man hier
	-- createdAt einsetzen, bekaeme er beim ersten Join nach dem Update die
	-- Obergrenze auf einen Schlag geschenkt, fuer eine Zeit, in der es das
	-- Legen noch gar nicht gab.
	if island.laidEggs == nil then
		island.laidEggs = {}
	else
		-- Nur vollstaendige Eintraege behalten. Ein Ei ohne uid liesse sich nie
		-- einsammeln und laege bis in alle Ewigkeit auf dem Plot herum.
		local cleaned: { Types.LaidEgg } = {}
		for _, egg in island.laidEggs do
			if typeof(egg.uid) == "string" and #egg.uid > 0
				and typeof(egg.eggType) == "string"
				and typeof(egg.x) == "number"
				and typeof(egg.y) == "number"
				and typeof(egg.z) == "number"
			then
				table.insert(cleaned, egg)
			end
		end
		island.laidEggs = cleaned
	end

	if island.lastEggAt == nil then
		island.lastEggAt = os.time()
	end

	-- v15: Waben-Recycler. Feldweise nachgeruestet (wie lastEggAt), deshalb
	-- gefahrlos wiederholbar und ohne Versionssprung.
	local recycler = (island :: any).recycler
	if typeof(recycler) ~= "table" then
		(island :: any).recycler = { level = 1, queued = 0, progress = 0, lastProcessedAt = os.time() }
	else
		if typeof(recycler.level) ~= "number" then recycler.level = 1 end
		if typeof(recycler.queued) ~= "number" then recycler.queued = 0 end
		if typeof(recycler.progress) ~= "number" then recycler.progress = 0 end
		if typeof(recycler.lastProcessedAt) ~= "number" then recycler.lastProcessedAt = os.time() end
	end

	-- (v5 hatte hier die uid-Nachruestung der Brut-Eier — seit v12 gibt es
	-- keine Brut-Eier mehr, siehe oben.)

	-- v4: die Gebaeude sind komplett ausgetauscht. Frueher gab es Hatchery,
	-- GummyFarm, Recycler (und davor FusionLab) mit je eigener Funktion —
	-- jetzt reine Honig-Produzenten. Alte Eintraege werden entfernt und
	-- die neuen angelegt; das Level laesst sich nicht sinnvoll uebertragen,
	-- weil die Gebaeude etwas voellig anderes tun.
	--
	-- (Honigtopf und Honig-Presse bleiben hier noch stehen: die v7- und die
	-- v15-Migration weiter unten brauchen ihre Level. Entfernt werden sie erst
	-- in der v15-Zusammenlegung.)
	local OBSOLETE_BUILDINGS = { "Hatchery", "GummyFarm", "Recycler", "FusionLab" }

	if island.buildings == nil then
		island.buildings = default.island.buildings
	else
		local buildings = island.buildings :: any

		for _, obsolete in OBSOLETE_BUILDINGS do
			buildings[obsolete] = nil
		end

		for buildingId, building in default.island.buildings do
			local existing = buildings[buildingId]
			if existing == nil then
				buildings[buildingId] = {
					id             = building.id,
					level          = building.level,
					honey          = building.honey,
					lastProducedAt = building.lastProducedAt,
				}
			else
				-- v4: Honig-Felder auf bereits vorhandenen Gebaeuden nachruesten
				if existing.honey == nil then
					existing.honey = 0
				end
				if existing.lastProducedAt == nil then
					existing.lastProducedAt = os.time()
				end
			end
		end
	end

	-- v7: die drei Gebaeude haben eigene Rollen bekommen (siehe
	-- Config/BuildingBehavior). Die XP pro Honig haengen seitdem allein am Level
	-- der Honig-Presse — vorher am Level des Gebaeudes, aus dem der Honig kam,
	-- also an allen dreien.
	--
	-- Ohne Ausgleich wuerde ein laufender Spielstand dabei XP VERLIEREN: wer
	-- seinen Bienenstock auf Level 5 stehen hat und die Presse auf Level 1,
	-- bekaeme ploetzlich 30 statt 135 XP pro Honig. Deshalb erbt die Presse
	-- einmalig das hoechste Level, das dieser Spielstand bei irgendeinem
	-- Gebaeude erreicht hatte. Danach ist die XP-Ausbeute mindestens so gut wie
	-- vorher, und niemand muss etwas nachkaufen.
	--
	-- DAS IST DIE ERSTE MIGRATION, DIE AN DER VERSIONSNUMMER HAENGEN MUSS
	-- (siehe den Kommentar bei data.version am Ende dieser Funktion): sie
	-- rechnet einen Wert um, statt ein fehlendes Feld anzulegen. Liefe sie bei
	-- jedem Join erneut, wuerde die Presse jedes Mal wieder auf das Maximum
	-- hochgezogen — der Spieler koennte die anderen beiden nie ueberholen.
	if (data.version or 0) < 7 then
		local press = (island.buildings :: any).HoneyPress

		if press then
			local highest = press.level or 1

			for _, building in island.buildings do
				highest = math.max(highest, building.level or 1)
			end

			press.level = highest
		end
	end

	-- ============================================================
	-- v15: GEBAEUDE OPTION B — Honigtopf + Honig-Presse -> Honig-Veredler
	-- ============================================================
	-- Niemand verliert etwas: der Veredler bekommt das HOEHERE der beiden alten
	-- Level (er kann beides: XP wie die Presse, Heilung wie der Topf), und der
	-- eingelagerte Honig beider wird zusammengelegt (gedeckelt auf sein Lager).
	-- Haengt an der Version, weil es UMRECHNET; danach sind Topf und Presse weg.
	-- Ueber `any`, weil Types.BuildingId die alten Ids nicht mehr kennt.
	do
		local buildings = island.buildings :: any
		if (data.version or 0) < 15 then
			local pot     = buildings.HoneyPot
			local press   = buildings.HoneyPress
			local refiner = buildings.HoneyRefiner
			-- Mit HONEY_POND_V2 legt der Standard keinen Veredler mehr an; fuer
			-- die Zusammenlegung (und danach den Teich) wird er hier angelegt.
			if refiner == nil and (pot or press) then
				refiner = { id = "HoneyRefiner", level = 1, honey = 0, lastProducedAt = os.time() }
				buildings.HoneyRefiner = refiner
			end
			if refiner and (pot or press) then
				local level = math.max(refiner.level or 1,
					if pot then pot.level or 1 else 1,
					if press then press.level or 1 else 1)
				refiner.level = math.clamp(level, 1, EconomyConfig.MAX_BUILDING_LEVEL)

				local honey = (if pot then pot.honey or 0 else 0) + (if press then press.honey or 0 else 0)
				refiner.honey = math.clamp(honey, 0, BuildingBehavior.getCapacity("HoneyRefiner", refiner.level))
			end
		end

		-- Honig-Teich (HONEY_POND_V2) bzw. zurueck zu Stock + Veredler. MUSS vor
		-- dem Aufraeumen unten laufen: sonst waeren die gerade nicht geltenden
		-- Gebaeude schon geloescht statt im Ruhestand (island.retiredBuildings).
		HoneyPondMode.apply(island, FeatureFlags.isOn("HONEY_POND_V2"), os.time())
		local pond = buildings[HoneyPondMode.POND]
		if pond then
			pond.level = EconomyConfig.clampBuildingLevel(pond.level or 1)
			pond.honey = math.clamp(pond.honey or 0, 0, BuildingBehavior.getCapacity("HoneyPond", pond.level))
		end

		-- Alles, was es nicht (mehr) gibt, verschwindet — auch Topf und Presse
		-- nach der Zusammenlegung. Am Feld erkennbar, deshalb wiederholbar.
		for buildingId in buildings do
			if default.island.buildings[buildingId] == nil then
				buildings[buildingId] = nil
			end
		end

		-- Level auf den gueltigen Bereich (1-60) klemmen.
		for _, building in buildings do
			building.level = EconomyConfig.clampBuildingLevel(building.level or 1)
		end
	end

	-- ============================================================
	-- v15: TOWER STATT PIT-LEVEL
	-- ============================================================
	-- 1. Erstattung: die Summe der bezahlten PIT-Ausbaukosten landet in
	--    island.pitRefund. Die Migration fasst KEINE Waehrung an —
	--    TowerService zahlt den Betrag beim Join ueber EconomyService aus.
	-- 2. Rekord: der alte letzte Lauf (pitProgress) wird in die gleich starke
	--    Tower-Stage umgerechnet (TowerConfig.legacyPitToTower) und als
	--    permanenter Rekord eingetragen. Die zugehoerigen Meilensteine vergibt
	--    TowerService beim Join rueckwirkend.
	-- 3. pitLevel, pitProgress und stats.highestPitLevel werden entfernt.
	--
	-- Gilt reachedStage als "geschafft"? reachedStage ist die letzte Stage, in
	-- die der Baerchi eingetreten ist — gewonnen oder verloren. Bewusst
	-- grosszuegig als Rekord gezaehlt: niemand soll durch die Umstellung weniger
	-- haben (ANNAHME, im Bericht).
	data.towers = (data :: any).towers
	if typeof(data.towers) ~= "table" then
		data.towers = {
			records      = {},
			claimed      = {},
			highestTower = TowerConfig.FIRST_TOWER,
			selected     = TowerConfig.FIRST_TOWER,
		}
	end
	local towers = data.towers :: any
	if typeof(towers.records) ~= "table" then towers.records = {} end
	if typeof(towers.claimed) ~= "table" then towers.claimed = {} end

	if (data.version or 0) < 15 then
		local legacyLevel = tonumber(legacyIsland.pitLevel) or 1
		local refund = TowerConfig.legacyPitRefund(legacyLevel)
		legacyIsland.pitRefund = (tonumber(legacyIsland.pitRefund) or 0) + refund

		local legacyProgress = legacyIsland.pitProgress
		if typeof(legacyProgress) == "table" then
			local towerId, stage = TowerConfig.legacyPitToTower(
				tonumber(legacyProgress.pitLevel) or legacyLevel,
				tonumber(legacyProgress.reachedStage) or 0
			)
			if towerId and stage > 0 then
				towers.records[towerId] = math.max(tonumber(towers.records[towerId]) or 0, stage)
			end
		end
	end
	legacyIsland.pitLevel    = nil
	legacyIsland.pitProgress = nil
	stats.highestPitLevel    = nil

	-- Rekorde: nur gueltige Tower, nur Zahlen, nur bis zur Stage-Zahl.
	for towerId, record in towers.records do
		local def = TowerConfig.get(towerId)
		local value = tonumber(record)
		if not def or not value or value <= 0 then
			towers.records[towerId] = nil
		else
			towers.records[towerId] = math.clamp(math.floor(value), 0, def.stages)
		end
	end
	-- Meilensteine: Tabelle je Tower mit TEXT-Schluesseln (siehe Types).
	for towerId, claimed in towers.claimed do
		if not TowerConfig.get(towerId) or typeof(claimed) ~= "table" then
			towers.claimed[towerId] = nil
		else
			local cleaned: { [string]: boolean } = {}
			for stage, flag in claimed do
				if flag == true and tonumber(stage) then
					cleaned[tostring(math.floor(tonumber(stage) :: number))] = true
				end
			end
			towers.claimed[towerId] = cleaned
		end
	end
	-- Hoechster Tower = der hoechste mit Rekord (nie niedriger als gespeichert).
	local highest = if TowerConfig.isValidId(towers.highestTower) then towers.highestTower else TowerConfig.FIRST_TOWER
	for towerId in towers.records do
		if TowerConfig.getIndex(towerId) > TowerConfig.getIndex(highest) then
			highest = towerId
		end
	end
	towers.highestTower = highest

	-- v17 (08.10.): Freischaltung durch Schaffen. Bestandsschutz: was nach der
	-- ALTEN Regel (Deckel pro Rebirth) offen war oder einen Rekord hat, bleibt
	-- offen — niemand verliert Zugang. Nur einmal (Version), danach fuehrt
	-- TowerService die Tabelle. Unbekannte Eintraege fliegen raus.
	if typeof(towers.unlocked) ~= "table" then
		towers.unlocked = {}
	end
	local unlocked = towers.unlocked :: { [string]: boolean }
	for towerId, flag in unlocked do
		if flag ~= true or not TowerConfig.isValidId(towerId) then
			unlocked[towerId] = nil
		end
	end
	unlocked[TowerConfig.FIRST_TOWER] = true
	local rebirths = tonumber((data :: any).rebirthCount) or 0
	for _, def in TowerConfig.TOWERS do
		local wasOpen = (data.version or 0) < 17
			and TowerConfig.getLegacyStageCap(rebirths, def.id, towers.records) > 0
		-- 12.10.: mit TOWER_UNLOCK_PER_LIFE oeffnet nach v17 nur, was in DIESEM
		-- Leben geschafft ist (sonst oeffnete jeder Join die Tower nach einem
		-- Rebirth ueber die Rekorde wieder). Der einmalige Bestandsschutz
		-- v16 -> v17 zaehlt weiter die Rekorde.
		local progress = if (data.version or 0) < 17 then towers.records
			else TowerConfig.unlockRecords(towers, (data :: any).island)
		if wasOpen or TowerConfig.isUnlockedByClear(def.id, progress, nil) then
			unlocked[def.id] = true
		end
	end

	if not TowerConfig.isValidId(towers.selected) then
		towers.selected = TowerConfig.FIRST_TOWER
	end

	-- v18 (20.10., Final-Epilog): Endless ist offen, sobald Final 100 geschafft
	-- ist — hier abgesichert, egal wie der Spielstand dorthin kam. Dazu
	-- epilog/worlds: Bestandsspieler mit Final-Rekord >= 100 bekommen "pending"
	-- (Epilog nachholen). Nur wenn das Feld noch fehlt bzw. kaputt ist; ein
	-- gueltiger Stand (seen/launched) bleibt unangetastet.
	local finalDef = TowerConfig.get(EpilogConfig.TOWER_ID)
	local finalStages = if finalDef then finalDef.stages else math.huge
	local finalRecord = tonumber(towers.records[EpilogConfig.TOWER_ID]) or 0
	if finalRecord >= finalStages and TowerConfig.get("Endless") then
		unlocked.Endless = true
	end
	EpilogRules.migrate(data, finalRecord, finalStages, os.time())

	-- Fortsetzen pro Tower (ersetzt pitProgress) und Erstattungs-Feld.
	if typeof(legacyIsland.towerProgress) ~= "table" then
		legacyIsland.towerProgress = {}
	else
		for towerId, stage in legacyIsland.towerProgress do
			if not TowerConfig.get(towerId) or typeof(stage) ~= "number" or stage < 1 then
				legacyIsland.towerProgress[towerId] = nil
			end
		end
	end
	if typeof(legacyIsland.pitRefund) ~= "number" or legacyIsland.pitRefund < 0 then
		legacyIsland.pitRefund = 0
	end

	-- v15: Login-Bonus. Feldweise, wiederholbar.
	local daily = (data :: any).daily
	if typeof(daily) ~= "table" then
		(data :: any).daily = { lastClaimDay = 0, streak = 0 }
	else
		if typeof(daily.lastClaimDay) ~= "number" then daily.lastClaimDay = 0 end
		if typeof(daily.streak) ~= "number" then daily.streak = 0 end
	end

	-- v8: die zweite Fortschrittsachse (Promotion, Stat-Level, Charms).
	--
	-- Steht bewusst VOR der currentHp-Migration weiter unten: die rechnet mit
	-- CombatCalculator.getEffectiveStats, und das liest inzwischen genau diese
	-- Felder. Es kaeme auch ohne zurecht (es faengt fehlende Felder mit 0 ab),
	-- aber ein Spielstand soll die Migration nicht in halb fertigem Zustand
	-- durchlaufen — das ist die Art Reihenfolge-Abhaengigkeit, die man erst
	-- Monate spaeter bemerkt.
	--
	-- Erkennt fehlende Felder einzeln statt an der Versionsnummer und ist
	-- deshalb gefahrlos wiederholbar (dieselbe Konvention wie v2/v4/v5).
	for _, baerchi in island.baerchis do
		if baerchi.promotionLevel == nil then
			baerchi.promotionLevel = 0
		end

		if baerchi.statLevels == nil then
			baerchi.statLevels = PromotionConfig.newStatLevels()
		else
			-- Einzelne Stat-Schluessel nachruesten: `egg` kam als letzter dazu,
			-- und ein kuenftiger fuenfter Stat soll hier ebenfalls landen, ohne
			-- dass die ganze Tabelle ersetzt (und damit der Fortschritt
			-- geloescht) wird.
			local levels = baerchi.statLevels :: any
			for _, key in PromotionConfig.ALL_STATS do
				if levels[key] == nil then
					levels[key] = 0
				end
			end
		end

		if baerchi.charms == nil then
			baerchi.charms = {}
		else
			-- Nur gueltige Eintraege behalten. Ein Charm ohne Slot oder mit
			-- einem Stat-Typ, den es nicht mehr gibt (Pool-Aenderung), waere
			-- sonst ein stiller Rechenfehler in getEffectiveStats.
			local cleaned: { Types.Charm } = {}
			for _, charm in baerchi.charms do
				local slotOk = typeof(charm.slot) == "number"
					and charm.slot >= 1
					and charm.slot <= CharmConfig.SLOT_COUNT

				if slotOk and CharmConfig.getStatDef(charm.statId) then
					if charm.locked == nil then
						charm.locked = false
					end
					table.insert(cleaned, charm)
				end
			end
			table.sort(cleaned, function(a, b)
				return a.slot < b.slot
			end)
			baerchi.charms = cleaned
		end

		-- baseStatOverride bleibt absichtlich ungesetzt: nil heisst "Basiswerte
		-- kommen wie immer aus BaerchiConfig", und genau das gilt fuer jeden
		-- Baerchi, der vor dieser Version entstanden ist — auch fuer die
		-- damaligen Fusions-Ergebnisse (die haben ihren Vorteil ueber
		-- fusionBonus, nicht ueber die Basiswerte).

		-- ============================================================
		-- v9: DEF ist weg, PWR ist da, Inverted ist neu
		-- ============================================================
		-- Anders als alles darueber RAEUMT diese Migration etwas WEG. Ein
		-- statLevels.def oder ein baseStatOverride.def aus v8 zeigt auf einen
		-- Stat, den es nicht mehr gibt — stehen bleiben duerfte er trotzdem
		-- nicht: er landete beim naechsten Speichern wieder im DataStore und
		-- waere in einem Jahr ein Feld, das niemand mehr einordnen kann.
		--
		-- Der alte def-WERT wird NICHT in pwr uebertragen. Die beiden haben
		-- nichts miteinander zu tun (Schadensreduktion gegen Ability-Staerke),
		-- und ein Baerchi mit acht DEF-Stufen haette sonst still acht Stufen
		-- eines voellig anderen Stats geschenkt bekommen. pwr faengt bei 0 an.
		local statLevels = baerchi.statLevels :: any
		if statLevels.def ~= nil then
			statLevels.def = nil
		end
		if statLevels.pwr == nil then
			statLevels.pwr = 0
		end

		local override = baerchi.baseStatOverride :: any
		if override ~= nil then
			override.def = nil

			-- Ein Fusions-Ergebnis aus v8 hat einen gemischten Basiswert fuer
			-- hp/atk/spd, aber keinen fuer pwr (den Stat gab es noch nicht).
			-- nil ist hier genau richtig: getEffectiveStats faellt dann auf den
			-- pwr-Wert seines configId zurueck.
		end

		-- ============================================================
		-- v11: MUTATION-SYSTEM ERSETZT INVERTED
		-- ============================================================
		-- Das binaere isInverted-Feld weicht dem gestuften Mutation-System
		-- (siehe BaerchiConfig.MUTATIONS). Alte Spielstaende kannten hoechstens
		-- isInverted = true.
		--
		-- ANNAHME, nicht vom Projektinhaber vorgegeben: ein zuvor invertierter
		-- Baerchi wird auf die Mutation "Diamond" abgebildet (0.3% Wurf-Chance,
		-- damit nahe an der alten INVERTED_CHANCE von 0.5% — eine exakte
		-- Entsprechung gibt es nicht, weil das alte System nur eine einzige
		-- Stufe kannte). Wer eine andere Zuordnung will, ist das hier die
		-- einzige Stelle, die es aendern muss.
		--
		-- Erkennt das alte Feld selbst (ueber `any`, weil Types.Baerchi es seit
		-- v11 nicht mehr kennt) und ist deshalb gefahrlos wiederholbar: beim
		-- ersten Durchlauf wird das alte Feld entfernt, jeder weitere Durchlauf
		-- findet es dann bereits als nil vor und tut nichts mehr.
		local legacy = baerchi :: any
		if legacy.isInverted == true and baerchi.mutation == nil then
			baerchi.mutation = "Diamond"
		end
		legacy.isInverted = nil
	end

	-- v2: fusionBonus auf allen bestehenden Baerchis
	for _, baerchi in island.baerchis do
		if baerchi.fusionBonus == nil then
			baerchi.fusionBonus = 0
		end
		if baerchi.isFusionResult == nil then
			baerchi.isFusionResult = false
		end
	end

	-- v4: currentHp auf allen bestehenden Baerchis.
	-- Sie haben unter dem neuen System noch nicht gekaempft, starten also mit
	-- vollen HP. CombatCalculator wird dafuer bewusst hier requiret: es ist
	-- ein reines Rechenmodul ohne Zustand, und maxHp soll es nur EINE Formel
	-- im ganzen Projekt geben.
	for _, baerchi in island.baerchis do
		if baerchi.currentHp == nil then
			local baerchiDef = BaerchiConfig.getById(baerchi.configId)

			if baerchiDef then
				-- In pcall: getEffectiveStats rechnet mit level und
				-- fusionBonus. Fehlt einem uralten Eintrag eines davon, waere
				-- der Fehler sonst mitten im Join — und ein einziger kaputter
				-- Baerchi wuerde den ganzen Spielstand unbrauchbar machen.
				local ok, maxHp = pcall(function()
					return CombatCalculator.getEffectiveStats(baerchi, baerchiDef.baseStats).maxHp
				end)

				baerchi.currentHp = if ok then maxHp else 0
				if not ok then
					warn("[PlayerService] Kaputter Baerchi-Eintrag migriert:", baerchi.configId, maxHp)
				end
			else
				-- Unbekannter configId (Config-Eintrag entfernt): nicht raten,
				-- lieber erschoepft starten als mit erfundenen Werten.
				baerchi.currentHp = 0
			end
		end
	end

	-- ============================================================
	-- v16: SAMMEL-UPDATE 05.10. (eine gemeinsame Migration)
	-- ============================================================
	-- Nur Anlegen, keine Waehrung. Am Feld erkennbar und damit wiederholbar.
	--   island.stageBest   Rebirth nach Stage (Paket 4.1). Fuer Staende VOR
	--                      v16 aus towerProgress gesaeet (dort steht die
	--                      zuletzt BETRETENE Stage, geschafft ist eine
	--                      weniger) — wer kurz vor dem alten Gummy-Rebirth
	--                      stand, muss nicht bei null anfangen.
	--   island.incubator   Paket 8, Level 1, keine Eier
	--   indexClaimed       Paket 7, leer (rueckwirkend abholbar)
	--   specialClaimed     Paket 6.2, leer (SpecialMilestoneService zahlt
	--                      beim Join rueckwirkend aus)
	if typeof(island.stageBest) ~= "table" then
		local best: { [string]: number } = {}
		if (data.version or 0) < 16 and typeof(island.towerProgress) == "table" then
			for towerId, entered in island.towerProgress :: any do
				local n = (tonumber(entered) or 0) - 1
				if typeof(towerId) == "string" and n > 0 then
					best[towerId] = n
				end
			end
		end
		island.stageBest = best
	end
	local incubator = (island :: any).incubator
	if typeof(incubator) ~= "table" then
		island.incubator = { level = 1, slots = {}, breeders = {}, stored = {} }
	else
		if typeof(incubator.level) ~= "number" or incubator.level < 1 then incubator.level = 1 end
		if typeof(incubator.slots) ~= "table" then incubator.slots = {} end
		-- INCUBATOR_BREED: Liste der bruetenden Baerchis (fehlt in v16-Staenden)
		if typeof(incubator.breeders) ~= "table" then incubator.breeders = {} end
		-- 15.10. Solo-Inkubator: Lager fuer gebruetete Eier
		if typeof(incubator.stored) ~= "table" then incubator.stored = {} end
	end
	if typeof((data :: any).indexClaimed) ~= "table" then
		data.indexClaimed = {}
	end
	if typeof((data :: any).specialClaimed) ~= "table" then
		data.specialClaimed = {}
	end

	-- Zum Schluss die Versionsnummer nachziehen. Sie steuert heute keine der
	-- Migrationen oben — die pruefen alle einzeln auf fehlende Felder und
	-- laufen deshalb harmlos bei jedem Laden. Sie ist trotzdem wichtig: sobald
	-- eine kuenftige Migration NICHT mehr am Feld erkennbar ist (weil sie zum
	-- Beispiel Werte umrechnet statt welche anzulegen), ist diese Zahl der
	-- einzige Weg, sie nicht bei jedem Join erneut auszufuehren. Wer
	-- Types.createDefaultPlayerData um ein Feld erweitert, erhoeht sie dort.
	data.version = default.version
	return data
end

return PlayerMigration
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX53"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX47"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">EpilogController</string><ProtectedString name="Source"><![CDATA[--!strict
-- EpilogController.luau
-- StarterPlayerScripts/Controllers/EpilogController.luau
--
-- Prompt 5 von 7 (Final-Epilog): Kamerafahrt und Bildschirmrand-Effekte.
--
-- Einzige Zustaendigkeit: die ~34 s lange Fahrt nach dem Final-100-Sieg ABSPIELEN.
--   - Kamera: EpilogCameraPath.sample(t, ctx) in einer einzigen Kit.animate-Schleife
--   - Avatar: Humanoid:MoveTo-Lauf ueber die Bruecke (Tempo-Profil wie der Begleiter)
--   - Bildschirmrand: UI/EpilogOverlay (Flash, Vignette, Funken, Konfetti, Speed-Lines ...)
--   - Licht: Bloom, SunRays, ColorCorrection (Namen Epilog*)
--   - Skip: Halten 1 s ab Sekunde 12 (Ring unten rechts), der Server prueft nach
--   - Aufraeumen: Kamera, FOV, Licht, UI, Verbindungen, Steuerung — immer, auch bei Tod,
--     Respawn, Verlassen und Fehlern.
-- Der Server fuehrt den Zeitplan (Teleport, Insel, Bruecke, Begleiter, Wachhund); der
-- Client zeigt nur und laeuft. Entscheidungen ueber Zustand trifft allein der Server.
--
-- Wiederaufnahme (mode "restore"): keine fahrt, nur 1,2 s Flash; EpilogSeen, sobald der
-- Avatar am Terminal steht.

local Players           = game:GetService("Players")
local Workspace         = game:GetService("Workspace")
local Lighting          = game:GetService("Lighting")
local GuiService        = game:GetService("GuiService")
local UserInputService  = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes          = require(ReplicatedStorage.Network.Remotes)
local EpilogConfig     = require(ReplicatedStorage.Config.EpilogConfig)
local SoundConfig      = require(ReplicatedStorage.Config.SoundConfig)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local EpilogRoute      = require(ReplicatedStorage.Modules.EpilogRoute)
local EpilogCameraPath = require(ReplicatedStorage.Modules.EpilogCameraPath)

local Kit            = require(script.Parent.Parent.UI.Kit)
local Moment         = require(script.Parent.Parent.UI.Moment)
local EpilogOverlay  = require(script.Parent.Parent.UI.EpilogOverlay)
local EpilogFinaleFX = require(script.Parent.Parent.UI.EpilogFinaleFX)
local AudioController = require(script.Parent.AudioController)

local EpilogController = {}

local Q  = EpilogConfig.SEQUENCE
local FX = EpilogConfig.FX
local player = Players.LocalPlayer

type Run = {
	token       : string,
	startAt     : number,    -- Serverzeit des Starts
	speed       : number,
	jump        : number,    -- Sekunden, die ein Skip der Fahrt vorgezogen hat
	ctx         : EpilogCameraPath.Context,
	route       : EpilogRoute.Route,
	profile     : EpilogRoute.Profile,
	camera      : Camera,
	saved       : { cameraType : Enum.CameraType, subject : Instance?, fov : number, cframe : CFrame },
	humanoid    : Humanoid?,
	walkSpeed   : number,
	stop        : (() -> ())?,
	conns       : { RBXScriptConnection },
	effects     : { Instance },
	controls    : any?,
	controlsOff : boolean,
	hidden      : { GuiObject },
	skipHeld    : number?,   -- Beginn des Haltens (os.clock) oder nil
	skipSent    : boolean,
	cuesDone    : { [number]: boolean },
	momentDone  : boolean,
	seenSent    : boolean,
	planks      : { BasePart },
	reduced     : boolean,
	ended       : boolean,
	lastClock   : number,
}

local _run: Run? = nil
local _restoreWatch: thread? = nil

--------------------------------------------------------------------------------
-- Kleine Helfer
--------------------------------------------------------------------------------

local function v3(a: { number }): Vector3
	return Vector3.new(a[1], a[2], a[3])
end

local function arr(v: Vector3): { number }
	return { v.X, v.Y, v.Z }
end

-- Stueckweise lineare Kurve { {t, wert}, ... }
local function curve(points: { { number } }, t: number): number
	if t <= points[1][1] then return points[1][2] end
	for i = 2, #points do
		local a, b = points[i - 1], points[i]
		if t <= b[1] then
			local u = (t - a[1]) / math.max(1e-6, b[1] - a[1])
			return a[2] + (b[2] - a[2]) * u
		end
	end
	return points[#points][2]
end

local function intensity(): string
	local reduced = false
	pcall(function()
		if (GuiService :: any).ReducedMotionEnabled == true then reduced = true end
	end)
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		reduced = true
	end
	pcall(function()
		local level = (UserSettings():GetService("UserGameSettings") :: any).SavedQualityLevel
		local n = if typeof(level) == "EnumItem" then level.Value else tonumber(level)
		if n and n > 0 and n <= 3 then reduced = true end
	end)
	return if reduced then "reduced" else "full"
end

-- HUD ausblenden, aber den Moment-Banner (haengt in derselben ScreenGui) stehen lassen.
-- Gibt die versteckten Elemente zurueck; showHud stellt sie wieder her.
local function hideHud(): { GuiObject }
	local hidden: { GuiObject } = {}
	local pg = player:FindFirstChildOfClass("PlayerGui")
	local hud = if pg then pg:FindFirstChild("RBL") else nil
	if hud and hud:IsA("ScreenGui") then
		for _, c in hud:GetChildren() do
			if c:IsA("GuiObject") and c.Name ~= "Moment" and c.Visible then
				c.Visible = false
				table.insert(hidden, c)
			end
		end
	end
	return hidden
end

local function showHud(hidden: { GuiObject })
	for _, c in hidden do
		if c.Parent then c.Visible = true end
	end
end

local function isNight(): boolean
	local h = Lighting.ClockTime
	return h < FX.dayFrom or h >= FX.dayTo
end

local function playCue(name: string)
	local id = EpilogConfig.CUES[name]
	if id and SoundConfig.get(id) then
		AudioController.play(id)
	end
end

local function sequenceTime(run: Run): number
	return math.max(0, (Workspace:GetServerTimeNow() - run.startAt) * run.speed) + run.jump
end

--------------------------------------------------------------------------------
-- Steuerung (Disable/Enable immer paarweise)
--------------------------------------------------------------------------------

local function getControls(): any?
	local ok, controls = pcall(function()
		local module = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 2)
		if not module then return nil end
		return (require(module :: ModuleScript) :: any):GetControls()
	end)
	if ok then return controls end
	return nil
end

local function setControls(run: Run, off: boolean)
	if run.controls == nil then return end
	if off and not run.controlsOff then
		run.controlsOff = true
		pcall(function() run.controls:Disable() end)
	elseif not off and run.controlsOff then
		run.controlsOff = false
		pcall(function() run.controls:Enable() end)
	end
end

--------------------------------------------------------------------------------
-- Licht
--------------------------------------------------------------------------------

local function makeEffects(run: Run)
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "EpilogBloom"
	bloom.Intensity = 0
	bloom.Size = 28
	bloom.Threshold = 1.0
	bloom.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Name = "EpilogSunRays"
	rays.Intensity = 0
	rays.Spread = 0.6
	rays.Parent = Lighting
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "EpilogColorCorrection"
	grade.Parent = Lighting
	run.effects = { bloom, rays, grade }
end

local function updateEffects(run: Run, t: number)
	local boost = if isNight() then FX.nightBoost else 1
	local bloom, rays, grade = run.effects[1], run.effects[2], run.effects[3]
	if bloom and bloom:IsA("BloomEffect") then
		bloom.Intensity = curve(FX.bloom, t) * boost * (if run.reduced then 0.8 else 1)
	end
	if rays and rays:IsA("SunRaysEffect") then
		rays.Intensity = curve(FX.sunRays, t) * (if run.reduced then 0.7 else 1)
	end
	if grade and grade:IsA("ColorCorrectionEffect") then
		local k = curve(FX.grade, t)
		grade.Saturation = FX.saturation * k
		grade.Contrast = FX.contrast * k
	end
end

--------------------------------------------------------------------------------
-- Aufraeumen
--------------------------------------------------------------------------------

local function cleanup(run: Run, reason: string)
	if run.ended then return end
	run.ended = true
	if _run == run then _run = nil end

	if run.stop then run.stop() run.stop = nil end
	for _, c in run.conns do
		c:Disconnect()
	end
	table.clear(run.conns)

	-- Kamera zurueck
	local cam = run.camera
	pcall(function()
		cam.FieldOfView = run.saved.fov
		cam.CameraType = run.saved.cameraType
		if run.saved.subject then cam.CameraSubject = run.saved.subject :: any end
	end)

	-- Licht, UI
	for _, e in run.effects do
		e:Destroy()
	end
	table.clear(run.effects)
	EpilogOverlay.finish()
	showHud(run.hidden)
	table.clear(run.hidden)

	-- Avatar und Steuerung
	local hum = run.humanoid
	if hum and hum.Parent then
		hum.WalkSpeed = run.walkSpeed
		pcall(function()
			local root = hum.RootPart
			if root then hum:MoveTo(root.Position) end
		end)
	end
	setControls(run, false)
	for _, p in run.planks do
		if p.Parent then p:SetAttribute("EpilogFlash", nil) end
	end
	if reason ~= "done" then
		warn("[EpilogController] Fahrt beendet:", reason)
	end
end

--------------------------------------------------------------------------------
-- Planken: golden aufblitzen, wenn der Avatar drueberlaeuft (rein visuell)
--------------------------------------------------------------------------------

local function collectPlanks(run: Run)
	for _, d in Workspace:GetDescendants() do
		if d:IsA("BasePart") and string.sub(d.Name, 1, 12) == "Epilog_Plank" then
			table.insert(run.planks, d)
			if #run.planks >= 80 then break end
		end
	end
end

local function flashPlanks(run: Run, pos: Vector3)
	for _, p in run.planks do
		if p.Parent and p:GetAttribute("EpilogFlash") == nil then
			local d = (p.Position - pos)
			if Vector3.new(d.X, 0, d.Z).Magnitude < 2.5 then
				p:SetAttribute("EpilogFlash", true)
				local old = p.Color
				p.Color = FX.colors.gold
				Kit.tween(p, 0.6, { Color = old })
				task.delay(0.8, function()
					if p.Parent then p:SetAttribute("EpilogFlash", nil) end
				end)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Lauf des Avatars
--------------------------------------------------------------------------------

local function walk(run: Run, t: number)
	local hum = run.humanoid
	local root = if hum then hum.RootPart else nil
	if not hum or not root or hum.Health <= 0 then return end
	local tau = t - Q.walkAt
	if tau < 0 or t >= Q.arriveAt then return end
	local progress = EpilogRoute.project(run.route, arr(root.Position))
	local want = EpilogRoute.distanceAt(run.profile, tau)
	local base = EpilogRoute.speedAt(run.profile, tau) * run.speed
	local speed = math.clamp(base + (want - progress) * 1.5, Q.walkMinSpeed, Q.walkMaxSpeed * math.max(1, run.speed))
	hum.WalkSpeed = speed
	local carrot = EpilogRoute.pointAt(run.route, math.min(run.route.length, progress + 6))
	hum:MoveTo(v3(carrot))
	flashPlanks(run, root.Position)
end

--------------------------------------------------------------------------------
-- Skip
--------------------------------------------------------------------------------

local function skipVisible(run: Run, t: number): boolean
	return t >= Q.skipFromSeconds and t < Q.arriveAt and not run.skipSent
end

local function doSkip(run: Run)
	if run.skipSent then return end
	run.skipSent = true
	Remotes.EpilogSkip:FireServer(run.token)
	local t = sequenceTime(run)
	run.jump += math.max(0, Q.arriveAt - t)
	run.cuesDone[3] = true
	EpilogOverlay.flashNow(FX.skipFlashSeconds, "skip")
	EpilogOverlay.setSkip(false, 0)
end

local function skipInput(run: Run, down: boolean)
	if run.ended then return end
	if down then
		if skipVisible(run, sequenceTime(run)) then run.skipHeld = os.clock() end
	else
		run.skipHeld = nil
	end
end

local function connectSkip(run: Run)
	local button = EpilogOverlay.skipButton()
	if button then
		table.insert(run.conns, button.InputBegan:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				skipInput(run, true)
			end
		end))
		table.insert(run.conns, button.InputEnded:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				skipInput(run, false)
			end
		end))
	end
	table.insert(run.conns, UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then
			skipInput(run, true)
		end
	end))
	table.insert(run.conns, UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then
			skipInput(run, false)
		end
	end))
end

--------------------------------------------------------------------------------
-- Der Takt (eine einzige Kit.animate-Schleife)
--------------------------------------------------------------------------------

local function defaultPose(run: Run): EpilogCameraPath.Pose
	local hum = run.humanoid
	local root = if hum then hum.RootPart else nil
	if not root then
		return { pos = run.ctx.cam0, look = run.ctx.avatar, fov = run.saved.fov }
	end
	local look = root.CFrame.LookVector
	local head = root.Position + Vector3.new(0, 2, 0)
	return {
		pos = arr(head - Vector3.new(look.X, 0, look.Z).Unit * 12 + Vector3.new(0, 5, 0)),
		look = arr(head),
		fov = run.saved.fov,
	}
end

local function step(run: Run): boolean
	if run.ended then return false end
	local now = os.clock()
	local dt = math.min(now - run.lastClock, 0.1)
	run.lastClock = now

	local hum = run.humanoid
	if not hum or hum.Health <= 0 or hum.Parent == nil then
		cleanup(run, "avatar_gone")
		return false
	end
	local root = hum.RootPart
	if not root then
		cleanup(run, "no_root")
		return false
	end

	local t = sequenceTime(run)
	-- Kontext aktualisieren
	local ctx = run.ctx
	ctx.avatar = arr(root.Position)
	ctx.progress = EpilogRoute.project(run.route, ctx.avatar)
	ctx.default = defaultPose(run)

	local pose, phase = EpilogCameraPath.sample(t, ctx)
	run.camera.CFrame = CFrame.lookAt(v3(pose.pos), v3(pose.look))
	run.camera.FieldOfView = pose.fov

	updateEffects(run, t)
	EpilogOverlay.update(t, dt, phase)
	walk(run, t)

	-- Cues
	for i, c in EpilogConfig.CUE_TIMES do
		if not run.cuesDone[i] and t >= c[1] then
			run.cuesDone[i] = true
			playCue(c[2] :: string)
		end
	end
	if not run.momentDone and t >= FX.momentAt then
		run.momentDone = true
		Moment.show("milestone", FX.colors.gold, "ui.moment.tower_cleared")
	end

	-- Skip-Ring
	local show = skipVisible(run, t)
	local progress = 0
	if run.skipHeld then
		progress = (now - run.skipHeld) / Q.skipHoldSeconds
		if progress >= 1 and show then
			run.skipHeld = nil
			doSkip(run)
			show = false
		end
	end
	EpilogOverlay.setSkip(show, progress)

	-- Steuerung zurueck, Ende der Fahrt
	if t >= EpilogConfig.TIMELINE.ARRIVAL_END then
		if not run.seenSent then
			run.seenSent = true
			Remotes.EpilogSeen:FireServer(run.token)
		end
		setControls(run, false)
		hum.WalkSpeed = run.walkSpeed
	end
	if t >= EpilogConfig.TIMELINE.ARRIVAL_END + Q.blendBackSeconds then
		cleanup(run, "done")
		return false
	end
	return true
end

--------------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------------

local function startFull(payload: any)
	if _run then cleanup(_run, "new_run") end
	local character = player.Character
	local hum = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local camera = Workspace.CurrentCamera
	local info = payload.route
	if not hum or not hum.RootPart or not camera or type(info) ~= "table" or type(info.points) ~= "table" then
		-- Ohne Wegdaten laeuft die Fahrt nicht; der Server hat seinen Zeitplan trotzdem
		-- (EpilogSeen kommt dann nach dem Mindestabstand von selbst).
		task.delay(EpilogConfig.SEEN_MIN_SECONDS, function()
			Remotes.EpilogSeen:FireServer(payload.token)
		end)
		return
	end

	local route = EpilogRoute.new(info.points)
	local reduced = intensity() == "reduced"
	local speed = math.clamp(tonumber(payload.speed) or 1, Q.minSpeed, Q.maxSpeed)
	local startAt = tonumber(payload.startAt) or Workspace:GetServerTimeNow()

	local run: Run = {
		token = tostring(payload.token), startAt = startAt, speed = speed, jump = 0,
		ctx = {
			cam0 = arr(camera.CFrame.Position), fov0 = camera.FieldOfView,
			summit = { center = info.summit, dir = info.dir },
			route = route, avatar = arr(hum.RootPart.Position), progress = 0,
			island = { center = info.island },
			terminal = { pos = info.terminalPos, look = info.terminalLook },
			default = { pos = arr(camera.CFrame.Position), look = arr(hum.RootPart.Position), fov = camera.FieldOfView },
			reduced = reduced,
		},
		route = route,
		profile = EpilogRoute.profile(route.length, Q.arriveAt - Q.walkAt, Q.walkFactors),
		camera = camera,
		saved = { cameraType = camera.CameraType, subject = camera.CameraSubject, fov = camera.FieldOfView, cframe = camera.CFrame },
		humanoid = hum, walkSpeed = hum.WalkSpeed,
		stop = nil, conns = {}, effects = {}, controls = getControls(), controlsOff = false,
		hidden = hideHud(),
		skipHeld = nil, skipSent = false, cuesDone = {}, momentDone = false, seenSent = false,
		planks = {}, reduced = reduced, ended = false, lastClock = os.clock(),
	}
	_run = run
	camera.CameraType = Enum.CameraType.Scriptable
	setControls(run, true)
	makeEffects(run)
	collectPlanks(run)
	EpilogOverlay.begin(if reduced then "reduced" else "full")
	connectSkip(run)

	-- Tod, Respawn, Verlassen: sofort sauber beenden
	table.insert(run.conns, hum.Died:Connect(function() cleanup(run, "died") end))
	table.insert(run.conns, player.CharacterRemoving:Connect(function() cleanup(run, "char_removed") end))
	table.insert(run.conns, Players.PlayerRemoving:Connect(function(p)
		if p == player then cleanup(run, "player_left") end
	end))

	run.stop = Kit.animate(function(): boolean
		local ok, keep = pcall(step, run)
		if not ok then
			cleanup(run, "error:" .. tostring(keep))
			return false
		end
		return keep :: boolean
	end)
end

-- Wiederaufnahme: nur Flash; EpilogSeen, sobald der Avatar am Terminal steht.
local function startRestore(payload: any)
	local token = tostring(payload.token)
	EpilogOverlay.flashNow(Q.restoreFlashSeconds, "restore")
	if payload.state ~= "pending" then return end
	if _restoreWatch then task.cancel(_restoreWatch) end
	_restoreWatch = task.spawn(function()
		for _ = 1, 240 do
			task.wait(0.5)
			local character = player.Character
			local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
			local terminal = Workspace:FindFirstChild("Epilog_Terminal", true)
			if root and terminal and terminal:IsA("Model") then
				if (terminal:GetPivot().Position - (root :: BasePart).Position).Magnitude < Q.arriveRadius * 1.5 then
					Remotes.EpilogSeen:FireServer(token)
					return
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Prompt 6: Knopf-Finale (Countdown, Start, Feier, Rueckweg)
--------------------------------------------------------------------------------

local FIN = EpilogConfig.FINALE

type FRun = {
	token      : string,
	startAt    : number,
	speed      : number,
	jump       : number,
	humanoid   : Humanoid?,
	fx         : EpilogFinaleFX.Instance,
	conns      : { RBXScriptConnection },
	stop       : (() -> ())?,
	controls   : any?,
	controlsOff: boolean,
	hidden     : { GuiObject },
	skipHeld   : number?,
	skipSent   : boolean,
	counted    : number,        -- wie viele Countdown-Zahlen schon gezeigt
	silence    : boolean,
	launched   : boolean,
	salvos     : number,
	bannerDone : boolean,
	returned   : boolean,
	reduced    : boolean,
	ended      : boolean,
	lastClock  : number,
}

local _fin: FRun? = nil

local function finaleTime(run: FRun): number
	return math.max(0, (Workspace:GetServerTimeNow() - run.startAt) * run.speed) + run.jump
end

local function finaleControls(run: FRun, off: boolean)
	if run.controls == nil then return end
	if off and not run.controlsOff then
		run.controlsOff = true
		pcall(function() run.controls:Disable() end)
	elseif not off and run.controlsOff then
		run.controlsOff = false
		pcall(function() run.controls:Enable() end)
	end
end

-- Beendet das Finale lokal: Effekte, Schuetteln, Steuerung, HUD. `keepOverlaySeconds`: der
-- Hinweis "Welt 2: Weg folgt bald" bleibt noch so lange sichtbar, dann geht die Schicht aus.
local function endFinale(run: FRun, reason: string, hintSeconds: number?)
	if run.ended then return end
	run.ended = true
	if _fin == run then _fin = nil end
	if run.stop then run.stop() run.stop = nil end
	for _, c in run.conns do c:Disconnect() end
	table.clear(run.conns)
	EpilogFinaleFX.destroy(run.fx)
	finaleControls(run, false)
	showHud(run.hidden)
	table.clear(run.hidden)
	local hum = run.humanoid
	if hum and hum.Parent then hum.CameraOffset = Vector3.zero end
	EpilogOverlay.setCountdown(0)
	EpilogOverlay.rain(0)
	EpilogOverlay.setSkip(false, 0)
	if hintSeconds and hintSeconds > 0 then
		EpilogOverlay.hint(Loc.t("epilog.finale.hint_world2"), hintSeconds)
		task.delay(hintSeconds + 0.6, function()
			if _run == nil and _fin == nil then EpilogOverlay.finish() end
		end)
	else
		EpilogOverlay.finish()
	end
	if reason ~= "done" and reason ~= "server_end" then
		warn("[EpilogController] Finale beendet:", reason)
	end
end

local function finaleSkipInput(run: FRun, down: boolean)
	if run.ended then return end
	if down then
		local f = finaleTime(run)
		if f >= FIN.skipFromSeconds and f < FIN.returnAt and not run.skipSent then
			run.skipHeld = os.clock()
		end
	else
		run.skipHeld = nil
	end
end

local function finaleStep(run: FRun): boolean
	if run.ended then return false end
	local now = os.clock()
	local dt = math.min(now - run.lastClock, 0.1)
	run.lastClock = now
	local hum = run.humanoid
	if not hum or hum.Parent == nil or hum.Health <= 0 then
		endFinale(run, "avatar_gone")
		return false
	end
	local f = finaleTime(run)

	-- Countdown 3 ... 2 ... 1 (Terminal zeigt ihn selbst, hier die grosse Zahl am Rand)
	while run.counted < #FIN.countTimes and f >= FIN.countTimes[run.counted + 1] do
		run.counted += 1
		EpilogOverlay.setCountdown(#FIN.countTimes - run.counted + 1)
		playCue("countdown")
	end
	if not run.silence and f >= FIN.silenceAt then
		run.silence = true
		EpilogOverlay.setCountdown(0)
		pcall(function() AudioController.duck(FIN.launchAt - FIN.silenceAt + 0.4) end)
	end
	-- Start: weisser Flash, Salven (3 x 0,4 s), Konfetti-Regen
	if not run.launched and f >= FIN.launchAt then
		run.launched = true
		EpilogOverlay.flashNow(0.5, "skip")
		EpilogOverlay.rain(if run.reduced then 25 else 50)
		playCue("launch")
	end
	if run.launched and run.salvos < FIN.salvos and f >= FIN.launchAt + run.salvos * FIN.salvoGap then
		run.salvos += 1
		EpilogOverlay.salvo()
	end
	-- Feier: Banner genau einmal (auch nach einem Skip)
	if not run.bannerDone and f >= FIN.celebrateAt then
		run.bannerDone = true
		EpilogOverlay.rain(0)
		EpilogOverlay.banner(Loc.t("epilog.finale.banner"), 2.4)
		Moment.show("unlock", EpilogConfig.FX.colors.gold, "ui.moment.world2")
		playCue("unlock")
	end
	if f >= FIN.celebrateAt + 0.5 then EpilogOverlay.rain(0) end

	EpilogFinaleFX.update(run.fx, f, dt)
	EpilogOverlay.update(-1000, dt, 0)

	-- Skip-Ring (erst ab Sekunde 5)
	local show = f >= FIN.skipFromSeconds and f < FIN.returnAt and not run.skipSent
	local progress = 0
	if run.skipHeld then
		progress = (now - run.skipHeld) / Q.skipHoldSeconds
		if progress >= 1 and show then
			run.skipHeld = nil
			run.skipSent = true
			Remotes.EpilogSkip:FireServer(run.token)
			run.jump += math.max(0, FIN.returnAt - f)
			show = false
		end
	end
	EpilogOverlay.setSkip(show, progress)

	-- Sicherheitsnetz: kommt das Server-Ende nie an, geben wir selbst frei
	if f > FIN.returnAt + 40 then
		endFinale(run, "timeout", 0)
		return false
	end
	return true
end

local function startFinale(payload: any)
	if _run then cleanup(_run, "finale") end
	if _fin then endFinale(_fin, "new_finale", 0) end
	local character = player.Character
	local hum = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local info = payload.route
	if not hum or type(info) ~= "table" then return end

	local reduced = intensity() == "reduced"
	local speed = math.clamp(tonumber(payload.speed) or 1, FIN.minSpeed, FIN.maxSpeed)
	local fx = EpilogFinaleFX.new({
		rocketBase = payload.rocketBase, island = info.island, dir = info.dir,
	}, hum, reduced)
	local run: FRun = {
		token = tostring(payload.token), startAt = tonumber(payload.startAt) or Workspace:GetServerTimeNow(),
		speed = speed, jump = 0, humanoid = hum, fx = fx, conns = {}, stop = nil,
		controls = getControls(), controlsOff = false, hidden = hideHud(),
		skipHeld = nil, skipSent = false, counted = 0, silence = false, launched = false, salvos = 0,
		bannerDone = false, returned = false, reduced = reduced, ended = false, lastClock = os.clock(),
	}
	_fin = run
	finaleControls(run, true)
	EpilogOverlay.begin(if reduced then "reduced" else "full")
	local button = EpilogOverlay.skipButton()
	if button then
		table.insert(run.conns, button.InputBegan:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				finaleSkipInput(run, true)
			end
		end))
		table.insert(run.conns, button.InputEnded:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				finaleSkipInput(run, false)
			end
		end))
	end
	table.insert(run.conns, UserInputService.InputBegan:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then finaleSkipInput(run, true) end
	end))
	table.insert(run.conns, UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then finaleSkipInput(run, false) end
	end))
	table.insert(run.conns, hum.Died:Connect(function() endFinale(run, "died", 0) end))
	table.insert(run.conns, player.CharacterRemoving:Connect(function() endFinale(run, "char_removed", 0) end))
	playCue("press")

	run.stop = Kit.animate(function(): boolean
		local ok, keep = pcall(finaleStep, run)
		if not ok then
			endFinale(run, "error:" .. tostring(keep), 0)
			return false
		end
		return keep :: boolean
	end)
end

-- Antworten des Servers waehrend des Finales: "return" (Flash zum Rueckweg), "end" (fertig).
local function onLaunchResult(payload: any)
	if type(payload) ~= "table" then return end
	if payload.phase == "start" and payload.ok == true then
		local ok, err = pcall(startFinale, payload)
		if not ok then
			warn("[EpilogController] Finale-Start fehlgeschlagen:", err)
			if _fin then endFinale(_fin, "start_error", 0) end
		end
	elseif payload.phase == "return" then
		local run = _fin
		if run then
			run.returned = true
			EpilogOverlay.flashNow(FIN.returnFlashSeconds, "skip")
			EpilogOverlay.setCountdown(0)
			EpilogOverlay.rain(0)
			EpilogOverlay.setSkip(false, 0)
		end
	elseif payload.phase == "end" then
		local run = _fin
		if run then
			endFinale(run, "server_end", if payload.aborted == true then 0 else FIN.hintSeconds)
		elseif payload.aborted ~= true then
			EpilogOverlay.init()
		end
	end
end

--------------------------------------------------------------------------------
-- Debug-Audit (epilog audit)
--------------------------------------------------------------------------------

local function audit(): { [string]: any }
	local cam = Workspace.CurrentCamera
	local count = 0
	for _, c in Lighting:GetChildren() do
		if string.sub(c.Name, 1, 6) == "Epilog" then count += 1 end
	end
	local hum = if player.Character then player.Character:FindFirstChildOfClass("Humanoid") else nil
	local run = _run
	return {
		fahrtLaeuft = run ~= nil,
		finaleLaeuft = _fin ~= nil,
		finaleSteuerungAus = _fin ~= nil and (_fin :: FRun).controlsOff,
		finaleFx = EpilogFinaleFX.audit(),
		cameraOffset = if hum then hum.CameraOffset.Magnitude else 0,
		kameraTyp = if cam then cam.CameraType.Name else "?",
		fov = if cam then cam.FieldOfView else 0,
		lichtEffekte = count,
		steuerungAus = run ~= nil and run.controlsOff,
		verbindungen = (if run then #run.conns else 0) + (if _fin then #_fin.conns else 0),
		animationen = Kit.activeAnimations(),
		walkSpeed = if hum then hum.WalkSpeed else 0,
		hudVersteckt = (if _run then #_run.hidden else 0) + (if _fin then #_fin.hidden else 0),
		overlay = EpilogOverlay.audit(),
	}
end

EpilogController.audit = audit

function EpilogController.isRunning(): boolean
	return _run ~= nil
end

function EpilogController.init()
	Remotes.EpilogStart.OnClientEvent:Connect(function(payload: any)
		if type(payload) ~= "table" then return end
		local ok, err = pcall(function()
			if payload.mode == EpilogConfig.MODE.RESTORE then
				startRestore(payload)
			else
				startFull(payload)
			end
		end)
		if not ok then
			warn("[EpilogController] Start fehlgeschlagen:", err)
			if _run then cleanup(_run, "start_error") end
		end
	end)

	Remotes.EpilogLaunchResult.OnClientEvent:Connect(onLaunchResult)

	Remotes.EpilogDebug.OnClientEvent:Connect(function(payload: any)
		if type(payload) == "table" and payload.cmd == "audit" then
			Remotes.EpilogDebugReport:FireServer(audit())
		end
	end)
end

return EpilogController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">EpilogIslandFX</string><ProtectedString name="Source"><![CDATA[--!strict
-- EpilogIslandFX.luau
-- StarterPlayerScripts/Controllers/EpilogIslandFX.luau
--
-- Einzige Zustaendigkeit (Prompt 3 von 7, Final-Epilog):
--   - Die Deko der schwebenden Insel (Kristalle, Buesche; Tag `EpilogDeco`) wippt
--     sanft: +-ISLAND.bobHeight Studs, ISLAND.bobPeriod Sekunden. Rein visuell,
--     lokal — der Server aendert nichts, die Kollision bleibt fest (die Deko
--     kollidiert ohnehin nicht).
--
-- Gewippt wird erst, wenn das Insel-Modell `Revealed` = true meldet (nach der
-- Enthuellung) und nur solange es besteht. Beim Abbau (`Revealed` = false) steht
-- die Deko wieder an ihrem Platz. Keine Schleife pro Frame: ein Tween pro Teil.
--
-- Mit FeatureFlags.FINAL_EPILOG = false baut der Server nichts — dann gibt es
-- auch nichts zu wippen.

local CollectionService = game:GetService("CollectionService")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EpilogConfig = require(ReplicatedStorage.Config.EpilogConfig)

local EpilogIslandFX = {}

local TAG = "EpilogDeco"

type Bob = {
	tween : Tween,
	base  : CFrame,
}

local _bobs: { [BasePart]: Bob } = {}
local _conns: { [BasePart]: { RBXScriptConnection } } = {}

local function stop(part: BasePart)
	local bob = _bobs[part]
	if not bob then return end
	_bobs[part] = nil
	bob.tween:Cancel()
	if part.Parent ~= nil then
		part.CFrame = bob.base
	end
end

local function start(part: BasePart)
	if _bobs[part] then return end
	local I = EpilogConfig.ISLAND
	local base = part.CFrame
	-- Phase je Teil verschieden (aus dem Namen), damit nicht alles im Gleichtakt wippt
	local phase = 0
	for i = 1, #part.Name do phase += string.byte(part.Name, i) end
	local delay = (phase % 10) / 10 * I.bobPeriod / 2

	part.CFrame = base - Vector3.new(0, I.bobHeight, 0)
	local tween = TweenService:Create(part,
		TweenInfo.new(I.bobPeriod / 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, delay),
		{ CFrame = base + Vector3.new(0, I.bobHeight, 0) })
	_bobs[part] = { tween = tween, base = base }
	tween:Play()
end

local function refresh(part: BasePart)
	local insel = part:FindFirstAncestor("Insel")
	if insel and insel:GetAttribute("Revealed") == true then
		start(part)
	else
		stop(part)
	end
end

local function forget(part: BasePart)
	stop(part)
	local list = _conns[part]
	if list then
		for _, conn in list do conn:Disconnect() end
		_conns[part] = nil
	end
end

local function onAdded(instance: Instance)
	if not instance:IsA("BasePart") then return end
	local part = instance
	if _conns[part] then return end
	local conns: { RBXScriptConnection } = {}
	_conns[part] = conns

	local function watchIsland()
		local insel = part:FindFirstAncestor("Insel")
		if insel then
			table.insert(conns, insel:GetAttributeChangedSignal("Revealed"):Connect(function() refresh(part) end))
		end
	end
	watchIsland()
	table.insert(conns, part.AncestryChanged:Connect(function(_, parent)
		if parent == nil then forget(part) end
	end))
	refresh(part)
end

function EpilogIslandFX.init()
	CollectionService:GetInstanceAddedSignal(TAG):Connect(onAdded)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(instance)
		if instance:IsA("BasePart") then forget(instance) end
	end)
	for _, instance in CollectionService:GetTagged(TAG) do
		onAdded(instance)
	end
end

return EpilogIslandFX
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">EpilogTerminalController</string><ProtectedString name="Source"><![CDATA[--!strict
-- EpilogTerminalController.luau
-- StarterPlayerScripts/Controllers/EpilogTerminalController.luau
--
-- Einzige Zustaendigkeit (Prompt 4 von 7, Final-Epilog):
--   - Das Start-Terminal auf der Insel lebendig machen: Bildschirmtext (in der
--     Sprache des Betrachters), Lampen, Schutzklappe, Knopf (Pulsieren, Senken),
--     Funken — alles aus dem Attribut `EpilogTerminalState` am Modell `Terminal`
--     (idle, ready, armed, fired, done). Der Server baut das Modell einmal und
--     fuehrt den Zustand; hier wird nur gezeigt (wie TerminalController).
--
-- Bewegungsvokabular: mechanisch-schwer, Scharniere mit Overshoot (Back), Knopf
-- Quad; kein Wackeln. Lampen blinken mit zufaelligem Mikro-Offset (+-0,1 s).
-- Der Prompt (Halten 1,2 s, Ladering) ist ein normaler serverseitiger
-- ProximityPrompt; sein Text kommt ueber WorldText.
--
-- Eine Heartbeat-Verbindung, nur solange mindestens ein Terminal steht.

local CollectionService = game:GetService("CollectionService")
local RunService        = game:GetService("RunService")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Loc          = require(ReplicatedStorage.Localization.Loc)
local EpilogConfig = require(ReplicatedStorage.Config.EpilogConfig)

local EpilogTerminalController = {}

local T  = EpilogConfig.TERMINAL
local ST = T.STATE
local PREFIX = "Epilog_Terminal_"

type View = {
	model     : Model,
	lamps     : { BasePart },
	jitter    : { number },
	lid       : BasePart,
	lidClosed : CFrame,
	hingeCF   : CFrame,
	knob      : BasePart,
	knobClosed: CFrame,
	label     : TextLabel,
	emitter   : ParticleEmitter?,
	angle     : NumberValue,   -- Klappe in Bogenmass
	press     : NumberValue,   -- Knopf gesenkt in Studs
	angleTween: Tween?,
	pressTween: Tween?,
	state     : string,
	stateAt   : number,
	conns     : { RBXScriptConnection },
}

local _views: { [Model]: View } = {}
local _count = 0
local _beat: RBXScriptConnection? = nil
local _langConn: any = nil

--------------------------------------------------------------------------------
-- Zustand -> Darstellung
--------------------------------------------------------------------------------

local SCREEN_KEY: { [string]: string } = {
	[ST.IDLE]  = "epilog.terminal.screen_idle",
	[ST.READY] = "epilog.terminal.screen_ready",
	[ST.ARMED] = "epilog.terminal.screen_armed",
	[ST.FIRED] = "epilog.terminal.screen_fired",
	[ST.DONE]  = "epilog.terminal.screen_done",
}

local function screenColor(state: string): Color3
	local c = T.colors
	if state == ST.FIRED or state == ST.DONE then return c.green end
	if state == ST.READY or state == ST.ARMED then return c.yellow end
	return c.red
end

-- Prompt 6: Countdown-Zahl (Attribut EpilogCountdown, 3 / 2 / 1; 0 oder fehlt = keine)
local function countdownOf(model: Model): number
	local n = model:GetAttribute(T.COUNTDOWN_ATTRIBUTE)
	return if typeof(n) == "number" then n else 0
end

local function setText(view: View)
	local n = countdownOf(view.model)
	if view.state == ST.FIRED and n > 0 then
		view.label.Text = tostring(n)
		view.label.TextColor3 = T.colors.yellow
		return
	end
	view.label.Text = Loc.t(SCREEN_KEY[view.state] or SCREEN_KEY[ST.IDLE])
	view.label.TextColor3 = screenColor(view.state)
end

local function applyLid(view: View)
	view.lid.CFrame = view.hingeCF * CFrame.Angles(view.angle.Value, 0, 0)
		* (view.hingeCF:Inverse() * view.lidClosed)
end

local function applyKnob(view: View)
	view.knob.CFrame = view.knobClosed - view.knobClosed.RightVector * view.press.Value
end

local function targetAngle(state: string): number
	if state == ST.READY then return math.rad(T.lidReadyDeg) end
	if state == ST.ARMED or state == ST.FIRED or state == ST.DONE then return math.rad(T.lidOpenDeg) end
	return 0
end

local function play(view: View, instant: boolean)
	local state = view.state
	local angle = targetAngle(state)
	local pressed = if state == ST.FIRED or state == ST.DONE then T.pressDepth else 0

	if view.angleTween then view.angleTween:Cancel() end
	if view.pressTween then view.pressTween:Cancel() end
	if instant then
		view.angle.Value = angle
		view.press.Value = pressed
	else
		local opening = angle > view.angle.Value
		local seconds = if state == ST.READY then T.lidReadySeconds
			elseif opening then T.lidOpenSeconds else T.lidCloseSeconds
		local at = TweenService:Create(view.angle, TweenInfo.new(seconds, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Value = angle })
		view.angleTween = at
		at:Play()
		-- harter Klack beim Druecken (Quad In), sanft zurueck beim Loslassen (Quad Out)
		local down = pressed > view.press.Value
		local pt = TweenService:Create(view.press, TweenInfo.new(if down then T.pressSeconds else T.releaseSeconds,
			Enum.EasingStyle.Quad, if down then Enum.EasingDirection.In else Enum.EasingDirection.Out), { Value = pressed })
		view.pressTween = pt
		pt:Play()
	end
	if view.emitter then
		view.emitter.Enabled = (state == ST.FIRED or state == ST.DONE)
	end
	setText(view)
end

local function readState(model: Model): string
	local raw = model:GetAttribute(T.ATTRIBUTE)
	if typeof(raw) == "string" and SCREEN_KEY[raw] then return raw end
	return ST.IDLE
end

--------------------------------------------------------------------------------
-- Lampen und Knopf (pro Frame, nur Farben)
--------------------------------------------------------------------------------

local function scale(c: Color3, f: number): Color3
	return Color3.new(math.min(1, c.R * f), math.min(1, c.G * f), math.min(1, c.B * f))
end

local function animate(view: View, now: number)
	local c = T.colors
	local age = now - view.stateAt
	local state = view.state
	for i, lamp in view.lamps do
		local color: Color3
		if state == ST.IDLE then
			-- rot blinkend, jede Lampe mit eigenem Mikro-Offset
			local phase = (now + view.jitter[i]) % T.blinkSeconds
			color = if phase < T.blinkSeconds / 2 then c.red else c.lampOff
		elseif state == ST.READY then
			-- der Reihe nach auf Gelb
			color = if age >= (i - 1) * T.lampStepSeconds then c.yellow else c.red
		elseif state == ST.ARMED then
			color = if now % 0.3 < 0.15 then c.yellow else c.lampOff
		elseif state == ST.FIRED then
			local n = countdownOf(view.model)
			if n > 0 then
				-- Countdown: von Gelb der Reihe nach auf Gruen (3: alle gelb, 2: eine gruen, 1: zwei gruen)
				color = if i <= T.lampCount - n then c.green else c.yellow
			else
				-- kurz gruen blitzen, dann dauerhaft gruen
				color = if age < T.fireFlashSeconds and now % 0.2 >= 0.1 then c.lampOff else c.green
			end
		else
			color = c.green
		end
		lamp.Color = color
	end

	-- Knopf pulsiert (Glow +-15 %, 1,2 s), solange er bereit ist
	local factor = 1
	if state == ST.READY or state == ST.ARMED then
		factor = 1 + T.pulseAmount * math.sin(now * 2 * math.pi / T.pulseSeconds)
	end
	view.knob.Color = scale(c.red, factor)
end

local function onBeat()
	local now = os.clock()
	for _, view in _views do
		animate(view, now)
	end
end

local function startBeat()
	if _beat == nil then
		_beat = RunService.Heartbeat:Connect(onBeat)
	end
end

local function stopBeat()
	if _beat ~= nil and _count == 0 then
		_beat:Disconnect()
		_beat = nil
	end
end

--------------------------------------------------------------------------------
-- Ansicht auf- und abbauen
--------------------------------------------------------------------------------

local function forget(model: Model)
	local view = _views[model]
	if not view then return end
	_views[model] = nil
	_count -= 1
	if view.angleTween then view.angleTween:Cancel() end
	if view.pressTween then view.pressTween:Cancel() end
	for _, conn in view.conns do conn:Disconnect() end
	view.angle:Destroy()
	view.press:Destroy()
	stopBeat()
end

local function build(model: Model)
	if _views[model] then return end
	local function part(name: string): BasePart?
		local found = model:WaitForChild(PREFIX .. name, 10)
		return if found and found:IsA("BasePart") then found else nil
	end
	local screen, lid, knob = part("Bildschirm"), part("Klappe"), part("Knopf")
	local korpus = part("Korpus")
	if not (screen and lid and knob and korpus) or _views[model] then return end
	local hinge = korpus:WaitForChild("Scharnier", 10)
	if not (hinge and hinge:IsA("Attachment")) then return end
	local lamps: { BasePart } = {}
	local jitter: { number } = {}
	local rng = Random.new()
	for i = 1, T.lampCount do
		local lamp = part("Lampe" .. i)
		if not lamp then return end
		table.insert(lamps, lamp)
		table.insert(jitter, rng:NextNumber(-T.blinkJitter, T.blinkJitter))
	end

	-- Bildschirm (SurfaceGui auf der Oberseite des Schirm-Teils)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "EpilogSchirm"
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(420, 100)
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	gui.Parent = screen
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.Code
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = T.colors.red
	label.Parent = gui

	local funken = knob:FindFirstChild("Funken")
	local emitter = if funken then funken:FindFirstChildOfClass("ParticleEmitter") else nil

	local view: View = {
		model = model, lamps = lamps, jitter = jitter,
		lid = lid, lidClosed = lid.CFrame, hingeCF = hinge.WorldCFrame,
		knob = knob, knobClosed = knob.CFrame, label = label, emitter = emitter,
		angle = Instance.new("NumberValue"), press = Instance.new("NumberValue"),
		angleTween = nil, pressTween = nil,
		state = readState(model), stateAt = os.clock(), conns = {},
	}
	_views[model] = view
	_count += 1

	table.insert(view.conns, view.angle.Changed:Connect(function() applyLid(view) end))
	table.insert(view.conns, view.press.Changed:Connect(function() applyKnob(view) end))
	table.insert(view.conns, model:GetAttributeChangedSignal(T.ATTRIBUTE):Connect(function()
		local new = readState(model)
		if new == view.state then return end
		view.state = new
		view.stateAt = os.clock()
		play(view, false)
	end))
	table.insert(view.conns, model:GetAttributeChangedSignal(T.COUNTDOWN_ATTRIBUTE):Connect(function()
		setText(view)
	end))
	table.insert(view.conns, model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then forget(model) end
	end))

	play(view, true)
	startBeat()
end

--------------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------------

function EpilogTerminalController.init()
	local function onAdded(instance: Instance)
		if instance:IsA("Model") then
			task.spawn(build, instance)
		end
	end
	CollectionService:GetInstanceAddedSignal(T.TAG):Connect(onAdded)
	CollectionService:GetInstanceRemovedSignal(T.TAG):Connect(function(instance)
		if instance:IsA("Model") then forget(instance) end
	end)
	for _, instance in CollectionService:GetTagged(T.TAG) do
		onAdded(instance)
	end
	-- Sprachwechsel: Schirmtexte neu setzen
	_langConn = Loc.onChanged(function()
		for _, view in _views do setText(view) end
	end)
end

return EpilogTerminalController
]]></ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX48"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!strict
-- Main.client.luau
-- StarterPlayerScripts/Main.client.luau
--
-- Bootstrap des Clients — das Gegenstueck zu GameManager auf dem Server.
-- Einzige Stelle die die Startreihenfolge der Client-Module kennt.
--
-- ACHTUNG beim Umbenennen: die Datei darf NICHT "init.client.luau" heissen.
-- Rojo macht aus einem Ordner mit init-Datei ein Script statt eines
-- Containers — auf StarterPlayerScripts angewandt heisst das, dass der
-- gesamte Client-Teilbaum nie im Spiel ankommt. Genau das hat den
-- Server-Sync schon einmal lahmgelegt.
--
-- Reihenfolge:
--   1. ScreenGui anlegen — alle UI-Module haengen sich dort ein.
--   2. Toast zuerst, damit fruehe Fehlermeldungen schon sichtbar sind.
--   3. ClientState VOR den datengetriebenen UIs: die registrieren sich per
--      onChanged und bekommen den aktuellen Stand sofort nachgereicht.
--   4. Die Panels. Jedes meldet sich in seinem init beim PanelManager an —
--      erst danach duerfen Module laufen die Panels oeffnen wollen.
--   5. Hud und MenuBar: beide sind reine Ausloeser und brauchen die
--      angemeldeten Panels (Rebirth-Pille, Menue-Knoepfe).
--   6. ResultFeed — Toast-Meldungen fuer Recycling und Offline-Ertrag.
--      Muss vor dem ersten Serverpaket stehen, sonst geht der Offline-Report
--      des Joins verloren.
--   7. WorldController zuletzt — er braucht Panel und PanelManager.
--   8. EggTimerController — unabhaengig von allen anderen, braucht nur
--      ClientState (schon initialisiert) und die Figuren in der Welt.
--   9. SkillFXController (v14) — hoert nur auf Remotes.SkillFXPlay.
--
-- Davor, ganz am Anfang: LanguageController. Er legt die Sprache fest, bevor
-- irgendein Text gebaut wird (er braucht ClientState erst, wenn es dort
-- Daten gibt — onChanged meldet den aktuellen Stand sofort nach).

local Players = game:GetService("Players")

local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local root = script.Parent

local Controllers = root:WaitForChild("Controllers")
local UI          = root:WaitForChild("UI")

local ClientState        = require(Controllers:WaitForChild("ClientState"))
local AudioController    = require(Controllers:WaitForChild("AudioController"))   -- Audio-Rework 16.10.
local LanguageController = require(Controllers:WaitForChild("LanguageController"))
local ResultFeed         = require(Controllers:WaitForChild("ResultFeed"))
local WorldController    = require(Controllers:WaitForChild("WorldController"))
local EggTimerController = require(Controllers:WaitForChild("EggTimerController"))
local SkillFXController  = require(Controllers:WaitForChild("SkillFXController"))
local CombController     = require(Controllers:WaitForChild("CombController"))
local AmbienceController = require(Controllers:WaitForChild("AmbienceController"))
-- Welt aufwerten (08.10.2026)
local DayCycleController    = require(Controllers:WaitForChild("DayCycleController"))
local WaterController       = require(Controllers:WaitForChild("WaterController"))
local HubLandmarkController = require(Controllers:WaitForChild("HubLandmarkController"))
local HubEventController    = require(Controllers:WaitForChild("HubEventController"))
local ArrivalController     = require(Controllers:WaitForChild("ArrivalController"))
local WorldShotController   = require(Controllers:WaitForChild("WorldShotController"))
local PlotLifeController    = require(Controllers:WaitForChild("PlotLifeController"))
local ArenaLifeController   = require(Controllers:WaitForChild("ArenaLifeController"))
local LifeController        = require(Controllers:WaitForChild("LifeController"))
local WorldMomentController = require(Controllers:WaitForChild("WorldMomentController"))
local SoundscapeController  = require(Controllers:WaitForChild("SoundscapeController"))
local ZoneLightController   = require(Controllers:WaitForChild("ZoneLightController"))
local EventFXController  = require(Controllers:WaitForChild("EventFXController"))
local LaidEggMeshController = require(Controllers:WaitForChild("LaidEggMeshController"))
local UiEventLogger      = require(Controllers:WaitForChild("UiEventLogger"))
local GuideController    = require(Controllers:WaitForChild("GuideController"))
local UpgradeHintController = require(Controllers:WaitForChild("UpgradeHintController"))
local IncubatorController   = require(Controllers:WaitForChild("IncubatorController"))   -- Sammel-Update 8
local AreaSignController    = require(Controllers:WaitForChild("AreaSignController"))    -- Sammel-Update 3.8
local EpilogIslandFX        = require(Controllers:WaitForChild("EpilogIslandFX"))        -- 20.10. Final-Epilog P3: Inseldeko wippt
local EpilogTerminalController = require(Controllers:WaitForChild("EpilogTerminalController"))   -- 20.10. Final-Epilog P4: Start-Terminal
local EpilogController = require(Controllers:WaitForChild("EpilogController"))   -- 20.10. Final-Epilog P5: Kamerafahrt
local TerminalController    = require(Controllers:WaitForChild("TerminalController"))    -- 08.10. Tower-Terminal
local TowerFlightController = require(Controllers:WaitForChild("TowerFlightController")) -- 12.10. Flugfeld am Kampf-Turm

local Toast            = require(UI:WaitForChild("Toast"))
local UiScale          = require(UI:WaitForChild("UiScale"))
local ShopPanel        = require(UI:WaitForChild("ShopPanel"))
local Hud              = require(UI:WaitForChild("Hud"))
local MenuBar          = require(UI:WaitForChild("MenuBar"))
local BaerchiPanel     = require(UI:WaitForChild("BaerchiPanel"))
local BaerchiInventory = require(UI:WaitForChild("BaerchiInventory"))
local HatchPanel       = require(UI:WaitForChild("HatchPanel"))
local CombatPanel      = require(UI:WaitForChild("CombatPanel"))
local TowerPanel       = require(UI:WaitForChild("TowerPanel"))     -- 08.10. Paket D
local BuildingPanel    = require(UI:WaitForChild("BuildingPanel"))
local FusionPanel      = require(UI:WaitForChild("FusionPanel"))
local CharmPanel       = require(UI:WaitForChild("CharmPanel"))
local RebirthDialog    = require(UI:WaitForChild("RebirthDialog"))
local LanguagePanel    = require(UI:WaitForChild("LanguagePanel"))
local AudioPanel       = require(UI:WaitForChild("AudioPanel"))     -- Audio-Rework 16.10.
local PetBar           = require(UI:WaitForChild("PetBar"))
local QuestPanel       = require(UI:WaitForChild("QuestPanel"))
local QuestTracker     = require(UI:WaitForChild("QuestTracker"))
local HudRow           = require(UI:WaitForChild("HudRow"))
local EggTreePanel     = require(UI:WaitForChild("EggTreePanel"))
local LeaderboardPanel = require(UI:WaitForChild("LeaderboardPanel"))
local ProfilePanel     = require(UI:WaitForChild("ProfilePanel"))
local DailyBonusPanel  = require(UI:WaitForChild("DailyBonusPanel"))
local Feedback         = require(UI:WaitForChild("Feedback"))
local UpgradeFX        = require(UI:WaitForChild("UpgradeFX"))   -- 08.10. Paket G
local Moment           = require(UI:WaitForChild("Moment"))
local ReturnSummary    = require(UI:WaitForChild("ReturnSummary"))
local HomeButton       = require(UI:WaitForChild("HomeButton"))
local RebirthButton    = require(UI:WaitForChild("RebirthButton"))   -- Sammel-Update 2.7
local IncubatorPanel   = require(UI:WaitForChild("IncubatorPanel"))  -- Sammel-Update 8
local CurrencyHint     = require(UI:WaitForChild("CurrencyHint"))    -- Sammel-Update 3.4

--------------------------------------------------------------------------------
-- Oberflaeche
--------------------------------------------------------------------------------

local screenGui = Instance.new("ScreenGui")
screenGui.Name             = "RBL"
screenGui.ResetOnSpawn     = false   -- ueberlebt den Tod des Charakters
screenGui.IgnoreGuiInset   = false   -- laesst Platz fuer die Roblox-Topbar
screenGui.ZIndexBehavior   = Enum.ZIndexBehavior.Sibling
screenGui.Parent           = playerGui

-- Playtest 05.10.: auf grossen Monitoren mitwachsen (siehe UI/UiScale)
-- R1: Notch/Kameraloch und Roblox-Topbar aussparen (Handy quer).
pcall(function()
	(screenGui :: any).ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
end)
UiScale.init(screenGui)

--------------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------------

-- Sprache ALLERERSTES: ab hier liefert Loc den Text in der Roblox-Sprache des
-- Spielers. Ohne das haetten Toast und alle Beschriftungen, die beim Aufbau
-- gesetzt werden, einen Moment lang die Standardsprache.
LanguageController.init()

-- Vom Server gebaute Welt-Texte (Tafeln, Schilder, Prompts) in der Sprache
-- dieses Spielers anzeigen (siehe Localization/WorldText)
require(game:GetService("ReplicatedStorage"):WaitForChild("Localization"):WaitForChild("WorldText")).startClient()

Toast.init(screenGui)
ClientState.init()
-- Audio-Rework 16.10.: Musik + Effekte (braucht ClientState und PanelManager,
-- beide sind als Module schon geladen; die Musik startet erst nach dem Laden)
AudioController.init()

BaerchiPanel.init(screenGui)
BaerchiInventory.init(screenGui)
HatchPanel.init(screenGui)
CombatPanel.init(screenGui)
TowerPanel.init(screenGui)         -- 08.10. Paket D (nur mit TOWER_PANEL_V2)
BuildingPanel.init(screenGui)
FusionPanel.init(screenGui)
-- Nach BaerchiPanel: die Detailkarte oeffnet dieses Panel ueber den
-- PanelManager, es muss dafuer angemeldet sein. Die Reihenfolge der init-Aufrufe
-- entscheidet das zwar nicht (geoeffnet wird erst per Klick), aber die Liste
-- hier soll den Aufrufweg widerspiegeln.
CharmPanel.init(screenGui)
RebirthDialog.init(screenGui)
LanguagePanel.init(screenGui)
AudioPanel.init(screenGui)         -- Audio-Rework 16.10.: Regler + Lautsprecher-Knopf
QuestPanel.init(screenGui)
-- v14: Ei-Baum (oeffnet sich aus dem Ei-Menue)
EggTreePanel.init(screenGui)
-- v15: Bestenliste, Spieler-Profil (Inspector) und Login-Bonus. Vor MenuBar,
-- damit die Menue-Kacheln die Panels schon angemeldet vorfinden.
LeaderboardPanel.init(screenGui)
ProfilePanel.init(screenGui)
DailyBonusPanel.init(screenGui)
ShopPanel.init(screenGui)          -- HBB Paket 10 (nur mit SHOP_V1)
IncubatorPanel.init(screenGui)     -- Sammel-Update Paket 8

Hud.init(screenGui)
MenuBar.init(screenGui)

-- HBB Paket 1: fliegende Icons, grosse Momente, Rueckkehr-Karte. Nach Hud
-- und MenuBar (Ziele der Icons), vor ResultFeed (der Offline-Bericht des
-- Joins kommt sonst an, bevor die Karte bereit ist).
Feedback.init(screenGui)
UpgradeFX.init()                -- 08.10. Paket G: Erfolgs-Moment beim Ausbau
Moment.init(screenGui)
ReturnSummary.init(screenGui)
-- HBB Paket 5: Heim-Knopf (erscheint nur weit weg vom eigenen Plot)
HomeButton.init(screenGui)
RebirthButton.init(screenGui)   -- Sammel-Update 2.7: fester Rebirth-Knopf
CurrencyHint.init(screenGui)    -- Sammel-Update 3.4: Waehrungs-Hinweise

-- v13: Quest-Karte links (braucht das Quest-Fenster, das oben angemeldet wird)
QuestTracker.init(screenGui)
-- HUD_ROW_V2: Zahnrad · Quests · Shop in einer Zeile (versteckt die Quest-Karte)
HudRow.init(screenGui)

-- v12: untere Pet-Leiste (Event / Fight), legt auch den PitResumeDialog an
PetBar.init(screenGui)

ResultFeed.init()
WorldController.init()
EggTimerController.init()
IncubatorController.init()   -- Sammel-Update Paket 8
AreaSignController.init()    -- Sammel-Update Paket 3.8
EpilogIslandFX.init()        -- 20.10. Final-Epilog Prompt 3 (wippende Inseldeko)
EpilogTerminalController.init()   -- 20.10. Final-Epilog Prompt 4 (Start-Terminal)
EpilogController.init()   -- 20.10. Final-Epilog Prompt 5 (Kamerafahrt)
TerminalController.init()    -- 08.10. Tower-Terminal an der Bruecke
TowerFlightController.init() -- 12.10. Flugfeld auf den Kampf-Turm
-- v14: Faehigkeiten-Show im PIT (unabhaengig von allem anderen)
SkillFXController.init()
-- v15: Waben im Event-Pit und Recycler (braucht Toast, ClientState und die Welt)
CombController.init(screenGui)
-- v16: Himmels-Kulisse (Wolken, Schwebeinseln, Pollen, Schaum) nur auf dem Client
AmbienceController.init()
-- Welt aufwerten: Tageslauf (Paket A) zuerst — Wasser und Hauptinsel melden
-- ihre leuchtenden Teile bei ihm an. Danach Wasser (B), Hauptinsel (C),
-- Ankunft (C) und die festen Kamerapunkte (Paket 0, nur Studio).
DayCycleController.init()
WaterController.init()
HubLandmarkController.init()
HubEventController.init()
ArrivalController.init()
-- Paket D (Plot-Inseln) vor F: die Bienen fragen nach der eigenen Insel.
PlotLifeController.init()
-- Paket G: Welt-Momente (nutzt Arena-, Insel-, Leben- und Wahrzeichen-Controller)
WorldMomentController.init()
-- Paket H: Klang-Kulisse (still, bis gepruefte Sound-IDs eingetragen sind)
SoundscapeController.init()
-- Paket I: Licht nach Zonen (nach dem Tageslauf: setzt dessen Atmosphaeren-Faktoren)
ZoneLightController.init()
ArenaLifeController.init()
LifeController.init()
WorldShotController.init()
-- v17: lebendige Events (UFO-Patrouille, Abwuerfe, Boss, Telegraphen); braucht Toast
EventFXController.init()
-- v18: Ei-Mesh der gelegten Eier (EditableMesh gibt es nur auf dem Client)
LaidEggMeshController.init()
-- HBB Paket 0: Messpunkte der Oberflaeche (Panel auf/zu, Stillstand)
UiEventLogger.init()
-- HBB Paket 2: Fuehrung ohne Text (braucht MenuBar und PetBar als Anker)
GuideController.init(screenGui)
-- HBB Paket 3: ⬆ ueber bezahlbaren eigenen Gebaeuden
UpgradeHintController.init()

print("[Client] Bereit")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX52"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">EpilogFinaleFX</string><ProtectedString name="Source"><![CDATA[--!strict
-- EpilogFinaleFX.luau
-- StarterPlayerScripts/UI/EpilogFinaleFX.luau
--
-- Einzige Zustaendigkeit (Prompt 6 von 7, Final-Epilog): die WELT-Effekte des Knopf-Finales,
-- alles nur lokal beim Spieler und rein visuell:
--   - Rakete aus dem Schacht in die Wolken fahren (Tween auf der Client-Kopie; Feuer und
--     Rauch schaltet der Server als Emitter)
--   - Shockwave-Ring ueber das Wasser (flacher Zylinder mit Ring aus SurfaceGui, oder Bild)
--   - Portal-Silhouette am Horizont (BillboardGui, Bild oder Frame-Silhouette)
--   - Himmel kurz in Welt-2-Violettrosa (ColorCorrection) und der Bloom-Stoss beim Start
--   - Kamera-Schuetteln ueber Humanoid.CameraOffset (0,3 -> 0,8 Studs, sinusfoermig)
-- Keine eigene Schleife: der EpilogController ruft `update(f, dt)` aus seiner einen
-- Kit.animate-Schleife. `destroy()` stellt ALLES wieder her (Bloom, Tint, CameraOffset,
-- lokale Teile) und ist immer sicher aufrufbar.

local Workspace         = game:GetService("Workspace")
local Lighting          = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EpilogConfig = require(ReplicatedStorage.Config.EpilogConfig)

local EpilogFinaleFX = {}
EpilogFinaleFX.__index = EpilogFinaleFX

local F = EpilogConfig.FINALE
local A = EpilogConfig.ASSETS

export type Info = {
	rocketBase : { number }?,
	island     : { number },
	dir        : { number },
}

export type Instance = typeof(setmetatable({} :: {
	info       : Info,
	humanoid   : Humanoid?,
	camOffset  : Vector3,
	rocket     : Model?,
	rocketHome : CFrame?,
	wave       : BasePart?,
	waveRing   : Frame?,
	portal     : BasePart?,
	portalGui  : GuiObject?,
	bloom      : BloomEffect?,
	tint       : ColorCorrectionEffect?,
	reduced    : boolean,
	waveStarted: boolean,
	destroyed  : boolean,
}, EpilogFinaleFX))

local function lerp(a: number, b: number, t: number): number return a + (b - a) * t end
local function clamp01(x: number): number return math.clamp(x, 0, 1) end

function EpilogFinaleFX.new(info: Info, humanoid: Humanoid?, reduced: boolean): Instance
	local self = setmetatable({
		info = info, humanoid = humanoid, camOffset = if humanoid then humanoid.CameraOffset else Vector3.zero,
		rocket = nil, rocketHome = nil, wave = nil, waveRing = nil,
		portal = nil, portalGui = nil, bloom = nil, tint = nil,
		reduced = reduced, waveStarted = false, destroyed = false,
	}, EpilogFinaleFX)

	local bloom = Instance.new("BloomEffect")
	bloom.Name = "EpilogFinaleBloom"
	bloom.Intensity = 0
	bloom.Size = 30
	bloom.Threshold = 1.0
	bloom.Parent = Lighting
	self.bloom = bloom
	local tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "EpilogFinaleTint"
	tint.Parent = Lighting
	self.tint = tint
	return self
end

-- Rakete (Server-Teil) suchen: Modell "Rakete" mit Attribut EpilogRocketBase, darin Epilog_Rakete.
local function findRocket(): Model?
	for _, d in Workspace:GetDescendants() do
		if d.Name == "Epilog_Rakete" and d:IsA("Model") and d.Parent and d.Parent:GetAttribute("EpilogRocketBase") ~= nil then
			return d
		end
	end
	return nil
end

local function v3(a: { number }): Vector3 return Vector3.new(a[1], a[2], a[3]) end

local function startWave(self: Instance)
	self.waveStarted = true
	local center = v3(self.info.island)
	local part = Instance.new("Part")
	part.Name = "Epilog_Shockwave"
	part.Shape = Enum.PartType.Cylinder
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = true, false, false, false, false
	part.Material = Enum.Material.SmoothPlastic
	part.Transparency = 1
	part.Size = Vector3.new(F.shockwave.height, F.shockwave.startSize, F.shockwave.startSize)
	part.CFrame = CFrame.new(center + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Right   -- Zylinderachse X wird nach oben gedreht
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 8
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.Brightness = 2
	gui.Parent = part
	if A.shockwaveTex ~= "" then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromScale(1, 1)
		img.Image = A.shockwaveTex
		img.ImageColor3 = Color3.fromRGB(255, 244, 214)
		img.Parent = gui
	else
		local ring = Instance.new("Frame")
		ring.BackgroundTransparency = 1
		ring.Size = UDim2.fromScale(1, 1)
		ring.BorderSizePixel = 0
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = ring
		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(255, 244, 214)
		st.Thickness = 14
		st.Parent = ring
		ring.Parent = gui
		self.waveRing = ring
	end
	part.Parent = Workspace
	self.wave = part
end

local function startPortal(self: Instance)
	local P = F.portal
	local pos = v3(self.info.island) + v3(self.info.dir) * P.distance + Vector3.new(0, P.height, 0)
	local part = Instance.new("Part")
	part.Name = "Epilog_Portal"
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = true, false, false, false, false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 1)
	part.Position = pos
	local gui = Instance.new("BillboardGui")
	gui.StudsOffset = Vector3.zero
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = 2000
	gui.Size = UDim2.fromScale(P.size, P.size)   -- BillboardGui: Scale = Studs
	gui.Parent = part
	local holder: GuiObject
	if A.portalTex ~= "" then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromScale(1, 1)
		img.Image = A.portalTex
		img.ImageTransparency = 1
		img.Parent = gui
		holder = img
	else
		-- Ersatz: Torbogen aus Frame (oben rund) in Violett-Rosa mit Glut-Rand
		local arch = Instance.new("Frame")
		arch.AnchorPoint = Vector2.new(0.5, 1)
		arch.Position = UDim2.fromScale(0.5, 1)
		arch.Size = UDim2.fromScale(0.5, 0.8)
		arch.BackgroundColor3 = Color3.fromRGB(70, 20, 90)
		arch.BackgroundTransparency = 1
		arch.BorderSizePixel = 0
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = arch
		local st = Instance.new("UIStroke")
		st.Color = F.skyTint
		st.Thickness = 10
		st.Transparency = 1
		st.Parent = arch
		arch.Parent = gui
		holder = arch
	end
	part.Parent = Workspace
	self.portal = part
	self.portalGui = holder
end

local function setPortalAlpha(self: Instance, a: number)
	local g = self.portalGui
	if not g then return end
	if g:IsA("ImageLabel") then
		g.ImageTransparency = 1 - a
	else
		g.BackgroundTransparency = 1 - a * 0.92
		local st = g:FindFirstChildOfClass("UIStroke")
		if st then st.Transparency = 1 - a end
	end
end

-- f = Finale-Sekunden, dt = Frame-Zeit.
function EpilogFinaleFX.update(self: Instance, f: number, dt: number)
	if self.destroyed then return end

	-- Kamera-Schuetteln: wird ab dem Countdown staerker, nach dem Start abklingend
	local hum = self.humanoid
	if hum and hum.Parent then
		local S = F.shake
		local amp = 0
		if f >= F.countTimes[1] and f < F.launchAt then
			amp = lerp(S.from, S.to, clamp01((f - F.countTimes[1]) / (F.launchAt - F.countTimes[1])))
		elseif f >= F.launchAt and f < F.launchEnd + 1 then
			amp = lerp(S.to, 0, clamp01((f - F.launchAt) / (F.launchEnd + 1 - F.launchAt)))
		end
		if self.reduced then amp *= 0.5 end
		local w = f * S.hz * 2 * math.pi
		hum.CameraOffset = self.camOffset + Vector3.new(math.sin(w) * amp, math.sin(w * 1.31 + 1) * amp * 0.6, 0)
	end

	-- Bloom: 1,5 beim Start, in 2 s auf 0,8, dann sanft aus
	local bloom = self.bloom
	if bloom then
		local v: number
		if f < F.launchAt then
			v = lerp(0, 0.9, clamp01((f - F.countTimes[1]) / (F.launchAt - F.countTimes[1])))
		elseif f < F.launchAt + F.bloomSeconds then
			v = lerp(F.bloomPeak, F.bloomRest, clamp01((f - F.launchAt) / F.bloomSeconds))
		else
			v = lerp(F.bloomRest, 0, clamp01((f - (F.returnAt)) / 1.5))
		end
		bloom.Intensity = v
	end

	-- Rakete
	if f >= F.launchAt - 0.01 and not self.rocket then
		self.rocket = findRocket()
		if self.rocket then self.rocketHome = self.rocket:GetPivot() end
	end
	local rocket, home = self.rocket, self.rocketHome
	if rocket and rocket.Parent and home then
		local u = clamp01((f - F.launchAt) / (F.launchEnd - F.launchAt))
		local rise = F.rocket.rise * u * u            -- Quad: zuerst traege, dann davon
		local wobble = math.sin(f * 21) * 0.05 * u
		rocket:PivotTo(home * CFrame.new(wobble, rise, 0))
	end

	-- Shockwave
	if f >= F.launchAt and not self.waveStarted then startWave(self) end
	local wave = self.wave
	if wave and wave.Parent then
		local W = F.shockwave
		local u = clamp01((f - F.launchAt) / W.seconds)
		local d = lerp(W.startSize, W.endSize, 1 - (1 - u) * (1 - u))
		wave.Size = Vector3.new(W.height, d, d)
		local a = 1 - u
		if self.waveRing then
			local st = self.waveRing:FindFirstChildOfClass("UIStroke")
			if st then st.Transparency = 1 - a; st.Thickness = lerp(16, 3, u) end
		else
			local gui = wave:FindFirstChildOfClass("SurfaceGui")
			local img = if gui then gui:FindFirstChildOfClass("ImageLabel") else nil
			if img then img.ImageTransparency = 1 - a end
		end
		if u >= 1 then wave.Parent = nil end
	end

	-- Himmel: Violett-Rosa kurz einblenden, halten, ausblenden; Portal-Silhouette dazu
	local tint = self.tint
	if tint then
		local inA = clamp01((f - F.celebrateAt) / F.skyTintSeconds)
		local outA = clamp01((f - (F.celebrateAt + F.skyTintSeconds + F.skyHoldSeconds)) / 1.2)
		local k = inA * (1 - outA)
		tint.TintColor = Color3.new(1, 1, 1):Lerp(F.skyTint, 0.55 * k)
		tint.Saturation = 0.2 * k
	end
	if f >= F.celebrateAt and not self.portal then startPortal(self) end
	if self.portal then
		local P = F.portal
		local inA = clamp01((f - F.celebrateAt) / 1.0)
		local outA = clamp01((f - (F.celebrateAt + P.seconds)) / 1.0)
		setPortalAlpha(self, inA * (1 - outA) * (if self.reduced then 0.8 else 1))
	end
end

-- Stellt alles wieder her und entfernt alle lokalen Teile. Mehrfachaufruf harmlos.
function EpilogFinaleFX.destroy(self: Instance)
	if self.destroyed then return end
	self.destroyed = true
	local hum = self.humanoid
	if hum and hum.Parent then hum.CameraOffset = self.camOffset end
	if self.bloom then self.bloom:Destroy() end
	if self.tint then self.tint:Destroy() end
	if self.wave then self.wave:Destroy() end
	if self.portal then self.portal:Destroy() end
	-- Die Raketen-Kopie liegt in einem Server-Modell; es wird serverseitig zerstoert.
	local rocket, home = self.rocket, self.rocketHome
	if rocket and rocket.Parent and home then rocket:PivotTo(home) end
end

-- Zaehler fuer `epilog audit`.
function EpilogFinaleFX.audit(): { [string]: any }
	local n = 0
	for _, c in Lighting:GetChildren() do
		if string.sub(c.Name, 1, 12) == "EpilogFinale" then n += 1 end
	end
	return {
		lichtEffekte = n,
		welle = Workspace:FindFirstChild("Epilog_Shockwave") ~= nil,
		portal = Workspace:FindFirstChild("Epilog_Portal") ~= nil,
	}
end

return EpilogFinaleFX
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">EpilogOverlay</string><ProtectedString name="Source"><![CDATA[--!strict
-- EpilogOverlay.luau
-- StarterPlayerScripts/UI/EpilogOverlay.luau
--
-- Einzige Zustaendigkeit (Prompt 5 von 7, Final-Epilog):
--   - Die Bildschirmrand-Effekte der Kamerafahrt in einer eigenen UI-Schicht:
--     Flash, Vignette (gold/dunkel, aus vier UI-Verlaeufen, kein Bild), goldene Eckfunken,
--     aufsteigende Konfetti-Schleier links/rechts, Konfetti-Burst, Speed-Lines,
--     Wolkenfetzen mit Parallax, Lens-Flare am oberen Rand, Letterbox (2,35:1),
--     roter Knopf-Puls im Zentrum und der Skip-Ring (zwoelf Punkte) unten rechts.
--
-- Keine eigene Schleife: der EpilogController ruft `update(t, dt)` aus seiner einen
-- Kit.animate-Schleife. Alle Teilchen kommen aus festen Pools (hoechstens FX.maxSprites,
-- "reduced" halbiert) und werden nur wiederverwendet. Ohne hochgeladene Bilder
-- (EpilogConfig.ASSETS) zeichnen Frames die Teilchen. Keine Texte (nur "TOWER GESCHAFFT!"
-- kommt ueber UI/Moment).
--
-- Eigene ScreenGui `RBL_Epilog` (IgnoreGuiInset, ohne UiScale), steht ueber dem HUD.

local Players           = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EpilogConfig = require(ReplicatedStorage.Config.EpilogConfig)

local EpilogOverlay = {}

local FX = EpilogConfig.FX
local A  = EpilogConfig.ASSETS
local SKIP_DOTS = 12

type Sprite = {
	gui    : GuiObject,
	kind   : string,
	active : boolean,
	age    : number,
	life   : number,
	x      : number, y : number,
	vx     : number, vy : number,
	spin   : number,
	size   : number,
	depth  : number,
	color  : Color3,
	flip   : boolean,
}

local _gui: ScreenGui? = nil
local _root: Frame? = nil
local _pools: { [string]: { Sprite } } = {}
local _spawnAcc: { [string]: number } = {}
local _rng = Random.new(20261020)
local _reduced = false
local _running = false

local _flash: Frame? = nil
local _flashEnd = 0          -- Ende eines manuellen Flashs (Sequenzzeit-unabhaengig, os.clock)
local _flashStart = 0
local _flashHold = 0
local _flashKind = ""        -- "" | "manual" | "restore"
local _vig: { Frame } = {}
local _letter: { Frame } = {}
local _glow: Frame? = nil
local _skip: TextButton? = nil
local _dots: { Frame } = {}
local _flare: { Frame } = {}
local _conns: { RBXScriptConnection } = {}
-- Prompt 6 (Finale): Zahl, Banner, Hinweis, Konfetti-Regen, feste Vignette
local _count: TextLabel? = nil
local _banner: TextLabel? = nil
local _hint: TextLabel? = nil
local _rain = 0                                  -- Konfetti pro Sekunde von oben (0 = aus)
local _vigManual: { color: Color3, alpha: number }? = nil

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function inWindow(w: { number }, t: number): boolean
	return t >= w[1] and t < w[2]
end

local function inAnyWindow(list: { { number } }, t: number): boolean
	for _, w in list do
		if inWindow(w, t) then return true end
	end
	return false
end

-- 0 -> 1 -> 0 ueber ein Fenster (sanfte Huellkurve)
local function envelope(w: { number }, t: number, edge: number): number
	if not inWindow(w, t) then return 0 end
	return math.min(1, (t - w[1]) / edge, (w[2] - t) / edge)
end

local function lerp(a: number, b: number, t: number): number return a + (b - a) * t end

local function size(): Vector2
	local root = _root
	return if root then root.AbsoluteSize else Vector2.new(1280, 720)
end

local function frame(name: string, parent: Instance, color: Color3, z: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.Active = false
	f.ZIndex = z
	f.Parent = parent
	return f
end

local function corner(parent: Instance, scale: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(scale, 0)
	c.Parent = parent
end

--------------------------------------------------------------------------------
-- Teilchen
--------------------------------------------------------------------------------

local function makeSprite(kind: string): Sprite
	local root = _root :: Frame
	local gui: GuiObject
	if kind == "sparks" then
		if A.sparkTex ~= "" then
			local img = Instance.new("ImageLabel")
			img.Image = A.sparkTex
			img.BackgroundTransparency = 1
			gui = img
		else
			local f = frame("Funke", root, FX.colors.gold, 12)
			f.Rotation = 45
			corner(f, 0.12)
			gui = f
		end
	elseif kind == "veil" or kind == "burst" then
		if A.confettiTex ~= "" then
			local img = Instance.new("ImageLabel")
			img.Image = A.confettiTex
			img.ImageRectSize = Vector2.new(64, 64)
			img.BackgroundTransparency = 1
			gui = img
		else
			local f = frame("Konfetti", root, FX.colors.gold, if kind == "burst" then 16 else 13)
			corner(f, 0.2)
			gui = f
		end
	elseif kind == "speed" then
		if A.speedLineTex ~= "" then
			local img = Instance.new("ImageLabel")
			img.Image = A.speedLineTex
			img.BackgroundTransparency = 1
			gui = img
		else
			local f = frame("SpeedLine", root, FX.colors.white, 11)
			local g = Instance.new("UIGradient")
			g.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.25), NumberSequenceKeypoint.new(1, 1),
			})
			g.Parent = f
			corner(f, 0.5)
			gui = f
		end
	else -- cloud
		local f = frame("Wolke", root, FX.colors.white, 10)
		corner(f, 0.5)
		gui = f
	end
	gui.AnchorPoint = Vector2.new(0.5, 0.5)
	gui.Visible = false
	gui.Parent = root
	return {
		gui = gui, kind = kind, active = false, age = 0, life = 1, x = 0, y = 0, vx = 0, vy = 0,
		spin = 0, size = 10, depth = 1, color = FX.colors.white, flip = false,
	}
end

local function setTint(s: Sprite, color: Color3)
	s.color = color
	if s.gui:IsA("ImageLabel") then
		(s.gui :: ImageLabel).ImageColor3 = color
	else
		s.gui.BackgroundColor3 = color
	end
end

local function setAlpha(s: Sprite, alpha: number)   -- alpha 1 = sichtbar
	local transparency = math.clamp(1 - alpha, 0, 1)
	if s.gui:IsA("ImageLabel") then
		(s.gui :: ImageLabel).ImageTransparency = transparency
	elseif s.kind == "speed" then
		s.gui.BackgroundTransparency = math.clamp(transparency * 0.9, 0, 1)
	elseif s.kind == "cloud" then
		s.gui.BackgroundTransparency = math.clamp(1 - alpha * 0.45, 0, 1)
	else
		s.gui.BackgroundTransparency = transparency
	end
end

local function free(kind: string): Sprite?
	local pool = _pools[kind]
	if not pool then return nil end
	for _, s in pool do
		if not s.active then return s end
	end
	return nil
end

local function activate(s: Sprite, life: number)
	s.active = true
	s.age = 0
	s.life = life
	s.gui.Visible = true
end

local function deactivate(s: Sprite)
	s.active = false
	s.gui.Visible = false
end

local PALETTE_SPARK = { FX.colors.gold, FX.colors.gold, FX.colors.white, FX.colors.pink }
local PALETTE_VEIL  = { FX.colors.gold, FX.colors.white, FX.colors.sky, FX.colors.pink, FX.colors.magenta }

local function spawnSpark(screen: Vector2)
	local s = free("sparks")
	if not s then return end
	local corners = { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }
	local c = corners[_rng:NextInteger(1, 4)]
	s.x = (c[1] * screen.X) + (if c[1] == 0 then 1 else -1) * _rng:NextNumber(0.02, 0.2) * screen.X
	s.y = (c[2] * screen.Y) + (if c[2] == 0 then 1 else -1) * _rng:NextNumber(0.02, 0.28) * screen.Y
	s.vx = _rng:NextNumber(-12, 12)
	s.vy = -_rng:NextNumber(8, 34)   -- steigt langsam auf
	s.size = _rng:NextNumber(10, 26)
	s.spin = _rng:NextNumber(-40, 40)
	s.gui.Rotation = if s.gui:IsA("Frame") then 45 else _rng:NextNumber(0, 90)
	setTint(s, PALETTE_SPARK[_rng:NextInteger(1, #PALETTE_SPARK)])
	activate(s, _rng:NextNumber(0.9, 1.6))
end

local function spawnVeil(screen: Vector2)
	local s = free("veil")
	if not s then return end
	local left = _rng:NextNumber() < 0.5
	s.x = if left then _rng:NextNumber(0, 0.12) * screen.X else _rng:NextNumber(0.88, 1) * screen.X
	s.y = screen.Y + 12
	s.vx = (if left then 1 else -1) * _rng:NextNumber(10, 60)
	s.vy = -_rng:NextNumber(170, 330)
	s.size = _rng:NextNumber(8, 15)
	s.spin = _rng:NextNumber(-260, 260)
	s.gui.Rotation = _rng:NextNumber(0, 360)
	setTint(s, PALETTE_VEIL[_rng:NextInteger(1, #PALETTE_VEIL)])
	if s.gui:IsA("ImageLabel") then
		(s.gui :: ImageLabel).ImageRectOffset = Vector2.new(64 * _rng:NextInteger(0, 3), 0)
	end
	activate(s, _rng:NextNumber(2.2, 3.2))
end

-- Konfetti-Regen von oben (Finale, Phase 3): nutzt den Veil-Pool, faellt statt zu steigen.
local function spawnRain(screen: Vector2)
	local s = free("veil")
	if not s then return end
	s.x = _rng:NextNumber(0.02, 0.98) * screen.X
	s.y = -14
	s.vx = _rng:NextNumber(-40, 40)
	s.vy = _rng:NextNumber(220, 420)
	s.size = _rng:NextNumber(8, 15)
	s.spin = _rng:NextNumber(-260, 260)
	s.gui.Rotation = _rng:NextNumber(0, 360)
	setTint(s, PALETTE_VEIL[_rng:NextInteger(1, #PALETTE_VEIL)])
	if s.gui:IsA("ImageLabel") then
		(s.gui :: ImageLabel).ImageRectOffset = Vector2.new(64 * _rng:NextInteger(0, 3), 0)
	end
	activate(s, _rng:NextNumber(1.8, 2.8))
end

local function spawnBurst(screen: Vector2)
	local s = free("burst")
	if not s then return end
	s.x = _rng:NextNumber(0.15, 0.85) * screen.X
	s.y = screen.Y + 6
	s.vx = _rng:NextNumber(-260, 260)
	s.vy = -_rng:NextNumber(520, 980)
	s.size = _rng:NextNumber(9, 17)
	s.spin = _rng:NextNumber(-540, 540)
	s.gui.Rotation = _rng:NextNumber(0, 360)
	setTint(s, PALETTE_VEIL[_rng:NextInteger(1, #PALETTE_VEIL)])
	if s.gui:IsA("ImageLabel") then
		(s.gui :: ImageLabel).ImageRectOffset = Vector2.new(64 * _rng:NextInteger(0, 3), 0)
	end
	activate(s, _rng:NextNumber(1.4, 2.2))
end

local function spawnSpeed(screen: Vector2)
	local s = free("speed")
	if not s then return end
	local left = _rng:NextNumber() < 0.5
	s.y = _rng:NextNumber(0.12, 0.88) * screen.Y
	s.x = if left then _rng:NextNumber(0.02, 0.2) * screen.X else _rng:NextNumber(0.8, 0.98) * screen.X
	s.vx = (if left then -1 else 1) * _rng:NextNumber(500, 900)   -- vom Zentrum nach aussen
	s.vy = 0
	s.size = _rng:NextNumber(0.18, 0.34) * screen.X               -- Laenge
	s.gui.Rotation = 0
	setTint(s, FX.colors.white)
	activate(s, _rng:NextNumber(0.28, 0.45))
end

local function spawnClouds(screen: Vector2)
	for _, s in (_pools.cloud or {}) do
		if not s.active then
			s.depth = _rng:NextNumber(0.4, 1.6)
			s.x = _rng:NextNumber(-0.2, 1.1) * screen.X
			s.y = _rng:NextNumber(0.1, 0.9) * screen.Y
			s.vx = -(60 + 220 * s.depth)               -- Parallax: nah = schnell
			s.vy = 0
			s.size = (90 + 170 * s.depth)
			setTint(s, FX.colors.white)
			activate(s, 99)                             -- lebt, bis das Fenster endet
		end
	end
end

local function layoutSprite(s: Sprite)
	if s.kind == "speed" then
		s.gui.Size = UDim2.fromOffset(s.size, math.max(3, s.size * 0.025))
	elseif s.kind == "cloud" then
		s.gui.Size = UDim2.fromOffset(s.size * 1.9, s.size * 0.55)
	elseif s.kind == "sparks" and A.sparkTex ~= "" then
		s.gui.Size = UDim2.fromOffset(s.size * 2.2, s.size * 2.2)
	else
		s.gui.Size = UDim2.fromOffset(s.size, if s.kind == "veil" or s.kind == "burst" then s.size * 1.35 else s.size)
	end
	s.gui.Position = UDim2.fromOffset(s.x, s.y)
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

local function buildVignette(root: Frame)
	-- Vier Randstreifen mit Verlauf nach innen (Transparenz 0 am Rand, 1 innen).
	local defs = {
		{ "Oben",   UDim2.new(1, 0, 0.34, 0), UDim2.fromScale(0, 0), 90 },
		{ "Unten",  UDim2.new(1, 0, 0.34, 0), UDim2.fromScale(0, 0.66), 270 },
		{ "Links",  UDim2.new(0.26, 0, 1, 0), UDim2.fromScale(0, 0), 0 },
		{ "Rechts", UDim2.new(0.26, 0, 1, 0), UDim2.fromScale(0.74, 0), 180 },
	}
	for _, d in defs do
		local f = frame("Vignette" .. (d[1] :: string), root, FX.colors.gold, 2)
		f.Size = d[2] :: UDim2
		f.Position = d[3] :: UDim2
		f.BackgroundTransparency = 1
		local g = Instance.new("UIGradient")
		g.Rotation = d[4] :: number
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		g.Parent = f
		table.insert(_vig, f)
	end
end

local function buildLetterbox(root: Frame)
	for i = 1, 2 do
		local f = frame(if i == 1 then "LetterboxOben" else "LetterboxUnten", root, Color3.new(0, 0, 0), 6)
		f.AnchorPoint = Vector2.new(0, if i == 1 then 0 else 1)
		f.Position = UDim2.fromScale(0, if i == 1 then 0 else 1)
		f.Size = UDim2.new(1, 0, 0, 0)
		table.insert(_letter, f)
	end
end

local function buildSkip(root: Frame)
	local button = Instance.new("TextButton")
	button.Name = "SkipRing"
	button.Text = ""
	button.AutoButtonColor = false
	button.BackgroundColor3 = Color3.fromRGB(20, 24, 40)
	button.BackgroundTransparency = 0.45
	button.AnchorPoint = Vector2.new(1, 1)
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	button.Position = UDim2.new(1, -28, 1, if touch then -200 else -36)   -- ueber dem Sprung-Knopf
	button.Size = UDim2.fromOffset(62, 62)
	button.ZIndex = 60
	button.Visible = false
	button.Parent = root
	corner(button, 0.5)
	for i = 1, SKIP_DOTS do
		local a = (i - 1) / SKIP_DOTS * math.pi * 2 - math.pi / 2
		local d = frame("Punkt" .. i, button, FX.colors.white, 61)
		d.AnchorPoint = Vector2.new(0.5, 0.5)
		d.Size = UDim2.fromOffset(8, 8)
		d.Position = UDim2.new(0.5, math.cos(a) * 22, 0.5, math.sin(a) * 22)
		d.BackgroundTransparency = 0.7
		corner(d, 0.5)
		table.insert(_dots, d)
	end
	local center = frame("Mitte", button, FX.colors.gold, 61)   -- kleine Raute als Symbol, ohne Text
	center.AnchorPoint = Vector2.new(0.5, 0.5)
	center.Position = UDim2.fromScale(0.5, 0.5)
	center.Size = UDim2.fromOffset(14, 14)
	center.Rotation = 45
	corner(center, 0.15)
	_skip = button
end

local function buildFlare(root: Frame)
	if A.lensFlareTex ~= "" then
		local img = Instance.new("ImageLabel")
		img.Name = "LensFlare"
		img.Image = A.lensFlareTex
		img.BackgroundTransparency = 1
		img.AnchorPoint = Vector2.new(0.5, 0.5)
		img.Size = UDim2.fromOffset(420, 420)
		img.Position = UDim2.fromScale(0.62, 0.04)
		img.ImageTransparency = 1
		img.ZIndex = 14
		img.Parent = root
		table.insert(_flare, img :: any)
	else
		-- Ersatz: heller Kern und ein waagrechter Streifen am oberen Rand
		local core = frame("LensFlare", root, FX.colors.white, 14)
		core.AnchorPoint = Vector2.new(0.5, 0.5)
		core.Size = UDim2.fromOffset(120, 120)
		core.Position = UDim2.fromScale(0.62, 0.05)
		core.BackgroundTransparency = 1
		corner(core, 0.5)
		table.insert(_flare, core)
		local streak = frame("LensStreifen", root, FX.colors.gold, 14)
		streak.AnchorPoint = Vector2.new(0.5, 0.5)
		streak.Size = UDim2.fromOffset(520, 10)
		streak.Position = UDim2.fromScale(0.62, 0.05)
		streak.BackgroundTransparency = 1
		local g = Instance.new("UIGradient")
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1),
		})
		g.Parent = streak
		corner(streak, 0.5)
		table.insert(_flare, streak)
	end
end

local function scaled(n: number): number
	return math.max(1, math.floor(n * (if _reduced then FX.reducedFactor else 1) + 0.5))
end

--------------------------------------------------------------------------------
-- Oeffentlich
--------------------------------------------------------------------------------

-- Baut die Schicht einmal (unsichtbar). Wiederholter Aufruf ist harmlos.
function EpilogOverlay.init()
	if _gui then return end
	local gui = Instance.new("ScreenGui")
	gui.Name = "RBL_Epilog"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Active = false
	root.Parent = gui
	_gui, _root = gui, root

	buildVignette(root)
	local glow = frame("KnopfGlow", root, FX.colors.red, 3)
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.fromScale(0.5, 0.5)
	glow.Size = UDim2.fromOffset(260, 260)
	glow.BackgroundTransparency = 1
	corner(glow, 0.5)
	_glow = glow
	buildFlare(root)
	buildLetterbox(root)
	buildSkip(root)
	local flash = frame("Flash", root, FX.flash.color, 50)
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundTransparency = 1
	_flash = flash
	-- Finale-Texte (Loc-Texte setzt der Controller; hier nur die Huelle)
	local function label(name: string, y: number, size: number, color: Color3, z: number): TextLabel
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = UDim2.fromScale(0.5, y)
		l.Size = UDim2.fromOffset(900, size)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.TextColor3 = color
		l.Text = ""
		l.TextTransparency = 1
		l.TextStrokeColor3 = Color3.fromRGB(70, 36, 8)
		l.TextStrokeTransparency = 1
		l.ZIndex = z
		l.Parent = root
		local sc = Instance.new("UIScale")
		sc.Parent = l
		return l
	end
	_count = label("Countdown", 0.4, 260, FX.colors.gold, 40)
	_banner = label("Banner", 0.3, 110, FX.colors.gold, 41)
	_hint = label("Hinweis", 0.84, 56, FX.colors.white, 41)
end

-- Beginnt eine Fahrt: Pools fuer die gewaehlte Staerke ("full" | "reduced").
function EpilogOverlay.begin(intensity: string)
	EpilogOverlay.init()
	EpilogOverlay.finish()
	_reduced = intensity == "reduced"
	_running = true
	_spawnAcc = {}
	for kind, n in FX.pools do
		local pool: { Sprite } = {}
		for _ = 1, scaled(n) do
			table.insert(pool, makeSprite(kind))
		end
		_pools[kind] = pool
	end
	local guiNow = _gui :: ScreenGui
	guiNow.Enabled = true
end

-- Raeumt alles ab (Teilchen, Zustand, Sichtbarkeit). Immer sicher aufrufbar.
function EpilogOverlay.finish()
	_running = false
	for _, pool in _pools do
		for _, s in pool do s.gui:Destroy() end
	end
	table.clear(_pools)
	table.clear(_spawnAcc)
	_flashKind = ""
	_rain = 0
	_vigManual = nil
	for _, l in { _count, _banner, _hint } do
		if l then l.Text = ""; l.TextTransparency = 1; l.TextStrokeTransparency = 1 end
	end
	if _flash then _flash.BackgroundTransparency = 1 end
	for _, v in _vig do v.BackgroundTransparency = 1 end
	for _, l in _letter do l.Size = UDim2.new(1, 0, 0, 0) end
	if _glow then _glow.BackgroundTransparency = 1 end
	for _, f in _flare do
		if f:IsA("ImageLabel") then (f :: any).ImageTransparency = 1 else f.BackgroundTransparency = 1 end
	end
	if _skip then _skip.Visible = false end
	if _gui then _gui.Enabled = false end
end

-- Zaehler fuer den Audit.
function EpilogOverlay.audit(): { [string]: any }
	local active, total = 0, 0
	for _, pool in _pools do
		for _, s in pool do
			total += 1
			if s.active then active += 1 end
		end
	end
	return {
		sichtbar = _gui ~= nil and _gui.Enabled,
		laeuft = _running,
		teilchenAktiv = active,
		teilchenPool = total,
		reduced = _reduced,
	}
end

-- Das Skip-Ring-Knopfobjekt (der Controller haengt Eingaben an).
function EpilogOverlay.skipButton(): TextButton?
	return _skip
end

-- Skip-Ring zeigen/verstecken; progress 0..1 fuellt die zwoelf Punkte.
function EpilogOverlay.setSkip(visible: boolean, progress: number)
	local button = _skip
	if not button then return end
	button.Visible = visible and _running
	local lit = math.floor(math.clamp(progress, 0, 1) * SKIP_DOTS + 0.5)
	for i, d in _dots do
		if i <= lit then
			d.BackgroundColor3 = FX.colors.gold
			d.BackgroundTransparency = 0
		else
			d.BackgroundColor3 = FX.colors.white
			d.BackgroundTransparency = 0.7
		end
	end
end

-- Weisser Flash jetzt: bei "restore" startet er voll und blendet in `seconds` aus
-- (Wiederaufnahme ohne Fahrt), sonst kurz hoch und wieder runter (z. B. beim Skip).
function EpilogOverlay.flashNow(seconds: number, kind: string?)
	EpilogOverlay.init()
	local guiNow = _gui :: ScreenGui
	guiNow.Enabled = true
	_flashKind = kind or "manual"
	_flashStart = os.clock()
	_flashEnd = _flashStart + seconds
end

-- Prompt 6 (Finale): grosse Zahl am Bildschirmrand-Zentrum (0/nil = weg). Pop-Animation.
function EpilogOverlay.setCountdown(n: number, text: string?)
	local l = _count
	if not l then return end
	if n <= 0 then
		l.TextTransparency = 1
		l.TextStrokeTransparency = 1
		return
	end
	l.Text = text or tostring(n)
	l.TextTransparency = 0
	l.TextStrokeTransparency = 0
	local sc = l:FindFirstChildOfClass("UIScale")
	if sc then
		sc.Scale = 1.6
		TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
end

local function popText(l: TextLabel?, text: string, seconds: number, from: number)
	if not l then return end
	l.Text = text
	l.TextTransparency = 0
	l.TextStrokeTransparency = 0
	local sc = l:FindFirstChildOfClass("UIScale")
	if sc then
		sc.Scale = from
		TweenService:Create(sc, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	task.delay(seconds, function()
		if l.Parent == nil or l.Text ~= text then return end
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
end

-- Banner (Gold mit Kontur) und Hinweis unten. Text kommt vom Aufrufer (Loc).
function EpilogOverlay.banner(text: string, seconds: number)
	popText(_banner, text, seconds, 0.3)
end

function EpilogOverlay.hint(text: string, seconds: number)
	popText(_hint, text, seconds, 0.8)
end

-- Eine Salve: Konfetti-Burst + Funken (Pools begrenzen die Anzahl).
function EpilogOverlay.salvo()
	if not _running then return end
	local screen = size()
	for _ = 1, #(_pools.burst or {}) do spawnBurst(screen) end
	for _ = 1, 5 do spawnSpark(screen) end
end

-- Konfetti-Regen von oben (Teilchen pro Sekunde, 0 = aus).
function EpilogOverlay.rain(perSecond: number)
	_rain = perSecond
end

-- Feste Randfarbe/-staerke (nil = Standard der Kamerafahrt, also keine Vignette).
function EpilogOverlay.setVignette(color: Color3?, alpha: number)
	_vigManual = if color then { color = color, alpha = alpha } else nil
end

local function flashAlpha(t: number, now: number): number
	local F = FX.flash
	local alpha = 0
	if t >= F.at and t < F.at + F.upSeconds + F.downSeconds then
		local u = t - F.at
		alpha = if u < F.upSeconds then u / F.upSeconds else 1 - (u - F.upSeconds) / F.downSeconds
	end
	if _flashKind ~= "" then
		local u = (now - _flashStart) / math.max(_flashEnd - _flashStart, 1e-3)
		if u >= 1 then
			_flashKind = ""
		elseif _flashKind == "restore" then
			alpha = math.max(alpha, 1 - u)
		else
			alpha = math.max(alpha, if u < 0.35 then u / 0.35 else 1 - (u - 0.35) / 0.65)
		end
	end
	return math.clamp(alpha, 0, 1)
end

-- Ein Bild: t = Sekunde der Sequenz (real), dt = Frame-Zeit, phase 1..6.
function EpilogOverlay.update(t: number, dt: number, phase: number)
	local root = _root
	if not root or not _running then return end
	local screen = size()
	local now = os.clock()
	dt = math.min(dt, 0.05)

	-- Flash
	local flash = _flash
	if flash then flash.BackgroundTransparency = 1 - flashAlpha(t, now) end

	-- Vignette: gold pulsiert im Sieg-Beat, dunkel vor dem Terminal-Reveal
	local vigAlpha, vigColor = 0, FX.colors.gold
	if inWindow(FX.vignetteGold, t) then
		vigColor = FX.colors.gold
		vigAlpha = 0.55 + 0.25 * math.sin(t * math.pi * 4)
	elseif t >= FX.vignetteDark[1] and phase <= 5 then
		vigColor = Color3.fromRGB(18, 20, 44)
		vigAlpha = 0.75 * math.min(1, (t - FX.vignetteDark[1]) / 1.5)
	end
	local manual = _vigManual
	if manual then vigColor, vigAlpha = manual.color, manual.alpha end
	for _, v in _vig do
		v.BackgroundColor3 = vigColor
		v.BackgroundTransparency = 1 - vigAlpha
	end

	-- Letterbox 2,35:1 (nur "full")
	if not _reduced then
		local lb = FX.letterbox
		local u = if t < lb[1] then 0 elseif t > lb[2] then 0 else math.min(1, (t - lb[1]) / lb[3])
		local bar = math.max(0, (screen.Y - screen.X / 2.35) / 2) * u
		for _, l in _letter do l.Size = UDim2.new(1, 0, 0, bar) end
	end

	-- Knopf-Puls im Zentrum (rot), waehrend die Vignette abdunkelt
	local glow = _glow
	if glow then
		if t >= FX.vignetteDark[1] and t < EpilogConfig.SEQUENCE.endAt then
			local pulse = 0.5 + 0.5 * math.sin((t - FX.vignetteDark[1]) * math.pi * 2 / 1.2)
			glow.BackgroundTransparency = 1 - (0.12 + 0.2 * pulse) * math.min(1, (t - FX.vignetteDark[1]) / 1.5)
			local s = 220 + 60 * pulse
			glow.Size = UDim2.fromOffset(s, s)
		else
			glow.BackgroundTransparency = 1
		end
	end

	-- Lens-Flare am oberen Rand (Insel-Reveal)
	local fl = envelope(FX.lensFlare, t, 0.6)
	for i, f in _flare do
		local a = fl * (if i == 1 then 0.55 else 0.7)
		if f:IsA("ImageLabel") then (f :: any).ImageTransparency = 1 - a else f.BackgroundTransparency = 1 - a end
	end

	-- Wolken-Overlay
	local cloudOn = inWindow(FX.clouds, t)
	if cloudOn then
		local pool = _pools.cloud
		if pool and not pool[1].active then spawnClouds(screen) end
	end

	-- Spawns (gleichmaessig ueber die Lebensdauer verteilt)
	local function emit(kind: string, perSecond: number, spawn: (Vector2) -> ())
		local acc = (_spawnAcc[kind] or 0) + perSecond * dt
		while acc >= 1 do
			acc -= 1
			spawn(screen)
		end
		_spawnAcc[kind] = acc
	end
	if inWindow(FX.sparks, t) then
		emit("sparks", #(_pools.sparks or {}) / 1.2, spawnSpark)
	end
	if inAnyWindow(FX.veil, t) then
		emit("veil", #(_pools.veil or {}) / 2.7, spawnVeil)
	end
	if inAnyWindow(FX.speedLines, t) then
		local env = 1
		for _, w in FX.speedLines do
			if inWindow(w, t) then env = envelope(w, t, 0.35) end
		end
		emit("speed", #(_pools.speed or {}) / 0.36 * math.max(env, 0.2), spawnSpeed)
	end
	if _rain > 0 then
		emit("veil", _rain, spawnRain)
	end
	if t >= FX.confettiBurstAt and _spawnAcc.burstDone ~= 1 then
		_spawnAcc.burstDone = 1
		for _ = 1, #(_pools.burst or {}) do spawnBurst(screen) end
	end

	-- Bewegen
	for _, pool in _pools do
		for _, s in pool do
			if s.active then
				s.age += dt
				local u = s.age / s.life
				if s.kind == "cloud" then
					s.x += s.vx * dt
					if s.x < -s.size * 1.2 then s.x = screen.X + s.size end
					local a = math.min(1, s.age / 0.6)
					if not cloudOn then
						deactivate(s)   -- Fenster vorbei: Wolke verschwindet (sie ist bereits hauchduenn)
					else
						setAlpha(s, a)
					end
				elseif u >= 1 then
					deactivate(s)
				else
					if s.kind == "burst" then s.vy += 900 * dt end
					s.x += s.vx * dt
					s.y += s.vy * dt
					s.gui.Rotation += s.spin * dt
					local a: number
					if s.kind == "sparks" then
						a = math.sin(math.pi * u) * (0.75 + 0.25 * math.sin(s.age * 14))   -- funkelt
					elseif s.kind == "speed" then
						a = math.sin(math.pi * u) * 0.8
					elseif s.kind == "burst" then
						a = if u < 0.7 then 1 else (1 - u) / 0.3
					else
						a = if u < 0.12 then u / 0.12 elseif u > 0.75 then (1 - u) / 0.25 else 0.9
					end
					setAlpha(s, a)
				end
				if s.active then layoutSprite(s) end
			end
		end
	end
end

return EpilogOverlay
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">ProfilePanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- ProfilePanel.luau
-- StarterPlayerScripts/UI/ProfilePanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die Profilkarte eines anderen Spielers zeigen (Inspektor, v15):
--     ausgeruesteter Baerchi (Rarity, Mutation, Level, Sterne), hoechster
--     Tower/Rekord, Rebirths, Index x/28 und die Top 3 Baerchis nach Staerke.
--
-- Geoeffnet ueber PanelManager.open("Profile", userId) — vom WorldController
-- (Klick auf Charakter oder Plot-Schild) und vom LeaderboardPanel. Die Karte
-- baut der Server (GetPlayerProfile); hier wird nur angezeigt.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types         = require(ReplicatedStorage.Network.Types)
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local Names         = require(ReplicatedStorage.Localization.Names)
local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local TowerConfig   = require(ReplicatedStorage.Config.TowerConfig)
local PromotionConfig = require(ReplicatedStorage.Config.PromotionConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)

local ProfilePanel = {}

local PANEL_NAME = "Profile"

local _root: Frame? = nil
local _title: TextLabel? = nil
local _lines: TextLabel? = nil
local _requestId = 0

local function baerchiLine(entry: Types.ProfileBaerchi): string
	local name = Names.baerchi(entry.configId)
	local stars = math.floor(math.clamp(entry.promotion, 0, PromotionConfig.MAX_PROMOTION) / 2)
	local mutation = if entry.mutation then " · " .. Loc.name("mutation." .. entry.mutation .. ".name", entry.mutation) else ""
	return string.format("%s  (%s%s)  Lv.%d  %s", name, Loc.name("rarity." .. entry.rarity, entry.rarity), mutation,
		entry.level, string.rep("★", stars))
end

local function render(card: Types.PlayerProfileCard?)
	local title, lines = _title, _lines
	if not title or not lines then return end
	if not card then
		title.Text = Loc.t("ui.profile.title")
		lines.Text = Loc.t("ui.profile.unavailable")
		return
	end

	title.Text = card.name
	local def = TowerConfig.get(card.highestTower) or TowerConfig.TOWERS[1]
	local out: { string } = {
		Loc.t("ui.profile.equipped", { baerchi = if card.equipped then baerchiLine(card.equipped) else "—" }),
		Loc.t("ui.profile.tower", { tower = def.numeral, stage = card.towerRecord }),
		Loc.t("ui.profile.rebirths", { n = card.rebirths }),
		Loc.t("ui.profile.index", { have = card.indexCount, total = card.indexTotal }),
		if card.world2 == true then Loc.t("ui.profile.world2") else "",
		"",
		Loc.t("ui.profile.top"),
	}
	for i, entry in card.top do
		table.insert(out, string.format("%d. %s", i, baerchiLine(entry)))
	end
	lines.Text = table.concat(out, "\n")
end

local function show(userId: number)
	render(nil)
	local title = _title
	if title then title.Text = Loc.t("ui.leaderboard.loading") end

	_requestId += 1
	local myRequest = _requestId
	task.spawn(function()
		local ok, card = pcall(function()
			return Remotes.GetPlayerProfile:InvokeServer(userId)
		end)
		if myRequest ~= _requestId then return end
		render(if ok and typeof(card) == "table" then card :: Types.PlayerProfileCard else nil)
	end)
end

function ProfilePanel.init(screenGui: ScreenGui)
	local root = Theme.dialog("ProfilePanel", screenGui, Vector2.new(0.42, 0.5), Vector2.new(300, 300), Vector2.new(480, 420))
	_root = root

	_title = Theme.dialogHeader(root, Loc.t("ui.profile.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)
	local lines = Theme.bodyText("Lines", body, "")
	lines.Size       = UDim2.fromScale(1, 1)
	lines.TextColor3 = Theme.COLORS.text
	lines.TextSize   = 15
	_lines = lines

	PanelManager.register(PANEL_NAME, {
		open = function(...: any)
			local userId = select(1, ...)
			if typeof(userId) ~= "number" then return end
			root.Visible = true
			show(userId)
		end,
		close = function()
			root.Visible = false
		end,
	})

	print("[ProfilePanel] Initialisiert")
end

return ProfilePanel
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
