	-- 19.10.: pet limit and sell mode
	["err.pet_limit_full"]            = "Your Baerchi storage is full – sell some Baerchis to make room",
	["err.pet_limit_partial"]         = "Storage full – opened: {n}. The rest stays in your egg storage",
	["err.sell_invalid"]              = "Invalid selection",
