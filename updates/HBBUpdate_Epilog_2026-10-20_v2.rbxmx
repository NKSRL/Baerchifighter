	["err.not_enough_gold_gummies"] = "Not enough Honey Crystals (you have {have}, you need {need})",
	["err.shop_free_taken"] = "Already claimed today — come back tomorrow for more gold!",
	["err.rebirth_cost"]            = "Rebirth costs {cost} Paw Coins (you have {have})",

	["err.building_missing"]        = "Building not available",
	["err.building_unknown"]        = "Unknown building",
	["err.max_level"]               = "Maximum level reached",

	["err.charm_roll_cost"]         = "One roll costs {cost} Honey Crystals (you have {have})",
