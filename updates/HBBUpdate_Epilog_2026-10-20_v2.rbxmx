-- es.luau
-- ReplicatedStorage/Localization/Strings/es.luau
--
-- Español. Mismas claves y mismos {placeholders} que de.luau — ver la
-- cabecera de ese archivo para las convenciones. Los términos del juego
-- ("Baerchi", "Gummies", "Honey Crystals", "PIT", "Rebirth") se mantienen
-- igual en todos los idiomas.

return {
	----------------------------------------------------------------------------
	-- Idioma
	----------------------------------------------------------------------------
	["ui.language.title"] = "Idioma",
	["ui.language.auto"]  = "Automático (Roblox)",
	["ui.settings.title"] = "Ajustes",
	["ui.audio.section"] = "Sonido",
	["ui.audio.music"] = "Música",
	["ui.audio.sfx"] = "Efectos",
	["ui.audio.mute"] = "Silencio",

	----------------------------------------------------------------------------
	-- Tiempo
	----------------------------------------------------------------------------
	["time.s"]  = "{s} s",
	["time.ms"] = "{m} min {s} s",
	["time.hm"] = "{h} h {m} min",

	----------------------------------------------------------------------------
	-- Barra de menú
	----------------------------------------------------------------------------
	["ui.menu.eggs"]    = "Huevos",
	["ui.menu.baerchis"] = "Baerchis",
	["ui.menu.fight"]   = "Combate",
	["ui.menu.arena"]   = "Arena",

	----------------------------------------------------------------------------
	-- Rebirth
	----------------------------------------------------------------------------
	["ui.rebirth.title"]   = "Rebirth",
	["ui.rebirth.status"]  = "Rebirth {count}  —  Multiplicador x{mult:d2}",
	["ui.rebirth.cost"]    = "Cuesta {cost} Paw Coins  (tienes {have})",
	["ui.rebirth.loss"]    = "Se pierde: todos los niveles de edificios, los niveles de tus Baerchis y tus Paw Coins (vuelven a {start}) — ¡gástalos antes!\nSe conserva: tus Baerchis, todos los huevos (también en la incubadora), las mejoras de la incubadora, el árbol de huevos, los récords de torre, los Honey Crystals, el rango y las estadísticas.",
	["ui.rebirth.reward"]  = "Después: Multiplicador x{mult:d2}",
	["ui.rebirth.reward_eggs.one"]   = "Después: Multiplicador x{mult:d2}  —  +{n} Huevo de Ascensión",
	["ui.rebirth.reward_eggs.other"] = "Después: Multiplicador x{mult:d2}  —  +{n} Huevos de Ascensión",
	["ui.rebirth.cancel"]  = "Cancelar",
	["ui.rebirth.confirm"] = "¡Rebirth!",

	----------------------------------------------------------------------------
