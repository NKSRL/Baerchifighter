<string name="Name">CombConfig</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- CombConfig.luau
-- ReplicatedStorage/Config/CombConfig.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Zahlen und Masse fuer Honigwaben im Event-Pit und fuer den
--     Waben-Recycler auf dem Plot.
--
-- ============================================================
-- DIE IDEE
-- ============================================================
-- Das Event-Pit ist die ganze Zeit begehbar, aber zwischen den Events passiert
-- dort nichts, und wer seinen Baerchi losgeschickt hat, wartet nur. Deshalb
-- liegen im Pit Honigwaben herum:
--
--   * Wer darueber laeuft, hebt sie auf. Sie stapeln sich ueber seinem Kopf.
--   * Jede Wabe macht ihn INNERHALB des Pits ein Stueck langsamer (SLOW_*).
--     Verlaesst er das Pit, laeuft er wieder normal — das Gewicht ist ein
--     Risiko im Pit, keine Dauerstrafe.
--   * Betritt er seine EIGENE Insel, gibt er den Stapel ab. Die Waben
--     wandern in die Warteschlange des Recyclers, der sie nach und nach in
--     Gummies verwandelt — auch waehrend der Spieler schon wieder in der
--     Mitte sammelt.
--   * Der Recycler laesst sich mit Gummies ausbauen: mehr Gummies pro Wabe und
--     schnellere Verarbeitung.
--
-- Die Waben sind KEIN Spielstand: was ein Spieler gerade traegt, geht beim
-- Tod oder Verlassen verloren. Nur die Warteschlange des Recyclers wird
-- gespeichert (IslandData.recycler).
--
-- BALANCE-HINWEIS: ein voller Stapel (MAX_CARRY) bringt auf Recycler-Level 1
-- 250 Gummies, auf Level 10 etwa 20.000, auf Level 60 rund 5,7 Mio (vor dem
-- Rebirth-Multiplikator; 12.10.: Grundwert 10 x Multiplikator, sofort). Zum Vergleich: Tower I zahlt auf Stage 1 10 Gummies
-- (TowerConfig). Die Ausbaukosten kommen aus EconomyConfig.HONEY_UPGRADE_COSTS,
-- dieselbe Kurve wie bei den Honig-Gebaeuden (v15: Level 1-60).

local EconomyConfig = require(script.Parent.EconomyConfig)
local MapConfig     = require(script.Parent.MapConfig)

local CombConfig = {}

--------------------------------------------------------------------------------
-- Waben im Event-Pit: Entstehen
--------------------------------------------------------------------------------

-- Sekunden zwischen zwei neuen Waben, solange FREIE Slots da sind (Serverstart,
-- Limit eines Wabenthemas gestiegen, ein Spawn hat keinen Platz gefunden).
CombConfig.SPAWN_INTERVAL_SECONDS = 1.2

-- SLOT-ZAHL: so viele Waben gibt es hoechstens gleichzeitig — im Pit, auf
-- Koepfen getragen und in der Respawn-Warteschlange zusammen. Mehr liegen auch
-- nie im Pit. Haelt die Zahl der Teile klein und macht Waben knapp.
-- Sammel-Update 05.10. (Paket 5.1, "Waben langsamer und etwas weniger"): 40 -> 30.
CombConfig.MAX_WORLD_COMBS = 30

--------------------------------------------------------------------------------
-- Waben im Event-Pit: Respawn (Slot-Modell)
--------------------------------------------------------------------------------
-- Eine aufgehobene Wabe behaelt ihren Slot (Besitzer = Spieler). Erst wenn sie
-- im Recycler abgegeben wird, kommt sie nach RESPAWN_DELAY_SECONDS an einer
-- freien Stelle im Pit zurueck. Der Wabenfluss haengt damit an der Abgabe-Rate.

-- Sekunden zwischen Abgabe und neuer Wabe im Pit.
-- Paket 5.1: 20 -> 30 s. Events (Hot Egg, Boss) behalten ihren Wabenwert
-- (valueFactor der Themen), dort bleibt die Wabe also gleich wertvoll.
CombConfig.RESPAWN_DELAY_SECONDS = 30

-- Hook: verkuerzt der Recycler-Level den Respawn? Faktor pro Level ueber 1
-- (1 = nein, 0.9 = je Level 10 % kuerzer). Absichtlich 1, Entscheidung offen.
CombConfig.RECYCLER_DELAY_FACTOR = 1

-- Geht ein Stapel verloren (Tod, Verlassen, neuer Charakter), werden seine
-- Slots nach dieser Zeit frei und die Waben kommen ins Pit zurueck.
CombConfig.ORPHAN_RELEASE_SECONDS = 60

-- Sicherheitsnetz: liegen weniger als MIN_WORLD_COMBS im Pit, kommt trotzdem
-- alle MIN_TRICKLE_SECONDS eine dazu (auch ueber die Slot-Zahl hinaus, aber nie
-- ueber das Limit im Pit), damit Neulinge nie ein leeres Pit sehen.
CombConfig.MIN_WORLD_COMBS     = 8
CombConfig.MIN_TRICKLE_SECONDS = 10   -- Paket 5.1: 6 -> 10 s

-- Takt der Respawn-Pruefung (ein Loop, kein Thread pro Wabe).
CombConfig.RESPAWN_TICK_SECONDS = 0.25

-- Beim Serverstart liegen schon so viele da, damit das Pit nicht leer wirkt.
CombConfig.INITIAL_COMBS = 24

-- Ringfoermiger Streifen um die Pit-Mitte, in dem Waben entstehen (Studs).
-- Innen bleibt die Mitte frei (Deko), aussen der Zaun (Radius 50).
CombConfig.SPAWN_RADIUS_MIN = 8
CombConfig.SPAWN_RADIUS_MAX = 44

-- Mindestabstand zwischen zwei Waben beim Entstehen.
CombConfig.SPAWN_MIN_DISTANCE = 4.5

-- Anteil goldener Waben und wie viel sie wert sind (in Wabeneinheiten, eine
-- normale Wabe ist 1).
CombConfig.GOLD_CHANCE = 0.08
CombConfig.GOLD_UNITS  = 5

--------------------------------------------------------------------------------
-- Wabenthemen (je Event, siehe CombService.setTheme)
--------------------------------------------------------------------------------
-- Ein Event kann den Waben im Pit fuer seine Dauer ein THEMA geben: anderes
-- Aussehen, anderer Wert, schnellerer Nachschub, mehr Slots, staerkere
-- Tragebremse. Der Wert wird beim AUFHEBEN festgeschrieben: wer bei
-- Event-Ende noch Lava-Waben traegt, gibt sie als Lava-Waben ab.
--
-- Schluessel = Event-id (EventConfig) bzw. Thema-id. Fehlt ein Eintrag, laeuft
-- das Event mit normalen Waben. Bewusst nur Hot Egg (Lava) und die
-- Wespenkoenigin (Koenigsgelee, Phase 2) — weitere Events koennen spaeter
-- ein Thema bekommen, ohne dass Code dazukommt.
export type CombTheme = {
	bodyColor      : Color3,
	cellColor      : Color3,
	goldBodyColor  : Color3,
	goldCellColor  : Color3,
	bodyMaterial   : Enum.Material,
	cellMaterial   : Enum.Material,
	valueFactor    : number,    -- Einheiten je Wabe (normal 1, Gold GOLD_UNITS) mal diesem Faktor
	spawnRateFactor: number,    -- Nachfuellen freier Slots so viel schneller
	limit          : number,    -- Slot-Zahl waehrend des Themas
	slowPerComb    : number?,   -- Tragebremse je Wabe dieses Themas (sonst SLOW_PER_COMB)
	burstColor     : Color3,    -- Farbe des Funken-Bursts beim Skin-Wechsel
}

CombConfig.THEMES = {
	-- Hot Egg: Vulkan-Waben. Basalt-Platte, glühende Zelle, dreifacher Wert
	-- (Lava-Gold 15), doppelt so schneller Nachschub, 60 Slots, schwerer.
	HotEgg = {
		bodyColor       = Color3.fromRGB( 58,  52,  50),
		cellColor       = Color3.fromRGB(255, 110,  30),
		goldBodyColor   = Color3.fromRGB( 90,  70,  50),
		goldCellColor   = Color3.fromRGB(255, 200,  80),
		bodyMaterial    = Enum.Material.Slate,
		cellMaterial    = Enum.Material.Neon,
		valueFactor     = 3,
		spawnRateFactor = 2,
		limit           = 60,
		slowPerComb     = 0.035,
		burstColor      = Color3.fromRGB(255, 120, 40),
	},
	-- Wespenkoenigin, Phase 2: Koenigsgelee. Cremig-weisse Waben, doppelter
	-- Wert; Slots und Tempo wie normal (der Waben-Regen des Bosses liefert sie).
	WaspQueen = {
		bodyColor       = Color3.fromRGB(250, 238, 200),
		cellColor       = Color3.fromRGB(255, 214,  90),
		goldBodyColor   = Color3.fromRGB(255, 230, 150),
		goldCellColor   = Color3.fromRGB(255, 255, 220),
		bodyMaterial    = Enum.Material.SmoothPlastic,
		cellMaterial    = Enum.Material.Neon,
		valueFactor     = 2,
		spawnRateFactor = 1,
		limit           = 40,
		slowPerComb     = nil,
		burstColor      = Color3.fromRGB(255, 230, 140),
	},
} :: { [string]: CombTheme }

-- Fliegende Waben (Vulkan-Ausbruch, Waben-Regen): Flugzeit und Bogenhoehe.
-- Erst nach der Landung lassen sie sich aufheben.
CombConfig.FLIGHT_SECONDS     = 1.4
CombConfig.FLIGHT_ARC_HEIGHT  = 18
-- Waben-Regen faellt aus dieser Hoehe ueber dem Landepunkt.
CombConfig.RAIN_DROP_HEIGHT   = 45

-- Funken-Burst beim Skin-Wechsel: EIN Emitter in der Pit-Mitte, so viele Funken.
CombConfig.THEME_BURST_COUNT  = 60

function CombConfig.getTheme(themeId: string?): CombTheme?
	if not themeId then return nil end
	return CombConfig.THEMES[themeId]
end

-- Wert einer Wabe in Einheiten (normal/Gold, mal Thema-Faktor).
function CombConfig.getUnits(isGold: boolean, themeId: string?): number
	local base = if isGold then CombConfig.GOLD_UNITS else 1
	local theme = CombConfig.getTheme(themeId)
	return base * (if theme then theme.valueFactor else 1)
end

-- Tragebremse einer Wabe dieses Themas.
function CombConfig.getSlowPerComb(themeId: string?): number
	local theme = CombConfig.getTheme(themeId)
	return if theme and theme.slowPerComb then theme.slowPerComb else CombConfig.SLOW_PER_COMB
end

--------------------------------------------------------------------------------
-- Einsammeln und Tragen
--------------------------------------------------------------------------------

-- Wie oft der Server prueft, wer auf einer Wabe steht.
CombConfig.PICKUP_CHECK_SECONDS = 0.1

-- Horizontaler Abstand zur Wabe, ab dem sie aufgehoben wird (Studs), und wie
-- weit sie hoechstens ueber/unter der Spielfigur liegen darf.
CombConfig.PICKUP_RADIUS     = 3.6
CombConfig.PICKUP_MAX_HEIGHT = 7

-- Wie viele Waben ein Spieler hoechstens traegt. Ist der Stapel voll, bleiben
-- weitere liegen.
CombConfig.MAX_CARRY = 25

--------------------------------------------------------------------------------
-- Tempo im Pit
--------------------------------------------------------------------------------

-- Laufgeschwindigkeit ohne Last. Das Spiel setzt sonst nirgends WalkSpeed,
-- das ist der Roblox-Standard.
CombConfig.BASE_WALK_SPEED = 16

-- Jede getragene Wabe nimmt diesen Anteil der Grundgeschwindigkeit (nicht
-- vom Rest: 25 Waben * 0.025 = 62,5 % weniger, also noch 37,5 %), nie weniger
-- als MIN_SPEED_FACTOR. Gilt NUR innerhalb des Pits.
CombConfig.SLOW_PER_COMB    = 0.025
CombConfig.MIN_SPEED_FACTOR = 0.35

--------------------------------------------------------------------------------
-- Abgabe auf der eigenen Insel
--------------------------------------------------------------------------------

-- Wer naeher als das an der Mitte SEINER Plot-Insel steht, hat die Insel
-- betreten. Etwas kleiner als MapConfig.PLOT_ISLAND_RADIUS (58), damit man
-- wirklich auf dem Gras steht und nicht noch auf dem Rand der Bruecke.
CombConfig.DELIVER_RADIUS = 54

--------------------------------------------------------------------------------
-- Optik der Wabe (Studs)
--------------------------------------------------------------------------------

-- Sechseck mit Umkreisradius R aus drei sich kreuzenden Platten: je 2R lang und
-- R*sqrt(3) breit, um 0, 60 und 120 Grad gedreht. Das ergibt exakt ein
-- regelmaessiges Sechseck, ohne dass dafuer ein Mesh noetig waere.
CombConfig.COMB_RADIUS    = 1.35
CombConfig.COMB_HEIGHT    = 0.55
CombConfig.CELL_RADIUS    = 0.72   -- die dunklere Honigzelle in der Mitte

-- Im Pit liegende Waben sind groesser, damit man sie von weitem sieht.
CombConfig.WORLD_SCALE    = 1.45
CombConfig.WORLD_HOVER    = 1.6    -- Hoehe ueber dem Boden

-- Stapel ueber dem Kopf: Abstand zwischen zwei Waben und Luft ueber dem Kopf.
CombConfig.STACK_STEP     = 0.62
CombConfig.STACK_HEAD_GAP = 0.9
-- Jede Wabe sitzt leicht versetzt/verdreht, damit der Turm wackelig-niedlich
-- aussieht statt wie eine Saeule. Ab der Wabe-Nummer wiederholt sich das Muster.
CombConfig.STACK_WOBBLE_STUDS   = 0.16
CombConfig.STACK_WOBBLE_DEGREES = 14

CombConfig.COMB_COLOR       = Color3.fromRGB(240, 186,  64)
CombConfig.CELL_COLOR       = Color3.fromRGB(214, 128,  28)
CombConfig.GOLD_COMB_COLOR  = Color3.fromRGB(255, 226, 110)
CombConfig.GOLD_CELL_COLOR  = Color3.fromRGB(255, 250, 190)

--------------------------------------------------------------------------------
-- Der Recycler
--------------------------------------------------------------------------------

-- v15: Level 1-60 wie die Honig-Gebaeude (gleiche Look-Stufen, siehe
-- BuildingBehavior.getLook; Faehigkeiten in BuildingBehavior.MILESTONES.Recycler).
CombConfig.RECYCLER_MAX_LEVEL = EconomyConfig.MAX_BUILDING_LEVEL

-- Gummies pro Wabeneinheit (VOR dem Rebirth-Multiplikator), je Recycler-Level.
-- Level 1-10 unveraendert; ab Level 11 waechst der Ertrag mit PAY_GROWTH pro
-- Level weiter (getPayPerUnit).
CombConfig.PAY_PER_UNIT = {
	[1]  = 3,
	[2]  = 5,
	[3]  = 8,
	[4]  = 13,
	[5]  = 21,
	[6]  = 34,
	[7]  = 55,
	[8]  = 90,
	[9]  = 145,
	[10] = 240,
} :: { [number]: number }

-- v15: Zuwachs des Ertrags pro Level ab Level 11 (Level 60 = 240 x 1.12^50 ≈
-- 69.000 je Einheit). ANNAHME, kalibriert mit tools/sim/progression_pacing.lua.
CombConfig.PAY_GROWTH = 1.12

-- Wabeneinheiten pro Sekunde, die der Recycler verarbeitet: Level 1 braucht
-- fuer einen vollen Stapel gut eine Minute, Level 10 ist in unter 10 s durch.
-- v15: danach linear weiter bis SPEED_LEVEL_60 (ein Stapel in ~4 s).
CombConfig.SPEED_LEVEL_1   = 0.4
CombConfig.SPEED_LEVEL_10  = 3.0
CombConfig.SPEED_LEVEL_60  = 6.0

-- Wie lange der Recycler offline hoechstens weiterarbeitet (Sekunden). Es kann
-- ohnehin nur die Warteschlange abgearbeitet werden, der Deckel schuetzt nur vor
-- Zeitmarken aus einer fernen Vergangenheit.
CombConfig.OFFLINE_MAX_SECONDS = 8 * 3600

-- Abstand der Zahlungs-Ticks auf dem Server.
CombConfig.RECYCLER_TICK_SECONDS = 1.0

--------------------------------------------------------------------------------
-- Der Recycler in der Welt (PLOT-LOKAL, siehe Kopf von MapConfig)
--------------------------------------------------------------------------------

-- Ganz vorne auf dem Gras der Plot-Insel: zwischen Wasserkante und Beet, auf der
-- Seite, von der der Spieler aus der Weltmitte kommt (lokales -Z). Das Beet
-- beginnt bei Z = -36, die Insel endet bei Z = -58. X seitlich neben der Bruecke
-- (die liegt auf X = 0), damit man beim Hereinlaufen nicht dagegen stoesst.
CombConfig.RECYCLER_OFFSET = Vector3.new(15, 0, -47)

-- Grosse des unsichtbaren Koerpers (Traeger fuer Name, Schild und Prompt).
CombConfig.RECYCLER_BODY_SIZE = Vector3.new(9, 8, 9)

CombConfig.RECYCLER_NAME = "Recycler"

-- Farbe der Betriebs-Lampe
CombConfig.LAMP_IDLE_COLOR   = Color3.fromRGB(190, 70, 60)
CombConfig.LAMP_ACTIVE_COLOR = Color3.fromRGB(90, 235, 110)

local UPRIGHT    = Vector3.new(0, 0, 90)
local WOOD       = Color3.fromRGB(160, 110, 65)
local WOOD_DARK  = Color3.fromRGB(118,  80,  46)
local METAL      = Color3.fromRGB(150, 152, 158)
local METAL_DARK = Color3.fromRGB( 96,  99, 106)
local GREEN      = Color3.fromRGB( 84, 178,  96)

-- Aussehen (Gebaeude-lokal, wie MapConfig.BUILDING_DECOR: Ursprung = Mitte der
-- Grundflaeche, +Y oben, -Z zur Weltmitte). Ein Trichter, in den die Waben
-- fallen, ein Maschinenkasten mit gruenem Recycling-Band, ein Auslaufrohr nach
-- vorne und die Betriebs-Lampe. "Lampe" wird vom Builder gefaerbt.
CombConfig.RECYCLER_DECOR = {
	{ name = "Sockel",     shape = Enum.PartType.Block,    size = Vector3.new(9.0, 1.2, 9.0),  offset = Vector3.new(0, 0.60, 0),     color = METAL_DARK, material = Enum.Material.Metal, solid = true },
	{ name = "Kasten",     shape = Enum.PartType.Block,    size = Vector3.new(7.0, 4.4, 7.0),  offset = Vector3.new(0, 3.40, 0),     color = WOOD,       material = Enum.Material.Wood, solid = true },
	{ name = "BandVorne",  shape = Enum.PartType.Block,    size = Vector3.new(7.2, 1.0, 7.2),  offset = Vector3.new(0, 3.40, 0),     color = GREEN,      material = Enum.Material.SmoothPlastic },
	{ name = "Deckel",     shape = Enum.PartType.Block,    size = Vector3.new(7.6, 0.7, 7.6),  offset = Vector3.new(0, 5.95, 0),     color = WOOD_DARK,  material = Enum.Material.Wood, solid = true },
	{ name = "TrichterU",  shape = Enum.PartType.Cylinder, size = Vector3.new(1.4, 4.2, 4.2),  offset = Vector3.new(0, 6.90, 0),     color = METAL,      material = Enum.Material.Metal, rotation = UPRIGHT, solid = true },
	{ name = "TrichterM",  shape = Enum.PartType.Cylinder, size = Vector3.new(1.4, 5.6, 5.6),  offset = Vector3.new(0, 8.10, 0),     color = METAL,      material = Enum.Material.Metal, rotation = UPRIGHT, solid = true },
	{ name = "TrichterO",  shape = Enum.PartType.Cylinder, size = Vector3.new(1.2, 7.0, 7.0),  offset = Vector3.new(0, 9.30, 0),     color = METAL,      material = Enum.Material.Metal, rotation = UPRIGHT, solid = true },
	{ name = "Fuellung",   shape = Enum.PartType.Cylinder, size = Vector3.new(0.3, 5.8, 5.8),  offset = Vector3.new(0, 9.85, 0),     color = Color3.fromRGB(240, 186, 64), material = Enum.Material.Neon, rotation = UPRIGHT },
	{ name = "Rohr",       shape = Enum.PartType.Cylinder, size = Vector3.new(3.0, 1.5, 1.5),  offset = Vector3.new(0, 2.40, -4.9), color = METAL_DARK, material = Enum.Material.Metal, rotation = Vector3.new(0, 90, 0) },
	{ name = "Lampe",      shape = Enum.PartType.Ball,     size = Vector3.new(1.3, 1.3, 1.3),  offset = Vector3.new(-2.4, 6.9, -2.4), color = Color3.fromRGB(190, 70, 60), material = Enum.Material.Neon },
} :: { MapConfig.DecorPiece }

-- v15: Look-Zusaetze des Recyclers (Platzhalter bis Prompt 4), Regeln wie
-- MapConfig.BUILDING_LOOK_DECOR: gebaut wird RECYCLER_DECOR plus alle Zusaetze
-- bis zum aktuellen Look (getDecor). Gleiche Look-Stufen wie die Gebaeude.
local GOLD_TRIM  = Color3.fromRGB(255, 205,  70)
local GLOW_GREEN = Color3.fromRGB(110, 255, 150)
local CRYSTAL    = Color3.fromRGB(150, 225, 255)
local PENNANT    = Color3.fromRGB(220,  70,  60)

CombConfig.RECYCLER_LOOK_DECOR = {
	[2] = {
		{ name = "L2Stab",     shape = Enum.PartType.Block,    size = Vector3.new(0.3, 3.0, 0.3),  offset = Vector3.new(-4.1, 1.50,  4.1), color = WOOD_DARK, material = Enum.Material.Wood },
		{ name = "L2Wimpel",   shape = Enum.PartType.Block,    size = Vector3.new(0.1, 1.0, 1.6),  offset = Vector3.new(-4.1, 2.50,  3.3), color = PENNANT },
	},
	[3] = {
		{ name = "L3Goldkante", shape = Enum.PartType.Block,   size = Vector3.new(9.4, 0.3, 9.4),  offset = Vector3.new(0, 1.35, 0), color = GOLD_TRIM, material = Enum.Material.Neon },
	},
	[4] = {
		{ name = "L4Krone",    shape = Enum.PartType.Cylinder, size = Vector3.new(0.5, 7.6, 7.6),  offset = Vector3.new(0, 10.15, 0), color = GOLD_TRIM, material = Enum.Material.Metal, rotation = UPRIGHT },
	},
	[5] = {
		{ name = "L5Glut1",    shape = Enum.PartType.Block,    size = Vector3.new(0.2, 3.6, 5.0),  offset = Vector3.new( 3.6, 3.40, 0), color = GLOW_GREEN, material = Enum.Material.Neon },
		{ name = "L5Glut2",    shape = Enum.PartType.Block,    size = Vector3.new(0.2, 3.6, 5.0),  offset = Vector3.new(-3.6, 3.40, 0), color = GLOW_GREEN, material = Enum.Material.Neon },
	},
	[6] = {
		{ name = "L6Kristall1", shape = Enum.PartType.Block,   size = Vector3.new(1.2, 2.4, 1.2),  offset = Vector3.new( 3.9, 2.40,  3.9), color = CRYSTAL, material = Enum.Material.Glass, rotation = Vector3.new(0, 45, 0) },
		{ name = "L6Kristall2", shape = Enum.PartType.Block,   size = Vector3.new(1.2, 2.4, 1.2),  offset = Vector3.new(-3.9, 2.40, -3.9), color = CRYSTAL, material = Enum.Material.Glass, rotation = Vector3.new(0, 45, 0) },
	},
} :: { [number]: { MapConfig.DecorPiece } }

-- Grund-Deko + Zusaetze bis zu diesem Look.
function CombConfig.getDecor(look: number): { MapConfig.DecorPiece }
	return MapConfig.combineLookDecor(CombConfig.RECYCLER_DECOR, CombConfig.RECYCLER_LOOK_DECOR, look)
end

-- v15: Faehigkeit "Sammelradius" (BuildingBehavior.MILESTONES.Recycler): ab dem
-- Freischalt-Level hebt der Spieler Waben aus so viel groesserem Abstand auf.
CombConfig.COLLECT_RADIUS_FACTOR = 1.6

--------------------------------------------------------------------------------
-- Rechen-Hilfen (Server UND Client benutzen dieselben, damit Anzeige und
-- Auszahlung nicht auseinanderlaufen)
--------------------------------------------------------------------------------

function CombConfig.clampLevel(level: number): number
	return math.clamp(math.floor(level), 1, CombConfig.RECYCLER_MAX_LEVEL)
end

-- 12.10. (Playtest "Recycler viel zu schwach, soll nur einen
-- Geldmultiplikator zeigen"): Jede Wabeneinheit hat einen GRUNDWERT, das
-- Recycler-Level ist ein MULTIPLIKATOR darauf. Die Kurve bleibt die alte
-- (PAY_PER_UNIT / PAY_GROWTH, geteilt durch den alten Level-1-Wert 3),
-- der Grundwert steigt von 3 auf BASE_PAY_PER_UNIT: alles x3,3. ANNAHME —
-- progression_pacing.lua rechnet den Recycler nicht mit; im Playtest pruefen.
CombConfig.BASE_PAY_PER_UNIT = 10

-- Auszahlung SOFORT bei der Abgabe statt nach und nach (Warteschlange,
-- getSpeed). Aus = alter Ablauf ueber Zeitmarke.
CombConfig.INSTANT_PAYOUT = true

local function legacyPay(clamped: number): number
	local fixed = CombConfig.PAY_PER_UNIT[clamped]
	if fixed then return fixed end
	local last = CombConfig.PAY_PER_UNIT[10] or 1
	return last * CombConfig.PAY_GROWTH ^ (clamped - 10)
end

-- Multiplikator auf den Grundwert bei diesem Level (Level 1 = x1). Unter 10
-- auf eine Nachkommastelle, darueber ganze Zahlen — so steht er auch am Schild.
function CombConfig.getMultiplier(level: number): number
	local clamped = CombConfig.clampLevel(level)
	local raw = legacyPay(clamped) / (CombConfig.PAY_PER_UNIT[1] or 1)
	if raw < 10 then
		return math.floor(raw * 10 + 0.5) / 10
	end
	return math.floor(raw + 0.5)
end

-- Gummies pro Wabeneinheit auf diesem Level, vor dem Rebirth-Multiplikator:
-- Grundwert x Multiplikator.
function CombConfig.getPayPerUnit(level: number): number
	return math.floor(CombConfig.BASE_PAY_PER_UNIT * CombConfig.getMultiplier(level) + 0.5)
end

-- Anzeige "x12" / "x2,5" (sprachneutral, Komma nur bei Nachkommastelle).
function CombConfig.formatMultiplier(level: number): string
	local m = CombConfig.getMultiplier(level)
	if m >= 1e6 then return (string.format("×%.1fM", m / 1e6):gsub("%.0M", "M")) end
	if m >= 1e4 then return string.format("×%dK", math.floor(m / 1000 + 0.5)) end
	if m == math.floor(m) then return string.format("×%d", m) end
	return (string.format("×%.1f", m):gsub("%.", ","))
end

-- Wabeneinheiten pro Sekunde: linear Level 1 -> 10, danach linear 10 -> 60.
function CombConfig.getSpeed(level: number): number
	local clamped = CombConfig.clampLevel(level)
	if clamped <= 10 then
		return CombConfig.SPEED_LEVEL_1
			+ (CombConfig.SPEED_LEVEL_10 - CombConfig.SPEED_LEVEL_1) * ((clamped - 1) / 9)
	end
	local span = math.max(1, CombConfig.RECYCLER_MAX_LEVEL - 10)
	return CombConfig.SPEED_LEVEL_10
		+ (CombConfig.SPEED_LEVEL_60 - CombConfig.SPEED_LEVEL_10) * ((clamped - 10) / span)
end

-- Kosten fuer den Ausbau AUF `targetLevel`; nil = es gibt dieses Level nicht.
-- Gleiche Kurve wie die Honig-Gebaeude (EconomyConfig.HONEY_UPGRADE_COSTS).
function CombConfig.getUpgradeCost(targetLevel: number): { gummies: number, goldGummies: number }?
	if targetLevel < 2 or targetLevel > CombConfig.RECYCLER_MAX_LEVEL then return nil end
	return EconomyConfig.HONEY_UPGRADE_COSTS[targetLevel]
end

-- Sekunden zwischen Abgabe und Respawn bei diesem Recycler-Level (Hook, siehe
-- RECYCLER_DELAY_FACTOR; mit Faktor 1 immer RESPAWN_DELAY_SECONDS).
function CombConfig.getRespawnDelay(recyclerLevel: number): number
	local steps = CombConfig.clampLevel(recyclerLevel) - 1
	return CombConfig.RESPAWN_DELAY_SECONDS * (CombConfig.RECYCLER_DELAY_FACTOR ^ steps)
end

-- Was ein VOLLER Stapel normaler Waben auf diesem Level ungefaehr bringt
-- (ohne goldene Waben und ohne Rebirth-Multiplikator). Nur fuer Anzeigen.
function CombConfig.estimateFullStackPay(level: number): number
	return CombConfig.MAX_CARRY * CombConfig.getPayPerUnit(level)
end

return CombConfig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX5"><Properties>
<string name="Name">FeatureFlags</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- FeatureFlags.luau
-- ReplicatedStorage/Config/FeatureFlags.luau
--
-- Einzige Zustaendigkeit:
--   - Schalter fuer jede sichtbare Aenderung aus dem Honey-Bear-Brawl-Plan
--
-- Jede neue Anzeige haengt an genau einem Schalter. `true` = neuer Weg,
-- `false` = das Spiel verhaelt sich wie vor dem jeweiligen Paket. So bleibt
-- jede Aenderung einzeln zuruecknehmbar, ohne Code anzufassen.
--
-- Liegt in ReplicatedStorage, weil Server UND Client dieselbe Antwort brauchen
-- (z.B. Boss-Stufen: Server zahlt aus, Client zeigt die Truhe).
--
-- Ein unbekannter Name ist ein Tippfehler. In Studio bricht isOn dann mit
-- einem Fehler ab, damit er sofort auffaellt; im Live-Spiel gilt der Schalter
-- still als aus, damit ein Tippfehler keinen Server abstuerzen laesst.

local RunService = game:GetService("RunService")

local FLAGS: { [string]: boolean } = {
	-- Paket 1: Icons und Zahlen statt Text-Toasts
	UI_V2_FEEDBACK    = true,
	-- Paket 2: Beam-Fuehrung, Quest-Tracker mit Icons, ruhige Dialoge
	UI_V2_GUIDE       = true,
	-- Paket 3: Elemente erscheinen erst, wenn man sie braucht
	UI_V2_PROGRESSIVE = true,
	-- Paket 4: Upgrade-Tab, Kampfwert-Zahl, Rarity-Baender
	UI_V2_UPGRADE_TAB = true,

	-- Paket 5: Map ohne Umbau
	MAP_V2_MERCHANT   = true,
	MAP_V2_HOME       = true,
	MAP_V2_SHOWCASE   = true,
	MAP_V2_BOARDS     = true,
	MAP_V2_ARENA_SPRINT = true,   -- Baerchi sprintet zur Arena und zurueck
	-- Paket 6
	MAP_V2_LIVE_BOARD = true,
	MAP_V2_WASP_NEST  = true,
	EVENT_V2_TIMER    = true,

	-- Honig-Teich statt Stock + Veredler: EIN Gebaeude, Looks bis zum
	-- Honig-Springbrunnen, Baerchi wohnt am Becken (kein Hin- und Herlaufen).
	-- Bericht: docs/HBB_HONIG_TEICH_2026-10-05.md
	HONEY_POND_V2      = true,

	-- Entscheidung 05.10.: Laeufe starten immer bei Stage 1. Ab der letzten
	-- Stage nur per Klick gegen Gummies (kleines Feld, 7 s, UI/FightStartPrompt).
	FIGHT_RESUME_PROMPT = true,

	-- HBB Paket 10: Shop mit Gratis-Griff (GoldGummies) und Robux-Paketen
	-- (Pakete erst sichtbar, wenn ShopConfig eine Product-ID hat).
	-- Bericht: docs/HBB_PAKET_10_SHOP_2026-10-05.md
	SHOP_V1            = true,

	-- Playtest 05.10.: Basis-Eier (unbegrenzt beim Haendler) nicht pressbar
	PRESS_NO_BASIC_EGG = true,

	-- Paket 7: Boss-Belohnung nach Stufen
	BOSS_TIERS        = true,

	-- GoldGummies nur noch aus Tages-Quests (spaeter: Gratis-Griff im Shop)
	-- und nur noch fuer Charms. Keine Gold-Kosten bei Gebaeuden/Recycler, kein
	-- Gold aus Tower-Laeufen, Meilensteinen oder Login-Bonus.
	-- Bericht: docs/HBB_GOLD_NUR_CHARMS_2026-10-05.md
	GOLD_CHARMS_ONLY  = true,

	-- Paket 8/9: neue Pacing-Werte. Bleibt aus, bis der Mensch die Tabelle
	-- freigegeben hat (Stopp-Punkt im Plan).
	PACING_V2         = false,
	-- Paket 9: Endless-Tower (Stage 101+), freigegeben 05.10.
	-- Bericht: docs/HBB_PAKET_9_ENDLESS_2026-10-05.md
	ENDLESS           = true,

	-- Sammel-Update 05.10. (docs/SAMMEL_UPDATE_UMGESETZT_2026-10-05.md):
	-- Paket 8: Inkubator auf dem Plot. Aus = Eier gehen wie vorher sofort auf,
	-- der Inkubator wird weder gebaut noch angeboten.
	INCUBATOR         = true,
	-- Paket 7: Index-Belohnungen (Abholen im Index).
	INDEX_REWARDS     = true,
	-- Paket 5.2: Kampf um die Mitte — gegnerische Event-Baerchis stossen
	-- Spieler ohne eigenen Baerchi im Event-Pit.
	PIT_BRAWL         = true,
	-- Paket 3.8: Bereichs-Schilder (zwei Woerter) auf der Hauptinsel.
	AREA_SIGNS        = true,
	-- Wunsch 05.10.: Baerchi darf mehrmals ins selbe UFO; nach dem Absetzen
	-- ist sein Level fuer EventConfig.UFO.DROP_WEAKEN_SECONDS halbiert.
	-- Aus = wie vorher (wer schon an Bord war, geht heim).
	UFO_REJOIN        = true,
	-- Wunsch 05.10.: aufgeraeumtes HUD. Honig-Brunnen nur vor Ort verbessern
	-- (E, kein Fenster, Schild mit Level und Preis), keine Kacheln "Verbessern"
	-- und "Inkubator" mehr, Quests als kleiner Knopf neben dem Zahnrad, Shop
	-- daneben (eine Zeile), groessere Kacheln rechts.
	HUD_ROW_V2        = true,
	-- Wunsch 05.10.: Inkubator = Baerchi hineinsetzen, er bruetet je nach
	-- Rarity im Takt zusaetzliche Eier (IncubatorConfig.BREED_*). Eier gehen
	-- wieder sofort auf (kein Brueten von Eiern mehr). Aus = Ei-Inkubator wie
	-- im Sammel-Update.
	INCUBATOR_BREED   = true,
	-- Welt aufwerten (08.10.2026), je Paket ein Schalter. Reine Client-Optik.
	-- Paket A (Tageslauf) haengt am Schalter AmbienceConfig.DAY_CYCLE.
	-- Bericht: claude/WELT_AUFGEWERTET_UMGESETZT_2026-10-09.md
	WORLD_B_WATER     = true,   -- Glitzern, Schaum, Arena-Kueste, Fisch, Bojen
	WORLD_C_HUB       = true,   -- Mastkrone, Honigfaden, Ankunft, Wegweiser, Pit-Rahmen, Haendler, Nest, Tafeln
	WORLD_D_PLOTS     = true,   -- Insel-Stufen, Teich-Glanz/Ueberlauf, eigene Insel, leere Inseln
	WORLD_E_ARENA     = true,   -- Steg-Laternen, Torbogen, Zuschauer, Flagge am Schau-Turm
	WORLD_F_LIFE      = true,   -- Bienen, Schmetterlinge, Blumen im Wind, Pollenfarbe, Pfotenabdruecke
	WORLD_G_MOMENTS   = true,   -- Welt-Momente: Lichtsaeule, Feuerwerk, Welle, Spirale, Event-Glocke
	WORLD_H_SOUND     = true,   -- Klang-Kulisse nach Zonen (laeuft nur mit gepruefter Sound-ID)
	WORLD_I_ZONES     = true,   -- Licht-Feinschliff nach Zonen (Insel / Arena / Turm)

	-- 08.10. (Tower-Terminal): Tower N+1 oeffnet, sobald Tower N geschafft ist
	-- (Rekord >= Stage-Zahl), statt ueber Rebirths. Der Deckel pro Rebirth
	-- begrenzt dann nichts mehr. Aus = alte Regel (STAGE_CAP_BY_REBIRTH).
	TOWER_UNLOCK_BY_CLEAR = true,
	-- 12.10. (Playtest): die Freischaltung gilt pro LEBEN. Ein Rebirth setzt
	-- sie zurueck (towers.unlocked = { I }), gezaehlt wird die beste Stage
	-- dieses Lebens (island.stageBest), nicht der Rekord. Sonst kaempft ein
	-- Level-1-Baerchi direkt nach dem Rebirth in Tower II. Aus = Rekorde
	-- oeffnen fuer immer (Stand 08.10.).
	TOWER_UNLOCK_PER_LIFE = true,
	-- 12.10. (Playtest): Fusion vorerst nur von der Karte des einzelnen
	-- Baerchis ("Staerker machen"). Aus = kein "Fusion: an/aus"-Knopf in der
	-- Sammlung; waehrend einer Fusions-Auswahl steht dort "Abbrechen".
	FUSION_INVENTORY_TOGGLE = false,
	-- 08.10.: Tower-Terminal an der Bruecke (Paket B2)
	TOWER_TERMINAL    = true,
	-- 08.10.: neues Tower-Panel im Look Theme.v2 (Paket D); aus = altes CombatPanel
	TOWER_PANEL_V2    = true,
}

local FeatureFlags = {}

FeatureFlags.FLAGS = FLAGS

function FeatureFlags.isOn(name: string): boolean
	local value = FLAGS[name]
	if value == nil then
		if RunService:IsStudio() then
			error("[FeatureFlags] Unbekannter Schalter: " .. tostring(name), 2)
		end
		return false
	end
	return value
end

return FeatureFlags
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX6"><Properties>
<string name="Name">MapConfig</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- MapConfig.luau
-- ReplicatedStorage/Config/MapConfig.luau
--
-- Alle Positionen, Groessen und visuellen Werte fuer die Map.
-- MapService hat keine einzige hardcodierte Zahl.
--
-- ============================================================
-- WELT-AUFBAU: INSELN IM WASSER
-- ============================================================
-- Drei Ringe aus Inseln, alle mit Holzstegen verbunden, rundherum Wasser:
--
--                        (A)
--                         |
--                        [P]
--                         |
--             (A)—[P]— (( C )) —[P]—(A)      8 mal, alle 45 Grad
--                         |
--                        [P]
--                         |
--                        (A)
--
--   (( C ))  Hauptinsel: Spawn, Honigmast, freie Karo-Wiese. Hier landen
--            alle und hier laufen sich alle ueber den Weg.
--   [P]      Plot-Insel: eine pro Spieler, mit dem eigenen Beet, den drei
--            Gebaeuden und dem Honig-Teich.
--   (A)      Arena-Insel: die eigene PIT-Arena, ein Stueck weiter draussen.
--
-- WARUM INSELN STATT EINER PLATTFORM
-- Vorher war alles eine einzige 480 Studs breite Scheibe, auf der die Plots
-- als Rechtecke lagen. Das las sich aus der Spielerkamera als eine grosse
-- gruene Flaeche mit Markierungen darauf — man sah nicht, wo der eigene
-- Bereich anfaengt. Getrennte Inseln beantworten das ohne ein einziges
-- Schild: was zu mir gehoert, ist das, was am Ende MEINES Stegs liegt.
--
-- Alle drei Abstaende sind derselbe Wert (ISLAND_GAP) und damit auch alle
-- Stege gleich lang. Ein Steg ueberbrueckt IMMER genau eine Luecke — es gibt
-- keine zweite Laengen-Zahl mehr, die davon abweichen koennte.
--
-- Die Wiese ist KARIERT (zwei Gruentoene). Gebaut wird nur die helle Haelfte
-- als flache Teile auf der dunklen Inselscheibe; das Raster liegt in
-- Weltkoordinaten, laeuft also ueber alle Inseln durch. Die frueheren
-- Lego-Noppen sind dafuer weg: Noppen UND Karos uebereinander ergeben nur
-- Unruhe, und das Karo ist das, was die Flaeche gliedert.
--
-- ============================================================
-- PLOT-LOKALES KOORDINATENSYSTEM (wichtig!)
-- ============================================================
-- Jeder Plot bekommt in MapService ein eigenes CFrame, das zur Plattform-
-- MITTE schaut. Alle Offsets hier unten sind deshalb LOKAL zu diesem Plot:
--
--     lokales -Z  = Richtung Plattform-Mitte
--     lokales +Z  = nach aussen (Richtung Rand → Bruecke → PIT)
--     lokales +X  = seitlich (rechts, wenn man vom Plot zur Mitte schaut)
--
-- Nur dadurch stehen die Gebaeude bei allen 8 Winkeln richtig herum statt
-- verdreht. Das Y in den Offsets ist eine ZUSATZ-Hoehe ueber dem Plot-Boden;
-- die eigentliche Standhoehe rechnet MapService selbst aus der jeweiligen
-- Teilegroesse aus, damit nichts schwebt oder im Boden steckt.

--------------------------------------------------------------------------------
-- Hauptinsel, Wasser, Karo-Wiese
--------------------------------------------------------------------------------

local CENTER = Vector3.new(0, 0, 0)

-- Oberkante JEDER Insel. Alles andere wird relativ dazu berechnet —
-- die Welt laesst sich damit an einer einzigen Zahl hoch/runter schieben.
local PLATFORM_TOP_Y = 0

-- War 150. Von der eigenen Plot-Insel bis zur Mitte war das ein spuerbar
-- langer Fussmarsch quer ueber die Hauptinsel — genau die Strecke, die am
-- meisten zaehlt, weil man sie bei jedem Ei, jedem Ausruesten und jedem
-- Rebirth-Blick zur Mitte zuruecklegt. 120 kuerzt das um ein Fuenftel, ohne
-- die Hauptinsel eng wirken zu lassen (das Spawn-Pad ist 24 Studs breit,
-- bleibt also weiterhin ein kleiner Punkt darauf).
local PLATFORM_RADIUS = 120

-- Wie dick eine Insel ist. Sie steckt damit sichtbar im Wasser statt wie eine
-- Scheibe darauf zu liegen — bei 16 Studs sieht man von der Kamerahoehe eines
-- Spielers eine richtige Kante, keinen Strich.
local ISLAND_HEIGHT = 16

-- Abstand zwischen zwei Inseln UND damit die Laenge jedes Stegs. Ein Steg
-- ueberbrueckt immer genau eine Luecke, deshalb gibt es nur diese eine Zahl.
-- War 44 (rund drei Sekunden bei WALK_SPEED). 34 bleibt immer noch lang genug,
-- dass die Inseln spuerbar getrennt wirken, kuerzt aber jede der beiden
-- Bruecken pro Weg (Hauptinsel→Plot, Plot→Arena) um gut zwei Sekunden.
local ISLAND_GAP = 34

-- ============================================================
-- KARO-WIESE
-- ============================================================
-- Zwei Gruentoene im Schachbrett. Gebaut werden NUR die hellen Felder als
-- flache Teile — die dunkle Haelfte ist die Inselscheibe selbst. Das halbiert
-- die Teilezahl gegenueber "jedes Feld ein Teil" bei exakt demselben Bild.
--
-- GRASS_TILE gilt fuer die ganze Welt, und das Raster liegt in WELT-
-- Koordinaten mit Ursprung im Weltmittelpunkt: die Karos laufen dadurch ueber
-- alle Inseln durch, statt auf jeder neu anzusetzen. Nur die Plot-Beete
-- rastern plot-lokal (siehe unten) — sonst laege das Karo auf einem gedrehten
-- Beet schief.
--
-- 24 Studs sind bewusst gross: bei 12 wirkt die Wiese aus der Spielerkamera
-- wie ein Muster statt wie Felder, und die Teilezahl vervierfacht sich.
--
-- Das Beet auf der Plot-Insel rastert FEINER (PLOT_GRASS_TILE). Es ist die
-- Flaeche, auf der man selbst steht und auf die man die ganze Zeit schaut;
-- 24er-Felder waeren darauf nur drei Reihen und wuerden gar nicht mehr als
-- Karo lesen. Dieselbe Ueberlegung wie bei einem Teppich gegenueber einer
-- Wiese. 72 / 18 geht glatt auf, es bleibt kein Reststreifen an einer Kante.
local GRASS_TILE      = 24
local PLOT_GRASS_TILE = 18
local GRASS_HEIGHT    = 0.08   -- wie weit ein helles Feld ueber der Scheibe liegt
local GRASS_DARK      = Color3.fromRGB( 58, 140,  62)
local GRASS_LIGHT     = Color3.fromRGB( 92, 178,  82)

-- Sandkante am Wasser: eine BREITERE Scheibe, die ein Stueck tiefer liegt.
-- Ringsum bleibt dadurch ein Sandstreifen sichtbar, ohne dass dafuer ein Ring
-- aus Einzelteilen gebaut werden muesste.
--
-- SHORE_DROP und WATER_DROP bilden zusammen eine Treppe: Wiese 0, Sand -1,
-- Wasser -2.6. Beide Stufen sind niedrig genug, dass eine Roblox-Figur sie
-- ohne Springen hochgeht — wer ins Wasser faellt, laeuft einfach zurueck an
-- Land. Waeren sie hoeher, waere jeder Fehltritt eine Sackgasse.
local SHORE_WIDTH = 8
local SHORE_DROP  = 1.0
local SHORE_COLOR = Color3.fromRGB(238, 214, 158)

-- Das Wasser ist EINE grosse Scheibe unter allem.
--
-- Sie ist begehbar (CanCollide): wer vom Steg faellt, landet auf der
-- Oberflaeche und laeuft zurueck, statt ins Leere zu stuerzen. In einem Spiel,
-- in dem man staendig ueber schmale Stege laeuft, ist das die freundlichere
-- Loesung — ein Sturz waere reine Strafe ohne Spielinhalt.
--
-- WATER_RADIUS muss die aeusserste Arena mit Sandkante umschliessen; das
-- prueft MapService beim Start. War 700 — mit der kleineren Welt reicht 650
-- fuer denselben grosszuegigen Rand offenen Wassers dahinter.
local WATER_RADIUS       = 650
local WATER_DROP         = 2.6    -- wie weit unter Inselhoehe die Oberflaeche liegt
local WATER_HEIGHT       = 10
local WATER_COLOR        = Color3.fromRGB(64, 164, 214)
local WATER_TRANSPARENCY = 0.28

-- Not-Spawn in der Mitte der Wiese. Greift nur noch, wenn ein Spieler
-- ausnahmsweise KEINEN eigenen Plot bekommt (Server voll, siehe
-- MapService.spawnIsland) — der normale Weg ist seit dem Insel-Spawn
-- (siehe PLAYER_SPAWN_OFFSET unten) die eigene Insel, nicht mehr die Mitte.
-- Unsichtbar, damit sie nicht als zweiter Bodenbelag unter dem Event-Pit
-- durchscheint.
local SPAWN_SIZE = Vector3.new(10, 1, 10)
local SPAWN_COLOR = Color3.fromRGB(240, 230, 200)

-- ============================================================
-- EVENT-PIT: DER STALL IN DER MITTE
-- ============================================================
-- Ein rundes, eingezaeuntes Podest genau in der Weltmitte, unter dem
-- Honigmast. Normalerweise ein schlichter Holz-Stall — sobald ein Event
-- laeuft, faerbt EventService Boden, Zaun und Ring in dessen Farben um
-- (siehe MapService.setEventPitTheme) und die Anzeigetafel darueber zeigt
-- Name und Restzeit. Ausserhalb eines Events zeigt dieselbe Tafel den
-- Countdown bis zum naechsten (siehe MapService.setEventBanner).
--
-- Acht Zaunluecken statt einer (wie bei den Spieler-Arenen): das Pit steht
-- in der Mitte aller acht Stege, nicht am Ende von nur einem. Jede Luecke
-- liegt genau in der Aussenrichtung eines Plots — wer von seiner Bruecke
-- kommt, laeuft geradewegs hinein statt am Zaun entlang zu suchen.
--
-- Podesthoehe 2 Studs, derselbe Trick wie beim Plot-Beet (PLOT_SIZE.Y):
-- ein klarer Schritt nach oben statt eines Absenk-Tricks, niedrig genug zum
-- Hochlaufen ohne Springen.
local EVENT_PIT_RADIUS       = 50
local EVENT_PIT_FLOOR_HEIGHT = 2

-- Sicherheitsabstand zwischen dem Karo-Rasen (GRASS_HEIGHT ueber
-- PLATFORM_TOP_Y) und der Podest-Unterkante — derselbe Grundgedanke wie
-- BRIDGE_SINK/GRASS_HEIGHT selbst: ohne diesen Puffer laege die Unterkante
-- GENAU auf Rasenhoehe, und ein paar Karo-Kacheln direkt am Podestrand
-- wuerden mit der Unterkante flimmern bzw. leicht durchscheinen — genau der
-- "das Pit steckt teilweise im Boden"-Effekt. Mit dem Puffer liegt die
-- Unterkante immer sauber ueber dem Rasen, egal welche Kachel gerade
-- darunterliegt.
local EVENT_PIT_GROUND_CLEARANCE = 0.3

-- Stall-Look: gedeckte Stroh-/Holztoene, kein Glimmen. Erst ein Event macht
-- daraus etwas Auffaelliges (siehe EventConfig.EVENTS).
local EVENT_PIT_DEFAULT_FLOOR_COLOR = Color3.fromRGB(178, 150, 100)
local EVENT_PIT_DEFAULT_FENCE_COLOR = Color3.fromRGB(150, 105, 60)
local EVENT_PIT_DEFAULT_RING_COLOR  = Color3.fromRGB(120,  98,  70)

local EVENT_PIT_RING_OVERHANG = 1.6
local EVENT_PIT_RING_HEIGHT   = 0.7

local EVENT_PIT_FENCE_COUNT       = 28
local EVENT_PIT_FENCE_SIZE        = Vector3.new(1.0, 5.0, 1.0)
local EVENT_PIT_FENCE_GAP_DEGREES = 9     -- Oeffnung je Bruecken-Richtung, halber Winkel je Seite
local EVENT_PIT_FENCE_INSET       = 1.6

-- Anzeigetafel: anders als bei den Spieler-Arenen IMMER eingeblendet — sie
-- ist der einzige Ort, an dem der Event-Countdown steht.
-- Playtest 05.10.: bei 16 lag die Tafel im Honigmast (Spitze ~33) und die
-- Schrift lief durch ihn hindurch. 38 = Unterkante ueber dem Tropfen.
local EVENT_PIT_BANNER_HEIGHT   = 38
local EVENT_PIT_BANNER_SIZE     = Vector2.new(22, 6)
local EVENT_PIT_BANNER_DISTANCE = 300
local EVENT_PIT_BANNER_IDLE_COLOR = Color3.fromRGB(230, 220, 200)

--------------------------------------------------------------------------------
-- Spieler-Plots
--------------------------------------------------------------------------------

local PLOT_COUNT = 8

-- Jeder Plot ist eine eigene RUNDE Insel; darauf liegt das quadratische Beet.
--
-- PLOT_ISLAND_RADIUS muss die ECKEN des Beetes decken, nicht seine Kanten:
-- bei 72x72 liegt eine Ecke 50.9 Studs von der Mitte. 58 laesst also rund
-- 7 Studs Wiesenrand ums Beet, dahinter kommt die Sandkante. Zu knapp, und
-- das Beet ragt an vier Stellen ueber die Insel; MapService prueft das beim
-- Start.
local PLOT_ISLAND_RADIUS = 58

-- Abstand der Insel-MITTE zur Weltmitte. Ergibt sich aus den Radien und der
-- Luecke: Hauptinsel-Rand + Steg + halbe Plot-Insel.
--     120 + 34 + 58 = 212
-- MapService rechnet das beim Start nach und warnt, wenn es nicht passt.
-- PLOT_ISLAND_RADIUS selbst bleibt unangetastet: er haengt fest an PLOT_SIZE
-- (die Insel muss die Beet-Ecken decken) — an dieser Zahl zu drehen wuerde das
-- Beet ueber den Inselrand ragen lassen, nicht nur den Weg dorthin verkuerzen.
local PLOT_RING_RADIUS = 212
local PLOT_SIZE        = Vector3.new(72, 2, 72)

-- Der Wiesenrand der Plot-Insel, auf dem das Beet steht. Etwas dunkler als das
-- Karo, damit das Beet als eigene Flaeche liest und nicht mit der Insel
-- verschwimmt.
local PLOT_ISLAND_COLOR = Color3.fromRGB(70, 152, 70)

-- Zaun an den beiden SEITEN des Plots (lokales +X und -X). Vorne (+Z, Richtung
-- Bruecke) und hinten (-Z, Richtung Mitte) bleibt bewusst offen — sonst muesste
-- man ueber den Zaun springen um auf den eigenen Plot oder zur Bruecke zu kommen.
local FENCE_POST_SIZE    = Vector3.new(1.2, 5, 1.2)
local FENCE_POST_SPACING = 9
local FENCE_RAIL_HEIGHT  = 0.8
local FENCE_COLOR        = Color3.fromRGB(225, 215, 190)

-- Schild an der zur Mitte zeigenden Kante: zeigt, wem der Plot gehoert
local SIGN_POST_SIZE  = Vector3.new(0.8, 7, 0.8)
-- Playtest 05.10.: 16 breit wirkte langgezogen, und EIN Pfosten in der Mitte
-- ragte vorne durch die Schrift. Jetzt 12 breit, zwei Pfosten HINTER dem Brett
-- an den Raendern, dunkle Leisten oben und unten.
