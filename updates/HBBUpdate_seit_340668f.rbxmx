	COLORS       = { Color3.fromRGB(226, 70, 70), Color3.fromRGB(80, 190, 90), Color3.fromRGB(255, 210, 60), Color3.fromRGB(80, 140, 230) },
	SCALE        = 1.0,
	HOP_HEIGHT   = 1.2,
	HOP_TIME     = 0.45,
	CHEER_TIME   = 2.4,
	SHOW_DISTANCE = 160,
}

WorldFXConfig.SHOWCASE_FLAG = {
	POLE_HEIGHT  = 4,
	FLAG_SIZE    = Vector3.new(2.6, 1.6, 0.1),
	WAVE_DEGREES = 14,
	WAVE_RATE    = 0.9,
	SHINE_TIME   = 1.2,
	SHOW_DISTANCE = 260,
}

--------------------------------------------------------------------------------
-- PAKET F: LEBEN IN DER LUFT UND IM GRAS
--------------------------------------------------------------------------------
WorldFXConfig.BEES = {
	MAX_SWARMS   = 6,        -- gleichzeitig in Sichtweite
	PER_SWARM    = { 3, 5 },
	SITE_RADIUS  = 6,
	SPEED        = 0.22,     -- Umlaeufe pro Sekunde
	HOME_EXTRA   = 2,        -- zusaetzliche Schwaerme auf der eigenen Insel
	VIEW_DISTANCE = 180,
	COLOR        = Color3.fromRGB(255, 206, 40),
	STRIPE_COLOR = Color3.fromRGB(46, 34, 20),
}

WorldFXConfig.BUTTERFLIES = {
	COUNT        = 6,
	COLORS       = { Color3.fromRGB(246, 150, 186), Color3.fromRGB(190, 160, 236) },
	FLAP_RATE    = 3.2,      -- Fluegelschlaege pro Sekunde (Bewegung, kein Flackern)
	WANDER       = 7,
	HEIGHT       = 2.5,
	VIEW_DISTANCE = 140,
}

WorldFXConfig.FLOWER_SWAY = {
	DEGREES      = 7,
	RATE         = 0.35,     -- Hz der Windwelle
	WAVELENGTH   = 60,       -- Studs: die Welle laeuft ueber die Insel
	DODGE_RADIUS = 3.5,
	DODGE_DEGREES = 28,
	VIEW_DISTANCE = 140,
	TICK         = 1 / 15,
}

WorldFXConfig.FOOTPRINTS = {
	MAX          = 20,
	STEP         = 2.2,      -- Studs zwischen zwei Abdruecken
	FADE         = 4,        -- Sekunden bis unsichtbar
	SIZE         = 0.9,
	COLOR        = Color3.fromRGB(196, 168, 112),   -- etwas dunkler als der Sand
}

--------------------------------------------------------------------------------
-- PAKET G: DIE WELT REAGIERT AUF DIE SPIELER
--------------------------------------------------------------------------------
-- Der Server meldet nur WAS passiert ist (Modules/WorldMoments erkennt es aus
-- dem Spielstand), wie es aussieht entscheidet der Client.
WorldFXConfig.MOMENTS = {
	HATCH_MIN_RARITY  = "Mythic",   -- ab hier: Lichtsaeule + Zeile fuer alle
	RING_MIN_RARITY   = "Cosmic",   -- ab hier zusaetzlich Funkenring am Himmel
	RARE_MUTATIONS    = { Celestial = true, Candy = true, Lava = true, Galaxy = true, Rainbow = true },
	PLAYER_COOLDOWN   = 30,     -- je Spieler hoechstens ein GROSSER Moment, sonst klein
	QUEUE_MAX         = 4,      -- so viele grosse Momente warten hoechstens
	QUEUE_GAP         = 0.6,    -- Pause zwischen zwei grossen Momenten (s)
	MAX_WAIT          = 12,     -- laenger gewartet: wird klein gezeigt statt gross
	-- Dauer der grossen Momente (so lange ist die Buehne belegt)
	DURATION = { hatch = 2.4, tower = 2.6, rebirth = 2.2, mutation = 2.2, record = 1.6 },
	-- Momente anderer Spieler: "on" | "small" | "off". Es gibt kein
	-- Einstellungs-Fenster im Spiel (nur Sprache); bis dahin gilt dieser Wert.
	OTHERS_DEFAULT    = "on",
	COLUMN_HEIGHT     = 70,
	COLUMN_WIDTH      = 7,
	RING_HEIGHT       = 55,
	RING_SPARKS       = 16,
	FIREWORK_ROCKETS  = 3,
	FIREWORK_SPARKS   = 12,
	WAVE_RADIUS       = 64,
	SPIRAL_SPARKS     = 10,
	NEAR_DISTANCE     = 180,    -- Rekord/Mutation: nur in der Naehe sichtbar
	LINE_SECONDS      = 3.5,
}

-- Klaenge: nur IDs, die in Studio geprueft sind. Leer = kein Klang (die
-- Sound-Pakete H und der Wespen-Summton warten auf eine geprufte ID).
WorldFXConfig.SOUNDS = {
	waspHum  = "rbxassetid://9112881890",   -- Pro Sound Effects "Sylph 1" (Bienenschwarm, Loop 36 s), 10.10. in Studio geladen
	-- Paket H: Klang-Kulisse (Schleifen). Leer = still. Jede ID vorher in
	-- Studio abspielen und pruefen (Toolbox, kostenlos, oder eingebaut).
	-- Alle IDs: Pro Sound Effects (Creator Store, frei), am 10.10.2026 in
	-- Studio geladen und geprueft (IsLoaded, Laenge in Klammern).
	waves    = "rbxassetid://9120570887",   -- Ufer: "Water Lap Active 2", kleine Wellen + ferne Voegel (28 s)
	gull     = "rbxassetid://9118858259",   -- Ufer: "Seagull Squawks 3", Einzelklang (3,5 s)
	meadow   = "rbxassetid://9113444360",   -- Wiese tags: "Birds Park 2", Voegel + Insektensummen (57 s)
	crickets = "rbxassetid://9112764040",   -- blaue Stunde: "Crickets Canyon 1", Grillen, Loop (36 s)
	drip     = "rbxassetid://9126190860",   -- Honigmast: "Water Drips Into Filled Bowl" (14 s)
	crowd    = "rbxassetid://9112766533",   -- Event-Pit: "Crowd Outdoor 2", Stimmengewirr, Loop (36 s)
	wind     = "rbxassetid://9114057104",   -- Arena/Turm: "Desert Wind Light Gusts 1" (37 s)
	bell     = "rbxassetid://9113584742",   -- Event-Start: "Brass Hand Bell 1", Einzelklang (6,6 s)
} :: { [string]: string }
-- Immer unter den Kampf-Sounds (Besitzer 0,35, Zuschauer 0,12).
WorldFXConfig.SOUND_VOLUME = {
	waspHum = 0.08, waves = 0.08, gull = 0.06, meadow = 0.07, crickets = 0.07,
	drip = 0.06, crowd = 0.08, wind = 0.07, bell = 0.1,
}

--------------------------------------------------------------------------------
-- PAKET H: KLANG-KULISSE
--------------------------------------------------------------------------------
-- Zonen nach Kamera-Position, weich ineinander geblendet; hoechstens
-- MAX_AUDIBLE Schleifen gleichzeitig hoerbar.
WorldFXConfig.SOUNDSCAPE = {
	TICK        = 0.2,
	FADE        = 0.12,     -- Anteil je Takt, mit dem die Lautstaerke dem Ziel folgt (~1,5 s)
	MAX_AUDIBLE = 3,
	MIN_WEIGHT  = 0.03,     -- darunter gilt eine Zone als still
	MAST_RADIUS = 45,
	PIT_RADIUS  = 80,
	ARENA_RADIUS = 70,
	HIGH_FROM   = 40,       -- ab dieser Kamerahoehe ueber der Arena mehr Wind
	SHORE_BAND  = 30,       -- so breit (Studs) klingt das Ufer um jede Kueste
	GULL_EVERY  = { 25, 60 },
	NIGHT_FROM  = 0.75,     -- Daemmerung, ab der Grillen statt Voegel
}

--------------------------------------------------------------------------------
-- PAKET I: LICHT NACH ZONEN
--------------------------------------------------------------------------------
-- Ein eigener Farbfilter "ZoneGrade" (stapelt sich mit der Basis und liegt
-- nie ueber einem Show-Filter: der Show-Filter faerbt, ZoneGrade hebt nur
-- Kontrast/Saettigung leicht). Hoch oben auf dem Turm wird die Atmosphaere
-- klarer (Dichte und Dunst skaliert). Keine Tiefenunschaerfe.
WorldFXConfig.ZONE_LIGHT = {
	TICK          = 0.1,
	BLEND_SECONDS = 1.5,
	island = { saturation = 0,    contrast = 0,    brightness = 0 },
	arena  = { saturation = 0.08, contrast = 0.07, brightness = 0.01 },
	ARENA_RADIUS  = 60,         -- um die Arena-Mitte, plus der aeussere Steg
	HIGH_FROM     = 30 * 2.4,   -- Etage 30 (MapConfig.PIT_TOWER_STEP_HEIGHT)
	HIGH_FULL     = 60 * 2.4,
	HIGH_DENSITY  = 0.55,       -- Faktor auf die Atmosphaeren-Dichte ganz oben
	HIGH_HAZE     = 0.45,
}

--------------------------------------------------------------------------------
-- PAKET 0: FESTE KAMERAPUNKTE ("worldshots")
--------------------------------------------------------------------------------
-- Gerechnet in WorldShotController aus MapConfig, damit sie mit der Welt
-- mitwandern. Hier nur die Parameter je Punkt (Slot 1 = Plot bei 0 Grad).
WorldFXConfig.WORLD_SHOTS = {
	{ name = "1 Spawn → Honigmast",       fov = 70 },
	{ name = "2 Hauptinsel schraeg oben", fov = 60 },
	{ name = "3 Plot-Insel, Brunnen",     fov = 70 },
	{ name = "4 Steg zur Arena",          fov = 70 },
	{ name = "5 Arena mit Turm",          fov = 65 },
	{ name = "6 Rand → Horizont",         fov = 70 },
}

--------------------------------------------------------------------------------
-- 12.10.: FLUGFELD AM KAMPF-TURM (TowerFlightController, nur Client)
--------------------------------------------------------------------------------
-- Playtest: "man kann den Turm nicht hochfliegen". Waechst der Turm im Lauf,
-- steht der Spieler unten und sieht nur Ringe. Am Arena-Rand (Steg-Seite,
-- neben dem Laufweg) liegt deshalb ein leuchtendes Feld: wer darauf tritt,
-- fliegt im Bogen auf die Turm-Spitze. Nur an der EIGENEN Arena, nur wenn
-- der Turm steht (Server-Attribut PitPlatform.TowerTopY).
-- Positionen arena-lokal: along = Richtung nach aussen (von der Weltmitte),
-- across = quer (MapLayout.side), 0 = Arena-Mitte.
WorldFXConfig.TOWER_FLIGHT = {
	PAD_ALONG     = -28,     -- auf dem Sockelrand zwischen Steg und Kampfflaeche (Radius 26..30)
	PAD_ACROSS    = -4.5,    -- neben dem Laufweg des Baerchis (X = 0)
	PAD_RADIUS    = 2.2,
	LAND_ALONG    = -19,     -- Landepunkt auf der Spitze (Kaempfer stehen quer bei +-9)
	LAND_ACROSS   = -4.5,
	APEX_EXTRA    = 6,       -- so hoch ueber der Spitze liegt der Scheitel
	MIN_LEVEL     = 1,       -- ab dieser Etage ist das Feld aktiv
	COOLDOWN      = 1.2,     -- Sekunden bis zum naechsten Start
	COLOR_ON      = Color3.fromRGB(255, 214, 90),
	COLOR_OFF     = Color3.fromRGB(150, 130, 100),
	SHOW_DISTANCE = 200,
}

return WorldFXConfig
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX9"><Properties>
<string name="Name">Modules</string>
