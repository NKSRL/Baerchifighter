<Item class="ModuleScript" referent="RBX10"><Properties>
<string name="Name">MapLayout</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- MapLayout.luau
-- ReplicatedStorage/Modules/MapLayout.luau
--
-- Einzige Zustaendigkeit:
--   - WO die festen Wahrzeichen der Welt stehen (HBB Paket 5/6): Bestenlisten-
--     Tafeln, Live-Kampf-Board, Schau-Tuerme, Wespen-Nest, Ei-Haendler.
--     Reine Rechnung aus MapConfig/EggConfig, baut nichts.
--
-- Warum ein eigenes Modul: Dieselben Positionen brauchen drei Stellen — die
-- Builder (bauen), ScenicBuilder (haelt Baeume/Buesche fern) und der Test
-- tools/luau-tests/map_layout.test.lua (prueft Abstaende zu Stegen, Laternen
-- und untereinander). Stuende die Formel dreimal da, liefe sie auseinander.
--
-- Winkel wie MapParts.buildPlotCFrame: Slot 1 liegt bei 0 Grad (+X), jeder
-- weitere 360/PLOT_COUNT Grad weiter Richtung +Z. Zwischen zwei Stegen liegt
-- eine "Luecke" bei 22,5 + k x 45 Grad.

local Config = script.Parent.Parent.Config
local MapConfig    = require(Config.MapConfig)
local EggConfig    = require(Config.EggConfig)
local FeatureFlags = require(Config.FeatureFlags)

local MapLayout = {}

-- Ein Wahrzeichen als Kreis auf der Wiese (fuer Abstandspruefungen).
export type Landmark = { name: string, x: number, z: number, r: number }

--------------------------------------------------------------------------------
-- Richtungen
--------------------------------------------------------------------------------

function MapLayout.slotAngle(slot: number): number
	return math.rad((slot - 1) * (360 / MapConfig.PLOT_COUNT))
end

-- Einheitsvektor von der Weltmitte zum Plot `slot` (= Richtung seines Stegs).
function MapLayout.outward(slot: number): Vector3
	local angle = MapLayout.slotAngle(slot)
	return Vector3.new(math.cos(angle), 0, math.sin(angle))
end

-- Quer zum Steg, zum naechsten Slot hin (wie die Laternen in ScenicBuilder).
function MapLayout.side(slot: number): Vector3
	local o = MapLayout.outward(slot)
	return Vector3.new(-o.Z, 0, o.X)
end

-- Punkt auf der Wiese bei `angleDegrees` und `radius` (Hoehe PLATFORM_TOP_Y).
function MapLayout.atAngle(angleDegrees: number, radius: number): Vector3
	local angle = math.rad(angleDegrees)
	return Vector3.new(
		MapConfig.CENTER.X + radius * math.cos(angle),
		MapConfig.PLATFORM_TOP_Y,
		MapConfig.CENTER.Z + radius * math.sin(angle)
	)
end

--------------------------------------------------------------------------------
-- Honig-Teich und Baerchi-Platz auf dem Plot (plot-lokal, siehe MapConfig-Kopf)
--------------------------------------------------------------------------------
-- HONEY_POND_V2: der Teich steht dort, wo das Gebaeude HoneyPond steht (Mitte
-- des hinteren Plot-Teils), sein Standplatz zeigt nach +Z (ins Plot hinein),
-- und der Baerchi WOHNT auf diesem Standplatz — er frisst ohne hinzulaufen.
-- Ohne Schalter: alter Teich (POND_OFFSET) und alter Baerchi-Platz.

local function pondV2(): boolean
	return FeatureFlags.isOn("HONEY_POND_V2")
end

function MapLayout.pondOffset(): Vector3
	return if pondV2() then MapConfig.BUILDING_OFFSETS.HoneyPond.offset else MapConfig.POND_OFFSET
end

-- Richtung (plot-lokal, waagerecht, Einheitsvektor) vom Teich zum Standplatz.
function MapLayout.pondFacing(): Vector3
	if pondV2() then
		return Vector3.new(0, 0, 1)
	end
	local toHome = MapConfig.BAERCHI_HOME_OFFSET - MapConfig.POND_OFFSET
	local flat = Vector3.new(toHome.X, 0, toHome.Z)
	return if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, 1)
end

-- Abstand Teich-Mitte -> Standplatz (Beckenrand + Luecke).
function MapLayout.pondStandDistance(): number
	return MapConfig.POND_RADIUS + MapConfig.POND_STAND_GAP
end

-- Wo der ausgeruestete Baerchi steht, wenn er nichts tut.
function MapLayout.baerchiHomeOffset(): Vector3
	if pondV2() then
		return MapLayout.pondOffset() + MapLayout.pondFacing() * MapLayout.pondStandDistance()
	end
	return MapConfig.BAERCHI_HOME_OFFSET
end

--------------------------------------------------------------------------------
-- Wahrzeichen
--------------------------------------------------------------------------------

-- Fuss des Schau-Turms von `slot` (Mitte, PLATFORM_TOP_Y).
-- MAP_V2_SHOWCASE: am Brueckenkopf auf der Hauptinsel; sonst wie v15 aussen
-- an der Arena-Insel (gleiche Formel wie MapParts.pitCenter + distance).
function MapLayout.showcaseFoot(slot: number): Vector3
	local cfg = MapConfig.TOWER_SHOWCASE
	local outward = MapLayout.outward(slot)
	local flat: Vector3
	if FeatureFlags.isOn("MAP_V2_SHOWCASE") then
		flat = MapConfig.CENTER + outward * cfg.bridgeheadAlong + MapLayout.side(slot) * cfg.bridgeheadAcross
	else
		local pitRadius = MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS
			+ MapConfig.ISLAND_GAP + MapConfig.PIT_BASE_RADIUS
		flat = MapConfig.CENTER + outward * (pitRadius + cfg.distance)
	end
	return Vector3.new(flat.X, MapConfig.PLATFORM_TOP_Y, flat.Z)
end

-- Die Bestenlisten-Tafeln: je Tafel Liste (nil = wechselnd, alter Weg) und Winkel.
function MapLayout.leaderboardBoards(): { { listId: string?, angleDegrees: number } }
	if FeatureFlags.isOn("MAP_V2_BOARDS") then
		local boards = {}
		for _, b in MapConfig.LEADERBOARD_BOARDS_V2 do
			if b.flag == nil or FeatureFlags.isOn(b.flag) then
				table.insert(boards, { listId = b.listId :: string?, angleDegrees = b.angleDegrees })
			end
		end
		return boards
	end
	return { { listId = nil, angleDegrees = MapConfig.LEADERBOARD_BOARD.angleDegrees } }
end

-- Mitte des Wespen-Nests (Weltkoordinaten).
function MapLayout.waspNestCenter(): Vector3
	return MapConfig.CENTER + Vector3.new(0, MapConfig.PLATFORM_TOP_Y, 0) + MapConfig.WASP_NEST.offset
end

-- Alle Wahrzeichen auf der Wiese der Hauptinsel, die gerade gebaut werden.
-- `r` = Radius des Kreises, der den Grundriss sicher umschliesst.
function MapLayout.landmarks(): { Landmark }
	local list: { Landmark } = {}
	local function add(name: string, p: Vector3, r: number)
		table.insert(list, { name = name, x = p.X, z = p.Z, r = r })
	end

	local board = MapConfig.LEADERBOARD_BOARD
	for i, b in MapLayout.leaderboardBoards() do
		add("Bestenliste" .. i, MapLayout.atAngle(b.angleDegrees, board.radius), board.size.X * 0.5 + 0.5)
	end

	if FeatureFlags.isOn("MAP_V2_LIVE_BOARD") then
		local live = MapConfig.LIVE_BOARD
		add("LiveBoard", MapLayout.atAngle(live.angleDegrees, live.radius), live.size.X * 0.5 + 0.5)
	end

	if FeatureFlags.isOn("MAP_V2_MERCHANT") then
		local m = EggConfig.MERCHANT_V2
		add("Haendler", MapLayout.atAngle(m.angleDegrees, m.radius), 6)
	end

	if FeatureFlags.isOn("MAP_V2_SHOWCASE") then
		-- Sockel: Turmradius + 1,2 (ArenaBuilder.buildShowcase), Dach bis 5
		local r = math.max(MapConfig.TOWER_SHOWCASE.radius + 1.2, 5) + 0.5
		for slot = 1, MapConfig.PLOT_COUNT do
			add("SchauTurm" .. slot, MapLayout.showcaseFoot(slot), r)
		end
	end

	return list
end

--------------------------------------------------------------------------------
-- Welt aufwerten (08.10.2026): Inselmitten, offenes Wasser, Wegweiser, Bojen
--------------------------------------------------------------------------------
-- Gebraucht von den Client-Controllern (Water/Hub/DayCycle) und von
-- map_layout.test.lua. Gleiche Formeln wie MapParts (Server), hier ohne
-- Server-Abhaengigkeit.

-- Mitte der Plot-Insel `slot` (PLATFORM_TOP_Y).
function MapLayout.plotCenter(slot: number): Vector3
	local flat = MapConfig.CENTER + MapLayout.outward(slot) * MapConfig.PLOT_RING_RADIUS
	return Vector3.new(flat.X, MapConfig.PLATFORM_TOP_Y, flat.Z)
end

-- Abstand der Arena-Mitte zur Weltmitte (wie MapParts.pitCenter).
function MapLayout.pitRadius(): number
	return MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS
		+ MapConfig.ISLAND_GAP + MapConfig.PIT_BASE_RADIUS
end

-- Mitte der Arena-Insel `slot` (PLATFORM_TOP_Y).
function MapLayout.pitCenter(slot: number): Vector3
	local flat = MapConfig.CENTER + MapLayout.outward(slot) * MapLayout.pitRadius()
	return Vector3.new(flat.X, MapConfig.PLATFORM_TOP_Y, flat.Z)
end

-- Liegt (x, z) auf offenem Wasser, mit `margin` Studs Abstand zu jeder
-- Sandkante und jedem Steg? Arena-Inseln und aeussere Stege zaehlen immer als
-- Land (es koennte ein Spieler kommen). Fuer Fisch und Gluehwuermchen.
function MapLayout.isOpenWater(x: number, z: number, margin: number): boolean
	local dx, dz = x - MapConfig.CENTER.X, z - MapConfig.CENTER.Z
	local r = math.sqrt(dx * dx + dz * dz)
	if r > MapConfig.WATER_RADIUS - margin then
		return false
	end
	local shore = MapConfig.SHORE_WIDTH + margin
	if r < MapConfig.PLATFORM_RADIUS + shore then
		return false
	end
	local laneHalf = MapConfig.BRIDGE_WIDTH * 0.5 + margin
	local pitR = MapLayout.pitRadius()
	for slot = 1, MapConfig.PLOT_COUNT do
		local o = MapLayout.outward(slot)
		local along = dx * o.X + dz * o.Z
		local across = math.abs(dx * o.Z - dz * o.X)
		if along > 0 and along < pitR and across <= laneHalf then
			return false
		end
		local plot = MapLayout.plotCenter(slot)
		if math.sqrt((x - plot.X) ^ 2 + (z - plot.Z) ^ 2) < MapConfig.PLOT_ISLAND_RADIUS + shore then
			return false
		end
		local pit = MapLayout.pitCenter(slot)
		if math.sqrt((x - pit.X) ^ 2 + (z - pit.Z) ^ 2) < MapConfig.PIT_BASE_RADIUS + shore then
			return false
		end
	end
	return true
end

-- Wegweiser: Ziel des dritten Arms — Haendler oder die naechste Bestenliste,
-- was naeher ist. (Position, Loc-Schluessel)
function MapLayout.signpostSideTarget(from: Vector3): (Vector3, string)
	local m = EggConfig.MERCHANT_V2
	local best = MapLayout.atAngle(m.angleDegrees, m.radius)
	local bestDist = (best - from).Magnitude
	local key = "world.sign.merchant"
	for _, b in MapLayout.leaderboardBoards() do
		local p = MapLayout.atAngle(b.angleDegrees, MapConfig.LEADERBOARD_BOARD.radius)
		local d = (p - from).Magnitude
		if d < bestDist then
			best, bestDist, key = p, d, "world.sign.board"
		end
	end
	return best, key
end

-- Wegweiser: einer je Steg, neben dem Pflasterweg, wo er am Event-Pit
-- beginnt. `outward` = Richtung nach aussen (zum Plot), `sideDir` = Richtung
-- des dritten Arms (waagerecht, Einheitsvektor).
-- 12.10.: die Schilder haengen aussen am Pfahl und ragen in Zeigerichtung
-- weg. Der Pfahl steht deshalb auf der Seite des Wegs, zu der der dritte Arm
-- zeigt — sonst ragte dieser Arm quer ueber das Pflaster.
function MapLayout.signposts(radius: number, sideOffset: number): { { slot: number, position: Vector3, outward: Vector3, sideDir: Vector3, sideKey: string } }
	local list = {}
	for slot = 1, MapConfig.PLOT_COUNT do
		local o = MapLayout.outward(slot)
		local side = MapLayout.side(slot)
		local function place(sign: number): (Vector3, Vector3, string)
			local flat = MapConfig.CENTER + o * radius + side * (sign * sideOffset)
			local position = Vector3.new(flat.X, MapConfig.PLATFORM_TOP_Y, flat.Z)
			local target, key = MapLayout.signpostSideTarget(position)
			local d = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
			local dir = if d.Magnitude > 1e-3 then d.Unit else side * sign
			return position, dir, key
		end
		local position, dir, key = place(1)
		if dir.X * side.X + dir.Z * side.Z < 0 then
			position, dir, key = place(-1)
		end
		table.insert(list, { slot = slot, position = position, outward = o, sideDir = dir, sideKey = key })
	end
	return list
end

-- Bojen: je eine in der Luecke zwischen zwei Stegen, weit draussen.
function MapLayout.buoys(radius: number): { Vector3 }
	local list = {}
	for slot = 1, MapConfig.PLOT_COUNT do
		local angle = (slot - 1) * (360 / MapConfig.PLOT_COUNT) + 180 / MapConfig.PLOT_COUNT
		local p = MapLayout.atAngle(angle, radius)
		table.insert(list, Vector3.new(p.X, MapConfig.PLATFORM_TOP_Y - MapConfig.WATER_DROP, p.Z))
	end
	return list
end

-- Paket D: Punkt am Rand der Plot-Insel `slot`. `angleDegrees` plot-lokal:
-- 0 = nach aussen (Arena-Steg), 90 = zur Seite (side), 180 = zur Hauptinsel.
-- Zweiter Wert: Richtung von dort zur Inselmitte (fuer die Ausrichtung der Deko).
function MapLayout.islandRimPoint(slot: number, angleDegrees: number, radius: number): (Vector3, Vector3)
	local a = math.rad(angleDegrees)
	local dir = MapLayout.outward(slot) * math.cos(a) + MapLayout.side(slot) * math.sin(a)
	local center = MapLayout.plotCenter(slot)
	return center + dir * radius, -dir
end

return MapLayout
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="Folder" referent="RBX11"><Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Folder" referent="RBX12"><Properties>
<string name="Name">Services</string>
</Properties>
<Item class="ModuleScript" referent="RBX13"><Properties>
<string name="Name">CombRecyclerService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- CombRecyclerService.luau
-- ServerScriptService/Services/CombRecyclerService.luau
--
-- Einzige Zustaendigkeit:
--   - Den Waben-Recycler auf dem Plot betreiben: abgegebene Waben in die
--     Warteschlange legen, sie zeitgesteuert in Gummies verwandeln und den
--     Ausbau des Recyclers verkaufen.
--
-- Nicht zu verwechseln mit RecycleService (verwertet einen Baerchi gegen
-- Gummies). Das hier ist die Maschine fuer die Waben aus dem Event-Pit
-- (siehe CombService und Config/CombConfig).
--
-- Die Verarbeitung laeuft ueber eine Zeitmarke (island.recycler.lastProcessedAt)
-- und nicht ueber einen Timer pro Spieler, genau wie Honig und Eierlegen: der
-- Recycler arbeitet damit auch weiter, waehrend der Spieler offline ist, und es
-- braucht keine Schleife pro Spieler. Der Takt unten verrechnet nur, was seit
-- der letzten Verrechnung dazugekommen ist.
--
-- Auszahlung ueber EconomyService.awardGummies, also MIT Rebirth-Multiplikator:
-- das ist Einkommen aus Arbeit, kein Gegenwert wie beim Verwerten eines
-- Baerchis (dort ist awardGummiesFlat richtig, siehe RecycleService).

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local Types      = require(ReplicatedStorage.Network.Types)
local Remotes    = require(ReplicatedStorage.Network.Remotes)
local Loc        = require(ReplicatedStorage.Localization.Loc)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local CombRecyclerService = {}

local payQueueNow: (Player, Types.PlayerData) -> number

--------------------------------------------------------------------------------
-- Verrechnung
--------------------------------------------------------------------------------

-- Rechnet die Zeit seit der letzten Verrechnung nach, schreibt die fertigen
-- Einheiten als Gummies gut und gibt zurueck, wie viele Einheiten fertig wurden.
--
-- Immer zuerst aufrufen, BEVOR sich Level oder Warteschlange aendern: sonst
-- wuerde die Zeit davor mit dem neuen Wert gerechnet (z.B. eine halbe Stunde
-- Leerlauf, die ploetzlich "Arbeit" waere, sobald eine Abgabe kommt).
local function settle(player: Player, data: Types.PlayerData): number
	if CombConfig.INSTANT_PAYOUT then
		return payQueueNow(player, data)
	end
	local recycler = data.island.recycler
	local now = os.time()

	local elapsed = math.clamp(now - recycler.lastProcessedAt, 0, CombConfig.OFFLINE_MAX_SECONDS)
	recycler.lastProcessedAt = now

	if recycler.queued <= 0 then
		recycler.queued   = 0
		recycler.progress = 0
		return 0
	end
	if elapsed <= 0 then return 0 end

	recycler.progress += elapsed * CombConfig.getSpeed(recycler.level)

	local done = math.min(recycler.queued, math.floor(recycler.progress))
	if done <= 0 then return 0 end

	recycler.queued   -= done
	recycler.progress -= done
	if recycler.queued <= 0 then
		recycler.queued   = 0
		recycler.progress = 0
	end

	EconomyService.awardGummies(player, done * CombConfig.getPayPerUnit(recycler.level))
	return done
end

-- 12.10.: zahlt die ganze Warteschlange auf einmal aus (INSTANT_PAYOUT).
-- Auch fuer Altstaende: wer noch Waben in der Schlange hat, bekommt sie
-- beim naechsten Join bzw. Takt sofort.
payQueueNow = function(player: Player, data: Types.PlayerData): number
	local recycler = data.island.recycler
	local units = math.max(0, math.floor(recycler.queued))
	recycler.queued   = 0
	recycler.progress = 0
	recycler.lastProcessedAt = os.time()
	if units > 0 then
		EconomyService.awardGummies(player, units * CombConfig.getPayPerUnit(recycler.level))
	end
	return units
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Nimmt abgegebene Waben entgegen. Gibt false zurueck, wenn die Spieldaten
-- noch nicht geladen sind — CombService behaelt den Stapel dann und versucht es
-- spaeter noch einmal.
function CombRecyclerService.deposit(player: Player, units: number): boolean
	local data = PlayerService.getData(player)
	if not data then return false end
	if units <= 0 then return true end

	settle(player, data)

	local recycler = data.island.recycler
	recycler.queued += math.floor(units)

	-- 12.10.: sofort auszahlen (CombConfig.INSTANT_PAYOUT) — die Waben
	-- werden bei der Abgabe in Gummies verwandelt, nicht nach und nach.
	if CombConfig.INSTANT_PAYOUT then
		payQueueNow(player, data)
	end

	PlayerService.markDirty(player)
	return true
end

-- Aktuelles Recycler-Level (1, solange die Daten nicht geladen sind). Fuer den
-- Respawn-Hook (CombConfig.getRespawnDelay).
function CombRecyclerService.getLevel(player: Player): number
	local data = PlayerService.getData(player)
	if not data then return 1 end
	return data.island.recycler.level
end

-- Kauft das naechste Level. Meldet Fehler als ActionFailed (wie IslandService).
function CombRecyclerService.upgrade(player: Player)
	local data = PlayerService.getData(player)
	if not data then return end

	local function fail(reason: Types.LocMsg)
		Remotes.ActionFailed:FireClient(player, "RequestUpgradeRecycler", reason)
	end

	-- Erst die laufende Arbeit nach dem ALTEN Level abrechnen.
	settle(player, data)

	local recycler = data.island.recycler
	local nextLevel = recycler.level + 1

	if nextLevel > CombConfig.RECYCLER_MAX_LEVEL then
		fail(Loc.msg("err.max_level"))
		return
	end

	local cost = CombConfig.getUpgradeCost(nextLevel)
	if not cost then
		fail(Loc.msg("err.max_level"))
		return
	end

	-- Erst pruefen, dann buchen (wie EconomyService.upgradeBuilding): sonst kann
	-- der erste Teilbetrag abgezogen werden, obwohl der zweite scheitert.
	if cost.gummies > 0 and data.gummies < cost.gummies then
		fail(Loc.msg("err.not_enough_gummies", { have = data.gummies, need = cost.gummies }))
		return
	end
	if cost.goldGummies > 0 and data.goldGummies < cost.goldGummies then
		fail(Loc.msg("err.not_enough_gold_gummies", { have = data.goldGummies, need = cost.goldGummies }))
		return
	end

	if cost.gummies > 0 then
		local ok, reason = EconomyService.spendGummies(player, cost.gummies)
		if not ok then
			fail(reason or Loc.msg("err.unknown"))
			return
		end
	end
	if cost.goldGummies > 0 then
		local ok, reason = EconomyService.spendGoldGummies(player, cost.goldGummies)
		if not ok then
			fail(reason or Loc.msg("err.unknown"))
			return
		end
	end

	recycler.level = nextLevel
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	Remotes.RecyclerUpgraded:FireClient(player, nextLevel)
	print("[CombRecyclerService]", player.Name, "| Recycler → Level", nextLevel)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

local function tickAll()
	for _, player in Players:GetPlayers() do
		local data = PlayerService.getData(player)
		if data and data.island.recycler.queued > 0 then
			-- settle() schreibt die fertigen Einheiten ueber awardGummies gut, und
			-- das loest markDirty aus: Hud, Schild und Lampe ziehen darueber nach.
			settle(player, data)
		end
	end
end

function CombRecyclerService.init()
	RateLimiter.connect(Remotes.RequestUpgradeRecycler, "RequestUpgradeRecycler", function(player)
		CombRecyclerService.upgrade(player)
	end)

	-- Offline-Arbeit beim Join: die Zeitmarke steht noch auf dem letzten
	-- Verlassen, settle() rechnet die Zwischenzeit nach (hoechstens
	-- OFFLINE_MAX_SECONDS).
	PlayerService.onDataLoaded(function(player, data)
		settle(player, data)
	end)

	-- Vor dem Speichern beim Verlassen noch einmal verrechnen, damit die
	-- Zeitmarke im Spielstand aktuell ist.
	PlayerService.onPlayerLeaving(function(player, data)
		settle(player, data)
	end)

	print("[CombRecyclerService] Initialisiert")
end

function CombRecyclerService.start()
	task.spawn(function()
		while true do
			task.wait(CombConfig.RECYCLER_TICK_SECONDS)
			local ok, err = pcall(tickAll)
			if not ok then
				warn("[CombRecyclerService] Tick fehlgeschlagen:", err)
			end
		end
	end)
end

return CombRecyclerService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX14"><Properties>
<string name="Name">DebugService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- DebugService.luau
-- ServerScriptService/Services/DebugService.luau
--
-- Einzige Zustaendigkeit:
--   - Test-Befehle aus der Studio Command Bar entgegennehmen
--
-- NUR IN STUDIO. Im veroeffentlichten Spiel macht init() nichts und die
-- BindableFunction existiert nicht.
--
-- Warum eine BindableFunction und nicht einfach _G oder ein require?
--   Die Command Bar laeuft in einem eigenen Lua-VM. Sie hat deshalb
--     * ihren eigenen require-Cache  → require(PlayerService) liefert dort eine
--       ZWEITE, nie initialisierte Kopie mit leerem _playerData, und
--     * ihr eigenes _G               → im Server gesetzte Globals sind unsichtbar.
--   Aufrufe auf der Kopie laufen still ins Leere, was beim Testen extrem
--   verwirrend ist. Eine BindableFunction ist eine Instanz im DataModel:
--   ihr OnInvoke wurde vom echten Server-Script gesetzt und laeuft daher
--   garantiert im echten Server-VM, mit dem echten Zustand.
--
-- Benutzung (Command Bar, Server-Kontext, Play laeuft):
--   local D = game.ServerScriptService.RBLDebug
--   D:Invoke("info")
--   D:Invoke("give", 100000, 1000)
--   D:Invoke("add", "RedBaerchi", 10)
--   D:Invoke("add", "RedBaerchi", 10, "Rainbow")   -- Mutation (siehe BaerchiConfig.MUTATIONS)
--   D:Invoke("stats", uid)                    -- Kampfwerte inkl. PWR
--   D:Invoke("list")
--   D:Invoke("fuse", uidA, uidB)
--   D:Invoke("recycle", uid)
--   D:Invoke("building", "Beehive", 5)   -- Level 1-60 (v15), Look folgt automatisch
--   D:Invoke("building", "HoneyRefiner", 60)
--   D:Invoke("hatch", "BasicEgg")   -- legt ein Ei ins Lager und oeffnet es sofort (v12)
--   D:Invoke("egg", "GoldenEgg", 5) -- 5 Eier ins Lager legen (ohne zu oeffnen)
--   D:Invoke("pitprogress", 12)     -- letzten Lauf im gewaehlten Tower auf Stage 12 setzen (Fortsetzungs-Test)
--   D:Invoke("petmode")             -- aktueller Zustand der Pet-Leiste
--   D:Invoke("pm", "Fight", "Last")  -- wie ein Klick auf die Pet-Leiste
--   D:Invoke("honey")               -- alle Honig-Lager sofort voll
--   D:Invoke("feed", uid, 20)       -- 20x fuettern (heilt + gibt XP)
--   D:Invoke("fight", uid)          -- kompletter Lauf im gewaehlten Tower
--   D:Invoke("skill", "equipped", "OmegaStrike") -- Faehigkeit tauschen (Show-Test)
--   D:Invoke("rebirth")
--
-- v8 (Promotion / Charms / Event-Teilnahme):
--   D:Invoke("promote", uid)        -- braucht genug Duplikate, siehe "add"
--   D:Invoke("charms", uid)         -- alle acht Slots im Klartext
--   D:Invoke("roll", uid, 5)        -- 5x wuerfeln (kostet GoldGummies)
--   D:Invoke("lock", uid, 1)        -- Slot I sperren/freigeben
--   D:Invoke("event")               -- ausgeruesteten Baerchi zum Event schicken
--   D:Invoke("skipevent")           -- laufende Phase sofort beenden
--   D:Invoke("events")              -- Katalog: alle Events mit ihrer Belohnung
--   D:Invoke("startevent", "ZauberZirkel")  -- genau dieses Event sofort starten
--
-- v10 (Eier legen):
--   D:Invoke("eggs")            -- was liegt herum, wie schnell legt er, welche Chancen
--   D:Invoke("lay", 5)          -- 5 Eier sofort legen (ohne aufs Intervall zu warten)
--   D:Invoke("collect")         -- alles einsammeln
--   D:Invoke("eggtime", 60)     -- Zeitmarke 60 Minuten zurueck, Tick legt nach
--
-- v15 (Waben im Event-Pit, Recycler):
--   D:Invoke("combs", 20)           -- 20 Waben sofort ins Pit legen (Stand ausgeben)
--   D:Invoke("queue", 50)           -- 50 Wabeneinheiten in die Recycler-Warteschlange
--   D:Invoke("recycler", 5)         -- Recycler-Level setzen (ohne Kosten), Stand ausgeben
--
-- v15 (Tower, Gebaeude 1-60, Angeben, Login-Bonus):
--   D:Invoke("tower", "II", 20)     -- Tower II waehlen und ab Stage 20 kaempfen (Fortsetzung gratis)
--   D:Invoke("towerrecord", "III", 45) -- Rekord setzen (Meilensteine bis dorthin werden ausgezahlt)
--   D:Invoke("rebirthcap")          -- Deckel des aktuellen Rebirths in allen Towern
--   D:Invoke("stagebest", "I", 30)  -- Sammel-Update: beste Stage dieses Lebens (Rebirth-Bedingung)
--   D:Invoke("incubator", "done")   -- Sammel-Update: Inkubator-Stand, "done" = alle Eier fertig
--   D:Invoke("incubator", "breed")  -- INCUBATOR_BREED: jedes Baerchi im Inkubator bruetet sofort ein Ei
--   D:Invoke("dailyshift", 1)       -- Login-Bonus: so tun, als waeren 1 Tag(e) vergangen
--   D:Invoke("lbflush")             -- Bestenlisten sofort schreiben und neu lesen
--   D:Invoke("parts")               -- Teile auf der eigenen Insel zaehlen (Budget 250)
--   D:Invoke("v14save")             -- Spielstand im alten v14-Format simulieren + migrieren
--
-- v17 (lebendige Events):
--   D:Invoke("startevent", "Ufo")   -- UFO-Patrouille mit Abwuerfen
--   D:Invoke("jackpot")             -- naechster UFO-Abwurf ist sicher ein Jackpot (Stand des Pity-Zaehlers)
--   D:Invoke("combtheme", "HotEgg") -- Wabenthema setzen ("off" = normal)
--   D:Invoke("launch", 10)          -- 10 Waben einfliegen lassen (Vulkan aus der Mitte)
--   D:Invoke("startevent", "WaspQueen") -- Boss-Event sofort (laeuft sonst nur jeden 2. Durchlauf)
--
-- v14 (Mega Egg Tree):
--   D:Invoke("tree")                 -- alle 20 Knoten mit Bedingungen und Stand
--   D:Invoke("unlock", "SunEgg")     -- einen Knoten freischalten ("all" = alle)
--   D:Invoke("hatched", "SugarEgg", 15) -- Hatch-Zaehler setzen (Freischalt-Test)
--   D:Invoke("blueprint", 1)         -- Blaupausen gutschreiben
--   D:Invoke("useblueprint", "PlatinumEgg")
--   D:Invoke("press", "SugarEgg", "Void") -- 5 Zucker-Eier -> 1 Nebel-Ei
--   D:Invoke("setrebirth", 10)       -- Rebirth-Zaehler setzen (ohne Reset)
--   D:Invoke("skilltest", "OmegaBaerchi", 30) -- einen Kampf mit Runden-Log
--   D:Invoke("snapshot")             -- Spielstand merken (fuer Tests)
--   D:Invoke("restore")              -- gemerkten Spielstand zurueckschreiben
--
-- Welt aufwerten (08.10.2026, nur Optik, setzt workspace-Attribute fuer die
-- Client-Controller; alle Test-Clients sehen dasselbe):
--   D:Invoke("worldshots", 1)        -- Kamera auf festen Punkt 1..6 (UI aus), 0 = zurueck
--   D:Invoke("daytime", 19)          -- Tageslauf auf feste Uhrzeit, "auto" = Zyklus
--   D:Invoke("pitstate", "soon")     -- Pit-Rahmen: idle | soon | live | auto
--   D:Invoke("neststate", "boss")    -- Wespen-Nest: calm | boss | auto
--   D:Invoke("arrival")              -- Ankunft (Blasen + Bienen) erneut abspielen
--   D:Invoke("fish")                 -- sofort einen Honig-Fisch springen lassen
--   D:Invoke("islandstage", 4)       -- Insel-Deko Stufe 1..4 zeigen ("auto" = aus dem Fortschritt)
--   D:Invoke("pondfull")             -- Teich bis zum Rand fuellen (Ueberlauf-Tropfen)
--   D:Invoke("spectators", "hop")    -- Zuschauer an der eigenen Arena: hop | cheer
--   D:Invoke("record")               -- Rekord-Moment am eigenen Schau-Turm (Flagge glaenzt, Jubel)
--   D:Invoke("moment", "hatch", "Cosmic") -- Welt-Moment an alle: hatch <Rarity> | tower <Id> | record | rebirth | mutation <Id>
--   D:Invoke("moments5")             -- fuenf grosse Momente gleichzeitig (Drosselung pruefen)
--   (Event-Start und Boss: D:Invoke("pitstate", "live") / D:Invoke("neststate", "boss"))
--
-- HBB Paket 0 (Test-Zustaende, erst "snapshot"):
--   D:Invoke("state", "fresh")       -- neues Konto, Trichter F01–F10 misst
--   D:Invoke("state", "hatch10")     -- dazu zehn geoeffnete Basis-Eier
--   D:Invoke("state", "tower1")      -- dazu Tower I geschafft (Rekord 30)
--
-- Ein kompletter Event-Durchlauf ohne acht Minuten Wartezeit:
--   D:Invoke("skipevent")   → Pause endet, Event laeuft
--   D:Invoke("event")       → Baerchi laeuft hin (ein paar Sekunden abwarten)
--   D:Invoke("skipevent")   → Event endet, Stat-Stufe wird vergeben
--
-- Rueckgaben sind einfache Tabellen/Zahlen — BindableFunctions kopieren
-- Werte ueber die VM-Grenze, Funktionen und Metatables kommen nicht durch.

local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local Loc = require(ReplicatedStorage.Localization.Loc)   -- Belohnung ist eine LocMsg
local CharmConfig      = require(ReplicatedStorage.Config.CharmConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local BaerchiFactory   = require(ReplicatedStorage.Modules.BaerchiFactory)
local SkillConfig      = require(ReplicatedStorage.Config.SkillConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggCalculator    = require(ReplicatedStorage.Modules.EggCalculator)
local CombConfig       = require(ReplicatedStorage.Config.CombConfig)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local IslandService  = require(ServerScriptService.Services.IslandService)
local EggService     = require(ServerScriptService.Services.EggService)
local CombatService  = require(ServerScriptService.Services.CombatService)
local FusionService  = require(ServerScriptService.Services.FusionService)
local RecycleService = require(ServerScriptService.Services.RecycleService)
local RebirthService = require(ServerScriptService.Services.RebirthService)
local HoneyService   = require(ServerScriptService.Services.HoneyService)
local MapService     = require(ServerScriptService.Services.MapService)

-- v8
local PromotionService          = require(ServerScriptService.Services.PromotionService)
local CharmService              = require(ServerScriptService.Services.CharmService)
local EventService              = require(ServerScriptService.Services.EventService)
local EventParticipationService = require(ServerScriptService.Services.EventParticipationService)

-- v10
local EggLayService             = require(ServerScriptService.Services.EggLayService)

-- v14
local EggTreeService            = require(ServerScriptService.Services.EggTreeService)
local EggTree                   = require(ReplicatedStorage.Modules.EggTree)
local CombatConfig              = require(ReplicatedStorage.Config.CombatConfig)

-- v12
local ActivityLock = require(ServerScriptService.Util.ActivityLock)  -- Paket 1.1: Lock-Halter ausgeben
local PetModeService            = require(ServerScriptService.Services.PetModeService)
local PitArenaService           = require(ServerScriptService.Services.PitArenaService)

-- v15 (Waben)
local CombService               = require(ServerScriptService.Services.CombService)
local CombRecyclerService       = require(ServerScriptService.Services.CombRecyclerService)

-- v15 (Tower, Angeben, Login-Bonus)
local TowerConfig               = require(ReplicatedStorage.Config.TowerConfig)
local TowerService              = require(ServerScriptService.Services.TowerService)
local GamepassService           = require(ServerScriptService.Services.GamepassService)   -- 08.10. Paket C
local LeaderboardService        = require(ServerScriptService.Services.LeaderboardService)
local LoginBonusService         = require(ServerScriptService.Services.LoginBonusService)
local PlayerMigration           = require(ServerScriptService.Util.PlayerMigration)

-- v17 (lebendige Events)
local JackpotRoll               = require(ServerScriptService.Util.JackpotRoll)

-- HBB Paket 0
local FunnelService             = require(ServerScriptService.Services.FunnelService)

local DebugService = {}

local BINDABLE_NAME = "RBLDebug"

--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

-- Der erste Spieler im Server. Fuer Solo-Tests in Studio genau richtig.
local function firstPlayer(): Player?
	return Players:GetPlayers()[1]
end

local function requireData(): (Player?, Types.PlayerData?, string?)
	local player = firstPlayer()
	if not player then
		return nil, nil, "Kein Spieler im Spiel — laeuft der Play-Modus?"
	end

	local data = PlayerService.getData(player)
	if not data then
		return player, nil, "Daten fuer " .. player.Name .. " noch nicht geladen"
	end

	return player, data, nil
end

local function countBaerchis(data: Types.PlayerData): number
	local n = 0
	for _ in data.island.baerchis do n += 1 end
	return n
end

--------------------------------------------------------------------------------
-- Befehle
--------------------------------------------------------------------------------

local commands: { [string]: (Player, Types.PlayerData, ...any) -> any } = {}

commands.info = function(player, data)
	local buildings: { [string]: number } = {}
	for id, building in data.island.buildings do
		buildings[id] = building.level
	end

	return {
		player       = player.Name,
		gummies      = data.gummies,
		goldGummies  = data.goldGummies,
		rebirthCount = data.rebirthCount,
		rebirthMult  = data.rebirthMult,
		baerchis     = countBaerchis(data),
		towers       = data.towers,
		towerProgress = data.island.towerProgress,
		buildings    = buildings,
		eggStock     = data.island.eggStock,
	}
end

-- Waehrung schenken. Ohne rebirthMult, du bekommst exakt die Zahl.
commands.give = function(player, _data, gummies: any, gold: any)
	EconomyService.awardGummiesFlat(player, tonumber(gummies) or 100000)
	EconomyService.awardGoldGummies(player, tonumber(gold) or 1000)
	return commands.info(player, PlayerService.getDataOrError(player))
end

-- Alle Baerchis als flache Liste (uid zum Weiterverwenden)
commands.list = function(_player, data)
	local out = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(out, {
			uid      = uid,
			configId = baerchi.configId,
			rarity   = baerchi.rarity,
			level    = baerchi.level,
			xp       = baerchi.xp,
			fusion   = baerchi.isFusionResult,
			bonus    = baerchi.fusionBonus,

			-- v8: die zweite Fortschrittsachse. `charms` bewusst nur als Anzahl
			-- — die Detailwerte holt man sich ueber "charms <uid>", sonst wird
			-- die Liste in der Command Bar unlesbar.
			promo    = baerchi.promotionLevel or 0,
			stats    = baerchi.statLevels,
			charms   = #(baerchi.charms or {}),
			mutation = baerchi.mutation,
		})
	end
	table.sort(out, function(a, b) return a.uid < b.uid end)
	return out
end

-- Baerchi direkt erzeugen, ohne Ei.
--
-- Das dritte Argument setzt eine Mutation (siehe BaerchiConfig.MUTATIONS fuer
-- gueltige Namen: Gold/Diamond/Bloodrot/Celestial/Candy/Lava/Galaxy/Rainbow).
-- Ohne diesen Weg waeren Mutationen in Studio praktisch nicht testbar: die
-- Gesamtchance beim Schluepfen liegt bei 1.5%, die seltenste Stufe (Rainbow)
-- bei 0.0005% — man muesste also im Schnitt 200'000 Eier ausbrueten.
--   D:Invoke("add", "RedBaerchi", 10)              -- normal
--   D:Invoke("add", "RedBaerchi", 10, "Rainbow")   -- mit Mutation
commands.add = function(player, data, configId: any, level: any, mutation: any)
	local mutationId: any = nil
	if typeof(mutation) == "string" and BaerchiConfig.MUTATIONS[mutation :: any] then
		mutationId = mutation
	end

	local baerchi = BaerchiFactory.create(tostring(configId), {
		level    = tonumber(level) or 1,
		mutation = mutationId,
	})
	if not baerchi then
		return { error = "Unbekannter configId: " .. tostring(configId) }
	end

	data.island.baerchis[baerchi.uid] = baerchi
	PlayerService.markDirty(player)

	return {
		uid      = baerchi.uid,
		configId = baerchi.configId,
		rarity   = baerchi.rarity,
		level    = baerchi.level,
		mutation = baerchi.mutation,
	}
end

-- Faehigkeit eines Baerchis tauschen (zum Testen der Shows).
-- uid "equipped" (oder leer) = der ausgeruestete Baerchi.
--   D:Invoke("skill", "equipped", "OmegaStrike")
commands.skill = function(player, data, uid: any, skillId: any)
	local id = if uid == nil or uid == "equipped" then data.island.equippedUid else tostring(uid)
	local baerchi = if id then data.island.baerchis[id] else nil
	if not baerchi then
		return { error = "Kein Baerchi mit uid " .. tostring(id) }
	end
	if not SkillConfig.getById(tostring(skillId)) then
		return { error = "Unbekannte Faehigkeit: " .. tostring(skillId) }
	end
	local before = baerchi.skillId
	baerchi.skillId = tostring(skillId) :: any
	PlayerService.markDirty(player)
	return { uid = baerchi.uid, configId = baerchi.configId, vorher = before, jetzt = baerchi.skillId }
end

-- Die Kampfwerte eines Baerchis so, wie der Kampf sie sieht. Praktisch, um
-- Promotion, Stat-Stufen, Charms und Mutation gegeneinander nachzurechnen.
commands.stats = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		return { error = "Unbekannter configId: " .. baerchi.configId }
	end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)

	return {
		configId = baerchi.configId,
		level    = baerchi.level,
		mutation = baerchi.mutation,
		promo    = baerchi.promotionLevel or 0,
		maxHp    = stats.maxHp,
		atk      = stats.atk,
		spd      = stats.spd,
		pwrProzent = math.floor(stats.pwr * 100 + 0.5),
		skill    = stats.skillId,
	}
end

-- Gebaeude-Level direkt setzen (umgeht die Kosten)
commands.building = function(player, data, buildingId: any, level: any)
	local building = data.island.buildings[buildingId]
	if not building then
		return { error = "Unbekanntes Gebaeude: " .. tostring(buildingId) }
	end

	-- clampBuildingLevel rundet mit ab: ohne das landete eine 5.5 aus der
	-- Command Bar als Kommazahl in den Daten und jedes spaetere
	-- string.format("%d", level) wuerde daran scheitern.
	building.level = EconomyConfig.clampBuildingLevel(tonumber(level) or 1)
	MapService.updateBuildingLevel(player, buildingId, building.level)
	PlayerService.markDirty(player)

	return { building = buildingId, level = building.level, look = BuildingBehavior.getLook(building.level) }
end

-- v12: Ei ins Lager legen und sofort oeffnen (es gibt keine Brut mehr)
commands.hatch = function(player, data, eggType: any)
	local egg = tostring(eggType or "BasicEgg")
	if not EggConfig.data[egg :: Types.EggType] then
		return { error = "Unbekannter Egg-Typ: " .. egg }
	end

	data.island.eggStock[egg :: Types.EggType] = (data.island.eggStock[egg :: Types.EggType] or 0) + 1
	local result = EggService.openEgg(player, egg :: Types.EggType)
	if not result then
		return { error = "Oeffnen fehlgeschlagen" }
	end

	return {
		configId = result.baerchi.configId,
		rarity   = result.baerchi.rarity,
		mutation = result.baerchi.mutation,
		neu      = result.isNew,
	}
end

-- v12: Eier ins Lager legen, ohne sie zu oeffnen (fuer Tests im Ei-Menue)
commands.egg = function(player, data, eggType: any, count: any)
	local egg = tostring(eggType or "BasicEgg")
	if not EggConfig.data[egg :: Types.EggType] then
		return { error = "Unbekannter Egg-Typ: " .. egg }
	end

	local amount = math.clamp(tonumber(count) or 1, 1, 100)
	data.island.eggStock[egg :: Types.EggType] = (data.island.eggStock[egg :: Types.EggType] or 0) + amount
	PlayerService.markDirty(player)
	return { lager = data.island.eggStock }
end

-- v12/v15: gespeicherten letzten Lauf im gewaehlten Tower setzen (0 = loeschen)
commands.pitprogress = function(player, data, stage: any)
	local reached = math.floor(tonumber(stage) or 0)
	local towerId = data.towers.selected
	data.island.towerProgress[towerId] = if reached > 0 then reached else nil
	PlayerService.markDirty(player)
	return { tower = towerId, towerProgress = data.island.towerProgress }
end

-- v15: Tower waehlen (auch einen noch geschlossenen) und ab `stage` kaempfen.
-- Die Fortsetzungs-Kosten werden vorher gutgeschrieben (Test ohne Grind).
commands.tower = function(player, data, towerId: any, stage: any)
	local id = tostring(towerId or "I")
	local def = TowerConfig.get(id)
	if not def then
		return { error = "Unbekannter Tower: " .. id .. " (I, II, III, Final)" }
	end
	local uid = data.island.equippedUid
	if not uid then
		return { error = "Kein Baerchi ausgeruestet" }
	end
	TowerService.debugOpenAll(data)
	data.towers.selected = id
	local start = math.clamp(math.floor(tonumber(stage) or 1), 1, def.stages)
	local choice = "Fresh"
	if start > 1 then
		data.island.towerProgress[id] = start
		local _, cost = CombatService.getResumeOffer(data, id, "Last")
		if cost > 0 then EconomyService.awardGummiesFlat(player, cost) end
		choice = "Last"
	end
	PlayerService.markDirty(player)
	task.spawn(PetModeService.request, player, "Fight", choice :: any)
	return {
		tower = id, ab = start, deckel = TowerConfig.getStageCap(data.rebirthCount, id, TowerConfig.unlockRecords(data.towers, data.island), data.towers.unlocked),
		gegnerStage1 = TowerConfig.getEnemyStats(id, start),
	}
end

-- 08.10. (Paket C): Gamepass-Besitz fuer diese Sitzung erzwingen.
-- D:Invoke("pass", "on")  /  ("pass", "off")  /  ("pass", "reset") = wieder Roblox
-- Optional mit Key: D:Invoke("pass", "on", "SKIP_PASS")
commands.pass = function(player, _data, mode: any, key: any)
	local passKey = tostring(key or "SKIP_PASS")
	local m = tostring(mode or "on")
	local value: boolean? = if m == "on" then true elseif m == "off" then false else nil
	GamepassService.debugSet(player, passKey, value)
	return { pass = passKey, besitz = GamepassService.owns(player, passKey) }
end

-- v15: Tower-Rekord direkt setzen (Meilensteine bis dorthin werden ausgezahlt)
commands.towerrecord = function(player, data, towerId: any, stage: any)
	local id = tostring(towerId or "I")
	if not TowerConfig.get(id) then
		return { error = "Unbekannter Tower: " .. id }
	end
	TowerService.debugSetRecord(player, id, tonumber(stage) or 0)
	return { towers = data.towers }
end

-- v15: Deckel des aktuellen Rebirths
commands.rebirthcap = function(_player, data)
	local caps: { [string]: number } = {}
	for _, def in TowerConfig.TOWERS do
		caps[def.id] = TowerConfig.getStageCap(data.rebirthCount, def.id, TowerConfig.unlockRecords(data.towers, data.island), data.towers.unlocked)
	end
	local capTower, capStage = TowerConfig.getCap(data.rebirthCount)
	return { rebirths = data.rebirthCount, deckelTower = capTower, deckelStage = capStage, proTower = caps }
end

-- Sammel-Update 05.10. (Paket 4.1): beste Stage dieses Lebens setzen und die
-- Rebirth-Bedingung zeigen. D:Invoke("stagebest", "I", 30)
commands.stagebest = function(player, data, towerId: any, stage: any)
	if typeof(towerId) == "string" and TowerConfig.get(towerId) then
		data.island.stageBest[towerId] = math.max(0, math.floor(tonumber(stage) or 0))
		PlayerService.markDirty(player)
	end
	local reqTower, reqStage = TowerConfig.getRebirthRequirement(data.rebirthCount, data.towers.records)
	return {
		stageBest  = data.island.stageBest,
		bedingung  = reqTower .. "/" .. reqStage,
		bereit     = TowerConfig.isRebirthReady(data.rebirthCount, data.island.stageBest, data.towers.records),
	}
end

-- Sammel-Update 05.10. (Paket 8): Inkubator-Stand; "done" macht alle Eier fertig.
commands.incubator = function(player, data, action: any)
	local incubator = data.island.incubator
	if action == "done" then
		for _, entry in incubator.slots do entry.finishAt = os.time() end
		PlayerService.markDirty(player)
	elseif action == "breed" then
		-- INCUBATOR_BREED: jedes Baerchi im Inkubator bruetet sofort ein Ei.
		-- Lazy require: kein weiterer Modul-Local (200er-Grenze).
		local made = require(ServerScriptService.Services.IncubatorService).breedNow(player)
		return { gebruetet = made, baerchis = incubator.breeders }
	end
	return { level = incubator.level, plaetze = incubator.slots, baerchis = incubator.breeders }
end

-- v15: Login-Bonus — so tun, als waeren `days` Tage vergangen
commands.dailyshift = function(player, _data, days: any)
	return LoginBonusService.debugShift(player, math.floor(tonumber(days) or 1))
end

-- v15: Bestenlisten sofort schreiben und neu lesen
commands.lbflush = function(_player, _data)
	return LeaderboardService.flush()
end

-- v15: Teile auf der eigenen Insel zaehlen (Budget: 250 ohne Baerchi-Figuren)
commands.parts = function(player, _data)
	return MapService.countParts(player) or { error = "kein Plot" }
end

-- Welt aufwerten: Debug-Signale an die Client-Controller (workspace-Attribute,
-- siehe WorldFXKit.onDebug). Ein Zaehler im Wert sorgt dafuer, dass derselbe
-- Befehl zweimal hintereinander auch zweimal ausloest.
local _worldSignal = 0
local function worldSignal(attribute: string, value: any)
	_worldSignal += 1
	workspace:SetAttribute(attribute, if value == nil then tostring(_worldSignal) else value)
end

commands.worldshots = function(_player, _data, index: any)
	local n = tonumber(index)
	if n == nil then
		local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
		local names = {}
		for _, shot in WorldFXConfig.WORLD_SHOTS do table.insert(names, shot.name) end
		return { hinweis = "worldshots <1..6> (0 = zurueck)", punkte = names }
	end
	_worldSignal += 1
	workspace:SetAttribute("DebugWorldShot", string.format("%d|%d", n, _worldSignal))
	return { punkt = n }
end

commands.daytime = function(_player, _data, hour: any)
	local h = tonumber(hour)
	workspace:SetAttribute("DebugDayTime", if h then h else -1)
	return { tageszeit = if h then h else "auto" }
end

commands.pitstate = function(_player, _data, state: any)
	local value = tostring(state or "auto")
	workspace:SetAttribute("DebugPitState", value)
	return { pit = value }
end

commands.neststate = function(_player, _data, state: any)
	local value = tostring(state or "auto")
	workspace:SetAttribute("DebugNestState", value)
	return { nest = value }
end

commands.arrival = function(_player, _data)
	worldSignal("DebugArrival", nil)
	return { ankunft = true }
end

commands.fish = function(_player, _data)
	worldSignal("DebugFish", nil)
	return { fisch = true }
end

-- Paket D: Insel-Stufe am Player-Attribut (wie PlotDisplayService), "auto"
-- rechnet sie aus dem Spielstand neu.
commands.islandstage = function(player, data, stage: any)
	local IslandStage = require(ReplicatedStorage.Modules.IslandStage)
	local n = tonumber(stage)
	local value = if n then math.clamp(math.floor(n), 1, IslandStage.MAX)
		else IslandStage.compute(data.towers and data.towers.records, data.rebirthCount or 0)
	player:SetAttribute("IslandStage", value)
	return { stufe = value }
end

-- Paket D: Teich voll (alle Honig-Lager voll, wie "honey"), damit der Ueberlauf laeuft
commands.pondfull = function(player, data)
	local result = commands.honey(player, data)
	return { teich = "voll", honig = result }
end

-- Paket E: Zuschauer-Baerchis an der eigenen Arena testen
commands.spectators = function(player, _data, mode: any)
	_worldSignal += 1
	workspace:SetAttribute("DebugSpectators", string.format("%d|%s|%d", player.UserId, tostring(mode or "hop"), _worldSignal))
	return { zuschauer = tostring(mode or "hop") }
end

-- Paket G: Welt-Moment wie vom Server erkannt an alle schicken (ohne den
-- Spielstand zu aendern). Erzwingt "gross", damit man jede Art sieht.
commands.moment = function(player, _data, kind: any, value: any)
	local WorldMomentService = require(ServerScriptService.Services.WorldMomentService)
	local k = tostring(kind or "hatch")
	local defaults = { hatch = "Cosmic", tower = "II", record = "I", rebirth = "1", mutation = "Galaxy" }
	local v = if value ~= nil then tostring(value) else defaults[k] or "?"
	WorldMomentService.announce(player, { kind = k :: any, value = v, number = 42 }, true)
	return { moment = k, wert = v }
end

-- Paket G: fuenf grosse Momente auf einmal (Client muss sie nacheinander zeigen)
commands.moments5 = function(player, _data)
	local WorldMomentService = require(ServerScriptService.Services.WorldMomentService)
	for _, m in { { "hatch", "Mythic" }, { "tower", "III" }, { "rebirth", "2" }, { "mutation", "Rainbow" }, { "hatch", "Omega" } } do
		WorldMomentService.announce(player, { kind = m[1] :: any, value = m[2], number = 2 }, true)
	end
	return { momente = 5 }
end

-- Paket E: Rekord-Moment am eigenen Schau-Turm
commands.record = function(player, _data)
	_worldSignal += 1
	workspace:SetAttribute("DebugRecord", string.format("%d|%d", player.UserId, _worldSignal))
	return { rekord = true }
end

-- v15: den aktuellen Spielstand in ein v14-Format zuruckverwandeln (Topf L7,
-- Presse L4, PIT 5, letzter Lauf Stage 12) und durch die Migration schicken —
-- das Ergebnis wird NICHT uebernommen, nur angezeigt (Migrations-Probe).
commands.v14save = function(_player, data)
	local HttpServiceLocal = game:GetService("HttpService")
	local copy = HttpServiceLocal:JSONDecode(HttpServiceLocal:JSONEncode(data))
	copy.version = 14
	copy.towers = nil
	copy.daily = nil
	copy.island.towerProgress = nil
	copy.island.pitRefund = nil
	copy.island.pitLevel = 5
	copy.island.pitProgress = { pitLevel = 5, reachedStage = 12 }
	copy.island.buildings.HoneyRefiner = nil
	copy.island.buildings.HoneyPot   = { id = "HoneyPot",   level = 7, honey = 4, lastProducedAt = os.time() }
	copy.island.buildings.HoneyPress = { id = "HoneyPress", level = 4, honey = 5, lastProducedAt = os.time() }
	local migrated = PlayerMigration.applyDefaults(copy)
	return {
		version   = migrated.version,
		veredler  = migrated.island.buildings.HoneyRefiner,
		erstattung = migrated.island.pitRefund,
		rekorde   = migrated.towers.records,
	}
end

commands.petmode = function(player, data)
	local pitPhase, stage = PitArenaService.getPhase(player)
	return {
		zuHause     = PetModeService.isHome(player),
		pit         = pitPhase,
		stage       = stage,
		event       = EventParticipationService.getPhase(player),
		-- Sammel-Update Paket 1.1: wer haelt die Figur gerade? (UFO-Einfrieren)
		lockHalter  = ActivityLock.owner(player) or "frei",
		entfuehrt   = EventParticipationService.isAbducting(player),
		towerProgress = data.island.towerProgress,
		eggStock    = data.island.eggStock,
		gummies     = data.gummies,
		lastEggAt   = data.island.lastEggAt,
	}
end

commands.pm = function(player, data, mode: any, resume: any)
	PetModeService.request(player, tostring(mode or "Home"), if resume then tostring(resume) :: any else nil)
	return commands.petmode(player, data)
end

commands.fight = function(player, _data, uid: any)
	CombatService.startPitRun(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

-- Alle Honig-Lager sofort fuellen (umgeht die Wartezeit).
-- Ohne das dauert jeder Level-Test 20 Sekunden pro Honig.

-- v15: Waben im Event-Pit legen und Zustand ausgeben
commands.combs = function(player, data, n: any)
	local count = if typeof(n) == "number" then math.clamp(math.floor(n), 0, 100) else 0
	if count > 0 then
		CombService.debugSpawn(count)
	end

	local recycler = data.island.recycler
	local slots = CombService.getSlotInfo()
	return {
		wabenImPit    = CombService.getWorldCount(),
		getragen      = CombService.getCarriedCount(player),
		getragenAlle  = slots.held,
		respawnQueue  = slots.queued,
		slotLimit     = slots.limit,
		recyclerLevel = recycler.level,
		warteschlange = recycler.queued,
	}
end

-- v17: naechsten UFO-Abwurf als Jackpot erzwingen; Stand des Pity-Zaehlers
commands.jackpot = function(_player, _data)
	JackpotRoll.ufo.forceNext = true
	return {
		naechsterIstJackpot = true,
		abwuerfeSeitJackpot = JackpotRoll.ufo.sinceLast,
		abwuerfeGesamt      = JackpotRoll.ufo.total,
		jackpotsGesamt      = JackpotRoll.ufo.jackpots,
		pity                = EventConfig.UFO.JACKPOT_PITY_DROPS,
	}
end

-- v17: Wabenthema setzen ("off" = normal)
commands.combtheme = function(_player, _data, themeId: any)
	local id = if typeof(themeId) == "string" and themeId ~= "off" then themeId else nil
	CombService.setTheme(id)
	local slots = CombService.getSlotInfo()
	return { thema = CombService.getTheme() or "normal", wabenImPit = slots.world, slotLimit = slots.limit }
end

-- v17: Waben einfliegen lassen (wie ein Vulkan-Ausbruch aus der Pit-Mitte)
commands.launch = function(_player, _data, n: any)
	local count = if typeof(n) == "number" then math.clamp(math.floor(n), 1, 30) else 10
	local origin = MapService.getEventPitPosition() + Vector3.new(0, 2, 0)
	return { gestartet = CombService.launchCombs(count, origin), slots = CombService.getSlotInfo() }
end

-- v15: Wabeneinheiten direkt in die Warteschlange des Recyclers legen
commands.queue = function(player, data, n: any)
	local units = if typeof(n) == "number" then math.clamp(math.floor(n), 0, 100000) else 0
	if units > 0 then
		CombRecyclerService.deposit(player, units)
	end

	local recycler = data.island.recycler
	return {
		warteschlange = recycler.queued,
		level         = recycler.level,
		gummies       = data.gummies,
	}
end

-- v15: Recycler-Level direkt setzen (ohne Kosten)
commands.recycler = function(player, data, level: any)
	local recycler = data.island.recycler
	if typeof(level) == "number" then
		recycler.level = CombConfig.clampLevel(level)
		PlayerService.markDirty(player)
	end

	return {
		level         = recycler.level,
		gummiesJeEinheit = CombConfig.getPayPerUnit(recycler.level),
		einheitenProSek  = CombConfig.getSpeed(recycler.level),
		warteschlange = recycler.queued,
	}
end

commands.honey = function(player, data)
	local filled: { [string]: number } = {}

	for _, building in data.island.buildings do
		-- Lager DIESES Gebaeudes auf DIESEM Level: der Bienenstock fasst seit
		-- v7 mehr als die anderen beiden.
		building.honey          = BuildingBehavior.getCapacity(building.id, building.level)
		building.lastProducedAt = os.time()
		filled[building.id]     = building.honey
	end

	PlayerService.markDirty(player)
	return { honey = filled }
end

-- Einen Baerchi fuettern (heilt + gibt XP), so oft wie angegeben
commands.feed = function(player, _data, uid: any, times: any)
	local count = math.clamp(tonumber(times) or 1, 1, 100)

	for _ = 1, count do
		HoneyService.feed(player, tostring(uid))
	end

	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Fusion. Die beiden letzten Argumente sind der Sperr-Schritt aus dem
-- Fusions-Menue (siehe FusionService, Regel C) und duerfen weggelassen werden —
-- dann laeuft alles automatisch.
--   D:Invoke("fuse", uidA, uidB)                   -- alles automatisch
--   D:Invoke("fuse", uidA, uidB, "ability", "B")   -- Skill kommt von B
commands.fuse = function(player, _data, uidA: any, uidB: any, lockedProperty: any, lockedFrom: any)
	local property = if lockedProperty ~= nil then tostring(lockedProperty) else nil
	local from     = if lockedFrom ~= nil then tostring(lockedFrom) else nil

	FusionService.fuse(player, tostring(uidA), tostring(uidB), property :: any, from :: any)
	return commands.list(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v8: Promotion, Charms, Event-Teilnahme
--------------------------------------------------------------------------------

-- Befoerdern. Legt die noetigen Duplikate NICHT selbst an — wer testen will,
-- ruft vorher mehrfach "add <configId>" auf. Genau so merkt man, ob die
-- Material-Pruefung tut, was sie soll.
commands.promote = function(player, _data, uid: any)
	PromotionService.promote(player, tostring(uid))
	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Charms wuerfeln. Kostet echte GoldGummies — vorher "give 0 100000".
commands.roll = function(player, _data, uid: any, times: any)
	CharmService.rollCharms(player, tostring(uid), tonumber(times) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Alle acht Slots eines Baerchis im Klartext.
commands.charms = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local bySlot: { [number]: any } = {}
	for _, charm in baerchi.charms or {} do
		bySlot[charm.slot] = charm
	end

	local out = {}
	for slot = 1, CharmConfig.SLOT_COUNT do
		local charm = bySlot[slot]
		out[slot] = {
			slot     = CharmConfig.SLOT_NUMERALS[slot],
			offen    = CharmConfig.isSlotUnlocked(slot, baerchi.promotionLevel or 0),
			abPromo  = CharmConfig.getUnlockPromotion(slot),
			rarity   = if charm then charm.rarity else nil,
			effekt   = if charm then CharmConfig.describe(charm) else nil,
			gesperrt = if charm then charm.locked else nil,
		}
	end

	return { promotion = baerchi.promotionLevel or 0, slots = out }
end

-- Einen Charm-Slot sperren/freigeben.
commands.lock = function(player, _data, uid: any, slot: any)
	CharmService.toggleLock(player, tostring(uid), tonumber(slot) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Den ausgeruesteten Baerchi zum Event schicken bzw. zurueckholen.
commands.event = function(player, _data)
	EventParticipationService.sendToEvent(player)
	return { unterwegs = true }
end

commands.recall = function(player, _data)
	EventParticipationService.recall(player)
	return { unterwegs = true }
end

--------------------------------------------------------------------------------
-- v10: Eier legen
--------------------------------------------------------------------------------

-- Legt sofort ein Ei, ohne auf das Intervall zu warten. Mehrfach aufrufen, um
-- den Plot zu fuellen und die Obergrenze zu pruefen.
commands.lay = function(player, _data, times: any)
    local count  = math.clamp(tonumber(times) or 1, 1, 30)
    local laid   = 0

    for _ = 1, count do
        if EggLayService.layNow(player) then
            laid += 1
        else
            break   -- Obergrenze erreicht oder kein Baerchi ausgeruestet
        end
    end

    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Was gerade herumliegt, plus die Werte des ausgeruesteten Legers.
commands.eggs = function(_player, data)
    local out = {}
    for _, egg in data.island.laidEggs or {} do
        table.insert(out, { uid = egg.uid, typ = egg.eggType })
    end

    local uid     = data.island.equippedUid
    local baerchi = if uid then data.island.baerchis[uid] else nil

    local rate: any = "kein Baerchi ausgeruestet"
    local chancen: any = nil

    if baerchi then
        local online  = EggCalculator.getLayIntervalSeconds(baerchi, false)
        local offline = EggCalculator.getLayIntervalSeconds(baerchi, true)

        rate = {
            configId       = baerchi.configId,
            level          = baerchi.level,
            eggStufe       = (baerchi.statLevels :: any).egg or 0,
            mutation       = baerchi.mutation,
            sekundenOnline = if online then math.floor(online + 0.5) else nil,
            sekundenOffline= if offline then math.floor(offline + 0.5) else nil,
        }

        chancen = {}
        for _, chance in EggCalculator.getChances(baerchi) do
            table.insert(chancen, string.format("%s %.0f%%", chance.eggType, chance.percent))
        end
    end

    return {
        liegen  = #out,
        maximum = EggConfig.MAX_UNCOLLECTED_EGGS,
        eier    = out,
        lager   = data.island.eggStock,
        leger   = rate,
        chancen = chancen,
    }
end

-- Alle herumliegenden Eier einsammeln (dasselbe wie der Knopf auf der Karte).
commands.collect = function(player, _data)
    EggLayService.collectAll(player)
    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Die Zeitmarke kuenstlich in die Vergangenheit setzen und danach nachrechnen
-- lassen — so laesst sich das OFFLINE-Nachholen pruefen, ohne den Server zu
-- verlassen. Der naechste Tick (max. 5s) legt dann die faelligen Eier.
--
-- Achtung: der Tick rechnet mit der ONLINE-Rate. Das echte Offline-Verhalten
-- (langsamer, siehe EggConfig.OFFLINE_SLOWDOWN) sieht man nur beim Rejoin.
commands.eggtime = function(player, data, minutes: any)
    local back = math.clamp(tonumber(minutes) or 30, 1, 10000)
    data.island.lastEggAt = os.time() - back * 60
    PlayerService.markDirty(player)

    return { zurueckgestellt = back .. " Minuten", hinweis = "naechster Tick legt nach (max. 5s)" }
end

-- Die laufende Phase sofort beenden. Zweimal aufgerufen bekommt man also aus
-- der Pause heraus ein vollstaendiges Event samt Belohnung, ohne acht Minuten
-- zu warten:
--   D:Invoke("skipevent")   -- Pause vorbei, Event laeuft
--   D:Invoke("event")       -- Baerchi hinschicken, ankommen lassen
--   D:Invoke("skipevent")   -- Event vorbei → Stat-Stufe wird vergeben
commands.skipevent = function(_player, _data)
	EventService.skipPhase()

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		belohnung    = if active then Loc.resolve(EventConfig.describeReward(active)) else nil,
		naechstes    = EventService.getNext().displayName,
		restSekunden = EventService.getRemainingSeconds(),
	}
end

-- Der ganze Katalog mit Belohnung, in der Reihenfolge, in der die Events
-- laufen. Praktisch, um die ids fuer "startevent" nachzuschlagen.
commands.events = function(_player, _data)
	local katalog = {}
	for index, def in EventConfig.EVENTS do
		table.insert(katalog, string.format(
			"%d. %s (%s) — %s",
			index, def.displayName, def.id, Loc.resolve(EventConfig.describeReward(def))
		))
	end

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		restSekunden = EventService.getRemainingSeconds(),
		naechstes    = EventService.getNext().displayName,
		takt         = string.format(
			"individuelle Dauer je Event / %ds Pause",
			EventConfig.EVENT_GAP_SECONDS
		),
		katalog      = katalog,
	}
end

-- Ein BESTIMMTES Event sofort starten, statt sich durch den Zyklus zu warten.
-- Ein voller Durchlauf durch alle zehn Events dauert 80 Minuten — ohne diesen
-- Befehl waere z.B. der Mutations-Sturm praktisch nicht testbar.
--
-- Laeuft gerade ein anderes Event, wird es vorher ordentlich beendet (die
-- Anwesenden bekommen also noch ihre Belohnung, siehe EventService.startById).
commands.startevent = function(_player, _data, id: any)
	local eventId = tostring(id or "")

	if not EventService.startById(eventId) then
		local ids = {}
		for _, def in EventConfig.EVENTS do
			table.insert(ids, def.id)
		end
		return { error = "Unbekannte Event-id: " .. eventId, verfuegbar = ids }
	end

	local active = EventService.getActive()
	return {
		gestartet    = if active then active.displayName else "?",
		belohnung    = if active then Loc.resolve(EventConfig.describeReward(active)) else nil,
		restSekunden = EventService.getRemainingSeconds(),
		hinweis      = "jetzt 'event' aufrufen, um den Baerchi hinzuschicken — er muss beim ENDE dort stehen",
	}
end

commands.recycle = function(player, _data, uid: any)
	RecycleService.recycle(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.upgrade = function(player, _data, buildingId: any)
	IslandService.upgradeBuilding(player, buildingId)
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.rebirth = function(player, _data)
	RebirthService.rebirth(player)
	return commands.info(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v14: Ei-Baum
--------------------------------------------------------------------------------

commands.tree = function(_player, data)
	local out = { blueprints = data.eggTree.blueprints, rebirths = data.rebirthCount }
	for _, eggId in EggConfig.getOrderedIds() do
		local p = EggTree.getProgress(data, eggId)
		local parts = {}
		for _, c in p.conditions do
			local label = c.kind .. (if c.egg then ":" .. c.egg elseif c.rarity then ":" .. c.rarity else "")
			table.insert(parts, string.format("%s %d/%d%s", label, c.have, c.need, if c.done then " ok" else ""))
		end
		out[string.format("%02d %s", EggConfig.data[eggId].sortOrder, eggId)] = string.format("%s | hatched %d | lager %d | %s",
			if p.unlocked then "FREI" else "zu", data.eggTree.hatched[eggId] or 0,
			data.island.eggStock[eggId] or 0, table.concat(parts, ", "))
	end
	return out
end

commands.unlock = function(player, data, eggType: any)
	if eggType == "all" then
		for _, eggId in EggConfig.getOrderedIds() do
			EggTreeService.forceUnlock(player, data, eggId, "debug")
		end
	elseif typeof(eggType) == "string" and EggConfig.data[eggType :: Types.EggType] then
		EggTreeService.forceUnlock(player, data, eggType :: Types.EggType, "debug")
	else
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.hatched = function(player, data, eggType: any, count: any)
	if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	data.eggTree.hatched[eggType] = math.max(0, math.floor(tonumber(count) or 0))
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.blueprint = function(player, data, amount: any)
	EggTreeService.grantBlueprint(player, data, tonumber(amount) or 1)
	PlayerService.markDirty(player)
	return { blueprints = data.eggTree.blueprints }
end

commands.useblueprint = function(player, data, eggType: any)
	local ok = EggTreeService.useBlueprint(player, eggType)
	return { ok = ok, tree = commands.tree(player, data) }
end

commands.press = function(player, data, eggType: any, path: any)
	local result = EggTreeService.press(player, eggType, path)
	return { result = result, stock = data.island.eggStock }
end

commands.setrebirth = function(player, data, count: any)
	data.rebirthCount = math.max(0, math.floor(tonumber(count) or 0))
	data.rebirthMult  = EconomyConfig.getRebirthMult(data.rebirthCount)
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

-- Spielstand fuer Tests sichern und zuruecksetzen. Die Kopie liegt nur im
-- Speicher dieses Servers (nicht im DataStore).
local HttpService = game:GetService("HttpService")
local _snapshot: string? = nil

commands.snapshot = function(_player, data)
	_snapshot = HttpService:JSONEncode(data)
	return { ok = true, bytes = #(_snapshot :: string) }
end

commands.restore = function(player, data)
	if not _snapshot then return { error = "Kein Snapshot" } end
	local saved = HttpService:JSONDecode(_snapshot :: string)
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in saved do (data :: any)[k] = v end
	MapService.rebuildIsland(player, data.island)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return { ok = true }
end

-- HBB Paket 0: feste Test-Zustaende fuer Playtests und Studio-Testschritte.
--   fresh   = Startstand eines neuen Kontos (createdAt = jetzt → Trichter misst)
--   hatch10 = fresh + zehn geoeffnete Basis-Eier
--   tower1  = hatch10 + Tower I geschafft (Rekord 30, Meilensteine ausgezahlt)
--
-- Studio spielt gegen den ECHTEN DataStore. Deshalb verlangt der Befehl einen
-- vorherigen "snapshot"; zurueck geht es mit "restore". Der Snapshot liegt nur
-- im Speicher dieses Servers — vor "Stop" also restore aufrufen.
--
-- Der Baerchi sollte zu Hause stehen (kein Kampf, kein Event), sonst haelt ein
-- anderer Service noch die alte Figur.
local TEST_STATES = { fresh = true, hatch10 = true, tower1 = true }
local TEST_HATCH_COUNT = 10
local TEST_TOWER_RECORD = 30

commands.state = function(player, data, name: any)
	local stateName = tostring(name or "")
	if not TEST_STATES[stateName] then
		return { error = "Unbekannter Zustand: " .. stateName, verfuegbar = { "fresh", "hatch10", "tower1" } }
	end
	if not _snapshot then
		return { error = "Erst D:Invoke(\"snapshot\") — Studio schreibt in den echten Spielstand" }
	end

	-- 1. fresh: alles ersetzen ausser Sitzungs-Sperre und Sprache
	local session  = (data :: any).session
	local language = data.language
	local fresh = PlayerService.buildDefaultData()
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in fresh :: any do (data :: any)[k] = v end
	;(data :: any).session = session
	data.language = language
	MapService.rebuildIsland(player, data.island)
	FunnelService.debugReset(player)

	-- 2. hatch10: ueber den echten Weg oeffnen, damit Zaehler, Index und
	-- Auto-Ausruesten genau wie im Spiel laufen.
	if stateName == "hatch10" or stateName == "tower1" then
		data.island.eggStock.BasicEgg = (data.island.eggStock.BasicEgg or 0) + TEST_HATCH_COUNT
		for _ = 1, TEST_HATCH_COUNT do
			EggService.openEgg(player, "BasicEgg")
		end
	end

	-- 3. tower1: Rekord setzen, Meilensteine wie bei "towerrecord"
	if stateName == "tower1" then
		TowerService.debugSetRecord(player, "I", TEST_TOWER_RECORD)
	end

	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return {
		ok = true,
		zustand = stateName,
		baerchis = countBaerchis(data),
		lager = data.island.eggStock,
		rekorde = data.towers.records,
		hinweis = "Zurueck mit D:Invoke(\"restore\")",
	}
end

-- Ein einzelner Kampf mit Runden-Log (Faehigkeiten pruefen).
commands.skilltest = function(_player, _data, configId: any, stage: any)
	local b = BaerchiFactory.create(tostring(configId), { level = 20 })
	if not b then return { error = "Unbekannter Baerchi" } end
	local def = BaerchiConfig.getById(b.configId)
	local stats = CombatCalculator.getEffectiveStats(b, (def :: any).baseStats)
	local es = CombatConfig.getEnemyStats(1, tonumber(stage) or 20)
	local me = { uid = "me", stats = stats, hp = stats.maxHp, charge = 0 }
	local en = { uid = "en", stats = es, hp = es.maxHp, charge = 0 }
	local r = CombatCalculator.simulate(me, en)
	local lines = {}
	for i, e in r.log do
		if i > 40 then break end
		table.insert(lines, string.format("%s r%d %s dmg %d heal %d abs %d | A %d B %d %s",
			e.actor, e.roundNumber, e.skillId or "-", e.damage, e.heal, e.absorbed,
			e.attackerHpAfter, e.defenderHpAfter, if e.effects then table.concat(e.effects, ",") else ""))
	end
	return { winner = r.winnerUid, rounds = r.rounds, skillUses = r.skillUses, log = lines }
end

commands.help = function()
	return {
		"info", "give <gummies> <gold>", "list",
		"add <configId> <level> [mutation]", "stats <uid>",
		"building <id> <level>",
		"hatch <eggType>", "egg <eggType> [anzahl]", "pitprogress <stage>", "honey", "feed <uid> <times>",
		"fight <uid>", "skill <uid|equipped> <skillId>",
		"fuse <uidA> <uidB> [ability|level|eggs] [A|B]",
		"recycle <uid>", "upgrade <buildingId>", "rebirth",

		-- v8
		"promote <uid>", "charms <uid>", "roll <uid> [anzahl]", "lock <uid> <slot>",
		"event", "recall", "skipevent", "events", "startevent <eventId>",

		-- v10
		"eggs", "lay [anzahl]", "collect", "eggtime <minuten>",

		-- v12
		"petmode", "pm <Event|Fight|Home> [Fresh|Percent|Last]",

		-- v14
		"tree", "unlock <eggType|all>", "hatched <eggType> <n>", "blueprint [n]",
		"useblueprint <eggType>", "press <eggType> [Gold|Kristall|Void]", "setrebirth <n>",
		"skilltest <configId> [stage]", "snapshot", "restore",
		-- HBB Paket 0
		"state <fresh|hatch10|tower1>  (erst snapshot!)",

		-- v15
		"combs [anzahl]", "queue <einheiten>", "recycler [level]",

		-- v15 (Tower/Gebaeude/Angeben/Login-Bonus)
		"tower <I|II|III|Final> <stage>", "towerrecord <id> <stage>", "rebirthcap",
		"pass <on|off|reset> [KEY]  (08.10.: Gamepass Gratis-Skip testen)",
		"dailyshift <tage>", "lbflush", "parts", "v14save",

		-- v17
		"jackpot", "combtheme <themeId|off>", "launch [anzahl]",

		-- Welt aufwerten
		"worldshots [1..6|0]", "daytime <uhrzeit|auto>", "pitstate <idle|soon|live|auto>",
		"neststate <calm|boss|auto>", "arrival", "fish",
		"islandstage <1..4|auto>", "pondfull", "spectators <hop|cheer>", "record",
		"moment <hatch|tower|record|rebirth|mutation> [wert]", "moments5",
	}
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function DebugService.init()
	if not RunService:IsStudio() then
		return   -- im Live-Spiel gibt es diesen Service schlicht nicht
	end

	local existing = ServerScriptService:FindFirstChild(BINDABLE_NAME)
	if existing then existing:Destroy() end

	local bindable = Instance.new("BindableFunction")
	bindable.Name   = BINDABLE_NAME
	bindable.Parent = ServerScriptService

	bindable.OnInvoke = function(command: any, ...)
		local name = tostring(command or "help")
		local handler = commands[name]
		if not handler then
			return { error = "Unbekannter Befehl: " .. name, verfuegbar = commands.help() }
		end

		if name == "help" then
			return commands.help()
		end

		local player, data, reason = requireData()
		if not player or not data then
			return { error = reason }
		end

		local ok, result = pcall(handler, player, data, ...)
		if not ok then
			return { error = tostring(result) }
		end
		return result
	end

	print("[DebugService] Initialisiert | Command Bar: game.ServerScriptService." .. BINDABLE_NAME .. ":Invoke(\"help\")")
end

return DebugService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX15"><Properties>
<string name="Name">MapService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- MapService.luau
-- ServerScriptService/Services/MapService.luau
--
-- Einzige Zustaendigkeit:
--   - Die einzige Schnittstelle zur gebauten Welt: Welt beim Start bauen
--     lassen, Spieler-Plots vergeben, spawnen, neu aufbauen und despawnen,
--     und die sichtbaren Teile aktuell halten (Schilder, Figur, Teich, Eier,
--     Lauf-Turm, Tower-Turm, Event-Pit)
--
-- Das eigentliche BAUEN steht in den Modulen unter Util/MapBuild (MapParts,
-- WorldBuilder, PlotBuilder, PondBuilder, ArenaBuilder, FigureBuilder,
-- LaidEggBuilder). Dieser Service haelt den Zustand (welcher Spieler welchen
-- Slot und welches Plot-Model hat) und entscheidet, WANN gebaut wird. Andere
-- Services sprechen nur mit MapService, nie mit den Buildern.
--
-- Baut physische Roblox-Parts aus IslandData.
-- Kennt keine Spielerdaten ausser IslandData (und den Namen fuer das Schild).
--
-- Alle Masse, Farben und Offsets kommen aus MapConfig. Wie das plot-lokale
-- Koordinatensystem funktioniert (lokales -Z = Richtung Mitte, +Z = nach
-- aussen), steht im Kopf von MapConfig.
--
-- ZWEI ARTEN VON AKTUALISIERUNG — bewusst getrennt:
--   * NEU BAUEN (updateBaerchis, updateBuildingLooks, updateTowerShowcase):
--     teuer, nur wenn sich die Struktur aendert (ein Baerchi kommt dazu, faellt
--     weg oder steigt im Level; ein Gebaeude wechselt den Look; der Tower-Turm
--     bekommt einen neuen Look oder Rekord).
--   * IN-PLACE (updateBaerchiStates, updateBuildingSigns): billig, aendert nur
--     Beschriftung und Transparenz an bereits stehenden Teilen. Dafuer gibt es
--     die Trennung: HP und Honig aendern sich staendig, und dafuer jedes Mal
--     25 Mesh-Figuren neu zu bauen waere Verschwendung.
--   PlotDisplayService entscheidet welche der beiden noetig ist.
--
-- NEUAUFBAU WAEHREND EINER BEWEGUNG — die eine Sperre in dieser Datei:
-- updateBaerchis zerstoert die Figur und baut sie neu. Laeuft sie in dem
-- Moment gerade (Kampf-Lauf oder Weg zum Honig-Teich), verschwaende sie mitten
-- im Schritt. Die Pruefung dagegen steht EINMAL hier drin statt an jeder
-- Aufrufstelle — und der uebersprungene Neuaufbau wird nachgeholt, sobald das
-- Schloss frei ist (siehe scheduleRebuildWhenFree weiter unten). Ohne das
-- Nachholen bliebe die Beschriftung dauerhaft veraltet, weil der Aufrufer
-- (PlotDisplayService) den neuen Stand direkt danach als "dargestellt" merkt.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig = require(ReplicatedStorage.Config.MapConfig)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types     = require(ReplicatedStorage.Network.Types)
local WorldText = require(ReplicatedStorage.Localization.WorldText)
local Loc       = require(ReplicatedStorage.Localization.Loc)

local ActivityLock = require(ServerScriptService.Util.ActivityLock)
local FigureFX     = require(ServerScriptService.Util.FigureFX)

local MapBuild       = ServerScriptService.Util.MapBuild
local MapParts       = require(MapBuild.MapParts)
local WorldBuilder   = require(MapBuild.WorldBuilder)
local PlotBuilder    = require(MapBuild.PlotBuilder)
local PondBuilder    = require(MapBuild.PondBuilder)
local ArenaBuilder   = require(MapBuild.ArenaBuilder)
local FigureBuilder  = require(MapBuild.FigureBuilder)
local LaidEggBuilder = require(MapBuild.LaidEggBuilder)
local IncubatorConfig = require(ReplicatedStorage.Config.IncubatorConfig)
local RecyclerBuilder = require(MapBuild.RecyclerBuilder)
local IncubatorBuilder = require(MapBuild.IncubatorBuilder)   -- Sammel-Update Paket 8
local TerminalBuilder  = require(MapBuild.TerminalBuilder)    -- 08.10. Tower-Terminal

--------------------------------------------------------------------------------
-- Interner Zustand
--------------------------------------------------------------------------------

-- Welcher Slot gehoert welchem Spieler
local _playerSlot: { [Player]: number } = {}

-- Alle gespawnten Plot-Models, key = Player
local _plotModels: { [Player]: Model } = {}

-- Verfuegbare Slots (1 .. PLOT_COUNT), wird in init() gefuellt
local _freeSlots: { number } = {}

-- Fuer welche Spieler gerade ein Waechter darauf wartet, den wegen
-- ActivityLock uebersprungenen Figuren-Neuaufbau nachzuholen. Verhindert, dass
-- mehrere Datenaenderungen waehrend derselben Bewegung mehrere Warte-Schleifen
-- starten — eine reicht, sie liest am Ende ohnehin frische Daten.
local _pendingRebuild: { [Player]: boolean } = {}

-- Woher der nachgeholte Neuaufbau seine FRISCHEN IslandData bekommt.
--
-- Absichtlich als eingehaengte Funktion statt eines require(PlayerService):
-- PlayerService requiret bereits MapService, der umgekehrte Weg waere ein
-- Ringschluss. Ausserdem bleibt damit die Regel
-- im Kopf dieser Datei gueltig — MapService kennt weiterhin keine
-- Spielerdaten ausser IslandData. Eingehaengt wird sie von
-- PlotDisplayService.init(); ohne sie faellt nur das Nachholen aus.
local _islandDataProvider: ((Player) -> Types.IslandData?)? = nil

-- v15: zuletzt gesetzter Tower-Turm und Tower-Symbol am Plot-Schild pro
-- Spieler. MapService kennt die Tower-Daten nicht (sie liegen ausserhalb von
-- IslandData) — PlotDisplayService setzt beides; gemerkt wird es hier, damit
-- ein Neuaufbau des Plots (Rebirth) Turm und Symbol sofort wieder mitbaut.
local _showcase: { [Player]: ArenaBuilder.ShowcaseView } = {}
-- Sammel-Update Paket 8: Platz-Zahl des Inkubators (siehe setIncubatorSlotProvider)
local _incubatorSlots: (Player) -> number = function(_player: Player): number return 1 end
type Badge = { text: string, color: Color3 }
local _badge: { [Player]: Badge } = {}
local _crown: { [Player]: boolean } = {}   -- Paket 9: Top 10 der Endless-Woche
-- 08.10.: zuletzt gesetzter Terminal-Zustand (Neuaufbau nach Rebirth baut ihn mit)
local _terminal: { [Player]: TerminalBuilder.TerminalView } = {}

local function badgeText(player: Player, text: string | Types.LocMsg): string | Types.LocMsg
	return if _crown[player] then Loc.msg("fmt.append", { a = "♛", b = text }) else text
end

--------------------------------------------------------------------------------
-- Plot-Inhalt
--------------------------------------------------------------------------------

-- Baut den kompletten Inhalt eines Plots (Gebaeude + Bruecke + PIT + Baerchis).
local function buildPlotContents(plotModel: Model, slot: number, islandData: Types.IslandData, owner: Player)
	local pool = PondBuilder.honeyPool(islandData)
	for _, building in islandData.buildings do
		PlotBuilder.buildBuilding(plotModel, slot, building, pool)
	end

	ArenaBuilder.buildBridge(plotModel, slot)
	ArenaBuilder.buildPit(plotModel, slot)
	PondBuilder.buildPond(plotModel, slot, islandData)
	RecyclerBuilder.build(plotModel, slot, islandData.recycler)
	-- Sammel-Update Paket 8: Inkubator (Plaetze liefert der Daten-Lieferant,
	-- weil sie auch an Rebirths und Index haengen, die nicht in der Insel stehen).
	if FeatureFlags.isOn("INCUBATOR") and islandData.incubator then
		IncubatorBuilder.build(plotModel, slot, islandData.incubator, _incubatorSlots(owner), islandData.baerchis)
	end
	-- 08.10.: Tower-Terminal am Stegbeginn (Zustand nur als Attribute)
	if FeatureFlags.isOn("TOWER_TERMINAL") then
		TerminalBuilder.build(plotModel, slot, _terminal[owner])
	end
	FigureBuilder.renderBaerchis(plotModel, slot, islandData)
	LaidEggBuilder.renderLaidEggs(plotModel, slot, islandData, owner)

	-- v15: Tower-Turm und Symbol, falls schon bekannt (nach einem Rebirth).
	local view = _showcase[owner]
	if view then
		ArenaBuilder.buildShowcase(plotModel, slot, view)
	end
	local badge = _badge[owner]
	if badge then
		PlotBuilder.writeOwnerBadge(plotModel, badgeText(owner, badge.text), badge.color)
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

local MapService = {}

local function claimSlot(): number?
	if #_freeSlots == 0 then return nil end
	return table.remove(_freeSlots, 1)
end

local function releaseSlot(slot: number)
	table.insert(_freeSlots, slot)
	table.sort(_freeSlots)
end

function MapService.spawnIsland(player: Player, islandData: Types.IslandData)
	-- Alten Slot freigeben falls vorhanden (sollte nicht passieren, aber sicher)
	if _playerSlot[player] then
		MapService.despawnIsland(player)
	end

	local slot = claimSlot()
	if not slot then
		warn("[MapService] Kein freier Plot fuer Spieler:", player.Name)
		return
	end

	_playerSlot[player] = slot

	local plotModel = PlotBuilder.buildPlotBase(slot, player)
	_plotModels[player] = plotModel

	buildPlotContents(plotModel, slot, islandData, player)

	print("[MapService] Plot gespawnt fuer:", player.Name, "| Slot:", slot)
end

-- Baut den Plot eines Spielers komplett neu — behaelt aber seinen Slot,
-- damit er nach einem Rebirth an derselben Stelle der Map steht.
function MapService.rebuildIsland(player: Player, islandData: Types.IslandData)
	local slot = _playerSlot[player]
	if not slot then
		-- Noch kein Plot (z.B. Server voll) → normaler Spawn-Versuch
		MapService.spawnIsland(player, islandData)
		return
	end

	local oldModel = _plotModels[player]
	if oldModel then
		oldModel:Destroy()
	end

	local plotModel = PlotBuilder.buildPlotBase(slot, player)
	_plotModels[player] = plotModel

	buildPlotContents(plotModel, slot, islandData, player)

	print("[MapService] Plot neu aufgebaut fuer:", player.Name, "| Slot:", slot)
end

function MapService.despawnIsland(player: Player)
	-- Ein noch wartender Nachhol-Waechter hat hier nichts mehr zu tun. Er
	-- merkt das zwar selbst beim naechsten Durchlauf (kein Plot mehr), aber so
	-- bleibt kein Eintrag fuer einen laengst gegangenen Spieler stehen.
	_pendingRebuild[player] = nil
	_showcase[player] = nil
	_badge[player] = nil
	_crown[player] = nil
	_terminal[player] = nil

	local model = _plotModels[player]
	if model then
		model:Destroy()
		_plotModels[player] = nil
	end

	local slot = _playerSlot[player]
	if slot then
		releaseSlot(slot)
		_playerSlot[player] = nil
	end
end

-- (v15: updatePitLevel ist entfallen — es gibt kein PIT-Level mehr. Der Turm
-- auf der Arena-Insel zeigt jetzt den Tower-Rekord, siehe updateTowerShowcase.)

-- v15: den Tower-Turm auf der Arena-Insel (neu) bauen. Aufrufer ist
-- PlotDisplayService, und nur wenn sich Look oder Rekord geaendert haben
-- (Signatur). `show` = der LOOK hat gewechselt: kurze Aufwertungs-Show (ein
-- Partikel-Stoss an der Spitze, < 2 s).
function MapService.updateTowerShowcase(player: Player, view: ArenaBuilder.ShowcaseView, show: boolean?)
	_showcase[player] = view

	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end

	local built = ArenaBuilder.buildShowcase(model, slot, view)
	if show then
		local foot = ArenaBuilder.showcaseFoot(slot)
		local height = MapConfig.TOWER_SHOWCASE.plinthHeight + view.floors * MapConfig.TOWER_SHOWCASE.floorHeight
		FigureFX.burstAt(foot + Vector3.new(0, height + 2, 0), view.color, built, 60)
	end
end

-- v15: Tower-Symbol unter dem Namen auf dem Plot-Schild ("◆ III · 42").
function MapService.setOwnerBadge(player: Player, text: string | Types.LocMsg, color: Color3)
	_badge[player] = { text = text, color = color }
	local model = _plotModels[player]
	if model then
		PlotBuilder.writeOwnerBadge(model, badgeText(player, text), color)
	end
end

-- Paket 9: Krone vor dem Plot-Symbol fuer die Top 10 der Endless-Woche.
-- Aufrufer ist LeaderboardService (kennt die Wochenliste).
function MapService.setOwnerCrown(player: Player, crowned: boolean)
	if (_crown[player] == true) == crowned then return end
	_crown[player] = if crowned then true else nil
	local badge = _badge[player]
	local model = _plotModels[player]
	if badge and model then
		PlotBuilder.writeOwnerBadge(model, badgeText(player, badge.text), badge.color)
	end
end

-- Farbe der kurzen Aufwertungs-Show beim Look-Wechsel (v15).
local LOOK_UPGRADE_COLOR = Color3.fromRGB(255, 220, 110)
local LOOK_UPGRADE_SPARKS = 40

-- v15: baut ein Gebaeude (oder den Recycler) NUR neu, wenn sich sein Look
-- geaendert hat (Attribut "Look" am Koerper gegen BuildingBehavior.getLook).
-- PlotDisplayService ruft das, wenn die Look-Signatur wechselt; Level-Aenderungen
-- innerhalb eines Looks laufen ueber das billige updateBuildingSigns.
-- `show` = kurze Aufwertungs-Show (ein Partikel-Stoss, < 2 s).
function MapService.updateBuildingLooks(player: Player, islandData: Types.IslandData, show: boolean?)
	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end

	local pool = PondBuilder.honeyPool(islandData)
	for _, building in islandData.buildings do
		local part = model:FindFirstChild(building.id)
		local look = BuildingBehavior.getLook(building.level)
		if part and part:IsA("BasePart") and part:GetAttribute("Look") ~= look then
			local position = part.Position
			part:Destroy()
			PlotBuilder.buildBuilding(model, slot, building, pool)
			if show then
				FigureFX.burstAt(position, LOOK_UPGRADE_COLOR, model, LOOK_UPGRADE_SPARKS)
			end
		end
	end

	local body = model:FindFirstChild(CombConfig.RECYCLER_NAME)
	local recyclerLook = BuildingBehavior.getLook(islandData.recycler.level)
	if body and body:IsA("BasePart") and body:GetAttribute("Look") ~= recyclerLook then
		local position = body.Position
		body:Destroy()
		RecyclerBuilder.build(model, slot, islandData.recycler)
		if show then
			FigureFX.burstAt(position, LOOK_UPGRADE_COLOR, model, LOOK_UPGRADE_SPARKS)
		end
	end
end

-- Haengt die Quelle fuer frische IslandData ein (siehe _islandDataProvider).
-- Wird einmal beim Start von PlotDisplayService aufgerufen.
function MapService.setIslandDataProvider(provider: (Player) -> Types.IslandData?)
	_islandDataProvider = provider
end

-- Wartet, bis die Figur des Spielers nicht mehr in einer Bewegung steckt, und
-- baut sie dann mit FRISCH gelesenen Daten neu.
--
-- Frisch gelesen ist der entscheidende Teil: waehrend der Bewegung koennen
-- weitere Aenderungen anfallen (mehrere Level-Ups waehrend eines Ess-Zyklus),
-- und nach einem Rebirth ist die alte IslandData-Tabelle gar nicht mehr die
-- des Spielers — sie einfach aufzuheben und spaeter nochmal zu rendern wuerde
-- einen veralteten Stand in die Welt stellen.
local function scheduleRebuildWhenFree(player: Player)
	if _pendingRebuild[player] then return end
	_pendingRebuild[player] = true

	task.spawn(function()
		local interval = MapConfig.FIGURE_REBUILD_RETRY_SECONDS
		local waited   = 0

		while waited < MapConfig.FIGURE_REBUILD_TIMEOUT_SECONDS do
			task.wait(interval)
			waited += interval

			-- Spieler weg oder Plot abgeraeumt: es gibt nichts mehr nachzuholen.
			if player.Parent == nil or _plotModels[player] == nil then
				break
			end

			if ActivityLock.isFree(player) then
				local provider = _islandDataProvider
				local island   = if provider then provider(player) else nil

				-- Vor dem erneuten Aufruf freigeben: updateBaerchis darf, falls
				-- inzwischen doch wieder eine Bewegung laeuft, sauber einen
				-- neuen Waechter starten.
				_pendingRebuild[player] = nil

				if island then
					MapService.updateBaerchis(player, island)
				end
				return
			end
		end

		_pendingRebuild[player] = nil
	end)
end

-- Baut die sichtbaren Baerchis eines Spielers NEU. Teuer — nur aufrufen wenn
-- sich der Bestand oder ein Level geaendert hat (siehe PlotDisplayService).
--
-- Steckt die Figur gerade in einer Bewegung, wird der Neuaufbau verschoben
-- statt sie mitten im Schritt zu ersetzen (Begruendung im Kopf der Datei).
function MapService.updateBaerchis(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	if not ActivityLock.isFree(player) then
		scheduleRebuildWhenFree(player)
		return
	end

	FigureBuilder.renderBaerchis(model, slot, islandData)
	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- Baut die herumliegenden Eier eines Spielers neu.
--
-- Anders als updateBaerchis KEINE ActivityLock-Pruefung: Eier bewegen sich
-- nicht und gehoeren niemandem, der sie gerade animiert. Sie duerfen deshalb
-- auch mitten in einem Kampf oder Weg zum Teich erscheinen und verschwinden —
-- genau das muss sogar sein, weil der Baerchi WAEHREND er laeuft legt.
function MapService.updateLaidEggs(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- Haengt den Ei-Einsammel-Handler ein: er laeuft, wenn der BESITZER eines
-- Plots sein eigenes gelegtes Ei mit der Spielfigur beruehrt. Wird einmal
-- beim Start von EggLayService aufgerufen (Pull-Callback statt require:
-- EggLayService requiret bereits MapService, der umgekehrte Weg waere ein
-- Ringschluss). Ohne Handler sammelt Beruehren einfach nichts ein.
function MapService.setEggCollectHandler(handler: (Player, string) -> ())
	LaidEggBuilder.setCollectHandler(handler)
end

-- Rechnet eine Weltposition in das Koordinatensystem des Plots um.
--
-- Gelegte Eier werden PLOT-RELATIV gespeichert, nicht in Weltkoordinaten. Der
-- Grund: welchen der acht Plots ein Spieler bekommt, entscheidet sich bei
-- jedem Join neu (siehe _freeSlots). Absolute Positionen wuerden nach einem
-- Rejoin auf einem anderen Plot liegen — im schlimmsten Fall auf dem eines
-- Nachbarn.
function MapService.worldToPlot(player: Player, worldPosition: Vector3): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end

	local plotCFrame = MapParts.plotCFrame(slot)
	if not plotCFrame then return nil end

	return plotCFrame:PointToObjectSpace(worldPosition)
end

-- Aktualisiert nur Beschriftung und Erschoepfung der bereits stehenden
-- Figuren. Billig — das ist der Weg fuer HP-Aenderungen.
function MapService.updateBaerchiStates(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return end

	for _, baerchi in islandData.baerchis do
		local figure = folder:FindFirstChild("Baerchi_" .. baerchi.uid)
		if figure and figure:IsA("Model") then
			FigureBuilder.writeBaerchiState(figure, baerchi, FigureBuilder.maxHpOf(baerchi))
		end
	end
end

-- Aktualisiert das Level-Attribut einer Gebaeude-Part (fuer Client-UI).
-- Wird nach einem Gebaeude-Upgrade aufgerufen; baut nichts neu.
function MapService.updateBuildingLevel(player: Player, buildingId: Types.BuildingId, level: number)
	local model = _plotModels[player]
	if not model then return end

	local part = model:FindFirstChild(buildingId)
	if part then
		part:SetAttribute("BuildingLevel", level)
	end
end

-- Wohin der Baerchi zum Fressen laeuft.
--
-- Das ist der Standplatz VOR dem Becken (auf den Bohlen), nicht mehr die
-- Beckenmitte. Bis der Teich ein richtiges Becken wurde, war beides dasselbe
-- — und der Baerchi stand mitten im Teich. Jetzt stuende er bis zum Bauch im
-- Beckenboden.
function MapService.getPondPosition(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return PondBuilder.pondStand(slot).Position
end

-- Mitte des Beckens (Weltposition) — z. B. damit gelegte Eier nicht im Honig
-- landen, seit der Baerchi am Becken wohnt (HONEY_POND_V2).
function MapService.getPondCenter(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return PondBuilder.pondGround(slot).Position
end

-- Fuellstand des Teichs nachziehen. Billig — das ist der Weg fuer
-- Honig-Aenderungen (siehe MapService.updateBuildingSigns, das das mit
-- aufruft, weil beides an denselben Werten haengt).
function MapService.updatePondFill(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	local pond = model:FindFirstChild("Pond")
	if not pond then return end

	local fill = pond:FindFirstChild("Fuellung")
	if fill and fill:IsA("BasePart") then
		PondBuilder.writePondFill(fill, PondBuilder.pondGround(slot), PondBuilder.pondFillRatio(islandData))
	end
end

-- Schreibt Level und Honig-Lagerstand auf die Gebaeude-Schilder.
-- Billig — das ist der Weg fuer Honig-Aenderungen.
function MapService.updateBuildingSigns(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local pool = PondBuilder.honeyPool(islandData)

	for _, building in islandData.buildings do
		local part = model:FindFirstChild(building.id)
		if part and part:IsA("BasePart") then
			part:SetAttribute("BuildingLevel", building.level)
			PlotBuilder.writeBuildingState(part, building, pool)
		end
	end

	-- Haengt an denselben Werten wie die Gebaeude-Schilder — deshalb hier
	-- gleich mit erledigt statt eines eigenen Aufrufers in PlotDisplayService.
	MapService.updatePondFill(player, islandData)
end

-- Sammel-Update Paket 8: Inkubator-Stand schreiben (Eier, Zeitmarken,
-- verfuegbare Plaetze). Billig; fehlt das Modell, wird es gebaut.
function MapService.updateIncubator(player: Player, islandData: Types.IslandData, slotCount: number)
	if not FeatureFlags.isOn("INCUBATOR") or not islandData.incubator then return end
	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end
	local existing = model:FindFirstChild(IncubatorConfig.MODEL_NAME)
	if existing and existing:IsA("Model") then
		IncubatorBuilder.writeState(existing, islandData.incubator, slotCount, islandData.baerchis)
	else
		IncubatorBuilder.build(model, slot, islandData.incubator, slotCount, islandData.baerchis)
	end
end

-- INCUBATOR_BREED: das Inkubator-Modell auf dem Plot des Spielers (Ort der
-- gebrueteten Eier), oder nil.
function MapService.getIncubatorModel(player: Player): Model?
	local model = _plotModels[player]
	local found = if model then model:FindFirstChild(IncubatorConfig.MODEL_NAME) else nil
	return if found and found:IsA("Model") then found else nil
end

-- Liefert die Platz-Zahl des Inkubators (setzt PlotDisplayService, weil sie
-- auch an Rebirths und Index-Belohnungen haengt).
function MapService.setIncubatorSlotProvider(provider: (Player) -> number)
	_incubatorSlots = provider
end

-- 08.10.: Zustand des Tower-Terminals (Attribute, kein Neubau). Aufrufer ist
-- PlotDisplayService bei geaenderter Signatur.
function MapService.updateTerminal(player: Player, view: TerminalBuilder.TerminalView)
	_terminal[player] = view
	local model = _plotModels[player]
	local terminal = if model then model:FindFirstChild(TerminalBuilder.MODEL_NAME) else nil
	if terminal and terminal:IsA("Model") then
		TerminalBuilder.writeState(terminal, view)
	end
end

-- Schreibt Level, Warteschlange und Lampe des Waben-Recyclers neu.
-- Billig — der Weg fuer jede Aenderung der Warteschlange.
function MapService.updateRecycler(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local body = model:FindFirstChild(CombConfig.RECYCLER_NAME)
	if body and body:IsA("BasePart") then
		RecyclerBuilder.writeState(body, islandData.recycler)
	end
end

-- Die Anzeigetafel ueber der Arena. Bewusst ueber den exakten Pfad gesucht und
-- nicht rekursiv: unter dem Plot haengen bis zu 25 importierte Mesh-Figuren,
-- deren Teilenamen aus einer .glb stammen und die wir nicht kontrollieren.
-- Eine rekursive Suche wuerde bei einem gleichnamigen Teil das Falsche finden
-- — und muesste bei jeder der bis zu 60 Stages den ganzen Baum durchlaufen.
local function findPitBanner(player: Player): BillboardGui?
	local model = _plotModels[player]
	if not model then return nil end

	local platform = model:FindFirstChild("PitPlatform")
	if not platform then return nil end

	local anchor = platform:FindFirstChild("PitBannerAnchor")
	if not anchor then return nil end

	local banner = anchor:FindFirstChild("Banner")
	return if banner and banner:IsA("BillboardGui") then banner else nil
end

-- Die Anzeigetafel ueber der Arena beschriften und einblenden.
-- Aufgerufen von PitArenaService waehrend einer Wiedergabe; MapService kennt
-- den Kampfverlauf nicht und entscheidet deshalb nichts ueber den Inhalt.
-- Titel und Untertitel duerfen Nachrichten (LocMsg) sein: die Tafel sieht
-- jeder Spieler, und jeder liest sie in seiner Sprache (siehe WorldText).
function MapService.setPitBanner(player: Player, title: string | Types.LocMsg, subtitle: string | Types.LocMsg, color: Color3)
	local banner = findPitBanner(player)
	if not banner then return end

	local titleLabel = banner:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		WorldText.set(titleLabel, title)
		titleLabel.TextColor3 = color
	end

	local subLabel = banner:FindFirstChild("Sub")
	if subLabel and subLabel:IsA("TextLabel") then
		WorldText.set(subLabel, subtitle)
	end

	banner.Enabled = true
end

-- Tafel wieder ausblenden. Idempotent — ein zweiter Aufruf schadet nicht.
function MapService.clearPitBanner(player: Player)
	local banner = findPitBanner(player)
	if banner then
		banner.Enabled = false
	end
end

--------------------------------------------------------------------------------
-- Event-Pit: Farbe und Anzeigetafel von aussen setzbar (EventService)
--------------------------------------------------------------------------------

-- Anders als findPitBanner gibt es das Event-Pit nur EINMAL fuer die ganze
-- Welt, nicht pro Spieler — keine Player-Suche noetig.
local function findEventPitContainer(): Model?
	local platform = workspace:FindFirstChild("Platform")
	if not platform then return nil end

	local pit = platform:FindFirstChild("EventPit")
	return if pit and pit:IsA("Model") then pit else nil
end

export type EventTheme = {
	floorColor : Color3,
	fenceColor : Color3,
	ringColor  : Color3,
}

-- Faerbt Boden, Zaun und Ring des Event-Pits um. Mit `theme = nil` kehrt es
-- zum schlichten Stall-Look zurueck (siehe MapConfig, EVENT_PIT_DEFAULT_*).
-- EventService ruft das genau zweimal pro Zyklus: einmal beim Start eines
-- Events mit dessen Farben, einmal beim Ende mit nil.
function MapService.setEventPitTheme(theme: EventTheme?)
	local container = findEventPitContainer()
	if not container then return end

	local floorColor = if theme then theme.floorColor else MapConfig.EVENT_PIT_DEFAULT_FLOOR_COLOR
	local fenceColor = if theme then theme.fenceColor else MapConfig.EVENT_PIT_DEFAULT_FENCE_COLOR
	local ringColor  = if theme then theme.ringColor  else MapConfig.EVENT_PIT_DEFAULT_RING_COLOR

	-- Material wechselt mit: Wood/SmoothPlastic im Stall-Look, Neon waehrend
	-- eines Events — sonst saehe man den Farbwechsel bei Zaun und Ring kaum,
	-- weil beide im Stall-Look bewusst matt sind.
	local activeMaterial = if theme then Enum.Material.Neon else Enum.Material.Wood
	local ringMaterial   = if theme then Enum.Material.Neon else Enum.Material.SmoothPlastic

	local floor = container:FindFirstChild("EventFloor")
	if floor and floor:IsA("BasePart") then
		floor.Color = floorColor
	end

	local ring = container:FindFirstChild("EventRing")
	if ring and ring:IsA("BasePart") then
		ring.Color    = ringColor
		ring.Material = ringMaterial
	end

	for _, child in container:GetChildren() do
		if child.Name:match("^EventFence_") and child:IsA("BasePart") then
			child.Color    = fenceColor
			child.Material = activeMaterial
		end
	end
end

-- Beschriftet die Countdown-Tafel ueber dem Event-Pit. Anders als
-- setPitBanner blendet das hier NICHT ein/aus — die Tafel steht permanent
-- (siehe buildEventPit): sie zeigt entweder den Countdown bis zum naechsten
-- Event oder Name + Restzeit des laufenden.
function MapService.setEventBanner(title: string | Types.LocMsg, subtitle: string | Types.LocMsg, color: Color3, reward: (string | Types.LocMsg)?)
	local container = findEventPitContainer()
	if not container then return end

	local anchor = container:FindFirstChild("EventBannerAnchor")
	if not anchor then return end

	local banner = anchor:FindFirstChild("Banner")
	if not (banner and banner:IsA("BillboardGui")) then return end

	local titleLabel = banner:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		WorldText.set(titleLabel, title)
		titleLabel.TextColor3 = color
	end

	local subLabel = banner:FindFirstChild("Sub")
	if subLabel and subLabel:IsA("TextLabel") then
		WorldText.set(subLabel, subtitle)
	end

	local rewardLabel = banner:FindFirstChild("Reward")
	if rewardLabel and rewardLabel:IsA("TextLabel") then
		WorldText.set(rewardLabel, reward or "")
	end
end

-- Weltposition der PODEST-OBERFLAECHE des Event-Pits in der Weltmitte.
--
-- Anders als getPitPosition NICHT pro Spieler: das Event-Pit gibt es einmal
-- fuer die ganze Welt (siehe findEventPitContainer). EventParticipationService
-- laesst die Figuren aller teilnehmenden Spieler auf dieselbe Flaeche laufen.
--
-- Der Y-Wert ist dieselbe Rechnung wie in buildEventPit (`floorY`), bewusst
-- aus MapConfig neu gerechnet statt aus der gebauten Geometrie gemessen: die
-- Zahl gehoert der Konfiguration, nicht dem Modell.
function MapService.getEventPitPosition(): Vector3
	local center = MapConfig.CENTER
	local floorY = MapConfig.PLATFORM_TOP_Y
		+ MapConfig.EVENT_PIT_GROUND_CLEARANCE
		+ MapConfig.EVENT_PIT_FLOOR_HEIGHT

	return Vector3.new(center.X, floorY, center.Z)
end

-- Radius der begehbaren Event-Flaeche. EventParticipationService prueft damit
-- serverseitig nach, ob eine Figur tatsaechlich noch dort steht, statt sich auf
-- ein gesetztes Flag zu verlassen.
function MapService.getEventPitRadius(): number
	return MapConfig.EVENT_PIT_RADIUS
end

-- Weltposition der Kampfflaeche dieses Spielers.
-- Wird von PitArenaService benoetigt um die Kaempfer zu platzieren.
function MapService.getPitPosition(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return MapParts.pitCenter(slot)
end

-- Das CFrame des Plots (Blickrichtung zur Plattform-Mitte).
-- PitArenaService braucht es, um die Kaempfer sinnvoll auszurichten.
function MapService.getPlotCFrame(player: Player): CFrame?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return MapParts.plotCFrame(slot)
end

-- Die stehende Figur eines Baerchis auf dem Plot, falls vorhanden.
-- PitArenaService schickt genau diese Figur in die Arena und wieder zurueck,
-- statt eine zweite Kopie zu bauen — sonst staende derselbe Baerchi doppelt
-- in der Welt.
function MapService.getBaerchiModel(player: Player, baerchiUid: string): Model?
	local model = _plotModels[player]
	if not model then return nil end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return nil end

	local figure = folder:FindFirstChild("Baerchi_" .. baerchiUid)
	if figure and figure:IsA("Model") then
		return figure
	end
	return nil
end

-- Feiert ein Ereignis (Level-Up, Promotion, Rebirth, ...) SICHTBAR auf dem
-- Plot: Partikel-Stoss, Huepfer, kurzes Aufleuchten (siehe FigureFX.celebrate).
--
-- Bewusst als eigene MapService-Funktion und nicht direkt FigureFX.celebrate
-- vom Aufrufer: der Aufrufer (HoneyService, PromotionService, RebirthService,
-- ...) soll keine Modelle aus der Welt heraussuchen muessen — genau wie bei
-- getBaerchiModel bleibt das MapServices Job. Steht die Figur gerade nicht in
-- der Welt (Plot noch nicht gebaut, Bewegung verzoegert den Neuaufbau), passiert
-- einfach nichts — kein Fehler, der Toast-Text kommt ja trotzdem an.
function MapService.celebrateBaerchi(player: Player, baerchiUid: string, color: Color3)
	local model = MapService.getBaerchiModel(player, baerchiUid)
	if not model then return end

	FigureFX.celebrate(model, color)
end

-- Beschriftung und Transparenz einer Figur mit einem AUSDRUECKLICH
-- angegebenen HP-Wert setzen — auch waehrend eines laufenden PIT-Kampfes.
--
-- Nur fuer PitArenaService: der muss die Figur beim Start der Wiedergabe auf
-- die HP zuruecksetzen, mit denen der Lauf BEGONNEN hat. Die gespeicherten HP
-- stehen zu dem Zeitpunkt laengst auf dem Endwert, der Baerchi saehe sonst
-- schon vor dem ersten Schlag erschoepft aus.
function MapService.setFigureState(model: Model, hp: number, maxHp: number)
	FigureBuilder.writeFigureState(model, hp, maxHp)
end

-- Der Ordner in der Arena, in den die Kampf-Figuren gehoeren.
function MapService.getFighterFolder(player: Player): Folder?
	local model = _plotModels[player]
	if not model then return nil end

	local pit = model:FindFirstChild("PitPlatform")
	if not pit then return nil end

	local fighters = pit:FindFirstChild("Fighters")
	if fighters and fighters:IsA("Folder") then
		return fighters
	end
	return nil
end

-- Baut den PIT-Turm auf genau `level` Etagen aus bzw. ab — idempotent: fehlt
-- eine Etage, wird sie ergaenzt; ist eine zu viel da, wird sie entfernt. Mit
-- `level = 0` verschwindet der Turm komplett.
--
-- PitArenaService ruft das bei jeder Stage mit der neuen Stufenzahl auf, und
-- mit 0 sobald ein Lauf zu Ende ist oder ein neuer beginnt — der Turm bleibt
-- also NIE zwischen zwei Laeufen stehen, genau wie die Kampf-Figuren selbst
-- (siehe clearFighters in PitArenaService).
--
-- Bewegt bei einem Aufbau auch die Anzeigetafel-Verankerung mit nach oben,
-- damit sie ueber dem gewachsenen Turm haengen bleibt statt mittendrin zu
-- stecken.
function MapService.setPitTowerLevel(player: Player, level: number)
	local slot  = _playerSlot[player]
	local model = _plotModels[player]
	if not slot or not model then return end

	local container = model:FindFirstChild("PitPlatform")
	if not container then return end

	local tower = container:FindFirstChild("Tower")
	if not (tower and tower:IsA("Folder")) then return end

	local wanted = math.max(0, math.floor(level))
	local center = MapParts.pitCenter(slot)

	for _, child in tower:GetChildren() do
		local index = tonumber(child.Name:match("^Ring_(%d+)$"))
		if not index or index > wanted then
			child:Destroy()
		end
	end

	for i = 1, wanted do
		if not tower:FindFirstChild("Ring_" .. i) then
			ArenaBuilder.buildTowerRing(tower, center, i)
		end
	end

	-- 12.10.: Hoehe fuer das Flugfeld am Arena-Rand (TowerFlightController):
	-- der Client schiesst den eigenen Charakter auf die Turm-Spitze.
	container:SetAttribute("TowerLevel", wanted)
	container:SetAttribute("TowerTopY", MapService.getPitTowerFloorY(wanted))

	local anchor = container:FindFirstChild("PitBannerAnchor")
	if anchor and anchor:IsA("BasePart") then
		local topY = MapConfig.PLATFORM_TOP_Y
			+ wanted * MapConfig.PIT_TOWER_STEP_HEIGHT
			+ MapConfig.PIT_BANNER_HEIGHT
		anchor.CFrame = CFrame.new(center.X, topY, center.Z)
	end
end

-- Hoehe (Y ueber PLATFORM_TOP_Y) der Kampfflaeche bei `level` bereits
-- gewachsenen Etagen. PitArenaService braucht das, um die Kaempfer beim
-- Erklimmen jeder Stage auf die richtige Hoehe zu stellen — dieselbe Formel
-- wie in buildTowerRing, hier aber ohne selbst eine Etage zu bauen.
function MapService.getPitTowerFloorY(level: number): number
	return MapConfig.PLATFORM_TOP_Y + math.max(0, level) * MapConfig.PIT_TOWER_STEP_HEIGHT
end

-- v15: die Bestenlisten-Tafel(n) beschriften (Titel + bis zu
-- LEADERBOARD_BOARD.lines Zeilen). Aufrufer ist LeaderboardService.
-- HBB Paket 5: eine Tafel je Liste; Schluessel = listId, "_rotating" = die
-- eine wechselnde Tafel ohne MAP_V2_BOARDS.
local ROTATING = "_rotating"
local _leaderboardBoards: { [string]: BasePart } = {}
local _liveBoard: BasePart? = nil
local _waspNest: Model? = nil

local function writeBoard(board: BasePart?, title: string, lines: { string }, lineCount: number, titleColor: Color3?)
	if not board then return end
	local surface = board:FindFirstChild("Board")
	if not surface then return end

	local titleLabel = surface:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		titleLabel.Text = title
		if titleColor then titleLabel.TextColor3 = titleColor end
	end
	for i = 1, lineCount do
		local line = surface:FindFirstChild("Line" .. i)
		if line and line:IsA("TextLabel") then
			line.Text = lines[i] or ""
		end
	end
end

-- Gibt es eine feste Tafel fuer `listId`? (sonst: wechselnde Tafel)
function MapService.hasLeaderboardBoard(listId: string): boolean
	return _leaderboardBoards[listId] ~= nil
end

function MapService.writeLeaderboardBoard(title: string, lines: { string }, listId: string?)
	local board = (if listId then _leaderboardBoards[listId] else nil) or _leaderboardBoards[ROTATING]
	writeBoard(board, title, lines, MapConfig.LEADERBOARD_BOARD.lines)
end

-- HBB Paket 6: Live-Kampf-Board beschriften. Aufrufer ist LiveBoardService.
function MapService.writeLiveBoard(title: string, lines: { string }, live: boolean)
	local cfg = MapConfig.LIVE_BOARD
	writeBoard(_liveBoard, title, lines, cfg.lines, if live then cfg.liveColor else cfg.textColor)
end

-- HBB Paket 6: Schild und Leuchten des Wespen-Nests. Aufrufer ist EventService.
function MapService.setWaspNest(text: string, glowing: boolean)
	local nest = _waspNest
	if not nest then return end
	local cfg = MapConfig.WASP_NEST
	local body = nest:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		body.Material = if glowing then Enum.Material.Neon else Enum.Material.Sand
		body.Color    = if glowing then cfg.glowColor else cfg.color
	end
	local anchor = nest:FindFirstChild("SignAnchor")
	local sign = if anchor then anchor:FindFirstChild("Sign") else nil
	local title = if sign then sign:FindFirstChild("Title") else nil
	if title and title:IsA("TextLabel") then
		title.Text = text
	end
end

-- v15: Teile auf der Insel eines Spielers zaehlen (Debug-Befehl "parts",
-- Budget <= 250 pro Insel ohne Baerchi-Mesh). Getrennt nach Bereichen, damit man
-- sieht, wo das Budget hingeht. Die Figuren (importierte Meshes) zaehlen extra.
function MapService.countParts(player: Player): { [string]: number }?
	local model = _plotModels[player]
	if not model then return nil end

	local result: { [string]: number } = { total = 0, figures = 0 }
	for _, child in model:GetChildren() do
		local count = if child:IsA("BasePart") then 1 else 0
		for _, descendant in child:GetDescendants() do
			if descendant:IsA("BasePart") then count += 1 end
		end
		local key = child.Name
		if key == "Baerchis" then
			result.figures += count
		else
			result[key] = (result[key] or 0) + count
			result.total += count
		end
	end
	return result
end

function MapService.init()
	-- Freie Slots einmalig aufbauen
	for slot = 1, MapConfig.PLOT_COUNT do
		table.insert(_freeSlots, slot)
	end

	-- ============================================================
	-- GEOMETRIE-PRUEFUNG
	-- ============================================================
	-- Die Weltgeometrie haengt an einem guten Dutzend Zahlen, die voneinander
	-- abhaengen. Faellt eine aus dem Rahmen, sieht man das im fertigen Spiel als
	-- Loch im Boden oder als Insel im Nichts — und sucht dann im Code statt in
	-- der Config. Diese vier Pruefungen sagen es beim Start, im Klartext.
	--
	-- Sie WARNEN nur und brechen nicht ab: eine Welt mit einer schiefen Zahl ist
	-- immer noch spielbar, und ein harter Abbruch beim Serverstart waere die
	-- schlechtere Rueckmeldung.

	-- 1. Passt das quadratische Beet auf die runde Plot-Insel? Entscheidend ist
	--    die ECKE, nicht die Kante — eine halbe Diagonale, nicht eine halbe Seite.
	local plateCorner = math.sqrt(
		(MapConfig.PLOT_SIZE.X * 0.5) ^ 2 + (MapConfig.PLOT_SIZE.Z * 0.5) ^ 2
	)
	if plateCorner > MapConfig.PLOT_ISLAND_RADIUS then
		warn(
			"[MapService] Das Beet ragt ueber die Plot-Insel:",
			"halbe Diagonale von PLOT_SIZE =", string.format("%.1f", plateCorner),
			"> PLOT_ISLAND_RADIUS =", MapConfig.PLOT_ISLAND_RADIUS
		)
	end

	-- 2. Liegt der Plot-Ring wirklich eine Steglaenge vor der Hauptinsel?
	--    Sonst waere der Steg entweder zu kurz (Luecke) oder zu lang (er endet
	--    auf der Insel).
	local expectedRing = MapConfig.PLATFORM_RADIUS + MapConfig.ISLAND_GAP + MapConfig.PLOT_ISLAND_RADIUS
	if math.abs(MapConfig.PLOT_RING_RADIUS - expectedRing) > 0.5 then
		warn(
			"[MapService] PLOT_RING_RADIUS passt nicht zur Luecke:",
			MapConfig.PLOT_RING_RADIUS, "sollte", expectedRing, "sein",
			"(PLATFORM_RADIUS + ISLAND_GAP + PLOT_ISLAND_RADIUS)"
		)
	end

	-- 3. Beruehren sich zwei benachbarte Plot-Inseln samt Sandkante?
	local shoreRadius = MapConfig.PLOT_ISLAND_RADIUS + MapConfig.SHORE_WIDTH
	local neighbourGap = 2 * MapConfig.PLOT_RING_RADIUS
		* math.sin(math.pi / MapConfig.PLOT_COUNT) - 2 * shoreRadius
	if neighbourGap <= 0 then
		warn(
			"[MapService] Die Plot-Inseln ueberlappen sich:",
			MapConfig.PLOT_COUNT, "Inseln mit Rand", shoreRadius,
			"auf Ring", MapConfig.PLOT_RING_RADIUS
		)
	end

	-- 4. Reicht das Wasser bis hinter die aeusserste Arena?
	local worldEdge = (MapParts.pitCenter(1) - MapConfig.CENTER).Magnitude
		+ MapConfig.PIT_BASE_RADIUS + MapConfig.SHORE_WIDTH
	if worldEdge > MapConfig.WATER_RADIUS then
		warn(
			"[MapService] Die Arenen ragen ueber den Wasserrand:",
			"Weltrand =", string.format("%.0f", worldEdge),
			"> WATER_RADIUS =", MapConfig.WATER_RADIUS
		)
	end

	WorldBuilder.buildPlatform()
	WorldBuilder.buildGlobalLighting()

	-- v15: Bestenlisten-Tafel(n) (LeaderboardService beschriftet sie).
	-- HBB Paket 5/6: Positionen aus MapLayout (dort auch der Layout-Test).
	local platform = workspace:FindFirstChild("Platform") or workspace
	for _, b in MapLayout.leaderboardBoards() do
		local listId = b.listId
		local name = if listId then "LeaderboardBoard_" .. listId else "LeaderboardBoard"
		_leaderboardBoards[listId or ROTATING] = WorldBuilder.buildLeaderboardBoard(platform, b.angleDegrees, name)
	end
	if FeatureFlags.isOn("MAP_V2_LIVE_BOARD") then
		_liveBoard = WorldBuilder.buildLiveBoard(platform)
	end
	if FeatureFlags.isOn("MAP_V2_WASP_NEST") then
		_waspNest = WorldBuilder.buildWaspNest(platform, MapLayout.waspNestCenter())
	end

	-- Sicherheitsnetz: falls PlayerService den Leave-Fall mal verpasst,
	-- bleibt sonst ein Slot dauerhaft belegt.
	Players.PlayerRemoving:Connect(function(player)
		if _playerSlot[player] then
			MapService.despawnIsland(player)
		end
	end)

	print("[MapService] Initialisiert | Plots:", MapConfig.PLOT_COUNT)
end

return MapService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX16"><Properties>
<string name="Name">PitArenaService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PitArenaService.luau
-- ServerScriptService/Services/PitArenaService.luau
--
-- Einzige Zustaendigkeit:
--   - Einen von CombatService fertig simulierten PIT-Lauf in der Arena
--     abspielen und dabei den Lauf ZEITLICH fuehren: Hinweg, Stage fuer Stage,
--     Rueckweg, Zurueckholen und Abbruch
--
-- Zum Fuehren gehoert, dass dieser Service entscheidet, WANN abgerechnet und
-- WANN das Ergebnis verschickt wird — beides haengt an der Wiedergabe:
--   - Abrechnung: CombatService gibt eine Funktion (settle) mit. Sie laeuft
--     GENAU EINMAL mit der Zahl der tatsaechlich gespielten Stages: alle bei
--     normalem Ende, bis einschliesslich der laufenden beim Zurueckholen
--     (requestRecall; vor der ersten Stage: 0), und beim Verlassen so, als
--     waere die begonnene Stage zu Ende gespielt (PlayerService.onPlayerLeaving).
--     WAS abgerechnet wird, weiss nur CombatService; dieser Service fasst
--     Spielerdaten selbst nicht an.
--   - Ergebnis: Remotes.CombatResultReceived geht erst raus, wenn abgerechnet
--     ist. sendResult() ist die einzige Stelle, die es abschickt, und
--     idempotent — alle Abbruch- und Erfolgspfade duerfen es aufrufen.
--   - Phase (ToPit / InPit / Returning) und laufende Stage meldet er fuer
--     die Pet-Leiste (PetModeService liest getPhase).
--
-- Warum auf dem SERVER und nicht im Client: die Arenen liegen in derselben
-- Welt wie alle Plots. Serverseitig kann ein Nachbar ueber den Steg kommen
-- und zuschauen.
--
-- Die Figur wird nicht kopiert, sondern die ECHTE Figur vom Plot wandert in
-- die Arena und danach exakt an ihren Platz zurueck. Eine zweite Kopie waere
-- sonst gleichzeitig auf dem Plot zu sehen.
--
-- ============================================================
-- HEIMKEHR — die eigentliche Schwierigkeit
-- ============================================================
-- Der Ausgangs-Pivot der Figur darf NICHT beim Start jeder Wiedergabe frisch
-- abgelesen werden: startet ein zweiter Lauf waehrend der erste noch laeuft,
-- stuende die Figur da schon in der Arena und wuerde spaeter genau dorthin
-- "zurueckgesetzt". Deshalb merkt sich dieser Service den Platz auf dem Plot
-- getrennt (_home) und raeumt einen laufenden Lauf IMMER erst komplett auf,
-- bevor ein neuer beginnt.
--
-- Abbrechen kann die Wiedergabe ausserdem: der Spieler geht, oder der Plot
-- wird neu gebaut (dann ist die Figur weg). Beides wird geprueft, und in
-- keinem Fall bleibt etwas Halbes stehen.
--
-- ============================================================
-- ZUG UM ZUG
-- ============================================================
-- CombatService gibt pro Stage die einzelnen Zuege mit (Types.FightBeat).
-- Jede Stage wird als Folge von Stoessen gezeigt: die Baerchis laufen
-- aufeinander zu und prallen zusammen (FigureFX.clash). Unter dem eigenen
-- HP-Balken laeuft eine Ladeleiste (Util/FightBars); ist sie voll, kommt die
-- Faehigkeit mit ihrer Show (SkillFX, beim ersten Mal voll, danach als Echo).
-- WELCHE Zuege in die Zeit passen, rechnet FightTimeline.
--
-- startPlayback ist bewusst EINE lange Funktion: sie erzaehlt den Ablauf
-- eines Laufs von vorn nach hinten, und ihre Schritte teilen viel Zustand.
-- Zerlegt in viele kleine Funktionen muesste man zum Verstehen hin und her
-- springen.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)
local MapConfig   = require(ReplicatedStorage.Config.MapConfig)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local SkillConfig = require(ReplicatedStorage.Config.SkillConfig)
local SkillFXConfig = require(ReplicatedStorage.Config.SkillFXConfig)
local BaerchiMesh = require(ReplicatedStorage.Modules.BaerchiMesh)
local FightTimeline = require(ReplicatedStorage.Modules.FightTimeline)
local Types       = require(ReplicatedStorage.Network.Types)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local Remotes     = require(ReplicatedStorage.Network.Remotes)

local PlayerService   = require(ServerScriptService.Services.PlayerService)
local MapService      = require(ServerScriptService.Services.MapService)
local FigureWalker    = require(ServerScriptService.Util.FigureWalker)
local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)
local RateLimiter     = require(ServerScriptService.Util.RateLimiter)   -- Paket 4.3
local FigureFX        = require(ServerScriptService.Util.FigureFX)
local ActivityLock    = require(ServerScriptService.Util.ActivityLock)
local FightBars       = require(ServerScriptService.Util.FightBars)

-- Name unter dem PitArenaService das Bewegungs-Schloss haelt (siehe
-- ActivityLock) — verhindert dass BaerchiAutopilotService den Baerchi
-- waehrend eines Kampf-Laufs zum Honig-Teich abzieht.
local LOCK_HOLDER = "Kampf"

local PitArenaService = {}

-- HBB Paket 5 (MAP_V2_ARENA_SPRINT): auf dem Weg Plot <-> Arena sprintet der
-- Baerchi (MapConfig.ARENA_WALK_SPEED) statt zu gehen — weniger Warten je Lauf.
local function arenaWalkSpeed(): number
	return if FeatureFlags.isOn("MAP_V2_ARENA_SPRINT") then MapConfig.ARENA_WALK_SPEED else MapConfig.WALK_SPEED
end

-- Gleich viele Hopser pro SEKUNDE wie beim Gehen, dafuer weitere: schnelleres
-- Huepfen liest das Auge als Zittern (siehe MapConfig.WALK_BOB_PER_STUD).
local function arenaBobPerStud(): number
	return MapConfig.WALK_BOB_PER_STUD * MapConfig.WALK_SPEED / arenaWalkSpeed()
end

-- 12.10. (Playtest "laeuft durch die Bruecke, keine guten Laufwege"): der
-- Weg Plot <-> Arena als Kette von Fusspunkten statt einer Geraden. Vorher
-- lief der Baerchi schraeg zum seitlichen Kampfplatz — am Arena-Ende durch
-- das Gelaender — und hielt dabei die Beet-Hoehe (2 Studs ueber dem Steg,
-- auf dem Rueckweg durch das Beet). Jetzt: zur Beet-Kante, hinunter auf die
-- Wiese, mittig ueber den Steg (plot-lokal X = 0), in die Arena, zum Platz.
-- Plot-lokal: +Z = nach aussen (Steg, Arena), Y = Hoehe ueber der Plattform.
local function laneLocalPoints(): { Vector3 }
	local beetTop  = MapConfig.PLOT_SIZE.Y
	local beetEdge = MapConfig.PLOT_SIZE.Z * 0.5
	local deckY    = -MapConfig.BRIDGE_SINK
	local bridgeIn  = MapConfig.PLOT_ISLAND_RADIUS - 1
	local bridgeOut = MapConfig.PLOT_ISLAND_RADIUS + MapConfig.ISLAND_GAP + 1
	return {
		Vector3.new(0, beetTop, beetEdge - 0.6),   -- Beet-Kante
		Vector3.new(0, 0, beetEdge + 1.6),         -- unten auf der Wiese
		Vector3.new(0, deckY, bridgeIn),           -- Steg-Anfang (Mitte)
		Vector3.new(0, deckY, bridgeOut),          -- Steg-Ende
		Vector3.new(0, 0, bridgeOut + 3),          -- in der Arena
	}
end

-- Fusspunkte von `from` nach `to` (Welt). Nimmt nur die Wegpunkte, die
-- zwischen beiden liegen (der Weg ist in Z monoton) — so geht es auch von
-- einem Zwischenstand aus (Zurueckholen auf dem Hinweg) richtig weiter.
local function arenaRoute(plotCFrame: CFrame, from: Vector3, to: Vector3): { Vector3 }
	local fromZ = plotCFrame:PointToObjectSpace(from).Z
	local toZ   = plotCFrame:PointToObjectSpace(to).Z
	local route = { from }
	local lane = laneLocalPoints()
	local outwards = toZ > fromZ
	local first, last, step = 1, #lane, 1
	if not outwards then first, last, step = #lane, 1, -1 end
	for i = first, last, step do
		local z = lane[i].Z
		local between = if outwards then (z > fromZ + 0.5 and z < toZ - 0.5) else (z < fromZ - 0.5 and z > toZ + 0.5)
		if between then
			table.insert(route, plotCFrame:PointToWorldSpace(lane[i]))
		end
	end
	table.insert(route, to)
	return route
end

-- Laufende Wiedergabe pro Spieler. Startet ein neuer Lauf, wird der alte
-- Token ungueltig und die alte Schleife beendet sich beim naechsten Schritt.
local _runToken: { [Player]: number } = {}

-- Ergebnis, das der Client noch nicht bekommen hat. Wird gesetzt sobald ein
-- Lauf beginnt und erst gefeuert, wenn der Baerchi sichtbar am Kampf-Spot
-- angekommen ist (siehe sendResult) — vorher liefe die Kampf-UI schon,
-- waehrend er noch zur Arena unterwegs waere. Bleibt die Wiedergabe aus
-- irgendeinem Grund stecken (kein Plot, Fehler waehrend des Laufs), wird an
-- den Abbruchstellen trotzdem gesendet, damit der Client nie ganz ohne
-- Ergebnis dasteht.
--
-- Der Eintrag traegt seinen eigenen Token: `isRunning` verhindert zwar, dass
-- ueberhaupt ein zweiter Lauf waehrend eines laufenden startet, aber ohne den
-- Token wuerde selbst ein knapp daneben abgewiesener Request die
-- Abbruch-Fallbacks eines ANDEREN, spaeter gestarteten Laufs treffen und
-- dessen Ergebnis zu frueh verschicken — genau der Fehler, den sendResult
-- eigentlich beheben soll. sendResult prueft den Token deshalb mit.
-- v12: Abrechnung und Zustand des laufenden Laufs. `entered` = wie viele
-- Stages bereits BEGONNEN haben (fuer die Abrechnung bei Abbruch), `phase`
-- und `stage` fuer die Anzeige, `recall` = Spieler will zurueck.
export type SettleFn = (played: number, recalled: boolean) -> Types.PitRunResult
type Active = {
	token   : number,
	run     : Types.PitRunResult,
	settle  : SettleFn?,
	settled : Types.PitRunResult?,
	sent    : boolean,
	entered : number,
	recall  : boolean,
	beats   : { { Types.FightBeat } }?,   -- v15: Zuege je Stage (Index = Stage im Lauf)
	phase   : string,     -- "ToPit" | "InPit" | "Returning"
	stage   : number?,
}
local _active: { [Player]: Active } = {}

-- Wo die gerade kaempfende Figur auf dem Plot hingehoert. homeFoot ist der
-- Fusspunkt VOR dem Loslaufen (fuer den Weg zurueck), pivot der exakte
-- Ausgangszustand (fuer den abschliessenden Snap in restoreHome).
type Home = { model: Model, pivot: CFrame, homeFoot: Vector3 }
local _home: { [Player]: Home } = {}

-- Sammel-Update 05.10. (Paket 4.3, "schnell den Tower hochfliegen"): Tempo
-- der Wiedergabe je Spieler (1, 2, 4 oder 0 = "Ergebnis sofort"). Die
-- Abrechnung aendert sich NICHT: sie steht ohnehin fest, bevor die Wiedergabe
-- beginnt, und wird am Ende ausgezahlt — schneller abspielen heisst nur
-- schneller ankommen. Gilt ab der naechsten Stage, gemerkt fuer die Sitzung.
local VALID_SPEEDS: { [number]: number } = { [1] = 1, [2] = 2, [4] = 4, [0] = 40 }
local _speed: { [Player]: number } = {}

local function speedFactor(player: Player): number
	return VALID_SPEEDS[_speed[player] or 1] or 1
end

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- Bringt eine noch in der Arena stehende Figur an ihren Platz auf dem Plot
-- zurueck und raeumt ihren Kampf-Balken weg. Idempotent: zweimal aufrufen
-- schadet nicht.
local function restoreHome(player: Player)
	local home = _home[player]
	if not home then return end

	_home[player] = nil

	local model = home.model
	if model.Parent ~= nil then
		FightBars.removeHealthBar(model)
		model:SetAttribute("InArena", nil)

		-- ZUERST abmelden, DANN heimsetzen — nie andersherum. Waehrend des
		-- Kampfs atmet die Figur am Kampf-Spot, ihre gemerkte Ruhelage ist also
		-- die Arena-Position. Ein spaeteres Abmelden wuerde sie genau dorthin
		-- zuruecksetzen und die Heimkehr wieder zunichtemachen.
		FigureFX.stopIdle(model)
		model:PivotTo(home.pivot)

		-- Zuhause angekommen und wieder in Ruhe: `home.pivot` ist garantiert
		-- die saubere Ruhelage, weil startPlayback das Atmen VOR dem Merken
		-- abgeschaltet hat.
		FigureFX.idleBob(model, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
	end
end

-- Alle Gegner-Figuren aus der Arena raeumen.
local function clearFighters(player: Player)
	local fighters = MapService.getFighterFolder(player)
	if not fighters then return end

	for _, child in fighters:GetChildren() do
		child:Destroy()
	end
end

-- Text auf der Anzeigetafel ueber der Arena. Die Tafel selbst gehoert
-- MapService; hier wird nur entschieden WAS draufsteht, weil nur dieser
-- Service den Verlauf des Laufs kennt.
-- v15: "Tower II · Stage 23"
-- Tafel-Texte sind Nachrichten (LocMsg): die Tafel sieht jeder Spieler auf
-- der Plattform, und jeder liest sie in seiner Sprache (MapService/WorldText).
local function stageTitle(towerId: string?, stage: number): Types.LocMsg
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	return Loc.msg("ui.pitboard.stage", { tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), stage = stage })
end

local function showStage(player: Player, towerId: string?, stage: Types.PitStageResult, cleared: number)
	MapService.setPitBanner(
		player,
		stageTitle(towerId, stage.stage),
		-- Sammel-Update 2.4: die Tafel sehen alle Spieler, jeder in seiner
		-- Sprache — deshalb Symbole und Zahlen statt deutscher Woerter.
		if cleared > 0
			then string.format("✔ %d", cleared)
			else "⚔ 1",
		MapConfig.PIT_BANNER_RUNNING
	)
end

local function showSummary(player: Player, run: Types.PitRunResult)
	-- "Geschafft" ist die Zahl gewonnener Stages. Sie kann 0 sein — dann hat
	-- der Baerchi den ersten Gegner nicht ueberlebt, und genau das soll auch
	-- dastehen statt eines beschoenigenden "0 geschafft".
	local won = run.stagesCleared > 0

	MapService.setPitBanner(
		player,
		if won
			then Loc.msg("fmt.append", { a = "✔", b = Loc.msg("ui.pitboard.won", { n = run.stagesCleared }) })
			else Loc.msg("fmt.append", { a = "✖", b = Loc.msg("ui.pitboard.none") }),
		Loc.msg("event.bonus.gummies", { n = run.gummiesWon }),
		if won then MapConfig.PIT_BANNER_WIN else MapConfig.PIT_BANNER_LOSS
	)
end

-- Schickt das Kampfergebnis an den Client — idempotent, weil mehrere
-- Abbruch- und Erfolgspfade das hier alle "auf gut Glueck" aufrufen koennen.
-- Erst danach darf CombatPanel seine Stage-Wiedergabe starten; siehe die
-- Aufrufstelle in startPlayback fuer den genauen Zeitpunkt (Ankunft am
-- Kampf-Spot).
-- `token` muss zu dem Lauf gehoeren, der sendResult aufruft — sonst koennte
-- der Abbruch-Fallback eines ueberholten Laufs A das laengst neu gesetzte
-- _pendingResult eines inzwischen gestarteten Laufs B verschicken, noch
-- bevor dessen eigener Baerchi angekommen ist.
-- v12: rechnet ab (einmal) und gibt das abgerechnete Ergebnis zurueck. Ohne
-- settle-Funktion (Altaufruf) zaehlt der volle Lauf.
local function settleActive(active: Active, played: number, recalled: boolean): Types.PitRunResult
	if active.settled then
		return active.settled
	end

	local settle = active.settle
	local result = active.run
	if settle then
		local ok, res = pcall(settle, played, recalled)
		if ok then
			result = res
		else
			warn("[PitArenaService] Abrechnung fehlgeschlagen:", res)
		end
	end

	active.settled = result
	return result
end

-- Schickt das ABGERECHNETE Ergebnis an den Client — idempotent und nur fuer
-- den Lauf, zu dem der Token gehoert. Wurde noch nicht abgerechnet (Abbruch),
-- wird hier mit den bereits begonnenen Stages abgerechnet.
local function sendResult(player: Player, token: number)
	local active = _active[player]
	if not active or active.token ~= token or active.sent then return end
	active.sent = true

	local result = settleActive(active, active.entered, active.recall)
	if player.Parent ~= nil then
		Remotes.CombatResultReceived:FireClient(player, result)
	end
end

-- Den Erschoepfungs-Zustand nachziehen, der waehrend der Wiedergabe
-- unterdrueckt war.
local function refreshState(player: Player)
	local data = PlayerService.getData(player)
	if data then
		MapService.updateBaerchiStates(player, data.island)
	end
end

--------------------------------------------------------------------------------
-- Wiedergabe
--------------------------------------------------------------------------------

-- Steht die Wiedergabe noch? Prueft alles was sie abbrechen kann:
-- ein neuer Lauf, der Spieler geht, der Plot wird neu gebaut (Figur weg),
-- oder das PIT wird ausgebaut (dann ist der Kaempfer-Ordner mit zerstoert
-- worden und neue Gegner landeten unsichtbar im Nirgendwo).
local function setPhase(player: Player, token: number, phase: string, stage: number?)
	local active = _active[player]
	if active and active.token == token then
		active.phase = phase
		active.stage = stage
	end
end

local function recallWanted(player: Player, token: number): boolean
	local active = _active[player]
	return active ~= nil and active.token == token and active.recall
end

local function stillValid(player: Player, token: number, figure: Model, fighters: Folder): boolean
	if _runToken[player] ~= token then return false end
	if player.Parent == nil then return false end
	if figure.Parent == nil then return false end
	if fighters.Parent == nil then return false end
	return true
end

-- v12: Laesst den Turm Etage fuer Etage von `fromLevel` auf `toLevel` wachsen
-- (oder schrumpfen) und haelt die Figur dabei immer oben auf der aktuellen
-- Etage. Bei sehr hohen Tuermen wachsen mehrere Etagen pro Schritt, damit es
-- nie laenger als `seconds` dauert. Die Figur darf waehrenddessen NICHT im
-- Idle-Loop sein (der Aufrufer meldet sie ab und danach wieder an).
-- Gibt false zurueck, wenn die Wiedergabe unterwegs ungueltig wurde.
local function rideTower(
	player: Player, token: number, figure: Model, fighters: Folder,
	fromLevel: number, toLevel: number, seconds: number,
	selfPos: Vector3, enemyPos: Vector3
): boolean
	local distance = math.abs(toLevel - fromLevel)
	if distance == 0 then return true end

	-- Hoechstens ~20 Schritte pro Sekunde: mehr sieht niemand, und jeder
	-- Schritt baut bzw. entfernt Teile.
	local steps    = math.max(1, math.min(distance, math.floor(seconds * 20)))
	local stepTime = seconds / steps

	for step = 1, steps do
		if not stillValid(player, token, figure, fighters) then return false end

		local level = fromLevel + math.floor((toLevel - fromLevel) * step / steps + 0.5)
		MapService.setPitTowerLevel(player, level)

		local y = MapService.getPitTowerFloorY(level)
		FigurePlacement.placeLookingAt(
			figure,
			Vector3.new(selfPos.X, y, selfPos.Z),
			Vector3.new(enemyPos.X, y, enemyPos.Z)
		)
		task.wait(stepTime)
	end

	return stillValid(player, token, figure, fighters)
end

local function startPlayback(player: Player, run: Types.PitRunResult, settle: SettleFn?, beats: { { Types.FightBeat } }?)
	-- Das Hochzaehlen des Tokens steht ganz oben und vor allem, was fehlschlagen
	-- kann. Ab hier gehoert die Wiedergabe fuer diesen Spieler UNS — und nur
	-- deshalb darf die Fehlerbehandlung in play() bedenkenlos aufraeumen. Stuende
	-- der Token weiter unten und etwas darueber wuerfe, wuerde play() den Zustand
	-- einer noch laufenden aelteren Wiedergabe zerlegen, die anschliessend
	-- munter weiterliefe: Figur zurueck auf dem Plot, aber weiter Gegner in der
	-- Arena und die Tafel wieder an.
	local token = (_runToken[player] or 0) + 1
	_runToken[player] = token

	-- Ab hier ist der Client faellig fuer dieses Ergebnis. Gefeuert wird es
	-- weiter unten erst bei Ankunft am Kampf-Spot — bricht die Wiedergabe
	-- vorher ab (kein Plot, Fehler), sorgen die Abbruchstellen selbst dafuer,
	-- dass es trotzdem noch rausgeht.
	_active[player] = {
		token   = token,
		run     = run,
		settle  = settle,
		settled = nil,
		sent    = false,
		entered = 0,
		recall  = false,
		beats   = beats,
		phase   = "ToPit",
		stage   = nil,
	}

	-- Ein Kampf hat immer Vorrang vor dem automatischen Weg zum Honig-Teich:
	-- forceAcquire nimmt das Bewegungs-Schloss notfalls dem Autopilot weg.
	-- Der bemerkt das selbst (sein isCancelled prueft den Besitzer) und bricht
	-- sein Hinlaufen sauber ab, statt mit dem Kampf um die Figur zu ringen.
	ActivityLock.forceAcquire(player, LOCK_HOLDER)

	-- Einen noch laufenden Lauf komplett aufraeumen. refreshState gehoert
	-- dazu: dessen Wiedergabe hatte den Zustand der Figur unterdrueckt und
	-- kommt wegen des neuen Tokens nicht mehr dazu, ihn nachzuziehen — der
	-- alte Baerchi staende sonst mit veralteter Beschriftung auf dem Plot.
	--
	-- Das passiert bewusst VOR den Abbruchgruenden unten: auch wenn diese
	-- Wiedergabe gar nicht erst startet, muss die alte sauber beendet sein.
	restoreHome(player)
	refreshState(player)
	clearFighters(player)
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)

	-- Es gibt keine Show — Ergebnis trotzdem rausschicken UND das Schloss
	-- wieder freigeben.
	--
	-- Das Freigeben stand hier frueher nicht: forceAcquire oben nimmt das
	-- Schloss immer, die beiden Abbruchgruende unten kamen aber ohne
	-- release() zurueck. Wer also einmal ohne Plot oder ohne gerenderte Figur
	-- in einen Lauf ging, behielt "Kampf" als Schloss-Besitzer fuer den Rest
	-- der Sitzung — der Autopilot ging nie wieder essen, und seit dem
	-- ActivityLock-Schutz wuerden auch Ausruesten, Verwerten und der
	-- Figuren-Neuaufbau dauerhaft abgelehnt. Nur der Fehler-Pfad
	-- (PitArenaService.play) hat freigegeben, der stille Abbruch nicht.
	local function abortPlayback()
		-- Keine Show moeglich: der Lauf zaehlt trotzdem voll (wie vor v12),
		-- er ist ja schon entschieden.
		local active = _active[player]
		if active and active.token == token then
			active.entered = #run.stages
		end
		sendResult(player, token)
		ActivityLock.release(player, LOCK_HOLDER)
		if _active[player] and _active[player].token == token then
			_active[player] = nil
		end
	end

	local center     = MapService.getPitPosition(player)
	local plotCFrame = MapService.getPlotCFrame(player)
	local fighters   = MapService.getFighterFolder(player)
	local figure     = MapService.getBaerchiModel(player, run.baerchiUid)

	-- Fehlt irgendetwas davon (kein Plot, kein Mesh-Template, Figur nicht
	-- gerendert), gibt es einfach keine Show. Der Lauf selbst ist davon
	-- unberuehrt — er ist laengst abgerechnet.
	if not center or not plotCFrame or not fighters or not figure then
		abortPlayback()
		return
	end

	-- typeof statt nur #: kaeme ein Lauf ohne stages-Tabelle herein, waere das
	-- sonst ein Fehler mitten in der Abrechnung statt einer stillen Nicht-Show.
	if typeof(run.stages) ~= "table" or #run.stages == 0 then
		abortPlayback()
		return
	end

	-- Ruhe-Atmen abschalten, BEVOR die Heimatposition gemessen wird: die Figur
	-- schwebt sonst gerade um einen Bruchteil ihres Hubs ueber der Ruhelage,
	-- und genau dieser Versatz wanderte dann in _home.pivot — nach jedem Kampf
	-- staende sie ein Stueckchen hoeher als vorher. stopIdle setzt sie dafuer
	-- selbst auf ihre Ruhelage zurueck.
	FigureFX.stopIdle(figure)

	local homeFoot = FigurePlacement.footOf(figure)   -- Sammel-Update 1.2
	_home[player] = { model = figure, pivot = figure:GetPivot(), homeFoot = homeFoot }

	local maxHp = math.max(1, run.maxHp)

	-- v14: welche Faehigkeit gezeigt wird (SkillFX). Die volle Show laeuft
	-- beim ersten Einsatz eines Laufs, danach nur ein kurzes Echo — sonst
	-- wuerde ein Lauf mit vielen Stages Minuten dauern.
	local fxData = PlayerService.getData(player)
	local fxBaerchi = fxData and fxData.island.baerchis[run.baerchiUid]
	local fxSkillId: string? = fxBaerchi and fxBaerchi.skillId
	local fxShownFull = false

	-- v15: Ladeleiste nur, wenn die Faehigkeit ueberhaupt aufgeladen wird
	-- (Passive und Grundschlag haben charge = 0).
	local fxSkill = fxSkillId and SkillConfig.getById(fxSkillId)
	local showsCharge = fxSkill ~= nil and (fxSkill.charge or 0) > 0

	-- Die beiden Kaempfer stehen sich quer zur Bruecke gegenueber, damit man
	-- sie beim Herueberlaufen von der Seite sieht statt hintereinander.
	local laneFrame: CFrame = plotCFrame   -- 12.10.: fuer die Laufwege (arenaRoute)
	local side     = plotCFrame.RightVector
	local selfPos  = center - side * MapConfig.FIGHT_SPACING
	local enemyPos = center + side * MapConfig.FIGHT_SPACING

	-- Die Figur gehoert jetzt uns: MapService laesst ihren Zustand in Ruhe,
	-- bis das Attribut wieder weg ist (sonst saehe sie mitten im Kampf
	-- erschoepft aus, weil die HP serverseitig schon final sind).
	figure:SetAttribute("InArena", true)

	-- Die Figur auf den Zustand VOR dem Lauf zuruecksetzen. Die gespeicherten
	-- HP stehen zu diesem Zeitpunkt schon auf dem Endwert — ohne diese Zeile
	-- stuende der Baerchi bereits blass und mit "erschoepft" beschriftet da,
	-- bevor der erste Gegner ueberhaupt erscheint.
	MapService.setFigureState(figure, run.hpBefore, maxHp)

	task.spawn(function()
		local selfFill: Frame? = nil
		local chargeFill: Frame? = nil

		local ok, err = pcall(function()
			-- Erst hinlaufen: der Kampf soll sichtbar ERST beginnen, wenn der
			-- Baerchi an der Plattform angekommen ist, nicht durch einen
			-- Teleport. FigureWalker haelt den Fusspunkt waehrenddessen exakt
			-- auf Plot-/Bruecken-Hoehe.
			FigureWalker.walkPath(figure, arenaRoute(laneFrame, homeFoot, selfPos), {
				speed       = arenaWalkSpeed(),
				bobPerStud  = arenaBobPerStud(),
				isCancelled = function()
					return not stillValid(player, token, figure, fighters) or recallWanted(player, token)
				end,
			})
			if not stillValid(player, token, figure, fighters) then
				sendResult(player, token)
				return
			end

			-- v12: auf dem Hinweg zurueckgeholt — noch keine Stage begonnen.
			-- Abrechnung mit 0 Stages (erstattet eine bezahlte Fortsetzung),
			-- dann von hier aus heimlaufen.
			if recallWanted(player, token) then
				sendResult(player, token)
				setPhase(player, token, "Returning", nil)
				local here = FigurePlacement.footOf(figure)
				FigureWalker.walkPath(figure, arenaRoute(laneFrame, here, homeFoot), {
					speed       = arenaWalkSpeed(),
					bobPerStud  = arenaBobPerStud(),
					isCancelled = function() return not stillValid(player, token, figure, fighters) end,
				})
				return
			end
			setPhase(player, token, "InPit", nil)

			-- Exakte Ausrichtung zum Gegner: der Lauf endet in Laufrichtung,
			-- gekaempft wird aber gegenueber.
			FigurePlacement.placeLookingAt(figure, selfPos, enemyPos)

			-- Ab hier steht der Baerchi am Kampf-Spot und atmet dort — auch
			-- zwischen den Stages und waehrend der Nachlauf-Pause, in der er
			-- sonst reglos herumstuende. Die Ausfallschritte melden ihn dafuer
			-- selbst kurz ab und danach wieder an (FigureFX.clash).
			FigureFX.idleBob(figure, {
				height = MapConfig.IDLE_BOB_HEIGHT,
				rate   = MapConfig.IDLE_BOB_RATE,
			})

			selfFill = FightBars.attachHealthBar(figure, MapConfig.FIGHT_BAR_SELF_COLOR)
			FightBars.tweenFill(selfFill, run.hpBefore / maxHp, 0.01)
			if showsCharge then
				chargeFill = FightBars.attachChargeBar(figure)
			end

			-- (v12: das Ergebnis geht erst nach der Abrechnung am Ende raus.)

			-- Der Gegner der VORHERIGEN Stage wird erst weggeraeumt wenn der
			-- naechste erscheint. Wuerde er am Ende seiner eigenen Stage
			-- verschwinden, waere die entscheidende letzte Niederlage nie zu
			-- sehen — und in der Nachlauf-Pause staende der eigene Baerchi
			-- allein in der Arena.
			local previousEnemy: Model? = nil

			-- Zaehlt die BEREITS gewonnenen Stages fuer die Anzeigetafel.
			-- Absichtlich nicht run.stagesCleared: das ist das Endergebnis und
			-- waere waehrend der Wiedergabe die halbe Spannung vorweggenommen.
			local cleared = 0

			-- Wo der eigene Baerchi zuletzt stand — auf Bodenhoehe, solange
			-- der Turm noch nicht gewachsen ist, sonst auf der aktuellen
			-- Etage. Der Rueckweg nach der letzten Stage startet von hier,
			-- nicht von der urspruenglichen (Boden-)selfPos.
			local finalSelfPos = selfPos

			-- Aktuelle Turmhoehe (Etagen), fuer den Abstieg am Ende.
			local towerNow = 0

			-- ============================================================
			-- v12: FORTSETZUNG — DER TURM WAECHST ERST BIS ZUR STARTSTAGE
			-- ============================================================
			-- Steigt der Baerchi bei Stage 30 ein, wachsen jetzt alle 29
			-- Etagen darunter sichtbar hoch und er faehrt oben mit. Danach
			-- kaempft er auf genau der Hoehe, auf der Stage 30 bei einem Lauf
			-- von vorn stattfinden wuerde — man sieht, wie weit oben man ist.
			-- v15: gestaucht (TowerConfig.getRunFloor), bei 100 Stages hoechstens
			-- RUN_MAX_FLOORS Etagen.
			local baseLevel = TowerConfig.getRunFloor(run.towerId or "I", run.startStage or 1)
			if baseLevel > 0 and not recallWanted(player, token) then
				MapService.setPitBanner(
					player,
					stageTitle(run.towerId, run.startStage or 1),
					"⬆ …",
					MapConfig.PIT_BANNER_RUNNING
				)

				local riseSeconds = math.min(
					MapConfig.PIT_TOWER_RISE_MAX_SECONDS,
					baseLevel * MapConfig.PIT_TOWER_RISE_SECONDS_PER_LEVEL
				)

				FigureFX.stopIdle(figure)
				if not rideTower(player, token, figure, fighters, 0, baseLevel, riseSeconds, selfPos, enemyPos) then
					return
				end
				FigureFX.idleBob(figure, {
					height = MapConfig.IDLE_BOB_HEIGHT,
					rate   = MapConfig.IDLE_BOB_RATE,
				})

				towerNow     = baseLevel
				finalSelfPos = Vector3.new(selfPos.X, MapService.getPitTowerFloorY(baseLevel), selfPos.Z)
			end

			for index, stage in run.stages do
				if not stillValid(player, token, figure, fighters) then return end

				-- v12: zurueckgeholt — die vorige Stage ist fertig gespielt,
				-- weitere beginnen nicht mehr.
				if recallWanted(player, token) then break end

				local active = _active[player]
				if active and active.token == token then
					active.entered = index
				end
				setPhase(player, token, "InPit", stage.stage)

				-- Etage dieser Stage: die erste Stage kaempft noch auf der
				-- normalen Kampfflaeche (Etage 0) — sichtbar identisch mit dem
				-- Boden, den man von der Bruecke kennt. Jede weitere Stage
				-- bekommt eine neue Turmetage obendrauf (siehe MapConfig,
				-- Abschnitt "PIT-TURM").
				-- v12: absolute Etage — bei einer Fortsetzung steht der Turm
				-- schon (siehe oben), Stage 30 kaempft auf Etage 29.
				local towerLevel = TowerConfig.getRunFloor(run.towerId or "I", stage.stage)
				MapService.setPitTowerLevel(player, towerLevel)
				towerNow = towerLevel

				local floorY        = MapService.getPitTowerFloorY(towerLevel)
				local stageSelfPos  = Vector3.new(selfPos.X, floorY, selfPos.Z)
				local stageEnemyPos = Vector3.new(enemyPos.X, floorY, enemyPos.Z)
				finalSelfPos = stageSelfPos

				-- Ist der Turm inzwischen gewachsen, steht der eigene Baerchi
				-- eine Etage tiefer als er jetzt muesste — er wird VOR dem
				-- naechsten Gegner mit hochgestellt. Ruhe-Atmen dafuer kurz
				-- abmelden und an der neuen Stelle neu anmelden, sonst zoegen
				-- Idle-Loop und diese Bewegung im selben Frame an derselben
				-- Figur (dieselbe Reihenfolge wie in restoreHome).
				if towerLevel > 0 then
					FigureFX.stopIdle(figure)
					FigurePlacement.placeLookingAt(figure, stageSelfPos, stageEnemyPos)
					FigureFX.idleBob(figure, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end

				showStage(player, run.towerId, stage, cleared)

				if previousEnemy and previousEnemy.Parent then
					previousEnemy:Destroy()
				end
				previousEnemy = nil

				local enemy = BaerchiMesh.buildEnemy(stageEnemyPos, MapConfig.FIGHT_ENEMY_COLOR)
				local enemyFill: Frame? = nil

				if enemy then
					FigurePlacement.placeLookingAt(enemy, stageEnemyPos, stageSelfPos)
					enemy.Parent = fighters
					enemyFill = FightBars.attachHealthBar(enemy, MapConfig.FIGHT_BAR_ENEMY_COLOR)
					previousEnemy = enemy

					-- Auch der Gegner soll nicht wie ein Standbild dastehen,
					-- solange er noch lebt.
					FigureFX.idleBob(enemy, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end

				-- ====================================================
				-- v15: DIE STAGE ZUG UM ZUG
				-- ====================================================
				local stageBeats: { Types.FightBeat } = (beats and beats[index]) or {}
				if #stageBeats == 0 then
					-- Ohne Zuege (aelterer Aufrufer): ein einziger Stoss, der
					-- das Ergebnis zeigt — wie vor v15.
					stageBeats = { {
						actor   = if stage.won then "A" else "B",
						kind    = "hit",
						selfHp  = stage.hpAfter / maxHp,
						enemyHp = if stage.won then 0 else 0.35,
						charge  = 0,
						skillId = nil,
					} }
				end

				local plan = FightTimeline.plan(stageBeats, #run.stages, stage.won)
				local fast  = speedFactor(player)   -- Paket 4.3
				local tempo = plan.tempo / fast

				-- Kurz stehen bleiben, damit man den neuen Gegner sieht.
				task.wait(MapConfig.FIGHT_ENEMY_INTRO_SECONDS * tempo)
				if not stillValid(player, token, figure, fighters) then return end

				for _, beatIndex in plan.indices do
					local beat = stageBeats[beatIndex]
					local isSelf = beat.actor == "A"
					local attacker: Model? = if isSelf then figure else enemy
					local target:   Model? = if isSelf then enemy else figure
					local attackerHome = if isSelf then stageSelfPos else stageEnemyPos
					local targetHome   = if isSelf then stageEnemyPos else stageSelfPos
					local isSkill = FightTimeline.isSkillBeat(beat)

					-- Leisten und Treffer-Rueckmeldung genau im Aufprall.
					local function onImpact()
						local barSeconds = MapConfig.FIGHT_BEAT_SECONDS * tempo * 0.5
						FightBars.tweenFill(selfFill, beat.selfHp, barSeconds)
						FightBars.tweenFill(enemyFill, beat.enemyHp, barSeconds)
						FightBars.setCharge(chargeFill, beat.charge, barSeconds)
						if target and target.Parent ~= nil then
							FigureFX.hitFlash(target, MapConfig.FIGHT_HIT_FLASH_COLOR, MapConfig.FIGHT_HIT_FLASH_SECONDS)
						end
						local contact = (stageSelfPos + stageEnemyPos) * 0.5 + Vector3.new(0, 1.5, 0)
						FigureFX.burstAt(contact, MapConfig.FIGHT_HIT_FLASH_COLOR, fighters,
							MapConfig.FIGHT_BUMP_SPARKS * (if isSkill then 3 else 1))
						FigureFX.soundAt(contact, MapConfig.FIGHT_BUMP_SOUND,
							MapConfig.FIGHT_BUMP_VOLUME * (if isSkill then 1.6 else 1), fighters,
							0.9 + math.random() * 0.25)
					end

					if beat.kind == "stunned" then
						-- Betaeubt: kein Stoss, die Figur taumelt.
						if attacker then
							FightBars.setCharge(chargeFill, beat.charge, 0.1)
							FigureFX.stagger(attacker, MapConfig.FIGHT_BEAT_SECONDS * tempo)
						else
							task.wait(MapConfig.FIGHT_BEAT_SECONDS * tempo)
						end
					else
						-- Faehigkeit mit Show (v15.1): die Show IST der Angriff.
						-- Leisten, Treffer-Blitz und Rueckstoss des Gegners
						-- kommen im Einschlag-Moment der Show
						-- (SkillFXConfig.getImpactTime), danach gibt es keinen
						-- zweiten Stoss mehr. Gesamtdauer wie in
						-- tools/sim/fight_timeline.lua:
						-- max(Show-Ende, Einschlag + Zugdauer).
						local showPlayed = false
						if isSkill and isSelf then
							FightBars.setCharge(chargeFill, 1, 0.1)
							local showId = beat.skillId or fxSkillId
							if showId then
								-- Paket 4.3: im Schnelldurchlauf nur das kurze Echo
								local full = not fxShownFull and fast <= 1
								fxShownFull = true
								local scale = if full then 1 else tempo
								Remotes.SkillFXPlay:FireAllClients({
									owner    = player.UserId,
									skillId  = showId,
									full     = full,
									attacker = figure,
									target   = enemy,
									center   = (stageSelfPos + stageEnemyPos) / 2,
									-- Finisher/Opener hat gegriffen (Client: violetter
									-- Schnitt, staerkerer Komet). Nur Optik.
									bonus    = beat.bonus == true,
								})
								local showSeconds   = SkillFXConfig.getDuration(showId, full) * scale
								local impactSeconds = math.min(SkillFXConfig.getImpactTime(showId, full) * scale, showSeconds)
								task.wait(impactSeconds)
								if not stillValid(player, token, figure, fighters) then return end

								local recoilSeconds = FightTimeline.beatSeconds(beat) * tempo
								if enemy and enemy.Parent ~= nil then
									onImpact()
									FigureFX.recoil(enemy, stageEnemyPos, stageSelfPos,
										MapConfig.FIGHT_SKILL_KNOCKBACK, MapConfig.FIGHT_HOP_HEIGHT * 1.6, recoilSeconds)
								else
									onImpact()
									task.wait(recoilSeconds)
								end
								local rest = showSeconds - impactSeconds - recoilSeconds
								if rest > 0 then task.wait(rest) end
								if not stillValid(player, token, figure, fighters) then return end
								showPlayed = true
							end
						end

						local seconds = FightTimeline.beatSeconds(beat) * tempo
						if showPlayed then
							-- Treffer kam schon in der Show (siehe oben).
						elseif attacker then
							FigureFX.clash(attacker, target, attackerHome, targetHome, {
								seconds   = seconds,
								gap       = MapConfig.FIGHT_CONTACT_GAP,
								hop       = MapConfig.FIGHT_HOP_HEIGHT * (if isSkill then 1.6 else 1),
								knockback = if isSkill then MapConfig.FIGHT_SKILL_KNOCKBACK else MapConfig.FIGHT_KNOCKBACK,
								step      = MapConfig.FIGHT_ENEMY_STEP_SHARE,
								onImpact  = onImpact,
							})
						else
							-- Gegner-Mesh fehlt: nur Leisten und Funken.
							onImpact()
							task.wait(seconds)
						end
					end

					if not stillValid(player, token, figure, fighters) then return end
				end

				-- Leisten auf den echten Endstand der Stage (falls Zuege
				-- ausgelassen wurden, stimmt so trotzdem alles).
				FightBars.tweenFill(selfFill, stage.hpAfter / maxHp, 0.15)
				FightBars.tweenFill(enemyFill, if stage.won then 0 else stageBeats[#stageBeats].enemyHp, 0.15)

				if stage.won then
					cleared += 1

					-- Besiegter Gegner kippt um, bevor der naechste kommt.
					-- Beim letzten Gegner macht das die Nachlauf-Pause unten.
					if index < #run.stages and enemy and enemy.Parent ~= nil then
						FigureFX.defeatCollapse(enemy, MapConfig.FIGHT_KO_SECONDS * tempo)
					end
				end
			end

			-- v12: JETZT abrechnen — mit den tatsaechlich gespielten Stages —
			-- und das Ergebnis an den Client schicken.
			local active = _active[player]
			local finalRun = run
			if active and active.token == token then
				finalRun = settleActive(active, active.entered, active.recall)
			end
			sendResult(player, token)

			-- Der letzte Gegner steht waehrend der Nachlauf-Pause noch da;
			-- weggeraeumt wird er unten von clearFighters.
			showSummary(player, finalRun)

			-- Wer die LETZTE Stage verloren hat, kippt sichtbar um, statt
			-- einfach zu verschwinden bzw. unveraendert stehenzubleiben.
			--
			-- Der eigene Baerchi kippt nur, wenn er den Lauf wirklich
			-- erschoepft beendet (hpAfter <= 0). Sonst laeuft er gleich darauf
			-- selbst nach Hause — eine umgekippte Figur, die losmarschiert,
			-- waere schlechter als gar keine Animation. Zurueckgesetzt wird die
			-- Neigung ohnehin von restoreHome.
			local lastStage = finalRun.stages[#finalRun.stages]
			local loser: Model? = nil

			if lastStage and lastStage.won then
				loser = previousEnemy
			elseif finalRun.hpAfter <= 0 then
				loser = figure
			end

			-- Das Umkippen laeuft INNERHALB der Nachlauf-Pause ab, verlaengert
			-- die Wiedergabe also nicht.
			local collapseSeconds = math.min(
				MapConfig.FIGHT_COLLAPSE_SECONDS,
				MapConfig.FIGHT_LINGER_SECONDS
			)

			if loser and loser.Parent ~= nil then
				FigureFX.defeatCollapse(loser, collapseSeconds)
				task.wait(math.max(0, MapConfig.FIGHT_LINGER_SECONDS - collapseSeconds))
			else
				task.wait(MapConfig.FIGHT_LINGER_SECONDS)
			end

			if not stillValid(player, token, figure, fighters) then return end

			-- Ueberlebt (hpAfter > 0): der Baerchi laeuft selbststaendig zu
			-- seinem Platz zurueck. Erschoepft (hpAfter <= 0): er ist ausser
			-- Gefecht und steht einfach wieder normal auf dem Plot — die
			-- anschliessende restoreHome() setzt ihn dafuer direkt zurueck,
			-- ganz ohne Lauf-Animation.
			if finalRun.hpAfter > 0 then
				setPhase(player, token, "Returning", nil)

				-- Vor dem eigenen PivotTo abmelden: sonst zoegen Idle-Loop und
				-- Lauf-Animation im selben Frame an derselben Figur. Wieder
				-- angemeldet wird sie am Ende von restoreHome, auf ihrem Platz.
				FigureFX.stopIdle(figure)

				-- v12: erst mit dem Turm wieder nach unten fahren — sonst liefe
				-- er auf Turmhoehe durch die Luft nach Hause.
				if towerNow > 0 then
					clearFighters(player)
					if not rideTower(player, token, figure, fighters, towerNow, 0, MapConfig.PIT_TOWER_FALL_SECONDS, selfPos, enemyPos) then
						return
					end
					finalSelfPos = selfPos
				end

				FigureWalker.walkPath(figure, arenaRoute(laneFrame, finalSelfPos, homeFoot), {
					speed       = arenaWalkSpeed(),
					bobPerStud  = arenaBobPerStud(),
					isCancelled = function() return not stillValid(player, token, figure, fighters) end,
				})
			end
		end)

		if not ok then
			warn("[PitArenaService] Wiedergabe fehlgeschlagen:", err)
		end

		-- Fallback: ist die Schleife oben aus irgendeinem Grund abgebrochen
		-- oder auf einen Fehler gelaufen, BEVOR der Baerchi angekommen ist,
		-- haette der Client sonst nie ein Ergebnis bekommen. sendResult ist
		-- idempotent — war es schon raus, passiert hier nichts mehr.
		sendResult(player, token)

		-- Nur aufraeumen wenn diese Wiedergabe noch die aktuelle ist —
		-- sonst wuerde man einem bereits gestarteten neuen Lauf die Figur
		-- unter den Fuessen wegziehen.
		if _runToken[player] == token then
			restoreHome(player)
			clearFighters(player)
			MapService.setPitTowerLevel(player, 0)
			MapService.clearPitBanner(player)
			refreshState(player)
			ActivityLock.release(player, LOCK_HOLDER)
			if _active[player] and _active[player].token == token then
				_active[player] = nil
			end
		end
	end)
end

-- Laeuft fuer diesen Spieler gerade eine Wiedergabe (Hinlauf, Stages,
-- Nachlauf oder Ruecklauf)? CombatService fragt das VOR einem neuen
-- RequestStartCombat ab: der Cooldown auf diesem Remote (1s,
-- NetworkConfig) ist kuerzer als eine volle Wiedergabe — ohne diese Sperre
-- koennte ein zweiter Lauf mitten in den ersten hineinstarten und ihm die
-- Figur unter den Fuessen wegziehen.
--
-- _home ist dafuer das richtige Signal: es wird exakt fuer die Dauer einer
-- Wiedergabe gesetzt (startPlayback) und von restoreHome() wieder geleert,
-- egal ob sie normal zu Ende lief oder abgebrochen wurde.
-- HBB Paket 6: alle laufenden Laeufe fuer das Live-Kampf-Board (nur lesen).
function PitArenaService.liveRuns(): { { name: string, towerId: string?, stage: number?, phase: string } }
	local list = {}
	for player, active in _active do
		table.insert(list, {
			name    = player.DisplayName,
			towerId = active.run.towerId,
			stage   = active.stage,
			phase   = active.phase,
		})
	end
	return list
end

function PitArenaService.isRunning(player: Player): boolean
	return _home[player] ~= nil
end

-- Spielt einen fertig ausgerechneten Lauf ab. Kehrt sofort zurueck — die
-- eigentliche Wiedergabe laeuft nebenher.
--
-- Wirft NIE. Der Aufrufer (CombatService) steht mitten in der Abrechnung
-- eines Laufs: ein Fehler in dieser reinen Darstellung darf ihn nicht daran
-- hindern, die Daten zu speichern und den Client zu synchronisieren. Und er
-- darf vor allem keine Figur mit gesetztem "InArena" zuruecklassen — die
-- waere fuer den Rest der Sitzung von jeder Zustands-Aktualisierung
-- ausgenommen.
-- v15: `beats` = die Zuege je Stage (Index wie run.stages). Fehlen sie, wird
-- jede Stage als ein einziger Stoss gezeigt.
function PitArenaService.play(player: Player, run: Types.PitRunResult, settle: SettleFn?, beats: { { Types.FightBeat } }?)
	local ok, err = pcall(startPlayback, player, run, settle, beats)
	if ok then return end

	warn("[PitArenaService] Wiedergabe konnte nicht starten:", err)

	-- Aufraeumen was der abgebrochene Start schon angefasst haben koennte.
	-- Das ist nur deshalb gefahrlos, weil startPlayback den Token als ALLERSTES
	-- hochzaehlt: es gibt an dieser Stelle keine fremde Wiedergabe mehr, der
	-- man etwas wegraeumen koennte.
	--
	-- sendResult zuerst: schlug startPlayback ab, noch bevor es das Ergebnis
	-- verschicken konnte, bekaeme der Client sonst nie eins. _runToken[player]
	-- ist an dieser Stelle bereits der Token DIESES Versuchs — startPlayback
	-- setzt ihn als allerersten Schritt, bevor irgendetwas werfen kann.
	sendResult(player, _runToken[player] or 0)
	restoreHome(player)
	clearFighters(player)
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)
	refreshState(player)
	ActivityLock.release(player, LOCK_HOLDER)
	_active[player] = nil
end

-- v12: Spieler holt den Baerchi zurueck (Pet-Leiste). Auf dem Hinweg kehrt
-- er sofort um; im Kampf endet der Lauf nach der laufenden Stage. Auf dem
-- Rueckweg ist nichts mehr zu tun. true = Anfrage angenommen.
function PitArenaService.requestRecall(player: Player): boolean
	local active = _active[player]
	if not active or active.phase == "Returning" then
		return false
	end
	active.recall = true
	return true
end

-- v12: Phase des laufenden Laufs fuer die Pet-Leiste: "ToPit", "InPit",
-- "Returning" oder nil (kein Lauf). Dazu die laufende Stage (nur im Kampf).
function PitArenaService.getPhase(player: Player): (string?, number?)
	local active = _active[player]
	if not active or _home[player] == nil then
		return nil, nil
	end
	return active.phase, active.stage
end

-- v12: Ist dieser Baerchi gerade in einem noch nicht abgerechneten Lauf?
-- HoneyService lehnt Fuettern dann ab — die Abrechnung setzt die HP am Ende
-- auf den Wert nach der letzten Stage und wuerde eine Heilung dazwischen
-- ueberschreiben.
function PitArenaService.isFighting(player: Player, baerchiUid: string): boolean
	local active = _active[player]
	return active ~= nil and active.settled == nil and active.run.baerchiUid == baerchiUid
end

function PitArenaService.init()
	-- Verlaesst ein Spieler den Server mitten in der Wiedergabe, macht der
	-- Token-Vergleich die laufende Schleife ungueltig. Sein Plot wird ohnehin
	-- despawnt, aufraeumen muss hier nichts mehr.
	Players.PlayerRemoving:Connect(function(player)
		_runToken[player] = nil
		_home[player]     = nil
		_active[player]   = nil
		_speed[player]    = nil
	end)

	-- Paket 4.3: Tempo-Knopf der Pet-Leiste (PetBar).
	RateLimiter.connect(Remotes.RequestPitSpeed, "RequestPitSpeed", function(player, speed: any)
		if typeof(speed) ~= "number" or VALID_SPEEDS[speed] == nil then return end
		_speed[player] = speed
	end)

	-- v12: geht der Spieler mitten im Lauf, wird VOR dem Speichern
	-- abgerechnet — so, als waere die gerade begonnene Stage zu Ende gespielt.
	PlayerService.onPlayerLeaving(function(player)
		local active = _active[player]
		if active then
			settleActive(active, active.entered, active.recall)
		end
	end)

	print("[PitArenaService] Initialisiert")
end

return PitArenaService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX17"><Properties>
<string name="Name">PlotDisplayService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PlotDisplayService.luau
-- ServerScriptService/Services/PlotDisplayService.luau
--
-- Einzige Zustaendigkeit:
--   - Entscheiden WANN die sichtbare Darstellung eines Plots nachgezogen
--     werden muss — und mit welchem der drei unterschiedlich teuren Wege.
--
-- Haengt an PlayerService.onDataChanged. Das feuert bei JEDER Aenderung, also
-- auch bei jedem einzelnen Gummy. Alles jedes Mal neu zu bauen waere
-- Verschwendung, deshalb merkt sich dieser Service drei Signaturen und
-- vergleicht sie:
--
--   STRUKTUR   (uid + Level jedes Baerchis)
--       → MapService.updateBaerchis: baut alle Mesh-Figuren neu. Teuer.
--         Noetig wenn ein Baerchi dazukommt, wegfaellt oder im Level steigt.
--
--   ZUSTAND    (uid + aktuelle HP)
--       → MapService.updateBaerchiStates: schreibt nur Beschriftung und
--         Erschoepfung an bestehende Figuren. Billig. HP aendern sich bei
--         jedem Fuettern und jedem PIT-Lauf — dafuer 25 Meshes neu zu bauen
--         waere absurd.
--
--   GEBAEUDE   (id + Level + Honig)
--       → MapService.updateBuildingSigns: schreibt die Schilder neu. Billig.
--         Honig aendert sich alle 20 Sekunden.
--
--   EIER       (uids der herumliegenden Eier)
--       → MapService.updateLaidEggs: baut die kleinen Kugeln neu. Billig —
--         es sind hoechstens zwoelf, und sie sind keine Meshes.
--         Aendert sich, wenn der Baerchi eines legt oder der Spieler eines
--         aufsammelt.
--
--   RECYCLER   (Level + Warteschlange des Waben-Recyclers)
--       → MapService.updateRecycler: schreibt Schild und Lampe. Billig.
--         Aendert sich jede Sekunde, solange der Recycler arbeitet.
--
--   LOOKS      (v15: Look-Stufe jedes Gebaeudes und des Recyclers)
--       → MapService.updateBuildingLooks: baut genau das Gebaeude neu, dessen
--         Look sich geaendert hat, mit kurzer Aufwertungs-Show. Haengt am
--         LOOK, nicht am Level — ein Ausbau innerhalb eines Looks schreibt nur
--         das Schild (GEBAEUDE oben).
--
--   STUFE      (Welt aufwerten, Paket D: Insel-Stufe 1..4 aus Towern und
--               Rebirths, Modules/IslandStage)
--       → Attribut "IslandStage" am Player (ueberlebt jeden Insel-Neuaufbau).
--         Die Deko baut nur der Client (PlotLifeController), der Server baut
--         dafuer kein einziges Teil.
--
--   TOWER      (v15: Look + Etagen + Schildtext des Tower-Turms)
--       → MapService.updateTowerShowcase (Neuaufbau des Turms, Show nur beim
--         Look-Wechsel) und MapService.setOwnerBadge (Symbol am Plot-Schild).
--         Aendert sich nur bei einem neuen Rekord oder Tower.
--
--   TERMINAL   (08.10.: Zustand, gewaehlter Tower, Rekord, Fortschritt)
--      → MapService.updateTerminal: schreibt nur Attribute, kein Neubau.
--
-- Die Figuren und Schilder selbst baut MapService — dieser Service entscheidet
-- nur WANN und WELCHE Tiefe.
--
-- EINE SACHE ENTSCHEIDET DIESER SERVICE BEWUSST NICHT: ob die Figur gerade
-- mitten in einer Bewegung steckt. Diese Sperre sitzt in
-- MapService.updateBaerchis selbst, damit sie fuer JEDEN Aufrufer gilt und
-- nicht an jeder Aufrufstelle wiederholt werden muss. Hier unten wird nur die
-- Quelle fuer frische Daten eingehaengt, mit der MapService den verschobenen
-- Neuaufbau spaeter nachholt (siehe init).
--
-- Wichtig fuer das Verstaendnis des Signatur-Vergleichs: eine verschobene
-- Darstellung gilt hier trotzdem sofort als "dargestellt". Das ist richtig, so
-- lange MapService das Nachholen uebernimmt — waere es andersherum, muesste
-- dieser Service den Zustand einer fremden Warteschlange mitverfolgen.
--
-- Ersetzt den frueheren BaerchiDisplayService, der nur die Figuren kannte und
-- inzwischen aus dem Projekt entfernt ist.

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local IncubatorRules = require(ReplicatedStorage.Modules.IncubatorRules)   -- Paket 8
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local IslandStage      = require(ReplicatedStorage.Modules.IslandStage)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)

local PlotDisplayService = {}

type Signatures = {
	incubator : string,   -- Sammel-Update Paket 8
	structure : string,
	state     : string,
	buildings : string,
	eggs      : string,
	recycler  : string,
	looks     : string,
	tower     : string,
	stage     : string,
	terminal  : string,   -- 08.10. Tower-Terminal
}

local _signatures: { [Player]: Signatures } = {}

--------------------------------------------------------------------------------
-- Signaturen
--------------------------------------------------------------------------------

-- Was sich aendern muss, damit die Figur neu gebaut wird: welche Baerchis es
-- gibt, auf welchem Level sie stehen (das Level aendert die Groesse der
-- Beschriftung und kann spaeter das Modell aendern) — UND wer gerade
-- ausgeruestet ist, seit nur noch dieser eine sichtbar gebaut wird. Ohne
-- equippedUid hier wuerde ein Equip-Wechsel auf einen gleich hochstufigen
-- Baerchi denselben String ergeben und die Signatur haelt die Aenderung
-- faelschlich fuer bereits dargestellt.
--
-- Die MUTATION gehoert aus demselben Grund dazu: sie bestimmt Fellfarbe, Aura
-- und das Kuerzel auf dem Namensschild (siehe MapService.buildBaerchiFigure).
-- Normalerweise aendert sie sich nie nach dem Schluepfen — der Mutations-Sturm
-- (EventParticipationService) kann sie aber mitten im Spiel anheben, und ohne
-- diesen Eintrag liefe die Figur bis zum naechsten Insel-Neuaufbau in der
-- alten Farbe weiter.
local function structureSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, string.format("%s:%d:%s:%s", uid, baerchi.level, baerchi.mutation or "-", baerchi.rarity))
	end
	table.sort(parts)
	table.insert(parts, "equipped:" .. (data.island.equippedUid or ""))
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Beschriftung neu geschrieben wird.
local function stateSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, uid .. ":" .. baerchi.currentHp)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Gebaeude-Schilder neu geschrieben werden.
local function buildingSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d:%d", id, building.level, building.honey or 0))
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Eier neu gebaut werden: WELCHE Eier
-- herumliegen. Die Position gehoert bewusst nicht dazu — ein gelegtes Ei
-- bewegt sich nie, es kommt nur dazu oder verschwindet.
local function eggSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for _, egg in data.island.laidEggs or {} do
		table.insert(parts, egg.uid)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit Schild und Lampe des Waben-Recyclers neu
-- geschrieben werden: Level und Warteschlange.
local function recyclerSignature(data: Types.PlayerData): string
	local recycler = data.island.recycler
	return string.format("%d:%d", recycler.level, recycler.queued)
end

-- v15: Look-Stufen. Bewusst NICHT das Level: ein Gebaeude wird nur neu
-- gebaut, wenn es einen neuen Look bekommt (README 4.2).
local function lookSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d", id, BuildingBehavior.getLook(building.level)))
	end
	table.sort(parts)
	table.insert(parts, "Recycler:" .. BuildingBehavior.getLook(data.island.recycler.level))
	return table.concat(parts, "|")
end

-- v15: Tower-Turm: hoechster Tower (Look) und Rekord darin (Etagen + Schild).
local function towerSignature(data: Types.PlayerData): string
	local towerId, record = TowerConfig.bestRecord(data.towers)
	local highest = data.towers.highestTower
	if TowerConfig.getIndex(highest) > TowerConfig.getIndex(towerId) then
		towerId, record = highest, data.towers.records[highest] or 0
	end
	return string.format("%s:%d", towerId, record)
end

-- Sammel-Update Paket 8: Inkubator — belegte Plaetze (Ei + Zeitmarken),
-- Level und Platz-Zahl. Fortschritt rechnet der Client selbst.
local function incubatorSignature(data: Types.PlayerData): string
	local incubator = data.island.incubator
	if not incubator then return "" end
	local parts: { string } = { tostring(incubator.level), tostring(IncubatorRules.slotCountFor(data)) }
	for _, entry in incubator.slots do
		table.insert(parts, string.format("%d=%s@%d", entry.slot, entry.eggType, entry.finishAt))
	end
	-- INCUBATOR_BREED: Baerchis in den Plaetzen (Figur, Takt, letzte Brut)
	for _, entry in incubator.breeders or {} do
		local baerchi = data.island.baerchis[entry.uid]
		table.insert(parts, string.format("b%d=%s:%s:%s@%d", entry.slot, entry.uid,
			if baerchi then baerchi.rarity else "?", if baerchi then tostring(baerchi.mutation) else "",
			entry.lastEggAt))
	end
	return table.concat(parts, "|")
end

-- Paket D: Stufe der Insel-Deko
local function stageSignature(data: Types.PlayerData): string
	return tostring(IslandStage.compute(data.towers and data.towers.records, data.rebirthCount or 0))
end

-- 08.10.: Tower-Terminal — Zustand, gewaehlter Tower, Rekord, Fortschritt.
local function terminalView(data: Types.PlayerData): { state: string, tower: string, record: number, nextTower: string, newTower: string, progress: number, needed: number }
	local towers = data.towers
	-- 12.10.: Freischaltung pro Leben (TOWER_UNLOCK_PER_LIFE) — nach einem
	-- Rebirth zeigt das Terminal wieder "Schaffe Tower I x/30".
	local progressRecords = TowerConfig.unlockRecords(towers, data.island)
	local nextTower, newTower = "", ""
	for _, def in TowerConfig.TOWERS do
		if newTower == "" and TowerConfig.isNew(def.id, towers) then
			newTower = def.id
		end
		if nextTower == "" and not TowerConfig.isUnlockedByClear(def.id, progressRecords, towers.unlocked) then
			nextTower = def.id
		end
	end
	local _, progress, needed = TowerConfig.getUnlockProgress(nextTower, progressRecords)
	return {
		state     = TowerConfig.terminalState(towers, progressRecords),
		tower     = towers.selected,
		record    = towers.records[towers.selected] or 0,
		nextTower = nextTower,
		newTower  = newTower,
		progress  = progress,
		needed    = needed,
	}
end

local function terminalSignature(data: Types.PlayerData): string
	local v = terminalView(data)
	return string.format("%s|%s|%d|%s|%s|%d|%d", v.state, v.tower, v.record, v.nextTower, v.newTower, v.progress, v.needed)
end

local function allSignatures(data: Types.PlayerData): Signatures
	return {
		terminal  = terminalSignature(data),
		incubator = incubatorSignature(data),
		structure = structureSignature(data),
		state     = stateSignature(data),
		buildings = buildingSignature(data),
		eggs      = eggSignature(data),
		recycler  = recyclerSignature(data),
		looks     = lookSignature(data),
		tower     = towerSignature(data),
		stage     = stageSignature(data),
	}
end

-- Turm und Plot-Symbol aus dem Tower-Stand (Signatur "Tower:Rekord").
local function applyTower(player: Player, signature: string, show: boolean)
	local towerId, recordText = string.match(signature, "^([^:]+):(%d+)$")
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	local record = tonumber(recordText) or 0

	MapService.updateTowerShowcase(player, {
		look   = def.look,
		floors = TowerConfig.getShowcaseFloors(def.id, record),
		title  = Loc.msg("ui.world.showcase_title", {
			name = player.DisplayName, tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record,
		}),
		color  = def.color,
	}, show)
	MapService.setOwnerBadge(player, Loc.msg("ui.world.owner_badge", {
		tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record,
	}), def.color)
end

--------------------------------------------------------------------------------
-- Abgleich
--------------------------------------------------------------------------------

local function refresh(player: Player, data: Types.PlayerData)
	local current  = allSignatures(data)
	local previous = _signatures[player]

	if not previous then
		-- Noch keine Signatur (sollte nach onDataLoaded nicht vorkommen):
		-- einmal komplett nachziehen und merken.
		_signatures[player] = current
		MapService.updateBaerchis(player, data.island)
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		return
	end

	if previous.structure ~= current.structure then
		-- Neuaufbau schreibt die Zustaende gleich mit — ein zusaetzliches
		-- updateBaerchiStates waere doppelte Arbeit.
		MapService.updateBaerchis(player, data.island)

	elseif previous.state ~= current.state then
		MapService.updateBaerchiStates(player, data.island)
	end

	if previous.buildings ~= current.buildings then
		MapService.updateBuildingSigns(player, data.island)
	end

	-- Bewusst UNABHAENGIG vom Struktur-Zweig oben: updateBaerchis baut die Eier
	-- zwar mit, kann aber wegen einer laufenden Bewegung verschoben worden sein
	-- (ActivityLock). Genau dann legt der Baerchi aber weiter — und ein frisch
	-- gelegtes Ei soll nicht darauf warten, dass er ankommt.
	if previous.eggs ~= current.eggs then
		MapService.updateLaidEggs(player, data.island)
	end

	if previous.recycler ~= current.recycler then
		MapService.updateRecycler(player, data.island)
	end

	if previous.incubator ~= current.incubator then
		MapService.updateIncubator(player, data.island, IncubatorRules.slotCountFor(data))
	end

	-- v15: neuer Look -> genau dieses Gebaeude neu bauen (mit Show). Nach einem
	-- Rebirth faellt der Look zurueck; rebuildIsland hat die Insel dann schon
	-- komplett neu gebaut, updateBuildingLooks findet nichts mehr zu tun.
	if previous.looks ~= current.looks then
		MapService.updateBuildingLooks(player, data.island, true)
	end

	if previous.stage ~= current.stage then
		player:SetAttribute("IslandStage", tonumber(current.stage))
	end

	if previous.terminal ~= current.terminal then
		MapService.updateTerminal(player, terminalView(data))
	end

	if previous.tower ~= current.tower then
		local oldTower = string.match(previous.tower, "^([^:]+):")
		local newTower = string.match(current.tower, "^([^:]+):")
		applyTower(player, current.tower, oldTower ~= newTower)
	end

	_signatures[player] = current
end

function PlotDisplayService.init()
	-- MapService darf PlayerService nicht requiren (PlayerService requiret
	-- bereits MapService — das waere ein Ringschluss). Deshalb bekommt es die
	-- Lesefunktion von hier: dieser Service kennt beide ohnehin schon.
	MapService.setIslandDataProvider(function(player: Player): Types.IslandData?
		local data = PlayerService.getData(player)
		return if data then data.island else nil
	end)
	-- Sammel-Update Paket 8: Platz-Zahl des Inkubators (Level, Rebirths, Index).
	MapService.setIncubatorSlotProvider(function(player: Player): number
		local data = PlayerService.getData(player)
		return if data then IncubatorRules.slotCountFor(data) else 1
	end)

	PlayerService.onPlayerReady(function(player, data)
		-- Die Figuren und Schilder stehen zu diesem Zeitpunkt schon
		-- (MapService.spawnIsland laeuft beim Join davor), aber die Daten
		-- haben sich seitdem noch geaendert: die onDataLoaded-Callbacks haben
		-- Offline-Honig gutgeschrieben und offline gelegte Eier eingetragen.
		-- Die Schilder zeigten sonst bis zum naechsten Honig-Tick den Stand von
		-- vor der Gutschrift, und die Eier laegen nur in den Daten.
		--
		-- Deshalb einmal aktiv nachziehen — und ERST DANN die Signatur
		-- merken, sonst haelt der Vergleich unten den Unterschied faelschlich
		-- fuer bereits dargestellt.
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateBaerchiStates(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		MapService.updateIncubator(player, data.island, IncubatorRules.slotCountFor(data))

		local signatures = allSignatures(data)
		applyTower(player, signatures.tower, false)
		player:SetAttribute("IslandStage", tonumber(signatures.stage))
		MapService.updateTerminal(player, terminalView(data))

		_signatures[player] = signatures
	end)

	PlayerService.onDataChanged(refresh)

	Players.PlayerRemoving:Connect(function(player)
		_signatures[player] = nil
	end)

	print("[PlotDisplayService] Initialisiert")
end

return PlotDisplayService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18"><Properties>
<string name="Name">RebirthService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- RebirthService.luau
-- ServerScriptService/Services/RebirthService.luau
--
-- Einzige Zustaendigkeit:
--   - Rebirth-Requests validieren und ausfuehren
--   - Insel zuruecksetzen, Multiplikator neu setzen, Meilenstein-Eier vergeben
--
-- Was ein Rebirth kostet und was er einbringt:
--   Bedingung  : (Sammel-Update 05.10.) eine Tower-Stage in diesem Leben,
--                TowerConfig.getRebirthRequirement — KEINE Gummies mehr
--   Verloren   : alle Gebaeude-Level, der Fortsetzen-Stand der Tower,
--                Gummies (zurueck auf REBIRTH_START_GUMMIES),
--                Baerchi-LEVEL und -XP (siehe unten)
--   Behalten   : alle Baerchis SELBST (inkl. wer gerade ausgeruestet ist,
--                Rarity, Skill, Fusion-Bonus), GoldGummies, Rang,
--                Statistiken, der Ei-Baum (v14), Tower-Rekorde und
--                Meilensteine (v15) und ALLE Eier im Lager
--                (v14 — vorher nur die Ascensions-Eier; seit kein Ei mehr
--                kaufbar ist, waere jedes andere Ei ein echter Verlust).
--                Herumliegende Eier wandern beim Rebirth ins Lager.
--   Gewonnen   : hoeherer rebirthMult + ggf. Meilenstein-Eier
--                (EconomyConfig.REBIRTH_MILESTONES, v14: alle vier
--                Ascensions-Eier, teils mit Freischaltung im Ei-Baum)
--
-- GoldGummies bleiben bewusst erhalten: sie sind die "harte" Waehrung fuer
-- die spaeten Gebaeude-Level und wuerden sonst jeden Rebirth entwerten.
--
-- Baerchis bleiben seit v8 als SAMMLUNG erhalten (vorher: komplett geloescht)
-- — das Sammeln ist der eigentliche langfristige Fortschritt im Spiel
-- (Grow-a-...-Fighter-Prinzip), ein Rebirth soll die Gebaeude-Spirale
-- zuruecksetzen, nicht die Sammlung wegnehmen. Ihr LEVEL faellt aber
-- weiterhin auf 1 zurueck: Honig-Fuettern (die einzige XP-Quelle, siehe
-- HoneyService) ist an die Gebaeude gekoppelt, die der Rebirth ja gerade
-- zuruecksetzt — bliebe das Level stehen, waere ein Rebirth am Ende ein
-- reiner Gewinn ohne jeden Rueckschritt, und nicht mehr der bewusste
-- Neustart-Trade-off, den das Spiel damit anbieten soll.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local FeatureFlags     = require(ReplicatedStorage.Config.FeatureFlags)   -- 12.10.: Tower pro Leben
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)   -- Paket 4.1: Rebirth nach Stage
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local MapService     = require(ServerScriptService.Services.MapService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)
local EggTreeService = require(ServerScriptService.Services.EggTreeService)

-- Feier-Farbe fuer einen Rebirth (siehe MapService.celebrateBaerchi) — Weiss,
-- fuer den "frischer Neustart"-Blitz statt einer Rarity- oder Rollen-Farbe.
local REBIRTH_CELEBRATE_COLOR = Color3.fromRGB(255, 255, 255)

local RebirthService = {}

local function fail(player: Player, reason: Types.LocMsg?)
	Remotes.ActionFailed:FireClient(player, "RequestRebirth", reason or Loc.msg("err.unknown"))
end

-- Setzt Level und XP eines Baerchis auf den Werkszustand zurueck und heilt
-- ihn dabei komplett — sonst stuende er nach dem Rebirth auf Level 1 mit den
-- (viel zu hohen) HP seines alten Levels da, oder umgekehrt erschoepft, wenn
-- die alten HP ueber der neuen, kleineren maxHp lagen.
--
-- Unbekannter configId (kaputter/veralteter Datensatz): Level/XP trotzdem
-- zuruecksetzen, HP aber unangetastet lassen — ohne Basiswerte laesst sich
-- keine maxHp berechnen, und ein Absturz hier wuerde den gesamten Rebirth
-- abbrechen, obwohl schon Gummies abgebucht sind.
local function resetBaerchiToLevelOne(baerchi: Types.Baerchi)
	baerchi.level = 1
	baerchi.xp    = 0

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		warn("[RebirthService] Unbekannter configId beim Rebirth-Reset:", baerchi.configId)
		return
	end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)
	baerchi.currentHp = stats.maxHp
end

function RebirthService.rebirth(player: Player)
	local data = PlayerService.getData(player)
	if not data then return end

	-- Sammel-Update 05.10. (Paket 4.1): kein Gummy-Preis mehr. Bedingung ist
	-- eine Tower-Stage, in DIESEM Leben geschafft (island.stageBest, siehe
	-- TowerConfig.getRebirthRequirement). Gummies verfallen beim Rebirth
	-- trotzdem (resetGummies unten) — wer vorher alles ausgibt, verliert nichts.
	if not TowerConfig.isRebirthReady(data.rebirthCount, data.island.stageBest, data.towers.records) then
		local towerId, stage = TowerConfig.getRebirthRequirement(data.rebirthCount, data.towers.records)
		local def = TowerConfig.get(towerId)
		fail(player, Loc.msg("err.rebirth_stage", {
			tower = if def then def.numeral else towerId,
			stage = stage,
			have  = (data.island.stageBest or {})[towerId] or 0,
		}))
		return
	end
	local cost = 0   -- nur noch fuer das Protokoll unten

	-- v14: ALLE Eier ueberleben den Reset (vorher nur Ascension). Seit kein
	-- Ei mehr kaufbar ist, waere jedes andere ein echter Verlust. Was noch
	-- auf dem Plot liegt, wandert mit ins Lager.
	local keptStock: { [Types.EggType]: number } = {}
	for eggType, count in data.island.eggStock do
		keptStock[eggType] = count
	end
	for _, egg in data.island.laidEggs do
		keptStock[egg.eggType] = (keptStock[egg.eggType] or 0) + 1
	end

	-- Baerchis (und wer davon gerade ausgeruestet ist) ueberleben den Reset
	-- ebenfalls — siehe Kopf-Kommentar. `equippedUid` einfach mit
	-- durchreichen statt neu zuzuweisen: zeigt der ausgeruestete Baerchi noch
	-- auf einen Eintrag in `keptBaerchis`, bleibt er nach dem Rebirth
	-- weiterhin ausgeruestet, MapService.rebuildIsland baut seine Figur ganz
	-- normal wieder mit auf.
	local keptBaerchis    = data.island.baerchis
	local keptEquippedUid = data.island.equippedUid

	-- Level und XP fallen trotzdem zurueck auf den Anfang — siehe Kopf-
	-- Kommentar. Die Baerchis selbst (Rarity, Skill, Fusion-Bonus, ...)
	-- bleiben dabei unangetastet, nur Fortschritt UEBER Level 1 hinaus geht
	-- verloren.
	for _, baerchi in keptBaerchis do
		resetBaerchiToLevelOne(baerchi)
	end

	-- Insel auf Werkszustand
	local freshIsland = PlayerService.buildDefaultIsland()
	-- Die Start-Basis-Eier gibt es nur fuer neue Spieler, nicht pro Rebirth.
	freshIsland.eggStock = keptStock
	freshIsland.baerchis    = keptBaerchis
	freshIsland.equippedUid = keptEquippedUid
	-- Sammel-Update Paket 8: Eier im Inkubator bleiben (wie das Ei-Lager),
	-- das Ausbau-Level faellt zurueck (Geldsenke vor dem Rebirth). Plaetze
	-- ueber der neuen Platz-Zahl lassen sich noch abholen, aber nicht neu belegen.
	local oldIncubator = data.island.incubator
	if oldIncubator and freshIsland.incubator then
		freshIsland.incubator.slots = oldIncubator.slots
		-- INCUBATOR_BREED: die Baerchis bleiben sitzen (die Sammlung bleibt
		-- beim Rebirth); IncubatorService raeumt fehlende im naechsten Takt.
		freshIsland.incubator.breeders = oldIncubator.breeders or {}
	end
	data.island = freshIsland

	-- 12.10. (TOWER_UNLOCK_PER_LIFE): die Tower-Freischaltung gilt pro Leben.
	-- Der Baerchi faellt auf Level 1 — er beginnt wieder in Tower I und
	-- schaltet II, III ... durch erneutes Schaffen frei (TowerService).
	-- Rekorde und Meilensteine bleiben.
	if FeatureFlags.isOn("TOWER_UNLOCK_PER_LIFE") then
		data.towers.unlocked = { [TowerConfig.FIRST_TOWER] = true }
		data.towers.selected = TowerConfig.FIRST_TOWER
	end

	-- Progression hochzaehlen
	data.rebirthCount += 1
	data.rebirthMult   = EconomyConfig.getRebirthMult(data.rebirthCount)
	data.stats.totalRebirths += 1

	-- Ueber EconomyService statt eines direkten Feld-Schreibzugriffs — nur
	-- der darf Waehrungen anfassen, auch beim Zuruecksetzen auf einen Fixwert.
	EconomyService.resetGummies(player, EconomyConfig.REBIRTH_START_GUMMIES)

	-- Meilenstein-Belohnung (v14: alle vier Ascensions-Eier)
	local eggReward = 0
	local milestoneEggs: { { eggType: Types.EggType, count: number } } = {}
	local milestone = EconomyConfig.getRebirthMilestone(data.rebirthCount)
	if milestone then
		for _, entry in milestone.eggs do
			local stock = data.island.eggStock[entry.eggType] or 0
			data.island.eggStock[entry.eggType] = stock + entry.count
			eggReward += entry.count
			table.insert(milestoneEggs, { eggType = entry.eggType, count = entry.count })
		end
		for _, eggType in (milestone.unlock or {}) do
			EggTreeService.forceUnlock(player, data, eggType, "rebirth")
		end
	end
	-- Rebirth-Gates im Baum (Sonnen-Ei ab Rebirth 3 usw.)
	EggTreeService.check(player, data, "rebirth")

	-- Sichtbare Insel neu aufbauen (Gebaeude auf Level 1, PIT wieder Level 1).
	-- rebuildIsland behaelt den Insel-Slot — der Spieler soll nach dem Rebirth
	-- nicht ploetzlich an einer anderen Stelle der Map stehen.
	MapService.rebuildIsland(player, data.island)

	-- Sichtbar feiern — NACH rebuildIsland, sonst existiert die Figur (mit
	-- ihrem frisch auf Level 1 zurueckgesetzten Stand) noch gar nicht in der
	-- Welt. Nur wenn ueberhaupt einer ausgeruestet ist: direkt nach dem ALLER-
	-- ersten Ei (vor dem ersten Rebirth ueberhaupt) waere keptEquippedUid nil.
	if keptEquippedUid then
		MapService.celebrateBaerchi(player, keptEquippedUid, REBIRTH_CELEBRATE_COLOR)
	end

	local result: Types.RebirthResult = {
		newRebirthCount = data.rebirthCount,
		newMultiplier   = data.rebirthMult,
		ascensionEggs   = eggReward,
		milestoneEggs   = milestoneEggs,
	}

	Remotes.RebirthResultReceived:FireClient(player, result)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	print(
		"[RebirthService]", player.Name,
		"| Rebirth #", data.rebirthCount,
		"| Kosten:", cost,
		"| neuer Multi:", data.rebirthMult,
		"| Meilenstein-Eier:", eggReward
	)
end

function RebirthService.init()
	RateLimiter.connect(Remotes.RequestRebirth, "RequestRebirth", function(player)
		RebirthService.rebirth(player)
	end)

	print("[RebirthService] Initialisiert")
end

return RebirthService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX19"><Properties>
<string name="Name">TowerService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- TowerService.luau
-- ServerScriptService/Services/TowerService.luau
--
-- Einzige Zustaendigkeit:
--   - Den permanenten Tower-Fortschritt fuehren (v15, ersetzt das PIT-Level):
--     Tower-Wahl, Freischaltung (08.10.: durch Schaffen des vorherigen
--     Towers, towers.unlocked, Meldung TowerUnlocked; ohne
--     FeatureFlags.TOWER_UNLOCK_BY_CLEAR der alte Deckel pro Rebirth),
--     Rekorde, Meilensteine (auch rueckwirkend) und die PIT-Erstattung aus
--     der Migration.
--
-- Was ein Lauf ist und wie er simuliert wird, weiss CombatService; dieser
-- Service sagt ihm nur, in welchem Tower gekaempft wird, bis wohin es Belohnung
-- gibt, und nimmt am Ende das Ergebnis entgegen (recordRun). Die Zahlen stehen
-- in Config/TowerConfig.
--
-- Die Daten (data.towers) liegen ausserhalb der Insel wie der Ei-Baum: ein
-- Rebirth setzt die Insel zurueck, Rekorde und abgeholte Meilensteine bleiben.
--
-- Auszahlungen laufen ausschliesslich ueber die zustaendigen Services:
-- Gummies/GoldGummies ueber EconomyService (Meilensteine OHNE Multiplikator,
-- awardGummiesFlat), Eier ueber EggService.grantEggs, Blaupausen ueber
-- EggTreeService.grantBlueprint.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local LeaderboardConfig = require(ReplicatedStorage.Config.LeaderboardConfig)  -- Paket 9: Woche
local EggTree     = require(ReplicatedStorage.Modules.EggTree)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local EggService     = require(ServerScriptService.Services.EggService)
local EggTreeService = require(ServerScriptService.Services.EggTreeService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local TowerService = {}

-- Nur Studio/Debug: Spielstaende, fuer die jeder Tower offen ist (Kampf in allen
-- vier Towern ohne Rebirths testen). Schluessel = die Daten-Tabelle, schwach.
local _debugOpen: { [any]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function fail(player: Player, reason: Types.LocMsg)
	Remotes.ActionFailed:FireClient(player, "RequestSelectTower", reason)
end

--------------------------------------------------------------------------------
-- Lesen
--------------------------------------------------------------------------------

-- Deckel in diesem Tower (0 = Tower noch zu). 08.10.: mit
-- TOWER_UNLOCK_BY_CLEAR die volle Stage-Zahl jedes freigeschalteten Towers.
function TowerService.getStageCap(data: Types.PlayerData, towerId: string): number
	local cap = TowerConfig.getStageCap(data.rebirthCount, towerId, TowerConfig.unlockRecords(data.towers, data.island), data.towers.unlocked)
	if cap <= 0 and _debugOpen[data] then
		local def = TowerConfig.get(towerId)
		return if def then def.stages else 0
	end
	return cap
end

-- Der gewaehlte Tower; ist er (z. B. nach einer Datenreparatur) nicht offen,
-- der hoechste offene.
function TowerService.getSelected(data: Types.PlayerData): string
	local selected = data.towers.selected
	if TowerConfig.isOpen(data.rebirthCount, selected, TowerConfig.unlockRecords(data.towers, data.island), data.towers.unlocked) or (_debugOpen[data] and TowerConfig.isValidId(selected)) then
		return selected
	end
	-- Sonst der hoechste offene Tower (Tower I ist immer offen)
	local best = TowerConfig.FIRST_TOWER :: string
	for _, def in TowerConfig.TOWERS do
		if TowerConfig.isOpen(data.rebirthCount, def.id, TowerConfig.unlockRecords(data.towers, data.island), data.towers.unlocked) then
			best = def.id
		end
	end
	return best
end

--------------------------------------------------------------------------------
-- Freischaltung (08.10.)
--------------------------------------------------------------------------------

-- Traegt die Tower ein, die `towerId` mit seinem Rekord oeffnet. `announce`:
-- dem Spieler melden (TowerUnlocked → Feier-Moment, "NEU"-Abzeichen). Beim
-- Join nur still nachtragen, sonst kaeme die Meldung bei jedem Betreten.
local function applyUnlocks(player: Player, data: Types.PlayerData, towerId: string, announce: boolean)
	if not FeatureFlags.isOn("TOWER_UNLOCK_BY_CLEAR") then return end
	local towers = data.towers
	if typeof(towers.unlocked) ~= "table" then towers.unlocked = {} end
	-- 12.10.: mit TOWER_UNLOCK_PER_LIFE zaehlt die beste Stage dieses Lebens
	local progress = TowerConfig.unlockRecords(towers, data.island)
	for _, nextId in TowerConfig.unlocksAfterClear(towerId, progress[towerId] or 0) do
		if towers.unlocked[nextId] ~= true then
			towers.unlocked[nextId] = true
			if announce then
				-- Nach dem Lauf-Ergebnis zeigen (Ergebnis-Toast zuerst)
				task.delay(1.5, function()
					if player.Parent then
						Remotes.TowerUnlocked:FireClient(player, nextId)
					end
				end)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Meilensteine
--------------------------------------------------------------------------------

-- Zahlt einen einzelnen Meilenstein aus (einmalig) und meldet ihn dem Client.
-- Gibt true zurueck, wenn er neu abgeholt wurde.
local function grantMilestone(player: Player, data: Types.PlayerData, towerId: string, stage: number): boolean
	local milestone = TowerConfig.getMilestone(towerId, stage)
	if not milestone then return false end

	local claimed = data.towers.claimed[towerId]
	if not claimed then
		claimed = {}
		data.towers.claimed[towerId] = claimed
	end
	local key = tostring(stage)
	if claimed[key] then return false end
	claimed[key] = true

	local reward: Types.TowerMilestoneReward = {
		towerId     = towerId,
		stage       = stage,
		gummies     = 0,
		goldGummies = 0,
		eggType     = nil,
		eggs        = 0,
		blueprints  = 0,
	}

	if milestone.gummies > 0 then
		reward.gummies = EconomyService.awardGummiesFlat(player, milestone.gummies)
	end
	if milestone.goldGummies > 0 then
		reward.goldGummies = EconomyService.awardGoldGummies(player, milestone.goldGummies)
	end
	if milestone.eggs > 0 then
		local eggType = EggTree.highestUnlocked(data.eggTree)
		if EggService.grantEggs(player, eggType, milestone.eggs) then
			reward.eggType = eggType
			reward.eggs = milestone.eggs
		end
	end
	if milestone.blueprints > 0 then
		EggTreeService.grantBlueprint(player, data, milestone.blueprints)
		reward.blueprints = milestone.blueprints
	end
	if milestone.endlessLevels > 0 then
		local baerchi = data.island.equippedUid and data.island.baerchis[data.island.equippedUid]
		if baerchi then
			baerchi.endlessLevel = (baerchi.endlessLevel or 0) + milestone.endlessLevels
			reward.endlessLevels = milestone.endlessLevels
		end
	end

	-- Kurz verzoegert: beim Join haengt der Client sein UI erst noch an.
	task.delay(1, function()
		if player.Parent then
			Remotes.TowerMilestoneReceived:FireClient(player, reward)
		end
	end)
	return true
end

-- Alle noch offenen Meilensteine bis einschliesslich `upTo` (rueckwirkend).
local function grantMilestonesUpTo(player: Player, data: Types.PlayerData, towerId: string, upTo: number): number
	local granted = 0
	local stage = TowerConfig.MILESTONE_EVERY
	while stage <= upTo do
		if grantMilestone(player, data, towerId, stage) then
			granted += 1
		end
		stage += TowerConfig.MILESTONE_EVERY
	end
	return granted
end

--------------------------------------------------------------------------------
-- Ergebnis eines Laufs
--------------------------------------------------------------------------------

-- Vom CombatService am Ende eines Laufs aufgerufen. `highestWon` = hoechste
-- gewonnene Stage dieses Laufs. Rekord und Meilensteine zaehlen nur bis zum
-- Deckel (weich). Gibt den neuen Rekord (nil = keiner) und zurueck, ob der Lauf
-- den Deckel erreicht hat (Rebirth-Hinweis, nur wenn der Deckel ein echtes
-- Limit ist).
function TowerService.recordRun(player: Player, data: Types.PlayerData, towerId: string, highestWon: number): (number?, boolean)
	local def = TowerConfig.get(towerId)
	if not def or highestWon <= 0 then return nil, false end

	local cap = TowerService.getStageCap(data, towerId)
	local counted = math.min(highestWon, cap)

	-- Sammel-Update 05.10. (Paket 4.1): beste Stage dieses Lebens fuer die
	-- Rebirth-Bedingung. Ungedeckelt: die Bedingung liegt ohnehin unter dem
	-- Deckel, und ein Spieler, der darueber kaempft, hat sie erst recht erfuellt.
	local island = data.island
	if typeof(island.stageBest) ~= "table" then island.stageBest = {} end
	island.stageBest[towerId] = math.max(island.stageBest[towerId] or 0, highestWon)

	local newRecord: number? = nil
	local previous = data.towers.records[towerId] or 0
	if counted > previous then
		data.towers.records[towerId] = counted
		newRecord = counted
		if def.index > TowerConfig.getIndex(data.towers.highestTower) then
			data.towers.highestTower = towerId
		end
		grantMilestonesUpTo(player, data, towerId, counted)
	end
	-- 12.10.: nach einem Rebirth oeffnet das erneute Schaffen den naechsten
	-- Tower wieder, auch ohne neuen Rekord (bereits offene meldet es nicht).
	applyUnlocks(player, data, towerId, true)

	-- Paket 9: beste Endless-Stage dieser Woche (Wochen-Bestenliste).
	if towerId == "Endless" then
		local week = LeaderboardConfig.weekOf(os.time())
		local entry = data.towers.endlessWeek
		if not entry or entry.week ~= week then
			entry = { week = week, best = 0 }
			data.towers.endlessWeek = entry
		end
		entry.best = math.max(entry.best, counted)
	end

	local capReached = highestWon >= cap and TowerConfig.isCapLimiting(data.rebirthCount, towerId)
	return newRecord, capReached
end

--------------------------------------------------------------------------------
-- Tower waehlen
--------------------------------------------------------------------------------

function TowerService.select(player: Player, towerId: string)
	local data = PlayerService.getData(player)
	if not data then return end

	if not TowerConfig.isValidId(towerId) then
		fail(player, Loc.msg("err.tower_unknown"))
		return
	end
	if not TowerConfig.isOpen(data.rebirthCount, towerId, TowerConfig.unlockRecords(data.towers, data.island), data.towers.unlocked)
		and not _debugOpen[data] then
		if towerId == "Endless" then
			fail(player, Loc.msg("err.tower_locked_endless"))
		elseif FeatureFlags.isOn("TOWER_UNLOCK_BY_CLEAR") then
			local prev, _, needed = TowerConfig.getUnlockProgress(towerId, TowerConfig.unlockRecords(data.towers, data.island))
			fail(player, Loc.msg("err.tower_locked_clear", {
				tower = Loc.msg("tower." .. (prev or TowerConfig.FIRST_TOWER) .. ".name"),
				stages = needed,
			}))
		else
			fail(player, Loc.msg("err.tower_locked", { rebirths = TowerConfig.getOpeningRebirth(towerId) }))
		end
		return
	end
	if data.towers.selected == towerId then return end

	data.towers.selected = towerId
	PlayerService.markDirty(player)
end

-- Debug: alle Tower fuer diesen Spielstand oeffnen (bis zum Verlassen).
function TowerService.debugOpenAll(data: Types.PlayerData)
	_debugOpen[data] = true
end

-- Debug: Rekord direkt setzen (mit Meilensteinen bis dorthin).
function TowerService.debugSetRecord(player: Player, towerId: string, stage: number)
	local data = PlayerService.getData(player)
	local def = TowerConfig.get(towerId)
	if not data or not def then return end
	local value = math.clamp(math.floor(stage), 0, def.stages)
	data.towers.records[towerId] = value
	if value > 0 and def.index > TowerConfig.getIndex(data.towers.highestTower) then
		data.towers.highestTower = towerId
	end
	grantMilestonesUpTo(player, data, towerId, value)
	applyUnlocks(player, data, towerId, true)
	PlayerService.markDirty(player)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function TowerService.init()
	RateLimiter.connect(Remotes.RequestSelectTower, "RequestSelectTower", function(player, towerId: any)
		if typeof(towerId) ~= "string" then return end
		TowerService.select(player, towerId)
	end)

	PlayerService.onDataLoaded(function(player, data)
		-- 1. PIT-Erstattung aus der Migration v14 -> v15 (einmalig).
		local refund = data.island.pitRefund or 0
		if refund > 0 then
			data.island.pitRefund = 0
			local paid = EconomyService.awardGummiesFlat(player, refund)
			task.delay(4, function()
				if player.Parent then
					Remotes.EventNotice:FireClient(player, Loc.msg("msg.pit_refund", { amount = paid }), "good")
				end
			end)
			print("[TowerService]", player.Name, "| PIT-Erstattung:", paid)
		end

		-- 2. Rueckwirkende Meilensteine (migrierter Rekord, oder ein neuer
		--    Meilenstein in der Config).
		for towerId, record in data.towers.records do
			grantMilestonesUpTo(player, data, towerId, record)
			applyUnlocks(player, data, towerId, false)
		end

		-- 3. Gewaehlter Tower muss offen sein.
		data.towers.selected = TowerService.getSelected(data)
	end)

	print("[TowerService] Initialisiert |", #TowerConfig.TOWERS, "Tower")
end

return TowerService
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX20"><Properties>
<string name="Name">Util</string>
</Properties>
<Item class="ModuleScript" referent="RBX21"><Properties>
<string name="Name">FigureWalker</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- FigureWalker.luau
-- ServerScriptService/Util/FigureWalker.luau
--
-- Einzige Zustaendigkeit:
--   - Ein Model prozedural von einem Fusspunkt zu einem anderen "laufen"
--     lassen — Bewegung plus einfache Lauf-Animation (Huepfen + Vorlehnung),
--     ohne dass dafuer eine echte Skelett-Animation gebraucht wird.
--
-- Die importierten Baerchi-Meshes sind keine gerigten Humanoid-Modelle
-- (siehe BaerchiMesh.luau): es sind lose zusammengesetzte Parts ohne
-- Motor6D-Gelenke, an denen eine klassische Lauf-Animation ansetzen koennte.
-- Eine Animation dafuer zu FORDERN waere Buerokratie um etwas, das es fuer
-- dieses Mesh gar nicht geben kann (dafuer muesste jedes Baerchi-Modell in
-- Studio neu gerigt werden). Stattdessen bewegt dieses Modul das GANZE Model
-- per Heartbeat-Schleife und legt ein Huepfen plus eine leichte Vorlehnung in
-- Laufrichtung darueber — der uebliche Trick fuer nicht gerigte Pet-Figuren
-- in diesem Genre (auch bei "Grow a ..."-artigen Spielen ueblich).
--
-- Der Fusspunkt bleibt waehrend der ganzen Bewegung exakt auf dem Boden: JEDEN
-- Frame wird zuerst gedreht und dann anhand der Bounding-Box neu auf den
-- Fusspunkt (plus Huepf-Offset) gestellt. Das Hinstellen selbst macht
-- FigurePlacement — dieselbe Funktion, die auch PitArenaService benutzt, um
-- seine Kaempfer aufzustellen. Warum das so laufen muss (erst drehen, dann
-- messen) steht im Kopf von FigurePlacement.luau, nicht mehr hier.

local RunService          = game:GetService("RunService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig       = require(ReplicatedStorage.Config.MapConfig)
local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)

local FigureWalker = {}

-- Die Vorgaben fuer das Huepfen kommen aus MapConfig und stehen bewusst NICHT
-- mehr hier: an ihnen dreht man beim Ausprobieren, und die Begruendung fuer die
-- Werte (wenige hohe Spruenge statt vieler flacher) gehoert neben die Zahl.
-- FigurePlacement bleibt davon unberuehrt — das ist reine Geometrie ohne
-- Geschmacksfrage.
export type WalkOptions = {
	speed       : number,          -- Studs pro Sekunde
	bobHeight   : number?,         -- Studs, Standard MapConfig.WALK_BOB_HEIGHT
	bobPerStud  : number?,         -- Spruenge pro Stud, Standard MapConfig.WALK_BOB_PER_STUD
	leanDegrees : number?,         -- Vorlehnung, Standard MapConfig.WALK_LEAN_DEGREES
	isCancelled : (() -> boolean)?,
}

-- Laeuft von `fromFoot` nach `toFoot` (beide Fusspunkte — es wird angenommen,
-- dass beide auf demselben Niveau liegen, z.B. Plot- oder Plattform-Hoehe;
-- die Y-Koordinate von `fromFoot` gilt fuer die ganze Bewegung). Kehrt erst
-- zurueck wenn die Bewegung fertig ist oder abgebrochen wurde — wer nebenher
-- weiterlaufen will, startet das selbst in einem eigenen task.spawn.
--
-- Endet IMMER exakt auf toFoot, auch nach einem Abbruch ueber isCancelled:
-- ein Model, das mitten in der Luft oder auf halbem Weg haengen bleibt, waere
-- schlimmer als der fehlende letzte Teil der Animation.
function FigureWalker.walk(model: Model, fromFoot: Vector3, toFoot: Vector3, options: WalkOptions)
	local flatFrom = Vector3.new(fromFoot.X, fromFoot.Y, fromFoot.Z)
	local flatTo   = Vector3.new(toFoot.X, fromFoot.Y, toFoot.Z)

	local delta    = flatTo - flatFrom
	local distance = delta.Magnitude

	if distance < 1e-2 then
		FigurePlacement.place(model, flatTo, model:GetPivot().Rotation)
		return
	end

	local direction = delta.Unit
	local facing    = CFrame.lookAt(Vector3.new(), direction)

	local speed       = math.max(options.speed, 1)
	local bobHeight   = options.bobHeight or MapConfig.WALK_BOB_HEIGHT
	local bobPerStud  = math.max(options.bobPerStud or MapConfig.WALK_BOB_PER_STUD, 1e-3)
	local leanRad     = math.rad(options.leanDegrees or MapConfig.WALK_LEAN_DEGREES)
	local isCancelled = options.isCancelled

	local duration = distance / speed
	local elapsed  = 0

	while elapsed < duration do
		if isCancelled and isCancelled() then
			break
		end

		local dt = RunService.Heartbeat:Wait()
		elapsed += dt

		local t        = math.clamp(elapsed / duration, 0, 1)
		local traveled = distance * t

		-- |sin| ist die Flugbahn eines huepfenden Balls: ein sauberer Bogen nach
		-- oben und ein harter Aufsetzpunkt unten. Genau dieser Knick macht den
		-- Unterschied zwischen "huepft" und "schwebt".
		--
		-- Das Argument ist absichtlich `traveled * bobPerStud * pi`, nicht
		-- `* 2 * pi`: |sin| hat die halbe Periode von sin, damit kommt auf
		-- 1 / bobPerStud Studs genau EIN Sprung. bobPerStud ist also woertlich
		-- "Spruenge pro Stud" — vorher stand dort ein Wert, der in Wahrheit die
		-- doppelte Frequenz bedeutete, und genau das war die Zitter-Falle.
		local bob = math.abs(math.sin(traveled * bobPerStud * math.pi)) * bobHeight

		FigurePlacement.place(
			model,
			flatFrom:Lerp(flatTo, t) + Vector3.new(0, bob, 0),
			facing * CFrame.Angles(leanRad, 0, 0)
		)
	end

	FigurePlacement.place(model, flatTo, facing)
end

-- 12.10. (Playtest "laeuft durch die Bruecke"): Laeuft eine Kette von
-- Fusspunkten ab. Anders als walk() folgt hier auch die HOEHE den Punkten
-- (linear je Abschnitt): vom Beet (2 Studs) hinunter auf Wiese und Steg und
-- weiter in die Arena, statt auf Beet-Hoehe ueber den Steg zu schweben bzw.
-- auf dem Rueckweg durch das Beet zu laufen. Das Huepfen laeuft ueber alle
-- Abschnitte durch (kein Ruck an den Ecken). Endet IMMER auf dem letzten
-- Punkt, auch nach einem Abbruch.
function FigureWalker.walkPath(model: Model, points: { Vector3 }, options: WalkOptions)
	if #points == 0 then return end
	local last = points[#points]
	if #points == 1 then
		FigurePlacement.place(model, last, model:GetPivot().Rotation)
		return
	end

	local speed       = math.max(options.speed, 1)
	local bobHeight   = options.bobHeight or MapConfig.WALK_BOB_HEIGHT
	local bobPerStud  = math.max(options.bobPerStud or MapConfig.WALK_BOB_PER_STUD, 1e-3)
	local leanRad     = math.rad(options.leanDegrees or MapConfig.WALK_LEAN_DEGREES)
	local isCancelled = options.isCancelled

	local facing = model:GetPivot().Rotation
	local traveledTotal = 0
	local cancelled = false

	for index = 1, #points - 1 do
		local from, to = points[index], points[index + 1]
		local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
		local distance = (to - from).Magnitude
		if distance > 1e-2 then
			-- Blickrichtung nur waagerecht; reine Hoehenschritte behalten sie
			if flat.Magnitude > 1e-2 then
				facing = CFrame.lookAt(Vector3.new(), flat.Unit)
			end
			local duration = distance / speed
			local elapsed = 0
			while elapsed < duration do
				if isCancelled and isCancelled() then
					cancelled = true
					break
				end
				local dt = RunService.Heartbeat:Wait()
				elapsed += dt
				local t = math.clamp(elapsed / duration, 0, 1)
				local bob = math.abs(math.sin((traveledTotal + distance * t) * bobPerStud * math.pi)) * bobHeight
				FigurePlacement.place(model, from:Lerp(to, t) + Vector3.new(0, bob, 0), facing * CFrame.Angles(leanRad, 0, 0))
			end
			traveledTotal += distance
		end
		if cancelled then break end
	end

	FigurePlacement.place(model, last, facing)
end

return FigureWalker
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX22"><Properties>
<string name="Name">MapBuild</string>
</Properties>
<Item class="ModuleScript" referent="RBX23"><Properties>
<string name="Name">RecyclerBuilder</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- RecyclerBuilder.luau
-- ServerScriptService/Util/MapBuild/RecyclerBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Den Waben-Recycler auf dem Plot bauen und sein Schild/seine Lampe
--     beschriften.
--
-- Wie ein Gebaeude (siehe PlotBuilder.buildBuilding): ein unsichtbarer Koerper,
-- der Name, Attribute und Schild traegt, plus die deklarative Deko aus
-- CombConfig.RECYCLER_DECOR und (v15) den Zusaetzen seines Looks
-- (CombConfig.getDecor). Der Look steht als Attribut "Look" am Koerper. Der Koerper heisst "Recycler"; der Client
-- (CombController) haengt daran den Ausbau-Prompt, aber nur am eigenen Plot.
--
-- Teil von MapService: nur MapService benutzt dieses Modul. Es aendert keine
-- Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local MapConfig  = require(ReplicatedStorage.Config.MapConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types      = require(ReplicatedStorage.Network.Types)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local WorldText = require(ReplicatedStorage.Localization.WorldText)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local RecyclerBuilder = {}

-- Die Insel-Wiese liegt auf PLATFORM_TOP_Y, also auf dem Plot-Ursprung — NICHT
-- auf der Beet-Hoehe (die ist PLOT_SIZE.Y darueber). Der Recycler steht auf dem
-- Gras vor dem Beet, deshalb Boden = Ursprung plus die Karo-Hoehe, damit nichts
-- in den hellen Feldern versinkt.
local function groundOffset(): number
	return MapConfig.GRASS_HEIGHT
end

-- Schreibt Level, Warteschlange und Lampe. Billig; laeuft bei jeder Aenderung
-- der Warteschlange (einmal pro Sekunde, solange gearbeitet wird).
function RecyclerBuilder.writeState(body: BasePart, recycler: Types.RecyclerData)
	-- Attribute: der Client rechnet daraus Prompt-Text und Kosten selbst.
	body:SetAttribute("RecyclerLevel", recycler.level)
	body:SetAttribute("RecyclerQueued", recycler.queued)

	local lamp = body:FindFirstChild("Lampe")
	if lamp and lamp:IsA("BasePart") then
		lamp.Color = if recycler.queued > 0 then CombConfig.LAMP_ACTIVE_COLOR else CombConfig.LAMP_IDLE_COLOR
	end

	local sign = body:FindFirstChild("Sign")
	if not sign or not sign:IsA("BillboardGui") then return end

	-- 12.10. (Playtest): das Schild zeigt IMMER nur den Geld-Multiplikator
	-- ("×12", sprachneutral) — sonst nichts. Ausgezahlt wird sofort, eine
	-- Warteschlange gibt es nicht mehr (CombConfig.INSTANT_PAYOUT).
	local title = sign:FindFirstChild("Title")
	local stock = sign:FindFirstChild("Stock")
	if CombConfig.INSTANT_PAYOUT then
		if title and title:IsA("TextLabel") then
			WorldText.set(title, CombConfig.formatMultiplier(recycler.level))
			title.TextColor3 = CombConfig.LAMP_ACTIVE_COLOR
			title.Size = UDim2.fromScale(1, 1)   -- die ganze Schildflaeche
		end
		if stock and stock:IsA("TextLabel") then
			stock.Visible = false
		end
		return
	end

	if title and title:IsA("TextLabel") then
		WorldText.set(title, Loc.msg("ui.world.sign_level", {
			name = Loc.msg("ui.recycler.name"), level = recycler.level,
		}))
	end

	if stock and stock:IsA("TextLabel") then
		if recycler.queued > 0 then
			stock.Text = string.format("⬡ %d", recycler.queued)   -- sprachneutral (2.4)
			stock.TextColor3 = CombConfig.LAMP_ACTIVE_COLOR
		else
			-- Sammel-Update 3.6: sprachneutral "⬡ = 12 G" (eine Wabe bringt so viel)
			stock.Text = string.format("⬡ = %d G", CombConfig.getPayPerUnit(recycler.level))
			stock.TextColor3 = Color3.fromRGB(235, 235, 235)
		end
	end
end

-- Baut den Recycler in das Plot-Model.
function RecyclerBuilder.build(plotModel: Model, slot: number, recycler: Types.RecyclerData)
	local plotCFrame = MapParts.plotCFrame(slot)
	local offset = CombConfig.RECYCLER_OFFSET
	local size   = CombConfig.RECYCLER_BODY_SIZE

	local ground = plotCFrame * CFrame.new(offset.X, groundOffset() + offset.Y, offset.Z)

	local body = MapParts.newPart(
		CombConfig.RECYCLER_NAME,
		size,
		ground * CFrame.new(0, size.Y * 0.5, 0),
		Color3.fromRGB(84, 178, 96),
		Enum.Material.SmoothPlastic
	)
	body.Transparency = 1
	body.CanCollide   = false
	body.Parent       = plotModel

	local look  = BuildingBehavior.getLook(recycler.level)
	local decor = CombConfig.getDecor(look)
	MapParts.buildDecor(body, ground, decor)
	body:SetAttribute("Look", look)

	-- Schild ueber dem Trichter, auf die Hoehe der hoechsten Deko gesetzt (wie
	-- bei den Gebaeuden: so haengt es nach einer Formaenderung nicht falsch).
	local top = math.max(MapParts.decorHeight(decor), size.Y)

	local sign = Instance.new("BillboardGui")
	sign.Name        = "Sign"
	sign.Size        = UDim2.fromScale(9, 2.6)
	sign.StudsOffset = Vector3.new(0, top - size.Y * 0.5 + 2, 0)
	sign.AlwaysOnTop = false
	sign.MaxDistance = MapConfig.BUILDING_SIGN_DISTANCE
	sign.Adornee     = body
	sign.Parent      = body

	MapParts.newTextLabel("Title", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0))
	MapParts.newTextLabel("Stock", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0.5))

	RecyclerBuilder.writeState(body, recycler)
end

return RecyclerBuilder
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="RBX24"><Properties>
<string name="Name">PlayerMigration</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PlayerMigration.luau
-- ServerScriptService/Util/PlayerMigration.luau
--
-- Einzige Zustaendigkeit:
--   - Einen geladenen Spielstand beliebiger frueherer Version auf die aktuelle
--     Struktur (Types.PlayerData) bringen
--
-- Gehoert fachlich zu PlayerService und wird nur von dort aufgerufen. Es ist
-- ein eigenes Modul, weil es eine reine Funktion ist (Tabelle rein, Tabelle
-- raus, kein DataStore, kein Spieler-Objekt) und deshalb ohne Studio getestet
-- werden kann: tools/luau-tests/migration.test.lua schickt alte Spielstaende
-- hindurch und prueft das Ergebnis gegen Types.createDefaultPlayerData.
--
-- Regel fuer neue Felder: jedes Feld, das in Types.PlayerData dazukommt, wird
-- hier nachgeruestet (oder ausdruecklich begruendet, warum nil reicht). Eine
-- Migration, die Werte UMRECHNET statt Fehlendes anzulegen, haengt an
-- data.version und darf nur einmal laufen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local PromotionConfig  = require(ReplicatedStorage.Config.PromotionConfig)
local CharmConfig      = require(ReplicatedStorage.Config.CharmConfig)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggTree          = require(ReplicatedStorage.Modules.EggTree)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local FeatureFlags     = require(ReplicatedStorage.Config.FeatureFlags)
local HoneyPondMode    = require(ReplicatedStorage.Modules.HoneyPondMode)

local PlayerMigration = {}

-- Fehlende Felder aus Default auffuellen (einfache Migration fuer neue Felder).
-- Muss jedes Feld abdecken das seit dem ersten Release in Types.luau
-- dazugekommen ist — sonst crasht alter Save-Stand beim ersten Zugriff.
function PlayerMigration.applyDefaults(data: Types.PlayerData): Types.PlayerData
	local default = Types.createDefaultPlayerData()

	-- Neue Top-Level-Felder
	if data.gummies      == nil then data.gummies      = default.gummies      end
	if data.goldGummies  == nil then data.goldGummies  = default.goldGummies  end
	if data.rebirthCount == nil then data.rebirthCount = default.rebirthCount end
	if data.rebirthMult  == nil then data.rebirthMult  = default.rebirthMult  end
	if data.rank         == nil then data.rank         = default.rank         end
	if data.island       == nil then data.island       = default.island       end
	if data.stats        == nil then data.stats        = default.stats        end
	if data.createdAt    == nil then data.createdAt    = default.createdAt    end
	if data.lastSeenAt   == nil then data.lastSeenAt   = default.lastSeenAt   end

	-- Neue Stats-Felder (dynamischer Key → bewusst ueber any, sonst meckert --!strict)
	local stats     = data.stats    :: any
	local defStats  = default.stats :: any

	-- HBB Paket 10: Sitzungszaehler. Ein Konto, das schon aelter als 10 min
	-- ist, war mindestens einmal da — es zaehlt als 1, damit Veteranen den
	-- Shop schon bei diesem Join (= Sitzung 2, PlayerService zaehlt hoch) sehen.
	if stats.sessions == nil then
		stats.sessions = if os.time() - (data.createdAt or os.time()) >= 600 then 1 else 0
	end
	for key, value in defStats do
		if stats[key] == nil then
			stats[key] = value
		end
	end

	-- highestTowerFloor gehoerte zu einem Tower-Modus, den es nicht gibt. Das
	-- Feld wird entfernt, damit es nicht bei jedem Speichern wieder im
	-- DataStore landet. Am Feld erkennbar und deshalb ohne Versions-Sprung
	-- wiederholbar; ein Wert geht nicht verloren, er war immer 0.
	stats.highestTowerFloor = nil

	-- Neue Island-Felder
	local island = data.island
	if island.baerchis  == nil then island.baerchis  = {} end
	if island.eggStock  == nil then island.eggStock  = { BasicEgg = 3 } end

	-- language: kein Nachruesten noetig — nil bedeutet "automatisch" (die
	-- Roblox-Sprache des Clients), und genau das soll ein alter Spielstand
	-- bekommen. Kein Versions-Sprung. Siehe SettingsService.
	--
	-- v6: equippedUid. Kein Nachruesten noetig — ein fehlendes Feld liest
	-- sich in Lua ohnehin als nil, und IslandService.autoEquipIfNone laeuft
	-- bei jedem Join (onDataLoaded) und ruestet automatisch den ersten
	-- vorhandenen Baerchi aus, falls noch/wieder keiner steht.

	-- ============================================================
	-- ============================================================
	-- v13: QUESTS + INDEX
	-- ============================================================
	-- Neue Felder: discovered, quests, stats.totalHatched (das Stats-Feld legt
	-- die Schleife oben schon mit 0 an). Fuer Spielstaende VOR v13 wird
	-- discovered aus den vorhandenen Baerchis gesaeet und totalHatched auf
	-- deren Anzahl gesetzt, damit Veteranen nicht bei null anfangen.
	if data.discovered == nil then
		data.discovered = {}
		for _, baerchi in data.island.baerchis do
			data.discovered[baerchi.configId] = true
		end
	end

	if (data.version or 0) < 13 then
		local owned = 0
		for _ in data.island.baerchis do owned += 1 end
		data.stats.totalHatched = math.max(data.stats.totalHatched or 0, owned)
	end

	-- HBB Paket 3: uiSeen. Leer nachruesten; UiStateService markiert beim
	-- ersten Laden eines Stands mit Fortschritt alles Sichtbare als gesehen
	-- (keine Badge-Flut fuer Veteranen). Kein Versions-Sprung.
	if data.uiSeen == nil then
		data.uiSeen = {}
	end

	-- HBB Paket 10: Shop-Teil. Leer nachruesten, kaputte Felder reparieren.
	local shop = (data :: any).shop
	if typeof(shop) ~= "table" then
		(data :: any).shop = default.shop
	else
		if typeof(shop.freeGrabDay) ~= "number" then shop.freeGrabDay = -1 end
		if typeof(shop.receipts) ~= "table" then shop.receipts = {} end
	end

	if data.quests == nil then
		data.quests = default.quests
	end

	-- ============================================================
	-- v14: EI-BAUM (Mega Egg Tree)
	-- ============================================================
	-- Neues Top-Level-Feld eggTree (ausserhalb der Insel, damit ein Rebirth
	-- es nicht loescht). Bestandsspieler bekommen die Knoten der Eier frei,
	-- die sie schon im Lager haben oder die auf ihrem Plot liegen — wer ein
	-- Goldenes Ei besitzt, soll es nicht ploetzlich "gesperrt" sehen. Die
	-- Rebirth-Knoten (Ascensions-Pfad) schaltet evaluate unten frei.
	--
	-- Gefahrlos wiederholbar: sanitize ergaenzt nur Fehlendes, und die
	-- Lager-Freischaltung laeuft nur fuer Spielstaende vor v14.
	local hadTree = data.eggTree ~= nil
	data.eggTree = EggTree.sanitize(data.eggTree)
	if not hadTree and (data.version or 0) < 14 then
		for eggType, count in island.eggStock do
			if (count or 0) > 0 and EggConfig.data[eggType] then
				data.eggTree.unlocked[eggType] = true
			end
		end
		for _, egg in (island.laidEggs or {}) do
			if EggConfig.data[egg.eggType] then
				data.eggTree.unlocked[egg.eggType] = true
			end
		end
	end
	-- Unbekannte Ei-Typen im Lager (alte Config) werden zum Basis-Ei.
	local stockAny = island.eggStock :: any
	for eggType, count in stockAny do
		if not EggConfig.data[eggType] then
			stockAny.BasicEgg = (stockAny.BasicEgg or 0) + (tonumber(count) or 0)
			stockAny[eggType] = nil
		end
	end
	EggTree.evaluate(data)

	-- v12: BRUT-SLOTS ENTFALLEN (Eier werden sofort geoeffnet)
	-- ============================================================
	-- Alte Spielstaende koennen noch laufende oder fertige Bruten in
	-- island.hatchingEggs haben. Die gehen NICHT verloren: jedes Ei wandert
	-- als ungeoeffnetes Ei zurueck ins Lager, danach wird das Feld entfernt.
	-- Ein Ei-Typ, den es nicht mehr gibt, wird zum Basis-Ei (dieselbe Regel,
	-- die frueher beim Abholen galt).
	--
	-- Gefahrlos wiederholbar: beim zweiten Durchlauf ist das Feld schon nil.
	-- Ueber `any`, weil Types.IslandData das Feld seit v12 nicht mehr kennt.
	local legacyIsland = island :: any
	if legacyIsland.hatchingEggs ~= nil then
		if typeof(legacyIsland.hatchingEggs) == "table" then
			for _, egg in legacyIsland.hatchingEggs do
				local eggType = if typeof(egg) == "table" then egg.eggType else nil
				if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then
					eggType = "BasicEgg"
				end
				local stock = island.eggStock :: any
				stock[eggType] = (stock[eggType] or 0) + 1
			end
		end
		legacyIsland.hatchingEggs = nil
	end

	-- v12: pitProgress muss nur gueltig sein, wenn es da ist (nil = kein
	-- gespeicherter Lauf). Ein halber Eintrag wird verworfen statt geraten.
	local progress = legacyIsland.pitProgress
	if progress ~= nil and (typeof(progress) ~= "table"
		or typeof(progress.pitLevel) ~= "number"
		or typeof(progress.reachedStage) ~= "number")
	then
		legacyIsland.pitProgress = nil
	end

	-- v10: gelegte Eier.
	--
	-- lastEggAt bewusst auf JETZT statt auf createdAt: ein Spielstand, der vor
	-- diesem Feature entstanden ist, hat keine Ei-Zeit — wuerde man hier
	-- createdAt einsetzen, bekaeme er beim ersten Join nach dem Update die
	-- Obergrenze auf einen Schlag geschenkt, fuer eine Zeit, in der es das
	-- Legen noch gar nicht gab.
	if island.laidEggs == nil then
		island.laidEggs = {}
	else
		-- Nur vollstaendige Eintraege behalten. Ein Ei ohne uid liesse sich nie
		-- einsammeln und laege bis in alle Ewigkeit auf dem Plot herum.
		local cleaned: { Types.LaidEgg } = {}
		for _, egg in island.laidEggs do
			if typeof(egg.uid) == "string" and #egg.uid > 0
				and typeof(egg.eggType) == "string"
				and typeof(egg.x) == "number"
				and typeof(egg.y) == "number"
				and typeof(egg.z) == "number"
			then
				table.insert(cleaned, egg)
			end
		end
		island.laidEggs = cleaned
	end

	if island.lastEggAt == nil then
		island.lastEggAt = os.time()
	end

	-- v15: Waben-Recycler. Feldweise nachgeruestet (wie lastEggAt), deshalb
	-- gefahrlos wiederholbar und ohne Versionssprung.
	local recycler = (island :: any).recycler
	if typeof(recycler) ~= "table" then
		(island :: any).recycler = { level = 1, queued = 0, progress = 0, lastProcessedAt = os.time() }
	else
		if typeof(recycler.level) ~= "number" then recycler.level = 1 end
		if typeof(recycler.queued) ~= "number" then recycler.queued = 0 end
		if typeof(recycler.progress) ~= "number" then recycler.progress = 0 end
		if typeof(recycler.lastProcessedAt) ~= "number" then recycler.lastProcessedAt = os.time() end
	end

	-- (v5 hatte hier die uid-Nachruestung der Brut-Eier — seit v12 gibt es
	-- keine Brut-Eier mehr, siehe oben.)

	-- v4: die Gebaeude sind komplett ausgetauscht. Frueher gab es Hatchery,
	-- GummyFarm, Recycler (und davor FusionLab) mit je eigener Funktion —
	-- jetzt reine Honig-Produzenten. Alte Eintraege werden entfernt und
	-- die neuen angelegt; das Level laesst sich nicht sinnvoll uebertragen,
	-- weil die Gebaeude etwas voellig anderes tun.
	--
	-- (Honigtopf und Honig-Presse bleiben hier noch stehen: die v7- und die
	-- v15-Migration weiter unten brauchen ihre Level. Entfernt werden sie erst
	-- in der v15-Zusammenlegung.)
	local OBSOLETE_BUILDINGS = { "Hatchery", "GummyFarm", "Recycler", "FusionLab" }

	if island.buildings == nil then
		island.buildings = default.island.buildings
	else
		local buildings = island.buildings :: any

		for _, obsolete in OBSOLETE_BUILDINGS do
			buildings[obsolete] = nil
		end

		for buildingId, building in default.island.buildings do
			local existing = buildings[buildingId]
			if existing == nil then
				buildings[buildingId] = {
					id             = building.id,
					level          = building.level,
					honey          = building.honey,
					lastProducedAt = building.lastProducedAt,
				}
			else
				-- v4: Honig-Felder auf bereits vorhandenen Gebaeuden nachruesten
				if existing.honey == nil then
					existing.honey = 0
				end
				if existing.lastProducedAt == nil then
					existing.lastProducedAt = os.time()
				end
			end
		end
	end

	-- v7: die drei Gebaeude haben eigene Rollen bekommen (siehe
	-- Config/BuildingBehavior). Die XP pro Honig haengen seitdem allein am Level
	-- der Honig-Presse — vorher am Level des Gebaeudes, aus dem der Honig kam,
	-- also an allen dreien.
	--
	-- Ohne Ausgleich wuerde ein laufender Spielstand dabei XP VERLIEREN: wer
	-- seinen Bienenstock auf Level 5 stehen hat und die Presse auf Level 1,
	-- bekaeme ploetzlich 30 statt 135 XP pro Honig. Deshalb erbt die Presse
	-- einmalig das hoechste Level, das dieser Spielstand bei irgendeinem
	-- Gebaeude erreicht hatte. Danach ist die XP-Ausbeute mindestens so gut wie
	-- vorher, und niemand muss etwas nachkaufen.
	--
	-- DAS IST DIE ERSTE MIGRATION, DIE AN DER VERSIONSNUMMER HAENGEN MUSS
	-- (siehe den Kommentar bei data.version am Ende dieser Funktion): sie
	-- rechnet einen Wert um, statt ein fehlendes Feld anzulegen. Liefe sie bei
	-- jedem Join erneut, wuerde die Presse jedes Mal wieder auf das Maximum
	-- hochgezogen — der Spieler koennte die anderen beiden nie ueberholen.
	if (data.version or 0) < 7 then
		local press = (island.buildings :: any).HoneyPress

		if press then
			local highest = press.level or 1

			for _, building in island.buildings do
				highest = math.max(highest, building.level or 1)
			end

			press.level = highest
		end
	end

	-- ============================================================
	-- v15: GEBAEUDE OPTION B — Honigtopf + Honig-Presse -> Honig-Veredler
	-- ============================================================
	-- Niemand verliert etwas: der Veredler bekommt das HOEHERE der beiden alten
	-- Level (er kann beides: XP wie die Presse, Heilung wie der Topf), und der
	-- eingelagerte Honig beider wird zusammengelegt (gedeckelt auf sein Lager).
	-- Haengt an der Version, weil es UMRECHNET; danach sind Topf und Presse weg.
	-- Ueber `any`, weil Types.BuildingId die alten Ids nicht mehr kennt.
	do
		local buildings = island.buildings :: any
		if (data.version or 0) < 15 then
			local pot     = buildings.HoneyPot
			local press   = buildings.HoneyPress
			local refiner = buildings.HoneyRefiner
			-- Mit HONEY_POND_V2 legt der Standard keinen Veredler mehr an; fuer
			-- die Zusammenlegung (und danach den Teich) wird er hier angelegt.
			if refiner == nil and (pot or press) then
				refiner = { id = "HoneyRefiner", level = 1, honey = 0, lastProducedAt = os.time() }
				buildings.HoneyRefiner = refiner
			end
			if refiner and (pot or press) then
				local level = math.max(refiner.level or 1,
					if pot then pot.level or 1 else 1,
					if press then press.level or 1 else 1)
				refiner.level = math.clamp(level, 1, EconomyConfig.MAX_BUILDING_LEVEL)

				local honey = (if pot then pot.honey or 0 else 0) + (if press then press.honey or 0 else 0)
				refiner.honey = math.clamp(honey, 0, BuildingBehavior.getCapacity("HoneyRefiner", refiner.level))
			end
		end

		-- Honig-Teich (HONEY_POND_V2) bzw. zurueck zu Stock + Veredler. MUSS vor
		-- dem Aufraeumen unten laufen: sonst waeren die gerade nicht geltenden
		-- Gebaeude schon geloescht statt im Ruhestand (island.retiredBuildings).
		HoneyPondMode.apply(island, FeatureFlags.isOn("HONEY_POND_V2"), os.time())
		local pond = buildings[HoneyPondMode.POND]
		if pond then
			pond.level = EconomyConfig.clampBuildingLevel(pond.level or 1)
			pond.honey = math.clamp(pond.honey or 0, 0, BuildingBehavior.getCapacity("HoneyPond", pond.level))
		end

		-- Alles, was es nicht (mehr) gibt, verschwindet — auch Topf und Presse
		-- nach der Zusammenlegung. Am Feld erkennbar, deshalb wiederholbar.
		for buildingId in buildings do
			if default.island.buildings[buildingId] == nil then
				buildings[buildingId] = nil
			end
		end

		-- Level auf den gueltigen Bereich (1-60) klemmen.
		for _, building in buildings do
			building.level = EconomyConfig.clampBuildingLevel(building.level or 1)
		end
	end

	-- ============================================================
	-- v15: TOWER STATT PIT-LEVEL
	-- ============================================================
	-- 1. Erstattung: die Summe der bezahlten PIT-Ausbaukosten landet in
	--    island.pitRefund. Die Migration fasst KEINE Waehrung an —
	--    TowerService zahlt den Betrag beim Join ueber EconomyService aus.
	-- 2. Rekord: der alte letzte Lauf (pitProgress) wird in die gleich starke
	--    Tower-Stage umgerechnet (TowerConfig.legacyPitToTower) und als
	--    permanenter Rekord eingetragen. Die zugehoerigen Meilensteine vergibt
	--    TowerService beim Join rueckwirkend.
	-- 3. pitLevel, pitProgress und stats.highestPitLevel werden entfernt.
	--
	-- Gilt reachedStage als "geschafft"? reachedStage ist die letzte Stage, in
	-- die der Baerchi eingetreten ist — gewonnen oder verloren. Bewusst
	-- grosszuegig als Rekord gezaehlt: niemand soll durch die Umstellung weniger
	-- haben (ANNAHME, im Bericht).
	data.towers = (data :: any).towers
	if typeof(data.towers) ~= "table" then
		data.towers = {
			records      = {},
			claimed      = {},
			highestTower = TowerConfig.FIRST_TOWER,
			selected     = TowerConfig.FIRST_TOWER,
		}
	end
	local towers = data.towers :: any
	if typeof(towers.records) ~= "table" then towers.records = {} end
	if typeof(towers.claimed) ~= "table" then towers.claimed = {} end

	if (data.version or 0) < 15 then
		local legacyLevel = tonumber(legacyIsland.pitLevel) or 1
		local refund = TowerConfig.legacyPitRefund(legacyLevel)
		legacyIsland.pitRefund = (tonumber(legacyIsland.pitRefund) or 0) + refund

		local legacyProgress = legacyIsland.pitProgress
		if typeof(legacyProgress) == "table" then
			local towerId, stage = TowerConfig.legacyPitToTower(
				tonumber(legacyProgress.pitLevel) or legacyLevel,
				tonumber(legacyProgress.reachedStage) or 0
			)
			if towerId and stage > 0 then
				towers.records[towerId] = math.max(tonumber(towers.records[towerId]) or 0, stage)
			end
		end
	end
	legacyIsland.pitLevel    = nil
	legacyIsland.pitProgress = nil
	stats.highestPitLevel    = nil

	-- Rekorde: nur gueltige Tower, nur Zahlen, nur bis zur Stage-Zahl.
	for towerId, record in towers.records do
		local def = TowerConfig.get(towerId)
		local value = tonumber(record)
		if not def or not value or value <= 0 then
			towers.records[towerId] = nil
		else
			towers.records[towerId] = math.clamp(math.floor(value), 0, def.stages)
		end
	end
	-- Meilensteine: Tabelle je Tower mit TEXT-Schluesseln (siehe Types).
	for towerId, claimed in towers.claimed do
		if not TowerConfig.get(towerId) or typeof(claimed) ~= "table" then
			towers.claimed[towerId] = nil
		else
			local cleaned: { [string]: boolean } = {}
			for stage, flag in claimed do
				if flag == true and tonumber(stage) then
					cleaned[tostring(math.floor(tonumber(stage) :: number))] = true
				end
			end
			towers.claimed[towerId] = cleaned
		end
	end
	-- Hoechster Tower = der hoechste mit Rekord (nie niedriger als gespeichert).
	local highest = if TowerConfig.isValidId(towers.highestTower) then towers.highestTower else TowerConfig.FIRST_TOWER
	for towerId in towers.records do
		if TowerConfig.getIndex(towerId) > TowerConfig.getIndex(highest) then
			highest = towerId
		end
	end
	towers.highestTower = highest

	-- v17 (08.10.): Freischaltung durch Schaffen. Bestandsschutz: was nach der
	-- ALTEN Regel (Deckel pro Rebirth) offen war oder einen Rekord hat, bleibt
	-- offen — niemand verliert Zugang. Nur einmal (Version), danach fuehrt
	-- TowerService die Tabelle. Unbekannte Eintraege fliegen raus.
	if typeof(towers.unlocked) ~= "table" then
		towers.unlocked = {}
	end
	local unlocked = towers.unlocked :: { [string]: boolean }
	for towerId, flag in unlocked do
		if flag ~= true or not TowerConfig.isValidId(towerId) then
			unlocked[towerId] = nil
		end
	end
	unlocked[TowerConfig.FIRST_TOWER] = true
	local rebirths = tonumber((data :: any).rebirthCount) or 0
	for _, def in TowerConfig.TOWERS do
		local wasOpen = (data.version or 0) < 17
			and TowerConfig.getLegacyStageCap(rebirths, def.id, towers.records) > 0
		-- 12.10.: mit TOWER_UNLOCK_PER_LIFE oeffnet nach v17 nur, was in DIESEM
		-- Leben geschafft ist (sonst oeffnete jeder Join die Tower nach einem
		-- Rebirth ueber die Rekorde wieder). Der einmalige Bestandsschutz
		-- v16 -> v17 zaehlt weiter die Rekorde.
		local progress = if (data.version or 0) < 17 then towers.records
			else TowerConfig.unlockRecords(towers, (data :: any).island)
		if wasOpen or TowerConfig.isUnlockedByClear(def.id, progress, nil) then
			unlocked[def.id] = true
		end
	end

	if not TowerConfig.isValidId(towers.selected) then
		towers.selected = TowerConfig.FIRST_TOWER
	end

	-- Fortsetzen pro Tower (ersetzt pitProgress) und Erstattungs-Feld.
	if typeof(legacyIsland.towerProgress) ~= "table" then
		legacyIsland.towerProgress = {}
	else
		for towerId, stage in legacyIsland.towerProgress do
			if not TowerConfig.get(towerId) or typeof(stage) ~= "number" or stage < 1 then
				legacyIsland.towerProgress[towerId] = nil
			end
		end
	end
	if typeof(legacyIsland.pitRefund) ~= "number" or legacyIsland.pitRefund < 0 then
		legacyIsland.pitRefund = 0
	end

	-- v15: Login-Bonus. Feldweise, wiederholbar.
	local daily = (data :: any).daily
	if typeof(daily) ~= "table" then
		(data :: any).daily = { lastClaimDay = 0, streak = 0 }
	else
		if typeof(daily.lastClaimDay) ~= "number" then daily.lastClaimDay = 0 end
		if typeof(daily.streak) ~= "number" then daily.streak = 0 end
	end

	-- v8: die zweite Fortschrittsachse (Promotion, Stat-Level, Charms).
	--
	-- Steht bewusst VOR der currentHp-Migration weiter unten: die rechnet mit
	-- CombatCalculator.getEffectiveStats, und das liest inzwischen genau diese
	-- Felder. Es kaeme auch ohne zurecht (es faengt fehlende Felder mit 0 ab),
	-- aber ein Spielstand soll die Migration nicht in halb fertigem Zustand
	-- durchlaufen — das ist die Art Reihenfolge-Abhaengigkeit, die man erst
	-- Monate spaeter bemerkt.
	--
	-- Erkennt fehlende Felder einzeln statt an der Versionsnummer und ist
	-- deshalb gefahrlos wiederholbar (dieselbe Konvention wie v2/v4/v5).
	for _, baerchi in island.baerchis do
		if baerchi.promotionLevel == nil then
			baerchi.promotionLevel = 0
		end

		if baerchi.statLevels == nil then
			baerchi.statLevels = PromotionConfig.newStatLevels()
		else
			-- Einzelne Stat-Schluessel nachruesten: `egg` kam als letzter dazu,
			-- und ein kuenftiger fuenfter Stat soll hier ebenfalls landen, ohne
			-- dass die ganze Tabelle ersetzt (und damit der Fortschritt
			-- geloescht) wird.
			local levels = baerchi.statLevels :: any
			for _, key in PromotionConfig.ALL_STATS do
				if levels[key] == nil then
					levels[key] = 0
				end
			end
		end

		if baerchi.charms == nil then
			baerchi.charms = {}
		else
			-- Nur gueltige Eintraege behalten. Ein Charm ohne Slot oder mit
			-- einem Stat-Typ, den es nicht mehr gibt (Pool-Aenderung), waere
			-- sonst ein stiller Rechenfehler in getEffectiveStats.
			local cleaned: { Types.Charm } = {}
			for _, charm in baerchi.charms do
				local slotOk = typeof(charm.slot) == "number"
					and charm.slot >= 1
					and charm.slot <= CharmConfig.SLOT_COUNT

				if slotOk and CharmConfig.getStatDef(charm.statId) then
					if charm.locked == nil then
						charm.locked = false
					end
					table.insert(cleaned, charm)
				end
			end
			table.sort(cleaned, function(a, b)
				return a.slot < b.slot
			end)
			baerchi.charms = cleaned
		end

		-- baseStatOverride bleibt absichtlich ungesetzt: nil heisst "Basiswerte
		-- kommen wie immer aus BaerchiConfig", und genau das gilt fuer jeden
		-- Baerchi, der vor dieser Version entstanden ist — auch fuer die
		-- damaligen Fusions-Ergebnisse (die haben ihren Vorteil ueber
		-- fusionBonus, nicht ueber die Basiswerte).

		-- ============================================================
		-- v9: DEF ist weg, PWR ist da, Inverted ist neu
		-- ============================================================
		-- Anders als alles darueber RAEUMT diese Migration etwas WEG. Ein
		-- statLevels.def oder ein baseStatOverride.def aus v8 zeigt auf einen
		-- Stat, den es nicht mehr gibt — stehen bleiben duerfte er trotzdem
		-- nicht: er landete beim naechsten Speichern wieder im DataStore und
		-- waere in einem Jahr ein Feld, das niemand mehr einordnen kann.
		--
		-- Der alte def-WERT wird NICHT in pwr uebertragen. Die beiden haben
		-- nichts miteinander zu tun (Schadensreduktion gegen Ability-Staerke),
		-- und ein Baerchi mit acht DEF-Stufen haette sonst still acht Stufen
		-- eines voellig anderen Stats geschenkt bekommen. pwr faengt bei 0 an.
		local statLevels = baerchi.statLevels :: any
		if statLevels.def ~= nil then
			statLevels.def = nil
		end
		if statLevels.pwr == nil then
			statLevels.pwr = 0
		end

		local override = baerchi.baseStatOverride :: any
		if override ~= nil then
			override.def = nil

			-- Ein Fusions-Ergebnis aus v8 hat einen gemischten Basiswert fuer
			-- hp/atk/spd, aber keinen fuer pwr (den Stat gab es noch nicht).
			-- nil ist hier genau richtig: getEffectiveStats faellt dann auf den
			-- pwr-Wert seines configId zurueck.
		end

		-- ============================================================
		-- v11: MUTATION-SYSTEM ERSETZT INVERTED
		-- ============================================================
		-- Das binaere isInverted-Feld weicht dem gestuften Mutation-System
		-- (siehe BaerchiConfig.MUTATIONS). Alte Spielstaende kannten hoechstens
		-- isInverted = true.
		--
		-- ANNAHME, nicht vom Projektinhaber vorgegeben: ein zuvor invertierter
		-- Baerchi wird auf die Mutation "Diamond" abgebildet (0.3% Wurf-Chance,
		-- damit nahe an der alten INVERTED_CHANCE von 0.5% — eine exakte
		-- Entsprechung gibt es nicht, weil das alte System nur eine einzige
		-- Stufe kannte). Wer eine andere Zuordnung will, ist das hier die
		-- einzige Stelle, die es aendern muss.
		--
		-- Erkennt das alte Feld selbst (ueber `any`, weil Types.Baerchi es seit
		-- v11 nicht mehr kennt) und ist deshalb gefahrlos wiederholbar: beim
		-- ersten Durchlauf wird das alte Feld entfernt, jeder weitere Durchlauf
		-- findet es dann bereits als nil vor und tut nichts mehr.
		local legacy = baerchi :: any
		if legacy.isInverted == true and baerchi.mutation == nil then
			baerchi.mutation = "Diamond"
		end
		legacy.isInverted = nil
	end

	-- v2: fusionBonus auf allen bestehenden Baerchis
	for _, baerchi in island.baerchis do
		if baerchi.fusionBonus == nil then
			baerchi.fusionBonus = 0
		end
		if baerchi.isFusionResult == nil then
			baerchi.isFusionResult = false
		end
	end

	-- v4: currentHp auf allen bestehenden Baerchis.
	-- Sie haben unter dem neuen System noch nicht gekaempft, starten also mit
	-- vollen HP. CombatCalculator wird dafuer bewusst hier requiret: es ist
	-- ein reines Rechenmodul ohne Zustand, und maxHp soll es nur EINE Formel
	-- im ganzen Projekt geben.
	for _, baerchi in island.baerchis do
		if baerchi.currentHp == nil then
			local baerchiDef = BaerchiConfig.getById(baerchi.configId)

			if baerchiDef then
				-- In pcall: getEffectiveStats rechnet mit level und
				-- fusionBonus. Fehlt einem uralten Eintrag eines davon, waere
				-- der Fehler sonst mitten im Join — und ein einziger kaputter
				-- Baerchi wuerde den ganzen Spielstand unbrauchbar machen.
				local ok, maxHp = pcall(function()
					return CombatCalculator.getEffectiveStats(baerchi, baerchiDef.baseStats).maxHp
				end)

				baerchi.currentHp = if ok then maxHp else 0
				if not ok then
					warn("[PlayerService] Kaputter Baerchi-Eintrag migriert:", baerchi.configId, maxHp)
				end
			else
				-- Unbekannter configId (Config-Eintrag entfernt): nicht raten,
				-- lieber erschoepft starten als mit erfundenen Werten.
				baerchi.currentHp = 0
			end
		end
	end

	-- ============================================================
	-- v16: SAMMEL-UPDATE 05.10. (eine gemeinsame Migration)
	-- ============================================================
	-- Nur Anlegen, keine Waehrung. Am Feld erkennbar und damit wiederholbar.
	--   island.stageBest   Rebirth nach Stage (Paket 4.1). Fuer Staende VOR
	--                      v16 aus towerProgress gesaeet (dort steht die
	--                      zuletzt BETRETENE Stage, geschafft ist eine
	--                      weniger) — wer kurz vor dem alten Gummy-Rebirth
	--                      stand, muss nicht bei null anfangen.
	--   island.incubator   Paket 8, Level 1, keine Eier
	--   indexClaimed       Paket 7, leer (rueckwirkend abholbar)
	--   specialClaimed     Paket 6.2, leer (SpecialMilestoneService zahlt
	--                      beim Join rueckwirkend aus)
	if typeof(island.stageBest) ~= "table" then
		local best: { [string]: number } = {}
		if (data.version or 0) < 16 and typeof(island.towerProgress) == "table" then
			for towerId, entered in island.towerProgress :: any do
				local n = (tonumber(entered) or 0) - 1
				if typeof(towerId) == "string" and n > 0 then
					best[towerId] = n
				end
			end
		end
		island.stageBest = best
	end
	local incubator = (island :: any).incubator
	if typeof(incubator) ~= "table" then
		island.incubator = { level = 1, slots = {}, breeders = {} }
	else
		if typeof(incubator.level) ~= "number" or incubator.level < 1 then incubator.level = 1 end
		if typeof(incubator.slots) ~= "table" then incubator.slots = {} end
		-- INCUBATOR_BREED: Liste der bruetenden Baerchis (fehlt in v16-Staenden)
		if typeof(incubator.breeders) ~= "table" then incubator.breeders = {} end
	end
	if typeof((data :: any).indexClaimed) ~= "table" then
		data.indexClaimed = {}
	end
	if typeof((data :: any).specialClaimed) ~= "table" then
		data.specialClaimed = {}
	end

	-- Zum Schluss die Versionsnummer nachziehen. Sie steuert heute keine der
	-- Migrationen oben — die pruefen alle einzeln auf fehlende Felder und
	-- laufen deshalb harmlos bei jedem Laden. Sie ist trotzdem wichtig: sobald
	-- eine kuenftige Migration NICHT mehr am Feld erkennbar ist (weil sie zum
	-- Beispiel Werte umrechnet statt welche anzulegen), ist diese Zahl der
	-- einzige Weg, sie nicht bei jedem Join erneut auszufuehren. Wer
	-- Types.createDefaultPlayerData um ein Feld erweitert, erhoeht sie dort.
	data.version = default.version
	return data
end

return PlayerMigration
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="Folder" referent="RBX25"><Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="Folder" referent="RBX26"><Properties>
<string name="Name">Controllers</string>
</Properties>
<Item class="ModuleScript" referent="RBX27"><Properties>
<string name="Name">CombController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- CombController.luau
-- StarterPlayerScripts/Controllers/CombController.luau
--
-- Einzige Zustaendigkeit:
--   - Alles, was der Spieler von den Honigwaben im Event-Pit und vom
--     Waben-Recycler SIEHT und ausloest:
--       1. Eine kleine Anzeige "Waben 12/25" (nur wenn er welche traegt)
--       2. Meldungen bei Abgabe und Recycler-Ausbau
--       3. Den Ausbau-Prompt am EIGENEN Recycler
--       4. Das Wippen und Drehen der im Pit liegenden Waben
--
-- Die Wahrheit liegt komplett auf dem Server (CombService, CombRecyclerService):
-- was getragen wird, kommt ueber Player-Attribute ("CombsCarried"/"CombsMax"),
-- Level und Warteschlange des Recyclers ueber PlayerDataUpdated. Dieser Controller
-- rechnet nichts und entscheidet nichts.
--
-- Der Prompt entsteht auf dem Client, nur am eigenen Plot — dasselbe Muster wie
-- die Gebaeude-Prompts im WorldController (der Server wendet die Anfrage ohnehin
-- immer auf die Daten des anfragenden Spielers an).

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local MapConfig  = require(ReplicatedStorage.Config.MapConfig)
local Remotes    = require(ReplicatedStorage.Network.Remotes)
local Loc        = require(ReplicatedStorage.Localization.Loc)
local FeedbackConfig = require(ReplicatedStorage.Config.FeedbackConfig)

local Theme       = require(script.Parent.Parent.UI.Theme)
local Toast       = require(script.Parent.Parent.UI.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify      = require(script.Parent.Parent.UI.Notify)
local Feedback    = require(script.Parent.Parent.UI.Feedback)
local ClientState = require(script.Parent.ClientState)

local CombController = {}

local localPlayer = Players.LocalPlayer

local WORLD_FOLDER_NAME = "EventPitCombs"
local OWNER_ATTRIBUTE   = "PlotOwner"
local PROMPT_NAME       = "UpgradeRecycler"
local PROMPT_DISTANCE   = 14
-- 08.10. (Paket G): ein Druck statt Halten; gegen Doppelkauf sperrt sich der
-- Prompt danach kurz (FeedbackConfig.UPGRADE_FX.PROMPT_LOCK).
local PROMPT_HOLD       = 0

-- Wippen und Drehen der Waben im Pit (rein optisch, nur auf diesem Client)
local BOB_HEIGHT = 0.32
local BOB_RATE   = 2.0    -- Schwingungen pro Sekunde (in Radiant: * 1)
local SPIN_RATE  = 0.9    -- Radiant pro Sekunde

--------------------------------------------------------------------------------
-- Anzeige "Waben x/y"
--------------------------------------------------------------------------------

local _pill: Frame? = nil
local _carryLabel: TextLabel? = nil
local _hintLabel: TextLabel? = nil

local function isInPit(): boolean
	local character = localPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not root or not root:IsA("BasePart") then return false end

	local flat = Vector3.new(
		root.Position.X - MapConfig.CENTER.X,
		0,
		root.Position.Z - MapConfig.CENTER.Z
	)
	return flat.Magnitude <= MapConfig.EVENT_PIT_RADIUS
end

local function refreshCarry()
	local pill, carryLabel, hint = _pill, _carryLabel, _hintLabel
	if not pill or not carryLabel or not hint then return end

	local count = localPlayer:GetAttribute("CombsCarried")
	local max   = localPlayer:GetAttribute("CombsMax")
	if typeof(count) ~= "number" or typeof(max) ~= "number" or count <= 0 then
		pill.Visible = false
		return
	end

	pill.Visible = true
	carryLabel.Text = Loc.t("ui.comb.carry", { n = count, max = max })

	if count >= max then
		hint.Text = Loc.t("ui.comb.full")
		hint.TextColor3 = Theme.COLORS.goldGummy
	elseif isInPit() then
		hint.Text = Loc.t("ui.comb.slow")
		hint.TextColor3 = Theme.COLORS.textDim
	else
		hint.Text = ""
	end
end

local function buildPill(screenGui: ScreenGui)
	local pill = Theme.panel("CombPill", screenGui, Theme.COLORS.panel)
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.Position    = UDim2.new(0.5, 0, 0, 12)
	pill.Size        = UDim2.new(0, 250, 0, 54)
	pill.Visible     = false

	local carry = Theme.label("Carry", pill, "")
	carry.Position       = UDim2.new(0, 10, 0, 4)
	carry.Size           = UDim2.new(1, -20, 0, 26)
	carry.TextXAlignment = Enum.TextXAlignment.Center
	carry.TextColor3     = Theme.COLORS.goldGummy

	local hint = Theme.bodyText("Hint", pill, "")
	hint.Position       = UDim2.new(0, 10, 0, 30)
	hint.Size           = UDim2.new(1, -20, 0, 20)
	hint.TextXAlignment = Enum.TextXAlignment.Center

	_pill        = pill
	_carryLabel  = carry
	_hintLabel   = hint
end

--------------------------------------------------------------------------------
-- Recycler-Prompt (nur am eigenen Plot)
--------------------------------------------------------------------------------

local function findPlotOwner(instance: Instance): number?
	local current: Instance? = instance
	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner
		end
		current = current.Parent
	end
	return nil
end

local function costText(level: number): string
	local cost = CombConfig.getUpgradeCost(level + 1)
	if not cost then
		return Loc.t("ui.recycler.maxed")
	end

	local text = if cost.goldGummies > 0
		then Loc.t("ui.recycler.cost_gg", { gummies = Theme.formatNumber(cost.gummies), gold = cost.goldGummies })
		else Loc.t("ui.recycler.cost_g", { gummies = Theme.formatNumber(cost.gummies) })

	return Loc.t("ui.recycler.upgrade", { cost = text })
end

local _locked: { [ProximityPrompt]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function writePrompt(prompt: ProximityPrompt)
	local data = ClientState.get()
	local level = if data then data.island.recycler.level else 1

	-- 12.10.: der Recycler zeigt seinen Geld-Multiplikator, im Prompt auch
	-- den naechsten ("Recycler  ×12 ➡ ×17")
	if CombConfig.INSTANT_PAYOUT then
		local nextText = if level < CombConfig.RECYCLER_MAX_LEVEL
			then "  ➡ " .. CombConfig.formatMultiplier(level + 1) else ""
		prompt.ObjectText = string.format("%s  %s%s", Loc.t("ui.recycler.name"), CombConfig.formatMultiplier(level), nextText)
	else
		prompt.ObjectText = string.format("%s  Lv.%d", Loc.t("ui.recycler.name"), level)
	end

	if level >= CombConfig.RECYCLER_MAX_LEVEL then
		prompt.ActionText = Loc.t("ui.recycler.maxed")
		prompt.Enabled    = false
	else
		-- Reicht es nicht, steht im Prompt, wie viel fehlt (ausgrauen kann der
		-- Standard-Prompt nicht); der Server lehnt einen Druck dann ab.
		local cost = CombConfig.getUpgradeCost(level + 1)
		local missing = if cost and data then cost.gummies - data.gummies else 0
		prompt.ActionText = if missing > 0
			then Loc.t("ui.upgrade.prompt_need", { missing = Theme.formatNumber(missing) })
			else costText(level)
		prompt.Enabled    = not _locked[prompt]
	end
end

local _prompts: { ProximityPrompt } = {}

local function attachPrompt(body: BasePart)
	if body:FindFirstChild(PROMPT_NAME) then return end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = PROMPT_NAME
	prompt.KeyboardKeyCode       = Enum.KeyCode.E
	prompt.HoldDuration          = PROMPT_HOLD
	prompt.MaxActivationDistance = PROMPT_DISTANCE
	prompt.RequiresLineOfSight   = false
	prompt.Parent                = body

	prompt.Triggered:Connect(function()
		if _locked[prompt] then return end
		_locked[prompt] = true
		prompt.Enabled = false
		Remotes.RequestUpgradeRecycler:FireServer()
		task.delay(FeedbackConfig.UPGRADE_FX.PROMPT_LOCK, function()
			_locked[prompt] = nil
			if prompt.Parent then writePrompt(prompt) end
		end)
	end)

	table.insert(_prompts, prompt)
	prompt.Destroying:Connect(function()
		local index = table.find(_prompts, prompt)
		if index then table.remove(_prompts, index) end
	end)

	writePrompt(prompt)
end

local function hookWorldPart(instance: Instance)
	if not instance:IsA("BasePart") then return end
	if instance.Name ~= CombConfig.RECYCLER_NAME then return end

	local function tryAttach()
		if findPlotOwner(instance) == localPlayer.UserId then
			attachPrompt(instance)
			return true
		end
		return false
	end

	if tryAttach() then return end

	-- Replikation ist nicht sortiert: das Plot-Model kann beim Client ankommen,
	-- bevor sein Besitzer-Attribut da ist. Einmal im naechsten Frame nachsehen.
	task.defer(function()
		if instance.Parent then
			tryAttach()
		end
	end)
end

--------------------------------------------------------------------------------
-- Waben im Pit: Wippen und Drehen
--------------------------------------------------------------------------------

-- `fly` = Einflug (Vulkan-Ausbruch, Waben-Regen): von `from` zur Ruhelage
-- zwischen den Serverzeiten `start` und `finish` (Attribute FlyFrom/FlyStart/FlyEnd).
type Fly = { from: Vector3, start: number, finish: number }
type Bob = { base: CFrame?, phase: number, spawnTime: number, fly: Fly? }

local _bobbing: { [Model]: Bob } = {}

-- Wie oft trackComb auf fehlende Attribute wartet (je ein Frame), bevor die
-- Wabe aufgegeben wird. Attribute kommen mit dem Model selbst an; das ist nur
-- ein Sicherheitsnetz.
local BASE_RETRY_FRAMES = 6

-- Auftauch-Effekt frisch gespawnter Waben: steigt aus dem Boden und federt nach.
local POP_SECONDS = 0.45
local POP_DEPTH   = 1.6

-- Baut die Ruhelage aus den Attributen "Pos"/"Yaw" (CombBuilder.buildWorldComb).
-- NIE aus GetPivot(): siehe Kopf von buildWorldComb.
local function readBase(model: Model): CFrame?
	local pos = model:GetAttribute("Pos")
	local yaw = model:GetAttribute("Yaw")
	if typeof(pos) ~= "Vector3" or typeof(yaw) ~= "number" then
		return nil
	end
	return CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
end

local function trackComb(child: Instance)
	if not child:IsA("Model") then return end
	local model = child :: Model

	local phase = model:GetAttribute("Phase")
	local spawnTime = model:GetAttribute("SpawnTime")
	local flyFrom   = model:GetAttribute("FlyFrom")
	local flyStart  = model:GetAttribute("FlyStart")
	local flyEnd    = model:GetAttribute("FlyEnd")
	local fly: Fly? = nil
	if typeof(flyFrom) == "Vector3" and typeof(flyStart) == "number" and typeof(flyEnd) == "number" then
		fly = { from = flyFrom, start = flyStart, finish = flyEnd }
	end
	local bob: Bob = {
		base      = readBase(model),
		phase     = if typeof(phase) == "number" then phase else 0,
		-- Fliegende Waben tauchen nicht zusaetzlich aus dem Boden auf.
		spawnTime = if fly then 0 elseif typeof(spawnTime) == "number" then spawnTime else 0,
		fly       = fly,
	}
	_bobbing[model] = bob

	if bob.base then return end

	-- Sicherheitsnetz: Attribute fehlen noch. Ein paar Frames nachsehen, bis
	-- dahin ueberspringt animateCombs diese Wabe (kein PivotTo mit Identitaet).
	task.spawn(function()
		for _ = 1, BASE_RETRY_FRAMES do
			task.wait()
			if _bobbing[model] ~= bob then return end
			local base = readBase(model)
			if base then
				bob.base = base
				return
			end
		end
	end)
end

local function hookWorldFolder(folder: Instance)
	for _, child in folder:GetChildren() do
		trackComb(child)
	end
	folder.ChildAdded:Connect(trackComb)
	folder.ChildRemoved:Connect(function(child)
		if child:IsA("Model") then
			_bobbing[child] = nil
		end
	end)
end

-- Versatz nach unten waehrend des Auftauchens (0 = fertig). Ueberschwingt kurz.
local function popOffset(now: number, spawnTime: number): number
	local age = now - spawnTime
	if spawnTime <= 0 or age >= POP_SECONDS or age < 0 then return 0 end
	local k = age / POP_SECONDS
	-- 1 → 0 mit kleinem Ueberschwinger (Back-Ease-Out)
	local c = 1.7
	local eased = 1 + (c + 1) * (k - 1) ^ 3 + c * (k - 1) ^ 2
	return -POP_DEPTH * (1 - eased)
end

-- Einflug: Bogen von `from` zur Ruhelage, Hoehe CombConfig.FLIGHT_ARC_HEIGHT.
-- nil = Flug ist vorbei (oder hat noch nicht begonnen und die Wabe wartet oben).
local function flyPosition(fly: Fly, landing: Vector3, now: number): Vector3?
	if now >= fly.finish then return nil end
	local span = math.max(0.05, fly.finish - fly.start)
	local k = math.clamp((now - fly.start) / span, 0, 1)
	local arc = 4 * k * (1 - k) * CombConfig.FLIGHT_ARC_HEIGHT
	return fly.from:Lerp(landing, k) + Vector3.new(0, arc, 0)
end

local function animateCombs()
	local t = os.clock()
	local serverNow = Workspace:GetServerTimeNow()
	for model, bob in _bobbing do
		local base = bob.base
		local fly = bob.fly
		if base and fly and model.Parent then
			local pos = flyPosition(fly, base.Position, serverNow)
			if pos then
				model:PivotTo(CFrame.new(pos) * CFrame.Angles(t * 6, t * SPIN_RATE * 3, 0))
				continue
			end
			bob.fly = nil
		end
		if base and model.Parent then
			local lift = math.sin(t * BOB_RATE + bob.phase) * BOB_HEIGHT + popOffset(serverNow, bob.spawnTime)
			model:PivotTo(base * CFrame.new(0, lift, 0) * CFrame.Angles(0, t * SPIN_RATE + bob.phase, 0))
		end
	end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function CombController.init(screenGui: ScreenGui)
	buildPill(screenGui)

	for _, name in { "CombsCarried", "CombsMax" } do
		localPlayer:GetAttributeChangedSignal(name):Connect(refreshCarry)
	end
	refreshCarry()

	-- "Im Pit" aendert sich ohne Attribut-Aenderung, deshalb ein gemuetlicher
	-- Takt fuer den Hinweistext.
	task.spawn(function()
		while true do
			task.wait(0.4)
			refreshCarry()
		end
	end)

	Remotes.CombDelivered.OnClientEvent:Connect(function(count: any, _units: any)
		if typeof(count) ~= "number" then return end
		Notify.emit("comb_delivered", function()
			Toast.success(Loc.tn("msg.comb_delivered", count))
		end, function()
			Feedback.gain("comb", count)
		end)
	end)

	Remotes.RecyclerUpgraded.OnClientEvent:Connect(function(level: any)
		if typeof(level) ~= "number" then return end
		Notify.emit("recycler_upgraded", function()
			Toast.success(Loc.t("msg.recycler_upgraded", { level = level }))
		end, function()
			-- Paket G: den Moment zeigt UI/UpgradeFX am Recycler selbst
			-- (aus dem Datenstand) — hier kein zweites "⬆" ueber dem Spieler.
		end)
	end)

	-- Prompt-Text nachziehen, wenn sich Level/Gummies aendern oder die Sprache
	ClientState.onChanged(function()
		for _, prompt in _prompts do
			writePrompt(prompt)
		end
	end)
	Loc.onChanged(function()
		for _, prompt in _prompts do
			writePrompt(prompt)
		end
		refreshCarry()
	end)

	for _, descendant in Workspace:GetDescendants() do
		hookWorldPart(descendant)
	end
	Workspace.DescendantAdded:Connect(hookWorldPart)

	local existing = Workspace:FindFirstChild(WORLD_FOLDER_NAME)
	if existing then
		hookWorldFolder(existing)
	end
	Workspace.ChildAdded:Connect(function(child)
		if child.Name == WORLD_FOLDER_NAME then
			hookWorldFolder(child)
		end
	end)

	RunService.RenderStepped:Connect(animateCombs)

	print("[CombController] Initialisiert")
end

return CombController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX28"><Properties>
<string name="Name">HubLandmarkController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- HubLandmarkController.luau
-- StarterPlayerScripts/Controllers/HubLandmarkController.luau
--
-- Einzige Zustaendigkeit:
--   - Die festen Wahrzeichen der Hauptinsel aufwerten (Paket C, "Welt
--     aufwerten"): Wabenkrone und Honigfaden am Honigmast, Wegweiser an den
--     Wegen, Laterne und Eierkorb am Haendler, Holzrahmen mit Krone an den
--     Tafeln und der Glanz auf Platz 1
--
-- Was auf Events reagiert (Pit-Rahmen, Wespen-Nest), steht in
-- HubEventController; die Ankunft in ArrivalController.
--
-- Alles nur auf dem Client (WorldFX_Local): kein Server-Teil, keine
-- Replikation, die Wegweiser in der Sprache des Betrachters. Positionen aus
-- MapLayout/MapConfig (Test: map_layout.test.lua), Zahlen aus WorldFXConfig.
--
-- PERFORMANCE: EIN Takt (20x pro Sekunde) fuer Tropfen und Glanz, nur wenn
-- die jeweilige Gruppe in Sichtweite ist (WorldFXKit.cullGroup). Wegweiser,
-- Haendler-Deko und Rahmen stehen still und kosten ausser Sichtweite nichts.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)
local Loc           = require(ReplicatedStorage.Localization.Loc)

local WorldFXKit         = require(script.Parent.WorldFXKit)
local DayCycleController = require(script.Parent.DayCycleController)

local HubLandmarkController = {}

local localPlayer = Players.LocalPlayer
local UPRIGHT = WorldFXKit.UPRIGHT
local TICK = 0.05

-- Mast-Fuss: Oberkante des Event-Pit-Podests (wie WorldBuilder.buildPlatform)
local MAST_FOOT = Vector3.new(
	MapConfig.CENTER.X,
	MapConfig.PLATFORM_TOP_Y + MapConfig.EVENT_PIT_GROUND_CLEARANCE + MapConfig.EVENT_PIT_FLOOR_HEIGHT,
	MapConfig.CENTER.Z
)

type Drip = { group: Instance, drop: BasePart, ring: BasePart, spout: Vector3, surfaceY: number, cycleStart: number }
local _drip: Drip? = nil

type Shine = { gradient: UIGradient, group: Instance }
local _shines: { Shine } = {}

type SignLabel = { label: TextLabel, slot: number }
local _islandLabels: { SignLabel } = {}

--------------------------------------------------------------------------------
-- Honigmast: Wabenkrone
--------------------------------------------------------------------------------

-- Ein Teil, dessen +X nach `outward` zeigt (Zylinder-Stirnseite nach aussen).
local function facing(position: Vector3, outward: Vector3): CFrame
	return CFrame.fromMatrix(position, outward, Vector3.yAxis)
end

local _crownCells: { BasePart } = {}

local function buildCrown(folder: Instance)
	local cfg = WorldFXConfig.MAST
	local model = Instance.new("Model")
	model.Name = "MastCrown"
	local combId = WorldFXKit.textureId("amber_comb")

	for row = 0, 1 do
		local y = MAST_FOOT.Y + cfg.CROWN_HEIGHT + (row - 0.5) * cfg.CROWN_ROW_GAP
		for i = 0, cfg.CROWN_CELLS - 1 do
			-- zweite Reihe um eine halbe Zelle versetzt: wie echte Waben
			local angle = (i + row * 0.5) / cfg.CROWN_CELLS * math.pi * 2
			local outward = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local p = Vector3.new(MAST_FOOT.X, y, MAST_FOOT.Z) + outward * cfg.CROWN_RADIUS
			local cell = WorldFXKit.part("Comb", model, Vector3.new(cfg.CELL_DEPTH, cfg.CELL_SIZE, cfg.CELL_SIZE),
				facing(p, outward), cfg.CELL_DAY, Enum.Material.Neon, Enum.PartType.Cylinder)
			if combId then
				local decal = Instance.new("Decal")
				decal.Texture = combId
				decal.Face = Enum.NormalId.Right
				decal.Parent = cell
			end
			DayCycleController.registerGlow(cell, cfg.CELL_DAY, cfg.CELL_NIGHT)
			table.insert(_crownCells, cell)
		end
	end
	model.Parent = folder
end

--------------------------------------------------------------------------------
-- Honigmast: Faden, Tuelle, Schale, Tropfen
--------------------------------------------------------------------------------

local function buildHoneyThread(folder: Instance)
	local cfg = WorldFXConfig.MAST
	local group = WorldFXKit.folder("HoneyThread", folder)
	local angle = math.rad(cfg.THREAD_ANGLE)
	local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))

	-- Faden am Mast herab
	local length = cfg.THREAD_TOP - cfg.THREAD_BOTTOM
	local threadBase = MAST_FOOT + dir * cfg.THREAD_RADIUS + Vector3.new(0, cfg.THREAD_BOTTOM, 0)
	local thread = WorldFXKit.pole("Thread", group, threadBase, length, cfg.THREAD_WIDTH, cfg.HONEY_COLOR, Enum.Material.Glass)
	thread.Transparency = 0.15

	-- Tuelle: waagerecht vom Mast bis ueber die Schale
	local reach = cfg.SPOUT_REACH - cfg.THREAD_RADIUS
	local spoutMid = MAST_FOOT + dir * (cfg.THREAD_RADIUS + reach * 0.5) + Vector3.new(0, cfg.THREAD_BOTTOM, 0)
	WorldFXKit.part("Spout", group, Vector3.new(reach, 0.45, 0.45), facing(spoutMid, dir),
		cfg.BOWL_COLOR, Enum.Material.Wood, Enum.PartType.Cylinder)

	-- Schale auf dem Podest, darin die Honig-Oberflaeche
	local bowlCenter = MAST_FOOT + dir * cfg.SPOUT_REACH
	WorldFXKit.part("Bowl", group, Vector3.new(cfg.BOWL_HEIGHT, cfg.BOWL_RADIUS * 2, cfg.BOWL_RADIUS * 2),
		CFrame.new(bowlCenter + Vector3.new(0, cfg.BOWL_HEIGHT * 0.5, 0)) * UPRIGHT,
		cfg.BOWL_COLOR, Enum.Material.Wood, Enum.PartType.Cylinder)
	local surfaceY = bowlCenter.Y + cfg.BOWL_HEIGHT + 0.02
	local honey = WorldFXKit.part("Honey", group, Vector3.new(0.08, cfg.BOWL_RADIUS * 1.7, cfg.BOWL_RADIUS * 1.7),
		CFrame.new(bowlCenter.X, surfaceY, bowlCenter.Z) * UPRIGHT, cfg.HONEY_COLOR, Enum.Material.Glass, Enum.PartType.Cylinder)
	honey.Reflectance = 0.2

	local drop = WorldFXKit.ball("Drop", nil, cfg.DROP_SIZE, bowlCenter, cfg.HONEY_COLOR, Enum.Material.Glass)
	local ring = WorldFXKit.part("Ring", nil, Vector3.new(0.04, 0.3, 0.3), CFrame.new(), Color3.fromRGB(255, 226, 150),
		Enum.Material.Neon, Enum.PartType.Cylinder)

	_drip = {
		group = group,
		drop = drop,
		ring = ring,
		spout = MAST_FOOT + dir * cfg.SPOUT_REACH + Vector3.new(0, cfg.THREAD_BOTTOM - 0.3, 0),
		surfaceY = surfaceY,
		cycleStart = os.clock(),
	}
	WorldFXKit.cullGroup(group, MAST_FOOT, cfg.SHOW_DISTANCE)
end

-- Ein Tropfen-Zyklus: an der Tuelle wachsen, fallen, Ring in der Schale.
local function stepDrip(now: number)
	local drip = _drip
	if not drip or not drip.group.Parent then return end
	local cfg = WorldFXConfig.MAST
	local t = (now - drip.cycleStart) % cfg.DROP_INTERVAL
	local fallHeight = drip.spout.Y - drip.surfaceY
	local fallTime = math.sqrt(2 * fallHeight / workspace.Gravity)

	if t < cfg.DROP_GROW then
		local k = t / cfg.DROP_GROW
		drip.drop.Size = Vector3.one * (cfg.DROP_SIZE * (0.3 + 0.7 * k))
		drip.drop.Position = drip.spout
		drip.drop.Parent = drip.group
	elseif t < cfg.DROP_GROW + fallTime then
		local f = t - cfg.DROP_GROW
		drip.drop.Position = drip.spout - Vector3.new(0, 0.5 * workspace.Gravity * f * f, 0)
	else
		drip.drop.Parent = nil
		local k = (t - cfg.DROP_GROW - fallTime) / cfg.RING_TIME
		if k < 1 then
			local size = 0.3 + cfg.BOWL_RADIUS * 1.4 * k
			drip.ring.Size = Vector3.new(0.04, size, size)
			drip.ring.CFrame = CFrame.new(drip.spout.X, drip.surfaceY + 0.05, drip.spout.Z) * UPRIGHT
			drip.ring.Transparency = 0.3 + 0.7 * k
			drip.ring.Parent = drip.group
		else
			drip.ring.Parent = nil
		end
	end
end

--------------------------------------------------------------------------------
-- Wegweiser
--------------------------------------------------------------------------------

-- Ein Schild in Baerchi-Form, das in Richtung `dir` zeigt. Text vorn und
-- hinten, je mit dem Pfeil auf der richtigen Seite (wer auf die Vorderseite
-- schaut, hat +X links).
local function buildBoard(parent: Instance, center: Vector3, dir: Vector3, color: Color3): (TextLabel, TextLabel)
	local cfg = WorldFXConfig.SIGNPOST
	local frame = CFrame.fromMatrix(center, dir, Vector3.yAxis)
	local board = WorldFXKit.part("Board", parent, cfg.BOARD_SIZE, frame, color, Enum.Material.Wood)
	local signId = WorldFXKit.textureId("bear_sign")
	if signId then
		-- Form aus dem Bild: Teil unsichtbar, Bild vorn und hinten
		board.Transparency = 1
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local decal = Instance.new("Decal")
			decal.Texture = signId
			decal.Face = face
			decal.Color3 = color
			decal.Parent = board
		end
	else
		-- Ohren oben
		for _, side in { -1, 1 } do
			WorldFXKit.part("Ear", parent, Vector3.new(0.3, 0.75, 0.75),
				frame * CFrame.new(side * cfg.BOARD_SIZE.X * 0.3, cfg.BOARD_SIZE.Y * 0.5, 0) * CFrame.Angles(0, math.rad(90), 0),
				color, Enum.Material.Wood, Enum.PartType.Cylinder)
		end
	end

	local labels = {}
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0   -- 12.10.: Schrift bleibt auch nachts hell
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(0.9, 0.8)
		label.Position = UDim2.fromScale(0.05, 0.1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = cfg.TEXT_COLOR
		label.TextStrokeColor3 = cfg.TEXT_STROKE
		label.TextStrokeTransparency = 0
		label.Parent = gui
		table.insert(labels, label)
	end
	return labels[1], labels[2]
end

-- Pfeil links (Vorderseite) bzw. rechts (Rueckseite) an den Text haengen.
local function arrowText(front: TextLabel, back: TextLabel, text: string)
	front.Text = "◀ " .. text
	back.Text  = text .. " ▶"
end

local function bindArrow(front: TextLabel, back: TextLabel, key: string, args: { [string]: any }?)
	local function refresh()
		arrowText(front, back, Loc.t(key, args))
	end
	refresh()
	Loc.onChanged(refresh)
end

-- Beschriftung "Insel von X" / "Deine Insel" / "Freie Insel" fuer Slot `slot`.
local function islandText(slot: number): (string, boolean)
	local plot = workspace:FindFirstChild("Plot_" .. slot)
	local ownerId = if plot then plot:GetAttribute("PlotOwner") else nil
	if typeof(ownerId) ~= "number" then
		return Loc.t("world.sign.free"), false
	end
	if ownerId == localPlayer.UserId then
		return Loc.t("world.sign.home"), true
	end
	local owner = Players:GetPlayerByUserId(ownerId)
	return Loc.t("world.sign.island", { name = if owner then owner.DisplayName else "?" }), false
end

local function refreshIslandLabels()
	local cfg = WorldFXConfig.SIGNPOST
	for _, entry in _islandLabels do
		local text, home = islandText(entry.slot)
		local gui = entry.label.Parent
		local board = gui and gui.Parent
		if board and board:IsA("BasePart") then
			board.Color = if home then cfg.HOME_COLOR else cfg.WOOD
			for _, decal in board:GetChildren() do
				if decal:IsA("Decal") then decal.Color3 = board.Color end
			end
		end
		if entry.label.Name == "Front" then
			entry.label.Text = "◀ " .. text
		else
			entry.label.Text = text .. " ▶"
		end
	end
end

local function buildSignposts(folder: Instance)
	local cfg = WorldFXConfig.SIGNPOST
	for _, spot in MapLayout.signposts(cfg.RADIUS, cfg.SIDE) do
		local group = WorldFXKit.folder("Signpost_" .. spot.slot, folder)
		local base = spot.position
		WorldFXKit.pole("Post", group, base, cfg.POST_HEIGHT, cfg.POST_DIAMETER, cfg.WOOD_DARK, Enum.Material.Wood)

		-- Mitte eines Schilds, das in `dir` zeigt: inneres Ende aussen am
		-- Pfahl, das Brett ragt in Zeigerichtung vom Pfahl weg.
		local reach = cfg.POST_DIAMETER * 0.5 + cfg.BOARD_POST_GAP + cfg.BOARD_SIZE.X * 0.5
		local function at(level: number, dir: Vector3): Vector3
			return base + dir * reach + Vector3.new(0, cfg.POST_HEIGHT - 0.9 - level * cfg.BOARD_GAP, 0)
		end

		-- 1: zur eigenen bzw. dieser Plot-Insel (nach aussen)
		local f1, b1 = buildBoard(group, at(0, spot.outward), spot.outward, cfg.WOOD)
		f1.Name, b1.Name = "Front", "Back"
		table.insert(_islandLabels, { label = f1, slot = spot.slot })
		table.insert(_islandLabels, { label = b1, slot = spot.slot })

		-- 2: zum Event (zur Mitte)
		local f2, b2 = buildBoard(group, at(1, -spot.outward), -spot.outward, cfg.WOOD)
		bindArrow(f2, b2, "world.sign.event")

		-- 3: Haendler oder Bestenliste, was naeher ist
		local f3, b3 = buildBoard(group, at(2, spot.sideDir), spot.sideDir, cfg.WOOD)
		bindArrow(f3, b3, spot.sideKey)

		WorldFXKit.cullGroup(group, base, cfg.SHOW_DISTANCE)
	end

	refreshIslandLabels()
	Loc.onChanged(refreshIslandLabels)
	-- Plots kommen und gehen mit den Spielern
	local function onWorldChild(child: Instance)
		if string.match(child.Name, "^Plot_%d+$") then
			task.defer(refreshIslandLabels)
		end
	end
	workspace.ChildAdded:Connect(onWorldChild)
	workspace.ChildRemoved:Connect(onWorldChild)
	Players.PlayerAdded:Connect(function() task.delay(1, refreshIslandLabels) end)
end

--------------------------------------------------------------------------------
-- Haendler: Laterne und Eierkorb
--------------------------------------------------------------------------------

local function buildStallDecor(folder: Instance)
	local stand = workspace:WaitForChild("EggMerchant", 60)
	if not (stand and stand:IsA("Model")) then return end
	local counter = stand.PrimaryPart or stand:FindFirstChild("Counter")
	if not (counter and counter:IsA("BasePart")) then return end
	local cfg = WorldFXConfig.STALL

	-- Boden-CFrame des Stands (Theke steht 1,3 ueber dem Boden, siehe EggMerchantService)
	local base = counter.CFrame * CFrame.new(0, -1.3, 0)
	local group = WorldFXKit.folder("StallDecor", folder)

	-- Laterne links neben dem Stand
	local lampFoot = (base * CFrame.new(-4.2, 0, 0.6)).Position
	WorldFXKit.pole("LampPost", group, lampFoot, 4.2, 0.35, WorldFXConfig.SIGNPOST.WOOD_DARK, Enum.Material.Wood)
	local glow = WorldFXKit.ball("LampGlow", group, 1.1, lampFoot + Vector3.new(0, 4.7, 0), cfg.LANTERN_COLOR, Enum.Material.Neon)
	DayCycleController.registerGlow(glow, WorldFXConfig.LAMP_DAY, WorldFXConfig.LAMP_NIGHT)

	-- Korb rechts davor, mit drei Eiern
	local basketCF = base * CFrame.new(4.0, 0.45, -0.8)
	WorldFXKit.part("Basket", group, Vector3.new(0.9, 2.2, 2.2), basketCF * UPRIGHT, cfg.BASKET_COLOR, Enum.Material.WoodPlanks, Enum.PartType.Cylinder)
	for i, color in cfg.EGG_COLORS do
		local a = (i - 1) / #cfg.EGG_COLORS * math.pi * 2
		WorldFXKit.ellipsoid("Egg", group, Vector3.new(0.8, 1.05, 0.8),
			basketCF * CFrame.new(math.cos(a) * 0.45, 0.75, math.sin(a) * 0.45) * CFrame.Angles(math.rad(10) * math.cos(a), 0, math.rad(10) * math.sin(a)),
			color, Enum.Material.SmoothPlastic)
	end

	WorldFXKit.cullGroup(group, base.Position, cfg.SHOW_DISTANCE)
end

--------------------------------------------------------------------------------
-- Tafeln: Rahmen, Krone, Glanz auf Platz 1
--------------------------------------------------------------------------------

local function isBoard(part: Instance): boolean
	return part:IsA("BasePart") and (string.sub(part.Name, 1, 16) == "LeaderboardBoard" or part.Name == "LiveBoard")
		and part:FindFirstChild("Board") ~= nil
end

local _framed: { [Instance]: boolean } = {}

local function frameBoard(board: BasePart, folder: Instance)
	if _framed[board] then return end
	_framed[board] = true
	local cfg = WorldFXConfig.BOARD_FRAME
	local group = WorldFXKit.folder("Frame_" .. board.Name, folder)
	local cf, size = board.CFrame, board.Size
	local depth = size.Z + 0.25
	local hw, hh = size.X * 0.5, size.Y * 0.5

	-- vier Balken
	for _, sy in { -1, 1 } do
		WorldFXKit.part("Beam", group, Vector3.new(size.X + cfg.BEAM * 2, cfg.BEAM, depth),
			cf * CFrame.new(0, sy * (hh + cfg.BEAM * 0.5), 0), cfg.WOOD, Enum.Material.Wood)
	end
	for _, sx in { -1, 1 } do
		WorldFXKit.part("Beam", group, Vector3.new(cfg.BEAM, size.Y, depth),
			cf * CFrame.new(sx * (hw + cfg.BEAM * 0.5), 0, 0), cfg.WOOD, Enum.Material.Wood)
	end
	-- Honig-Ecken
	for _, sx in { -1, 1 } do
		for _, sy in { -1, 1 } do
			WorldFXKit.ball("Corner", group, cfg.CORNER_SIZE,
				(cf * CFrame.new(sx * (hw + cfg.BEAM * 0.5), sy * (hh + cfg.BEAM * 0.5), 0)).Position,
				cfg.CORNER_COLOR, Enum.Material.Glass)
		end
	end
	-- Krone oben: Reif und drei Zacken
	local top = cf * CFrame.new(0, hh + cfg.BEAM + 0.45, 0)
	WorldFXKit.part("CrownBand", group, Vector3.new(0.6, 2.4, 2.4), top * UPRIGHT, cfg.CROWN_COLOR, Enum.Material.Neon, Enum.PartType.Cylinder)
	for i = -1, 1 do
		WorldFXKit.ball("CrownTip", group, 0.6, (top * CFrame.new(i * 0.85, 0.65 - math.abs(i) * 0.15, 0)).Position,
			cfg.CROWN_COLOR, Enum.Material.Neon)
	end

	-- Glanz auf Platz 1 (nur Bestenlisten, nicht das Live-Board)
	if board.Name ~= "LiveBoard" and WorldFXKit.enabled("boardShine") then
		local gui = board:FindFirstChild("Board")
		local line = gui and gui:FindFirstChild("Line1")
		if line and line:IsA("GuiObject") then
			local shine = Instance.new("Frame")
			shine.Name = "Shine"
			shine.BackgroundColor3 = Color3.new(1, 1, 1)
			shine.BorderSizePixel = 0
			shine.Position = line.Position
			shine.Size = line.Size
			shine.ZIndex = line.ZIndex + 1
			shine.Parent = gui
			local gradient = Instance.new("UIGradient")
			gradient.Rotation = 20
			gradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.42, 1),
				NumberSequenceKeypoint.new(0.5, 0.55), NumberSequenceKeypoint.new(0.58, 1),
				NumberSequenceKeypoint.new(1, 1),
			})
			gradient.Parent = shine
			table.insert(_shines, { gradient = gradient, group = group })
		end
	end

	WorldFXKit.cullGroup(group, cf.Position, cfg.SHOW_DISTANCE)
end

local function buildBoardFrames(folder: Instance)
	local platform = workspace:WaitForChild("Platform", 60)
	if not platform then return end
	for _, child in platform:GetChildren() do
		if isBoard(child) then
			frameBoard(child :: BasePart, folder)
		end
	end
	platform.ChildAdded:Connect(function(child)
		task.defer(function()
			if isBoard(child) then frameBoard(child :: BasePart, folder) end
		end)
	end)
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

-- Paket G (Event startet): die Wabenkrone blinkt zweimal auf (2 Hz, unter
-- der 3-Hz-Grenze), danach gilt wieder der Tageslauf.
function HubLandmarkController.flashCrown()
	if #_crownCells == 0 then return end
	task.spawn(function()
		for _ = 1, 2 do
			for _, cell in _crownCells do cell.Color = Color3.fromRGB(255, 244, 200) end
			task.wait(0.25)
			DayCycleController.refreshGlow()
			task.wait(0.25)
		end
	end)
end

function HubLandmarkController.init()
	if not FeatureFlags.isOn("WORLD_C_HUB") then return end
	local folder = WorldFXKit.folder("Hub", WorldFXKit.root())

	if WorldFXKit.enabled("mastCrown") then
		buildCrown(folder)
	end
	if WorldFXKit.enabled("honeyThread") then
		buildHoneyThread(folder)
	end
	if WorldFXKit.enabled("signposts") then
		buildSignposts(folder)
	end
	if WorldFXKit.enabled("stallDecor") then
		task.spawn(buildStallDecor, folder)
	end
	if WorldFXKit.enabled("boardFrames") then
		task.spawn(buildBoardFrames, folder)
	end

	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < TICK then return end
		acc = 0
		local now = os.clock()
		stepDrip(now)
		-- Glanzstreifen wandert ueber Platz 1 (nur sichtbare Tafeln)
		local offset = ((now / WorldFXConfig.BOARD_FRAME.SHINE_PERIOD) % 1) * 2 - 1
		for _, shine in _shines do
			if shine.group.Parent then
				shine.gradient.Offset = Vector2.new(offset, 0)
			end
		end
	end)

	print("[Hub] Wahrzeichen aktiv")
end

return HubLandmarkController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX29"><Properties>
<string name="Name">TowerFlightController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- TowerFlightController.luau
-- StarterPlayerScripts/Controllers/TowerFlightController.luau
--
-- Einzige Zustaendigkeit:
--   - 12.10. (Playtest "man kann den Turm nicht hochfliegen"): ein Flugfeld
--     am Rand der EIGENEN Arena. Steht der Kampf-Turm (Server-Attribut
--     PitPlatform.TowerTopY / TowerLevel, geschrieben von
--     MapService.setPitTowerLevel), fliegt der eigene Charakter beim
--     Betreten im Bogen auf die Turm-Spitze und sieht dem Kampf von oben zu.
--
-- Warum auf dem Client: die Spielfigur gehoert physikalisch dem Client
-- (Network Ownership). Eine Geschwindigkeit vom Server wuerde sofort vom
-- Client ueberschrieben. Das Feld selbst ist reine Optik (lokales Teil), der
-- Server baut nichts neu und kein Spielstand haengt daran.
--
-- Die Flugbahn: senkrechte Startgeschwindigkeit so, dass der Scheitel
-- APEX_EXTRA ueber der Spitze liegt; waagerecht so, dass der Charakter im
-- Scheitel ueber dem Landepunkt ist und von dort auf die Spitze faellt.

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace  = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
local MapLayout     = require(ReplicatedStorage.Modules.MapLayout)

local WorldFXKit = require(script.Parent.WorldFXKit)

local TowerFlightController = {}

local CFG = WorldFXConfig.TOWER_FLIGHT
local localPlayer = Players.LocalPlayer

local _slot: number? = nil
local _pad: BasePart? = nil
local _ring: BasePart? = nil
local _lastLaunch = 0

-- Punkt in Arena-Koordinaten (along = nach aussen, across = quer) auf Hoehe y
local function arenaPoint(slot: number, along: number, across: number, y: number): Vector3
	local center = MapLayout.pitCenter(slot)
	local p = center + MapLayout.outward(slot) * along + MapLayout.side(slot) * across
	return Vector3.new(p.X, y, p.Z)
end

local function ownSlot(): number?
	for _, child in Workspace:GetChildren() do
		local slot = tonumber(string.match(child.Name, "^Plot_(%d+)$"))
		if slot and child:GetAttribute("PlotOwner") == localPlayer.UserId then
			return slot
		end
	end
	return nil
end

local function platform(slot: number): Instance?
	local plot = Workspace:FindFirstChild("Plot_" .. slot)
	return if plot then plot:FindFirstChild("PitPlatform") else nil
end

local function towerTop(slot: number): (number, number)
	local container = platform(slot)
	if not container then return 0, 0 end
	local level = container:GetAttribute("TowerLevel")
	local top = container:GetAttribute("TowerTopY")
	return (if typeof(level) == "number" then level else 0), (if typeof(top) == "number" then top else 0)
end

local function buildPad(slot: number)
	local old = _pad
	if old then old:Destroy() end
	local oldRing = _ring
	if oldRing then oldRing:Destroy() end
	local folder = WorldFXKit.folder("TowerFlight", WorldFXKit.root())
	local base = arenaPoint(slot, CFG.PAD_ALONG, CFG.PAD_ACROSS, MapLayout.pitCenter(slot).Y)
	-- flache Scheibe knapp ueber dem Sockelrand (der liegt 0.35 tiefer als die Mitte)
	local pad = WorldFXKit.part("FlightPad", folder, Vector3.new(0.2, CFG.PAD_RADIUS * 2, CFG.PAD_RADIUS * 2),
		CFrame.new(base + Vector3.new(0, -0.25, 0)) * WorldFXKit.UPRIGHT, CFG.COLOR_OFF, Enum.Material.Neon, Enum.PartType.Cylinder)
	pad.Transparency = 0.25
	local ring = WorldFXKit.part("FlightRing", folder, Vector3.new(0.1, CFG.PAD_RADIUS * 2.6, CFG.PAD_RADIUS * 2.6),
		CFrame.new(base + Vector3.new(0, -0.3, 0)) * WorldFXKit.UPRIGHT, CFG.COLOR_OFF, Enum.Material.Neon, Enum.PartType.Cylinder)
	ring.Transparency = 0.6
	_pad, _ring = pad, ring
	WorldFXKit.cullGroup(folder, base, CFG.SHOW_DISTANCE)
end

local function launch(root: BasePart, slot: number, topY: number)
	local gravity = Workspace.Gravity
	local start = root.Position
	-- Hoehe der Huefte ueber dem Fuss etwa 3 Studs: Ziel = Spitze + 3
	local landing = arenaPoint(slot, CFG.LAND_ALONG, CFG.LAND_ACROSS, topY + 3)
	local apexY = math.max(landing.Y, start.Y) + CFG.APEX_EXTRA
	local rise = math.max(1, apexY - start.Y)
	local vy = math.sqrt(2 * gravity * rise)
	local tApex = vy / gravity
	local flat = Vector3.new(landing.X - start.X, 0, landing.Z - start.Z)
	local vxz = flat / tApex
	root.AssemblyLinearVelocity = Vector3.new(vxz.X, vy, vxz.Z)
	-- Im Scheitel die Waagerechte abbremsen, sonst rutscht er ueber die Kante
	task.delay(tApex, function()
		if root.Parent then
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(0, math.min(v.Y, 0), 0)
		end
	end)
end

local function step()
	local slot = _slot
	local pad = _pad
	if not slot or not pad then return end
	local level, topY = towerTop(slot)
	local active = level >= CFG.MIN_LEVEL
	local color = if active then CFG.COLOR_ON else CFG.COLOR_OFF
	if pad.Color ~= color then
		pad.Color = color
		local ring = _ring
		if ring then ring.Color = color end
	end
	local ring = _ring
	if ring and active then
		ring.Transparency = 0.45 + math.sin(os.clock() * 5) * 0.2
	end
	if not active then return end

	local character = localPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid then return end
	if humanoid.FloorMaterial == Enum.Material.Air then return end
	if os.clock() - _lastLaunch < CFG.COOLDOWN then return end

	local p = pad.Position
	local d = Vector3.new(root.Position.X - p.X, 0, root.Position.Z - p.Z).Magnitude
	if d > CFG.PAD_RADIUS or math.abs(root.Position.Y - p.Y) > 6 then return end
	-- schon oben? (z. B. auf der Spitze gelandet und zurueckgelaufen)
	if root.Position.Y > topY + 1 then return end

	_lastLaunch = os.clock()
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	launch(root, slot, topY)
end

local function refreshSlot()
	local slot = ownSlot()
	if slot == _slot then return end
	_slot = slot
	if slot then buildPad(slot) end
end

function TowerFlightController.init()
	if not WorldFXKit.enabled("towerFlight") then return end
	refreshSlot()
	Workspace.ChildAdded:Connect(function(child)
		if string.match(child.Name, "^Plot_%d+$") then task.defer(refreshSlot) end
	end)
	Workspace.ChildRemoved:Connect(function(child)
		if string.match(child.Name, "^Plot_%d+$") then task.defer(refreshSlot) end
	end)
	-- PlotOwner kommt evtl. nach dem Plot an
	task.delay(3, refreshSlot)
	RunService.Heartbeat:Connect(step)
	print("[TowerFlightController] Initialisiert")
end

return TowerFlightController
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="LocalScript" referent="RBX30"><Properties>
<string name="Name">Main</string>
<bool name="Disabled">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Main.client.luau
-- StarterPlayerScripts/Main.client.luau
--
-- Bootstrap des Clients — das Gegenstueck zu GameManager auf dem Server.
-- Einzige Stelle die die Startreihenfolge der Client-Module kennt.
--
-- ACHTUNG beim Umbenennen: die Datei darf NICHT "init.client.luau" heissen.
-- Rojo macht aus einem Ordner mit init-Datei ein Script statt eines
-- Containers — auf StarterPlayerScripts angewandt heisst das, dass der
-- gesamte Client-Teilbaum nie im Spiel ankommt. Genau das hat den
-- Server-Sync schon einmal lahmgelegt.
--
-- Reihenfolge:
--   1. ScreenGui anlegen — alle UI-Module haengen sich dort ein.
--   2. Toast zuerst, damit fruehe Fehlermeldungen schon sichtbar sind.
--   3. ClientState VOR den datengetriebenen UIs: die registrieren sich per
--      onChanged und bekommen den aktuellen Stand sofort nachgereicht.
--   4. Die Panels. Jedes meldet sich in seinem init beim PanelManager an —
--      erst danach duerfen Module laufen die Panels oeffnen wollen.
--   5. Hud und MenuBar: beide sind reine Ausloeser und brauchen die
--      angemeldeten Panels (Rebirth-Pille, Menue-Knoepfe).
--   6. ResultFeed — Toast-Meldungen fuer Recycling und Offline-Ertrag.
--      Muss vor dem ersten Serverpaket stehen, sonst geht der Offline-Report
--      des Joins verloren.
--   7. WorldController zuletzt — er braucht Panel und PanelManager.
--   8. EggTimerController — unabhaengig von allen anderen, braucht nur
--      ClientState (schon initialisiert) und die Figuren in der Welt.
--   9. SkillFXController (v14) — hoert nur auf Remotes.SkillFXPlay.
--
-- Davor, ganz am Anfang: LanguageController. Er legt die Sprache fest, bevor
-- irgendein Text gebaut wird (er braucht ClientState erst, wenn es dort
-- Daten gibt — onChanged meldet den aktuellen Stand sofort nach).

local Players = game:GetService("Players")

local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local root = script.Parent

local Controllers = root:WaitForChild("Controllers")
local UI          = root:WaitForChild("UI")

local ClientState        = require(Controllers:WaitForChild("ClientState"))
local LanguageController = require(Controllers:WaitForChild("LanguageController"))
local ResultFeed         = require(Controllers:WaitForChild("ResultFeed"))
local WorldController    = require(Controllers:WaitForChild("WorldController"))
local EggTimerController = require(Controllers:WaitForChild("EggTimerController"))
local SkillFXController  = require(Controllers:WaitForChild("SkillFXController"))
local CombController     = require(Controllers:WaitForChild("CombController"))
local AmbienceController = require(Controllers:WaitForChild("AmbienceController"))
-- Welt aufwerten (08.10.2026)
local DayCycleController    = require(Controllers:WaitForChild("DayCycleController"))
local WaterController       = require(Controllers:WaitForChild("WaterController"))
local HubLandmarkController = require(Controllers:WaitForChild("HubLandmarkController"))
local HubEventController    = require(Controllers:WaitForChild("HubEventController"))
local ArrivalController     = require(Controllers:WaitForChild("ArrivalController"))
local WorldShotController   = require(Controllers:WaitForChild("WorldShotController"))
local PlotLifeController    = require(Controllers:WaitForChild("PlotLifeController"))
local ArenaLifeController   = require(Controllers:WaitForChild("ArenaLifeController"))
local LifeController        = require(Controllers:WaitForChild("LifeController"))
local WorldMomentController = require(Controllers:WaitForChild("WorldMomentController"))
local SoundscapeController  = require(Controllers:WaitForChild("SoundscapeController"))
local ZoneLightController   = require(Controllers:WaitForChild("ZoneLightController"))
local EventFXController  = require(Controllers:WaitForChild("EventFXController"))
local LaidEggMeshController = require(Controllers:WaitForChild("LaidEggMeshController"))
local UiEventLogger      = require(Controllers:WaitForChild("UiEventLogger"))
local GuideController    = require(Controllers:WaitForChild("GuideController"))
local UpgradeHintController = require(Controllers:WaitForChild("UpgradeHintController"))
local IncubatorController   = require(Controllers:WaitForChild("IncubatorController"))   -- Sammel-Update 8
local AreaSignController    = require(Controllers:WaitForChild("AreaSignController"))    -- Sammel-Update 3.8
local TerminalController    = require(Controllers:WaitForChild("TerminalController"))    -- 08.10. Tower-Terminal
local TowerFlightController = require(Controllers:WaitForChild("TowerFlightController")) -- 12.10. Flugfeld am Kampf-Turm

local Toast            = require(UI:WaitForChild("Toast"))
local UiScale          = require(UI:WaitForChild("UiScale"))
local ShopPanel        = require(UI:WaitForChild("ShopPanel"))
local Hud              = require(UI:WaitForChild("Hud"))
local MenuBar          = require(UI:WaitForChild("MenuBar"))
local BaerchiPanel     = require(UI:WaitForChild("BaerchiPanel"))
local BaerchiInventory = require(UI:WaitForChild("BaerchiInventory"))
local HatchPanel       = require(UI:WaitForChild("HatchPanel"))
local CombatPanel      = require(UI:WaitForChild("CombatPanel"))
local TowerPanel       = require(UI:WaitForChild("TowerPanel"))     -- 08.10. Paket D
local BuildingPanel    = require(UI:WaitForChild("BuildingPanel"))
local FusionPanel      = require(UI:WaitForChild("FusionPanel"))
local CharmPanel       = require(UI:WaitForChild("CharmPanel"))
local RebirthDialog    = require(UI:WaitForChild("RebirthDialog"))
local LanguagePanel    = require(UI:WaitForChild("LanguagePanel"))
local PetBar           = require(UI:WaitForChild("PetBar"))
local QuestPanel       = require(UI:WaitForChild("QuestPanel"))
local QuestTracker     = require(UI:WaitForChild("QuestTracker"))
local HudRow           = require(UI:WaitForChild("HudRow"))
local EggTreePanel     = require(UI:WaitForChild("EggTreePanel"))
local LeaderboardPanel = require(UI:WaitForChild("LeaderboardPanel"))
local ProfilePanel     = require(UI:WaitForChild("ProfilePanel"))
local DailyBonusPanel  = require(UI:WaitForChild("DailyBonusPanel"))
local Feedback         = require(UI:WaitForChild("Feedback"))
local UpgradeFX        = require(UI:WaitForChild("UpgradeFX"))   -- 08.10. Paket G
local Moment           = require(UI:WaitForChild("Moment"))
local ReturnSummary    = require(UI:WaitForChild("ReturnSummary"))
local HomeButton       = require(UI:WaitForChild("HomeButton"))
local RebirthButton    = require(UI:WaitForChild("RebirthButton"))   -- Sammel-Update 2.7
local IncubatorPanel   = require(UI:WaitForChild("IncubatorPanel"))  -- Sammel-Update 8
local CurrencyHint     = require(UI:WaitForChild("CurrencyHint"))    -- Sammel-Update 3.4

--------------------------------------------------------------------------------
-- Oberflaeche
--------------------------------------------------------------------------------

local screenGui = Instance.new("ScreenGui")
screenGui.Name             = "RBL"
screenGui.ResetOnSpawn     = false   -- ueberlebt den Tod des Charakters
screenGui.IgnoreGuiInset   = false   -- laesst Platz fuer die Roblox-Topbar
screenGui.ZIndexBehavior   = Enum.ZIndexBehavior.Sibling
screenGui.Parent           = playerGui

-- Playtest 05.10.: auf grossen Monitoren mitwachsen (siehe UI/UiScale)
UiScale.init(screenGui)

--------------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------------

-- Sprache ALLERERSTES: ab hier liefert Loc den Text in der Roblox-Sprache des
-- Spielers. Ohne das haetten Toast und alle Beschriftungen, die beim Aufbau
-- gesetzt werden, einen Moment lang die Standardsprache.
LanguageController.init()

-- Vom Server gebaute Welt-Texte (Tafeln, Schilder, Prompts) in der Sprache
-- dieses Spielers anzeigen (siehe Localization/WorldText)
require(game:GetService("ReplicatedStorage"):WaitForChild("Localization"):WaitForChild("WorldText")).startClient()

Toast.init(screenGui)
ClientState.init()

BaerchiPanel.init(screenGui)
BaerchiInventory.init(screenGui)
HatchPanel.init(screenGui)
CombatPanel.init(screenGui)
TowerPanel.init(screenGui)         -- 08.10. Paket D (nur mit TOWER_PANEL_V2)
BuildingPanel.init(screenGui)
FusionPanel.init(screenGui)
-- Nach BaerchiPanel: die Detailkarte oeffnet dieses Panel ueber den
-- PanelManager, es muss dafuer angemeldet sein. Die Reihenfolge der init-Aufrufe
-- entscheidet das zwar nicht (geoeffnet wird erst per Klick), aber die Liste
-- hier soll den Aufrufweg widerspiegeln.
CharmPanel.init(screenGui)
RebirthDialog.init(screenGui)
LanguagePanel.init(screenGui)
QuestPanel.init(screenGui)
-- v14: Ei-Baum (oeffnet sich aus dem Ei-Menue)
EggTreePanel.init(screenGui)
-- v15: Bestenliste, Spieler-Profil (Inspector) und Login-Bonus. Vor MenuBar,
-- damit die Menue-Kacheln die Panels schon angemeldet vorfinden.
LeaderboardPanel.init(screenGui)
ProfilePanel.init(screenGui)
DailyBonusPanel.init(screenGui)
ShopPanel.init(screenGui)          -- HBB Paket 10 (nur mit SHOP_V1)
IncubatorPanel.init(screenGui)     -- Sammel-Update Paket 8

Hud.init(screenGui)
MenuBar.init(screenGui)

-- HBB Paket 1: fliegende Icons, grosse Momente, Rueckkehr-Karte. Nach Hud
-- und MenuBar (Ziele der Icons), vor ResultFeed (der Offline-Bericht des
-- Joins kommt sonst an, bevor die Karte bereit ist).
Feedback.init(screenGui)
UpgradeFX.init()                -- 08.10. Paket G: Erfolgs-Moment beim Ausbau
Moment.init(screenGui)
ReturnSummary.init(screenGui)
-- HBB Paket 5: Heim-Knopf (erscheint nur weit weg vom eigenen Plot)
HomeButton.init(screenGui)
RebirthButton.init(screenGui)   -- Sammel-Update 2.7: fester Rebirth-Knopf
CurrencyHint.init(screenGui)    -- Sammel-Update 3.4: Waehrungs-Hinweise

-- v13: Quest-Karte links (braucht das Quest-Fenster, das oben angemeldet wird)
QuestTracker.init(screenGui)
-- HUD_ROW_V2: Zahnrad · Quests · Shop in einer Zeile (versteckt die Quest-Karte)
HudRow.init(screenGui)

-- v12: untere Pet-Leiste (Event / Fight), legt auch den PitResumeDialog an
PetBar.init(screenGui)

ResultFeed.init()
WorldController.init()
EggTimerController.init()
IncubatorController.init()   -- Sammel-Update Paket 8
AreaSignController.init()    -- Sammel-Update Paket 3.8
TerminalController.init()    -- 08.10. Tower-Terminal an der Bruecke
TowerFlightController.init() -- 12.10. Flugfeld auf den Kampf-Turm
-- v14: Faehigkeiten-Show im PIT (unabhaengig von allem anderen)
SkillFXController.init()
-- v15: Waben im Event-Pit und Recycler (braucht Toast, ClientState und die Welt)
CombController.init(screenGui)
-- v16: Himmels-Kulisse (Wolken, Schwebeinseln, Pollen, Schaum) nur auf dem Client
AmbienceController.init()
-- Welt aufwerten: Tageslauf (Paket A) zuerst — Wasser und Hauptinsel melden
-- ihre leuchtenden Teile bei ihm an. Danach Wasser (B), Hauptinsel (C),
-- Ankunft (C) und die festen Kamerapunkte (Paket 0, nur Studio).
DayCycleController.init()
WaterController.init()
HubLandmarkController.init()
HubEventController.init()
ArrivalController.init()
-- Paket D (Plot-Inseln) vor F: die Bienen fragen nach der eigenen Insel.
PlotLifeController.init()
-- Paket G: Welt-Momente (nutzt Arena-, Insel-, Leben- und Wahrzeichen-Controller)
WorldMomentController.init()
-- Paket H: Klang-Kulisse (still, bis gepruefte Sound-IDs eingetragen sind)
SoundscapeController.init()
-- Paket I: Licht nach Zonen (nach dem Tageslauf: setzt dessen Atmosphaeren-Faktoren)
ZoneLightController.init()
ArenaLifeController.init()
LifeController.init()
WorldShotController.init()
-- v17: lebendige Events (UFO-Patrouille, Abwuerfe, Boss, Telegraphen); braucht Toast
EventFXController.init()
-- v18: Ei-Mesh der gelegten Eier (EditableMesh gibt es nur auf dem Client)
LaidEggMeshController.init()
-- HBB Paket 0: Messpunkte der Oberflaeche (Panel auf/zu, Stillstand)
UiEventLogger.init()
-- HBB Paket 2: Fuehrung ohne Text (braucht MenuBar und PetBar als Anker)
GuideController.init(screenGui)
-- HBB Paket 3: ⬆ ueber bezahlbaren eigenen Gebaeuden
UpgradeHintController.init()

print("[Client] Bereit")
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX31"><Properties>
<string name="Name">UI</string>
</Properties>
<Item class="ModuleScript" referent="RBX32"><Properties>
<string name="Name">BaerchiInventory</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- BaerchiInventory.luau
-- StarterPlayerScripts/UI/BaerchiInventory.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Baerchis des Spielers als scrollbare Liste zeigen
--   - Die Zwei-Slot-Auswahl fuer die Fusion verwalten
--   - Die zwei Reiter: "Meine Baerchis" (diese Liste) und "Index" (IndexView)
--
-- Die Liste kommt fertig sortiert aus ClientState.getBaerchiList()
-- (Rarity absteigend, dann Level) — hier wird nichts nachsortiert.
--
-- Die Fusions-Auswahl ist der einzige Zustand den dieses Modul selbst haelt.
-- Das ist erlaubt: welche zwei Zeilen gerade markiert sind, ist eine reine
-- Bedien-Information und kein Spielstand — sie steht in keinem Save und der
-- Server erfaehrt davon erst beim Bestaetigen in FusionPanel.
--
-- Neu aufgebaut wird die Liste nur wenn das Panel sichtbar ist. Kommt ein
-- Update waehrend es zu ist, wird nur ein Merker gesetzt und beim naechsten
-- Oeffnen nachgeholt — sonst baut jede Kampfrunde 25 Zeilen neu.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local Names            = require(ReplicatedStorage.Localization.Names)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Unlock       = require(script.Parent.Unlock)   -- HBB Paket 3
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombatRating = require(ReplicatedStorage.Modules.CombatRating)

-- HBB Paket 4: "⚔ 1,2K" statt HP/ATK in der Zeile
local function ratingText(baerchi: Types.Baerchi): string
	local value, suffix = CombatRating.short(CombatRating.of(baerchi))
	local digits = if suffix ~= "" and value < 100 then 1 else 0
	return "⚔ " .. (if digits > 0 then Loc.formatDecimal(value, digits) else Loc.formatNumber(math.floor(value))) .. suffix
end
local IndexView    = require(script.Parent.IndexView)

local BaerchiInventory = {}

local PANEL_NAME  = "Inventory"
local ROW_HEIGHT  = 48
local TOOLBAR_H   = 32
local FOOTER_H    = 64
local TAB_H       = 32

local _root: Frame?               = nil
local _title: TextLabel?          = nil
local _scroller: ScrollingFrame?  = nil
local _empty: TextLabel?          = nil
local _footer: Frame?             = nil
local _slotLabels: { TextLabel }  = {}
local _fuseButton: TextButton?    = nil
local _modeButton: TextButton?    = nil
local _hint: TextLabel?           = nil
local _listPage: Frame?           = nil
local _tabButtons: { [string]: TextButton } = {}
local _tab = "Pets"   -- "Pets" | "Index"

local _fusionMode = false
local _selection: { string } = {}
local _dirty = true

--------------------------------------------------------------------------------
-- Auswahl
--------------------------------------------------------------------------------

local function isSelected(uid: string): boolean
	return table.find(_selection, uid) ~= nil
end

local function toggleSelection(uid: string)
	local index = table.find(_selection, uid)
	if index then
		table.remove(_selection, index)
		return
	end

	-- Sammel-Update 2.8: B muss dieselbe Rarity wie A haben (der Server
	-- lehnt sonst ab, err.fuse_rarity_mismatch). Die Liste zeigt ohnehin nur
	-- passende — das hier ist das Netz fuer einen Klick waehrend eines Umbaus.
	local first = if _selection[1] then ClientState.getBaerchi(_selection[1]) else nil
	local picked = ClientState.getBaerchi(uid)
	if first and picked and first.rarity ~= picked.rarity then
		return
	end

	-- Sammel-Update 1.3: ein weiterer Klick ersetzt B, nie A — A ist der
	-- Baerchi, von dessen Karte der Spieler kam.
	if #_selection >= 2 then
		table.remove(_selection, 2)
	end
	table.insert(_selection, uid)
end

-- Sammel-Update 2.8: im Fusions-Modus mit gewaehltem A nur Baerchis
-- derselben Rarity zeigen (A selbst bleibt sichtbar, zum Abwaehlen).
local function visibleInFusion(baerchi: Types.Baerchi): boolean
	if not _fusionMode or not _selection[1] then return true end
	if isSelected(baerchi.uid) then return true end
	local first = ClientState.getBaerchi(_selection[1])
	return first == nil or first.rarity == baerchi.rarity
end

-- Sammel-Update 1.3 ("kann keinen 2. auswaehlen"): die Zeilen wurden bei JEDEM
-- Datenstand (Honig, Eier, ... mehrmals pro Sekunde) zerstoert und neu
-- gebaut. Lag ein Tipp gerade dazwischen (Finger runter, Zeile weg, Finger
-- hoch), kam Activated nie an — auf dem Handy fast jedes Mal. Jetzt bleibt
-- die Zeile samt Knopf pro uid stehen, nur der Inhalt wird erneuert.
local _rows: { [string]: Frame } = {}

-- Markierungen wegwerfen die es nicht mehr gibt (verwertet, fusioniert, Rebirth)
local function pruneSelection()
	for i = #_selection, 1, -1 do
		if not ClientState.getBaerchi(_selection[i]) then
			table.remove(_selection, i)
		end
	end
end

--------------------------------------------------------------------------------
-- Aufbau der Liste
--------------------------------------------------------------------------------

-- Zeigt die AKTUELLEN HP, nicht nur das Maximum: seit die HP zwischen
-- PIT-Laeufen stehen bleiben, ist "wer kann ueberhaupt noch kaempfen" die
-- eigentliche Frage beim Durchscrollen der Liste.
local function describeStats(baerchi: Types.Baerchi): string
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then return "" end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)
	-- `or stats.maxHp`: ohne den Rueckfall wuerde ein Baerchi ohne currentHp
	-- (Datenpaket von einem aelteren Serverstand) hier den Aufbau der GANZEN
	-- Liste abbrechen, weil dieser Aufruf mitten in der Zeilen-Schleife steht.
	local hp    = math.clamp(baerchi.currentHp or stats.maxHp, 0, stats.maxHp)

	return string.format("HP %d/%d\nATK %d", hp, stats.maxHp, stats.atk)
end

local function buildRow(parent: Instance, order: number, baerchi: Types.Baerchi)
	local upgradeUi = FeatureFlags.isOn("UI_V2_UPGRADE_TAB")
	-- HBB Paket 4: Farbband statt zwoelf Einzelfarben
	local color = if upgradeUi then Theme.bandColor(baerchi.rarity) else Theme.rarityColor(baerchi.rarity)
	local def   = BaerchiConfig.getById(baerchi.configId)

	local data     = ClientState.get()
	local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

	local uid = baerchi.uid
	local row = _rows[uid]
	local fresh = row == nil or row.Parent == nil
	if fresh then
		row = Theme.panel("Row_" .. uid, parent, Theme.COLORS.panel)
		row.Size = UDim2.new(1, -8, 0, ROW_HEIGHT)
		_rows[uid] = row :: Frame

		-- Die ganze Zeile ist der Knopf: ein durchsichtiger Button darueber.
		-- Er bleibt ueber alle Aktualisierungen bestehen (siehe _rows).
		local hit = Instance.new("TextButton")
		hit.Name                   = "Hit"
		hit.BackgroundTransparency = 1
		hit.Text                   = ""
		hit.Size                   = UDim2.fromScale(1, 1)
		hit.ZIndex                 = 3
		hit.Parent                 = row

		hit.Activated:Connect(function()
			if _fusionMode then
				toggleSelection(uid)
				BaerchiInventory.refresh()
			else
				PanelManager.open("Baerchi", uid)
			end
		end)
	end
	local frame = row :: Frame
	frame.LayoutOrder = order
	frame.Visible     = visibleInFusion(baerchi)
	for _, child in frame:GetChildren() do
		if child.Name == "Accent" or child.Name == "Name" or child.Name == "Sub" or child.Name == "Stats" then
			child:Destroy()
		end
	end
	row = frame

	-- Markierte Zeilen bekommen einen farbigen Rand statt eines eigenen Symbols
	local stroke = row:FindFirstChildOfClass("UIStroke")
	if stroke then
		local marked = _fusionMode and isSelected(uid)
		stroke.Color     = if marked then Theme.COLORS.gummy else Theme.COLORS.outline
		stroke.Thickness = if marked then Theme.OUTLINE_THICKNESS + 2 else Theme.OUTLINE_THICKNESS
	end

	local accent = Instance.new("Frame")
	accent.Name             = "Accent"
	accent.Size             = UDim2.new(0, 6, 1, -14)
	accent.Position         = UDim2.new(0, 8, 0, 7)
	-- Der ausgeruestete Baerchi (der einzige, der auf dem Plot steht und
	-- kaempfen/essen kann) hebt sich hier golden ab statt in Rarity-Farbe —
	-- das ist auf einen Blick wichtiger als die Rarity.
	accent.BackgroundColor3  = if equipped then Theme.COLORS.goldGummy else color
	accent.BorderSizePixel   = 0
	accent.Parent            = row
	Theme.corner(accent, 3)

	-- Eine Mutation ist in einer langen Liste die Information, die man auf
	-- keinen Fall uebersehen darf: die haeufigste Stufe trifft trotzdem nur
	-- 1 von 100 Baerchis. Deshalb hier gleich zweimal — als Kuerzel im Namen
	-- und als Farbe der Unterzeile (seit v11, ersetzt das binaere Inverted).
	local mutation = baerchi.mutation

	local name = Theme.label("Name", row,
		(if equipped then "\u{2605} " else "")
		.. (if mutation then BaerchiConfig.getMutationBadge(mutation) .. " " else "")
		.. Names.baerchi(baerchi.configId))
	name.Position = UDim2.new(0, 22, 0, 5)
	name.Size     = UDim2.new(1, -120, 0, 21)

	local sub = Theme.label("Sub", row, string.format(
		"Lv. %d  —  %s%s",
		baerchi.level,
		Loc.t("rarity." .. baerchi.rarity),
		if mutation then "  —  " .. Loc.name("mutation." .. mutation .. ".name", BaerchiConfig.getMutationDisplayName(mutation)):upper() else ""
	))
	sub.Position   = UDim2.new(0, 22, 0, 26)
	sub.Size       = UDim2.new(1, -120, 0, 16)
	sub.TextColor3 = if mutation then BaerchiConfig.getMutationColor(mutation) else color

	local stats = Theme.label("Stats", row, if upgradeUi then ratingText(baerchi) else describeStats(baerchi))
	stats.AnchorPoint    = Vector2.new(1, 0.5)
	stats.Position       = UDim2.new(1, -10, 0.5, 0)
	stats.Size           = UDim2.new(0, 84, 1, -10)
	stats.TextXAlignment = Enum.TextXAlignment.Right
	stats.TextScaled     = false
	stats.TextSize       = if upgradeUi then 20 else 13
	stats.Font           = if upgradeUi then Theme.FONT else Theme.FONT_BODY
	stats.TextColor3     = if upgradeUi then Theme.COLORS.text else Theme.COLORS.textDim
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

local function updateFooter()
	local footer = _footer
	if footer then
		footer.Visible = _fusionMode
	end

	local scroller = _scroller
	if scroller then
		local reserved = if _fusionMode then FOOTER_H + 6 else 0
		scroller.Size = UDim2.new(1, 0, 1, -(TOOLBAR_H + 6 + reserved))
	end

	for slot = 1, 2 do
		local label = _slotLabels[slot]
		if not label then continue end

		local uid = _selection[slot]
		local baerchi = if uid then ClientState.getBaerchi(uid) else nil

		if baerchi then
			local def = BaerchiConfig.getById(baerchi.configId)
			label.Text       = string.format("%s  Lv.%d", Names.baerchi(baerchi.configId), baerchi.level)
			label.TextColor3  = Theme.rarityColor(baerchi.rarity)
		else
			label.Text       = Loc.t("ui.fusion.slot_empty", { n = slot })
			label.TextColor3  = Theme.COLORS.textDim
		end
	end

	local fuseButton = _fuseButton
	if fuseButton then
		Theme.setEnabled(fuseButton, #_selection == 2)
	end

	local modeButton = _modeButton
	if modeButton then
		if FeatureFlags.isOn("FUSION_INVENTORY_TOGGLE") then
			modeButton.Text = Loc.t(if _fusionMode then "ui.fusion.mode_on" else "ui.fusion.mode_off")
		else
			-- 12.10.: Fusion startet nur von der Baerchi-Karte; hier nur Abbrechen
			modeButton.Visible = _fusionMode
			modeButton.Text = Loc.t("ui.common.cancel")
		end
	end
	local hint = _hint
	if hint then
		local shifted = modeButton ~= nil and modeButton.Visible
		hint.Position = UDim2.new(0, if shifted then 140 else 0, 0, 0)
		hint.Size     = UDim2.new(1, if shifted then -140 else 0, 1, 0)
	end

	local hint = _hint
	if hint then
		hint.Text = if not _fusionMode
			then Loc.t("ui.inventory.hint_card")
			elseif _selection[1] then Loc.t("ui.fusion.hint_pick_b")
			else Loc.t("ui.fusion.hint_pick_a")
	end
end

function BaerchiInventory.refresh()
	local scroller = _scroller
	local root     = _root
	if not scroller or not root then return end

	if not root.Visible then
		_dirty = true
		return
	end
	_dirty = false

	pruneSelection()

	local list = ClientState.getBaerchiList()

	-- Sammel-Update 1.3: nur Zeilen entfernen, deren Baerchi es nicht mehr gibt.
	local alive: { [string]: boolean } = {}
	for _, baerchi in list do alive[baerchi.uid] = true end
	for uid, row in _rows do
		if not alive[uid] then
			row:Destroy()
			_rows[uid] = nil
		end
	end

	local title = _title
	if title then
		title.Text = Loc.t("ui.inventory.title_count", { n = #list })
	end

	local empty = _empty
	if empty then
		empty.Visible = #list == 0
	end

	for order, baerchi in list do
		buildRow(scroller, order, baerchi)
	end

	updateFooter()
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function applyTab()
	-- HBB Paket 3: der Index-Reiter erscheint ab drei entdeckten Arten
	local indexTab = _tabButtons.Index
	if indexTab then
		Unlock.apply("index", indexTab)
		if not indexTab.Visible and _tab == "Index" then _tab = "Pets" end
	end

	local listPage = _listPage
	if listPage then
		listPage.Visible = _tab == "Pets"
	end
	IndexView.setVisible(_tab == "Index" and _root ~= nil and _root.Visible)

	for tab, button in _tabButtons do
		local active = tab == _tab
		button.BackgroundColor3 = if active then Theme.COLORS.accent else Theme.COLORS.panelLight
		button.TextColor3       = if active then Theme.COLORS.outline else Theme.COLORS.text
	end

	-- Sammel-Update 05.10. (Paket 7): "!" am Index-Reiter, solange eine
	-- Belohnung abholbar ist.
	local indexButton = _tabButtons.Index
	if indexButton then
		local badge = indexButton:FindFirstChild("RewardBadge")
		if badge and badge:IsA("GuiObject") then
			badge.Visible = IndexView.claimableCount() > 0
		end
	end

	if _tab == "Pets" then
		BaerchiInventory.refresh()
	end
end

local function openInternal(...: any)
	local root = _root
	if not root then return end

	-- PanelManager.open("Inventory", "Index") springt direkt in den Index
	-- (zum Beispiel aus einer Quest heraus).
	local wanted, uid = ...
	if wanted == "Index" or wanted == "Pets" then
		_tab = wanted
	elseif wanted == "Fuse" then
		-- Playtest 05.10.: Fusion von der Baerchi-Karte aus. Das Fusions-
		-- Fenster selbst hat keine Auswahl; ausgewaehlt wird hier. A ist
		-- dieser Baerchi, B tippt der Spieler in der Liste an.
		_tab = "Pets"
		_fusionMode = true
		table.clear(_selection)
		if typeof(uid) == "string" then table.insert(_selection, uid) end
	end

	root.Visible = true
	applyTab()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
	-- 12.10.: eine offene Fusions-Auswahl endet mit dem Fenster
	if not FeatureFlags.isOn("FUSION_INVENTORY_TOGGLE") then
		_fusionMode = false
		table.clear(_selection)
	end
	IndexView.setVisible(false)
end

function BaerchiInventory.show()
	PanelManager.open(PANEL_NAME)
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function BaerchiInventory.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"BaerchiInventory", screenGui,
		Vector2.new(0.46, 0.66),
		Vector2.new(300, 300),
		Vector2.new(520, 580)
	)
	_root  = root
	_title = Theme.dialogHeader(root, Loc.t("ui.menu.baerchis"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	-- Reiter-Leiste: "Meine Baerchis" | "Index"
	local tabBar = Theme.container("Tabs", body)
	tabBar.Size = UDim2.new(1, 0, 0, TAB_H)
	local tabLayout = Theme.listLayout(tabBar, 8, true)
	tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local function addTab(tab: string, key: string, order: number)
		local button = Theme.button("Tab_" .. tab, tabBar, "", Theme.COLORS.panelLight)
		button.Size        = UDim2.new(0, 150, 1, 0)
		button.LayoutOrder = order
		Loc.bind(button, key)
		button.Activated:Connect(function()
			if tab == "Index" then Unlock.markSeen("index") end
			_tab = tab
			applyTab()
		end)
		_tabButtons[tab] = button
	end
	addTab("Pets",  "ui.inventory.tab_pets",  1)
	addTab("Index", "ui.inventory.tab_index", 2)
	do
		local indexButton = _tabButtons.Index
		local badge = Theme.panel("RewardBadge", indexButton, Theme.COLORS.bad)
		badge.AnchorPoint = Vector2.new(1, 0)
		badge.Position = UDim2.new(1, 4, 0, -6)
		badge.Size = UDim2.fromOffset(20, 20)
		badge.ZIndex = 4
		badge.Visible = false
		Theme.corner(badge, 10)
		local bang = Theme.label("Bang", badge, "!")
		bang.Size = UDim2.fromScale(1, 1)
		bang.TextXAlignment = Enum.TextXAlignment.Center
		bang.ZIndex = 5
	end

	-- Beide Seiten teilen sich die Flaeche unter den Reitern.
	local pages = Theme.container("Pages", body)
	pages.Position = UDim2.new(0, 0, 0, TAB_H + 8)
	pages.Size     = UDim2.new(1, 0, 1, -(TAB_H + 8))

	local listPage = Theme.container("ListPage", pages)
	listPage.Size = UDim2.fromScale(1, 1)
	_listPage = listPage

	IndexView.build(pages, root)

	-- Werkzeugleiste: Fusions-Modus an/aus
	local toolbar = Theme.container("Toolbar", listPage)
	toolbar.Size = UDim2.new(1, 0, 0, TOOLBAR_H)

	local modeButton = Theme.button("FusionMode", toolbar, Loc.t("ui.fusion.mode_off"), Theme.COLORS.gummy)
	modeButton.Size = UDim2.new(0, 130, 1, 0)
	_modeButton = modeButton

	local hint = Theme.bodyText("Hint", toolbar, Loc.t("ui.inventory.hint_card"))
	_hint = hint
	hint.Position       = UDim2.new(0, 140, 0, 0)
	hint.Size           = UDim2.new(1, -140, 1, 0)
	hint.TextYAlignment = Enum.TextYAlignment.Center

	modeButton.Activated:Connect(function()
		_fusionMode = not _fusionMode
		if not _fusionMode then
			table.clear(_selection)
		end
		BaerchiInventory.refresh()
	end)

	-- Liste
	local scroller = Theme.scroller("List", listPage)
	scroller.Position = UDim2.new(0, 0, 0, TOOLBAR_H + 6)
	scroller.Size     = UDim2.new(1, 0, 1, -(TOOLBAR_H + 6))
	_scroller = scroller

	local layout = Theme.listLayout(scroller, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local empty = Theme.bodyText("Empty", listPage, Loc.t("ui.inventory.empty"))
	empty.Position = UDim2.new(0, 4, 0, TOOLBAR_H + 16)
	empty.Size     = UDim2.new(1, -8, 0, 40)
	empty.Visible  = false
	_empty = empty

	-- Fussleiste fuer die Fusions-Auswahl
	local footer = Theme.panel("FusionFooter", listPage, Theme.COLORS.panel)
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Position    = UDim2.new(0, 0, 1, 0)
	footer.Size        = UDim2.new(1, -8, 0, FOOTER_H)
	footer.Visible     = false
	_footer = footer

	for slot = 1, 2 do
		local label = Theme.label("Slot" .. slot, footer, Loc.t("ui.fusion.slot_empty", { n = slot }))
		label.Position   = UDim2.new(0, 10, 0, 6 + (slot - 1) * 22)
		label.Size       = UDim2.new(1, -140, 0, 20)
		label.TextColor3  = Theme.COLORS.textDim
		_slotLabels[slot] = label
	end

	local fuseButton = Theme.button("Fuse", footer, Loc.t("ui.fusion.fuse"), Theme.COLORS.gummy)
	fuseButton.AnchorPoint = Vector2.new(1, 0.5)
	fuseButton.Position    = UDim2.new(1, -10, 0.5, 0)
	fuseButton.Size        = UDim2.new(0, 116, 0, 34)
	_fuseButton = fuseButton

	fuseButton.Activated:Connect(function()
		if #_selection < 2 then return end
		PanelManager.open("Fusion", _selection[1], _selection[2])
	end)

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	-- Bestandsaenderungen: sichtbar sofort nachziehen, sonst nur merken
	ClientState.onChanged(function()
		local current = _root
		local indexButton = _tabButtons.Index
		local badge = if indexButton then indexButton:FindFirstChild("RewardBadge") else nil
		if badge and badge:IsA("GuiObject") then
			badge.Visible = IndexView.claimableCount() > 0
		end
		if current and current.Visible then
			BaerchiInventory.refresh()
		else
			_dirty = true
		end
	end)

	-- Sprachwechsel: Zeilen, Titel und Fusions-Leiste neu beschriften
	Loc.onChanged(function()
		_dirty = true
		BaerchiInventory.refresh()
	end)

	print("[BaerchiInventory] Initialisiert")
end

return BaerchiInventory
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX33"><Properties>
<string name="Name">FightStartPrompt</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- FightStartPrompt.luau
-- StarterPlayerScripts/UI/FightStartPrompt.luau
--
-- Einzige Zustaendigkeit:
--   - Das kleine Feld beim Fight-Klick (FeatureFlags.FIGHT_RESUME_PROMPT):
--     "Ab Stage X weiter" gegen Gummies. Klickt der Spieler nichts, ist es
--     nach AUTO_SECONDS weg und der Lauf startet bei Stage 1.
--
-- Entscheidung Projektinhaber 05.10.: Stages schafft man durch STAERKERE
-- Baerchis. Der Einstieg weiter oben ist eine bewusste Spieler-Entscheidung
-- gegen Waehrung, nie der Standard. (Vorher startete der Fight-Knopf ohne
-- Frage ab 65 % des letzten Laufs und buchte dafuer Gummies ab.)
--
-- Kosten und Start-Stage rechnet PitResumeDialog.offer — dieselbe Rechnung,
-- mit der der Server abbucht. Bezahlbar entscheidet am Ende der Server.
--
-- 08.10. (Paket C, "der bezahlte Knopf leuchtet, keiner nimmt den Gratis-
-- Start"): Hierarchie umgedreht. Oben gross und gruen der GRATIS-Start bei
-- Stage 1, darunter klein und gedaempft der bezahlte Einstieg (mit dem
-- Gamepass "Gratis (Pass)"). Keine falschen Countdowns: der Balken zeigt nur,
-- wann es von selbst gratis losgeht.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local Loc = require(ReplicatedStorage.Localization.Loc)

local Theme           = require(script.Parent.Theme)
local Icons           = require(script.Parent.Icons)
local Kit             = require(script.Parent.Kit)   -- 12.10.: kurze Zahlen (4,8M)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local ClientState     = require(script.Parent.Parent.Controllers.ClientState)

local FightStartPrompt = {}

FightStartPrompt.AUTO_SECONDS = 7

local _root: Frame? = nil
local _resume: TextButton? = nil
local _resumeText: TextLabel? = nil   -- 12.10.: eigene Beschriftung (links)
local _cost: TextLabel? = nil
local _bar: Frame? = nil
local _onChoose: ((PitResumeDialog.Choice) -> ())? = nil
local _openedAt = 0
local _token = 0

local function finish(choice: PitResumeDialog.Choice)
	local callback = _onChoose
	_onChoose = nil
	_token += 1
	local root = _root
	if root then root.Visible = false end
	if callback then callback(choice) end
end

function FightStartPrompt.isOpen(): boolean
	return _onChoose ~= nil
end

-- Sofort mit Stage 1 starten (zweiter Fight-Klick waehrend das Feld offen ist)
function FightStartPrompt.chooseFresh()
	if _onChoose then finish("Fresh") end
end

-- Oeffnet das Feld, wenn es einen letzten Lauf ueber Stage 1 gibt. Gibt
-- false zurueck, wenn es nichts anzubieten gibt (Aufrufer startet dann
-- selbst bei Stage 1).
function FightStartPrompt.open(onChoose: (PitResumeDialog.Choice) -> ()): boolean
	local root, resume, cost = _root, _resume, _cost
	local data = ClientState.get()
	if not root or not resume or not cost or not data then return false end
	local reached = PitResumeDialog.getProgress(data)
	if not reached or reached <= 1 then return false end

	local stage, price = PitResumeDialog.offer(data, "Last")
	local pass = PitResumeDialog.hasSkipPass()
	-- 12.10.: Preis kurz und hinter dem Text (vorher lag die lange Zahl
	-- ueber dem Wort "weiter")
	local label = _resumeText
	local text = if pass
		then Loc.t("ui.fight.resume_pass", { stage = stage })
		else "⏩ " .. Loc.t("ui.fight.resume", { stage = stage })
	if label then label.Text = text end
	cost.Text = if pass then "" else Kit.formatCompact(price)
	local affordable = price <= data.gummies
	Theme.setEnabled(resume, affordable)
	-- Auch zu teuer bleibt die Schrift lesbar (nur etwas gedaempft); der
	-- Preis wird rot, damit klar ist, warum der Knopf nicht geht.
	if label then label.TextColor3 = if affordable then Theme.COLORS.text else Color3.fromRGB(205, 200, 215) end
	cost.TextColor3 = if affordable then Theme.COLORS.text else Color3.fromRGB(255, 120, 120)
	local coin = resume:FindFirstChild("Icon")
	if coin and coin:IsA("GuiObject") then coin.Visible = not pass end

	_onChoose = onChoose
	_openedAt = os.clock()
	_token += 1
	local token = _token
	root.Visible = true

	task.delay(FightStartPrompt.AUTO_SECONDS, function()
		if token == _token and _onChoose then
			finish("Fresh")
		end
	end)
	return true
end

function FightStartPrompt.init(screenGui: ScreenGui, anchorAbove: GuiObject)
	local root = Theme.panel("FightStartPrompt", screenGui, Theme.COLORS.panelDeep)
	root.AnchorPoint = Vector2.new(0.5, 1)
	-- 12.10. (Playtest "unter dem Start-Knopf liegt ein Knopf, den man nicht
	-- erkennt"): drei klare Zeilen statt Knopf + Balken nebeneinander —
	-- gruener Gratis-Start, darunter der bezahlte Einstieg ueber die ganze
	-- Breite (Text links, Preis rechts, nichts ueberlappt), unten der Balken.
	root.Size = UDim2.fromOffset(320, 126)
	root.Visible = false
	root.ZIndex = 6
	_root = root

	-- Ueber der Pet-Leiste, und mit ihr mitwandern: auf Touch-Geraeten sitzt
	-- sie nicht mittig, sondern im freien Streifen neben der Steuerung
	-- (TouchSafeArea), und ihr UIScale macht sie kleiner.
	local function follow()
		local barScale = anchorAbove:FindFirstChildOfClass("UIScale")
		local factor = if barScale then barScale.Scale else 1
		root.Position = UDim2.new(
			anchorAbove.Position.X.Scale, anchorAbove.Position.X.Offset,
			1, -(anchorAbove.Size.Y.Offset * factor + 26)
		)
	end
	anchorAbove:GetPropertyChangedSignal("Position"):Connect(follow)
	local barScale = anchorAbove:FindFirstChildOfClass("UIScale")
	if barScale then
		barScale:GetPropertyChangedSignal("Scale"):Connect(follow)
	end
	follow()

	-- Primaer: der Gratis-Start (gross, gruen)
	local fresh = Theme.bigButton("Fresh", root, Loc.t("ui.fight.fresh_free"), Theme.COLORS.good)
	fresh.Position = UDim2.new(0, 8, 0, 8)
	fresh.Size = UDim2.new(1, -16, 0, 46)
	fresh.TextColor3 = Theme.COLORS.text
	Theme.outlineText(fresh :: any, 2)
	Loc.bind(fresh, "ui.fight.fresh_free")
	fresh.Activated:Connect(function() finish("Fresh") end)

	-- Sekundaer: der bezahlte Einstieg (ganze Breite, ruhiger, kein Glanz)
	local resume = Theme.button("Resume", root, "", Theme.COLORS.panelLight)
	resume.Position = UDim2.new(0, 8, 0, 62)
	resume.Size = UDim2.new(1, -16, 0, 40)
	resume.TextColor3 = Theme.COLORS.text
	local shine = resume:FindFirstChild("Shine")
	if shine then shine:Destroy() end
	-- Beschriftung als eigenes Feld links, Preis rechts: feste Bereiche statt
	-- einer Polsterung, ueber die Preis und Text sich nicht ueberlappen koennen
	local resumeText = Theme.label("Text", resume, "")
	resumeText.AnchorPoint = Vector2.new(0, 0.5)
	resumeText.Position = UDim2.new(0, 10, 0.5, 0)
	resumeText.Size = UDim2.new(1, -110, 0, 26)
	resumeText.TextXAlignment = Enum.TextXAlignment.Left
	resumeText.TextScaled = true
	Theme.outlineText(resumeText, 2)
	_resumeText = resumeText
	resume.Activated:Connect(function()
		if resume.Active then finish("Last") end
	end)
	_resume = resume

	-- Kosten rechts im Knopf: Zahl + Gummi-Icon
	local coin = Icons.make(resume, "gummy", "G")
	coin.AnchorPoint = Vector2.new(1, 0.5)
	coin.Position = UDim2.new(1, -8, 0.5, 0)
	coin.Size = UDim2.fromOffset(24, 24)
	local cost = Theme.label("Cost", resume, "")
	cost.AnchorPoint = Vector2.new(1, 0.5)
	cost.Position = UDim2.new(1, -36, 0.5, 0)
	cost.Size = UDim2.fromOffset(58, 24)
	cost.TextXAlignment = Enum.TextXAlignment.Right
	Theme.outlineText(cost, 2)
	_cost = cost

	-- Ablaufbalken: zeigt, dass es gleich von selbst bei Stage 1 losgeht
	local track = Instance.new("Frame")
	track.Name = "Timer"
	track.BackgroundColor3 = Theme.COLORS.panelLight
	track.BorderSizePixel = 0
	track.Position = UDim2.new(0, 12, 0, 110)
	track.Size = UDim2.new(1, -24, 0, 8)
	track.Parent = root
	Theme.corner(track, 4)
	local bar = Instance.new("Frame")
	bar.BackgroundColor3 = Theme.COLORS.good
	bar.BorderSizePixel = 0
	bar.Size = UDim2.fromScale(1, 1)
	bar.Parent = track
	Theme.corner(bar, 4)
	_bar = bar

	RunService.RenderStepped:Connect(function()
		if not _onChoose then return end
		local left = math.clamp(1 - (os.clock() - _openedAt) / FightStartPrompt.AUTO_SECONDS, 0, 1)
		local b = _bar
		if b then b.Size = UDim2.fromScale(left, 1) end
	end)

end

return FightStartPrompt
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX34"><Properties>
<string name="Name">HatchPanel</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- HatchPanel.luau
-- StarterPlayerScripts/UI/HatchPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die Eier im Lager auflisten und per "Oeffnen" sofort oeffnen lassen
--
-- Seit v12 (Ei-Baum-Konzept, Block A) gibt es keine Brut-Slots, keine
-- Brutzeit und keine Preise mehr: das Menue ist nur noch eine Liste der Eier
-- im Lager. Ein Klick auf "Oeffnen" startet sofort die Ei-Animation
-- (HatchAnimation) und schickt die Anfrage an den Server, der allein
-- entscheidet, was herauskommt.
--
-- Eier kommen aus Legen, Events und Rebirth-Meilensteinen. Kaufen kann man
-- nur das Basis-Ei, und das nur beim versteckten Haendler in der Welt —
-- bewusst ohne Hinweis hier.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types     = require(ReplicatedStorage.Network.Types)
local Remotes   = require(ReplicatedStorage.Network.Remotes)
local EggConfig = require(ReplicatedStorage.Config.EggConfig)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local Names     = require(ReplicatedStorage.Localization.Names)
local EggTree   = require(ReplicatedStorage.Modules.EggTree)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)
local IncubatorRules = require(ReplicatedStorage.Modules.IncubatorRules)   -- Sammel-Update 8

local Theme          = require(script.Parent.Theme)
local PanelManager   = require(script.Parent.PanelManager)
local EggIcon        = require(script.Parent.EggIcon)
local HatchAnimation = require(script.Parent.HatchAnimation)
local ClientState    = require(script.Parent.Parent.Controllers.ClientState)

local HatchPanel = {}

local PANEL_NAME = "Hatch"
local EGG_HEIGHT = 92

local _root: Frame?              = nil
local _scroller: ScrollingFrame? = nil
local _signature = ""

--------------------------------------------------------------------------------
-- Reihenfolge der Eier
--------------------------------------------------------------------------------

-- Nach EggConfig.sortOrder: stabil (die Iteration ueber EggConfig.data waere
-- es nicht) und unabhaengig von der frueheren Brutdauer.
local function buildEggOrder(): { Types.EggType }
	local list: { Types.EggType } = {}
	for eggType in EggConfig.data do
		table.insert(list, eggType)
	end

	table.sort(list, function(a, b)
		local orderA = EggConfig.data[a].sortOrder or 999
		local orderB = EggConfig.data[b].sortOrder or 999
		if orderA ~= orderB then
			return orderA < orderB
		end
		return a < b
	end)

	return list
end

local EGG_ORDER = buildEggOrder()

--------------------------------------------------------------------------------
-- Zeilen bauen
--------------------------------------------------------------------------------

local function buildEggCard(parent: Instance, order: number, eggType: Types.EggType, stock: number)
	local def = EggConfig.data[eggType]

	local card = Theme.panel("Egg_" .. eggType, parent, Theme.COLORS.panel)
	card.Size        = UDim2.new(1, -8, 0, EGG_HEIGHT)
	card.LayoutOrder = order
	-- Bilderbuch-Rahmen (frames/frame_card); ohne Bild Waldgruen mit Honigrand
	Theme.ornate(card, "card", 0.4)

	-- Das Ei links auf einem kleinen Sockel, in Farbe und Muster seines Pfads
	-- (EggIcon), damit man die Sorte ohne Lesen erkennt. Es wackelt ab und
	-- zu, wie ein Ei, das gleich schluepfen will.
	local icon = EggIcon.make(card, eggType, 58, 3, { idle = true, pedestal = true })
	icon.Position = UDim2.fromOffset(16, 7)

	local name = Theme.label("Name", card, Names.egg(eggType))
	name.Position = UDim2.new(0, 76, 0, 12)
	name.Size     = UDim2.new(1, -212, 0, 22)
	name.TextColor3 = def.color:Lerp(Color3.new(1, 1, 1), 0.3)
	Theme.outlineText(name, 2)

	-- v14: ein noch gesperrtes Ei im Lager ist ein Sprung-Ei aus einem Event.
	local data = ClientState.get()
	local locked = data ~= nil and not EggTree.isUnlocked(data.eggTree, eggType)
	local desc = Theme.bodyText("Desc", card, if locked then Loc.t("ui.tree.jump_hint") else Names.eggDesc(eggType))
	desc.Position = UDim2.new(0, 76, 0, 36)
	desc.Size     = UDim2.new(1, -212, 0, 44)
	desc.TextColor3 = Theme.COLORS.cream

	local count = Theme.label("Count", card, "x" .. stock)
	count.Position       = UDim2.new(1, -136, 0, 10)
	count.Size           = UDim2.new(0, 116, 0, 22)
	count.TextXAlignment = Enum.TextXAlignment.Right
	count.TextColor3     = Theme.COLORS.honey
	Theme.outlineText(count, 2)

	-- Sammel-Update 05.10. (Paket 8): Eier ab Gold-Stufe gehen in den
	-- Inkubator statt sofort auf (gleiche Regel wie der Server).
	local toIncubator = FeatureFlags.isOn("INCUBATOR") and not FeatureFlags.isOn("INCUBATOR_BREED") and data ~= nil
		and IncubatorRules.requiresIncubator(eggType, IncubatorRules.isUnlocked(data))
	-- "Oeffnen" als Honigtropfen-Siegel
	local button = Theme.sealButton("Open", card,
		if toIncubator then Loc.t("ui.hatch.to_incubator") else Loc.t("ui.hatch.open"))
	button.Position = UDim2.new(1, -138, 0, 40)
	button.Size     = UDim2.new(0, 120, 0, 36)

	button.Activated:Connect(function()
		if toIncubator then
			Remotes.RequestIncubatorStart:FireServer(eggType)
			PanelManager.open("Incubator")
			return
		end
		-- Animation zuerst: der Klick soll sich sofort anfuehlen. Was
		-- herauskommt, kommt trotzdem ausschliesslich vom Server.
		HatchAnimation.request(eggType)
		Remotes.RequestHatchEgg:FireServer(eggType)
	end)
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

function HatchPanel.refresh()
	local scroller = _scroller
	local root     = _root
	if not scroller or not root then return end
	if not root.Visible then return end

	local data = ClientState.get()
	if not data then return end

	-- Sammel-Update 1.3-Muster: nur neu bauen, wenn sich das Lager (oder die
	-- Sprache) aendert — sonst zerstoert jeder Datenstand den Knopf unter dem
	-- Finger, und der Tipp kommt nicht an.
	local parts = { Loc.getLanguage(), tostring(IncubatorRules.isUnlocked(data)) }
	for _, eggType in EGG_ORDER do
		local n = data.island.eggStock[eggType] or 0
		if n > 0 then table.insert(parts, eggType .. n) end
	end
	local signature = table.concat(parts, "|")
	if signature == _signature then return end
	_signature = signature

	for _, child in scroller:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	local shown = 0
	for order, eggType in EGG_ORDER do
		local stock = data.island.eggStock[eggType] or 0
		if stock > 0 then
			buildEggCard(scroller, order, eggType, stock)
			shown += 1
		end
	end

	if shown == 0 then
		local empty = Theme.bodyText("Empty", scroller, Loc.t("ui.hatch.empty"))
		empty.Size        = UDim2.new(1, -8, 0, 60)
		empty.LayoutOrder = 1
	end
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local root = _root
	if not root then return end

	root.Visible = true
	_signature = ""
	HatchPanel.refresh()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function HatchPanel.init(screenGui: ScreenGui)
	HatchAnimation.init(screenGui)

	local root = Theme.dialog(
		"HatchPanel", screenGui,
		Vector2.new(0.52, 0.68),
		Vector2.new(320, 320),
		Vector2.new(560, 600)
	)
	_root = root

	local header = Theme.dialogHeader(root, Loc.t("ui.menu.eggs"), function()
		PanelManager.close(PANEL_NAME)
	end)

	-- v14: Knopf zum Ei-Baum (Presse, Freischaltung, Drop-Vorschau)
	local treeButton = Theme.button("TreeButton", header.Parent :: Instance, Loc.t("ui.menu.tree"), Theme.COLORS.growth)
	treeButton.AnchorPoint = Vector2.new(1, 0.5)
	-- 12.10. (Playtest): klebte direkt am X (X: 44 breit, ragt 4 hinaus,
	-- Trefferflaeche 56). Jetzt 12 Luft bis zur Trefferflaeche des X.
	treeButton.Position = UDim2.new(1, -58, 0.5, 0)
	treeButton.Size = UDim2.new(0, 92, 0, 26)
	treeButton.Activated:Connect(function()
		PanelManager.open("EggTree")
	end)
	Loc.onChanged(function()
		treeButton.Text = Loc.t("ui.menu.tree")
		header.Text = Loc.t("ui.menu.eggs")
		HatchPanel.refresh()
	end)

	local body     = Theme.dialogBody(root)
	-- Bilderbuch-Rahmen wie der Ei-Baum (Theme.ornateDialog)
	Theme.ornateDialog(root)
	local scroller = Theme.scroller("List", body)
	scroller.Size = UDim2.fromScale(1, 1)
	_scroller = scroller

	local layout = Theme.listLayout(scroller, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	-- Neue Serverdaten: Lagerbestand neu zeichnen. Nur wenn sichtbar.
	ClientState.onChanged(function()
		HatchPanel.refresh()
	end)

	Remotes.HatchResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		HatchAnimation.deliver(result :: Types.HatchResult)
	end)

	-- Abgelehnt (z.B. Lager inzwischen leer): die Animation ohne Ergebnis
	-- beenden. Die Meldung selbst zeigt der Toast (ActionFailed).
	Remotes.ActionFailed.OnClientEvent:Connect(function(action: any, reason: any)
		if action == "RequestHatchEgg" then
			HatchAnimation.reject(tostring(reason))
		end
	end)

	print("[HatchPanel] Initialisiert")
end

return HatchPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX35"><Properties>
<string name="Name">TowerPanel</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- TowerPanel.luau
-- StarterPlayerScripts/UI/TowerPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Das Tower-Fenster im neuen Look (08.10., Paket D, FeatureFlags.
--     TOWER_PANEL_V2): Tower waehlen (Karten mit Zustand AKTIV / WAEHLEN /
--     NEU / GESPERRT) und von hier aus losschicken (Einstiegsleiste mit
--     Gratis-Start, bezahltem Skip und Gamepass-Knopf).
--
-- Geoeffnet vom Tower-Terminal an der Bruecke (Hauptweg), vom Prompt an der
-- Arena, vom Antippen des Tower-Namens in der Pet-Leiste. Es meldet sich
-- unter dem Namen "Combat" an (PanelManager.ARENA_PANEL) — alle bisherigen
-- Wege zur Tower-Wahl landen damit hier. Lauf-Ergebnis- und Meilenstein-
-- Meldungen bleiben im CombatPanel (die laufen auch bei geschlossenem
-- Fenster).
--
-- Gebaut ausschliesslich aus UI/Kit (Tokens Theme.v2). Der Server prueft
-- alles selbst (offen? bezahlbar? Pass?); die Karten rechnen mit denselben
-- Funktionen aus TowerConfig nur fuer die Anzeige.
--
-- Hierarchie (Kinder 7-14): der Blick soll zuerst auf den GRATIS-Start
-- fallen — groesster Knopf, kraeftigste Farbe, als einziges Element mit Puls.
-- Der bezahlte Skip ist klein, cremefarben, ohne Glanz und Puls. Keine
-- falschen Countdowns, nichts versteckt.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types          = require(ReplicatedStorage.Network.Types)
local Remotes        = require(ReplicatedStorage.Network.Remotes)
local Loc            = require(ReplicatedStorage.Localization.Loc)
local TowerConfig    = require(ReplicatedStorage.Config.TowerConfig)
local GamepassConfig = require(ReplicatedStorage.Config.GamepassConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)

local Theme           = require(script.Parent.Theme)
local Kit             = require(script.Parent.Kit)
local Icons           = require(script.Parent.Icons)
local Notify          = require(script.Parent.Notify)
local Moment          = require(script.Parent.Moment)
local Toast           = require(script.Parent.Toast)
local PanelManager    = require(script.Parent.PanelManager)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local ClientState     = require(script.Parent.Parent.Controllers.ClientState)

local TowerPanel = {}

local T = Kit.T
local PANEL_NAME = PanelManager.ARENA_PANEL   -- "Combat"
local PASS_KEY   = "SKIP_PASS"

-- Masse (Oberflaechen-Einheiten, 8er-Raster)
local DESIGN     = Vector2.new(640, 688)
local MIN_HEIGHT = 316   -- Kopf + eine Karte + Leiste (kompakt)
local HEADER_H   = 84
local STATUS_H   = 40
local FOOTER_H   = 140
-- Kompakt (niedrige Bildschirme, Handy quer): kleinerer Kopf, ohne
-- Statuszeile und ohne die erste Leisten-Zeile (Gummies stehen ohnehin im
-- HUD); die Liste scrollt. Ab dieser Fensterhoehe:
local COMPACT_BELOW = 520
local HEADER_H_COMPACT = 60
local FOOTER_H_COMPACT = 104
local CARD_H     = 116
local PAD        = T.space.m
local BADGE      = 80
local RIGHT_W    = 140
-- Freie Raender: oben HUD-Luft, unten Pet-Leiste (68 + Abstand), rechts
-- Menueleiste (Kacheln bis 94 + Rand), links etwas Luft. Auf kurzen
-- Bildschirmen (Handy quer) stehen HUD-Pillen und Menueleiste neben dem
-- Fenster: dort links/rechts mehr Platz lassen, oben weniger.
local function reserve(screen: Vector2): Kit.Reserve
	if screen.Y < COMPACT_BELOW then
		return { top = 6, bottom = 90, left = 196, right = 84 }
	end
	-- Schmalere Bildschirme (Tablet, 1366): links an den HUD-Pillen vorbei
	local left = if screen.X < 1400 then 196 else 12
	return { top = 12, bottom = 96, left = left, right = 112 }
end
local _compact = false

type CardView = {
	def      : TowerConfig.TowerDef,
	card     : Kit.Card,
	badge    : Frame,
	lockIcon : GuiObject,
	title    : TextLabel,
	progress : Kit.Progress,
	reward   : TextLabel,
	rewardIcon : Frame,
	choose   : Kit.Button,
	active   : Frame,
	newBadge : Frame,
	lockChip : Frame,
	lockBar  : Kit.Progress,
	glimmer  : Frame,
	state    : string,
}

local _window: Kit.Window? = nil
local _status: { selected: Frame, record: Frame, nextOpen: Frame }? = nil
local _list: ScrollingFrame? = nil
local _cards: { [string]: CardView } = {}
local _order: { string } = {}
local _footer: Frame? = nil
local _gummyChip: Frame? = nil
local _hint: TextLabel? = nil
local _primary: Kit.Button? = nil
local _skip: Kit.Button? = nil
local _premium: Kit.Button? = nil
local _freeBadge: Frame? = nil
local _stopPulse: (() -> ())? = nil
local _stopLoop: (() -> ())? = nil
local _isOpen = false
local _petState = "Home"

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function towerName(id: string): string
	return Loc.t("tower." .. id .. ".name")
end

local function hasPass(): boolean
	return Players.LocalPlayer:GetAttribute(GamepassConfig.attributeName(PASS_KEY)) == true
end

local function cardState(def: TowerConfig.TowerDef, data: Types.PlayerDataUpdate): string
	local towers = data.towers
	if not towers then return if def.id == TowerConfig.FIRST_TOWER then "active" else "locked" end
	local open = TowerConfig.isOpen(data.rebirthCount, def.id, TowerConfig.unlockRecords(towers, data.island), (towers :: any).unlocked)
	if not open then return "locked" end
	if towers.selected == def.id then return "active" end
	if TowerConfig.isNew(def.id, towers :: any) then return "new" end
	return "open"
end

-- Naechster Meilenstein als (Icon-Name, Rueckfall, Text) fuer die Karte.
local function rewardHint(def: TowerConfig.TowerDef, data: Types.PlayerDataUpdate): (string?, string?, string?)
	local towers = data.towers
	local record = if towers then towers.records[def.id] or 0 else 0
	local claimed = if towers then towers.claimed[def.id] else nil
	local stage = TowerConfig.nextMilestoneStage(def.id, claimed, record + 1)
	if not stage then return nil, nil, nil end
	local m = TowerConfig.getMilestone(def.id, stage)
	if not m then return nil, nil, nil end
	if m.eggs > 0 then
		return "egg", "🥚", Loc.t("ui.tower2.reward_egg", { stage = stage, n = m.eggs })
	elseif m.goldGummies > 0 then
		return "goldgummy", "$", Loc.t("ui.tower2.reward_amount", { stage = stage, n = Theme.formatNumber(m.goldGummies) })
	elseif m.endlessLevels > 0 then
		return "trophy", "★", Loc.t("ui.tower2.reward_endless", { stage = stage, n = m.endlessLevels })
	end
	return "gummy", "G", Loc.t("ui.tower2.reward_amount", { stage = stage, n = Theme.formatNumber(m.gummies) })
end

--------------------------------------------------------------------------------
-- Karte
--------------------------------------------------------------------------------

local function buildCard(parent: Instance, def: TowerConfig.TowerDef, order: number): CardView
	local card = Kit.card("Tower_" .. def.id, parent, CARD_H)
	card.holder.LayoutOrder = order
	local face = card.face
	local endless = def.id == "Endless"
	if endless then
		-- Endless: besondere Karte in Rosa/Lila
		Kit.gradient(face, Color3.fromRGB(255, 236, 248), Color3.fromRGB(240, 214, 255))
	end

	local badge = Kit.towerBadge("Badge", face, def.look, def.color, def.numeral, BADGE)
	badge.AnchorPoint = Vector2.new(0, 0.5)
	badge.Position = UDim2.new(0, 14, 0.5, -1)

	local lockIcon = Kit.lockIcon(badge, 34)
	lockIcon.AnchorPoint = Vector2.new(1, 1)
	lockIcon.Position = UDim2.new(1, 8, 1, 8)
	lockIcon.ZIndex = 38

	local left = 14 + BADGE + 14
	local title = Kit.text("Title", face, towerName(def.id), T.text.cardTitle)
	title.Position = UDim2.fromOffset(left, 10)
	title.Size = UDim2.new(1, -(left + RIGHT_W + 12), 0, 30)
	title.ZIndex = 32

	local progress = Kit.progress("Record", face, 26)
	progress.track.Position = UDim2.fromOffset(left, 46)
	progress.track.Size = UDim2.new(1, -(left + RIGHT_W + 16), 0, 26)

	local rewardIcon = Kit.frame("RewardIcon", face)
	rewardIcon.Position = UDim2.fromOffset(left, 80)
	rewardIcon.Size = UDim2.fromOffset(24, 24)
	rewardIcon.ZIndex = 32
	local reward = Kit.text("Reward", face, "", T.text.small + 1, { color = T.color.inkSoft })
	reward.Position = UDim2.fromOffset(left + 30, 80)
	reward.Size = UDim2.new(1, -(left + 30 + RIGHT_W + 12), 0, 24)
	reward.ZIndex = 32

	-- Rechts: Waehlen-Knopf ...
	local choose = Kit.button("Choose", face, "choose", Loc.t("ui.tower2.choose"), 24)
	choose.button.AnchorPoint = Vector2.new(1, 0.5)
	choose.button.Position = UDim2.new(1, -14, 0.5, 0)
	choose.button.Size = UDim2.fromOffset(RIGHT_W - 8, 64)
	choose.button.Activated:Connect(function()
		if not choose.button.Active then return end
		Kit.playSound("select")
		Remotes.RequestSelectTower:FireServer(def.id)
	end)

	-- ... oder AKTIV-Band ...
	local active = Kit.badge("Active", face, Loc.t("ui.tower2.active"), T.color.active, 0)
	active.AnchorPoint = Vector2.new(1, 0.5)
	active.Position = UDim2.new(1, -18, 0.5, 0)
	active.Size = UDim2.fromOffset(0, 40)
	local activeLabel = active:FindFirstChild("Text") :: TextLabel
	activeLabel.TextSize = 22

	-- ... oder Fortschritt zur Freischaltung
	local lockChip = Kit.frame("LockInfo", face)
	lockChip.AnchorPoint = Vector2.new(1, 0.5)
	lockChip.Position = UDim2.new(1, -14, 0.5, 0)
	lockChip.Size = UDim2.fromOffset(RIGHT_W, 68)
	lockChip.ZIndex = 32
	local lockText = Kit.text("Text", lockChip, "", T.text.small + 1, { color = T.color.ink, align = Enum.TextXAlignment.Center, wrap = true })
	lockText.Size = UDim2.new(1, 0, 0, 36)
	lockText.ZIndex = 33
	local lockBar = Kit.progress("Bar", lockChip, 24, T.color.honey)
	lockBar.track.Position = UDim2.fromOffset(0, 40)

	-- NEU-Aufkleber oben links (schraeg) und Glanz fuer frisch freie Karten
	local newBadge = Kit.badge("New", card.holder, Loc.t("ui.tower2.new"), T.color.new, -10)
	newBadge.Position = UDim2.fromOffset(46, 4)
	newBadge.ZIndex = 45
	local newLabel = newBadge:FindFirstChild("Text") :: TextLabel
	newLabel.ZIndex = 46

	local glimmer = Kit.frame("Glimmer", face, T.color.white)
	glimmer.Size = UDim2.new(0.22, 0, 1, 0)
	glimmer.Rotation = 18
	glimmer.BackgroundTransparency = 0.6
	glimmer.ZIndex = 31
	glimmer.Visible = false
	local glimmerFade = Instance.new("UIGradient")
	glimmerFade.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1),
	})
	glimmerFade.Parent = glimmer
	face.ClipsDescendants = false

	return {
		def = def, card = card, badge = badge, lockIcon = lockIcon, title = title,
		progress = progress, reward = reward, rewardIcon = rewardIcon, choose = choose,
		active = active, newBadge = newBadge, lockChip = lockChip, lockBar = lockBar,
		glimmer = glimmer, state = "",
	}
end

local function refreshCard(view: CardView, data: Types.PlayerDataUpdate)
	local def = view.def
	local towers = data.towers
	local state = cardState(def, data)
	view.state = state
	local record = if towers then towers.records[def.id] or 0 else 0
	local endless = def.id == "Endless"

	view.title.Text = if endless
		then towerName(def.id)
		else Loc.t("ui.tower2.title_stages", { tower = towerName(def.id), stages = def.stages })

	local locked = state == "locked"
	view.lockIcon.Visible = locked
	view.choose.button.Visible = state == "open" or state == "new"
	view.active.Visible = state == "active"
	view.newBadge.Visible = state == "new"
	view.lockChip.Visible = locked
	view.glimmer.Visible = state == "new"

	-- Rekord-Balken (Endless: ohne Ende, Balken zeigt das naechste Zehnerziel)
	if endless then
		local goal = math.max(10, (math.floor(record / 10) + 1) * 10)
		view.progress.set(record / goal, Loc.t("ui.tower2.record_endless", { record = record }))
	else
		view.progress.set(record / def.stages, Loc.t("ui.tower2.record", { record = record, stages = def.stages }))
	end
	view.progress.track.Visible = not locked or record > 0

	-- Meilenstein
	for _, child in view.rewardIcon:GetChildren() do child:Destroy() end
	local iconName, fallback, text = rewardHint(def, data)
	if iconName and text and not locked then
		local icon = Icons.make(view.rewardIcon, iconName, fallback)
		icon.Size = UDim2.fromScale(1, 1)
		icon.ZIndex = 33
		view.reward.Text = text
		view.reward.Visible = true
	else
		view.reward.Visible = locked
		view.reward.Text = if locked then "🔒 " .. Loc.t("ui.tower2.locked_hint") else ""
	end
	-- Gesperrt: Hinweis in die Mitte der Karte (dort stuende sonst der Balken)
	view.reward.Position = UDim2.fromOffset(14 + BADGE + 14 + (if locked then 0 else 30), if locked then 48 else 80)

	-- Gesperrt: gedaempft, aber lesbar
	if locked then
		local prev, have, need = TowerConfig.getUnlockProgress(def.id, TowerConfig.unlockRecords(towers, data.island))
		local lockText = view.lockChip:FindFirstChild("Text") :: TextLabel
		lockText.Text = if prev
			then Loc.t("ui.tower2.unlock_by", { tower = towerName(prev) })
			else ""
		view.lockBar.set(if need > 0 then have / need else 0, string.format("%d/%d", have, need))
		Kit.gradient(view.card.face, T.color.cardLocked, T.color.sunk)
		Kit.gradient(view.badge, Theme.shade(def.color, 0.1):Lerp(T.color.lock, 0.6), T.color.lock)
	else
		if endless then
			Kit.gradient(view.card.face, Color3.fromRGB(255, 236, 248), Color3.fromRGB(240, 214, 255))
		else
			Kit.gradient(view.card.face, T.color.card, T.color.surface)
		end
		Kit.gradient(view.badge, Theme.shade(def.color, 0.35), Theme.shade(def.color, -0.12))
	end

	view.card.stroke.Color = if state == "active" then T.color.honeyBottom else T.color.outline
	view.card.stroke.Thickness = if state == "active" then T.stroke.card + 2 else T.stroke.card
	view.choose.label.Text = Loc.t("ui.tower2.choose")
	view.choose.setEnabled(true)
	local activeLabel = view.active:FindFirstChild("Text")
	if activeLabel and activeLabel:IsA("TextLabel") then activeLabel.Text = "✔ " .. Loc.t("ui.tower2.active") end
	local newLabel = view.newBadge:FindFirstChild("Text")
	if newLabel and newLabel:IsA("TextLabel") then newLabel.Text = Loc.t("ui.tower2.new") end
end

--------------------------------------------------------------------------------
-- Status und Einstiegsleiste
--------------------------------------------------------------------------------

local function refreshStatus(data: Types.PlayerDataUpdate)
	local status = _status
	if not status then return end
	local towers = data.towers
	local selected = if towers then towers.selected else TowerConfig.FIRST_TOWER
	local def = TowerConfig.get(selected) or TowerConfig.TOWERS[1]
	local record = if towers then towers.records[selected] or 0 else 0
	Kit.setChip(status.selected, Loc.t("ui.tower2.status_selected", { tower = towerName(selected) }))
	Kit.setChip(status.record, if def.id == "Endless"
		then Loc.t("ui.tower2.record_endless", { record = record })
		else Loc.t("ui.tower2.record", { record = record, stages = def.stages }))
	-- Naechste Freischaltung
	local nextText = Loc.t("ui.tower2.status_all_open")
	for _, other in TowerConfig.TOWERS do
		if not TowerConfig.isOpen(data.rebirthCount, other.id, TowerConfig.unlockRecords(towers, data.island), if towers then (towers :: any).unlocked else nil) then
			local prev, have, need = TowerConfig.getUnlockProgress(other.id, TowerConfig.unlockRecords(towers, data.island))
			if prev then
				nextText = Loc.t("ui.tower2.status_next", { tower = towerName(other.id), have = have, need = need })
			end
			break
		end
	end
	Kit.setChip(status.nextOpen, nextText)
end

-- Ordnet die Einstiegsleiste je nach Lage: mit/ohne gespeichertem Lauf,
-- mit/ohne Pass. Primaer ist immer der breiteste Knopf.
local function layoutFooter(showSkip: boolean, passOwned: boolean, footerWidth: number)
	local primary, skip, premium = _primary, _skip, _premium
	if not primary or not skip or not premium then return end
	local gap = T.space.s
	local inner = footerWidth - PAD * 2
	if passOwned and showSkip then
		-- Pass: Skip und Pass verschmelzen zu EINEM goldenen Knopf
		skip.button.Visible = false
		premium.button.Visible = true
		local w = math.floor(inner * 0.42)
		primary.button.Size = UDim2.fromOffset(inner - w - gap, 76)
		premium.button.Size = UDim2.fromOffset(w, 64)
		premium.button.Position = UDim2.new(0, PAD + inner - w, 1, -PAD - 64)
	elseif showSkip then
		skip.button.Visible = true
		premium.button.Visible = true
		local wSkip, wPrem = 160, 148
		primary.button.Size = UDim2.fromOffset(inner - wSkip - wPrem - gap * 2, 76)
		skip.button.Size = UDim2.fromOffset(wSkip, 64)
		skip.button.Position = UDim2.new(0, PAD + inner - wSkip - wPrem - gap, 1, -PAD - 64)
		premium.button.Size = UDim2.fromOffset(wPrem, 64)
		premium.button.Position = UDim2.new(0, PAD + inner - wPrem, 1, -PAD - 64)
	else
		skip.button.Visible = false
		premium.button.Visible = true
		local wPrem = 148
		primary.button.Size = UDim2.fromOffset(inner - wPrem - gap, 76)
		premium.button.Size = UDim2.fromOffset(wPrem, 64)
		premium.button.Position = UDim2.new(0, PAD + inner - wPrem, 1, -PAD - 64)
	end
	primary.button.Position = UDim2.new(0, PAD, 1, -PAD - 76)
end

local function refreshFooter(data: Types.PlayerDataUpdate)
	local primary, skip, premium, gummyChip, hint = _primary, _skip, _premium, _gummyChip, _hint
	local window = _window
	if not primary or not skip or not premium or not gummyChip or not hint or not window then return end

	Kit.setChip(gummyChip, Theme.formatNumber(data.gummies))

	local running = _petState == "ToPit" or _petState == "InPit"
	local reached = PitResumeDialog.getProgress(data)
	local showSkip = reached ~= nil and reached > 1 and not running
	local stage, price = 1, 0
	if showSkip then
		stage, price = PitResumeDialog.offer(data, "Last")
	end
	local passOwned = hasPass()
	local passReady = GamepassConfig.isReady(PASS_KEY)

	-- Primaer: Gratis-Start (die tatsaechliche freie Stage: immer 1,
	-- Entscheidung 05.10.)
	primary.label.Text = if running then Loc.t("ui.tower2.running") else Loc.t("ui.tower2.start")
	primary.sub.Text = if running then "" else Loc.t("ui.tower2.start_sub", { stage = 1 })
	primary.sub.Visible = not running
	primary.label.Size = UDim2.new(1, -20, 0, 34)
	primary.label.Position = UDim2.new(0.5, 0, 0, if running then 22 else 8)
	primary.label.AnchorPoint = Vector2.new(0.5, 0)
	primary.setEnabled(not running)
	if _freeBadge then _freeBadge.Visible = not running end

	-- Sekundaer: bezahlter Einstieg ab der letzten Stage
	skip.label.Text = Loc.t("ui.tower2.skip", { stage = stage })
	skip.sub.Text = Loc.t("ui.tower2.price", { price = Kit.formatCompact(price) })
	skip.sub.Visible = true
	skip.setEnabled(price <= data.gummies)

	-- Premium / Pass
	if passOwned and showSkip then
		premium.label.Text = Loc.t("ui.tower2.skip", { stage = stage })
		premium.sub.Text = Loc.t("ui.tower2.pass_free")
		premium.setEnabled(true)
	else
		premium.label.Text = "👑 " .. Loc.t("ui.pass.skip.name")
		premium.sub.Text = if passOwned then Loc.t("ui.tower2.pass_owned")
			elseif passReady then Loc.t("ui.tower2.pass_buy")
			else Loc.t("ui.pass.soon")
		premium.setEnabled(not passOwned)
	end
	premium.sub.Visible = true

	hint.Text = if running then Loc.t("ui.tower2.hint_running") else Loc.t("ui.tower2.hint_free")

	local size = window.root.Size
	layoutFooter(showSkip, passOwned, size.X.Offset)
end

function TowerPanel.refresh()
	if not _isOpen then return end
	local data = ClientState.get()
	if not data then return end
	refreshStatus(data)
	for _, view in _cards do
		refreshCard(view, data)
	end
	refreshFooter(data)
end

--------------------------------------------------------------------------------
-- Bewegung (eine Schleife, solange das Fenster offen ist)
--------------------------------------------------------------------------------

local function startLoop()
	if _stopLoop then return end
	local t0 = os.clock()
	_stopLoop = Kit.animate(function(now)
		local t = now - t0
		-- Glanz ueber neue Karten (sanft, alle ~2,6 s)
		local phase = (t % T.motion.glimmer) / T.motion.glimmer
		for _, view in _cards do
			if view.glimmer.Visible then
				view.glimmer.Position = UDim2.new(-0.3 + phase * 1.6, 0, 0, 0)
				view.glimmer.BackgroundTransparency = 0.55 + 0.45 * math.abs(phase - 0.5) * 2
			end
			if view.newBadge.Visible then
				view.newBadge.Rotation = -10 + math.sin(t * 4) * 4
			end
		end
		return true
	end)
end

local function stopLoop()
	if _stopLoop then _stopLoop() end
	_stopLoop = nil
	if _stopPulse then _stopPulse() end
	_stopPulse = nil
end

-- Karten laufen gestaffelt ein (von rechts, leicht vergroessert)
local function staggerCards()
	for index, id in _order do
		local view = _cards[id]
		local face = view.card.face
		face.Position = UDim2.fromOffset(4 + 40, 0)
		local delay = (index - 1) * T.motion.stagger
		task.delay(delay, function()
			if not _isOpen then
				face.Position = UDim2.fromOffset(4, 0)
				return
			end
			Kit.tween(face, T.motion.cardIn, { Position = UDim2.fromOffset(4, 0) }, Enum.EasingStyle.Back)
		end)
	end
end

local function scrollToSelected()
	local list, data = _list, ClientState.get()
	if not list or not data or not data.towers then return end
	local index = table.find(_order, data.towers.selected) or 1
	local y = math.max(0, (index - 2) * (CARD_H + T.space.s))
	list.CanvasPosition = Vector2.new(0, y)
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local window = _window
	if not window then return end
	local refit = (window :: any).refit
	if refit then refit() end
	window.root.Visible = true
	_isOpen = true
	TowerPanel.refresh()
	scrollToSelected()
	Kit.popIn(window)
	staggerCards()
	startLoop()
	local primary = _primary
	if primary and not _stopPulse then
		_stopPulse = Kit.pulse(primary.face, 0.05)
	end
end

local function closeInternal()
	local window = _window
	if window then window.root.Visible = false end
	_isOpen = false
	stopLoop()
end

function TowerPanel.isOpen(): boolean
	return _isOpen
end

-- Fuer die Fuehrung (GuideController): der Waehlen-Knopf des ersten neuen Towers.
function TowerPanel.getGuideTarget(): GuiObject?
	if not _isOpen then return nil end
	for _, id in _order do
		local view = _cards[id]
		if view.state == "new" then
			return view.choose.button
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Freischalt-Moment
--------------------------------------------------------------------------------

local function onUnlocked(towerId: string)
	local def = TowerConfig.get(towerId)
	if not def then return end
	Kit.playSound("unlock")
	Notify.emit("tower_unlocked", function()
		Toast.success(Loc.t("msg.tower_unlocked", { tower = towerName(towerId) }))
	end, function()
		Moment.show("tower_unlocked", def.color, "ui.moment.tower_unlocked")
	end)
	local view = _cards[towerId]
	local window = _window
	if _isOpen and view and window then
		TowerPanel.refresh()
		local face = view.card.face
		local rel = face.AbsolutePosition - window.body.AbsolutePosition
		-- AbsolutePosition sind Pixel; der Koerper ist mit FitScale und der
		-- globalen UiScale skaliert — fuer das Konfetti grob zurueckrechnen.
		local scale = window.body.AbsoluteSize.X / math.max(1, window.root.Size.X.Offset)
		Kit.confetti(window.content, Vector2.new(rel.X / scale + 60, rel.Y / scale + 40), 26)
	end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function TowerPanel.init(screenGui: ScreenGui)
	if not FeatureFlags.isOn("TOWER_PANEL_V2") then return end

	local window = Kit.window("TowerPanel", screenGui, {
		design = DESIGN, minHeight = MIN_HEIGHT, reserve = reserve,
	})
	_window = window
	Kit.mascot(window, 74)
	local title = Kit.header(window, Loc.t("ui.tower.title"), HEADER_H)
	Loc.bind(title, "ui.tower.title")
	Kit.closeButton(window, function()
		PanelManager.close(PANEL_NAME)
	end)

	local content = window.content

	-- Statuszeile
	local statusRow = Kit.frame("Status", content)
	statusRow.Position = UDim2.fromOffset(PAD, HEADER_H + 10)
	statusRow.Size = UDim2.new(1, -PAD * 2, 0, STATUS_H - 8)
	statusRow.ZIndex = 30
	local statusLayout = Instance.new("UIListLayout")
	statusLayout.FillDirection = Enum.FillDirection.Horizontal
	statusLayout.Padding = UDim.new(0, T.space.s)
	statusLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	statusLayout.SortOrder = Enum.SortOrder.LayoutOrder
	statusLayout.Parent = statusRow
	local selectedChip = Kit.chip("Selected", statusRow, "", T.color.honeyTop)
	selectedChip.LayoutOrder = 1
	local recordChip = Kit.chip("Record", statusRow, "")
	recordChip.LayoutOrder = 2
	local nextChip = Kit.chip("Next", statusRow, "")
	nextChip.LayoutOrder = 3
	_status = { selected = selectedChip, record = recordChip, nextOpen = nextChip }

	-- Kartenliste
	local list = Kit.scroller("List", content)
	_list = list
	local listPad = Instance.new("UIPadding")
	listPad.PaddingTop = UDim.new(0, 14)   -- Platz fuer den NEU-Aufkleber
	listPad.PaddingRight = UDim.new(0, 10)
	listPad.Parent = list
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, T.space.s + 2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	for order, def in TowerConfig.TOWERS do
		_cards[def.id] = buildCard(list, def, order)
		table.insert(_order, def.id)
	end

	-- Einstiegsleiste
	local footer = Kit.frame("Footer", content, T.color.white)
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Position = UDim2.fromScale(0, 1)
	footer.Size = UDim2.new(1, 0, 0, FOOTER_H)
	footer.ZIndex = 31
	Kit.corner(footer, T.radius.panel)
	Kit.gradient(footer, T.color.surfaceDeep, Theme.shade(T.color.surfaceDeep, -0.06))
	_footer = footer
	local footerTop = Kit.frame("FooterTop", footer, T.color.white)
	footerTop.Size = UDim2.new(1, 0, 0, T.radius.panel)
	footerTop.ZIndex = 31
	Kit.gradient(footerTop, T.color.surfaceDeep, T.color.surfaceDeep)
	local footerLine = Kit.frame("FooterLine", footer, T.color.outline)
	footerLine.Size = UDim2.new(1, 0, 0, T.stroke.card)
	footerLine.ZIndex = 32

	-- Zeile 1: Gummy-Stand und ein ehrlicher Satz zum Gratis-Start
	local gummyChip = Kit.chip("Gummies", footer, "0", T.color.white)
	gummyChip.Position = UDim2.fromOffset(PAD, 10)
	-- Icon links in der Pille (die Polsterung macht ihm Platz)
	local gummyPad = gummyChip:FindFirstChildOfClass("UIPadding")
	if gummyPad then gummyPad.PaddingLeft = UDim.new(0, 36) end
	local gummyIcon = Icons.make(gummyChip, "gummy", "G")
	gummyIcon.Size = UDim2.fromOffset(28, 28)
	gummyIcon.AnchorPoint = Vector2.new(0, 0.5)
	gummyIcon.Position = UDim2.new(0, -32, 0.5, 0)
	gummyIcon.ZIndex = 34
	_gummyChip = gummyChip

	local hint = Kit.text("Hint", footer, "", T.text.small, { color = T.color.inkSoft, align = Enum.TextXAlignment.Right })
	hint.AnchorPoint = Vector2.new(1, 0)
	hint.Position = UDim2.new(1, -PAD, 0, 10)
	hint.Size = UDim2.new(0.6, 0, 0, 30)
	hint.ZIndex = 33
	_hint = hint

	-- Zeile 2: die drei Einstiege
	local primary = Kit.button("Start", footer, "primary", Loc.t("ui.tower2.start"), 30)
	primary.sub.Visible = true
	primary.sub.Size = UDim2.new(1, -20, 0, 20)
	primary.button.Activated:Connect(function()
		if not primary.button.Active then return end
		Kit.playSound("click")
		Remotes.RequestPetMode:FireServer("Fight", "Fresh")
		PanelManager.close(PANEL_NAME)
	end)
	_primary = primary
	local freeBadge = Kit.badge("Free", primary.button, Loc.t("ui.tower2.free"), T.color.gummy, 8)
	-- Oben rechts INNERHALB des Knopfs: links steht die Gummy-Pille, rechts
	-- daneben der naechste Knopf, in der Mitte die Beschriftung.
	freeBadge.AnchorPoint = Vector2.new(1, 0.5)
	freeBadge.Position = UDim2.new(1, -10, 0, 2)
	freeBadge.ZIndex = 44
	local freeLabel = freeBadge:FindFirstChild("Text") :: TextLabel
	freeLabel.ZIndex = 45
	_freeBadge = freeBadge

	local skip = Kit.button("Skip", footer, "secondary", "", 20)
	skip.label.Size = UDim2.new(1, -12, 0, 24)
	skip.label.AnchorPoint = Vector2.new(0.5, 0)
	skip.label.Position = UDim2.new(0.5, 0, 0, 6)
	skip.sub.Size = UDim2.new(1, -12, 0, 20)
	skip.button.Activated:Connect(function()
		if not skip.button.Active then return end
		Kit.playSound("click")
		Remotes.RequestPetMode:FireServer("Fight", "Last")
		PanelManager.close(PANEL_NAME)
	end)
	_skip = skip

	local premium = Kit.button("Pass", footer, "premium", "", 20)
	premium.label.Size = UDim2.new(1, -12, 0, 24)
	premium.label.AnchorPoint = Vector2.new(0.5, 0)
	premium.label.Position = UDim2.new(0.5, 0, 0, 6)
	premium.sub.Size = UDim2.new(1, -12, 0, 20)
	premium.button.Activated:Connect(function()
		if not premium.button.Active then return end
		Kit.playSound("click")
		if hasPass() then
			-- Mit Pass ist das der Gratis-Skip (der Server rechnet 0)
			Remotes.RequestPetMode:FireServer("Fight", "Last")
			PanelManager.close(PANEL_NAME)
		elseif GamepassConfig.isReady(PASS_KEY) then
			Remotes.RequestBuyGamepass:FireServer(PASS_KEY)
		else
			-- "Bald": kurzer Wackler statt eines Kaufs
			local face = premium.face
			Kit.tween(face, 0.06, { Rotation = 3 })
			task.delay(0.07, function() Kit.tween(face, 0.12, { Rotation = 0 }, Enum.EasingStyle.Back) end)
		end
	end)
	_premium = premium

	-- Groesse: Liste fuellt den Platz zwischen Status und Leiste; auf
	-- niedrigen Fenstern die kompakte Anordnung.
	window.setSize = function(size: Vector2)
		_compact = size.Y < COMPACT_BELOW
		local headerH = if _compact then HEADER_H_COMPACT else HEADER_H
		local statusH = if _compact then 0 else STATUS_H
		local footerH = if _compact then FOOTER_H_COMPACT else FOOTER_H
		local band = window.header
		if band then band.Size = UDim2.new(1, 0, 0, headerH) end
		statusRow.Visible = not _compact
		footer.Size = UDim2.new(1, 0, 0, footerH)
		gummyChip.Visible = not _compact
		hint.Visible = not _compact
		list.Position = UDim2.fromOffset(PAD, headerH + statusH + 4)
		list.Size = UDim2.new(1, -PAD * 2 + 10, 0, math.max(CARD_H * 0.6, size.Y - headerH - statusH - footerH - 8))
		if _isOpen then TowerPanel.refresh() end
	end

	PanelManager.register(PANEL_NAME, { open = openInternal, close = closeInternal })

	ClientState.onChanged(function() TowerPanel.refresh() end)
	Loc.onChanged(function() TowerPanel.refresh() end)
	Players.LocalPlayer:GetAttributeChangedSignal(GamepassConfig.attributeName(PASS_KEY)):Connect(function()
		TowerPanel.refresh()
	end)
	Remotes.PetModeChanged.OnClientEvent:Connect(function(state: any)
		_petState = if typeof(state) == "string" then state else "Home"
		TowerPanel.refresh()
	end)
	Remotes.TowerUnlocked.OnClientEvent:Connect(function(towerId: any)
		if typeof(towerId) == "string" then onUnlocked(towerId) end
	end)

	print("[TowerPanel] Initialisiert |", #_order, "Tower")
end

return TowerPanel
]]></ProtectedString>
