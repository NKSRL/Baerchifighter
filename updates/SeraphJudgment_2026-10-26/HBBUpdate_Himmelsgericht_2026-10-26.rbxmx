	-- ============================================================
	-- COSMIC (Kosmos)
	-- ============================================================

	CometBaerchi = {
		id = "CometBaerchi", displayName = "Astronaut", rarity = "Cosmic", path = "Kosmos",
		baseStats = { hp = 3800, atk = 205, spd = 1.25, pwr = 0.30 },
