	["ui.pets.sell.sell_button.one"]   = "Vendre {n} Baerchi",
	["ui.pets.sell.sell_button.other"] = "Vendre {n} Baerchis",
	["ui.pets.sell.clear_all"]        = "Tout désélectionner",
