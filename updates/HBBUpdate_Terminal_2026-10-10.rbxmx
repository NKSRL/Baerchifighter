	["skill.BearHug.name"]                = "Câlin d'ourson",
	["skill.Revive.name"]                 = "Résurrection",
	["skill.BasicPunch.desc"]             = "Un coup simple. Toujours là.",
	["skill.SugarRush.desc"]              = "Vitesse d'attaque doublée pendant 2 actions.",
	["skill.GummyShield.desc"]            = "Absorbe 50 % des dégâts pendant 2 actions.",
	["skill.IceSlam.desc"]                = "1.5x dégâts et étourdit l'ennemi pendant une action.",
	["skill.FireBite.desc"]               = "Enflamme l'ennemi pendant 3 actions.",
	["skill.SugarStorm.desc"]             = "Un tourbillon de sucre frappe tout autour du Baerchi.",
	["skill.ShardBlast.desc"]             = "2.2x dégâts. Lent à charger, mais dévastateur.",
	["skill.GoldRush.desc"]               = "Vole 25 % des HP ennemis et se soigne avec.",
	["skill.BlackHole.desc"]              = "Aspire tout. L'AoE la plus forte du jeu.",
	["skill.ChromaBlast.desc"]            = "3x dégâts. Toutes les couleurs d'un coup.",
	["skill.TitanMode.desc"]              = "Absorbe 90 % des dégâts pendant 3 actions. Indestructible.",
	["skill.BigBang.desc"]                = "20 % de chances de K.O. immédiat. Sinon 2.5x dégâts.",
	["skill.BearHug.desc"]                = "Soigne 30 % des HP max. La compétence la plus gentille.",
	["skill.Revive.desc"]                 = "Revient une fois par combat avec 50 % des HP.",
	["skill.PhoenixRebirth.desc"]         = "Survit une fois par combat avec 1 HP et riposte d'un jet de flammes.",
	["skill.GlacierFrost.desc"]           = "Ralentit l'ennemi de 40 % pendant 3 de ses actions.",
	["skill.PhantomOmen.desc"]            = "Passif : les oeufs pondus ont 25 % de chances de monter d'un rang.",
	["skill.SeraphGrace.desc"]            = "Soigne 22 % des HP max.",
	["skill.AuroraVeil.desc"]             = "+50 % SPD et +30 % PWR pendant 3 actions.",
	["skill.EclipseShroud.desc"]          = "Réduit l'attaque ennemie de 35 % pendant 3 de ses actions.",
	["skill.CometImpact.desc"]            = "Le premier impact frappe à 4.5x ATK, les suivants à 1.6x.",
	["skill.NebulaBurn.desc"]             = "Enveloppe l'ennemi d'une brume brûlante (4 actions).",
	["skill.PulsarPulse.desc"]            = "Chaque pulsation frappe plus fort que la précédente.",
	["skill.ShadeSlash.desc"]             = "Sous 30 % des HP ennemis, l'entaille frappe à 4x ATK.",
	["skill.RiddleBeam.desc"]             = "Un rayon de symboles, 2.6x dégâts.",
	["skill.TitanFist.desc"]              = "Un poing tombé du ciel, 3.6x dégâts.",
	["skill.GenesisWave.desc"]            = "Chaque vague s'appuie sur la précédente.",
	["skill.ChronosRift.desc"]            = "Déchire le temps, 3x dégâts.",
	["skill.InfinityBarrage.desc"]        = "Cinq coups d'affilée, 0.6x ATK chacun.",
	["skill.OmegaStrike.desc"]            = "Un seul coup. 7x dégâts.",
	["skill.BasicPunch.drawback"]         = "Aucun pic de puissance.",
	["skill.SugarRush.drawback"]          = "Aucun dégât bonus en soi, long cooldown.",
