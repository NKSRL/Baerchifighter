	["baerchi.CometBaerchi.desc"]         = "Kommt mit einem Knall. Bleibt mit einem Krater.",
	["baerchi.NebulaBaerchi.desc"]        = "Ein Fell aus Sternenstaub, der brennt.",
	["baerchi.PulsarBaerchi.desc"]        = "Tickt wie eine Uhr. Jeder Schlag lauter.",
	["baerchi.ShadeBaerchi.desc"]         = "Niemand hat ihn je ganz gesehen.",
	["baerchi.RiddleBaerchi.desc"]        = "Beantwortet jede Frage mit einer neuen.",
