<Item class="Folder" referent="RBX17"><Properties>
<string name="Name">Modules</string>
</Properties>
<Item class="ModuleScript" referent="RBX18"><Properties>
<string name="Name">GuideSteps</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- GuideSteps.luau
-- ReplicatedStorage/Modules/GuideSteps.luau
--
-- Einzige Zustaendigkeit:
--   - Aus dem Spielstand ableiten, welcher Fuehrungsschritt gerade dran ist
--     (reine Funktion, keine Roblox-Dienste, kein eigenes Feld im Spielstand)
--
-- Kontext: HBB Paket 2. Ein neues Kind soll ohne Text sehen, was als
-- Naechstes kommt. Der Client (GuideController) zeigt den Schritt als Beam in
-- der Welt oder als pulsierenden Pfeil am Knopf.
--
-- Jeder Schritt endet, sobald seine Bedingung aus den Daten erfuellt ist.
-- Ein Tutorial-Fortschritt wird nirgends gespeichert.
--
-- Reihenfolge (Abweichung vom Plan-Vorschlag, siehe Bericht): ein frisches
-- Konto hat noch keinen Baerchi und damit keine gelegten Eier. Deshalb zuerst
-- oeffnen, dann kaempfen; "gelegtes Ei einsammeln" kommt, sobald eines liegt.
--
-- Keine requires: das Modul laeuft unveraendert im Luau-Test
-- (tools/luau-tests/guide_steps.test.lua).

-- Sammel-Update 05.10. (Paket 3.5): Einsteiger-Kette Ei oeffnen -> kaempfen ->
-- Waben holen und im Recycler abgeben -> Gebaeude verbessern -> Event. Jeder
-- Schritt bekommt im Client einen Satz, was er bringt ("guide.<step>").
--
-- 08.10. (Tower-Terminal): nach dem ersten Schaffen von Tower I der Schritt
-- "tower": zum Terminal an der Bruecke, dort zur Karte von Tower II. Fertig,
-- sobald ein anderer Tower gewaehlt ist oder dort schon gekaempft wurde.
-- Ausnahme von der Veteranen-Regel (siehe towerSwitchPending).
export type Step = "hatch" | "fight" | "collect" | "merchant" | "combs" | "upgrade" | "event" | "tower"

-- Nur die Felder, die hier gelesen werden. PlayerDataUpdate (Client) und
-- PlayerData (Server) passen beide hinein.
export type View = {
	rebirthCount : number,
	island : {
		baerchis      : { [string]: any },
		eggStock      : { [string]: number },
		laidEggs      : { any },
		towerProgress : { [string]: number }?,
		buildings     : { [string]: { level: number } }?,   -- Sammel-Update 3.5
		recycler      : { level: number }?,
	},
	towers : { records: { [string]: number }, selected: string?, unlocked: { [string]: boolean }? }?,
	quests : { chainDone: number }?,
	stats  : { totalEventsCompleted: number?, totalCombsDelivered: number? }?,
	gummies : number?,
}

-- Optionen, die der Aufrufer aus Configs mitgibt (haelt das Modul frei von
-- requires). merchantPrice = Preis eines Basis-Eis beim Haendler; nil = der
-- Haendler-Schritt ist aus (Flag MAP_V2_MERCHANT).
export type Options = {
	merchantPrice : number?,
}

local GuideSteps = {}

-- Ab hier gilt ein Spielstand nicht mehr als neu: kein Schritt mehr.
GuideSteps.VETERAN_CHAIN_DONE = 4

local function isEmpty(map: { [any]: any }?): boolean
	return map == nil or next(map) == nil
end

local function countMap(map: { [any]: number }): number
	local total = 0
	for _, n in map do
		total += n
	end
	return total
end

function GuideSteps.isVeteran(view: View): boolean
	if (view.rebirthCount or 0) > 0 then return true end
	local quests = view.quests
	return quests ~= nil and (quests.chainDone or 0) >= GuideSteps.VETERAN_CHAIN_DONE
end

function GuideSteps.hasFought(view: View): boolean
	local towers = view.towers
	if towers and not isEmpty(towers.records) then return true end
	return not isEmpty(view.island.towerProgress)
end

-- Sammel-Update 3.5: irgendein Gebaeude (oder der Recycler) ueber Level 1.
function GuideSteps.hasUpgraded(view: View): boolean
	local recycler = view.island.recycler
	if recycler and (recycler.level or 1) > 1 then return true end
	for _, building in view.island.buildings or {} do
		if (building.level or 1) > 1 then return true end
	end
	return false
end

function GuideSteps.eventsDone(view: View): number
	local stats = view.stats
	return if stats then (stats.totalEventsCompleted or 0) else 0
end

-- 08.10.: Tower II ist frei (Tower I geschafft), aber der Spieler hat noch
-- nie gewechselt: weiter in Tower I gewaehlt und in keinem anderen Tower
-- gekaempft. Nur ohne Rebirth.
--
-- Bewusst VOR der Veteranen-Regel "4 Ketten-Quests": die ist nach fuenf
-- gewonnenen Kaempfen erfuellt, also lange bevor jemand Tower I schafft —
-- mit ihr saehe diesen Schritt praktisch niemand. Sie schuetzt alte Konten
-- vor der Einfuehrung; das Umstellen ist dagegen fuer jeden neu (Annahme,
-- im Bericht). Die Rebirth-Regel gilt weiter.
function GuideSteps.towerSwitchPending(view: View): boolean
	if (view.rebirthCount or 0) > 0 then return false end
	local towers = view.towers
	if not towers or not towers.unlocked or towers.unlocked.II ~= true then return false end
	if (towers.selected or "I") ~= "I" then return false end
	for towerId, record in towers.records do
		if towerId ~= "I" and record > 0 then return false end
	end
	return true
end

-- Der aktuelle Schritt oder nil (fertig bzw. kein neuer Spieler).
function GuideSteps.current(view: View, options: Options?): Step?
	if GuideSteps.towerSwitchPending(view) then
		return "tower"
	end
	if GuideSteps.isVeteran(view) then
		return nil
	end

	local island = view.island
	local hasBaerchi = not isEmpty(island.baerchis)
	local eggsInStock = countMap(island.eggStock)

	-- 1. Ei oeffnen: noch kein Baerchi, aber ein Ei im Lager
	if not hasBaerchi then
		if eggsInStock > 0 then
			return "hatch"
		end
		-- Kein Ei, kein Baerchi: zum Haendler, wenn es den Schritt gibt
		local price = if options then options.merchantPrice else nil
		if price and (view.gummies or 0) >= price then
			return "merchant"
		end
		return nil
	end

	-- 2. Erster Kampf
	if not GuideSteps.hasFought(view) then
		return "fight"
	end

	-- 3. Gelegtes Ei einsammeln (nur waehrend der Einfuehrung)
	local onboarding = GuideSteps.eventsDone(view) == 0
	if onboarding and #island.laidEggs > 0 then
		return "collect"
	end

	-- 4. Sammel-Update 3.5: Waben holen und im Recycler abgeben
	local stats = view.stats
	if onboarding and stats and (stats.totalCombsDelivered or 0) == 0 then
		return "combs"
	end

	-- 5. Sammel-Update 3.5: ein Gebaeude verbessern
	if onboarding and not GuideSteps.hasUpgraded(view) then
		return "upgrade"
	end

	-- 6. Erstes Event (der Client zeigt diesen Schritt nur kurz, Paket 3.2)
	if onboarding then
		return "event"
	end

	-- 5. Kein Ei mehr (weder im Lager noch auf dem Plot), Gummies reichen:
	-- zum Haendler (HBB Paket 5, nur solange der Spieler neu ist)
	local price = if options then options.merchantPrice else nil
	if price and eggsInStock == 0 and #island.laidEggs == 0 and (view.gummies or 0) >= price then
		return "merchant"
	end

	return nil
end

return GuideSteps
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX19"><Properties>
<string name="Name">Network</string>
</Properties>
<Item class="ModuleScript" referent="RBX20"><Properties>
<string name="Name">Remotes</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- Remotes.luau
-- ReplicatedStorage/Network/Remotes.luau
--
-- Alle RemoteEvents und RemoteFunctions als benannte Konstanten.
-- Kein Magic-String im gesamten Projekt.
-- Server und Client importieren von hier.
--
-- Konvention: der Feldname hier ist gleichzeitig der Schluessel in
-- NetworkConfig.REMOTE_COOLDOWNS — RateLimiter verlaesst sich darauf.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

-- ============================================================
-- WARUM DIE FALLUNTERSCHEIDUNG SERVER/CLIENT
-- ============================================================
-- Nur der SERVER legt die Remotes an. Der Client wartet ausschliesslich
-- darauf, dass sie repliziert werden.
--
-- Ohne diese Trennung koennte ein Client-Skript, das laeuft bevor der Ordner
-- bei ihm angekommen ist, sich selbst einen EIGENEN "RemoteFolder" mit
-- eigenen, rein lokalen RemoteEvents bauen. Die kommen nie beim Server an
-- und der Server erreicht sie nie — das Spiel saehe vollstaendig normal aus
-- und wuerde einfach gar nichts tun, ohne eine einzige Fehlermeldung. Das ist
-- eine der unangenehmsten Fehlerarten ueberhaupt, deshalb hier explizit.
local IS_SERVER = RunService:IsServer()

local folder: Instance
if IS_SERVER then
	local existing = ReplicatedStorage:FindFirstChild("RemoteFolder")
	if existing then
		folder = existing
	else
		local created = Instance.new("Folder")
		created.Name   = "RemoteFolder"
		created.Parent = ReplicatedStorage
		folder = created
	end
else
	folder = ReplicatedStorage:WaitForChild("RemoteFolder")
end

local function getOrCreateEvent(name: string): RemoteEvent
	if not IS_SERVER then
		return folder:WaitForChild(name) :: RemoteEvent
	end

	local existing = folder:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local remote  = Instance.new("RemoteEvent")
	remote.Name   = name
	remote.Parent = folder
	return remote
end

local function getOrCreateFunction(name: string): RemoteFunction
	if not IS_SERVER then
		return folder:WaitForChild(name) :: RemoteFunction
	end

	local existing = folder:FindFirstChild(name)
	if existing and existing:IsA("RemoteFunction") then
		return existing
	end
	local remote  = Instance.new("RemoteFunction")
	remote.Name   = name
	remote.Parent = folder
	return remote
end

-- ============================================================
-- Server → Client Events
-- ============================================================

-- Wird nach jeder Zustandsaenderung gefeuert
-- Args: PlayerDataUpdate
local PlayerDataUpdated = getOrCreateEvent("PlayerDataUpdated")

-- Kampfergebnis anzeigen (Animation auf Client)
-- Args: CombatResult
local CombatResultReceived = getOrCreateEvent("CombatResultReceived")

-- Hatch-Ergebnis anzeigen (Gacha-Animation auf Client)
-- Args: HatchResult
local HatchResultReceived = getOrCreateEvent("HatchResultReceived")

-- Fusions-Ergebnis anzeigen
-- Args: FusionResult
local FusionResultReceived = getOrCreateEvent("FusionResultReceived")

-- Recycling-Ergebnis anzeigen
-- Args: RecycleResult
local RecycleResultReceived = getOrCreateEvent("RecycleResultReceived")

-- Rebirth durchgefuehrt
-- Args: RebirthResult
local RebirthResultReceived = getOrCreateEvent("RebirthResultReceived")

-- Offline-Ertrag beim Join
-- Args: OfflineReport
local OfflineReportReceived = getOrCreateEvent("OfflineReportReceived")

-- Ein Honig wurde verfuettert: Heilung, XP und ggf. Level-Up
-- Args: FeedResult
local FeedResultReceived = getOrCreateEvent("FeedResultReceived")

-- Ein Baerchi wurde befoerdert
-- Args: PromotionResult
local PromotionResultReceived = getOrCreateEvent("PromotionResultReceived")

-- Charms wurden neu gewuerfelt (ein Wurf oder ein Auto-Roll-Paket)
-- Args: CharmRollResult
local CharmRollResultReceived = getOrCreateEvent("CharmRollResultReceived")

-- Ein Stat-Level ist durch Event-Teilnahme gestiegen
-- Args: EventStatGain
local EventStatGained = getOrCreateEvent("EventStatGained")

-- Der ausgeruestete Baerchi ist am Event angekommen bzw. wieder zuhause.
-- Reiner Anzeige-Zustand fuer den "Zum Event"-Knopf — die Wahrheit darueber,
-- wer am Event steht, liegt ausschliesslich serverseitig
-- (EventParticipationService), dieser Event teilt sie nur mit.
-- Args: atEvent: boolean, baerchiUid: string?
local EventPresenceChanged = getOrCreateEvent("EventPresenceChanged")

-- Der Event-Zyklus hat die Phase gewechselt: ein Event hat begonnen oder ist
-- vorbei. Geht an ALLE Spieler (der Zyklus ist fuer alle derselbe) und beim
-- Join zusaetzlich einmal gezielt an den neuen Spieler.
--
-- Uebertragen wird nur die eventId, NICHT die Belohnung: den Katalog kennt der
-- Client selbst (EventConfig liegt in ReplicatedStorage), und ein zweiter
-- Uebertragungsweg fuer dieselben Zahlen waere genau die Art Doppelung, die
-- beim naechsten Balancing auseinander laeuft.
--
-- Args: eventId: string?  (nil = gerade Pause),
--       secondsRemaining: number,
--       nextEventId: string  (was als naechstes laeuft — waehrend der Pause
--                             die eigentlich wichtige Angabe, weil der Spieler
--                             danach entscheidet, ob er seinen Baerchi
--                             losschickt)
local EventPhaseChanged = getOrCreateEvent("EventPhaseChanged")

-- Ein gelegtes Ei wurde eingesammelt und liegt jetzt im Lager
-- Args: EggCollectResult
local EggCollectedReceived = getOrCreateEvent("EggCollectedReceived")

-- Beim Join: wie viele Eier waehrend der Abwesenheit dazugekommen sind
-- Args: OfflineEggReport
local OfflineEggReportReceived = getOrCreateEvent("OfflineEggReportReceived")

-- v15: Der Spieler hat seinen Waben-Stapel auf der eigenen Insel abgegeben.
-- Reiner Anzeige-Anlass (Meldung); die Waben gehen serverseitig direkt in die
-- Warteschlange des Recyclers (CombRecyclerService).
-- Args: count: number (Waben), units: number (Wabeneinheiten, goldene zaehlen mehr)
local CombDelivered = getOrCreateEvent("CombDelivered")

-- v15: Der Waben-Recycler wurde ausgebaut.
-- Args: newLevel: number
local RecyclerUpgraded = getOrCreateEvent("RecyclerUpgraded")

-- v12: Zustand des ausgeruesteten Baerchis fuer die untere Pet-Leiste
-- (PetBar). Die Wahrheit liegt ausschliesslich in PetModeService, dieser
-- Event teilt sie nur mit.
-- Args: state: string  ("Home" | "ToEvent" | "AtEvent" | "ToPit" | "InPit" | "Returning"),
--       pending: string? ("Event" | "Fight" — vorgemerktes Ziel beim Wechsel),
--       info: { stage: number? }?  (laufende Stage im PIT, fuer die Beschriftung)
local PetModeChanged = getOrCreateEvent("PetModeChanged")

-- Eine Anfrage wurde serverseitig abgelehnt — Client zeigt Toast/Fehlertext.
-- Args: action: string, reason: Types.LocMsg  (Schluessel + Zahlen, KEIN fertiger
--       Satz: der Client baut den Text in der Sprache des Spielers, siehe
--       Localization/Loc. Ein einfacher String wird als Altlast unveraendert
--       angezeigt.)
-- v13: Quest-Belohnung wurde ausgezahlt (Toast). Args: reward: Types.QuestReward
local QuestRewardReceived = getOrCreateEvent("QuestRewardReceived")

local ActionFailed = getOrCreateEvent("ActionFailed")

-- v17 (lebendige Events): Meldung waehrend eines Events, als LocMsg (der
-- Client uebersetzt). Geht an einen Spieler oder an alle (Jackpot, Boss).
-- Args: msg: Types.LocMsg, style: ("info" | "good" | "big")?
local EventNotice = getOrCreateEvent("EventNotice")

-- v17: Telegraph einer Boss-Attacke (an alle). Args: Types.HazardTelegraph
local EventTelegraph = getOrCreateEvent("EventTelegraph")

-- v17: Der eigene Charakter wurde von einer Boss-Attacke getroffen.
-- Args: Types.HazardHit
local EventHazardHit = getOrCreateEvent("EventHazardHit")

-- v15 (Tower): ein Tower-Meilenstein wurde ausgezahlt (Toast).
-- Args: Types.TowerMilestoneReward
local TowerMilestoneReceived = getOrCreateEvent("TowerMilestoneReceived")
-- 08.10.: ein Tower ist durch Schaffen des vorherigen frei geworden
-- (Server → Client, Argument: TowerId). Feier-Moment + "NEU"-Abzeichen.
local TowerUnlocked = getOrCreateEvent("TowerUnlocked")

-- v15: Login-Bonus ausgezahlt (Toast). Args: Types.DailyBonusResult
local DailyBonusReceived = getOrCreateEvent("DailyBonusReceived")

-- v14 (Mega Egg Tree): Ei-Baum, Ei-Presse, Blaupausen, Faehigkeiten-Show
local EggTreeUnlocked        = getOrCreateEvent("EggTreeUnlocked")        -- S->C (Types.EggUnlockResult)
local EggPressResultReceived = getOrCreateEvent("EggPressResultReceived") -- S->C (Types.EggPressResult)
local SkillFXPlay            = getOrCreateEvent("SkillFXPlay")            -- S->C (alle Clients, siehe PitArenaService)
-- Welt aufwerten, Paket G: ein grosser Moment eines Spielers, an ALLE Clients.
-- Der Server sagt nur WAS passiert ist; wie es aussieht entscheidet der Client
-- (WorldMomentController). Args: { userId, kind, value, number?, big }
-- (kind: "hatch" | "tower" | "record" | "rebirth" | "mutation", siehe Modules/WorldMoments)
local WorldMoment            = getOrCreateEvent("WorldMoment")            -- S->C (alle Clients, siehe WorldMomentService)
local RequestPressEggs       = getOrCreateEvent("RequestPressEggs")       -- C->S (eggType, path?)
local RequestUseBlueprint    = getOrCreateEvent("RequestUseBlueprint")    -- C->S (eggType)

-- ============================================================
-- Client → Server Events (Anfragen)
-- ============================================================

-- Spieler oeffnet ein Ei aus seinem Lager (seit v12 sofort, ohne Brutzeit
-- und ohne Kauf). Ergebnis kommt ueber HatchResultReceived.
-- Args: eggType: string
local RequestHatchEgg = getOrCreateEvent("RequestHatchEgg")

-- v13: Quest-Belohnung abholen. Der Server prueft selbst, ob die Quest erledigt ist.
-- Args: kind: "chain" | "daily", questId: string
local RequestClaimQuest = getOrCreateEvent("RequestClaimQuest")

-- v12: Pet-Leiste. Der Client sagt nur, welcher Knopf gedrueckt wurde — was
-- daraus folgt (hinschicken, zurueckholen, wechseln), entscheidet
-- PetModeService.
-- Args: mode: "Event" | "Fight" | "Home",
--       resume: ("Fresh" | "Percent" | "Last")?  (nur bei "Fight": Wahl aus der
--               Fortsetzungs-Frage; nil = von vorn)
local RequestPetMode = getOrCreateEvent("RequestPetMode")

-- Spieler will ein Gebaeude upgraden
-- Args: buildingId: string
local RequestUpgradeBuilding = getOrCreateEvent("RequestUpgradeBuilding")

-- (v15: RequestUpgradePit ist entfallen — es gibt kein PIT-Level mehr.)

-- v15: Tower waehlen, in den der Fight-Knopf schickt. Der Server prueft, ob
-- der Tower beim aktuellen Rebirth offen ist (TowerConfig.isOpen).
-- Args: towerId: string
local RequestSelectTower = getOrCreateEvent("RequestSelectTower")
-- 08.10. (Paket C): Kauf-Dialog fuer einen Gamepass (Argument: Pass-Key aus
-- GamepassConfig). Der Server prueft Id und Besitz.
local RequestBuyGamepass = getOrCreateEvent("RequestBuyGamepass")

-- v15: taeglichen Login-Bonus abholen. Der Server prueft UTC-Tag,
-- Gnadenfrist und doppelte Abholung (Modules/LoginBonusCalc).
-- Args: (keine)
local RequestClaimDailyBonus = getOrCreateEvent("RequestClaimDailyBonus")

-- v15: Waben-Recycler ausbauen (kein Argument: es gibt nur einen pro Insel)
local RequestUpgradeRecycler = getOrCreateEvent("RequestUpgradeRecycler")

-- Spieler will zwei Baerchis fusionieren
--
-- Args: uidA: string, uidB: string,
--       lockedProperty: ("ability" | "level" | "eggs")?,   -- nil = alles automatisch
--       lockedFrom:     ("A" | "B")?                        -- nur wenn lockedProperty gesetzt
--
-- Die beiden letzten Argumente kommen aus dem Sperr-Schritt des Fusions-Menues
-- (siehe FusionPanel). Sie sind optional: ein Aufruf ohne sie verhaelt sich wie
-- vor der Erweiterung, alles automatisch nach der Standard-Regel.
local RequestFuseBaerchis = getOrCreateEvent("RequestFuseBaerchis")

-- Spieler will einen Baerchi mit Duplikaten befoerdern
-- Args: baerchiUid: string
local RequestPromoteBaerchi = getOrCreateEvent("RequestPromoteBaerchi")

-- Spieler will die Charms eines Baerchis neu wuerfeln.
-- `rolls` ist die Anzahl der Wuerfe in EINEM Paket (1 = "Roll Charms",
-- CharmConfig.AUTO_ROLL_COUNT = "Auto Roll"). Siehe CharmConfig, Kommentar bei
-- AUTO_ROLL_COUNT, warum das ein Paket ist und keine Schleife auf dem Client.
-- Args: baerchiUid: string, rolls: number?
local RequestRollCharms = getOrCreateEvent("RequestRollCharms")

-- Spieler will einen Charm-Slot gegen erneutes Wuerfeln sperren/freigeben
-- Args: baerchiUid: string, slot: number
local RequestToggleCharmLock = getOrCreateEvent("RequestToggleCharmLock")

-- Spieler sammelt ein gelegtes Ei auf, das in der Welt liegt.
-- Args: eggUid: string  (Types.LaidEgg.uid — NICHT die Position: die aendert
--       sich nicht, aber eine uid ist eindeutig auch dann noch, wenn zwei Eier
--       uebereinander liegen.)
local RequestCollectEgg = getOrCreateEvent("RequestCollectEgg")

-- Spieler sammelt ALLE herumliegenden Eier auf einmal auf.
-- Args: (keine)
local RequestCollectAllEggs = getOrCreateEvent("RequestCollectAllEggs")

-- Spieler will einen Baerchi verwerten
-- Args: baerchiUid: string
local RequestRecycleBaerchi = getOrCreateEvent("RequestRecycleBaerchi")

-- Spieler will einen Baerchi mit einem Honig fuettern (heilt + gibt XP).
-- Aus welchem Gebaeude der Honig kommt, entscheidet der Server (bestes zuerst).
-- Args: baerchiUid: string
local RequestFeedHoney = getOrCreateEvent("RequestFeedHoney")

-- Spieler will einen Baerchi ausruesten. Es steht immer nur EINER auf dem
-- Plot — die anderen bleiben im Inventar. Siehe IslandService.equipBaerchi.
-- Args: baerchiUid: string
local RequestEquipBaerchi = getOrCreateEvent("RequestEquipBaerchi")

-- Spieler will Rebirth machen
-- Args: (keine)
local RequestRebirth = getOrCreateEvent("RequestRebirth")

-- Spieler waehlt seine Sprache. nil/"auto" = zurueck auf die Roblox-Sprache.
-- Args: language: string?   ("de" | "en" | "fr" | "es")
local RequestSetLanguage = getOrCreateEvent("RequestSetLanguage")

-- HBB Paket 0: Messpunkte der Oberflaeche (Panel geoeffnet, Panel schnell
-- wieder geschlossen, Spieler steht still). Reine Statistik, aendert nichts
-- am Spielstand. Der Server prueft Art und Panel-Namen gegen
-- FunnelConfig und deckelt die Anzahl pro Sitzung.
-- Args: kind: "PanelOpened" | "PanelQuickClose" | "IdleStanding",
--       panelName: string?
local RequestLogUiEvent = getOrCreateEvent("RequestLogUiEvent")

-- HBB Paket 3: Bedienelemente als "gesehen" markieren (Badge verschwindet).
-- Rein kosmetisch; der Server prueft nur die Ids gegen UnlockRules.ELEMENTS.
-- Args: ids: string | { string }
local RequestMarkUiSeen = getOrCreateEvent("RequestMarkUiSeen")

-- HBB Paket 5: Heim-Knopf. Der Server teleportiert auf den eigenen Plot,
-- ausser der Spieler traegt Waben (dann ActionFailed).
-- Args: (keine)
local RequestGoHome = getOrCreateEvent("RequestGoHome")
-- HBB Paket 10: Shop — Gratis-Griff (Client -> Server, keine Argumente)
local RequestClaimFreeGrab = getOrCreateEvent("RequestClaimFreeGrab")

-- ============================================================
-- Sammel-Update 05.10.
-- ============================================================
-- Paket 4.3: Tower-Wiedergabe beschleunigen. Args: speed (1 | 2 | 4 | 0 = sofort)
local RequestPitSpeed = getOrCreateEvent("RequestPitSpeed")
-- Paket 7: Index-Belohnung abholen. Args: rewardId (IndexRewardConfig)
local RequestClaimIndexReward = getOrCreateEvent("RequestClaimIndexReward")
-- Paket 7: Belohnung ausgezahlt (S->C, Toast). Args: Types.IndexRewardResult
local IndexRewardReceived = getOrCreateEvent("IndexRewardReceived")
-- Paket 6.2: besonderer Meilenstein ausgezahlt (S->C). Args: Types.SpecialMilestoneResult
local SpecialMilestoneReceived = getOrCreateEvent("SpecialMilestoneReceived")
-- Paket 8: Inkubator. Start (eggType), Abholen (slot), Beschleunigen (slot),
-- Ausbauen (keine Args). Das Schluepfen meldet HatchResultReceived.
local RequestIncubatorStart   = getOrCreateEvent("RequestIncubatorStart")
local RequestIncubatorCollect = getOrCreateEvent("RequestIncubatorCollect")
local RequestIncubatorSpeedUp = getOrCreateEvent("RequestIncubatorSpeedUp")
local RequestUpgradeIncubator = getOrCreateEvent("RequestUpgradeIncubator")
-- INCUBATOR_BREED: ("put", baerchiUid) / ("take", platz)
local RequestIncubatorBaerchi = getOrCreateEvent("RequestIncubatorBaerchi")
-- Paket 8: S->C Hinweis "Platz belegt / fertig / abgeholt" (Feedback, Ton).
-- Args: { slot: number, kind: "start" | "ready" | "collect" | "speedup" | "upgrade" }
local IncubatorChanged = getOrCreateEvent("IncubatorChanged")

-- ============================================================
-- Client → Server Functions (brauchen eine Antwort)
-- ============================================================

-- Spieler fragt seine aktuellen Daten an (z.B. nach Reconnect)
-- Returns: PlayerDataUpdate?
local GetPlayerData = getOrCreateFunction("GetPlayerData")

-- v15: eine Bestenliste (LeaderboardService, gecacht).
-- Args: listId: "Tower" | "Rebirths" | "Collection"
-- Returns: Types.LeaderboardView?
local GetLeaderboard = getOrCreateFunction("GetLeaderboard")

-- v15: Profilkarte eines anderen Spielers auf DIESEM Server (Inspektor).
-- Args: userId: number
-- Returns: Types.PlayerProfileCard?
local GetPlayerProfile = getOrCreateFunction("GetPlayerProfile")

return {
	-- Server → Client
	PlayerDataUpdated     = PlayerDataUpdated,
	CombatResultReceived  = CombatResultReceived,
	HatchResultReceived   = HatchResultReceived,
	FusionResultReceived  = FusionResultReceived,
	RecycleResultReceived = RecycleResultReceived,
	RebirthResultReceived = RebirthResultReceived,
	OfflineReportReceived = OfflineReportReceived,
	FeedResultReceived    = FeedResultReceived,
	PromotionResultReceived = PromotionResultReceived,
	CharmRollResultReceived = CharmRollResultReceived,
	EventStatGained         = EventStatGained,
	EventPresenceChanged    = EventPresenceChanged,
	EventPhaseChanged       = EventPhaseChanged,
	EggCollectedReceived    = EggCollectedReceived,
	OfflineEggReportReceived = OfflineEggReportReceived,
	PetModeChanged          = PetModeChanged,
	CombDelivered           = CombDelivered,
	RecyclerUpgraded        = RecyclerUpgraded,
	QuestRewardReceived     = QuestRewardReceived,
	ActionFailed          = ActionFailed,
	EventNotice           = EventNotice,
	EventTelegraph        = EventTelegraph,
	EventHazardHit        = EventHazardHit,

	TowerMilestoneReceived = TowerMilestoneReceived,
	TowerUnlocked          = TowerUnlocked,
	DailyBonusReceived     = DailyBonusReceived,

	EggTreeUnlocked        = EggTreeUnlocked,
	EggPressResultReceived = EggPressResultReceived,
	SkillFXPlay            = SkillFXPlay,
	WorldMoment            = WorldMoment,
	RequestPressEggs       = RequestPressEggs,
	RequestUseBlueprint    = RequestUseBlueprint,

	-- Client → Server
	RequestHatchEgg        = RequestHatchEgg,
	RequestClaimQuest      = RequestClaimQuest,
	RequestPetMode         = RequestPetMode,
	RequestUpgradeBuilding = RequestUpgradeBuilding,
	RequestSelectTower     = RequestSelectTower,
	RequestBuyGamepass     = RequestBuyGamepass,
	RequestClaimDailyBonus = RequestClaimDailyBonus,
	RequestUpgradeRecycler = RequestUpgradeRecycler,
	RequestFuseBaerchis    = RequestFuseBaerchis,
	RequestRecycleBaerchi  = RequestRecycleBaerchi,
	RequestFeedHoney       = RequestFeedHoney,
	RequestEquipBaerchi    = RequestEquipBaerchi,
	RequestRebirth         = RequestRebirth,
	RequestSetLanguage     = RequestSetLanguage,
	RequestPromoteBaerchi  = RequestPromoteBaerchi,
	RequestRollCharms      = RequestRollCharms,
	RequestToggleCharmLock = RequestToggleCharmLock,
	RequestCollectEgg      = RequestCollectEgg,
	RequestCollectAllEggs  = RequestCollectAllEggs,
	RequestLogUiEvent      = RequestLogUiEvent,
	RequestMarkUiSeen      = RequestMarkUiSeen,
	RequestGoHome          = RequestGoHome,
	RequestClaimFreeGrab   = RequestClaimFreeGrab,

	-- Sammel-Update 05.10.
	RequestPitSpeed          = RequestPitSpeed,
	RequestClaimIndexReward  = RequestClaimIndexReward,
	IndexRewardReceived      = IndexRewardReceived,
	SpecialMilestoneReceived = SpecialMilestoneReceived,
	RequestIncubatorStart    = RequestIncubatorStart,
	RequestIncubatorCollect  = RequestIncubatorCollect,
	RequestIncubatorSpeedUp  = RequestIncubatorSpeedUp,
	RequestUpgradeIncubator  = RequestUpgradeIncubator,
	RequestIncubatorBaerchi  = RequestIncubatorBaerchi,
	IncubatorChanged         = IncubatorChanged,

	-- Functions
	GetPlayerData          = GetPlayerData,
	GetLeaderboard         = GetLeaderboard,
	GetPlayerProfile       = GetPlayerProfile,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX21"><Properties>
<string name="Name">Types</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- Types.luau
-- ReplicatedStorage/Network/Types.luau
--
-- Einzige Wahrheit fuer alle Datenstrukturen im Spiel.
-- Wird auf Server UND Client importiert.
-- Wenn sich ein Feld aendert, aendert es sich hier — nirgendwo sonst.

--------------------------------------------------------------------------------
-- Enums
--------------------------------------------------------------------------------

local HoneyPondMode = require(script.Parent.Parent.Modules.HoneyPondMode)
local FeatureFlags  = require(script.Parent.Parent.Config.FeatureFlags)

export type Rarity =
	| "Common"
	| "Uncommon"
	| "Rare"
	| "Epic"
	| "Legendary"
	| "Mythic"
	| "Divine"
	| "Cosmic"
	| "Secret"
	| "Godly"
	| "Eternal"
	| "Omega"

-- v14 (Mega Egg Tree): 20 Eier in einem Freischalt-Baum. Welches Ei zu
-- welchem Pfad gehoert und wie es frei wird, steht in EggConfig (TREE).
export type EggType =
	-- Stamm
	| "BasicEgg"
	| "SugarEgg"
	-- Gold-Pfad
	| "GoldenEgg"
	| "PlatinumEgg"
	| "SunEgg"
	| "ZenithEgg"
	-- Kristall-Pfad
	| "CrystalEgg"
	| "PrismEgg"
	| "AuroraEgg"
	-- Void-Pfad
	| "MistEgg"
	| "VoidEgg"
	| "ShadowEgg"
	| "AbyssEgg"
	-- Kosmos-Pfad
	| "CometEgg"
	| "NovaEgg"
	| "GalaxyEgg"
	-- Ascensions-Pfad (nur Rebirth)
	| "AscensionEgg"
	| "TranscendenceEgg"
	| "EternityEgg"
	| "OmegaEgg"
	-- Sonder-Eier ausserhalb des Baums (EggConfig: special = true)
	| "UfoJackpotEgg"

-- v14: die Pfade des Ei-Baums. Ein Pfad ist kein Upgrade, sondern ein
-- Spielziel (Gold = stark, Kristall = schnell, Void = selten, Kosmos =
-- Allrounder, Ascension = Rebirth). Siehe BaerchiConfig.PATHS.
export type PathId = "Stamm" | "Gold" | "Kristall" | "Void" | "Kosmos" | "Ascension"
	| "Event"   -- Sonder-Eier aus Events (nicht im Baum, nie freischaltbar)

-- v11: MUTATION-SYSTEM (ersetzt das binaere isInverted-Feld).
--
-- Acht Stufen statt einem einzigen Bonus — Namen und Werte (Multiplikator,
-- Farbe, Wuerfel-Gewicht) stehen NICHT hier, sondern in
-- Config/BaerchiConfig.MUTATIONS (dieselbe Trennung wie bei Rarity: Types
-- kennt nur die Werte-Menge, BaerchiConfig kennt die Bedeutung dahinter).
-- Aufsteigend sortiert nach Seltenheit/Staerke — BaerchiConfig.MUTATION_ORDER
-- haelt exakt diese Reihenfolge fuer Fusions-Vergleiche ("hoehere Stufe
-- gewinnt").
export type MutationId =
	| "Gold"
	| "Diamond"
	| "Bloodrot"
	| "Celestial"
	| "Candy"
	| "Lava"
	| "Galaxy"
	| "Rainbow"

-- Gebaeude sind seit v4 reine HONIG-Produzenten: jedes stellt regelmaessig
-- einen Honig her und lagert eine begrenzte Menge davon. Ein Honig an einen
-- Baerchi verfuettert heilt ihn und gibt XP — die einzige XP-Quelle im Spiel
-- (Kaempfe geben keine XP mehr).
--
-- Seit v15 (Gebaeude Option B) sind es noch ZWEI Honig-Gebaeude, und nur eine
-- Datei weiss, was sie koennen: Config/BuildingBehavior.luau. Kurz:
--   Beehive       Vorrat   — groesseres Lager, schnellere Produktion
--   HoneyRefiner  Veredeln — sein Level hebt Heilung UND XP jedes Honigs
--                            (verschmolzen aus Honigtopf und Honig-Presse;
--                            "Honig-Veredler" ist ein Platzhalter-Name)
-- Das dritte Gebaeude, der Waben-Recycler, liegt in island.recycler.
--
-- Level 1-60 (EconomyConfig.MAX_BUILDING_LEVEL), Look-Stufe aus dem Level
-- (BuildingBehavior.getLook).
--
-- Seit dem Honig-Teich (FeatureFlags.HONEY_POND_V2) ist es EIN Gebaeude:
--   HoneyPond     Honig-Teich — kann alles, was Stock und Veredler zusammen
--                 koennen; seine Looks wachsen bis zum Honig-Springbrunnen.
-- Die jeweils nicht aktiven liegen in IslandData.retiredBuildings
-- (Modules/HoneyPondMode).
export type BuildingId =
	| "Beehive"        -- Bienenstock
	| "HoneyRefiner"   -- Honig-Veredler (Platzhalter-Name)
	| "HoneyPond"      -- Honig-Teich (HONEY_POND_V2)
-- Fusion ist seit v3 kein Gebaeude mehr — sie laeuft rein ueber GUI
-- (FusionPanel/BaerchiInventory) und ist von Anfang an freigeschaltet.
-- Recycling ist seit v4 ebenfalls eine reine GUI-Funktion mit festem Wert
-- (EconomyConfig.RECYCLE_RETURN). Eier werden seit v12 sofort geoeffnet,
-- es gibt keine Brut-Slots mehr.

export type SkillId = string  -- "SugarRush", "GummySmash", "BearHug", etc.
                               -- String damit neue Skills nur Config-Eintraege sind

-- Rarity eines BATTLE-CHARMS. Bewusst eine eigene Kette, nicht Types.Rarity:
-- ein Charm hat andere Stufen als ein Baerchi ("Super Rare", "Ascended"), und
-- die Odds der einen duerfen sich nicht verschieben, wenn jemand die andere
-- erweitert. Zahlen und Farben stehen in Config/CharmConfig.
export type CharmRarity =
	| "Common"
	| "Uncommon"
	| "Rare"
	| "SuperRare"
	| "Legendary"
	| "Ascended"

-- Ein einzelner ausgeruesteter Battle-Charm.
--
-- Der Slot steht IM Eintrag statt als Tabellen-Schluessel: eine Lua-Tabelle mit
-- Luecken in den Zahlen-Schluesseln ({[1]=..., [5]=...}) laesst sich nicht in
-- einem DataStore ablegen. Baerchi.charms ist deshalb eine dichte Liste, in der
-- nur die tatsaechlich gewuerfelten Slots vorkommen — nach `slot` sortiert.
export type Charm = {
	slot   : number,        -- 1-8, siehe CharmConfig.SLOT_COUNT
	rarity : CharmRarity,   -- erster Wurf
	statId : string,        -- zweiter Wurf, Eintrag aus CharmConfig.STAT_POOL
	value  : number,        -- konkreter Bonus (Faktor bzw. flacher Wert, siehe STAT_POOL.mode)
	locked : boolean,       -- vom Spieler gegen erneutes Wuerfeln gesperrt
}

-- Fortschritt JEDES EINZELNEN Stats durch Event-Teilnahme, gedeckelt durch die
-- rarity-abhaengige Obergrenze (PromotionConfig.STAT_CAP). Voellig getrennt von
-- Baerchi.level, das ueber Honig/XP waechst — zwei unabhaengige Achsen.
--
-- Seit v10 sind alle fuenf echt: `egg` war lange ein Balken ohne Wirkung, weil
-- es das Ei-Legen noch nicht gab. Jetzt beschleunigt es das Legen (siehe
-- EggConfig.LAY_STAT_LEVEL_GAIN).
export type StatLevels = {
	hp  : number,
	atk : number,
	spd : number,   -- Angriffsgeschwindigkeit
	pwr : number,   -- Ability-Staerke (skaliert den Skill-Schaden)
	egg : number,   -- Lege-Tempo (siehe EggCalculator)
}

--------------------------------------------------------------------------------
-- Kern-Einheit: Baerchi
--------------------------------------------------------------------------------

export type Baerchi = {
	uid            : string,   -- eindeutige Instanz-ID ("b_1721abc...")
	configId       : string,   -- Schluessel in BaerchiConfig ("RedBaerchi", "GoldenGrizzly")
	rarity         : Rarity,
	level          : number,   -- 1 - BaerchiConfig.MAX_LEVEL
	xp             : number,   -- XP-Fortschritt zum naechsten Level
	endlessLevel   : number?,  -- Paket 9: Level ueber MAX_LEVEL (nil = 0), bleibt ueber Rebirths
	skillId        : SkillId,  -- aktiver Skill (durch Fusion ueberschreibbar)
	isFusionResult : boolean,  -- fuer UI-Badge "FUSION"
	fusionBonus    : number,   -- 0.0 = kein Bonus, 0.25 = +25% HP/ATK
	                           -- wird beim Fusionieren gesetzt (EconomyConfig.FUSION_STAT_BONUS)
	                           -- und von CombatCalculator.getEffectiveStats angewendet
	currentHp      : number,   -- aktuelle Lebenspunkte, bleiben zwischen PIT-Laeufen
	                           -- stehen. 0 = erschoepft, der Baerchi kann erst
	                           -- wieder kaempfen wenn er mit Honig gefuettert wurde.
	                           -- Obergrenze ist maxHp aus getEffectiveStats.

	-- v8: die zweite Fortschrittsachse (siehe Config/PromotionConfig).
	promotionLevel : number,       -- 0 - PromotionConfig.MAX_PROMOTION, angezeigt als 5 Sterne
	statLevels     : StatLevels,   -- waechst durch Event-Teilnahme
	charms         : { Charm },    -- dichte Liste, nach slot sortiert (siehe Charm)

	-- v8: nur bei einem FUSIONS-Ergebnis gesetzt, sonst nil.
	--
	-- Basiswerte haengen sonst ausschliesslich am configId
	-- (BaerchiConfig.data[configId].baseStats). Seit der neuen Fusions-Regel
	-- ("pro Stat der bessere der beiden Eltern") kann ein Fusions-Ergebnis aber
	-- hoehere Basiswerte tragen, als sein eigener configId hergibt — genau
	-- dafuer ist dieses Feld da.
	--
	-- CombatCalculator.getEffectiveStats bevorzugt die hier gesetzten Werte.
	-- Fuer JEDEN nicht fusionierten Baerchi bleibt das Feld nil und das
	-- Verhalten unveraendert.
	baseStatOverride : {
		hp  : number?,
		atk : number?,
		spd : number?,
		pwr : number?,
	}?,

	-- v11: MUTATION (ersetzt das fruehere binaere isInverted-Feld aus v9).
	--
	-- Eine seltene Variante JEDES Baerchis (Wurf beim Schluepfen:
	-- BaerchiConfig.rollMutation()), diesmal GESTUFT statt binaer: acht
	-- Stufen mit steigendem Stat-Multiplikator, steigender Seltenheit und
	-- eigener Farbe/Leuchten (siehe BaerchiConfig.MUTATIONS). nil = keine
	-- Mutation, der weit ueberwiegende Normalfall.
	--
	-- Bewusst ein eigenes Feld und KEINE eigene Rarity: die Rarity steuert
	-- Gacha-Gewichte, Stat-Obergrenzen, Fusions-Kette und Farben. Mutation an
	-- sie zu haengen haette all das mitverbogen — derselbe Grund wie zuvor bei
	-- Inverted, nur jetzt mit mehr als zwei moeglichen Zustaenden.
	mutation : MutationId?,
}

--------------------------------------------------------------------------------
-- Insel-Daten
--------------------------------------------------------------------------------

export type Building = {
	id    : BuildingId,
	level : number,   -- 1 .. EconomyConfig.MAX_BUILDING_LEVEL (60)

	-- Eingelagerter Honig, 0 .. EconomyConfig.HONEY_CAPACITY.
	honey : number,

	-- os.time() des zuletzt ANGERECHNETEN Honigs. Die Produktion laeuft nicht
	-- ueber einen Timer sondern wird aus dieser Zeitmarke nachgerechnet
	-- (gleiches Prinzip wie HatchingEgg.readyAt) — dadurch produzieren die
	-- Gebaeude auch waehrend der Spieler offline ist, ohne Server-Loop.
	lastProducedAt : number,
}

-- v12: Brut-Slots (HatchingEgg, island.hatchingEggs) sind entfallen. Ein Ei
-- aus dem Lager wird per Klick sofort geoeffnet (EggService.openEgg). Die
-- Migration (Util/PlayerMigration) legt laufende Bruten alter Spielstaende zurueck
-- ins Lager.

-- v15: TOWER-SYSTEM (ersetzt das PIT-Level).
--
-- Vier Tower mit eigener Stage-Zahl und eigenem Gegner-Wachstum, Zahlen in
-- Config/TowerConfig. "I" Holz (30 Stages), "II" Stein (45), "III" Gold (60),
-- "Final" Kristall (100).
export type TowerId = "I" | "II" | "III" | "Final" | "Endless"   -- Endless: HBB Paket 9

-- Permanenter Tower-Fortschritt. Liegt bewusst AUSSERHALB von island (wie
-- eggTree): ein Rebirth setzt die Insel zurueck, Rekorde und abgeholte
-- Meilensteine bleiben.
--
--   records      beste geschaffte Stage je Tower (zaehlt nur bis zum Deckel
--                des jeweiligen Rebirths, siehe TowerConfig.getStageCap)
--   claimed      abgeholte Meilenstein-Stages je Tower. Die Stage steht als
--                TEXT-Schluessel ("5", "10"): eine Lua-Tabelle mit Luecken in
--                Zahlen-Schluesseln laesst sich nicht im DataStore ablegen
--                (derselbe Grund wie bei Baerchi.charms).
--   highestTower hoechster je erreichte Tower (Look des Turms, Abzeichen)
--   selected     der Tower, in den der Fight-Knopf schickt
--   unlocked     v17 (08.10.): freigeschaltete Tower. Tower N+1 geht auf,
--                sobald Tower N geschafft ist (TowerConfig.UNLOCK_AFTER);
--                die Migration traegt ein, was vorher per Rebirth offen war
--                (Bestandsschutz). Tower I steht immer drin.
export type TowerState = {
	records      : { [string]: number },
	claimed      : { [string]: { [string]: boolean } },
	highestTower : string,
	selected     : string,
	unlocked     : { [string]: boolean },
	endlessWeek  : { week: number, best: number }?, -- Paket 9: beste Endless-Stage der Woche
}

-- v15: Taeglicher Login-Bonus (Config/LoginBonusConfig). Tage zaehlen nach
-- UTC (os.time() // 86400). streak = wie viele Tage des 7-Tage-Zyklus schon
-- abgeholt sind (0-7); lastClaimDay = UTC-Tag der letzten Abholung (0 = nie).
export type DailyState = {
	lastClaimDay : number,
	streak       : number,
}

-- Ein GELEGTES Ei: liegt sichtbar in der Welt und wartet darauf, angeklickt zu
-- werden. Erst beim Einsammeln wird daraus ein Eintrag in eggStock, der sich
-- ausbrueten laesst.
--
-- Die Position steht als drei Zahlen drin, nicht als Vector3: ein DataStore
-- kann nur einfache Werte speichern, ein Vector3 waere beim naechsten Laden
-- verschwunden.
--
-- Warum das Ei ueberhaupt eine Position hat: es wird dort abgelegt, wo der
-- Baerchi im Moment des Legens stand. Wer seinen Baerchi zum Honig-Teich und
-- zurueck laufen laesst, findet danach eine Spur aus Eiern — genau das ist
-- gewollt.
export type LaidEgg = {
	uid     : string,     -- eindeutig, wird zum Einsammeln benutzt
	eggType : EggType,
	laidAt  : number,     -- os.time(), nur fuer die Anzeige ("gerade eben")
	x       : number,
	y       : number,     -- Fusspunkt, das Ei sitzt mit seiner Unterkante darauf
	z       : number,
	-- INCUBATOR_BREED: vom Inkubator gebruetet (eigene Obergrenze, zaehlt
	-- nicht gegen die des ausgeruesteten Baerchis).
	fromIncubator : boolean?,
}

-- v15: der Waben-Recycler vor der Basis (siehe Config/CombConfig). Er nimmt die
-- Waben, die der Spieler im Event-Pit gesammelt hat, in eine Warteschlange und
-- verwandelt sie nach und nach in Gummies. Wie Building.lastProducedAt laeuft
-- das ueber eine Zeitmarke und nicht ueber einen Timer, damit er auch offline
-- weiterarbeitet.
export type RecyclerData = {
	level           : number,   -- 1 .. CombConfig.RECYCLER_MAX_LEVEL
	queued          : number,   -- Wabeneinheiten, die noch verarbeitet werden muessen
	progress        : number,   -- angefangene Einheit (0 .. <1), damit keine Bruchteile verloren gehen
	lastProcessedAt : number,   -- os.time() der letzten Verrechnung
}

export type IslandData = {
	buildings    : { [BuildingId]: Building },
	-- HONEY_POND_V2: Gebaeude, die im aktuellen Modus nicht gelten (Teich
	-- bzw. Stock + Veredler). Bleiben erhalten, kommen beim Zurueckschalten
	-- wieder (Modules/HoneyPondMode). nil = keine.
	retiredBuildings : { [BuildingId]: Building }?,
	baerchis     : { [string]: Baerchi },     -- key = Baerchi.uid
	eggStock     : { [EggType]: number },     -- Eier im Lager (Legen, Events, Rebirth, Haendler)

	-- Der EINE Baerchi, der auf dem Plot steht: laeuft selbststaendig zum
	-- Honig-Teich, in den PIT und wieder zurueck. Alle anderen bleiben reiner
	-- Inventar-Datensatz und werden nicht in der Welt gebaut (MapService
	-- rendert ausschliesslich diesen). nil = noch keiner ausgeruestet (leerer
	-- Plot) — kommt nur direkt nach dem ersten Ei oder nach einem Rebirth vor,
	-- IslandService ruestet den ersten geschluepften Baerchi automatisch aus.
	equippedUid  : string?,

	-- v10: Eier, die der ausgeruestete Baerchi gelegt hat und die noch
	-- herumliegen. Gedeckelt durch EggConfig.MAX_UNCOLLECTED_EGGS.
	laidEggs : { LaidEgg },

	-- os.time() des zuletzt ANGERECHNETEN Eis. Genau wie
	-- Building.lastProducedAt: die Produktion laeuft nicht ueber einen Timer,
	-- sondern wird aus dieser Zeitmarke nachgerechnet — dadurch legt der
	-- Baerchi auch waehrend der Spieler offline ist weiter (langsamer, siehe
	-- EggConfig.OFFLINE_SLOWDOWN) und es braucht keinen Server-Loop dafuer.
	lastEggAt : number,

	-- v15: Waben-Recycler (Level 1-60 + Warteschlange).
	recycler : RecyclerData,

	-- v15: letzte erreichte Stage je Tower fuer die Fortsetzungs-Frage
	-- (ersetzt pitProgress). Schluessel = TowerId. Gehoert zur Insel, weil ein
	-- Rebirth den Baerchi auf Level 1 setzt und ein alter Einstieg dann
	-- sinnlos waere.
	towerProgress : { [string]: number },

	-- v15: Erstattung fuer gekaufte PIT-Level (Migration v14 -> v15). Die
	-- Migration schreibt den Betrag, TowerService zahlt ihn beim Join ueber
	-- EconomyService aus und setzt das Feld auf 0.
	pitRefund : number,

	-- v16 (Sammel-Update, Paket 4.1): beste geschaffte Stage je Tower in
	-- DIESEM Leben (seit dem letzten Rebirth). Die Rebirth-Bedingung
	-- (TowerConfig.getRebirthRequirement) prueft dagegen — nicht gegen die
	-- dauerhaften Rekorde, sonst koennte ein Veteran mehrere Rebirths am Stueck
	-- machen. Liegt in der Insel, damit ein Rebirth es von selbst leert.
	stageBest : { [string]: number },

	-- v16 (Sammel-Update, Paket 8): der Inkubator auf dem Plot.
	incubator : IncubatorData,
}

-- v16 (Paket 8): ein belegter Brut-Platz. Zeitmarken statt Timer (wie
-- Honig und Recycler): fertig ist das Ei, sobald os.time() >= finishAt —
-- auch wenn der Spieler dazwischen offline war. `slot` steht IM Eintrag
-- (dichte Liste, derselbe DataStore-Grund wie bei Baerchi.charms).
export type IncubatorSlot = {
	slot      : number,    -- 1 .. IncubatorConfig.MAX_SLOTS
	eggType   : EggType,
	startedAt : number,
	finishAt  : number,
}

-- v16 (Paket 8): Level (Ausbau mit Gummies, Geldsenke vor dem Rebirth) und
-- die belegten Plaetze. Ein Rebirth setzt das Level zurueck, die Eier in den
-- Plaetzen bleiben (wie das Ei-Lager).
export type IncubatorData = {
	level : number,
	slots : { IncubatorSlot },
	-- INCUBATOR_BREED (Wunsch 05.10.): Baerchis, die im Inkubator sitzen und
	-- im Takt ihrer Rarity zusaetzliche Eier bruehten. Optional, damit alte
	-- Staende ohne das Feld gueltig bleiben (PlayerMigration fuellt es).
	breeders : { IncubatorBreeder }?,
}

-- INCUBATOR_BREED: ein belegter Platz mit Baerchi. `lastEggAt` ist die
-- Zeitmarke (os.time) des letzten Eis — wie island.lastEggAt beim Legen.
export type IncubatorBreeder = {
	slot      : number,    -- 1 .. IncubatorConfig.MAX_SLOTS
	uid       : string,    -- island.baerchis[uid]
	lastEggAt : number,
}

--------------------------------------------------------------------------------
-- Lokalisierte Nachrichten (Server → Client)
--------------------------------------------------------------------------------

-- Der Server formuliert nie einen Satz. Er schickt einen Schluessel plus Zahlen
-- bzw. Namen, der Client baut daraus den Text in der Sprache des Spielers
-- (siehe Localization/Loc). Ein Argument darf selbst wieder eine LocMsg sein,
-- damit z.B. ein Eiername in der Sprache des Spielers eingesetzt wird.
--
-- Konvention fuer Schluessel: "err.*" fuer abgelehnte Aktionen, "msg.*" fuer
-- Meldungen, "ui.*" fuer feste Beschriftungen. Die Texte stehen ausschliesslich
-- in Localization/Strings/<sprache>.luau.
export type LocArg = string | number | LocMsg
export type LocMsg = {
	k : string,                      -- Schluessel
	a : { [string]: LocArg }?,       -- Platzhalter-Werte
}

--------------------------------------------------------------------------------
-- Quests und Index (v13)
--------------------------------------------------------------------------------

-- Gespeicherter Quest-Stand. Gespeichert wird bewusst NUR, was sich nicht aus
-- den Spielzaehlern ableiten laesst: wie viele Kettenquests schon abgeholt
-- wurden, und der Tagesstand. Den Fortschritt selbst rechnet QuestProgress
-- jedes Mal frisch aus data.stats / island — so gibt es keine zweite Wahrheit,
-- die auseinanderlaufen kann, und kein anderer Service muss Quests kennen.
export type QuestBaseline = {
	hatched     : number,
	fightsWon   : number,
	gummies     : number,
}

export type QuestState = {
	chainClaimed : number,                    -- Kettenquests, die schon abgeholt sind
	day          : number,                    -- Tagesnummer (UTC), siehe QuestConfig.dayOf
	baseline     : QuestBaseline,             -- Zaehlerstand zu Tagesbeginn
	dailyClaimed : { [string]: boolean },     -- abgeholte Tages-Quests von `day`
}

-- Eine Zeile in der Quest-Anzeige (Server -> Client). Keine Texte: der Client
-- baut sie aus der id (Schluessel "quest.<id>.title").
export type QuestEntry = {
	id       : string,
	kind     : string,   -- "chain" | "daily"
	progress : number,   -- schon auf `target` gedeckelt
	target   : number,
	claimed  : boolean,
}

export type QuestView = {
	chain      : QuestEntry?,   -- aktuelle Kettenquest, nil = Kette komplett
	chainDone  : number,        -- wie viele der Kette erledigt sind
	chainTotal : number,
	daily      : { QuestEntry },
	dailyResetIn : number,      -- Sekunden bis zum naechsten Tageswechsel
}

-- Belohnungs-Meldung (Server -> Client), fuer den Toast.
export type QuestReward = {
	questId : string,
	gummies : number,
	eggType : EggType?,
	goldGummies : number?,   -- GOLD_CHARMS_ONLY: Tages-Quests
}

--------------------------------------------------------------------------------
-- Ei-Baum (v14)
--------------------------------------------------------------------------------

-- Fortschritt im Ei-Baum. Liegt bewusst AUSSERHALB von island: ein Rebirth
-- setzt die Insel zurueck, den Baum aber nicht — er ist der lange Grind.
--
--   unlocked   Eier, deren Knoten frei ist (einmal frei, immer frei)
--   hatched    wie oft jedes Ei schon geoeffnet wurde (Freischalt-Bedingung)
--   pressed    wie oft jedes Ei in der Ei-Presse entstanden ist (Statistik)
--   blueprints Blaupausen aus Events, noch nicht eingesetzt
--   bypass     Knoten, deren Hatch- und Index-Bedingung eine Blaupause
--              ersetzt hat (das Rebirth-Gate gilt trotzdem)
export type EggTreeState = {
	unlocked   : { [string]: boolean },
	hatched    : { [string]: number },
	pressed    : { [string]: number },
	blueprints : number,
	bypass     : { [string]: boolean },
}

--------------------------------------------------------------------------------
-- Spieler-Rang
--------------------------------------------------------------------------------

export type Rank = {
	tier   : number,  -- 1, 2, 3 ...
	name   : string,  -- "Gummy Hatchling", "Sugar Brawler", "Golden Champion" ...
	points : number,  -- Rangpunkte (PvP Arena)
}

--------------------------------------------------------------------------------
-- Sitzungs-Sperre
--------------------------------------------------------------------------------

-- jobId ist game.JobId des haltenden Servers, lockedAt sein os.time() beim
-- letzten Laden oder Speichern.
export type SessionLock = {
	jobId    : string,
	lockedAt : number,
}

--------------------------------------------------------------------------------
-- PlayerData — alles was im DataStore landet
--------------------------------------------------------------------------------

-- HBB Paket 10: Shop-Teil des Spielstands (Regeln: Modules/ShopRules)
export type ShopState = {
	freeGrabDay : number,     -- UTC-Tag des letzten Gratis-Griffs, -1 = nie
	receipts    : { string }, -- zuletzt ausgezahlte Robux-Kauf-IDs
}

-- HBB Paket 10: was der Client fuer das Shop-Fenster braucht
export type ShopView = {
	freeReady  : boolean,
	nextFreeIn : number,      -- Sekunden bis zum naechsten UTC-Tag
	freeGold   : number,
}

export type PlayerData = {
	-- Schema
	version    : number,   -- fuer Migrationen beim Laden alter Daten
	createdAt  : number,   -- Unix-Timestamp
	lastSeenAt : number,   -- fuer Offline-Gummy-Farm-Berechnung

	-- Waehrungen
	gummies     : number,  -- aktiv: PIT-Kaempfe, Quests, Recycling
	goldGummies : number,  -- Premium: PIT-Meilensteine, Events

	-- Progression
	rebirthCount : number,   -- Anzahl Rebirths
	rebirthMult  : number,   -- Earnings-Multiplikator (1.0 → 1.5 → 2.25 ...)
	rank         : Rank,

	-- Gewaehlte Sprache ("de" | "en" | "fr" | "es"). nil = der Spieler hat nie
	-- gewaehlt, es gilt die Roblox-Sprache seines Clients. Bewusst OHNE
	-- Versions-Sprung: ein fehlendes Feld liest sich in Lua ohnehin als nil
	-- und bedeutet genau "automatisch" (wie equippedUid in v6).
	language     : string?,

	-- Insel
	island : IslandData,

	-- Nur serverseitig relevant (wird nicht an Client gesendet)
	stats : {
		totalGummiesEarned  : number,
		totalFightsWon      : number,
		totalFightsLost     : number,
		totalFusions        : number,
		totalRebirths       : number,
		totalRecycled       : number,
		totalHatched        : number,   -- v13: geoeffnete Eier (Quest-Zaehler)
		-- HBB Paket 2: Events, an deren Ende der Baerchi belohnt wurde
		-- (Fuehrung: "erstes Event geschafft"). Alte Staende starten bei 0.
		totalEventsCompleted : number,
		-- Sammel-Update 05.10. (Paket 6.2): Boss-Siege mit eigenem Schaden
		-- (besonderer Meilenstein "erster Boss-Sieg"). Alte Staende starten bei 0.
		bossVictories : number,
		-- Sammel-Update 05.10. (Paket 3.5): im Recycler abgegebene Waben
		-- (Einfuehrung "Waben abgeben"). Alte Staende starten bei 0.
		totalCombsDelivered : number,
	},

	-- v13: Index. Jede configId, die der Spieler je besessen hat (auch nach
	-- Recycling/Fusion/Rebirth). Wird nie geleert.
	discovered : { [string]: boolean },

	-- HBB Paket 3: welche Bedienelemente der Spieler schon gesehen hat
	-- (Badge "!" nur fuer neue). Rein kosmetisch, gesetzt nur von
	-- UiStateService; Ids siehe Modules/UnlockRules.ELEMENTS.
	uiSeen : { [string]: boolean },

	-- HBB Paket 10: Shop (Gratis-Griff, gemerkte Robux-Kaeufe)
	shop : ShopState,

	-- v13: Quest-Stand
	quests : QuestState,

	-- v14: Ei-Baum (ueberlebt Rebirths)
	eggTree : EggTreeState,

	-- v15: Tower-Rekorde und Meilensteine (ueberleben Rebirths)
	towers : TowerState,

	-- v15: taeglicher Login-Bonus
	daily : DailyState,

	-- v16 (Sammel-Update, Paket 7): abgeholte Index-Belohnungen
	-- (Schluessel = IndexRewardConfig-Id, z.B. "egg:BasicEgg", "path:Gold").
	indexClaimed : { [string]: boolean },

	-- v16 (Sammel-Update, Paket 6.2): ausgezahlte besondere Meilensteine
	-- (EconomyConfig.SPECIAL_MILESTONES, einmalig pro Konto, auch rueckwirkend).
	specialClaimed : { [string]: boolean },

	-- Welcher Server den Spielstand gerade haelt (siehe Util/SessionLock).
	-- Nur serverseitig, geht nie an den Client. nil = niemand; das ist der
	-- Stand nach einem sauberen Verlassen und bei jedem alten Spielstand,
	-- deshalb ohne Versions-Sprung.
	session : SessionLock?,
}

--------------------------------------------------------------------------------
-- Netzwerk-Typen (Server → Client Updates)
--------------------------------------------------------------------------------

-- Wird nach jeder relevanten Aenderung gefeuert.
-- Stats werden bewusst weggelassen (kein Leak sensibler Serverdaten).
export type PlayerDataUpdate = {
	gummies      : number,
	goldGummies  : number,
	rebirthCount : number,
	rebirthMult  : number,
	rank         : Rank,
	language     : string?,
	island       : IslandData,
	discovered   : { [string]: boolean },
	quests       : QuestView,
	eggTree      : EggTreeState,   -- v14
	towers       : TowerState,     -- v15
	daily        : DailyView,      -- v15
	-- HBB Paket 2: fuer Fuehrung und Freischaltung (rein lesend im Client)
	stats        : { [string]: number }?,
	createdAt    : number?,
	uiSeen       : { [string]: boolean }?,   -- HBB Paket 3
	shop         : ShopView?,                -- HBB Paket 10
	indexClaimed : { [string]: boolean }?,   -- v16: Paket 7
}

-- v15: was der Client fuer das Login-Bonus-Fenster braucht (fertig
-- ausgewertet vom Server, siehe LoginBonusService.buildView).
--   day        welcher Tag des Zyklus heute dran ist (1-7)
--   claimable  heute noch nicht abgeholt
--   streak     schon abgeholte Tage im laufenden Zyklus
--   resetIn    Sekunden bis zum naechsten UTC-Tag
export type DailyView = {
	day       : number,
	claimable : boolean,
	streak    : number,
	resetIn   : number,
}

-- Eine einzelne Kampf-AKTION (v14: Runden-Log). Bleibt serverseitig in
-- CombatCalculator und wird NICHT komplett an den Client geschickt: ein
-- PIT-Lauf hat viele Stages, das ganze Protokoll waere ein Vielfaches der
-- Nutzlast. Der Client bekommt pro Stage nur die Zusammenfassung
-- (PitStageResult.skillUses / firstSkillRound) — genug fuer die SkillFX.
--
-- Seit v14 handelt jeder Kaempfer nach seiner SPD (siehe CombatCalculator),
-- ein Eintrag ist deshalb EINE Aktion von A oder B, nicht mehr eine
-- Doppelrunde.
export type RoundLogEntry = {
	roundNumber     : number,     -- wievielte Aktion von A (der Baerchi)
	actor           : string,     -- "A" | "B"
	-- v15: was in diesem Zug passiert ist: "hit" (Stoss), "skill"
	-- (Faehigkeit), "burst" (Feuerstoss nach Letzter Chance), "stunned"
	kind            : string,
	chargeA         : number,     -- v15: Ladestand von A nach dem Zug (0..1)
	skillUsed       : boolean,
	skillId         : string?,
	damage          : number,     -- wirklich abgezogene HP beim Ziel
	heal            : number,
	absorbed        : number,     -- vom Schild abgefangen
	effects         : { string }?, -- "stun", "slow", "dot", "burn:12", "laststand" ...
	attackerHpAfter : number,     -- HP von A nach der Aktion
	defenderHpAfter : number,     -- HP von B nach der Aktion
}

-- v15: ein Zug fuer die WIEDERGABE in der Arena (aus RoundLogEntry
-- verdichtet). Bleibt serverseitig: CombatService baut die Liste,
-- PitArenaService spielt sie ab (Stoesse, Faehigkeiten, Lebens- und
-- Ladeleisten). HP und Ladung als Anteil 0..1, damit die Leisten direkt
-- gesetzt werden koennen.
export type FightBeat = {
	actor   : string,    -- "A" = der Baerchi, "B" = der Gegner
	kind    : string,    -- "hit" | "skill" | "burst" | "stunned"
	selfHp  : number,    -- HP des Baerchis nach dem Zug (0..1)
	enemyHp : number,    -- HP des Gegners nach dem Zug (0..1)
	charge  : number,    -- Ladestand der Faehigkeit des Baerchis (0..1)
	skillId : string?,   -- bei "skill"/"burst"
	bonus   : boolean?,  -- Finisher/Opener hat gegriffen (nur Optik der Show)
}

-- Eine bestandene (oder verlorene) Stage innerhalb eines PIT-Laufs.
export type PitStageResult = {
	stage      : number,
	won        : boolean,
	rounds     : number,
	hpAfter    : number,   -- HP des Baerchis NACH dieser Stage
	gummiesWon : number,
	-- v14: fuer die Fähigkeiten-Animation (SkillFX)
	skillUses       : number?,   -- wie oft der Skill in dieser Stage kam
	firstSkillRound : number?,   -- erste Aktion mit Skill (nil = keiner)
}

-- Ergebnis eines kompletten PIT-Laufs.
--
-- Ein Lauf ist kein einzelner Kampf mehr: der Baerchi kaempft Stage fuer
-- Stage weiter, solange er ueberlebt. Seine HP werden zwischen den Stages
-- NICHT zurueckgesetzt — der Lauf endet erst wenn er verliert. Danach steht
-- er erschoepft (hpAfter, meist 0) auf dem Plot und muss mit Honig
-- hochgefuettert werden.
export type PitRunResult = {
	baerchiUid    : string,
	towerId       : string?,          -- v15: in welchem Tower der Lauf war
	capStage      : number?,          -- v15: Deckel des Rebirths in diesem Tower (Belohnung/Rekord nur bis hier)
	capReached    : boolean?,         -- v15: der Lauf hat den Deckel erreicht (Rebirth-Hinweis)
	newRecord     : number?,          -- v15: neuer Tower-Rekord (nil = keiner)
	startStage    : number,           -- v12: erste gespielte Stage (1 = von vorn, sonst Fortsetzung)
	recalled      : boolean,          -- v12: true = vom Spieler nach einer Stage zurueckgeholt
	corrected     : boolean?,         -- v12: true = nachgeschicktes, gekuerztes Ergebnis nach dem Zurueckholen
	stagesCleared : number,           -- wie viele Stages gewonnen wurden
	stages        : { PitStageResult },
	gummiesWon    : number,           -- Summe ueber alle Stages, bereits mit rebirthMult
	goldGummiesWon: number,           -- Meilenstein-Belohnung (siehe EconomyConfig)
	hpBefore      : number,           -- HP mit denen der Lauf gestartet wurde
	hpAfter       : number,
	maxHp         : number,
}

-- Ergebnis einer Fuetterung: ein Honig heilt und gibt XP.
export type FeedResult = {
	baerchiUid : string,
	buildingId : BuildingId,   -- aus welchem Gebaeude der Honig kam
	hpGained   : number,
	xpGained   : number,
	leveledUp  : boolean,
	newLevel   : number,
	hpAfter    : number,
	maxHp      : number,
}

export type HatchResult = {
	eggType  : EggType,
	baerchi  : Baerchi,
	isNew    : boolean,   -- erstes Mal dieser configId → besondere Animation
}

-- Ergebnis eines Charm-Wurfs, eines Events oder einer Fusion enthaelt den
-- Baerchi selbst — `mutation` steht dort mit drin, ein eigener Typ dafuer
-- waere ueberfluessig.

export type FusionResult = {
	resultBaerchi : Baerchi,
	consumedUids  : { string },
}

export type RecycleResult = {
	consumedUid   : string,
	gummiesGained : number,
	goldGummiesGained : number,
}

-- Ergebnis einer Befoerderung (PromotionService).
export type PromotionResult = {
	baerchiUid       : string,
	newPromotion     : number,      -- 1 - PromotionConfig.MAX_PROMOTION
	consumedUids     : { string },  -- die verbrauchten Duplikate
	unlockedSlots    : { number },  -- Charm-Slots, die durch DIESE Stufe dazukamen
}

-- Ergebnis eines Charm-Wurf-Pakets (CharmService).
--
-- `rolls` ist die Anzahl der tatsaechlich durchgefuehrten Wuerfe: bei einem
-- Auto-Roll kann sie kleiner sein als angefragt, wenn zwischendurch die
-- GoldGummies ausgehen. Der Client zeigt genau diese Zahl an, nicht die
-- angefragte — sonst behauptet die Oberflaeche etwas, das nicht passiert ist.
export type CharmRollResult = {
	baerchiUid       : string,
	rolls            : number,
	goldGummiesSpent : number,
	charms           : { Charm },   -- Stand NACH allen Wuerfen
}

-- Ein gelegtes Ei wurde eingesammelt (fuer den Toast beim Spieler).
export type EggCollectResult = {
	eggUid   : string,
	eggType  : EggType,
	inStock  : number,   -- wie viele von dieser Sorte jetzt im Lager liegen
}

-- Beim Join nachgerechnete Eier aus der Abwesenheit. Wird zusammen mit dem
-- Honig-Bericht gezeigt (siehe OfflineReport) — aber als eigener Typ, weil
-- die beiden Systeme sonst aneinander haengen wuerden.
export type OfflineEggReport = {
	laid        : number,   -- wie viele Eier nachgelegt wurden
	skipped     : boolean,  -- true wenn die Obergrenze das Nachlegen gebremst hat
	secondsAway : number,
}

-- Was eine Event-Teilnahme gebracht hat (EventParticipationService).
--
-- Heisst weiterhin "StatGain", weil die Stat-Stufe der Kern der Belohnung ist —
-- seit dem Event-Katalog (EventConfig) kann aber zusaetzlich ein Bonus dazu
-- kommen, und in einem Fall NUR der Bonus.
export type EventStatGain = {
	baerchiUid : string,
	eventId    : string,

	-- Welcher Stat gestiegen ist ("hp" | "atk" | "spd" | "pwr" | "egg").
	--
	-- nil heisst: es gab KEINE Stat-Stufe, weil bereits jeder Stat dieses
	-- Baerchis an seiner Rarity-Obergrenze steht. Der Bonus unten wurde
	-- trotzdem vergeben — deshalb ist das kein Fehlerfall, und der Client muss
	-- diesen Fall anzeigen koennen statt ihn zu verwerfen.
	statKey    : string?,
	newLevel   : number,   -- 0, wenn statKey nil ist
	cap        : number,

	-- Der Zusatz-Ertrag dieses Events als fertiger Text ("+1x Goldenes Ei").
	-- nil = dieses Event hatte keinen Bonus, oder der Wurf ging daneben
	-- (Mutations-Sturm). Bewusst als Text und nicht als Zahlenfeld pro
	-- Bonus-Art: der Client zeigt ihn nur an, und die Formulierung soll an
	-- EINER Stelle stehen (EventConfig.describeBonus bzw. der Ausgabe-Text in
	-- EventParticipationService).
	bonusText  : (string | LocMsg)?,   -- Sammel-Update 2.4: meist LocMsg

	-- Gesetzt, wenn der Baerchi durch dieses Event eine (bessere) Mutation
	-- bekommen hat — der seltenste Ausgang im ganzen Event-System, deshalb als
	-- eigenes Feld statt nur im Text: der Client faerbt den Hinweis damit ein.
	mutation   : MutationId?,

	-- true: Zwischenmeldung WAEHREND eines Events (UFO-Kampf, Fund, Entfuehrung)
	-- statt Abschlussmeldung. Der Client zeigt dann nur `bonusText`.
	midEvent   : boolean?,

	-- Neue Rarity, falls das UFO den Baerchi aufsteigen liess.
	rarityUp   : string?,
}

-- Telegraph einer Boss-Attacke (Server → alle Clients, Remotes.EventTelegraph).
-- Die Wahrheit (wer getroffen wird) rechnet der Server zum Zeitpunkt hitAt;
-- der Client zeichnet nur die Warnflaeche von jetzt bis hitAt.
--   kind = "ring"    Kreisring um `center` zwischen `inner` und `outer`
--   kind = "circles" Kreise mit Radius `radius` um jeden Punkt in `points`
--   kind = "lane"    Bahn von `from` nach `to`, Breite `width`
-- warnAt/hitAt sind Serverzeiten (workspace:GetServerTimeNow()).
export type HazardTelegraph = {
	kind   : "ring" | "circles" | "lane",
	center : Vector3?,
	inner  : number?,
	outer  : number?,
	points : { Vector3 }?,
	radius : number?,
	from   : Vector3?,
	to     : Vector3?,
	width  : number?,
	warnAt : number,
	hitAt  : number,
}

-- Treffer einer Boss-Attacke am eigenen Charakter (Server → ein Client,
-- Remotes.EventHazardHit). Der Server hat entschieden; der Client fuehrt nur
-- die Physik an seinem eigenen Charakter aus (er besitzt ihn).
export type HazardHit = {
	push        : Vector3,   -- Rueckstoss (Studs/s, waagerecht)
	slowFactor  : number,    -- WalkSpeed-Faktor fuer slowSeconds
	slowSeconds : number,
	-- Sammel-Update 05.10. (Paket 5.2): "boss" (Standard) oder "brawl"
	-- (gegnerischer Event-Baerchi) — nur fuer die Meldung beim Client.
	source      : string?,
}

export type RebirthResult = {
	newRebirthCount : number,
	newMultiplier   : number,
	ascensionEggs   : number,   -- Summe aller Meilenstein-Eier (0 = keine), fuer alte Anzeigen
	-- v14: Meilenstein-Eier nach Sorte (Ascension, Transzendenz, Ewigkeit, Omega)
	milestoneEggs   : { { eggType: EggType, count: number } }?,
}

-- v14: ein Knoten im Ei-Baum ist frei geworden (fuer den Toast).
export type EggUnlockResult = {
	eggType : EggType,
	reason  : string,    -- "tree" | "blueprint" | "rebirth" | "migration"
}

-- v14: Ergebnis der Ei-Presse.
export type EggPressResult = {
	fromEgg : EggType,
	toEgg   : EggType,
	used    : number,
}

-- v15: ein Tower-Meilenstein wurde ausgezahlt (Toast).
export type TowerMilestoneReward = {
	towerId     : string,
	stage       : number,
	gummies     : number,   -- ohne Rebirth-Multiplikator
	goldGummies : number,
	eggType     : EggType?,
	eggs        : number,
	blueprints  : number,
	endlessLevels : number?, -- Paket 9: +Endless-Level fuer den ausgeruesteten Baerchi
}

-- v15: eine Zeile einer Bestenliste (Server → Client).
export type LeaderboardEntry = {
	rank   : number,
	userId : number,
	name   : string,
	value  : number,
}

-- v15: eine Bestenliste. listId = "Tower" | "Rebirths" | "Collection".
-- ownRank = Rang des Anfragenden (nil = nicht in den Top N).
export type LeaderboardView = {
	listId    : string,
	entries   : { LeaderboardEntry },
	ownRank   : number?,
	ownValue  : number,
	updatedAt : number,
}

-- v15: die Profilkarte eines anderen Spielers (Inspektor). Der Server baut sie
-- aus den Daten im Speicher — rohe PlayerData gehen nie an fremde Clients.
export type ProfileBaerchi = {
	configId  : string,
	rarity    : Rarity,
	mutation  : MutationId?,
	level     : number,
	promotion : number,
	power     : number,   -- grobe Staerke (fuer die Top-3-Sortierung)
}

export type PlayerProfileCard = {
	userId       : number,
	name         : string,
	equipped     : ProfileBaerchi?,
	highestTower : string,
	towerRecord  : number,
	rebirths     : number,
	indexCount   : number,
	indexTotal   : number,
	top          : { ProfileBaerchi },
}

-- v16 (Sammel-Update, Paket 6.2): ein besonderer Meilenstein wurde
-- ausgezahlt (Toast). id = Schluessel in EconomyConfig.SPECIAL_MILESTONES.
export type SpecialMilestoneResult = {
	id   : string,
	eggs : { { eggType: EggType, count: number } },
}

-- v16 (Sammel-Update, Paket 7): eine Index-Belohnung wurde abgeholt (Toast).
export type IndexRewardResult = {
	rewardId       : string,
	gummies        : number,
	goldGummies    : number,
	eggType        : EggType?,
	eggs           : number,
	blueprints     : number,
	incubatorSlots : number,
}

-- v15: Ergebnis des Login-Bonus (Toast).
export type DailyBonusResult = {
	day         : number,
	gummies     : number,
	goldGummies : number,
	eggType     : EggType?,
	eggs        : number,
	blueprint   : boolean,
}

-- Offline-Ertrag beim Join (Server → Client, direkt nach dem ersten Sync).
-- Seit v4 ist das der Honig, den die Gebaeude waehrend der Abwesenheit
-- produziert haben — gedeckelt durch EconomyConfig.HONEY_CAPACITY pro
-- Gebaeude, laenger weg bringt also nichts zusaetzlich.
export type OfflineReport = {
	secondsAway  : number,
	honeyGained  : number,
}

--------------------------------------------------------------------------------
-- Default-Fabrik (nur PlayerService darf dies aufrufen)
--------------------------------------------------------------------------------

local function createDefaultPlayerData(): PlayerData
	local now = os.time()

	local data: PlayerData = {
		-- v11: das binaere isInverted-Feld weicht dem gestuften Mutation-System
		-- (siehe Baerchi.mutation und BaerchiConfig.MUTATIONS). Die Migration in
		-- PlayerService bildet alte isInverted=true-Eintraege auf eine feste
		-- Mutation ab und entfernt das alte Feld — DAS ist der Grund, warum
		-- diese Zahl steigen MUSS: es wird wieder etwas ENTFERNT, nicht nur
		-- ein fehlendes Feld angelegt (dieselbe Konvention wie beim v9-Sprung).
		--
		-- v10: der ausgeruestete Baerchi legt Eier. Neu sind island.laidEggs
		-- und island.lastEggAt; die Migration legt beide an.
		--
		-- v9: DEF ist ersatzlos entfallen, PWR (Ability-Staerke) ist an seine
		-- Stelle getreten, und jeder Baerchi hat ein isInverted-Feld bekommen.
		-- Die Migration (Util/PlayerMigration) raeumt dafuer die alten def-Eintraege
		-- aus statLevels und baseStatOverride weg — DAS ist der Grund, warum
		-- diese Zahl steigen MUSS: die Migration entfernt etwas, statt nur ein
		-- fehlendes Feld anzulegen.
		--
		-- v8: jeder Baerchi hat drei neue Felder bekommen (promotionLevel,
		-- statLevels, charms) plus das optionale baseStatOverride. Die
		-- zugehoerige Migration (Util/PlayerMigration) legt sie auf bestehenden
		-- Baerchis an — sie erkennt fehlende Felder selbst und ist deshalb
		-- gefahrlos wiederholbar.
		--
		-- v7: eigene Rolle pro Gebaeude. KEIN neues Feld — die Zahl stieg
		-- trotzdem, weil die zugehoerige Migration (Util/PlayerMigration) einen Wert
		-- UMRECHNET (die Presse erbt einmalig das hoechste Gebaeude-Level) und
		-- deshalb genau einmal laufen darf.
		-- v13: Quests + Index. Neu: discovered, quests, stats.totalHatched. Die
		-- Migration seedet discovered aus den vorhandenen Baerchis und setzt
		-- totalHatched auf deren Anzahl, damit Veteranen nicht bei null starten.
		-- v12: Brut-Slots entfallen (Eier werden sofort geoeffnet), die
		-- Migration legt laufende Bruten zurueck ins Lager und ENTFERNT
		-- island.hatchingEggs. Neu: island.pitProgress (optional).
		-- v15: Gebaeude Option B (Honigtopf + Honig-Presse -> HoneyRefiner),
		-- Level 1-60, Tower statt PIT-Level (towers, island.towerProgress,
		-- island.pitRefund), Login-Bonus (daily). Die Migration RECHNET um
		-- (Veredler-Level, PIT-Erstattung, alter Rekord) — deshalb Sprung.
		-- v16 (Sammel-Update 05.10.): island.stageBest (Rebirth nach Stage),
		-- island.incubator (Inkubator), indexClaimed (Index-Belohnungen),
		-- specialClaimed (besondere Meilensteine). EINE gemeinsame Migration;
		-- sie legt nur an und saeet stageBest aus towerProgress, fasst keine
		-- Waehrung an.
		-- v17 (08.10., Tower-Terminal): towers.unlocked. Die Migration RECHNET
		-- die alte Rebirth-Regel in Freischaltungen um (Bestandsschutz) und
		-- darf das nur einmal — deshalb Sprung.
		version    = 17,  -- v17: Tower-Freischaltung durch Schaffen, v16: Sammel-Update, v15: Tower + Gebaeude B + Login-Bonus, v14: Ei-Baum, v13: Quests + Index (discovered, quests, stats.totalHatched), v12: Sofort-Oeffnen + pitProgress, v11: Mutation-System (v10: Eier legen, v9: PWR statt DEF + Inverted, v8: Promotion/Charms/Stat-Level, v7: Gebaeude-Rollen, v6: equippedUid, v5: Ei-uid, v4: Honig-Gebaeude + currentHp)
		createdAt  = now,
		lastSeenAt = now,

		gummies     = 100,
		goldGummies = 0,

		rebirthCount = 0,
		rebirthMult  = 1.0,

		rank = {
			tier   = 1,
			name   = "Gummy Hatchling",
			points = 0,
		},

		island = {
			-- Beide Honig-Gebaeude stehen ab dem ersten Join auf dem Plot und
			-- fangen sofort an zu produzieren.
			buildings = {
				Beehive      = { id = "Beehive",      level = 1, honey = 0, lastProducedAt = now },
				HoneyRefiner = { id = "HoneyRefiner", level = 1, honey = 0, lastProducedAt = now },
				HoneyPond    = { id = "HoneyPond",    level = 1, honey = 0, lastProducedAt = now },
			},
			baerchis     = {},
			eggStock     = {
				-- Sammel-Update 05.10. (Paket 6.4, "mehr Eier am Anfang"): 3 -> 6.
				-- Die ersten Minuten sollen mehrere Schluepf-Momente haben, bevor das
				-- Legen uebernimmt. Ein Rebirth setzt das Lager NICHT zurueck (siehe
				-- RebirthService), Veteranen bekommen also nichts doppelt.
				BasicEgg = 6,  -- Starter-Eier fuer den ersten Join
			},
			equippedUid  = nil,   -- noch kein Baerchi da, der ausgeruestet sein koennte

			laidEggs  = {},
			lastEggAt = now,

			recycler = { level = 1, queued = 0, progress = 0, lastProcessedAt = now },

			towerProgress = {},
			pitRefund     = 0,

			stageBest = {},                       -- v16: Paket 4.1
			incubator = { level = 1, slots = {}, breeders = {} },  -- v16: Paket 8
		},

		stats = {
			totalGummiesEarned  = 0,
			totalFightsWon      = 0,
			totalFightsLost     = 0,
			totalFusions        = 0,
			totalRebirths       = 0,
			totalRecycled       = 0,
			totalHatched        = 0,
			totalEventsCompleted = 0,
			bossVictories        = 0,   -- v16: Paket 6.2
			totalCombsDelivered  = 0,   -- v16: Paket 3.5
			sessions             = 0,   -- HBB Paket 10: Sitzungen (Shop ab der 2.)
		},

		-- HBB Paket 10: Shop (Modules/ShopRules). freeGrabDay = UTC-Tag des
		-- letzten Gratis-Griffs (-1 = nie), receipts = gemerkte Robux-Kauf-IDs.
		shop = { freeGrabDay = -1, receipts = {} },

		discovered = {},
		uiSeen     = {},

		eggTree = {
			unlocked   = { BasicEgg = true, SugarEgg = true },
			hatched    = {},
			pressed    = {},
			blueprints = 0,
			bypass     = {},
		},

		towers = {
			records      = {},
			claimed      = {},
			highestTower = "I",
			selected     = "I",
			unlocked     = { I = true },   -- v17
		},

		daily = {
			lastClaimDay = 0,
			streak       = 0,
		},

		indexClaimed   = {},   -- v16: Paket 7
		specialClaimed = {},   -- v16: Paket 6.2

		quests = {
			chainClaimed = 0,
			day          = 0,   -- 0 = noch nie gesetzt; QuestService setzt beim Join den Tag
			baseline     = { hatched = 0, fightsWon = 0, gummies = 0 },
			dailyClaimed = {},
		},
	}

	-- Honig-Teich oder Stock + Veredler, je nach Schalter (neue Spieler und
	-- Rebirth gehen beide hierueber).
	HoneyPondMode.apply(data.island, FeatureFlags.isOn("HONEY_POND_V2"), now)
	return data
end

return {
	createDefaultPlayerData = createDefaultPlayerData,
}
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="Folder" referent="RBX22"><Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Folder" referent="RBX23"><Properties>
<string name="Name">Core</string>
</Properties>
<Item class="Script" referent="RBX24"><Properties>
<string name="Name">GameManager</string>
<bool name="Disabled">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- GameManager.server.luau
-- ServerScriptService/Core/GameManager.server.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Services laden und in drei Phasen starten
--
-- Kein anderes Skript startet Services. Die drei Phasen:
--   1. laden   alle Module per require — danach existiert jedes Modul
--   2. init()  jeder Service richtet sich ein: Remotes verbinden, Rueckrufe
--              bei anderen Services anmelden (onDataLoaded, onEventEnded ...)
--   3. start() erst jetzt passiert etwas mit Spielern oder Zeit: PlayerService
--              laedt verbundene Spieler, EventService startet den Zyklus
--
-- Weil kein Service in init() schon Spieler verarbeitet, ist die Reihenfolge
-- in REGISTRY beliebig: jeder Rueckruf ist angemeldet, bevor der erste
-- Spieler geladen wird. Ein neuer Service traegt sich irgendwo ein und
-- verschiebt Arbeit mit Spielern in ein start().

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService          = game:GetService("RunService")

-- ALLERERSTE Zeile mit Wirkung, bevor irgendein Service laedt: kein Spieler
-- soll automatisch in der Weltmitte landen. Stattdessen spawnt PlayerService
-- jeden Spieler explizit auf seiner eigenen Insel (player:LoadCharacter(),
-- erst NACHDEM MapService.spawnIsland sein RespawnLocation gesetzt hat — siehe
-- PlayerService.onPlayerAdded). Muss vor jedem require() stehen: ein Spieler
-- kann in Studio-Play-Solo bereits verbunden sein, sobald dieses Skript
-- ueberhaupt zu laufen beginnt.
Players.CharacterAutoLoads = false

-- Der Name links ist nur fuer den Studio-Debug-Hook am Ende der Datei
-- relevant. Gruppiert nach Thema, nicht nach Abhaengigkeit.
local REGISTRY: { { name: string, module: ModuleScript } } = {
	-- Infrastruktur
	{ name = "RateLimiter",    module = ServerScriptService.Util.RateLimiter },
	{ name = "PlayerService",  module = ServerScriptService.Services.PlayerService },
	{ name = "EconomyService", module = ServerScriptService.Services.EconomyService },

	-- Welt und Darstellung
	{ name = "MapService",              module = ServerScriptService.Services.MapService },
	{ name = "PlotDisplayService",      module = ServerScriptService.Services.PlotDisplayService },
	-- Welt aufwerten, Paket G: grosse Momente eines Spielers an alle melden
	{ name = "WorldMomentService",      module = ServerScriptService.Services.WorldMomentService },
	{ name = "BaerchiAutopilotService", module = ServerScriptService.Services.BaerchiAutopilotService },

	-- Insel, Honig, Eier
	{ name = "IslandService",      module = ServerScriptService.Services.IslandService },
	{ name = "HoneyService",       module = ServerScriptService.Services.HoneyService },
	{ name = "EggService",         module = ServerScriptService.Services.EggService },
	{ name = "EggMerchantService", module = ServerScriptService.Services.EggMerchantService },
	{ name = "EggLayService",      module = ServerScriptService.Services.EggLayService },
	{ name = "EggTreeService",     module = ServerScriptService.Services.EggTreeService },
	-- Sammel-Update 05.10.: Inkubator (Paket 8), Index-Belohnungen (Paket 7),
	-- besondere Meilensteine (Paket 6.2)
	{ name = "IncubatorService",        module = ServerScriptService.Services.IncubatorService },
	{ name = "IndexRewardService",      module = ServerScriptService.Services.IndexRewardService },
	{ name = "SpecialMilestoneService", module = ServerScriptService.Services.SpecialMilestoneService },

	-- Kampf
	{ name = "PitArenaService", module = ServerScriptService.Services.PitArenaService },
	{ name = "CombatService",   module = ServerScriptService.Services.CombatService },
	{ name = "PetModeService",  module = ServerScriptService.Services.PetModeService },
	-- v15: Tower-Fortschritt (ersetzt das PIT-Level)
	{ name = "TowerService",    module = ServerScriptService.Services.TowerService },
	{ name = "GamepassService", module = ServerScriptService.Services.GamepassService },   -- 08.10. Paket C

	-- Events
	{ name = "EventService",              module = ServerScriptService.Services.EventService },
	{ name = "EventParticipationService", module = ServerScriptService.Services.EventParticipationService },
	-- Sammel-Update 05.10. (Paket 5.2): Kampf um die Mitte
	{ name = "PitBrawlService",           module = ServerScriptService.Services.PitBrawlService },

	-- Waben: Sammeln im Event-Pit und der Recycler auf dem Plot
	{ name = "CombRecyclerService", module = ServerScriptService.Services.CombRecyclerService },
	{ name = "CombService",         module = ServerScriptService.Services.CombService },

	-- Baerchis veraendern
	{ name = "FusionService",    module = ServerScriptService.Services.FusionService },
	{ name = "RecycleService",   module = ServerScriptService.Services.RecycleService },
	{ name = "PromotionService", module = ServerScriptService.Services.PromotionService },
	{ name = "CharmService",     module = ServerScriptService.Services.CharmService },
	{ name = "RebirthService",   module = ServerScriptService.Services.RebirthService },

	-- Meta
	{ name = "QuestService",    module = ServerScriptService.Services.QuestService },
	{ name = "SettingsService", module = ServerScriptService.Services.SettingsService },

	-- v15: Angeben (Bestenlisten, Inspektor, Abzeichen) und Login-Bonus
	{ name = "LeaderboardService", module = ServerScriptService.Services.LeaderboardService },
	{ name = "ProfileService",     module = ServerScriptService.Services.ProfileService },
	{ name = "PlayerBadgeService", module = ServerScriptService.Services.PlayerBadgeService },
	{ name = "LoginBonusService",  module = ServerScriptService.Services.LoginBonusService },

	-- HBB Paket 0: Messpunkte (Onboarding-Trichter, UI-Ereignisse)
	{ name = "FunnelService",      module = ServerScriptService.Services.FunnelService },
	-- HBB Paket 3: Anzeigestand (welche Bedienelemente schon gesehen sind)
	{ name = "UiStateService",     module = ServerScriptService.Services.UiStateService },
	-- HBB Paket 5: Heim-Knopf (zurueck auf den eigenen Plot)
	{ name = "HomeService",        module = ServerScriptService.Services.HomeService },
	-- HBB Paket 6: Live-Kampf-Board auf der Hauptinsel
	{ name = "LiveBoardService",   module = ServerScriptService.Services.LiveBoardService },
	-- HBB Paket 10: Shop (Gratis-Griff, Robux-Goldpakete)
	{ name = "ShopService",        module = ServerScriptService.Services.ShopService },

	-- Kein Spiel-Service: die Studio-Test-Schnittstelle
	{ name = "DebugService", module = ServerScriptService.Services.DebugService },
}

local loaded: { [string]: any } = {}

for _, entry in REGISTRY do
	loaded[entry.name] = require(entry.module)
end

for _, entry in REGISTRY do
	local service = loaded[entry.name]
	if service.init then
		service.init()
	end
end

for _, entry in REGISTRY do
	local service = loaded[entry.name]
	if service.start then
		service.start()
	end
end

--------------------------------------------------------------------------------
-- Studio-Debug-Hook
--
-- Legt die tatsaechlich laufenden Service-Instanzen unter _G.RBL ab.
-- Nur in Studio — im Live-Spiel existiert der Hook nicht.
--
-- ACHTUNG, gemessen und bestaetigt: die Studio Command Bar laeuft in einem
-- EIGENEN Lua-VM. Sie sieht dieses _G NICHT, und ein dortiges
-- require(ServerScriptService.Services.PlayerService) liefert eine zweite,
-- nie initialisierte Kopie des Moduls mit leerem _playerData — Aufrufe darauf
-- laufen still ins Leere. Zum Testen aus der Command Bar deshalb IMMER die
-- BindableFunction benutzen, die DebugService anlegt:
--
--   game.ServerScriptService.RBLDebug:Invoke("help")
--
-- _G.RBL ist nur fuer anderen Server-Code im selben VM gedacht.
--------------------------------------------------------------------------------

if RunService:IsStudio() then
	local debugTable: { [string]: any } = {}
	for name, service in loaded do
		debugTable[name] = service
	end

	-- Configs und Factories gleich mitgeben, die braucht man beim Testen staendig
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	debugTable.EconomyConfig  = require(ReplicatedStorage.Config.EconomyConfig)
	debugTable.BaerchiConfig  = require(ReplicatedStorage.Config.BaerchiConfig)
	debugTable.EggConfig      = require(ReplicatedStorage.Config.EggConfig)
	debugTable.BaerchiFactory = require(ReplicatedStorage.Modules.BaerchiFactory)

	_G.RBL = debugTable
	print("[GameManager] Studio-Debug-Hook aktiv — Zugriff ueber _G.RBL")
end

print("[GameManager] Alle Services gestartet")
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX25"><Properties>
<string name="Name">Services</string>
</Properties>
<Item class="ModuleScript" referent="RBX26"><Properties>
<string name="Name">CombatService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- CombatService.luau
-- ServerScriptService/Services/CombatService.luau
--
-- Einzige Zustaendigkeit:
--   - Einen TOWER-LAUF validieren, durchsimulieren und (am Ende der
--     Wiedergabe) abrechnen
--
-- v15: Es gibt kein PIT-Level mehr. Gekaempft wird im gewaehlten Tower
-- (TowerService.getSelected); Gegner und Stage-Gummies kommen aus TowerConfig,
-- Rekord, Meilensteine und Deckel fuehrt TowerService (recordRun). Bis zu 100
-- Stages werden IN PORTIONEN simuliert (SIM_STAGES_PER_STEP pro task.wait),
-- damit ein langer Lauf keinen Frame-Spike auf dem Server macht.
--
-- Ein Lauf ist kein einzelner Kampf: der Baerchi kaempft Stage fuer Stage
-- weiter, solange er gewinnt, und seine HP werden zwischen den Stages NICHT
-- zurueckgesetzt. Kaempfe geben KEINE XP (die kommt nur aus Honig).
--
-- ============================================================
-- SEIT v12: SIMULATION SOFORT, ABRECHNUNG SPAETER
-- ============================================================
-- Der Lauf wird weiterhin KOMPLETT im Voraus simuliert. Der Server kennt das
-- Ergebnis also, bevor die Figur losgeht — der Client kann am Ausgang nichts
-- drehen. Neu ist nur, WANN abgerechnet wird: nicht mehr vor der Wiedergabe,
-- sondern erst, wenn PitArenaService weiss, wie viele Stages tatsaechlich
-- gespielt wurden. Der Spieler kann den Baerchi naemlich zurueckholen
-- (PetBar, Knopf "Fight" nochmal): dann endet der Lauf nach der aktuellen
-- Stage, und es zaehlen nur die bis dahin geschafften.
--
-- Dafuer bekommt PitArenaService eine Abrechnungs-Funktion (settle) mit. Sie
-- laeuft genau einmal — am Ende der Wiedergabe, beim Zurueckholen, bei einem
-- Abbruch oder, wenn der Spieler mitten im Lauf geht, ueber
-- PlayerService.onPlayerLeaving (dann so, als waere die aktuelle Stage zu Ende
-- gespielt).
--
-- ============================================================
-- FORTSETZUNG (v12)
-- ============================================================
-- Vor dem Lauf kann der Spieler weiter oben einsteigen (PitResumeDialog):
--   "Fresh"   Stage 1, kostenlos
--   "Percent" bei 65 % der Stage-Tiefe seines letzten Laufs
--   "Last"    bei der letzten erreichten Stage
-- Kosten und Startstage rechnet TowerConfig (dieselben Funktionen nutzt der
-- Client fuer die Anzeige). Der letzte Lauf steht pro Tower in
-- island.towerProgress (v15).
--
-- Gegner-Werte und Belohnungen kommen aus TowerConfig, die Simulation aus
-- CombatCalculator. rebirthMult wendet ausschliesslich
-- EconomyService.awardGummies an. Der weiche Deckel: ueber den Deckel hinaus
-- wird gekaempft, Stage-Gummies und GoldGummies gibt es aber nur bis dorthin.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local PlayerService   = require(ServerScriptService.Services.PlayerService)
local EconomyService  = require(ServerScriptService.Services.EconomyService)
local PitArenaService = require(ServerScriptService.Services.PitArenaService)
local TowerService    = require(ServerScriptService.Services.TowerService)
local FunnelService = require(ServerScriptService.Services.FunnelService)  -- HBB: Messpunkte
local GamepassService = require(ServerScriptService.Services.GamepassService)  -- 08.10. Paket C
local Loc           = require(ReplicatedStorage.Localization.Loc)

local CombatService = {}

-- So viele Stages werden am Stueck simuliert, dann gibt der Server einen
-- Frame frei (task.wait). Rein technisch, kein Balancing-Wert.
local SIM_STAGES_PER_STEP = 10

-- Spieler, deren Lauf gerade simuliert wird (die Simulation yieldet jetzt —
-- ein zweiter Knopfdruck darf nicht dazwischen einen zweiten Lauf starten).
local _simulating: { [Player]: boolean } = {}

export type ResumeChoice = "Fresh" | "Percent" | "Last"

local function fail(player: Player, reason: Types.LocMsg | string)
	Remotes.ActionFailed:FireClient(player, "RequestPetMode", reason)
end

-- Gegner-Snapshot fuer eine Stage. Die Werte selbst kommen komplett aus
-- TowerConfig — hier wird nur umgepackt.
local function buildEnemySnapshot(towerId: string, stage: number): CombatCalculator.CombatSnapshot
	local stats = TowerConfig.getEnemyStats(towerId, stage)

	return {
		uid    = string.format("enemy_%s_s%d", towerId, stage),
		stats  = stats,
		hp     = stats.maxHp,
		charge = 0,
	}
end

-- Letzte erreichte Stage in diesem Tower (0 = kein Lauf gespeichert).
function CombatService.getProgress(data: Types.PlayerData, towerId: string): number
	local reached = data.island.towerProgress[towerId]
	return if typeof(reached) == "number" and reached >= 1 then reached else 0
end

-- Startstage und Kosten fuer eine Fortsetzungs-Wahl. nil = Wahl ungueltig
-- (kein letzter Lauf in diesem Tower).
-- `hasPass` (08.10.): Gamepass Gratis-Skip -> Kosten 0 (nur der Server fragt
-- GamepassService; ein gefaelschter Client aendert daran nichts).
function CombatService.getResumeOffer(data: Types.PlayerData, towerId: string, choice: ResumeChoice, hasPass: boolean?): (number?, number)
	if choice == "Fresh" then
		return 1, 0
	end

	local reached = CombatService.getProgress(data, towerId)
	if reached <= 0 then
		return nil, 0
	end

	local startStage = if choice == "Last"
		then reached
		else TowerConfig.getResumePercentStage(reached)

	local def = TowerConfig.get(towerId)
	startStage = math.clamp(startStage, 1, if def then def.stages else 1)
	return startStage, TowerConfig.getResumeCost(towerId, startStage, data.rebirthMult, hasPass)
end

-- Startet einen Tower-Lauf. Gibt true zurueck, wenn er losgeht — sonst hat
-- der Spieler bereits ein ActionFailed mit dem Grund bekommen.
function CombatService.startPitRun(player: Player, baerchiUid: string, choice: ResumeChoice?): boolean
	-- Ein zweiter Lauf darf nie in einen laufenden hineinstarten (die Figur
	-- wuerde sonst mitten in der Wiedergabe weggezogen).
	if PitArenaService.isRunning(player) or _simulating[player] then
		fail(player, Loc.msg("err.combat_busy"))
		return false
	end
	_simulating[player] = true
	local ok, started = pcall(CombatService._startRun, player, baerchiUid, choice)
	_simulating[player] = nil
	if not ok then
		warn("[CombatService] Lauf konnte nicht starten:", started)
		return false
	end
	return started
end

function CombatService._startRun(player: Player, baerchiUid: string, choice: ResumeChoice?): boolean

	local data = PlayerService.getData(player)
	if not data then return false end

	local baerchi = data.island.baerchis[baerchiUid]
	if not baerchi then
		fail(player, Loc.msg("err.baerchi_not_found"))
		return false
	end

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		warn("[CombatService] Unbekannter configId:", baerchi.configId)
		fail(player, Loc.msg("err.baerchi_data_corrupt"))
		return false
	end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)

	-- Der gespeicherte Wert kann ueber maxHp liegen, wenn der Baerchi seit dem
	-- letzten Lauf ein Level gestiegen ist — deshalb immer klemmen.
	local hp = math.clamp(baerchi.currentHp, 0, stats.maxHp)
	if hp <= 0 then
		fail(player, Loc.msg("err.combat_exhausted"))
		return false
	end

	local towerId = TowerService.getSelected(data)
	local tower = TowerConfig.get(towerId)
	if not tower then
		fail(player, Loc.msg("err.tower_unknown"))
		return false
	end
	-- Deckel beim START festhalten: ein Rebirth waehrend des Laufs ist
	-- unmoeglich (der Lauf gehoert zur Insel), sicher ist sicher.
	local capStage = TowerService.getStageCap(data, towerId)

	local startStage, cost = CombatService.getResumeOffer(data, towerId, choice or "Fresh",
		GamepassService.owns(player, "SKIP_PASS"))
	if not startStage then
		fail(player, Loc.msg("err.combat_no_last_run"))
		return false
	end

	if cost > 0 then
		local ok, reason = EconomyService.spendGummies(player, cost)
		if not ok then
			fail(player, reason)
			return false
		end
	end

	local hpBefore = hp

	-- ============================================================
	-- SIMULATION (komplett im Voraus)
	-- ============================================================
	local stages: { Types.PitStageResult } = {}
	-- v15: pro Stage die einzelnen Zuege fuer die Wiedergabe (Stoesse,
	-- Faehigkeiten). Bleibt auf dem Server — PitArenaService spielt sie ab,
	-- der Client sieht nur das Ergebnis in der Welt.
	local beats: { { Types.FightBeat } } = {}
	local lastStage = tower.stages

	-- v15: die Aufladung der Faehigkeit bleibt ueber die Stages erhalten.
	local charge = 0
	local simulatedInStep = 0

	for stage = startStage, lastStage do
		-- In Portionen: nach SIM_STAGES_PER_STEP Stages einen Frame freigeben.
		simulatedInStep += 1
		if simulatedInStep > SIM_STAGES_PER_STEP then
			simulatedInStep = 1
			task.wait()
			if player.Parent == nil then
				-- Gegangen, waehrend simuliert wurde: bezahlte Fortsetzung zurueck.
				if cost > 0 then EconomyService.awardGummiesFlat(player, cost) end
				return false
			end
		end

		local playerSnapshot: CombatCalculator.CombatSnapshot = {
			uid    = baerchi.uid,
			stats  = stats,
			hp     = hp,
			charge = charge,
		}
		local enemySnapshot = buildEnemySnapshot(towerId, stage)
		local enemyMax = math.max(1, enemySnapshot.stats.maxHp)

		local result = CombatCalculator.simulate(playerSnapshot, enemySnapshot, true)
		local won    = result.winnerUid == baerchi.uid

		hp = math.clamp(playerSnapshot.hp, 0, stats.maxHp)
		charge = playerSnapshot.charge or 0

		local stageBeats: { Types.FightBeat } = {}
		for _, entry in result.log do
			-- Finisher/Opener hat gegriffen: nur fuer die Optik der Show
			-- (PitArenaService -> SkillFXPlay.bonus).
			local bonus = false
			for _, effect in entry.effects or {} do
				if effect == "finisher" or effect == "opener" then bonus = true end
			end
			table.insert(stageBeats, {
				actor   = entry.actor,
				kind    = entry.kind,
				selfHp  = math.clamp(entry.attackerHpAfter / math.max(1, stats.maxHp), 0, 1),
				enemyHp = math.clamp(entry.defenderHpAfter / enemyMax, 0, 1),
				charge  = entry.chargeA,
				skillId = entry.skillId,
				bonus   = if bonus then true else nil,
			})
		end
		table.insert(beats, stageBeats)

		table.insert(stages, {
			stage      = stage,
			won        = won,
			rounds     = result.rounds,
			hpAfter    = hp,
			-- Basiswert ohne rebirthMult; ausgezahlt wird erst in settle.
			-- Weicher Deckel: ueber dem Deckel gibt es nichts.
			gummiesWon = if won and stage <= capStage then TowerConfig.getStageReward(towerId, stage) else 0,
			-- v14: fuer die Faehigkeiten-Show (PitArenaService -> SkillFX)
			skillUses       = result.skillUses,
			firstSkillRound = result.firstSkillRound,
		})

		-- Ein Sieg mit 0 HP kann vorkommen (bei Rundenlimit entscheidet der
		-- HP-Vergleich) — dann ist der Lauf trotzdem vorbei.
		if not won or hp <= 0 then
			break
		end
	end

	local fullRun: Types.PitRunResult = {
		baerchiUid     = baerchiUid,
		towerId        = towerId,
		capStage       = capStage,
		startStage     = startStage,
		recalled       = false,
		stagesCleared  = 0,
		stages         = stages,
		gummiesWon     = 0,
		goldGummiesWon = 0,
		hpBefore       = hpBefore,
		hpAfter        = hpBefore,
		maxHp          = stats.maxHp,
	}

	-- ============================================================
	-- ABRECHNUNG (laeuft genau einmal, aufgerufen von PitArenaService)
	-- ============================================================
	-- played = wie viele Stages tatsaechlich gespielt wurden (0..#stages).
	-- recalled = der Spieler hat zurueckgeholt.
	local settled: Types.PitRunResult? = nil

	local function settle(played: number, recalled: boolean): Types.PitRunResult
		if settled then
			return settled
		end

		played = math.clamp(math.floor(played), 0, #stages)

		local playedStages: { Types.PitStageResult } = {}
		local cleared     = 0
		local paidCleared = 0   -- geschaffte Stages bis zum Deckel (GoldGummies)
		local highestWon  = 0
		local baseGummies = 0
		for index = 1, played do
			local stage = stages[index]
			table.insert(playedStages, stage)
			if stage.won then
				cleared += 1
				baseGummies += stage.gummiesWon
				highestWon = math.max(highestWon, stage.stage)
				if stage.stage <= capStage then
					paidCleared += 1
				end
			end
		end

		local hpAfter = if played > 0 then playedStages[played].hpAfter else hpBefore

		-- Den aktuellen Spielstand holen: der Spieler kann waehrenddessen
		-- gegangen sein (dann laeuft das hier aus onPlayerLeaving, die Daten
		-- sind noch da).
		local current = PlayerService.getData(player)
		local result: Types.PitRunResult = {
			baerchiUid     = baerchiUid,
			towerId        = towerId,
			capStage       = capStage,
			startStage     = startStage,
			recalled       = recalled,
			corrected      = played < #stages,
			stagesCleared  = cleared,
			stages         = playedStages,
			gummiesWon     = 0,
			goldGummiesWon = 0,
			hpBefore       = hpBefore,
			hpAfter        = hpAfter,
			maxHp          = stats.maxHp,
		}

		if not current then
			settled = result
			return result
		end

		if played == 0 then
			-- Zurueckgeholt, bevor die erste Stage begann: nichts passiert.
			-- Eine bezahlte Fortsetzung wird erstattet — der Spieler hat
			-- nichts davon gehabt.
			if cost > 0 then
				EconomyService.awardGummiesFlat(player, cost)
			end
		else
			local fighter = current.island.baerchis[baerchiUid]
			if fighter then
				-- Erschoepfungszustand festhalten: DAS ist die Verbindung zum
				-- Fuettern.
				fighter.currentHp = hpAfter
			end

			if baseGummies > 0 then
				result.gummiesWon = EconomyService.awardGummies(player, baseGummies)
			end

			local goldReward = TowerConfig.getRunGold(towerId, paidCleared)
			if goldReward > 0 then
				result.goldGummiesWon = EconomyService.awardGoldGummies(player, goldReward)
			end

			if cleared > 0 then
				current.stats.totalFightsWon += cleared
			end
			if not playedStages[played].won then
				current.stats.totalFightsLost += 1
			end

			-- v15: Rekord, Meilensteine, Deckel-Hinweis (TowerService).
			local newRecord, capReached = TowerService.recordRun(player, current, towerId, highestWon)
			result.newRecord  = newRecord
			result.capReached = capReached

			-- Fuer die Fortsetzungs-Frage: die letzte Stage, in die er
			-- eingetreten ist — pro Tower.
			current.island.towerProgress[towerId] = playedStages[played].stage
		end

		FunnelService.step(player, "F06_FirstFightEnded")
		PlayerService.markDirty(player)
		PlayerService.saveNow(player)

		print(
			"[CombatService]", player.Name,
			"| Tower", towerId, "ab Stage", startStage,
			"| gespielt:", played, "/", #stages,
			if recalled then "(zurueckgeholt)" else "",
			"| geschafft:", cleared,
			"| HP:", hpAfter, "/", stats.maxHp,
			"| Gummies:", result.gummiesWon,
			"| Gold:", result.goldGummiesWon
		)

		settled = result
		return result
	end

	-- Den Client informiert NICHT dieser Service, sondern PitArenaService — am
	-- Ende der Wiedergabe mit dem abgerechneten Ergebnis.
	PitArenaService.play(player, fullRun, settle, beats)
	FunnelService.step(player, "F05_FirstFightStarted")

	-- Kosten sind schon abgezogen: syncen, damit die Anzeige stimmt.
	if cost > 0 then
		PlayerService.markDirty(player)
	end

	print("[CombatService]", player.Name, "| Tower-Lauf startet: Tower", towerId,
		"| ab Stage", startStage, "| Kosten:", cost, "| simuliert:", #stages, "Stages")

	return true
end

function CombatService.init()
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		_simulating[player] = nil
	end)

	-- Seit v12 kein eigener Remote mehr: gestartet wird ueber die Pet-Leiste
	-- (PetModeService.RequestPetMode).
	print("[CombatService] Initialisiert")
end

return CombatService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX27"><Properties>
<string name="Name">DebugService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- DebugService.luau
-- ServerScriptService/Services/DebugService.luau
--
-- Einzige Zustaendigkeit:
--   - Test-Befehle aus der Studio Command Bar entgegennehmen
--
-- NUR IN STUDIO. Im veroeffentlichten Spiel macht init() nichts und die
-- BindableFunction existiert nicht.
--
-- Warum eine BindableFunction und nicht einfach _G oder ein require?
--   Die Command Bar laeuft in einem eigenen Lua-VM. Sie hat deshalb
--     * ihren eigenen require-Cache  → require(PlayerService) liefert dort eine
--       ZWEITE, nie initialisierte Kopie mit leerem _playerData, und
--     * ihr eigenes _G               → im Server gesetzte Globals sind unsichtbar.
--   Aufrufe auf der Kopie laufen still ins Leere, was beim Testen extrem
--   verwirrend ist. Eine BindableFunction ist eine Instanz im DataModel:
--   ihr OnInvoke wurde vom echten Server-Script gesetzt und laeuft daher
--   garantiert im echten Server-VM, mit dem echten Zustand.
--
-- Benutzung (Command Bar, Server-Kontext, Play laeuft):
--   local D = game.ServerScriptService.RBLDebug
--   D:Invoke("info")
--   D:Invoke("give", 100000, 1000)
--   D:Invoke("add", "RedBaerchi", 10)
--   D:Invoke("add", "RedBaerchi", 10, "Rainbow")   -- Mutation (siehe BaerchiConfig.MUTATIONS)
--   D:Invoke("stats", uid)                    -- Kampfwerte inkl. PWR
--   D:Invoke("list")
--   D:Invoke("fuse", uidA, uidB)
--   D:Invoke("recycle", uid)
--   D:Invoke("building", "Beehive", 5)   -- Level 1-60 (v15), Look folgt automatisch
--   D:Invoke("building", "HoneyRefiner", 60)
--   D:Invoke("hatch", "BasicEgg")   -- legt ein Ei ins Lager und oeffnet es sofort (v12)
--   D:Invoke("egg", "GoldenEgg", 5) -- 5 Eier ins Lager legen (ohne zu oeffnen)
--   D:Invoke("pitprogress", 12)     -- letzten Lauf im gewaehlten Tower auf Stage 12 setzen (Fortsetzungs-Test)
--   D:Invoke("petmode")             -- aktueller Zustand der Pet-Leiste
--   D:Invoke("pm", "Fight", "Last")  -- wie ein Klick auf die Pet-Leiste
--   D:Invoke("honey")               -- alle Honig-Lager sofort voll
--   D:Invoke("feed", uid, 20)       -- 20x fuettern (heilt + gibt XP)
--   D:Invoke("fight", uid)          -- kompletter Lauf im gewaehlten Tower
--   D:Invoke("skill", "equipped", "OmegaStrike") -- Faehigkeit tauschen (Show-Test)
--   D:Invoke("rebirth")
--
-- v8 (Promotion / Charms / Event-Teilnahme):
--   D:Invoke("promote", uid)        -- braucht genug Duplikate, siehe "add"
--   D:Invoke("charms", uid)         -- alle acht Slots im Klartext
--   D:Invoke("roll", uid, 5)        -- 5x wuerfeln (kostet GoldGummies)
--   D:Invoke("lock", uid, 1)        -- Slot I sperren/freigeben
--   D:Invoke("event")               -- ausgeruesteten Baerchi zum Event schicken
--   D:Invoke("skipevent")           -- laufende Phase sofort beenden
--   D:Invoke("events")              -- Katalog: alle Events mit ihrer Belohnung
--   D:Invoke("startevent", "ZauberZirkel")  -- genau dieses Event sofort starten
--
-- v10 (Eier legen):
--   D:Invoke("eggs")            -- was liegt herum, wie schnell legt er, welche Chancen
--   D:Invoke("lay", 5)          -- 5 Eier sofort legen (ohne aufs Intervall zu warten)
--   D:Invoke("collect")         -- alles einsammeln
--   D:Invoke("eggtime", 60)     -- Zeitmarke 60 Minuten zurueck, Tick legt nach
--
-- v15 (Waben im Event-Pit, Recycler):
--   D:Invoke("combs", 20)           -- 20 Waben sofort ins Pit legen (Stand ausgeben)
--   D:Invoke("queue", 50)           -- 50 Wabeneinheiten in die Recycler-Warteschlange
--   D:Invoke("recycler", 5)         -- Recycler-Level setzen (ohne Kosten), Stand ausgeben
--
-- v15 (Tower, Gebaeude 1-60, Angeben, Login-Bonus):
--   D:Invoke("tower", "II", 20)     -- Tower II waehlen und ab Stage 20 kaempfen (Fortsetzung gratis)
--   D:Invoke("towerrecord", "III", 45) -- Rekord setzen (Meilensteine bis dorthin werden ausgezahlt)
--   D:Invoke("rebirthcap")          -- Deckel des aktuellen Rebirths in allen Towern
--   D:Invoke("stagebest", "I", 30)  -- Sammel-Update: beste Stage dieses Lebens (Rebirth-Bedingung)
--   D:Invoke("incubator", "done")   -- Sammel-Update: Inkubator-Stand, "done" = alle Eier fertig
--   D:Invoke("incubator", "breed")  -- INCUBATOR_BREED: jedes Baerchi im Inkubator bruetet sofort ein Ei
--   D:Invoke("dailyshift", 1)       -- Login-Bonus: so tun, als waeren 1 Tag(e) vergangen
--   D:Invoke("lbflush")             -- Bestenlisten sofort schreiben und neu lesen
--   D:Invoke("parts")               -- Teile auf der eigenen Insel zaehlen (Budget 250)
--   D:Invoke("v14save")             -- Spielstand im alten v14-Format simulieren + migrieren
--
-- v17 (lebendige Events):
--   D:Invoke("startevent", "Ufo")   -- UFO-Patrouille mit Abwuerfen
--   D:Invoke("jackpot")             -- naechster UFO-Abwurf ist sicher ein Jackpot (Stand des Pity-Zaehlers)
--   D:Invoke("combtheme", "HotEgg") -- Wabenthema setzen ("off" = normal)
--   D:Invoke("launch", 10)          -- 10 Waben einfliegen lassen (Vulkan aus der Mitte)
--   D:Invoke("startevent", "WaspQueen") -- Boss-Event sofort (laeuft sonst nur jeden 2. Durchlauf)
--
-- v14 (Mega Egg Tree):
--   D:Invoke("tree")                 -- alle 20 Knoten mit Bedingungen und Stand
--   D:Invoke("unlock", "SunEgg")     -- einen Knoten freischalten ("all" = alle)
--   D:Invoke("hatched", "SugarEgg", 15) -- Hatch-Zaehler setzen (Freischalt-Test)
--   D:Invoke("blueprint", 1)         -- Blaupausen gutschreiben
--   D:Invoke("useblueprint", "PlatinumEgg")
--   D:Invoke("press", "SugarEgg", "Void") -- 5 Zucker-Eier -> 1 Nebel-Ei
--   D:Invoke("setrebirth", 10)       -- Rebirth-Zaehler setzen (ohne Reset)
--   D:Invoke("skilltest", "OmegaBaerchi", 30) -- einen Kampf mit Runden-Log
--   D:Invoke("snapshot")             -- Spielstand merken (fuer Tests)
--   D:Invoke("restore")              -- gemerkten Spielstand zurueckschreiben
--
-- Welt aufwerten (08.10.2026, nur Optik, setzt workspace-Attribute fuer die
-- Client-Controller; alle Test-Clients sehen dasselbe):
--   D:Invoke("worldshots", 1)        -- Kamera auf festen Punkt 1..6 (UI aus), 0 = zurueck
--   D:Invoke("daytime", 19)          -- Tageslauf auf feste Uhrzeit, "auto" = Zyklus
--   D:Invoke("pitstate", "soon")     -- Pit-Rahmen: idle | soon | live | auto
--   D:Invoke("neststate", "boss")    -- Wespen-Nest: calm | boss | auto
--   D:Invoke("arrival")              -- Ankunft (Blasen + Bienen) erneut abspielen
--   D:Invoke("fish")                 -- sofort einen Honig-Fisch springen lassen
--   D:Invoke("islandstage", 4)       -- Insel-Deko Stufe 1..4 zeigen ("auto" = aus dem Fortschritt)
--   D:Invoke("pondfull")             -- Teich bis zum Rand fuellen (Ueberlauf-Tropfen)
--   D:Invoke("spectators", "hop")    -- Zuschauer an der eigenen Arena: hop | cheer
--   D:Invoke("record")               -- Rekord-Moment am eigenen Schau-Turm (Flagge glaenzt, Jubel)
--   D:Invoke("moment", "hatch", "Cosmic") -- Welt-Moment an alle: hatch <Rarity> | tower <Id> | record | rebirth | mutation <Id>
--   D:Invoke("moments5")             -- fuenf grosse Momente gleichzeitig (Drosselung pruefen)
--   (Event-Start und Boss: D:Invoke("pitstate", "live") / D:Invoke("neststate", "boss"))
--
-- HBB Paket 0 (Test-Zustaende, erst "snapshot"):
--   D:Invoke("state", "fresh")       -- neues Konto, Trichter F01–F10 misst
--   D:Invoke("state", "hatch10")     -- dazu zehn geoeffnete Basis-Eier
--   D:Invoke("state", "tower1")      -- dazu Tower I geschafft (Rekord 30)
--
-- Ein kompletter Event-Durchlauf ohne acht Minuten Wartezeit:
--   D:Invoke("skipevent")   → Pause endet, Event laeuft
--   D:Invoke("event")       → Baerchi laeuft hin (ein paar Sekunden abwarten)
--   D:Invoke("skipevent")   → Event endet, Stat-Stufe wird vergeben
--
-- Rueckgaben sind einfache Tabellen/Zahlen — BindableFunctions kopieren
-- Werte ueber die VM-Grenze, Funktionen und Metatables kommen nicht durch.

local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local Loc = require(ReplicatedStorage.Localization.Loc)   -- Belohnung ist eine LocMsg
local CharmConfig      = require(ReplicatedStorage.Config.CharmConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local BaerchiFactory   = require(ReplicatedStorage.Modules.BaerchiFactory)
local SkillConfig      = require(ReplicatedStorage.Config.SkillConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggCalculator    = require(ReplicatedStorage.Modules.EggCalculator)
local CombConfig       = require(ReplicatedStorage.Config.CombConfig)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local IslandService  = require(ServerScriptService.Services.IslandService)
local EggService     = require(ServerScriptService.Services.EggService)
local CombatService  = require(ServerScriptService.Services.CombatService)
local FusionService  = require(ServerScriptService.Services.FusionService)
local RecycleService = require(ServerScriptService.Services.RecycleService)
local RebirthService = require(ServerScriptService.Services.RebirthService)
local HoneyService   = require(ServerScriptService.Services.HoneyService)
local MapService     = require(ServerScriptService.Services.MapService)

-- v8
local PromotionService          = require(ServerScriptService.Services.PromotionService)
local CharmService              = require(ServerScriptService.Services.CharmService)
local EventService              = require(ServerScriptService.Services.EventService)
local EventParticipationService = require(ServerScriptService.Services.EventParticipationService)

-- v10
local EggLayService             = require(ServerScriptService.Services.EggLayService)

-- v14
local EggTreeService            = require(ServerScriptService.Services.EggTreeService)
local EggTree                   = require(ReplicatedStorage.Modules.EggTree)
local CombatConfig              = require(ReplicatedStorage.Config.CombatConfig)

-- v12
local ActivityLock = require(ServerScriptService.Util.ActivityLock)  -- Paket 1.1: Lock-Halter ausgeben
local PetModeService            = require(ServerScriptService.Services.PetModeService)
local PitArenaService           = require(ServerScriptService.Services.PitArenaService)

-- v15 (Waben)
local CombService               = require(ServerScriptService.Services.CombService)
local CombRecyclerService       = require(ServerScriptService.Services.CombRecyclerService)

-- v15 (Tower, Angeben, Login-Bonus)
local TowerConfig               = require(ReplicatedStorage.Config.TowerConfig)
local TowerService              = require(ServerScriptService.Services.TowerService)
local GamepassService           = require(ServerScriptService.Services.GamepassService)   -- 08.10. Paket C
local LeaderboardService        = require(ServerScriptService.Services.LeaderboardService)
local LoginBonusService         = require(ServerScriptService.Services.LoginBonusService)
local PlayerMigration           = require(ServerScriptService.Util.PlayerMigration)

-- v17 (lebendige Events)
local JackpotRoll               = require(ServerScriptService.Util.JackpotRoll)

-- HBB Paket 0
local FunnelService             = require(ServerScriptService.Services.FunnelService)

local DebugService = {}

local BINDABLE_NAME = "RBLDebug"

--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

-- Der erste Spieler im Server. Fuer Solo-Tests in Studio genau richtig.
local function firstPlayer(): Player?
	return Players:GetPlayers()[1]
end

local function requireData(): (Player?, Types.PlayerData?, string?)
	local player = firstPlayer()
	if not player then
		return nil, nil, "Kein Spieler im Spiel — laeuft der Play-Modus?"
	end

	local data = PlayerService.getData(player)
	if not data then
		return player, nil, "Daten fuer " .. player.Name .. " noch nicht geladen"
	end

	return player, data, nil
end

local function countBaerchis(data: Types.PlayerData): number
	local n = 0
	for _ in data.island.baerchis do n += 1 end
	return n
end

--------------------------------------------------------------------------------
-- Befehle
--------------------------------------------------------------------------------

local commands: { [string]: (Player, Types.PlayerData, ...any) -> any } = {}

commands.info = function(player, data)
	local buildings: { [string]: number } = {}
	for id, building in data.island.buildings do
		buildings[id] = building.level
	end

	return {
		player       = player.Name,
		gummies      = data.gummies,
		goldGummies  = data.goldGummies,
		rebirthCount = data.rebirthCount,
		rebirthMult  = data.rebirthMult,
		baerchis     = countBaerchis(data),
		towers       = data.towers,
		towerProgress = data.island.towerProgress,
		buildings    = buildings,
		eggStock     = data.island.eggStock,
	}
end

-- Waehrung schenken. Ohne rebirthMult, du bekommst exakt die Zahl.
commands.give = function(player, _data, gummies: any, gold: any)
	EconomyService.awardGummiesFlat(player, tonumber(gummies) or 100000)
	EconomyService.awardGoldGummies(player, tonumber(gold) or 1000)
	return commands.info(player, PlayerService.getDataOrError(player))
end

-- Alle Baerchis als flache Liste (uid zum Weiterverwenden)
commands.list = function(_player, data)
	local out = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(out, {
			uid      = uid,
			configId = baerchi.configId,
			rarity   = baerchi.rarity,
			level    = baerchi.level,
			xp       = baerchi.xp,
			fusion   = baerchi.isFusionResult,
			bonus    = baerchi.fusionBonus,

			-- v8: die zweite Fortschrittsachse. `charms` bewusst nur als Anzahl
			-- — die Detailwerte holt man sich ueber "charms <uid>", sonst wird
			-- die Liste in der Command Bar unlesbar.
			promo    = baerchi.promotionLevel or 0,
			stats    = baerchi.statLevels,
			charms   = #(baerchi.charms or {}),
			mutation = baerchi.mutation,
		})
	end
	table.sort(out, function(a, b) return a.uid < b.uid end)
	return out
end

-- Baerchi direkt erzeugen, ohne Ei.
--
-- Das dritte Argument setzt eine Mutation (siehe BaerchiConfig.MUTATIONS fuer
-- gueltige Namen: Gold/Diamond/Bloodrot/Celestial/Candy/Lava/Galaxy/Rainbow).
-- Ohne diesen Weg waeren Mutationen in Studio praktisch nicht testbar: die
-- Gesamtchance beim Schluepfen liegt bei 1.5%, die seltenste Stufe (Rainbow)
-- bei 0.0005% — man muesste also im Schnitt 200'000 Eier ausbrueten.
--   D:Invoke("add", "RedBaerchi", 10)              -- normal
--   D:Invoke("add", "RedBaerchi", 10, "Rainbow")   -- mit Mutation
commands.add = function(player, data, configId: any, level: any, mutation: any)
	local mutationId: any = nil
	if typeof(mutation) == "string" and BaerchiConfig.MUTATIONS[mutation :: any] then
		mutationId = mutation
	end

	local baerchi = BaerchiFactory.create(tostring(configId), {
		level    = tonumber(level) or 1,
		mutation = mutationId,
	})
	if not baerchi then
		return { error = "Unbekannter configId: " .. tostring(configId) }
	end

	data.island.baerchis[baerchi.uid] = baerchi
	PlayerService.markDirty(player)

	return {
		uid      = baerchi.uid,
		configId = baerchi.configId,
		rarity   = baerchi.rarity,
		level    = baerchi.level,
		mutation = baerchi.mutation,
	}
end

-- Faehigkeit eines Baerchis tauschen (zum Testen der Shows).
-- uid "equipped" (oder leer) = der ausgeruestete Baerchi.
--   D:Invoke("skill", "equipped", "OmegaStrike")
commands.skill = function(player, data, uid: any, skillId: any)
	local id = if uid == nil or uid == "equipped" then data.island.equippedUid else tostring(uid)
	local baerchi = if id then data.island.baerchis[id] else nil
	if not baerchi then
		return { error = "Kein Baerchi mit uid " .. tostring(id) }
	end
	if not SkillConfig.getById(tostring(skillId)) then
		return { error = "Unbekannte Faehigkeit: " .. tostring(skillId) }
	end
	local before = baerchi.skillId
	baerchi.skillId = tostring(skillId) :: any
	PlayerService.markDirty(player)
	return { uid = baerchi.uid, configId = baerchi.configId, vorher = before, jetzt = baerchi.skillId }
end

-- Die Kampfwerte eines Baerchis so, wie der Kampf sie sieht. Praktisch, um
-- Promotion, Stat-Stufen, Charms und Mutation gegeneinander nachzurechnen.
commands.stats = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		return { error = "Unbekannter configId: " .. baerchi.configId }
	end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)

	return {
		configId = baerchi.configId,
		level    = baerchi.level,
		mutation = baerchi.mutation,
		promo    = baerchi.promotionLevel or 0,
		maxHp    = stats.maxHp,
		atk      = stats.atk,
		spd      = stats.spd,
		pwrProzent = math.floor(stats.pwr * 100 + 0.5),
		skill    = stats.skillId,
	}
end

-- Gebaeude-Level direkt setzen (umgeht die Kosten)
commands.building = function(player, data, buildingId: any, level: any)
	local building = data.island.buildings[buildingId]
	if not building then
		return { error = "Unbekanntes Gebaeude: " .. tostring(buildingId) }
	end

	-- clampBuildingLevel rundet mit ab: ohne das landete eine 5.5 aus der
	-- Command Bar als Kommazahl in den Daten und jedes spaetere
	-- string.format("%d", level) wuerde daran scheitern.
	building.level = EconomyConfig.clampBuildingLevel(tonumber(level) or 1)
	MapService.updateBuildingLevel(player, buildingId, building.level)
	PlayerService.markDirty(player)

	return { building = buildingId, level = building.level, look = BuildingBehavior.getLook(building.level) }
end

-- v12: Ei ins Lager legen und sofort oeffnen (es gibt keine Brut mehr)
commands.hatch = function(player, data, eggType: any)
	local egg = tostring(eggType or "BasicEgg")
	if not EggConfig.data[egg :: Types.EggType] then
		return { error = "Unbekannter Egg-Typ: " .. egg }
	end

	data.island.eggStock[egg :: Types.EggType] = (data.island.eggStock[egg :: Types.EggType] or 0) + 1
	local result = EggService.openEgg(player, egg :: Types.EggType)
	if not result then
		return { error = "Oeffnen fehlgeschlagen" }
	end

	return {
		configId = result.baerchi.configId,
		rarity   = result.baerchi.rarity,
		mutation = result.baerchi.mutation,
		neu      = result.isNew,
	}
end

-- v12: Eier ins Lager legen, ohne sie zu oeffnen (fuer Tests im Ei-Menue)
commands.egg = function(player, data, eggType: any, count: any)
	local egg = tostring(eggType or "BasicEgg")
	if not EggConfig.data[egg :: Types.EggType] then
		return { error = "Unbekannter Egg-Typ: " .. egg }
	end

	local amount = math.clamp(tonumber(count) or 1, 1, 100)
	data.island.eggStock[egg :: Types.EggType] = (data.island.eggStock[egg :: Types.EggType] or 0) + amount
	PlayerService.markDirty(player)
	return { lager = data.island.eggStock }
end

-- v12/v15: gespeicherten letzten Lauf im gewaehlten Tower setzen (0 = loeschen)
commands.pitprogress = function(player, data, stage: any)
	local reached = math.floor(tonumber(stage) or 0)
	local towerId = data.towers.selected
	data.island.towerProgress[towerId] = if reached > 0 then reached else nil
	PlayerService.markDirty(player)
	return { tower = towerId, towerProgress = data.island.towerProgress }
end

-- v15: Tower waehlen (auch einen noch geschlossenen) und ab `stage` kaempfen.
-- Die Fortsetzungs-Kosten werden vorher gutgeschrieben (Test ohne Grind).
commands.tower = function(player, data, towerId: any, stage: any)
	local id = tostring(towerId or "I")
	local def = TowerConfig.get(id)
	if not def then
		return { error = "Unbekannter Tower: " .. id .. " (I, II, III, Final)" }
	end
	local uid = data.island.equippedUid
	if not uid then
		return { error = "Kein Baerchi ausgeruestet" }
	end
	TowerService.debugOpenAll(data)
	data.towers.selected = id
	local start = math.clamp(math.floor(tonumber(stage) or 1), 1, def.stages)
	local choice = "Fresh"
	if start > 1 then
		data.island.towerProgress[id] = start
		local _, cost = CombatService.getResumeOffer(data, id, "Last")
		if cost > 0 then EconomyService.awardGummiesFlat(player, cost) end
		choice = "Last"
	end
	PlayerService.markDirty(player)
	task.spawn(PetModeService.request, player, "Fight", choice :: any)
	return {
		tower = id, ab = start, deckel = TowerConfig.getStageCap(data.rebirthCount, id, data.towers.records, data.towers.unlocked),
		gegnerStage1 = TowerConfig.getEnemyStats(id, start),
	}
end

-- 08.10. (Paket C): Gamepass-Besitz fuer diese Sitzung erzwingen.
-- D:Invoke("pass", "on")  /  ("pass", "off")  /  ("pass", "reset") = wieder Roblox
-- Optional mit Key: D:Invoke("pass", "on", "SKIP_PASS")
commands.pass = function(player, _data, mode: any, key: any)
	local passKey = tostring(key or "SKIP_PASS")
	local m = tostring(mode or "on")
	local value: boolean? = if m == "on" then true elseif m == "off" then false else nil
	GamepassService.debugSet(player, passKey, value)
	return { pass = passKey, besitz = GamepassService.owns(player, passKey) }
end

-- v15: Tower-Rekord direkt setzen (Meilensteine bis dorthin werden ausgezahlt)
commands.towerrecord = function(player, data, towerId: any, stage: any)
	local id = tostring(towerId or "I")
	if not TowerConfig.get(id) then
		return { error = "Unbekannter Tower: " .. id }
	end
	TowerService.debugSetRecord(player, id, tonumber(stage) or 0)
	return { towers = data.towers }
end

-- v15: Deckel des aktuellen Rebirths
commands.rebirthcap = function(_player, data)
	local caps: { [string]: number } = {}
	for _, def in TowerConfig.TOWERS do
		caps[def.id] = TowerConfig.getStageCap(data.rebirthCount, def.id, data.towers.records, data.towers.unlocked)
	end
	local capTower, capStage = TowerConfig.getCap(data.rebirthCount)
	return { rebirths = data.rebirthCount, deckelTower = capTower, deckelStage = capStage, proTower = caps }
end

-- Sammel-Update 05.10. (Paket 4.1): beste Stage dieses Lebens setzen und die
-- Rebirth-Bedingung zeigen. D:Invoke("stagebest", "I", 30)
commands.stagebest = function(player, data, towerId: any, stage: any)
	if typeof(towerId) == "string" and TowerConfig.get(towerId) then
		data.island.stageBest[towerId] = math.max(0, math.floor(tonumber(stage) or 0))
		PlayerService.markDirty(player)
	end
	local reqTower, reqStage = TowerConfig.getRebirthRequirement(data.rebirthCount, data.towers.records)
	return {
		stageBest  = data.island.stageBest,
		bedingung  = reqTower .. "/" .. reqStage,
		bereit     = TowerConfig.isRebirthReady(data.rebirthCount, data.island.stageBest, data.towers.records),
	}
end

-- Sammel-Update 05.10. (Paket 8): Inkubator-Stand; "done" macht alle Eier fertig.
commands.incubator = function(player, data, action: any)
	local incubator = data.island.incubator
	if action == "done" then
		for _, entry in incubator.slots do entry.finishAt = os.time() end
		PlayerService.markDirty(player)
	elseif action == "breed" then
		-- INCUBATOR_BREED: jedes Baerchi im Inkubator bruetet sofort ein Ei.
		-- Lazy require: kein weiterer Modul-Local (200er-Grenze).
		local made = require(ServerScriptService.Services.IncubatorService).breedNow(player)
		return { gebruetet = made, baerchis = incubator.breeders }
	end
	return { level = incubator.level, plaetze = incubator.slots, baerchis = incubator.breeders }
end

-- v15: Login-Bonus — so tun, als waeren `days` Tage vergangen
commands.dailyshift = function(player, _data, days: any)
	return LoginBonusService.debugShift(player, math.floor(tonumber(days) or 1))
end

-- v15: Bestenlisten sofort schreiben und neu lesen
commands.lbflush = function(_player, _data)
	return LeaderboardService.flush()
end

-- v15: Teile auf der eigenen Insel zaehlen (Budget: 250 ohne Baerchi-Figuren)
commands.parts = function(player, _data)
	return MapService.countParts(player) or { error = "kein Plot" }
end

-- Welt aufwerten: Debug-Signale an die Client-Controller (workspace-Attribute,
-- siehe WorldFXKit.onDebug). Ein Zaehler im Wert sorgt dafuer, dass derselbe
-- Befehl zweimal hintereinander auch zweimal ausloest.
local _worldSignal = 0
local function worldSignal(attribute: string, value: any)
	_worldSignal += 1
	workspace:SetAttribute(attribute, if value == nil then tostring(_worldSignal) else value)
end

commands.worldshots = function(_player, _data, index: any)
	local n = tonumber(index)
	if n == nil then
		local WorldFXConfig = require(ReplicatedStorage.Config.WorldFXConfig)
		local names = {}
		for _, shot in WorldFXConfig.WORLD_SHOTS do table.insert(names, shot.name) end
		return { hinweis = "worldshots <1..6> (0 = zurueck)", punkte = names }
	end
	_worldSignal += 1
	workspace:SetAttribute("DebugWorldShot", string.format("%d|%d", n, _worldSignal))
	return { punkt = n }
end

commands.daytime = function(_player, _data, hour: any)
	local h = tonumber(hour)
	workspace:SetAttribute("DebugDayTime", if h then h else -1)
	return { tageszeit = if h then h else "auto" }
end

commands.pitstate = function(_player, _data, state: any)
	local value = tostring(state or "auto")
	workspace:SetAttribute("DebugPitState", value)
	return { pit = value }
end

commands.neststate = function(_player, _data, state: any)
	local value = tostring(state or "auto")
	workspace:SetAttribute("DebugNestState", value)
	return { nest = value }
end

commands.arrival = function(_player, _data)
	worldSignal("DebugArrival", nil)
	return { ankunft = true }
end

commands.fish = function(_player, _data)
	worldSignal("DebugFish", nil)
	return { fisch = true }
end

-- Paket D: Insel-Stufe am Player-Attribut (wie PlotDisplayService), "auto"
-- rechnet sie aus dem Spielstand neu.
commands.islandstage = function(player, data, stage: any)
	local IslandStage = require(ReplicatedStorage.Modules.IslandStage)
	local n = tonumber(stage)
	local value = if n then math.clamp(math.floor(n), 1, IslandStage.MAX)
		else IslandStage.compute(data.towers and data.towers.records, data.rebirthCount or 0)
	player:SetAttribute("IslandStage", value)
	return { stufe = value }
end

-- Paket D: Teich voll (alle Honig-Lager voll, wie "honey"), damit der Ueberlauf laeuft
commands.pondfull = function(player, data)
	local result = commands.honey(player, data)
	return { teich = "voll", honig = result }
end

-- Paket E: Zuschauer-Baerchis an der eigenen Arena testen
commands.spectators = function(player, _data, mode: any)
	_worldSignal += 1
	workspace:SetAttribute("DebugSpectators", string.format("%d|%s|%d", player.UserId, tostring(mode or "hop"), _worldSignal))
	return { zuschauer = tostring(mode or "hop") }
end

-- Paket G: Welt-Moment wie vom Server erkannt an alle schicken (ohne den
-- Spielstand zu aendern). Erzwingt "gross", damit man jede Art sieht.
commands.moment = function(player, _data, kind: any, value: any)
	local WorldMomentService = require(ServerScriptService.Services.WorldMomentService)
	local k = tostring(kind or "hatch")
	local defaults = { hatch = "Cosmic", tower = "II", record = "I", rebirth = "1", mutation = "Galaxy" }
	local v = if value ~= nil then tostring(value) else defaults[k] or "?"
	WorldMomentService.announce(player, { kind = k :: any, value = v, number = 42 }, true)
	return { moment = k, wert = v }
end

-- Paket G: fuenf grosse Momente auf einmal (Client muss sie nacheinander zeigen)
commands.moments5 = function(player, _data)
	local WorldMomentService = require(ServerScriptService.Services.WorldMomentService)
	for _, m in { { "hatch", "Mythic" }, { "tower", "III" }, { "rebirth", "2" }, { "mutation", "Rainbow" }, { "hatch", "Omega" } } do
		WorldMomentService.announce(player, { kind = m[1] :: any, value = m[2], number = 2 }, true)
	end
	return { momente = 5 }
end

-- Paket E: Rekord-Moment am eigenen Schau-Turm
commands.record = function(player, _data)
	_worldSignal += 1
	workspace:SetAttribute("DebugRecord", string.format("%d|%d", player.UserId, _worldSignal))
	return { rekord = true }
end

-- v15: den aktuellen Spielstand in ein v14-Format zuruckverwandeln (Topf L7,
-- Presse L4, PIT 5, letzter Lauf Stage 12) und durch die Migration schicken —
-- das Ergebnis wird NICHT uebernommen, nur angezeigt (Migrations-Probe).
commands.v14save = function(_player, data)
	local HttpServiceLocal = game:GetService("HttpService")
	local copy = HttpServiceLocal:JSONDecode(HttpServiceLocal:JSONEncode(data))
	copy.version = 14
	copy.towers = nil
	copy.daily = nil
	copy.island.towerProgress = nil
	copy.island.pitRefund = nil
	copy.island.pitLevel = 5
	copy.island.pitProgress = { pitLevel = 5, reachedStage = 12 }
	copy.island.buildings.HoneyRefiner = nil
	copy.island.buildings.HoneyPot   = { id = "HoneyPot",   level = 7, honey = 4, lastProducedAt = os.time() }
	copy.island.buildings.HoneyPress = { id = "HoneyPress", level = 4, honey = 5, lastProducedAt = os.time() }
	local migrated = PlayerMigration.applyDefaults(copy)
	return {
		version   = migrated.version,
		veredler  = migrated.island.buildings.HoneyRefiner,
		erstattung = migrated.island.pitRefund,
		rekorde   = migrated.towers.records,
	}
end

commands.petmode = function(player, data)
	local pitPhase, stage = PitArenaService.getPhase(player)
	return {
		zuHause     = PetModeService.isHome(player),
		pit         = pitPhase,
		stage       = stage,
		event       = EventParticipationService.getPhase(player),
		-- Sammel-Update Paket 1.1: wer haelt die Figur gerade? (UFO-Einfrieren)
		lockHalter  = ActivityLock.owner(player) or "frei",
		entfuehrt   = EventParticipationService.isAbducting(player),
		towerProgress = data.island.towerProgress,
		eggStock    = data.island.eggStock,
		gummies     = data.gummies,
		lastEggAt   = data.island.lastEggAt,
	}
end

commands.pm = function(player, data, mode: any, resume: any)
	PetModeService.request(player, tostring(mode or "Home"), if resume then tostring(resume) :: any else nil)
	return commands.petmode(player, data)
end

commands.fight = function(player, _data, uid: any)
	CombatService.startPitRun(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

-- Alle Honig-Lager sofort fuellen (umgeht die Wartezeit).
-- Ohne das dauert jeder Level-Test 20 Sekunden pro Honig.

-- v15: Waben im Event-Pit legen und Zustand ausgeben
commands.combs = function(player, data, n: any)
	local count = if typeof(n) == "number" then math.clamp(math.floor(n), 0, 100) else 0
	if count > 0 then
		CombService.debugSpawn(count)
	end

	local recycler = data.island.recycler
	local slots = CombService.getSlotInfo()
	return {
		wabenImPit    = CombService.getWorldCount(),
		getragen      = CombService.getCarriedCount(player),
		getragenAlle  = slots.held,
		respawnQueue  = slots.queued,
		slotLimit     = slots.limit,
		recyclerLevel = recycler.level,
		warteschlange = recycler.queued,
	}
end

-- v17: naechsten UFO-Abwurf als Jackpot erzwingen; Stand des Pity-Zaehlers
commands.jackpot = function(_player, _data)
	JackpotRoll.ufo.forceNext = true
	return {
		naechsterIstJackpot = true,
		abwuerfeSeitJackpot = JackpotRoll.ufo.sinceLast,
		abwuerfeGesamt      = JackpotRoll.ufo.total,
		jackpotsGesamt      = JackpotRoll.ufo.jackpots,
		pity                = EventConfig.UFO.JACKPOT_PITY_DROPS,
	}
end

-- v17: Wabenthema setzen ("off" = normal)
commands.combtheme = function(_player, _data, themeId: any)
	local id = if typeof(themeId) == "string" and themeId ~= "off" then themeId else nil
	CombService.setTheme(id)
	local slots = CombService.getSlotInfo()
	return { thema = CombService.getTheme() or "normal", wabenImPit = slots.world, slotLimit = slots.limit }
end

-- v17: Waben einfliegen lassen (wie ein Vulkan-Ausbruch aus der Pit-Mitte)
commands.launch = function(_player, _data, n: any)
	local count = if typeof(n) == "number" then math.clamp(math.floor(n), 1, 30) else 10
	local origin = MapService.getEventPitPosition() + Vector3.new(0, 2, 0)
	return { gestartet = CombService.launchCombs(count, origin), slots = CombService.getSlotInfo() }
end

-- v15: Wabeneinheiten direkt in die Warteschlange des Recyclers legen
commands.queue = function(player, data, n: any)
	local units = if typeof(n) == "number" then math.clamp(math.floor(n), 0, 100000) else 0
	if units > 0 then
		CombRecyclerService.deposit(player, units)
	end

	local recycler = data.island.recycler
	return {
		warteschlange = recycler.queued,
		level         = recycler.level,
		gummies       = data.gummies,
	}
end

-- v15: Recycler-Level direkt setzen (ohne Kosten)
commands.recycler = function(player, data, level: any)
	local recycler = data.island.recycler
	if typeof(level) == "number" then
		recycler.level = CombConfig.clampLevel(level)
		PlayerService.markDirty(player)
	end

	return {
		level         = recycler.level,
		gummiesJeEinheit = CombConfig.getPayPerUnit(recycler.level),
		einheitenProSek  = CombConfig.getSpeed(recycler.level),
		warteschlange = recycler.queued,
	}
end

commands.honey = function(player, data)
	local filled: { [string]: number } = {}

	for _, building in data.island.buildings do
		-- Lager DIESES Gebaeudes auf DIESEM Level: der Bienenstock fasst seit
		-- v7 mehr als die anderen beiden.
		building.honey          = BuildingBehavior.getCapacity(building.id, building.level)
		building.lastProducedAt = os.time()
		filled[building.id]     = building.honey
	end

	PlayerService.markDirty(player)
	return { honey = filled }
end

-- Einen Baerchi fuettern (heilt + gibt XP), so oft wie angegeben
commands.feed = function(player, _data, uid: any, times: any)
	local count = math.clamp(tonumber(times) or 1, 1, 100)

	for _ = 1, count do
		HoneyService.feed(player, tostring(uid))
	end

	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Fusion. Die beiden letzten Argumente sind der Sperr-Schritt aus dem
-- Fusions-Menue (siehe FusionService, Regel C) und duerfen weggelassen werden —
-- dann laeuft alles automatisch.
--   D:Invoke("fuse", uidA, uidB)                   -- alles automatisch
--   D:Invoke("fuse", uidA, uidB, "ability", "B")   -- Skill kommt von B
commands.fuse = function(player, _data, uidA: any, uidB: any, lockedProperty: any, lockedFrom: any)
	local property = if lockedProperty ~= nil then tostring(lockedProperty) else nil
	local from     = if lockedFrom ~= nil then tostring(lockedFrom) else nil

	FusionService.fuse(player, tostring(uidA), tostring(uidB), property :: any, from :: any)
	return commands.list(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v8: Promotion, Charms, Event-Teilnahme
--------------------------------------------------------------------------------

-- Befoerdern. Legt die noetigen Duplikate NICHT selbst an — wer testen will,
-- ruft vorher mehrfach "add <configId>" auf. Genau so merkt man, ob die
-- Material-Pruefung tut, was sie soll.
commands.promote = function(player, _data, uid: any)
	PromotionService.promote(player, tostring(uid))
	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Charms wuerfeln. Kostet echte GoldGummies — vorher "give 0 100000".
commands.roll = function(player, _data, uid: any, times: any)
	CharmService.rollCharms(player, tostring(uid), tonumber(times) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Alle acht Slots eines Baerchis im Klartext.
commands.charms = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local bySlot: { [number]: any } = {}
	for _, charm in baerchi.charms or {} do
		bySlot[charm.slot] = charm
	end

	local out = {}
	for slot = 1, CharmConfig.SLOT_COUNT do
		local charm = bySlot[slot]
		out[slot] = {
			slot     = CharmConfig.SLOT_NUMERALS[slot],
			offen    = CharmConfig.isSlotUnlocked(slot, baerchi.promotionLevel or 0),
			abPromo  = CharmConfig.getUnlockPromotion(slot),
			rarity   = if charm then charm.rarity else nil,
			effekt   = if charm then CharmConfig.describe(charm) else nil,
			gesperrt = if charm then charm.locked else nil,
		}
	end

	return { promotion = baerchi.promotionLevel or 0, slots = out }
end

-- Einen Charm-Slot sperren/freigeben.
commands.lock = function(player, _data, uid: any, slot: any)
	CharmService.toggleLock(player, tostring(uid), tonumber(slot) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Den ausgeruesteten Baerchi zum Event schicken bzw. zurueckholen.
commands.event = function(player, _data)
	EventParticipationService.sendToEvent(player)
	return { unterwegs = true }
end

commands.recall = function(player, _data)
	EventParticipationService.recall(player)
	return { unterwegs = true }
end

--------------------------------------------------------------------------------
-- v10: Eier legen
--------------------------------------------------------------------------------

-- Legt sofort ein Ei, ohne auf das Intervall zu warten. Mehrfach aufrufen, um
-- den Plot zu fuellen und die Obergrenze zu pruefen.
commands.lay = function(player, _data, times: any)
    local count  = math.clamp(tonumber(times) or 1, 1, 30)
    local laid   = 0

    for _ = 1, count do
        if EggLayService.layNow(player) then
            laid += 1
        else
            break   -- Obergrenze erreicht oder kein Baerchi ausgeruestet
        end
    end

    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Was gerade herumliegt, plus die Werte des ausgeruesteten Legers.
commands.eggs = function(_player, data)
    local out = {}
    for _, egg in data.island.laidEggs or {} do
        table.insert(out, { uid = egg.uid, typ = egg.eggType })
    end

    local uid     = data.island.equippedUid
    local baerchi = if uid then data.island.baerchis[uid] else nil

    local rate: any = "kein Baerchi ausgeruestet"
    local chancen: any = nil

    if baerchi then
        local online  = EggCalculator.getLayIntervalSeconds(baerchi, false)
        local offline = EggCalculator.getLayIntervalSeconds(baerchi, true)

        rate = {
            configId       = baerchi.configId,
            level          = baerchi.level,
            eggStufe       = (baerchi.statLevels :: any).egg or 0,
            mutation       = baerchi.mutation,
            sekundenOnline = if online then math.floor(online + 0.5) else nil,
            sekundenOffline= if offline then math.floor(offline + 0.5) else nil,
        }

        chancen = {}
        for _, chance in EggCalculator.getChances(baerchi) do
            table.insert(chancen, string.format("%s %.0f%%", chance.eggType, chance.percent))
        end
    end

    return {
        liegen  = #out,
        maximum = EggConfig.MAX_UNCOLLECTED_EGGS,
        eier    = out,
        lager   = data.island.eggStock,
        leger   = rate,
        chancen = chancen,
    }
end

-- Alle herumliegenden Eier einsammeln (dasselbe wie der Knopf auf der Karte).
commands.collect = function(player, _data)
    EggLayService.collectAll(player)
    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Die Zeitmarke kuenstlich in die Vergangenheit setzen und danach nachrechnen
-- lassen — so laesst sich das OFFLINE-Nachholen pruefen, ohne den Server zu
-- verlassen. Der naechste Tick (max. 5s) legt dann die faelligen Eier.
--
-- Achtung: der Tick rechnet mit der ONLINE-Rate. Das echte Offline-Verhalten
-- (langsamer, siehe EggConfig.OFFLINE_SLOWDOWN) sieht man nur beim Rejoin.
commands.eggtime = function(player, data, minutes: any)
    local back = math.clamp(tonumber(minutes) or 30, 1, 10000)
    data.island.lastEggAt = os.time() - back * 60
    PlayerService.markDirty(player)

    return { zurueckgestellt = back .. " Minuten", hinweis = "naechster Tick legt nach (max. 5s)" }
end

-- Die laufende Phase sofort beenden. Zweimal aufgerufen bekommt man also aus
-- der Pause heraus ein vollstaendiges Event samt Belohnung, ohne acht Minuten
-- zu warten:
--   D:Invoke("skipevent")   -- Pause vorbei, Event laeuft
--   D:Invoke("event")       -- Baerchi hinschicken, ankommen lassen
--   D:Invoke("skipevent")   -- Event vorbei → Stat-Stufe wird vergeben
commands.skipevent = function(_player, _data)
	EventService.skipPhase()

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		belohnung    = if active then Loc.resolve(EventConfig.describeReward(active)) else nil,
		naechstes    = EventService.getNext().displayName,
		restSekunden = EventService.getRemainingSeconds(),
	}
end

-- Der ganze Katalog mit Belohnung, in der Reihenfolge, in der die Events
-- laufen. Praktisch, um die ids fuer "startevent" nachzuschlagen.
commands.events = function(_player, _data)
	local katalog = {}
	for index, def in EventConfig.EVENTS do
		table.insert(katalog, string.format(
			"%d. %s (%s) — %s",
			index, def.displayName, def.id, Loc.resolve(EventConfig.describeReward(def))
		))
	end

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		restSekunden = EventService.getRemainingSeconds(),
		naechstes    = EventService.getNext().displayName,
		takt         = string.format(
			"individuelle Dauer je Event / %ds Pause",
			EventConfig.EVENT_GAP_SECONDS
		),
		katalog      = katalog,
	}
end

-- Ein BESTIMMTES Event sofort starten, statt sich durch den Zyklus zu warten.
-- Ein voller Durchlauf durch alle zehn Events dauert 80 Minuten — ohne diesen
-- Befehl waere z.B. der Mutations-Sturm praktisch nicht testbar.
--
-- Laeuft gerade ein anderes Event, wird es vorher ordentlich beendet (die
-- Anwesenden bekommen also noch ihre Belohnung, siehe EventService.startById).
commands.startevent = function(_player, _data, id: any)
	local eventId = tostring(id or "")

	if not EventService.startById(eventId) then
		local ids = {}
		for _, def in EventConfig.EVENTS do
			table.insert(ids, def.id)
		end
		return { error = "Unbekannte Event-id: " .. eventId, verfuegbar = ids }
	end

	local active = EventService.getActive()
	return {
		gestartet    = if active then active.displayName else "?",
		belohnung    = if active then Loc.resolve(EventConfig.describeReward(active)) else nil,
		restSekunden = EventService.getRemainingSeconds(),
		hinweis      = "jetzt 'event' aufrufen, um den Baerchi hinzuschicken — er muss beim ENDE dort stehen",
	}
end

commands.recycle = function(player, _data, uid: any)
	RecycleService.recycle(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.upgrade = function(player, _data, buildingId: any)
	IslandService.upgradeBuilding(player, buildingId)
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.rebirth = function(player, _data)
	RebirthService.rebirth(player)
	return commands.info(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v14: Ei-Baum
--------------------------------------------------------------------------------

commands.tree = function(_player, data)
	local out = { blueprints = data.eggTree.blueprints, rebirths = data.rebirthCount }
	for _, eggId in EggConfig.getOrderedIds() do
		local p = EggTree.getProgress(data, eggId)
		local parts = {}
		for _, c in p.conditions do
			local label = c.kind .. (if c.egg then ":" .. c.egg elseif c.rarity then ":" .. c.rarity else "")
			table.insert(parts, string.format("%s %d/%d%s", label, c.have, c.need, if c.done then " ok" else ""))
		end
		out[string.format("%02d %s", EggConfig.data[eggId].sortOrder, eggId)] = string.format("%s | hatched %d | lager %d | %s",
			if p.unlocked then "FREI" else "zu", data.eggTree.hatched[eggId] or 0,
			data.island.eggStock[eggId] or 0, table.concat(parts, ", "))
	end
	return out
end

commands.unlock = function(player, data, eggType: any)
	if eggType == "all" then
		for _, eggId in EggConfig.getOrderedIds() do
			EggTreeService.forceUnlock(player, data, eggId, "debug")
		end
	elseif typeof(eggType) == "string" and EggConfig.data[eggType :: Types.EggType] then
		EggTreeService.forceUnlock(player, data, eggType :: Types.EggType, "debug")
	else
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.hatched = function(player, data, eggType: any, count: any)
	if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	data.eggTree.hatched[eggType] = math.max(0, math.floor(tonumber(count) or 0))
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.blueprint = function(player, data, amount: any)
	EggTreeService.grantBlueprint(player, data, tonumber(amount) or 1)
	PlayerService.markDirty(player)
	return { blueprints = data.eggTree.blueprints }
end

commands.useblueprint = function(player, data, eggType: any)
	local ok = EggTreeService.useBlueprint(player, eggType)
	return { ok = ok, tree = commands.tree(player, data) }
end

commands.press = function(player, data, eggType: any, path: any)
	local result = EggTreeService.press(player, eggType, path)
	return { result = result, stock = data.island.eggStock }
end

commands.setrebirth = function(player, data, count: any)
	data.rebirthCount = math.max(0, math.floor(tonumber(count) or 0))
	data.rebirthMult  = EconomyConfig.getRebirthMult(data.rebirthCount)
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

-- Spielstand fuer Tests sichern und zuruecksetzen. Die Kopie liegt nur im
-- Speicher dieses Servers (nicht im DataStore).
local HttpService = game:GetService("HttpService")
local _snapshot: string? = nil

commands.snapshot = function(_player, data)
	_snapshot = HttpService:JSONEncode(data)
	return { ok = true, bytes = #(_snapshot :: string) }
end

commands.restore = function(player, data)
	if not _snapshot then return { error = "Kein Snapshot" } end
	local saved = HttpService:JSONDecode(_snapshot :: string)
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in saved do (data :: any)[k] = v end
	MapService.rebuildIsland(player, data.island)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return { ok = true }
end

-- HBB Paket 0: feste Test-Zustaende fuer Playtests und Studio-Testschritte.
--   fresh   = Startstand eines neuen Kontos (createdAt = jetzt → Trichter misst)
--   hatch10 = fresh + zehn geoeffnete Basis-Eier
--   tower1  = hatch10 + Tower I geschafft (Rekord 30, Meilensteine ausgezahlt)
--
-- Studio spielt gegen den ECHTEN DataStore. Deshalb verlangt der Befehl einen
-- vorherigen "snapshot"; zurueck geht es mit "restore". Der Snapshot liegt nur
-- im Speicher dieses Servers — vor "Stop" also restore aufrufen.
--
-- Der Baerchi sollte zu Hause stehen (kein Kampf, kein Event), sonst haelt ein
-- anderer Service noch die alte Figur.
local TEST_STATES = { fresh = true, hatch10 = true, tower1 = true }
local TEST_HATCH_COUNT = 10
local TEST_TOWER_RECORD = 30

commands.state = function(player, data, name: any)
	local stateName = tostring(name or "")
	if not TEST_STATES[stateName] then
		return { error = "Unbekannter Zustand: " .. stateName, verfuegbar = { "fresh", "hatch10", "tower1" } }
	end
	if not _snapshot then
		return { error = "Erst D:Invoke(\"snapshot\") — Studio schreibt in den echten Spielstand" }
	end

	-- 1. fresh: alles ersetzen ausser Sitzungs-Sperre und Sprache
	local session  = (data :: any).session
	local language = data.language
	local fresh = PlayerService.buildDefaultData()
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in fresh :: any do (data :: any)[k] = v end
	;(data :: any).session = session
	data.language = language
	MapService.rebuildIsland(player, data.island)
	FunnelService.debugReset(player)

	-- 2. hatch10: ueber den echten Weg oeffnen, damit Zaehler, Index und
	-- Auto-Ausruesten genau wie im Spiel laufen.
	if stateName == "hatch10" or stateName == "tower1" then
		data.island.eggStock.BasicEgg = (data.island.eggStock.BasicEgg or 0) + TEST_HATCH_COUNT
		for _ = 1, TEST_HATCH_COUNT do
			EggService.openEgg(player, "BasicEgg")
		end
	end

	-- 3. tower1: Rekord setzen, Meilensteine wie bei "towerrecord"
	if stateName == "tower1" then
		TowerService.debugSetRecord(player, "I", TEST_TOWER_RECORD)
	end

	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return {
		ok = true,
		zustand = stateName,
		baerchis = countBaerchis(data),
		lager = data.island.eggStock,
		rekorde = data.towers.records,
		hinweis = "Zurueck mit D:Invoke(\"restore\")",
	}
end

-- Ein einzelner Kampf mit Runden-Log (Faehigkeiten pruefen).
commands.skilltest = function(_player, _data, configId: any, stage: any)
	local b = BaerchiFactory.create(tostring(configId), { level = 20 })
	if not b then return { error = "Unbekannter Baerchi" } end
	local def = BaerchiConfig.getById(b.configId)
	local stats = CombatCalculator.getEffectiveStats(b, (def :: any).baseStats)
	local es = CombatConfig.getEnemyStats(1, tonumber(stage) or 20)
	local me = { uid = "me", stats = stats, hp = stats.maxHp, charge = 0 }
	local en = { uid = "en", stats = es, hp = es.maxHp, charge = 0 }
	local r = CombatCalculator.simulate(me, en)
	local lines = {}
	for i, e in r.log do
		if i > 40 then break end
		table.insert(lines, string.format("%s r%d %s dmg %d heal %d abs %d | A %d B %d %s",
			e.actor, e.roundNumber, e.skillId or "-", e.damage, e.heal, e.absorbed,
			e.attackerHpAfter, e.defenderHpAfter, if e.effects then table.concat(e.effects, ",") else ""))
	end
	return { winner = r.winnerUid, rounds = r.rounds, skillUses = r.skillUses, log = lines }
end

commands.help = function()
	return {
		"info", "give <gummies> <gold>", "list",
		"add <configId> <level> [mutation]", "stats <uid>",
		"building <id> <level>",
		"hatch <eggType>", "egg <eggType> [anzahl]", "pitprogress <stage>", "honey", "feed <uid> <times>",
		"fight <uid>", "skill <uid|equipped> <skillId>",
		"fuse <uidA> <uidB> [ability|level|eggs] [A|B]",
		"recycle <uid>", "upgrade <buildingId>", "rebirth",

		-- v8
		"promote <uid>", "charms <uid>", "roll <uid> [anzahl]", "lock <uid> <slot>",
		"event", "recall", "skipevent", "events", "startevent <eventId>",

		-- v10
		"eggs", "lay [anzahl]", "collect", "eggtime <minuten>",

		-- v12
		"petmode", "pm <Event|Fight|Home> [Fresh|Percent|Last]",

		-- v14
		"tree", "unlock <eggType|all>", "hatched <eggType> <n>", "blueprint [n]",
		"useblueprint <eggType>", "press <eggType> [Gold|Kristall|Void]", "setrebirth <n>",
		"skilltest <configId> [stage]", "snapshot", "restore",
		-- HBB Paket 0
		"state <fresh|hatch10|tower1>  (erst snapshot!)",

		-- v15
		"combs [anzahl]", "queue <einheiten>", "recycler [level]",

		-- v15 (Tower/Gebaeude/Angeben/Login-Bonus)
		"tower <I|II|III|Final> <stage>", "towerrecord <id> <stage>", "rebirthcap",
		"pass <on|off|reset> [KEY]  (08.10.: Gamepass Gratis-Skip testen)",
		"dailyshift <tage>", "lbflush", "parts", "v14save",

		-- v17
		"jackpot", "combtheme <themeId|off>", "launch [anzahl]",

		-- Welt aufwerten
		"worldshots [1..6|0]", "daytime <uhrzeit|auto>", "pitstate <idle|soon|live|auto>",
		"neststate <calm|boss|auto>", "arrival", "fish",
		"islandstage <1..4|auto>", "pondfull", "spectators <hop|cheer>", "record",
		"moment <hatch|tower|record|rebirth|mutation> [wert]", "moments5",
	}
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function DebugService.init()
	if not RunService:IsStudio() then
		return   -- im Live-Spiel gibt es diesen Service schlicht nicht
	end

	local existing = ServerScriptService:FindFirstChild(BINDABLE_NAME)
	if existing then existing:Destroy() end

	local bindable = Instance.new("BindableFunction")
	bindable.Name   = BINDABLE_NAME
	bindable.Parent = ServerScriptService

	bindable.OnInvoke = function(command: any, ...)
		local name = tostring(command or "help")
		local handler = commands[name]
		if not handler then
			return { error = "Unbekannter Befehl: " .. name, verfuegbar = commands.help() }
		end

		if name == "help" then
			return commands.help()
		end

		local player, data, reason = requireData()
		if not player or not data then
			return { error = reason }
		end

		local ok, result = pcall(handler, player, data, ...)
		if not ok then
			return { error = tostring(result) }
		end
		return result
	end

	print("[DebugService] Initialisiert | Command Bar: game.ServerScriptService." .. BINDABLE_NAME .. ":Invoke(\"help\")")
end

return DebugService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX28"><Properties>
<string name="Name">GamepassService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- GamepassService.luau
-- ServerScriptService/Services/GamepassService.luau
--
-- Einzige Zustaendigkeit:
--   - Gamepass-Besitz pruefen und im Speicher halten (08.10., Paket C):
--     beim Join und nach PromptGamePassPurchaseFinished
--     (MarketplaceService.UserOwnsGamePassAsync, mit pcall); den Kauf-Dialog
--     ausloesen (RequestBuyGamepass).
--
-- Besitz steht NICHT im Spielstand (Roblox ist die Wahrheit). Fuer die
-- Anzeige schreibt der Service ein Attribut an den Player
-- (GamepassConfig.attributeName); Kosten rechnet nur der Server mit
-- GamepassService.owns (z. B. CombatService beim bezahlten Einstieg).
--
-- id = 0 (nicht angelegt): niemand besitzt den Pass, ein Kaufwunsch wird
-- still verworfen (der Knopf zeigt "Bald") — kein Fehler, kein Crash.
-- Studio: Debug "pass <KEY> on|off" setzt den Besitz fuer diese Sitzung.

local Players            = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Remotes        = require(ReplicatedStorage.Network.Remotes)
local GamepassConfig = require(ReplicatedStorage.Config.GamepassConfig)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local GamepassService = {}

-- Spieler -> Pass-Key -> Besitz (aus Roblox)
local _owned: { [Player]: { [string]: boolean } } = {}
-- Debug-Uebersteuerung (nur Studio): Spieler -> Key -> Besitz
local _debug: { [Player]: { [string]: boolean } } = {}

local function publish(player: Player, key: string)
	player:SetAttribute(GamepassConfig.attributeName(key), GamepassService.owns(player, key))
end

-- Besitz eines Passes (Debug vor Roblox). Nie ein Fehler.
function GamepassService.owns(player: Player, key: string): boolean
	local forced = _debug[player]
	if forced and forced[key] ~= nil then
		return forced[key]
	end
	local owned = _owned[player]
	return owned ~= nil and owned[key] == true
end

-- Fragt Roblox fuer alle angelegten Passes (pcall: der Dienst kann ausfallen,
-- dann bleibt der bekannte Stand bzw. "nicht besessen").
function GamepassService.refresh(player: Player)
	local owned = _owned[player] or {}
	_owned[player] = owned
	for key, def in GamepassConfig.PASSES do
		if def.id > 0 then
			local ok, result = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
			end)
			if ok then
				owned[key] = result == true
			else
				warn("[GamepassService] Besitz nicht pruefbar:", player.Name, key, result)
			end
		else
			owned[key] = false
		end
		publish(player, key)
	end
end

-- Debug (Studio): Besitz fuer diese Sitzung erzwingen; nil = wieder Roblox.
function GamepassService.debugSet(player: Player, key: string, value: boolean?)
	local forced = _debug[player] or {}
	_debug[player] = forced
	forced[key] = value
	publish(player, key)
end

local function keyForId(passId: number): string?
	for key, def in GamepassConfig.PASSES do
		if def.id > 0 and def.id == passId then return key end
	end
	return nil
end

function GamepassService.init()
	RateLimiter.connect(Remotes.RequestBuyGamepass, "RequestBuyGamepass", function(player, key: any)
		if typeof(key) ~= "string" then return end
		local def = GamepassConfig.get(key)
		if not def or def.id <= 0 then return end          -- "Bald": still verwerfen
		if GamepassService.owns(player, key) then return end
		local ok, err = pcall(function()
			MarketplaceService:PromptGamePassPurchase(player, def.id)
		end)
		if not ok then warn("[GamepassService] Kauf-Dialog fehlgeschlagen:", err) end
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		local key = keyForId(passId)
		if not key or not purchased then return end
		local owned = _owned[player] or {}
		_owned[player] = owned
		owned[key] = true
		publish(player, key)
		print("[GamepassService]", player.Name, "hat gekauft:", key)
	end)

	Players.PlayerRemoving:Connect(function(player)
		_owned[player] = nil
		_debug[player] = nil
	end)

	print("[GamepassService] Initialisiert")
end

function GamepassService.start()
	for _, player in Players:GetPlayers() do
		task.spawn(GamepassService.refresh, player)
	end
	Players.PlayerAdded:Connect(function(player)
		GamepassService.refresh(player)
	end)
end

return GamepassService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX29"><Properties>
<string name="Name">MapService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- MapService.luau
-- ServerScriptService/Services/MapService.luau
--
-- Einzige Zustaendigkeit:
--   - Die einzige Schnittstelle zur gebauten Welt: Welt beim Start bauen
--     lassen, Spieler-Plots vergeben, spawnen, neu aufbauen und despawnen,
--     und die sichtbaren Teile aktuell halten (Schilder, Figur, Teich, Eier,
--     Lauf-Turm, Tower-Turm, Event-Pit)
--
-- Das eigentliche BAUEN steht in den Modulen unter Util/MapBuild (MapParts,
-- WorldBuilder, PlotBuilder, PondBuilder, ArenaBuilder, FigureBuilder,
-- LaidEggBuilder). Dieser Service haelt den Zustand (welcher Spieler welchen
-- Slot und welches Plot-Model hat) und entscheidet, WANN gebaut wird. Andere
-- Services sprechen nur mit MapService, nie mit den Buildern.
--
-- Baut physische Roblox-Parts aus IslandData.
-- Kennt keine Spielerdaten ausser IslandData (und den Namen fuer das Schild).
--
-- Alle Masse, Farben und Offsets kommen aus MapConfig. Wie das plot-lokale
-- Koordinatensystem funktioniert (lokales -Z = Richtung Mitte, +Z = nach
-- aussen), steht im Kopf von MapConfig.
--
-- ZWEI ARTEN VON AKTUALISIERUNG — bewusst getrennt:
--   * NEU BAUEN (updateBaerchis, updateBuildingLooks, updateTowerShowcase):
--     teuer, nur wenn sich die Struktur aendert (ein Baerchi kommt dazu, faellt
--     weg oder steigt im Level; ein Gebaeude wechselt den Look; der Tower-Turm
--     bekommt einen neuen Look oder Rekord).
--   * IN-PLACE (updateBaerchiStates, updateBuildingSigns): billig, aendert nur
--     Beschriftung und Transparenz an bereits stehenden Teilen. Dafuer gibt es
--     die Trennung: HP und Honig aendern sich staendig, und dafuer jedes Mal
--     25 Mesh-Figuren neu zu bauen waere Verschwendung.
--   PlotDisplayService entscheidet welche der beiden noetig ist.
--
-- NEUAUFBAU WAEHREND EINER BEWEGUNG — die eine Sperre in dieser Datei:
-- updateBaerchis zerstoert die Figur und baut sie neu. Laeuft sie in dem
-- Moment gerade (Kampf-Lauf oder Weg zum Honig-Teich), verschwaende sie mitten
-- im Schritt. Die Pruefung dagegen steht EINMAL hier drin statt an jeder
-- Aufrufstelle — und der uebersprungene Neuaufbau wird nachgeholt, sobald das
-- Schloss frei ist (siehe scheduleRebuildWhenFree weiter unten). Ohne das
-- Nachholen bliebe die Beschriftung dauerhaft veraltet, weil der Aufrufer
-- (PlotDisplayService) den neuen Stand direkt danach als "dargestellt" merkt.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig = require(ReplicatedStorage.Config.MapConfig)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types     = require(ReplicatedStorage.Network.Types)
local WorldText = require(ReplicatedStorage.Localization.WorldText)
local Loc       = require(ReplicatedStorage.Localization.Loc)

local ActivityLock = require(ServerScriptService.Util.ActivityLock)
local FigureFX     = require(ServerScriptService.Util.FigureFX)

local MapBuild       = ServerScriptService.Util.MapBuild
local MapParts       = require(MapBuild.MapParts)
local WorldBuilder   = require(MapBuild.WorldBuilder)
local PlotBuilder    = require(MapBuild.PlotBuilder)
local PondBuilder    = require(MapBuild.PondBuilder)
local ArenaBuilder   = require(MapBuild.ArenaBuilder)
local FigureBuilder  = require(MapBuild.FigureBuilder)
local LaidEggBuilder = require(MapBuild.LaidEggBuilder)
local IncubatorConfig = require(ReplicatedStorage.Config.IncubatorConfig)
local RecyclerBuilder = require(MapBuild.RecyclerBuilder)
local IncubatorBuilder = require(MapBuild.IncubatorBuilder)   -- Sammel-Update Paket 8
local TerminalBuilder  = require(MapBuild.TerminalBuilder)    -- 08.10. Tower-Terminal

--------------------------------------------------------------------------------
-- Interner Zustand
--------------------------------------------------------------------------------

-- Welcher Slot gehoert welchem Spieler
local _playerSlot: { [Player]: number } = {}

-- Alle gespawnten Plot-Models, key = Player
local _plotModels: { [Player]: Model } = {}

-- Verfuegbare Slots (1 .. PLOT_COUNT), wird in init() gefuellt
local _freeSlots: { number } = {}

-- Fuer welche Spieler gerade ein Waechter darauf wartet, den wegen
-- ActivityLock uebersprungenen Figuren-Neuaufbau nachzuholen. Verhindert, dass
-- mehrere Datenaenderungen waehrend derselben Bewegung mehrere Warte-Schleifen
-- starten — eine reicht, sie liest am Ende ohnehin frische Daten.
local _pendingRebuild: { [Player]: boolean } = {}

-- Woher der nachgeholte Neuaufbau seine FRISCHEN IslandData bekommt.
--
-- Absichtlich als eingehaengte Funktion statt eines require(PlayerService):
-- PlayerService requiret bereits MapService, der umgekehrte Weg waere ein
-- Ringschluss. Ausserdem bleibt damit die Regel
-- im Kopf dieser Datei gueltig — MapService kennt weiterhin keine
-- Spielerdaten ausser IslandData. Eingehaengt wird sie von
-- PlotDisplayService.init(); ohne sie faellt nur das Nachholen aus.
local _islandDataProvider: ((Player) -> Types.IslandData?)? = nil

-- v15: zuletzt gesetzter Tower-Turm und Tower-Symbol am Plot-Schild pro
-- Spieler. MapService kennt die Tower-Daten nicht (sie liegen ausserhalb von
-- IslandData) — PlotDisplayService setzt beides; gemerkt wird es hier, damit
-- ein Neuaufbau des Plots (Rebirth) Turm und Symbol sofort wieder mitbaut.
local _showcase: { [Player]: ArenaBuilder.ShowcaseView } = {}
-- Sammel-Update Paket 8: Platz-Zahl des Inkubators (siehe setIncubatorSlotProvider)
local _incubatorSlots: (Player) -> number = function(_player: Player): number return 1 end
type Badge = { text: string, color: Color3 }
local _badge: { [Player]: Badge } = {}
local _crown: { [Player]: boolean } = {}   -- Paket 9: Top 10 der Endless-Woche
-- 08.10.: zuletzt gesetzter Terminal-Zustand (Neuaufbau nach Rebirth baut ihn mit)
local _terminal: { [Player]: TerminalBuilder.TerminalView } = {}

local function badgeText(player: Player, text: string | Types.LocMsg): string | Types.LocMsg
	return if _crown[player] then Loc.msg("fmt.append", { a = "♛", b = text }) else text
end

--------------------------------------------------------------------------------
-- Plot-Inhalt
--------------------------------------------------------------------------------

-- Baut den kompletten Inhalt eines Plots (Gebaeude + Bruecke + PIT + Baerchis).
local function buildPlotContents(plotModel: Model, slot: number, islandData: Types.IslandData, owner: Player)
	local pool = PondBuilder.honeyPool(islandData)
	for _, building in islandData.buildings do
		PlotBuilder.buildBuilding(plotModel, slot, building, pool)
	end

	ArenaBuilder.buildBridge(plotModel, slot)
	ArenaBuilder.buildPit(plotModel, slot)
	PondBuilder.buildPond(plotModel, slot, islandData)
	RecyclerBuilder.build(plotModel, slot, islandData.recycler)
	-- Sammel-Update Paket 8: Inkubator (Plaetze liefert der Daten-Lieferant,
	-- weil sie auch an Rebirths und Index haengen, die nicht in der Insel stehen).
	if FeatureFlags.isOn("INCUBATOR") and islandData.incubator then
		IncubatorBuilder.build(plotModel, slot, islandData.incubator, _incubatorSlots(owner), islandData.baerchis)
	end
	-- 08.10.: Tower-Terminal am Stegbeginn (Zustand nur als Attribute)
	if FeatureFlags.isOn("TOWER_TERMINAL") then
		TerminalBuilder.build(plotModel, slot, _terminal[owner])
	end
	FigureBuilder.renderBaerchis(plotModel, slot, islandData)
	LaidEggBuilder.renderLaidEggs(plotModel, slot, islandData, owner)

	-- v15: Tower-Turm und Symbol, falls schon bekannt (nach einem Rebirth).
	local view = _showcase[owner]
	if view then
		ArenaBuilder.buildShowcase(plotModel, slot, view)
	end
	local badge = _badge[owner]
	if badge then
		PlotBuilder.writeOwnerBadge(plotModel, badgeText(owner, badge.text), badge.color)
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

local MapService = {}

local function claimSlot(): number?
	if #_freeSlots == 0 then return nil end
	return table.remove(_freeSlots, 1)
end

local function releaseSlot(slot: number)
	table.insert(_freeSlots, slot)
	table.sort(_freeSlots)
end

function MapService.spawnIsland(player: Player, islandData: Types.IslandData)
	-- Alten Slot freigeben falls vorhanden (sollte nicht passieren, aber sicher)
	if _playerSlot[player] then
		MapService.despawnIsland(player)
	end

	local slot = claimSlot()
	if not slot then
		warn("[MapService] Kein freier Plot fuer Spieler:", player.Name)
		return
	end

	_playerSlot[player] = slot

	local plotModel = PlotBuilder.buildPlotBase(slot, player)
	_plotModels[player] = plotModel

	buildPlotContents(plotModel, slot, islandData, player)

	print("[MapService] Plot gespawnt fuer:", player.Name, "| Slot:", slot)
end

-- Baut den Plot eines Spielers komplett neu — behaelt aber seinen Slot,
-- damit er nach einem Rebirth an derselben Stelle der Map steht.
function MapService.rebuildIsland(player: Player, islandData: Types.IslandData)
	local slot = _playerSlot[player]
	if not slot then
		-- Noch kein Plot (z.B. Server voll) → normaler Spawn-Versuch
		MapService.spawnIsland(player, islandData)
		return
	end

	local oldModel = _plotModels[player]
	if oldModel then
		oldModel:Destroy()
	end

	local plotModel = PlotBuilder.buildPlotBase(slot, player)
	_plotModels[player] = plotModel

	buildPlotContents(plotModel, slot, islandData, player)

	print("[MapService] Plot neu aufgebaut fuer:", player.Name, "| Slot:", slot)
end

function MapService.despawnIsland(player: Player)
	-- Ein noch wartender Nachhol-Waechter hat hier nichts mehr zu tun. Er
	-- merkt das zwar selbst beim naechsten Durchlauf (kein Plot mehr), aber so
	-- bleibt kein Eintrag fuer einen laengst gegangenen Spieler stehen.
	_pendingRebuild[player] = nil
	_showcase[player] = nil
	_badge[player] = nil
	_crown[player] = nil
	_terminal[player] = nil

	local model = _plotModels[player]
	if model then
		model:Destroy()
		_plotModels[player] = nil
	end

	local slot = _playerSlot[player]
	if slot then
		releaseSlot(slot)
		_playerSlot[player] = nil
	end
end

-- (v15: updatePitLevel ist entfallen — es gibt kein PIT-Level mehr. Der Turm
-- auf der Arena-Insel zeigt jetzt den Tower-Rekord, siehe updateTowerShowcase.)

-- v15: den Tower-Turm auf der Arena-Insel (neu) bauen. Aufrufer ist
-- PlotDisplayService, und nur wenn sich Look oder Rekord geaendert haben
-- (Signatur). `show` = der LOOK hat gewechselt: kurze Aufwertungs-Show (ein
-- Partikel-Stoss an der Spitze, < 2 s).
function MapService.updateTowerShowcase(player: Player, view: ArenaBuilder.ShowcaseView, show: boolean?)
	_showcase[player] = view

	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end

	local built = ArenaBuilder.buildShowcase(model, slot, view)
	if show then
		local foot = ArenaBuilder.showcaseFoot(slot)
		local height = MapConfig.TOWER_SHOWCASE.plinthHeight + view.floors * MapConfig.TOWER_SHOWCASE.floorHeight
		FigureFX.burstAt(foot + Vector3.new(0, height + 2, 0), view.color, built, 60)
	end
end

-- v15: Tower-Symbol unter dem Namen auf dem Plot-Schild ("◆ III · 42").
function MapService.setOwnerBadge(player: Player, text: string | Types.LocMsg, color: Color3)
	_badge[player] = { text = text, color = color }
	local model = _plotModels[player]
	if model then
		PlotBuilder.writeOwnerBadge(model, badgeText(player, text), color)
	end
end

-- Paket 9: Krone vor dem Plot-Symbol fuer die Top 10 der Endless-Woche.
-- Aufrufer ist LeaderboardService (kennt die Wochenliste).
function MapService.setOwnerCrown(player: Player, crowned: boolean)
	if (_crown[player] == true) == crowned then return end
	_crown[player] = if crowned then true else nil
	local badge = _badge[player]
	local model = _plotModels[player]
	if badge and model then
		PlotBuilder.writeOwnerBadge(model, badgeText(player, badge.text), badge.color)
	end
end

-- Farbe der kurzen Aufwertungs-Show beim Look-Wechsel (v15).
local LOOK_UPGRADE_COLOR = Color3.fromRGB(255, 220, 110)
local LOOK_UPGRADE_SPARKS = 40

-- v15: baut ein Gebaeude (oder den Recycler) NUR neu, wenn sich sein Look
-- geaendert hat (Attribut "Look" am Koerper gegen BuildingBehavior.getLook).
-- PlotDisplayService ruft das, wenn die Look-Signatur wechselt; Level-Aenderungen
-- innerhalb eines Looks laufen ueber das billige updateBuildingSigns.
-- `show` = kurze Aufwertungs-Show (ein Partikel-Stoss, < 2 s).
function MapService.updateBuildingLooks(player: Player, islandData: Types.IslandData, show: boolean?)
	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end

	local pool = PondBuilder.honeyPool(islandData)
	for _, building in islandData.buildings do
		local part = model:FindFirstChild(building.id)
		local look = BuildingBehavior.getLook(building.level)
		if part and part:IsA("BasePart") and part:GetAttribute("Look") ~= look then
			local position = part.Position
			part:Destroy()
			PlotBuilder.buildBuilding(model, slot, building, pool)
			if show then
				FigureFX.burstAt(position, LOOK_UPGRADE_COLOR, model, LOOK_UPGRADE_SPARKS)
			end
		end
	end

	local body = model:FindFirstChild(CombConfig.RECYCLER_NAME)
	local recyclerLook = BuildingBehavior.getLook(islandData.recycler.level)
	if body and body:IsA("BasePart") and body:GetAttribute("Look") ~= recyclerLook then
		local position = body.Position
		body:Destroy()
		RecyclerBuilder.build(model, slot, islandData.recycler)
		if show then
			FigureFX.burstAt(position, LOOK_UPGRADE_COLOR, model, LOOK_UPGRADE_SPARKS)
		end
	end
end

-- Haengt die Quelle fuer frische IslandData ein (siehe _islandDataProvider).
-- Wird einmal beim Start von PlotDisplayService aufgerufen.
function MapService.setIslandDataProvider(provider: (Player) -> Types.IslandData?)
	_islandDataProvider = provider
end

-- Wartet, bis die Figur des Spielers nicht mehr in einer Bewegung steckt, und
-- baut sie dann mit FRISCH gelesenen Daten neu.
--
-- Frisch gelesen ist der entscheidende Teil: waehrend der Bewegung koennen
-- weitere Aenderungen anfallen (mehrere Level-Ups waehrend eines Ess-Zyklus),
-- und nach einem Rebirth ist die alte IslandData-Tabelle gar nicht mehr die
-- des Spielers — sie einfach aufzuheben und spaeter nochmal zu rendern wuerde
-- einen veralteten Stand in die Welt stellen.
local function scheduleRebuildWhenFree(player: Player)
	if _pendingRebuild[player] then return end
	_pendingRebuild[player] = true

	task.spawn(function()
		local interval = MapConfig.FIGURE_REBUILD_RETRY_SECONDS
		local waited   = 0

		while waited < MapConfig.FIGURE_REBUILD_TIMEOUT_SECONDS do
			task.wait(interval)
			waited += interval

			-- Spieler weg oder Plot abgeraeumt: es gibt nichts mehr nachzuholen.
			if player.Parent == nil or _plotModels[player] == nil then
				break
			end

			if ActivityLock.isFree(player) then
				local provider = _islandDataProvider
				local island   = if provider then provider(player) else nil

				-- Vor dem erneuten Aufruf freigeben: updateBaerchis darf, falls
				-- inzwischen doch wieder eine Bewegung laeuft, sauber einen
				-- neuen Waechter starten.
				_pendingRebuild[player] = nil

				if island then
					MapService.updateBaerchis(player, island)
				end
				return
			end
		end

		_pendingRebuild[player] = nil
	end)
end

-- Baut die sichtbaren Baerchis eines Spielers NEU. Teuer — nur aufrufen wenn
-- sich der Bestand oder ein Level geaendert hat (siehe PlotDisplayService).
--
-- Steckt die Figur gerade in einer Bewegung, wird der Neuaufbau verschoben
-- statt sie mitten im Schritt zu ersetzen (Begruendung im Kopf der Datei).
function MapService.updateBaerchis(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	if not ActivityLock.isFree(player) then
		scheduleRebuildWhenFree(player)
		return
	end

	FigureBuilder.renderBaerchis(model, slot, islandData)
	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- Baut die herumliegenden Eier eines Spielers neu.
--
-- Anders als updateBaerchis KEINE ActivityLock-Pruefung: Eier bewegen sich
-- nicht und gehoeren niemandem, der sie gerade animiert. Sie duerfen deshalb
-- auch mitten in einem Kampf oder Weg zum Teich erscheinen und verschwinden —
-- genau das muss sogar sein, weil der Baerchi WAEHREND er laeuft legt.
function MapService.updateLaidEggs(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- Haengt den Ei-Einsammel-Handler ein: er laeuft, wenn der BESITZER eines
-- Plots sein eigenes gelegtes Ei mit der Spielfigur beruehrt. Wird einmal
-- beim Start von EggLayService aufgerufen (Pull-Callback statt require:
-- EggLayService requiret bereits MapService, der umgekehrte Weg waere ein
-- Ringschluss). Ohne Handler sammelt Beruehren einfach nichts ein.
function MapService.setEggCollectHandler(handler: (Player, string) -> ())
	LaidEggBuilder.setCollectHandler(handler)
end

-- Rechnet eine Weltposition in das Koordinatensystem des Plots um.
--
-- Gelegte Eier werden PLOT-RELATIV gespeichert, nicht in Weltkoordinaten. Der
-- Grund: welchen der acht Plots ein Spieler bekommt, entscheidet sich bei
-- jedem Join neu (siehe _freeSlots). Absolute Positionen wuerden nach einem
-- Rejoin auf einem anderen Plot liegen — im schlimmsten Fall auf dem eines
-- Nachbarn.
function MapService.worldToPlot(player: Player, worldPosition: Vector3): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end

	local plotCFrame = MapParts.plotCFrame(slot)
	if not plotCFrame then return nil end

	return plotCFrame:PointToObjectSpace(worldPosition)
end

-- Aktualisiert nur Beschriftung und Erschoepfung der bereits stehenden
-- Figuren. Billig — das ist der Weg fuer HP-Aenderungen.
function MapService.updateBaerchiStates(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return end

	for _, baerchi in islandData.baerchis do
		local figure = folder:FindFirstChild("Baerchi_" .. baerchi.uid)
		if figure and figure:IsA("Model") then
			FigureBuilder.writeBaerchiState(figure, baerchi, FigureBuilder.maxHpOf(baerchi))
		end
	end
end

-- Aktualisiert das Level-Attribut einer Gebaeude-Part (fuer Client-UI).
-- Wird nach einem Gebaeude-Upgrade aufgerufen; baut nichts neu.
function MapService.updateBuildingLevel(player: Player, buildingId: Types.BuildingId, level: number)
	local model = _plotModels[player]
	if not model then return end

	local part = model:FindFirstChild(buildingId)
	if part then
		part:SetAttribute("BuildingLevel", level)
	end
end

-- Wohin der Baerchi zum Fressen laeuft.
--
-- Das ist der Standplatz VOR dem Becken (auf den Bohlen), nicht mehr die
-- Beckenmitte. Bis der Teich ein richtiges Becken wurde, war beides dasselbe
-- — und der Baerchi stand mitten im Teich. Jetzt stuende er bis zum Bauch im
-- Beckenboden.
function MapService.getPondPosition(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return PondBuilder.pondStand(slot).Position
end

-- Mitte des Beckens (Weltposition) — z. B. damit gelegte Eier nicht im Honig
-- landen, seit der Baerchi am Becken wohnt (HONEY_POND_V2).
function MapService.getPondCenter(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return PondBuilder.pondGround(slot).Position
end

-- Fuellstand des Teichs nachziehen. Billig — das ist der Weg fuer
-- Honig-Aenderungen (siehe MapService.updateBuildingSigns, das das mit
-- aufruft, weil beides an denselben Werten haengt).
function MapService.updatePondFill(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	local pond = model:FindFirstChild("Pond")
	if not pond then return end

	local fill = pond:FindFirstChild("Fuellung")
	if fill and fill:IsA("BasePart") then
		PondBuilder.writePondFill(fill, PondBuilder.pondGround(slot), PondBuilder.pondFillRatio(islandData))
	end
end

-- Schreibt Level und Honig-Lagerstand auf die Gebaeude-Schilder.
-- Billig — das ist der Weg fuer Honig-Aenderungen.
function MapService.updateBuildingSigns(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local pool = PondBuilder.honeyPool(islandData)

	for _, building in islandData.buildings do
		local part = model:FindFirstChild(building.id)
		if part and part:IsA("BasePart") then
			part:SetAttribute("BuildingLevel", building.level)
			PlotBuilder.writeBuildingState(part, building, pool)
		end
	end

	-- Haengt an denselben Werten wie die Gebaeude-Schilder — deshalb hier
	-- gleich mit erledigt statt eines eigenen Aufrufers in PlotDisplayService.
	MapService.updatePondFill(player, islandData)
end

-- Sammel-Update Paket 8: Inkubator-Stand schreiben (Eier, Zeitmarken,
-- verfuegbare Plaetze). Billig; fehlt das Modell, wird es gebaut.
function MapService.updateIncubator(player: Player, islandData: Types.IslandData, slotCount: number)
	if not FeatureFlags.isOn("INCUBATOR") or not islandData.incubator then return end
	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end
	local existing = model:FindFirstChild(IncubatorConfig.MODEL_NAME)
	if existing and existing:IsA("Model") then
		IncubatorBuilder.writeState(existing, islandData.incubator, slotCount, islandData.baerchis)
	else
		IncubatorBuilder.build(model, slot, islandData.incubator, slotCount, islandData.baerchis)
	end
end

-- INCUBATOR_BREED: das Inkubator-Modell auf dem Plot des Spielers (Ort der
-- gebrueteten Eier), oder nil.
function MapService.getIncubatorModel(player: Player): Model?
	local model = _plotModels[player]
	local found = if model then model:FindFirstChild(IncubatorConfig.MODEL_NAME) else nil
	return if found and found:IsA("Model") then found else nil
end

-- Liefert die Platz-Zahl des Inkubators (setzt PlotDisplayService, weil sie
-- auch an Rebirths und Index-Belohnungen haengt).
function MapService.setIncubatorSlotProvider(provider: (Player) -> number)
	_incubatorSlots = provider
end

-- 08.10.: Zustand des Tower-Terminals (Attribute, kein Neubau). Aufrufer ist
-- PlotDisplayService bei geaenderter Signatur.
function MapService.updateTerminal(player: Player, view: TerminalBuilder.TerminalView)
	_terminal[player] = view
	local model = _plotModels[player]
	local terminal = if model then model:FindFirstChild(TerminalBuilder.MODEL_NAME) else nil
	if terminal and terminal:IsA("Model") then
		TerminalBuilder.writeState(terminal, view)
	end
end

-- Schreibt Level, Warteschlange und Lampe des Waben-Recyclers neu.
-- Billig — der Weg fuer jede Aenderung der Warteschlange.
function MapService.updateRecycler(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local body = model:FindFirstChild(CombConfig.RECYCLER_NAME)
	if body and body:IsA("BasePart") then
		RecyclerBuilder.writeState(body, islandData.recycler)
	end
end

-- Die Anzeigetafel ueber der Arena. Bewusst ueber den exakten Pfad gesucht und
-- nicht rekursiv: unter dem Plot haengen bis zu 25 importierte Mesh-Figuren,
-- deren Teilenamen aus einer .glb stammen und die wir nicht kontrollieren.
-- Eine rekursive Suche wuerde bei einem gleichnamigen Teil das Falsche finden
-- — und muesste bei jeder der bis zu 60 Stages den ganzen Baum durchlaufen.
local function findPitBanner(player: Player): BillboardGui?
	local model = _plotModels[player]
	if not model then return nil end

	local platform = model:FindFirstChild("PitPlatform")
	if not platform then return nil end

	local anchor = platform:FindFirstChild("PitBannerAnchor")
	if not anchor then return nil end

	local banner = anchor:FindFirstChild("Banner")
	return if banner and banner:IsA("BillboardGui") then banner else nil
end

-- Die Anzeigetafel ueber der Arena beschriften und einblenden.
-- Aufgerufen von PitArenaService waehrend einer Wiedergabe; MapService kennt
-- den Kampfverlauf nicht und entscheidet deshalb nichts ueber den Inhalt.
-- Titel und Untertitel duerfen Nachrichten (LocMsg) sein: die Tafel sieht
-- jeder Spieler, und jeder liest sie in seiner Sprache (siehe WorldText).
function MapService.setPitBanner(player: Player, title: string | Types.LocMsg, subtitle: string | Types.LocMsg, color: Color3)
	local banner = findPitBanner(player)
	if not banner then return end

	local titleLabel = banner:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		WorldText.set(titleLabel, title)
		titleLabel.TextColor3 = color
	end

	local subLabel = banner:FindFirstChild("Sub")
	if subLabel and subLabel:IsA("TextLabel") then
		WorldText.set(subLabel, subtitle)
	end

	banner.Enabled = true
end

-- Tafel wieder ausblenden. Idempotent — ein zweiter Aufruf schadet nicht.
function MapService.clearPitBanner(player: Player)
	local banner = findPitBanner(player)
	if banner then
		banner.Enabled = false
	end
end

--------------------------------------------------------------------------------
-- Event-Pit: Farbe und Anzeigetafel von aussen setzbar (EventService)
--------------------------------------------------------------------------------

-- Anders als findPitBanner gibt es das Event-Pit nur EINMAL fuer die ganze
-- Welt, nicht pro Spieler — keine Player-Suche noetig.
local function findEventPitContainer(): Model?
	local platform = workspace:FindFirstChild("Platform")
	if not platform then return nil end

	local pit = platform:FindFirstChild("EventPit")
	return if pit and pit:IsA("Model") then pit else nil
end

export type EventTheme = {
	floorColor : Color3,
	fenceColor : Color3,
	ringColor  : Color3,
}

-- Faerbt Boden, Zaun und Ring des Event-Pits um. Mit `theme = nil` kehrt es
-- zum schlichten Stall-Look zurueck (siehe MapConfig, EVENT_PIT_DEFAULT_*).
-- EventService ruft das genau zweimal pro Zyklus: einmal beim Start eines
-- Events mit dessen Farben, einmal beim Ende mit nil.
function MapService.setEventPitTheme(theme: EventTheme?)
	local container = findEventPitContainer()
	if not container then return end

	local floorColor = if theme then theme.floorColor else MapConfig.EVENT_PIT_DEFAULT_FLOOR_COLOR
	local fenceColor = if theme then theme.fenceColor else MapConfig.EVENT_PIT_DEFAULT_FENCE_COLOR
	local ringColor  = if theme then theme.ringColor  else MapConfig.EVENT_PIT_DEFAULT_RING_COLOR

	-- Material wechselt mit: Wood/SmoothPlastic im Stall-Look, Neon waehrend
	-- eines Events — sonst saehe man den Farbwechsel bei Zaun und Ring kaum,
	-- weil beide im Stall-Look bewusst matt sind.
	local activeMaterial = if theme then Enum.Material.Neon else Enum.Material.Wood
	local ringMaterial   = if theme then Enum.Material.Neon else Enum.Material.SmoothPlastic

	local floor = container:FindFirstChild("EventFloor")
	if floor and floor:IsA("BasePart") then
		floor.Color = floorColor
	end

	local ring = container:FindFirstChild("EventRing")
	if ring and ring:IsA("BasePart") then
		ring.Color    = ringColor
		ring.Material = ringMaterial
	end

	for _, child in container:GetChildren() do
		if child.Name:match("^EventFence_") and child:IsA("BasePart") then
			child.Color    = fenceColor
			child.Material = activeMaterial
		end
	end
end

-- Beschriftet die Countdown-Tafel ueber dem Event-Pit. Anders als
-- setPitBanner blendet das hier NICHT ein/aus — die Tafel steht permanent
-- (siehe buildEventPit): sie zeigt entweder den Countdown bis zum naechsten
-- Event oder Name + Restzeit des laufenden.
function MapService.setEventBanner(title: string | Types.LocMsg, subtitle: string | Types.LocMsg, color: Color3, reward: (string | Types.LocMsg)?)
	local container = findEventPitContainer()
	if not container then return end

	local anchor = container:FindFirstChild("EventBannerAnchor")
	if not anchor then return end

	local banner = anchor:FindFirstChild("Banner")
	if not (banner and banner:IsA("BillboardGui")) then return end

	local titleLabel = banner:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		WorldText.set(titleLabel, title)
		titleLabel.TextColor3 = color
	end

	local subLabel = banner:FindFirstChild("Sub")
	if subLabel and subLabel:IsA("TextLabel") then
		WorldText.set(subLabel, subtitle)
	end

	local rewardLabel = banner:FindFirstChild("Reward")
	if rewardLabel and rewardLabel:IsA("TextLabel") then
		WorldText.set(rewardLabel, reward or "")
	end
end

-- Weltposition der PODEST-OBERFLAECHE des Event-Pits in der Weltmitte.
--
-- Anders als getPitPosition NICHT pro Spieler: das Event-Pit gibt es einmal
-- fuer die ganze Welt (siehe findEventPitContainer). EventParticipationService
-- laesst die Figuren aller teilnehmenden Spieler auf dieselbe Flaeche laufen.
--
-- Der Y-Wert ist dieselbe Rechnung wie in buildEventPit (`floorY`), bewusst
-- aus MapConfig neu gerechnet statt aus der gebauten Geometrie gemessen: die
-- Zahl gehoert der Konfiguration, nicht dem Modell.
function MapService.getEventPitPosition(): Vector3
	local center = MapConfig.CENTER
	local floorY = MapConfig.PLATFORM_TOP_Y
		+ MapConfig.EVENT_PIT_GROUND_CLEARANCE
		+ MapConfig.EVENT_PIT_FLOOR_HEIGHT

	return Vector3.new(center.X, floorY, center.Z)
end

-- Radius der begehbaren Event-Flaeche. EventParticipationService prueft damit
-- serverseitig nach, ob eine Figur tatsaechlich noch dort steht, statt sich auf
-- ein gesetztes Flag zu verlassen.
function MapService.getEventPitRadius(): number
	return MapConfig.EVENT_PIT_RADIUS
end

-- Weltposition der Kampfflaeche dieses Spielers.
-- Wird von PitArenaService benoetigt um die Kaempfer zu platzieren.
function MapService.getPitPosition(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return MapParts.pitCenter(slot)
end

-- Das CFrame des Plots (Blickrichtung zur Plattform-Mitte).
-- PitArenaService braucht es, um die Kaempfer sinnvoll auszurichten.
function MapService.getPlotCFrame(player: Player): CFrame?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return MapParts.plotCFrame(slot)
end

-- Die stehende Figur eines Baerchis auf dem Plot, falls vorhanden.
-- PitArenaService schickt genau diese Figur in die Arena und wieder zurueck,
-- statt eine zweite Kopie zu bauen — sonst staende derselbe Baerchi doppelt
-- in der Welt.
function MapService.getBaerchiModel(player: Player, baerchiUid: string): Model?
	local model = _plotModels[player]
	if not model then return nil end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return nil end

	local figure = folder:FindFirstChild("Baerchi_" .. baerchiUid)
	if figure and figure:IsA("Model") then
		return figure
	end
	return nil
end

-- Feiert ein Ereignis (Level-Up, Promotion, Rebirth, ...) SICHTBAR auf dem
-- Plot: Partikel-Stoss, Huepfer, kurzes Aufleuchten (siehe FigureFX.celebrate).
--
-- Bewusst als eigene MapService-Funktion und nicht direkt FigureFX.celebrate
-- vom Aufrufer: der Aufrufer (HoneyService, PromotionService, RebirthService,
-- ...) soll keine Modelle aus der Welt heraussuchen muessen — genau wie bei
-- getBaerchiModel bleibt das MapServices Job. Steht die Figur gerade nicht in
-- der Welt (Plot noch nicht gebaut, Bewegung verzoegert den Neuaufbau), passiert
-- einfach nichts — kein Fehler, der Toast-Text kommt ja trotzdem an.
function MapService.celebrateBaerchi(player: Player, baerchiUid: string, color: Color3)
	local model = MapService.getBaerchiModel(player, baerchiUid)
	if not model then return end

	FigureFX.celebrate(model, color)
end

-- Beschriftung und Transparenz einer Figur mit einem AUSDRUECKLICH
-- angegebenen HP-Wert setzen — auch waehrend eines laufenden PIT-Kampfes.
--
-- Nur fuer PitArenaService: der muss die Figur beim Start der Wiedergabe auf
-- die HP zuruecksetzen, mit denen der Lauf BEGONNEN hat. Die gespeicherten HP
-- stehen zu dem Zeitpunkt laengst auf dem Endwert, der Baerchi saehe sonst
-- schon vor dem ersten Schlag erschoepft aus.
function MapService.setFigureState(model: Model, hp: number, maxHp: number)
	FigureBuilder.writeFigureState(model, hp, maxHp)
end

-- Der Ordner in der Arena, in den die Kampf-Figuren gehoeren.
function MapService.getFighterFolder(player: Player): Folder?
	local model = _plotModels[player]
	if not model then return nil end

	local pit = model:FindFirstChild("PitPlatform")
	if not pit then return nil end

	local fighters = pit:FindFirstChild("Fighters")
	if fighters and fighters:IsA("Folder") then
		return fighters
	end
	return nil
end

-- Baut den PIT-Turm auf genau `level` Etagen aus bzw. ab — idempotent: fehlt
-- eine Etage, wird sie ergaenzt; ist eine zu viel da, wird sie entfernt. Mit
-- `level = 0` verschwindet der Turm komplett.
--
-- PitArenaService ruft das bei jeder Stage mit der neuen Stufenzahl auf, und
-- mit 0 sobald ein Lauf zu Ende ist oder ein neuer beginnt — der Turm bleibt
-- also NIE zwischen zwei Laeufen stehen, genau wie die Kampf-Figuren selbst
-- (siehe clearFighters in PitArenaService).
--
-- Bewegt bei einem Aufbau auch die Anzeigetafel-Verankerung mit nach oben,
-- damit sie ueber dem gewachsenen Turm haengen bleibt statt mittendrin zu
-- stecken.
function MapService.setPitTowerLevel(player: Player, level: number)
	local slot  = _playerSlot[player]
	local model = _plotModels[player]
	if not slot or not model then return end

	local container = model:FindFirstChild("PitPlatform")
	if not container then return end

	local tower = container:FindFirstChild("Tower")
	if not (tower and tower:IsA("Folder")) then return end

	local wanted = math.max(0, math.floor(level))
	local center = MapParts.pitCenter(slot)

	for _, child in tower:GetChildren() do
		local index = tonumber(child.Name:match("^Ring_(%d+)$"))
		if not index or index > wanted then
			child:Destroy()
		end
	end

	for i = 1, wanted do
		if not tower:FindFirstChild("Ring_" .. i) then
			ArenaBuilder.buildTowerRing(tower, center, i)
		end
	end

	local anchor = container:FindFirstChild("PitBannerAnchor")
	if anchor and anchor:IsA("BasePart") then
		local topY = MapConfig.PLATFORM_TOP_Y
			+ wanted * MapConfig.PIT_TOWER_STEP_HEIGHT
			+ MapConfig.PIT_BANNER_HEIGHT
		anchor.CFrame = CFrame.new(center.X, topY, center.Z)
	end
end

-- Hoehe (Y ueber PLATFORM_TOP_Y) der Kampfflaeche bei `level` bereits
-- gewachsenen Etagen. PitArenaService braucht das, um die Kaempfer beim
-- Erklimmen jeder Stage auf die richtige Hoehe zu stellen — dieselbe Formel
-- wie in buildTowerRing, hier aber ohne selbst eine Etage zu bauen.
function MapService.getPitTowerFloorY(level: number): number
	return MapConfig.PLATFORM_TOP_Y + math.max(0, level) * MapConfig.PIT_TOWER_STEP_HEIGHT
end

-- v15: die Bestenlisten-Tafel(n) beschriften (Titel + bis zu
-- LEADERBOARD_BOARD.lines Zeilen). Aufrufer ist LeaderboardService.
-- HBB Paket 5: eine Tafel je Liste; Schluessel = listId, "_rotating" = die
-- eine wechselnde Tafel ohne MAP_V2_BOARDS.
local ROTATING = "_rotating"
local _leaderboardBoards: { [string]: BasePart } = {}
local _liveBoard: BasePart? = nil
local _waspNest: Model? = nil

local function writeBoard(board: BasePart?, title: string, lines: { string }, lineCount: number, titleColor: Color3?)
	if not board then return end
	local surface = board:FindFirstChild("Board")
	if not surface then return end

	local titleLabel = surface:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		titleLabel.Text = title
		if titleColor then titleLabel.TextColor3 = titleColor end
	end
	for i = 1, lineCount do
		local line = surface:FindFirstChild("Line" .. i)
		if line and line:IsA("TextLabel") then
			line.Text = lines[i] or ""
		end
	end
end

-- Gibt es eine feste Tafel fuer `listId`? (sonst: wechselnde Tafel)
function MapService.hasLeaderboardBoard(listId: string): boolean
	return _leaderboardBoards[listId] ~= nil
end

function MapService.writeLeaderboardBoard(title: string, lines: { string }, listId: string?)
	local board = (if listId then _leaderboardBoards[listId] else nil) or _leaderboardBoards[ROTATING]
	writeBoard(board, title, lines, MapConfig.LEADERBOARD_BOARD.lines)
end

-- HBB Paket 6: Live-Kampf-Board beschriften. Aufrufer ist LiveBoardService.
function MapService.writeLiveBoard(title: string, lines: { string }, live: boolean)
	local cfg = MapConfig.LIVE_BOARD
	writeBoard(_liveBoard, title, lines, cfg.lines, if live then cfg.liveColor else cfg.textColor)
end

-- HBB Paket 6: Schild und Leuchten des Wespen-Nests. Aufrufer ist EventService.
function MapService.setWaspNest(text: string, glowing: boolean)
	local nest = _waspNest
	if not nest then return end
	local cfg = MapConfig.WASP_NEST
	local body = nest:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		body.Material = if glowing then Enum.Material.Neon else Enum.Material.Sand
		body.Color    = if glowing then cfg.glowColor else cfg.color
	end
	local anchor = nest:FindFirstChild("SignAnchor")
	local sign = if anchor then anchor:FindFirstChild("Sign") else nil
	local title = if sign then sign:FindFirstChild("Title") else nil
	if title and title:IsA("TextLabel") then
		title.Text = text
	end
end

-- v15: Teile auf der Insel eines Spielers zaehlen (Debug-Befehl "parts",
-- Budget <= 250 pro Insel ohne Baerchi-Mesh). Getrennt nach Bereichen, damit man
-- sieht, wo das Budget hingeht. Die Figuren (importierte Meshes) zaehlen extra.
function MapService.countParts(player: Player): { [string]: number }?
	local model = _plotModels[player]
	if not model then return nil end

	local result: { [string]: number } = { total = 0, figures = 0 }
	for _, child in model:GetChildren() do
		local count = if child:IsA("BasePart") then 1 else 0
		for _, descendant in child:GetDescendants() do
			if descendant:IsA("BasePart") then count += 1 end
		end
		local key = child.Name
		if key == "Baerchis" then
			result.figures += count
		else
			result[key] = (result[key] or 0) + count
			result.total += count
		end
	end
	return result
end

function MapService.init()
	-- Freie Slots einmalig aufbauen
	for slot = 1, MapConfig.PLOT_COUNT do
		table.insert(_freeSlots, slot)
	end

	-- ============================================================
	-- GEOMETRIE-PRUEFUNG
	-- ============================================================
	-- Die Weltgeometrie haengt an einem guten Dutzend Zahlen, die voneinander
	-- abhaengen. Faellt eine aus dem Rahmen, sieht man das im fertigen Spiel als
	-- Loch im Boden oder als Insel im Nichts — und sucht dann im Code statt in
	-- der Config. Diese vier Pruefungen sagen es beim Start, im Klartext.
	--
	-- Sie WARNEN nur und brechen nicht ab: eine Welt mit einer schiefen Zahl ist
	-- immer noch spielbar, und ein harter Abbruch beim Serverstart waere die
	-- schlechtere Rueckmeldung.

	-- 1. Passt das quadratische Beet auf die runde Plot-Insel? Entscheidend ist
	--    die ECKE, nicht die Kante — eine halbe Diagonale, nicht eine halbe Seite.
	local plateCorner = math.sqrt(
		(MapConfig.PLOT_SIZE.X * 0.5) ^ 2 + (MapConfig.PLOT_SIZE.Z * 0.5) ^ 2
	)
	if plateCorner > MapConfig.PLOT_ISLAND_RADIUS then
		warn(
			"[MapService] Das Beet ragt ueber die Plot-Insel:",
			"halbe Diagonale von PLOT_SIZE =", string.format("%.1f", plateCorner),
			"> PLOT_ISLAND_RADIUS =", MapConfig.PLOT_ISLAND_RADIUS
		)
	end

	-- 2. Liegt der Plot-Ring wirklich eine Steglaenge vor der Hauptinsel?
	--    Sonst waere der Steg entweder zu kurz (Luecke) oder zu lang (er endet
	--    auf der Insel).
	local expectedRing = MapConfig.PLATFORM_RADIUS + MapConfig.ISLAND_GAP + MapConfig.PLOT_ISLAND_RADIUS
	if math.abs(MapConfig.PLOT_RING_RADIUS - expectedRing) > 0.5 then
		warn(
			"[MapService] PLOT_RING_RADIUS passt nicht zur Luecke:",
			MapConfig.PLOT_RING_RADIUS, "sollte", expectedRing, "sein",
			"(PLATFORM_RADIUS + ISLAND_GAP + PLOT_ISLAND_RADIUS)"
		)
	end

	-- 3. Beruehren sich zwei benachbarte Plot-Inseln samt Sandkante?
	local shoreRadius = MapConfig.PLOT_ISLAND_RADIUS + MapConfig.SHORE_WIDTH
	local neighbourGap = 2 * MapConfig.PLOT_RING_RADIUS
		* math.sin(math.pi / MapConfig.PLOT_COUNT) - 2 * shoreRadius
	if neighbourGap <= 0 then
		warn(
			"[MapService] Die Plot-Inseln ueberlappen sich:",
			MapConfig.PLOT_COUNT, "Inseln mit Rand", shoreRadius,
			"auf Ring", MapConfig.PLOT_RING_RADIUS
		)
	end

	-- 4. Reicht das Wasser bis hinter die aeusserste Arena?
	local worldEdge = (MapParts.pitCenter(1) - MapConfig.CENTER).Magnitude
		+ MapConfig.PIT_BASE_RADIUS + MapConfig.SHORE_WIDTH
	if worldEdge > MapConfig.WATER_RADIUS then
		warn(
			"[MapService] Die Arenen ragen ueber den Wasserrand:",
			"Weltrand =", string.format("%.0f", worldEdge),
			"> WATER_RADIUS =", MapConfig.WATER_RADIUS
		)
	end

	WorldBuilder.buildPlatform()
	WorldBuilder.buildGlobalLighting()

	-- v15: Bestenlisten-Tafel(n) (LeaderboardService beschriftet sie).
	-- HBB Paket 5/6: Positionen aus MapLayout (dort auch der Layout-Test).
	local platform = workspace:FindFirstChild("Platform") or workspace
	for _, b in MapLayout.leaderboardBoards() do
		local listId = b.listId
		local name = if listId then "LeaderboardBoard_" .. listId else "LeaderboardBoard"
		_leaderboardBoards[listId or ROTATING] = WorldBuilder.buildLeaderboardBoard(platform, b.angleDegrees, name)
	end
	if FeatureFlags.isOn("MAP_V2_LIVE_BOARD") then
		_liveBoard = WorldBuilder.buildLiveBoard(platform)
	end
	if FeatureFlags.isOn("MAP_V2_WASP_NEST") then
		_waspNest = WorldBuilder.buildWaspNest(platform, MapLayout.waspNestCenter())
	end

	-- Sicherheitsnetz: falls PlayerService den Leave-Fall mal verpasst,
	-- bleibt sonst ein Slot dauerhaft belegt.
	Players.PlayerRemoving:Connect(function(player)
		if _playerSlot[player] then
			MapService.despawnIsland(player)
		end
	end)

	print("[MapService] Initialisiert | Plots:", MapConfig.PLOT_COUNT)
end

return MapService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX30"><Properties>
<string name="Name">PlotDisplayService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PlotDisplayService.luau
-- ServerScriptService/Services/PlotDisplayService.luau
--
-- Einzige Zustaendigkeit:
--   - Entscheiden WANN die sichtbare Darstellung eines Plots nachgezogen
--     werden muss — und mit welchem der drei unterschiedlich teuren Wege.
--
-- Haengt an PlayerService.onDataChanged. Das feuert bei JEDER Aenderung, also
-- auch bei jedem einzelnen Gummy. Alles jedes Mal neu zu bauen waere
-- Verschwendung, deshalb merkt sich dieser Service drei Signaturen und
-- vergleicht sie:
--
--   STRUKTUR   (uid + Level jedes Baerchis)
--       → MapService.updateBaerchis: baut alle Mesh-Figuren neu. Teuer.
--         Noetig wenn ein Baerchi dazukommt, wegfaellt oder im Level steigt.
--
--   ZUSTAND    (uid + aktuelle HP)
--       → MapService.updateBaerchiStates: schreibt nur Beschriftung und
--         Erschoepfung an bestehende Figuren. Billig. HP aendern sich bei
--         jedem Fuettern und jedem PIT-Lauf — dafuer 25 Meshes neu zu bauen
--         waere absurd.
--
--   GEBAEUDE   (id + Level + Honig)
--       → MapService.updateBuildingSigns: schreibt die Schilder neu. Billig.
--         Honig aendert sich alle 20 Sekunden.
--
--   EIER       (uids der herumliegenden Eier)
--       → MapService.updateLaidEggs: baut die kleinen Kugeln neu. Billig —
--         es sind hoechstens zwoelf, und sie sind keine Meshes.
--         Aendert sich, wenn der Baerchi eines legt oder der Spieler eines
--         aufsammelt.
--
--   RECYCLER   (Level + Warteschlange des Waben-Recyclers)
--       → MapService.updateRecycler: schreibt Schild und Lampe. Billig.
--         Aendert sich jede Sekunde, solange der Recycler arbeitet.
--
--   LOOKS      (v15: Look-Stufe jedes Gebaeudes und des Recyclers)
--       → MapService.updateBuildingLooks: baut genau das Gebaeude neu, dessen
--         Look sich geaendert hat, mit kurzer Aufwertungs-Show. Haengt am
--         LOOK, nicht am Level — ein Ausbau innerhalb eines Looks schreibt nur
--         das Schild (GEBAEUDE oben).
--
--   STUFE      (Welt aufwerten, Paket D: Insel-Stufe 1..4 aus Towern und
--               Rebirths, Modules/IslandStage)
--       → Attribut "IslandStage" am Player (ueberlebt jeden Insel-Neuaufbau).
--         Die Deko baut nur der Client (PlotLifeController), der Server baut
--         dafuer kein einziges Teil.
--
--   TOWER      (v15: Look + Etagen + Schildtext des Tower-Turms)
--       → MapService.updateTowerShowcase (Neuaufbau des Turms, Show nur beim
--         Look-Wechsel) und MapService.setOwnerBadge (Symbol am Plot-Schild).
--         Aendert sich nur bei einem neuen Rekord oder Tower.
--
--   TERMINAL   (08.10.: Zustand, gewaehlter Tower, Rekord, Fortschritt)
--      → MapService.updateTerminal: schreibt nur Attribute, kein Neubau.
--
-- Die Figuren und Schilder selbst baut MapService — dieser Service entscheidet
-- nur WANN und WELCHE Tiefe.
--
-- EINE SACHE ENTSCHEIDET DIESER SERVICE BEWUSST NICHT: ob die Figur gerade
-- mitten in einer Bewegung steckt. Diese Sperre sitzt in
-- MapService.updateBaerchis selbst, damit sie fuer JEDEN Aufrufer gilt und
-- nicht an jeder Aufrufstelle wiederholt werden muss. Hier unten wird nur die
-- Quelle fuer frische Daten eingehaengt, mit der MapService den verschobenen
-- Neuaufbau spaeter nachholt (siehe init).
--
-- Wichtig fuer das Verstaendnis des Signatur-Vergleichs: eine verschobene
-- Darstellung gilt hier trotzdem sofort als "dargestellt". Das ist richtig, so
-- lange MapService das Nachholen uebernimmt — waere es andersherum, muesste
-- dieser Service den Zustand einer fremden Warteschlange mitverfolgen.
--
-- Ersetzt den frueheren BaerchiDisplayService, der nur die Figuren kannte und
-- inzwischen aus dem Projekt entfernt ist.

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local IncubatorRules = require(ReplicatedStorage.Modules.IncubatorRules)   -- Paket 8
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local IslandStage      = require(ReplicatedStorage.Modules.IslandStage)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)

local PlotDisplayService = {}

type Signatures = {
	incubator : string,   -- Sammel-Update Paket 8
	structure : string,
	state     : string,
	buildings : string,
	eggs      : string,
	recycler  : string,
	looks     : string,
	tower     : string,
	stage     : string,
	terminal  : string,   -- 08.10. Tower-Terminal
}

local _signatures: { [Player]: Signatures } = {}

--------------------------------------------------------------------------------
-- Signaturen
--------------------------------------------------------------------------------

-- Was sich aendern muss, damit die Figur neu gebaut wird: welche Baerchis es
-- gibt, auf welchem Level sie stehen (das Level aendert die Groesse der
-- Beschriftung und kann spaeter das Modell aendern) — UND wer gerade
-- ausgeruestet ist, seit nur noch dieser eine sichtbar gebaut wird. Ohne
-- equippedUid hier wuerde ein Equip-Wechsel auf einen gleich hochstufigen
-- Baerchi denselben String ergeben und die Signatur haelt die Aenderung
-- faelschlich fuer bereits dargestellt.
--
-- Die MUTATION gehoert aus demselben Grund dazu: sie bestimmt Fellfarbe, Aura
-- und das Kuerzel auf dem Namensschild (siehe MapService.buildBaerchiFigure).
-- Normalerweise aendert sie sich nie nach dem Schluepfen — der Mutations-Sturm
-- (EventParticipationService) kann sie aber mitten im Spiel anheben, und ohne
-- diesen Eintrag liefe die Figur bis zum naechsten Insel-Neuaufbau in der
-- alten Farbe weiter.
local function structureSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, string.format("%s:%d:%s:%s", uid, baerchi.level, baerchi.mutation or "-", baerchi.rarity))
	end
	table.sort(parts)
	table.insert(parts, "equipped:" .. (data.island.equippedUid or ""))
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Beschriftung neu geschrieben wird.
local function stateSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, uid .. ":" .. baerchi.currentHp)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Gebaeude-Schilder neu geschrieben werden.
local function buildingSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d:%d", id, building.level, building.honey or 0))
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Eier neu gebaut werden: WELCHE Eier
-- herumliegen. Die Position gehoert bewusst nicht dazu — ein gelegtes Ei
-- bewegt sich nie, es kommt nur dazu oder verschwindet.
local function eggSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for _, egg in data.island.laidEggs or {} do
		table.insert(parts, egg.uid)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit Schild und Lampe des Waben-Recyclers neu
-- geschrieben werden: Level und Warteschlange.
local function recyclerSignature(data: Types.PlayerData): string
	local recycler = data.island.recycler
	return string.format("%d:%d", recycler.level, recycler.queued)
end

-- v15: Look-Stufen. Bewusst NICHT das Level: ein Gebaeude wird nur neu
-- gebaut, wenn es einen neuen Look bekommt (README 4.2).
local function lookSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d", id, BuildingBehavior.getLook(building.level)))
	end
	table.sort(parts)
	table.insert(parts, "Recycler:" .. BuildingBehavior.getLook(data.island.recycler.level))
	return table.concat(parts, "|")
end

-- v15: Tower-Turm: hoechster Tower (Look) und Rekord darin (Etagen + Schild).
local function towerSignature(data: Types.PlayerData): string
	local towerId, record = TowerConfig.bestRecord(data.towers)
	local highest = data.towers.highestTower
	if TowerConfig.getIndex(highest) > TowerConfig.getIndex(towerId) then
		towerId, record = highest, data.towers.records[highest] or 0
	end
	return string.format("%s:%d", towerId, record)
end

-- Sammel-Update Paket 8: Inkubator — belegte Plaetze (Ei + Zeitmarken),
-- Level und Platz-Zahl. Fortschritt rechnet der Client selbst.
local function incubatorSignature(data: Types.PlayerData): string
	local incubator = data.island.incubator
	if not incubator then return "" end
	local parts: { string } = { tostring(incubator.level), tostring(IncubatorRules.slotCountFor(data)) }
	for _, entry in incubator.slots do
		table.insert(parts, string.format("%d=%s@%d", entry.slot, entry.eggType, entry.finishAt))
	end
	-- INCUBATOR_BREED: Baerchis in den Plaetzen (Figur, Takt, letzte Brut)
	for _, entry in incubator.breeders or {} do
		local baerchi = data.island.baerchis[entry.uid]
		table.insert(parts, string.format("b%d=%s:%s:%s@%d", entry.slot, entry.uid,
			if baerchi then baerchi.rarity else "?", if baerchi then tostring(baerchi.mutation) else "",
			entry.lastEggAt))
	end
	return table.concat(parts, "|")
end

-- Paket D: Stufe der Insel-Deko
local function stageSignature(data: Types.PlayerData): string
	return tostring(IslandStage.compute(data.towers and data.towers.records, data.rebirthCount or 0))
end

-- 08.10.: Tower-Terminal — Zustand, gewaehlter Tower, Rekord, Fortschritt.
local function terminalView(data: Types.PlayerData): { state: string, tower: string, record: number, nextTower: string, newTower: string, progress: number, needed: number }
	local towers = data.towers
	local nextTower, newTower = "", ""
	for _, def in TowerConfig.TOWERS do
		if newTower == "" and TowerConfig.isNew(def.id, towers) then
			newTower = def.id
		end
		if nextTower == "" and not TowerConfig.isUnlockedByClear(def.id, towers.records, towers.unlocked) then
			nextTower = def.id
		end
	end
	local _, progress, needed = TowerConfig.getUnlockProgress(nextTower, towers.records)
	return {
		state     = TowerConfig.terminalState(towers),
		tower     = towers.selected,
		record    = towers.records[towers.selected] or 0,
		nextTower = nextTower,
		newTower  = newTower,
		progress  = progress,
		needed    = needed,
	}
end

local function terminalSignature(data: Types.PlayerData): string
	local v = terminalView(data)
	return string.format("%s|%s|%d|%s|%s|%d|%d", v.state, v.tower, v.record, v.nextTower, v.newTower, v.progress, v.needed)
end

local function allSignatures(data: Types.PlayerData): Signatures
	return {
		terminal  = terminalSignature(data),
		incubator = incubatorSignature(data),
		structure = structureSignature(data),
		state     = stateSignature(data),
		buildings = buildingSignature(data),
		eggs      = eggSignature(data),
		recycler  = recyclerSignature(data),
		looks     = lookSignature(data),
		tower     = towerSignature(data),
		stage     = stageSignature(data),
	}
end

-- Turm und Plot-Symbol aus dem Tower-Stand (Signatur "Tower:Rekord").
local function applyTower(player: Player, signature: string, show: boolean)
	local towerId, recordText = string.match(signature, "^([^:]+):(%d+)$")
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	local record = tonumber(recordText) or 0

	MapService.updateTowerShowcase(player, {
		look   = def.look,
		floors = TowerConfig.getShowcaseFloors(def.id, record),
		title  = Loc.msg("ui.world.showcase_title", {
			name = player.DisplayName, tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record,
		}),
		color  = def.color,
	}, show)
	MapService.setOwnerBadge(player, Loc.msg("ui.world.owner_badge", {
		tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record,
	}), def.color)
end

--------------------------------------------------------------------------------
-- Abgleich
--------------------------------------------------------------------------------

local function refresh(player: Player, data: Types.PlayerData)
	local current  = allSignatures(data)
	local previous = _signatures[player]

	if not previous then
		-- Noch keine Signatur (sollte nach onDataLoaded nicht vorkommen):
		-- einmal komplett nachziehen und merken.
		_signatures[player] = current
		MapService.updateBaerchis(player, data.island)
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		return
	end

	if previous.structure ~= current.structure then
		-- Neuaufbau schreibt die Zustaende gleich mit — ein zusaetzliches
		-- updateBaerchiStates waere doppelte Arbeit.
		MapService.updateBaerchis(player, data.island)

	elseif previous.state ~= current.state then
		MapService.updateBaerchiStates(player, data.island)
	end

	if previous.buildings ~= current.buildings then
		MapService.updateBuildingSigns(player, data.island)
	end

	-- Bewusst UNABHAENGIG vom Struktur-Zweig oben: updateBaerchis baut die Eier
	-- zwar mit, kann aber wegen einer laufenden Bewegung verschoben worden sein
	-- (ActivityLock). Genau dann legt der Baerchi aber weiter — und ein frisch
	-- gelegtes Ei soll nicht darauf warten, dass er ankommt.
	if previous.eggs ~= current.eggs then
		MapService.updateLaidEggs(player, data.island)
	end

	if previous.recycler ~= current.recycler then
		MapService.updateRecycler(player, data.island)
	end

	if previous.incubator ~= current.incubator then
		MapService.updateIncubator(player, data.island, IncubatorRules.slotCountFor(data))
	end

	-- v15: neuer Look -> genau dieses Gebaeude neu bauen (mit Show). Nach einem
	-- Rebirth faellt der Look zurueck; rebuildIsland hat die Insel dann schon
	-- komplett neu gebaut, updateBuildingLooks findet nichts mehr zu tun.
	if previous.looks ~= current.looks then
		MapService.updateBuildingLooks(player, data.island, true)
	end

	if previous.stage ~= current.stage then
		player:SetAttribute("IslandStage", tonumber(current.stage))
	end

	if previous.terminal ~= current.terminal then
		MapService.updateTerminal(player, terminalView(data))
	end

	if previous.tower ~= current.tower then
		local oldTower = string.match(previous.tower, "^([^:]+):")
		local newTower = string.match(current.tower, "^([^:]+):")
		applyTower(player, current.tower, oldTower ~= newTower)
	end

	_signatures[player] = current
end

function PlotDisplayService.init()
	-- MapService darf PlayerService nicht requiren (PlayerService requiret
	-- bereits MapService — das waere ein Ringschluss). Deshalb bekommt es die
	-- Lesefunktion von hier: dieser Service kennt beide ohnehin schon.
	MapService.setIslandDataProvider(function(player: Player): Types.IslandData?
		local data = PlayerService.getData(player)
		return if data then data.island else nil
	end)
	-- Sammel-Update Paket 8: Platz-Zahl des Inkubators (Level, Rebirths, Index).
	MapService.setIncubatorSlotProvider(function(player: Player): number
		local data = PlayerService.getData(player)
		return if data then IncubatorRules.slotCountFor(data) else 1
	end)

	PlayerService.onPlayerReady(function(player, data)
		-- Die Figuren und Schilder stehen zu diesem Zeitpunkt schon
		-- (MapService.spawnIsland laeuft beim Join davor), aber die Daten
		-- haben sich seitdem noch geaendert: die onDataLoaded-Callbacks haben
		-- Offline-Honig gutgeschrieben und offline gelegte Eier eingetragen.
		-- Die Schilder zeigten sonst bis zum naechsten Honig-Tick den Stand von
		-- vor der Gutschrift, und die Eier laegen nur in den Daten.
		--
		-- Deshalb einmal aktiv nachziehen — und ERST DANN die Signatur
		-- merken, sonst haelt der Vergleich unten den Unterschied faelschlich
		-- fuer bereits dargestellt.
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateBaerchiStates(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		MapService.updateIncubator(player, data.island, IncubatorRules.slotCountFor(data))

		local signatures = allSignatures(data)
		applyTower(player, signatures.tower, false)
		player:SetAttribute("IslandStage", tonumber(signatures.stage))
		MapService.updateTerminal(player, terminalView(data))

		_signatures[player] = signatures
	end)

	PlayerService.onDataChanged(refresh)

	Players.PlayerRemoving:Connect(function(player)
		_signatures[player] = nil
	end)

	print("[PlotDisplayService] Initialisiert")
end

return PlotDisplayService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX31"><Properties>
<string name="Name">TowerService</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- TowerService.luau
-- ServerScriptService/Services/TowerService.luau
--
-- Einzige Zustaendigkeit:
--   - Den permanenten Tower-Fortschritt fuehren (v15, ersetzt das PIT-Level):
--     Tower-Wahl, Freischaltung (08.10.: durch Schaffen des vorherigen
--     Towers, towers.unlocked, Meldung TowerUnlocked; ohne
--     FeatureFlags.TOWER_UNLOCK_BY_CLEAR der alte Deckel pro Rebirth),
--     Rekorde, Meilensteine (auch rueckwirkend) und die PIT-Erstattung aus
--     der Migration.
--
-- Was ein Lauf ist und wie er simuliert wird, weiss CombatService; dieser
-- Service sagt ihm nur, in welchem Tower gekaempft wird, bis wohin es Belohnung
-- gibt, und nimmt am Ende das Ergebnis entgegen (recordRun). Die Zahlen stehen
-- in Config/TowerConfig.
--
-- Die Daten (data.towers) liegen ausserhalb der Insel wie der Ei-Baum: ein
-- Rebirth setzt die Insel zurueck, Rekorde und abgeholte Meilensteine bleiben.
--
-- Auszahlungen laufen ausschliesslich ueber die zustaendigen Services:
-- Gummies/GoldGummies ueber EconomyService (Meilensteine OHNE Multiplikator,
-- awardGummiesFlat), Eier ueber EggService.grantEggs, Blaupausen ueber
-- EggTreeService.grantBlueprint.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local LeaderboardConfig = require(ReplicatedStorage.Config.LeaderboardConfig)  -- Paket 9: Woche
local EggTree     = require(ReplicatedStorage.Modules.EggTree)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local EggService     = require(ServerScriptService.Services.EggService)
local EggTreeService = require(ServerScriptService.Services.EggTreeService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local TowerService = {}

-- Nur Studio/Debug: Spielstaende, fuer die jeder Tower offen ist (Kampf in allen
-- vier Towern ohne Rebirths testen). Schluessel = die Daten-Tabelle, schwach.
local _debugOpen: { [any]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function fail(player: Player, reason: Types.LocMsg)
	Remotes.ActionFailed:FireClient(player, "RequestSelectTower", reason)
end

--------------------------------------------------------------------------------
-- Lesen
--------------------------------------------------------------------------------

-- Deckel in diesem Tower (0 = Tower noch zu). 08.10.: mit
-- TOWER_UNLOCK_BY_CLEAR die volle Stage-Zahl jedes freigeschalteten Towers.
function TowerService.getStageCap(data: Types.PlayerData, towerId: string): number
	local cap = TowerConfig.getStageCap(data.rebirthCount, towerId, data.towers.records, data.towers.unlocked)
	if cap <= 0 and _debugOpen[data] then
		local def = TowerConfig.get(towerId)
		return if def then def.stages else 0
	end
	return cap
end

-- Der gewaehlte Tower; ist er (z. B. nach einer Datenreparatur) nicht offen,
-- der hoechste offene.
function TowerService.getSelected(data: Types.PlayerData): string
	local selected = data.towers.selected
	if TowerConfig.isOpen(data.rebirthCount, selected, data.towers.records, data.towers.unlocked) or (_debugOpen[data] and TowerConfig.isValidId(selected)) then
		return selected
	end
	-- Sonst der hoechste offene Tower (Tower I ist immer offen)
	local best = TowerConfig.FIRST_TOWER :: string
	for _, def in TowerConfig.TOWERS do
		if TowerConfig.isOpen(data.rebirthCount, def.id, data.towers.records, data.towers.unlocked) then
			best = def.id
		end
	end
	return best
end

--------------------------------------------------------------------------------
-- Freischaltung (08.10.)
--------------------------------------------------------------------------------

-- Traegt die Tower ein, die `towerId` mit seinem Rekord oeffnet. `announce`:
-- dem Spieler melden (TowerUnlocked → Feier-Moment, "NEU"-Abzeichen). Beim
-- Join nur still nachtragen, sonst kaeme die Meldung bei jedem Betreten.
local function applyUnlocks(player: Player, data: Types.PlayerData, towerId: string, announce: boolean)
	if not FeatureFlags.isOn("TOWER_UNLOCK_BY_CLEAR") then return end
	local towers = data.towers
	if typeof(towers.unlocked) ~= "table" then towers.unlocked = {} end
	for _, nextId in TowerConfig.unlocksAfterClear(towerId, towers.records[towerId] or 0) do
		if towers.unlocked[nextId] ~= true then
			towers.unlocked[nextId] = true
			if announce then
				-- Nach dem Lauf-Ergebnis zeigen (Ergebnis-Toast zuerst)
				task.delay(1.5, function()
					if player.Parent then
						Remotes.TowerUnlocked:FireClient(player, nextId)
					end
				end)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Meilensteine
--------------------------------------------------------------------------------

-- Zahlt einen einzelnen Meilenstein aus (einmalig) und meldet ihn dem Client.
-- Gibt true zurueck, wenn er neu abgeholt wurde.
local function grantMilestone(player: Player, data: Types.PlayerData, towerId: string, stage: number): boolean
	local milestone = TowerConfig.getMilestone(towerId, stage)
	if not milestone then return false end

	local claimed = data.towers.claimed[towerId]
	if not claimed then
		claimed = {}
		data.towers.claimed[towerId] = claimed
	end
	local key = tostring(stage)
	if claimed[key] then return false end
	claimed[key] = true

	local reward: Types.TowerMilestoneReward = {
		towerId     = towerId,
		stage       = stage,
		gummies     = 0,
		goldGummies = 0,
		eggType     = nil,
		eggs        = 0,
		blueprints  = 0,
	}

	if milestone.gummies > 0 then
		reward.gummies = EconomyService.awardGummiesFlat(player, milestone.gummies)
	end
	if milestone.goldGummies > 0 then
		reward.goldGummies = EconomyService.awardGoldGummies(player, milestone.goldGummies)
	end
	if milestone.eggs > 0 then
		local eggType = EggTree.highestUnlocked(data.eggTree)
		if EggService.grantEggs(player, eggType, milestone.eggs) then
			reward.eggType = eggType
			reward.eggs = milestone.eggs
		end
	end
	if milestone.blueprints > 0 then
		EggTreeService.grantBlueprint(player, data, milestone.blueprints)
		reward.blueprints = milestone.blueprints
	end
	if milestone.endlessLevels > 0 then
		local baerchi = data.island.equippedUid and data.island.baerchis[data.island.equippedUid]
		if baerchi then
			baerchi.endlessLevel = (baerchi.endlessLevel or 0) + milestone.endlessLevels
			reward.endlessLevels = milestone.endlessLevels
		end
	end

	-- Kurz verzoegert: beim Join haengt der Client sein UI erst noch an.
	task.delay(1, function()
		if player.Parent then
			Remotes.TowerMilestoneReceived:FireClient(player, reward)
		end
	end)
	return true
end

-- Alle noch offenen Meilensteine bis einschliesslich `upTo` (rueckwirkend).
local function grantMilestonesUpTo(player: Player, data: Types.PlayerData, towerId: string, upTo: number): number
	local granted = 0
	local stage = TowerConfig.MILESTONE_EVERY
	while stage <= upTo do
		if grantMilestone(player, data, towerId, stage) then
			granted += 1
		end
		stage += TowerConfig.MILESTONE_EVERY
	end
	return granted
end

--------------------------------------------------------------------------------
-- Ergebnis eines Laufs
--------------------------------------------------------------------------------

-- Vom CombatService am Ende eines Laufs aufgerufen. `highestWon` = hoechste
-- gewonnene Stage dieses Laufs. Rekord und Meilensteine zaehlen nur bis zum
-- Deckel (weich). Gibt den neuen Rekord (nil = keiner) und zurueck, ob der Lauf
-- den Deckel erreicht hat (Rebirth-Hinweis, nur wenn der Deckel ein echtes
-- Limit ist).
function TowerService.recordRun(player: Player, data: Types.PlayerData, towerId: string, highestWon: number): (number?, boolean)
	local def = TowerConfig.get(towerId)
	if not def or highestWon <= 0 then return nil, false end

	local cap = TowerService.getStageCap(data, towerId)
	local counted = math.min(highestWon, cap)

	-- Sammel-Update 05.10. (Paket 4.1): beste Stage dieses Lebens fuer die
	-- Rebirth-Bedingung. Ungedeckelt: die Bedingung liegt ohnehin unter dem
	-- Deckel, und ein Spieler, der darueber kaempft, hat sie erst recht erfuellt.
	local island = data.island
	if typeof(island.stageBest) ~= "table" then island.stageBest = {} end
	island.stageBest[towerId] = math.max(island.stageBest[towerId] or 0, highestWon)

	local newRecord: number? = nil
	local previous = data.towers.records[towerId] or 0
	if counted > previous then
		data.towers.records[towerId] = counted
		newRecord = counted
		if def.index > TowerConfig.getIndex(data.towers.highestTower) then
			data.towers.highestTower = towerId
		end
		grantMilestonesUpTo(player, data, towerId, counted)
		applyUnlocks(player, data, towerId, true)
	end

	-- Paket 9: beste Endless-Stage dieser Woche (Wochen-Bestenliste).
	if towerId == "Endless" then
		local week = LeaderboardConfig.weekOf(os.time())
		local entry = data.towers.endlessWeek
		if not entry or entry.week ~= week then
			entry = { week = week, best = 0 }
			data.towers.endlessWeek = entry
		end
		entry.best = math.max(entry.best, counted)
	end

	local capReached = highestWon >= cap and TowerConfig.isCapLimiting(data.rebirthCount, towerId)
	return newRecord, capReached
end

--------------------------------------------------------------------------------
-- Tower waehlen
--------------------------------------------------------------------------------

function TowerService.select(player: Player, towerId: string)
	local data = PlayerService.getData(player)
	if not data then return end

	if not TowerConfig.isValidId(towerId) then
		fail(player, Loc.msg("err.tower_unknown"))
		return
	end
	if not TowerConfig.isOpen(data.rebirthCount, towerId, data.towers.records, data.towers.unlocked)
		and not _debugOpen[data] then
		if towerId == "Endless" then
			fail(player, Loc.msg("err.tower_locked_endless"))
		elseif FeatureFlags.isOn("TOWER_UNLOCK_BY_CLEAR") then
			local prev, _, needed = TowerConfig.getUnlockProgress(towerId, data.towers.records)
			fail(player, Loc.msg("err.tower_locked_clear", {
				tower = Loc.msg("tower." .. (prev or TowerConfig.FIRST_TOWER) .. ".name"),
				stages = needed,
			}))
		else
			fail(player, Loc.msg("err.tower_locked", { rebirths = TowerConfig.getOpeningRebirth(towerId) }))
		end
		return
	end
	if data.towers.selected == towerId then return end

	data.towers.selected = towerId
	PlayerService.markDirty(player)
end

-- Debug: alle Tower fuer diesen Spielstand oeffnen (bis zum Verlassen).
function TowerService.debugOpenAll(data: Types.PlayerData)
	_debugOpen[data] = true
end

-- Debug: Rekord direkt setzen (mit Meilensteinen bis dorthin).
function TowerService.debugSetRecord(player: Player, towerId: string, stage: number)
	local data = PlayerService.getData(player)
	local def = TowerConfig.get(towerId)
	if not data or not def then return end
	local value = math.clamp(math.floor(stage), 0, def.stages)
	data.towers.records[towerId] = value
	if value > 0 and def.index > TowerConfig.getIndex(data.towers.highestTower) then
		data.towers.highestTower = towerId
	end
	grantMilestonesUpTo(player, data, towerId, value)
	applyUnlocks(player, data, towerId, true)
	PlayerService.markDirty(player)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function TowerService.init()
	RateLimiter.connect(Remotes.RequestSelectTower, "RequestSelectTower", function(player, towerId: any)
		if typeof(towerId) ~= "string" then return end
		TowerService.select(player, towerId)
	end)

	PlayerService.onDataLoaded(function(player, data)
		-- 1. PIT-Erstattung aus der Migration v14 -> v15 (einmalig).
		local refund = data.island.pitRefund or 0
		if refund > 0 then
			data.island.pitRefund = 0
			local paid = EconomyService.awardGummiesFlat(player, refund)
			task.delay(4, function()
				if player.Parent then
					Remotes.EventNotice:FireClient(player, Loc.msg("msg.pit_refund", { amount = paid }), "good")
				end
			end)
			print("[TowerService]", player.Name, "| PIT-Erstattung:", paid)
		end

		-- 2. Rueckwirkende Meilensteine (migrierter Rekord, oder ein neuer
		--    Meilenstein in der Config).
		for towerId, record in data.towers.records do
			grantMilestonesUpTo(player, data, towerId, record)
			applyUnlocks(player, data, towerId, false)
		end

		-- 3. Gewaehlter Tower muss offen sein.
		data.towers.selected = TowerService.getSelected(data)
	end)

	print("[TowerService] Initialisiert |", #TowerConfig.TOWERS, "Tower")
end

return TowerService
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX32"><Properties>
<string name="Name">Util</string>
</Properties>
<Item class="Folder" referent="RBX33"><Properties>
<string name="Name">MapBuild</string>
</Properties>
<Item class="ModuleScript" referent="RBX34"><Properties>
<string name="Name">PondBuilder</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PondBuilder.luau
-- ServerScriptService/Util/MapBuild/PondBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Den Honig-Teich eines Plots bauen und seinen Fuellstand anzeigen
--
-- Der Fuellstand ist der gelagerte Honig aller Gebaeude (honeyPool). Der
-- ausgeruestete Baerchi isst am Steg (pondStand).
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types            = require(ReplicatedStorage.Network.Types)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local PondBuilder = {}

-- Der gesamte Honig-Vorrat einer Insel.
--
-- Wird als Attribut an JEDES Gebaeude geschrieben, nicht nur der eigene
-- Bestand: gefuettert wird auf der Baerchi-Detailkarte, und dort stehen alle
-- drei Vorraete nebeneinander zur Wahl. Wer vor dem Bienenstock steht, soll
-- deshalb sehen, dass ueberhaupt noch Honig da ist — auch wenn er im Honigtopf
-- nebenan liegt.
function PondBuilder.honeyPool(islandData: Types.IslandData): number
	local total = 0
	for _, building in islandData.buildings do
		total += math.max(0, building.honey or 0)
	end
	return total
end

-- Wie voll der Teich angezeigt wird: Anteil des GESAMTEN Honig-Vorrats an der
-- Lagermenge, die diese Insel auf ihren AKTUELLEN Leveln fasst.
--
-- Bewusst die aktuelle und nicht die theoretisch maximale Menge: der
-- Bienenstock vergroessert sein Lager mit jedem Level, und ein Teich, der nach
-- einem Ausbau ploetzlich leerer aussieht, waere die falsche Rueckmeldung.
-- So heisst "voller Teich" immer dasselbe — alle Lager sind voll.
function PondBuilder.pondFillRatio(islandData: Types.IslandData): number
	local capacity = BuildingBehavior.getTotalCapacity(islandData.buildings)
	if capacity <= 0 then return 0 end
	return math.clamp(PondBuilder.honeyPool(islandData) / capacity, 0, 1)
end

-- Der Boden-Ursprung des Teichs fuer einen Plot.
--
-- Mitte des Beckens auf Beet-Hoehe — dieselbe Rolle wie `ground` bei den
-- Gebaeuden, aber zusaetzlich GEDREHT: das lokale -Z zeigt zum Baerchi-Platz,
-- also dorthin, wo der Baerchi herkommt und beim Fressen steht. Genau
-- dieselbe Regel wie beim Plot-CFrame ("-Z zeigt dorthin, wo man herkommt"),
-- und der Grund, warum die Offsets in MapConfig.POND_DECOR ohne einen einzigen
-- Winkel auskommen.
--
-- Faellt die Richtung weg (Teich exakt auf dem Baerchi-Platz — kann nur durch
-- eine kaputte Config passieren), bleibt die Plot-Ausrichtung stehen: lieber
-- ein Teich, der in die falsche Richtung schaut, als gar keiner.
function PondBuilder.pondGround(slot: number): CFrame
	local plotCFrame = MapParts.plotCFrame(slot)

	-- Lage und Richtung aus MapLayout (HONEY_POND_V2: Teich in der Plot-Mitte
	-- hinten, Standplatz nach +Z; sonst wie bisher zum Baerchi-Platz).
	local offset = MapLayout.pondOffset()
	local center = CFrame.new(offset.X, MapParts.plotSurfaceOffset() + offset.Y, offset.Z)
	local toHome = MapLayout.pondFacing()

	-- CFrame.lookAt richtet -Z auf das Ziel aus (siehe buildPlotCFrame).
	local facing = CFrame.lookAt(center.Position, center.Position + toHome)
	return plotCFrame * facing
end

-- Der Standplatz vor dem Becken: teich-lokal auf -Z, um Beckenrand plus
-- Abstand von der Mitte entfernt. Hier landet der Baerchi, hier liegen die
-- Bohlen, und genau hier hat der Steinkranz seine Luecke.
function PondBuilder.pondStandDistance(): number
	return MapLayout.pondStandDistance()
end

function PondBuilder.pondStand(slot: number): CFrame
	return PondBuilder.pondGround(slot) * CFrame.new(0, 0, -PondBuilder.pondStandDistance())
end

-- Setzt die Fuellhoehe der "Fuellung"-Part auf den aktuellen Vorrat. Getrennt
-- vom Aufbau, weil das bei jeder Honig-Aenderung laeuft (siehe
-- updateBuildingSigns) und deshalb billig bleiben muss — kein Neuaufbau.
--
-- `ground` ist derselbe Ursprung wie beim Aufbau: die Fuellung waechst von
-- dort nach oben, statt ueber die WELT-Position herumzurechnen (die haengt
-- vom Plot-Winkel ab und ist dafuer ungeeignet).
function PondBuilder.writePondFill(fill: BasePart, ground: CFrame, ratio: number)
	-- Breiter UND hoeher (siehe MapConfig): nur hoeher waere aus der
	-- Spielerkamera kaum abzulesen, nur breiter saehe aus wie ein Aufkleber.
	local maxRadius = MapConfig.POND_RADIUS - MapConfig.POND_FILL_INSET
	local scale     = MapConfig.POND_FILL_MIN_SCALE
		+ (1 - MapConfig.POND_FILL_MIN_SCALE) * math.clamp(ratio, 0, 1)

	local radius = maxRadius * scale
	local height = MapConfig.POND_FILL_MIN_HEIGHT
		+ (MapConfig.POND_FILL_MAX_HEIGHT - MapConfig.POND_FILL_MIN_HEIGHT) * math.clamp(ratio, 0, 1)

	-- Der Honig steht AUF dem Beckenboden, nicht auf dem Beet.
	fill.CFrame = ground
		* CFrame.new(0, MapConfig.POND_FLOOR_TOP + height * 0.5, 0)
		* CFrame.Angles(0, 0, math.rad(90))
	fill.Size   = Vector3.new(height, radius * 2, radius * 2)

	fill.Transparency = if ratio <= 0 then 1 else MapConfig.POND_FILL_TRANSPARENCY
end

-- Eine der beiden flachen Scheiben des Beckens (Sandkante bzw. Beckenboden).
-- Beide sind dicker als der sichtbare Teil; der Rest steckt im Beet, damit
-- unten nichts durchscheint.
function PondBuilder.buildPondDisc(parent: Instance, ground: CFrame, name: string, radius: number, top: number, color: Color3, material: Enum.Material)
	local disc = MapParts.newPart(
		name,
		Vector3.new(MapConfig.POND_DISC_HEIGHT, radius * 2, radius * 2),
		ground * CFrame.new(0, top - MapConfig.POND_DISC_HEIGHT * 0.5, 0)
			* CFrame.Angles(0, 0, math.rad(90)),
		color,
		material
	)
	disc.Shape      = Enum.PartType.Cylinder
	disc.CanCollide = true
	disc.CanQuery   = false
	disc.Parent     = parent
end

-- Der Steinkranz: die Beckenwand.
--
-- Er laesst auf der Seite zum Baerchi-Platz eine Luecke frei — dieselbe Idee
-- wie beim Zaun um die Arena, und aus demselben Grund: durch eine Wand kommt
-- man nicht. Groessen und Farben wechseln reihum durch, damit es nach
-- gesammelten Feldsteinen aussieht und nicht nach einer Perlenkette.
function PondBuilder.buildPondStones(parent: Instance, ground: CFrame)
	local ringRadius = MapConfig.POND_RADIUS + MapConfig.POND_RIM_WIDTH * 0.5
	local gap        = math.rad(MapConfig.POND_STONE_GAP_DEGREES)

	-- Die Steine stehen bei (sin a, cos a): a = 0 ist teich-lokales +Z,
	-- a = pi ist -Z. Die Luecke liegt also bei pi.
	local gapAngle = math.pi

	for i = 1, MapConfig.POND_STONE_COUNT do
		local angle = (i - 1) * (2 * math.pi / MapConfig.POND_STONE_COUNT)

		-- Winkelabstand zur Luecke, immer als kuerzester Weg gemessen.
		local delta = math.abs(((angle - gapAngle + math.pi) % (2 * math.pi)) - math.pi)

		if delta > gap then
			local size  = MapConfig.POND_STONE_SIZES[((i - 1) % #MapConfig.POND_STONE_SIZES) + 1]
			local color = MapConfig.POND_STONE_COLORS[((i - 1) % #MapConfig.POND_STONE_COLORS) + 1]

			-- Etwas eingegraben: die Steine sollen im Sand liegen und nicht
			-- auf dem Boden balancieren. Sie sind leicht gestaucht, damit sie
			-- nach Feldsteinen aussehen und nicht nach Murmeln.
			local stone = MapParts.newPart(
				"Stein_" .. i,
				Vector3.new(size, size * 0.82, size),
				ground * CFrame.new(
					math.sin(angle) * ringRadius,
					MapConfig.POND_RIM_TOP + size * 0.30,
					math.cos(angle) * ringRadius
				),
				color,
				Enum.Material.Slate
			)
			stone.Shape      = Enum.PartType.Ball
			stone.CanCollide = true
			stone.CanQuery   = false
			stone.Parent     = parent
		end
	end
end

-- Die zwei Bohlen vor der Luecke, auf denen der Baerchi beim Fressen steht,
-- plus zwei Pfloecke daneben. Sie liegen um den Standplatz herum, den auch
-- MapService.getPondPosition zurueckgibt — eine Rechnung, kein zweiter Satz
-- Zahlen (siehe MapConfig.POND_STAND_GAP).
function PondBuilder.buildPondPlanks(parent: Instance, ground: CFrame)
	local stand = PondBuilder.pondStandDistance()
	local step: number = (MapConfig.POND_PLANK_SIZE.Z + MapConfig.POND_PLANK_GAP) * 0.5
	local y: number    = MapConfig.POND_PLANK_TOP - MapConfig.POND_PLANK_SIZE.Y * 0.5

	for i, offset in { -step, step } do
		local plank = MapParts.newPart(
			"Bohle_" .. i,
			MapConfig.POND_PLANK_SIZE,
			ground * CFrame.new(0, y, -stand + offset),
			MapConfig.POND_PLANK_COLORS[((i - 1) % #MapConfig.POND_PLANK_COLORS) + 1],
			Enum.Material.WoodPlanks
		)
		plank.CanCollide = false
		plank.CanQuery   = false
		plank.Parent     = parent
	end

	-- Pfloecke: kleine Pfosten an beiden Bohlen-Enden. CFrame.Angles(0, 0, 90)
	-- stellt den Zylinder AUFRECHT (seine Laenge ist Size.X) — deshalb muss
	-- auch die Hoehe aus Size.X kommen. 08.10.: vorher stand hier
	-- Size.Y * 0.4 (der Durchmesser), der Pfosten steckte 0.49 im Beet.
	for i, side in { -1, 1 } do
		local peg = MapParts.newPart(
			"Pflock_" .. i,
			MapConfig.POND_PEG_SIZE,
			ground * CFrame.new(side * MapConfig.POND_PEG_SPREAD, MapConfig.POND_PEG_SIZE.X * MapConfig.POND_PEG_LIFT, -stand)
				* CFrame.Angles(0, 0, math.rad(90)),
			MapConfig.POND_PLANK_COLORS[2],
			Enum.Material.Wood
		)
		peg.Shape      = Enum.PartType.Cylinder
		peg.CanCollide = false
		peg.CanQuery   = false
		peg.Parent     = parent
	end
end

-- Der Honig-Teich auf dem Plot: Sandkante, Steinkranz, abgesenkter Beckenboden
-- und darauf der Honig, dessen Flaeche und Hoehe den Gesamt-Vorrat zeigen. Der
-- ausgeruestete Baerchi laeuft zu den Bohlen davor, um zu essen (siehe
-- BaerchiAutopilotService).
function PondBuilder.buildPond(plotModel: Model, slot: number, islandData: Types.IslandData)
	local old = plotModel:FindFirstChild("Pond")
	if old then old:Destroy() end

	local ground = PondBuilder.pondGround(slot)

	local pond = Instance.new("Model")
	pond.Name   = "Pond"
	pond.Parent = plotModel

	-- Sandkante zuerst und TIEFER als der Beckenboden: nur so bleibt sie
	-- ringsum als Streifen sichtbar, ohne dass ein Ring aus Einzelteilen
	-- noetig waere — derselbe Trick wie am Ufer jeder Insel.
	PondBuilder.buildPondDisc(
		pond, ground, "Rand",
		MapConfig.POND_RADIUS + MapConfig.POND_RIM_WIDTH,
		MapConfig.POND_RIM_TOP,
		MapConfig.POND_RIM_COLOR,
		Enum.Material.Sand
	)
	PondBuilder.buildPondDisc(
		pond, ground, "Boden",
		MapConfig.POND_RADIUS,
		MapConfig.POND_FLOOR_TOP,
		MapConfig.POND_FLOOR_COLOR,
		Enum.Material.Slate
	)

	PondBuilder.buildPondStones(pond, ground)
	PondBuilder.buildPondPlanks(pond, ground)
	-- Mit HONEY_POND_V2 schmueckt der Brunnen (Gebaeude HoneyPond) das
	-- Becken; der Honigloeffel wuerde in seine Schale ragen.
	if not FeatureFlags.isOn("HONEY_POND_V2") then
		MapParts.buildDecor(pond, ground, MapConfig.POND_DECOR)
	end

	-- Als Platzhalter-Groesse angelegt — writePondFill setzt Groesse und
	-- Position gleich im Anschluss auf den echten Vorrat.
	local fill = MapParts.newPart(
		"Fuellung",
		Vector3.new(0.05, MapConfig.POND_RADIUS, MapConfig.POND_RADIUS),
		ground,
		MapConfig.POND_FILL_COLOR,
		Enum.Material.Neon
	)
	fill.Shape      = Enum.PartType.Cylinder
	fill.CanCollide = false
	fill.CanQuery   = false
	fill.CanTouch   = false
	fill.Parent     = pond

	PondBuilder.writePondFill(fill, ground, PondBuilder.pondFillRatio(islandData))
end

return PondBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX35"><Properties>
<string name="Name">TerminalBuilder</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- TerminalBuilder.luau
-- ServerScriptService/Util/MapBuild/TerminalBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Das Tower-Terminal am Stegbeginn bauen (08.10., Paket B2) und seinen
--     Zustand als Attribute an das Model schreiben.
--
-- Gebaut wird EINMAL mit dem Plot, rein aus MapConfig.TOWER_TERMINAL (wie die
-- Gebaeude-Deko). Was der Bildschirm zeigt, steht nur in Attributen; den Text
-- in der Sprache des Betrachters, die Lampenfarbe, das Blinken, das "!" und
-- den Prompt macht der Client (Controllers/TerminalController). Kein Neubau
-- bei einer Aenderung, keine Emitter, keine Lichter.
--
-- Attribute am Model "TowerTerminal":
--   State     "locked" | "ready" | "normal" (TowerConfig.terminalState)
--   Tower     gewaehlter Tower (Id)
--   Record    Rekord im gewaehlten Tower
--   NextTower Tower, der als naechstes aufgeht ("" = keiner)
--   NewTower  frisch freier Tower ("NEU", "" = keiner)
--   Progress  Rekord im Vorgaenger dieses Towers (Fortschritt "12/30")
--   Needed    noetige Stage im Vorgaenger
--
-- Teil von MapService: nur MapService benutzt dieses Modul. Es aendert keine
-- Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig = require(ReplicatedStorage.Config.MapConfig)
local MapParts  = require(ServerScriptService.Util.MapBuild.MapParts)

local TerminalBuilder = {}

TerminalBuilder.MODEL_NAME = "TowerTerminal"

export type TerminalView = {
	state     : string,
	tower     : string,
	record    : number,
	nextTower : string,
	newTower  : string,
	progress  : number,
	needed    : number,
}

-- Boden-Ursprung des Terminals (plot-lokal versetzt und gedreht).
function TerminalBuilder.origin(slot: number): CFrame
	local cfg = MapConfig.TOWER_TERMINAL
	return MapParts.plotCFrame(slot)
		* CFrame.new(cfg.offset)
		* CFrame.Angles(0, math.rad(cfg.yaw), 0)
end

function TerminalBuilder.writeState(model: Model, view: TerminalView)
	model:SetAttribute("State", view.state)
	model:SetAttribute("Tower", view.tower)
	model:SetAttribute("Record", view.record)
	model:SetAttribute("NextTower", view.nextTower)
	model:SetAttribute("NewTower", view.newTower)
	model:SetAttribute("Progress", view.progress)
	model:SetAttribute("Needed", view.needed)
end

function TerminalBuilder.build(plotModel: Model, slot: number, view: TerminalView?): Model
	local old = plotModel:FindFirstChild(TerminalBuilder.MODEL_NAME)
	if old then old:Destroy() end

	local model = Instance.new("Model")
	model.Name = TerminalBuilder.MODEL_NAME
	local origin = TerminalBuilder.origin(slot)
	MapParts.buildDecor(model, origin, MapConfig.TOWER_TERMINAL.pieces)
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") then
			part.CastShadow = part.Name == "Kopf" or part.Name == "Saeule" or part.Name == "Sockel"
		end
	end
	-- Pivot auf den Boden-Ursprung: der Client findet so "vorne" und "oben".
	model.WorldPivot = origin
	if view then
		TerminalBuilder.writeState(model, view)
	else
		TerminalBuilder.writeState(model, { state = "locked", tower = "I", record = 0, nextTower = "II", newTower = "", progress = 0, needed = 0 })
	end
	model.Parent = plotModel
	return model
end

return TerminalBuilder
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="RBX36"><Properties>
<string name="Name">PlayerMigration</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PlayerMigration.luau
-- ServerScriptService/Util/PlayerMigration.luau
--
-- Einzige Zustaendigkeit:
--   - Einen geladenen Spielstand beliebiger frueherer Version auf die aktuelle
--     Struktur (Types.PlayerData) bringen
--
-- Gehoert fachlich zu PlayerService und wird nur von dort aufgerufen. Es ist
-- ein eigenes Modul, weil es eine reine Funktion ist (Tabelle rein, Tabelle
-- raus, kein DataStore, kein Spieler-Objekt) und deshalb ohne Studio getestet
-- werden kann: tools/luau-tests/migration.test.lua schickt alte Spielstaende
-- hindurch und prueft das Ergebnis gegen Types.createDefaultPlayerData.
--
-- Regel fuer neue Felder: jedes Feld, das in Types.PlayerData dazukommt, wird
-- hier nachgeruestet (oder ausdruecklich begruendet, warum nil reicht). Eine
-- Migration, die Werte UMRECHNET statt Fehlendes anzulegen, haengt an
-- data.version und darf nur einmal laufen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local PromotionConfig  = require(ReplicatedStorage.Config.PromotionConfig)
local CharmConfig      = require(ReplicatedStorage.Config.CharmConfig)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggTree          = require(ReplicatedStorage.Modules.EggTree)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local FeatureFlags     = require(ReplicatedStorage.Config.FeatureFlags)
local HoneyPondMode    = require(ReplicatedStorage.Modules.HoneyPondMode)

local PlayerMigration = {}

-- Fehlende Felder aus Default auffuellen (einfache Migration fuer neue Felder).
-- Muss jedes Feld abdecken das seit dem ersten Release in Types.luau
-- dazugekommen ist — sonst crasht alter Save-Stand beim ersten Zugriff.
function PlayerMigration.applyDefaults(data: Types.PlayerData): Types.PlayerData
	local default = Types.createDefaultPlayerData()

	-- Neue Top-Level-Felder
	if data.gummies      == nil then data.gummies      = default.gummies      end
	if data.goldGummies  == nil then data.goldGummies  = default.goldGummies  end
	if data.rebirthCount == nil then data.rebirthCount = default.rebirthCount end
	if data.rebirthMult  == nil then data.rebirthMult  = default.rebirthMult  end
	if data.rank         == nil then data.rank         = default.rank         end
	if data.island       == nil then data.island       = default.island       end
	if data.stats        == nil then data.stats        = default.stats        end
	if data.createdAt    == nil then data.createdAt    = default.createdAt    end
	if data.lastSeenAt   == nil then data.lastSeenAt   = default.lastSeenAt   end

	-- Neue Stats-Felder (dynamischer Key → bewusst ueber any, sonst meckert --!strict)
	local stats     = data.stats    :: any
	local defStats  = default.stats :: any

	-- HBB Paket 10: Sitzungszaehler. Ein Konto, das schon aelter als 10 min
	-- ist, war mindestens einmal da — es zaehlt als 1, damit Veteranen den
	-- Shop schon bei diesem Join (= Sitzung 2, PlayerService zaehlt hoch) sehen.
	if stats.sessions == nil then
		stats.sessions = if os.time() - (data.createdAt or os.time()) >= 600 then 1 else 0
	end
	for key, value in defStats do
		if stats[key] == nil then
			stats[key] = value
		end
	end

	-- highestTowerFloor gehoerte zu einem Tower-Modus, den es nicht gibt. Das
	-- Feld wird entfernt, damit es nicht bei jedem Speichern wieder im
	-- DataStore landet. Am Feld erkennbar und deshalb ohne Versions-Sprung
	-- wiederholbar; ein Wert geht nicht verloren, er war immer 0.
	stats.highestTowerFloor = nil

	-- Neue Island-Felder
	local island = data.island
	if island.baerchis  == nil then island.baerchis  = {} end
	if island.eggStock  == nil then island.eggStock  = { BasicEgg = 3 } end

	-- language: kein Nachruesten noetig — nil bedeutet "automatisch" (die
	-- Roblox-Sprache des Clients), und genau das soll ein alter Spielstand
	-- bekommen. Kein Versions-Sprung. Siehe SettingsService.
	--
	-- v6: equippedUid. Kein Nachruesten noetig — ein fehlendes Feld liest
	-- sich in Lua ohnehin als nil, und IslandService.autoEquipIfNone laeuft
	-- bei jedem Join (onDataLoaded) und ruestet automatisch den ersten
	-- vorhandenen Baerchi aus, falls noch/wieder keiner steht.

	-- ============================================================
	-- ============================================================
	-- v13: QUESTS + INDEX
	-- ============================================================
	-- Neue Felder: discovered, quests, stats.totalHatched (das Stats-Feld legt
	-- die Schleife oben schon mit 0 an). Fuer Spielstaende VOR v13 wird
	-- discovered aus den vorhandenen Baerchis gesaeet und totalHatched auf
	-- deren Anzahl gesetzt, damit Veteranen nicht bei null anfangen.
	if data.discovered == nil then
		data.discovered = {}
		for _, baerchi in data.island.baerchis do
			data.discovered[baerchi.configId] = true
		end
	end

	if (data.version or 0) < 13 then
		local owned = 0
		for _ in data.island.baerchis do owned += 1 end
		data.stats.totalHatched = math.max(data.stats.totalHatched or 0, owned)
	end

	-- HBB Paket 3: uiSeen. Leer nachruesten; UiStateService markiert beim
	-- ersten Laden eines Stands mit Fortschritt alles Sichtbare als gesehen
	-- (keine Badge-Flut fuer Veteranen). Kein Versions-Sprung.
	if data.uiSeen == nil then
		data.uiSeen = {}
	end

	-- HBB Paket 10: Shop-Teil. Leer nachruesten, kaputte Felder reparieren.
	local shop = (data :: any).shop
	if typeof(shop) ~= "table" then
		(data :: any).shop = default.shop
	else
		if typeof(shop.freeGrabDay) ~= "number" then shop.freeGrabDay = -1 end
		if typeof(shop.receipts) ~= "table" then shop.receipts = {} end
	end

	if data.quests == nil then
		data.quests = default.quests
	end

	-- ============================================================
	-- v14: EI-BAUM (Mega Egg Tree)
	-- ============================================================
	-- Neues Top-Level-Feld eggTree (ausserhalb der Insel, damit ein Rebirth
	-- es nicht loescht). Bestandsspieler bekommen die Knoten der Eier frei,
	-- die sie schon im Lager haben oder die auf ihrem Plot liegen — wer ein
	-- Goldenes Ei besitzt, soll es nicht ploetzlich "gesperrt" sehen. Die
	-- Rebirth-Knoten (Ascensions-Pfad) schaltet evaluate unten frei.
	--
	-- Gefahrlos wiederholbar: sanitize ergaenzt nur Fehlendes, und die
	-- Lager-Freischaltung laeuft nur fuer Spielstaende vor v14.
	local hadTree = data.eggTree ~= nil
	data.eggTree = EggTree.sanitize(data.eggTree)
	if not hadTree and (data.version or 0) < 14 then
		for eggType, count in island.eggStock do
			if (count or 0) > 0 and EggConfig.data[eggType] then
				data.eggTree.unlocked[eggType] = true
			end
		end
		for _, egg in (island.laidEggs or {}) do
			if EggConfig.data[egg.eggType] then
				data.eggTree.unlocked[egg.eggType] = true
			end
		end
	end
	-- Unbekannte Ei-Typen im Lager (alte Config) werden zum Basis-Ei.
	local stockAny = island.eggStock :: any
	for eggType, count in stockAny do
		if not EggConfig.data[eggType] then
			stockAny.BasicEgg = (stockAny.BasicEgg or 0) + (tonumber(count) or 0)
			stockAny[eggType] = nil
		end
	end
	EggTree.evaluate(data)

	-- v12: BRUT-SLOTS ENTFALLEN (Eier werden sofort geoeffnet)
	-- ============================================================
	-- Alte Spielstaende koennen noch laufende oder fertige Bruten in
	-- island.hatchingEggs haben. Die gehen NICHT verloren: jedes Ei wandert
	-- als ungeoeffnetes Ei zurueck ins Lager, danach wird das Feld entfernt.
	-- Ein Ei-Typ, den es nicht mehr gibt, wird zum Basis-Ei (dieselbe Regel,
	-- die frueher beim Abholen galt).
	--
	-- Gefahrlos wiederholbar: beim zweiten Durchlauf ist das Feld schon nil.
	-- Ueber `any`, weil Types.IslandData das Feld seit v12 nicht mehr kennt.
	local legacyIsland = island :: any
	if legacyIsland.hatchingEggs ~= nil then
		if typeof(legacyIsland.hatchingEggs) == "table" then
			for _, egg in legacyIsland.hatchingEggs do
				local eggType = if typeof(egg) == "table" then egg.eggType else nil
				if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then
					eggType = "BasicEgg"
				end
				local stock = island.eggStock :: any
				stock[eggType] = (stock[eggType] or 0) + 1
			end
		end
		legacyIsland.hatchingEggs = nil
	end

	-- v12: pitProgress muss nur gueltig sein, wenn es da ist (nil = kein
	-- gespeicherter Lauf). Ein halber Eintrag wird verworfen statt geraten.
	local progress = legacyIsland.pitProgress
	if progress ~= nil and (typeof(progress) ~= "table"
		or typeof(progress.pitLevel) ~= "number"
		or typeof(progress.reachedStage) ~= "number")
	then
		legacyIsland.pitProgress = nil
	end

	-- v10: gelegte Eier.
	--
	-- lastEggAt bewusst auf JETZT statt auf createdAt: ein Spielstand, der vor
	-- diesem Feature entstanden ist, hat keine Ei-Zeit — wuerde man hier
	-- createdAt einsetzen, bekaeme er beim ersten Join nach dem Update die
	-- Obergrenze auf einen Schlag geschenkt, fuer eine Zeit, in der es das
	-- Legen noch gar nicht gab.
	if island.laidEggs == nil then
		island.laidEggs = {}
	else
		-- Nur vollstaendige Eintraege behalten. Ein Ei ohne uid liesse sich nie
		-- einsammeln und laege bis in alle Ewigkeit auf dem Plot herum.
		local cleaned: { Types.LaidEgg } = {}
		for _, egg in island.laidEggs do
			if typeof(egg.uid) == "string" and #egg.uid > 0
				and typeof(egg.eggType) == "string"
				and typeof(egg.x) == "number"
				and typeof(egg.y) == "number"
				and typeof(egg.z) == "number"
			then
				table.insert(cleaned, egg)
			end
		end
		island.laidEggs = cleaned
	end

	if island.lastEggAt == nil then
		island.lastEggAt = os.time()
	end

	-- v15: Waben-Recycler. Feldweise nachgeruestet (wie lastEggAt), deshalb
	-- gefahrlos wiederholbar und ohne Versionssprung.
	local recycler = (island :: any).recycler
	if typeof(recycler) ~= "table" then
		(island :: any).recycler = { level = 1, queued = 0, progress = 0, lastProcessedAt = os.time() }
	else
		if typeof(recycler.level) ~= "number" then recycler.level = 1 end
		if typeof(recycler.queued) ~= "number" then recycler.queued = 0 end
		if typeof(recycler.progress) ~= "number" then recycler.progress = 0 end
		if typeof(recycler.lastProcessedAt) ~= "number" then recycler.lastProcessedAt = os.time() end
	end

	-- (v5 hatte hier die uid-Nachruestung der Brut-Eier — seit v12 gibt es
	-- keine Brut-Eier mehr, siehe oben.)

	-- v4: die Gebaeude sind komplett ausgetauscht. Frueher gab es Hatchery,
	-- GummyFarm, Recycler (und davor FusionLab) mit je eigener Funktion —
	-- jetzt reine Honig-Produzenten. Alte Eintraege werden entfernt und
	-- die neuen angelegt; das Level laesst sich nicht sinnvoll uebertragen,
	-- weil die Gebaeude etwas voellig anderes tun.
	--
	-- (Honigtopf und Honig-Presse bleiben hier noch stehen: die v7- und die
	-- v15-Migration weiter unten brauchen ihre Level. Entfernt werden sie erst
	-- in der v15-Zusammenlegung.)
	local OBSOLETE_BUILDINGS = { "Hatchery", "GummyFarm", "Recycler", "FusionLab" }

	if island.buildings == nil then
		island.buildings = default.island.buildings
	else
		local buildings = island.buildings :: any

		for _, obsolete in OBSOLETE_BUILDINGS do
			buildings[obsolete] = nil
		end

		for buildingId, building in default.island.buildings do
			local existing = buildings[buildingId]
			if existing == nil then
				buildings[buildingId] = {
					id             = building.id,
					level          = building.level,
					honey          = building.honey,
					lastProducedAt = building.lastProducedAt,
				}
			else
				-- v4: Honig-Felder auf bereits vorhandenen Gebaeuden nachruesten
				if existing.honey == nil then
					existing.honey = 0
				end
				if existing.lastProducedAt == nil then
					existing.lastProducedAt = os.time()
				end
			end
		end
	end

	-- v7: die drei Gebaeude haben eigene Rollen bekommen (siehe
	-- Config/BuildingBehavior). Die XP pro Honig haengen seitdem allein am Level
	-- der Honig-Presse — vorher am Level des Gebaeudes, aus dem der Honig kam,
	-- also an allen dreien.
	--
	-- Ohne Ausgleich wuerde ein laufender Spielstand dabei XP VERLIEREN: wer
	-- seinen Bienenstock auf Level 5 stehen hat und die Presse auf Level 1,
	-- bekaeme ploetzlich 30 statt 135 XP pro Honig. Deshalb erbt die Presse
	-- einmalig das hoechste Level, das dieser Spielstand bei irgendeinem
	-- Gebaeude erreicht hatte. Danach ist die XP-Ausbeute mindestens so gut wie
	-- vorher, und niemand muss etwas nachkaufen.
	--
	-- DAS IST DIE ERSTE MIGRATION, DIE AN DER VERSIONSNUMMER HAENGEN MUSS
	-- (siehe den Kommentar bei data.version am Ende dieser Funktion): sie
	-- rechnet einen Wert um, statt ein fehlendes Feld anzulegen. Liefe sie bei
	-- jedem Join erneut, wuerde die Presse jedes Mal wieder auf das Maximum
	-- hochgezogen — der Spieler koennte die anderen beiden nie ueberholen.
	if (data.version or 0) < 7 then
		local press = (island.buildings :: any).HoneyPress

		if press then
			local highest = press.level or 1

			for _, building in island.buildings do
				highest = math.max(highest, building.level or 1)
			end

			press.level = highest
		end
	end

	-- ============================================================
	-- v15: GEBAEUDE OPTION B — Honigtopf + Honig-Presse -> Honig-Veredler
	-- ============================================================
	-- Niemand verliert etwas: der Veredler bekommt das HOEHERE der beiden alten
	-- Level (er kann beides: XP wie die Presse, Heilung wie der Topf), und der
	-- eingelagerte Honig beider wird zusammengelegt (gedeckelt auf sein Lager).
	-- Haengt an der Version, weil es UMRECHNET; danach sind Topf und Presse weg.
	-- Ueber `any`, weil Types.BuildingId die alten Ids nicht mehr kennt.
	do
		local buildings = island.buildings :: any
		if (data.version or 0) < 15 then
			local pot     = buildings.HoneyPot
			local press   = buildings.HoneyPress
			local refiner = buildings.HoneyRefiner
			-- Mit HONEY_POND_V2 legt der Standard keinen Veredler mehr an; fuer
			-- die Zusammenlegung (und danach den Teich) wird er hier angelegt.
			if refiner == nil and (pot or press) then
				refiner = { id = "HoneyRefiner", level = 1, honey = 0, lastProducedAt = os.time() }
				buildings.HoneyRefiner = refiner
			end
			if refiner and (pot or press) then
				local level = math.max(refiner.level or 1,
					if pot then pot.level or 1 else 1,
					if press then press.level or 1 else 1)
				refiner.level = math.clamp(level, 1, EconomyConfig.MAX_BUILDING_LEVEL)

				local honey = (if pot then pot.honey or 0 else 0) + (if press then press.honey or 0 else 0)
				refiner.honey = math.clamp(honey, 0, BuildingBehavior.getCapacity("HoneyRefiner", refiner.level))
			end
		end

		-- Honig-Teich (HONEY_POND_V2) bzw. zurueck zu Stock + Veredler. MUSS vor
		-- dem Aufraeumen unten laufen: sonst waeren die gerade nicht geltenden
		-- Gebaeude schon geloescht statt im Ruhestand (island.retiredBuildings).
		HoneyPondMode.apply(island, FeatureFlags.isOn("HONEY_POND_V2"), os.time())
		local pond = buildings[HoneyPondMode.POND]
		if pond then
			pond.level = EconomyConfig.clampBuildingLevel(pond.level or 1)
			pond.honey = math.clamp(pond.honey or 0, 0, BuildingBehavior.getCapacity("HoneyPond", pond.level))
		end

		-- Alles, was es nicht (mehr) gibt, verschwindet — auch Topf und Presse
		-- nach der Zusammenlegung. Am Feld erkennbar, deshalb wiederholbar.
		for buildingId in buildings do
			if default.island.buildings[buildingId] == nil then
				buildings[buildingId] = nil
			end
		end

		-- Level auf den gueltigen Bereich (1-60) klemmen.
		for _, building in buildings do
			building.level = EconomyConfig.clampBuildingLevel(building.level or 1)
		end
	end

	-- ============================================================
	-- v15: TOWER STATT PIT-LEVEL
	-- ============================================================
	-- 1. Erstattung: die Summe der bezahlten PIT-Ausbaukosten landet in
	--    island.pitRefund. Die Migration fasst KEINE Waehrung an —
	--    TowerService zahlt den Betrag beim Join ueber EconomyService aus.
	-- 2. Rekord: der alte letzte Lauf (pitProgress) wird in die gleich starke
	--    Tower-Stage umgerechnet (TowerConfig.legacyPitToTower) und als
	--    permanenter Rekord eingetragen. Die zugehoerigen Meilensteine vergibt
	--    TowerService beim Join rueckwirkend.
	-- 3. pitLevel, pitProgress und stats.highestPitLevel werden entfernt.
	--
	-- Gilt reachedStage als "geschafft"? reachedStage ist die letzte Stage, in
	-- die der Baerchi eingetreten ist — gewonnen oder verloren. Bewusst
	-- grosszuegig als Rekord gezaehlt: niemand soll durch die Umstellung weniger
	-- haben (ANNAHME, im Bericht).
	data.towers = (data :: any).towers
	if typeof(data.towers) ~= "table" then
		data.towers = {
			records      = {},
			claimed      = {},
			highestTower = TowerConfig.FIRST_TOWER,
			selected     = TowerConfig.FIRST_TOWER,
		}
	end
	local towers = data.towers :: any
	if typeof(towers.records) ~= "table" then towers.records = {} end
	if typeof(towers.claimed) ~= "table" then towers.claimed = {} end

	if (data.version or 0) < 15 then
		local legacyLevel = tonumber(legacyIsland.pitLevel) or 1
		local refund = TowerConfig.legacyPitRefund(legacyLevel)
		legacyIsland.pitRefund = (tonumber(legacyIsland.pitRefund) or 0) + refund

		local legacyProgress = legacyIsland.pitProgress
		if typeof(legacyProgress) == "table" then
			local towerId, stage = TowerConfig.legacyPitToTower(
				tonumber(legacyProgress.pitLevel) or legacyLevel,
				tonumber(legacyProgress.reachedStage) or 0
			)
			if towerId and stage > 0 then
				towers.records[towerId] = math.max(tonumber(towers.records[towerId]) or 0, stage)
			end
		end
	end
	legacyIsland.pitLevel    = nil
	legacyIsland.pitProgress = nil
	stats.highestPitLevel    = nil

	-- Rekorde: nur gueltige Tower, nur Zahlen, nur bis zur Stage-Zahl.
	for towerId, record in towers.records do
		local def = TowerConfig.get(towerId)
		local value = tonumber(record)
		if not def or not value or value <= 0 then
			towers.records[towerId] = nil
		else
			towers.records[towerId] = math.clamp(math.floor(value), 0, def.stages)
		end
	end
	-- Meilensteine: Tabelle je Tower mit TEXT-Schluesseln (siehe Types).
	for towerId, claimed in towers.claimed do
		if not TowerConfig.get(towerId) or typeof(claimed) ~= "table" then
			towers.claimed[towerId] = nil
		else
			local cleaned: { [string]: boolean } = {}
			for stage, flag in claimed do
				if flag == true and tonumber(stage) then
					cleaned[tostring(math.floor(tonumber(stage) :: number))] = true
				end
			end
			towers.claimed[towerId] = cleaned
		end
	end
	-- Hoechster Tower = der hoechste mit Rekord (nie niedriger als gespeichert).
	local highest = if TowerConfig.isValidId(towers.highestTower) then towers.highestTower else TowerConfig.FIRST_TOWER
	for towerId in towers.records do
		if TowerConfig.getIndex(towerId) > TowerConfig.getIndex(highest) then
			highest = towerId
		end
	end
	towers.highestTower = highest

	-- v17 (08.10.): Freischaltung durch Schaffen. Bestandsschutz: was nach der
	-- ALTEN Regel (Deckel pro Rebirth) offen war oder einen Rekord hat, bleibt
	-- offen — niemand verliert Zugang. Nur einmal (Version), danach fuehrt
	-- TowerService die Tabelle. Unbekannte Eintraege fliegen raus.
	if typeof(towers.unlocked) ~= "table" then
		towers.unlocked = {}
	end
	local unlocked = towers.unlocked :: { [string]: boolean }
	for towerId, flag in unlocked do
		if flag ~= true or not TowerConfig.isValidId(towerId) then
			unlocked[towerId] = nil
		end
	end
	unlocked[TowerConfig.FIRST_TOWER] = true
	local rebirths = tonumber((data :: any).rebirthCount) or 0
	for _, def in TowerConfig.TOWERS do
		local wasOpen = (data.version or 0) < 17
			and TowerConfig.getLegacyStageCap(rebirths, def.id, towers.records) > 0
		if wasOpen or TowerConfig.isUnlockedByClear(def.id, towers.records, nil) then
			unlocked[def.id] = true
		end
	end

	if not TowerConfig.isValidId(towers.selected) then
		towers.selected = TowerConfig.FIRST_TOWER
	end

	-- Fortsetzen pro Tower (ersetzt pitProgress) und Erstattungs-Feld.
	if typeof(legacyIsland.towerProgress) ~= "table" then
		legacyIsland.towerProgress = {}
	else
		for towerId, stage in legacyIsland.towerProgress do
			if not TowerConfig.get(towerId) or typeof(stage) ~= "number" or stage < 1 then
				legacyIsland.towerProgress[towerId] = nil
			end
		end
	end
	if typeof(legacyIsland.pitRefund) ~= "number" or legacyIsland.pitRefund < 0 then
		legacyIsland.pitRefund = 0
	end

	-- v15: Login-Bonus. Feldweise, wiederholbar.
	local daily = (data :: any).daily
	if typeof(daily) ~= "table" then
		(data :: any).daily = { lastClaimDay = 0, streak = 0 }
	else
		if typeof(daily.lastClaimDay) ~= "number" then daily.lastClaimDay = 0 end
		if typeof(daily.streak) ~= "number" then daily.streak = 0 end
	end

	-- v8: die zweite Fortschrittsachse (Promotion, Stat-Level, Charms).
	--
	-- Steht bewusst VOR der currentHp-Migration weiter unten: die rechnet mit
	-- CombatCalculator.getEffectiveStats, und das liest inzwischen genau diese
	-- Felder. Es kaeme auch ohne zurecht (es faengt fehlende Felder mit 0 ab),
	-- aber ein Spielstand soll die Migration nicht in halb fertigem Zustand
	-- durchlaufen — das ist die Art Reihenfolge-Abhaengigkeit, die man erst
	-- Monate spaeter bemerkt.
	--
	-- Erkennt fehlende Felder einzeln statt an der Versionsnummer und ist
	-- deshalb gefahrlos wiederholbar (dieselbe Konvention wie v2/v4/v5).
	for _, baerchi in island.baerchis do
		if baerchi.promotionLevel == nil then
			baerchi.promotionLevel = 0
		end

		if baerchi.statLevels == nil then
			baerchi.statLevels = PromotionConfig.newStatLevels()
		else
			-- Einzelne Stat-Schluessel nachruesten: `egg` kam als letzter dazu,
			-- und ein kuenftiger fuenfter Stat soll hier ebenfalls landen, ohne
			-- dass die ganze Tabelle ersetzt (und damit der Fortschritt
			-- geloescht) wird.
			local levels = baerchi.statLevels :: any
			for _, key in PromotionConfig.ALL_STATS do
				if levels[key] == nil then
					levels[key] = 0
				end
			end
		end

		if baerchi.charms == nil then
			baerchi.charms = {}
		else
			-- Nur gueltige Eintraege behalten. Ein Charm ohne Slot oder mit
			-- einem Stat-Typ, den es nicht mehr gibt (Pool-Aenderung), waere
			-- sonst ein stiller Rechenfehler in getEffectiveStats.
			local cleaned: { Types.Charm } = {}
			for _, charm in baerchi.charms do
				local slotOk = typeof(charm.slot) == "number"
					and charm.slot >= 1
					and charm.slot <= CharmConfig.SLOT_COUNT

				if slotOk and CharmConfig.getStatDef(charm.statId) then
					if charm.locked == nil then
						charm.locked = false
					end
					table.insert(cleaned, charm)
				end
			end
			table.sort(cleaned, function(a, b)
				return a.slot < b.slot
			end)
			baerchi.charms = cleaned
		end

		-- baseStatOverride bleibt absichtlich ungesetzt: nil heisst "Basiswerte
		-- kommen wie immer aus BaerchiConfig", und genau das gilt fuer jeden
		-- Baerchi, der vor dieser Version entstanden ist — auch fuer die
		-- damaligen Fusions-Ergebnisse (die haben ihren Vorteil ueber
		-- fusionBonus, nicht ueber die Basiswerte).

		-- ============================================================
		-- v9: DEF ist weg, PWR ist da, Inverted ist neu
		-- ============================================================
		-- Anders als alles darueber RAEUMT diese Migration etwas WEG. Ein
		-- statLevels.def oder ein baseStatOverride.def aus v8 zeigt auf einen
		-- Stat, den es nicht mehr gibt — stehen bleiben duerfte er trotzdem
		-- nicht: er landete beim naechsten Speichern wieder im DataStore und
		-- waere in einem Jahr ein Feld, das niemand mehr einordnen kann.
		--
		-- Der alte def-WERT wird NICHT in pwr uebertragen. Die beiden haben
		-- nichts miteinander zu tun (Schadensreduktion gegen Ability-Staerke),
		-- und ein Baerchi mit acht DEF-Stufen haette sonst still acht Stufen
		-- eines voellig anderen Stats geschenkt bekommen. pwr faengt bei 0 an.
		local statLevels = baerchi.statLevels :: any
		if statLevels.def ~= nil then
			statLevels.def = nil
		end
		if statLevels.pwr == nil then
			statLevels.pwr = 0
		end

		local override = baerchi.baseStatOverride :: any
		if override ~= nil then
			override.def = nil

			-- Ein Fusions-Ergebnis aus v8 hat einen gemischten Basiswert fuer
			-- hp/atk/spd, aber keinen fuer pwr (den Stat gab es noch nicht).
			-- nil ist hier genau richtig: getEffectiveStats faellt dann auf den
			-- pwr-Wert seines configId zurueck.
		end

		-- ============================================================
		-- v11: MUTATION-SYSTEM ERSETZT INVERTED
		-- ============================================================
		-- Das binaere isInverted-Feld weicht dem gestuften Mutation-System
		-- (siehe BaerchiConfig.MUTATIONS). Alte Spielstaende kannten hoechstens
		-- isInverted = true.
		--
		-- ANNAHME, nicht vom Projektinhaber vorgegeben: ein zuvor invertierter
		-- Baerchi wird auf die Mutation "Diamond" abgebildet (0.3% Wurf-Chance,
		-- damit nahe an der alten INVERTED_CHANCE von 0.5% — eine exakte
		-- Entsprechung gibt es nicht, weil das alte System nur eine einzige
		-- Stufe kannte). Wer eine andere Zuordnung will, ist das hier die
		-- einzige Stelle, die es aendern muss.
		--
		-- Erkennt das alte Feld selbst (ueber `any`, weil Types.Baerchi es seit
		-- v11 nicht mehr kennt) und ist deshalb gefahrlos wiederholbar: beim
		-- ersten Durchlauf wird das alte Feld entfernt, jeder weitere Durchlauf
		-- findet es dann bereits als nil vor und tut nichts mehr.
		local legacy = baerchi :: any
		if legacy.isInverted == true and baerchi.mutation == nil then
			baerchi.mutation = "Diamond"
		end
		legacy.isInverted = nil
	end

	-- v2: fusionBonus auf allen bestehenden Baerchis
	for _, baerchi in island.baerchis do
		if baerchi.fusionBonus == nil then
			baerchi.fusionBonus = 0
		end
		if baerchi.isFusionResult == nil then
			baerchi.isFusionResult = false
		end
	end

	-- v4: currentHp auf allen bestehenden Baerchis.
	-- Sie haben unter dem neuen System noch nicht gekaempft, starten also mit
	-- vollen HP. CombatCalculator wird dafuer bewusst hier requiret: es ist
	-- ein reines Rechenmodul ohne Zustand, und maxHp soll es nur EINE Formel
	-- im ganzen Projekt geben.
	for _, baerchi in island.baerchis do
		if baerchi.currentHp == nil then
			local baerchiDef = BaerchiConfig.getById(baerchi.configId)

			if baerchiDef then
				-- In pcall: getEffectiveStats rechnet mit level und
				-- fusionBonus. Fehlt einem uralten Eintrag eines davon, waere
				-- der Fehler sonst mitten im Join — und ein einziger kaputter
				-- Baerchi wuerde den ganzen Spielstand unbrauchbar machen.
				local ok, maxHp = pcall(function()
					return CombatCalculator.getEffectiveStats(baerchi, baerchiDef.baseStats).maxHp
				end)

				baerchi.currentHp = if ok then maxHp else 0
				if not ok then
					warn("[PlayerService] Kaputter Baerchi-Eintrag migriert:", baerchi.configId, maxHp)
				end
			else
				-- Unbekannter configId (Config-Eintrag entfernt): nicht raten,
				-- lieber erschoepft starten als mit erfundenen Werten.
				baerchi.currentHp = 0
			end
		end
	end

	-- ============================================================
	-- v16: SAMMEL-UPDATE 05.10. (eine gemeinsame Migration)
	-- ============================================================
	-- Nur Anlegen, keine Waehrung. Am Feld erkennbar und damit wiederholbar.
	--   island.stageBest   Rebirth nach Stage (Paket 4.1). Fuer Staende VOR
	--                      v16 aus towerProgress gesaeet (dort steht die
	--                      zuletzt BETRETENE Stage, geschafft ist eine
	--                      weniger) — wer kurz vor dem alten Gummy-Rebirth
	--                      stand, muss nicht bei null anfangen.
	--   island.incubator   Paket 8, Level 1, keine Eier
	--   indexClaimed       Paket 7, leer (rueckwirkend abholbar)
	--   specialClaimed     Paket 6.2, leer (SpecialMilestoneService zahlt
	--                      beim Join rueckwirkend aus)
	if typeof(island.stageBest) ~= "table" then
		local best: { [string]: number } = {}
		if (data.version or 0) < 16 and typeof(island.towerProgress) == "table" then
			for towerId, entered in island.towerProgress :: any do
				local n = (tonumber(entered) or 0) - 1
				if typeof(towerId) == "string" and n > 0 then
					best[towerId] = n
				end
			end
		end
		island.stageBest = best
	end
	local incubator = (island :: any).incubator
	if typeof(incubator) ~= "table" then
		island.incubator = { level = 1, slots = {}, breeders = {} }
	else
		if typeof(incubator.level) ~= "number" or incubator.level < 1 then incubator.level = 1 end
		if typeof(incubator.slots) ~= "table" then incubator.slots = {} end
		-- INCUBATOR_BREED: Liste der bruetenden Baerchis (fehlt in v16-Staenden)
		if typeof(incubator.breeders) ~= "table" then incubator.breeders = {} end
	end
	if typeof((data :: any).indexClaimed) ~= "table" then
		data.indexClaimed = {}
	end
	if typeof((data :: any).specialClaimed) ~= "table" then
		data.specialClaimed = {}
	end

	-- Zum Schluss die Versionsnummer nachziehen. Sie steuert heute keine der
	-- Migrationen oben — die pruefen alle einzeln auf fehlende Felder und
	-- laufen deshalb harmlos bei jedem Laden. Sie ist trotzdem wichtig: sobald
	-- eine kuenftige Migration NICHT mehr am Feld erkennbar ist (weil sie zum
	-- Beispiel Werte umrechnet statt welche anzulegen), ist diese Zahl der
	-- einzige Weg, sie nicht bei jedem Join erneut auszufuehren. Wer
	-- Types.createDefaultPlayerData um ein Feld erweitert, erhoeht sie dort.
	data.version = default.version
	return data
end

return PlayerMigration
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="Folder" referent="RBX37"><Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="Folder" referent="RBX38"><Properties>
<string name="Name">Controllers</string>
</Properties>
<Item class="ModuleScript" referent="RBX39"><Properties>
<string name="Name">CombController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- CombController.luau
-- StarterPlayerScripts/Controllers/CombController.luau
--
-- Einzige Zustaendigkeit:
--   - Alles, was der Spieler von den Honigwaben im Event-Pit und vom
--     Waben-Recycler SIEHT und ausloest:
--       1. Eine kleine Anzeige "Waben 12/25" (nur wenn er welche traegt)
--       2. Meldungen bei Abgabe und Recycler-Ausbau
--       3. Den Ausbau-Prompt am EIGENEN Recycler
--       4. Das Wippen und Drehen der im Pit liegenden Waben
--
-- Die Wahrheit liegt komplett auf dem Server (CombService, CombRecyclerService):
-- was getragen wird, kommt ueber Player-Attribute ("CombsCarried"/"CombsMax"),
-- Level und Warteschlange des Recyclers ueber PlayerDataUpdated. Dieser Controller
-- rechnet nichts und entscheidet nichts.
--
-- Der Prompt entsteht auf dem Client, nur am eigenen Plot — dasselbe Muster wie
-- die Gebaeude-Prompts im WorldController (der Server wendet die Anfrage ohnehin
-- immer auf die Daten des anfragenden Spielers an).

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local MapConfig  = require(ReplicatedStorage.Config.MapConfig)
local Remotes    = require(ReplicatedStorage.Network.Remotes)
local Loc        = require(ReplicatedStorage.Localization.Loc)
local FeedbackConfig = require(ReplicatedStorage.Config.FeedbackConfig)

local Theme       = require(script.Parent.Parent.UI.Theme)
local Toast       = require(script.Parent.Parent.UI.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify      = require(script.Parent.Parent.UI.Notify)
local Feedback    = require(script.Parent.Parent.UI.Feedback)
local ClientState = require(script.Parent.ClientState)

local CombController = {}

local localPlayer = Players.LocalPlayer

local WORLD_FOLDER_NAME = "EventPitCombs"
local OWNER_ATTRIBUTE   = "PlotOwner"
local PROMPT_NAME       = "UpgradeRecycler"
local PROMPT_DISTANCE   = 14
-- 08.10. (Paket G): ein Druck statt Halten; gegen Doppelkauf sperrt sich der
-- Prompt danach kurz (FeedbackConfig.UPGRADE_FX.PROMPT_LOCK).
local PROMPT_HOLD       = 0

-- Wippen und Drehen der Waben im Pit (rein optisch, nur auf diesem Client)
local BOB_HEIGHT = 0.32
local BOB_RATE   = 2.0    -- Schwingungen pro Sekunde (in Radiant: * 1)
local SPIN_RATE  = 0.9    -- Radiant pro Sekunde

--------------------------------------------------------------------------------
-- Anzeige "Waben x/y"
--------------------------------------------------------------------------------

local _pill: Frame? = nil
local _carryLabel: TextLabel? = nil
local _hintLabel: TextLabel? = nil

local function isInPit(): boolean
	local character = localPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not root or not root:IsA("BasePart") then return false end

	local flat = Vector3.new(
		root.Position.X - MapConfig.CENTER.X,
		0,
		root.Position.Z - MapConfig.CENTER.Z
	)
	return flat.Magnitude <= MapConfig.EVENT_PIT_RADIUS
end

local function refreshCarry()
	local pill, carryLabel, hint = _pill, _carryLabel, _hintLabel
	if not pill or not carryLabel or not hint then return end

	local count = localPlayer:GetAttribute("CombsCarried")
	local max   = localPlayer:GetAttribute("CombsMax")
	if typeof(count) ~= "number" or typeof(max) ~= "number" or count <= 0 then
		pill.Visible = false
		return
	end

	pill.Visible = true
	carryLabel.Text = Loc.t("ui.comb.carry", { n = count, max = max })

	if count >= max then
		hint.Text = Loc.t("ui.comb.full")
		hint.TextColor3 = Theme.COLORS.goldGummy
	elseif isInPit() then
		hint.Text = Loc.t("ui.comb.slow")
		hint.TextColor3 = Theme.COLORS.textDim
	else
		hint.Text = ""
	end
end

local function buildPill(screenGui: ScreenGui)
	local pill = Theme.panel("CombPill", screenGui, Theme.COLORS.panel)
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.Position    = UDim2.new(0.5, 0, 0, 12)
	pill.Size        = UDim2.new(0, 250, 0, 54)
	pill.Visible     = false

	local carry = Theme.label("Carry", pill, "")
	carry.Position       = UDim2.new(0, 10, 0, 4)
	carry.Size           = UDim2.new(1, -20, 0, 26)
	carry.TextXAlignment = Enum.TextXAlignment.Center
	carry.TextColor3     = Theme.COLORS.goldGummy

	local hint = Theme.bodyText("Hint", pill, "")
	hint.Position       = UDim2.new(0, 10, 0, 30)
	hint.Size           = UDim2.new(1, -20, 0, 20)
	hint.TextXAlignment = Enum.TextXAlignment.Center

	_pill        = pill
	_carryLabel  = carry
	_hintLabel   = hint
end

--------------------------------------------------------------------------------
-- Recycler-Prompt (nur am eigenen Plot)
--------------------------------------------------------------------------------

local function findPlotOwner(instance: Instance): number?
	local current: Instance? = instance
	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner
		end
		current = current.Parent
	end
	return nil
end

local function costText(level: number): string
	local cost = CombConfig.getUpgradeCost(level + 1)
	if not cost then
		return Loc.t("ui.recycler.maxed")
	end

	local text = if cost.goldGummies > 0
		then Loc.t("ui.recycler.cost_gg", { gummies = Theme.formatNumber(cost.gummies), gold = cost.goldGummies })
		else Loc.t("ui.recycler.cost_g", { gummies = Theme.formatNumber(cost.gummies) })

	return Loc.t("ui.recycler.upgrade", { cost = text })
end

local _locked: { [ProximityPrompt]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function writePrompt(prompt: ProximityPrompt)
	local data = ClientState.get()
	local level = if data then data.island.recycler.level else 1

	prompt.ObjectText = string.format("%s  Lv.%d", Loc.t("ui.recycler.name"), level)

	if level >= CombConfig.RECYCLER_MAX_LEVEL then
		prompt.ActionText = Loc.t("ui.recycler.maxed")
		prompt.Enabled    = false
	else
		-- Reicht es nicht, steht im Prompt, wie viel fehlt (ausgrauen kann der
		-- Standard-Prompt nicht); der Server lehnt einen Druck dann ab.
		local cost = CombConfig.getUpgradeCost(level + 1)
		local missing = if cost and data then cost.gummies - data.gummies else 0
		prompt.ActionText = if missing > 0
			then Loc.t("ui.upgrade.prompt_need", { missing = Theme.formatNumber(missing) })
			else costText(level)
		prompt.Enabled    = not _locked[prompt]
	end
end

local _prompts: { ProximityPrompt } = {}

local function attachPrompt(body: BasePart)
	if body:FindFirstChild(PROMPT_NAME) then return end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = PROMPT_NAME
	prompt.KeyboardKeyCode       = Enum.KeyCode.E
	prompt.HoldDuration          = PROMPT_HOLD
	prompt.MaxActivationDistance = PROMPT_DISTANCE
	prompt.RequiresLineOfSight   = false
	prompt.Parent                = body

	prompt.Triggered:Connect(function()
		if _locked[prompt] then return end
		_locked[prompt] = true
		prompt.Enabled = false
		Remotes.RequestUpgradeRecycler:FireServer()
		task.delay(FeedbackConfig.UPGRADE_FX.PROMPT_LOCK, function()
			_locked[prompt] = nil
			if prompt.Parent then writePrompt(prompt) end
		end)
	end)

	table.insert(_prompts, prompt)
	prompt.Destroying:Connect(function()
		local index = table.find(_prompts, prompt)
		if index then table.remove(_prompts, index) end
	end)

	writePrompt(prompt)
end

local function hookWorldPart(instance: Instance)
	if not instance:IsA("BasePart") then return end
	if instance.Name ~= CombConfig.RECYCLER_NAME then return end

	local function tryAttach()
		if findPlotOwner(instance) == localPlayer.UserId then
			attachPrompt(instance)
			return true
		end
		return false
	end

	if tryAttach() then return end

	-- Replikation ist nicht sortiert: das Plot-Model kann beim Client ankommen,
	-- bevor sein Besitzer-Attribut da ist. Einmal im naechsten Frame nachsehen.
	task.defer(function()
		if instance.Parent then
			tryAttach()
		end
	end)
end

--------------------------------------------------------------------------------
-- Waben im Pit: Wippen und Drehen
--------------------------------------------------------------------------------

-- `fly` = Einflug (Vulkan-Ausbruch, Waben-Regen): von `from` zur Ruhelage
-- zwischen den Serverzeiten `start` und `finish` (Attribute FlyFrom/FlyStart/FlyEnd).
type Fly = { from: Vector3, start: number, finish: number }
type Bob = { base: CFrame?, phase: number, spawnTime: number, fly: Fly? }

local _bobbing: { [Model]: Bob } = {}

-- Wie oft trackComb auf fehlende Attribute wartet (je ein Frame), bevor die
-- Wabe aufgegeben wird. Attribute kommen mit dem Model selbst an; das ist nur
-- ein Sicherheitsnetz.
local BASE_RETRY_FRAMES = 6

-- Auftauch-Effekt frisch gespawnter Waben: steigt aus dem Boden und federt nach.
local POP_SECONDS = 0.45
local POP_DEPTH   = 1.6

-- Baut die Ruhelage aus den Attributen "Pos"/"Yaw" (CombBuilder.buildWorldComb).
-- NIE aus GetPivot(): siehe Kopf von buildWorldComb.
local function readBase(model: Model): CFrame?
	local pos = model:GetAttribute("Pos")
	local yaw = model:GetAttribute("Yaw")
	if typeof(pos) ~= "Vector3" or typeof(yaw) ~= "number" then
		return nil
	end
	return CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
end

local function trackComb(child: Instance)
	if not child:IsA("Model") then return end
	local model = child :: Model

	local phase = model:GetAttribute("Phase")
	local spawnTime = model:GetAttribute("SpawnTime")
	local flyFrom   = model:GetAttribute("FlyFrom")
	local flyStart  = model:GetAttribute("FlyStart")
	local flyEnd    = model:GetAttribute("FlyEnd")
	local fly: Fly? = nil
	if typeof(flyFrom) == "Vector3" and typeof(flyStart) == "number" and typeof(flyEnd) == "number" then
		fly = { from = flyFrom, start = flyStart, finish = flyEnd }
	end
	local bob: Bob = {
		base      = readBase(model),
		phase     = if typeof(phase) == "number" then phase else 0,
		-- Fliegende Waben tauchen nicht zusaetzlich aus dem Boden auf.
		spawnTime = if fly then 0 elseif typeof(spawnTime) == "number" then spawnTime else 0,
		fly       = fly,
	}
	_bobbing[model] = bob

	if bob.base then return end

	-- Sicherheitsnetz: Attribute fehlen noch. Ein paar Frames nachsehen, bis
	-- dahin ueberspringt animateCombs diese Wabe (kein PivotTo mit Identitaet).
	task.spawn(function()
		for _ = 1, BASE_RETRY_FRAMES do
			task.wait()
			if _bobbing[model] ~= bob then return end
			local base = readBase(model)
			if base then
				bob.base = base
				return
			end
		end
	end)
end

local function hookWorldFolder(folder: Instance)
	for _, child in folder:GetChildren() do
		trackComb(child)
	end
	folder.ChildAdded:Connect(trackComb)
	folder.ChildRemoved:Connect(function(child)
		if child:IsA("Model") then
			_bobbing[child] = nil
		end
	end)
end

-- Versatz nach unten waehrend des Auftauchens (0 = fertig). Ueberschwingt kurz.
local function popOffset(now: number, spawnTime: number): number
	local age = now - spawnTime
	if spawnTime <= 0 or age >= POP_SECONDS or age < 0 then return 0 end
	local k = age / POP_SECONDS
	-- 1 → 0 mit kleinem Ueberschwinger (Back-Ease-Out)
	local c = 1.7
	local eased = 1 + (c + 1) * (k - 1) ^ 3 + c * (k - 1) ^ 2
	return -POP_DEPTH * (1 - eased)
end

-- Einflug: Bogen von `from` zur Ruhelage, Hoehe CombConfig.FLIGHT_ARC_HEIGHT.
-- nil = Flug ist vorbei (oder hat noch nicht begonnen und die Wabe wartet oben).
local function flyPosition(fly: Fly, landing: Vector3, now: number): Vector3?
	if now >= fly.finish then return nil end
	local span = math.max(0.05, fly.finish - fly.start)
	local k = math.clamp((now - fly.start) / span, 0, 1)
	local arc = 4 * k * (1 - k) * CombConfig.FLIGHT_ARC_HEIGHT
	return fly.from:Lerp(landing, k) + Vector3.new(0, arc, 0)
end

local function animateCombs()
	local t = os.clock()
	local serverNow = Workspace:GetServerTimeNow()
	for model, bob in _bobbing do
		local base = bob.base
		local fly = bob.fly
		if base and fly and model.Parent then
			local pos = flyPosition(fly, base.Position, serverNow)
			if pos then
				model:PivotTo(CFrame.new(pos) * CFrame.Angles(t * 6, t * SPIN_RATE * 3, 0))
				continue
			end
			bob.fly = nil
		end
		if base and model.Parent then
			local lift = math.sin(t * BOB_RATE + bob.phase) * BOB_HEIGHT + popOffset(serverNow, bob.spawnTime)
			model:PivotTo(base * CFrame.new(0, lift, 0) * CFrame.Angles(0, t * SPIN_RATE + bob.phase, 0))
		end
	end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function CombController.init(screenGui: ScreenGui)
	buildPill(screenGui)

	for _, name in { "CombsCarried", "CombsMax" } do
		localPlayer:GetAttributeChangedSignal(name):Connect(refreshCarry)
	end
	refreshCarry()

	-- "Im Pit" aendert sich ohne Attribut-Aenderung, deshalb ein gemuetlicher
	-- Takt fuer den Hinweistext.
	task.spawn(function()
		while true do
			task.wait(0.4)
			refreshCarry()
		end
	end)

	Remotes.CombDelivered.OnClientEvent:Connect(function(count: any, _units: any)
		if typeof(count) ~= "number" then return end
		Notify.emit("comb_delivered", function()
			Toast.success(Loc.tn("msg.comb_delivered", count))
		end, function()
			Feedback.gain("comb", count)
		end)
	end)

	Remotes.RecyclerUpgraded.OnClientEvent:Connect(function(level: any)
		if typeof(level) ~= "number" then return end
		Notify.emit("recycler_upgraded", function()
			Toast.success(Loc.t("msg.recycler_upgraded", { level = level }))
		end, function()
			-- Paket G: den Moment zeigt UI/UpgradeFX am Recycler selbst
			-- (aus dem Datenstand) — hier kein zweites "⬆" ueber dem Spieler.
		end)
	end)

	-- Prompt-Text nachziehen, wenn sich Level/Gummies aendern oder die Sprache
	ClientState.onChanged(function()
		for _, prompt in _prompts do
			writePrompt(prompt)
		end
	end)
	Loc.onChanged(function()
		for _, prompt in _prompts do
			writePrompt(prompt)
		end
		refreshCarry()
	end)

	for _, descendant in Workspace:GetDescendants() do
		hookWorldPart(descendant)
	end
	Workspace.DescendantAdded:Connect(hookWorldPart)

	local existing = Workspace:FindFirstChild(WORLD_FOLDER_NAME)
	if existing then
		hookWorldFolder(existing)
	end
	Workspace.ChildAdded:Connect(function(child)
		if child.Name == WORLD_FOLDER_NAME then
			hookWorldFolder(child)
		end
	end)

	RunService.RenderStepped:Connect(animateCombs)

	print("[CombController] Initialisiert")
end

return CombController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX40"><Properties>
<string name="Name">GuideController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- GuideController.luau
-- StarterPlayerScripts/Controllers/GuideController.luau
--
-- Einzige Zustaendigkeit:
--   - Den aktuellen Fuehrungsschritt (Modules/GuideSteps) sichtbar machen:
--     Ziel in der Welt → leuchtender Beam vom Charakter zum Ziel,
--     Ziel in der Oberflaeche → pulsierender Rahmen und Pfeil am Knopf
--
-- Kontext: HBB Paket 2. Kein Text, hoechstens ein Icon. Passiert eine Weile
-- nichts (FeedbackConfig/GUIDE_HINT_SECONDS), wird die Hervorhebung staerker
-- ("Timed Hint").
--
-- Alles hier ist rein lokal: der Beam, die Attachments und der Rahmen
-- existieren nur auf diesem Client, ohne Kollision und ohne Remote.
--
-- Mit FeatureFlags.UI_V2_GUIDE = false zeigt dieses Modul nichts.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local GuideSteps   = require(ReplicatedStorage.Modules.GuideSteps)
local EggConfig    = require(ReplicatedStorage.Config.EggConfig)
local Loc          = require(ReplicatedStorage.Localization.Loc)   -- Sammel-Update 3.5
local PanelManager = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("PanelManager"))

local UI          = script.Parent.Parent:WaitForChild("UI")
local Theme       = require(UI:WaitForChild("Theme"))
local UiScale     = require(UI:WaitForChild("UiScale"))
local MenuBar     = require(UI:WaitForChild("MenuBar"))
local PetBar      = require(UI:WaitForChild("PetBar"))
local TowerPanel  = require(UI:WaitForChild("TowerPanel"))          -- 08.10. Schritt "tower"
local TerminalController = require(script.Parent.TerminalController)
local ClientState = require(script.Parent.ClientState)

local GuideController = {}

-- Nach so vielen Sekunden ohne Fortschritt wird die Hervorhebung staerker.
local HINT_AFTER_SECONDS = 12

-- Sammel-Update 05.10.:
-- 3.1 groessere Pfeile (vorher 40 px, Wippen 8/18 px)
local ARROW_SIZE   = 84
local ARROW_BOUNCE = 16
local ARROW_BOUNCE_STRONG = 30
-- 3.2 der Event-Schritt ist am Anfang unwichtig: er zeigt sich nur so lange
-- und verschwindet dann (bis zum naechsten Join).
local EVENT_STEP_SECONDS = 8
-- 3.5 ein Satz, was der Schritt bringt (Schluessel "guide.<step>")
local HINT_WIDTH = 300
local HIGHLIGHT_COLOR = Color3.fromRGB(255, 236, 140)
local BEAM_COLOR      = Color3.fromRGB(255, 220, 90)
local LAID_EGG_ATTRIBUTE = "LaidEggUid"

local _step: string? = nil
local _stepSince = 0
-- Welt-Ziel, im Takt von evaluate() gesucht (nicht jeden Frame: die Suche
-- laeuft ueber den Workspace)
local _worldTarget: BasePart? = nil

local _frame: Frame? = nil
local _stroke: UIStroke? = nil
local _arrow: TextLabel? = nil
local _hint: TextLabel? = nil

local _beam: Beam? = nil
local _from: Attachment? = nil
local _to: Attachment? = nil

--------------------------------------------------------------------------------
-- Ziele
--------------------------------------------------------------------------------

local function uiTarget(step: string): GuiObject?
	if step == "hatch" then
		return MenuBar.getTileAnchor("Hatch")
	elseif step == "fight" then
		return PetBar.getButton("Fight")
	elseif step == "event" then
		return PetBar.getButton("Event")
	elseif step == "tower" then
		-- 08.10.: im offenen Tower-Panel der Waehlen-Knopf von Tower II;
		-- sonst zeigt der Strahl zum Terminal (worldTarget)
		return TowerPanel.getGuideTarget()
	elseif step == "upgrade" then
		-- HUD_ROW_V2: keine Kachel mehr, der Strahl zeigt zum Brunnen (worldTarget)
		if FeatureFlags.isOn("HUD_ROW_V2") then return nil end
		-- Sammel-Update 3.5: Gebaeude-Kachel rechts
		return MenuBar.getTileAnchor(PanelManager.buildingPanelName(
			if FeatureFlags.isOn("HONEY_POND_V2") then "HoneyPond" else "HoneyRefiner"))
	end
	return nil
end

local function characterRoot(): BasePart?
	local character = Players.LocalPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	return if root and root:IsA("BasePart") then root else nil
end

-- Naechstes EIGENES gelegtes Ei (uid steht in den eigenen Daten).
local function nearestOwnEgg(): BasePart?
	local data = ClientState.get()
	local root = characterRoot()
	if not data or not root then return nil end
	local own: { [string]: boolean } = {}
	for _, egg in data.island.laidEggs do
		own[(egg :: any).uid] = true
	end
	local best: BasePart? = nil
	local bestDist = math.huge
	for _, descendant in Workspace:GetDescendants() do
		if descendant:IsA("BasePart") then
			local uid = descendant:GetAttribute(LAID_EGG_ATTRIBUTE)
			if typeof(uid) == "string" and own[uid] then
				local dist = (descendant.Position - root.Position).Magnitude
				if dist < bestDist then
					best, bestDist = descendant, dist
				end
			end
		end
	end
	return best
end

-- Theke des Ei-Haendlers (EggMerchantService baut das Model "EggMerchant")
local function merchantCounter(): BasePart?
	local model = Workspace:FindFirstChild("EggMerchant")
	local counter = if model then model:FindFirstChild("Counter") else nil
	return if counter and counter:IsA("BasePart") then counter else nil
end

-- Recycler auf dem EIGENEN Plot (Attribut PlotOwner am Plot-Model).
local function ownRecycler(): BasePart?
	for _, descendant in Workspace:GetDescendants() do
		if descendant.Name == "Recycler" and descendant:IsA("BasePart") then
			local model = descendant.Parent
			if model and model:GetAttribute("PlotOwner") == Players.LocalPlayer.UserId then
				return descendant
			end
		end
	end
	return nil
end

-- HUD_ROW_V2: Honig-Gebaeude auf dem EIGENEN Plot (Prompt "Verbessern").
local function ownHoneyBuilding(): BasePart?
	local id = if FeatureFlags.isOn("HONEY_POND_V2") then "HoneyPond" else "HoneyRefiner"
	for _, descendant in Workspace:GetDescendants() do
		if descendant.Name == id and descendant:IsA("BasePart") then
			local current: Instance? = descendant
			while current do
				local owner = current:GetAttribute("PlotOwner")
				if typeof(owner) == "number" then
					if owner == Players.LocalPlayer.UserId then return descendant end
					break
				end
				current = current.Parent
			end
		end
	end
	return nil
end

local function worldTarget(step: string): BasePart?
	if step == "tower" then
		if TowerPanel.isOpen() then return nil end
		return TerminalController.getOwnScreen()
	end
	if step == "upgrade" and FeatureFlags.isOn("HUD_ROW_V2") then
		return ownHoneyBuilding()
	elseif step == "collect" then
		return nearestOwnEgg()
	elseif step == "merchant" then
		return merchantCounter()
	elseif step == "combs" then
		-- Sammel-Update 3.5: mit Waben auf dem Kopf zum eigenen Recycler,
		-- sonst zu den Waben in die Mitte.
		local carried = Players.LocalPlayer:GetAttribute("CombsCarried")
		if typeof(carried) == "number" and carried > 0 then
			return ownRecycler()
		end
		local pit = Workspace:FindFirstChild("EventFloor", true)
		return if pit and pit:IsA("BasePart") then pit else nil
	end
	return nil
end

--------------------------------------------------------------------------------
-- Darstellung
--------------------------------------------------------------------------------

local function clearBeam()
	if _beam then _beam:Destroy() end
	if _from then _from:Destroy() end
	if _to then _to:Destroy() end
	_beam, _from, _to = nil, nil, nil
end

local function showBeam(target: BasePart)
	local root = characterRoot()
	if not root then
		clearBeam()
		return
	end
	if _to and _to.Parent == target and _from and _from.Parent == root then
		return
	end
	clearBeam()
	local from = Instance.new("Attachment")
	from.Name = "GuideFrom"
	from.Parent = root
	local to = Instance.new("Attachment")
	to.Name = "GuideTo"
	to.Position = Vector3.new(0, 1, 0)
	to.Parent = target
	local beam = Instance.new("Beam")
	beam.Name = "GuideBeam"
	beam.Attachment0 = from
	beam.Attachment1 = to
	beam.Color = ColorSequence.new(BEAM_COLOR)
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Width0 = 0.5
	beam.Width1 = 0.5
	beam.Segments = 12
	beam.CurveSize0 = 4
	beam.Transparency = NumberSequence.new(0.15)
	beam.Parent = root
	_beam, _from, _to = beam, from, to
end

local function hideHighlight()
	if _frame then _frame.Visible = false end
	if _arrow then _arrow.Visible = false end
end

-- Sammel-Update 3.5: Satz zum Schritt, unten mittig ueber der Pet-Leiste.
local function showHint(step: string?)
	local hint = _hint
	if not hint then return end
	local key = if step then "guide." .. step else nil
	if key and Loc.has(key) then
		hint.Text = Loc.t(key)
		hint.Visible = true
	else
		hint.Visible = false
	end
end

local function showHighlight(target: GuiObject, strong: boolean, t: number)
	local frame, stroke, arrow = _frame, _stroke, _arrow
	if not frame or not stroke or not arrow then return end
	if not target.Visible then
		hideHighlight()
		return
	end
	-- Bildschirm-Pixel -> Oberflaechen-Einheiten (globale UiScale)
	local pos, size = UiScale.toGui(target.AbsolutePosition), UiScale.toGui(target.AbsoluteSize)
	local pad = 6
	frame.Position = UDim2.fromOffset(pos.X - pad, pos.Y - pad)
	frame.Size = UDim2.fromOffset(size.X + pad * 2, size.Y + pad * 2)
	frame.Visible = true

	local wave = (math.sin(t * (if strong then 9 else 5)) + 1) * 0.5
	stroke.Thickness = (if strong then 5 else 3) + wave * (if strong then 4 else 2)
	stroke.Transparency = 0.1 + (1 - wave) * 0.4

	-- Pfeil zeigt von oben auf den Knopf (die Kachelleiste rechts: von links)
	local screen = frame.Parent :: GuiObject
	local fromLeft = pos.X > UiScale.toGui(screen.AbsoluteSize.X) * 0.8
	local bounce = wave * (if strong then ARROW_BOUNCE_STRONG else ARROW_BOUNCE)
	arrow.Visible = true
	if fromLeft then
		-- "➡" statt "➜": "➜" kann die Spielschrift nicht darstellen.
		arrow.Text = "➡"
		arrow.Position = UDim2.fromOffset(pos.X - ARROW_SIZE - 6 - bounce, pos.Y + size.Y * 0.5 - ARROW_SIZE * 0.5)
	else
		arrow.Text = "⬇"
		arrow.Position = UDim2.fromOffset(pos.X + size.X * 0.5 - ARROW_SIZE * 0.5, pos.Y - ARROW_SIZE - 6 - bounce)
	end
end

--------------------------------------------------------------------------------
-- Takt
--------------------------------------------------------------------------------

local function evaluate()
	local data = ClientState.get()
	local step: string? = nil
	if data and FeatureFlags.isOn("UI_V2_GUIDE") then
		-- HBB Paket 5: Haendler-Schritt nur mit sichtbarem Haendler
		local options = if FeatureFlags.isOn("MAP_V2_MERCHANT")
			then { merchantPrice = EggConfig.MERCHANT.priceGummies }
			else nil
		step = GuideSteps.current(data :: any, options)
	end
	if step ~= _step then
		_step = step
		_stepSince = os.clock()
	end
	_worldTarget = if step then worldTarget(step) else nil
end

local function render()
	local step = _step
	local now = os.clock()
	-- Sammel-Update 3.2: Event-Schritt nur kurz
	if step == "event" and now - _stepSince > EVENT_STEP_SECONDS then
		step = nil
	end
	showHint(step)
	if not step then
		hideHighlight()
		clearBeam()
		return
	end
	local strong = now - _stepSince >= HINT_AFTER_SECONDS

	local target = uiTarget(step)
	if target then
		clearBeam()
		showHighlight(target, strong, now)
		return
	end
	hideHighlight()

	local part = _worldTarget
	if part and part.Parent then
		showBeam(part)
		local beam = _beam
		if beam then
			local w = if strong then 0.9 + math.sin(now * 8) * 0.3 else 0.5
			beam.Width0, beam.Width1 = w, w
		end
	else
		clearBeam()
	end
end

function GuideController.init(screenGui: ScreenGui)
	local frame = Theme.container("GuideHighlight", screenGui)
	frame.ZIndex = 40
	frame.Visible = false
	Theme.corner(frame, 16)
	local stroke = Instance.new("UIStroke")
	stroke.Color = HIGHLIGHT_COLOR
	stroke.Thickness = 3
	stroke.Parent = frame
	_frame, _stroke = frame, stroke

	local arrow = Theme.label("GuideArrow", screenGui, "⬇")
	arrow.Size = UDim2.fromOffset(ARROW_SIZE, ARROW_SIZE)
	local arrowLimit = arrow:FindFirstChildOfClass("UITextSizeConstraint")
	if arrowLimit then arrowLimit.MaxTextSize = ARROW_SIZE end
	arrow.TextXAlignment = Enum.TextXAlignment.Center
	arrow.TextColor3 = HIGHLIGHT_COLOR
	arrow.ZIndex = 41
	arrow.Visible = false
	Theme.outlineText(arrow, 3)
	_arrow = arrow

	-- Sammel-Update 3.5: ein Satz pro Schritt
	local hint = Theme.label("GuideHint", screenGui, "")
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position = UDim2.new(0.5, 0, 1, -112)
	hint.Size = UDim2.fromOffset(HINT_WIDTH, 44)
	hint.TextXAlignment = Enum.TextXAlignment.Center
	hint.TextWrapped = true
	hint.TextColor3 = HIGHLIGHT_COLOR
	hint.ZIndex = 41
	hint.Visible = false
	Theme.outlineText(hint, 2)
	_hint = hint
	Loc.onChanged(function() showHint(_step) end)

	ClientState.onChanged(function()
		evaluate()
	end)

	-- Gelegte Eier tauchen ohne Datenaenderung auf/ab (Replikation): der
	-- Welt-Schritt wird deshalb im Takt neu gesucht, die Anzeige jeden Frame.
	local accumulator = 0
	RunService.RenderStepped:Connect(function(delta)
		accumulator += delta
		if accumulator >= 0.5 then
			accumulator = 0
			evaluate()
		end
		render()
	end)

	print("[GuideController] Initialisiert")
end

return GuideController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX41"><Properties>
<string name="Name">TerminalController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- TerminalController.luau
-- StarterPlayerScripts/Controllers/TerminalController.luau
--
-- Einzige Zustaendigkeit:
--   - Das Tower-Terminal an der Bruecke (08.10., Paket B2) lebendig machen:
--     Bildschirm (SurfaceGui, in der Sprache des Betrachters), Lampenfarbe
--     und Blinken, "!"-Marker, und am EIGENEN Terminal der Prompt
--     "Tower waehlen", der das Tower-Panel oeffnet.
--
-- Der Server baut das Terminal einmal (TerminalBuilder) und schreibt nur
-- Attribute (State, Tower, Record, NextTower, NewTower, Progress, Needed). Hier wird
-- daraus Text und Licht — ohne Neubau, ohne Emitter, ohne Light-Instanz
-- (Neon + Bloom). Eine Heartbeat-Schleife fuer das Blinken aller Terminals.
--
-- Zustaende (TowerConfig.terminalState):
--   locked  Bildschirm dunkel mit Schloss und "Tower I 12/30", Lampe rot;
--           der Prompt oeffnet nichts, sondern zeigt einen Hinweis
--   ready   Bildschirm leuchtet "NEU: Tower II!", Lampe gruen blinkend, "!"
--   normal  ruhig, zeigt den gewaehlten Tower und den Rekord

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Loc          = require(ReplicatedStorage.Localization.Loc)
local MapConfig    = require(ReplicatedStorage.Config.MapConfig)
local TowerConfig  = require(ReplicatedStorage.Config.TowerConfig)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local UI           = script.Parent.Parent:WaitForChild("UI")
local Theme        = require(UI:WaitForChild("Theme"))
local Kit          = require(UI:WaitForChild("Kit"))
local Icons        = require(UI:WaitForChild("Icons"))
local Notify       = require(UI:WaitForChild("Notify"))
local Toast        = require(UI:WaitForChild("Toast"))
local PanelManager = require(UI:WaitForChild("PanelManager"))

local TerminalController = {}

local MODEL_NAME = "TowerTerminal"
local CFG = MapConfig.TOWER_TERMINAL
local T = Kit.T

type View = {
	model   : Model,
	screen  : SurfaceGui,
	bg      : Frame,
	badgeHolder : Frame,
	lock    : GuiObject,
	title   : TextLabel,
	line    : TextLabel,
	bar     : Kit.Progress,
	lamp    : BasePart?,
	marker  : BillboardGui,
	prompt  : ProximityPrompt?,
	badgeKey: string,
}

local _views: { [Model]: View } = {}

local function isOwn(model: Model): boolean
	local plot = model.Parent
	return plot ~= nil and plot:GetAttribute("PlotOwner") == Players.LocalPlayer.UserId
end

local function attr(model: Model, name: string, default: any): any
	local value = model:GetAttribute(name)
	return if value == nil then default else value
end

local function towerName(id: string): string
	return Loc.t("tower." .. id .. ".name")
end

local function write(view: View)
	local model = view.model
	local state = attr(model, "State", "locked") :: string
	local towerId = attr(model, "Tower", "I") :: string
	local record = attr(model, "Record", 0) :: number
	local nextTower = attr(model, "NextTower", "") :: string
	local progress = attr(model, "Progress", 0) :: number
	local needed = attr(model, "Needed", 0) :: number
	local def = TowerConfig.get(towerId) or TowerConfig.TOWERS[1]

	-- Abzeichen nur neu bauen, wenn sich Tower oder Zustand aendern
	local key = state .. ":" .. def.id
	if view.badgeKey ~= key then
		view.badgeKey = key
		for _, child in view.badgeHolder:GetChildren() do child:Destroy() end
		local shown = if state == "locked" then (TowerConfig.get(nextTower) or def) else def
		local badge = Kit.towerBadge("Badge", view.badgeHolder, shown.look, shown.color, shown.numeral, 150)
		badge.Size = UDim2.fromScale(1, 1)
		badge.ZIndex = 3
	end

	view.lock.Visible = state == "locked"
	if state == "locked" then
		local prev = TowerConfig.UNLOCK_AFTER[nextTower] or TowerConfig.FIRST_TOWER
		view.title.Text = Loc.t("ui.terminal.screen_locked")
		view.title.TextColor3 = Color3.fromRGB(255, 120, 120)
		view.line.Text = Loc.t("ui.terminal.screen_unlock_by", { tower = towerName(prev) })
		view.bar.track.Visible = true
		view.bar.set(if needed > 0 then progress / needed else 0, string.format("%d/%d", progress, needed))
		view.bg.BackgroundColor3 = Color3.fromRGB(28, 22, 36)
	elseif state == "ready" then
		local newId = attr(model, "NewTower", towerId) :: string
		view.title.Text = Loc.t("ui.terminal.screen_new", { tower = towerName(newId) })
		view.title.TextColor3 = Color3.fromRGB(140, 255, 150)
		view.line.Text = Loc.t("ui.terminal.prompt_action")
		view.bar.track.Visible = false
		view.bg.BackgroundColor3 = Theme.shade(def.color, -0.55)
	else
		view.title.Text = towerName(def.id)
		view.title.TextColor3 = T.color.white
		view.line.Text = if def.id == "Endless"
			then Loc.t("ui.tower2.record_endless", { record = record })
			else Loc.t("ui.tower2.record", { record = record, stages = def.stages })
		view.bar.track.Visible = def.id ~= "Endless"
		view.bar.set(record / math.max(1, def.stages), "")
		view.bg.BackgroundColor3 = Theme.shade(def.color, -0.6)
	end

	view.marker.Enabled = state == "ready" and isOwn(model)

	local prompt = view.prompt
	if prompt then
		if state == "locked" then
			local prev = TowerConfig.UNLOCK_AFTER[nextTower] or TowerConfig.FIRST_TOWER
			prompt.ActionText = Loc.t("ui.terminal.prompt_locked", { tower = towerName(prev), have = progress, need = needed })
		else
			prompt.ActionText = Loc.t("ui.terminal.prompt_action")
		end
		prompt.ObjectText = Loc.t("ui.terminal.prompt_object")
	end
end

local function buildScreen(model: Model): View?
	local screenPart = model:FindFirstChild(CFG.screenPart)
	if not screenPart or not screenPart:IsA("BasePart") then return nil end

	local gui = Instance.new("SurfaceGui")
	gui.Name = "TerminalScreen"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = CFG.screenPixels
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.MaxDistance = 120
	gui.Adornee = screenPart
	gui.Parent = screenPart

	local bg = Kit.frame("Bg", gui, Color3.fromRGB(28, 22, 36))
	bg.Size = UDim2.fromScale(1, 1)
	local glow = Instance.new("UIGradient")
	glow.Rotation = 90
	glow.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150))
	glow.Parent = bg

	local badgeHolder = Kit.frame("BadgeHolder", bg)
	badgeHolder.AnchorPoint = Vector2.new(0, 0.5)
	badgeHolder.Position = UDim2.new(0, 24, 0.5, 0)
	badgeHolder.Size = UDim2.fromOffset(150, 150)

	local lock = Icons.make(badgeHolder, "lock", "🔒")
	lock.AnchorPoint = Vector2.new(0.5, 0.5)
	lock.Position = UDim2.fromScale(0.5, 0.5)
	lock.Size = UDim2.fromOffset(110, 110)
	lock.ZIndex = 8

	local title = Kit.text("Title", bg, "", 48, { color = T.color.white, stroke = 4, min = 24 })
	title.Position = UDim2.fromOffset(196, 30)
	title.Size = UDim2.new(1, -212, 0, 60)
	local line = Kit.text("Line", bg, "", 32, { color = Color3.fromRGB(240, 230, 210), stroke = 3, min = 20 })
	line.Position = UDim2.fromOffset(196, 96)
	line.Size = UDim2.new(1, -212, 0, 44)
	local bar = Kit.progress("Bar", bg, 36, T.color.honey)
	bar.track.Position = UDim2.fromOffset(196, 156)
	bar.track.Size = UDim2.new(1, -212, 0, 36)

	-- "!" ueber dem Terminal (nur am eigenen, im Zustand "ready")
	local marker = Instance.new("BillboardGui")
	marker.Name = "TerminalMarker"
	marker.Size = UDim2.fromOffset(64, 64)
	marker.StudsOffsetWorldSpace = Vector3.new(0, CFG.markerHeight, 0)
	marker.AlwaysOnTop = true
	marker.LightInfluence = 0
	marker.MaxDistance = 180
	marker.Enabled = false
	marker.Adornee = model.PrimaryPart or screenPart
	marker.Parent = screenPart
	local bang = Kit.text("Bang", marker, "!", 56, { color = Color3.fromRGB(255, 230, 80), stroke = 4, align = Enum.TextXAlignment.Center })
	bang.Size = UDim2.fromScale(1, 1)

	local lamp = model:FindFirstChild(CFG.lampPart)
	local view: View = {
		model = model, screen = gui, bg = bg, badgeHolder = badgeHolder, lock = lock,
		title = title, line = line, bar = bar,
		lamp = if lamp and lamp:IsA("BasePart") then lamp else nil,
		marker = marker, prompt = nil, badgeKey = "",
	}

	if isOwn(model) then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "TerminalPrompt"
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0   -- Paket G: ein Druck genuegt
		prompt.MaxActivationDistance = CFG.promptDistance
		prompt.RequiresLineOfSight = false
		prompt.Parent = screenPart
		prompt.Triggered:Connect(function()
			if attr(model, "State", "locked") == "locked" then
				local nextTower = attr(model, "NextTower", "II") :: string
				local prev = TowerConfig.UNLOCK_AFTER[nextTower] or TowerConfig.FIRST_TOWER
				local needed = attr(model, "Needed", 0)
				Notify.emit("terminal_locked", function()
					Toast.info(Loc.t("msg.terminal_locked", { tower = towerName(prev), need = needed }))
				end)
				return
			end
			Kit.playSound("click")
			PanelManager.open(PanelManager.ARENA_PANEL)
		end)
		view.prompt = prompt
	end

	model.AttributeChanged:Connect(function()
		write(view)
	end)
	model.Destroying:Connect(function()
		_views[model] = nil
	end)
	write(view)
	return view
end

local function hook(instance: Instance)
	if not instance:IsA("Model") or instance.Name ~= MODEL_NAME then return end
	if _views[instance] then return end
	-- Teile kommen evtl. nach dem Model an; einen Frame warten
	task.defer(function()
		if not instance.Parent or _views[instance] then return end
		if not instance:FindFirstChild(CFG.screenPart) then
			instance:WaitForChild(CFG.screenPart, 5)
		end
		local view = buildScreen(instance)
		if view then _views[instance] = view end
	end)
end

-- Lampe: Farbe nach Zustand, "ready" blinkt (eine Schleife fuer alle)
local function blink()
	local on = (os.clock() % (CFG.blinkSeconds * 2)) < CFG.blinkSeconds
	for model, view in _views do
		local lamp = view.lamp
		if lamp then
			local state = attr(model, "State", "locked") :: string
			local color = CFG.lampColors[state] or CFG.lampColors.normal
			if state == "ready" then
				lamp.Color = if on then color else Theme.shade(color, -0.6)
			else
				lamp.Color = color
			end
		end
		if view.marker.Enabled then
			view.marker.StudsOffsetWorldSpace = Vector3.new(0, CFG.markerHeight + math.sin(os.clock() * 4) * 0.4, 0)
		end
	end
end

-- Fuer die Fuehrung: der Bildschirm des eigenen Terminals.
function TerminalController.getOwnScreen(): BasePart?
	for model in _views do
		if isOwn(model) then
			local part = model:FindFirstChild(CFG.screenPart)
			if part and part:IsA("BasePart") then return part end
		end
	end
	return nil
end

function TerminalController.init()
	if not FeatureFlags.isOn("TOWER_TERMINAL") then return end
	for _, descendant in Workspace:GetDescendants() do
		hook(descendant)
	end
	Workspace.DescendantAdded:Connect(hook)
	Loc.onChanged(function()
		for _, view in _views do write(view) end
	end)
	RunService.Heartbeat:Connect(blink)
	print("[TerminalController] Initialisiert")
end

return TerminalController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX42"><Properties>
<string name="Name">WorldController</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- WorldController.luau
-- StarterPlayerScripts/Controllers/WorldController.luau
--
-- Einzige Zustaendigkeit:
--   - Klicks und Naeherungs-Prompts an Objekten in der Welt in UI-Aktionen
--     uebersetzen
--
-- Es gibt drei Anker in der Welt:
--   1. Baerchi-Figuren (Attribut "BaerchiUid" an Koerper und Kopf)
--      → Detailkarte, ueber einen ClickDetector den der Server schon mitbaut
--   2. Gebaeude-Parts (Name = BuildingId, Attribute "BuildingLevel"/"HoneyPool")
--      → ein hier erzeugter ProximityPrompt (E) oeffnet das Gebaeude-Panel
--   3. Die Kampf-Plattform ("FightFloor" im Model "PitPlatform")
--      → v15: Tower-Wahl (CombatPanel), ueber einen hier erzeugten ProximityPrompt
--   4. v15: FREMDE Spieler (Charakter) und fremde Plot-Schilder
--      → Profilkarte (Inspektor, ProfilePanel), per Klick
--
-- Gelegte Eier sind ABSICHTLICH kein vierter Anker mehr: sie werden nicht
-- mehr angeklickt, sondern serverseitig per Touched eingesammelt, sobald die
-- eigene Spielfigur hindurchlaeuft (siehe MapService.buildLaidEgg). Dieser
-- Controller muss sie deshalb nicht mehr kennen — es gibt am Ei keinen
-- ClickDetector mehr, an den er sich haengen koennte.
--
-- Das Fuettern selbst ist seit dem Equip-/Honig-Teich-System keine manuelle
-- Aktion mehr: der ausgeruestete Baerchi laeuft von alleine zum Teich auf dem
-- Plot, sobald er Honig braucht (siehe BaerchiAutopilotService). Den
-- frueheren "Honig fuettern (E)"-Prompt am Gebaeude gibt es deshalb nicht
-- mehr — er waere jetzt ohnehin nur noch fuer den einen sichtbaren Baerchi
-- relevant gewesen.
--
-- Die Prompts entstehen bewusst auf dem Client: der Server braucht sie nicht
-- zu kennen, weil sie nur ein lokales Fenster oeffnen.
--
-- Besitzer-Pruefung: MapService schreibt das Attribut "PlotOwner" (UserId) an
-- jedes Plot-Model. Prompts entstehen nur am EIGENEN Plot. Vorher erschienen
-- sie auch an fremden Gebaeuden — ungefaehrlich, weil RequestUpgradeBuilding
-- und RequestStartCombat kein Insel-Argument haben und der Server immer auf
-- den Daten des anfragenden Spielers arbeitet, aber irrefuehrend: man haette
-- am Nachbar-Gebaeude sein eigenes ausgebaut.
--
-- Die Zuordnung der Baerchis laeuft ueber das Attribut "BaerchiUid", das
-- MapService an die Koerper-Part schreibt. Der Client braucht dafuer kein
-- eigenes Remote: er hat die vollstaendigen Baerchi-Daten bereits ueber
-- PlayerDataUpdated.
--
-- Ausserdem markiert dieser Controller den EIGENEN Plot mit einem Wegweiser
-- ueber dem Schild. Das gehoert bewusst hierher und nicht zu MapService: der
-- Server baut fuer alle dasselbe, aber "dein Plot" ist fuer jeden ein anderer.
-- Serverseitig muesste man dafuer acht verschiedene Schilder bauen — hier ist
-- es ein einziges Element, das nur der Besitzer sieht.

local Players   = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Loc          = require(ReplicatedStorage.Localization.Loc)
local Remotes      = require(ReplicatedStorage.Network.Remotes)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)

local FeedbackConfig = require(ReplicatedStorage.Config.FeedbackConfig)

local Theme        = require(script.Parent.Parent.UI.Theme)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local BaerchiPanel = require(script.Parent.Parent.UI.BaerchiPanel)
local PanelManager = require(script.Parent.Parent.UI.PanelManager)

local WorldController = {}

local UID_ATTRIBUTE   = "BaerchiUid"
local LEVEL_ATTRIBUTE = "BuildingLevel"
local OWNER_ATTRIBUTE = "PlotOwner"
local PROMPT_DISTANCE = 14

-- v15 Inspektor: Klick auf fremde Spieler oder fremde Plot-Schilder oeffnet
-- die Profilkarte. Der ClickDetector entsteht nur lokal und heisst "Inspect",
-- damit hookClickable ihn nicht fuer eine Baerchi-Figur haelt.
local INSPECT_NAME     = "Inspect"
local INSPECT_DISTANCE = 60

-- Wegweiser auf den eigenen Plot. Die Plattform ist 480 Studs breit und
-- ueberall gleich gruen; ohne diese Marke sucht man beim ersten Join acht
-- Schilder ab, um das eigene zu finden. Reichweite deshalb so gross, dass sie
-- vom Spawn in der Mitte aus zu sehen ist (Plot-Ring: 165 Studs).
local HOME_MARKER_NAME     = "DeinPlot"
local HOME_MARKER_DISTANCE = 260
local HOME_MARKER_HEIGHT   = 7

-- Gebaeude-Part-Namen wie MapService sie vergibt (= Types.BuildingId)
local BUILDING_NAMES: { [string]: boolean } = {
	Beehive      = true,
	HoneyRefiner = true,
	HoneyPond    = true,
}

-- Bereits verbundene ClickDetectors, damit nichts doppelt haengt
local _connected: { [ClickDetector]: boolean } = {}

--------------------------------------------------------------------------------
-- Baerchi-Figuren
--------------------------------------------------------------------------------

-- Ein ClickDetector in der Welt gehoert einer Baerchi-Figur — Eier haben seit
-- dem Umstieg auf Beruehren-zum-Einsammeln keinen ClickDetector mehr (siehe
-- Kommentar-Kopf).
local function findTarget(detector: ClickDetector): string?
	local part = detector.Parent
	if not part then return nil end

	local baerchiUid = part:GetAttribute(UID_ATTRIBUTE)
	if typeof(baerchiUid) == "string" then
		return baerchiUid
	end

	return nil
end

local function tryHook(detector: ClickDetector): boolean
	if _connected[detector] then return true end

	if findTarget(detector) == nil then return false end

	_connected[detector] = true

	detector.MouseClick:Connect(function()
		-- Beim Klick NEU nachschlagen statt den Wert von oben zu benutzen: die
		-- Part kann inzwischen eine andere uid tragen (Figuren werden bei jedem
		-- Plot-Neuaufbau ersetzt).
		local current = findTarget(detector)
		if not current then return end

		BaerchiPanel.show(current)
	end)

	detector.Destroying:Connect(function()
		_connected[detector] = nil
	end)

	return true
end

local function hookClickable(instance: Instance)
	if not instance:IsA("ClickDetector") then return end
	if instance.Name == INSPECT_NAME then return end
	if tryHook(instance) then return end

	-- Replikation ist nicht sortiert: der ClickDetector kann beim Client
	-- ankommen bevor das Attribut seiner Part da ist. Deshalb einmal im
	-- naechsten Frame erneut versuchen und sonst auf eines der beiden Attribute
	-- warten — welches kommt, weiss man vorher nicht.
	task.defer(function()
		if tryHook(instance) then return end

		local part = instance.Parent
		if not part then return end

		local connection: RBXScriptConnection? = nil
		connection = part:GetAttributeChangedSignal(UID_ATTRIBUTE):Connect(function()
			if tryHook(instance) and connection then
				connection:Disconnect()
			end
		end)
	end)
end

--------------------------------------------------------------------------------
-- Gebaeude und Kampfplattform
--------------------------------------------------------------------------------

-- Beschriftung eines Prompts: liefert (ActionText, ObjectText) in der
-- aktiven Sprache. Als Funktion statt fertiger Texte, damit ein Sprachwechsel
-- alle Prompts neu beschriften kann (siehe Loc.onChanged in init).
type PromptLabels = () -> (string, string)

-- Weak: ein ersetzter Plot nimmt seine Prompts mit, ohne dass sie hier haengen bleiben.
local _promptLabels: { [ProximityPrompt]: PromptLabels } = setmetatable({}, { __mode = "k" }) :: any

local function applyPromptLabels(prompt: ProximityPrompt, labels: PromptLabels)
	local action, object = labels()
	prompt.ActionText = action
	prompt.ObjectText = object
end

-- Ein Prompt an einer Part. `name` dient als Schutz gegen doppeltes Anhaengen:
-- die Parts werden bei jedem Plot-Neuaufbau ersetzt, und ein zweiter Prompt
-- waere ein doppeltes Fenster.
local function addPrompt(
	part: BasePart,
	name: string,
	labels: PromptLabels,
	keyCode: Enum.KeyCode,
	onTriggered: () -> ()
): ProximityPrompt?
	if part:FindFirstChild(name) then return nil end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = name
	applyPromptLabels(prompt, labels)
	_promptLabels[prompt] = labels
	prompt.KeyboardKeyCode       = keyCode
	prompt.MaxActivationDistance = PROMPT_DISTANCE
	prompt.RequiresLineOfSight   = false
	prompt.Parent                = part

	prompt.Triggered:Connect(onTriggered)
	return prompt
end

local function addPanelPrompt(part: BasePart, labels: PromptLabels, panelName: string)
	addPrompt(part, "OpenPanel", labels, Enum.KeyCode.E, function()
		PanelManager.open(panelName)
	end)
end

--------------------------------------------------------------------------------
-- HUD_ROW_V2: Honig-Brunnen ohne Fenster
--------------------------------------------------------------------------------
-- Wunsch Projektinhaber 05.10.: Am Brunnen ploppt nichts mehr auf. E baut
-- direkt aus, und ueber dem Brunnen steht nur ein Schild mit Level und Preis
-- des naechsten Ausbaus. Verbessern geht nur noch vor Ort (keine Kachel
-- mehr). Der Server prueft wie immer selbst (IslandService).
--
-- 08.10. (Paket G): EIN Druck auf E (Antippen am Handy) statt Halten. Gegen
-- Doppelkauf sperrt sich der Prompt danach kurz (FeedbackConfig.UPGRADE_FX.
-- PROMPT_LOCK); der Server bleibt massgeblich (Kosten, Level-Cap,
-- RateLimiter). Den Erfolgs-Effekt zeigt UI/UpgradeFX, sobald der Server den
-- Ausbau gebucht hat.

local POND_SIGN_NAME   = "PondLevelSign"
local POND_PROMPT_HOLD = 0
local POND_SIGN_HEIGHT = 9
local POND_SIGN_DISTANCE = 90

type PondView = { part: BasePart, prompt: ProximityPrompt, level: TextLabel, cost: TextLabel, lastLevel: number, locked: boolean }
local _ponds: { PondView } = {}

local function pondState(buildingId: string): (number, any?)
	local data = ClientState.get()
	local building = if data then data.island.buildings[buildingId :: any] else nil
	local level = if building then building.level else 1
	return level, BuildingBehavior.getUpgrade(buildingId :: any, level + 1)
end

local function costText(cost: any): string
	local gummies = Theme.formatNumber(cost.costGummies or 0)
	local gold = cost.costGoldGummies or 0
	return if gold > 0
		then Loc.t("ui.recycler.cost_gg", { gummies = gummies, gold = gold })
		else Loc.t("ui.recycler.cost_g", { gummies = gummies })
end

local function writePond(view: PondView)
	local buildingId = view.part.Name
	local level, cost = pondState(buildingId)
	view.level.Text = "Lv. " .. level
	local data = ClientState.get()
	if cost then
		local affordable = data ~= nil and data.gummies >= (cost.costGummies or 0)
			and data.goldGummies >= (cost.costGoldGummies or 0)
		view.cost.Text = "⬆ " .. costText(cost)
		view.cost.TextColor3 = if affordable then Theme.COLORS.good else Theme.COLORS.text
		-- Preis steht im Prompt; reicht es nicht, steht dort, wie viel fehlt
		-- (der Standard-Prompt laesst sich nicht ausgrauen). Druecken geht
		-- trotzdem: der Server lehnt mit der bekannten Meldung ab.
		view.prompt.ActionText = if affordable
			then Loc.t("ui.upgrade.prompt_buy", { cost = Theme.formatNumber(cost.costGummies or 0) })
			else Loc.t("ui.upgrade.prompt_need", { missing = Theme.formatNumber(math.max(0, (cost.costGummies or 0) - (if data then data.gummies else 0))) })
		if not view.locked then
			view.prompt.Enabled = true
		end
	else
		view.cost.Text = Loc.t("ui.recycler.maxed")
		view.cost.TextColor3 = Theme.COLORS.goldGummy
		view.prompt.Enabled = false
	end
	view.prompt.ObjectText = Loc.name("building." .. buildingId .. ".name", buildingId) .. "  Lv." .. level

	-- Kleiner Huepfer am Schild, wenn das Level steigt (statt eines Fensters)
	if level > view.lastLevel and view.lastLevel > 0 then
		local gui = view.level.Parent
		if gui and gui:IsA("BillboardGui") then
			local base = gui.Size
			gui.Size = UDim2.new(base.X.Scale * 1.25, 0, base.Y.Scale * 1.25, 0)
			task.delay(0.25, function()
				if gui.Parent then gui.Size = base end
			end)
		end
	end
	view.lastLevel = level
end

local function attachPond(part: BasePart)
	if part:FindFirstChild(POND_SIGN_NAME) then return end

	local gui = Instance.new("BillboardGui")
	gui.Name        = POND_SIGN_NAME
	gui.Size        = UDim2.fromScale(12, 4)
	gui.StudsOffset = Vector3.new(0, POND_SIGN_HEIGHT, 0)
	gui.MaxDistance = POND_SIGN_DISTANCE
	gui.AlwaysOnTop = false
	gui.Adornee     = part
	gui.Parent      = part

	local level = Instance.new("TextLabel")
	level.Name                   = "Level"
	level.Size                   = UDim2.fromScale(1, 0.58)
	level.BackgroundTransparency = 1
	level.Font                   = Theme.FONT
	level.TextScaled             = true
	level.TextColor3             = Theme.COLORS.goldGummy
	level.TextStrokeTransparency = 0.1
	level.Parent                 = gui

	local cost = Instance.new("TextLabel")
	cost.Name                   = "Cost"
	cost.Position               = UDim2.fromScale(0, 0.6)
	cost.Size                   = UDim2.fromScale(1, 0.4)
	cost.BackgroundTransparency = 1
	cost.Font                   = Theme.FONT
	cost.TextScaled             = true
	cost.TextStrokeTransparency = 0.1
	cost.Parent                 = gui

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = "OpenPanel"   -- gleicher Name: kein zweiter Prompt
	prompt.KeyboardKeyCode       = Enum.KeyCode.E
	prompt.HoldDuration          = POND_PROMPT_HOLD
	prompt.MaxActivationDistance = PROMPT_DISTANCE
	prompt.RequiresLineOfSight   = false
	prompt.Parent                = part
	local buildingId = part.Name
	local view: PondView = { part = part, prompt = prompt, level = level, cost = cost, lastLevel = 0, locked = false }
	prompt.Triggered:Connect(function()
		if view.locked then return end
		view.locked = true
		prompt.Enabled = false
		Remotes.RequestUpgradeBuilding:FireServer(buildingId)
		task.delay(FeedbackConfig.UPGRADE_FX.PROMPT_LOCK, function()
			view.locked = false
			if prompt.Parent then writePond(view) end
		end)
	end)

	table.insert(_ponds, view)
	part.Destroying:Connect(function()
		local index = table.find(_ponds, view)
		if index then table.remove(_ponds, index) end
	end)
	writePond(view)
end

local function refreshPonds()
	for _, view in _ponds do
		writePond(view)
	end
end

local function usesPondSign(buildingId: string): boolean
	return FeatureFlags.isOn("HUD_ROW_V2") and buildingId == "HoneyPond"
end

--------------------------------------------------------------------------------
-- Wem gehoert der Plot, in dem dieses Teil steckt?
--
-- MapService setzt das Attribut am Plot-Model, nicht an jedem Teil — also
-- nach oben laufen bis es gefunden wird. Teile ausserhalb eines Plots (die
-- Plattform selbst, Blumen) haben keinen Besitzer und liefern nil.
local function findPlotOwner(instance: Instance): number?
	local current: Instance? = instance

	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner
		end
		current = current.Parent
	end

	return nil
end

local function isOwnPlot(instance: Instance): boolean
	return findPlotOwner(instance) == Players.LocalPlayer.UserId
end

-- Der Wegweiser ueber dem eigenen Plot-Schild.
--
-- Rein lokal erzeugt: er landet nie beim Server und damit auch nie bei den
-- anderen sieben Spielern, die ja alle ihren eigenen sehen sollen. Beim
-- Neuaufbau des Plots verschwindet er mit dem Schild und wird von
-- DescendantAdded wieder angelegt — deshalb die Pruefung auf ein bereits
-- vorhandenes Exemplar.
local function addHomeMarker(board: BasePart)
	if board:FindFirstChild(HOME_MARKER_NAME) then return end

	local marker = Instance.new("BillboardGui")
	marker.Name        = HOME_MARKER_NAME
	marker.Size        = UDim2.fromScale(14, 4)
	marker.StudsOffset = Vector3.new(0, HOME_MARKER_HEIGHT, 0)
	marker.MaxDistance = HOME_MARKER_DISTANCE
	-- Durch die Landschaft hindurch sichtbar: genau dafuer ist er da. Vom
	-- Spawn aus liegt zwischen Spieler und Schild sonst der halbe Plot.
	marker.AlwaysOnTop = true
	marker.Adornee     = board
	marker.Parent      = board

	local label = Instance.new("TextLabel")
	label.Name                   = "Text"
	label.Size                   = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font                   = Theme.FONT
	label.TextScaled             = true
	label.Text                   = "\u{25BC} " .. Loc.t("ui.world.your_plot")
	label.TextColor3             = Theme.COLORS.goldGummy
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
	label.Parent                 = marker
end

--------------------------------------------------------------------------------
-- Inspektor (v15)
--------------------------------------------------------------------------------

-- Haengt einen lokalen ClickDetector an `parent` (Part oder Model), der die
-- Profilkarte von `userId` oeffnet. Der Server prueft selbst, ob der Spieler
-- auf diesem Server ist (ProfileService); hier geht es nur ums Oeffnen.
local function addInspector(parent: Instance, userId: number)
	if parent:FindFirstChild(INSPECT_NAME) then return end
	if userId == Players.LocalPlayer.UserId then return end

	local detector = Instance.new("ClickDetector")
	detector.Name                  = INSPECT_NAME
	detector.MaxActivationDistance = INSPECT_DISTANCE
	detector.Parent                = parent

	detector.MouseClick:Connect(function()
		-- Am Schild beim Klick neu nachschlagen: ein Plot kann inzwischen einem
		-- anderen Spieler gehoeren.
		local target = if parent:IsA("BasePart") then (findPlotOwner(parent) or userId) else userId
		if target == Players.LocalPlayer.UserId then return end
		PanelManager.open("Profile", target)
	end)
end

local function hookCharacter(other: Player, character: Model)
	addInspector(character, other.UserId)
end

local function hookPlayer(other: Player)
	if other == Players.LocalPlayer then return end
	if other.Character then
		hookCharacter(other, other.Character)
	end
	other.CharacterAdded:Connect(function(character)
		hookCharacter(other, character)
	end)
end

local function hookOwnedPart(instance: BasePart)
	if instance.Name == "SignBoard" then
		addHomeMarker(instance)
		return
	end

	if instance.Name == "FightFloor" then
		addPanelPrompt(instance, function()
			return Loc.t("ui.tower.prompt_action"), Loc.t("ui.tower.prompt_object")
		end, PanelManager.ARENA_PANEL)
		return
	end

	if not BUILDING_NAMES[instance.Name] then return end

	-- Fuettern passiert nicht mehr hier (siehe Kommentar-Kopf) — es bleibt nur
	-- noch das Ausbauen.
	--
	-- Jedes Gebaeude hat sein EIGENES Menue (siehe BuildingPanel), und der
	-- Prompt oeffnet genau dieses — nicht mehr eine Liste, in der man das
	-- angeklickte Gebaeude erst suchen muss.
	--
	-- Dasselbe Menue haengt auch an der Kachelleiste rechts. Der Prompt hier ist
	-- also nur noch die Abkuerzung fuer den, der ohnehin davorsteht; gehen MUSS
	-- niemand mehr.
	local buildingId = instance.Name

	-- Sammel-Update 2.6: am Honig-Teich gibt es kein Schild und kein
	-- "Honig essen"-Klicken mehr (der Baerchi isst selbst). Der Prompt hier
	-- ist nur noch "Verbessern" — dazu die Gebaeude-Kachel rechts (MenuBar).

	local function attach()
		if usesPondSign(buildingId) then
			attachPond(instance)
			return
		end
		addPrompt(instance, "OpenPanel", function()
			return Loc.t("ui.building.prompt_upgrade"), Loc.name("building." .. buildingId .. ".name", buildingId)
		end, Enum.KeyCode.E, function()
			PanelManager.open(PanelManager.buildingPanelName(buildingId))
		end)
	end

	-- Das Level-Attribut setzt MapService erst NACH dem Einhaengen der Part.
	-- Beim Client kann die Part deshalb kurz ohne Attribut ankommen —
	-- dann einmal warten statt das Gebaeude zu verpassen.
	if instance:GetAttribute(LEVEL_ATTRIBUTE) ~= nil then
		attach()
		return
	end

	local connection: RBXScriptConnection? = nil
	connection = instance:GetAttributeChangedSignal(LEVEL_ATTRIBUTE):Connect(function()
		attach()
		if connection then
			connection:Disconnect()
		end
	end)
end

local function hookWorldPart(instance: Instance)
	if not instance:IsA("BasePart") then return end

	-- Nur die eigenen Gebaeude und das eigene PIT bekommen einen Prompt.
	-- Vorher erschien er an jedem fremden Plot, was schon deshalb verwirrend
	-- war weil der Server die Anfrage ohnehin immer auf die Daten des
	-- ANFRAGENDEN Spielers anwendet — man haette also am Nachbar-Gebaeude
	-- sein eigenes ausgebaut.
	if isOwnPlot(instance) then
		hookOwnedPart(instance)
		return
	end

	-- v15: fremdes Plot-Schild → Profilkarte des Besitzers
	if instance.Name == "SignBoard" then
		local owner = findPlotOwner(instance)
		if owner then
			addInspector(instance, owner)
			return
		end
	end

	-- Besitzer noch unbekannt: das kann passieren wenn das Teil beim Client
	-- ankommt bevor sein Plot-Model komplett da ist. Einmal im naechsten
	-- Frame erneut versuchen, statt den Prompt fuer immer zu verlieren.
	if findPlotOwner(instance) == nil then
		task.defer(function()
			if not instance.Parent then return end
			if isOwnPlot(instance) then
				hookOwnedPart(instance)
			elseif instance.Name == "SignBoard" then
				local owner = findPlotOwner(instance)
				if owner then addInspector(instance, owner) end
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

local function hook(instance: Instance)
	hookClickable(instance)
	hookWorldPart(instance)
end

function WorldController.init()
	-- Sprachwechsel: alle noch lebenden Prompts neu beschriften
	Loc.onChanged(function()
		for prompt, labels in _promptLabels do
			if prompt.Parent then applyPromptLabels(prompt, labels) end
		end
	end)

	-- Was schon da ist
	for _, descendant in Workspace:GetDescendants() do
		hook(descendant)
	end

	-- Und alles was der Server noch nachliefert. Die Figuren werden bei jeder
	-- Bestandsaenderung neu gebaut, also passiert das staendig.
	Workspace.DescendantAdded:Connect(hook)

	-- v15 Inspektor: fremde Spielfiguren anklickbar machen
	for _, other in Players:GetPlayers() do
		hookPlayer(other)
	end
	Players.PlayerAdded:Connect(hookPlayer)

	-- HUD_ROW_V2: Brunnen-Schild mit Level und Preis aktuell halten
	ClientState.onChanged(refreshPonds)
	Loc.onChanged(refreshPonds)

	print("[WorldController] Initialisiert")
end

return WorldController
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="LocalScript" referent="RBX43"><Properties>
<string name="Name">Main</string>
<bool name="Disabled">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Main.client.luau
-- StarterPlayerScripts/Main.client.luau
--
-- Bootstrap des Clients — das Gegenstueck zu GameManager auf dem Server.
-- Einzige Stelle die die Startreihenfolge der Client-Module kennt.
--
-- ACHTUNG beim Umbenennen: die Datei darf NICHT "init.client.luau" heissen.
-- Rojo macht aus einem Ordner mit init-Datei ein Script statt eines
-- Containers — auf StarterPlayerScripts angewandt heisst das, dass der
-- gesamte Client-Teilbaum nie im Spiel ankommt. Genau das hat den
-- Server-Sync schon einmal lahmgelegt.
--
-- Reihenfolge:
--   1. ScreenGui anlegen — alle UI-Module haengen sich dort ein.
--   2. Toast zuerst, damit fruehe Fehlermeldungen schon sichtbar sind.
--   3. ClientState VOR den datengetriebenen UIs: die registrieren sich per
--      onChanged und bekommen den aktuellen Stand sofort nachgereicht.
--   4. Die Panels. Jedes meldet sich in seinem init beim PanelManager an —
--      erst danach duerfen Module laufen die Panels oeffnen wollen.
--   5. Hud und MenuBar: beide sind reine Ausloeser und brauchen die
--      angemeldeten Panels (Rebirth-Pille, Menue-Knoepfe).
--   6. ResultFeed — Toast-Meldungen fuer Recycling und Offline-Ertrag.
--      Muss vor dem ersten Serverpaket stehen, sonst geht der Offline-Report
--      des Joins verloren.
--   7. WorldController zuletzt — er braucht Panel und PanelManager.
--   8. EggTimerController — unabhaengig von allen anderen, braucht nur
--      ClientState (schon initialisiert) und die Figuren in der Welt.
--   9. SkillFXController (v14) — hoert nur auf Remotes.SkillFXPlay.
--
-- Davor, ganz am Anfang: LanguageController. Er legt die Sprache fest, bevor
-- irgendein Text gebaut wird (er braucht ClientState erst, wenn es dort
-- Daten gibt — onChanged meldet den aktuellen Stand sofort nach).

local Players = game:GetService("Players")

local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local root = script.Parent

local Controllers = root:WaitForChild("Controllers")
local UI          = root:WaitForChild("UI")

local ClientState        = require(Controllers:WaitForChild("ClientState"))
local LanguageController = require(Controllers:WaitForChild("LanguageController"))
local ResultFeed         = require(Controllers:WaitForChild("ResultFeed"))
local WorldController    = require(Controllers:WaitForChild("WorldController"))
local EggTimerController = require(Controllers:WaitForChild("EggTimerController"))
local SkillFXController  = require(Controllers:WaitForChild("SkillFXController"))
local CombController     = require(Controllers:WaitForChild("CombController"))
local AmbienceController = require(Controllers:WaitForChild("AmbienceController"))
-- Welt aufwerten (08.10.2026)
local DayCycleController    = require(Controllers:WaitForChild("DayCycleController"))
local WaterController       = require(Controllers:WaitForChild("WaterController"))
local HubLandmarkController = require(Controllers:WaitForChild("HubLandmarkController"))
local HubEventController    = require(Controllers:WaitForChild("HubEventController"))
local ArrivalController     = require(Controllers:WaitForChild("ArrivalController"))
local WorldShotController   = require(Controllers:WaitForChild("WorldShotController"))
local PlotLifeController    = require(Controllers:WaitForChild("PlotLifeController"))
local ArenaLifeController   = require(Controllers:WaitForChild("ArenaLifeController"))
local LifeController        = require(Controllers:WaitForChild("LifeController"))
local WorldMomentController = require(Controllers:WaitForChild("WorldMomentController"))
local SoundscapeController  = require(Controllers:WaitForChild("SoundscapeController"))
local ZoneLightController   = require(Controllers:WaitForChild("ZoneLightController"))
local EventFXController  = require(Controllers:WaitForChild("EventFXController"))
local LaidEggMeshController = require(Controllers:WaitForChild("LaidEggMeshController"))
local UiEventLogger      = require(Controllers:WaitForChild("UiEventLogger"))
local GuideController    = require(Controllers:WaitForChild("GuideController"))
local UpgradeHintController = require(Controllers:WaitForChild("UpgradeHintController"))
local IncubatorController   = require(Controllers:WaitForChild("IncubatorController"))   -- Sammel-Update 8
local AreaSignController    = require(Controllers:WaitForChild("AreaSignController"))    -- Sammel-Update 3.8
local TerminalController    = require(Controllers:WaitForChild("TerminalController"))    -- 08.10. Tower-Terminal

local Toast            = require(UI:WaitForChild("Toast"))
local UiScale          = require(UI:WaitForChild("UiScale"))
local ShopPanel        = require(UI:WaitForChild("ShopPanel"))
local Hud              = require(UI:WaitForChild("Hud"))
local MenuBar          = require(UI:WaitForChild("MenuBar"))
local BaerchiPanel     = require(UI:WaitForChild("BaerchiPanel"))
local BaerchiInventory = require(UI:WaitForChild("BaerchiInventory"))
local HatchPanel       = require(UI:WaitForChild("HatchPanel"))
local CombatPanel      = require(UI:WaitForChild("CombatPanel"))
local TowerPanel       = require(UI:WaitForChild("TowerPanel"))     -- 08.10. Paket D
local BuildingPanel    = require(UI:WaitForChild("BuildingPanel"))
local FusionPanel      = require(UI:WaitForChild("FusionPanel"))
local CharmPanel       = require(UI:WaitForChild("CharmPanel"))
local RebirthDialog    = require(UI:WaitForChild("RebirthDialog"))
local LanguagePanel    = require(UI:WaitForChild("LanguagePanel"))
local PetBar           = require(UI:WaitForChild("PetBar"))
local QuestPanel       = require(UI:WaitForChild("QuestPanel"))
local QuestTracker     = require(UI:WaitForChild("QuestTracker"))
local HudRow           = require(UI:WaitForChild("HudRow"))
local EggTreePanel     = require(UI:WaitForChild("EggTreePanel"))
local LeaderboardPanel = require(UI:WaitForChild("LeaderboardPanel"))
local ProfilePanel     = require(UI:WaitForChild("ProfilePanel"))
local DailyBonusPanel  = require(UI:WaitForChild("DailyBonusPanel"))
local Feedback         = require(UI:WaitForChild("Feedback"))
local UpgradeFX        = require(UI:WaitForChild("UpgradeFX"))   -- 08.10. Paket G
local Moment           = require(UI:WaitForChild("Moment"))
local ReturnSummary    = require(UI:WaitForChild("ReturnSummary"))
local HomeButton       = require(UI:WaitForChild("HomeButton"))
local RebirthButton    = require(UI:WaitForChild("RebirthButton"))   -- Sammel-Update 2.7
local IncubatorPanel   = require(UI:WaitForChild("IncubatorPanel"))  -- Sammel-Update 8
local CurrencyHint     = require(UI:WaitForChild("CurrencyHint"))    -- Sammel-Update 3.4

--------------------------------------------------------------------------------
-- Oberflaeche
--------------------------------------------------------------------------------

local screenGui = Instance.new("ScreenGui")
screenGui.Name             = "RBL"
screenGui.ResetOnSpawn     = false   -- ueberlebt den Tod des Charakters
screenGui.IgnoreGuiInset   = false   -- laesst Platz fuer die Roblox-Topbar
screenGui.ZIndexBehavior   = Enum.ZIndexBehavior.Sibling
screenGui.Parent           = playerGui

-- Playtest 05.10.: auf grossen Monitoren mitwachsen (siehe UI/UiScale)
UiScale.init(screenGui)

--------------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------------

-- Sprache ALLERERSTES: ab hier liefert Loc den Text in der Roblox-Sprache des
-- Spielers. Ohne das haetten Toast und alle Beschriftungen, die beim Aufbau
-- gesetzt werden, einen Moment lang die Standardsprache.
LanguageController.init()

-- Vom Server gebaute Welt-Texte (Tafeln, Schilder, Prompts) in der Sprache
-- dieses Spielers anzeigen (siehe Localization/WorldText)
require(game:GetService("ReplicatedStorage"):WaitForChild("Localization"):WaitForChild("WorldText")).startClient()

Toast.init(screenGui)
ClientState.init()

BaerchiPanel.init(screenGui)
BaerchiInventory.init(screenGui)
HatchPanel.init(screenGui)
CombatPanel.init(screenGui)
TowerPanel.init(screenGui)         -- 08.10. Paket D (nur mit TOWER_PANEL_V2)
BuildingPanel.init(screenGui)
FusionPanel.init(screenGui)
-- Nach BaerchiPanel: die Detailkarte oeffnet dieses Panel ueber den
-- PanelManager, es muss dafuer angemeldet sein. Die Reihenfolge der init-Aufrufe
-- entscheidet das zwar nicht (geoeffnet wird erst per Klick), aber die Liste
-- hier soll den Aufrufweg widerspiegeln.
CharmPanel.init(screenGui)
RebirthDialog.init(screenGui)
LanguagePanel.init(screenGui)
QuestPanel.init(screenGui)
-- v14: Ei-Baum (oeffnet sich aus dem Ei-Menue)
EggTreePanel.init(screenGui)
-- v15: Bestenliste, Spieler-Profil (Inspector) und Login-Bonus. Vor MenuBar,
-- damit die Menue-Kacheln die Panels schon angemeldet vorfinden.
LeaderboardPanel.init(screenGui)
ProfilePanel.init(screenGui)
DailyBonusPanel.init(screenGui)
ShopPanel.init(screenGui)          -- HBB Paket 10 (nur mit SHOP_V1)
IncubatorPanel.init(screenGui)     -- Sammel-Update Paket 8

Hud.init(screenGui)
MenuBar.init(screenGui)

-- HBB Paket 1: fliegende Icons, grosse Momente, Rueckkehr-Karte. Nach Hud
-- und MenuBar (Ziele der Icons), vor ResultFeed (der Offline-Bericht des
-- Joins kommt sonst an, bevor die Karte bereit ist).
Feedback.init(screenGui)
UpgradeFX.init()                -- 08.10. Paket G: Erfolgs-Moment beim Ausbau
Moment.init(screenGui)
ReturnSummary.init(screenGui)
-- HBB Paket 5: Heim-Knopf (erscheint nur weit weg vom eigenen Plot)
HomeButton.init(screenGui)
RebirthButton.init(screenGui)   -- Sammel-Update 2.7: fester Rebirth-Knopf
CurrencyHint.init(screenGui)    -- Sammel-Update 3.4: Waehrungs-Hinweise

-- v13: Quest-Karte links (braucht das Quest-Fenster, das oben angemeldet wird)
QuestTracker.init(screenGui)
-- HUD_ROW_V2: Zahnrad · Quests · Shop in einer Zeile (versteckt die Quest-Karte)
HudRow.init(screenGui)

-- v12: untere Pet-Leiste (Event / Fight), legt auch den PitResumeDialog an
PetBar.init(screenGui)

ResultFeed.init()
WorldController.init()
EggTimerController.init()
IncubatorController.init()   -- Sammel-Update Paket 8
AreaSignController.init()    -- Sammel-Update Paket 3.8
TerminalController.init()    -- 08.10. Tower-Terminal an der Bruecke
-- v14: Faehigkeiten-Show im PIT (unabhaengig von allem anderen)
SkillFXController.init()
-- v15: Waben im Event-Pit und Recycler (braucht Toast, ClientState und die Welt)
CombController.init(screenGui)
-- v16: Himmels-Kulisse (Wolken, Schwebeinseln, Pollen, Schaum) nur auf dem Client
AmbienceController.init()
-- Welt aufwerten: Tageslauf (Paket A) zuerst — Wasser und Hauptinsel melden
-- ihre leuchtenden Teile bei ihm an. Danach Wasser (B), Hauptinsel (C),
-- Ankunft (C) und die festen Kamerapunkte (Paket 0, nur Studio).
DayCycleController.init()
WaterController.init()
HubLandmarkController.init()
HubEventController.init()
ArrivalController.init()
-- Paket D (Plot-Inseln) vor F: die Bienen fragen nach der eigenen Insel.
PlotLifeController.init()
-- Paket G: Welt-Momente (nutzt Arena-, Insel-, Leben- und Wahrzeichen-Controller)
WorldMomentController.init()
-- Paket H: Klang-Kulisse (still, bis gepruefte Sound-IDs eingetragen sind)
SoundscapeController.init()
-- Paket I: Licht nach Zonen (nach dem Tageslauf: setzt dessen Atmosphaeren-Faktoren)
ZoneLightController.init()
ArenaLifeController.init()
LifeController.init()
WorldShotController.init()
-- v17: lebendige Events (UFO-Patrouille, Abwuerfe, Boss, Telegraphen); braucht Toast
EventFXController.init()
-- v18: Ei-Mesh der gelegten Eier (EditableMesh gibt es nur auf dem Client)
LaidEggMeshController.init()
-- HBB Paket 0: Messpunkte der Oberflaeche (Panel auf/zu, Stillstand)
UiEventLogger.init()
-- HBB Paket 2: Fuehrung ohne Text (braucht MenuBar und PetBar als Anker)
GuideController.init(screenGui)
-- HBB Paket 3: ⬆ ueber bezahlbaren eigenen Gebaeuden
UpgradeHintController.init()

print("[Client] Bereit")
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX44"><Properties>
<string name="Name">UI</string>
</Properties>
<Item class="ModuleScript" referent="RBX45"><Properties>
<string name="Name">CombatPanel</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- CombatPanel.luau
-- StarterPlayerScripts/UI/CombatPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die Tower-Wahl zeigen (v15): eine Karte pro Tower mit Look-Farbe,
--     Rekord, Deckel des aktuellen Rebirths und naechstem Meilenstein
--   - Nach einem Lauf eine kurze Ergebnis-Meldung zeigen (Toast), am Deckel den
--     Rebirth-Hinweis mit Knopf zum RebirthDialog, und Meilenstein-Toasts
--
-- Gestartet und zurueckgeholt wird weiterhin ueber den Fight-Knopf der unteren
-- Pet-Leiste (PetBar). Dieses Panel waehlt nur, WOHIN er schickt
-- (RequestSelectTower). Ob ein Tower offen ist, prueft der Server; die Karten
-- rechnen mit denselben Funktionen aus TowerConfig nur fuer die Anzeige.
--
-- Der Ergebnis-Listener haengt am Modul, nicht am Panel: ein Lauf soll seine
-- Meldung auch bringen, wenn das Panel zu ist.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local Names       = require(ReplicatedStorage.Localization.Names)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local EggConfig   = require(ReplicatedStorage.Config.EggConfig)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local Moment       = require(script.Parent.Moment)
local PanelManager = require(script.Parent.PanelManager)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local Icons        = require(script.Parent.Icons)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local CombatPanel = {}

local PANEL_NAME   = "Combat"
local REBIRTH_PANEL = "Rebirth"
local CARD_HEIGHT  = 78

type Card = {
	frame  : Frame,
	stroke : UIStroke?,
	title  : TextLabel,
	info   : TextLabel,
	button : TextButton,
}

local _root: Frame?        = nil
local _info: TextLabel?    = nil
local _hint: Frame?        = nil
local _cards: { [string]: Card } = {}

-- HBB Paket 2: bezahlter Wiedereinstieg ab der letzten Stage als kleiner
-- Knopf (frueher eine Option im PitResumeDialog). Der kostenlose Einstieg
-- ab 65 % laeuft jetzt ohne Frage ueber den Fight-Knopf.
local _resume: TextButton? = nil
local _resumeHint: TextLabel? = nil

local function refreshResume(data: Types.PlayerDataUpdate)
	local button, hintText = _resume, _resumeHint
	if not button or not hintText then return end
	local reached = PitResumeDialog.getProgress(data)
	local towerId = if data.towers then data.towers.selected else TowerConfig.FIRST_TOWER
	local cost = if reached then TowerConfig.getResumeCost(towerId, reached, data.rebirthMult) else 0
	local show = FeatureFlags.isOn("UI_V2_GUIDE") and reached ~= nil and reached > 1 and cost > 0
	button.Visible = show
	hintText.Visible = not show
	if show then
		button.Text = string.format("⏩ %d   %s", reached :: number, Theme.formatNumber(cost))
		Theme.setEnabled(button, cost <= data.gummies)
	end
end

--------------------------------------------------------------------------------
-- Karten
--------------------------------------------------------------------------------

local function towerName(def: TowerConfig.TowerDef): string
	return Loc.t("tower." .. def.id .. ".name")
end

local function buildCard(parent: Instance, def: TowerConfig.TowerDef, order: number): Card
	local frame = Theme.panel("Tower_" .. def.id, parent, Theme.COLORS.panel)
	frame.Size        = UDim2.new(1, -8, 0, CARD_HEIGHT)
	frame.LayoutOrder = order

	-- Farbstreifen links in der Look-Farbe des Towers
	local stripe = Theme.panel("Stripe", frame, def.color)
	stripe.Size     = UDim2.new(0, 14, 1, -12)
	stripe.Position = UDim2.new(0, 6, 0, 6)

	local title = Theme.label("Title", frame, "")
	title.Position   = UDim2.new(0, 28, 0, 6)
	title.Size       = UDim2.new(1, -150, 0, 26)
	title.TextColor3 = Theme.shade(def.color, -0.1)
	Theme.outlineText(title)

	local info = Theme.bodyText("Info", frame, "")
	info.Position = UDim2.new(0, 28, 0, 34)
	info.Size     = UDim2.new(1, -150, 0, CARD_HEIGHT - 38)
	info.TextSize = 13

	local button = Theme.bigButton("Choose", frame, "", def.color)
	button.AnchorPoint = Vector2.new(1, 0.5)
	button.Position    = UDim2.new(1, -10, 0.5, 0)
	button.Size        = UDim2.new(0, 110, 0, 40)
	button.Activated:Connect(function()
		if not button.Active then return end
		Remotes.RequestSelectTower:FireServer(def.id)
	end)

	return {
		frame  = frame,
		stroke = frame:FindFirstChildOfClass("UIStroke"),
		title  = title,
		info   = info,
		button = button,
	}
end

local function refreshCard(card: Card, def: TowerConfig.TowerDef, data: Types.PlayerDataUpdate)
	local towers = data.towers
	local record = if towers then towers.records[def.id] or 0 else 0
	local cap    = TowerConfig.getStageCap(data.rebirthCount, def.id, if towers then towers.records else nil)
	local open   = cap > 0
	local selected = towers ~= nil and towers.selected == def.id
	local endless = def.id == "Endless"   -- HBB Paket 9: ohne Obergrenze

	card.title.Text = if endless then towerName(def) else string.format("%s  (%d)", towerName(def), def.stages)

	if open then
		local claimed = if towers then towers.claimed[def.id] else nil
		local nextStage = TowerConfig.nextMilestoneStage(def.id, claimed, record + 1)
		local lines = {
			if endless
				then Loc.t("ui.tower.record_endless", { record = record })
				else Loc.t("ui.tower.record_cap", { record = record, cap = cap, stages = def.stages }),
		}
		if nextStage then
			table.insert(lines, Loc.t("ui.tower.next_milestone", { stage = nextStage }))
		end
		card.info.Text = table.concat(lines, "\n")
		card.button.Text = if selected then Loc.t("ui.tower.selected") else Loc.t("ui.tower.choose")
		Theme.setEnabled(card.button, not selected)
	else
		card.info.Text = if endless
			then Loc.t("ui.tower.locked_endless")
			else Loc.t("ui.tower.locked", { rebirths = TowerConfig.getOpeningRebirth(def.id) })
		card.button.Text = Loc.t("ui.tower.locked_short")
		Theme.setEnabled(card.button, false)
	end

	local stroke = card.stroke
	if stroke then
		stroke.Color     = if selected then Theme.COLORS.good else Theme.COLORS.outline
		stroke.Thickness = if selected then Theme.OUTLINE_THICKNESS + 2 else Theme.OUTLINE_THICKNESS
	end
end

function CombatPanel.refresh()
	local root = _root
	if not root or not root.Visible then return end

	local data = ClientState.get()
	if not data then return end

	local capTower, capStage = TowerConfig.getCap(data.rebirthCount)
	local capDef = TowerConfig.get(capTower) or TowerConfig.TOWERS[1]
	local info = _info
	if info then
		info.Text = Loc.t("ui.tower.cap_line", { rebirths = data.rebirthCount, tower = towerName(capDef), stage = capStage })
	end

	refreshResume(data)

	for _, def in TowerConfig.TOWERS do
		local card = _cards[def.id]
		if card then refreshCard(card, def, data) end
	end
end

--------------------------------------------------------------------------------
-- Ergebnis des Laufs
--------------------------------------------------------------------------------

local function showCapHint(result: Types.PitRunResult)
	local hint = _hint
	if not hint then return end
	local label = hint:FindFirstChild("Text")
	if label and label:IsA("TextLabel") then
		label.Text = Loc.t("ui.tower.cap_reached", { stage = result.capStage or 0 })
	end
	hint.Visible = true
	task.delay(12, function()
		hint.Visible = false
	end)
end

local function showResult(result: Types.PitRunResult)
	local cleared = result.stagesCleared or 0
	local def = TowerConfig.get(result.towerId or "") or TowerConfig.TOWERS[1]
	local parts = {
		"Tower " .. def.numeral,
		Loc.tn("msg.tower_cleared", cleared),
		"+" .. Theme.formatNumber(result.gummiesWon or 0) .. " Gummies",
	}
	if (result.goldGummiesWon or 0) > 0 then
		table.insert(parts, "+" .. Theme.formatNumber(result.goldGummiesWon) .. " GoldGummies")
	end
	if result.newRecord then
		table.insert(parts, Loc.t("msg.tower_new_record", { stage = result.newRecord }))
	end
	if result.recalled then
		table.insert(parts, Loc.t("msg.tower_recalled"))
	end

	local text = table.concat(parts, "  •  ")
	-- Gummies/GoldGummies fliegen ueber den Datenstand (UI/Feedback); der
	-- neue Rekord ist der Moment, den man sehen soll.
	Notify.emit("tower_result", function()
		if cleared > 0 then Toast.success(text) else Toast.info(text) end
	end, function()
		if result.newRecord then
			Notify.emit("tower_record", function() end, function()
				Moment.show("record", Theme.COLORS.goldGummy, "ui.moment.record")
			end)
		end
	end)

	if result.capReached then
		showCapHint(result)
	end
end

local function showMilestone(reward: Types.TowerMilestoneReward)
	local def = TowerConfig.get(reward.towerId) or TowerConfig.TOWERS[1]
	local parts: { string } = {}
	if reward.gummies > 0 then table.insert(parts, "+" .. Theme.formatNumber(reward.gummies) .. " Gummies") end
	if reward.goldGummies > 0 then table.insert(parts, "+" .. Theme.formatNumber(reward.goldGummies) .. " GoldGummies") end
	if reward.eggType and reward.eggs > 0 then
		table.insert(parts, string.format("+%d %s", reward.eggs, Names.egg(reward.eggType)))
	end
	if reward.blueprints > 0 then table.insert(parts, Loc.t("msg.tower_blueprint")) end
	if (reward.endlessLevels or 0) > 0 then
		table.insert(parts, Loc.t("msg.tower_endless_level", { n = reward.endlessLevels or 0 }))
	end
	Notify.emit("tower_milestone", function()
		Toast.success(Loc.t("msg.tower_milestone", { tower = def.numeral, stage = reward.stage, reward = table.concat(parts, ", ") }))
	end, function()
		Moment.show("milestone", Theme.COLORS.goldGummy, "ui.moment.milestone")
	end)
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local root = _root
	if not root then return end

	root.Visible = true
	CombatPanel.refresh()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function CombatPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"CombatPanel", screenGui,
		Vector2.new(0.50, 0.70),
		Vector2.new(320, 420),
		Vector2.new(560, 600)
	)
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.tower.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	local info = Theme.bodyText("Info", body, "")
	info.Size = UDim2.new(1, -8, 0, 34)
	_info = info

	local scroller = Theme.scroller("List", body)
	scroller.Position = UDim2.new(0, 0, 0, 38)
	scroller.Size     = UDim2.new(1, 0, 1, -84)

	local layout = Theme.listLayout(scroller, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	for order, def in TowerConfig.TOWERS do
		_cards[def.id] = buildCard(scroller, def, order)
	end

	local hintText = Theme.bodyText("Hint", body, Loc.t("ui.tower.hint"))
	hintText.AnchorPoint = Vector2.new(0.5, 1)
	hintText.Position    = UDim2.new(0.5, 0, 1, 0)
	hintText.Size        = UDim2.new(1, -8, 0, 40)
	_resumeHint = hintText

	local resume = Theme.bigButton("ResumeLast", body, "", Theme.COLORS.goldGummy)
	resume.AnchorPoint = Vector2.new(0.5, 1)
	resume.Position    = UDim2.new(0.5, 0, 1, -2)
	resume.Size        = UDim2.new(0, 200, 0, 40)
	resume.Visible     = false
	if Icons.has("gummy") then
		local coin = Icons.make(resume, "gummy")
		coin.AnchorPoint = Vector2.new(1, 0.5)
		coin.Position    = UDim2.new(1, -6, 0.5, 0)
		coin.Size        = UDim2.fromOffset(28, 28)
		coin.ZIndex      = 4
	end
	resume.Activated:Connect(function()
		if not resume.Active then return end
		Remotes.RequestPetMode:FireServer("Fight", "Last")
		PanelManager.close(PANEL_NAME)
	end)
	_resume = resume

	-- Rebirth-Hinweis am Deckel: eigenes kleines Fenster unten in der Mitte,
	-- unabhaengig davon, ob das Panel offen ist.
	local hint = Theme.panel("CapHint", screenGui, Theme.COLORS.panel)
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position    = UDim2.new(0.5, 0, 1, -110)
	hint.Size        = UDim2.fromOffset(420, 70)
	hint.Visible     = false
	hint.ZIndex      = 15
	_hint = hint

	local hintLabel = Theme.bodyText("Text", hint, "")
	hintLabel.Position = UDim2.new(0, 10, 0, 8)
	hintLabel.Size     = UDim2.new(1, -140, 1, -16)
	hintLabel.TextColor3 = Theme.COLORS.text

	local rebirthButton = Theme.bigButton("Rebirth", hint, Loc.t("ui.tower.to_rebirth"), Theme.COLORS.goldGummy)
	rebirthButton.AnchorPoint = Vector2.new(1, 0.5)
	rebirthButton.Position    = UDim2.new(1, -10, 0.5, 0)
	rebirthButton.Size        = UDim2.new(0, 116, 0, 44)
	rebirthButton.Activated:Connect(function()
		hint.Visible = false
		PanelManager.open(REBIRTH_PANEL)
	end)

	-- 08.10. (Paket D): mit TOWER_PANEL_V2 meldet sich das neue Tower-Panel
	-- (UI/TowerPanel) unter demselben Namen an; dieses Fenster bleibt dann
	-- unsichtbar, die Ergebnis-/Meilenstein-Meldungen unten laufen weiter.
	if not FeatureFlags.isOn("TOWER_PANEL_V2") then
		PanelManager.register(PANEL_NAME, {
			open  = openInternal,
			close = closeInternal,
		})
	end

	ClientState.onChanged(function()
		CombatPanel.refresh()
	end)

	Loc.onChanged(function()
		CombatPanel.refresh()
	end)

	Remotes.CombatResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.PitRunResult

		-- Auf dem Hinweg zurueckgeholt: es gab keinen Kampf.
		if typed.recalled and (typeof(typed.stages) ~= "table" or #typed.stages == 0) then
			return
		end

		showResult(typed)
	end)

	Remotes.TowerMilestoneReceived.OnClientEvent:Connect(function(reward: any)
		if typeof(reward) ~= "table" then return end
		showMilestone(reward :: Types.TowerMilestoneReward)
	end)

	print("[CombatPanel] Initialisiert |", #TowerConfig.TOWERS, "Tower")
end

return CombatPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX46"><Properties>
<string name="Name">Feedback</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- Feedback.luau
-- StarterPlayerScripts/UI/Feedback.luau
--
-- Einzige Zustaendigkeit:
--   - Gewinne ohne Text zeigen: Icon fliegt zur passenden Pille/Kachel,
--     eine Zahl ("+25") steigt auf, Honig/XP/Stufen als Zahl ueber dem Baerchi
--
-- Kontext: HBB Paket 1. Ein Kind soll Belohnungen sehen, nicht lesen.
--
-- Zwei Quellen:
--   1. Waehrungen und Eier erkennt dieses Modul selbst am Datenstand
--      (ClientState): steigt `gummies`, `goldGummies` oder die Summe im
--      Ei-Lager, fliegt ein Icon. So braucht keine Belohnungsstelle eigenen
--      Code, und nichts wird doppelt gezeigt.
--   2. Alles, was keine Pille hat (XP, Honig, Level, Stat-Stufe, Waben,
--      Ausbau), meldet der Aufrufer mit Feedback.gain(kind, amount, origin?).
--
-- Leistung: ein fester Pool wiederverwendeter Elemente und EINE Schleife pro
-- Frame. Kein Thread und kein Tween pro Icon.
--
-- Mit FeatureFlags.UI_V2_FEEDBACK = false zeigt dieses Modul nichts.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local GuiService        = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local Types          = require(ReplicatedStorage.Network.Types)
local FeedbackConfig = require(ReplicatedStorage.Config.FeedbackConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)

local Theme       = require(script.Parent.Theme)
local UiScale     = require(script.Parent.UiScale)
local Icons       = require(script.Parent.Icons)
local Hud         = require(script.Parent.Hud)
local MenuBar     = require(script.Parent.MenuBar)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local Feedback = {}

export type Origin = GuiObject | Vector3 | BasePart

-- Wie jede Art aussieht. `icon` = Name in Icons, `text` = Rueckfall/Praefix.
-- `me` = Zahl ueber dem eigenen Charakter statt ueber dem Baerchi.
local LOOK: { [string]: { icon: string?, text: string, color: Color3, float: boolean, me: boolean? } } = {
	gummies     = { icon = "gummy",     text = "G",  color = Theme.COLORS.gummy,     float = false },
	goldGummies = { icon = "goldgummy", text = "$",  color = Theme.COLORS.goldGummy, float = false },
	eggs        = { icon = "egg",       text = "🥚", color = Theme.COLORS.text,      float = false },
	xp          = { icon = nil,         text = "XP", color = Theme.COLORS.growth,    float = true },
	honey       = { icon = "honey",     text = "",   color = Theme.COLORS.volume,    float = true },
	level       = { icon = nil,         text = "Lv", color = Theme.COLORS.good,      float = true },
	stat        = { icon = nil,         text = "",   color = Theme.COLORS.accent,    float = true },
	comb        = { icon = "honey",     text = "",   color = Theme.COLORS.volume,    float = true, me = true },
	upgrade     = { icon = nil,         text = "⬆",  color = Theme.COLORS.good,      float = true, me = true },
	star        = { icon = nil,         text = "★",  color = Theme.COLORS.goldGummy, float = true },
}

-- Groesse eines fliegenden Icons (px)
local ICON_SIZE = 38
-- Wie hoch die Zahl ueber den Startpunkt steigt (px)
local NUMBER_RISE = 46
-- Wie hoch die Zahl ueber dem Baerchi steigt (Studs)
local FLOAT_RISE = 3
local FLOAT_BASE = 4

type Flyer = {
	frame  : Frame,
	icon   : GuiObject,
	number : TextLabel,
	busy   : boolean,
	t0     : number,
	from   : Vector2,
	to     : Vector2?,
	kind   : string,
	landed : boolean,
	spent  : boolean,   -- Paket G: Betrag fliegt AUS der Pille (keinen Puls am Ziel)
}

type Floater = {
	gui    : BillboardGui,
	label  : TextLabel,
	busy   : boolean,
	t0     : number,
}

local _layer: Frame? = nil
local _flyers: { Flyer } = {}
local _floaters: { Floater } = {}

-- Sammeln gleicher Gewinne im MERGE_WINDOW
local _pending: { [string]: { amount: number, origin: Origin?, due: number, suffix: string? } } = {}

-- Letzter bekannter Stand fuer die Erkennung aus ClientState
local _last: { gummies: number, goldGummies: number, eggs: number }? = nil

-- Zwischenspeicher fuer die Figur des ausgeruesteten Baerchis
local _bearPart: BasePart? = nil
local _bearUid: string? = nil

local function enabled(): boolean
	return FeatureFlags.isOn("UI_V2_FEEDBACK")
end

local function formatAmount(kind: string, amount: number, suffix: string?): string
	if suffix then
		return "+" .. Theme.formatNumber(amount) .. " " .. suffix
	end
	local look = LOOK[kind]
	local prefix = if look then look.text else ""
	if kind == "level" then
		return prefix .. " " .. Theme.formatNumber(amount)
	elseif kind == "upgrade" or kind == "star" then
		return prefix .. " " .. Theme.formatNumber(amount)
	elseif kind == "xp" then
		return "+" .. Theme.formatNumber(amount) .. " " .. prefix
	end
	return "+" .. Theme.formatNumber(amount)
end

--------------------------------------------------------------------------------
-- Positionen
--------------------------------------------------------------------------------

local function guiCenter(gui: GuiObject): Vector2
	-- Bildschirm-Pixel -> Oberflaechen-Einheiten (globale UiScale)
	return UiScale.toGui(gui.AbsolutePosition + gui.AbsoluteSize * 0.5)
end

local function worldToScreen(position: Vector3): Vector2?
	local camera = Workspace.CurrentCamera
	if not camera then return nil end
	local point, visible = camera:WorldToViewportPoint(position)
	if not visible then return nil end
	-- Die ScreenGui laesst Platz fuer die Topbar (IgnoreGuiInset = false):
	-- Viewport-Koordinaten muessen um diesen Rand verschoben werden.
	local inset = GuiService:GetGuiInset()
	return UiScale.toGui(Vector2.new(point.X, point.Y) - inset)
end

local function defaultOrigin(): Vector2
	local layer = _layer
	if not layer then return Vector2.zero end
	local size = UiScale.toGui(layer.AbsoluteSize)
	-- Ueber der Pet-Leiste, wo der Blick ohnehin ist
	return Vector2.new(size.X * 0.5, size.Y * 0.72)
end

local function resolveOrigin(origin: Origin?): Vector2
	if typeof(origin) == "Instance" then
		if origin:IsA("GuiObject") then
			return guiCenter(origin)
		elseif origin:IsA("BasePart") then
			return worldToScreen(origin.Position) or defaultOrigin()
		end
	elseif typeof(origin) == "Vector3" then
		return worldToScreen(origin) or defaultOrigin()
	end
	return defaultOrigin()
end

local function targetFor(kind: string): GuiObject?
	local anchor = Hud.getPillAnchor(kind)
	if anchor then return anchor end
	if kind == "eggs" then
		return MenuBar.getTileAnchor("Hatch")
	end
	return nil
end

local function pulseTarget(kind: string, target: GuiObject?)
	if Hud.getPillAnchor(kind) then
		Hud.pulse(kind)
	elseif target then
		local scale = target:FindFirstChild("PulseScale")
		if not scale then
			local created = Instance.new("UIScale")
			created.Name = "PulseScale"
			created.Parent = target
			scale = created
		end
		local uiScale = scale :: UIScale
		uiScale.Scale = 1.15
	end
end

-- Sucht die Figur des eigenen, ausgeruesteten Baerchis (Attribut BaerchiUid,
-- siehe WorldController). Bleibt zwischengespeichert, bis sie verschwindet.
local function findBearPart(): BasePart?
	local data = ClientState.get()
	local uid = if data then data.island.equippedUid else nil
	if not uid then return nil end
	local cached = _bearPart
	if cached and cached.Parent and _bearUid == uid then
		return cached
	end
	_bearPart = nil
	_bearUid = uid
	for _, descendant in Workspace:GetDescendants() do
		if descendant:IsA("BasePart") and descendant:GetAttribute("BaerchiUid") == uid then
			_bearPart = descendant
			return descendant
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Pools
--------------------------------------------------------------------------------

local function makeFlyer(layer: Frame): Flyer
	local frame = Instance.new("Frame")
	frame.Name = "Flyer"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromOffset(ICON_SIZE, ICON_SIZE)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Visible = false
	frame.ZIndex = 60
	frame.Parent = layer

	local number = Theme.label("Number", layer, "")
	number.AnchorPoint = Vector2.new(0.5, 0.5)
	number.Size = UDim2.fromOffset(120, 34)
	number.TextXAlignment = Enum.TextXAlignment.Center
	number.ZIndex = 61
	number.Visible = false
	Theme.outlineText(number, 2)

	return {
		frame = frame, icon = frame, number = number, busy = false,
		t0 = 0, from = Vector2.zero, to = nil, kind = "", landed = false, spent = false,
	}
end

local function setFlyerLook(flyer: Flyer, kind: string)
	if flyer.kind == kind and flyer.icon ~= flyer.frame then return end
	if flyer.icon ~= flyer.frame then
		flyer.icon:Destroy()
	end
	local look = LOOK[kind]
	local iconName = if look then look.icon else nil
	local icon = Icons.make(flyer.frame, iconName or "", if look then look.text else "?")
	icon.Size = UDim2.fromScale(1, 1)
	icon.ZIndex = 60
	flyer.icon = icon
	flyer.kind = kind
end

local function makeFloater(): Floater
	local gui = Instance.new("BillboardGui")
	gui.Name = "FeedbackFloat"
	gui.Size = UDim2.fromOffset(160, 44)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Enabled = false
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local label = Theme.label("Text", gui, "")
	label.Size = UDim2.fromScale(1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Center
	Theme.outlineText(label, 2)

	return { gui = gui, label = label, busy = false, t0 = 0 }
end

--------------------------------------------------------------------------------
-- Ausloesen
--------------------------------------------------------------------------------

local function launchFlyer(kind: string, amount: number, origin: Origin?)
	local free: Flyer? = nil
	for _, flyer in _flyers do
		if not flyer.busy then
			free = flyer
			break
		end
	end
	-- Alle belegt: die Pille zaehlt den Wert ohnehin hoch. Kein siebtes Icon.
	if not free then return end

	local target = targetFor(kind)
	local from = resolveOrigin(origin)
	setFlyerLook(free, kind)
	free.busy   = true
	free.landed = false
	free.spent  = false
	free.t0     = os.clock()
	free.from   = from
	free.to     = if target then guiCenter(target) else nil
	free.frame.Position = UDim2.fromOffset(from.X, from.Y)
	free.frame.Visible  = true

	local look = LOOK[kind]
	free.number.Text       = formatAmount(kind, amount)
	free.number.TextColor3 = if look then look.color else Theme.COLORS.text
	free.number.Position   = UDim2.fromOffset(from.X, from.Y - 20)
	free.number.TextTransparency = 0
	free.number.Visible    = true
end

local function characterPart(): BasePart?
	local character = Players.LocalPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then return root end
	return nil
end

local function launchFloater(kind: string, amount: number, suffix: string?)
	local look0 = LOOK[kind]
	local part = if look0 and look0.me then characterPart() else findBearPart()
	if not part then return end
	local free: Floater? = nil
	for _, floater in _floaters do
		if not floater.busy then
			free = floater
			break
		end
	end
	if not free then return end
	local look = LOOK[kind]
	free.busy = true
	free.t0 = os.clock()
	free.gui.Adornee = part
	free.gui.StudsOffset = Vector3.new(0, FLOAT_BASE, 0)
	free.gui.Enabled = true
	free.label.Text = formatAmount(kind, amount, suffix)
	free.label.TextColor3 = if look then look.color else Theme.COLORS.text
	free.label.TextTransparency = 0
end

local function flush(kind: string)
	local entry = _pending[kind]
	_pending[kind] = nil
	if not entry or entry.amount == 0 then return end
	local look = LOOK[kind]
	if look and look.float then
		launchFloater(kind, entry.amount, entry.suffix)
	else
		launchFlyer(kind, entry.amount, entry.origin)
	end
end

-- Oeffentlich: einen Gewinn zeigen. Gleiche Arten innerhalb des
-- MERGE_WINDOW werden zu einer Zahl addiert. Bei "level", "upgrade" und
-- "star" ist `amount` die neue Stufe (wird nicht addiert, sondern ersetzt).
-- `suffix`: kurzes Kuerzel hinter der Zahl ("+1 ATK"); nur Zahlen und
-- sprachneutrale Kuerzel, keine Woerter.
function Feedback.gain(kind: string, amount: number, origin: Origin?, suffix: string?)
	if not enabled() then return end
	if not LOOK[kind] then
		warn("[Feedback] Unbekannte Art:", kind)
		return
	end
	local entry = _pending[kind]
	if entry then
		if kind == "level" or kind == "upgrade" or kind == "star" then
			entry.amount = amount
		else
			entry.amount += amount
		end
		entry.origin = origin or entry.origin
		entry.suffix = suffix or entry.suffix
	else
		_pending[kind] = { amount = amount, origin = origin, due = os.clock() + FeedbackConfig.MERGE_WINDOW, suffix = suffix }
	end
end

-- Paket G (08.10.): einen BEZAHLTEN Betrag zeigen. Das Icon fliegt aus der
-- Pille zum Ziel in der Welt (z. B. dem ausgebauten Gebaeude), an der Pille
-- steigt "-1.234" auf. Nur aufrufen, wenn der Server die Ausgabe bestaetigt
-- hat (Datenstand), nie spekulativ.
function Feedback.spend(kind: string, amount: number, toWorld: Vector3?)
	if not enabled() or amount <= 0 then return end
	local pill = targetFor(kind)
	if not pill then return end
	local free: Flyer? = nil
	for _, flyer in _flyers do
		if not flyer.busy then
			free = flyer
			break
		end
	end
	if not free then return end
	local from = guiCenter(pill)
	setFlyerLook(free, kind)
	free.busy   = true
	free.landed = false
	free.spent  = true
	free.t0     = os.clock()
	free.from   = from
	free.to     = if toWorld then worldToScreen(toWorld) else nil
	free.frame.Position = UDim2.fromOffset(from.X, from.Y)
	free.frame.Visible  = true
	free.number.Text       = "-" .. Theme.formatNumber(amount)
	free.number.TextColor3 = Theme.COLORS.bad
	free.number.Position   = UDim2.fromOffset(from.X, from.Y + 20)
	free.number.TextTransparency = 0
	free.number.Visible    = true
	Hud.pulse(kind)
end

--------------------------------------------------------------------------------
-- Die eine Schleife
--------------------------------------------------------------------------------

local function easeOut(t: number): number
	return 1 - (1 - t) * (1 - t)
end

local function step()
	local now = os.clock()

	for kind, entry in _pending do
		if now >= entry.due then
			flush(kind)
		end
	end

	local fly = FeedbackConfig.FLY_SECONDS
	local rise = FeedbackConfig.NUMBER_SECONDS
	for _, flyer in _flyers do
		if not flyer.busy then continue end
		local t = now - flyer.t0

		-- Zahl: steigt am Startpunkt auf und blendet aus
		local tn = math.clamp(t / rise, 0, 1)
		-- Ausgaben (spend) sinken unter der Pille ab: die Pille sitzt oben
		-- am Rand, nach oben waere kein Platz.
		local dy = if flyer.spent then 26 + NUMBER_RISE * easeOut(tn) else -20 - NUMBER_RISE * easeOut(tn)
		flyer.number.Position = UDim2.fromOffset(flyer.from.X, flyer.from.Y + dy)
		flyer.number.TextTransparency = math.max(0, (tn - 0.6) / 0.4)

		-- Icon: Bogen zum Ziel (ohne Ziel: nur kurz aufsteigen)
		local tf = math.clamp(t / fly, 0, 1)
		local to = flyer.to or (flyer.from - Vector2.new(0, 80))
		local mid = (flyer.from + to) * 0.5 + Vector2.new(0, -90)
		local e = easeOut(tf)
		local a = flyer.from:Lerp(mid, e)
		local b = mid:Lerp(to, e)
		local p = a:Lerp(b, e)
		flyer.frame.Position = UDim2.fromOffset(p.X, p.Y)
		local size = ICON_SIZE * (1 - 0.35 * tf)
		flyer.frame.Size = UDim2.fromOffset(size, size)

		if tf >= 1 and not flyer.landed then
			flyer.landed = true
			flyer.frame.Visible = false
			if not flyer.spent then
				pulseTarget(flyer.kind, targetFor(flyer.kind))
			end
		end
		if tf >= 1 and tn >= 1 then
			flyer.busy = false
			flyer.number.Visible = false
		end
	end

	local floatTime = FeedbackConfig.FLOAT_SECONDS
	for _, floater in _floaters do
		if not floater.busy then continue end
		local t = math.clamp((now - floater.t0) / floatTime, 0, 1)
		floater.gui.StudsOffset = Vector3.new(0, FLOAT_BASE + FLOAT_RISE * easeOut(t), 0)
		floater.label.TextTransparency = math.max(0, (t - 0.6) / 0.4)
		if t >= 1 then
			floater.busy = false
			floater.gui.Enabled = false
			floater.gui.Adornee = nil
		end
	end

	-- Puls der Kacheln zurueckfedern (Pillen machen das selbst per Tween)
	local tile = MenuBar.getTileAnchor("Hatch")
	if tile then
		local scale = tile:FindFirstChild("PulseScale")
		if scale and scale:IsA("UIScale") and scale.Scale > 1 then
			scale.Scale = math.max(1, scale.Scale - 0.6 * (1 / 60))
		end
	end
end

--------------------------------------------------------------------------------
-- Erkennung aus dem Datenstand
--------------------------------------------------------------------------------

local function countEggs(data: Types.PlayerDataUpdate): number
	local total = 0
	for _, n in data.island.eggStock do
		total += n
	end
	return total
end

local function onData(data: Types.PlayerDataUpdate)
	local now = { gummies = data.gummies, goldGummies = data.goldGummies, eggs = countEggs(data) }
	local last = _last
	_last = now
	-- Erster Stand nach dem Join ist kein Gewinn
	if not last then return end
	if now.gummies > last.gummies then Feedback.gain("gummies", now.gummies - last.gummies) end
	if now.goldGummies > last.goldGummies then Feedback.gain("goldGummies", now.goldGummies - last.goldGummies) end
	if now.eggs > last.eggs then Feedback.gain("eggs", now.eggs - last.eggs) end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function Feedback.init(screenGui: ScreenGui)
	local layer = Theme.container("FeedbackLayer", screenGui)
	layer.Size = UDim2.fromScale(1, 1)
	layer.ZIndex = 60
	_layer = layer

	for _ = 1, FeedbackConfig.MAX_ICONS do
		table.insert(_flyers, makeFlyer(layer))
	end
	for _ = 1, FeedbackConfig.MAX_FLOATS do
		table.insert(_floaters, makeFloater())
	end

	ClientState.onChanged(onData)
	RunService.RenderStepped:Connect(step)

	print("[Feedback] Initialisiert")
end

return Feedback
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX47"><Properties>
<string name="Name">FightStartPrompt</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- FightStartPrompt.luau
-- StarterPlayerScripts/UI/FightStartPrompt.luau
--
-- Einzige Zustaendigkeit:
--   - Das kleine Feld beim Fight-Klick (FeatureFlags.FIGHT_RESUME_PROMPT):
--     "Ab Stage X weiter" gegen Gummies. Klickt der Spieler nichts, ist es
--     nach AUTO_SECONDS weg und der Lauf startet bei Stage 1.
--
-- Entscheidung Projektinhaber 05.10.: Stages schafft man durch STAERKERE
-- Baerchis. Der Einstieg weiter oben ist eine bewusste Spieler-Entscheidung
-- gegen Waehrung, nie der Standard. (Vorher startete der Fight-Knopf ohne
-- Frage ab 65 % des letzten Laufs und buchte dafuer Gummies ab.)
--
-- Kosten und Start-Stage rechnet PitResumeDialog.offer — dieselbe Rechnung,
-- mit der der Server abbucht. Bezahlbar entscheidet am Ende der Server.
--
-- 08.10. (Paket C, "der bezahlte Knopf leuchtet, keiner nimmt den Gratis-
-- Start"): Hierarchie umgedreht. Oben gross und gruen der GRATIS-Start bei
-- Stage 1, darunter klein und gedaempft der bezahlte Einstieg (mit dem
-- Gamepass "Gratis (Pass)"). Keine falschen Countdowns: der Balken zeigt nur,
-- wann es von selbst gratis losgeht.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local Loc = require(ReplicatedStorage.Localization.Loc)

local Theme           = require(script.Parent.Theme)
local Icons           = require(script.Parent.Icons)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local ClientState     = require(script.Parent.Parent.Controllers.ClientState)

local FightStartPrompt = {}

FightStartPrompt.AUTO_SECONDS = 7

local _root: Frame? = nil
local _resume: TextButton? = nil
local _cost: TextLabel? = nil
local _bar: Frame? = nil
local _onChoose: ((PitResumeDialog.Choice) -> ())? = nil
local _openedAt = 0
local _token = 0

local function finish(choice: PitResumeDialog.Choice)
	local callback = _onChoose
	_onChoose = nil
	_token += 1
	local root = _root
	if root then root.Visible = false end
	if callback then callback(choice) end
end

function FightStartPrompt.isOpen(): boolean
	return _onChoose ~= nil
end

-- Sofort mit Stage 1 starten (zweiter Fight-Klick waehrend das Feld offen ist)
function FightStartPrompt.chooseFresh()
	if _onChoose then finish("Fresh") end
end

-- Oeffnet das Feld, wenn es einen letzten Lauf ueber Stage 1 gibt. Gibt
-- false zurueck, wenn es nichts anzubieten gibt (Aufrufer startet dann
-- selbst bei Stage 1).
function FightStartPrompt.open(onChoose: (PitResumeDialog.Choice) -> ()): boolean
	local root, resume, cost = _root, _resume, _cost
	local data = ClientState.get()
	if not root or not resume or not cost or not data then return false end
	local reached = PitResumeDialog.getProgress(data)
	if not reached or reached <= 1 then return false end

	local stage, price = PitResumeDialog.offer(data, "Last")
	local pass = PitResumeDialog.hasSkipPass()
	resume.Text = if pass
		then Loc.t("ui.fight.resume_pass", { stage = stage })
		else Loc.t("ui.fight.resume", { stage = stage })
	cost.Text = if pass then "" else Theme.formatNumber(price)
	Theme.setEnabled(resume, price <= data.gummies)
	local coin = resume:FindFirstChild("Icon")
	if coin and coin:IsA("GuiObject") then coin.Visible = not pass end

	_onChoose = onChoose
	_openedAt = os.clock()
	_token += 1
	local token = _token
	root.Visible = true

	task.delay(FightStartPrompt.AUTO_SECONDS, function()
		if token == _token and _onChoose then
			finish("Fresh")
		end
	end)
	return true
end

function FightStartPrompt.init(screenGui: ScreenGui, anchorAbove: GuiObject)
	local root = Theme.panel("FightStartPrompt", screenGui, Theme.COLORS.panelDeep)
	root.AnchorPoint = Vector2.new(0.5, 1)
	root.Size = UDim2.fromOffset(300, 104)
	root.Visible = false
	root.ZIndex = 6
	_root = root

	-- Ueber der Pet-Leiste, und mit ihr mitwandern: auf Touch-Geraeten sitzt
	-- sie nicht mittig, sondern im freien Streifen neben der Steuerung
	-- (TouchSafeArea), und ihr UIScale macht sie kleiner.
	local function follow()
		local barScale = anchorAbove:FindFirstChildOfClass("UIScale")
		local factor = if barScale then barScale.Scale else 1
		root.Position = UDim2.new(
			anchorAbove.Position.X.Scale, anchorAbove.Position.X.Offset,
			1, -(anchorAbove.Size.Y.Offset * factor + 26)
		)
	end
	anchorAbove:GetPropertyChangedSignal("Position"):Connect(follow)
	local barScale = anchorAbove:FindFirstChildOfClass("UIScale")
	if barScale then
		barScale:GetPropertyChangedSignal("Scale"):Connect(follow)
	end
	follow()

	-- Primaer: der Gratis-Start (gross, gruen)
	local fresh = Theme.bigButton("Fresh", root, Loc.t("ui.fight.fresh_free"), Theme.COLORS.good)
	fresh.Position = UDim2.new(0, 8, 0, 8)
	fresh.Size = UDim2.new(1, -16, 0, 46)
	fresh.TextColor3 = Theme.COLORS.text
	Theme.outlineText(fresh :: any, 2)
	Loc.bind(fresh, "ui.fight.fresh_free")
	fresh.Activated:Connect(function() finish("Fresh") end)

	-- Sekundaer: der bezahlte Einstieg (klein, gedaempft, kein Glanz)
	local resume = Theme.button("Resume", root, "", Theme.COLORS.panelLight)
	resume.Position = UDim2.new(0, 8, 0, 62)
	resume.Size = UDim2.new(0.62, 0, 0, 30)
	resume.TextColor3 = Theme.COLORS.text
	resume.TextXAlignment = Enum.TextXAlignment.Left
	local shine = resume:FindFirstChild("Shine")
	if shine then shine:Destroy() end
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 64)
	pad.Parent = resume
	resume.Activated:Connect(function()
		if resume.Active then finish("Last") end
	end)
	_resume = resume

	-- Kosten rechts im Knopf: Gummi-Icon + Zahl
	local coin = Icons.make(resume, "gummy", "G")
	coin.AnchorPoint = Vector2.new(1, 0.5)
	coin.Position = UDim2.new(1, 62, 0.5, 0)
	coin.Size = UDim2.fromOffset(20, 20)
	local cost = Theme.label("Cost", resume, "")
	cost.AnchorPoint = Vector2.new(1, 0.5)
	cost.Position = UDim2.new(1, 40, 0.5, 0)
	cost.Size = UDim2.fromOffset(44, 20)
	_cost = cost

	-- Ablaufbalken: zeigt, dass es gleich von selbst bei Stage 1 losgeht
	local track = Instance.new("Frame")
	track.Name = "Timer"
	track.BackgroundColor3 = Theme.COLORS.panelLight
	track.BorderSizePixel = 0
	track.Position = UDim2.new(0.62, 16, 0, 72)
	track.Size = UDim2.new(0.38, -24, 0, 10)
	track.Parent = root
	Theme.corner(track, 5)
	local bar = Instance.new("Frame")
	bar.BackgroundColor3 = Theme.COLORS.good
	bar.BorderSizePixel = 0
	bar.Size = UDim2.fromScale(1, 1)
	bar.Parent = track
	Theme.corner(bar, 5)
	_bar = bar

	RunService.RenderStepped:Connect(function()
		if not _onChoose then return end
		local left = math.clamp(1 - (os.clock() - _openedAt) / FightStartPrompt.AUTO_SECONDS, 0, 1)
		local b = _bar
		if b then b.Size = UDim2.fromScale(left, 1) end
	end)

end

return FightStartPrompt
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX48"><Properties>
<string name="Name">Kit</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- Kit.luau
-- StarterPlayerScripts/UI/Kit.luau
--
-- Einzige Zustaendigkeit:
--   - Die Bausteine des neuen UI-Looks (08.10., Paket D): Fenster mit Schatten
--     und Kopf, Schliessen-X, Karte, Chip, Abzeichen, Balken, Knoepfe
--     (primaer/sekundaer/premium/waehlen), Schloss, Tower-Abzeichen,
--     Konfetti, Klang — und EINE Animations-Schleife fuer alles Bewegte.
--
-- Alle Farben, Radien, Striche, Abstaende, Schriftgroessen und Zeiten kommen
-- aus Theme.v2 (Tokens). Kein Baustein kennt ein bestimmtes Panel: das
-- Tower-Panel (UI/TowerPanel) ist der erste Nutzer, die anderen Panels
-- koennen spaeter einfach umsteigen. Die alte Theme-API bleibt unberuehrt.
--
-- Leistung: Bausteine sind ein paar Frames, keine Bilder (ausser optionalen
-- Icons mit Text-Rueckfall). Bewegung laeuft ueber Kit.animate in EINER
-- RenderStepped-Verbindung, die nur lebt, solange etwas animiert — kein
-- Thread und kein Dauer-Tween pro Element. Tweens (Oeffnen, Druecken) sind
-- kurz und raeumen sich selbst auf.

local SoundService      = game:GetService("SoundService")
local RunService        = game:GetService("RunService")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SoundConfig = require(ReplicatedStorage.Config.SoundConfig)

local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)

local Kit = {}

local T = Theme.v2
Kit.T = T

--------------------------------------------------------------------------------
-- Klang
--------------------------------------------------------------------------------

-- Ein Sound-Objekt je Name, einmal angelegt und wiederverwendet.
local _sounds: { [string]: Sound } = {}

-- Spielt einen UI-Klang aus SoundConfig. Stumm-sicher: unbekannt, leer oder
-- nicht ladbar → es passiert nichts.
function Kit.playSound(name: string)
	local def = SoundConfig.get(name)
	if not def then return end
	local sound = _sounds[name]
	if not sound then
		local created = Instance.new("Sound")
		created.Name    = "UiSound_" .. name
		created.SoundId = def.id
		created.Parent  = SoundService
		_sounds[name] = created
		sound = created
	end
	sound.Volume = def.volume * SoundConfig.MASTER_VOLUME
	pcall(function()
		SoundService:PlayLocalSound(sound)
	end)
end

--------------------------------------------------------------------------------
-- Zahlen kurz (fuer enge Knoepfe): bis 99.999 ausgeschrieben, darueber
-- 120K / 3,1M / 2,4B / 1,2T. Die Buchstaben sind in Roblox-Spielen in jeder
-- Sprache ueblich (sprachneutral); das Komma kommt aus der Sprache (Loc).
--------------------------------------------------------------------------------

local Loc = require(ReplicatedStorage.Localization.Loc)

function Kit.formatCompact(value: number): string
	local v = math.floor(value)
	if math.abs(v) < 100000 then return Loc.formatNumber(v) end
	for _, step in { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } } do
		if math.abs(v) >= step[1] then
			local n = v / step[1]
			local digits = if math.abs(n) >= 100 then 0 else 1
			return Loc.formatDecimal(n, digits) .. step[2]
		end
	end
	return Loc.formatNumber(v)
end

--------------------------------------------------------------------------------
-- Die eine Animations-Schleife
--------------------------------------------------------------------------------
-- Kit.animate(step) haengt `step(now)` an; gibt step false zurueck, faellt er
-- heraus. Laeuft nichts mehr, wird die Verbindung getrennt. Rueckgabe: eine
-- Funktion zum vorzeitigen Abmelden.

type Step = (number) -> boolean
local _steps: { Step } = {}
local _connection: RBXScriptConnection? = nil

local function runSteps()
	local now = os.clock()
	for i = #_steps, 1, -1 do
		local ok, keep = pcall(_steps[i], now)
		if not ok or keep == false then
			table.remove(_steps, i)
		end
	end
	if #_steps == 0 and _connection then
		_connection:Disconnect()
		_connection = nil
	end
end

function Kit.animate(step: Step): () -> ()
	table.insert(_steps, step)
	if not _connection then
		_connection = RunService.RenderStepped:Connect(runSteps)
	end
	return function()
		local index = table.find(_steps, step)
		if index then table.remove(_steps, index) end
	end
end

-- Anzahl laufender Animationen (Leck-Test: muss nach dem Schliessen 0 sein).
function Kit.activeAnimations(): number
	return #_steps
end

function Kit.tween(instance: Instance, seconds: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(instance, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

--------------------------------------------------------------------------------
-- Grundformen
--------------------------------------------------------------------------------

function Kit.corner(parent: Instance, radius: number): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
	return corner
end

function Kit.stroke(parent: Instance, thickness: number, color: Color3?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or T.color.outline
	stroke.Thickness = thickness
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = parent
	return stroke
end

-- Verlauf von oben nach unten. Achtung: ein UIGradient MULTIPLIZIERT sich auf
-- die Hintergrundfarbe — deshalb setzen die Bausteine BackgroundColor3 weiss
-- und tragen die echte Farbe im Verlauf.
function Kit.gradient(parent: Instance, top: Color3, bottom: Color3): UIGradient
	local gradient = parent:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(top, bottom)
	gradient.Rotation = 90
	gradient.Parent = parent
	return gradient
end

function Kit.frame(name: string, parent: Instance, color: Color3?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BorderSizePixel = 0
	if color then
		frame.BackgroundColor3 = color
	else
		frame.BackgroundTransparency = 1
	end
	frame.Parent = parent
	return frame
end

-- Text, der nie abgeschnitten wird: TextScaled zwischen `size` (Ziel) und
-- T.text.small (Untergrenze). Lange FR/ES-Texte werden kleiner, nicht kuerzer.
export type TextOptions = {
	color   : Color3?,
	stroke  : number?,           -- Kontur (px), nil = keine
	strokeColor : Color3?,
	align   : Enum.TextXAlignment?,
	alignY  : Enum.TextYAlignment?,
	wrap    : boolean?,
	min     : number?,
}

function Kit.text(name: string, parent: Instance, text: string, size: number, options: TextOptions?): TextLabel
	local o: TextOptions = options or {}
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Font = T.text.font
	label.Text = text
	label.TextColor3 = o.color or T.color.ink
	label.TextScaled = true
	label.TextWrapped = o.wrap == true
	label.TextXAlignment = o.align or Enum.TextXAlignment.Left
	label.TextYAlignment = o.alignY or Enum.TextYAlignment.Center
	label.Parent = parent
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = size
	limit.MinTextSize = math.min(size, o.min or T.text.small)
	limit.Parent = label
	if o.stroke then
		local stroke = Instance.new("UIStroke")
		stroke.Color = o.strokeColor or T.color.outline
		stroke.Thickness = o.stroke
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		stroke.LineJoinMode = Enum.LineJoinMode.Round
		stroke.Parent = label
	end
	return label
end

-- Glanzlicht auf der oberen Haelfte (wie Theme.shine, mit v2-Masse)
function Kit.shine(parent: GuiObject, radius: number, height: number?): Frame
	local shine = Kit.frame("Shine", parent, T.color.white)
	shine.BackgroundTransparency = 0.72
	shine.AnchorPoint = Vector2.new(0.5, 0)
	shine.Position = UDim2.new(0.5, 0, 0, 4)
	shine.Size = UDim2.new(1, -16, height or 0.38, 0)
	shine.ZIndex = parent.ZIndex + 1
	Kit.corner(shine, math.max(4, radius - 6))
	local fade = Instance.new("UIGradient")
	fade.Rotation = 90
	fade.Transparency = NumberSequence.new(0, 0.85)
	fade.Parent = shine
	return shine
end

-- Weiches Anwachsen beim Drueberfahren, Eindruecken beim Druecken (UIScale,
-- damit Layouts unberuehrt bleiben).
function Kit.pressable(button: GuiButton, onPress: (() -> ())?): UIScale
	local scale = Instance.new("UIScale")
	scale.Name = "PressScale"
	scale.Parent = button
	local function to(target: number)
		Kit.tween(scale, T.motion.press, { Scale = target })
	end
	button.MouseEnter:Connect(function() if button.Active then to(1.04) end end)
	button.MouseLeave:Connect(function() to(1) end)
	button.MouseButton1Down:Connect(function()
		if button.Active then
			to(0.94)
			if onPress then onPress() end
		end
	end)
	button.MouseButton1Up:Connect(function() if button.Active then to(1.04) end end)
	return scale
end

--------------------------------------------------------------------------------
-- Fenster
--------------------------------------------------------------------------------

export type Window = {
	root     : Frame,    -- unsichtbarer Rahmen, traegt FitScale (passt aufs Bild)
	holder   : Frame,    -- traegt PopScale (Aufspring-Animation)
	pop      : UIScale,
	body     : Frame,    -- Creme-Koerper mit Kontur
	content  : Frame,    -- Innenflaeche unter dem Kopf
	header   : Frame?,
	title    : TextLabel?,
	close    : TextButton?,
	mascot   : GuiObject?,
	setSize  : (Vector2) -> (),
}

-- Ein zentriertes Fenster mit Schlagschatten. `design` ist die gebaute Groesse
-- in Oberflaechen-Einheiten; passt sie nicht, wird erst die Hoehe bis
-- `minHeight` gekuerzt (die Liste darin scrollt), danach alles gleichmaessig
-- verkleinert. `reserve(screen)` haelt Raender frei (HUD, Pet-Leiste,
-- Menueleiste) — als Funktion der Bildschirmgroesse (Oberflaechen-Einheiten),
-- weil ein Handy quer andere Raender braucht als ein Monitor.
export type Reserve = { top: number, bottom: number, left: number, right: number }
export type WindowOptions = {
	design    : Vector2,
	minHeight : number,
	reserve   : (Vector2) -> Reserve,
}

function Kit.window(name: string, screenGui: ScreenGui, options: WindowOptions): Window
	local root = Kit.frame(name, screenGui)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Visible = false
	root.ZIndex = 20
	local fit = Instance.new("UIScale")
	fit.Name = "FitScale"
	fit.Parent = root

	local holder = Kit.frame("Holder", root)
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = 20
	local pop = Instance.new("UIScale")
	pop.Name = "PopScale"
	pop.Parent = holder

	-- Weicher Schlagschatten: dieselbe Form, dunkel, nach unten versetzt
	local shadow = Kit.frame("Shadow", holder, T.color.shadow)
	shadow.BackgroundTransparency = 0.55
	shadow.Position = UDim2.fromOffset(0, 10)
	shadow.Size = UDim2.fromScale(1, 1)
	shadow.ZIndex = 20
	Kit.corner(shadow, T.radius.panel)

	local body = Kit.frame("Body", holder, T.color.white)
	body.Size = UDim2.fromScale(1, 1)
	body.ZIndex = 22
	Kit.corner(body, T.radius.panel)
	Kit.stroke(body, T.stroke.panel)
	Kit.gradient(body, T.color.surface, T.color.surfaceDeep)

	local content = Kit.frame("Content", body)
	content.Size = UDim2.fromScale(1, 1)
	content.ZIndex = 23

	local window: Window = {
		root = root, holder = holder, pop = pop, body = body, content = content,
		header = nil, title = nil, close = nil, mascot = nil,
		setSize = function(_: Vector2) end,
	}

	local function refit()
		local global = screenGui:FindFirstChild("GlobalScale")
		local g = if global and global:IsA("UIScale") then math.max(global.Scale, 0.01) else 1
		local screen = screenGui.AbsoluteSize / g
		if screen.X <= 0 or screen.Y <= 0 then return end
		local r = options.reserve(screen)
		local roomX = screen.X - r.left - r.right
		local roomY = screen.Y - r.top - r.bottom
		local width = options.design.X
		local height = math.clamp(roomY, options.minHeight, options.design.Y)
		local scale = math.min(1, roomX / width, roomY / height)
		root.Size = UDim2.fromOffset(width, height)
		fit.Scale = scale
		-- Mitte des freien Bereichs
		root.Position = UDim2.fromOffset(r.left + roomX * 0.5, r.top + roomY * 0.5)
		window.setSize(Vector2.new(width, height))
	end
	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
	screenGui.ChildAdded:Connect(function(child)
		if child.Name == "GlobalScale" and child:IsA("UIScale") then
			child:GetPropertyChangedSignal("Scale"):Connect(refit)
			refit()
		end
	end)
	local global = screenGui:FindFirstChild("GlobalScale")
	if global and global:IsA("UIScale") then
		global:GetPropertyChangedSignal("Scale"):Connect(refit)
	end
	task.defer(refit)
	;(window :: any).refit = refit
	return window
end

-- Kopf: Honig-Band oben im Koerper. Es hat DENSELBEN Eckradius und liegt
-- buendig in der oberen Kante — dadurch folgt es der Rundung exakt und kein
-- Pixel steht ueber die Kontur. Die unteren Ecken fuellt ein Streifen in
-- Bandfarbe auf (gerade Unterkante). Der Titel federt beim Oeffnen ein.
function Kit.header(window: Window, title: string, height: number): TextLabel
	local band = Kit.frame("Header", window.body, T.color.white)
	band.Size = UDim2.new(1, 0, 0, height)
	band.ZIndex = 24
	Kit.corner(band, T.radius.panel)
	Kit.gradient(band, T.color.honeyTop, T.color.honeyBottom)

	local filler = Kit.frame("HeaderFill", band, T.color.white)
	filler.AnchorPoint = Vector2.new(0, 1)
	filler.Position = UDim2.fromScale(0, 1)
	filler.Size = UDim2.new(1, 0, 0, T.radius.panel)
	filler.ZIndex = 24
	local fillGradient = Instance.new("UIGradient")
	fillGradient.Rotation = 90
	-- Fortsetzung des Band-Verlaufs im unteren Teil (ohne sichtbare Naht)
	local split = 1 - T.radius.panel / height
	fillGradient.Color = ColorSequence.new(
		T.color.honeyTop:Lerp(T.color.honeyBottom, split),
		T.color.honeyBottom
	)
	fillGradient.Parent = filler

	-- Trennlinie zum Inhalt (Teil der dicken Kontur-Sprache)
	local line = Kit.frame("HeaderLine", band, T.color.outline)
	line.AnchorPoint = Vector2.new(0, 1)
	line.Position = UDim2.fromScale(0, 1)
	line.Size = UDim2.new(1, 0, 0, T.stroke.card)
	line.ZIndex = 26

	local shine = Kit.frame("HeaderShine", band, T.color.white)
	shine.BackgroundTransparency = 0.7
	shine.Position = UDim2.fromOffset(14, 6)
	shine.Size = UDim2.new(1, -28, 0, math.floor(height * 0.28))
	shine.ZIndex = 25
	Kit.corner(shine, 12)
	local fade = Instance.new("UIGradient")
	fade.Rotation = 90
	fade.Transparency = NumberSequence.new(0, 0.9)
	fade.Parent = shine

	local label = Kit.text("Title", band, title, T.text.title, {
		color = T.color.white, stroke = T.stroke.text + 1, align = Enum.TextXAlignment.Center,
	})
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.new(1, -220, 0, T.text.title + 6)
	label.ZIndex = 27
	local titleScale = Instance.new("UIScale")
	titleScale.Name = "TitleScale"
	titleScale.Parent = label

	window.header = band
	window.title = label
	return label
end

-- Maskottchen: ein Baerchi-Kopf lugt ueber die obere Kante (hinter dem
-- Koerper, nur die obere Haelfte ist zu sehen).
function Kit.mascot(window: Window, xOffset: number): GuiObject
	local holder = Kit.frame("Mascot", window.holder)
	holder.AnchorPoint = Vector2.new(0.5, 1)
	holder.Position = UDim2.new(0, xOffset, 0, 34)
	holder.Size = UDim2.fromOffset(84, 84)
	holder.ZIndex = 21   -- unter dem Koerper (22): die untere Haelfte steckt dahinter
	local icon = Icons.make(holder, "bear", "🐻")
	icon.Size = UDim2.fromScale(1, 1)
	icon.ZIndex = 21
	window.mascot = holder
	return holder
end

-- Schliessen-X: eigenes Geschwister des Koerpers, an dessen Ecke oben rechts
-- verankert (Mittelpunkt 10 px innerhalb der Ecke), steht leicht ueber, wird
-- nicht abgeschnitten. 52 px sichtbar, 64 px Trefferflaeche (Touch >= 48).
function Kit.closeButton(window: Window, onClose: () -> ()): TextButton
	local size = 52
	local button = Instance.new("TextButton")
	button.Name = "Close"
	button.AnchorPoint = Vector2.new(0.5, 0.5)
	button.Position = UDim2.new(1, -10, 0, 10)
	button.Size = UDim2.fromOffset(size, size)
	button.BackgroundColor3 = T.color.white
	button.AutoButtonColor = false
	button.Text = ""
	button.ZIndex = 40
	button.Parent = window.holder
	Kit.corner(button, size)
	Kit.stroke(button, T.stroke.button)
	Kit.gradient(button, Color3.fromRGB(255, 120, 120), Color3.fromRGB(226, 60, 70))

	local cross = Kit.text("X", button, "✕", 30, { color = T.color.white, stroke = 2, align = Enum.TextXAlignment.Center })
	cross.Size = UDim2.fromScale(1, 1)
	cross.ZIndex = 41

	local hit = Instance.new("TextButton")
	hit.Name = "CloseHit"
	hit.AnchorPoint = Vector2.new(0.5, 0.5)
	hit.Position = UDim2.fromScale(0.5, 0.5)
	hit.Size = UDim2.fromOffset(64, 64)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.ZIndex = 42
	hit.Parent = button

	Kit.pressable(button)
	local function fire()
		Kit.playSound("click")
		onClose()
	end
	button.Activated:Connect(fire)
	hit.Activated:Connect(fire)
	window.close = button
	return button
end

-- Aufspringen beim Oeffnen: Fenster von 0,86 auf 1 (Back), Titel etwas spaeter.
function Kit.popIn(window: Window)
	window.pop.Scale = 0.86
	Kit.tween(window.pop, T.motion.open, { Scale = 1 }, Enum.EasingStyle.Back)
	local title = window.title
	local titleScale = if title then title:FindFirstChild("TitleScale") else nil
	if titleScale and titleScale:IsA("UIScale") then
		titleScale.Scale = 0.5
		task.delay(0.08, function()
			Kit.tween(titleScale, T.motion.open + 0.1, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end
end

-- Scrollbare Liste (Canvas waechst mit dem Inhalt), Balken in Baerchi-Braun.
function Kit.scroller(name: string, parent: Instance): ScrollingFrame
	local list = Instance.new("ScrollingFrame")
	list.Name = name
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 8
	list.ScrollBarImageColor3 = T.color.bear
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.ScrollingDirection = Enum.ScrollingDirection.Y
	list.ZIndex = 30
	list.Parent = parent
	return list
end

--------------------------------------------------------------------------------
-- Karte, Chip, Abzeichen, Balken
--------------------------------------------------------------------------------

-- Karte mit Kontur und kleiner 3D-Kante (dunklerer Streifen unten).
-- Rueckgabe: der Halter fuer Layouts (`holder`) und die Kartenflaeche (`face`),
-- die beim Einlaufen verschoben werden darf.
export type Card = { holder: Frame, face: Frame, stroke: UIStroke, gradient: UIGradient }

function Kit.card(name: string, parent: Instance, height: number): Card
	local holder = Kit.frame(name, parent)
	holder.Size = UDim2.new(1, 0, 0, height)

	local face = Kit.frame("Face", holder, T.color.white)
	face.Size = UDim2.new(1, -8, 1, -6)
	face.Position = UDim2.fromOffset(4, 0)
	face.ZIndex = 30
	Kit.corner(face, T.radius.card)
	local stroke = Kit.stroke(face, T.stroke.card)
	local gradient = Kit.gradient(face, T.color.card, T.color.surface)

	-- 3D-Kante: gleiche Form, dunkler, 6 px tiefer, HINTER der Flaeche.
	-- Geschwister (nicht Kind) der Flaeche: Kinder liegen in Roblox immer
	-- ueber ihrem Eltern-Element, egal welcher ZIndex.
	local edge = Kit.frame("Edge", holder, T.color.quietEdge)
	edge.Position = UDim2.fromOffset(4, 6)
	edge.Size = UDim2.new(1, -8, 1, -6)
	edge.ZIndex = 29
	Kit.corner(edge, T.radius.card)
	Kit.stroke(edge, T.stroke.card)

	return { holder = holder, face = face, stroke = stroke, gradient = gradient }
end

-- Pille mit Text (Status, Fortschritt). Breite waechst mit dem Text.
function Kit.chip(name: string, parent: Instance, text: string, color: Color3?, textColor: Color3?): Frame
	local chip = Kit.frame(name, parent, color or T.color.sunk)
	chip.AutomaticSize = Enum.AutomaticSize.X
	chip.Size = UDim2.fromOffset(0, 30)
	chip.ZIndex = 32
	Kit.corner(chip, 15)
	Kit.stroke(chip, T.stroke.textSmall)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 12)
	pad.PaddingRight = UDim.new(0, 12)
	pad.Parent = chip
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Size = UDim2.fromScale(0, 1)
	label.Font = T.text.font
	label.TextSize = T.text.small + 1
	label.TextColor3 = textColor or T.color.ink
	label.Text = text
	label.ZIndex = 33
	label.Parent = chip
	return chip
end

function Kit.setChip(chip: Frame, text: string)
	local label = chip:FindFirstChild("Text")
	if label and label:IsA("TextLabel") then label.Text = text end
end

-- Kleiner schraeger Aufkleber ("NEU", "AKTIV", "GRATIS").
function Kit.badge(name: string, parent: Instance, text: string, color: Color3, rotation: number?): Frame
	local badge = Kit.frame(name, parent, T.color.white)
	badge.AnchorPoint = Vector2.new(0.5, 0.5)
	badge.AutomaticSize = Enum.AutomaticSize.X
	badge.Size = UDim2.fromOffset(0, 28)
	badge.Rotation = rotation or -8
	badge.ZIndex = 36
	Kit.corner(badge, 10)
	Kit.stroke(badge, T.stroke.textSmall)
	Kit.gradient(badge, Theme.shade(color, 0.25), color)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = badge
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Size = UDim2.fromScale(0, 1)
	label.Font = T.text.font
	label.TextSize = T.text.small + 2
	label.TextColor3 = T.color.white
	label.Text = text
	label.ZIndex = 37
	label.Parent = badge
	local stroke = Instance.new("UIStroke")
	stroke.Color = T.color.outline
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent = label
	return badge
end

export type Progress = { track: Frame, fill: Frame, label: TextLabel, set: (number, string) -> () }

-- Fortschrittsbalken mit Text in der Mitte.
function Kit.progress(name: string, parent: Instance, height: number, color: Color3?): Progress
	local track = Kit.frame(name, parent, T.color.sunk)
	track.Size = UDim2.new(1, 0, 0, height)
	track.ZIndex = 32
	track.ClipsDescendants = true
	Kit.corner(track, math.floor(height / 2))
	Kit.stroke(track, T.stroke.textSmall)

	local fill = Kit.frame("Fill", track, T.color.white)
	fill.Size = UDim2.fromScale(0, 1)
	fill.ZIndex = 33
	Kit.corner(fill, math.floor(height / 2))
	local base = color or T.color.progress
	Kit.gradient(fill, Theme.shade(base, 0.3), base)

	local label = Kit.text("Text", track, "", height - 4, { color = T.color.white, stroke = 2, align = Enum.TextXAlignment.Center, min = 12 })
	label.Size = UDim2.fromScale(1, 1)
	label.ZIndex = 34

	local function set(ratio: number, text: string)
		local r = math.clamp(ratio, 0, 1)
		fill.Visible = r > 0
		fill.Size = UDim2.new(math.max(r, 0.06), 0, 1, 0)
		label.Text = text
	end
	return { track = track, fill = fill, label = label, set = set }
end

--------------------------------------------------------------------------------
-- Knoepfe
--------------------------------------------------------------------------------
-- Ein Knopf = unsichtbarer TextButton (Trefferflaeche) mit "Edge" (3D-Kante,
-- dunkel, volle Groesse) und "Face" (Flaeche mit Verlauf und Glanz, 6 px
-- hoeher). Beim Druecken sinkt die Flaeche auf die Kante.
--   primary   gross, kraeftig gruen, Glanz, darf pulsieren (Kit.pulse)
--   secondary Creme mit Kontur, kein Glanz, gedaempfte Kante — lesbar, ruhig
--   premium   gold, ruhig, Krone
--   choose    himmelblau (Waehlen auf einer Karte)

export type ButtonKind = "primary" | "secondary" | "premium" | "choose"

export type Button = {
	button : TextButton,
	face   : Frame,
	label  : TextLabel,
	sub    : TextLabel,
	kind   : ButtonKind,
	setEnabled : (boolean) -> (),
	setKind    : (ButtonKind) -> (),
}

local KIND_COLORS: { [string]: { top: Color3, bottom: Color3, edge: Color3, text: Color3, stroke: number? } } = {
	primary   = { top = T.color.goTop,   bottom = T.color.go,       edge = T.color.goEdge,     text = T.color.white, stroke = T.stroke.text },
	secondary = { top = T.color.quiet,   bottom = T.color.surface,  edge = T.color.quietEdge,  text = T.color.ink,   stroke = nil },
	premium   = { top = T.color.goldTop, bottom = T.color.gold,     edge = T.color.goldEdge,   text = T.color.ink,   stroke = nil },
	choose    = { top = Theme.shade(T.color.choose, 0.3), bottom = T.color.choose, edge = T.color.chooseEdge, text = T.color.white, stroke = T.stroke.text },
}

local EDGE = 6

function Kit.button(name: string, parent: Instance, kind: ButtonKind, text: string, textSize: number?): Button
	local button = Instance.new("TextButton")
	button.Name = name
	button.BackgroundTransparency = 1
	button.AutoButtonColor = false
	button.Text = ""
	button.ZIndex = 34
	button.Parent = parent

	local edge = Kit.frame("Edge", button, T.color.white)
	edge.Position = UDim2.fromOffset(0, EDGE)
	edge.Size = UDim2.new(1, 0, 1, -EDGE)
	edge.ZIndex = 34
	Kit.corner(edge, T.radius.button)
	Kit.stroke(edge, T.stroke.button)

	local face = Kit.frame("Face", button, T.color.white)
	face.Size = UDim2.new(1, 0, 1, -EDGE)
	face.ZIndex = 35
	Kit.corner(face, T.radius.button)
	Kit.stroke(face, T.stroke.button)
	local shine = Kit.shine(face, T.radius.button)
	shine.ZIndex = 36

	local label = Kit.text("Label", face, text, textSize or T.text.button, { align = Enum.TextXAlignment.Center })
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.new(1, -16, 0.62, 0)
	label.ZIndex = 37

	local sub = Kit.text("Sub", face, "", T.text.small, { align = Enum.TextXAlignment.Center })
	sub.AnchorPoint = Vector2.new(0.5, 1)
	sub.Position = UDim2.new(0.5, 0, 1, -4)
	sub.Size = UDim2.new(1, -16, 0, T.text.small + 2)
	sub.ZIndex = 37
	sub.Visible = false

	local view: Button = {
		button = button, face = face, label = label, sub = sub, kind = kind,
		setEnabled = function(_: boolean) end, setKind = function(_: ButtonKind) end,
	}

	local function paint()
		local c = KIND_COLORS[view.kind]
		local enabled = button.Active
		local top = if enabled then c.top else T.color.sunk
		local bottom = if enabled then c.bottom else T.color.cardLocked
		Kit.gradient(face, top, bottom)
		edge.BackgroundColor3 = if enabled then c.edge else T.color.quietEdge
		shine.Visible = enabled and view.kind ~= "secondary"
		local textColor = if enabled then c.text else T.color.inkSoft
		label.TextColor3 = textColor
		sub.TextColor3 = textColor
		for _, l in { label, sub } do
			local stroke = l:FindFirstChildOfClass("UIStroke")
			if c.stroke and enabled then
				if not stroke then
					stroke = Instance.new("UIStroke")
					stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
					stroke.LineJoinMode = Enum.LineJoinMode.Round
					stroke.Parent = l
				end
				local s = stroke :: UIStroke
				s.Color = T.color.outline
				s.Thickness = if l == label then c.stroke else 2
				s.Enabled = true
			elseif stroke then
				stroke.Enabled = false
			end
		end
	end

	view.setEnabled = function(enabled: boolean)
		button.Active = enabled
		button.Selectable = enabled
		paint()
	end
	view.setKind = function(newKind: ButtonKind)
		view.kind = newKind
		paint()
	end

	-- Eindruecken: Flaeche sinkt auf die Kante
	button.MouseButton1Down:Connect(function()
		if button.Active then face.Position = UDim2.fromOffset(0, EDGE - 2) end
	end)
	local function release() face.Position = UDim2.fromOffset(0, 0) end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
	Kit.pressable(button)

	paint()
	return view
end

-- Sanfter Puls (nur fuer EIN Element je Fenster: den Hauptknopf). Laeuft in
-- der gemeinsamen Schleife; die Rueckgabe stoppt ihn.
function Kit.pulse(target: GuiObject, amount: number?): () -> ()
	local scale = target:FindFirstChild("PulseScale") :: UIScale?
	if not scale then
		local created = Instance.new("UIScale")
		created.Name = "PulseScale"
		-- Ein GuiObject darf nur EIN UIScale haben; der Knopf hat schon
		-- PressScale. Deshalb pulsiert der Inhalt (Face) statt des Knopfs.
		created.Parent = target
		scale = created
	end
	local s = scale :: UIScale
	local a = amount or 0.045
	local t0 = os.clock()
	local stop = Kit.animate(function(now)
		if not target.Parent then return false end
		local phase = ((now - t0) % T.motion.pulse) / T.motion.pulse
		s.Scale = 1 + a * math.sin(phase * math.pi * 2) ^ 2
		return true
	end)
	return function()
		stop()
		s.Scale = 1
	end
end

--------------------------------------------------------------------------------
-- Schloss, Tower-Abzeichen, Konfetti
--------------------------------------------------------------------------------

-- Gedaempfte Flaeche mit Schloss — "gesperrt, aber nicht tot": der Inhalt
-- darunter bleibt lesbar (nur leicht abgedeckt).
function Kit.lockOverlay(parent: GuiObject): Frame
	local overlay = Kit.frame("Lock", parent, T.color.cardLocked)
	overlay.BackgroundTransparency = 0.45
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = parent.ZIndex + 5
	Kit.corner(overlay, T.radius.card)
	return overlay
end

function Kit.lockIcon(parent: Instance, size: number): GuiObject
	local icon = Icons.make(parent, "lock", "🔒")
	icon.Size = UDim2.fromOffset(size, size)
	return icon
end

-- Tower-Abzeichen: Quadrat in der Look-Farbe mit Kante, grosser Ziffer und
-- einem Material-Zeichen aus Frames (Holz: Maserung, Stein: Fugen, Gold:
-- Glanzstreif, Kristall: Raute, Endless: Kreis). Keine Bilder noetig.
function Kit.towerBadge(name: string, parent: Instance, look: string, color: Color3, numeral: string, size: number): Frame
	local badge = Kit.frame(name, parent, T.color.white)
	badge.Size = UDim2.fromOffset(size, size)
	badge.ZIndex = 32
	Kit.corner(badge, T.radius.badge)
	Kit.stroke(badge, T.stroke.card)
	Kit.gradient(badge, Theme.shade(color, 0.35), Theme.shade(color, -0.12))

	local deco = Theme.shade(color, -0.3)
	local function mark(n: string, pos: UDim2, sz: UDim2, rot: number?, radius: number?)
		local f = Kit.frame(n, badge, deco)
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = pos
		f.Size = sz
		f.Rotation = rot or 0
		f.BackgroundTransparency = 0.45
		f.ZIndex = 33
		if radius then Kit.corner(f, radius) end
	end
	if look == "Wood" then
		mark("Grain1", UDim2.fromScale(0.5, 0.3), UDim2.new(0.8, 0, 0, 3), 0, 2)
		mark("Grain2", UDim2.fromScale(0.5, 0.72), UDim2.new(0.8, 0, 0, 3), 0, 2)
	elseif look == "Stone" then
		mark("Joint1", UDim2.fromScale(0.5, 0.36), UDim2.new(0.9, 0, 0, 3))
		mark("Joint2", UDim2.fromScale(0.5, 0.66), UDim2.new(0.9, 0, 0, 3))
		mark("Joint3", UDim2.fromScale(0.3, 0.51), UDim2.new(0, 3, 0.3, 0))
	elseif look == "Gold" then
		-- zwei kleine Funkel-Rauten statt eines Streifens (der las sich wie
		-- "durchgestrichen")
		for i, spot in { { 0.22, 0.24, 0.16 }, { 0.8, 0.76, 0.11 } } do
			local f = Kit.frame("Sparkle" .. i, badge, T.color.white)
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.Position = UDim2.fromScale(spot[1], spot[2])
			f.Size = UDim2.fromScale(spot[3], spot[3])
			f.Rotation = 45
			f.BackgroundTransparency = 0.25
			f.ZIndex = 33
			Kit.corner(f, 2)
		end
	elseif look == "Crystal" then
		mark("Gem", UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.62, 0.62), 45, 6)
	elseif look == "Endless" then
		mark("Ring", UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.8, 0.8), 0, 999)
	end

	local label = Kit.text("Numeral", badge, numeral, math.floor(size * 0.52), {
		color = T.color.white, stroke = T.stroke.text, align = Enum.TextXAlignment.Center,
	})
	label.Size = UDim2.fromScale(1, 1)
	label.ZIndex = 34
	local s = Kit.shine(badge, T.radius.badge, 0.32)
	s.ZIndex = 35
	return badge
end

-- Konfetti: wenige Schnipsel (Frames) fallen aus `origin` (Position in
-- `parent`), drehen sich und verblassen. Alles in der gemeinsamen Schleife,
-- nach T.motion.confetti wieder weg.
local CONFETTI_COLORS = { T.color.honey, T.color.gummy, T.color.sky, T.color.go, T.color.gold }

function Kit.confetti(parent: GuiObject, origin: Vector2, count: number?)
	local pieces: { { frame: Frame, vx: number, vy: number, spin: number } } = {}
	for i = 1, count or 22 do
		local f = Kit.frame("Confetti", parent, CONFETTI_COLORS[(i - 1) % #CONFETTI_COLORS + 1])
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Size = UDim2.fromOffset(math.random(7, 12), math.random(10, 16))
		f.Position = UDim2.fromOffset(origin.X, origin.Y)
		f.ZIndex = 60
		f.Rotation = math.random(0, 360)
		Kit.corner(f, 3)
		table.insert(pieces, {
			frame = f,
			vx = (math.random() - 0.5) * 520,
			vy = -(220 + math.random() * 260),
			spin = (math.random() - 0.5) * 900,
		})
	end
	local t0 = os.clock()
	local last = t0
	Kit.animate(function(now)
		local dt = math.min(now - last, 0.05)
		last = now
		local t = (now - t0) / T.motion.confetti
		for _, p in pieces do
			p.vy += 900 * dt
			local pos = p.frame.Position
			p.frame.Position = UDim2.fromOffset(pos.X.Offset + p.vx * dt, pos.Y.Offset + p.vy * dt)
			p.frame.Rotation += p.spin * dt
			p.frame.BackgroundTransparency = math.max(0, (t - 0.6) / 0.4)
		end
		if t >= 1 then
			for _, p in pieces do p.frame:Destroy() end
			return false
		end
		return true
	end)
end

return Kit
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX49"><Properties>
<string name="Name">Moment</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- Moment.luau
-- StarterPlayerScripts/UI/Moment.luau
--
-- Einzige Zustaendigkeit:
--   - Seltene, wichtige Ereignisse als grosses Icon in der Bildschirmmitte
--     zeigen (neuer Rekord, Freischaltung, Mutation, Rebirth …)
--
-- Kontext: HBB Paket 1. Hoechstens EIN kurzes Wort, Farbe der Rarity oder
-- des Ereignisses, ein kurzer Klang. Kein Ersatz fuer HatchAnimation: das
-- Schluepfen bleibt, wie es ist.
--
-- Momente kommen nacheinander, nie uebereinander. Die Warteschlange ist kurz
-- (FeedbackConfig.MOMENT_QUEUE); wer mehr ausloest, verliert die aeltesten.

local TweenService      = game:GetService("TweenService")
local SoundService      = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Loc            = require(ReplicatedStorage.Localization.Loc)
local FeedbackConfig = require(ReplicatedStorage.Config.FeedbackConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)

local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)

local Moment = {}

-- Art → Icon. Unbekannte Arten bekommen den Stern.
local ICON_FOR: { [string]: string } = {
	record    = "trophy",
	tower_unlocked = "crown",   -- 08.10. neuer Tower frei
	milestone = "trophy",
	unlock    = "tree",
	rebirth   = "rebirth",
	mutation  = "bear",
	rarity    = "crown",
	jackpot   = "egg",
	slot      = "check",
	boss      = "swords",
	chest     = "gift",
}

local ICON_SIZE = 150

type Job = { kind: string, color: Color3, shortKey: string? }

local _root: Frame? = nil
local _ring: Frame? = nil
local _iconHolder: Frame? = nil
local _word: TextLabel? = nil
local _scale: UIScale? = nil
local _queue: { Job } = {}
local _running = false

local function playSound()
	local sound = Instance.new("Sound")
	sound.SoundId = FeedbackConfig.MOMENT_SOUND
	sound.Volume  = FeedbackConfig.MOMENT_VOLUME
	SoundService:PlayLocalSound(sound)
	task.delay(3, function()
		sound:Destroy()
	end)
end

local function showOne(job: Job)
	local root, ring, holder, word, scale = _root, _ring, _iconHolder, _word, _scale
	if not root or not ring or not holder or not word or not scale then return end

	for _, child in holder:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	local icon = Icons.make(holder, ICON_FOR[job.kind] or "", "★")
	icon.Size = UDim2.fromScale(1, 1)
	icon.ZIndex = 72

	ring.BackgroundColor3 = job.color
	word.Text = if job.shortKey then Loc.t(job.shortKey) else ""
	word.TextColor3 = job.color
	word.Visible = job.shortKey ~= nil

	root.Visible = true
	ring.BackgroundTransparency = 0.25
	word.TextTransparency = 0
	scale.Scale = 0.2
	playSound()

	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.wait(FeedbackConfig.MOMENT_SECONDS)
	local fadeTime = 0.3
	TweenService:Create(scale, TweenInfo.new(fadeTime), { Scale = 1.25 }):Play()
	TweenService:Create(ring, TweenInfo.new(fadeTime), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(word, TweenInfo.new(fadeTime), { TextTransparency = 1 }):Play()
	if icon:IsA("ImageLabel") then
		TweenService:Create(icon, TweenInfo.new(fadeTime), { ImageTransparency = 1 }):Play()
	end
	task.wait(fadeTime)
	root.Visible = false
end

local function run()
	_running = true
	while #_queue > 0 do
		local job = table.remove(_queue, 1)
		if not job then break end
		showOne(job)
	end
	_running = false
end

-- kind: siehe ICON_FOR. color: Rarity-/Ereignisfarbe. shortKey: optionaler
-- Loc-Schluessel fuer EIN Wort (ui.moment.*).
function Moment.show(kind: string, color: Color3, shortKey: string?)
	if not FeatureFlags.isOn("UI_V2_FEEDBACK") then return end
	while #_queue >= FeedbackConfig.MOMENT_QUEUE do
		table.remove(_queue, 1)
	end
	table.insert(_queue, { kind = kind, color = color, shortKey = shortKey })
	if not _running then
		task.spawn(run)
	end
end

function Moment.init(screenGui: ScreenGui)
	local root = Theme.container("Moment", screenGui)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.42)
	root.Size = UDim2.fromOffset(ICON_SIZE + 60, ICON_SIZE + 110)
	root.ZIndex = 70
	root.Visible = false

	local scale = Instance.new("UIScale")
	scale.Parent = root

	local ring = Instance.new("Frame")
	ring.Name = "Ring"
	ring.AnchorPoint = Vector2.new(0.5, 0)
	ring.Position = UDim2.new(0.5, 0, 0, 0)
	ring.Size = UDim2.fromOffset(ICON_SIZE + 50, ICON_SIZE + 50)
	ring.BorderSizePixel = 0
	ring.ZIndex = 70
	ring.Parent = root
	Theme.corner(ring, (ICON_SIZE + 50) // 2)
	Theme.stroke(ring, Theme.COLORS.outline, 4)

	local holder = Theme.container("Icon", ring)
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromOffset(ICON_SIZE, ICON_SIZE)
	holder.ZIndex = 71

	local word = Theme.label("Word", root, "")
	word.AnchorPoint = Vector2.new(0.5, 1)
	word.Position = UDim2.new(0.5, 0, 1, 0)
	word.Size = UDim2.new(1, 80, 0, 50)
	word.TextXAlignment = Enum.TextXAlignment.Center
	word.ZIndex = 72
	Theme.outlineText(word, 3)
	local limit = word:FindFirstChildOfClass("UITextSizeConstraint")
	if limit then limit.MaxTextSize = 44 end

	_root, _ring, _iconHolder, _word, _scale = root, ring, holder, word, scale
	print("[Moment] Initialisiert")
end

return Moment
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX50"><Properties>
<string name="Name">PetBar</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PetBar.luau
-- StarterPlayerScripts/UI/PetBar.luau
--
-- Einzige Zustaendigkeit:
--   - Die untere Pet-Leiste: zwei grosse Knoepfe "Event" und "Fight", die den
--     ausgeruesteten Baerchi hinschicken bzw. zurueckholen.
--
-- Die Leiste ZEIGT nur an, was der Server meldet (PetModeChanged) — was ein
-- Klick bedeutet, entscheidet PetModeService. Der Client schickt nur, welcher
-- Knopf gedrueckt wurde, und beim Fight-Knopf ggf. die Wahl aus der
-- Fortsetzungs-Frage (PitResumeDialog).
--
-- Zustaende je Knopf:
--   normal        Normalfarbe, Klick schickt hin
--   unterwegs/da  leuchtet, Text "Zurueckholen"
--   wartet        der Baerchi geht erst heim und dann hierher; Klick bricht ab
--   gesperrt      grau, kleine Zeile mit dem Grund

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local FeatureFlags      = require(ReplicatedStorage.Config.FeatureFlags)

local Remotes          = require(ReplicatedStorage.Network.Remotes)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local Loc              = require(ReplicatedStorage.Localization.Loc)   -- Sammel-Update 2.4
local Names = require(game:GetService("ReplicatedStorage").Localization.Names)

local Theme           = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)   -- 08.10.: Tower-Name oeffnet das Tower-Panel
local UiScale         = require(script.Parent.UiScale)
local TouchSafeArea   = require(script.Parent.TouchSafeArea)
local Icons           = require(script.Parent.Icons)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local FightStartPrompt = require(script.Parent.FightStartPrompt)
local ClientState     = require(script.Parent.Parent.Controllers.ClientState)
local Unlock          = require(script.Parent.Unlock)

local PetBar = {}

local BUTTON_WIDTH  = 210
local BUTTON_HEIGHT = 68    -- Mindesthoehe 56 px fuer Touch
local GAP           = 14

local EVENT_COLOR = Color3.fromRGB(120, 190, 255)
local FIGHT_COLOR = Color3.fromRGB(255,  96,  96)
local GLOW_COLOR  = Color3.fromRGB(255, 236, 140)

type ButtonView = {
	button : TextButton,
	title  : TextLabel,
	sub    : TextLabel,
	stroke : UIStroke,
	color  : Color3,
	icon   : GuiObject,
}

local _event: ButtonView? = nil
local _fight: ButtonView? = nil

-- Letzte Server-Meldung (PetModeChanged)
local _state   = "Home"
-- Sammel-Update 05.10. (Paket 4.3): gewaehltes Wiedergabe-Tempo (0 = sofort)
local SPEED_STEPS = { 1, 2, 4, 0 }
local _bossAt: number? = nil   -- Sammel-Update 5.3
local _speedChoice = 1
local _speedButton: TextButton? = nil
local _pending: string? = nil
local _stage: number? = nil
local _tower: string? = nil   -- v15: Tower des laufenden Kampfs (vom Server)
local _from: string? = nil
local _abducting = false

-- Event-Zyklus (EventPhaseChanged)
local _eventId: string? = nil
local _nextEventId: string? = nil
local _phaseEndsAt = 0

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- HBB Paket 6: Icon je Event fuer den Timer am Knopf (Name aus UI/Icons,
-- sonst das Zeichen als Rueckfall). Die Wespenkoenigin bekommt ein eigenes.
local EVENT_ICON: { [string]: { name: string, fallback: string } } = {
	Ufo            = { name = "ufo",   fallback = "UFO" },
	HotEgg         = { name = "egg",   fallback = "🥚" },
	MutationsSturm = { name = "",      fallback = "🌪" },
	Koenigshuegel  = { name = "crown", fallback = "♛" },
	Schatzgraeber  = { name = "gift",  fallback = "💎" },
	WaspQueen      = { name = "",      fallback = "🐝" },
}

local function clock(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

local function eventLine(): string
	local remaining = _phaseEndsAt - os.clock()
	if _eventId then
		local def = EventConfig.getById(_eventId)
		return string.format("%s  %s", Names.event(_eventId), clock(remaining))
	end
	if _nextEventId then
		return Loc.t("ui.petbar.next_event", { t = clock(remaining) })
	end
	return ""
end

-- Sammel-Update 5.3: "🐝 Boss in 12 min" (bzw. "🐝 Boss LIVE").
local function bossLine(): string
	local at = _bossAt
	if not at then return "" end
	local left = at - os.clock()
	if left <= 0 then return Loc.t("ui.petbar.boss_live") end
	return Loc.t("ui.petbar.boss_in", { min = math.max(1, math.ceil(left / 60)) })
end

-- "Tower II" fuer eine Tower-Id.
local function towerLabel(towerId: string?): string
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	return Loc.t("ui.petbar.tower", { n = def.numeral })
end

-- HP-Anteil des ausgeruesteten Baerchis (nil = keiner da) und der gewaehlte
-- Tower (v15, ersetzt das PIT-Level).
local function fighterInfo(): (number?, string)
	local data = ClientState.get()
	if not data then return nil, "I" end

	local tower = if data.towers then data.towers.selected else "I"
	local uid = data.island.equippedUid
	local baerchi = if uid then data.island.baerchis[uid] else nil
	local def = if baerchi then BaerchiConfig.getById(baerchi.configId) else nil
	if not baerchi or not def then
		return nil, tower
	end

	local maxHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
	local hp = math.clamp(baerchi.currentHp or maxHp, 0, maxHp)
	return hp / math.max(1, maxHp), tower
end

local function paint(view: ButtonView, title: string, sub: string, mode: "normal" | "active" | "waiting" | "disabled")
	view.title.Text = title
	view.sub.Text   = sub

	if mode == "disabled" then
		view.button.Active           = false
		view.button.AutoButtonColor  = false
		view.button.BackgroundColor3 = Theme.COLORS.disabled
		view.stroke.Color            = Theme.COLORS.outline
		view.stroke.Thickness        = Theme.OUTLINE_THICKNESS
		view.title.TextTransparency  = 0.35
		Icons.tint(view.icon, Color3.fromRGB(140, 140, 150))
		return
	end

	Icons.tint(view.icon, Color3.new(1, 1, 1))

	view.button.Active          = true
	view.button.AutoButtonColor = false
	view.title.TextTransparency = 0

	if mode == "active" then
		view.button.BackgroundColor3 = Theme.shade(view.color, 0.15)
		view.stroke.Color            = GLOW_COLOR
		view.stroke.Thickness        = 5
	elseif mode == "waiting" then
		view.button.BackgroundColor3 = Theme.shade(view.color, -0.25)
		view.stroke.Color            = GLOW_COLOR
		view.stroke.Thickness        = 3
	else
		view.button.BackgroundColor3 = view.color
		view.stroke.Color            = Theme.COLORS.outline
		view.stroke.Thickness        = Theme.OUTLINE_THICKNESS
	end
end

--------------------------------------------------------------------------------
-- Anzeige
--------------------------------------------------------------------------------

local _eventIconKey: string? = nil

-- Tauscht das Icon des Event-Knopfs gegen das des kommenden/laufenden Events.
local function setEventIcon(view: ButtonView, eventId: string?)
	local key = eventId or "Ufo"
	if _eventIconKey == key then return end
	_eventIconKey = key
	local look = EVENT_ICON[key] or EVENT_ICON.Ufo
	local old = view.icon
	local icon = Icons.make(view.button, look.name, look.fallback)
	icon.AnchorPoint = old.AnchorPoint
	icon.Position    = old.Position
	icon.Size        = old.Size
	icon.ZIndex      = old.ZIndex
	old:Destroy()
	view.icon = icon
end

local function refresh()
	local event, fight = _event, _fight
	if not event or not fight then return end

	-- Paket 4.3: Tempo-Knopf nur im Tower
	local speedButton = _speedButton
	if speedButton then
		speedButton.Visible = _state == "InPit" or _state == "ToPit"
		speedButton.Text = if _speedChoice == 0 then "⏭ " .. Loc.t("ui.petbar.speed_skip") else "⏩ x" .. _speedChoice
	end

	-- HBB Paket 3: der Event-Knopf erscheint erst nach dem ersten Kampf
	Unlock.apply("button_event", event.button)

	local hpRatio, selectedTower = fighterInfo()
	local hasPet = hpRatio ~= nil

	-- --------------------------------------------------------------- Event
	local eventTitle = Loc.t("ui.petbar.event")
	local recall     = Loc.t("ui.petbar.recall")
	local waiting    = Loc.t("ui.petbar.waiting")
	if not hasPet then
		paint(event, eventTitle, Loc.t("ui.petbar.no_pet"), "disabled")
	elseif _abducting then
		paint(event, eventTitle, Loc.t("ui.petbar.abducted"), "disabled")
	elseif _state == "ToEvent" then
		paint(event, Loc.t("ui.petbar.recall"), Loc.t("ui.petbar.walking_there") .. " • " .. eventLine(), "active")
	elseif _state == "AtEvent" then
		paint(event, Loc.t("ui.petbar.recall"), eventLine(), "active")
	elseif _pending == "Event" then
		paint(event, Loc.t("ui.petbar.waiting"), Loc.t("ui.petbar.switch_hint"), "waiting")
	elseif _state == "Returning" and _from == "Event" then
		paint(event, eventTitle, Loc.t("ui.petbar.coming_home"), "normal")
	elseif FeatureFlags.isOn("EVENT_V2_TIMER") then
		-- HBB Paket 6: Icon des kommenden bzw. laufenden Events + Restzeit,
		-- keine Woerter.
		setEventIcon(event, _eventId or _nextEventId)
		paint(event, clock(_phaseEndsAt - os.clock()), bossLine(), "normal")
	else
		paint(event, eventTitle, eventLine(), "normal")
	end

	-- --------------------------------------------------------------- Fight
	local hpText = if hpRatio then string.format("HP %d%%  •  %s", math.floor(hpRatio * 100 + 0.5), towerLabel(selectedTower)) else ""

	local fightTitle = Loc.t("ui.petbar.fight")
	if not hasPet then
		paint(fight, fightTitle, Loc.t("ui.petbar.no_pet"), "disabled")
	elseif _state == "ToPit" then
		paint(fight, Loc.t("ui.petbar.recall"), Loc.t("ui.petbar.walking_pit"), "active")
	elseif _state == "InPit" then
		paint(fight, Loc.t("ui.petbar.recall"), if _stage then Loc.t("ui.petbar.in_pit_stage", { tower = towerLabel(_tower or selectedTower), stage = _stage }) else towerLabel(_tower or selectedTower), "active")
	elseif _pending == "Fight" then
		paint(fight, Loc.t("ui.petbar.waiting"), Loc.t("ui.petbar.switch_hint_pit"), "waiting")
	elseif _state == "Returning" and _from == "Fight" then
		paint(fight, fightTitle, Loc.t("ui.petbar.coming_home"), "normal")
	elseif (hpRatio or 0) <= 0 then
		paint(fight, fightTitle, Loc.t("ui.petbar.exhausted"), "disabled")
	else
		paint(fight, fightTitle, hpText, "normal")
	end
end

--------------------------------------------------------------------------------
-- Klicks
--------------------------------------------------------------------------------

local function onEventClicked()
	Unlock.markSeen("button_event")
	Remotes.RequestPetMode:FireServer("Event")
end

local function onFightClicked()
	-- Zurueckholen oder einen vorgemerkten Wechsel abbrechen: keine Frage.
	if _state == "ToPit" or _state == "InPit" or _pending == "Fight" then
		Remotes.RequestPetMode:FireServer("Fight")
		return
	end

	-- Neuer Lauf: gibt es einen letzten Lauf in diesem Tower, zuerst die
	-- Fortsetzungs-Frage.
	local data = ClientState.get()

	-- Entscheidung 05.10. (FIGHT_RESUME_PROMPT): Standard ist IMMER Stage 1.
	-- Der Einstieg ab der letzten Stage gegen Gummies ist ein kleines Feld,
	-- das nach 7 s von selbst verschwindet (dann Stage 1). Ein zweiter
	-- Fight-Klick waehrend das Feld offen ist, startet sofort bei Stage 1.
	if FeatureFlags.isOn("FIGHT_RESUME_PROMPT") then
		if FightStartPrompt.isOpen() then
			FightStartPrompt.chooseFresh()
			return
		end
		local opened = FightStartPrompt.open(function(choice)
			Remotes.RequestPetMode:FireServer("Fight", choice)
		end)
		if not opened then
			Remotes.RequestPetMode:FireServer("Fight", "Fresh")
		end
		return
	end

	-- HBB Paket 2: keine Frage mehr. Mit gespeichertem Lauf geht es
	-- kostenlos ab 65 % weiter; der bezahlte Einstieg ab der letzten Stage
	-- ist ein eigener kleiner Knopf im Tower-Fenster (CombatPanel). Der
	-- Server rechnet beide Wege unveraendert.
	if FeatureFlags.isOn("UI_V2_GUIDE") then
		local choice = if data and PitResumeDialog.getProgress(data) then "Percent" else "Fresh"
		Remotes.RequestPetMode:FireServer("Fight", choice)
		return
	end

	if data and PitResumeDialog.getProgress(data) then
		PitResumeDialog.open(function(choice)
			Remotes.RequestPetMode:FireServer("Fight", choice)
		end)
		return
	end

	Remotes.RequestPetMode:FireServer("Fight", "Fresh")
end

--------------------------------------------------------------------------------
-- HBB Paket 2: Anker fuer die Fuehrung (GuideController)
--------------------------------------------------------------------------------

-- 08.10.: letzter Zustand vom Server ("Home", "ToPit", "InPit", ...)
function PetBar.getState(): string
	return _state
end

function PetBar.getButton(mode: string): GuiObject?
	local view = if mode == "Fight" then _fight elseif mode == "Event" then _event else nil
	return if view then view.button else nil
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

local function buildButton(parent: Instance, name: string, color: Color3, order: number, onClick: () -> (), iconName: string, fallback: string): ButtonView
	local button = Theme.bigButton(name, parent, "", color)
	button.Size        = UDim2.fromOffset(BUTTON_WIDTH, BUTTON_HEIGHT)
	button.LayoutOrder = order

	local stroke = button:FindFirstChildOfClass("UIStroke") :: UIStroke

	-- Icon links, ragt oben ueber den Knopf hinaus
	local icon = Icons.make(button, iconName, fallback)
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.Position    = UDim2.new(0, 6, 0.5, -6)
	icon.Size        = UDim2.fromOffset(60, 60)
	icon.ZIndex      = 4

	-- Beschriftung setzt refresh() (in der Spielersprache); `name` ist nur der Instanz-Name
	local title = Theme.label("Title", button, "")
	title.Position       = UDim2.new(0, 64, 0, 6)
	title.Size           = UDim2.new(1, -72, 0, 30)
	title.TextXAlignment = Enum.TextXAlignment.Center
	title.TextColor3     = Theme.COLORS.text
	Theme.outlineText(title)

	local sub = Theme.label("Sub", button, "")
	sub.Position       = UDim2.new(0, 64, 1, -26)
	sub.Size           = UDim2.new(1, -70, 0, 18)
	sub.TextXAlignment = Enum.TextXAlignment.Center
	sub.TextScaled     = false
	sub.TextSize       = 12
	sub.Font           = Theme.FONT_BODY
	sub.TextColor3     = Theme.COLORS.outline
	sub.TextTruncate   = Enum.TextTruncate.AtEnd

	button.Activated:Connect(function()
		if not button.Active then return end
		onClick()
	end)

	return { button = button, title = title, sub = sub, stroke = stroke, color = color, icon = icon }
end

function PetBar.init(screenGui: ScreenGui)
	local bar = Theme.container("PetBar", screenGui)
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position    = UDim2.new(0.5, 0, 1, -14)
	bar.Size        = UDim2.fromOffset(BUTTON_WIDTH * 2 + GAP, BUTTON_HEIGHT)
	bar.ZIndex      = 5

	-- Auf schmalen Bildschirmen (Handy) mitskalieren statt ueber den Rand.
	-- Playtest 07.10.: auf Touch-Geraeten ausserdem raus aus der Zone des
	-- Bewegungs-Sticks und weg vom Sprung-Knopf (TouchSafeArea) — sonst
	-- loeste, wer laufen wollte, den Event-Knopf aus.
	local scale = Instance.new("UIScale")
	scale.Parent = bar
	local barWidth = BUTTON_WIDTH * 2 + GAP
	local function rescale()
		local zone = TouchSafeArea.zone(screenGui)
		if zone then
			bar.Position = UDim2.new(0, zone.center, 1, -14)
			scale.Scale  = math.clamp(zone.width / barWidth, 0.5, 1)
		else
			local width = UiScale.toGui(screenGui.AbsoluteSize.X)
			bar.Position = UDim2.new(0.5, 0, 1, -14)
			scale.Scale  = math.clamp((width - 32) / barWidth, 0.6, 1)
		end
	end
	TouchSafeArea.watch(screenGui, rescale)

	local layout = Theme.listLayout(bar, GAP, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	_event = buildButton(bar, "Event", EVENT_COLOR, 1, onEventClicked, "ufo", "UFO")
	_fight = buildButton(bar, "Fight", FIGHT_COLOR, 2, onFightClicked, "swords", "X")

	-- Sammel-Update 05.10. (Paket 4.3): Tempo-Knopf ueber dem Fight-Knopf,
	-- nur waehrend der Baerchi im Tower kaempft. Ein Tipp schaltet
	-- x1 -> x2 -> x4 -> "sofort" -> x1. Der Server spielt ab der naechsten
	-- Stage schneller ab; die Abrechnung bleibt gleich.
	local speedButton = Theme.button("SpeedButton", _fight.button, "⏩ x1", Theme.COLORS.panelLight)
	speedButton.AnchorPoint = Vector2.new(1, 1)
	speedButton.Position    = UDim2.new(1, 0, 0, -6)
	speedButton.Size        = UDim2.fromOffset(96, 34)
	speedButton.ZIndex      = 6
	speedButton.TextColor3  = Theme.COLORS.text
	speedButton.Visible     = false
	_speedButton = speedButton
	speedButton.Activated:Connect(function()
		local index = (table.find(SPEED_STEPS, _speedChoice) or 1) % #SPEED_STEPS + 1
		_speedChoice = SPEED_STEPS[index]
		Remotes.RequestPitSpeed:FireServer(_speedChoice)
		refresh()
	end)
	FightStartPrompt.init(screenGui, bar)

	-- 08.10. (Tower-Terminal): Antippen des Tower-Namens unter "Kampf"
	-- ("HP 100% · Tower I") oeffnet das Tower-Panel — derselbe Weg wie am
	-- Terminal, nur kuerzer. Eine unsichtbare Flaeche ueber der Unterzeile.
	local towerTap = Instance.new("TextButton")
	towerTap.Name = "TowerTap"
	towerTap.BackgroundTransparency = 1
	towerTap.Text = ""
	towerTap.AnchorPoint = Vector2.new(1, 1)
	towerTap.Position = UDim2.new(1, 0, 1, 0)
	towerTap.Size = UDim2.new(1, -64, 0, 30)
	towerTap.ZIndex = 7
	towerTap.Parent = _fight.button
	towerTap.Activated:Connect(function()
		if _state == "ToPit" or _state == "InPit" then
			onFightClicked()   -- waehrend des Kampfs bleibt es der Zurueckholen-Knopf
			return
		end
		PanelManager.open(PanelManager.ARENA_PANEL)
	end)

	PitResumeDialog.init(screenGui)

	Remotes.PetModeChanged.OnClientEvent:Connect(function(state: any, pending: any, info: any)
		_state   = if typeof(state) == "string" then state else "Home"
		_pending = if typeof(pending) == "string" then pending else nil
		local typedInfo = if typeof(info) == "table" then info else {}
		_stage     = if typeof(typedInfo.stage) == "number" then typedInfo.stage else nil
		_tower     = if typeof(typedInfo.tower) == "string" then typedInfo.tower else nil
		_from      = if typeof(typedInfo.from) == "string" then typedInfo.from else nil
		_abducting = typedInfo.abducting == true

		-- Laeuft der Baerchi los, ist eine offene Fortsetzungs-Frage hinfaellig.
		if _state ~= "Home" and _state ~= "Returning" and PitResumeDialog.isOpen() then
			PitResumeDialog.close()
		end

		refresh()
	end)

	Remotes.EventPhaseChanged.OnClientEvent:Connect(function(eventId: any, remaining: any, nextEventId: any, untilBoss: any)
		-- Sammel-Update 5.3: Countdown bis zum Boss
		_bossAt      = if typeof(untilBoss) == "number" then os.clock() + untilBoss else nil
		_eventId     = if typeof(eventId) == "string" then eventId else nil
		_nextEventId = if typeof(nextEventId) == "string" then nextEventId else nil
		_phaseEndsAt = os.clock() + (if typeof(remaining) == "number" then remaining else 0)
		refresh()
	end)

	ClientState.onChanged(refresh)
	Loc.onChanged(function() refresh() end)

	-- Restzeit des Events jede Sekunde nachziehen
	local accumulator = 0
	RunService.Heartbeat:Connect(function(delta)
		accumulator += delta
		if accumulator < 1 then return end
		accumulator = 0
		refresh()
	end)

	refresh()
	print("[PetBar] Initialisiert")
end

return PetBar
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX51"><Properties>
<string name="Name">PitResumeDialog</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- PitResumeDialog.luau
-- StarterPlayerScripts/UI/PitResumeDialog.luau
--
-- Einzige Zustaendigkeit:
--   - Vor einem PIT-Lauf fragen, wo eingestiegen wird: von vorn, ab 65 % des
--     letzten Laufs oder ab der letzten erreichten Stage (gegen Gummies).
--
-- v15: pro Tower. Erscheint nur, wenn es im GEWAEHLTEN Tower einen
-- gespeicherten letzten Lauf gibt (island.towerProgress), auch nach einer
-- Niederlage oder einem Zurueckholen. Startstage und Kosten rechnet
-- TowerConfig — dieselben
-- Funktionen benutzt der Server beim Abbuchen. Nicht bezahlbare Optionen sind
-- sichtbar, aber nicht klickbar. Abbrechen schliesst den Dialog, der Baerchi
-- bleibt zu Hause.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players           = game:GetService("Players")
local Loc = require(game:GetService("ReplicatedStorage").Localization.Loc)   -- Sammel-Update 2.4

local Types            = require(ReplicatedStorage.Network.Types)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local GamepassConfig   = require(ReplicatedStorage.Config.GamepassConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local Loc              = require(ReplicatedStorage.Localization.Loc)

local Theme       = require(script.Parent.Theme)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local PitResumeDialog = {}

export type Choice = "Fresh" | "Percent" | "Last"

local _root: Frame? = nil
local _hpLabel: TextLabel? = nil
local _options: { [Choice]: TextButton } = {}
local _onChoose: ((Choice) -> ())? = nil

local function selectedTower(data: Types.PlayerDataUpdate): string
	return if data.towers then data.towers.selected else TowerConfig.FIRST_TOWER
end

-- Die letzte erreichte Stage im gewaehlten Tower (nil = kein Lauf gespeichert).
function PitResumeDialog.getProgress(data: Types.PlayerDataUpdate): number?
	local progress = data.island.towerProgress
	local reached = if progress then progress[selectedTower(data)] else nil
	if typeof(reached) == "number" and reached >= 1 then
		return reached
	end
	return nil
end

-- Start-Stage und Gummi-Kosten einer Option — dieselbe Rechnung wie
-- CombatService.getResumeOffer (TowerConfig). Oeffentlich fuer FightStartPrompt.
local function offer(data: Types.PlayerDataUpdate, choice: Choice): (number, number)
	if choice == "Fresh" then
		return 1, 0
	end
	local reached = PitResumeDialog.getProgress(data)
	if not reached then
		return 1, 0
	end
	local towerId = selectedTower(data)
	local def = TowerConfig.get(towerId)
	local stage = if choice == "Last"
		then reached
		else TowerConfig.getResumePercentStage(reached)
	stage = math.clamp(stage, 1, if def then def.stages else 1)
	return stage, TowerConfig.getResumeCost(towerId, stage, data.rebirthMult, PitResumeDialog.hasSkipPass())
end

-- 08.10. (Paket C): Gamepass Gratis-Skip besessen? Nur Anzeige — die Kosten
-- rechnet der Server selbst (GamepassService), das Attribut setzt er auch.
function PitResumeDialog.hasSkipPass(): boolean
	return Players.LocalPlayer:GetAttribute(GamepassConfig.attributeName("SKIP_PASS")) == true
end

-- Sammel-Update 2.4: Schluessel statt fester Texte
local LABELS: { [Choice]: string } = {
	Fresh   = "ui.resume.fresh",
	Percent = "ui.resume.percent",
	Last    = "ui.resume.last",
}

local function fill()
	local data = ClientState.get()
	if not data then return end

	for choice, button in _options do
		local stage, cost = offer(data, choice)
		local affordable = cost <= data.gummies

		button.Text = Loc.t("ui.pit_resume.option", {
			label = Loc.t(LABELS[choice]),
			stage = stage,
			cost  = if cost > 0 then Loc.t("event.bonus.gummies", { n = cost }) else Loc.t("ui.resume.free"),
		})
		Theme.setEnabled(button, affordable)
	end

	local hpLabel = _hpLabel
	if hpLabel then
		local uid = data.island.equippedUid
		local baerchi = if uid then data.island.baerchis[uid] else nil
		local def = if baerchi then BaerchiConfig.getById(baerchi.configId) else nil
		local reached = PitResumeDialog.getProgress(data)
		if baerchi and def then
			local maxHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
			local hp = math.clamp(baerchi.currentHp or maxHp, 0, maxHp)
			hpLabel.Text = Loc.t("ui.resume.status", {
				tower = (TowerConfig.get(selectedTower(data)) or TowerConfig.TOWERS[1]).numeral,
				stage = reached or 0,
				hp = hp, max = maxHp, pct = math.floor(hp / math.max(1, maxHp) * 100 + 0.5),
			})
		end
	end
end

function PitResumeDialog.offer(data: Types.PlayerDataUpdate, choice: Choice): (number, number)
	return offer(data, choice)
end

function PitResumeDialog.close()
	_onChoose = nil
	local root = _root
	if root then root.Visible = false end
end

-- Oeffnet den Dialog. `onChoose` bekommt die gewaehlte Option.
function PitResumeDialog.open(onChoose: (Choice) -> ())
	local root = _root
	if not root then return end
	_onChoose = onChoose
	fill()
	root.Visible = true
end

function PitResumeDialog.isOpen(): boolean
	return _root ~= nil and (_root :: Frame).Visible
end

function PitResumeDialog.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"PitResumeDialog", screenGui,
		Vector2.new(0.46, 0.42),
		Vector2.new(300, 280),
		Vector2.new(520, 340)
	)
	root.ZIndex = 20
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.resume.title"), PitResumeDialog.close)

	local body = Theme.dialogBody(root)
	local layout = Theme.listLayout(body, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local hp = Theme.bodyText("Hp", body, "")
	hp.Size        = UDim2.new(1, 0, 0, 20)
	hp.LayoutOrder = 0
	_hpLabel = hp

	local colors: { [Choice]: Color3 } = {
		Fresh   = Theme.COLORS.accent,
		Percent = Theme.COLORS.goldGummy,
		Last    = Theme.COLORS.bad,
	}

	for order, choice in { "Fresh", "Percent", "Last" } :: { Choice } do
		local button = Theme.bigButton("Option_" .. choice, body, Loc.t(LABELS[choice]), colors[choice])
		button.Size        = UDim2.new(1, 0, 0, 44)
		button.LayoutOrder = order
		button.Activated:Connect(function()
			if not button.Active then return end
			local callback = _onChoose
			PitResumeDialog.close()
			if callback then callback(choice) end
		end)
		_options[choice] = button
	end

	local cancel = Theme.button("Cancel", body, "", Theme.COLORS.panelLight)
	Loc.bind(cancel, "ui.common.cancel")
	cancel.Size        = UDim2.new(1, 0, 0, 34)
	cancel.LayoutOrder = 10
	cancel.TextColor3  = Theme.COLORS.text
	cancel.Activated:Connect(PitResumeDialog.close)

	ClientState.onChanged(function()
		if PitResumeDialog.isOpen() then fill() end
	end)
	Loc.onChanged(function()
		if PitResumeDialog.isOpen() then fill() end
	end)

	print("[PitResumeDialog] Initialisiert")
end

return PitResumeDialog
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX52"><Properties>
<string name="Name">Theme</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- Theme.luau
-- StarterPlayerScripts/UI/Theme.luau
--
-- Einzige Zustaendigkeit:
--   - Farben, Schrift und Baustein-Helfer fuer das gesamte UI
--
-- Kein UI-Modul definiert eigene Farben oder baut Frames von Hand —
-- alles laeuft hier durch. Wenn der Look sich aendert, aendert er sich hier.
--
-- Die Rarity-Farben kommen bewusst NICHT von hier, sondern aus
-- BaerchiConfig.RARITY_COLORS: der Server faerbt die Figuren auf der Insel
-- mit denselben Werten, und die duerfen nicht auseinanderlaufen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")

local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local Types         = require(ReplicatedStorage.Network.Types)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local RarityBandConfig = require(ReplicatedStorage.Config.RarityBandConfig)  -- HBB Paket 4

local Theme = {}

--------------------------------------------------------------------------------
-- Farben
--------------------------------------------------------------------------------

Theme.COLORS = {
	-- Flaechen
	panel      = Color3.fromRGB( 52,  46,  78),
	panelDeep  = Color3.fromRGB( 38,  34,  58),
	panelLight = Color3.fromRGB( 72,  64, 104),

	-- Rahmen (der dicke dunkle Cartoon-Rand)
	outline    = Color3.fromRGB( 24,  20,  38),

	-- Schrift
	text       = Color3.fromRGB(255, 255, 255),
	textDim    = Color3.fromRGB(188, 182, 210),

	-- Waehrungen
	gummy      = Color3.fromRGB(255, 105, 150),
	goldGummy  = Color3.fromRGB(255, 196,  60),

	-- Zustaende
	good       = Color3.fromRGB( 76, 217, 100),
	bad        = Color3.fromRGB(255,  82,  82),
	accent     = Color3.fromRGB(120, 190, 255),

	-- Die drei Gebaeude-Rollen (siehe Theme.buildingColor). Benannt nach der
	-- ROLLE, nicht nach dem Gebaeude: die Farbe soll sagen WOFUER sein Honig
	-- gut ist.
	volume     = Color3.fromRGB(255, 186,  62),   -- Vorrat
	healing    = Color3.fromRGB( 92, 222, 160),   -- Heilung
	growth     = Color3.fromRGB(178, 148, 255),   -- Wachstum

	-- Ausgegrauter Button (siehe Theme.setEnabled)
	disabled   = Color3.fromRGB( 84,  80, 104),
}

Theme.FONT      = Enum.Font.FredokaOne
Theme.FONT_BODY = Enum.Font.GothamMedium

-- Dicke des Cartoon-Rands
Theme.OUTLINE_THICKNESS = 3
Theme.CORNER_RADIUS     = 14

function Theme.rarityColor(rarity: Types.Rarity): Color3
	return BaerchiConfig.getRarityColor(rarity)
end

-- Akzentfarbe eines Honig-Gebaeudes.
--
-- Die Zuordnung steht an EINER Stelle, genau wie bei rarityColor: das
-- Gebaeude-Panel faerbt damit seine Karten, die Baerchi-Detailkarte ihre
-- Fuetter-Knoepfe. Zwei getrennte Listen waeren die naechste Stelle, an der
-- Farbe und Gebaeude auseinanderlaufen.
--
-- Was die Farben BEDEUTEN, steht bei den Rollen in Config/BuildingBehavior:
-- Bienenstock = Vorrat, Honigtopf = Heilung, Honig-Presse = Wachstum.
local BUILDING_COLORS: { [string]: Color3 } = {
	Beehive    = Theme.COLORS.volume,
	HoneyRefiner = Theme.COLORS.growth,
	HoneyPond  = Theme.COLORS.goldGummy,   -- Honig-Teich / -Brunnen (HONEY_POND_V2)
}

-- HBB Paket 4: Farben der fuenf Rarity-Baender (Zuordnung in
-- Config/RarityBandConfig). Kraeftig und weit auseinander, damit ein Kind
-- sie ohne Text unterscheidet.
Theme.BAND_COLORS = {
	Color3.fromRGB(176, 190, 204),   -- 1 grau
	Color3.fromRGB( 46, 155, 255),   -- 2 blau
	Color3.fromRGB(255, 176,  32),   -- 3 gold
	Color3.fromRGB(168,  85, 247),   -- 4 lila
	Color3.fromRGB(255,  70, 110),   -- 5 rot-pink
}

function Theme.bandColor(rarity: string): Color3
	return Theme.BAND_COLORS[RarityBandConfig.bandOf(rarity)] or Theme.BAND_COLORS[1]
end

function Theme.buildingColor(buildingId: string): Color3
	return BUILDING_COLORS[buildingId] or Theme.COLORS.accent
end

--------------------------------------------------------------------------------
-- Bausteine
--------------------------------------------------------------------------------

function Theme.corner(parent: Instance, radius: number?): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or Theme.CORNER_RADIUS)
	corner.Parent = parent
	return corner
end

function Theme.stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color        = color or Theme.COLORS.outline
	stroke.Thickness    = thickness or Theme.OUTLINE_THICKNESS
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent       = parent
	return stroke
end

-- Hellere bzw. dunklere Variante einer Farbe. `amount` > 0 hellt auf, < 0
-- dunkelt ab, jeweils 0..1. Damit muss keine Farbvariante von Hand gepflegt
-- werden — jede Flaeche kann sich ihre Abstufung aus der Grundfarbe holen.
function Theme.shade(color: Color3, amount: number): Color3
	if amount >= 0 then
		return color:Lerp(Color3.new(1, 1, 1), math.clamp(amount, 0, 1))
	end
	return color:Lerp(Color3.new(0, 0, 0), math.clamp(-amount, 0, 1))
end

-- Farbverlauf ueber eine Flaeche.
--
-- Der kuerzeste Weg von "Platzhalter" zu "Spiel": eine flache Farbe sieht aus
-- wie ein unfertiges Rechteck, dieselbe Farbe mit einem Verlauf sieht aus wie
-- ein Knopf. Wird fuer die Kopfbalken und die grossen Knoepfe der
-- Gebaeude-Menues benutzt.
--
-- `rotation` in Grad: 90 = von oben nach unten (Standard).
function Theme.gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	-- Ein vorhandener Verlauf wird ueberschrieben statt gestapelt: zwei
	-- UIGradients multiplizieren sich und machen den Knopf dunkel. So kann
	-- Theme.button schon einen Grundverlauf setzen, und bigButton oder eine
	-- Kachel faerbt ihn nur um.
	local gradient = parent:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, top),
		ColorSequenceKeypoint.new(1, bottom),
	})
	gradient.Rotation = rotation or 90
	gradient.Parent   = parent
	return gradient
end

function Theme.padding(parent: Instance, px: number): UIPadding
	local padding = Instance.new("UIPadding")
	padding.PaddingTop    = UDim.new(0, px)
	padding.PaddingBottom = UDim.new(0, px)
	padding.PaddingLeft   = UDim.new(0, px)
	padding.PaddingRight  = UDim.new(0, px)
	padding.Parent        = parent
	return padding
end

function Theme.listLayout(parent: Instance, padding: number, horizontal: boolean?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.FillDirection       = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	layout.SortOrder           = Enum.SortOrder.LayoutOrder
	layout.Padding             = UDim.new(0, padding)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment   = Enum.VerticalAlignment.Top
	layout.Parent              = parent
	return layout
end

-- Durchsichtiger Container ohne Rand
function Theme.container(name: string, parent: Instance): Frame
	local frame = Instance.new("Frame")
	frame.Name                   = name
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel        = 0
	frame.Parent                 = parent
	return frame
end

-- Gefuellte Flaeche mit Rundung und Cartoon-Rand
function Theme.panel(name: string, parent: Instance, color: Color3?): Frame
	local frame = Instance.new("Frame")
	frame.Name            = name
	frame.BackgroundColor3 = color or Theme.COLORS.panel
	frame.BorderSizePixel = 0
	frame.Parent          = parent

	Theme.corner(frame)
	Theme.stroke(frame)
	-- Leichter Verlauf: eine flache Flaeche wirkt wie ein Platzhalter, mit
	-- hellerer Oberkante wie ein Spielelement.
	-- (Ein UIGradient MULTIPLIZIERT sich auf die Hintergrundfarbe: weiss =
	-- unveraendert, grau = dunkler. Deshalb neutrale Farben, nicht shade().)
	Theme.gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(196, 196, 208))
	return frame
end

-- Heller Glanzstreifen auf der oberen Haelfte eines Knopfes — der kleine
-- Kniff, der aus einem Rechteck einen "Cartoon-Knopf" macht. Faengt keine
-- Klicks ab (Frame, nicht aktiv).
function Theme.shine(parent: GuiObject, radius: number?): Frame
	local shine = Instance.new("Frame")
	shine.Name                   = "Shine"
	shine.AnchorPoint            = Vector2.new(0.5, 0)
	shine.Position               = UDim2.new(0.5, 0, 0, 3)
	shine.Size                   = UDim2.new(1, -10, 0.42, 0)
	shine.BackgroundColor3       = Color3.new(1, 1, 1)
	shine.BackgroundTransparency = 0.82
	shine.BorderSizePixel        = 0
	shine.Active                 = false
	shine.Parent                 = parent
	Theme.corner(shine, radius or 8)
	return shine
end

-- Weiches Anwachsen beim Drueberfahren, Eindruecken beim Druecken. Ein
-- UIScale statt Size, damit Layouts und Tweens an der Groesse unberuehrt bleiben.
local PRESS_TWEEN = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function Theme.pressable(button: GuiButton, hover: number?)
	local grow = hover or 1.06
	local scale = Instance.new("UIScale")
	scale.Name   = "PressScale"
	scale.Parent = button

	local function to(target: number)
		TweenService:Create(scale, PRESS_TWEEN, { Scale = target }):Play()
	end

	button.MouseEnter:Connect(function()
		if button.Active then to(grow) end
	end)
	button.MouseLeave:Connect(function()
		to(1)
	end)
	button.MouseButton1Down:Connect(function()
		if button.Active then to(0.93) end
	end)
	button.MouseButton1Up:Connect(function()
		if button.Active then to(grow) end
	end)
end

function Theme.label(name: string, parent: Instance, text: string?): TextLabel
	local label = Instance.new("TextLabel")
	label.Name                   = name
	label.BackgroundTransparency = 1
	label.Font                   = Theme.FONT
	label.Text                   = text or ""
	label.TextColor3             = Theme.COLORS.text
	label.TextScaled             = true
	label.TextXAlignment         = Enum.TextXAlignment.Left
	label.Parent                 = parent

	-- Verhindert absurd grosse Schrift auf hohen Frames
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 28
	constraint.MinTextSize = 8
	constraint.Parent      = label

	return label
end

-- Kleiner, mehrzeiliger Fliesstext (Beschreibungen, Effekt-Texte).
-- Bewusst mit fester TextSize statt TextScaled: umgebrochener Text
-- wird sonst je nach Zeilenzahl unterschiedlich gross.
function Theme.bodyText(name: string, parent: Instance, text: string?): TextLabel
	local label = Instance.new("TextLabel")
	label.Name                   = name
	label.BackgroundTransparency = 1
	label.Font                   = Theme.FONT_BODY
	label.Text                   = text or ""
	label.TextColor3             = Theme.COLORS.textDim
	label.TextScaled             = false
	label.TextSize               = 14
	label.TextWrapped            = true
	label.TextXAlignment         = Enum.TextXAlignment.Left
	label.TextYAlignment         = Enum.TextYAlignment.Top
	label.Parent                 = parent
	return label
end

function Theme.button(name: string, parent: Instance, text: string, color: Color3?): TextButton
	local button = Instance.new("TextButton")
	button.Name             = name
	button.BackgroundColor3  = color or Theme.COLORS.accent
	button.BorderSizePixel   = 0
	button.Font              = Theme.FONT
	button.Text              = text
	button.TextColor3        = Theme.COLORS.outline
	button.TextScaled        = true
	button.AutoButtonColor   = true
	button.Parent            = parent

	Theme.corner(button, 12)
	Theme.stroke(button)

	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 24
	constraint.MinTextSize = 8
	constraint.Parent      = button

	-- Cartoon-Look: Verlauf + Glanzstreifen + Hover/Druck-Animation.
	-- AutoButtonColor aus: der Standard-Abdunkler faerbt sonst den ganzen
	-- Verlauf grau; die Animation uebernimmt das Feedback.
	-- Neutraler Verlauf (multipliziert sich auf die Knopffarbe, siehe panel).
	Theme.gradient(button, Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 190, 200))
	Theme.shine(button, 9)
	button.AutoButtonColor = false
	Theme.pressable(button)

	return button
end

-- Button ausgrauen bzw. wieder freigeben.
--
-- Das ist reiner Komfort: der Server prueft jede Anfrage selbst und schickt
-- bei Ablehnung ein ActionFailed (→ Toast). Ein ausgegrauter Button ist nur
-- die freundliche Vorwarnung, nie die Absicherung.
--
-- Die urspruengliche Farbe wird beim ersten Ausgrauen als Attribut gemerkt,
-- damit der Aufrufer sie nicht selbst mitschleppen muss.
-- Grosser, bunter Aktionsknopf mit Verlauf — der Knopf, um den herum ein
-- Menue gebaut wird ("AUSBAUEN", "FUETTERN"). Bewusst deutlich hoeher und
-- kraeftiger als Theme.button: in einem Menue soll auf einen Blick klar sein,
-- was der Hauptzweck ist.
function Theme.bigButton(name: string, parent: Instance, text: string, color: Color3): TextButton
	local button = Theme.button(name, parent, text, color)
	Theme.gradient(button, Theme.shade(color, 0.28), Theme.shade(color, -0.12))
	return button
end

-- Dunkler Umriss um die Schrift — der Look, den Roblox-Spiele fuer Beschriftungen
-- ueber bunten Flaechen benutzen. Ohne ihn verschwindet weisser Text auf gelben
-- Kacheln, und mit ihm wirkt jede Beschriftung wie aufgeklebt statt wie
-- hineingerechnet.
function Theme.outlineText(label: TextLabel, thickness: number?): TextLabel
	label.TextStrokeColor3       = Theme.COLORS.outline
	label.TextStrokeTransparency = 0
	label.RichText               = false

	local stroke = Instance.new("UIStroke")
	stroke.Color         = Theme.COLORS.outline
	stroke.Thickness     = thickness or 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent        = label

	return label
end

-- Kleine Grossbuchstaben-Ueberschrift ueber einem Abschnitt einer Karte.
function Theme.sectionLabel(name: string, parent: Instance, text: string, color: Color3?): TextLabel
	local label = Theme.label(name, parent, string.upper(text))
	label.TextColor3 = color or Theme.COLORS.textDim
	label.TextScaled = false
	label.TextSize   = 13
	label.Font       = Theme.FONT
	return label
end

function Theme.setEnabled(button: TextButton, enabled: boolean)
	local stored = button:GetAttribute("EnabledColor")
	if typeof(stored) ~= "Color3" then
		stored = button.BackgroundColor3
		button:SetAttribute("EnabledColor", stored)
	end

	button.Active          = enabled
	local shine = button:FindFirstChild("Shine")
	if shine and shine:IsA("GuiObject") then
		shine.Visible = enabled
	end
	button.BackgroundColor3 = if enabled then (stored :: Color3) else Theme.COLORS.disabled
	button.TextTransparency = if enabled then 0 else 0.4

	-- Ein Verlauf (Theme.bigButton) multipliziert sich auf die Hintergrundfarbe
	-- und wuerde den ausgegrauten Knopf weiter bunt aussehen lassen. Deshalb
	-- geht er beim Ausgrauen mit aus.
	local gradient = button:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Enabled = enabled
	end
end

-- Scrollbare Liste. Der Aufrufer haengt ein Theme.listLayout hinein und
-- setzt seine Zeilen auf UDim2.new(1, -8, 0, hoehe) — die -8 lassen Platz
-- fuer den Scrollbalken, sonst ragt jede Zeile darunter.
function Theme.scroller(name: string, parent: Instance): ScrollingFrame
	local scroller = Instance.new("ScrollingFrame")
	scroller.Name                   = name
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel        = 0
	scroller.ScrollBarThickness     = 6
	scroller.ScrollBarImageColor3   = Theme.COLORS.panelLight
	scroller.CanvasSize             = UDim2.new()
	scroller.AutomaticCanvasSize    = Enum.AutomaticSize.Y
	scroller.ScrollingDirection     = Enum.ScrollingDirection.Y
	scroller.Parent                 = parent
	return scroller
end

export type Progress = {
	track : Frame,
	fill  : Frame,
	text  : TextLabel,
}

-- Fortschrittsbalken mit Text darueber (Brut-Timer, XP, Kampf-HP).
function Theme.progress(parent: Instance, fillColor: Color3?): Progress
	local track = Theme.panel("Track", parent, Theme.COLORS.panelDeep)
	track.ClipsDescendants = true   -- damit der Fuellbalken die Rundung nicht ueberragt

	local fill = Instance.new("Frame")
	fill.Name             = "Fill"
	fill.Size             = UDim2.fromScale(0, 1)
	fill.BackgroundColor3  = fillColor or Theme.COLORS.accent
	fill.BorderSizePixel   = 0
	fill.Parent            = track
	Theme.corner(fill, 12)
	Theme.gradient(fill, Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 170, 185))
	Theme.shine(fill, 6).Size = UDim2.new(1, -8, 0.4, 0)

	local text = Theme.label("Text", track, "")
	text.Size           = UDim2.fromScale(1, 1)
	text.TextXAlignment = Enum.TextXAlignment.Center
	text.ZIndex         = 3
	Theme.outlineText(text, 2)

	return { track = track, fill = fill, text = text }
end

--------------------------------------------------------------------------------
-- Dialoge
--------------------------------------------------------------------------------

-- Ein Dialog laesst mindestens so viel vom Bildschirm frei (Anteil, je Achse).
local DIALOG_SCREEN_FILL = 0.94

-- Name des UIScale, mit dem ein Dialog auf kleine Bildschirme passt (siehe
-- Theme.dialog und Theme.dialogScale).
local FIT_SCALE_NAME = "FitScale"

-- Schliessen-Knopf (Sammel-Update 2.1: 44x40) plus eine unsichtbare
-- Trefferflaeche 56x56 darum — auf dem Handy trifft ein Daumen sonst leicht
-- daneben (Richtwert 44 pt).
local CLOSE_HIT = 56

-- Zentriertes Panel, standardmaessig unsichtbar. Groesse in Scale, damit es
-- auf Handy und Monitor passt; die Constraints halten es lesbar.
--
-- UI-Qualitaet Schritt 2: die Mindestgroesse (minSize) war auf kleinen
-- Bildschirmen groesser als der Bildschirm selbst — ein Handy quer hat ohne
-- Topbar rund 350 px Hoehe, Charms/Bestenliste/Kampf brauchen 420. Kopfzeile
-- und Schliessen-X lagen dann ausserhalb. Jetzt verkleinert ein UIScale
-- (FitScale) den GANZEN Dialog gleichmaessig, bis er passt: das Layout bleibt
-- wie gebaut, nur kleiner. Auf normalen Bildschirmen ist der Faktor 1.
function Theme.dialog(name: string, parent: Instance, scale: Vector2, minSize: Vector2, maxSize: Vector2): Frame
	local root = Theme.panel(name, parent, Theme.COLORS.panelDeep)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position    = UDim2.fromScale(0.5, 0.5)
	root.Size        = UDim2.fromScale(scale.X, scale.Y)
	root.Visible     = false
	root.ZIndex      = 10

	local constraint = Instance.new("UISizeConstraint")
	constraint.MinSize = minSize
	constraint.MaxSize = maxSize
	constraint.Parent  = root

	local fit = Instance.new("UIScale")
	fit.Name   = FIT_SCALE_NAME
	fit.Parent = root

	if parent:IsA("LayerCollector") then
		local screen = parent :: LayerCollector
		local function refit()
			-- AbsoluteSize sind echte Pixel; die globale UiScale (>= 1) rechnet
			-- sie in Oberflaechen-Einheiten um, in denen minSize gemeint ist.
			local global = screen:FindFirstChild("GlobalScale")
			local globalScale = if global and global:IsA("UIScale") then math.max(global.Scale, 0.01) else 1
			local room = screen.AbsoluteSize / globalScale * DIALOG_SCREEN_FILL
			if room.X <= 0 or room.Y <= 0 then return end
			fit.Scale = math.min(1, room.X / minSize.X, room.Y / minSize.Y)
		end
		screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
		-- Die globale UiScale kann nach dem Dialog angelegt werden (Main) und
		-- aendert sich mit der Fenstergroesse.
		screen.ChildAdded:Connect(function(child)
			if child.Name == "GlobalScale" and child:IsA("UIScale") then
				child:GetPropertyChangedSignal("Scale"):Connect(refit)
				refit()
			end
		end)
		local global = screen:FindFirstChild("GlobalScale")
		if global and global:IsA("UIScale") then
			global:GetPropertyChangedSignal("Scale"):Connect(refit)
		end
		refit()
	end

	return root
end

-- Gesamter Verkleinerungsfaktor der Dialoge, in denen `gui` steckt (1 = keiner).
-- Fuer Code, der AbsolutePosition/AbsoluteSize in eine Position INNERHALB eines
-- Dialogs zurueckrechnet (IndexView): erst UiScale.toGui, dann durch diesen Wert.
function Theme.dialogScale(gui: Instance): number
	local factor = 1
	local node: Instance? = gui
	while node do
		local fit = node:FindFirstChild(FIT_SCALE_NAME)
		if fit and fit:IsA("UIScale") then
			factor *= fit.Scale
		end
		node = node.Parent
	end
	return factor
end

-- Sammel-Update 2.1: der eine Schliessen-Knopf fuer alle Fenster (oben
-- rechts, gross genug zum Tippen). Fenster ohne dialogHeader (Baerchi-Karte)
-- setzen ihn direkt. `color` optional (Gebaeude-Menue: Ton seiner Farbe).
-- UI-Qualitaet: dazu eine unsichtbare Trefferflaeche (CLOSE_HIT) als Kind —
-- sie liegt ueber dem Knopf (ZIndexBehavior.Sibling) und nimmt jeden Klick in
-- ihrem Bereich an, auch knapp neben dem sichtbaren X.
function Theme.closeButton(parent: Instance, onClose: () -> (), color: Color3?): TextButton
	local close = Theme.button("Close", parent, "X", color or Theme.COLORS.bad)
	close.AnchorPoint = Vector2.new(1, 0.5)
	close.Position    = UDim2.new(1, 4, 0.5, 0)
	close.Size        = UDim2.new(0, 44, 0, 40)
	close.TextColor3  = Theme.COLORS.text
	close.ZIndex      = math.max(close.ZIndex, 12)
	close.Activated:Connect(onClose)

	local hit = Instance.new("TextButton")
	hit.Name                   = "CloseHit"
	hit.AnchorPoint            = Vector2.new(0.5, 0.5)
	hit.Position               = UDim2.fromScale(0.5, 0.5)
	hit.Size                   = UDim2.fromOffset(CLOSE_HIT, CLOSE_HIT)
	hit.BackgroundTransparency = 1
	hit.Text                   = ""
	hit.AutoButtonColor        = false
	hit.ZIndex                 = close.ZIndex
	hit.Parent                 = close
	hit.Activated:Connect(onClose)

	return close
end

-- Kopfzeile eines Dialogs: Titel links, Schliessen-Kreuz rechts.
-- Gibt das Titel-Label zurueck, damit der Aufrufer es spaeter aendern kann.
function Theme.dialogHeader(root: Frame, title: string, onClose: () -> ()): TextLabel
	-- Farbiger Titelbalken hinter der Kopfzeile (zuerst gebaut, liegt darum
	-- unter Titel und Kreuz).
	local band = Instance.new("Frame")
	band.Name             = "TitleBand"
	band.Position         = UDim2.new(0, 6, 0, 5)
	band.Size             = UDim2.new(1, -12, 0, 42)
	band.BackgroundColor3 = Color3.fromRGB(122, 104, 204)
	band.BorderSizePixel  = 0
	band.Parent           = root
	Theme.corner(band, 12)
	Theme.stroke(band, Theme.COLORS.outline, 2)
	Theme.gradient(band, Color3.fromRGB(255, 255, 255), Color3.fromRGB(176, 170, 215))
	Theme.shine(band, 8).Size = UDim2.new(1, -12, 0.36, 0)

	local header = Theme.container("Header", root)
	header.Position = UDim2.new(0, 14, 0, 11)
	header.Size     = UDim2.new(1, -28, 0, 30)

	local label = Theme.label("Title", header, title)
	label.Size = UDim2.new(1, -52, 1, 0)
	Theme.outlineText(label, 2)

	-- Sammel-Update 2.1: groesserer X-Knopf (Tippflaeche ~44 px, Apple/
	-- Google-Empfehlung) — er ragt bewusst etwas ueber die Kopfzeile hinaus.
	Theme.closeButton(header, onClose)

	return label
end

-- Inhaltsflaeche unter der Kopfzeile.
function Theme.dialogBody(root: Frame): Frame
	local body = Theme.container("Body", root)
	body.Position = UDim2.new(0, 14, 0, 48)
	body.Size     = UDim2.new(1, -28, 1, -62)
	return body
end

--------------------------------------------------------------------------------
-- Theme.v2 — Tokens des neuen Looks (08.10., Paket D)
--------------------------------------------------------------------------------
-- Nur UI/Kit (und Panels, die Kit benutzen) lesen diese Tabelle. Alles oben
-- (COLORS, panel, button, dialog ...) bleibt unveraendert: die alten Panels
-- sehen genauso aus wie vorher. Wer die Palette tauschen will, aendert NUR
-- die Werte hier — kein Kit-Baustein hat eine eigene Farbe oder Zahl.
--
-- Richtung: warm und freundlich (Honig-Amber, Baerchi-Braun, Gummi-Pink,
-- Himmelblau), helle Creme-Flaechen mit dicker schokobrauner Kontur, Knoepfe
-- mit 3D-Kante und Glanz. Masse in Oberflaechen-Einheiten (die globale
-- UiScale vergroessert auf grossen Bildschirmen, 1080p ~ x1,27). 8er-Raster.
-- Kontraste (WCAG, gerechnet im Bericht): ink auf surface 11,6:1, inkSoft auf
-- card 6,5:1; weisse Knopfschrift traegt immer eine 3-px-Kontur (ink).
Theme.v2 = {
	color = {
		-- Flaechen
		surface     = Color3.fromRGB(255, 244, 220),   -- Panel-Koerper (Creme)
		surfaceDeep = Color3.fromRGB(246, 226, 190),   -- Verlauf unten
		card        = Color3.fromRGB(255, 252, 243),   -- Karte
		cardLocked  = Color3.fromRGB(236, 226, 210),   -- gesperrte Karte
		sunk        = Color3.fromRGB(240, 222, 190),   -- Balken-Spur, Chips
		shadow      = Color3.fromRGB( 59,  34,  18),   -- Schlagschatten

		-- Schrift und Kontur
		ink         = Color3.fromRGB( 74,  44,  23),   -- Text (Schokolade)
		inkSoft     = Color3.fromRGB(122,  84,  53),   -- Nebentext
		outline     = Color3.fromRGB( 59,  34,  18),   -- dicke Kontur
		white       = Color3.fromRGB(255, 255, 255),

		-- Marke
		honey       = Color3.fromRGB(255, 182,  39),
		honeyTop    = Color3.fromRGB(255, 214, 100),
		honeyBottom = Color3.fromRGB(255, 152,  24),
		bear        = Color3.fromRGB(156,  98,  51),
		gummy       = Color3.fromRGB(255,  92, 154),
		gummyDeep   = Color3.fromRGB(214,  51, 120),
		sky         = Color3.fromRGB( 76, 195, 255),
		skyDeep     = Color3.fromRGB( 22, 120, 190),

		-- Knopf-Arten
		go          = Color3.fromRGB( 72, 196,  70),   -- Primaer (Gratis-Start)
		goTop       = Color3.fromRGB(120, 230, 100),
		goEdge      = Color3.fromRGB( 30, 128,  44),   -- 3D-Kante unten
		quiet       = Color3.fromRGB(255, 248, 232),   -- Sekundaer (Skip): Creme
		quietEdge   = Color3.fromRGB(214, 190, 150),
		gold        = Color3.fromRGB(255, 222, 128),   -- Premium (Pass): ruhiges Gold
		goldTop     = Color3.fromRGB(255, 243, 200),
		goldEdge    = Color3.fromRGB(206, 150,  30),
		choose      = Color3.fromRGB( 76, 195, 255),   -- "Waehlen" auf der Karte
		chooseEdge  = Color3.fromRGB( 22, 120, 190),

		-- Zustaende
		active      = Color3.fromRGB(255, 196,  40),   -- "AKTIV"-Band
		new         = Color3.fromRGB(255,  92, 154),   -- "NEU"-Abzeichen
		lock        = Color3.fromRGB(150, 132, 112),
		progress    = Color3.fromRGB( 72, 196,  70),
	},
	radius = { panel = 26, card = 18, button = 16, chip = 999, badge = 14 },
	stroke = { panel = 4, card = 3, button = 3, text = 3, textSmall = 2 },
	space  = { xs = 4, s = 8, m = 16, l = 24, xl = 32 },
	text   = {
		font      = Enum.Font.FredokaOne,
		title     = 40,
		cardTitle = 26,
		number    = 30,
		body      = 18,
		small     = 15,   -- nie kleiner (1080p: ~19 px)
		button    = 26,
	},
	motion = {
		open      = 0.32,   -- Panel springt auf (Back)
		stagger   = 0.05,   -- Karten nacheinander
		cardIn    = 0.28,
		press     = 0.10,
		pulse     = 1.6,    -- Sekunden je Puls (nur der Gratis-Start)
		glimmer   = 2.6,    -- Glanz ueber freie neue Karten
		confetti  = 1.2,
	},
}

--------------------------------------------------------------------------------
-- Formatierung
--------------------------------------------------------------------------------

-- Grosse Zahlen lesbar machen: 1234567 → "1.234.567" (de/es), "1,234,567" (en),
-- "1 234 567" (fr). Das Trennzeichen kommt aus der Sprache des Spielers — die
-- Logik steht in Loc, damit Server-Texte und UI dieselbe Formatierung teilen.
-- Bleibt als Theme-Funktion bestehen, damit kein UI-Modul umgeschrieben werden
-- muss, das schon formatNumber benutzt.
function Theme.formatNumber(value: number): string
	return Loc.formatNumber(value)
end

-- Restzeiten: "45s", "2m 05s", "1h 12m" (Einheiten je nach Sprache)
function Theme.formatDuration(seconds: number): string
	return Loc.formatDuration(seconds)
end

return Theme
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX53"><Properties>
<string name="Name">TowerPanel</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- TowerPanel.luau
-- StarterPlayerScripts/UI/TowerPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Das Tower-Fenster im neuen Look (08.10., Paket D, FeatureFlags.
--     TOWER_PANEL_V2): Tower waehlen (Karten mit Zustand AKTIV / WAEHLEN /
--     NEU / GESPERRT) und von hier aus losschicken (Einstiegsleiste mit
--     Gratis-Start, bezahltem Skip und Gamepass-Knopf).
--
-- Geoeffnet vom Tower-Terminal an der Bruecke (Hauptweg), vom Prompt an der
-- Arena, vom Antippen des Tower-Namens in der Pet-Leiste. Es meldet sich
-- unter dem Namen "Combat" an (PanelManager.ARENA_PANEL) — alle bisherigen
-- Wege zur Tower-Wahl landen damit hier. Lauf-Ergebnis- und Meilenstein-
-- Meldungen bleiben im CombatPanel (die laufen auch bei geschlossenem
-- Fenster).
--
-- Gebaut ausschliesslich aus UI/Kit (Tokens Theme.v2). Der Server prueft
-- alles selbst (offen? bezahlbar? Pass?); die Karten rechnen mit denselben
-- Funktionen aus TowerConfig nur fuer die Anzeige.
--
-- Hierarchie (Kinder 7-14): der Blick soll zuerst auf den GRATIS-Start
-- fallen — groesster Knopf, kraeftigste Farbe, als einziges Element mit Puls.
-- Der bezahlte Skip ist klein, cremefarben, ohne Glanz und Puls. Keine
-- falschen Countdowns, nichts versteckt.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types          = require(ReplicatedStorage.Network.Types)
local Remotes        = require(ReplicatedStorage.Network.Remotes)
local Loc            = require(ReplicatedStorage.Localization.Loc)
local TowerConfig    = require(ReplicatedStorage.Config.TowerConfig)
local GamepassConfig = require(ReplicatedStorage.Config.GamepassConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)

local Theme           = require(script.Parent.Theme)
local Kit             = require(script.Parent.Kit)
local Icons           = require(script.Parent.Icons)
local Notify          = require(script.Parent.Notify)
local Moment          = require(script.Parent.Moment)
local Toast           = require(script.Parent.Toast)
local PanelManager    = require(script.Parent.PanelManager)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local ClientState     = require(script.Parent.Parent.Controllers.ClientState)

local TowerPanel = {}

local T = Kit.T
local PANEL_NAME = PanelManager.ARENA_PANEL   -- "Combat"
local PASS_KEY   = "SKIP_PASS"

-- Masse (Oberflaechen-Einheiten, 8er-Raster)
local DESIGN     = Vector2.new(640, 688)
local MIN_HEIGHT = 316   -- Kopf + eine Karte + Leiste (kompakt)
local HEADER_H   = 84
local STATUS_H   = 40
local FOOTER_H   = 140
-- Kompakt (niedrige Bildschirme, Handy quer): kleinerer Kopf, ohne
-- Statuszeile und ohne die erste Leisten-Zeile (Gummies stehen ohnehin im
-- HUD); die Liste scrollt. Ab dieser Fensterhoehe:
local COMPACT_BELOW = 520
local HEADER_H_COMPACT = 60
local FOOTER_H_COMPACT = 104
local CARD_H     = 116
local PAD        = T.space.m
local BADGE      = 80
local RIGHT_W    = 140
-- Freie Raender: oben HUD-Luft, unten Pet-Leiste (68 + Abstand), rechts
-- Menueleiste (Kacheln bis 94 + Rand), links etwas Luft. Auf kurzen
-- Bildschirmen (Handy quer) stehen HUD-Pillen und Menueleiste neben dem
-- Fenster: dort links/rechts mehr Platz lassen, oben weniger.
local function reserve(screen: Vector2): Kit.Reserve
	if screen.Y < COMPACT_BELOW then
		return { top = 6, bottom = 90, left = 196, right = 84 }
	end
	-- Schmalere Bildschirme (Tablet, 1366): links an den HUD-Pillen vorbei
	local left = if screen.X < 1400 then 196 else 12
	return { top = 12, bottom = 96, left = left, right = 112 }
end
local _compact = false

type CardView = {
	def      : TowerConfig.TowerDef,
	card     : Kit.Card,
	badge    : Frame,
	lockIcon : GuiObject,
	title    : TextLabel,
	progress : Kit.Progress,
	reward   : TextLabel,
	rewardIcon : Frame,
	choose   : Kit.Button,
	active   : Frame,
	newBadge : Frame,
	lockChip : Frame,
	lockBar  : Kit.Progress,
	glimmer  : Frame,
	state    : string,
}

local _window: Kit.Window? = nil
local _status: { selected: Frame, record: Frame, nextOpen: Frame }? = nil
local _list: ScrollingFrame? = nil
local _cards: { [string]: CardView } = {}
local _order: { string } = {}
local _footer: Frame? = nil
local _gummyChip: Frame? = nil
local _hint: TextLabel? = nil
local _primary: Kit.Button? = nil
local _skip: Kit.Button? = nil
local _premium: Kit.Button? = nil
local _freeBadge: Frame? = nil
local _stopPulse: (() -> ())? = nil
local _stopLoop: (() -> ())? = nil
local _isOpen = false
local _petState = "Home"

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function towerName(id: string): string
	return Loc.t("tower." .. id .. ".name")
end

local function hasPass(): boolean
	return Players.LocalPlayer:GetAttribute(GamepassConfig.attributeName(PASS_KEY)) == true
end

local function cardState(def: TowerConfig.TowerDef, data: Types.PlayerDataUpdate): string
	local towers = data.towers
	if not towers then return if def.id == TowerConfig.FIRST_TOWER then "active" else "locked" end
	local open = TowerConfig.isOpen(data.rebirthCount, def.id, towers.records, (towers :: any).unlocked)
	if not open then return "locked" end
	if towers.selected == def.id then return "active" end
	if TowerConfig.isNew(def.id, towers :: any) then return "new" end
	return "open"
end

-- Naechster Meilenstein als (Icon-Name, Rueckfall, Text) fuer die Karte.
local function rewardHint(def: TowerConfig.TowerDef, data: Types.PlayerDataUpdate): (string?, string?, string?)
	local towers = data.towers
	local record = if towers then towers.records[def.id] or 0 else 0
	local claimed = if towers then towers.claimed[def.id] else nil
	local stage = TowerConfig.nextMilestoneStage(def.id, claimed, record + 1)
	if not stage then return nil, nil, nil end
	local m = TowerConfig.getMilestone(def.id, stage)
	if not m then return nil, nil, nil end
	if m.eggs > 0 then
		return "egg", "🥚", Loc.t("ui.tower2.reward_egg", { stage = stage, n = m.eggs })
	elseif m.goldGummies > 0 then
		return "goldgummy", "$", Loc.t("ui.tower2.reward_amount", { stage = stage, n = Theme.formatNumber(m.goldGummies) })
	elseif m.endlessLevels > 0 then
		return "trophy", "★", Loc.t("ui.tower2.reward_endless", { stage = stage, n = m.endlessLevels })
	end
	return "gummy", "G", Loc.t("ui.tower2.reward_amount", { stage = stage, n = Theme.formatNumber(m.gummies) })
end

--------------------------------------------------------------------------------
-- Karte
--------------------------------------------------------------------------------

local function buildCard(parent: Instance, def: TowerConfig.TowerDef, order: number): CardView
	local card = Kit.card("Tower_" .. def.id, parent, CARD_H)
	card.holder.LayoutOrder = order
	local face = card.face
	local endless = def.id == "Endless"
	if endless then
		-- Endless: besondere Karte in Rosa/Lila
		Kit.gradient(face, Color3.fromRGB(255, 236, 248), Color3.fromRGB(240, 214, 255))
	end

	local badge = Kit.towerBadge("Badge", face, def.look, def.color, def.numeral, BADGE)
	badge.AnchorPoint = Vector2.new(0, 0.5)
	badge.Position = UDim2.new(0, 14, 0.5, -1)

	local lockIcon = Kit.lockIcon(badge, 34)
	lockIcon.AnchorPoint = Vector2.new(1, 1)
	lockIcon.Position = UDim2.new(1, 8, 1, 8)
	lockIcon.ZIndex = 38

	local left = 14 + BADGE + 14
	local title = Kit.text("Title", face, towerName(def.id), T.text.cardTitle)
	title.Position = UDim2.fromOffset(left, 10)
	title.Size = UDim2.new(1, -(left + RIGHT_W + 12), 0, 30)
	title.ZIndex = 32

	local progress = Kit.progress("Record", face, 26)
	progress.track.Position = UDim2.fromOffset(left, 46)
	progress.track.Size = UDim2.new(1, -(left + RIGHT_W + 16), 0, 26)

	local rewardIcon = Kit.frame("RewardIcon", face)
	rewardIcon.Position = UDim2.fromOffset(left, 80)
	rewardIcon.Size = UDim2.fromOffset(24, 24)
	rewardIcon.ZIndex = 32
	local reward = Kit.text("Reward", face, "", T.text.small + 1, { color = T.color.inkSoft })
	reward.Position = UDim2.fromOffset(left + 30, 80)
	reward.Size = UDim2.new(1, -(left + 30 + RIGHT_W + 12), 0, 24)
	reward.ZIndex = 32

	-- Rechts: Waehlen-Knopf ...
	local choose = Kit.button("Choose", face, "choose", Loc.t("ui.tower2.choose"), 24)
	choose.button.AnchorPoint = Vector2.new(1, 0.5)
	choose.button.Position = UDim2.new(1, -14, 0.5, 0)
	choose.button.Size = UDim2.fromOffset(RIGHT_W - 8, 64)
	choose.button.Activated:Connect(function()
		if not choose.button.Active then return end
		Kit.playSound("select")
		Remotes.RequestSelectTower:FireServer(def.id)
	end)

	-- ... oder AKTIV-Band ...
	local active = Kit.badge("Active", face, Loc.t("ui.tower2.active"), T.color.active, 0)
	active.AnchorPoint = Vector2.new(1, 0.5)
	active.Position = UDim2.new(1, -18, 0.5, 0)
	active.Size = UDim2.fromOffset(0, 40)
	local activeLabel = active:FindFirstChild("Text") :: TextLabel
	activeLabel.TextSize = 22

	-- ... oder Fortschritt zur Freischaltung
	local lockChip = Kit.frame("LockInfo", face)
	lockChip.AnchorPoint = Vector2.new(1, 0.5)
	lockChip.Position = UDim2.new(1, -14, 0.5, 0)
	lockChip.Size = UDim2.fromOffset(RIGHT_W, 68)
	lockChip.ZIndex = 32
	local lockText = Kit.text("Text", lockChip, "", T.text.small + 1, { color = T.color.ink, align = Enum.TextXAlignment.Center, wrap = true })
	lockText.Size = UDim2.new(1, 0, 0, 36)
	lockText.ZIndex = 33
	local lockBar = Kit.progress("Bar", lockChip, 24, T.color.honey)
	lockBar.track.Position = UDim2.fromOffset(0, 40)

	-- NEU-Aufkleber oben links (schraeg) und Glanz fuer frisch freie Karten
	local newBadge = Kit.badge("New", card.holder, Loc.t("ui.tower2.new"), T.color.new, -10)
	newBadge.Position = UDim2.fromOffset(46, 4)
	newBadge.ZIndex = 45
	local newLabel = newBadge:FindFirstChild("Text") :: TextLabel
	newLabel.ZIndex = 46

	local glimmer = Kit.frame("Glimmer", face, T.color.white)
	glimmer.Size = UDim2.new(0.22, 0, 1, 0)
	glimmer.Rotation = 18
	glimmer.BackgroundTransparency = 0.6
	glimmer.ZIndex = 31
	glimmer.Visible = false
	local glimmerFade = Instance.new("UIGradient")
	glimmerFade.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1),
	})
	glimmerFade.Parent = glimmer
	face.ClipsDescendants = false

	return {
		def = def, card = card, badge = badge, lockIcon = lockIcon, title = title,
		progress = progress, reward = reward, rewardIcon = rewardIcon, choose = choose,
		active = active, newBadge = newBadge, lockChip = lockChip, lockBar = lockBar,
		glimmer = glimmer, state = "",
	}
end

local function refreshCard(view: CardView, data: Types.PlayerDataUpdate)
	local def = view.def
	local towers = data.towers
	local state = cardState(def, data)
	view.state = state
	local record = if towers then towers.records[def.id] or 0 else 0
	local endless = def.id == "Endless"

	view.title.Text = if endless
		then towerName(def.id)
		else Loc.t("ui.tower2.title_stages", { tower = towerName(def.id), stages = def.stages })

	local locked = state == "locked"
	view.lockIcon.Visible = locked
	view.choose.button.Visible = state == "open" or state == "new"
	view.active.Visible = state == "active"
	view.newBadge.Visible = state == "new"
	view.lockChip.Visible = locked
	view.glimmer.Visible = state == "new"

	-- Rekord-Balken (Endless: ohne Ende, Balken zeigt das naechste Zehnerziel)
	if endless then
		local goal = math.max(10, (math.floor(record / 10) + 1) * 10)
		view.progress.set(record / goal, Loc.t("ui.tower2.record_endless", { record = record }))
	else
		view.progress.set(record / def.stages, Loc.t("ui.tower2.record", { record = record, stages = def.stages }))
	end
	view.progress.track.Visible = not locked or record > 0

	-- Meilenstein
	for _, child in view.rewardIcon:GetChildren() do child:Destroy() end
	local iconName, fallback, text = rewardHint(def, data)
	if iconName and text and not locked then
		local icon = Icons.make(view.rewardIcon, iconName, fallback)
		icon.Size = UDim2.fromScale(1, 1)
		icon.ZIndex = 33
		view.reward.Text = text
		view.reward.Visible = true
	else
		view.reward.Visible = locked
		view.reward.Text = if locked then "🔒 " .. Loc.t("ui.tower2.locked_hint") else ""
	end
	-- Gesperrt: Hinweis in die Mitte der Karte (dort stuende sonst der Balken)
	view.reward.Position = UDim2.fromOffset(14 + BADGE + 14 + (if locked then 0 else 30), if locked then 48 else 80)

	-- Gesperrt: gedaempft, aber lesbar
	if locked then
		local prev, have, need = TowerConfig.getUnlockProgress(def.id, if towers then towers.records else nil)
		local lockText = view.lockChip:FindFirstChild("Text") :: TextLabel
		lockText.Text = if prev
			then Loc.t("ui.tower2.unlock_by", { tower = towerName(prev) })
			else ""
		view.lockBar.set(if need > 0 then have / need else 0, string.format("%d/%d", have, need))
		Kit.gradient(view.card.face, T.color.cardLocked, T.color.sunk)
		Kit.gradient(view.badge, Theme.shade(def.color, 0.1):Lerp(T.color.lock, 0.6), T.color.lock)
	else
		if endless then
			Kit.gradient(view.card.face, Color3.fromRGB(255, 236, 248), Color3.fromRGB(240, 214, 255))
		else
			Kit.gradient(view.card.face, T.color.card, T.color.surface)
		end
		Kit.gradient(view.badge, Theme.shade(def.color, 0.35), Theme.shade(def.color, -0.12))
	end

	view.card.stroke.Color = if state == "active" then T.color.honeyBottom else T.color.outline
	view.card.stroke.Thickness = if state == "active" then T.stroke.card + 2 else T.stroke.card
	view.choose.label.Text = Loc.t("ui.tower2.choose")
	view.choose.setEnabled(true)
	local activeLabel = view.active:FindFirstChild("Text")
	if activeLabel and activeLabel:IsA("TextLabel") then activeLabel.Text = "✔ " .. Loc.t("ui.tower2.active") end
	local newLabel = view.newBadge:FindFirstChild("Text")
	if newLabel and newLabel:IsA("TextLabel") then newLabel.Text = Loc.t("ui.tower2.new") end
end

--------------------------------------------------------------------------------
-- Status und Einstiegsleiste
--------------------------------------------------------------------------------

local function refreshStatus(data: Types.PlayerDataUpdate)
	local status = _status
	if not status then return end
	local towers = data.towers
	local selected = if towers then towers.selected else TowerConfig.FIRST_TOWER
	local def = TowerConfig.get(selected) or TowerConfig.TOWERS[1]
	local record = if towers then towers.records[selected] or 0 else 0
	Kit.setChip(status.selected, Loc.t("ui.tower2.status_selected", { tower = towerName(selected) }))
	Kit.setChip(status.record, if def.id == "Endless"
		then Loc.t("ui.tower2.record_endless", { record = record })
		else Loc.t("ui.tower2.record", { record = record, stages = def.stages }))
	-- Naechste Freischaltung
	local nextText = Loc.t("ui.tower2.status_all_open")
	for _, other in TowerConfig.TOWERS do
		if not TowerConfig.isOpen(data.rebirthCount, other.id, if towers then towers.records else nil, if towers then (towers :: any).unlocked else nil) then
			local prev, have, need = TowerConfig.getUnlockProgress(other.id, if towers then towers.records else nil)
			if prev then
				nextText = Loc.t("ui.tower2.status_next", { tower = towerName(other.id), have = have, need = need })
			end
			break
		end
	end
	Kit.setChip(status.nextOpen, nextText)
end

-- Ordnet die Einstiegsleiste je nach Lage: mit/ohne gespeichertem Lauf,
-- mit/ohne Pass. Primaer ist immer der breiteste Knopf.
local function layoutFooter(showSkip: boolean, passOwned: boolean, footerWidth: number)
	local primary, skip, premium = _primary, _skip, _premium
	if not primary or not skip or not premium then return end
	local gap = T.space.s
	local inner = footerWidth - PAD * 2
	if passOwned and showSkip then
		-- Pass: Skip und Pass verschmelzen zu EINEM goldenen Knopf
		skip.button.Visible = false
		premium.button.Visible = true
		local w = math.floor(inner * 0.42)
		primary.button.Size = UDim2.fromOffset(inner - w - gap, 76)
		premium.button.Size = UDim2.fromOffset(w, 64)
		premium.button.Position = UDim2.new(0, PAD + inner - w, 1, -PAD - 64)
	elseif showSkip then
		skip.button.Visible = true
		premium.button.Visible = true
		local wSkip, wPrem = 160, 148
		primary.button.Size = UDim2.fromOffset(inner - wSkip - wPrem - gap * 2, 76)
		skip.button.Size = UDim2.fromOffset(wSkip, 64)
		skip.button.Position = UDim2.new(0, PAD + inner - wSkip - wPrem - gap, 1, -PAD - 64)
		premium.button.Size = UDim2.fromOffset(wPrem, 64)
		premium.button.Position = UDim2.new(0, PAD + inner - wPrem, 1, -PAD - 64)
	else
		skip.button.Visible = false
		premium.button.Visible = true
		local wPrem = 148
		primary.button.Size = UDim2.fromOffset(inner - wPrem - gap, 76)
		premium.button.Size = UDim2.fromOffset(wPrem, 64)
		premium.button.Position = UDim2.new(0, PAD + inner - wPrem, 1, -PAD - 64)
	end
	primary.button.Position = UDim2.new(0, PAD, 1, -PAD - 76)
end

local function refreshFooter(data: Types.PlayerDataUpdate)
	local primary, skip, premium, gummyChip, hint = _primary, _skip, _premium, _gummyChip, _hint
	local window = _window
	if not primary or not skip or not premium or not gummyChip or not hint or not window then return end

	Kit.setChip(gummyChip, Theme.formatNumber(data.gummies))

	local running = _petState == "ToPit" or _petState == "InPit"
	local reached = PitResumeDialog.getProgress(data)
	local showSkip = reached ~= nil and reached > 1 and not running
	local stage, price = 1, 0
	if showSkip then
		stage, price = PitResumeDialog.offer(data, "Last")
	end
	local passOwned = hasPass()
	local passReady = GamepassConfig.isReady(PASS_KEY)

	-- Primaer: Gratis-Start (die tatsaechliche freie Stage: immer 1,
	-- Entscheidung 05.10.)
	primary.label.Text = if running then Loc.t("ui.tower2.running") else Loc.t("ui.tower2.start")
	primary.sub.Text = if running then "" else Loc.t("ui.tower2.start_sub", { stage = 1 })
	primary.sub.Visible = not running
	primary.label.Size = UDim2.new(1, -20, 0, 34)
	primary.label.Position = UDim2.new(0.5, 0, 0, if running then 22 else 8)
	primary.label.AnchorPoint = Vector2.new(0.5, 0)
	primary.setEnabled(not running)
	if _freeBadge then _freeBadge.Visible = not running end

	-- Sekundaer: bezahlter Einstieg ab der letzten Stage
	skip.label.Text = Loc.t("ui.tower2.skip", { stage = stage })
	skip.sub.Text = Loc.t("ui.tower2.price", { price = Kit.formatCompact(price) })
	skip.sub.Visible = true
	skip.setEnabled(price <= data.gummies)

	-- Premium / Pass
	if passOwned and showSkip then
		premium.label.Text = Loc.t("ui.tower2.skip", { stage = stage })
		premium.sub.Text = Loc.t("ui.tower2.pass_free")
		premium.setEnabled(true)
	else
		premium.label.Text = "👑 " .. Loc.t("ui.pass.skip.name")
		premium.sub.Text = if passOwned then Loc.t("ui.tower2.pass_owned")
			elseif passReady then Loc.t("ui.tower2.pass_buy")
			else Loc.t("ui.pass.soon")
		premium.setEnabled(not passOwned)
	end
	premium.sub.Visible = true

	hint.Text = if running then Loc.t("ui.tower2.hint_running") else Loc.t("ui.tower2.hint_free")

	local size = window.root.Size
	layoutFooter(showSkip, passOwned, size.X.Offset)
end

function TowerPanel.refresh()
	if not _isOpen then return end
	local data = ClientState.get()
	if not data then return end
	refreshStatus(data)
	for _, view in _cards do
		refreshCard(view, data)
	end
	refreshFooter(data)
end

--------------------------------------------------------------------------------
-- Bewegung (eine Schleife, solange das Fenster offen ist)
--------------------------------------------------------------------------------

local function startLoop()
	if _stopLoop then return end
	local t0 = os.clock()
	_stopLoop = Kit.animate(function(now)
		local t = now - t0
		-- Glanz ueber neue Karten (sanft, alle ~2,6 s)
		local phase = (t % T.motion.glimmer) / T.motion.glimmer
		for _, view in _cards do
			if view.glimmer.Visible then
				view.glimmer.Position = UDim2.new(-0.3 + phase * 1.6, 0, 0, 0)
				view.glimmer.BackgroundTransparency = 0.55 + 0.45 * math.abs(phase - 0.5) * 2
			end
			if view.newBadge.Visible then
				view.newBadge.Rotation = -10 + math.sin(t * 4) * 4
			end
		end
		return true
	end)
end

local function stopLoop()
	if _stopLoop then _stopLoop() end
	_stopLoop = nil
	if _stopPulse then _stopPulse() end
	_stopPulse = nil
end

-- Karten laufen gestaffelt ein (von rechts, leicht vergroessert)
local function staggerCards()
	for index, id in _order do
		local view = _cards[id]
		local face = view.card.face
		face.Position = UDim2.fromOffset(4 + 40, 0)
		local delay = (index - 1) * T.motion.stagger
		task.delay(delay, function()
			if not _isOpen then
				face.Position = UDim2.fromOffset(4, 0)
				return
			end
			Kit.tween(face, T.motion.cardIn, { Position = UDim2.fromOffset(4, 0) }, Enum.EasingStyle.Back)
		end)
	end
end

local function scrollToSelected()
	local list, data = _list, ClientState.get()
	if not list or not data or not data.towers then return end
	local index = table.find(_order, data.towers.selected) or 1
	local y = math.max(0, (index - 2) * (CARD_H + T.space.s))
	list.CanvasPosition = Vector2.new(0, y)
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local window = _window
	if not window then return end
	local refit = (window :: any).refit
	if refit then refit() end
	window.root.Visible = true
	_isOpen = true
	TowerPanel.refresh()
	scrollToSelected()
	Kit.popIn(window)
	staggerCards()
	startLoop()
	local primary = _primary
	if primary and not _stopPulse then
		_stopPulse = Kit.pulse(primary.face, 0.05)
	end
end

local function closeInternal()
	local window = _window
	if window then window.root.Visible = false end
	_isOpen = false
	stopLoop()
end

function TowerPanel.isOpen(): boolean
	return _isOpen
end

-- Fuer die Fuehrung (GuideController): der Waehlen-Knopf des ersten neuen Towers.
function TowerPanel.getGuideTarget(): GuiObject?
	if not _isOpen then return nil end
	for _, id in _order do
		local view = _cards[id]
		if view.state == "new" then
			return view.choose.button
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Freischalt-Moment
--------------------------------------------------------------------------------

local function onUnlocked(towerId: string)
	local def = TowerConfig.get(towerId)
	if not def then return end
	Kit.playSound("unlock")
	Notify.emit("tower_unlocked", function()
		Toast.success(Loc.t("msg.tower_unlocked", { tower = towerName(towerId) }))
	end, function()
		Moment.show("tower_unlocked", def.color, "ui.moment.tower_unlocked")
	end)
	local view = _cards[towerId]
	local window = _window
	if _isOpen and view and window then
		TowerPanel.refresh()
		local face = view.card.face
		local rel = face.AbsolutePosition - window.body.AbsolutePosition
		-- AbsolutePosition sind Pixel; der Koerper ist mit FitScale und der
		-- globalen UiScale skaliert — fuer das Konfetti grob zurueckrechnen.
		local scale = window.body.AbsoluteSize.X / math.max(1, window.root.Size.X.Offset)
		Kit.confetti(window.content, Vector2.new(rel.X / scale + 60, rel.Y / scale + 40), 26)
	end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function TowerPanel.init(screenGui: ScreenGui)
	if not FeatureFlags.isOn("TOWER_PANEL_V2") then return end

	local window = Kit.window("TowerPanel", screenGui, {
		design = DESIGN, minHeight = MIN_HEIGHT, reserve = reserve,
	})
	_window = window
	Kit.mascot(window, 74)
	local title = Kit.header(window, Loc.t("ui.tower.title"), HEADER_H)
	Loc.bind(title, "ui.tower.title")
	Kit.closeButton(window, function()
		PanelManager.close(PANEL_NAME)
	end)

	local content = window.content

	-- Statuszeile
	local statusRow = Kit.frame("Status", content)
	statusRow.Position = UDim2.fromOffset(PAD, HEADER_H + 10)
	statusRow.Size = UDim2.new(1, -PAD * 2, 0, STATUS_H - 8)
	statusRow.ZIndex = 30
	local statusLayout = Instance.new("UIListLayout")
	statusLayout.FillDirection = Enum.FillDirection.Horizontal
	statusLayout.Padding = UDim.new(0, T.space.s)
	statusLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	statusLayout.SortOrder = Enum.SortOrder.LayoutOrder
	statusLayout.Parent = statusRow
	local selectedChip = Kit.chip("Selected", statusRow, "", T.color.honeyTop)
	selectedChip.LayoutOrder = 1
	local recordChip = Kit.chip("Record", statusRow, "")
	recordChip.LayoutOrder = 2
	local nextChip = Kit.chip("Next", statusRow, "")
	nextChip.LayoutOrder = 3
	_status = { selected = selectedChip, record = recordChip, nextOpen = nextChip }

	-- Kartenliste
	local list = Kit.scroller("List", content)
	_list = list
	local listPad = Instance.new("UIPadding")
	listPad.PaddingTop = UDim.new(0, 14)   -- Platz fuer den NEU-Aufkleber
	listPad.PaddingRight = UDim.new(0, 10)
	listPad.Parent = list
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, T.space.s + 2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	for order, def in TowerConfig.TOWERS do
		_cards[def.id] = buildCard(list, def, order)
		table.insert(_order, def.id)
	end

	-- Einstiegsleiste
	local footer = Kit.frame("Footer", content, T.color.white)
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Position = UDim2.fromScale(0, 1)
	footer.Size = UDim2.new(1, 0, 0, FOOTER_H)
	footer.ZIndex = 31
	Kit.corner(footer, T.radius.panel)
	Kit.gradient(footer, T.color.surfaceDeep, Theme.shade(T.color.surfaceDeep, -0.06))
	_footer = footer
	local footerTop = Kit.frame("FooterTop", footer, T.color.white)
	footerTop.Size = UDim2.new(1, 0, 0, T.radius.panel)
	footerTop.ZIndex = 31
	Kit.gradient(footerTop, T.color.surfaceDeep, T.color.surfaceDeep)
	local footerLine = Kit.frame("FooterLine", footer, T.color.outline)
	footerLine.Size = UDim2.new(1, 0, 0, T.stroke.card)
	footerLine.ZIndex = 32

	-- Zeile 1: Gummy-Stand und ein ehrlicher Satz zum Gratis-Start
	local gummyChip = Kit.chip("Gummies", footer, "0", T.color.white)
	gummyChip.Position = UDim2.fromOffset(PAD, 10)
	-- Icon links in der Pille (die Polsterung macht ihm Platz)
	local gummyPad = gummyChip:FindFirstChildOfClass("UIPadding")
	if gummyPad then gummyPad.PaddingLeft = UDim.new(0, 36) end
	local gummyIcon = Icons.make(gummyChip, "gummy", "G")
	gummyIcon.Size = UDim2.fromOffset(28, 28)
	gummyIcon.AnchorPoint = Vector2.new(0, 0.5)
	gummyIcon.Position = UDim2.new(0, -32, 0.5, 0)
	gummyIcon.ZIndex = 34
	_gummyChip = gummyChip

	local hint = Kit.text("Hint", footer, "", T.text.small, { color = T.color.inkSoft, align = Enum.TextXAlignment.Right })
	hint.AnchorPoint = Vector2.new(1, 0)
	hint.Position = UDim2.new(1, -PAD, 0, 10)
	hint.Size = UDim2.new(0.6, 0, 0, 30)
	hint.ZIndex = 33
	_hint = hint

	-- Zeile 2: die drei Einstiege
	local primary = Kit.button("Start", footer, "primary", Loc.t("ui.tower2.start"), 30)
	primary.sub.Visible = true
	primary.sub.Size = UDim2.new(1, -20, 0, 20)
	primary.button.Activated:Connect(function()
		if not primary.button.Active then return end
		Kit.playSound("click")
		Remotes.RequestPetMode:FireServer("Fight", "Fresh")
		PanelManager.close(PANEL_NAME)
	end)
	_primary = primary
	local freeBadge = Kit.badge("Free", primary.button, Loc.t("ui.tower2.free"), T.color.gummy, 8)
	-- Oben rechts INNERHALB des Knopfs: links steht die Gummy-Pille, rechts
	-- daneben der naechste Knopf, in der Mitte die Beschriftung.
	freeBadge.AnchorPoint = Vector2.new(1, 0.5)
	freeBadge.Position = UDim2.new(1, -10, 0, 2)
	freeBadge.ZIndex = 44
	local freeLabel = freeBadge:FindFirstChild("Text") :: TextLabel
	freeLabel.ZIndex = 45
	_freeBadge = freeBadge

	local skip = Kit.button("Skip", footer, "secondary", "", 20)
	skip.label.Size = UDim2.new(1, -12, 0, 24)
	skip.label.AnchorPoint = Vector2.new(0.5, 0)
	skip.label.Position = UDim2.new(0.5, 0, 0, 6)
	skip.sub.Size = UDim2.new(1, -12, 0, 20)
	skip.button.Activated:Connect(function()
		if not skip.button.Active then return end
		Kit.playSound("click")
		Remotes.RequestPetMode:FireServer("Fight", "Last")
		PanelManager.close(PANEL_NAME)
	end)
	_skip = skip

	local premium = Kit.button("Pass", footer, "premium", "", 20)
	premium.label.Size = UDim2.new(1, -12, 0, 24)
	premium.label.AnchorPoint = Vector2.new(0.5, 0)
	premium.label.Position = UDim2.new(0.5, 0, 0, 6)
	premium.sub.Size = UDim2.new(1, -12, 0, 20)
	premium.button.Activated:Connect(function()
		if not premium.button.Active then return end
		Kit.playSound("click")
		if hasPass() then
			-- Mit Pass ist das der Gratis-Skip (der Server rechnet 0)
			Remotes.RequestPetMode:FireServer("Fight", "Last")
			PanelManager.close(PANEL_NAME)
		elseif GamepassConfig.isReady(PASS_KEY) then
			Remotes.RequestBuyGamepass:FireServer(PASS_KEY)
		else
			-- "Bald": kurzer Wackler statt eines Kaufs
			local face = premium.face
			Kit.tween(face, 0.06, { Rotation = 3 })
			task.delay(0.07, function() Kit.tween(face, 0.12, { Rotation = 0 }, Enum.EasingStyle.Back) end)
		end
	end)
	_premium = premium

	-- Groesse: Liste fuellt den Platz zwischen Status und Leiste; auf
	-- niedrigen Fenstern die kompakte Anordnung.
	window.setSize = function(size: Vector2)
		_compact = size.Y < COMPACT_BELOW
		local headerH = if _compact then HEADER_H_COMPACT else HEADER_H
		local statusH = if _compact then 0 else STATUS_H
		local footerH = if _compact then FOOTER_H_COMPACT else FOOTER_H
		local band = window.header
		if band then band.Size = UDim2.new(1, 0, 0, headerH) end
		statusRow.Visible = not _compact
		footer.Size = UDim2.new(1, 0, 0, footerH)
		gummyChip.Visible = not _compact
		hint.Visible = not _compact
		list.Position = UDim2.fromOffset(PAD, headerH + statusH + 4)
		list.Size = UDim2.new(1, -PAD * 2 + 10, 0, math.max(CARD_H * 0.6, size.Y - headerH - statusH - footerH - 8))
		if _isOpen then TowerPanel.refresh() end
	end

	PanelManager.register(PANEL_NAME, { open = openInternal, close = closeInternal })

	ClientState.onChanged(function() TowerPanel.refresh() end)
	Loc.onChanged(function() TowerPanel.refresh() end)
	Players.LocalPlayer:GetAttributeChangedSignal(GamepassConfig.attributeName(PASS_KEY)):Connect(function()
		TowerPanel.refresh()
	end)
	Remotes.PetModeChanged.OnClientEvent:Connect(function(state: any)
		_petState = if typeof(state) == "string" then state else "Home"
		TowerPanel.refresh()
	end)
	Remotes.TowerUnlocked.OnClientEvent:Connect(function(towerId: any)
		if typeof(towerId) == "string" then onUnlocked(towerId) end
	end)

	print("[TowerPanel] Initialisiert |", #_order, "Tower")
end

return TowerPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX54"><Properties>
<string name="Name">UpgradeFX</string>
<ProtectedString name="Source"><![CDATA[--!strict
-- UpgradeFX.luau
-- StarterPlayerScripts/UI/UpgradeFX.luau
--
-- Einzige Zustaendigkeit:
--   - Der Erfolgs-Moment nach einem BESTAETIGTEN Ausbau (Paket G, 08.10.):
--     das Gebaeude springt kurz auf, Funken in seiner Farbe steigen auf,
--     "Level 7 ➜ 8" schwebt hoch, ein kurzer Klang, und der bezahlte Betrag
--     fliegt aus der Gummy-Pille zum Gebaeude (Feedback.spend). Beim
--     Look-Wechsel (Level 10/20/30/45/60) die grosse Variante.
--
-- Ausgeloest wird NUR aus dem Datenstand (ClientState): steigt das Level des
-- Honig-Brunnens bzw. eines Gebaeudes oder des Recyclers, hat der Server den
-- Kauf schon gebucht. Nie spekulativ beim Tastendruck — ein abgelehnter Kauf
-- (zu wenig Gummies) zeigt nur die Ablehnung (ActionFailed), keinen Effekt.
-- Egal ob ueber den Prompt (E) oder ein Menue ausgebaut wurde: es sieht
-- gleich aus.
--
-- Leistung: EINE Heartbeat-Schleife fuer alle laufenden Effekte, kein Thread
-- und kein Tween pro Effekt; je Effekt ein unsichtbarer Anker-Teil mit EINEM
-- Emitter und EINEM BillboardGui, nach <= 1,2 s wieder weg. Die Gebaeude-Teile
-- werden nur lokal skaliert und danach exakt auf ihren Stand zurueckgesetzt.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local FeedbackConfig   = require(ReplicatedStorage.Config.FeedbackConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local CombConfig       = require(ReplicatedStorage.Config.CombConfig)
local MapConfig        = require(ReplicatedStorage.Config.MapConfig)

local Theme       = require(script.Parent.Theme)
local Kit         = require(script.Parent.Kit)
local Feedback    = require(script.Parent.Feedback)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local UpgradeFX = {}

local FX = FeedbackConfig.UPGRADE_FX
local OWNER_ATTRIBUTE = "PlotOwner"
local RECYCLER_KEY = "Recycler"
local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"

type PartState = { part: BasePart, cframe: CFrame, size: Vector3 }

type Job = {
	key      : string,       -- BuildingId oder "Recycler"
	from     : number,
	to       : number,
	big      : boolean,      -- Look-Wechsel
	t0       : number,       -- Start (os.clock); bis dahin wird auf den Neubau gewartet
	waitLook : number?,      -- Look, auf den gewartet wird (nil = sofort)
	started  : boolean,
	parts    : { PartState },
	origin   : CFrame,
	anchor   : BasePart?,
	label    : TextLabel?,
	gui      : BillboardGui?,
	popDone  : boolean,
}

local _jobs: { Job } = {}
local _last: { [string]: number }? = nil

--------------------------------------------------------------------------------
-- Welt
--------------------------------------------------------------------------------

local function ownPlot(): Instance?
	local userId = Players.LocalPlayer.UserId
	for _, child in Workspace:GetChildren() do
		if child:IsA("Model") and child:GetAttribute(OWNER_ATTRIBUTE) == userId then
			return child
		end
	end
	return nil
end

local function findBody(key: string): BasePart?
	local plot = ownPlot()
	if not plot then return nil end
	local name = if key == RECYCLER_KEY then CombConfig.RECYCLER_NAME else key
	local body = plot:FindFirstChild(name)
	return if body and body:IsA("BasePart") then body else nil
end

local function colorFor(key: string): Color3
	if key == RECYCLER_KEY then
		return Color3.fromRGB(120, 230, 140)
	end
	local def = MapConfig.BUILDING_OFFSETS[key]
	return if def then def.color else Theme.COLORS.goldGummy
end

--------------------------------------------------------------------------------
-- Effekt-Teile
--------------------------------------------------------------------------------

local function easeOut(t: number): number
	return 1 - (1 - t) * (1 - t)
end

-- Skalierung ueber die Zeit: schnell auf `peak`, dann gedaempft zurueck
-- (kurzes Unterschwingen wie eine Feder).
local function popScale(t: number, peak: number): number
	if t <= 0 then return 1 end
	if t >= 1 then return 1 end
	if t < 0.35 then
		return 1 + (peak - 1) * easeOut(t / 0.35)
	end
	local u = (t - 0.35) / 0.65
	return 1 + (peak - 1) * math.cos(u * math.pi * 1.5) * (1 - u)
end

local function startJob(job: Job, body: BasePart)
	job.started = true
	job.t0 = os.clock()

	-- Teile merken (nur die Deko, nicht der unsichtbare Koerper)
	local top = body.Position.Y
	for _, child in body:GetDescendants() do
		if child:IsA("BasePart") then
			table.insert(job.parts, { part = child, cframe = child.CFrame, size = child.Size })
			top = math.max(top, child.Position.Y + child.Size.Y * 0.5)
		end
	end
	job.origin = body.CFrame * CFrame.new(0, -body.Size.Y * 0.5, 0)

	-- Anker oben auf dem Gebaeude: Funken + Zahl
	local anchor = Instance.new("Part")
	anchor.Name         = "UpgradeFxAnchor"
	anchor.Anchored     = true
	anchor.CanCollide   = false
	anchor.CanQuery     = false
	anchor.CanTouch     = false
	anchor.CastShadow   = false
	anchor.Transparency = 1
	anchor.Size         = Vector3.new(1, 1, 1)
	anchor.CFrame       = CFrame.new(body.Position.X, top + 0.5, body.Position.Z)
	anchor.Parent       = Workspace.CurrentCamera or Workspace
	job.anchor = anchor

	local color = colorFor(job.key)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture       = SPARK_TEXTURE
	emitter.Color         = ColorSequence.new(Theme.shade(color, 0.35), color)
	emitter.LightEmission = 1
	emitter.Size          = NumberSequence.new({
		NumberSequenceKeypoint.new(0, if job.big then 1.4 else 1.0),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency  = NumberSequence.new(0.1, 1)
	emitter.Lifetime      = NumberRange.new(FX.SPARK_LIFETIME * 0.6, FX.SPARK_LIFETIME)
	emitter.Speed         = NumberRange.new(8, if job.big then 22 else 15)
	emitter.SpreadAngle   = Vector2.new(55, 55)
	emitter.Acceleration  = Vector3.new(0, 6, 0)
	emitter.Drag          = 3
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Rate          = 0
	emitter.Parent        = anchor
	emitter:Emit(if job.big then FX.SPARKS_BIG else FX.SPARKS)

	local size = if job.big then FX.NUMBER_SIZE_BIG else FX.NUMBER_SIZE
	local gui = Instance.new("BillboardGui")
	gui.Name           = "UpgradeFxNumber"
	gui.Size           = UDim2.fromOffset(size.X, size.Y)
	gui.AlwaysOnTop    = true
	gui.LightInfluence = 0
	gui.StudsOffset    = Vector3.new(0, 1, 0)
	gui.Adornee        = anchor
	gui.Parent         = anchor
	job.gui = gui

	local label = Theme.label("Text", gui, "")
	label.Size = UDim2.fromScale(1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextColor3 = if job.big then Theme.COLORS.goldGummy else Color3.new(1, 1, 1)
	local text = Loc.t("ui.upgrade.fx_level", { from = job.from, to = job.to })
	if job.big then
		text = text .. "\n" .. Loc.t("ui.upgrade.fx_look")
		label.TextWrapped = true
		local limit = label:FindFirstChildOfClass("UITextSizeConstraint")
		if limit then limit.MaxTextSize = 44 end
	end
	label.Text = text
	Theme.outlineText(label, 3)
	job.label = label

	Kit.playSound(if job.big then "lookUp" else "upgrade")

	-- Bezahlter Betrag fliegt aus der Pille zum Gebaeude (Mechanik aus Paket 1)
	local cost = 0
	if job.key == RECYCLER_KEY then
		local def = CombConfig.getUpgradeCost(job.to)
		cost = if def then def.gummies else 0
	else
		local def = BuildingBehavior.getUpgrade(job.key :: any, job.to)
		cost = if def then def.costGummies else 0
	end
	if cost > 0 then
		Feedback.spend("gummies", cost, anchor.Position)
	end
end

local function finishJob(job: Job)
	for _, state in job.parts do
		if state.part.Parent then
			state.part.Size   = state.size
			state.part.CFrame = state.cframe
		end
	end
	table.clear(job.parts)
	if job.anchor then
		job.anchor:Destroy()
		job.anchor = nil
	end
end

local function step()
	if #_jobs == 0 then return end
	local now = os.clock()
	for i = #_jobs, 1, -1 do
		local job = _jobs[i]
		if not job.started then
			-- Look-Wechsel: der Server baut das Gebaeude neu. Erst auf den
			-- neuen Koerper warten, sonst springt der alte, gleich verschwindende.
			local body = findBody(job.key)
			local ready = body ~= nil and (job.waitLook == nil or body:GetAttribute("Look") == job.waitLook)
			local late = now - job.t0 > FX.LOOK_WAIT
			if body and (ready or late) then
				startJob(job, body)
			elseif late then
				table.remove(_jobs, i)
			end
			continue
		end

		local t = now - job.t0

		-- 1. Aufspringen und zurueckfedern
		if not job.popDone then
			local tp = math.clamp(t / FX.POP_SECONDS, 0, 1)
			local s = popScale(tp, if job.big then FX.POP_SCALE_BIG else FX.POP_SCALE)
			for _, state in job.parts do
				if state.part.Parent then
					local rel = job.origin:ToObjectSpace(state.cframe)
					state.part.Size   = state.size * s
					state.part.CFrame = job.origin * CFrame.new(rel.Position * s) * rel.Rotation
				end
			end
			if tp >= 1 then
				job.popDone = true
				for _, state in job.parts do
					if state.part.Parent then
						state.part.Size   = state.size
						state.part.CFrame = state.cframe
					end
				end
			end
		end

		-- 2. Zahl steigt auf und blendet aus
		local tn = math.clamp(t / FX.NUMBER_SECONDS, 0, 1)
		local gui, label = job.gui, job.label
		if gui and label then
			gui.StudsOffset = Vector3.new(0, 1 + FX.NUMBER_RISE * easeOut(tn), 0)
			local fade = math.max(0, (tn - 0.6) / 0.4)
			label.TextTransparency = fade
			local stroke = label:FindFirstChildOfClass("UIStroke")
			if stroke then stroke.Transparency = fade end
			label.TextStrokeTransparency = fade
		end

		if tn >= 1 and job.popDone then
			finishJob(job)
			table.remove(_jobs, i)
		end
	end
end

--------------------------------------------------------------------------------
-- Ausloesen
--------------------------------------------------------------------------------

-- Oeffentlich (auch fuer Tests/Debug): Effekt fuer `key` von Level `from` auf `to`.
function UpgradeFX.play(key: string, from: number, to: number)
	local big = BuildingBehavior.getLook(to) > BuildingBehavior.getLook(from)
	-- Ein laufender Effekt am selben Gebaeude wird beendet (schnelles
	-- Doppelt-Ausbauen ueber das Menue): nie zwei Skalierungen uebereinander.
	for i = #_jobs, 1, -1 do
		if _jobs[i].key == key then
			finishJob(_jobs[i])
			table.remove(_jobs, i)
		end
	end
	table.insert(_jobs, {
		key = key, from = from, to = to, big = big,
		t0 = os.clock(), waitLook = if big then BuildingBehavior.getLook(to) else nil,
		started = false, parts = {}, origin = CFrame.identity, popDone = false,
	})
end

local function levelsOf(data: Types.PlayerDataUpdate): { [string]: number }
	local levels: { [string]: number } = {}
	for id, building in data.island.buildings do
		levels[id :: string] = building.level
	end
	levels[RECYCLER_KEY] = data.island.recycler.level
	return levels
end

local function onData(data: Types.PlayerDataUpdate)
	local now = levelsOf(data)
	local last = _last
	_last = now
	if not last then return end   -- erster Stand nach dem Join
	for key, level in now do
		local before = last[key]
		-- Nur ein echter Ausbau: genau +1 (ein Rebirth senkt, ein
		-- Debug-Sprung um viele Level ist keiner).
		if before and level == before + 1 then
			UpgradeFX.play(key, before, level)
		end
	end
end

function UpgradeFX.init()
	ClientState.onChanged(onData)
	RunService.Heartbeat:Connect(step)
	print("[UpgradeFX] Initialisiert")
end

return UpgradeFX
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
</roblox>