<Item class="ModuleScript" referent="RBX9"><Properties>
<string name="Name">CombatService</string>
<ProtectedString name="Source">--!strict
-- CombatService.luau
-- ServerScriptService/Services/CombatService.luau
--
-- Einzige Zustaendigkeit:
--   - Einen TOWER-LAUF validieren, durchsimulieren und (am Ende der
--     Wiedergabe) abrechnen
--
-- v15: Es gibt kein PIT-Level mehr. Gekaempft wird im gewaehlten Tower
-- (TowerService.getSelected); Gegner und Stage-Gummies kommen aus TowerConfig,
-- Rekord, Meilensteine und Deckel fuehrt TowerService (recordRun). Bis zu 100
-- Stages werden IN PORTIONEN simuliert (SIM_STAGES_PER_STEP pro task.wait),
-- damit ein langer Lauf keinen Frame-Spike auf dem Server macht.
--
-- Ein Lauf ist kein einzelner Kampf: der Baerchi kaempft Stage fuer Stage
-- weiter, solange er gewinnt, und seine HP werden zwischen den Stages NICHT
-- zurueckgesetzt. Kaempfe geben KEINE XP (die kommt nur aus Honig).
--
-- ============================================================
-- SEIT v12: SIMULATION SOFORT, ABRECHNUNG SPAETER
-- ============================================================
-- Der Lauf wird weiterhin KOMPLETT im Voraus simuliert. Der Server kennt das
-- Ergebnis also, bevor die Figur losgeht — der Client kann am Ausgang nichts
-- drehen. Neu ist nur, WANN abgerechnet wird: nicht mehr vor der Wiedergabe,
-- sondern erst, wenn PitArenaService weiss, wie viele Stages tatsaechlich
-- gespielt wurden. Der Spieler kann den Baerchi naemlich zurueckholen
-- (PetBar, Knopf "Fight" nochmal): dann endet der Lauf nach der aktuellen
-- Stage, und es zaehlen nur die bis dahin geschafften.
--
-- Dafuer bekommt PitArenaService eine Abrechnungs-Funktion (settle) mit. Sie
-- laeuft genau einmal — am Ende der Wiedergabe, beim Zurueckholen, bei einem
-- Abbruch oder, wenn der Spieler mitten im Lauf geht, ueber
-- PlayerService.onPlayerLeaving (dann so, als waere die aktuelle Stage zu Ende
-- gespielt).
--
-- ============================================================
-- FORTSETZUNG (v12)
-- ============================================================
-- Vor dem Lauf kann der Spieler weiter oben einsteigen (PitResumeDialog):
--   "Fresh"   Stage 1, kostenlos
--   "Percent" bei 65 % der Stage-Tiefe seines letzten Laufs
--   "Last"    bei der letzten erreichten Stage
-- Kosten und Startstage rechnet TowerConfig (dieselben Funktionen nutzt der
-- Client fuer die Anzeige). Der letzte Lauf steht pro Tower in
-- island.towerProgress (v15).
--
-- Gegner-Werte und Belohnungen kommen aus TowerConfig, die Simulation aus
-- CombatCalculator. rebirthMult wendet ausschliesslich
-- EconomyService.awardGummies an. Der weiche Deckel: ueber den Deckel hinaus
-- wird gekaempft, Stage-Gummies und GoldGummies gibt es aber nur bis dorthin.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local PlayerService   = require(ServerScriptService.Services.PlayerService)
local EconomyService  = require(ServerScriptService.Services.EconomyService)
local PitArenaService = require(ServerScriptService.Services.PitArenaService)
local TowerService    = require(ServerScriptService.Services.TowerService)
local FunnelService = require(ServerScriptService.Services.FunnelService)  -- HBB: Messpunkte
local Loc           = require(ReplicatedStorage.Localization.Loc)

local CombatService = {}

-- So viele Stages werden am Stueck simuliert, dann gibt der Server einen
-- Frame frei (task.wait). Rein technisch, kein Balancing-Wert.
local SIM_STAGES_PER_STEP = 10

-- Spieler, deren Lauf gerade simuliert wird (die Simulation yieldet jetzt —
-- ein zweiter Knopfdruck darf nicht dazwischen einen zweiten Lauf starten).
local _simulating: { [Player]: boolean } = {}

export type ResumeChoice = "Fresh" | "Percent" | "Last"

local function fail(player: Player, reason: Types.LocMsg | string)
	Remotes.ActionFailed:FireClient(player, "RequestPetMode", reason)
end

-- Gegner-Snapshot fuer eine Stage. Die Werte selbst kommen komplett aus
-- TowerConfig — hier wird nur umgepackt.
local function buildEnemySnapshot(towerId: string, stage: number): CombatCalculator.CombatSnapshot
	local stats = TowerConfig.getEnemyStats(towerId, stage)

	return {
		uid    = string.format("enemy_%s_s%d", towerId, stage),
		stats  = stats,
		hp     = stats.maxHp,
		charge = 0,
	}
end

-- Letzte erreichte Stage in diesem Tower (0 = kein Lauf gespeichert).
function CombatService.getProgress(data: Types.PlayerData, towerId: string): number
	local reached = data.island.towerProgress[towerId]
	return if typeof(reached) == "number" and reached &gt;= 1 then reached else 0
end

-- Startstage und Kosten fuer eine Fortsetzungs-Wahl. nil = Wahl ungueltig
-- (kein letzter Lauf in diesem Tower).
function CombatService.getResumeOffer(data: Types.PlayerData, towerId: string, choice: ResumeChoice): (number?, number)
	if choice == "Fresh" then
		return 1, 0
	end

	local reached = CombatService.getProgress(data, towerId)
	if reached &lt;= 0 then
		return nil, 0
	end

	local startStage = if choice == "Last"
		then reached
		else TowerConfig.getResumePercentStage(reached)

	local def = TowerConfig.get(towerId)
	startStage = math.clamp(startStage, 1, if def then def.stages else 1)
	return startStage, TowerConfig.getResumeCost(towerId, startStage, data.rebirthMult)
end

-- Startet einen Tower-Lauf. Gibt true zurueck, wenn er losgeht — sonst hat
-- der Spieler bereits ein ActionFailed mit dem Grund bekommen.
function CombatService.startPitRun(player: Player, baerchiUid: string, choice: ResumeChoice?): boolean
	-- Ein zweiter Lauf darf nie in einen laufenden hineinstarten (die Figur
	-- wuerde sonst mitten in der Wiedergabe weggezogen).
	if PitArenaService.isRunning(player) or _simulating[player] then
		fail(player, Loc.msg("err.combat_busy"))
		return false
	end
	_simulating[player] = true
	local ok, started = pcall(CombatService._startRun, player, baerchiUid, choice)
	_simulating[player] = nil
	if not ok then
		warn("[CombatService] Lauf konnte nicht starten:", started)
		return false
	end
	return started
end

function CombatService._startRun(player: Player, baerchiUid: string, choice: ResumeChoice?): boolean

	local data = PlayerService.getData(player)
	if not data then return false end

	local baerchi = data.island.baerchis[baerchiUid]
	if not baerchi then
		fail(player, Loc.msg("err.baerchi_not_found"))
		return false
	end

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		warn("[CombatService] Unbekannter configId:", baerchi.configId)
		fail(player, Loc.msg("err.baerchi_data_corrupt"))
		return false
	end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)

	-- Der gespeicherte Wert kann ueber maxHp liegen, wenn der Baerchi seit dem
	-- letzten Lauf ein Level gestiegen ist — deshalb immer klemmen.
	local hp = math.clamp(baerchi.currentHp, 0, stats.maxHp)
	if hp &lt;= 0 then
		fail(player, Loc.msg("err.combat_exhausted"))
		return false
	end

	local towerId = TowerService.getSelected(data)
	local tower = TowerConfig.get(towerId)
	if not tower then
		fail(player, Loc.msg("err.tower_unknown"))
		return false
	end
	-- Deckel beim START festhalten: ein Rebirth waehrend des Laufs ist
	-- unmoeglich (der Lauf gehoert zur Insel), sicher ist sicher.
	local capStage = TowerService.getStageCap(data, towerId)

	local startStage, cost = CombatService.getResumeOffer(data, towerId, choice or "Fresh")
	if not startStage then
		fail(player, Loc.msg("err.combat_no_last_run"))
		return false
	end

	if cost &gt; 0 then
		local ok, reason = EconomyService.spendGummies(player, cost)
		if not ok then
			fail(player, reason)
			return false
		end
	end

	local hpBefore = hp

	-- ============================================================
	-- SIMULATION (komplett im Voraus)
	-- ============================================================
	local stages: { Types.PitStageResult } = {}
	-- v15: pro Stage die einzelnen Zuege fuer die Wiedergabe (Stoesse,
	-- Faehigkeiten). Bleibt auf dem Server — PitArenaService spielt sie ab,
	-- der Client sieht nur das Ergebnis in der Welt.
	local beats: { { Types.FightBeat } } = {}
	local lastStage = tower.stages

	-- v15: die Aufladung der Faehigkeit bleibt ueber die Stages erhalten.
	local charge = 0
	local simulatedInStep = 0

	for stage = startStage, lastStage do
		-- In Portionen: nach SIM_STAGES_PER_STEP Stages einen Frame freigeben.
		simulatedInStep += 1
		if simulatedInStep &gt; SIM_STAGES_PER_STEP then
			simulatedInStep = 1
			task.wait()
			if player.Parent == nil then
				-- Gegangen, waehrend simuliert wurde: bezahlte Fortsetzung zurueck.
				if cost &gt; 0 then EconomyService.awardGummiesFlat(player, cost) end
				return false
			end
		end

		local playerSnapshot: CombatCalculator.CombatSnapshot = {
			uid    = baerchi.uid,
			stats  = stats,
			hp     = hp,
			charge = charge,
		}
		local enemySnapshot = buildEnemySnapshot(towerId, stage)
		local enemyMax = math.max(1, enemySnapshot.stats.maxHp)

		local result = CombatCalculator.simulate(playerSnapshot, enemySnapshot, true)
		local won    = result.winnerUid == baerchi.uid

		hp = math.clamp(playerSnapshot.hp, 0, stats.maxHp)
		charge = playerSnapshot.charge or 0

		local stageBeats: { Types.FightBeat } = {}
		for _, entry in result.log do
			-- Finisher/Opener hat gegriffen: nur fuer die Optik der Show
			-- (PitArenaService -&gt; SkillFXPlay.bonus).
			local bonus = false
			for _, effect in entry.effects or {} do
				if effect == "finisher" or effect == "opener" then bonus = true end
			end
			table.insert(stageBeats, {
				actor   = entry.actor,
				kind    = entry.kind,
				selfHp  = math.clamp(entry.attackerHpAfter / math.max(1, stats.maxHp), 0, 1),
				enemyHp = math.clamp(entry.defenderHpAfter / enemyMax, 0, 1),
				charge  = entry.chargeA,
				skillId = entry.skillId,
				bonus   = if bonus then true else nil,
			})
		end
		table.insert(beats, stageBeats)

		table.insert(stages, {
			stage      = stage,
			won        = won,
			rounds     = result.rounds,
			hpAfter    = hp,
			-- Basiswert ohne rebirthMult; ausgezahlt wird erst in settle.
			-- Weicher Deckel: ueber dem Deckel gibt es nichts.
			gummiesWon = if won and stage &lt;= capStage then TowerConfig.getStageReward(towerId, stage) else 0,
			-- v14: fuer die Faehigkeiten-Show (PitArenaService -&gt; SkillFX)
			skillUses       = result.skillUses,
			firstSkillRound = result.firstSkillRound,
		})

		-- Ein Sieg mit 0 HP kann vorkommen (bei Rundenlimit entscheidet der
		-- HP-Vergleich) — dann ist der Lauf trotzdem vorbei.
		if not won or hp &lt;= 0 then
			break
		end
	end

	local fullRun: Types.PitRunResult = {
		baerchiUid     = baerchiUid,
		towerId        = towerId,
		capStage       = capStage,
		startStage     = startStage,
		recalled       = false,
		stagesCleared  = 0,
		stages         = stages,
		gummiesWon     = 0,
		goldGummiesWon = 0,
		hpBefore       = hpBefore,
		hpAfter        = hpBefore,
		maxHp          = stats.maxHp,
	}

	-- ============================================================
	-- ABRECHNUNG (laeuft genau einmal, aufgerufen von PitArenaService)
	-- ============================================================
	-- played = wie viele Stages tatsaechlich gespielt wurden (0..#stages).
	-- recalled = der Spieler hat zurueckgeholt.
	local settled: Types.PitRunResult? = nil

	local function settle(played: number, recalled: boolean): Types.PitRunResult
		if settled then
			return settled
		end

		played = math.clamp(math.floor(played), 0, #stages)

		local playedStages: { Types.PitStageResult } = {}
		local cleared     = 0
		local paidCleared = 0   -- geschaffte Stages bis zum Deckel (GoldGummies)
		local highestWon  = 0
		local baseGummies = 0
		for index = 1, played do
			local stage = stages[index]
			table.insert(playedStages, stage)
			if stage.won then
				cleared += 1
				baseGummies += stage.gummiesWon
				highestWon = math.max(highestWon, stage.stage)
				if stage.stage &lt;= capStage then
					paidCleared += 1
				end
			end
		end

		local hpAfter = if played &gt; 0 then playedStages[played].hpAfter else hpBefore

		-- Den aktuellen Spielstand holen: der Spieler kann waehrenddessen
		-- gegangen sein (dann laeuft das hier aus onPlayerLeaving, die Daten
		-- sind noch da).
		local current = PlayerService.getData(player)
		local result: Types.PitRunResult = {
			baerchiUid     = baerchiUid,
			towerId        = towerId,
			capStage       = capStage,
			startStage     = startStage,
			recalled       = recalled,
			corrected      = played &lt; #stages,
			stagesCleared  = cleared,
			stages         = playedStages,
			gummiesWon     = 0,
			goldGummiesWon = 0,
			hpBefore       = hpBefore,
			hpAfter        = hpAfter,
			maxHp          = stats.maxHp,
		}

		if not current then
			settled = result
			return result
		end

		if played == 0 then
			-- Zurueckgeholt, bevor die erste Stage begann: nichts passiert.
			-- Eine bezahlte Fortsetzung wird erstattet — der Spieler hat
			-- nichts davon gehabt.
			if cost &gt; 0 then
				EconomyService.awardGummiesFlat(player, cost)
			end
		else
			local fighter = current.island.baerchis[baerchiUid]
			if fighter then
				-- Erschoepfungszustand festhalten: DAS ist die Verbindung zum
				-- Fuettern.
				fighter.currentHp = hpAfter
			end

			if baseGummies &gt; 0 then
				result.gummiesWon = EconomyService.awardGummies(player, baseGummies)
			end

			local goldReward = TowerConfig.getRunGold(towerId, paidCleared)
			if goldReward &gt; 0 then
				result.goldGummiesWon = EconomyService.awardGoldGummies(player, goldReward)
			end

			if cleared &gt; 0 then
				current.stats.totalFightsWon += cleared
			end
			if not playedStages[played].won then
				current.stats.totalFightsLost += 1
			end

			-- v15: Rekord, Meilensteine, Deckel-Hinweis (TowerService).
			local newRecord, capReached = TowerService.recordRun(player, current, towerId, highestWon)
			result.newRecord  = newRecord
			result.capReached = capReached

			-- Fuer die Fortsetzungs-Frage: die letzte Stage, in die er
			-- eingetreten ist — pro Tower.
			current.island.towerProgress[towerId] = playedStages[played].stage
		end

		FunnelService.step(player, "F06_FirstFightEnded")
		PlayerService.markDirty(player)
		PlayerService.saveNow(player)

		print(
			"[CombatService]", player.Name,
			"| Tower", towerId, "ab Stage", startStage,
			"| gespielt:", played, "/", #stages,
			if recalled then "(zurueckgeholt)" else "",
			"| geschafft:", cleared,
			"| HP:", hpAfter, "/", stats.maxHp,
			"| Gummies:", result.gummiesWon,
			"| Gold:", result.goldGummiesWon
		)

		settled = result
		return result
	end

	-- Den Client informiert NICHT dieser Service, sondern PitArenaService — am
	-- Ende der Wiedergabe mit dem abgerechneten Ergebnis.
	PitArenaService.play(player, fullRun, settle, beats)
	FunnelService.step(player, "F05_FirstFightStarted")

	-- Kosten sind schon abgezogen: syncen, damit die Anzeige stimmt.
	if cost &gt; 0 then
		PlayerService.markDirty(player)
	end

	print("[CombatService]", player.Name, "| Tower-Lauf startet: Tower", towerId,
		"| ab Stage", startStage, "| Kosten:", cost, "| simuliert:", #stages, "Stages")

	return true
end

function CombatService.init()
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		_simulating[player] = nil
	end)

	-- Seit v12 kein eigener Remote mehr: gestartet wird ueber die Pet-Leiste
	-- (PetModeService.RequestPetMode).
	print("[CombatService] Initialisiert")
end

return CombatService
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX10"><Properties>
<string name="Name">PitArenaService</string>
<ProtectedString name="Source">--!strict
-- PitArenaService.luau
-- ServerScriptService/Services/PitArenaService.luau
--
-- Einzige Zustaendigkeit:
--   - Einen von CombatService fertig simulierten PIT-Lauf in der Arena
--     abspielen und dabei den Lauf ZEITLICH fuehren: Hinweg, Stage fuer Stage,
--     Rueckweg, Zurueckholen und Abbruch
--
-- Zum Fuehren gehoert, dass dieser Service entscheidet, WANN abgerechnet und
-- WANN das Ergebnis verschickt wird — beides haengt an der Wiedergabe:
--   - Abrechnung: CombatService gibt eine Funktion (settle) mit. Sie laeuft
--     GENAU EINMAL mit der Zahl der tatsaechlich gespielten Stages: alle bei
--     normalem Ende, bis einschliesslich der laufenden beim Zurueckholen
--     (requestRecall; vor der ersten Stage: 0), und beim Verlassen so, als
--     waere die begonnene Stage zu Ende gespielt (PlayerService.onPlayerLeaving).
--     WAS abgerechnet wird, weiss nur CombatService; dieser Service fasst
--     Spielerdaten selbst nicht an.
--   - Ergebnis: Remotes.CombatResultReceived geht erst raus, wenn abgerechnet
--     ist. sendResult() ist die einzige Stelle, die es abschickt, und
--     idempotent — alle Abbruch- und Erfolgspfade duerfen es aufrufen.
--   - Phase (ToPit / InPit / Returning) und laufende Stage meldet er fuer
--     die Pet-Leiste (PetModeService liest getPhase).
--
-- Warum auf dem SERVER und nicht im Client: die Arenen liegen in derselben
-- Welt wie alle Plots. Serverseitig kann ein Nachbar ueber den Steg kommen
-- und zuschauen.
--
-- Die Figur wird nicht kopiert, sondern die ECHTE Figur vom Plot wandert in
-- die Arena und danach exakt an ihren Platz zurueck. Eine zweite Kopie waere
-- sonst gleichzeitig auf dem Plot zu sehen.
--
-- ============================================================
-- HEIMKEHR — die eigentliche Schwierigkeit
-- ============================================================
-- Der Ausgangs-Pivot der Figur darf NICHT beim Start jeder Wiedergabe frisch
-- abgelesen werden: startet ein zweiter Lauf waehrend der erste noch laeuft,
-- stuende die Figur da schon in der Arena und wuerde spaeter genau dorthin
-- "zurueckgesetzt". Deshalb merkt sich dieser Service den Platz auf dem Plot
-- getrennt (_home) und raeumt einen laufenden Lauf IMMER erst komplett auf,
-- bevor ein neuer beginnt.
--
-- Abbrechen kann die Wiedergabe ausserdem: der Spieler geht, oder der Plot
-- wird neu gebaut (dann ist die Figur weg). Beides wird geprueft, und in
-- keinem Fall bleibt etwas Halbes stehen.
--
-- ============================================================
-- ZUG UM ZUG
-- ============================================================
-- CombatService gibt pro Stage die einzelnen Zuege mit (Types.FightBeat).
-- Jede Stage wird als Folge von Stoessen gezeigt: die Baerchis laufen
-- aufeinander zu und prallen zusammen (FigureFX.clash). Unter dem eigenen
-- HP-Balken laeuft eine Ladeleiste (Util/FightBars); ist sie voll, kommt die
-- Faehigkeit mit ihrer Show (SkillFX, beim ersten Mal voll, danach als Echo).
-- WELCHE Zuege in die Zeit passen, rechnet FightTimeline.
--
-- startPlayback ist bewusst EINE lange Funktion: sie erzaehlt den Ablauf
-- eines Laufs von vorn nach hinten, und ihre Schritte teilen viel Zustand.
-- Zerlegt in viele kleine Funktionen muesste man zum Verstehen hin und her
-- springen.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)
local MapConfig   = require(ReplicatedStorage.Config.MapConfig)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local SkillConfig = require(ReplicatedStorage.Config.SkillConfig)
local SkillFXConfig = require(ReplicatedStorage.Config.SkillFXConfig)
local BaerchiMesh = require(ReplicatedStorage.Modules.BaerchiMesh)
local FightTimeline = require(ReplicatedStorage.Modules.FightTimeline)
local Types       = require(ReplicatedStorage.Network.Types)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local Remotes     = require(ReplicatedStorage.Network.Remotes)

local PlayerService   = require(ServerScriptService.Services.PlayerService)
local MapService      = require(ServerScriptService.Services.MapService)
local FigureWalker    = require(ServerScriptService.Util.FigureWalker)
local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)
local RateLimiter     = require(ServerScriptService.Util.RateLimiter)   -- Paket 4.3
local FigureFX        = require(ServerScriptService.Util.FigureFX)
local ActivityLock    = require(ServerScriptService.Util.ActivityLock)
local FightBars       = require(ServerScriptService.Util.FightBars)

-- Name unter dem PitArenaService das Bewegungs-Schloss haelt (siehe
-- ActivityLock) — verhindert dass BaerchiAutopilotService den Baerchi
-- waehrend eines Kampf-Laufs zum Honig-Teich abzieht.
local LOCK_HOLDER = "Kampf"

local PitArenaService = {}

-- HBB Paket 5 (MAP_V2_ARENA_SPRINT): auf dem Weg Plot &lt;-&gt; Arena sprintet der
-- Baerchi (MapConfig.ARENA_WALK_SPEED) statt zu gehen — weniger Warten je Lauf.
local function arenaWalkSpeed(): number
	return if FeatureFlags.isOn("MAP_V2_ARENA_SPRINT") then MapConfig.ARENA_WALK_SPEED else MapConfig.WALK_SPEED
end

-- Gleich viele Hopser pro SEKUNDE wie beim Gehen, dafuer weitere: schnelleres
-- Huepfen liest das Auge als Zittern (siehe MapConfig.WALK_BOB_PER_STUD).
local function arenaBobPerStud(): number
	return MapConfig.WALK_BOB_PER_STUD * MapConfig.WALK_SPEED / arenaWalkSpeed()
end

-- Laufende Wiedergabe pro Spieler. Startet ein neuer Lauf, wird der alte
-- Token ungueltig und die alte Schleife beendet sich beim naechsten Schritt.
local _runToken: { [Player]: number } = {}

-- Ergebnis, das der Client noch nicht bekommen hat. Wird gesetzt sobald ein
-- Lauf beginnt und erst gefeuert, wenn der Baerchi sichtbar am Kampf-Spot
-- angekommen ist (siehe sendResult) — vorher liefe die Kampf-UI schon,
-- waehrend er noch zur Arena unterwegs waere. Bleibt die Wiedergabe aus
-- irgendeinem Grund stecken (kein Plot, Fehler waehrend des Laufs), wird an
-- den Abbruchstellen trotzdem gesendet, damit der Client nie ganz ohne
-- Ergebnis dasteht.
--
-- Der Eintrag traegt seinen eigenen Token: `isRunning` verhindert zwar, dass
-- ueberhaupt ein zweiter Lauf waehrend eines laufenden startet, aber ohne den
-- Token wuerde selbst ein knapp daneben abgewiesener Request die
-- Abbruch-Fallbacks eines ANDEREN, spaeter gestarteten Laufs treffen und
-- dessen Ergebnis zu frueh verschicken — genau der Fehler, den sendResult
-- eigentlich beheben soll. sendResult prueft den Token deshalb mit.
-- v12: Abrechnung und Zustand des laufenden Laufs. `entered` = wie viele
-- Stages bereits BEGONNEN haben (fuer die Abrechnung bei Abbruch), `phase`
-- und `stage` fuer die Anzeige, `recall` = Spieler will zurueck.
export type SettleFn = (played: number, recalled: boolean) -&gt; Types.PitRunResult
type Active = {
	token   : number,
	run     : Types.PitRunResult,
	settle  : SettleFn?,
	settled : Types.PitRunResult?,
	sent    : boolean,
	entered : number,
	recall  : boolean,
	beats   : { { Types.FightBeat } }?,   -- v15: Zuege je Stage (Index = Stage im Lauf)
	phase   : string,     -- "ToPit" | "InPit" | "Returning"
	stage   : number?,
}
local _active: { [Player]: Active } = {}

-- Wo die gerade kaempfende Figur auf dem Plot hingehoert. homeFoot ist der
-- Fusspunkt VOR dem Loslaufen (fuer den Weg zurueck), pivot der exakte
-- Ausgangszustand (fuer den abschliessenden Snap in restoreHome).
type Home = { model: Model, pivot: CFrame, homeFoot: Vector3 }
local _home: { [Player]: Home } = {}

-- Sammel-Update 05.10. (Paket 4.3, "schnell den Tower hochfliegen"): Tempo
-- der Wiedergabe je Spieler (1, 2, 4 oder 0 = "Ergebnis sofort"). Die
-- Abrechnung aendert sich NICHT: sie steht ohnehin fest, bevor die Wiedergabe
-- beginnt, und wird am Ende ausgezahlt — schneller abspielen heisst nur
-- schneller ankommen. Gilt ab der naechsten Stage, gemerkt fuer die Sitzung.
local VALID_SPEEDS: { [number]: number } = { [1] = 1, [2] = 2, [4] = 4, [0] = 40 }
local _speed: { [Player]: number } = {}

local function speedFactor(player: Player): number
	return VALID_SPEEDS[_speed[player] or 1] or 1
end

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- Bringt eine noch in der Arena stehende Figur an ihren Platz auf dem Plot
-- zurueck und raeumt ihren Kampf-Balken weg. Idempotent: zweimal aufrufen
-- schadet nicht.
local function restoreHome(player: Player)
	local home = _home[player]
	if not home then return end

	_home[player] = nil

	local model = home.model
	if model.Parent ~= nil then
		FightBars.removeHealthBar(model)
		model:SetAttribute("InArena", nil)

		-- ZUERST abmelden, DANN heimsetzen — nie andersherum. Waehrend des
		-- Kampfs atmet die Figur am Kampf-Spot, ihre gemerkte Ruhelage ist also
		-- die Arena-Position. Ein spaeteres Abmelden wuerde sie genau dorthin
		-- zuruecksetzen und die Heimkehr wieder zunichtemachen.
		FigureFX.stopIdle(model)
		model:PivotTo(home.pivot)

		-- Zuhause angekommen und wieder in Ruhe: `home.pivot` ist garantiert
		-- die saubere Ruhelage, weil startPlayback das Atmen VOR dem Merken
		-- abgeschaltet hat.
		FigureFX.idleBob(model, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
	end
end

-- Alle Gegner-Figuren aus der Arena raeumen.
local function clearFighters(player: Player)
	local fighters = MapService.getFighterFolder(player)
	if not fighters then return end

	for _, child in fighters:GetChildren() do
		child:Destroy()
	end
end

-- Text auf der Anzeigetafel ueber der Arena. Die Tafel selbst gehoert
-- MapService; hier wird nur entschieden WAS draufsteht, weil nur dieser
-- Service den Verlauf des Laufs kennt.
-- v15: "Tower II · Stage 23"
-- Tafel-Texte sind Nachrichten (LocMsg): die Tafel sieht jeder Spieler auf
-- der Plattform, und jeder liest sie in seiner Sprache (MapService/WorldText).
local function stageTitle(towerId: string?, stage: number): Types.LocMsg
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	return Loc.msg("ui.pitboard.stage", { tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), stage = stage })
end

local function showStage(player: Player, towerId: string?, stage: Types.PitStageResult, cleared: number)
	MapService.setPitBanner(
		player,
		stageTitle(towerId, stage.stage),
		-- Sammel-Update 2.4: die Tafel sehen alle Spieler, jeder in seiner
		-- Sprache — deshalb Symbole und Zahlen statt deutscher Woerter.
		if cleared &gt; 0
			then string.format("✔ %d", cleared)
			else "⚔ 1",
		MapConfig.PIT_BANNER_RUNNING
	)
end

local function showSummary(player: Player, run: Types.PitRunResult)
	-- "Geschafft" ist die Zahl gewonnener Stages. Sie kann 0 sein — dann hat
	-- der Baerchi den ersten Gegner nicht ueberlebt, und genau das soll auch
	-- dastehen statt eines beschoenigenden "0 geschafft".
	local won = run.stagesCleared &gt; 0

	MapService.setPitBanner(
		player,
		if won
			then Loc.msg("fmt.append", { a = "✔", b = Loc.msg("ui.pitboard.won", { n = run.stagesCleared }) })
			else Loc.msg("fmt.append", { a = "✖", b = Loc.msg("ui.pitboard.none") }),
		Loc.msg("event.bonus.gummies", { n = run.gummiesWon }),
		if won then MapConfig.PIT_BANNER_WIN else MapConfig.PIT_BANNER_LOSS
	)
end

-- Schickt das Kampfergebnis an den Client — idempotent, weil mehrere
-- Abbruch- und Erfolgspfade das hier alle "auf gut Glueck" aufrufen koennen.
-- Erst danach darf CombatPanel seine Stage-Wiedergabe starten; siehe die
-- Aufrufstelle in startPlayback fuer den genauen Zeitpunkt (Ankunft am
-- Kampf-Spot).
-- `token` muss zu dem Lauf gehoeren, der sendResult aufruft — sonst koennte
-- der Abbruch-Fallback eines ueberholten Laufs A das laengst neu gesetzte
-- _pendingResult eines inzwischen gestarteten Laufs B verschicken, noch
-- bevor dessen eigener Baerchi angekommen ist.
-- v12: rechnet ab (einmal) und gibt das abgerechnete Ergebnis zurueck. Ohne
-- settle-Funktion (Altaufruf) zaehlt der volle Lauf.
local function settleActive(active: Active, played: number, recalled: boolean): Types.PitRunResult
	if active.settled then
		return active.settled
	end

	local settle = active.settle
	local result = active.run
	if settle then
		local ok, res = pcall(settle, played, recalled)
		if ok then
			result = res
		else
			warn("[PitArenaService] Abrechnung fehlgeschlagen:", res)
		end
	end

	active.settled = result
	return result
end

-- Schickt das ABGERECHNETE Ergebnis an den Client — idempotent und nur fuer
-- den Lauf, zu dem der Token gehoert. Wurde noch nicht abgerechnet (Abbruch),
-- wird hier mit den bereits begonnenen Stages abgerechnet.
local function sendResult(player: Player, token: number)
	local active = _active[player]
	if not active or active.token ~= token or active.sent then return end
	active.sent = true

	local result = settleActive(active, active.entered, active.recall)
	if player.Parent ~= nil then
		Remotes.CombatResultReceived:FireClient(player, result)
	end
end

-- Den Erschoepfungs-Zustand nachziehen, der waehrend der Wiedergabe
-- unterdrueckt war.
local function refreshState(player: Player)
	local data = PlayerService.getData(player)
	if data then
		MapService.updateBaerchiStates(player, data.island)
	end
end

--------------------------------------------------------------------------------
-- Wiedergabe
--------------------------------------------------------------------------------

-- Steht die Wiedergabe noch? Prueft alles was sie abbrechen kann:
-- ein neuer Lauf, der Spieler geht, der Plot wird neu gebaut (Figur weg),
-- oder das PIT wird ausgebaut (dann ist der Kaempfer-Ordner mit zerstoert
-- worden und neue Gegner landeten unsichtbar im Nirgendwo).
local function setPhase(player: Player, token: number, phase: string, stage: number?)
	local active = _active[player]
	if active and active.token == token then
		active.phase = phase
		active.stage = stage
	end
end

local function recallWanted(player: Player, token: number): boolean
	local active = _active[player]
	return active ~= nil and active.token == token and active.recall
end

local function stillValid(player: Player, token: number, figure: Model, fighters: Folder): boolean
	if _runToken[player] ~= token then return false end
	if player.Parent == nil then return false end
	if figure.Parent == nil then return false end
	if fighters.Parent == nil then return false end
	return true
end

-- v12: Laesst den Turm Etage fuer Etage von `fromLevel` auf `toLevel` wachsen
-- (oder schrumpfen) und haelt die Figur dabei immer oben auf der aktuellen
-- Etage. Bei sehr hohen Tuermen wachsen mehrere Etagen pro Schritt, damit es
-- nie laenger als `seconds` dauert. Die Figur darf waehrenddessen NICHT im
-- Idle-Loop sein (der Aufrufer meldet sie ab und danach wieder an).
-- Gibt false zurueck, wenn die Wiedergabe unterwegs ungueltig wurde.
local function rideTower(
	player: Player, token: number, figure: Model, fighters: Folder,
	fromLevel: number, toLevel: number, seconds: number,
	selfPos: Vector3, enemyPos: Vector3
): boolean
	local distance = math.abs(toLevel - fromLevel)
	if distance == 0 then return true end

	-- Hoechstens ~20 Schritte pro Sekunde: mehr sieht niemand, und jeder
	-- Schritt baut bzw. entfernt Teile.
	local steps    = math.max(1, math.min(distance, math.floor(seconds * 20)))
	local stepTime = seconds / steps

	for step = 1, steps do
		if not stillValid(player, token, figure, fighters) then return false end

		local level = fromLevel + math.floor((toLevel - fromLevel) * step / steps + 0.5)
		MapService.setPitTowerLevel(player, level)

		local y = MapService.getPitTowerFloorY(level)
		FigurePlacement.placeLookingAt(
			figure,
			Vector3.new(selfPos.X, y, selfPos.Z),
			Vector3.new(enemyPos.X, y, enemyPos.Z)
		)
		task.wait(stepTime)
	end

	return stillValid(player, token, figure, fighters)
end

local function startPlayback(player: Player, run: Types.PitRunResult, settle: SettleFn?, beats: { { Types.FightBeat } }?)
	-- Das Hochzaehlen des Tokens steht ganz oben und vor allem, was fehlschlagen
	-- kann. Ab hier gehoert die Wiedergabe fuer diesen Spieler UNS — und nur
	-- deshalb darf die Fehlerbehandlung in play() bedenkenlos aufraeumen. Stuende
	-- der Token weiter unten und etwas darueber wuerfe, wuerde play() den Zustand
	-- einer noch laufenden aelteren Wiedergabe zerlegen, die anschliessend
	-- munter weiterliefe: Figur zurueck auf dem Plot, aber weiter Gegner in der
	-- Arena und die Tafel wieder an.
	local token = (_runToken[player] or 0) + 1
	_runToken[player] = token

	-- Ab hier ist der Client faellig fuer dieses Ergebnis. Gefeuert wird es
	-- weiter unten erst bei Ankunft am Kampf-Spot — bricht die Wiedergabe
	-- vorher ab (kein Plot, Fehler), sorgen die Abbruchstellen selbst dafuer,
	-- dass es trotzdem noch rausgeht.
	_active[player] = {
		token   = token,
		run     = run,
		settle  = settle,
		settled = nil,
		sent    = false,
		entered = 0,
		recall  = false,
		beats   = beats,
		phase   = "ToPit",
		stage   = nil,
	}

	-- Ein Kampf hat immer Vorrang vor dem automatischen Weg zum Honig-Teich:
	-- forceAcquire nimmt das Bewegungs-Schloss notfalls dem Autopilot weg.
	-- Der bemerkt das selbst (sein isCancelled prueft den Besitzer) und bricht
	-- sein Hinlaufen sauber ab, statt mit dem Kampf um die Figur zu ringen.
	ActivityLock.forceAcquire(player, LOCK_HOLDER)

	-- Einen noch laufenden Lauf komplett aufraeumen. refreshState gehoert
	-- dazu: dessen Wiedergabe hatte den Zustand der Figur unterdrueckt und
	-- kommt wegen des neuen Tokens nicht mehr dazu, ihn nachzuziehen — der
	-- alte Baerchi staende sonst mit veralteter Beschriftung auf dem Plot.
	--
	-- Das passiert bewusst VOR den Abbruchgruenden unten: auch wenn diese
	-- Wiedergabe gar nicht erst startet, muss die alte sauber beendet sein.
	restoreHome(player)
	refreshState(player)
	clearFighters(player)
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)

	-- Es gibt keine Show — Ergebnis trotzdem rausschicken UND das Schloss
	-- wieder freigeben.
	--
	-- Das Freigeben stand hier frueher nicht: forceAcquire oben nimmt das
	-- Schloss immer, die beiden Abbruchgruende unten kamen aber ohne
	-- release() zurueck. Wer also einmal ohne Plot oder ohne gerenderte Figur
	-- in einen Lauf ging, behielt "Kampf" als Schloss-Besitzer fuer den Rest
	-- der Sitzung — der Autopilot ging nie wieder essen, und seit dem
	-- ActivityLock-Schutz wuerden auch Ausruesten, Verwerten und der
	-- Figuren-Neuaufbau dauerhaft abgelehnt. Nur der Fehler-Pfad
	-- (PitArenaService.play) hat freigegeben, der stille Abbruch nicht.
	local function abortPlayback()
		-- Keine Show moeglich: der Lauf zaehlt trotzdem voll (wie vor v12),
		-- er ist ja schon entschieden.
		local active = _active[player]
		if active and active.token == token then
			active.entered = #run.stages
		end
		sendResult(player, token)
		ActivityLock.release(player, LOCK_HOLDER)
		if _active[player] and _active[player].token == token then
			_active[player] = nil
		end
	end

	local center     = MapService.getPitPosition(player)
	local plotCFrame = MapService.getPlotCFrame(player)
	local fighters   = MapService.getFighterFolder(player)
	local figure     = MapService.getBaerchiModel(player, run.baerchiUid)

	-- Fehlt irgendetwas davon (kein Plot, kein Mesh-Template, Figur nicht
	-- gerendert), gibt es einfach keine Show. Der Lauf selbst ist davon
	-- unberuehrt — er ist laengst abgerechnet.
	if not center or not plotCFrame or not fighters or not figure then
		abortPlayback()
		return
	end

	-- typeof statt nur #: kaeme ein Lauf ohne stages-Tabelle herein, waere das
	-- sonst ein Fehler mitten in der Abrechnung statt einer stillen Nicht-Show.
	if typeof(run.stages) ~= "table" or #run.stages == 0 then
		abortPlayback()
		return
	end

	-- Ruhe-Atmen abschalten, BEVOR die Heimatposition gemessen wird: die Figur
	-- schwebt sonst gerade um einen Bruchteil ihres Hubs ueber der Ruhelage,
	-- und genau dieser Versatz wanderte dann in _home.pivot — nach jedem Kampf
	-- staende sie ein Stueckchen hoeher als vorher. stopIdle setzt sie dafuer
	-- selbst auf ihre Ruhelage zurueck.
	FigureFX.stopIdle(figure)

	local homeFoot = FigurePlacement.footOf(figure)   -- Sammel-Update 1.2
	_home[player] = { model = figure, pivot = figure:GetPivot(), homeFoot = homeFoot }

	local maxHp = math.max(1, run.maxHp)

	-- v14: welche Faehigkeit gezeigt wird (SkillFX). Die volle Show laeuft
	-- beim ersten Einsatz eines Laufs, danach nur ein kurzes Echo — sonst
	-- wuerde ein Lauf mit vielen Stages Minuten dauern.
	local fxData = PlayerService.getData(player)
	local fxBaerchi = fxData and fxData.island.baerchis[run.baerchiUid]
	local fxSkillId: string? = fxBaerchi and fxBaerchi.skillId
	local fxShownFull = false

	-- v15: Ladeleiste nur, wenn die Faehigkeit ueberhaupt aufgeladen wird
	-- (Passive und Grundschlag haben charge = 0).
	local fxSkill = fxSkillId and SkillConfig.getById(fxSkillId)
	local showsCharge = fxSkill ~= nil and (fxSkill.charge or 0) &gt; 0

	-- Die beiden Kaempfer stehen sich quer zur Bruecke gegenueber, damit man
	-- sie beim Herueberlaufen von der Seite sieht statt hintereinander.
	local side     = plotCFrame.RightVector
	local selfPos  = center - side * MapConfig.FIGHT_SPACING
	local enemyPos = center + side * MapConfig.FIGHT_SPACING

	-- Die Figur gehoert jetzt uns: MapService laesst ihren Zustand in Ruhe,
	-- bis das Attribut wieder weg ist (sonst saehe sie mitten im Kampf
	-- erschoepft aus, weil die HP serverseitig schon final sind).
	figure:SetAttribute("InArena", true)

	-- Die Figur auf den Zustand VOR dem Lauf zuruecksetzen. Die gespeicherten
	-- HP stehen zu diesem Zeitpunkt schon auf dem Endwert — ohne diese Zeile
	-- stuende der Baerchi bereits blass und mit "erschoepft" beschriftet da,
	-- bevor der erste Gegner ueberhaupt erscheint.
	MapService.setFigureState(figure, run.hpBefore, maxHp)

	task.spawn(function()
		local selfFill: Frame? = nil
		local chargeFill: Frame? = nil

		local ok, err = pcall(function()
			-- Erst hinlaufen: der Kampf soll sichtbar ERST beginnen, wenn der
			-- Baerchi an der Plattform angekommen ist, nicht durch einen
			-- Teleport. FigureWalker haelt den Fusspunkt waehrenddessen exakt
			-- auf Plot-/Bruecken-Hoehe.
			FigureWalker.walk(figure, homeFoot, selfPos, {
				speed       = arenaWalkSpeed(),
				bobPerStud  = arenaBobPerStud(),
				isCancelled = function()
					return not stillValid(player, token, figure, fighters) or recallWanted(player, token)
				end,
			})
			if not stillValid(player, token, figure, fighters) then
				sendResult(player, token)
				return
			end

			-- v12: auf dem Hinweg zurueckgeholt — noch keine Stage begonnen.
			-- Abrechnung mit 0 Stages (erstattet eine bezahlte Fortsetzung),
			-- dann von hier aus heimlaufen.
			if recallWanted(player, token) then
				sendResult(player, token)
				setPhase(player, token, "Returning", nil)
				local here = FigurePlacement.footOf(figure)
				FigureWalker.walk(figure, here, homeFoot, {
					speed       = arenaWalkSpeed(),
					bobPerStud  = arenaBobPerStud(),
					isCancelled = function() return not stillValid(player, token, figure, fighters) end,
				})
				return
			end
			setPhase(player, token, "InPit", nil)

			-- Exakte Ausrichtung zum Gegner: der Lauf endet in Laufrichtung,
			-- gekaempft wird aber gegenueber.
			FigurePlacement.placeLookingAt(figure, selfPos, enemyPos)

			-- Ab hier steht der Baerchi am Kampf-Spot und atmet dort — auch
			-- zwischen den Stages und waehrend der Nachlauf-Pause, in der er
			-- sonst reglos herumstuende. Die Ausfallschritte melden ihn dafuer
			-- selbst kurz ab und danach wieder an (FigureFX.clash).
			FigureFX.idleBob(figure, {
				height = MapConfig.IDLE_BOB_HEIGHT,
				rate   = MapConfig.IDLE_BOB_RATE,
			})

			selfFill = FightBars.attachHealthBar(figure, MapConfig.FIGHT_BAR_SELF_COLOR)
			FightBars.tweenFill(selfFill, run.hpBefore / maxHp, 0.01)
			if showsCharge then
				chargeFill = FightBars.attachChargeBar(figure)
			end

			-- (v12: das Ergebnis geht erst nach der Abrechnung am Ende raus.)

			-- Der Gegner der VORHERIGEN Stage wird erst weggeraeumt wenn der
			-- naechste erscheint. Wuerde er am Ende seiner eigenen Stage
			-- verschwinden, waere die entscheidende letzte Niederlage nie zu
			-- sehen — und in der Nachlauf-Pause staende der eigene Baerchi
			-- allein in der Arena.
			local previousEnemy: Model? = nil

			-- Zaehlt die BEREITS gewonnenen Stages fuer die Anzeigetafel.
			-- Absichtlich nicht run.stagesCleared: das ist das Endergebnis und
			-- waere waehrend der Wiedergabe die halbe Spannung vorweggenommen.
			local cleared = 0

			-- Wo der eigene Baerchi zuletzt stand — auf Bodenhoehe, solange
			-- der Turm noch nicht gewachsen ist, sonst auf der aktuellen
			-- Etage. Der Rueckweg nach der letzten Stage startet von hier,
			-- nicht von der urspruenglichen (Boden-)selfPos.
			local finalSelfPos = selfPos

			-- Aktuelle Turmhoehe (Etagen), fuer den Abstieg am Ende.
			local towerNow = 0

			-- ============================================================
			-- v12: FORTSETZUNG — DER TURM WAECHST ERST BIS ZUR STARTSTAGE
			-- ============================================================
			-- Steigt der Baerchi bei Stage 30 ein, wachsen jetzt alle 29
			-- Etagen darunter sichtbar hoch und er faehrt oben mit. Danach
			-- kaempft er auf genau der Hoehe, auf der Stage 30 bei einem Lauf
			-- von vorn stattfinden wuerde — man sieht, wie weit oben man ist.
			-- v15: gestaucht (TowerConfig.getRunFloor), bei 100 Stages hoechstens
			-- RUN_MAX_FLOORS Etagen.
			local baseLevel = TowerConfig.getRunFloor(run.towerId or "I", run.startStage or 1)
			if baseLevel &gt; 0 and not recallWanted(player, token) then
				MapService.setPitBanner(
					player,
					stageTitle(run.towerId, run.startStage or 1),
					"⬆ …",
					MapConfig.PIT_BANNER_RUNNING
				)

				local riseSeconds = math.min(
					MapConfig.PIT_TOWER_RISE_MAX_SECONDS,
					baseLevel * MapConfig.PIT_TOWER_RISE_SECONDS_PER_LEVEL
				)

				FigureFX.stopIdle(figure)
				if not rideTower(player, token, figure, fighters, 0, baseLevel, riseSeconds, selfPos, enemyPos) then
					return
				end
				FigureFX.idleBob(figure, {
					height = MapConfig.IDLE_BOB_HEIGHT,
					rate   = MapConfig.IDLE_BOB_RATE,
				})

				towerNow     = baseLevel
				finalSelfPos = Vector3.new(selfPos.X, MapService.getPitTowerFloorY(baseLevel), selfPos.Z)
			end

			for index, stage in run.stages do
				if not stillValid(player, token, figure, fighters) then return end

				-- v12: zurueckgeholt — die vorige Stage ist fertig gespielt,
				-- weitere beginnen nicht mehr.
				if recallWanted(player, token) then break end

				local active = _active[player]
				if active and active.token == token then
					active.entered = index
				end
				setPhase(player, token, "InPit", stage.stage)

				-- Etage dieser Stage: die erste Stage kaempft noch auf der
				-- normalen Kampfflaeche (Etage 0) — sichtbar identisch mit dem
				-- Boden, den man von der Bruecke kennt. Jede weitere Stage
				-- bekommt eine neue Turmetage obendrauf (siehe MapConfig,
				-- Abschnitt "PIT-TURM").
				-- v12: absolute Etage — bei einer Fortsetzung steht der Turm
				-- schon (siehe oben), Stage 30 kaempft auf Etage 29.
				local towerLevel = TowerConfig.getRunFloor(run.towerId or "I", stage.stage)
				MapService.setPitTowerLevel(player, towerLevel)
				towerNow = towerLevel

				local floorY        = MapService.getPitTowerFloorY(towerLevel)
				local stageSelfPos  = Vector3.new(selfPos.X, floorY, selfPos.Z)
				local stageEnemyPos = Vector3.new(enemyPos.X, floorY, enemyPos.Z)
				finalSelfPos = stageSelfPos

				-- Ist der Turm inzwischen gewachsen, steht der eigene Baerchi
				-- eine Etage tiefer als er jetzt muesste — er wird VOR dem
				-- naechsten Gegner mit hochgestellt. Ruhe-Atmen dafuer kurz
				-- abmelden und an der neuen Stelle neu anmelden, sonst zoegen
				-- Idle-Loop und diese Bewegung im selben Frame an derselben
				-- Figur (dieselbe Reihenfolge wie in restoreHome).
				if towerLevel &gt; 0 then
					FigureFX.stopIdle(figure)
					FigurePlacement.placeLookingAt(figure, stageSelfPos, stageEnemyPos)
					FigureFX.idleBob(figure, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end

				showStage(player, run.towerId, stage, cleared)

				if previousEnemy and previousEnemy.Parent then
					previousEnemy:Destroy()
				end
				previousEnemy = nil

				local enemy = BaerchiMesh.buildEnemy(stageEnemyPos, MapConfig.FIGHT_ENEMY_COLOR)
				local enemyFill: Frame? = nil

				if enemy then
					FigurePlacement.placeLookingAt(enemy, stageEnemyPos, stageSelfPos)
					enemy.Parent = fighters
					enemyFill = FightBars.attachHealthBar(enemy, MapConfig.FIGHT_BAR_ENEMY_COLOR)
					previousEnemy = enemy

					-- Auch der Gegner soll nicht wie ein Standbild dastehen,
					-- solange er noch lebt.
					FigureFX.idleBob(enemy, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end

				-- ====================================================
				-- v15: DIE STAGE ZUG UM ZUG
				-- ====================================================
				local stageBeats: { Types.FightBeat } = (beats and beats[index]) or {}
				if #stageBeats == 0 then
					-- Ohne Zuege (aelterer Aufrufer): ein einziger Stoss, der
					-- das Ergebnis zeigt — wie vor v15.
					stageBeats = { {
						actor   = if stage.won then "A" else "B",
						kind    = "hit",
						selfHp  = stage.hpAfter / maxHp,
						enemyHp = if stage.won then 0 else 0.35,
						charge  = 0,
						skillId = nil,
					} }
				end

				local plan = FightTimeline.plan(stageBeats, #run.stages, stage.won)
				local fast  = speedFactor(player)   -- Paket 4.3
				local tempo = plan.tempo / fast

				-- Kurz stehen bleiben, damit man den neuen Gegner sieht.
				task.wait(MapConfig.FIGHT_ENEMY_INTRO_SECONDS * tempo)
				if not stillValid(player, token, figure, fighters) then return end

				for _, beatIndex in plan.indices do
					local beat = stageBeats[beatIndex]
					local isSelf = beat.actor == "A"
					local attacker: Model? = if isSelf then figure else enemy
					local target:   Model? = if isSelf then enemy else figure
					local attackerHome = if isSelf then stageSelfPos else stageEnemyPos
					local targetHome   = if isSelf then stageEnemyPos else stageSelfPos
					local isSkill = FightTimeline.isSkillBeat(beat)

					-- Leisten und Treffer-Rueckmeldung genau im Aufprall.
					local function onImpact()
						local barSeconds = MapConfig.FIGHT_BEAT_SECONDS * tempo * 0.5
						FightBars.tweenFill(selfFill, beat.selfHp, barSeconds)
						FightBars.tweenFill(enemyFill, beat.enemyHp, barSeconds)
						FightBars.setCharge(chargeFill, beat.charge, barSeconds)
						if target and target.Parent ~= nil then
							FigureFX.hitFlash(target, MapConfig.FIGHT_HIT_FLASH_COLOR, MapConfig.FIGHT_HIT_FLASH_SECONDS)
						end
						local contact = (stageSelfPos + stageEnemyPos) * 0.5 + Vector3.new(0, 1.5, 0)
						FigureFX.burstAt(contact, MapConfig.FIGHT_HIT_FLASH_COLOR, fighters,
							MapConfig.FIGHT_BUMP_SPARKS * (if isSkill then 3 else 1))
						FigureFX.soundAt(contact, MapConfig.FIGHT_BUMP_SOUND,
							MapConfig.FIGHT_BUMP_VOLUME * (if isSkill then 1.6 else 1), fighters,
							0.9 + math.random() * 0.25)
					end

					if beat.kind == "stunned" then
						-- Betaeubt: kein Stoss, die Figur taumelt.
						if attacker then
							FightBars.setCharge(chargeFill, beat.charge, 0.1)
							FigureFX.stagger(attacker, MapConfig.FIGHT_BEAT_SECONDS * tempo)
						else
							task.wait(MapConfig.FIGHT_BEAT_SECONDS * tempo)
						end
					else
						-- Faehigkeit mit Show (v15.1): die Show IST der Angriff.
						-- Leisten, Treffer-Blitz und Rueckstoss des Gegners
						-- kommen im Einschlag-Moment der Show
						-- (SkillFXConfig.getImpactTime), danach gibt es keinen
						-- zweiten Stoss mehr. Gesamtdauer wie in
						-- tools/sim/fight_timeline.lua:
						-- max(Show-Ende, Einschlag + Zugdauer).
						local showPlayed = false
						if isSkill and isSelf then
							FightBars.setCharge(chargeFill, 1, 0.1)
							local showId = beat.skillId or fxSkillId
							if showId then
								-- Paket 4.3: im Schnelldurchlauf nur das kurze Echo
								local full = not fxShownFull and fast &lt;= 1
								fxShownFull = true
								local scale = if full then 1 else tempo
								Remotes.SkillFXPlay:FireAllClients({
									owner    = player.UserId,
									skillId  = showId,
									full     = full,
									attacker = figure,
									target   = enemy,
									center   = (stageSelfPos + stageEnemyPos) / 2,
									-- Finisher/Opener hat gegriffen (Client: violetter
									-- Schnitt, staerkerer Komet). Nur Optik.
									bonus    = beat.bonus == true,
								})
								local showSeconds   = SkillFXConfig.getDuration(showId, full) * scale
								local impactSeconds = math.min(SkillFXConfig.getImpactTime(showId, full) * scale, showSeconds)
								task.wait(impactSeconds)
								if not stillValid(player, token, figure, fighters) then return end

								local recoilSeconds = FightTimeline.beatSeconds(beat) * tempo
								if enemy and enemy.Parent ~= nil then
									onImpact()
									FigureFX.recoil(enemy, stageEnemyPos, stageSelfPos,
										MapConfig.FIGHT_SKILL_KNOCKBACK, MapConfig.FIGHT_HOP_HEIGHT * 1.6, recoilSeconds)
								else
									onImpact()
									task.wait(recoilSeconds)
								end
								local rest = showSeconds - impactSeconds - recoilSeconds
								if rest &gt; 0 then task.wait(rest) end
								if not stillValid(player, token, figure, fighters) then return end
								showPlayed = true
							end
						end

						local seconds = FightTimeline.beatSeconds(beat) * tempo
						if showPlayed then
							-- Treffer kam schon in der Show (siehe oben).
						elseif attacker then
							FigureFX.clash(attacker, target, attackerHome, targetHome, {
								seconds   = seconds,
								gap       = MapConfig.FIGHT_CONTACT_GAP,
								hop       = MapConfig.FIGHT_HOP_HEIGHT * (if isSkill then 1.6 else 1),
								knockback = if isSkill then MapConfig.FIGHT_SKILL_KNOCKBACK else MapConfig.FIGHT_KNOCKBACK,
								step      = MapConfig.FIGHT_ENEMY_STEP_SHARE,
								onImpact  = onImpact,
							})
						else
							-- Gegner-Mesh fehlt: nur Leisten und Funken.
							onImpact()
							task.wait(seconds)
						end
					end

					if not stillValid(player, token, figure, fighters) then return end
				end

				-- Leisten auf den echten Endstand der Stage (falls Zuege
				-- ausgelassen wurden, stimmt so trotzdem alles).
				FightBars.tweenFill(selfFill, stage.hpAfter / maxHp, 0.15)
				FightBars.tweenFill(enemyFill, if stage.won then 0 else stageBeats[#stageBeats].enemyHp, 0.15)

				if stage.won then
					cleared += 1

					-- Besiegter Gegner kippt um, bevor der naechste kommt.
					-- Beim letzten Gegner macht das die Nachlauf-Pause unten.
					if index &lt; #run.stages and enemy and enemy.Parent ~= nil then
						FigureFX.defeatCollapse(enemy, MapConfig.FIGHT_KO_SECONDS * tempo)
					end
				end
			end

			-- v12: JETZT abrechnen — mit den tatsaechlich gespielten Stages —
			-- und das Ergebnis an den Client schicken.
			local active = _active[player]
			local finalRun = run
			if active and active.token == token then
				finalRun = settleActive(active, active.entered, active.recall)
			end
			sendResult(player, token)

			-- Der letzte Gegner steht waehrend der Nachlauf-Pause noch da;
			-- weggeraeumt wird er unten von clearFighters.
			showSummary(player, finalRun)

			-- Wer die LETZTE Stage verloren hat, kippt sichtbar um, statt
			-- einfach zu verschwinden bzw. unveraendert stehenzubleiben.
			--
			-- Der eigene Baerchi kippt nur, wenn er den Lauf wirklich
			-- erschoepft beendet (hpAfter &lt;= 0). Sonst laeuft er gleich darauf
			-- selbst nach Hause — eine umgekippte Figur, die losmarschiert,
			-- waere schlechter als gar keine Animation. Zurueckgesetzt wird die
			-- Neigung ohnehin von restoreHome.
			local lastStage = finalRun.stages[#finalRun.stages]
			local loser: Model? = nil

			if lastStage and lastStage.won then
				loser = previousEnemy
			elseif finalRun.hpAfter &lt;= 0 then
				loser = figure
			end

			-- Das Umkippen laeuft INNERHALB der Nachlauf-Pause ab, verlaengert
			-- die Wiedergabe also nicht.
			local collapseSeconds = math.min(
				MapConfig.FIGHT_COLLAPSE_SECONDS,
				MapConfig.FIGHT_LINGER_SECONDS
			)

			if loser and loser.Parent ~= nil then
				FigureFX.defeatCollapse(loser, collapseSeconds)
				task.wait(math.max(0, MapConfig.FIGHT_LINGER_SECONDS - collapseSeconds))
			else
				task.wait(MapConfig.FIGHT_LINGER_SECONDS)
			end

			if not stillValid(player, token, figure, fighters) then return end

			-- Ueberlebt (hpAfter &gt; 0): der Baerchi laeuft selbststaendig zu
			-- seinem Platz zurueck. Erschoepft (hpAfter &lt;= 0): er ist ausser
			-- Gefecht und steht einfach wieder normal auf dem Plot — die
			-- anschliessende restoreHome() setzt ihn dafuer direkt zurueck,
			-- ganz ohne Lauf-Animation.
			if finalRun.hpAfter &gt; 0 then
				setPhase(player, token, "Returning", nil)

				-- Vor dem eigenen PivotTo abmelden: sonst zoegen Idle-Loop und
				-- Lauf-Animation im selben Frame an derselben Figur. Wieder
				-- angemeldet wird sie am Ende von restoreHome, auf ihrem Platz.
				FigureFX.stopIdle(figure)

				-- v12: erst mit dem Turm wieder nach unten fahren — sonst liefe
				-- er auf Turmhoehe durch die Luft nach Hause.
				if towerNow &gt; 0 then
					clearFighters(player)
					if not rideTower(player, token, figure, fighters, towerNow, 0, MapConfig.PIT_TOWER_FALL_SECONDS, selfPos, enemyPos) then
						return
					end
					finalSelfPos = selfPos
				end

				FigureWalker.walk(figure, finalSelfPos, homeFoot, {
					speed       = arenaWalkSpeed(),
					bobPerStud  = arenaBobPerStud(),
					isCancelled = function() return not stillValid(player, token, figure, fighters) end,
				})
			end
		end)

		if not ok then
			warn("[PitArenaService] Wiedergabe fehlgeschlagen:", err)
		end

		-- Fallback: ist die Schleife oben aus irgendeinem Grund abgebrochen
		-- oder auf einen Fehler gelaufen, BEVOR der Baerchi angekommen ist,
		-- haette der Client sonst nie ein Ergebnis bekommen. sendResult ist
		-- idempotent — war es schon raus, passiert hier nichts mehr.
		sendResult(player, token)

		-- Nur aufraeumen wenn diese Wiedergabe noch die aktuelle ist —
		-- sonst wuerde man einem bereits gestarteten neuen Lauf die Figur
		-- unter den Fuessen wegziehen.
		if _runToken[player] == token then
			restoreHome(player)
			clearFighters(player)
			MapService.setPitTowerLevel(player, 0)
			MapService.clearPitBanner(player)
			refreshState(player)
			ActivityLock.release(player, LOCK_HOLDER)
			if _active[player] and _active[player].token == token then
				_active[player] = nil
			end
		end
	end)
end

-- Laeuft fuer diesen Spieler gerade eine Wiedergabe (Hinlauf, Stages,
-- Nachlauf oder Ruecklauf)? CombatService fragt das VOR einem neuen
-- RequestStartCombat ab: der Cooldown auf diesem Remote (1s,
-- NetworkConfig) ist kuerzer als eine volle Wiedergabe — ohne diese Sperre
-- koennte ein zweiter Lauf mitten in den ersten hineinstarten und ihm die
-- Figur unter den Fuessen wegziehen.
--
-- _home ist dafuer das richtige Signal: es wird exakt fuer die Dauer einer
-- Wiedergabe gesetzt (startPlayback) und von restoreHome() wieder geleert,
-- egal ob sie normal zu Ende lief oder abgebrochen wurde.
-- HBB Paket 6: alle laufenden Laeufe fuer das Live-Kampf-Board (nur lesen).
function PitArenaService.liveRuns(): { { name: string, towerId: string?, stage: number?, phase: string } }
	local list = {}
	for player, active in _active do
		table.insert(list, {
			name    = player.DisplayName,
			towerId = active.run.towerId,
			stage   = active.stage,
			phase   = active.phase,
		})
	end
	return list
end

function PitArenaService.isRunning(player: Player): boolean
	return _home[player] ~= nil
end

-- Spielt einen fertig ausgerechneten Lauf ab. Kehrt sofort zurueck — die
-- eigentliche Wiedergabe laeuft nebenher.
--
-- Wirft NIE. Der Aufrufer (CombatService) steht mitten in der Abrechnung
-- eines Laufs: ein Fehler in dieser reinen Darstellung darf ihn nicht daran
-- hindern, die Daten zu speichern und den Client zu synchronisieren. Und er
-- darf vor allem keine Figur mit gesetztem "InArena" zuruecklassen — die
-- waere fuer den Rest der Sitzung von jeder Zustands-Aktualisierung
-- ausgenommen.
-- v15: `beats` = die Zuege je Stage (Index wie run.stages). Fehlen sie, wird
-- jede Stage als ein einziger Stoss gezeigt.
function PitArenaService.play(player: Player, run: Types.PitRunResult, settle: SettleFn?, beats: { { Types.FightBeat } }?)
	local ok, err = pcall(startPlayback, player, run, settle, beats)
	if ok then return end

	warn("[PitArenaService] Wiedergabe konnte nicht starten:", err)

	-- Aufraeumen was der abgebrochene Start schon angefasst haben koennte.
	-- Das ist nur deshalb gefahrlos, weil startPlayback den Token als ALLERSTES
	-- hochzaehlt: es gibt an dieser Stelle keine fremde Wiedergabe mehr, der
	-- man etwas wegraeumen koennte.
	--
	-- sendResult zuerst: schlug startPlayback ab, noch bevor es das Ergebnis
	-- verschicken konnte, bekaeme der Client sonst nie eins. _runToken[player]
	-- ist an dieser Stelle bereits der Token DIESES Versuchs — startPlayback
	-- setzt ihn als allerersten Schritt, bevor irgendetwas werfen kann.
	sendResult(player, _runToken[player] or 0)
	restoreHome(player)
	clearFighters(player)
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)
	refreshState(player)
	ActivityLock.release(player, LOCK_HOLDER)
	_active[player] = nil
end

-- v12: Spieler holt den Baerchi zurueck (Pet-Leiste). Auf dem Hinweg kehrt
-- er sofort um; im Kampf endet der Lauf nach der laufenden Stage. Auf dem
-- Rueckweg ist nichts mehr zu tun. true = Anfrage angenommen.
function PitArenaService.requestRecall(player: Player): boolean
	local active = _active[player]
	if not active or active.phase == "Returning" then
		return false
	end
	active.recall = true
	return true
end

-- v12: Phase des laufenden Laufs fuer die Pet-Leiste: "ToPit", "InPit",
-- "Returning" oder nil (kein Lauf). Dazu die laufende Stage (nur im Kampf).
function PitArenaService.getPhase(player: Player): (string?, number?)
	local active = _active[player]
	if not active or _home[player] == nil then
		return nil, nil
	end
	return active.phase, active.stage
end

-- v12: Ist dieser Baerchi gerade in einem noch nicht abgerechneten Lauf?
-- HoneyService lehnt Fuettern dann ab — die Abrechnung setzt die HP am Ende
-- auf den Wert nach der letzten Stage und wuerde eine Heilung dazwischen
-- ueberschreiben.
function PitArenaService.isFighting(player: Player, baerchiUid: string): boolean
	local active = _active[player]
	return active ~= nil and active.settled == nil and active.run.baerchiUid == baerchiUid
end

function PitArenaService.init()
	-- Verlaesst ein Spieler den Server mitten in der Wiedergabe, macht der
	-- Token-Vergleich die laufende Schleife ungueltig. Sein Plot wird ohnehin
	-- despawnt, aufraeumen muss hier nichts mehr.
	Players.PlayerRemoving:Connect(function(player)
		_runToken[player] = nil
		_home[player]     = nil
		_active[player]   = nil
		_speed[player]    = nil
	end)

	-- Paket 4.3: Tempo-Knopf der Pet-Leiste (PetBar).
	RateLimiter.connect(Remotes.RequestPitSpeed, "RequestPitSpeed", function(player, speed: any)
		if typeof(speed) ~= "number" or VALID_SPEEDS[speed] == nil then return end
		_speed[player] = speed
	end)

	-- v12: geht der Spieler mitten im Lauf, wird VOR dem Speichern
	-- abgerechnet — so, als waere die gerade begonnene Stage zu Ende gespielt.
	PlayerService.onPlayerLeaving(function(player)
		local active = _active[player]
		if active then
			settleActive(active, active.entered, active.recall)
		end
	end)

	print("[PitArenaService] Initialisiert")
end

return PitArenaService
</ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX11"><Properties>
<string name="Name">Util</string>
</Properties>
<Item class="ModuleScript" referent="RBX12"><Properties>
<string name="Name">FigureFX</string>
<ProtectedString name="Source">--!strict
-- FigureFX.luau
-- ServerScriptService/Util/FigureFX.luau
--
-- Einzige Zustaendigkeit:
--   - Kleine, rein kosmetische Bewegungen an einem Model abspielen:
--     Ausfallschritt, Treffer-Blitz, Umkippen, Vorbeugen, Ruhe-Atmen,
--     seit v15 Zusammenprall (clash), Taumeln und Aufprall-Ton.
--
-- Dieses Modul kennt WEDER Spielerdaten NOCH Remotes NOCH Gebaeude oder
-- Kaempfe — nur Model, CFrame und Zahlen. Es entscheidet WIE eine Bewegung
-- aussieht; WANN sie passiert, entscheidet der aufrufende Service
-- (PitArenaService, BaerchiAutopilotService, MapService). Genau diese Trennung
-- ist der Grund, warum es eine eigene Datei ist und nicht in PitArenaService
-- steht.
--
-- ============================================================
-- KEIN RIG, KEIN ANIMATOR
-- ============================================================
-- Die importierten Baerchi-Meshes haben keine Motor6D-Gelenke (siehe
-- BaerchiMesh.luau / FigureWalker.luau) — eine klassische Skelett-Animation
-- kann daran nicht ansetzen. Alles hier bewegt deshalb das GANZE Model per
-- PivotTo, genau wie FigureWalker. Der Fusspunkt bleibt dabei ueberall auf dem
-- Boden: entweder ueber FigurePlacement (Ausfallschritt) oder ueber eine
-- Drehung um eine Achse, die DURCH den Fusspunkt geht (Vorbeugen, Umkippen).
-- Ein Motor6D oder AnimationController wird hier bewusst NICHT eingefuehrt.
--
-- ============================================================
-- WER WELCHE ZAHL BESTIMMT
-- ============================================================
-- Dauer, Distanz und Farbe kommen als Argument herein — die stehen in
-- MapConfig, weil sie Balance/Optik des Spiels sind. Was hier unten als
-- Konstante steht, ist die FORM der Bewegung (wie hoch der Hopser im
-- Verhaeltnis zur Ausfall-Distanz ist, wie lange die Figur beim Fressen unten
-- bleibt). Die gehoert zur Bewegung selbst, nicht zum Spiel — genauso wie
-- FigureWalker seine Huepf-Vorgaben selbst mitbringt.

local RunService          = game:GetService("RunService")
local TweenService        = game:GetService("TweenService")
local Debris              = game:GetService("Debris")
local ServerScriptService = game:GetService("ServerScriptService")

local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)

local FigureFX = {}

--------------------------------------------------------------------------------
-- Form-Konstanten (siehe Kopf: das WIE, nicht das WIEVIEL)
--------------------------------------------------------------------------------

-- Huepf-Hoehe des Ausfallschritts als Anteil seiner Distanz. Ein Ausfall ohne
-- jede Hoehe sieht aus wie Schlittern.
local LUNGE_HOP_SHARE = 0.35

-- Wie weit eine besiegte Figur nach HINTEN wegkippt, und wie weit sie dabei
-- absackt (als Anteil ihrer eigenen Hoehe, damit es bei jedem Mesh passt).
local COLLAPSE_DEGREES    = 74
local COLLAPSE_SINK_SHARE = 0.18

-- Anteil der Fress-Dauer, den die Figur unten bleibt. Der Rest teilt sich auf
-- Runterbeugen und Wiederaufrichten auf.
local LEAN_HOLD_SHARE = 0.40

-- Deckkraft des Treffer-Blitzes. Voll deckend waere ein Farbklecks statt eines
-- Aufleuchtens.
local FLASH_FILL_TRANSPARENCY = 0.45

-- Ruhe-Atmen: Vorgaben, falls der Aufrufer keine mitgibt.
local IDLE_DEFAULT_HEIGHT = 0.16   -- Studs
local IDLE_DEFAULT_RATE   = 1.5    -- Schwingungen pro Sekunde

-- Feier-Momente (celebrate/burstAt) — siehe Abschnitt weiter unten.
-- Die Zahlen hier sind FORM (wie ein Partikel-Stoss aussieht), nicht Balance
-- — deshalb hier und nicht in MapConfig, genau wie beim Rest dieser Datei.
local CELEBRATE_PARTICLE_COUNT   = 24
local CELEBRATE_HOP_HEIGHT_SHARE = 0.45   -- Anteil der Modellhoehe
local CELEBRATE_FLASH_SECONDS    = 0.35
local CELEBRATE_DEFAULT_SECONDS  = 0.6

-- Kuerzeste sinnvolle Dauer — schuetzt vor Division durch Null bei 0.
local MIN_SECONDS = 0.05

local EPSILON = 1e-3

--------------------------------------------------------------------------------
-- Interne Hilfen
--------------------------------------------------------------------------------

-- Fusspunkt eines Models: Mitte der Unterkante seiner Bounding-Box. Dieselbe
-- Groesse, mit der FigurePlacement und FigureWalker rechnen.
local function footOf(model: Model): Vector3
	return FigurePlacement.footOf(model)   -- Sammel-Update 1.2
end

local function heightOf(model: Model): number
	local _, size = model:GetBoundingBox()
	return size.Y
end

-- Laeuft `seconds` lang und ruft `step(t)` jeden Frame mit t von 0 bis 1.
-- Bricht ab, sobald das Model aus der Welt verschwindet (Plot neu gebaut,
-- Gegner weggeraeumt, Spieler weg) — dieselbe defensive Pruefung, die auch
-- FigureWalker und PitArenaService machen.
--
-- Gibt zurueck, ob die Bewegung ganz durchgelaufen ist.
local function animate(model: Model, seconds: number, step: (t: number) -&gt; ()): boolean
	local duration = math.max(seconds, MIN_SECONDS)
	local elapsed  = 0

	while elapsed &lt; duration do
		local dt = RunService.Heartbeat:Wait()
		elapsed += dt

		if model.Parent == nil then
			return false
		end

		step(math.clamp(elapsed / duration, 0, 1))
	end

	return true
end

-- Die waagerechte Achse, um die eine Figur nach vorne oder hinten kippt:
-- quer zu ihrer Blickrichtung.
local function tiltAxis(pivot: CFrame): Vector3
	local right = Vector3.new(pivot.RightVector.X, 0, pivot.RightVector.Z)
	if right.Magnitude &lt; EPSILON then
		return Vector3.xAxis
	end
	return right.Unit
end

-- Kippt `basePivot` um `radians` um eine Achse, die DURCH `foot` geht — die
-- Fuesse bleiben also stehen, nur der Koerper neigt sich. Zusaetzlich sackt
-- die Figur um `sink` Studs ab.
--
-- Vorzeichen: positive Radiant kippen nach HINTEN (Rechte-Hand-Regel um den
-- RightVector schwenkt den UpVector Richtung +Z, und Blickrichtung ist -Z).
-- Wer nach vorne will, uebergibt einen negativen Wert.
local function tilted(basePivot: CFrame, foot: Vector3, radians: number, sink: number): CFrame
	local hinge = CFrame.new(foot)
	local turn  = CFrame.fromAxisAngle(tiltAxis(basePivot), radians)

	return (hinge * turn * hinge:Inverse() * basePivot) + Vector3.new(0, -sink, 0)
end

--------------------------------------------------------------------------------
-- Ruhe-Atmen: EIN Loop fuer ALLE Figuren
--------------------------------------------------------------------------------
--
-- Pro Figur eine eigene RunService-Verbindung waere bei 8 Spielern plus deren
-- Arena-Gegnern ein gutes Dutzend paralleler Schleifen fuer eine Bewegung, die
-- sich in einem einzigen Callback genauso rechnen laesst. Deshalb: eine
-- Registry, ein Heartbeat.
--
-- Die Verbindung entsteht erst mit der ersten Figur und loest sich wieder,
-- sobald keine mehr registriert ist — ein leerer Server laesst also gar nichts
-- mitlaufen.

export type IdleOptions = {
	height : number?,   -- Studs Hub, Standard IDLE_DEFAULT_HEIGHT
	rate   : number?,   -- Schwingungen pro Sekunde, Standard IDLE_DEFAULT_RATE
}

type IdleEntry = {
	basePivot : CFrame,        -- Ruhelage, auf die jederzeit zurueckgesetzt wird
	options   : IdleOptions,   -- gemerkt, um nach einer Bewegung gleich weiterzumachen
	height    : number,
	rate      : number,
	phase     : number,        -- damit nicht alle Figuren im Gleichschritt wippen
}

local _idle: { [Model]: IdleEntry } = {}
local _idleConnection: RBXScriptConnection? = nil
local _idleClock = 0

local function stepIdle(dt: number)
	_idleClock += dt

	for model, entry in _idle do
		if model.Parent == nil then
			-- Figur ist aus der Welt verschwunden (Plot neu gebaut, Gegner
			-- weggeraeumt). Kein Aufrufer muss daran denken, sich abzumelden.
			_idle[model] = nil
			continue
		end

		-- (1 - cos) laeuft von 0 sanft nach oben und zurueck auf 0 — die Figur
		-- geht also nie UNTER ihre Ruhelage und damit nie in den Boden.
		local swing = (1 - math.cos(_idleClock * entry.rate * math.pi * 2 + entry.phase)) * 0.5
		model:PivotTo(entry.basePivot + Vector3.new(0, swing * entry.height, 0))
	end

	if next(_idle) == nil and _idleConnection then
		_idleConnection:Disconnect()
		_idleConnection = nil
	end
end

local function ensureIdleLoop()
	if _idleConnection then return end
	_idleConnection = RunService.Heartbeat:Connect(stepIdle)
end

-- Meldet eine STEHENDE Figur zum Ruhe-Atmen an und gibt die Stopp-Funktion
-- zurueck. Wer die Figur selbst bewegen will, muss vorher abmelden — sonst
-- ueberschreiben sich Idle-Loop und Bewegung gegenseitig.
--
-- Nochmal fuer dieselbe Figur aufgerufen: die alte Anmeldung wird sauber
-- beendet (Ruhelage wiederhergestellt) und die aktuelle Lage als neue Ruhelage
-- genommen. Ohne das wuerde sich der Hub bei jedem Neuanmelden aufaddieren.
function FigureFX.idleBob(model: Model, options: IdleOptions?): () -&gt; ()
	FigureFX.stopIdle(model)

	local opts: IdleOptions = options or {}

	_idle[model] = {
		basePivot = model:GetPivot(),
		options   = opts,
		height    = opts.height or IDLE_DEFAULT_HEIGHT,
		rate      = opts.rate or IDLE_DEFAULT_RATE,
		phase     = math.random() * math.pi * 2,
	}

	ensureIdleLoop()

	return function()
		FigureFX.stopIdle(model)
	end
end

-- Meldet eine Figur ab und stellt ihre Ruhelage wieder her. Ohne das
-- Zuruecksetzen bliebe sie um den halben Hub in der Luft stehen — und genau
-- dieser Versatz wuerde in PitArenaService._home als "Heimatposition"
-- gespeichert.
--
-- Fuer eine nicht angemeldete Figur passiert nichts.
function FigureFX.stopIdle(model: Model)
	local entry = _idle[model]
	if not entry then return end

	_idle[model] = nil

	if model.Parent ~= nil then
		model:PivotTo(entry.basePivot)
	end
end

-- Nimmt einer Figur das Ruhe-Atmen fuer die Dauer einer eigenen Bewegung weg.
-- Gibt eine Funktion zurueck, die es an der DANN aktuellen Stelle wieder
-- aufnimmt — oder nil, wenn die Figur gar nicht geatmet hat.
local function takeOver(model: Model): (() -&gt; ())?
	local entry = _idle[model]
	if not entry then return nil end

	FigureFX.stopIdle(model)

	return function()
		if model.Parent ~= nil then
			FigureFX.idleBob(model, entry.options)
		end
	end
end

--------------------------------------------------------------------------------
-- Kampf- und Fress-Bausteine
--------------------------------------------------------------------------------

-- Kurzer Ausfallschritt in Richtung `towardPosition` und zurueck: die Figur
-- setzt nach vorne, hebt dabei leicht ab und landet wieder exakt auf ihrem
-- Ausgangs-Fusspunkt. Die Ausrichtung bleibt unveraendert — sie schaut den
-- Gegner ja schon an.
--
-- Blockiert bis die Bewegung durch ist (wie FigureWalker.walk), damit der
-- Aufrufer die Reihenfolge im Kampf bestimmen kann.
function FigureFX.attackLunge(model: Model, towardPosition: Vector3, distance: number, duration: number)
	local resume = takeOver(model)

	local facing = model:GetPivot().Rotation
	local foot   = footOf(model)

	local flat  = Vector3.new(towardPosition.X, foot.Y, towardPosition.Z)
	local delta = flat - foot

	-- Steht der Gegner praktisch auf demselben Punkt, gibt es keine Richtung —
	-- dann bleibt der Ausfall aus, statt in eine zufaellige Richtung zu gehen.
	if delta.Magnitude &gt; EPSILON then
		local direction = delta.Unit
		local hop       = distance * LUNGE_HOP_SHARE

		animate(model, duration, function(t)
			-- sin(pi*t): 0 → 1 → 0, also hin und wieder zurueck in einem Zug.
			local swing = math.sin(t * math.pi)
			FigurePlacement.place(
				model,
				foot + direction * (distance * swing) + Vector3.new(0, hop * swing, 0),
				facing
			)
		end)

		-- Immer sauber auf dem Ausgangspunkt enden, auch nach einem Abbruch.
		if model.Parent ~= nil then
			FigurePlacement.place(model, foot, facing)
		end
	end

	if resume then resume() end
end

-- Kurzes Aufleuchten als Treffer-Rueckmeldung. Kehrt sofort zurueck; das
-- Ausblenden laeuft nebenher.
--
-- Bewusst ein Highlight statt eines Farbpulses auf allen BaseParts: die
-- eigenen Farben und Transparenzen der Figur sind bereits belegt (Rarity-
-- Einfaerbung in BaerchiMesh, Erschoepfungs-Transparenz in MapService, die
-- Ausgangswerte liegen als Attribute an den Parts). Ein Highlight legt sich
-- darueber, ohne einen dieser Werte anzufassen — es kann also auch nichts
-- falsch wiederherstellen, wenn zwei Treffer kurz hintereinander kommen.
--
-- Occluded statt AlwaysOnTop: sonst leuchtete der Treffer quer ueber die
-- Plattform durch die Landschaft hindurch.
function FigureFX.hitFlash(model: Model, color: Color3, duration: number)
	local seconds = math.max(duration, MIN_SECONDS)

	local previous = model:FindFirstChild("HitFlash")
	if previous then
		previous:Destroy()
	end

	local highlight = Instance.new("Highlight")
	highlight.Name                = "HitFlash"
	highlight.FillColor           = color
	highlight.FillTransparency    = FLASH_FILL_TRANSPARENCY
	highlight.OutlineTransparency = 1
	highlight.DepthMode           = Enum.HighlightDepthMode.Occluded
	highlight.Adornee             = model
	highlight.Parent              = model

	TweenService:Create(
		highlight,
		TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ FillTransparency = 1 }
	):Play()

	task.delay(seconds, function()
		if highlight.Parent ~= nil then
			highlight:Destroy()
		end
	end)
end

-- Die Figur kippt nach hinten weg und sackt dabei etwas ab, statt einfach zu
-- verschwinden. Gedacht fuer den Moment VOR dem Aufraeumen — das Entfernen
-- selbst bleibt Sache des Aufrufers.
--
-- Meldet die Figur vom Ruhe-Atmen ab und nimmt es bewusst NICHT wieder auf:
-- eine umgekippte Figur soll liegen bleiben, nicht weiteratmen.
--
-- Blockiert bis die Bewegung durch ist.
function FigureFX.defeatCollapse(model: Model, duration: number)
	FigureFX.stopIdle(model)

	local basePivot = model:GetPivot()
	local foot      = footOf(model)
	local radians   = math.rad(COLLAPSE_DEGREES)
	local sink      = heightOf(model) * COLLAPSE_SINK_SHARE

	animate(model, duration, function(t)
		-- Quadratisch statt linear: erst langsam wegkippen, dann fallen.
		local fall = t * t
		model:PivotTo(tilted(basePivot, foot, radians * fall, sink * fall))
	end)
end

-- Die Figur beugt sich nach vorne, bleibt kurz unten und richtet sich wieder
-- auf — die "ich fresse gerade"-Bewegung am Honig-Teich.
--
-- `duration` ist die GESAMTE Dauer inklusive Verharren, damit der Aufrufer
-- einfach seine bisherige Wartezeit durchreichen kann, statt sie aufzuteilen.
-- Blockiert genau so lange.
function FigureFX.leanForward(model: Model, degrees: number, duration: number)
	local resume = takeOver(model)

	local basePivot = model:GetPivot()
	local foot      = footOf(model)

	-- Negativ = nach vorne (siehe tilted).
	local radians = -math.rad(degrees)
	local move    = (1 - LEAN_HOLD_SHARE) * 0.5   -- Anteil fuer Runter bzw. Hoch

	animate(model, duration, function(t)
		local amount: number
		if t &lt; move then
			amount = t / move                      -- runterbeugen
		elseif t &lt; move + LEAN_HOLD_SHARE then
			amount = 1                             -- unten bleiben
		else
			amount = (1 - t) / move                -- wieder aufrichten
		end

		model:PivotTo(tilted(basePivot, foot, radians * math.clamp(amount, 0, 1), 0))
	end)

	-- Sauber aufgerichtet enden, auch nach einem Abbruch.
	if model.Parent ~= nil then
		model:PivotTo(basePivot)
	end

	if resume then resume() end
end

--------------------------------------------------------------------------------
-- v15: Zusammenprall (Kampf-Choreografie)
--------------------------------------------------------------------------------
-- Ein Stoss im PIT: der Angreifer rennt auf den Gegner zu und springt ihn an,
-- der Gegner kommt ihm ein Stueck entgegen, beim Aufprall wird der Getroffene
-- zurueckgestossen, danach gehen beide an ihre Plaetze zurueck.
--
-- Anders als attackLunge bewegt clash ZWEI Figuren in einem Zug — getrennte
-- Aufrufe liefen nicht im Gleichtakt, und der Aufprall muss fuer beide im
-- selben Frame passieren.
--
-- Die Plaetze (Fusspunkte) kommen herein, statt sie hier abzulesen: im Kampf
-- weiss nur der Aufrufer, wo die Figuren hingehoeren (Turmetage). Waere eine
-- Figur von einem abgebrochenen Stoss noch verschoben, wuerde sie so trotzdem
-- wieder exakt auf ihren Platz gesetzt.

export type ClashOptions = {
	seconds   : number,           -- Gesamtdauer
	gap       : number,           -- Abstand der Fusspunkte beim Aufprall
	hop       : number,           -- Hoehe des Ansprungs
	knockback : number,           -- wie weit der Getroffene zurueckfliegt
	step      : number?,          -- Anteil des Wegs, den der Getroffene entgegenkommt
	onImpact  : (() -&gt; ())?,      -- genau im Aufprall-Frame (Balken, Funken, Ton)
}

-- Form des Stosses (v15.1: natuerlicher). Anteile an der Gesamtdauer:
--   0 .. RUN_END     beide LAUFEN aufeinander zu: kleine Schritt-Huepfer,
--                    nach vorne geneigt, erst langsam, dann schneller
--   .. IMPACT_AT     der Angreifer setzt zum kurzen Sprung an (Bogen)
--   .. RECOIL_END    Aufprall: der Getroffene fliegt zurueck, der Angreifer
--                    prallt ab
--   .. 1             beide trotten an ihre Plaetze zurueck (kleine Schritte)
local CLASH_RUN_END      = 0.46
local CLASH_IMPACT_AT    = 0.60
local CLASH_RECOIL_END   = 0.76
local CLASH_LEAP_SHARE   = 0.30   -- Sprungweite als Anteil des Anlaufwegs
local CLASH_RUN_STEPS    = 4      -- Schritt-Huepfer waehrend des Anlaufs
local CLASH_BACK_STEPS   = 3      -- ... auf dem Rueckweg
local CLASH_STEP_HOP     = 0.30   -- Huepfhoehe eines Schritts, Anteil von `hop`
local CLASH_LEAN_DEGREES = 12     -- Vorlage beim Rennen
local CLASH_RECOIL_HOP   = 0.35   -- Huepfer des Getroffenen, Anteil von `hop`
local CLASH_BOUNCE       = 0.25   -- Angreifer prallt um diesen Anteil von `gap` ab
local CLASH_TARGET_DELAY = 0.25   -- der Getroffene laeuft etwas spaeter los

-- Weiche Kurve 0 → 1 (langsam rein, schnell, langsam raus).
local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end

-- Schritt-Huepfer: |sin| ergibt eine Folge kleiner Boegen, nie unter 0.
local function stepLift(k: number, steps: number, height: number): number
	return math.abs(math.sin(k * steps * math.pi)) * height
end

-- Figur auf `foot` stellen, mit Blick `facing`, um `degrees` nach vorne
-- geneigt (Fuesse bleiben am Boden, siehe tilted).
local function placeLeaning(model: Model, foot: Vector3, lift: number, facing: CFrame, degrees: number)
	FigurePlacement.place(model, foot + Vector3.new(0, lift, 0), facing)
	if degrees ~= 0 then
		model:PivotTo(tilted(model:GetPivot(), foot + Vector3.new(0, lift, 0), -math.rad(degrees), 0))
	end
end

-- Blockiert bis der Stoss durch ist. `target` darf fehlen (Gegner-Mesh nicht
-- da) — dann springt der Angreifer ins Leere, onImpact kommt trotzdem.
function FigureFX.clash(attacker: Model, target: Model?, attackerHome: Vector3, targetHome: Vector3, options: ClashOptions)
	local resumeA = takeOver(attacker)
	local resumeB = if target then takeOver(target) else nil

	local facingA = attacker:GetPivot().Rotation
	local facingB = if target then target:GetPivot().Rotation else facingA

	local flatTarget = Vector3.new(targetHome.X, attackerHome.Y, targetHome.Z)
	local delta = flatTarget - attackerHome
	local distance = delta.Magnitude
	local dir = if distance &gt; EPSILON then delta.Unit else Vector3.zAxis

	-- Treffpunkt: der Getroffene kommt `step` des Wegs entgegen, der
	-- Angreifer landet `gap` davor. Der letzte Teil seines Wegs ist ein
	-- Sprung, davor wird gelaufen.
	local stepShare = options.step or 0
	local travel = math.max(0, distance - options.gap)
	local targetMeet = targetHome - dir * (travel * stepShare)
	local attackerMeet = Vector3.new(targetMeet.X, attackerHome.Y, targetMeet.Z) - dir * options.gap
	local runWay = (attackerMeet - attackerHome).Magnitude
	local leapStart = attackerMeet - dir * (runWay * CLASH_LEAP_SHARE)
	local targetPushed = targetHome + dir * options.knockback
	local attackerBounce = attackerMeet - dir * (options.gap * CLASH_BOUNCE)

	local stepHop = options.hop * CLASH_STEP_HOP
	local impacted = false

	local function placeTarget(foot: Vector3, lift: number, lean: number)
		if target and target.Parent ~= nil then
			placeLeaning(target, foot, lift, facingB, lean)
		end
	end

	animate(attacker, options.seconds, function(t)
		if t &lt; CLASH_RUN_END then
			-- Anlauf: beschleunigen (k^1.6), Schritt-Huepfer, Vorlage.
			local k = t / CLASH_RUN_END
			local pos = attackerHome:Lerp(leapStart, k ^ 1.6)
			placeLeaning(attacker, pos, stepLift(k, CLASH_RUN_STEPS, stepHop), facingA,
				CLASH_LEAN_DEGREES * math.min(1, k * 3))

			-- Der Getroffene laeuft etwas spaeter los, ebenfalls mit Schritten.
			local kb = math.clamp((t / CLASH_IMPACT_AT - CLASH_TARGET_DELAY) / (1 - CLASH_TARGET_DELAY), 0, 1)
			placeTarget(targetHome:Lerp(targetMeet, smooth(kb)),
				stepLift(kb, CLASH_RUN_STEPS - 1, stepHop * 0.8), CLASH_LEAN_DEGREES * 0.6 * math.min(1, kb * 3))
		elseif t &lt; CLASH_IMPACT_AT then
			-- Sprung: flacher Bogen bis zum Treffpunkt, leicht vorgebeugt.
			local k = (t - CLASH_RUN_END) / (CLASH_IMPACT_AT - CLASH_RUN_END)
			local lift = math.sin(k * math.pi) * options.hop
			placeLeaning(attacker, leapStart:Lerp(attackerMeet, k), lift, facingA, CLASH_LEAN_DEGREES * 1.3)

			local kb = math.clamp((t / CLASH_IMPACT_AT - CLASH_TARGET_DELAY) / (1 - CLASH_TARGET_DELAY), 0, 1)
			placeTarget(targetHome:Lerp(targetMeet, smooth(kb)), 0, CLASH_LEAN_DEGREES * 0.6)
		elseif t &lt; CLASH_RECOIL_END then
			if not impacted then
				impacted = true
				if options.onImpact then
					options.onImpact()
				end
			end
			local k = (t - CLASH_IMPACT_AT) / (CLASH_RECOIL_END - CLASH_IMPACT_AT)
			local ease = 1 - (1 - k) * (1 - k)
			placeLeaning(attacker, attackerMeet:Lerp(attackerBounce, ease), 0, facingA, CLASH_LEAN_DEGREES * (1 - k))
			-- Der Getroffene wird nach hinten gekippt zurueckgestossen.
			local lift = math.sin(k * math.pi) * options.hop * CLASH_RECOIL_HOP
			placeTarget(targetMeet:Lerp(targetPushed, ease), lift, -CLASH_LEAN_DEGREES * math.sin(k * math.pi))
		else
			-- Zurueck an die Plaetze, in kleinen Schritten statt zu gleiten.
			local k = (t - CLASH_RECOIL_END) / (1 - CLASH_RECOIL_END)
			local e = smooth(k)
			placeLeaning(attacker, attackerBounce:Lerp(attackerHome, e), stepLift(k, CLASH_BACK_STEPS, stepHop * 0.6), facingA, 0)
			placeTarget(targetPushed:Lerp(targetHome, e), stepLift(k, CLASH_BACK_STEPS - 1, stepHop * 0.5), 0)
		end
	end)

	-- Bei sehr kurzen Dauern kann der Aufprall-Frame uebersprungen werden.
	if not impacted and options.onImpact then
		options.onImpact()
	end

	-- Immer exakt auf den Plaetzen enden, auch nach einem Abbruch.
	if attacker.Parent ~= nil then
		FigurePlacement.place(attacker, attackerHome, facingA)
	end
	if target and target.Parent ~= nil then
		FigurePlacement.place(target, targetHome, facingB)
	end

	if resumeA then resumeA() end
	if resumeB then resumeB() end
end

-- Rueckstoss ohne Anlauf: der Getroffene fliegt von `fromPosition` weg nach
-- hinten (kleiner Huepfer, nach hinten gekippt) und trottet zurueck.
-- Fuer Faehigkeiten mit Show: die Show IST der Angriff, der Angreifer rennt
-- nicht mehr los — nur der Treffer kommt im Einschlag-Moment an.
-- Gleiche Anteile wie der Rueckstoss-Teil von `clash`, damit es gleich wirkt.
-- Blockiert bis die Bewegung durch ist.
local RECOIL_PUSH_END = 0.38

function FigureFX.recoil(target: Model, home: Vector3, fromPosition: Vector3, knockback: number, hop: number, seconds: number)
	local resume = takeOver(target)
	local facing = target:GetPivot().Rotation

	local flat = Vector3.new(home.X - fromPosition.X, 0, home.Z - fromPosition.Z)
	local dir = if flat.Magnitude &gt; EPSILON then flat.Unit else -facing.LookVector
	local pushed = home + dir * knockback
	local stepHop = hop * CLASH_STEP_HOP

	animate(target, seconds, function(t)
		if target.Parent == nil then return end
		if t &lt; RECOIL_PUSH_END then
			local k = t / RECOIL_PUSH_END
			local ease = 1 - (1 - k) * (1 - k)
			local lift = math.sin(k * math.pi) * hop * CLASH_RECOIL_HOP
			placeLeaning(target, home:Lerp(pushed, ease), lift, facing, -CLASH_LEAN_DEGREES * math.sin(k * math.pi))
		else
			local k = (t - RECOIL_PUSH_END) / (1 - RECOIL_PUSH_END)
			placeLeaning(target, pushed:Lerp(home, smooth(k)), stepLift(k, CLASH_BACK_STEPS - 1, stepHop * 0.5), facing, 0)
		end
	end)

	if target.Parent ~= nil then
		FigurePlacement.place(target, home, facing)
	end
	if resume then resume() end
end

-- Taumeln (betaeubt): die Figur wankt kurz hin und her, Fuesse bleiben
-- stehen. Blockiert bis die Bewegung durch ist.
local STAGGER_DEGREES = 12
local STAGGER_SWINGS  = 2

function FigureFX.stagger(model: Model, duration: number)
	local resume = takeOver(model)

	local basePivot = model:GetPivot()
	local foot      = footOf(model)
	local radians   = math.rad(STAGGER_DEGREES)

	animate(model, duration, function(t)
		local swing = math.sin(t * math.pi * 2 * STAGGER_SWINGS) * (1 - t)
		model:PivotTo(tilted(basePivot, foot, radians * swing, 0))
	end)

	if model.Parent ~= nil then
		model:PivotTo(basePivot)
	end

	if resume then resume() end
end

-- Ein kurzer Ton an einer Weltposition (Aufprall). Alle Spieler in der Naehe
-- hoeren ihn, weil er serverseitig in der Welt haengt. Leise Grenzen fuer die
-- Reichweite, damit ein Kampf nicht ueber die ganze Karte schallt.
function FigureFX.soundAt(position: Vector3, soundId: string, volume: number, parent: Instance, pitch: number?)
	local anchor = Instance.new("Part")
	anchor.Name         = "FXSound"
	anchor.Anchored     = true
	anchor.CanCollide   = false
	anchor.CanTouch     = false
	anchor.CanQuery     = false
	anchor.Transparency = 1
	anchor.Size         = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame       = CFrame.new(position)
	anchor.Parent       = parent

	local sound = Instance.new("Sound")
	sound.SoundId            = soundId
	sound.Volume             = volume
	sound.PlaybackSpeed      = pitch or 1
	sound.RollOffMode        = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 8
	sound.RollOffMaxDistance = 70
	sound.Parent             = anchor
	sound:Play()

	Debris:AddItem(anchor, 2)
end

--------------------------------------------------------------------------------
-- Feier-Momente: Partikel-Stoss + Huepfer + Aufleuchten
--------------------------------------------------------------------------------
-- Fuer Ereignisse, die vorher nur als Toast-Text sichtbar waren (Level-Up,
-- Promotion, Rebirth, Ei einsammeln) — siehe
-- DESIGN_VORSCHLAG_TRENDANALYSE_2026-09-11.md, Abschnitt 4. WICHTIG: das
-- passiert in der geteilten Welt, alle 8 Spieler sehen es mit, nicht nur der
-- Besitzer — genau das macht den Unterschied zu einem reinen UI-Toast.

-- Ein einmaliger Partikel-Stoss an einer Attachment/BasePart. Feuert sofort
-- `count` Partikel und raeumt sich selbst ab (Debris) — kein Dauer-Emitter,
-- der irgendwo vergessen werden koennte.
local function burstParticles(parent: Instance, color: Color3, count: number)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture      = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color        = ColorSequence.new(color)
	emitter.Size          = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency  = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime      = NumberRange.new(0.5, 0.9)
	emitter.Speed         = NumberRange.new(6, 12)
	emitter.SpreadAngle   = Vector2.new(180, 180)
	emitter.Rate          = 0   -- kein Dauerstrom, nur der Emit()-Stoss unten
	emitter.Parent        = parent

	emitter:Emit(count)

	Debris:AddItem(emitter, 1.2)
end

-- Feier-Moment an einer FIGUR: ein kurzer Freuden-Huepfer (rein vertikal,
-- Fusspunkt bleibt stehen), ein Partikel-Stoss in `color`, und ein kurzes
-- Aufleuchten (wiederverwendet hitFlash — dieselbe Technik, andere Bedeutung).
--
-- Blockiert NICHT: laeuft als eigene Coroutine, damit der aufrufende Service
-- (der gerade PlayerService.markDirty/saveNow aufrufen will) nicht auf eine
-- Zierbewegung warten muss.
function FigureFX.celebrate(model: Model, color: Color3, duration: number?)
	local seconds = math.max(duration or CELEBRATE_DEFAULT_SECONDS, MIN_SECONDS)

	local anchor = (model.PrimaryPart :: BasePart?) or (model:FindFirstChildWhichIsA("BasePart", true) :: BasePart?)
	if anchor then
		local attachment = Instance.new("Attachment")
		attachment.Name   = "CelebrateBurst"
		attachment.Parent = anchor

		burstParticles(attachment, color, CELEBRATE_PARTICLE_COUNT)
		Debris:AddItem(attachment, 1.3)
	end

	FigureFX.hitFlash(model, color, CELEBRATE_FLASH_SECONDS)

	task.spawn(function()
		local resume = takeOver(model)

		local basePivot = model:GetPivot()
		local hop        = heightOf(model) * CELEBRATE_HOP_HEIGHT_SHARE

		animate(model, seconds, function(t)
			-- sin(pi*t): hoch und wieder runter in einem Zug, wie ein einzelner
			-- Freudensprung — dieselbe Kurve wie beim Ausfallschritt.
			local swing = math.sin(t * math.pi)
			model:PivotTo(basePivot + Vector3.new(0, hop * swing, 0))
		end)

		if model.Parent ~= nil then
			model:PivotTo(basePivot)
		end

		if resume then resume() end
	end)
end

-- Feier-Moment an einer FESTEN WELTPOSITION, ohne Model — fuer Momente wie
-- das Einsammeln eines Eis, wo es keine Figur gibt, an die der Effekt haengen
-- koennte. Baut einen unsichtbaren, nicht-kollidierenden Anker-Part, feuert
-- den Partikel-Stoss, und raeumt beides selbst wieder ab.
function FigureFX.burstAt(position: Vector3, color: Color3, parent: Instance, count: number?)
	local anchor = Instance.new("Part")
	anchor.Name         = "FXAnchor"
	anchor.Anchored     = true
	anchor.CanCollide   = false
	anchor.CanTouch     = false
	anchor.CanQuery     = false
	anchor.Transparency = 1
	anchor.Size         = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame       = CFrame.new(position)
	anchor.Parent       = parent

	burstParticles(anchor, color, count or CELEBRATE_PARTICLE_COUNT)

	Debris:AddItem(anchor, 1.3)
end

return FigureFX
</ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="Folder" referent="RBX13"><Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="Folder" referent="RBX14"><Properties>
<string name="Name">Controllers</string>
</Properties>
<Item class="ModuleScript" referent="RBX15"><Properties>
<string name="Name">SkillFXController</string>
<ProtectedString name="Source">--!strict
-- SkillFXController.luau
-- StarterPlayerScripts/Controllers/SkillFXController.luau
--
-- v14 (Mega Egg Tree, WP8): der SkillFX-Baukasten.
--
-- Spielt die Show einer Faehigkeit ab, wenn der Server sie im PIT meldet
-- (Remotes.SkillFXPlay, gefeuert von PitArenaService). WAS gezeigt wird,
-- steht als reine Daten in Config/SkillFXConfig — hier stehen nur die
-- Bausteine (aura, ring, pillar, ...) und der Ablauf.
--
-- Alles hier ist rein CLIENTSEITIG: die Teile entstehen nur auf diesem
-- Rechner, beruehren keine Physik und verschwinden nach ihrer Dauer selbst.
-- Der Server wartet waehrend der vollen Show einfach (SkillFXConfig.getDuration),
-- damit Kampf und Show zusammenpassen.
--
-- WER sieht was:
--   * Besitzer: alles — Welt-Effekte, Farbfilter, Blitz, Wackeln, Kamerafahrt.
--   * Andere Spieler in der Naehe: nur die Effekte in der Welt. Ihr Bild und
--     ihre Kamera gehoeren ihnen.
--
-- Partikel-Budget: alle Stueckzahlen werden mit dem Faktor der Grafikstufe
-- multipliziert (SkillFXConfig.PARTICLE_BUDGET), damit Handys nicht ruckeln.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")
local RunService        = game:GetService("RunService")
local Lighting          = game:GetService("Lighting")
local Debris            = game:GetService("Debris")

local Remotes       = require(ReplicatedStorage.Network.Remotes)
local SkillFXConfig = require(ReplicatedStorage.Config.SkillFXConfig)
local MapConfig     = require(ReplicatedStorage.Config.MapConfig)

local SkillFXController = {}

local player = Players.LocalPlayer

-- Wie weit weg ein Zuschauer noch Effekte sieht (Studs).
local SPECTATOR_DISTANCE = 260

local _folder: Folder? = nil

local function folder(): Folder
	if _folder and _folder.Parent then
		return _folder
	end
	local f = Instance.new("Folder")
	f.Name = "SkillFXLocal"
	f.Parent = workspace
	_folder = f
	return f
end

--------------------------------------------------------------------------------
-- Budget
--------------------------------------------------------------------------------

local function budgetFactor(): number
	local ok, level = pcall(function()
		local settingsObj = UserSettings():GetService("UserGameSettings")
		return (settingsObj :: any).SavedQualityLevel
	end)
	local b = SkillFXConfig.PARTICLE_BUDGET
	if not ok or level == nil or level == Enum.SavedQualitySetting.Automatic then
		return b.medium
	end
	local n = tonumber(string.match(tostring(level), "(%d+)$")) or 5
	if n &lt;= 3 then return b.low end
	if n &lt;= 6 then return b.medium end
	return b.high
end

local function scaled(count: number?, factor: number): number
	return math.max(SkillFXConfig.PARTICLE_BUDGET.MIN_COUNT, math.floor((count or 6) * factor + 0.5))
end

--------------------------------------------------------------------------------
-- Kleine Werkzeuge
--------------------------------------------------------------------------------

local function newPart(shape: Enum.PartType?, size: Vector3, color: Color3, cf: CFrame, transparency: number?): Part
	local p = Instance.new("Part")
	p.Shape        = shape or Enum.PartType.Block
	p.Size         = size
	p.Color        = color
	p.Material     = Enum.Material.Neon
	p.Anchored     = true
	p.CanCollide   = false
	p.CanQuery     = false
	p.CanTouch     = false
	p.CastShadow   = false
	p.CFrame       = cf
	p.Transparency = transparency or 0
	p.Parent       = folder()
	return p
end

local function tween(inst: Instance, seconds: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local t = TweenService:Create(inst, TweenInfo.new(math.max(0.01, seconds), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function fadeAndDestroy(p: BasePart, seconds: number, extra: { [string]: any }?)
	local props: { [string]: any } = { Transparency = 1 }
	if extra then
		for k, v in extra do props[k] = v end
	end
	tween(p, seconds, props)
	Debris:AddItem(p, seconds + 0.1)
end

local function centerOf(model: Model?): Vector3?
	if not model or not model.Parent then return nil end
	local ok, cf = pcall(function()
		return (model :: Model):GetBoundingBox()
	end)
	if not ok or typeof(cf) ~= "CFrame" then return nil end
	return (cf :: CFrame).Position
end

-- Groesse der Figur (Bounding-Box). Fallback: ein normaler Baerchi.
local function sizeOf(model: Model?): Vector3
	if model and model.Parent then
		local ok, _, size = pcall(function()
			return (model :: Model):GetBoundingBox()
		end)
		if ok and typeof(size) == "Vector3" and (size :: Vector3).Y &gt; 0.5 then
			return size :: Vector3
		end
	end
	return Vector3.new(3, 3.5, 3)
end

-- Gleiche Regeln wie newPart, fuer andere Teil-Klassen (CornerWedgePart ...).
local function prepPart(p: BasePart, color: Color3, cf: CFrame, transparency: number?)
	p.Color        = color
	p.Material     = Enum.Material.Neon
	p.Anchored     = true
	p.CanCollide   = false
	p.CanQuery     = false
	p.CanTouch     = false
	p.CastShadow   = false
	p.CFrame       = cf
	p.Transparency = transparency or 0
	p.Parent       = folder()
end

-- Tween mit Startverzoegerung: so braucht eine Reihe von Teilen (Dornen,
-- Riss-Stuecke) keinen eigenen Thread pro Teil.
local function tweenLater(inst: Instance, delaySeconds: number, seconds: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local info = TweenInfo.new(math.max(0.01, seconds), style or Enum.EasingStyle.Quad,
		dir or Enum.EasingDirection.Out, 0, false, math.max(0, delaySeconds))
	local t = TweenService:Create(inst, info, props)
	t:Play()
	return t
end

local RAINBOW = {
	Color3.fromRGB(255, 60, 60), Color3.fromRGB(255, 160, 40), Color3.fromRGB(255, 240, 60),
	Color3.fromRGB(80, 230, 90), Color3.fromRGB(60, 180, 255), Color3.fromRGB(150, 90, 255),
}

local function pickColor(step: { [string]: any }, fx: SkillFXConfig.SkillFX, i: number?): Color3
	if typeof(step.color) == "Color3" then
		return step.color                          -- v16: feste Farbe je Schritt
	end
	if step.rainbow then
		return RAINBOW[((i or 1) - 1) % #RAINBOW + 1]
	end
	if step.dark or step.second then
		return fx.color2
	end
	if i and i % 2 == 0 then
		return fx.color2
	end
	return fx.color
end

--------------------------------------------------------------------------------
-- Kontext einer Show
--------------------------------------------------------------------------------

type Ctx = {
	fx       : SkillFXConfig.SkillFX,
	id       : string,
	selfPos  : Vector3,
	targetPos: Vector3,
	arena    : Vector3,
	isOwner  : boolean,
	factor   : number,
	cc       : ColorCorrectionEffect?,
	sounds   : { [string]: boolean },
	-- v16 (Gletscher-Show): Fuesse, Groesse und Blickrichtung der Kaempfer.
	-- Alles relativ zu den Figuren, nie zur Arena-Bodenhoehe (Tower!).
	selfModel  : Model?,
	targetModel: Model?,
	selfSize   : Vector3,
	targetSize : Vector3,
	selfFeet   : Vector3,
	targetFeet : Vector3,
	fwd        : Vector3,       -- waagerecht von self zu target, Laenge 1
	path       : { Vector3 }?,  -- Zickzack-Linie des letzten `crack`
	cometHead  : BasePart?,     -- Kopf des laufenden `comet` (Kamera "chase")
	far        : boolean,       -- Zuschauer ausserhalb SPECTATOR_DISTANCE: nur `global`-Schritte
	bonus      : boolean,       -- Finisher/Opener hat gegriffen (Server: SkillFXPlay.bonus)
}

local function at(ctx: Ctx, where: string?): Vector3
	if where == "target" then return ctx.targetPos end
	if where == "arena" then return ctx.arena end
	return ctx.selfPos
end

-- Bodenpunkt unter einer Figur (Fuesse).
local function groundAt(ctx: Ctx, where: string?): Vector3
	if where == "target" then return ctx.targetFeet end
	if where == "arena" then return (ctx.selfFeet + ctx.targetFeet) / 2 end
	return ctx.selfFeet
end

local function sizeAt(ctx: Ctx, where: string?): Vector3
	if where == "target" then return ctx.targetSize end
	return ctx.selfSize
end

-- Textur-ID aus SkillFXConfig.TEXTURES[&lt;Faehigkeit&gt;][key] oder nil (dann
-- laeuft der Rueckfall mit Neon-Teilen bzw. Standard-Partikeln).
local function texOf(ctx: Ctx, key: string?): string?
	if not key then return nil end
	local set = SkillFXConfig.TEXTURES[ctx.id]
	local id = set and set[key]
	if typeof(id) == "number" and id &gt; 0 then
		return "rbxassetid://" .. tostring(id)
	end
	return nil
end

local function addDecal(p: BasePart, texture: string, face: Enum.NormalId, color: Color3?): Decal
	local d = Instance.new("Decal")
	d.Texture = texture
	d.Face = face
	if color then d.Color3 = color end
	d.Parent = p
	return d
end

-- Beiwerk (Schritte mit `extra = true`, Adern, Glitzer) faellt auf
-- niedriger Grafikstufe weg; der Kernmoment bleibt.
local function extrasOn(ctx: Ctx): boolean
	return ctx.factor &gt;= SkillFXConfig.PARTICLE_BUDGET.EXTRAS_MIN
end

-- v16: Radius als Zahl oder als Name: "tower" = Turmspitze/Kampfflaeche
-- (MapConfig.PIT_TOWER_RADIUS), "fence" = bis zum Arena-Zaun. Beide gemessen
-- ab der Arena-Mitte (req.center = Mitte zwischen den Kaempfern = Turmmitte).
local function radiusOf(v: any, default: number): number
	if v == "tower" then return MapConfig.PIT_TOWER_RADIUS end
	if v == "fence" then return MapConfig.PIT_RADIUS - MapConfig.PIT_FENCE_INSET end
	return if typeof(v) == "number" then v else default
end

--------------------------------------------------------------------------------
-- Bausteine
--------------------------------------------------------------------------------

local BLOCKS: { [string]: (Ctx, { [string]: any }) -&gt; () } = {}

BLOCKS.aura = function(ctx, s)
	local pos = at(ctx, s.at)
	local size = s.size or 4
	local dur = s.dur or 0.6
	local ball = newPart(Enum.PartType.Ball, Vector3.one * size * 0.4, pickColor(s, ctx.fx), CFrame.new(pos), 0.35)
	local light = Instance.new("PointLight")
	light.Color = ball.Color
	light.Range = size * 3
	light.Brightness = 3
	light.Parent = ball
	tween(ball, dur * 0.5, { Size = Vector3.one * size }, Enum.EasingStyle.Back)
	if s.rainbow then
		task.spawn(function()
			local t0 = os.clock()
			while ball.Parent and os.clock() - t0 &lt; dur do
				ball.Color = Color3.fromHSV(((os.clock() - t0) * 1.5) % 1, 0.8, 1)
				light.Color = ball.Color
				task.wait(0.05)
			end
		end)
	end
	task.delay(dur * 0.5, function()
		if ball.Parent then fadeAndDestroy(ball, dur * 0.5, { Size = Vector3.one * size * 1.3 }) end
	end)
end

BLOCKS.ring = function(ctx, s)
	-- `ground = true`: flach auf dem Boden unter der Figur (v16).
	local pos = if s.ground then groundAt(ctx, s.at) + Vector3.new(0, 0.1, 0) else at(ctx, s.at) - Vector3.new(0, 1.2, 0)
	if s.lift then
		-- v16: `lift` = so viele Studs ueber der Figur (z. B. Wolkenloch)
		pos = at(ctx, s.at) + Vector3.new(0, s.lift, 0)
	end
	local r = radiusOf(s.radius, 6)
	local dur = s.dur or 0.6
	-- `toArena` (v16): der Bodenring startet an der Figur und waechst um die
	-- Arena-Mitte herum (z. B. Schockwelle bis zum Zaun).
	local endPos = if s.toArena and s.ground then groundAt(ctx, "arena") + Vector3.new(0, 0.1, 0) else pos
	local startD = if s.shrink then r * 2 else 0.5
	local endD   = if s.shrink then 0.5 else r * 2
	-- `ground` + `tex`: das Bild liegt als Decal auf einer flachen, unsichtbaren
	-- Platte (quadratisches PNG mit rundem Motiv).
	local texture = if s.ground or s.lift then texOf(ctx, s.tex) else nil
	if texture then
		local plate = newPart(Enum.PartType.Block, Vector3.new(startD, 0.05, startD), pickColor(s, ctx.fx), CFrame.new(pos), 1)
		local d = addDecal(plate, texture, Enum.NormalId.Top, plate.Color)
		tween(plate, dur, { Size = Vector3.new(endD, 0.05, endD), CFrame = CFrame.new(endPos) })
		tweenLater(d, dur * 0.6, dur * 0.4, { Transparency = 1 })
		if s.lift then
			-- von unten sichtbar
			local under = addDecal(plate, texture, Enum.NormalId.Bottom, plate.Color)
			tweenLater(under, dur * 0.6, dur * 0.4, { Transparency = 1 })
		end
		Debris:AddItem(plate, dur + 0.1)
		return
	end
	local ring = newPart(Enum.PartType.Cylinder, Vector3.new(if s.ground or s.lift then 0.08 else 0.25, startD, startD), pickColor(s, ctx.fx),
		CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), 0.2)
	if s.ground or s.lift then
		-- flacher Ring: Dicke bleibt, nur der Durchmesser waechst
		tween(ring, dur, { Size = Vector3.new(0.08, endD, endD),
			CFrame = CFrame.new(endPos) * CFrame.Angles(0, 0, math.rad(90)) })
		task.delay(dur * 0.6, function()
			if ring.Parent then fadeAndDestroy(ring, dur * 0.4) end
		end)
		return
	end
	if s.rainbow or s.glyphs or s.infinity or s.clock then
		task.spawn(function()
			local t0 = os.clock()
			while ring.Parent and os.clock() - t0 &lt; dur do
				local k = os.clock() - t0
				if s.rainbow then ring.Color = Color3.fromHSV((k * 1.2) % 1, 0.8, 1) end
				ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, k * (if s.clock then -6 else 4), math.rad(90))
				task.wait(0.03)
			end
		end)
	end
	tween(ring, dur, { Size = Vector3.new(0.25, endD, endD) })
	task.delay(dur * 0.6, function()
		if ring.Parent then fadeAndDestroy(ring, dur * 0.4) end
	end)
end

BLOCKS.pillar = function(ctx, s)
	local pos = at(ctx, s.at)
	local h = s.height or 16
	local w = s.width or 3
	local dur = s.dur or 0.8
	local base = pos - Vector3.new(0, 1.5, 0)
	if s.feet then
		-- v16: Fuss der Saeule genau unter der Figur (Tower in jeder Hoehe)
		base = groundAt(ctx, s.at)
	end
	local texture = texOf(ctx, s.tex)
	if texture then
		-- v16: Saeule als Beam mit Bild (weicher Verlauf). Zwei unsichtbare
		-- Anker; bei `fromSky` faellt der untere Anker von oben herab.
		local topPart = newPart(Enum.PartType.Block, Vector3.one * 0.2, Color3.new(1, 1, 1), CFrame.new(base + Vector3.new(0, h, 0)), 1)
		local lowPart = newPart(Enum.PartType.Block, Vector3.one * 0.2, Color3.new(1, 1, 1),
			CFrame.new(if s.fromSky then base + Vector3.new(0, h, 0) else base), 1)
		local a0 = Instance.new("Attachment"); a0.Parent = topPart
		local a1 = Instance.new("Attachment"); a1.Parent = lowPart
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Texture = texture
		beam.TextureMode = Enum.TextureMode.Stretch
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Color = ColorSequence.new(pickColor(s, ctx.fx))
		beam.Width0 = w
		beam.Width1 = w
		beam.Parent = topPart
		tween(lowPart, dur * 0.35, { CFrame = CFrame.new(base) }, Enum.EasingStyle.Quart)
		tweenLater(beam, dur * 0.6, dur * 0.4, { Width0 = w * 0.2, Width1 = w * 0.2 })
		Debris:AddItem(topPart, dur + 0.1)
		Debris:AddItem(lowPart, dur + 0.1)
		return
	end
	local startCf = if s.fromSky
		then CFrame.new(base + Vector3.new(0, h * 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
		else CFrame.new(base) * CFrame.Angles(0, 0, math.rad(90))
	local col = newPart(Enum.PartType.Cylinder, Vector3.new(0.2, w, w), pickColor(s, ctx.fx), startCf, if s.soft then 0.5 else 0.15)
	tween(col, dur * 0.35, {
		Size = Vector3.new(h, w, w),
		CFrame = CFrame.new(base + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	}, Enum.EasingStyle.Quart)
	if s.beacon then
		task.spawn(function()
			local t0 = os.clock()
			while col.Parent and os.clock() - t0 &lt; dur do
				col.Transparency = 0.15 + 0.5 * (0.5 + 0.5 * math.sin((os.clock() - t0) * 12))
				task.wait(0.03)
			end
		end)
	end
	task.delay(dur * 0.6, function()
		if col.Parent then fadeAndDestroy(col, dur * 0.4, { Size = Vector3.new(h, w * 0.2, w * 0.2) }) end
	end)
end

local function shootOne(ctx: Ctx, s: { [string]: any }, delaySeconds: number, offset: Vector3)
	task.delay(delaySeconds, function()
		local from = ctx.selfPos + Vector3.new(0, 0.5, 0) + offset
		local to = ctx.targetPos + Vector3.new(0, 0.5, 0)
		local size = s.size or 1
		local ball = newPart(Enum.PartType.Ball, Vector3.one * size, pickColor(s, ctx.fx), CFrame.new(from), 0)
		local a0 = Instance.new("Attachment"); a0.Position = Vector3.new(0, size * 0.3, 0); a0.Parent = ball
		local a1 = Instance.new("Attachment"); a1.Position = Vector3.new(0, -size * 0.3, 0); a1.Parent = ball
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(ball.Color, ctx.fx.color2)
		trail.Lifetime = 0.25
		trail.LightEmission = 1
		trail.Transparency = NumberSequence.new(0, 1)
		trail.Parent = ball
		if s.flame then
			local fire = Instance.new("Fire")
			fire.Size = size * 2
			fire.Color = ctx.fx.color
			fire.SecondaryColor = ctx.fx.color2
			fire.Parent = ball
		end
		local dur = s.dur or 0.3
		tween(ball, dur, { CFrame = CFrame.new(to) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(dur, function()
			if ball.Parent then fadeAndDestroy(ball, 0.15, { Size = Vector3.one * size * 2.5 }) end
		end)
	end)
end

BLOCKS.projectile = function(ctx, s)
	local n = s.count or 1
	for i = 1, n do
		local off = if n &gt; 1 then Vector3.new(0, (i - (n + 1) / 2) * 0.9, 0) else Vector3.zero
		shootOne(ctx, s, (i - 1) * 0.07, off)
	end
end

BLOCKS.meteor = function(ctx, s)
	local to = at(ctx, s.at or "target")
	local h = s.height or 20
	local size = s.size or 2
	local dur = s.dur or 0.5
	local from = to + Vector3.new(h * 0.35, h, -h * 0.2)
	local rock = newPart(Enum.PartType.Ball, Vector3.one * size, pickColor(s, ctx.fx), CFrame.new(from), 0)
	if s.fist then
		rock.Shape = Enum.PartType.Block
		rock.Size = Vector3.new(size, size * 1.2, size * 0.9)
		rock.Material = Enum.Material.Slate
	end
	if s.tail or s.fist then
		local fire = Instance.new("Fire")
		fire.Size = size * 3
		fire.Heat = 25
		fire.Color = ctx.fx.color
		fire.SecondaryColor = ctx.fx.color2
		fire.Parent = rock
	end
	local light = Instance.new("PointLight")
	light.Range = size * 6
	light.Brightness = 4
	light.Color = rock.Color
	light.Parent = rock
	tween(rock, dur, { CFrame = CFrame.new(to) }, if s.slow then Enum.EasingStyle.Sine else Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(dur, function()
		if rock.Parent then fadeAndDestroy(rock, if s.dark then 1.2 else 0.25, { Size = rock.Size * 1.6 }) end
	end)
end

BLOCKS.beam = function(ctx, s)
	local from = ctx.selfPos + Vector3.new(0, 0.5, 0)
	local to = ctx.targetPos + Vector3.new(0, 0.5, 0)
	if s.curtain then
		from = ctx.selfPos + Vector3.new(-6, 9, 0)
		to = ctx.targetPos + Vector3.new(6, 9, 0)
	end
	local dist = (to - from).Magnitude
	local w = s.width or 1
	local dur = s.dur or 0.6
	local mid = (from + to) / 2
	local cf = CFrame.lookAt(mid, to)
	if s.cross then
		cf = cf * CFrame.Angles(0, 0, math.rad(90))
	end
	local beam = newPart(Enum.PartType.Block, Vector3.new(w * 0.2, w * 0.2, 0.2), pickColor(s, ctx.fx), cf, 0.05)
	if s.slash or s.rift then
		beam.Color = if s.rift then Color3.new(0, 0, 0) else ctx.fx.color2
		beam.Size = Vector3.new(w, 0.1, 0.1)
		beam.CFrame = CFrame.lookAt(ctx.targetPos, ctx.targetPos + Vector3.new(0, 1, 0.001)) * CFrame.Angles(0, 0, if s.cross then math.rad(-35) else math.rad(35))
		tween(beam, dur * 0.4, { Size = Vector3.new(w, 9, 0.1) }, Enum.EasingStyle.Quart)
	else
		tween(beam, dur * 0.3, { Size = Vector3.new(w, if s.curtain then w * 3 else w, dist) }, Enum.EasingStyle.Quart)
	end
	if s.rainbow or s.curtain then
		task.spawn(function()
			local t0 = os.clock()
			while beam.Parent and os.clock() - t0 &lt; dur do
				beam.Color = Color3.fromHSV(((os.clock() - t0) * (if s.curtain then 0.4 else 1.5) + 0.35) % 1, 0.7, 1)
				task.wait(0.04)
			end
		end)
	end
	task.delay(dur * 0.65, function()
		if beam.Parent then fadeAndDestroy(beam, dur * 0.35) end
	end)
end

BLOCKS.wave = function(ctx, s)
	local pos = at(ctx, s.at)
	local r = s.radius or 10
	local dur = s.dur or 0.6
	local ball = newPart(Enum.PartType.Ball, Vector3.one, pickColor(s, ctx.fx), CFrame.new(pos), 0.3)
	ball.Material = if s.cloud then Enum.Material.SmoothPlastic else Enum.Material.ForceField
	tween(ball, dur, { Size = Vector3.one * r * 2, Transparency = 1 }, Enum.EasingStyle.Quart)
	Debris:AddItem(ball, dur + 0.1)
end

-- v16: Truemmer fliegen im Bogen nach aussen und fallen auf den Boden
-- (`arc`). Hoch und runter sind zwei Tweens; der zweite startet fuer ALLE
-- Brocken aus EINEM verzoegerten Aufruf (kein Thread pro Brocken).
local function shardsArc(ctx: Ctx, s: { [string]: any })
	local pos = at(ctx, s.at)
	local floorY = groundAt(ctx, s.at).Y
	local n = scaled(s.count, ctx.factor)
	local size = s.size or 0.8
	local dur = s.dur or 1.0
	local texture = texOf(ctx, s.tex)
	local half = dur * 0.45
	local down: { { part: BasePart, goal: CFrame } } = {}
	for i = 1, n do
		local a = math.random() * math.pi * 2
		local out = Vector3.new(math.cos(a), 0, math.sin(a))
		local reach = 5 + math.random() * 8
		local apex = pos + out * reach * 0.5 + Vector3.new(0, 2.5 + math.random() * 3.5, 0)
		local land = Vector3.new(pos.X, floorY + size * 0.3, pos.Z) + out * reach
		local p = newPart(Enum.PartType.Block, Vector3.new(size, size * 0.8, size * 0.7), pickColor(s, ctx.fx, i),
			CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), 0)
		if s.stone then
			p.Material = Enum.Material.Slate
			p.Color = Color3.fromRGB(80, 70, 90):Lerp(ctx.fx.color, 0.2)
		end
		if texture then
			addDecal(p, texture, Enum.NormalId.Top)
			addDecal(p, texture, Enum.NormalId.Front)
		end
		tween(p, half, { CFrame = CFrame.new(apex) * CFrame.Angles(math.random() * 6, math.random() * 6, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		table.insert(down, { part = p, goal = CFrame.new(land) * CFrame.Angles(math.random() * 6, math.random() * 6, 0) })
		Debris:AddItem(p, dur + 0.1)
	end
	task.delay(half, function()
		for _, d in down do
			if d.part.Parent then
				tween(d.part, half, { CFrame = d.goal }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				tweenLater(d.part, half, dur - 2 * half, { Transparency = 1 })
			end
		end
	end)
end

BLOCKS.shards = function(ctx, s)
	if s.arc then shardsArc(ctx, s) return end
	local shardTex = texOf(ctx, s.tex)
	local pos = at(ctx, s.at)
	local n = scaled(s.count, ctx.factor)
	local size = s.size or 0.6
	local dur = s.dur or 0.6
	for i = 1, n do
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8 + 0.1, math.random() - 0.5).Unit
		local from = if s.inward then pos + dir * 6 else pos
		local to = if s.inward then pos else pos + dir * (5 + math.random() * 6)
		local p = newPart(Enum.PartType.Block, Vector3.new(size, size * 1.6, size * 0.5), pickColor(s, ctx.fx, i),
			CFrame.new(from) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), 0)
		if s.stone then
			p.Material = Enum.Material.Slate
			p.Color = Color3.fromRGB(120, 110, 100):Lerp(ctx.fx.color, 0.25)
		end
		if s.glyphs then
			p.Shape = Enum.PartType.Ball
		end
		if shardTex then
			-- v16: Bild auf beiden grossen Flaechen (z. B. Schattenfetzen)
			p.Transparency = 1
			for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
				local d = addDecal(p, shardTex, face, p.Color)
				tweenLater(d, dur * 0.5, dur * 0.5, { Transparency = 1 })
			end
		end
		tween(p, dur, { CFrame = CFrame.new(to) * CFrame.Angles(math.random() * 6, math.random() * 6, 0) })
		task.delay(dur * 0.5, function()
			if p.Parent then fadeAndDestroy(p, dur * 0.5) end
		end)
	end
end

BLOCKS.sparks = function(ctx, s)
	local pos = at(ctx, s.at)
	local n = scaled(s.count, ctx.factor)
	local dur = s.dur or 0.6
	for i = 1, n do
		local dir = Vector3.new(math.random() - 0.5, math.random() - 0.2, math.random() - 0.5).Unit
		local size = if s.stars then 0.35 else 0.22
		local p = newPart(Enum.PartType.Ball, Vector3.one * size, pickColor(s, ctx.fx, i), CFrame.new(pos), 0)
		local reach = (if s.stars then 14 else 6) * (0.5 + math.random())
		local endPos = pos + dir * reach + (if s.ember then Vector3.new(0, 3, 0) else Vector3.zero)
		tween(p, dur, { CFrame = CFrame.new(endPos), Transparency = 1 }, Enum.EasingStyle.Quad)
		Debris:AddItem(p, dur + 0.1)
	end
end

BLOCKS.bubble = function(ctx, s)
	local pos = at(ctx, s.at)
	local size = s.size or 6
	local dur = s.dur or 1
	local b = newPart(Enum.PartType.Ball, Vector3.one * 0.5, pickColor(s, ctx.fx), CFrame.new(pos), 0.55)
	b.Material = Enum.Material.ForceField
	tween(b, dur * 0.25, { Size = Vector3.one * size }, Enum.EasingStyle.Back)
	if s.hex then
		local inner = newPart(Enum.PartType.Ball, Vector3.one * 0.5, ctx.fx.color2, CFrame.new(pos), 0.8)
		inner.Material = Enum.Material.Glass
		tween(inner, dur * 0.3, { Size = Vector3.one * size * 0.92 })
		task.delay(dur * 0.7, function() if inner.Parent then fadeAndDestroy(inner, dur * 0.3) end end)
	end
	task.delay(dur * 0.7, function()
		if b.Parent then fadeAndDestroy(b, dur * 0.3) end
	end)
end

BLOCKS.rise = function(ctx, s)
	local pos = at(ctx, s.at)
	local n = scaled(s.count, ctx.factor)
	local dur = s.dur or 0.8
	for i = 1, n do
		task.delay((i / n) * dur * 0.5, function()
			local off = Vector3.new((math.random() - 0.5) * 4, -1, (math.random() - 0.5) * 4)
			if s.wings then
				local side = if i % 2 == 0 then 1 else -1
				off = Vector3.new(side * (1 + math.random() * 5), math.random() * 2, (math.random() - 0.5) * 2)
			end
			local p = newPart(Enum.PartType.Ball, Vector3.one * 0.35, pickColor(s, ctx.fx, i), CFrame.new(pos + off), 0)
			local goal = pos + off + Vector3.new(0, 4 + math.random() * 3, 0)
			if s.toSelf then goal = ctx.selfPos + Vector3.new(0, 1, 0) end
			tween(p, dur * 0.6, { CFrame = CFrame.new(goal), Transparency = 1 }, Enum.EasingStyle.Sine)
			Debris:AddItem(p, dur * 0.6 + 0.1)
		end)
	end
end

BLOCKS.spiral = function(ctx, s)
	local center = at(ctx, s.at)
	local n = scaled(s.count, ctx.factor)
	local r = s.radius or 8
	local dur = s.dur or 1
	for i = 1, n do
		local angle = (i / n) * math.pi * 2
		local startR = if s.outward then 0.5 else r
		local endR = if s.outward then r else 0.3
		local size = if s.cloud then 1.4 else (if s.snow then 0.3 else 0.4)
		local p = newPart(Enum.PartType.Ball, Vector3.one * size, pickColor(s, ctx.fx, i),
			CFrame.new(center + Vector3.new(math.cos(angle) * startR, (math.random() - 0.3) * 3, math.sin(angle) * startR)),
			if s.cloud then 0.5 else 0)
		task.spawn(function()
			local t0 = os.clock()
			while p.Parent and os.clock() - t0 &lt; dur do
				local k = (os.clock() - t0) / dur
				local rr = startR + (endR - startR) * k
				local a = angle + k * math.pi * 3
				p.CFrame = CFrame.new(center + Vector3.new(math.cos(a) * rr, (1 - k) * 2, math.sin(a) * rr))
				task.wait(0.03)
			end
			if p.Parent then fadeAndDestroy(p, 0.15) end
		end)
	end
end

-- v16: Kristalle von den Fuessen bis zur Huefte (`legs`). Waechst von unten
-- nach oben: jeder Kristall startet per Tween-Verzoegerung, kein Thread.
local function frostLegs(ctx: Ctx, s: { [string]: any })
	local feet = groundAt(ctx, s.at)
	local size = sizeAt(ctx, s.at)
	local hip = size.Y * 0.55
	local radius = math.max(size.X, size.Z) * 0.42
	local n = math.max(6, scaled(s.count, ctx.factor))
	local dur = s.dur or 1.2
	local grow = dur * 0.45
	for i = 1, n do
		local k = (i - 1) / math.max(1, n - 1)          -- 0 = Fuesse, 1 = Huefte
		local a = i * 2.39996                            -- goldener Winkel: gleichmaessig rundum
		local r = radius * (1.05 - 0.25 * k)
		local base = feet + Vector3.new(math.cos(a) * r, 0.1 + k * hip, math.sin(a) * r)
		local outward = Vector3.new(math.cos(a), 0, math.sin(a))
		local h = 0.9 + 0.6 * (1 - k) + math.random() * 0.4
		local rot = CFrame.lookAt(Vector3.zero, outward).Rotation * CFrame.Angles(math.rad(25 + math.random() * 20), 0, 0)
		local p = newPart(Enum.PartType.Block, Vector3.new(0.05, 0.05, 0.05), if i % 3 == 0 then ctx.fx.color2 else ctx.fx.color,
			CFrame.new(base) * rot, 0.1)
		p.Material = Enum.Material.Ice
		local w = 0.28 + 0.12 * (1 - k)
		tweenLater(p, k * grow, grow * 0.6, {
			Size = Vector3.new(w, h, w),
			CFrame = CFrame.new(base) * rot * CFrame.new(0, h * 0.35, 0),
		}, Enum.EasingStyle.Back)
		tweenLater(p, dur * 0.75, dur * 0.25, { Transparency = 1 })
		Debris:AddItem(p, dur + 0.1)
	end
end

-- v16: kleine Kristalle auf Ohren und Schultern (`perch`), ein Glitzern.
local function frostPerch(ctx: Ctx, s: { [string]: any })
	local model = if s.at == "target" then ctx.targetModel else ctx.selfModel
	local center = at(ctx, s.at)
	local size = sizeAt(ctx, s.at)
	local spots: { Vector3 } = {}
	for _, name in { "ear_left", "ear_right" } do
		local ear = model and model:FindFirstChild(name, true)
		if ear and ear:IsA("BasePart") then
			table.insert(spots, ear.Position + Vector3.new(0, ear.Size.Y * 0.4, 0))
		end
	end
	if #spots == 0 then
		-- Rueckfall: Ohren oben links/rechts am Kopf schaetzen.
		local side = ctx.fwd:Cross(Vector3.yAxis)
		table.insert(spots, center + side * size.X * 0.28 + Vector3.new(0, size.Y * 0.48, 0))
		table.insert(spots, center - side * size.X * 0.28 + Vector3.new(0, size.Y * 0.48, 0))
	end
	local side = ctx.fwd:Cross(Vector3.yAxis)
	table.insert(spots, center + side * size.X * 0.42 + Vector3.new(0, size.Y * 0.05, 0))  -- Schultern
	table.insert(spots, center - side * size.X * 0.42 + Vector3.new(0, size.Y * 0.05, 0))
	local dur = s.dur or 1.4
	local per = math.max(1, math.floor(scaled(s.count, ctx.factor) / #spots + 0.5))
	for si, spot in spots do
		for j = 1, per do
			local rot = CFrame.Angles(math.random() - 0.5, math.random() * 6, math.random() - 0.5)
			local p = newPart(Enum.PartType.Block, Vector3.new(0.05, 0.05, 0.05), ctx.fx.color,
				CFrame.new(spot) * rot, 0.05)
			p.Material = Enum.Material.Ice
			local h = 0.35 + math.random() * 0.35
			tweenLater(p, (si + j) * 0.06, dur * 0.3, { Size = Vector3.new(0.14, h, 0.14) }, Enum.EasingStyle.Back)
			if s.glint and extrasOn(ctx) then
				-- EIN kurzes Aufleuchten der Kante (weiss, hin und zurueck), kein Flackern.
				TweenService:Create(p, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true,
					dur * 0.35 + si * 0.08), { Color = Color3.new(1, 1, 1) }):Play()
			end
			tweenLater(p, dur * 0.8, dur * 0.2, { Transparency = 1 })
			Debris:AddItem(p, dur + 0.1)
		end
	end
end

BLOCKS.frost = function(ctx, s)
	if s.legs then frostLegs(ctx, s) return end
	if s.perch then frostPerch(ctx, s) return end
	local pos = at(ctx, s.at)
	local n = scaled(s.count, ctx.factor)
	local dur = s.dur or 0.8
	for i = 1, n do
		local off = Vector3.new((math.random() - 0.5) * 3, (math.random() - 0.3) * 2.5, (math.random() - 0.5) * 3)
		local p = newPart(Enum.PartType.Block, Vector3.new(0.1, 0.1, 0.1), ctx.fx.color,
			CFrame.new(pos + off) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6), 0.1)
		p.Material = Enum.Material.Ice
		tween(p, dur * 0.3, { Size = Vector3.new(0.3, 1.2 + math.random(), 0.3) }, Enum.EasingStyle.Back)
		task.delay(dur * 0.7, function() if p.Parent then fadeAndDestroy(p, dur * 0.3) end end)
	end
end

BLOCKS.starfield = function(ctx, s)
	local center = ctx.arena
	local n = scaled(s.count, ctx.factor)
	local dur = s.dur or 3
	for i = 1, n do
		local a = math.random() * math.pi * 2
		local r = 10 + math.random() * 35
		local pos = center + Vector3.new(math.cos(a) * r, 18 + math.random() * 30, math.sin(a) * r)
		local col = if s.nebula then pickColor({ rainbow = false }, ctx.fx, i) else Color3.new(1, 1, 1)
		local p = newPart(Enum.PartType.Ball, Vector3.one * (0.2 + math.random() * 0.4), col, CFrame.new(pos), 1)
		tween(p, 0.4 + math.random() * 0.6, { Transparency = 0.1 })
		task.delay(dur * 0.75, function() if p.Parent then fadeAndDestroy(p, dur * 0.25) end end)
	end
end

--------------------------------------------------------------------------------
-- v16 (Gletscher-Show): Boden, Riss, Dornen, Atem, Schneefall. Wiederverwendbar
-- fuer jede Faehigkeit; Doku in SkillFXConfig ("BAUSTEINE").
--------------------------------------------------------------------------------

-- Ein flaches Teil auf dem Boden, das von `from` nach `to` waechst (Riss,
-- Adern). Kein Thread: Wachsen und Ausblenden sind verzoegerte Tweens.
local function groundStroke(ctx: Ctx, from: Vector3, to: Vector3, width: number, color: Color3,
	delaySeconds: number, growSeconds: number, fadeAt: number, texture: string?): BasePart?
	local len = (to - from).Magnitude
	if len &lt; 0.05 then return nil end
	local rot = CFrame.lookAt(from, to).Rotation
	local p = newPart(Enum.PartType.Block, Vector3.new(width, 0.04, 0.01), color, CFrame.new(from) * rot, 0)
	tweenLater(p, delaySeconds, growSeconds, {
		Size = Vector3.new(width, 0.04, len),
		CFrame = CFrame.new((from + to) / 2) * rot,
	}, Enum.EasingStyle.Linear)
	if texture then
		p.Transparency = 1
		local d = addDecal(p, texture, Enum.NormalId.Top, color)
		tweenLater(d, fadeAt, 0.4, { Transparency = 1 })
	else
		tweenLater(p, fadeAt, 0.4, { Transparency = 1 })
	end
	Debris:AddItem(p, fadeAt + 0.5)
	return p
end

-- breath: Atemwolke vor dem Maul. EIN Emitter, zwei Atemstoesse.
--   at, dur, count (Teilchen je Stoss)
BLOCKS.breath = function(ctx, s)
	local center = at(ctx, s.at)
	local size = sizeAt(ctx, s.at)
	local dir = if s.at == "target" then -ctx.fwd else ctx.fwd
	local mouth = center + dir * size.Z * 0.45 + Vector3.new(0, size.Y * 0.2, 0)
	local dur = s.dur or 1.0
	local anchor = newPart(Enum.PartType.Block, Vector3.one * 0.2, Color3.new(1, 1, 1), CFrame.lookAt(mouth, mouth + dir), 1)
	local em = Instance.new("ParticleEmitter")
	em.Texture = texOf(ctx, s.tex) or "rbxasset://textures/particles/smoke_main.dds"
	em.EmissionDirection = Enum.NormalId.Front
	em.Rate = 0
	em.Speed = NumberRange.new(1.5, 2.5)
	em.SpreadAngle = Vector2.new(18, 12)
	em.Drag = 2.5
	em.Lifetime = NumberRange.new(0.8, 1.1)
	em.Acceleration = Vector3.new(0, 0.6, 0)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1.6) })
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1) })
	em.Color = ColorSequence.new(Color3.new(1, 1, 1), ctx.fx.color)
	em.LightEmission = 0.2
	em.Rotation = NumberRange.new(0, 360)
	em.RotSpeed = NumberRange.new(-30, 30)
	em.Parent = anchor
	local n = scaled(s.count, ctx.factor)
	em:Emit(n)
	task.delay(dur * 0.5, function()
		if em.Parent then em:Emit(n) end
	end)
	Debris:AddItem(anchor, dur * 0.5 + 1.3)
end

-- groundmark: Boden friert in einem Kreis, Adern kriechen nach aussen.
--   at, radius, dur, veins (Zahl der Adern; Beiwerk), tex (Bodenbild)
BLOCKS.groundmark = function(ctx, s)
	local feet = groundAt(ctx, s.at) + Vector3.new(0, 0.06, 0)
	local r = s.radius or 6
	local dur = s.dur or 2
	local grow = dur * 0.3
	local disc = newPart(Enum.PartType.Cylinder, Vector3.new(0.05, 0.5, 0.5), ctx.fx.color,
		CFrame.new(feet) * CFrame.Angles(0, 0, math.rad(90)), 0.45)
	disc.Material = Enum.Material.Ice
	tween(disc, grow, { Size = Vector3.new(0.05, r * 1.2, r * 1.2) }, Enum.EasingStyle.Sine)
	local texture = texOf(ctx, s.tex)
	if texture then
		-- Mit Bodenbild: das Bild (auf einer flachen Platte) traegt Kreis UND
		-- Adern; die Eisscheibe bleibt als blasser Grund darunter.
		local plate = newPart(Enum.PartType.Block, Vector3.new(0.5, 0.05, 0.5), ctx.fx.color, CFrame.new(feet + Vector3.new(0, 0.03, 0)), 1)
		local d = addDecal(plate, texture, Enum.NormalId.Top)
		tween(plate, grow * 1.6, { Size = Vector3.new(r * 2, 0.05, r * 2) }, Enum.EasingStyle.Sine)
		tweenLater(d, dur * 0.8, dur * 0.2, { Transparency = 1 })
		tweenLater(disc, dur * 0.8, dur * 0.2, { Transparency = 1 })
		Debris:AddItem(plate, dur + 0.1)
	else
		tweenLater(disc, dur * 0.8, dur * 0.2, { Transparency = 1 })
		if extrasOn(ctx) then
			-- Rueckfall: Reif-Adern als duenne Neon-Striche, je Ader ein Ast.
			local n = scaled(s.veins or 6, ctx.factor)
			for i = 1, n do
				local a = (i / n) * math.pi * 2 + math.random() * 0.4
				local dir = Vector3.new(math.cos(a), 0, math.sin(a))
				local mainEnd = feet + dir * r * (0.75 + math.random() * 0.25)
				groundStroke(ctx, feet, mainEnd, 0.09, ctx.fx.color2, i * 0.03, grow * 1.4, dur * 0.8, nil)
				local fork = feet + dir * r * 0.45
				local turn = (if i % 2 == 0 then 1 else -1) * math.rad(35)
				local bdir = Vector3.new(math.cos(a + turn), 0, math.sin(a + turn))
				groundStroke(ctx, fork, fork + bdir * r * 0.35, 0.06, ctx.fx.color2, grow * 0.8, grow * 0.8, dur * 0.8, nil)
			end
		end
	end
	Debris:AddItem(disc, dur + 0.1)
end

-- crack: Zickzack-Riss am Boden von self zu target. Merkt sich die Linie in
-- ctx.path (fuer `spikes`).
--   dur (Wachsen), linger (sichtbar bis), segments, amp (Zickzack-Breite), width, tex
BLOCKS.crack = function(ctx, s)
	local from = ctx.selfFeet + ctx.fwd * ctx.selfSize.Z * 0.3 + Vector3.new(0, 0.07, 0)
	local to = ctx.targetFeet - ctx.fwd * ctx.targetSize.Z * 0.15 + Vector3.new(0, 0.07, 0)
	local k = s.segments or 7
	local amp = s.amp or 0.9
	local side = ctx.fwd:Cross(Vector3.yAxis)
	local pts: { Vector3 } = { from }
	for j = 1, k - 1 do
		local sign = if j % 2 == 0 then 1 else -1
		table.insert(pts, from:Lerp(to, j / k) + side * sign * amp * (0.6 + math.random() * 0.4))
	end
	table.insert(pts, to)
	ctx.path = pts
	local dur = s.dur or 0.5
	local linger = s.linger or (dur + 1)
	local step = dur / k
	local texture = texOf(ctx, s.tex)
	for j = 1, k do
		groundStroke(ctx, pts[j], pts[j + 1], s.width or 0.28, ctx.fx.color2, (j - 1) * step, step, linger, texture)
	end
end

-- spikes: schraege Eisdornen brechen nacheinander entlang ctx.path (oder der
-- Linie self -&gt; target) aus dem Boden, jeder hoeher als der vorige.
--   count, dur (vom ersten bis zum letzten Dorn), minHeight, maxHeight, linger, tex
BLOCKS.spikes = function(ctx, s)
	local pts = ctx.path or { ctx.selfFeet, ctx.targetFeet }
	-- Gesamtlaenge und Punkt bei Anteil k entlang der Linie
	local lens: { number } = {}
	local total = 0
	for j = 1, #pts - 1 do
		local l = (pts[j + 1] - pts[j]).Magnitude
		lens[j] = l
		total += l
	end
	local function pointAt(k: number): Vector3
		local want = total * k
		for j = 1, #pts - 1 do
			if want &lt;= lens[j] or j == #pts - 1 then
				return pts[j]:Lerp(pts[j + 1], math.clamp(want / math.max(lens[j], 0.001), 0, 1))
			end
			want -= lens[j]
		end
		return pts[#pts]
	end
	local n = math.max(4, scaled(s.count, ctx.factor))   -- Kernmoment: nie unter 4
	local dur = s.dur or 0.8
	local rise = s.rise or 0.18
	local linger = s.linger or (dur + 1)
	local lo, hi = s.minHeight or 1.0, s.maxHeight or 3.2
	local tilt = CFrame.lookAt(Vector3.zero, ctx.fwd).Rotation * CFrame.Angles(math.rad(-28), 0, 0)
	local texture = texOf(ctx, s.tex)
	local tips = extrasOn(ctx)
	for i = 1, n do
		local k = i / n
		local base = pointAt(0.2 + 0.8 * k)
		local h = lo + (hi - lo) * k
		local w = 0.55 + 0.35 * k
		local delaySeconds = (i - 1) * (dur / n)
		local rot = tilt * CFrame.Angles(0, math.random() * 0.6 - 0.3, 0)
		local spike = Instance.new("CornerWedgePart")
		spike.Size = Vector3.new(w, 0.05, w)
		prepPart(spike, if i % 2 == 0 then ctx.fx.color else ctx.fx.color:Lerp(Color3.fromRGB(40, 170, 180), 0.35), CFrame.new(base) * rot, 0.05)
		spike.Material = Enum.Material.Ice
		if texture then
			local d = addDecal(spike, texture, Enum.NormalId.Front)
			tweenLater(d, linger, 0.35, { Transparency = 1 })
		end
		tweenLater(spike, delaySeconds, rise, {
			Size = Vector3.new(w, h, w),
			CFrame = CFrame.new(base) * rot * CFrame.new(0, h / 2, 0),
		}, Enum.EasingStyle.Back)
		tweenLater(spike, linger, 0.35, { Transparency = 1 })
		Debris:AddItem(spike, linger + 0.45)
		if tips then
			-- Reines Weiss als scharfes Licht: jeder Dorn leuchtet nach dem
			-- Ausbrechen EINMAL kurz auf (laeuft als Welle mit, kein Flackern).
			TweenService:Create(spike, TweenInfo.new(0.16, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true,
				delaySeconds + rise * 0.8), { Color = Color3.new(1, 1, 1) }):Play()
		end
	end
end

-- snowfall: Nachgluehen. Leichter Reifschimmer um die Figur und einzelne
-- Schneeflocken, die langsam herabsinken. EIN Emitter.
--   at, count, dur, tex (Flocke)
BLOCKS.snowfall = function(ctx, s)
	local center = at(ctx, s.at)
	local size = sizeAt(ctx, s.at)
	local dur = s.dur or 1.2
	local top = center + Vector3.new(0, size.Y * 0.5 + (s.lift or 1.5), 0)
	local w = math.max(size.X, size.Z) * 1.6
	local anchor = newPart(Enum.PartType.Block, Vector3.new(w, 0.2, w), Color3.new(1, 1, 1), CFrame.new(top), 1)
	local em = Instance.new("ParticleEmitter")
	em.Texture = texOf(ctx, s.tex) or "rbxasset://textures/particles/sparkles_main.dds"
	em.Shape = Enum.ParticleEmitterShape.Box
	em.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	em.EmissionDirection = Enum.NormalId.Bottom
	em.Rate = 0
	em.Speed = NumberRange.new(0.6, 1.2)
	em.Acceleration = Vector3.new(0, -0.4, 0)
	em.Drag = 0.5
	em.Lifetime = NumberRange.new(dur * 0.8, dur * 1.2)
	em.Size = NumberSequence.new(s.size or 0.22)
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.7, 0.3), NumberSequenceKeypoint.new(1, 1) })
	em.Color = ColorSequence.new(Color3.new(1, 1, 1), ctx.fx.color)
	em.LightEmission = 0.5
	em.Rotation = NumberRange.new(0, 360)
	em.RotSpeed = NumberRange.new(-40, 40)
	em.Parent = anchor
	em:Emit(scaled(s.count, ctx.factor))
	Debris:AddItem(anchor, dur * 1.2 + 0.2)
	-- Reifschimmer: eine fast durchsichtige Huelle, blendet langsam aus.
	-- `noShell` (v16, z. B. rieselnde Federn): nur der Emitter.
	if s.noShell then return end
	local shell = newPart(Enum.PartType.Ball, size * 1.15, ctx.fx.color, CFrame.new(center), 0.82)
	shell.Material = Enum.Material.ForceField
	tweenLater(shell, dur * 0.4, dur * 0.6, { Transparency = 1 }, Enum.EasingStyle.Sine)
	Debris:AddItem(shell, dur + 0.1)
end

--------------------------------------------------------------------------------
-- v16 (Seraph-Show): Fluegel, Heiligenschein, Wabenmuster. Wiederverwendbar;
-- Doku in SkillFXConfig ("BAUSTEINE").
--------------------------------------------------------------------------------

-- Haelt Teile an einer Figur fest, waehrend sie sich bewegt (Wippen, Anlauf
-- zum Stoss). EINE RenderStepped-Verbindung pro Effekt, endet nach `seconds`
-- oder wenn die Figur weg ist. `place(center, k)` setzt die Teile.
local function followModel(model: Model?, fallback: Vector3, seconds: number, place: (Vector3, number) -&gt; ())
	local t0 = os.clock()
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		local k = os.clock() - t0
		if k &gt;= seconds then
			if conn then conn:Disconnect() end
			return
		end
		local c = centerOf(model) or fallback
		local ok = pcall(place, c, k)
		if not ok and conn then conn:Disconnect() end
	end)
end

-- wings: zwei Fluegel aus langen Lichtfedern entfalten sich hinter der Figur,
-- Feder fuer Feder von innen nach aussen; bei `foldAt` falten sie sich
-- zusammen und zerfallen in Funken (EIN Emitter).
--   at, count (Federn je Fluegel), span (Laenge), dur, foldAt, tex (Feder), sparkTex
BLOCKS.wings = function(ctx, s)
	local center = at(ctx, s.at)
	local size = sizeAt(ctx, s.at)
	local fwd = if s.at == "target" then -ctx.fwd else ctx.fwd
	local side = fwd:Cross(Vector3.yAxis)
	local n = math.max(4, scaled(s.count or 7, ctx.factor))
	local span = s.span or 2.6
	local dur = s.dur or 3
	local foldAt = s.foldAt or (dur - 0.4)
	local unfold = math.min(0.9, dur * 0.3)
	local texture = texOf(ctx, s.tex)
	for _, sgn in { 1, -1 } do
		local origin = center - fwd * size.Z * 0.3 + Vector3.new(0, size.Y * 0.18, 0) + side * sgn * size.X * 0.12
		for i = 1, n do
			local k = (i - 1) / math.max(1, n - 1)                  -- 0 = innen (oben), 1 = aussen (unten)
			local a = math.rad(18 + 92 * k)
			local dir = (Vector3.yAxis * math.cos(a) + side * sgn * math.sin(a) - fwd * 0.3).Unit
			local len = span * (1.05 - 0.35 * k)
			local p = newPart(Enum.PartType.Block, Vector3.new(0.34, 0.06, 0.05), if i % 2 == 0 then ctx.fx.color else ctx.fx.color2,
				CFrame.lookAt(origin, origin + dir, fwd), 0.25)
			if texture then
				p.Transparency = 1
				for _, face in { Enum.NormalId.Top, Enum.NormalId.Bottom } do
					local d = addDecal(p, texture, face, p.Color)
					tweenLater(d, foldAt, 0.35, { Transparency = 1 })
				end
			end
			tweenLater(p, k * unfold, 0.3, {
				Size = Vector3.new(0.34, 0.06, len),
				CFrame = CFrame.lookAt(origin + dir * len / 2, origin + dir * len, fwd),
			}, Enum.EasingStyle.Sine)
			-- zusammenfalten (aussen zuerst) und verblassen
			tweenLater(p, foldAt + (1 - k) * 0.12, 0.3, {
				Size = Vector3.new(0.34, 0.06, 0.05),
				CFrame = CFrame.lookAt(origin, origin + dir, fwd),
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tweenLater(p, foldAt, 0.42, { Transparency = 1 })
			Debris:AddItem(p, foldAt + 0.5)
		end
	end
	-- Funken beim Zerfallen (Beiwerk)
	if extrasOn(ctx) then
		local back = center - fwd * size.Z * 0.35 + Vector3.new(0, size.Y * 0.3, 0)
		local anchor = newPart(Enum.PartType.Block, Vector3.new(span * 2, span, 0.2), Color3.new(1, 1, 1),
			CFrame.lookAt(back, back + fwd), 1)
		local em = Instance.new("ParticleEmitter")
		em.Texture = texOf(ctx, s.sparkTex) or "rbxasset://textures/particles/sparkles_main.dds"
		em.Shape = Enum.ParticleEmitterShape.Box
		em.Rate = 0
		em.Speed = NumberRange.new(0.5, 1.5)
		em.SpreadAngle = Vector2.new(180, 180)
		em.Acceleration = Vector3.new(0, -1, 0)
		em.Drag = 1
		em.Lifetime = NumberRange.new(0.6, 1.0)
		em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
		em.Color = ColorSequence.new(ctx.fx.color2, ctx.fx.color)
		em.LightEmission = 1
		em.Parent = anchor
		task.delay(foldAt + 0.15, function()
			if em.Parent then em:Emit(scaled(s.sparks or 24, ctx.factor)) end
		end)
		Debris:AddItem(anchor, foldAt + 1.3)
	end
end

-- halo: Heiligenschein ueber dem Kopf, dreht sich langsam und bleibt an der
-- Figur. Ohne Bild: Perlen im Kreis; mit Bild: eine flache Scheibe.
--   at, radius, lift (ueber dem Kopf), count (Perlen), dur, tex
BLOCKS.halo = function(ctx, s)
	local model = if s.at == "target" then ctx.targetModel else ctx.selfModel
	local start = at(ctx, s.at)
	local size = sizeAt(ctx, s.at)
	local up = size.Y * 0.5 + (s.lift or 0.7)
	local r = s.radius or 0.9
	local dur = s.dur or 2.5
	local texture = texOf(ctx, s.tex)
	local parts: { BasePart } = {}
	if texture then
		local plate = newPart(Enum.PartType.Block, Vector3.new(r * 2.4, 0.05, r * 2.4), ctx.fx.color, CFrame.new(start + Vector3.new(0, up, 0)), 1)
		for _, face in { Enum.NormalId.Top, Enum.NormalId.Bottom } do
			local d = addDecal(plate, texture, face, ctx.fx.color)
			d.Transparency = 1
			tween(d, 0.4, { Transparency = 0 })
			tweenLater(d, dur - 0.4, 0.4, { Transparency = 1 })
		end
		table.insert(parts, plate)
	else
		local n = math.max(8, scaled(s.count or 14, ctx.factor))
		for i = 1, n do
			local p = newPart(Enum.PartType.Ball, Vector3.one * 0.26, if i % 4 == 0 then ctx.fx.color2 else ctx.fx.color,
				CFrame.new(start + Vector3.new(0, up, 0)), 1)
			tween(p, 0.4, { Transparency = 0.05 })
			tweenLater(p, dur - 0.4, 0.4, { Transparency = 1 })
			table.insert(parts, p)
		end
	end
	for _, p in parts do Debris:AddItem(p, dur + 0.1) end
	local n = #parts
	local cfs = table.create(n) :: { CFrame }
	followModel(model, start, dur, function(c, k)
		local spin = k * 0.8                    -- langsam: etwa eine Umdrehung in 8 s
		local mid = c + Vector3.new(0, up, 0)
		if texture then
			cfs[1] = CFrame.new(mid) * CFrame.Angles(0, spin, 0)
		else
			for i = 1, n do
				local a = spin + (i / n) * math.pi * 2
				cfs[i] = CFrame.new(mid + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
			end
		end
		workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end)
end

-- honeycomb: feines Wabenmuster laeuft von den Fuessen bis zum Kopf ueber die
-- Figur (`sweep`), zieht dann in sie ein (`pull`) und laesst einen warmen
-- Schein zurueck, der `hold` Sekunden an der Figur bleibt, auch wenn sie sich
-- bewegt (z. B. bis der HP-Balken die Heilung zeigt).
--   at, cols, rows, sweep, pull, hold, tex (Wabe)
BLOCKS.honeycomb = function(ctx, s)
	local model = if s.at == "target" then ctx.targetModel else ctx.selfModel
	local center = at(ctx, s.at)
	local feet = groundAt(ctx, s.at)
	local size = sizeAt(ctx, s.at)
	local radius = math.max(size.X, size.Z) * 0.58
	local cols = math.max(5, scaled(s.cols or 9, ctx.factor))
	local rows = math.max(4, scaled(s.rows or 6, ctx.factor))
	local sweep = s.sweep or 0.5
	local pull = s.pull or 0.35
	local hold = s.hold or 0.8
	local tile = math.min(0.7, (2 * math.pi * radius) / cols * 0.8)
	local texture = texOf(ctx, s.tex)
	for row = 1, rows do
		local y = (row - 0.5) / rows * size.Y
		local appear = (row - 1) / rows * sweep
		for col = 1, cols do
			-- jede zweite Reihe um eine halbe Wabe versetzt (Bienenwaben)
			local a = (col + (if row % 2 == 0 then 0.5 else 0)) / cols * math.pi * 2
			local out = Vector3.new(math.cos(a), 0, math.sin(a))
			local pos = feet + Vector3.new(0, y, 0) + out * radius
			local face = CFrame.lookAt(pos, pos + out)
			local p: BasePart
			if texture then
				p = newPart(Enum.PartType.Block, Vector3.new(0.05, 0.05, 0.04), ctx.fx.color, face, 1)
				local d = addDecal(p, texture, Enum.NormalId.Front, ctx.fx.color)  -- Front = -Z = nach aussen
				tweenLater(d, sweep + pull * 0.5, pull * 0.5, { Transparency = 1 })
			else
				-- Rueckfall: flache Neon-Scheibe (Zylinder-Achse zeigt nach aussen)
				p = newPart(Enum.PartType.Cylinder, Vector3.new(0.04, 0.05, 0.05), if (row + col) % 3 == 0 then ctx.fx.color2 else ctx.fx.color,
					face * CFrame.Angles(0, math.rad(90), 0), 0.2)
			end
			local full = if texture then Vector3.new(tile, tile, 0.04) else Vector3.new(0.04, tile, tile)
			tweenLater(p, appear, 0.12, { Size = full }, Enum.EasingStyle.Back)
			-- einziehen: zur Mitte der Figur, dabei klein werden
			local inPos = center + Vector3.new(0, y - size.Y * 0.5, 0) * 0.3
			tweenLater(p, sweep, pull, {
				CFrame = CFrame.new(inPos) * (p.CFrame - p.CFrame.Position),
				Size = if texture then Vector3.new(0.05, 0.05, 0.04) else Vector3.new(0.04, 0.05, 0.05),
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			if not texture then
				tweenLater(p, sweep + pull * 0.5, pull * 0.5, { Transparency = 1 })
			end
			Debris:AddItem(p, sweep + pull + 0.05)
		end
	end
	-- Der warme Schein bleibt an der Figur.
	task.delay(sweep + pull * 0.7, function()
		local now = centerOf(model) or center
		local glowPart = newPart(Enum.PartType.Ball, size * 1.25, ctx.fx.color, CFrame.new(now), 0.45)
		glowPart.Material = Enum.Material.ForceField
		tween(glowPart, 0.25, { Size = size * 0.95 }, Enum.EasingStyle.Quad)
		tweenLater(glowPart, hold * 0.55, hold * 0.45, { Transparency = 1 }, Enum.EasingStyle.Sine)
		Debris:AddItem(glowPart, hold + 0.1)
		followModel(model, now, hold, function(c)
			glowPart.CFrame = CFrame.new(c)
		end)
	end)
end

--------------------------------------------------------------------------------
-- v16 (Kometen-Show): Schattenkreis, Komet, Krater, Sternstaub.
-- Doku in SkillFXConfig ("BAUSTEINE").
--------------------------------------------------------------------------------

-- shadow: dunkler Kreis am Boden, waechst beschleunigt (wie etwas, das von
-- oben naeherkommt). Mit `toArena` wandert seine Mitte zur Arena-Mitte, damit
-- er bei radius = "tower" genau die Turmspitze bedeckt.
--   at, from (Startradius), radius (Zahl | "tower" | "fence"), dur, fadeOut, toArena
BLOCKS.shadow = function(ctx, s)
	local start = groundAt(ctx, s.at) + Vector3.new(0, 0.05, 0)
	local finish = if s.toArena then groundAt(ctx, "arena") + Vector3.new(0, 0.05, 0) else start
	local r0 = s.from or 1.5
	local r1 = radiusOf(s.radius, 8)
	local dur = s.dur or 2
	local fadeOut = s.fadeOut or 0.3
	local disc = newPart(Enum.PartType.Cylinder, Vector3.new(0.05, r0 * 2, r0 * 2), Color3.fromRGB(12, 10, 30),
		CFrame.new(start) * CFrame.Angles(0, 0, math.rad(90)), 0.7)
	disc.Material = Enum.Material.SmoothPlastic
	tween(disc, dur, {
		Size = Vector3.new(0.05, r1 * 2, r1 * 2),
		CFrame = CFrame.new(finish) * CFrame.Angles(0, 0, math.rad(90)),
		Transparency = 0.35,
	}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	-- verschwindet im Einschlag (Transparenz-Tween ersetzt den obigen erst
	-- nach dessen Ende: gleiche Eigenschaft, spaeter gestartet)
	task.delay(dur, function()
		if disc.Parent then tween(disc, fadeOut, { Transparency = 1 }) end
	end)
	Debris:AddItem(disc, dur + fadeOut + 0.1)
end

-- comet: ein Punkt funkelt hoch ueber dem Gegner und wird groesser
-- (`charge` s), dann faellt der Komet mit gluehendem Kopf, weissem Kern und
-- langem Schweif auf den Gegner (`fall` s; die letzten 30 % langsamer =
-- Zeitlupe). Funken loesen sich vom Schweif (EIN Emitter). Bricht er durch
-- die Wolkendecke (`cloudY` Studs ueber dem Gegner), stieben Wolkenfetzen.
-- Der Kopf steht in ctx.cometHead (Kamera "chase").
-- EINE RenderStepped-Verbindung fuer den ganzen Kometen.
--   height, size, charge, fall, cloudY, tex (Glut), tailTex (Schweif)
BLOCKS.comet = function(ctx, s)
	local to = ctx.targetPos
	local h = s.height or 80
	local size = s.size or 3
	local charge = s.charge or 0
	local fall = s.fall or 0.8
	local side = ctx.fwd:Cross(Vector3.yAxis)
	local from = to - ctx.fwd * h * 0.4 + side * h * 0.2 + Vector3.new(0, h, 0)
	local slowAt = to + (from - to) * 0.18     -- ab hier Zeitlupe
	local dir = (to - from).Unit

	local head = newPart(Enum.PartType.Ball, Vector3.one * 0.3, ctx.fx.color, CFrame.lookAt(from, from + dir), 0)
	local core = newPart(Enum.PartType.Ball, Vector3.one * 0.15, Color3.new(1, 1, 1), CFrame.new(from), 0)
	local glowTex = texOf(ctx, s.tex)
	local halo: BasePart? = nil
	if glowTex then
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromScale(size * 3.2, size * 3.2)
		bb.LightInfluence = 0
		bb.AlwaysOnTop = false
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromScale(1, 1)
		img.Image = glowTex
		img.ImageColor3 = ctx.fx.color
		img.Parent = bb
		bb.Parent = head
	else
		halo = newPart(Enum.PartType.Ball, Vector3.one * 0.6, ctx.fx.color, CFrame.new(from), 0.65)
	end
	ctx.cometHead = head

	-- Schweif
	local a0 = Instance.new("Attachment"); a0.Position = Vector3.new(0, size * 0.45, 0); a0.Parent = head
	local a1 = Instance.new("Attachment"); a1.Position = Vector3.new(0, -size * 0.45, 0); a1.Parent = head
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.5
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(0.25, ctx.fx.color),
		ColorSequenceKeypoint.new(1, ctx.fx.color2),
	})
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.15) })
	local tailTex = texOf(ctx, s.tailTex)
	if tailTex then
		trail.Texture = tailTex
		trail.TextureMode = Enum.TextureMode.Stretch
	end
	trail.Enabled = false
	trail.Parent = head

	-- Funken vom Schweif (ein Emitter, Rate erst im Fall)
	local em = Instance.new("ParticleEmitter")
	em.Texture = texOf(ctx, s.sparkTex) or "rbxasset://textures/particles/sparkles_main.dds"
	em.EmissionDirection = Enum.NormalId.Back
	em.Rate = 0
	em.Speed = NumberRange.new(2, 6)
	em.SpreadAngle = Vector2.new(25, 25)
	em.Lifetime = NumberRange.new(0.3, 0.6)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.18), NumberSequenceKeypoint.new(1, 0) })
	em.Color = ColorSequence.new(ctx.fx.color, ctx.fx.color2)
	em.LightEmission = 1
	em.Parent = head

	local parts: { BasePart } = { head, core }
	if halo then table.insert(parts, halo) end
	local cfs = table.create(#parts) :: { CFrame }
	local cloudY = s.cloudY
	local cloudDone = cloudY == nil or not extrasOn(ctx)
	local t0 = os.clock()
	local total = charge + fall
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local pos: Vector3
		local sz: number
		if t &lt; charge then
			-- Funkeln: waechst, Helligkeit pulsiert 2x pro Sekunde (unter 3/s)
			local k = t / charge
			pos = from
			sz = 0.3 + (size * 0.55 - 0.3) * k * k
			head.Transparency = 0.1 + 0.3 * (0.5 + 0.5 * math.sin(t * math.pi * 4))
		else
			local k = math.clamp((t - charge) / fall, 0, 1)
			if not trail.Enabled then
				trail.Enabled = true
				head.Transparency = 0
				em.Rate = 45 * ctx.factor
			end
			if k &lt; 0.7 then
				local q = k / 0.7
				pos = from:Lerp(slowAt, q * q)
			else
				pos = slowAt:Lerp(to, (k - 0.7) / 0.3)
			end
			sz = size * (0.55 + 0.45 * math.min(1, k * 1.5))
			if not cloudDone and pos.Y &lt;= to.Y + cloudY then
				cloudDone = true
				-- Wolkenfetzen stieben auseinander (Beiwerk)
				for i = 1, 6 do
					local a = i / 6 * math.pi * 2
					local out = Vector3.new(math.cos(a), 0.15, math.sin(a))
					local puff = newPart(Enum.PartType.Ball, Vector3.one * 3, Color3.fromRGB(200, 205, 230), CFrame.new(pos), 0.45)
					puff.Material = Enum.Material.SmoothPlastic
					tween(puff, 0.7, { CFrame = CFrame.new(pos + out * 7), Size = Vector3.one * 5, Transparency = 1 })
					Debris:AddItem(puff, 0.8)
				end
			end
		end
		cfs[1] = CFrame.lookAt(pos, pos + dir)
		cfs[2] = CFrame.new(pos)
		if halo then cfs[3] = CFrame.new(pos) end
		workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
		head.Size = Vector3.one * sz
		core.Size = Vector3.one * sz * 0.5
		if halo then halo.Size = Vector3.one * sz * 2 end
		if t &gt;= total or not head.Parent then
			if conn then conn:Disconnect() end
			em.Rate = 0
			trail.Enabled = false
			if ctx.cometHead == head then ctx.cometHead = nil end
			for _, p in parts do
				if p.Parent then fadeAndDestroy(p, 0.08) end
			end
		end
	end)
	Debris:AddItem(head, total + 1)
	Debris:AddItem(core, total + 1)
	if halo then Debris:AddItem(halo, total + 1) end
end

-- crater: im Boden gluehen strahlenfoermige Risse auf (Orange), kuehlen
-- langsam nach Violett ab und verblassen; dunkle Brandflaeche darunter.
--   at, radius, count (Risse), dur, tex (Krater-Bild)
BLOCKS.crater = function(ctx, s)
	local feet = groundAt(ctx, s.at) + Vector3.new(0, 0.07, 0)
	local r = radiusOf(s.radius, 6)
	local dur = s.dur or 2
	local fadeAt = math.max(0.2, dur - 0.45)
	local scorch = newPart(Enum.PartType.Cylinder, Vector3.new(0.05, 0.5, 0.5), Color3.fromRGB(28, 18, 36),
		CFrame.new(feet - Vector3.new(0, 0.02, 0)) * CFrame.Angles(0, 0, math.rad(90)), 0.25)
	scorch.Material = Enum.Material.SmoothPlastic
	tween(scorch, 0.15, { Size = Vector3.new(0.05, r * 1.1, r * 1.1) })
	tweenLater(scorch, fadeAt, 0.45, { Transparency = 1 })
	Debris:AddItem(scorch, dur + 0.1)
	local texture = texOf(ctx, s.tex)
	if texture then
		local plate = newPart(Enum.PartType.Block, Vector3.new(r * 2, 0.05, r * 2), ctx.fx.color, CFrame.new(feet), 1)
		local d = addDecal(plate, texture, Enum.NormalId.Top, ctx.fx.color)
		tweenLater(d, 0.2, dur * 0.6, { Color3 = ctx.fx.color2 }, Enum.EasingStyle.Sine)
		tweenLater(d, fadeAt, 0.45, { Transparency = 1 })
		Debris:AddItem(plate, dur + 0.1)
		return
	end
	-- Rueckfall: Risse als Neon-Striche mit einem Knick.
	local n = math.max(6, scaled(s.count or 10, ctx.factor))
	for i = 1, n do
		local a = (i / n) * math.pi * 2 + (math.random() - 0.5) * 0.3
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local bend = Vector3.new(math.cos(a + 0.35), 0, math.sin(a + 0.35))
		local len = r * (0.6 + math.random() * 0.4)
		local knee = feet + dir * len * 0.55
		local tip = knee + bend * len * 0.45
		local inner = groundStroke(ctx, feet + dir * 0.4, knee, 0.3, ctx.fx.color, 0, 0.12, fadeAt, nil)
		local outer = groundStroke(ctx, knee, tip, 0.18, ctx.fx.color, 0.1, 0.12, fadeAt, nil)
		for _, p in { inner, outer } do
			-- Glut kuehlt ab: Orange -&gt; Violett
			if p then tweenLater(p, 0.25, dur * 0.6, { Color = ctx.fx.color2 }, Enum.EasingStyle.Sine) end
		end
	end
end

-- dust: Sternstaub fliegt im Bogen nach aussen (Schwerkraft am Emitter).
-- EIN Emitter, ein Stoss.
--   at, count, speed, dur, tex
BLOCKS.dust = function(ctx, s)
	local pos = at(ctx, s.at)
	local dur = s.dur or 1.0
	local anchor = newPart(Enum.PartType.Block, Vector3.one * 0.5, Color3.new(1, 1, 1), CFrame.new(pos), 1)
	local em = Instance.new("ParticleEmitter")
	em.Texture = texOf(ctx, s.tex) or "rbxasset://textures/particles/sparkles_main.dds"
	em.EmissionDirection = Enum.NormalId.Top
	em.Rate = 0
	em.SpreadAngle = Vector2.new(65, 65)
	local sp = s.speed or 14
	em.Speed = NumberRange.new(sp * 0.6, sp)
	em.Acceleration = Vector3.new(0, -sp * 1.8, 0)
	em.Lifetime = NumberRange.new(dur * 0.7, dur)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	em.Color = ColorSequence.new(Color3.new(1, 1, 1), ctx.fx.color2)
	em.LightEmission = 1
	em.Rotation = NumberRange.new(0, 360)
	em.Parent = anchor
	em:Emit(scaled(s.count, ctx.factor))
	Debris:AddItem(anchor, dur + 0.2)
end

--------------------------------------------------------------------------------
-- v16 (Schemen-Show): Tinten-Klone des Baerchis, Verblassen, Stille, Schnitt.
-- Doku in SkillFXConfig ("BAUSTEINE").
--------------------------------------------------------------------------------

-- Was an einem Klon nichts zu suchen hat (Aussehen, Leben, Ton, Licht).
local CLONE_STRIP: { [string]: boolean } = {
	Decal = true, Texture = true, SurfaceAppearance = true, BillboardGui = true, SurfaceGui = true,
	Script = true, LocalScript = true, ModuleScript = true, Sound = true, ParticleEmitter = true,
	PointLight = true, SpotLight = true, SurfaceLight = true, Highlight = true, Humanoid = true,
	Fire = true, Smoke = true, Sparkles = true, Trail = true, Beam = true,
	Weld = true, WeldConstraint = true, Motor6D = true,
}

-- Ein tintenschwarzer Klon der Figur (lokal, nur auf diesem Rechner). Ohne
-- klonbares Modell: ein einfacher Kugel-Baerchi in derselben Groesse.
-- `feet` + `fwd` geben die Lage vor; `flat` (0..1) staucht die Tiefe
-- (flache Silhouette). Rueckgabe: Modell und Pivot relativ zu den Fuessen.
local function inkBear(source: Model?, size: Vector3, color: Color3, transparency: number,
	feet: Vector3, fwd: Vector3, flat: number?): (Model, CFrame)
	local frame = CFrame.lookAt(feet, feet + fwd)
	local m: Model? = nil
	if source and source.Parent then
		local ok, c = pcall(function() return (source :: Model):Clone() end)
		if ok and c then m = c end
	end
	if m then
		for _, d in m:GetDescendants() do
			if CLONE_STRIP[d.ClassName] then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				d.CastShadow = false
				d.Material = Enum.Material.SmoothPlastic
				d.Color = color
				d.Transparency = transparency
				d.LocalTransparencyModifier = 0
				if d:IsA("MeshPart") then
					pcall(function() (d :: any).TextureID = "" end)
				end
			end
		end
	else
		-- Rueckfall: Koerper, Kopf, zwei Ohren
		local bear = Instance.new("Model")
		local function ball(d: number, off: Vector3)
			local p = Instance.new("Part")
			p.Shape = Enum.PartType.Ball
			p.Size = Vector3.one * d
			prepPart(p, color, frame * CFrame.new(off), transparency)
			p.Material = Enum.Material.SmoothPlastic
			p.Parent = bear
		end
		ball(size.X * 0.8, Vector3.new(0, size.Y * 0.32, 0))
		ball(size.X * 0.55, Vector3.new(0, size.Y * 0.74, 0))
		ball(size.X * 0.2, Vector3.new(size.X * 0.2, size.Y * 0.95, 0))
		ball(size.X * 0.2, Vector3.new(-size.X * 0.2, size.Y * 0.95, 0))
		bear.WorldPivot = frame
		m = bear
	end
	local model = m :: Model
	if flat and flat &lt; 1 then
		-- Tiefe (entlang der Blickrichtung) stauchen: Positionen und die
		-- Teil-Achse, die am ehesten nach vorn zeigt.
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				local rel = frame:ToObjectSpace(d.CFrame)
				d.CFrame = frame * (CFrame.new(rel.X, rel.Y, rel.Z * flat) * rel.Rotation)
				local look = frame.LookVector
				local ax = math.abs(d.CFrame.RightVector:Dot(look))
				local ay = math.abs(d.CFrame.UpVector:Dot(look))
				local az = math.abs(d.CFrame.LookVector:Dot(look))
				local sz = d.Size
				if ax &gt;= ay and ax &gt;= az then
					d.Size = Vector3.new(math.max(0.05, sz.X * flat), sz.Y, sz.Z)
				elseif ay &gt;= az then
					d.Size = Vector3.new(sz.X, math.max(0.05, sz.Y * flat), sz.Z)
				else
					d.Size = Vector3.new(sz.X, sz.Y, math.max(0.05, sz.Z * flat))
				end
			end
		end
	end
	model.Name = "SkillFXInk"
	model.Parent = folder()
	return model, frame:ToObjectSpace(model:GetPivot())
end

local function fadeModel(model: Model, delaySeconds: number, seconds: number)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			tweenLater(d, delaySeconds, seconds, { Transparency = 1 }, Enum.EasingStyle.Sine)
		elseif d:IsA("Decal") then
			tweenLater(d, delaySeconds, seconds, { Transparency = 1 }, Enum.EasingStyle.Sine)
		end
	end
	Debris:AddItem(model, delaySeconds + seconds + 0.1)
end

-- Rauch-Emitter (EIN Emitter pro Effekt); `puff(pos, n)` stoesst an pos aus.
local function smokeAt(ctx: Ctx, texKey: string?, life: number): (Vector3, number) -&gt; ()
	local anchor = newPart(Enum.PartType.Block, Vector3.one * 0.3, Color3.new(), CFrame.new(ctx.selfPos), 1)
	local em = Instance.new("ParticleEmitter")
	em.Texture = texOf(ctx, texKey) or "rbxasset://textures/particles/smoke_main.dds"
	em.Rate = 0
	em.EmissionDirection = Enum.NormalId.Top
	em.Speed = NumberRange.new(0.6, 1.6)
	em.SpreadAngle = Vector2.new(60, 60)
	em.Drag = 1.5
	em.Lifetime = NumberRange.new(0.6, 1.0)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 2.2) })
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	em.Color = ColorSequence.new(ctx.fx.color, ctx.fx.color2)
	em.LightEmission = 0
	em.Rotation = NumberRange.new(0, 360)
	em.RotSpeed = NumberRange.new(-25, 25)
	em.Parent = anchor
	Debris:AddItem(anchor, life + 1.2)
	local on = extrasOn(ctx)
	return function(pos: Vector3, n: number)
		if not on or not anchor.Parent then return end
		anchor.CFrame = CFrame.new(pos)
		em:Emit(scaled(n, ctx.factor))
	end
end

-- silhouette: der Schatten der Figur loest sich vom Boden und richtet sich
-- als flache, tintenschwarze Silhouette hinter ihr auf; zerfaellt dann in Rauch.
--   at, behind, rise, hold, dissolve, tex (Silhouette), smokeTex
BLOCKS.silhouette = function(ctx, s)
	local size = sizeAt(ctx, s.at)
	local fwd = if s.at == "target" then -ctx.fwd else ctx.fwd
	local feet = groundAt(ctx, s.at) - fwd * (s.behind or 1.4)
	local rise = s.rise or 1.0
	local hold = s.hold or 0.4
	local dissolve = s.dissolve or 0.4
	local model: Model
	local offset: CFrame
	local texture = texOf(ctx, s.tex)
	if texture then
		-- Bild-Silhouette: flache Platte mit dem Umriss (vorn und hinten).
		model = Instance.new("Model")
		local frame = CFrame.lookAt(feet, feet + fwd)
		local plate = Instance.new("Part")
		plate.Size = Vector3.new(size.X * 1.3, size.Y * 1.3, 0.05)
		prepPart(plate, ctx.fx.color, frame * CFrame.new(0, size.Y * 0.65, 0), 1)
		plate.Parent = model
		addDecal(plate, texture, Enum.NormalId.Front, ctx.fx.color)
		addDecal(plate, texture, Enum.NormalId.Back, ctx.fx.color)
		model.WorldPivot = frame
		model.Parent = folder()
		offset = CFrame.new()
	else
		model, offset = inkBear(if s.at == "target" then ctx.targetModel else ctx.selfModel, size,
			ctx.fx.color, 0.08, feet, fwd, 0.12)
	end
	local footFrame = CFrame.lookAt(feet, feet + fwd)
	-- liegt zuerst flach nach hinten auf dem Boden (wie ein Schatten)
	model:PivotTo(footFrame * CFrame.Angles(math.rad(90), 0, 0) * offset)
	local t0 = os.clock()
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		local k = math.clamp((os.clock() - t0) / rise, 0, 1)
		local e = 1 - (1 - k) ^ 3
		if model.Parent then
			model:PivotTo(footFrame * CFrame.Angles(math.rad(90) * (1 - e), 0, 0) * offset)
		end
		if k &gt;= 1 or not model.Parent then
			if conn then conn:Disconnect() end
		end
	end)
	fadeModel(model, rise + hold, dissolve)
	local puff = smokeAt(ctx, s.smokeTex, rise + hold + dissolve)
	task.delay(rise + hold, function()
		puff(feet + Vector3.new(0, size.Y * 0.5, 0), 14)
	end)
end

-- shades: dunkle Pfuetzen rund um die Figur, aus jeder steigt gleichzeitig
-- ein Schatten-Baerchi aus Rauch (Tinten-Klon), der sie anschaut; nach
-- `fadeAt` loesen sie sich auf. EINE Verbindung fuer alle, EIN Emitter.
--   at, count, distance, pool, rise, fadeAt, dissolve, tex (Pfuetze), smokeTex
BLOCKS.shades = function(ctx, s)
	local center = groundAt(ctx, s.at)
	local size = ctx.selfSize                              -- Klone des eigenen Baerchis
	local n = s.count or 3
	local dist = s.distance or 3.4
	local poolR = s.pool or 1.7
	local rise = s.rise or 0.5
	local fadeAt = s.fadeAt or 1.2
	local dissolve = s.dissolve or 0.35
	local poolTex = texOf(ctx, s.tex)
	local puff = smokeAt(ctx, s.smokeTex, fadeAt + dissolve)
	local models: { Model } = {}
	local finals: { CFrame } = {}
	local offsets: { CFrame } = {}
	local spin = math.random() * math.pi * 2
	for i = 1, n do
		local a = spin + (i / n) * math.pi * 2
		local spot = center + Vector3.new(math.cos(a) * dist, 0, math.sin(a) * dist)
		-- Pfuetze
		local pool: BasePart
		if poolTex then
			pool = newPart(Enum.PartType.Block, Vector3.new(0.1, 0.04, 0.1), ctx.fx.color, CFrame.new(spot + Vector3.new(0, 0.05, 0)), 1)
			local d = addDecal(pool, poolTex, Enum.NormalId.Top, ctx.fx.color)
			tweenLater(d, fadeAt, dissolve, { Transparency = 1 })
			tween(pool, 0.15, { Size = Vector3.new(poolR * 2, 0.04, poolR * 2) })
		else
			pool = newPart(Enum.PartType.Cylinder, Vector3.new(0.04, 0.1, 0.1), ctx.fx.color,
				CFrame.new(spot + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90)), 0.15)
			pool.Material = Enum.Material.SmoothPlastic
			tween(pool, 0.15, { Size = Vector3.new(0.04, poolR * 2, poolR * 2) })
			tweenLater(pool, fadeAt, dissolve, { Transparency = 1 })
		end
		Debris:AddItem(pool, fadeAt + dissolve + 0.1)
		-- Schatten-Baerchi, blickt zur Mitte
		local look = (center - spot)
		local fwd = if look.Magnitude &gt; 0.1 then Vector3.new(look.X, 0, look.Z).Unit else ctx.fwd
		local m, off = inkBear(ctx.selfModel, size, ctx.fx.color, 0.25, spot, fwd, nil)
		local final = CFrame.lookAt(spot, spot + fwd)
		m:PivotTo(final * CFrame.new(0, -size.Y * 1.1, 0) * off)   -- noch unter dem Boden
		table.insert(models, m)
		table.insert(finals, final)
		table.insert(offsets, off)
		fadeModel(m, fadeAt, dissolve)
	end
	local t0 = os.clock()
	local start = 0.15                                     -- erst die Pfuetzen
	local puffed = false
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0 - start
		if t &lt; 0 then return end
		if not puffed then
			puffed = true
			for i = 1, #models do puff(finals[i].Position, 6) end
		end
		local k = math.clamp(t / rise, 0, 1)
		local e = 1 - (1 - k) ^ 2
		for i, m in models do
			if m.Parent then
				m:PivotTo(finals[i] * CFrame.new(0, -size.Y * 1.1 * (1 - e), 0) * offsets[i])
			end
		end
		if k &gt;= 1 then
			if conn then conn:Disconnect() end
		end
	end)
	task.delay(fadeAt, function()
		for i = 1, #models do puff(finals[i].Position + Vector3.new(0, size.Y * 0.5, 0), 8) end
	end)
end

-- vanish: die Figur wird blasser bis fast durchsichtig (LocalTransparency-
-- Modifier: nur auf diesem Rechner, nie zum Server repliziert) und steht bei
-- `back` Sekunden schlagartig wieder voll da. EINE Verbindung.
--   at, to (0..1), fadeIn, back
BLOCKS.vanish = function(ctx, s)
	local model = if s.at == "target" then ctx.targetModel else ctx.selfModel
	if not model then return end
	local goal = s.to or 0.85
	local fadeIn = s.fadeIn or 1.0
	local back = s.back or 2.0
	local parts: { BasePart } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then table.insert(parts, d) end
	end
	local function set(v: number)
		for _, p in parts do
			if p.Parent then p.LocalTransparencyModifier = v end
		end
	end
	local t0 = os.clock()
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t &gt;= back or not model.Parent then
			if conn then conn:Disconnect() end
			set(0)                                         -- als waere er nie weg gewesen
			return
		end
		set(goal * math.clamp(t / fadeIn, 0, 1))
	end)
end

-- cut: ein einziger duenner, weisser Schnitt quer durch das Bild (jeder Client
-- richtet ihn an SEINER Kamera aus) durch den Gegner. Er bleibt `tearAt` s
-- stehen, dann reisst er auf: zwei Raender weichen auseinander, dazwischen
-- dunkles Violett.
--   at, length, width, draw, tearAt, tex (ausgefranste Schnittlinie)
-- Farbe des Schnitts, wenn der Finisher-Bonus gegriffen hat (helles Violett,
-- hebt sich vom Tintenschwarz der Show ab).
local BONUS_VIOLET = Color3.fromRGB(175, 115, 255)

BLOCKS.cut = function(ctx, s)
	local cam = workspace.CurrentCamera
	local pos = at(ctx, s.at or "target") + Vector3.new(0, 0.3, 0)
	local view = if cam then cam.CFrame else CFrame.lookAt(pos + Vector3.new(0, 4, 12), pos)
	local tilt = math.rad(s.angle or 18)
	local dir = (view.RightVector * math.cos(tilt) + view.UpVector * math.sin(tilt)).Unit
	local across = view.LookVector:Cross(dir).Unit             -- quer zur Linie, im Bild
	local len = s.length or 20
	local w = s.width or 0.12
	local draw = s.draw or 0.08
	local tearAt = s.tearAt or 0.4
	local fromPt = pos - dir * len / 2
	-- Y der Linie zeigt zur Kamera: die sichtbare Breite ist X
	local function frame(c: Vector3): CFrame
		return CFrame.lookAt(c, c + dir, view.LookVector)
	end
	local texture = texOf(ctx, s.tex)
	local line = newPart(Enum.PartType.Block, Vector3.new(w, 0.02, 0.05), Color3.new(1, 1, 1), frame(fromPt), if texture then 1 else 0)
	if texture then
		addDecal(line, texture, Enum.NormalId.Top)
		addDecal(line, texture, Enum.NormalId.Bottom)
	end
	tween(line, draw, { Size = Vector3.new(w, 0.02, len), CFrame = frame(pos) }, Enum.EasingStyle.Linear)
	Debris:AddItem(line, tearAt + 0.6)
	-- Finisher-Bonus (ctx.bonus): der Schnitt reisst violett auf statt weiss.
	local edgeColor = if ctx.bonus then (s.bonusColor or BONUS_VIOLET) else Color3.new(1, 1, 1)
	task.delay(tearAt, function()
		if not line.Parent then return end
		if ctx.bonus then line.Color = edgeColor end
		-- dunkler Spalt in der Mitte
		tween(line, 0.3, { Size = Vector3.new(w * 6, 0.02, len), Color = ctx.fx.color2, Transparency = 1 })
		for _, d in line:GetChildren() do
			if d:IsA("Decal") then tween(d, 0.2, { Transparency = 1 }) end
		end
		-- zwei weisse Raender weichen auseinander
		for _, sgn in { 1, -1 } do
			local edge = newPart(Enum.PartType.Block, Vector3.new(w * 0.6, 0.02, len), edgeColor, frame(pos), 0)
			tween(edge, 0.35, { CFrame = frame(pos + across * sgn * 0.9), Transparency = 1, Size = Vector3.new(w * 0.3, 0.02, len * 0.85) },
				Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			Debris:AddItem(edge, 0.45)
		end
	end)
end

--------------------------------------------------------------------------------
-- v16 (Omega-Show): Omega-Zeichen, Lichtpunkte aus vier Richtungen.
-- Doku in SkillFXConfig ("BAUSTEINE").
--------------------------------------------------------------------------------

-- Punkte eines Omega (Kreisbogen mit Luecke unten + zwei Fuesse) in der
-- Ebene (u, v) um c. Rueckgabe: Liste von Strecken {a, b}.
local function omegaStrokes(c: Vector3, u: Vector3, v: Vector3, r: number, n: number): { { Vector3 } }
	local out: { { Vector3 } } = {}
	local t0, t1 = math.rad(-48), math.rad(228)
	local prev = c + u * math.cos(t0) * r + v * math.sin(t0) * r
	local first = prev
	for i = 1, n do
		local t = t0 + (t1 - t0) * i / n
		local p = c + u * math.cos(t) * r + v * math.sin(t) * r
		table.insert(out, { prev, p })
		prev = p
	end
	-- Fuesse: von den Bogen-Enden waagerecht nach aussen
	table.insert(out, { first, first + u * r * 0.55 })
	table.insert(out, { prev, prev - u * r * 0.55 })
	return out
end

-- omega: ein leuchtendes Omega (Ω), Strich fuer Strich gezeichnet.
--   sky   : hoch ueber der Arena (`lift`), zur Kamera DIESES Clients gedreht;
--           bei `pullAt` zieht es sich mit einem Ruck auf die Pfote des
--           Baerchis zusammen (`jerk` s) und endet in einem weissen Punkt.
--   brand : flach auf dem Boden unter `at` eingebrannt, gluehend weiss -&gt;
--           Zweitfarbe, verblasst langsam (`fade` s ab `burnFor`).
--   mode ("sky"|"brand"), at, radius, lift, segments, draw, pullAt, jerk, burnFor, fade, width, tex
BLOCKS.omega = function(ctx, s)
	local mode = s.mode or "sky"
	local r = s.radius or 6
	local n = math.max(10, scaled(s.segments or 18, ctx.factor))
	local draw = s.draw or 0.8
	local w = s.width or r * 0.12
	local th = if mode == "brand" then 0.04 else w          -- Brandzeichen: flach
	local center: Vector3
	local u: Vector3
	local v: Vector3
	if mode == "brand" then
		center = groundAt(ctx, s.at or "target") + Vector3.new(0, 0.08, 0)
		u = ctx.fwd:Cross(Vector3.yAxis)
		v = ctx.fwd
	else
		center = at(ctx, s.at or "arena") + Vector3.new(0, s.lift or 34, 0)
		local cam = workspace.CurrentCamera
		local look = if cam then cam.CFrame.LookVector else ctx.fwd
		local flatLook = Vector3.new(look.X, 0, look.Z)
		local f = if flatLook.Magnitude &gt; 0.05 then flatLook.Unit else ctx.fwd
		u = f:Cross(Vector3.yAxis)            -- waagerecht, quer zum Blick
		v = Vector3.yAxis
	end
	local normal = u:Cross(v)
	local col = pickColor(s, ctx.fx)
	local parts: { BasePart } = {}
	local texture = texOf(ctx, s.tex)
	if texture then
		-- Mit Bild: EINE Platte mit dem Omega (beidseitig). Beim Brandzeichen
		-- liegt sie flach (u, v waagerecht), sonst steht sie senkrecht.
		local plate = newPart(Enum.PartType.Block, Vector3.new(0.05, 0.05, 0.05), col,
			CFrame.fromMatrix(center, u, v), 1)
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local d = addDecal(plate, texture, face, col)
			if mode == "brand" then
				tweenLater(d, s.burnFor or 0.4, s.fade or 1.5, { Transparency = 1 }, Enum.EasingStyle.Sine)
			end
		end
		tween(plate, draw, { Size = Vector3.new(r * 2.7, r * 2.7, 0.05) }, Enum.EasingStyle.Sine)
		table.insert(parts, plate)
	else
		for i, seg in omegaStrokes(center, u, v, r, n) do
			local a, b = seg[1], seg[2]
			local len = (b - a).Magnitude
			local rot = CFrame.lookAt(a, b, normal).Rotation
			local p = newPart(Enum.PartType.Block, Vector3.new(w, th, 0.05), col, CFrame.new(a) * rot, 0)
			tweenLater(p, (i - 1) / (n + 2) * draw, draw / (n + 2) + 0.05, {
				Size = Vector3.new(w, th, len + w * 0.6),
				CFrame = CFrame.new((a + b) / 2) * rot,
			}, Enum.EasingStyle.Linear)
			if mode == "brand" then
				tweenLater(p, s.burnFor or 0.4, s.fade or 1.5, { Color = ctx.fx.color2 }, Enum.EasingStyle.Sine)
				tweenLater(p, s.burnFor or 0.4, s.fade or 1.5, { Transparency = 1 }, Enum.EasingStyle.Sine)
			end
			table.insert(parts, p)
		end
	end
	if mode == "brand" then
		for _, p in parts do Debris:AddItem(p, (s.burnFor or 0.4) + (s.fade or 1.5) + 0.1) end
		return
	end
	-- Ruck auf die Pfote
	local pullAt = s.pullAt or (draw + 1)
	local jerk = s.jerk or 0.22
	local size = ctx.selfSize
	local paw = ctx.selfPos + ctx.fwd * size.Z * 0.45 + Vector3.new(0, size.Y * 0.05, 0)
	for _, p in parts do Debris:AddItem(p, pullAt + jerk + 0.1) end
	task.delay(pullAt, function()
		for _, p in parts do
			if p.Parent then
				tween(p, jerk, { CFrame = CFrame.new(paw) * (p.CFrame - p.CFrame.Position), Size = Vector3.one * 0.08 },
					Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				for _, d in p:GetChildren() do
					if d:IsA("Decal") then tween(d, jerk, { Transparency = 0.3 }) end
				end
			end
		end
		-- reines Weiss als hellster Punkt an der Pfote
		local core = newPart(Enum.PartType.Ball, Vector3.one * 0.2, Color3.new(1, 1, 1), CFrame.new(paw), 0)
		tweenLater(core, jerk * 0.8, 0.12, { Size = Vector3.one * 2.4 }, Enum.EasingStyle.Quad)
		tweenLater(core, jerk * 0.8 + 0.12, 0.25, { Transparency = 1 })
		Debris:AddItem(core, jerk + 0.5)
	end)
end

-- converge: Lichtpunkte fliegen aus vier Himmelsrichtungen in einen Punkt
-- hoch ueber der Arena (`lift`, wie `omega`). Eine Farbe je Richtung
-- (`colors`), Schweif per Trail; Starts per Tween-Verzoegerung.
--   colors, perSide, from (Abstand), lift, flight, stagger, tex
BLOCKS.converge = function(ctx, s)
	local goal = at(ctx, s.at or "arena") + Vector3.new(0, s.lift or 34, 0)
	local colors: { Color3 } = s.colors or { ctx.fx.color, ctx.fx.color2 }
	local per = math.max(2, scaled(s.perSide or 4, ctx.factor))
	local dist = s.from or 45
	local flight = s.flight or 0.9
	local stagger = s.stagger or 0.18
	local texture = texOf(ctx, s.tex)
	local base = at(ctx, "arena")
	for side = 1, 4 do
		local col = colors[(side - 1) % #colors + 1]
		local a = (side - 1) * math.pi / 2
		for j = 1, per do
			local aj = a + (math.random() - 0.5) * 0.35
			local from = base + Vector3.new(math.cos(aj) * dist, 10 + math.random() * 14, math.sin(aj) * dist)
			local orb = newPart(Enum.PartType.Ball, Vector3.one * 0.7, col, CFrame.new(from), 0)
			local a0 = Instance.new("Attachment"); a0.Position = Vector3.new(0, 0.3, 0); a0.Parent = orb
			local a1 = Instance.new("Attachment"); a1.Position = Vector3.new(0, -0.3, 0); a1.Parent = orb
			local trail = Instance.new("Trail")
			trail.Attachment0 = a0
			trail.Attachment1 = a1
			trail.Lifetime = 0.35
			trail.LightEmission = 1
			trail.FaceCamera = true
			trail.Color = ColorSequence.new(col)
			trail.Transparency = NumberSequence.new(0.1, 1)
			trail.Parent = orb
			if texture then
				local bb = Instance.new("BillboardGui")
				bb.Size = UDim2.fromScale(2.2, 2.2)
				bb.LightInfluence = 0
				local img = Instance.new("ImageLabel")
				img.BackgroundTransparency = 1
				img.Size = UDim2.fromScale(1, 1)
				img.Image = texture
				img.ImageColor3 = col
				img.Parent = bb
				bb.Parent = orb
			end
			local delaySeconds = (j - 1) * stagger + (side - 1) * 0.05
			tweenLater(orb, delaySeconds, flight, { CFrame = CFrame.new(goal) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tweenLater(orb, delaySeconds + flight, 0.12, { Transparency = 1 })
			Debris:AddItem(orb, delaySeconds + flight + 0.25)
		end
	end
end

-- Ab hier: nur fuer den Besitzer (Bildschirm und Kamera gehoeren ihm).

local function ensureCC(ctx: Ctx): ColorCorrectionEffect
	if ctx.cc and ctx.cc.Parent then return ctx.cc end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "SkillFX_Sky"
	cc.Parent = Lighting
	ctx.cc = cc
	return cc
end

BLOCKS.sky = function(ctx, s)
	if not ctx.isOwner then return end
	local cc = ensureCC(ctx)
	local dur = s.dur or 2
	tween(cc, s.fade or 0.35, {
		TintColor = s.tint or Color3.new(1, 1, 1),
		Brightness = s.brightness or 0,
		Saturation = s.saturation or 0,
	})
	task.delay(math.max(0.4, dur - 0.5), function()
		if cc.Parent then
			tween(cc, 0.5, { TintColor = Color3.new(1, 1, 1), Brightness = 0, Saturation = 0, Contrast = 0 })
		end
	end)
end

BLOCKS.spectrum = function(ctx, s)
	if not ctx.isOwner then return end
	local cc = ensureCC(ctx)
	local dur = s.dur or 1.5
	task.spawn(function()
		local t0 = os.clock()
		while cc.Parent and os.clock() - t0 &lt; dur do
			cc.TintColor = Color3.fromHSV(((os.clock() - t0) / dur) % 1, 0.45, 1)
			cc.Saturation = 0.6
			task.wait(0.03)
		end
		if cc.Parent then
			tween(cc, 0.3, { TintColor = Color3.new(1, 1, 1), Saturation = 0 })
		end
	end)
end

BLOCKS.hitstop = function(ctx, s)
	-- Den Server-Kampf kann der Client nicht anhalten. "Zeitlupe" heisst hier:
	-- Bild entsaettigt, Kontrast hoch, Sichtfeld zieht kurz zusammen.
	local dur = s.dur or 0.3
	if ctx.isOwner then
		local cc = ensureCC(ctx)
		local before = { Saturation = cc.Saturation, Contrast = cc.Contrast }
		cc.Saturation = -0.8
		cc.Contrast = 0.35
		task.delay(dur, function()
			if cc.Parent then tween(cc, 0.25, before) end
		end)
		local cam = workspace.CurrentCamera
		if cam then
			local fov = cam.FieldOfView
			tween(cam, dur * 0.4, { FieldOfView = math.max(30, fov - 12) })
			task.delay(dur, function() tween(cam, 0.3, { FieldOfView = fov }) end)
		end
	end
end

-- silence: der Ton geht fuer `dur` Sekunden ganz aus (nur Besitzer). Alle
-- gerade spielenden Klaenge werden lokal stumm und danach auf ihre
-- Lautstaerke zurueckgesetzt (ausser der Server hat sie inzwischen geaendert).
BLOCKS.silence = function(ctx, s)
	if not ctx.isOwner then return end
	local dur = s.dur or 0.3
	local level = math.clamp(s.level or 0, 0, 1)          -- v16: 0 = stumm, 0.15 = ganz leise
	local muted: { { snd: Sound, vol: number } } = {}
	local roots: { Instance } = { workspace, game:GetService("SoundService") }
	local gui = player:FindFirstChildOfClass("PlayerGui")
	if gui then table.insert(roots, gui) end
	for _, root in roots do
		for _, d in root:GetDescendants() do
			if d:IsA("Sound") and d.IsPlaying and d.Volume &gt; 0 then
				table.insert(muted, { snd = d, vol = d.Volume })
				d.Volume = d.Volume * level
			end
		end
	end
	task.delay(dur, function()
		for _, m in muted do
			if m.snd.Parent and math.abs(m.snd.Volume - m.vol * level) &lt; 1e-3 then
				m.snd.Volume = m.vol
			end
		end
	end)
end

-- spotlight: die eigene Figur leuchtet, waehrend die Welt entfaerbt ist
-- (Highlight, lokal, nur Besitzer). Roblox kann einzelne Objekte NICHT vom
-- Farbfilter ausnehmen — das Leuchten haelt die Figur aber klar heller als
-- die graue Welt.
--   at, dur, fill (Farbe), strength (0..1)
BLOCKS.spotlight = function(ctx, s)
	if not ctx.isOwner then return end
	local model = if s.at == "target" then ctx.targetModel else ctx.selfModel
	if not model then return end
	local dur = s.dur or 2
	local h = Instance.new("Highlight")
	h.Adornee = model
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.FillColor = s.fill or Color3.fromRGB(255, 245, 225)
	h.OutlineColor = Color3.new(1, 1, 1)
	h.FillTransparency = 1
	h.OutlineTransparency = 1
	h.Parent = folder()
	local strength = s.strength or 0.35
	tween(h, 0.5, { FillTransparency = 1 - strength, OutlineTransparency = 0.3 })
	tweenLater(h, math.max(0.5, dur - 0.4), 0.4, { FillTransparency = 1, OutlineTransparency = 1 })
	Debris:AddItem(h, dur + 0.1)
end

-- wipe: ein Farbspektrum laeuft als Welle durchs Bild; dahinter bekommt die
-- Welt ihre Farbe zurueck (Farbfilter -&gt; neutral). Nur Besitzer.
--   dur, tex (Spektrum-Verlauf; ohne Bild: UIGradient)
BLOCKS.wipe = function(ctx, s)
	if not ctx.isOwner then return end
	local dur = s.dur or 0.9
	local gui = Instance.new("ScreenGui")
	gui.Name = "SkillFXWipe"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 49
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")
	local texture = texOf(ctx, s.tex)
	local band: GuiObject
	if texture then
		local img = Instance.new("ImageLabel")
		img.Image = texture
		img.BackgroundTransparency = 1
		img.ImageTransparency = 0.35
		img.ScaleType = Enum.ScaleType.Stretch
		band = img
	else
		local f = Instance.new("Frame")
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.BackgroundTransparency = 0.35
		f.BorderSizePixel = 0
		local g = Instance.new("UIGradient")
		local keys = {}
		for i, c in RAINBOW do
			table.insert(keys, ColorSequenceKeypoint.new((i - 1) / (#RAINBOW - 1), c))
		end
		g.Color = ColorSequence.new(keys)
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.25, 0.2),
			NumberSequenceKeypoint.new(0.75, 0.2), NumberSequenceKeypoint.new(1, 1),
		})
		g.Parent = f
		band = f
	end
	band.AnchorPoint = Vector2.new(0.5, 0.5)
	band.Size = UDim2.fromScale(0.45, 1.6)
	band.Rotation = 12
	band.Position = UDim2.fromScale(-0.3, 0.5)
	band.Parent = gui
	tween(band, dur, { Position = UDim2.fromScale(1.3, 0.5) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	Debris:AddItem(gui, dur + 0.1)
	-- Farbe kommt hinter der Welle zurueck
	local cc = ensureCC(ctx)
	tweenLater(cc, dur * 0.2, dur * 0.8, { Saturation = 0, Brightness = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1) })
end

local _flashGui: ScreenGui? = nil
BLOCKS.flash = function(ctx, s)
	if not ctx.isOwner then return end
	local gui = _flashGui
	if not gui or not gui.Parent then
		local g = Instance.new("ScreenGui")
		g.Name = "SkillFXFlash"
		g.IgnoreGuiInset = true
		g.DisplayOrder = 50
		g.ResetOnSpawn = false
		g.Parent = player:WaitForChild("PlayerGui")
		_flashGui = g
		gui = g
	end
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.BackgroundTransparency = 0.05
	f.BorderSizePixel = 0
	f.Parent = gui
	tween(f, s.dur or 0.3, { BackgroundTransparency = 1 })
	Debris:AddItem(f, (s.dur or 0.3) + 0.1)
end

local _shakeUntil = 0
local _shakePower = 0
local _shakeBound = false
BLOCKS.shake = function(ctx, s)
	if not ctx.isOwner then return end
	_shakeUntil = math.max(_shakeUntil, os.clock() + (s.dur or 0.3))
	_shakePower = math.max(_shakePower, s.power or 0.5)
	if _shakeBound then return end
	_shakeBound = true
	RunService:BindToRenderStep("SkillFXShake", Enum.RenderPriority.Camera.Value + 1, function()
		local cam = workspace.CurrentCamera
		local left = _shakeUntil - os.clock()
		if left &lt;= 0 or not cam then
			RunService:UnbindFromRenderStep("SkillFXShake")
			_shakeBound = false
			_shakePower = 0
			return
		end
		local p = _shakePower * math.min(1, left * 3) * 0.6
		cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * p, (math.random() - 0.5) * p, 0)
	end)
end

local _cinematic = false
BLOCKS.cinematic = function(ctx, s)
	if not ctx.isOwner or not SkillFXConfig.CINEMATIC_CAMERA or _cinematic then return end
	if not SkillFXConfig.TIERS[ctx.fx.tier].cinematic then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	_cinematic = true
	local dur = math.min(2.5, s.dur or 2)
	local center = (ctx.selfPos + ctx.targetPos) / 2
	local oldType = cam.CameraType
	local oldCf = cam.CFrame
	cam.CameraType = Enum.CameraType.Scriptable
	local style = s.style or "orbit"
	local chaseEye: Vector3? = nil
	local t0 = os.clock()
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		local k = math.clamp((os.clock() - t0) / dur, 0, 1)
		local eye: Vector3
		if style == "up" then
			eye = center + Vector3.new(14 - 4 * k, 2 + 4 * k, 14 - 4 * k)
			cam.CFrame = CFrame.lookAt(eye, center + Vector3.new(0, 6 + 20 * (1 - k), 0))
		elseif style == "low" then
			eye = center + Vector3.new(-10 + 6 * k, 1.2, 8)
			cam.CFrame = CFrame.lookAt(eye, ctx.targetPos)
		elseif style == "side" then
			eye = center + Vector3.new(0, 4, 18 - 6 * k)
			cam.CFrame = CFrame.lookAt(eye, center)
		elseif style == "chase" then
			-- v16: schraeg hinter dem laufenden `comet` her; nach dem Aufprall
			-- bleibt das Auge stehen und schaut auf den Gegner.
			local head = ctx.cometHead
			if head and head.Parent then
				local cp = head.Position
				local toTarget = ctx.targetPos - cp
				local d = if toTarget.Magnitude &gt; 0.1 then toTarget.Unit else Vector3.new(0, -1, 0)
				local sideV = d:Cross(Vector3.yAxis)
				if sideV.Magnitude &lt; 0.1 then sideV = Vector3.xAxis else sideV = sideV.Unit end
				eye = cp - d * 16 + Vector3.new(0, 4, 0) + sideV * 7
				chaseEye = eye
				cam.CFrame = CFrame.lookAt(eye, cp + d * 6)
			else
				eye = chaseEye or (ctx.targetPos + Vector3.new(10, 8, 10))
				cam.CFrame = CFrame.lookAt(eye, ctx.targetPos)
			end
		elseif style == "orbitSelf" then
			-- v16: langsamer Halbkreis um den eigenen Baerchi, Blick leicht
			-- nach oben (Baerchi und Himmel im Bild)
			local a = math.pi * 0.25 + k * math.pi
			local me = ctx.selfPos
			eye = me + Vector3.new(math.cos(a) * 13, 3.5, math.sin(a) * 13)
			cam.CFrame = CFrame.lookAt(eye, me + Vector3.new(0, 4 + 3 * k, 0))
		else
			local a = k * math.pi * 0.9
			eye = center + Vector3.new(math.cos(a) * 16, 6, math.sin(a) * 16)
			cam.CFrame = CFrame.lookAt(eye, center)
		end
		if k &gt;= 1 then
			if conn then conn:Disconnect() end
			cam.CFrame = oldCf
			cam.CameraType = if oldType == Enum.CameraType.Scriptable then Enum.CameraType.Custom else oldType
			_cinematic = false
		end
	end)
end

BLOCKS.sound = function(ctx, s)
	local slot = s.slot or "strike"
	local key = (ctx.fx.sounds :: any)[slot]
	if not key then return end
	local id = SkillFXConfig.SOUND_LIBRARY[key] or key
	local anchor = newPart(Enum.PartType.Block, Vector3.one * 0.1, Color3.new(), CFrame.new(ctx.selfPos), 1)
	local snd = Instance.new("Sound")
	snd.SoundId = if tonumber(id) then "rbxassetid://" .. id else id
	-- v15: leiser, Echo noch leiser, nach MAX_SECONDS ausgeblendet
	-- (SkillFXConfig.SOUND) — die eingebauten Klaenge sind sonst sehr hart.
	local cfg = SkillFXConfig.SOUND
	local volume = if ctx.isOwner then cfg.OWNER_VOLUME else cfg.SPECTATOR_VOLUME
	if s.echo then
		volume *= cfg.ECHO_FACTOR
	end
	snd.Volume = volume
	snd.PlaybackSpeed = (ctx.fx.pitch or 1) * (if slot == "charge" then 0.9 elseif slot == "impact" then 0.8 else 1)
	snd.RollOffMode = Enum.RollOffMode.InverseTapered
	snd.RollOffMinDistance = cfg.ROLLOFF_MIN
	snd.RollOffMaxDistance = cfg.ROLLOFF_MAX
	snd.Parent = anchor
	snd:Play()
	task.delay(cfg.MAX_SECONDS, function()
		if snd.Parent ~= nil and snd.IsPlaying then
			tween(snd, cfg.FADE_SECONDS, { Volume = 0 })
		end
	end)
	Debris:AddItem(anchor, cfg.MAX_SECONDS + cfg.FADE_SECONDS + 0.2)
end

--------------------------------------------------------------------------------
-- Abspielen
--------------------------------------------------------------------------------

export type PlayRequest = {
	owner    : number,     -- UserId des Besitzers
	skillId  : string,
	full     : boolean,    -- volle Show (erster Einsatz im Lauf) oder kurzes Echo
	attacker : Model?,     -- die Figur des Baerchis
	target   : Model?,     -- der Gegner
	center   : Vector3?,   -- Arena-Mitte (Fallback fuer Positionen)
	bonus    : boolean?,   -- Finisher/Opener hat gegriffen: Schritte mit `bonus = true` laufen mit
}

function SkillFXController.play(req: PlayRequest)
	local fx = SkillFXConfig.get(req.skillId)
	local selfPos = centerOf(req.attacker) or req.center
	if not selfPos then return end
	local targetPos = centerOf(req.target) or (selfPos + Vector3.new(0, 0, -8))
	local isOwner = req.owner == player.UserId

	-- v16: weit weg = nur Schritte mit `global = true` (z. B. die Omega-
	-- Lichtsaeule, die man von der Hauptinsel sieht) und nur in der vollen Show.
	local far = false
	if not isOwner then
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root or (root.Position - selfPos).Magnitude &gt; SPECTATOR_DISTANCE then
			far = true
		end
	end
	if far and not req.full then
		return
	end

	local selfSize = sizeOf(req.attacker)
	local targetSize = sizeOf(req.target)
	local flat = Vector3.new(targetPos.X - selfPos.X, 0, targetPos.Z - selfPos.Z)
	local ctx: Ctx = {
		fx = fx,
		id = req.skillId,
		selfPos = selfPos,
		targetPos = targetPos,
		arena = req.center or (selfPos + targetPos) / 2,
		isOwner = isOwner,
		factor = budgetFactor() * (if isOwner then 1 else 0.6),
		cc = nil,
		sounds = {},
		selfModel = req.attacker,
		targetModel = req.target,
		selfSize = selfSize,
		targetSize = targetSize,
		selfFeet = selfPos - Vector3.new(0, selfSize.Y / 2, 0),
		targetFeet = targetPos - Vector3.new(0, targetSize.Y / 2, 0),
		fwd = if flat.Magnitude &gt; 0.01 then flat.Unit else Vector3.new(0, 0, -1),
		path = nil,
		cometHead = nil,
		far = far,
		bonus = req.bonus == true,
	}

	-- Schritte abspielen (volle Show oder eigenes Echo), je Schritt EIN
	-- verzoegerter Aufruf; Fehler eines Bausteins stoppen die Show nicht.
	local function run(steps: { SkillFXConfig.Step }, limit: number, echo: boolean)
		for _, step in steps do
			local block = BLOCKS[step.fx]
			if block and not (step.extra and not extrasOn(ctx)) and not (step.ownerOnly and not ctx.isOwner)
				and not (ctx.far and not step.global)
				and not (step.bonus and not ctx.bonus)
			then
				local st = step
				if echo and step.fx == "sound" then
					st = table.clone(step)
					st.echo = true
				end
				task.delay(math.min(step.t or 0, limit), function()
					local ok, err = pcall(block, ctx, st)
					if not ok then
						warn("[SkillFX]", req.skillId, step.fx, err)
					end
				end)
			end
		end
	end

	local echoSteps = fx.echo
	if not req.full and echoSteps then
		-- v16: eigenes Echo der Show (SkillFXConfig: `echo`).
		run(echoSteps, SkillFXConfig.TIERS[fx.tier].echo, true)
		return
	end

	if not req.full then
		-- Echo: die ersten zwei Welt-Effekte der Show, stark verkuerzt.
		local shown = 0
		for _, step in fx.steps do
			local block = BLOCKS[step.fx]
			if block and step.fx ~= "sound" and step.fx ~= "sky" and step.fx ~= "cinematic"
				and step.fx ~= "spectrum" and step.fx ~= "hitstop" and step.fx ~= "starfield"
				and step.fx ~= "flash" and step.fx ~= "shake" and not step.bonus
			then
				local short = table.clone(step)
				short.dur = math.min(step.dur or 0.4, SkillFXConfig.TIERS[fx.tier].echo)
				task.spawn(block, ctx, short)
				shown += 1
				if shown &gt;= 2 then break end
			end
		end
		BLOCKS.sound(ctx, { slot = "strike", echo = true })
		return
	end

	local maxDur = SkillFXConfig.getDuration(req.skillId, true)
	run(fx.steps, maxDur, false)

	-- Farbfilter am Ende sicher entfernen.
	task.delay(maxDur + 1, function()
		if ctx.cc and ctx.cc.Parent then
			tween(ctx.cc, 0.3, { TintColor = Color3.new(1, 1, 1), Brightness = 0, Saturation = 0, Contrast = 0 })
			Debris:AddItem(ctx.cc, 0.4)
		end
	end)
end

function SkillFXController.init()
	Remotes.SkillFXPlay.OnClientEvent:Connect(function(req: any)
		if typeof(req) ~= "table" or typeof(req.skillId) ~= "string" then return end
		local ok, err = pcall(SkillFXController.play, req)
		if not ok then
			warn("[SkillFXController] Show fehlgeschlagen:", err)
		end
	end)
	print("[SkillFXController] Bereit")
end

return SkillFXController
