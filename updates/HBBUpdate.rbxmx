	----------------------------------------------------------------------------
	-- UI-Qualitaet: Beschreibungen aus den Configs (Baerchis, Eier, Skills, Events, Charms)
	----------------------------------------------------------------------------
	["baerchi.RedBaerchi.desc"]           = "El clásico. Fiable, sin complicaciones.",
	["baerchi.GreenBaerchi.desc"]         = "Algo más resistente, pero más lento.",
	["baerchi.YellowBaerchi.desc"]        = "Rápido pero frágil. Un cañón de cristal.",
	["baerchi.BlueBaerchi.desc"]          = "Sólido en todo.",
	["baerchi.OrangeBaerchi.desc"]        = "Mucho daño, aguante medio.",
	["baerchi.SugarBaerchi.desc"]         = "Huele a caramelo, pega como un camión.",
	["baerchi.CrystalBaerchi.desc"]       = "Afilado y rapidísimo. Se rompe fácilmente.",
	["baerchi.GoldenGrizzly.desc"]        = "Raro, poderoso, y lo sabe.",
	["baerchi.VoidBaerchi.desc"]          = "Sale de la nada. Y así se va.",
	["baerchi.RainbowBaerchi.desc"]       = "Todos los colores. Todos los poderes.",
	["baerchi.AncientBaerchi.desc"]       = "Ya existía antes de que se inventaran los Gummies.",
	["baerchi.CosmicBaerchi.desc"]        = "Un trozo de cielo estrellado con pelo.",
	["baerchi.PhoenixBaerchi.desc"]       = "Cae una vez. Siempre se levanta.",
	["baerchi.GlacierBaerchi.desc"]       = "Donde mira, todo se ralentiza.",
	["baerchi.PhantomBaerchi.desc"]       = "Apenas se le ve. Sus huevos, sí.",
	["baerchi.SeraphBaerchi.desc"]        = "Seis alas, un corazón de miel.",
	["baerchi.NorthernLightBaerchi.desc"] = "Baila por el cielo, más rápido que la vista.",
	["baerchi.EclipseBaerchi.desc"]       = "Cuando aparece, oscurece a mediodía.",
	["baerchi.CometBaerchi.desc"]         = "Llega con un estallido. Deja un cráter.",
	["baerchi.NebulaBaerchi.desc"]        = "Un pelaje de polvo de estrellas que arde.",
	["baerchi.PulsarBaerchi.desc"]        = "Late como un reloj. Cada golpe más fuerte.",
	["baerchi.ShadeBaerchi.desc"]         = "Nadie lo ha visto nunca del todo.",
	["baerchi.RiddleBaerchi.desc"]        = "Responde cada pregunta con otra.",
	["baerchi.TitanBaerchi.desc"]         = "Carga montañas como si fueran ositos de goma.",
	["baerchi.GenesisBaerchi.desc"]       = "En el principio era el Baerchi.",
	["baerchi.ChronosBaerchi.desc"]       = "Siempre llega justo a tiempo.",
	["baerchi.InfinityBaerchi.desc"]      = "Nunca para. De verdad, nunca.",
	["baerchi.OmegaBaerchi.desc"]         = "El último Baerchi. Después, nada más.",
	["egg.BasicEgg.desc"]                 = "Un huevo de lo más normal. ¿Qué saldrá?",
	["egg.SugarEgg.desc"]                 = "Sabe dulce. Lo de dentro también.",
	["egg.GoldenEgg.desc"]                = "Brilla sospechosamente. Rare o mejor garantizado.",
	["egg.PlatinumEgg.desc"]              = "Pesado como el plomo, vale más que el oro.",
	["egg.SunEgg.desc"]                   = "Cálido en la mano. Muy cálido.",
	["egg.ZenithEgg.desc"]                = "La cima de la senda del Oro.",
	["egg.CrystalEgg.desc"]               = "Transparente. Casi se ve lo que hay dentro.",
	["egg.PrismEgg.desc"]                 = "Divide la luz en siete colores.",
	["egg.AuroraEgg.desc"]                = "Brilla como el cielo del norte.",
	["egg.MistEgg.desc"]                  = "Se siente frío y húmedo.",
	["egg.VoidEgg.desc"]                  = "Más negro que el negro.",
	["egg.ShadowEgg.desc"]                = "No proyecta sombra. ES una.",
	["egg.AbyssEgg.desc"]                 = "Lo más hondo. Debajo no hay nada.",
	["egg.CometEgg.desc"]                 = "Arrastra una cola de chispas.",
	["egg.NovaEgg.desc"]                  = "A punto de explotar.",
	["egg.GalaxyEgg.desc"]                = "Un universo entero en una cáscara.",
	["egg.AscensionEgg.desc"]             = "Ganado, no comprado. Legendary garantizado.",
	["egg.TranscendenceEgg.desc"]         = "Más allá de todo lo que se puede comprar.",
	["egg.EternityEgg.desc"]              = "Siempre estuvo aquí. Se queda para siempre.",
	["egg.OmegaEgg.desc"]                 = "El último huevo. 30 % Omega.",
	["egg.UfoJackpotEgg.desc"]            = "Lanzado por el OVNI. Un hallazgo rarísimo.",
	["egg.BasicEgg.short"]                = "Básico",
	["egg.SugarEgg.short"]                = "Azúcar",
	["egg.GoldenEgg.short"]               = "Oro",
