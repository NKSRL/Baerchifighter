--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

local function getById(id: string): EventDef?
	for _, def in EVENTS do
		if def.id == id then
			return def
		end
	end
	return nil
end

-- Laeuft dieses Event im Durchlauf `cycle` (ab 1 gezaehlt)?
local function isScheduledInCycle(def: EventDef, cycle: number): boolean
	local n = def.everyNthCycle
	if not n or n <= 1 then return true end
	return cycle % n == 0
end

local function getDuration(def: EventDef): number
	return def.durationSeconds or EVENT_DURATION_SECONDS
end

-- HBB Paket 6: Sekunden, bis Event `targetId` das naechste Mal STARTET
-- (0 = laeuft gerade). Rein, nach demselben Ablauf wie EventService:
-- Event -> Pause (EVENT_GAP_SECONDS) -> naechstes geplantes Event.
--   activeId  laufendes Event oder nil (Pause)
--   remaining Restsekunden der aktuellen Phase
--   nextIndex/nextCycle  Stand von EventService (_nextIndex, _nextCycle)
-- nil, wenn das Event im Zyklus nie vorkommt.
local function secondsUntilStart(targetId: string, activeId: string?, remaining: number,
	nextIndex: number, nextCycle: number): number?
	if activeId == targetId then return 0 end
	local t = math.max(0, remaining)
	if activeId then
		t += EVENT_GAP_SECONDS   -- erst endet das laufende Event, dann Pause
	end

	local index, cycle = nextIndex, nextCycle
	local count = #EVENTS
	for _ = 1, count * 8 do
		local def = EVENTS[index]
		if isScheduledInCycle(def, cycle) then
			if def.id == targetId then return t end
			t += getDuration(def) + EVENT_GAP_SECONDS
		end
		index += 1
		if index > count then
			index = 1
			cycle += 1
		end
	end
	return nil
end

local function getRarityUpChance(rarity: string): number
	return RARITY_UP_CHANCE[rarity] or 0
end

local function getMutationFactor(rarity: string): number
	return MUTATION_RARITY_FACTOR[rarity] or 1
end

-- Liefert eine Nachricht (LocMsg) statt eines fertigen Satzes: die Tafel
-- baut der Server, lesen tut sie jeder Spieler in seiner Sprache. Der Client
-- loest sie mit Loc.resolve auf, Log-Ausgaben ebenso (dann in Serversprache).
local function describeBonus(bonus: EventBonus?): Types.LocMsg?
	if not bonus then
		return nil
	end

	local amount = bonus.amount or 0

	if bonus.kind == "honey" then
		return Loc.msg("event.bonus.honey", { n = amount })

	elseif bonus.kind == "eggs" then
		if bonus.eggPick == "jump" then
			return Loc.msg("event.bonus.jump", { n = amount })
		elseif bonus.eggPick == "highest" then
			return Loc.msg("event.bonus.highest", { n = amount })
		end
		local eggType = bonus.eggType or "BasicEgg"
		return Loc.msg("event.bonus.eggs", { n = amount, egg = Loc.msg("egg." .. eggType .. ".name") })

	elseif bonus.kind == "gummies" then
		return Loc.msg("event.bonus.gummies", { n = amount })

	elseif bonus.kind == "goldGummies" then
		return Loc.msg("event.bonus.gold", { n = amount })

	elseif bonus.kind == "mutation" then
		return Loc.msg("event.bonus.mutation", { pct = math.floor((bonus.chance or 0) * 100 + 0.5) })
	end

	return nil
end

-- Die vollstaendige Belohnung in einer Zeile, fuer Tafel und UI.
local function describeReward(def: EventDef): Types.LocMsg
	if def.rewardText then
		return Loc.msg("event." .. def.id .. ".reward")
	end

	local bonusPart = describeBonus(def.bonus)
	if bonusPart then
		return bonusPart
	end

	return Loc.msg("event.bonus.unknown")
end

--------------------------------------------------------------------------------
-- Sammel-Update 05.10. (Paket 5.2): KAMPF UM DIE MITTE
--------------------------------------------------------------------------------
-- Waehrend eines Events stossen die Event-Baerchis Spieler, die KEIN eigenes
-- Baerchi im Event haben und ihnen im Pit zu nahe kommen (Rueckstoss + kurze
-- Verlangsamung + kurze Waben-Pause). Die Baerchis kaempfen zuerst
-- untereinander (Handler); greifen tun sie nur, wenn sie gerade frei sind.
-- Annahmen (Abschnitt 11.10, Standard): kein Angriff auf Spieler mit eigenem
-- Baerchi im Pit, kein Festhalten (Abklingzeit je Spieler), nur im Pit-Radius.
local PIT_BRAWL = {
	TICK_SECONDS        = 0.5,
	REACH               = 9,      -- Studs: so nah muss der Spieler am Baerchi sein
	PLAYER_COOLDOWN     = 4,      -- Sekunden: so oft wird ein Spieler hoechstens gestossen
	BAERCHI_COOLDOWN    = 2.5,    -- Sekunden: so oft greift ein Baerchi hoechstens an
	KNOCKBACK_SPEED     = 55,
	SLOW_FACTOR         = 0.7,
	SLOW_SECONDS        = 1.5,
	PICKUP_PAUSE_SECONDS = 1.5,
	LUNGE_DISTANCE      = 2.5,
	LUNGE_SECONDS       = 0.3,
}

return {
	EMERGENCY_BASIC_EGG_CHANCE = EMERGENCY_BASIC_EGG_CHANCE,
	EVENT_DURATION_SECONDS = EVENT_DURATION_SECONDS,
	EVENT_GAP_SECONDS      = EVENT_GAP_SECONDS,
	FIRST_GAP_SECONDS      = FIRST_GAP_SECONDS,
	BOSS_TIERS             = BOSS_TIERS,
	EVENTS                 = EVENTS,

	UFO                    = UFO,
	DUEL                   = DUEL,
	RARITY_UP_CHANCE       = RARITY_UP_CHANCE,
	MUTATION_RARITY_FACTOR = MUTATION_RARITY_FACTOR,
	STORM                  = STORM,
	HOT_EGG                = HOT_EGG,
	KING                   = KING,
	TREASURE               = TREASURE,
	WASP_QUEEN             = WASP_QUEEN,

	getById           = getById,
	getDuration       = getDuration,
	isScheduledInCycle = isScheduledInCycle,
	secondsUntilStart  = secondsUntilStart,
	getRarityUpChance = getRarityUpChance,
	getMutationFactor = getMutationFactor,
	describeBonus     = describeBonus,
	describeReward    = describeReward,
	PIT_BRAWL         = PIT_BRAWL,   -- Sammel-Update 5.2
}
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX12"><Properties><string name="Name">Localization</string></Properties><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Names</string><ProtectedString name="Source"><![CDATA[--!strict
-- Names.luau
-- ReplicatedStorage/Localization/Names.luau
--
-- Einzige Zustaendigkeit:
--   - Anzeigenamen und Beschreibungen von Config-Eintraegen in der
--     Spielersprache liefern (Baerchis, Eier, Skills, Events, Gebaeude,
--     Mutationen, Charm-Werte)
--
-- Warum es dieses Modul gibt: die Configs tragen ihre Texte auf Deutsch
-- (`displayName`, `description`, ...). Jede Stelle, die diese Felder direkt
-- anzeigte, war ein Text, der nie uebersetzt wurde — und davon gab es ueber
-- dreissig. Jetzt ist das hier der EINZIGE Leser dieser Felder;
-- `tools/check_ui.py` (Regel T3) meldet jeden anderen. Das deutsche Feld
-- bleibt als Rueckfall stehen, falls ein Schluessel fehlt (T4 verhindert das).
--
-- Zwei Formen:
--   * Names.baerchi(id) usw.  → fertiger Text (Client, aktive Sprache)
--   * Names.msg.baerchi(id)   → LocMsg (Server: der Client loest sie auf,
--                               jeder Spieler in seiner Sprache)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types         = require(ReplicatedStorage.Network.Types)
local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local SkillConfig   = require(ReplicatedStorage.Config.SkillConfig)
local EventConfig   = require(ReplicatedStorage.Config.EventConfig)
local CharmConfig   = require(ReplicatedStorage.Config.CharmConfig)
local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local Loc           = require(script.Parent.Loc)

local Names = {}

-- Ein Schluessel mit deutschem Rueckfall aus der Config; ohne beides die id.
local function lookup(key: string, fallback: string?, id: string): string
	return Loc.name(key, fallback or id)
end

--------------------------------------------------------------------------------
-- Baerchis
--------------------------------------------------------------------------------

function Names.baerchi(configId: string): string
	local def = BaerchiConfig.getById(configId)
	return lookup("baerchi." .. configId .. ".name", def and def.displayName, configId)
end

function Names.baerchiDesc(configId: string): string
	local def = BaerchiConfig.getById(configId)
	return lookup("baerchi." .. configId .. ".desc", def and def.description, "")
end

function Names.rarity(rarity: string): string
	return Loc.name("rarity." .. rarity, rarity)
end

function Names.mutation(mutation: Types.MutationId): string
	local ok, fallback = pcall(BaerchiConfig.getMutationDisplayName, mutation)
	return lookup("mutation." .. tostring(mutation) .. ".name", if ok then fallback else nil, tostring(mutation))
end

--------------------------------------------------------------------------------
-- Eier
--------------------------------------------------------------------------------

function Names.egg(eggType: string): string
	local def = EggConfig.data[eggType :: any]
	return lookup("egg." .. eggType .. ".name", def and def.displayName, eggType)
end

function Names.eggDesc(eggType: string): string
	local def = EggConfig.data[eggType :: any]
	return lookup("egg." .. eggType .. ".desc", def and def.description, "")
end

function Names.eggShort(eggType: string): string
	local def = EggConfig.data[eggType :: any]
	return lookup("egg." .. eggType .. ".short", def and def.shortName, eggType)
end

--------------------------------------------------------------------------------
-- Skills
--------------------------------------------------------------------------------

function Names.skill(skillId: string): string
	local def = SkillConfig.getById(skillId)
	return lookup("skill." .. skillId .. ".name", def and def.displayName, skillId)
end

function Names.skillDesc(skillId: string): string
	local def = SkillConfig.getById(skillId)
	return lookup("skill." .. skillId .. ".desc", def and def.description, "")
end

function Names.skillDrawback(skillId: string): string
	local def = SkillConfig.getById(skillId)
	return lookup("skill." .. skillId .. ".drawback", def and def.drawback, "")
end

--------------------------------------------------------------------------------
-- Events, Gebaeude, Charms
--------------------------------------------------------------------------------

function Names.event(eventId: string): string
	local def = EventConfig.getById(eventId)
	return lookup("event." .. eventId .. ".name", def and def.displayName, eventId)
end

function Names.building(buildingId: string): string
	local def = MapConfig.BUILDING_OFFSETS[buildingId]
	return lookup("building." .. buildingId .. ".name", def and def.displayName, buildingId)
end

function Names.buildingShort(buildingId: string): string
	local def = MapConfig.BUILDING_OFFSETS[buildingId]
	return lookup("building." .. buildingId .. ".short", def and def.shortName, buildingId)
end

function Names.charmStat(statId: string): string
	local def = CharmConfig.getStatDef(statId)
	return lookup("charm." .. statId .. ".name", def and def.displayName, statId)
end

--------------------------------------------------------------------------------
-- Dieselben Namen als Nachricht (fuer den Server)
--------------------------------------------------------------------------------
-- Der Server kennt die Sprache des Spielers nicht. Er schickt deshalb nur den
-- Schluessel; Loc.resolve beim Client setzt den Namen ein — auch verschachtelt
-- als Argument einer anderen Nachricht ("+{n}x {egg}").

Names.msg = {
	baerchi  = function(configId: string): Types.LocMsg return Loc.msg("baerchi." .. configId .. ".name") end,
	egg      = function(eggType: string): Types.LocMsg return Loc.msg("egg." .. eggType .. ".name") end,
	eggShort = function(eggType: string): Types.LocMsg return Loc.msg("egg." .. eggType .. ".short") end,
	event    = function(eventId: string): Types.LocMsg return Loc.msg("event." .. eventId .. ".name") end,
	building = function(buildingId: string): Types.LocMsg return Loc.msg("building." .. buildingId .. ".name") end,
	mutation = function(mutation: string): Types.LocMsg return Loc.msg("mutation." .. mutation .. ".name") end,
}

return Names
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX10"><Properties><string name="Name">Strings</string></Properties><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">de</string><ProtectedString name="Source"><![CDATA[--!strict
-- de.luau
-- ReplicatedStorage/Localization/Strings/de.luau
--
-- Deutsch — die Ursprungssprache des Projekts und deshalb die letzte
-- Rueckfall-Stufe: hier muss JEDER Schluessel stehen. `tools/check_loc.py`
-- prueft, dass en/fr/es nichts enthalten, was hier fehlt, und umgekehrt.
--
-- Konventionen (gelten fuer alle Sprachdateien):
--   * Platzhalter {name} muessen in jeder Sprache dieselben Namen tragen.
--   * Mehrzahl: Schluessel `.one` / `.other`, die Zahl steht als {n} bereit.
--   * "Baerchi", "Gummies", "GoldGummies", "PIT", "Rebirth" sind feste
--     Spielbegriffe und bleiben in allen Sprachen stehen.
--   * Reihenfolge der Abschnitte ist in allen Dateien gleich — so lassen sich
--     die Dateien nebeneinander lesen.

return {
	----------------------------------------------------------------------------
	-- Sprache
	----------------------------------------------------------------------------
	["ui.language.title"] = "Sprache",
	["ui.language.auto"]  = "Automatisch (Roblox)",

	----------------------------------------------------------------------------
	-- Zeit (Theme.formatDuration) — Werte kommen vorformatiert (z.B. "05")
	----------------------------------------------------------------------------
	["time.s"]  = "{s}s",
	["time.ms"] = "{m}m {s}s",
	["time.hm"] = "{h}h {m}m",

	----------------------------------------------------------------------------
	-- Menueleiste
	----------------------------------------------------------------------------
	["ui.menu.eggs"]    = "Eier",
	["ui.menu.baerchis"] = "Baerchis",
	["ui.menu.fight"]   = "Kampf",
	["ui.menu.arena"]   = "Arena",

	----------------------------------------------------------------------------
	-- Rebirth
	----------------------------------------------------------------------------
	["ui.rebirth.title"]   = "Rebirth",
	["ui.rebirth.status"]  = "Rebirth {count}  —  Multiplikator x{mult:d2}",
	["ui.rebirth.cost"]    = "Kostet {cost} Gummies  (du hast {have})",
	["ui.rebirth.loss"]    = "Weg: alle Gebäude-Level, der Inkubator-Ausbau, die Level deiner Baerchis und deine Gummies (zurück auf {start}) — gib sie vorher aus!\nBleibt: deine Baerchis, alle Eier (auch im Inkubator), der Ei-Baum, Tower-Rekorde, GoldGummies, Rang und Statistiken.",
	["ui.rebirth.reward"]  = "Danach: Multiplikator x{mult:d2}",
	["ui.rebirth.reward_eggs.one"]   = "Danach: Multiplikator x{mult:d2}  —  +{n} Ascensions-Ei",
	["ui.rebirth.reward_eggs.other"] = "Danach: Multiplikator x{mult:d2}  —  +{n} Ascensions-Eier",
	["ui.rebirth.cancel"]  = "Abbrechen",
	["ui.rebirth.confirm"] = "Rebirth!",

	----------------------------------------------------------------------------
	-- Meldungen (Toasts)
	----------------------------------------------------------------------------
	["msg.recycled"]       = "Verwertet: +{gummies} Gummies",
	["msg.recycled_gold"]  = "Verwertet: +{gummies} Gummies  und  +{gold} GoldGummies",
	["msg.offline_honey"]  = "Während du weg warst ({time}): +{honey} Honig",
	["msg.level_up"]       = "Level Up!  Jetzt Level {level}",
	["msg.rebirth_done"]   = "Rebirth {count} geschafft: Multiplikator x{mult:d2}",
	["msg.rebirth_done_eggs.one"]   = "Rebirth {count} geschafft: Multiplikator x{mult:d2} und {n} Ascensions-Ei",
	["msg.rebirth_done_eggs.other"] = "Rebirth {count} geschafft: Multiplikator x{mult:d2} und {n} Ascensions-Eier",

	----------------------------------------------------------------------------
	-- Eier in der Welt (Timer ueber dem Baerchi)
	----------------------------------------------------------------------------
	["ui.egg.full"] = "Lager voll — erst einsammeln!",
	["ui.egg.soon"] = "Nächstes Ei: gleich!",
	["ui.egg.next"] = "Nächstes Ei: {time}",

	----------------------------------------------------------------------------
	-- Abgelehnte Aktionen (Server → Client, siehe Types.LocMsg)
	----------------------------------------------------------------------------
	["err.unknown"]                 = "Aktion nicht möglich",
	["err.player_not_loaded"]       = "Spieler nicht geladen",
	["err.baerchi_not_found"]       = "Baerchi nicht gefunden",
	["err.baerchi_data_corrupt"]    = "Baerchi-Daten defekt",
	["err.baerchi_busy"]            = "Der Baerchi ist gerade unterwegs — kurz warten",
	["err.not_enough_gummies"]      = "Nicht genug Gummies (du hast {have}, du brauchst {need})",
	["err.not_enough_gold_gummies"] = "Nicht genug GoldGummies (du hast {have}, du brauchst {need})",
	["err.shop_free_taken"] = "Heute schon abgeholt — morgen gibt es wieder Gold!",
	["err.rebirth_cost"]            = "Rebirth kostet {cost} Gummies (du hast {have})",

	["err.building_missing"]        = "Gebäude nicht vorhanden",
	["err.building_unknown"]        = "Unbekanntes Gebäude",
	["err.max_level"]               = "Maximales Level erreicht",

	["err.charm_roll_cost"]         = "Ein Wurf kostet {cost} GoldGummies (du hast {have})",
