--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

-- Der erste Spieler im Server. Fuer Solo-Tests in Studio genau richtig.
local function firstPlayer(): Player?
	return Players:GetPlayers()[1]
end

local function requireData(): (Player?, Types.PlayerData?, string?)
	local player = firstPlayer()
	if not player then
		return nil, nil, "Kein Spieler im Spiel — laeuft der Play-Modus?"
	end

	local data = PlayerService.getData(player)
	if not data then
		return player, nil, "Daten fuer " .. player.Name .. " noch nicht geladen"
	end

	return player, data, nil
end

local function countBaerchis(data: Types.PlayerData): number
	local n = 0
	for _ in data.island.baerchis do n += 1 end
	return n
end

--------------------------------------------------------------------------------
-- Befehle
--------------------------------------------------------------------------------

local commands: { [string]: (Player, Types.PlayerData, ...any) -> any } = {}

commands.info = function(player, data)
	local buildings: { [string]: number } = {}
	for id, building in data.island.buildings do
		buildings[id] = building.level
	end

	return {
		player       = player.Name,
		gummies      = data.gummies,
		goldGummies  = data.goldGummies,
		rebirthCount = data.rebirthCount,
		rebirthMult  = data.rebirthMult,
		baerchis     = countBaerchis(data),
		towers       = data.towers,
		towerProgress = data.island.towerProgress,
		buildings    = buildings,
		eggStock     = data.island.eggStock,
	}
end

-- Waehrung schenken. Ohne rebirthMult, du bekommst exakt die Zahl.
commands.give = function(player, _data, gummies: any, gold: any)
	EconomyService.awardGummiesFlat(player, tonumber(gummies) or 100000)
	EconomyService.awardGoldGummies(player, tonumber(gold) or 1000)
	return commands.info(player, PlayerService.getDataOrError(player))
end

-- Alle Baerchis als flache Liste (uid zum Weiterverwenden)
commands.list = function(_player, data)
	local out = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(out, {
			uid      = uid,
			configId = baerchi.configId,
			rarity   = baerchi.rarity,
			level    = baerchi.level,
			xp       = baerchi.xp,
			fusion   = baerchi.isFusionResult,
			bonus    = baerchi.fusionBonus,

			-- v8: die zweite Fortschrittsachse. `charms` bewusst nur als Anzahl
			-- — die Detailwerte holt man sich ueber "charms <uid>", sonst wird
			-- die Liste in der Command Bar unlesbar.
			promo    = baerchi.promotionLevel or 0,
			stats    = baerchi.statLevels,
			charms   = #(baerchi.charms or {}),
			mutation = baerchi.mutation,
		})
	end
	table.sort(out, function(a, b) return a.uid < b.uid end)
	return out
end

-- Baerchi direkt erzeugen, ohne Ei.
--
-- Das dritte Argument setzt eine Mutation (siehe BaerchiConfig.MUTATIONS fuer
-- gueltige Namen: Gold/Diamond/Bloodrot/Celestial/Candy/Lava/Galaxy/Rainbow).
-- Ohne diesen Weg waeren Mutationen in Studio praktisch nicht testbar: die
-- Gesamtchance beim Schluepfen liegt bei 1.5%, die seltenste Stufe (Rainbow)
-- bei 0.0005% — man muesste also im Schnitt 200'000 Eier ausbrueten.
--   D:Invoke("add", "RedBaerchi", 10)              -- normal
--   D:Invoke("add", "RedBaerchi", 10, "Rainbow")   -- mit Mutation
commands.add = function(player, data, configId: any, level: any, mutation: any)
	local mutationId: any = nil
	if typeof(mutation) == "string" and BaerchiConfig.MUTATIONS[mutation :: any] then
		mutationId = mutation
	end

	local baerchi = BaerchiFactory.create(tostring(configId), {
		level    = tonumber(level) or 1,
		mutation = mutationId,
	})
	if not baerchi then
		return { error = "Unbekannter configId: " .. tostring(configId) }
	end

	data.island.baerchis[baerchi.uid] = baerchi
	PlayerService.markDirty(player)

	return {
		uid      = baerchi.uid,
		configId = baerchi.configId,
		rarity   = baerchi.rarity,
		level    = baerchi.level,
		mutation = baerchi.mutation,
	}
end

-- Die Kampfwerte eines Baerchis so, wie der Kampf sie sieht. Praktisch, um
-- Promotion, Stat-Stufen, Charms und Mutation gegeneinander nachzurechnen.
commands.stats = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		return { error = "Unbekannter configId: " .. baerchi.configId }
	end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)

	return {
		configId = baerchi.configId,
		level    = baerchi.level,
		mutation = baerchi.mutation,
		promo    = baerchi.promotionLevel or 0,
		maxHp    = stats.maxHp,
		atk      = stats.atk,
		spd      = stats.spd,
		pwrProzent = math.floor(stats.pwr * 100 + 0.5),
		skill    = stats.skillId,
	}
end

-- Gebaeude-Level direkt setzen (umgeht die Kosten)
commands.building = function(player, data, buildingId: any, level: any)
	local building = data.island.buildings[buildingId]
	if not building then
		return { error = "Unbekanntes Gebaeude: " .. tostring(buildingId) }
	end

	-- clampBuildingLevel rundet mit ab: ohne das landete eine 5.5 aus der
	-- Command Bar als Kommazahl in den Daten und jedes spaetere
	-- string.format("%d", level) wuerde daran scheitern.
	building.level = EconomyConfig.clampBuildingLevel(tonumber(level) or 1)
	MapService.updateBuildingLevel(player, buildingId, building.level)
	PlayerService.markDirty(player)

	return { building = buildingId, level = building.level, look = BuildingBehavior.getLook(building.level) }
end

-- v12: Ei ins Lager legen und sofort oeffnen (es gibt keine Brut mehr)
commands.hatch = function(player, data, eggType: any)
	local egg = tostring(eggType or "BasicEgg")
	if not EggConfig.data[egg :: Types.EggType] then
		return { error = "Unbekannter Egg-Typ: " .. egg }
	end

	data.island.eggStock[egg :: Types.EggType] = (data.island.eggStock[egg :: Types.EggType] or 0) + 1
	local result = EggService.openEgg(player, egg :: Types.EggType)
	if not result then
		return { error = "Oeffnen fehlgeschlagen" }
	end

	return {
		configId = result.baerchi.configId,
		rarity   = result.baerchi.rarity,
		mutation = result.baerchi.mutation,
		neu      = result.isNew,
	}
end

-- v12: Eier ins Lager legen, ohne sie zu oeffnen (fuer Tests im Ei-Menue)
commands.egg = function(player, data, eggType: any, count: any)
	local egg = tostring(eggType or "BasicEgg")
	if not EggConfig.data[egg :: Types.EggType] then
		return { error = "Unbekannter Egg-Typ: " .. egg }
	end

	local amount = math.clamp(tonumber(count) or 1, 1, 100)
	data.island.eggStock[egg :: Types.EggType] = (data.island.eggStock[egg :: Types.EggType] or 0) + amount
	PlayerService.markDirty(player)
	return { lager = data.island.eggStock }
end

-- v12/v15: gespeicherten letzten Lauf im gewaehlten Tower setzen (0 = loeschen)
commands.pitprogress = function(player, data, stage: any)
	local reached = math.floor(tonumber(stage) or 0)
	local towerId = data.towers.selected
	data.island.towerProgress[towerId] = if reached > 0 then reached else nil
	PlayerService.markDirty(player)
	return { tower = towerId, towerProgress = data.island.towerProgress }
end

-- v15: Tower waehlen (auch einen noch geschlossenen) und ab `stage` kaempfen.
-- Die Fortsetzungs-Kosten werden vorher gutgeschrieben (Test ohne Grind).
commands.tower = function(player, data, towerId: any, stage: any)
	local id = tostring(towerId or "I")
	local def = TowerConfig.get(id)
	if not def then
		return { error = "Unbekannter Tower: " .. id .. " (I, II, III, Final)" }
	end
	local uid = data.island.equippedUid
	if not uid then
		return { error = "Kein Baerchi ausgeruestet" }
	end
	TowerService.debugOpenAll(data)
	data.towers.selected = id
	local start = math.clamp(math.floor(tonumber(stage) or 1), 1, def.stages)
	local choice = "Fresh"
	if start > 1 then
		data.island.towerProgress[id] = start
		local _, cost = CombatService.getResumeOffer(data, id, "Last")
		if cost > 0 then EconomyService.awardGummiesFlat(player, cost) end
		choice = "Last"
	end
	PlayerService.markDirty(player)
	task.spawn(PetModeService.request, player, "Fight", choice :: any)
	return {
		tower = id, ab = start, deckel = TowerConfig.getStageCap(data.rebirthCount, id, data.towers.records),
		gegnerStage1 = TowerConfig.getEnemyStats(id, start),
	}
end

-- v15: Tower-Rekord direkt setzen (Meilensteine bis dorthin werden ausgezahlt)
commands.towerrecord = function(player, data, towerId: any, stage: any)
	local id = tostring(towerId or "I")
	if not TowerConfig.get(id) then
		return { error = "Unbekannter Tower: " .. id }
	end
	TowerService.debugSetRecord(player, id, tonumber(stage) or 0)
	return { towers = data.towers }
end

-- v15: Deckel des aktuellen Rebirths
commands.rebirthcap = function(_player, data)
	local caps: { [string]: number } = {}
	for _, def in TowerConfig.TOWERS do
		caps[def.id] = TowerConfig.getStageCap(data.rebirthCount, def.id, data.towers.records)
	end
	local capTower, capStage = TowerConfig.getCap(data.rebirthCount)
	return { rebirths = data.rebirthCount, deckelTower = capTower, deckelStage = capStage, proTower = caps }
end

-- Sammel-Update 05.10. (Paket 4.1): beste Stage dieses Lebens setzen und die
-- Rebirth-Bedingung zeigen. D:Invoke("stagebest", "I", 30)
commands.stagebest = function(player, data, towerId: any, stage: any)
	if typeof(towerId) == "string" and TowerConfig.get(towerId) then
		data.island.stageBest[towerId] = math.max(0, math.floor(tonumber(stage) or 0))
		PlayerService.markDirty(player)
	end
	local reqTower, reqStage = TowerConfig.getRebirthRequirement(data.rebirthCount, data.towers.records)
	return {
		stageBest  = data.island.stageBest,
		bedingung  = reqTower .. "/" .. reqStage,
		bereit     = TowerConfig.isRebirthReady(data.rebirthCount, data.island.stageBest, data.towers.records),
	}
end

-- Sammel-Update 05.10. (Paket 8): Inkubator-Stand; "done" macht alle Eier fertig.
commands.incubator = function(player, data, action: any)
	local incubator = data.island.incubator
	if action == "done" then
		for _, entry in incubator.slots do entry.finishAt = os.time() end
		PlayerService.markDirty(player)
	elseif action == "breed" then
		-- INCUBATOR_BREED: jedes Baerchi im Inkubator bruetet sofort ein Ei.
		-- Lazy require: kein weiterer Modul-Local (200er-Grenze).
		local made = require(ServerScriptService.Services.IncubatorService).breedNow(player)
		return { gebruetet = made, baerchis = incubator.breeders }
	end
	return { level = incubator.level, plaetze = incubator.slots, baerchis = incubator.breeders }
end

-- v15: Login-Bonus — so tun, als waeren `days` Tage vergangen
commands.dailyshift = function(player, _data, days: any)
	return LoginBonusService.debugShift(player, math.floor(tonumber(days) or 1))
end

-- v15: Bestenlisten sofort schreiben und neu lesen
commands.lbflush = function(_player, _data)
	return LeaderboardService.flush()
end

-- v15: Teile auf der eigenen Insel zaehlen (Budget: 250 ohne Baerchi-Figuren)
commands.parts = function(player, _data)
	return MapService.countParts(player) or { error = "kein Plot" }
end

-- v15: den aktuellen Spielstand in ein v14-Format zuruckverwandeln (Topf L7,
-- Presse L4, PIT 5, letzter Lauf Stage 12) und durch die Migration schicken —
-- das Ergebnis wird NICHT uebernommen, nur angezeigt (Migrations-Probe).
commands.v14save = function(_player, data)
	local HttpServiceLocal = game:GetService("HttpService")
	local copy = HttpServiceLocal:JSONDecode(HttpServiceLocal:JSONEncode(data))
	copy.version = 14
	copy.towers = nil
	copy.daily = nil
	copy.island.towerProgress = nil
	copy.island.pitRefund = nil
	copy.island.pitLevel = 5
	copy.island.pitProgress = { pitLevel = 5, reachedStage = 12 }
	copy.island.buildings.HoneyRefiner = nil
	copy.island.buildings.HoneyPot   = { id = "HoneyPot",   level = 7, honey = 4, lastProducedAt = os.time() }
	copy.island.buildings.HoneyPress = { id = "HoneyPress", level = 4, honey = 5, lastProducedAt = os.time() }
	local migrated = PlayerMigration.applyDefaults(copy)
	return {
		version   = migrated.version,
		veredler  = migrated.island.buildings.HoneyRefiner,
		erstattung = migrated.island.pitRefund,
		rekorde   = migrated.towers.records,
	}
end

commands.petmode = function(player, data)
	local pitPhase, stage = PitArenaService.getPhase(player)
	return {
		zuHause     = PetModeService.isHome(player),
		pit         = pitPhase,
		stage       = stage,
		event       = EventParticipationService.getPhase(player),
		-- Sammel-Update Paket 1.1: wer haelt die Figur gerade? (UFO-Einfrieren)
		lockHalter  = ActivityLock.owner(player) or "frei",
		entfuehrt   = EventParticipationService.isAbducting(player),
		towerProgress = data.island.towerProgress,
		eggStock    = data.island.eggStock,
		gummies     = data.gummies,
		lastEggAt   = data.island.lastEggAt,
	}
end

commands.pm = function(player, data, mode: any, resume: any)
	PetModeService.request(player, tostring(mode or "Home"), if resume then tostring(resume) :: any else nil)
	return commands.petmode(player, data)
end

commands.fight = function(player, _data, uid: any)
	CombatService.startPitRun(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

-- Alle Honig-Lager sofort fuellen (umgeht die Wartezeit).
-- Ohne das dauert jeder Level-Test 20 Sekunden pro Honig.

-- v15: Waben im Event-Pit legen und Zustand ausgeben
commands.combs = function(player, data, n: any)
	local count = if typeof(n) == "number" then math.clamp(math.floor(n), 0, 100) else 0
	if count > 0 then
		CombService.debugSpawn(count)
	end

	local recycler = data.island.recycler
	local slots = CombService.getSlotInfo()
	return {
		wabenImPit    = CombService.getWorldCount(),
		getragen      = CombService.getCarriedCount(player),
		getragenAlle  = slots.held,
		respawnQueue  = slots.queued,
		slotLimit     = slots.limit,
		recyclerLevel = recycler.level,
		warteschlange = recycler.queued,
	}
end

-- v17: naechsten UFO-Abwurf als Jackpot erzwingen; Stand des Pity-Zaehlers
commands.jackpot = function(_player, _data)
	JackpotRoll.ufo.forceNext = true
	return {
		naechsterIstJackpot = true,
		abwuerfeSeitJackpot = JackpotRoll.ufo.sinceLast,
		abwuerfeGesamt      = JackpotRoll.ufo.total,
		jackpotsGesamt      = JackpotRoll.ufo.jackpots,
		pity                = EventConfig.UFO.JACKPOT_PITY_DROPS,
	}
end

-- v17: Wabenthema setzen ("off" = normal)
commands.combtheme = function(_player, _data, themeId: any)
	local id = if typeof(themeId) == "string" and themeId ~= "off" then themeId else nil
	CombService.setTheme(id)
	local slots = CombService.getSlotInfo()
	return { thema = CombService.getTheme() or "normal", wabenImPit = slots.world, slotLimit = slots.limit }
end

-- v17: Waben einfliegen lassen (wie ein Vulkan-Ausbruch aus der Pit-Mitte)
commands.launch = function(_player, _data, n: any)
	local count = if typeof(n) == "number" then math.clamp(math.floor(n), 1, 30) else 10
	local origin = MapService.getEventPitPosition() + Vector3.new(0, 2, 0)
	return { gestartet = CombService.launchCombs(count, origin), slots = CombService.getSlotInfo() }
end

-- v15: Wabeneinheiten direkt in die Warteschlange des Recyclers legen
commands.queue = function(player, data, n: any)
	local units = if typeof(n) == "number" then math.clamp(math.floor(n), 0, 100000) else 0
	if units > 0 then
		CombRecyclerService.deposit(player, units)
	end

	local recycler = data.island.recycler
	return {
		warteschlange = recycler.queued,
		level         = recycler.level,
		gummies       = data.gummies,
	}
end

-- v15: Recycler-Level direkt setzen (ohne Kosten)
commands.recycler = function(player, data, level: any)
	local recycler = data.island.recycler
	if typeof(level) == "number" then
		recycler.level = CombConfig.clampLevel(level)
		PlayerService.markDirty(player)
	end

	return {
		level         = recycler.level,
		gummiesJeEinheit = CombConfig.getPayPerUnit(recycler.level),
		einheitenProSek  = CombConfig.getSpeed(recycler.level),
		warteschlange = recycler.queued,
	}
end

commands.honey = function(player, data)
	local filled: { [string]: number } = {}

	for _, building in data.island.buildings do
		-- Lager DIESES Gebaeudes auf DIESEM Level: der Bienenstock fasst seit
		-- v7 mehr als die anderen beiden.
		building.honey          = BuildingBehavior.getCapacity(building.id, building.level)
		building.lastProducedAt = os.time()
		filled[building.id]     = building.honey
	end

	PlayerService.markDirty(player)
	return { honey = filled }
end

-- Einen Baerchi fuettern (heilt + gibt XP), so oft wie angegeben
commands.feed = function(player, _data, uid: any, times: any)
	local count = math.clamp(tonumber(times) or 1, 1, 100)

	for _ = 1, count do
		HoneyService.feed(player, tostring(uid))
	end

	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Fusion. Die beiden letzten Argumente sind der Sperr-Schritt aus dem
-- Fusions-Menue (siehe FusionService, Regel C) und duerfen weggelassen werden —
-- dann laeuft alles automatisch.
--   D:Invoke("fuse", uidA, uidB)                   -- alles automatisch
--   D:Invoke("fuse", uidA, uidB, "ability", "B")   -- Skill kommt von B
commands.fuse = function(player, _data, uidA: any, uidB: any, lockedProperty: any, lockedFrom: any)
	local property = if lockedProperty ~= nil then tostring(lockedProperty) else nil
	local from     = if lockedFrom ~= nil then tostring(lockedFrom) else nil

	FusionService.fuse(player, tostring(uidA), tostring(uidB), property :: any, from :: any)
	return commands.list(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v8: Promotion, Charms, Event-Teilnahme
--------------------------------------------------------------------------------

-- Befoerdern. Legt die noetigen Duplikate NICHT selbst an — wer testen will,
-- ruft vorher mehrfach "add <configId>" auf. Genau so merkt man, ob die
-- Material-Pruefung tut, was sie soll.
commands.promote = function(player, _data, uid: any)
	PromotionService.promote(player, tostring(uid))
	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Charms wuerfeln. Kostet echte GoldGummies — vorher "give 0 100000".
commands.roll = function(player, _data, uid: any, times: any)
	CharmService.rollCharms(player, tostring(uid), tonumber(times) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Alle acht Slots eines Baerchis im Klartext.
commands.charms = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local bySlot: { [number]: any } = {}
	for _, charm in baerchi.charms or {} do
		bySlot[charm.slot] = charm
	end

	local out = {}
	for slot = 1, CharmConfig.SLOT_COUNT do
		local charm = bySlot[slot]
		out[slot] = {
			slot     = CharmConfig.SLOT_NUMERALS[slot],
			offen    = CharmConfig.isSlotUnlocked(slot, baerchi.promotionLevel or 0),
			abPromo  = CharmConfig.getUnlockPromotion(slot),
			rarity   = if charm then charm.rarity else nil,
			effekt   = if charm then CharmConfig.describe(charm) else nil,
			gesperrt = if charm then charm.locked else nil,
		}
	end

	return { promotion = baerchi.promotionLevel or 0, slots = out }
end

-- Einen Charm-Slot sperren/freigeben.
commands.lock = function(player, _data, uid: any, slot: any)
	CharmService.toggleLock(player, tostring(uid), tonumber(slot) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Den ausgeruesteten Baerchi zum Event schicken bzw. zurueckholen.
commands.event = function(player, _data)
	EventParticipationService.sendToEvent(player)
	return { unterwegs = true }
end

commands.recall = function(player, _data)
	EventParticipationService.recall(player)
	return { unterwegs = true }
end

--------------------------------------------------------------------------------
-- v10: Eier legen
--------------------------------------------------------------------------------

-- Legt sofort ein Ei, ohne auf das Intervall zu warten. Mehrfach aufrufen, um
-- den Plot zu fuellen und die Obergrenze zu pruefen.
commands.lay = function(player, _data, times: any)
    local count  = math.clamp(tonumber(times) or 1, 1, 30)
    local laid   = 0

    for _ = 1, count do
        if EggLayService.layNow(player) then
            laid += 1
        else
            break   -- Obergrenze erreicht oder kein Baerchi ausgeruestet
        end
    end

    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Was gerade herumliegt, plus die Werte des ausgeruesteten Legers.
commands.eggs = function(_player, data)
    local out = {}
    for _, egg in data.island.laidEggs or {} do
        table.insert(out, { uid = egg.uid, typ = egg.eggType })
    end

    local uid     = data.island.equippedUid
    local baerchi = if uid then data.island.baerchis[uid] else nil

    local rate: any = "kein Baerchi ausgeruestet"
    local chancen: any = nil

    if baerchi then
        local online  = EggCalculator.getLayIntervalSeconds(baerchi, false)
        local offline = EggCalculator.getLayIntervalSeconds(baerchi, true)

        rate = {
            configId       = baerchi.configId,
            level          = baerchi.level,
            eggStufe       = (baerchi.statLevels :: any).egg or 0,
            mutation       = baerchi.mutation,
            sekundenOnline = if online then math.floor(online + 0.5) else nil,
            sekundenOffline= if offline then math.floor(offline + 0.5) else nil,
        }

        chancen = {}
        for _, chance in EggCalculator.getChances(baerchi) do
            table.insert(chancen, string.format("%s %.0f%%", chance.eggType, chance.percent))
        end
    end

    return {
        liegen  = #out,
        maximum = EggConfig.MAX_UNCOLLECTED_EGGS,
        eier    = out,
        lager   = data.island.eggStock,
        leger   = rate,
        chancen = chancen,
    }
end

-- Alle herumliegenden Eier einsammeln (dasselbe wie der Knopf auf der Karte).
commands.collect = function(player, _data)
    EggLayService.collectAll(player)
    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Die Zeitmarke kuenstlich in die Vergangenheit setzen und danach nachrechnen
-- lassen — so laesst sich das OFFLINE-Nachholen pruefen, ohne den Server zu
-- verlassen. Der naechste Tick (max. 5s) legt dann die faelligen Eier.
--
-- Achtung: der Tick rechnet mit der ONLINE-Rate. Das echte Offline-Verhalten
-- (langsamer, siehe EggConfig.OFFLINE_SLOWDOWN) sieht man nur beim Rejoin.
commands.eggtime = function(player, data, minutes: any)
    local back = math.clamp(tonumber(minutes) or 30, 1, 10000)
    data.island.lastEggAt = os.time() - back * 60
    PlayerService.markDirty(player)

    return { zurueckgestellt = back .. " Minuten", hinweis = "naechster Tick legt nach (max. 5s)" }
end

-- Die laufende Phase sofort beenden. Zweimal aufgerufen bekommt man also aus
-- der Pause heraus ein vollstaendiges Event samt Belohnung, ohne acht Minuten
-- zu warten:
--   D:Invoke("skipevent")   -- Pause vorbei, Event laeuft
--   D:Invoke("event")       -- Baerchi hinschicken, ankommen lassen
--   D:Invoke("skipevent")   -- Event vorbei → Stat-Stufe wird vergeben
commands.skipevent = function(_player, _data)
	EventService.skipPhase()

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		belohnung    = if active then Loc.resolve(EventConfig.describeReward(active)) else nil,
		naechstes    = EventService.getNext().displayName,
		restSekunden = EventService.getRemainingSeconds(),
	}
end

-- Der ganze Katalog mit Belohnung, in der Reihenfolge, in der die Events
-- laufen. Praktisch, um die ids fuer "startevent" nachzuschlagen.
commands.events = function(_player, _data)
	local katalog = {}
	for index, def in EventConfig.EVENTS do
		table.insert(katalog, string.format(
			"%d. %s (%s) — %s",
			index, def.displayName, def.id, Loc.resolve(EventConfig.describeReward(def))
		))
	end

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		restSekunden = EventService.getRemainingSeconds(),
		naechstes    = EventService.getNext().displayName,
		takt         = string.format(
			"individuelle Dauer je Event / %ds Pause",
			EventConfig.EVENT_GAP_SECONDS
		),
		katalog      = katalog,
	}
end

-- Ein BESTIMMTES Event sofort starten, statt sich durch den Zyklus zu warten.
-- Ein voller Durchlauf durch alle zehn Events dauert 80 Minuten — ohne diesen
-- Befehl waere z.B. der Mutations-Sturm praktisch nicht testbar.
--
-- Laeuft gerade ein anderes Event, wird es vorher ordentlich beendet (die
-- Anwesenden bekommen also noch ihre Belohnung, siehe EventService.startById).
commands.startevent = function(_player, _data, id: any)
	local eventId = tostring(id or "")

	if not EventService.startById(eventId) then
		local ids = {}
		for _, def in EventConfig.EVENTS do
			table.insert(ids, def.id)
		end
		return { error = "Unbekannte Event-id: " .. eventId, verfuegbar = ids }
	end

	local active = EventService.getActive()
	return {
		gestartet    = if active then active.displayName else "?",
		belohnung    = if active then Loc.resolve(EventConfig.describeReward(active)) else nil,
		restSekunden = EventService.getRemainingSeconds(),
		hinweis      = "jetzt 'event' aufrufen, um den Baerchi hinzuschicken — er muss beim ENDE dort stehen",
	}
end

commands.recycle = function(player, _data, uid: any)
	RecycleService.recycle(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.upgrade = function(player, _data, buildingId: any)
	IslandService.upgradeBuilding(player, buildingId)
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.rebirth = function(player, _data)
	RebirthService.rebirth(player)
	return commands.info(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v14: Ei-Baum
--------------------------------------------------------------------------------

commands.tree = function(_player, data)
	local out = { blueprints = data.eggTree.blueprints, rebirths = data.rebirthCount }
	for _, eggId in EggConfig.getOrderedIds() do
		local p = EggTree.getProgress(data, eggId)
		local parts = {}
		for _, c in p.conditions do
			local label = c.kind .. (if c.egg then ":" .. c.egg elseif c.rarity then ":" .. c.rarity else "")
			table.insert(parts, string.format("%s %d/%d%s", label, c.have, c.need, if c.done then " ok" else ""))
		end
		out[string.format("%02d %s", EggConfig.data[eggId].sortOrder, eggId)] = string.format("%s | hatched %d | lager %d | %s",
			if p.unlocked then "FREI" else "zu", data.eggTree.hatched[eggId] or 0,
			data.island.eggStock[eggId] or 0, table.concat(parts, ", "))
	end
	return out
end

commands.unlock = function(player, data, eggType: any)
	if eggType == "all" then
		for _, eggId in EggConfig.getOrderedIds() do
			EggTreeService.forceUnlock(player, data, eggId, "debug")
		end
	elseif typeof(eggType) == "string" and EggConfig.data[eggType :: Types.EggType] then
		EggTreeService.forceUnlock(player, data, eggType :: Types.EggType, "debug")
	else
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.hatched = function(player, data, eggType: any, count: any)
	if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	data.eggTree.hatched[eggType] = math.max(0, math.floor(tonumber(count) or 0))
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.blueprint = function(player, data, amount: any)
	EggTreeService.grantBlueprint(player, data, tonumber(amount) or 1)
	PlayerService.markDirty(player)
	return { blueprints = data.eggTree.blueprints }
end

commands.useblueprint = function(player, data, eggType: any)
	local ok = EggTreeService.useBlueprint(player, eggType)
	return { ok = ok, tree = commands.tree(player, data) }
end

commands.press = function(player, data, eggType: any, path: any)
	local result = EggTreeService.press(player, eggType, path)
	return { result = result, stock = data.island.eggStock }
end

commands.setrebirth = function(player, data, count: any)
	data.rebirthCount = math.max(0, math.floor(tonumber(count) or 0))
	data.rebirthMult  = EconomyConfig.getRebirthMult(data.rebirthCount)
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

-- Spielstand fuer Tests sichern und zuruecksetzen. Die Kopie liegt nur im
-- Speicher dieses Servers (nicht im DataStore).
local HttpService = game:GetService("HttpService")
local _snapshot: string? = nil

commands.snapshot = function(_player, data)
	_snapshot = HttpService:JSONEncode(data)
	return { ok = true, bytes = #(_snapshot :: string) }
end

commands.restore = function(player, data)
	if not _snapshot then return { error = "Kein Snapshot" } end
	local saved = HttpService:JSONDecode(_snapshot :: string)
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in saved do (data :: any)[k] = v end
	MapService.rebuildIsland(player, data.island)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return { ok = true }
end

-- HBB Paket 0: feste Test-Zustaende fuer Playtests und Studio-Testschritte.
--   fresh   = Startstand eines neuen Kontos (createdAt = jetzt → Trichter misst)
--   hatch10 = fresh + zehn geoeffnete Basis-Eier
--   tower1  = hatch10 + Tower I geschafft (Rekord 30, Meilensteine ausgezahlt)
--
-- Studio spielt gegen den ECHTEN DataStore. Deshalb verlangt der Befehl einen
-- vorherigen "snapshot"; zurueck geht es mit "restore". Der Snapshot liegt nur
-- im Speicher dieses Servers — vor "Stop" also restore aufrufen.
--
-- Der Baerchi sollte zu Hause stehen (kein Kampf, kein Event), sonst haelt ein
-- anderer Service noch die alte Figur.
local TEST_STATES = { fresh = true, hatch10 = true, tower1 = true }
local TEST_HATCH_COUNT = 10
local TEST_TOWER_RECORD = 30

commands.state = function(player, data, name: any)
	local stateName = tostring(name or "")
	if not TEST_STATES[stateName] then
		return { error = "Unbekannter Zustand: " .. stateName, verfuegbar = { "fresh", "hatch10", "tower1" } }
	end
	if not _snapshot then
		return { error = "Erst D:Invoke(\"snapshot\") — Studio schreibt in den echten Spielstand" }
	end

	-- 1. fresh: alles ersetzen ausser Sitzungs-Sperre und Sprache
	local session  = (data :: any).session
	local language = data.language
	local fresh = PlayerService.buildDefaultData()
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in fresh :: any do (data :: any)[k] = v end
	;(data :: any).session = session
	data.language = language
	MapService.rebuildIsland(player, data.island)
	FunnelService.debugReset(player)

	-- 2. hatch10: ueber den echten Weg oeffnen, damit Zaehler, Index und
	-- Auto-Ausruesten genau wie im Spiel laufen.
	if stateName == "hatch10" or stateName == "tower1" then
		data.island.eggStock.BasicEgg = (data.island.eggStock.BasicEgg or 0) + TEST_HATCH_COUNT
		for _ = 1, TEST_HATCH_COUNT do
			EggService.openEgg(player, "BasicEgg")
		end
	end

	-- 3. tower1: Rekord setzen, Meilensteine wie bei "towerrecord"
	if stateName == "tower1" then
		TowerService.debugSetRecord(player, "I", TEST_TOWER_RECORD)
	end

	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return {
		ok = true,
		zustand = stateName,
		baerchis = countBaerchis(data),
		lager = data.island.eggStock,
		rekorde = data.towers.records,
		hinweis = "Zurueck mit D:Invoke(\"restore\")",
	}
end

-- Ein einzelner Kampf mit Runden-Log (Faehigkeiten pruefen).
commands.skilltest = function(_player, _data, configId: any, stage: any)
	local b = BaerchiFactory.create(tostring(configId), { level = 20 })
	if not b then return { error = "Unbekannter Baerchi" } end
	local def = BaerchiConfig.getById(b.configId)
	local stats = CombatCalculator.getEffectiveStats(b, (def :: any).baseStats)
	local es = CombatConfig.getEnemyStats(1, tonumber(stage) or 20)
	local me = { uid = "me", stats = stats, hp = stats.maxHp, charge = 0 }
	local en = { uid = "en", stats = es, hp = es.maxHp, charge = 0 }
	local r = CombatCalculator.simulate(me, en)
	local lines = {}
	for i, e in r.log do
		if i > 40 then break end
		table.insert(lines, string.format("%s r%d %s dmg %d heal %d abs %d | A %d B %d %s",
			e.actor, e.roundNumber, e.skillId or "-", e.damage, e.heal, e.absorbed,
			e.attackerHpAfter, e.defenderHpAfter, if e.effects then table.concat(e.effects, ",") else ""))
	end
	return { winner = r.winnerUid, rounds = r.rounds, skillUses = r.skillUses, log = lines }
end

commands.help = function()
	return {
		"info", "give <gummies> <gold>", "list",
		"add <configId> <level> [mutation]", "stats <uid>",
		"building <id> <level>",
		"hatch <eggType>", "egg <eggType> [anzahl]", "pitprogress <stage>", "honey", "feed <uid> <times>",
		"fight <uid>",
		"fuse <uidA> <uidB> [ability|level|eggs] [A|B]",
		"recycle <uid>", "upgrade <buildingId>", "rebirth",

		-- v8
		"promote <uid>", "charms <uid>", "roll <uid> [anzahl]", "lock <uid> <slot>",
		"event", "recall", "skipevent", "events", "startevent <eventId>",

		-- v10
		"eggs", "lay [anzahl]", "collect", "eggtime <minuten>",

		-- v12
		"petmode", "pm <Event|Fight|Home> [Fresh|Percent|Last]",

		-- v14
		"tree", "unlock <eggType|all>", "hatched <eggType> <n>", "blueprint [n]",
		"useblueprint <eggType>", "press <eggType> [Gold|Kristall|Void]", "setrebirth <n>",
		"skilltest <configId> [stage]", "snapshot", "restore",
		-- HBB Paket 0
		"state <fresh|hatch10|tower1>  (erst snapshot!)",

		-- v15
		"combs [anzahl]", "queue <einheiten>", "recycler [level]",

		-- v15 (Tower/Gebaeude/Angeben/Login-Bonus)
		"tower <I|II|III|Final> <stage>", "towerrecord <id> <stage>", "rebirthcap",
		"dailyshift <tage>", "lbflush", "parts", "v14save",

		-- v17
		"jackpot", "combtheme <themeId|off>", "launch [anzahl]",
	}
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function DebugService.init()
	if not RunService:IsStudio() then
		return   -- im Live-Spiel gibt es diesen Service schlicht nicht
	end

	local existing = ServerScriptService:FindFirstChild(BINDABLE_NAME)
	if existing then existing:Destroy() end

	local bindable = Instance.new("BindableFunction")
	bindable.Name   = BINDABLE_NAME
	bindable.Parent = ServerScriptService

	bindable.OnInvoke = function(command: any, ...)
		local name = tostring(command or "help")
		local handler = commands[name]
		if not handler then
			return { error = "Unbekannter Befehl: " .. name, verfuegbar = commands.help() }
		end

		if name == "help" then
			return commands.help()
		end

		local player, data, reason = requireData()
		if not player or not data then
			return { error = reason }
		end

		local ok, result = pcall(handler, player, data, ...)
		if not ok then
			return { error = tostring(result) }
		end
		return result
	end

	print("[DebugService] Initialisiert | Command Bar: game.ServerScriptService." .. BINDABLE_NAME .. ":Invoke(\"help\")")
end

return DebugService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">EventParticipationService</string><ProtectedString name="Source"><![CDATA[--!strict
-- EventParticipationService.luau
-- ServerScriptService/Services/EventParticipationService.luau
--
-- Einzige Zustaendigkeit:
--   - Den ausgeruesteten Baerchi eines Spielers auf Knopfdruck in die
--     Event-Area in der Weltmitte schicken und wieder zurueckholen
--   - Beim ENDE eines Events an jeden dort tatsaechlich anwesenden Baerchi
--     die Belohnung dieses Events auszahlen
--
-- WAS es gibt, steht ausschliesslich in EventConfig (Stat-Fokus und Bonus je
-- Event) — hier steht nur, WIE es ausgezahlt wird. Waehrungen laufen dabei
-- ueber EconomyService, nie ueber einen direkten Feldzugriff: die Projektregel
-- "nur EconomyService aendert Waehrungen" gilt auch fuer Event-Belohnungen.
--
-- ============================================================
-- WARUM DAS EIN EIGENER SERVICE IST
-- ============================================================
-- EventService faehrt den Zyklus und weiss nichts von Spielern. MapService
-- baut Geometrie. BaerchiAutopilotService laesst die Figur zum Honig-Teich
-- laufen. Die Teilnahme braucht alle drei, gehoert aber in keinen davon: sie
-- ist die erste Stelle im Projekt, an der eine Spieleraktion, ein Weltzustand
-- (laeuft ein Event?) und Spielerdaten (Stat-Level) zusammenkommen.
--
-- ============================================================
-- WARUM DIE ANWESENHEIT SERVERSEITIG FESTGESTELLT WIRD
-- ============================================================
-- Der Client schickt ausschliesslich "ich moechte hin" bzw. "hol ihn zurueck".
-- WO die Figur danach steht, bestimmt allein dieser Service (er bewegt sie
-- selbst) und er prueft es beim Verteilen der Belohnung noch einmal an der
-- tatsaechlichen Weltposition nach. Ein Client, der "ich bin am Event"
-- behauptet, bekommt davon nichts — sonst waere der Stat-Fortschritt in fuenf
-- Minuten nachgebaut.
--
-- ============================================================
-- BEWUSST EINFACH GEHALTEN (Vorgabe des Projektinhabers)
-- ============================================================
-- Genau EIN Baerchi pro Spieler (der ausgeruestete — nur er hat ueberhaupt
-- eine Figur in der Welt), kein Auto-Send, kein Offline-Fortschritt, keine
-- mehrfache Belegung. Das groessere AFK-Grind-System um Events herum ist laut
-- Projektinhaber ausdruecklich ein spaeterer, eigener Auftrag. Wer das hier
-- erweitert: die Stelle dafuer ist _present (eine Liste statt eines Eintrags)
-- und awardStatLevel/awardBonus (die schon jetzt pro Baerchi arbeiten).

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local PromotionConfig  = require(ReplicatedStorage.Config.PromotionConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggTree          = require(ReplicatedStorage.Modules.EggTree)

local FigureWalker    = require(ServerScriptService.Util.FigureWalker)
local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)
local FigureFX        = require(ServerScriptService.Util.FigureFX)
local ActivityLock    = require(ServerScriptService.Util.ActivityLock)
local RateLimiter     = require(ServerScriptService.Util.RateLimiter)
local PlayerService   = require(ServerScriptService.Services.PlayerService)
local EconomyService  = require(ServerScriptService.Services.EconomyService)
local MapService      = require(ServerScriptService.Services.MapService)
local EventService    = require(ServerScriptService.Services.EventService)
local EventHandlers   = require(ServerScriptService.Services.EventHandlers)
local EggTreeService  = require(ServerScriptService.Services.EggTreeService)
local EggService      = require(ServerScriptService.Services.EggService)
local CombRecyclerService = require(ServerScriptService.Services.CombRecyclerService)
local FunnelService = require(ServerScriptService.Services.FunnelService)  -- HBB: Messpunkte
local Loc           = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)

local EventParticipationService = {}

--------------------------------------------------------------------------------
-- Konstanten
--------------------------------------------------------------------------------

-- Halter-Name fuer ActivityLock. Wird fuer die GESAMTE Zeit gehalten, in der
-- der Baerchi unterwegs zum Event ist oder dort steht — sonst wuerde ihn der
-- Autopilot mitten am Event zum Honig-Teich zurueckrufen.
--
-- Bewusste Folge: waehrend der Teilnahme isst der Baerchi nicht. Das ist der
-- Preis fuers Hinschicken und macht die Entscheidung erst zu einer.
local LOCK_HOLDER = "EventParticipation"

-- Sammel-Update 1.1: so lange darf eine UFO-Entfuehrung hoechstens dauern
-- (Hochziehen 2 s + Transport 3 s + Warten + Absetzen 1,5 s, grosszuegig
-- aufgerundet). Danach greift der Waechter in tick().
local ABDUCT_WATCHDOG_SECONDS = EventConfig.UFO.ABDUCT_WAIT_SECONDS + 30

-- Der Weg von einem Plot (Ring-Radius 212) in die Mitte ist lang. Mit der
-- normalen MapConfig.WALK_SPEED waere man ueber zehn Sekunden unterwegs —
-- deshalb hier doppeltes Tempo: sichtbar hinlaufen ja, Geduldsprobe nein.
local EVENT_WALK_SPEED = MapConfig.WALK_SPEED * 2

-- Wie weit vom Mittelpunkt entfernt ein Baerchi auf dem Podest steht, als
-- Anteil des Podest-Radius. Bewusst nicht 0: bei mehreren Spielern staenden
-- sonst alle Figuren ineinander. Jeder steht auf SEINER Seite (Richtung des
-- eigenen Plots, siehe standPosition) — dieselben acht Richtungen, in denen
-- auch die Zaunluecken sitzen.
local STAND_RADIUS_FACTOR = 0.55

-- Wie oft nachgesehen wird, ob eine Teilnahme noch gilt (Figur weg, Schloss
-- von einem Kampf uebernommen, Baerchi nicht mehr ausgeruestet). Muss nicht
-- schnell sein — es geht nur darum, dass ein ungueltiger Zustand nicht bis zum
-- Event-Ende liegen bleibt.
local CHECK_INTERVAL = 4

-- Wie sich der Baerchi waehrend eines Events bewegt. Die Zuordnung zum
-- Event-Typ steht in EventConfig.EventDef.action — hier nur, wie sich das in
-- Zahlen der Ruhe-Animation uebersetzt.
--
-- Bewusst ueber die vorhandene Idle-Bewegung statt ueber eigene Animationen:
-- die Baerchi-Meshes sind nicht gerigt (siehe FigureWalker, Kopf-Kommentar),
-- eine echte "faengt Bienen"-Animation gaebe es fuer dieses Modell gar nicht.
-- Der Spieler soll sehen, DASS sein Baerchi mitmacht — mehr ist fuer das
-- Basis-Spiel nicht gefordert.
local ACTION_MOTION: { [string]: { height: number, rate: number } } = {
	bounce = { height = 1.60, rate = 2.20 },   -- kraeftiges Huepfen
	lean   = { height = 0.35, rate = 3.00 },   -- schnelles, flaches Nicken
	spin   = { height = 0.80, rate = 1.10 },   -- ruhiges Wiegen
}

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

type Presence = {
	baerchiUid : string,
	homeFoot   : Vector3,   -- wohin zurueckgelaufen wird
	standFoot  : Vector3,   -- wo auf dem Podest gestanden wird
	arrivedAt  : number,    -- os.time(), nur fuers Log

	-- Von Event-Handlern genutzt (siehe buildApi):
	player     : Player?,
	figure     : Model?,
	busy       : boolean?,        -- Figur laeuft gerade (walkTo)
	cancelWalk : boolean?,        -- laufende Bewegung abbrechen
	abducting  : boolean?,        -- UFO hat die Figur gerade
}

-- Spieler, deren Baerchi gerade AM Event steht (fertig angekommen).
local _present: { [Player]: Presence } = {}

-- Spieler, deren Baerchi gerade laeuft (hin oder zurueck). Verhindert, dass
-- zwei Laufbewegungen gleichzeitig an derselben Figur ziehen.
local _walking: { [Player]: boolean } = {}

-- Laufender Event-Handler (siehe Services/EventHandlers) samt Token. Der Token
-- steigt bei jedem Start/Ende; api.running() vergleicht damit.
local _session: any = nil
local _sessionToken = 0

-- Spieler, die waehrend einer Handler-Bewegung "zurueck" gedrueckt haben.
local _recallPending: { [Player]: boolean } = {}

-- v12: Richtung des laufenden Wegs ("to" = zum Event, "back" = heim) fuer die
-- Pet-Leiste, und der Wunsch, einen Hinweg abzubrechen (Zurueckholen, bevor
-- der Baerchi angekommen ist).
local _walkDir: { [Player]: string } = {}
local _cancelTo: { [Player]: boolean } = {}

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function fail(player: Player, action: string, reason: Types.LocMsg | string)
	Remotes.ActionFailed:FireClient(player, action, reason)
end

local function notifyPresence(player: Player, atEvent: boolean, baerchiUid: string?)
	Remotes.EventPresenceChanged:FireClient(player, atEvent, baerchiUid)
end

local function footPosOf(model: Model): Vector3
	return FigurePlacement.footOf(model)   -- Sammel-Update 1.2
end

-- Der Standplatz dieses Spielers auf dem Podest: auf der Seite, aus der er
-- kommt. Ohne Plot-Information (sollte nicht vorkommen) faellt es auf die
-- Mitte zurueck — lieber uebereinander stehen als gar nicht ankommen.
local function standPosition(player: Player): Vector3
	local center = MapService.getEventPitPosition()
	local plot   = MapService.getPlotCFrame(player)

	if not plot then
		return center
	end

	local flat = Vector3.new(plot.Position.X - center.X, 0, plot.Position.Z - center.Z)
	if flat.Magnitude < 1e-3 then
		return center
	end

	return center + flat.Unit * (MapService.getEventPitRadius() * STAND_RADIUS_FACTOR)
end

-- Steht diese Figur tatsaechlich (noch) auf dem Podest?
-- Das ist die Pruefung, die den Fortschritt vor gefaelschten Client-Meldungen
-- schuetzt — siehe Kopf-Kommentar.
local function isOnEventFloor(model: Model): boolean
	local center = MapService.getEventPitPosition()
	local foot   = footPosOf(model)
	local flat   = Vector3.new(foot.X - center.X, 0, foot.Z - center.Z)

	return flat.Magnitude <= MapService.getEventPitRadius()
end

-- Die Bewegung, die der Baerchi waehrend des laufenden Events zeigt.
local function playEventMotion(model: Model)
	local active = EventService.getActive()
	local motion = if active then ACTION_MOTION[active.action] else nil

	if not motion then
		-- Kein Event aktiv: der Baerchi steht einfach dekorativ herum und
		-- atmet. Ausdrueckliche Vorgabe — das ist kein Fehlerzustand, und
		-- niemand muss ihn deshalb zurueckholen.
		FigureFX.idleBob(model, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
		return
	end

	FigureFX.idleBob(model, { height = motion.height, rate = motion.rate })
end

--------------------------------------------------------------------------------
-- Hin und zurueck
--------------------------------------------------------------------------------

-- Gibt true zurueck, wenn der Baerchi losgeht.
function EventParticipationService.sendToEvent(player: Player): boolean
	local data = PlayerService.getData(player)
	if not data then return false end

	if _present[player] or _walking[player] then
		fail(player, "RequestPetMode", Loc.msg("err.event_already_away"))
		return false
	end

	local uid = data.island.equippedUid
	if not uid or not data.island.baerchis[uid] then
		fail(player, "RequestPetMode", Loc.msg("err.event_no_equipped"))
		return false
	end

	local figure = MapService.getBaerchiModel(player, uid)
	if not figure then
		fail(player, "RequestPetMode", Loc.msg("err.event_not_on_plot"))
		return false
	end

	-- v12: ein vom Spieler ausgeloester Weg zum Event hat Vorrang vor dem
	-- Honig-Autopilot (wie der Kampf). Dem Autopilot wird das Schloss
	-- abgenommen — er bemerkt das selbst und bricht sauber ab. Haelt es
	-- jemand anderes (Kampf), wird weiter abgelehnt; die Reihenfolge regelt
	-- dann PetModeService.
	if ActivityLock.owner(player) == "Autopilot" then
		ActivityLock.forceAcquire(player, LOCK_HOLDER)
	elseif not ActivityLock.tryAcquire(player, LOCK_HOLDER) then
		fail(player, "RequestPetMode", Loc.msg("err.baerchi_busy"))
		return false
	end

	_walking[player]  = true
	_walkDir[player]  = "to"
	_cancelTo[player] = nil

	task.spawn(function()
		local ok, err = pcall(function()
			FigureFX.stopIdle(figure)

			local homeFoot  = footPosOf(figure)
			local standFoot = standPosition(player)

			local function cancelled(): boolean
				return ActivityLock.owner(player) ~= LOCK_HOLDER
					or player.Parent == nil
					or figure.Parent == nil
					or MapService.getBaerchiModel(player, uid) ~= figure
			end

			FigureWalker.walk(figure, homeFoot, standFoot, {
				speed       = EVENT_WALK_SPEED,
				isCancelled = function(): boolean
					return cancelled() or _cancelTo[player] == true
				end,
			})

			if cancelled() then
				return
			end

			-- v12: auf dem Hinweg zurueckgeholt — von hier aus umkehren.
			if _cancelTo[player] then
				_cancelTo[player] = nil
				_walkDir[player]  = "back"
				FigureWalker.walk(figure, footPosOf(figure), homeFoot, {
					speed       = EVENT_WALK_SPEED,
					isCancelled = cancelled,
				})
				if not cancelled() then
					FigurePlacement.place(figure, homeFoot, figure:GetPivot().Rotation)
					FigureFX.idleBob(figure, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end
				return
			end

			-- FigureWalker haelt die Y-Koordinate des STARTPUNKTES ueber die
			-- ganze Strecke (siehe dort). Das Event-Podest liegt hoeher als der
			-- Plot, also wird die Figur hier noch einmal sauber auf die
			-- Podest-Oberflaeche gesetzt — mit Blick zur Mitte.
			FigurePlacement.placeLookingAt(figure, standFoot, MapService.getEventPitPosition())

			_present[player] = {
				player     = player,
				baerchiUid = uid,
				homeFoot   = homeFoot,
				standFoot  = standFoot,
				arrivedAt  = os.time(),
			}

			playEventMotion(figure)
			notifyPresence(player, true, uid)

			print("[EventParticipationService]", player.Name, "| am Event:", uid)
		end)


		_walking[player]  = nil
		_walkDir[player]  = nil
		_cancelTo[player] = nil

		if not ok then
			warn("[EventParticipationService] Hinweg fehlgeschlagen:", err)
		end

		-- Nicht angekommen (abgebrochen oder Fehler): Schloss wieder freigeben,
		-- sonst bliebe der Spieler dauerhaft blockiert.
		if not _present[player] then
			ActivityLock.release(player, LOCK_HOLDER)
			notifyPresence(player, false, nil)
		end
	end)

	return true
end

-- Gibt true zurueck, wenn der Rueckweg angestossen wurde (oder schon laeuft).
function EventParticipationService.recall(player: Player): boolean
	local presence = _present[player]
	if not presence then
		-- v12: noch auf dem Hinweg — umkehren lassen.
		if _walking[player] and _walkDir[player] == "to" then
			_cancelTo[player] = true
			return true
		end
		return _walking[player] == true
	end

	if presence.abducting then
		fail(player, "RequestPetMode", Loc.msg("err.event_ufo"))
		return false
	end

	-- Ein Event-Handler bewegt die Figur gerade: Bewegung abbrechen, der
	-- Rueckweg startet direkt danach (siehe walkTo in buildApi).
	if presence.busy then
		_recallPending[player] = true
		presence.cancelWalk = true
		return true
	end

	if _walking[player] then
		return true   -- laeuft schon zurueck
	end

	local figure = MapService.getBaerchiModel(player, presence.baerchiUid)

	-- Figur ist weg (Equip-Wechsel, Rebirth, Insel neu gebaut): Zustand
	-- einfach aufraeumen statt einen Rueckweg zu erfinden.
	if not figure then
		_present[player] = nil
		ActivityLock.release(player, LOCK_HOLDER)
		notifyPresence(player, false, nil)
		return true
	end

	_walking[player]  = true
	_walkDir[player]  = "back"
	_present[player]  = nil
	notifyPresence(player, false, presence.baerchiUid)

	task.spawn(function()
		local ok, err = pcall(function()
			FigureFX.stopIdle(figure)

			local function cancelled(): boolean
				return ActivityLock.owner(player) ~= LOCK_HOLDER
					or player.Parent == nil
					or figure.Parent == nil
			end

			FigureWalker.walk(figure, footPosOf(figure), presence.homeFoot, {
				speed       = EVENT_WALK_SPEED,
				isCancelled = cancelled,
			})

			if cancelled() then
				return
			end

			FigurePlacement.place(figure, presence.homeFoot, figure:GetPivot().Rotation)
			FigureFX.idleBob(figure, {
				height = MapConfig.IDLE_BOB_HEIGHT,
				rate   = MapConfig.IDLE_BOB_RATE,
			})
		end)

		_walking[player] = nil
		_walkDir[player] = nil
		ActivityLock.release(player, LOCK_HOLDER)

		if not ok then
			warn("[EventParticipationService] Rueckweg fehlgeschlagen:", err)
		end
	end)

	return true
end

--------------------------------------------------------------------------------
-- Belohnung am Event-Ende
--------------------------------------------------------------------------------

-- Vergibt EINE Stat-Stufe an diesen Baerchi.
--
-- `focus` ist der Stat, auf den das laufende Event ausgelegt ist
-- (EventConfig.EventDef.statFocus) — bei den Trainings-Events also fest, bei
-- allen anderen nil.
--
-- Reihenfolge:
--   1. Der Fokus-Stat, sofern er noch unter der Rarity-Obergrenze liegt.
--   2. Sonst zufaellig unter allen Stats, die noch Luft haben. Wuerde man
--      blind aus allen fuenf ziehen, liefe eine Teilnahme umso oefter ins
--      Leere, je weiter der Baerchi schon ist — und ausgerechnet dann, wenn
--      der Spieler am meisten Zeit investiert hat.
--
-- Dass ein gedeckelter Fokus-Stat auf Zufall zurueckfaellt statt nichts zu tun,
-- ist Absicht: sonst waere ein Trainings-Event fuer genau die Spieler wertlos,
-- die es am laengsten besucht haben.
--
-- Gibt den gewaehlten Stat-Schluessel zurueck, oder nil wenn schon ALLES am
-- Anschlag ist.
local function awardStatLevel(baerchi: Types.Baerchi, focus: string?): string?
	local cap = PromotionConfig.getStatCap(baerchi.rarity)

	-- Einmal auf `any` umgebogen und ab dann unter eigenem Namen benutzt: die
	-- Stat-Schluessel kommen als String herein (PromotionConfig.GROWABLE_STATS
	-- bzw. EventConfig.statFocus), und Types.StatLevels hat feste Felder.
	-- Ausserdem darf so keine Zuweisung mehr mit "(" beginnen — eine Zeile, die
	-- mit einer Klammer anfaengt, liest Luau als Fortsetzung der vorherigen.
	local levels = baerchi.statLevels :: any

	if focus and (levels[focus] or 0) < cap then
		levels[focus] = (levels[focus] or 0) + 1
		return focus
	end

	local candidates: { string } = {}
	for _, key in PromotionConfig.GROWABLE_STATS do
		if (levels[key] or 0) < cap then
			table.insert(candidates, key)
		end
	end

	if #candidates == 0 then
		return nil
	end

	local key = candidates[math.random(1, #candidates)]
	levels[key] = (levels[key] or 0) + 1

	return key
end

-- Zahlt den Zusatz-Ertrag eines Events aus (EventConfig.EventDef.bonus).
--
-- Gibt zurueck:
--   1. eine Nachricht (LocMsg, "+1x Goldenes Ei"), oder nil wenn es
--      nichts zu melden gibt (Event ohne Bonus, oder Mutations-Wurf daneben),
--   2. die neue Mutation, falls dieses Event dem Baerchi eine verschafft hat.
--
-- Der Baerchi wird hier NUR beim Mutations-Bonus angefasst; alles andere geht
-- an den Spieler (Lager, Waehrung) und nicht an die Figur.
local function awardBonus(
	player: Player,
	data: Types.PlayerData,
	baerchi: Types.Baerchi,
	bonus: EventConfig.EventBonus?
): (Types.LocMsg?, Types.MutationId?)

	if not bonus then
		return nil, nil
	end

	local amount = math.max(0, math.floor(bonus.amount or 0))

	-- HONIG in JEDES Gebaeude, gedeckelt auf dessen Lager. Der Ueberlauf
	-- verfaellt bewusst, statt sich anzusammeln: die Lagergroesse ist die
	-- Bremse des ganzen Honig-Systems (siehe BuildingBehavior), und ein Event
	-- darf sie nicht aushebeln.
	if bonus.kind == "honey" then
		local added = 0

		for _, building in data.island.buildings do
			local capacity = BuildingBehavior.getCapacity(building.id, building.level)
			local before   = building.honey or 0
			local after    = math.min(capacity, before + amount)

			added += after - before
			building.honey = after
		end

		if added <= 0 then
			return Loc.msg("msg.event.honey_full"), nil
		end
		return Loc.msg("msg.event.honey", { n = added }), nil
	end

	-- EIER ins Lager, nicht in einen Brut-Slot: die Brut startet der Spieler
	-- selbst (die Slots koennen gerade belegt sein), und im Lager geht nichts
	-- verloren.
	if bonus.kind == "eggs" then
		if amount <= 0 then
			return nil, nil
		end

		-- v14 (WP10): Sorte nach dem Ei-Baum des Spielers waehlen.
		local eggType: Types.EggType = bonus.eggType or "BasicEgg"
		local isJump = false
		if bonus.eggPick == "jump" then
			local jump = EggTree.pickJumpEgg(data.eggTree)
			if jump then
				eggType = jump
				isJump = true
			else
				eggType = EggTree.highestUnlocked(data.eggTree)
			end
		elseif bonus.eggPick == "highest" then
			eggType = EggTree.highestUnlocked(data.eggTree)
		end
		data.island.eggStock[eggType] = (data.island.eggStock[eggType] or 0) + amount

		-- Sammel-Update 2.4: Text als LocMsg, der Client uebersetzt.
		local text = Loc.msg(if isJump then "msg.event.eggs_jump" else "msg.event.eggs", {
			n = amount, egg = Loc.msg("egg." .. eggType .. ".name"),
		})

		-- Blaupause (Koenigshuegel, Schatzgraeber mit 5 Funden)
		if (bonus.blueprintChance or 0) > 0 and math.random() < (bonus.blueprintChance :: number) then
			EggTreeService.grantBlueprint(player, data, 1)
			text = Loc.join(text, Loc.msg("msg.event.blueprint"))
		end

		-- Notfall-Ei (zusaetzlich, siehe EventConfig.EMERGENCY_BASIC_EGG_CHANCE)
		if math.random() < EventConfig.EMERGENCY_BASIC_EGG_CHANCE then
			data.island.eggStock.BasicEgg = (data.island.eggStock.BasicEgg or 0) + 1
			text = Loc.join(text, Loc.msg("msg.event.eggs", { n = 1, egg = Loc.msg("egg.BasicEgg.name") }))
		end

		return text, nil
	end

	-- WAEHRUNG immer ueber EconomyService: der rebirthMult gehoert dorthin und
	-- nirgendwo sonst hin (awardGummies wendet ihn an, awardGoldGummies
	-- bewusst nicht — GoldGummies sind die Premium-Waehrung).
	if bonus.kind == "gummies" then
		local final = EconomyService.awardGummies(player, amount)
		if final <= 0 then
			return nil, nil
		end
		return Loc.msg("msg.event.gummies", { n = final }), nil
	end

	if bonus.kind == "goldGummies" then
		local final = EconomyService.awardGoldGummies(player, amount)
		if final <= 0 then
			return nil, nil
		end
		return Loc.msg("msg.event.gold", { n = final }), nil
	end

	-- MUTATION: zwei getrennte Wuerfe. Erst die Event-Chance (kommt ueberhaupt
	-- etwas?), dann die Stufe (welche?). Der zweite Wurf benutzt bewusst
	-- rollMutationTier und NICHT rollMutation: sonst waere das Ergebnis auch
	-- nach einem Treffer noch in 98.5% der Faelle "keine Mutation".
	if bonus.kind == "mutation" then
		-- Die Chance sinkt mit der Rarity (EventConfig.MUTATION_RARITY_FACTOR).
		local chance = (bonus.chance or 0) * EventConfig.getMutationFactor(baerchi.rarity)
		if math.random() >= chance then
			return nil, nil   -- daneben — der Normalfall, kein Text noetig
		end

		local rolled = BaerchiConfig.rollMutationTier()
		local better = BaerchiConfig.pickHigherMutation(baerchi.mutation, rolled)

		-- Nur nach OBEN: wer schon Lava traegt, kann sie hier nie gegen Gold
		-- eintauschen. Der Fehlversuch wird trotzdem gemeldet — ein Treffer,
		-- der nichts veraendert, saehe sonst aus wie ein verschlucktes Ergebnis.
		if better == baerchi.mutation then
			return Loc.msg("msg.event.mutation_weaker", { m = Loc.msg("mutation." .. rolled .. ".name") }), nil
		end

		baerchi.mutation = better
		return Loc.msg("msg.event.mutation", { m = Loc.msg("mutation." .. (better :: string) .. ".name") }), better
	end

	return nil, nil
end

-- Wurf auf einen Rarity-Aufstieg um EINE Stufe (UFO-Absetzen, Boss-Top-Rang).
-- Gibt die neue Rarity zurueck oder nil.
local function rollRarityUp(baerchi: Types.Baerchi, chance: number): string?
	if chance <= 0 or math.random() >= chance then
		return nil
	end
	local nextRarity = BaerchiConfig.getNextRarity(baerchi.rarity)
	if nextRarity then
		baerchi.rarity = nextRarity
		return nextRarity
	end
	return nil
end

-- v17: Zusatz-Belohnungen eines Handler-Ergebnisses (Boss): Gummies,
-- Wabeneinheiten, zweites Ei, Rarity-Up-Wurf. Waehrungen ueber
-- EconomyService, Waben ueber CombRecyclerService, nie direkt.
-- Gibt (Meldungen als LocMsg, Meldung des zweiten Eis, neue Rarity) zurueck.
local function awardExtras(
	player: Player,
	data: Types.PlayerData,
	baerchi: Types.Baerchi,
	result: EventHandlers.Reward
): ({ Types.LocMsg }, Types.LocMsg?, string?)
	local notes: { Types.LocMsg } = {}
	local eggText: Types.LocMsg? = nil

	if result.extraEgg then
		eggText = awardBonus(player, data, baerchi, result.extraEgg)
	end

	-- HBB Paket 7: Mutations-Wurf der Boss-Stufe 4 (gleicher Weg wie der
	-- Mutations-Sturm). Der Text haengt an die Ei-Zeile an.
	if result.tierBonus then
		local tierText = awardBonus(player, data, baerchi, result.tierBonus)
		if tierText then
			eggText = if eggText then Loc.join(eggText, tierText) else tierText
		end
	end
	if (result.tierEggs or 0) > 0 then
		EggService.grantEggs(player, "BasicEgg", result.tierEggs :: number)
	end
	if result.bossTier and result.bossTier > 0 then
		table.insert(notes, Loc.msg("msg.boss.tier", { tier = result.bossTier }))
	end

	local gummies = result.gummies or 0
	if gummies > 0 then
		local final = EconomyService.awardGummies(player, gummies)
		if final > 0 then table.insert(notes, Loc.msg("msg.event.gummies", { n = final })) end
	end

	local units = result.combUnits or 0
	if units > 0 and CombRecyclerService.deposit(player, units) then
		table.insert(notes, Loc.msg("msg.event.combs", { n = units }))
	end

	local rarityUp: string? = nil
	if (result.rarityUpFactor or 0) > 0 then
		local oldRarity = baerchi.rarity
		local chance = (result.rarityUpFactor :: number) * EventConfig.getRarityUpChance(oldRarity)
		rarityUp = rollRarityUp(baerchi, chance)
		if rarityUp then
			table.insert(notes, Loc.msg("msg.event.rarity_up", {
				from = Loc.msg("rarity." .. oldRarity), to = Loc.msg("rarity." .. rarityUp),
			}))
		end
	end

	return notes, eggText, rarityUp
end

local function onEventEnded(finished: EventConfig.EventDef)
	-- Handler zuerst beenden: er liefert, wer was bekommt.
	local results: any = {}
	if _session then
		local ok, res = pcall(_session.stop)
		if ok and res then
			results = res
		else
			warn("[EventParticipationService] Handler-stop fehlgeschlagen:", res)
		end
		_session = nil
	end
	_sessionToken += 1

	for player, presence in _present do
		local data = PlayerService.getData(player)
		if not data then continue end

		local baerchi = data.island.baerchis[presence.baerchiUid]
		if not baerchi then continue end

		-- Zweite, unabhaengige Pruefung: steht die Figur wirklich noch dort?
		-- _present allein wuerde reichen, solange sich niemand dazwischen an der
		-- Figur zu schaffen macht — aber genau das kann passieren (Kampf, der
		-- das Schloss uebernimmt). Die Weltposition ist die Wahrheit.
		local figure = MapService.getBaerchiModel(player, presence.baerchiUid)
		if not figure or not isOnEventFloor(figure) then
			continue
		end

		-- maxHp kann durch den neuen Stat-Level steigen — und seit dem
		-- Mutations-Sturm sogar sprunghaft (eine Mutation multipliziert die
		-- Basiswerte, siehe BaerchiConfig.getMutationBonus). Die Differenz wird
		-- gutgeschrieben, damit ein Fortschritt den Baerchi nicht relativ
		-- SCHWAECHER macht (mehr maxHp bei gleichen currentHp waere ein
		-- leererer Balken als vorher).
		--
		-- Deshalb steht der Messpunkt VOR beiden Belohnungen und wird erst
		-- NACH beiden ausgewertet: Stat-Stufe und Mutation koennen in
		-- derselben Teilnahme zusammenkommen.
		local def      = BaerchiConfig.getById(baerchi.configId)
		local beforeHp = if def then CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp else 0

		-- Nur wer im Handler-Ergebnis steht, bekommt etwas (Stat-Stufen gibt es
		-- nur beim UFO, und dort sofort beim Absetzen, nicht hier).
		local result = results[player]
		if not result then
			continue
		end
		FunnelService.step(player, "F09_FirstEventCompleted")
		data.stats.totalEventsCompleted = (data.stats.totalEventsCompleted or 0) + 1
		-- Sammel-Update 05.10. (Paket 6.2): Boss-Siege zaehlen (besonderer
		-- Meilenstein, SpecialMilestoneService zahlt beim naechsten Datenstand).
		if result.bossVictory then
			local stats = data.stats :: any
			stats.bossVictories = (stats.bossVictories or 0) + 1
		end

		local bonus: EventConfig.EventBonus? = nil
		if result.egg then
			bonus = result.egg
		elseif result.mutationRoll then
			bonus = finished.bonus
		end

		local key: string? = nil
		local bonusText, mutation = awardBonus(player, data, baerchi, bonus)

		-- v17: Zusatz-Belohnungen (Boss) und die lokalisierte Zusammenfassung
		-- des Handlers.
		local notes, extraEggText, rarityUp = awardExtras(player, data, baerchi, result)
		if extraEggText then
			bonusText = if bonusText then Loc.join(bonusText, extraEggText) else extraEggText
		end
		if player.Parent ~= nil then
			if result.notice then
				Remotes.EventNotice:FireClient(player, result.notice, "good")
			end
			for _, note in notes do
				Remotes.EventNotice:FireClient(player, note, "good")
			end
		end
		if rarityUp then
			MapService.celebrateBaerchi(player, presence.baerchiUid, BaerchiConfig.getRarityColor(baerchi.rarity))
		end

		-- Weder eine Stufe (alles am Rarity-Cap) noch ein Bonus: dann gibt es
		-- auch nichts zu melden und nichts zu speichern.
		if not key and not bonusText and #notes == 0 then
			continue
		end

		if def then
			local afterHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
			baerchi.currentHp = math.clamp(
				(baerchi.currentHp or 0) + math.max(0, afterHp - beforeHp),
				0,
				afterHp
			)
		end

		local gain: Types.EventStatGain = {
			baerchiUid = presence.baerchiUid,
			eventId    = finished.id,
			statKey    = key,
			newLevel   = if key then (baerchi.statLevels :: any)[key] else 0,
			cap        = PromotionConfig.getStatCap(baerchi.rarity),
			bonusText  = bonusText,
			mutation   = mutation,
		}

		Remotes.EventStatGained:FireClient(player, gain)
		PlayerService.markDirty(player)
		PlayerService.saveNow(player)

		-- Eine frisch gewonnene Mutation aendert Fellfarbe UND Aura der Figur.
		-- Beides zieht der normale Weg nach: markDirty oben laesst
		-- PlotDisplayService die Figur neu bauen, sobald das ActivityLock frei
		-- ist (die Mutation steht dafuer in dessen Struktur-Signatur). "Sobald
		-- frei" heisst hier: wenn der Baerchi vom Event zurueck ist — waehrend
		-- er dort steht, haelt DIESER Service das Schloss.
		--
		-- Damit der Moment trotzdem sofort sichtbar ist, gibt es hier einen
		-- Partikel-Stoss in der Farbe der neuen Stufe. Die Figur umzubauen,
		-- waehrend sie auf dem Podest steht, waere die schlechtere Loesung: sie
		-- wuerde dabei an ihren Platz auf dem Plot zurueckspringen.
		if mutation then
			MapService.celebrateBaerchi(
				player,
				presence.baerchiUid,
				BaerchiConfig.getMutationColor(mutation)
			)
		end

		-- Nur Server-Log (kein Spieler sieht das)
		local statText = "no stat level"
		if key then
			statText = string.format("%s %d/%d", key, gain.newLevel, gain.cap)
		end

		print(
			"[EventParticipationService]", player.Name,
			"|", finished.id,
			"→", statText,
			if bonusText then "| " .. Loc.resolve(bonusText) else ""
		)
	end

	-- Nach dem Event weiter dekorativ herumstehen (siehe playEventMotion):
	-- der Baerchi wird NICHT automatisch zurueckgeschickt. Wer die naechste
	-- Runde mitnehmen will, laesst ihn einfach stehen.
	for player, presence in _present do
		local figure = MapService.getBaerchiModel(player, presence.baerchiUid)
		if figure then
			playEventMotion(figure)
		end
	end
end

--------------------------------------------------------------------------------
-- Schnittstelle fuer die Event-Handler (Services/EventHandlers)
--------------------------------------------------------------------------------

-- Meldung an den Spieler waehrend eines Events (Toast beim Client).
local function toast(player: Player, text: string | Types.LocMsg)
	if player.Parent == nil then
		return
	end
	local gain: any = {
		baerchiUid = "",
		eventId    = "",
		statKey    = nil,
		newLevel   = 0,
		cap        = 0,
		bonusText  = text,
		mutation   = nil,
		midEvent   = true,
	}
	Remotes.EventStatGained:FireClient(player, gain)
end

--------------------------------------------------------------------------------
-- UFO_REJOIN: befristete Schwaechung nach dem UFO-Absetzen
--------------------------------------------------------------------------------
-- Nur Laufzeit (nicht gespeichert): uid -> os.clock(), bis zu der das Level in
-- Event-Duellen mit EventConfig.UFO.DROP_WEAKEN_LEVEL_FACTOR zaehlt. Die Figur
-- traegt das Attribut "WeakUntil" (Serverzeit), damit der Client es zeigen kann.
local _weakUntil: { [string]: number } = {}

local function isWeakened(baerchiUid: string): boolean
	local untilAt = _weakUntil[baerchiUid]
	if not untilAt then return false end
	if os.clock() >= untilAt then
		_weakUntil[baerchiUid] = nil
		return false
	end
	return true
end

local function weakenedLevel(baerchiUid: string, level: number): number
	if not isWeakened(baerchiUid) then return level end
	return math.max(1, math.floor(level * EventConfig.UFO.DROP_WEAKEN_LEVEL_FACTOR))
end

local function weaken(player: Player, baerchiUid: string, seconds: number)
	if not FeatureFlags.isOn("UFO_REJOIN") or seconds <= 0 then return end
	_weakUntil[baerchiUid] = os.clock() + seconds
	local figure = MapService.getBaerchiModel(player, baerchiUid)
	if figure then
		figure:SetAttribute("WeakUntil", workspace:GetServerTimeNow() + seconds)
		-- Sichtbar fuer alle (sprachneutral): "💫 ½ Lv 42s" ueber dem Kopf.
		local root = figure.PrimaryPart or figure:FindFirstChildWhichIsA("BasePart")
		local old = figure:FindFirstChild("WeakLabel")
		if old then old:Destroy() end
		if root then
			local gui = Instance.new("BillboardGui")
			gui.Name        = "WeakLabel"
			gui.Size        = UDim2.fromOffset(120, 28)
			gui.StudsOffset = Vector3.new(0, 7.5, 0)
			gui.AlwaysOnTop = true
			gui.MaxDistance = 120
			gui.Adornee     = root
			local text = Instance.new("TextLabel")
			text.Size                   = UDim2.fromScale(1, 1)
			text.BackgroundTransparency = 1
			text.Font                   = Enum.Font.GothamBold
			text.TextScaled             = true
			text.TextColor3             = Color3.fromRGB(190, 170, 255)
			text.TextStrokeTransparency = 0.2
			text.Parent = gui
			gui.Parent = figure
			local untilAt = _weakUntil[baerchiUid]
			task.spawn(function()
				while gui.Parent and _weakUntil[baerchiUid] == untilAt and os.clock() < untilAt do
					text.Text = string.format("💫 ½ Lv %ds", math.ceil(untilAt - os.clock()))
					task.wait(1)
				end
				gui:Destroy()
			end)
		end
	end
	if player.Parent ~= nil then
		Remotes.EventNotice:FireClient(player, Loc.msg("msg.ufo.weakened", { s = seconds }), "info")
	end
end

-- Setzt die Figur wieder aufs Plot und beendet die Teilnahme (UFO-Absetzen).
local function finishHome(presence: any)
	local player: Player = presence.player
	local figure = MapService.getBaerchiModel(player, presence.baerchiUid)

	if _present[player] == presence then
		_present[player] = nil
	end

	if figure then
		-- Sammel-Update 1.1: ERST das Atmen abmelden, dann setzen. Sonst
		-- springt idleBob -> stopIdle die Figur auf ihre alte Ruhelage zurueck
		-- (z.B. mitten im Event-Pit) und sie "atmet" dort weiter, obwohl sie
		-- laut Daten schon zu Hause ist — genau das eingefrorene Bild.
		FigureFX.stopIdle(figure)
		FigurePlacement.place(figure, presence.homeFoot, figure:GetPivot().Rotation)
		FigureFX.idleBob(figure, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
	end

	ActivityLock.release(player, LOCK_HOLDER)
	if player.Parent ~= nil then
		notifyPresence(player, false, nil)
	end
end

-- UFO-Belohnung beim Absetzen: +1 auf alle Stats (begrenzt durch STAT_CAP)
-- und der Rarity-Up-Wurf (EventConfig.RARITY_UP_CHANCE).
local function applyUfoReward(presence: any)
	local player: Player = presence.player
	local data = PlayerService.getData(player)
	if not data then return end

	local baerchi = data.island.baerchis[presence.baerchiUid]
	if not baerchi then return end

	local def      = BaerchiConfig.getById(baerchi.configId)
	local beforeHp = if def then CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp else 0

	local cap    = PromotionConfig.getStatCap(baerchi.rarity)
	local levels = baerchi.statLevels :: any
	local gained: { string } = {}

	for _, key in PromotionConfig.GROWABLE_STATS do
		local old = levels[key] or 0
		if old < cap then
			levels[key] = math.min(cap, old + EventConfig.UFO.STAT_GAIN_PER_STAT)
			table.insert(gained, PromotionConfig.STAT_LABELS[key] or key)
		end
	end

	-- Rarity-Up: nur eine Stufe, Chance sinkt mit der aktuellen Rarity.
	local oldRarity = baerchi.rarity
	local rarityUp = rollRarityUp(baerchi, EventConfig.getRarityUpChance(oldRarity))

	-- Mehr maxHp (Stat-Stufe, hoehere Rarity): Differenz gutschreiben.
	if def then
		local afterHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
		baerchi.currentHp = math.clamp(
			(baerchi.currentHp or 0) + math.max(0, afterHp - beforeHp),
			0,
			afterHp
		)
	end

	-- Sammel-Update 2.4: als LocMsg (Stat-Kuerzel sind in allen Sprachen gleich)
	local text: Types.LocMsg = if #gained > 0
		then Loc.msg("msg.ufo.reward_stats", { stats = table.concat(gained, "/") })
		else Loc.msg("msg.ufo.reward_maxed")
	if rarityUp then
		text = Loc.join(text, Loc.msg("msg.event.rarity_up", {
			from = Loc.msg("rarity." .. oldRarity), to = Loc.msg("rarity." .. rarityUp),
		}))
	end

	local gain: any = {
		baerchiUid = presence.baerchiUid,
		eventId    = "Ufo",
		statKey    = nil,
		newLevel   = 0,
		cap        = PromotionConfig.getStatCap(baerchi.rarity),
		bonusText  = text :: any,
		mutation   = nil,
		midEvent   = true,
		rarityUp   = rarityUp,
	}
	Remotes.EventStatGained:FireClient(player, gain)

	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	MapService.celebrateBaerchi(player, presence.baerchiUid, BaerchiConfig.getRarityColor(baerchi.rarity))

	print("[EventParticipationService]", player.Name, "| UFO:", Loc.resolve(text))
end

local function buildApi(token: number): any
	local api: any = {}

	api.center = MapService.getEventPitPosition()
	api.radius = MapService.getEventPitRadius()

	api.running = function(): boolean
		return _sessionToken == token
	end

	api.footOf = footPosOf

	-- Alle Teilnehmer, die gerade am Event stehen und deren Figur existiert.
	-- Entfuehrte (abducting) sind nicht dabei.
	api.participants = function(): { any }
		local list = {}
		for player, presence in _present do
			local figure = MapService.getBaerchiModel(player, presence.baerchiUid)
			if figure and not presence.abducting then
				presence.player = player
				presence.figure = figure
				table.insert(list, presence)
			end
		end
		return list
	end

	api.stillHere = function(part: any): boolean
		return part.player ~= nil and _present[part.player] == part
	end

	api.plotPosition = function(player: Player): Vector3?
		local cf = MapService.getPlotCFrame(player)
		return if cf then cf.Position else nil
	end

	api.level = function(part: any): number
		local data = PlayerService.getData(part.player)
		local baerchi = if data then data.island.baerchis[part.baerchiUid] else nil
		return if baerchi then weakenedLevel(part.baerchiUid, baerchi.level) else 1
	end

	-- Kampfstaerke fuer Duelle: ATK * maxHp (wie CombatCalculator).
	api.power = function(part: any): number
		local data = PlayerService.getData(part.player)
		local found = if data then data.island.baerchis[part.baerchiUid] else nil
		if not found then return 1 end
		local baerchi: any = found
		-- UFO_REJOIN: geschwaecht = mit halbem Level rechnen (Kopie, die
		-- gespeicherten Daten bleiben unberuehrt).
		local level = weakenedLevel(part.baerchiUid, baerchi.level)
		if level ~= baerchi.level then
			baerchi = table.clone(baerchi)
			baerchi.level = level
		end
		local def = BaerchiConfig.getById(baerchi.configId)
		if def then
			local ok, stats = pcall(CombatCalculator.getEffectiveStats, baerchi, def.baseStats)
			if ok and stats then
				local s: any = stats
				return math.max(1, s.atk or 1) * math.max(1, s.maxHp or 1)
			end
		end
		return math.max(1, baerchi.level)
	end

	api.toast = toast

	api.recall = function(player: Player)
		EventParticipationService.recall(player)
	end

	api.finishHome = finishHome
	api.ufoReward  = applyUfoReward

	-- UFO_REJOIN: nach dem Absetzen geschwaecht (Level halbiert, befristet).
	api.weaken = function(part: any, seconds: number)
		weaken(part.player, part.baerchiUid, seconds)
	end
	api.isWeakened = function(part: any): boolean
		return isWeakened(part.baerchiUid)
	end

	-- v17: Eier direkt ins Lager (UFO-Abwurf), ueber EggService.
	api.grantEgg = function(player: Player, eggType: Types.EggType, amount: number): boolean
		return EggService.grantEggs(player, eggType, amount)
	end

	-- v17: lokalisierte Meldungen (LocMsg) an einen Spieler bzw. an alle.
	api.notify = function(player: Player, msg: Types.LocMsg, style: string?)
		if player.Parent ~= nil then
			Remotes.EventNotice:FireClient(player, msg, style)
		end
	end
	api.announce = function(msg: Types.LocMsg, style: string?)
		Remotes.EventNotice:FireAllClients(msg, style)
	end

	-- v17: effektive Kampfwerte des Baerchis (fuer den Boss-Schaden, siehe
	-- Modules/BossBalance). nil, wenn Daten oder Baerchi fehlen.
	api.fightStats = function(part: any): any
		local data = PlayerService.getData(part.player)
		local baerchi = if data then data.island.baerchis[part.baerchiUid] else nil
		if not baerchi then return nil end
		local def = BaerchiConfig.getById(baerchi.configId)
		if not def then return nil end
		local ok, stats = pcall(CombatCalculator.getEffectiveStats, baerchi, def.baseStats)
		return if ok then stats else nil
	end

	-- v17: das laufende Event vorzeitig beenden (Boss besiegt). Laeuft ueber
	-- den normalen Weg: EventService stellt nur die Uhr vor, das Ende samt
	-- Auszahlung macht der naechste Takt.
	api.finishEarly = function()
		if _sessionToken == token then
			EventService.skipPhase()
		end
	end

	-- Laeuft die Figur zu `target` (nur X/Z, Y bleibt). Blockiert bis zur
	-- Ankunft oder bis die Bewegung abgebrochen wurde. true = angekommen.
	api.walkTo = function(part: any, target: Vector3): boolean
		local figure: Model? = part.figure
		if not figure or not figure.Parent or part.busy or _present[part.player] ~= part then
			return false
		end

		part.busy       = true
		part.cancelWalk = false

		local ok, err = pcall(function()
			FigureFX.stopIdle(figure)
			local from = footPosOf(figure)
			FigureWalker.walk(figure, from, Vector3.new(target.X, from.Y, target.Z), {
				speed       = EVENT_WALK_SPEED,
				isCancelled = function(): boolean
					return part.cancelWalk == true
						or _present[part.player] ~= part
						or figure.Parent == nil
				end,
			})
		end)
		if not ok then
			warn("[EventParticipationService] walkTo fehlgeschlagen:", err)
		end

		local cancelled = part.cancelWalk == true or _present[part.player] ~= part
		part.busy       = false
		part.cancelWalk = false

		-- Der Spieler wollte waehrenddessen zurueck: jetzt ausfuehren.
		if _recallPending[part.player] and _present[part.player] == part then
			_recallPending[part.player] = nil
			EventParticipationService.recall(part.player)
			return false
		end

		return ok and not cancelled
	end

	return api
end

local function onEventStarted(def: EventConfig.EventDef)
	if _session then
		pcall(_session.stop)
		_session = nil
	end

	_sessionToken += 1

	local handler = (EventHandlers :: any)[def.handler]
	if not handler then
		warn("[EventParticipationService] Kein Handler fuer Event:", def.id, def.handler)
		return
	end

	local ok, session = pcall(handler, buildApi(_sessionToken), def)
	if ok then
		_session = session
	else
		warn("[EventParticipationService] Handler-Start fehlgeschlagen:", session)
	end
end

--------------------------------------------------------------------------------
-- Aufraeumen
--------------------------------------------------------------------------------

-- Eine Teilnahme kann auf drei Wegen ungueltig werden, ohne dass jemand
-- "zurueck" gedrueckt hat: ein Kampf nimmt das Schloss per forceAcquire, die
-- Figur verschwindet (Rebirth, Insel-Neuaufbau), oder der Baerchi ist nicht
-- mehr der ausgeruestete. In allen drei Faellen wird der Eintrag hier still
-- geraeumt — die Figur selbst gehoert dann bereits jemand anderem.
local function tick()
	for player, presence in _present do
		local data = PlayerService.getData(player)

		-- Sammel-Update 1.1 (UFO-Einfrieren): Waechter fuer die Entfuehrung.
		-- Haengt der Ablauf (Fehler ausserhalb des pcall, Thread gestorben),
		-- blieb der Baerchi bisher fuer immer "entfuehrt": Schloss gehalten,
		-- kein Legen, kein Honig-Teich. Nach der laengsten moeglichen Dauer
		-- plus Puffer wird er hier sicher heimgesetzt.
		if presence.abducting and presence.abductedAt
			and os.clock() - presence.abductedAt > ABDUCT_WATCHDOG_SECONDS then
			warn("[EventParticipationService] Entfuehrung haengt, setze heim:", player.Name)
			presence.abducting = false
			pcall(finishHome, presence)
			continue
		end

		local lost = data == nil
			or player.Parent == nil
			or ActivityLock.owner(player) ~= LOCK_HOLDER
			or (data :: Types.PlayerData).island.equippedUid ~= presence.baerchiUid
			or MapService.getBaerchiModel(player, presence.baerchiUid) == nil

		if lost then
			_present[player] = nil
			ActivityLock.release(player, LOCK_HOLDER)

			if player.Parent ~= nil then
				notifyPresence(player, false, nil)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- v12: Phase fuer die Pet-Leiste: "ToEvent", "AtEvent", "Returning" oder nil.
function EventParticipationService.getPhase(player: Player): string?
	if _present[player] then
		return "AtEvent"
	end
	if _walking[player] then
		return if _walkDir[player] == "to" and not _cancelTo[player] then "ToEvent" else "Returning"
	end
	return nil
end

-- Sammel-Update 05.10. (Paket 5.2): wer steht gerade mit welcher Figur am
-- Event (fuer PitBrawlService). Nur lesend; "busy" = laeuft/kaempft gerade,
-- dann greift die Figur niemanden an.
function EventParticipationService.getParticipants(): { { player: Player, figure: Model, busy: boolean } }
	local list = {}
	for player, presence in _present do
		local figure = MapService.getBaerchiModel(player, presence.baerchiUid)
		if figure and figure.Parent and not presence.abducting then
			table.insert(list, { player = player, figure = figure, busy = presence.busy == true })
		end
	end
	return list
end

function EventParticipationService.isPresent(player: Player): boolean
	return _present[player] ~= nil
end

-- v12: wird der Baerchi gerade vom UFO entfuehrt? (Event-Knopf gesperrt)
function EventParticipationService.isAbducting(player: Player): boolean
	local presence = _present[player]
	return presence ~= nil and presence.abducting == true
end

function EventParticipationService.init()
	-- (v12: Hinschicken und Zurueckholen laufen ueber PetModeService /
	-- RequestPetMode, nicht mehr ueber eigene Remotes.)

	EventService.onEventStarted(onEventStarted)
	EventService.onEventEnded(onEventEnded)

	-- Beim Start eines Events die Bewegung der bereits Anwesenden umstellen —
	-- sonst nickt ein Baerchi weiter im Pausen-Takt, obwohl das Event laeuft.
	-- Bewusst ueber denselben Tick wie die Aufraeum-Pruefung: ein zweiter
	-- Callback in EventService waere mehr Mechanik als der Effekt wert ist.
	Players.PlayerRemoving:Connect(function(player)
		_present[player]  = nil
		_walking[player]  = nil
		_walkDir[player]  = nil
		_cancelTo[player] = nil
	end)

	task.spawn(function()
		local lastEventId: string? = nil

		while true do
			task.wait(CHECK_INTERVAL)

			local ok, err = pcall(function()
				tick()

				local active  = EventService.getActive()
				local nowId   = if active then active.id else nil

				if nowId ~= lastEventId then
					lastEventId = nowId
					for player, presence in _present do
						local figure = MapService.getBaerchiModel(player, presence.baerchiUid)
						if figure and not presence.busy and not presence.abducting then
							playEventMotion(figure)
						end
					end
				end
			end)

			if not ok then
				warn("[EventParticipationService] Tick fehlgeschlagen:", err)
			end
		end
	end)

	print("[EventParticipationService] Initialisiert | Intervall:", CHECK_INTERVAL, "s")
end

return EventParticipationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[--!strict
-- EventService.luau
-- ServerScriptService/Services/EventService.luau
--
-- Einzige Zustaendigkeit:
--   - Den Event-Zyklus fahren (Pause → Event → Pause → ...)
--   - Das Event-Pit in der Weltmitte entsprechend umfaerben (MapService)
--   - Die Countdown-Tafel darueber beschriften
--
-- Kennt weiterhin WEDER Spielerdaten NOCH Waehrung. Dass ein Event inzwischen
-- eine spielerische Auswirkung hat (Stat-Fortschritt fuer teilnehmende
-- Baerchis), aendert daran nichts: dieser Service meldet nur, WANN ein Event
-- endet — was daraufhin passiert, entscheidet allein
-- EventParticipationService ueber den onEventEnded-Callback weiter unten.
--
-- Genau diese Trennung ist der Grund, warum der Zyklus hier keine einzige
-- Zeile Spiellogik bekommt: sonst waere dieser Service beim naechsten Feature
-- ("Event gibt auch Honig") die Stelle, an der drei fremde Systeme
-- zusammenlaufen.
--
-- ============================================================
-- WARUM EIN EIGENER SERVICE UND NICHT TEIL VON MAPSERVICE
-- ============================================================
-- MapService baut und AENDERT Geometrie, entscheidet aber nirgendwo sonst
-- WANN etwas passiert — das ist ueberall sonst Sache des aufrufenden Service
-- (CombatService/PitArenaService fuer den Kampf-Ablauf, HoneyService fuer die
-- Produktions-Zeitpunkte). Der Event-Zyklus ist genau so ein "wann", also
-- bekommt er einen eigenen, kleinen Service statt MapService eine zweite
-- Zustaendigkeit aufzubuerden.

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local EventConfig = require(ReplicatedStorage.Config.EventConfig)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local Names       = require(ReplicatedStorage.Localization.Names)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)  -- HBB Paket 6
local MapConfig    = require(ReplicatedStorage.Config.MapConfig)
local Remotes      = require(ReplicatedStorage.Network.Remotes)
local MapService   = require(ServerScriptService.Services.MapService)

local EventService = {}

-- Das Boss-Event, auf das das Wespen-Nest zeigt (EventConfig.EVENTS)
local WASP_QUEEN_ID = "WaspQueen"

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

-- Das gerade laufende Event, oder nil waehrend einer Pause.
local _active: EventConfig.EventDef? = nil

-- Zeitstempel (os.time()), an dem die aktuelle Phase (Event ODER Pause) endet.
local _phaseEndsAt = 0

-- Index in EventConfig.EVENTS, der als naechstes drankommt. Der Reihe nach,
-- kein Zufall — siehe EventConfig, Kommentar bei EVENTS.
local _nextIndex = 1

-- In welchem Durchlauf des Zyklus das naechste Event liegt (ab 1). Events mit
-- everyNthCycle (Boss) laufen nur in passenden Durchlaeufen; die Regel steht
-- in EventConfig.isScheduledInCycle, hier wird nur weitergezaehlt.
local _nextCycle = 1

-- Beobachter, die beim START eines Events benachrichtigt werden wollen
-- (EventParticipationService startet damit den Event-Handler).
local _onEventStarted: { (EventConfig.EventDef) -> () } = {}

-- Beobachter, die beim ENDE eines Events benachrichtigt werden wollen.
-- Aktuell genau einer: EventParticipationService, der dann die Stat-Stufen
-- an die anwesenden Baerchis verteilt.
local _onEventEnded: { (EventConfig.EventDef) -> () } = {}

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function formatCountdown(seconds: number): string
	local clamped = math.max(0, math.floor(seconds))
	local minutes = clamped // 60
	local secs    = clamped % 60
	return string.format("%d:%02d", minutes, secs)
end

-- Die drei Angaben einer Phasen-Meldung: laufendes Event (nil in der Pause),
-- Restzeit der Phase, und welches Event als naechstes kommt.
--
-- Das NAECHSTE Event gehoert mit dazu, weil der Spieler waehrend der Pause
-- entscheidet: nur wenn er weiss, was gleich laeuft, kann er seinen Baerchi
-- rechtzeitig losschicken (der Weg in die Mitte dauert selbst ein paar
-- Sekunden). Auf der Tafel steht dieselbe Information — die sieht aber nur,
-- wer gerade in die Weltmitte schaut.
-- Sammel-Update 05.10. (Paket 5.3): vierte Angabe = Sekunden bis zur
-- naechsten Wespenkoenigin (0 = laeuft gerade, nil = unbekannt). Die Pet-
-- Leiste zeigt daraus "Boss in X min" — der 50-Minuten-Zyklus fuehlt sich
-- kuerzer an, wenn man sieht, worauf man wartet.
local function phasePayload(): (string?, number, string, number?)
	local remaining = math.max(0, _phaseEndsAt - os.time())
	local activeId = if _active then _active.id else nil
	return
		activeId,
		remaining,
		EventConfig.EVENTS[_nextIndex].id,
		EventConfig.secondsUntilStart(WASP_QUEEN_ID, activeId, remaining, _nextIndex, _nextCycle)
end

-- Sagt ALLEN Clients, welches Event gerade laeuft (bzw. dass Pause ist).
--
-- Nur bei einem PHASENWECHSEL und beim Join, nicht im Sekundentakt: die Uhr
-- steht sichtbar auf der Tafel in der Welt, dafuer braucht es kein Remote. Der
-- Client benutzt die Meldung ausschliesslich, um auf der Baerchi-Karte
-- anzuzeigen, was eine Teilnahme gerade bringen wuerde (siehe BaerchiPanel).
local function broadcastPhase()
	Remotes.EventPhaseChanged:FireAllClients(phasePayload())
end

-- Stellt _nextIndex auf das naechste Event, das im jeweiligen Durchlauf
-- laeuft. Beim Umlauf (letztes → erstes Event) beginnt ein neuer Durchlauf.
local function advance()
	local count = #EventConfig.EVENTS
	for _ = 1, count * 2 do
		_nextIndex += 1
		if _nextIndex > count then
			_nextIndex = 1
			_nextCycle += 1
		end
		if EventConfig.isScheduledInCycle(EventConfig.EVENTS[_nextIndex], _nextCycle) then
			return
		end
	end
end

local function startEvent()
	local def = EventConfig.EVENTS[_nextIndex]
	advance()

	_active      = def
	_phaseEndsAt = os.time() + EventConfig.getDuration(def)

	MapService.setEventPitTheme({
		floorColor = def.floorColor,
		fenceColor = def.fenceColor,
		ringColor  = def.ringColor,
	})

	broadcastPhase()

	print("[EventService] Event gestartet:", def.displayName, "|", Loc.resolve(EventConfig.describeReward(def)))

	for _, callback in _onEventStarted do
		local ok, err = pcall(callback, def)
		if not ok then
			warn("[EventService] onEventStarted-Callback fehlgeschlagen:", err)
		end
	end
end

local function endEvent()
	local finished = _active
	_active      = nil
	_phaseEndsAt = os.time() + EventConfig.EVENT_GAP_SECONDS

	MapService.setEventPitTheme(nil)
	broadcastPhase()

	if finished then
		print("[EventService] Event beendet:", finished.displayName)

		-- Beobachter NACH dem Aufraeumen benachrichtigen: sie sollen einen
		-- Zustand vorfinden, in dem das Event nachweislich vorbei ist
		-- (getActive() gibt bereits nil zurueck). Jeder Callback in pcall — ein
		-- Fehler beim Verteilen der Belohnung darf den Zyklus nicht anhalten,
		-- sonst stuende die Event-Uhr fuer den ganzen Server still.
		for _, callback in _onEventEnded do
			local ok, err = pcall(callback, finished)
			if not ok then
				warn("[EventService] onEventEnded-Callback fehlgeschlagen:", err)
			end
		end
	end
end

-- Ein Tick pro Sekunde: Phase ggf. wechseln, danach die Tafel nachziehen.
-- Zeit wird immer aus os.time()/_phaseEndsAt neu gerechnet statt einfach
-- runtergezaehlt — ein einzelner ausgesetzter Tick (Server-Laghlack) darf die
-- Uhr nicht verschieben.
local function tick()
	local remaining = _phaseEndsAt - os.time()

	if remaining <= 0 then
		if _active then
			endEvent()
		else
			startEvent()
		end
		remaining = _phaseEndsAt - os.time()
	end

	-- Auf der Tafel steht IMMER auch die Belohnung — bei zehn Events im
	-- Wechsel waere "Naechstes Event / in 4:12" sonst keine Information, auf
	-- die man eine Entscheidung stuetzen kann. Waehrend der Pause wird deshalb
	-- zusaetzlich angekuendigt, WELCHES Event als naechstes kommt: nur so kann
	-- ein Spieler seinen Baerchi rechtzeitig hinschicken, wenn genau dieses
	-- Event den Stat bringt, den er braucht.
	if _active then
		-- Tafel-Texte als Nachrichten: jeder Spieler liest sie in seiner Sprache.
		MapService.setEventBanner(
			-- Sammel-Update 2.4: die Tafel sehen alle — Zeichen statt Woerter
			Loc.msg("ui.eventboard.live", { event = Names.msg.event(_active.id) }),
			string.format("⏱ %s", formatCountdown(remaining)),
			_active.bannerColor,
			EventConfig.describeReward(_active)
		)
	else
		local upcoming = EventConfig.EVENTS[_nextIndex]

		MapService.setEventBanner(
			Loc.msg("fmt.append", { a = "⏭", b = Names.msg.event(upcoming.id) }),
			string.format("⏱ %s", formatCountdown(remaining)),
			MapConfig.EVENT_PIT_BANNER_IDLE_COLOR,
			EventConfig.describeReward(upcoming)
		)
	end

	-- HBB Paket 6: Wespen-Nest am Mast zaehlt bis zur Koenigin herunter
	-- (sprachneutral: Biene + Uhr) und leuchtet kurz davor und waehrenddessen.
	if FeatureFlags.isOn("MAP_V2_WASP_NEST") then
		local activeId = if _active then _active.id else nil
		local untilBoss = EventConfig.secondsUntilStart(WASP_QUEEN_ID, activeId, remaining, _nextIndex, _nextCycle)
		if untilBoss then
			MapService.setWaspNest(
				if untilBoss == 0 then "🐝 LIVE" else "🐝 " .. formatCountdown(untilBoss),
				untilBoss <= MapConfig.WASP_NEST.glowSeconds
			)
		end
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Das gerade laufende Event, falls eins laeuft — nil waehrend einer Pause.
-- Wird von EventParticipationService gelesen (und vom Client ueber dessen
-- Zustandsmeldungen indirekt mitbekommen).
function EventService.getActive(): EventConfig.EventDef?
	return _active
end

-- Das Event, das als NAECHSTES an der Reihe ist. Waehrend einer Pause ist das
-- der Countdown-Gegenstand auf der Tafel; waehrend eines laufenden Events ist
-- es das darauf folgende.
--
-- Gibt es immer (der Zyklus ist ein Ring), deshalb kein optionaler Rueckgabewert.
function EventService.getNext(): EventConfig.EventDef
	return EventConfig.EVENTS[_nextIndex]
end

-- Sekunden bis zum Ende der laufenden Phase (Event ODER Pause). Nie negativ.
function EventService.getRemainingSeconds(): number
	return math.max(0, _phaseEndsAt - os.time())
end

-- Beendet die laufende Phase sofort — laeuft gerade ein Event, ist es danach
-- vorbei (inklusive aller onEventEnded-Callbacks); ist gerade Pause, startet
-- sofort das naechste Event.
--
-- Nur fuer den Studio-Test gedacht (DebugService): ein Zyklus aus 3 Minuten
-- Event und 5 Minuten Pause laesst sich sonst nicht in vertretbarer Zeit
-- durchspielen. Bewusst KEIN eigener Sonderweg — es wird nur die Uhr
-- vorgestellt, den Rest macht der normale tick(). Dadurch kann dieser Aufruf
-- auch nichts kaputt machen, was im echten Ablauf nicht ohnehin passiert.
function EventService.skipPhase()
	_phaseEndsAt = os.time()
end

-- Stellt den Zyklus so, dass als naechstes GENAU dieses Event kommt, und
-- startet es sofort. Gibt false zurueck, wenn es die id nicht gibt.
--
-- Ebenfalls nur fuer den Studio-Test gedacht (DebugService): bei zehn Events
-- im Wechsel dauert ein voller Durchlauf 80 Minuten — ein bestimmtes Event
-- abzuwarten waere sonst keine Testmoeglichkeit, sondern eine Geduldsprobe.
--
-- Laeuft gerade ein Event, wird es ordentlich beendet (inklusive aller
-- onEventEnded-Callbacks, also auch der Belohnungen) statt einfach ersetzt —
-- sonst haette ein Testaufruf nebenbei die Teilnahme aller Anwesenden
-- verschluckt.
function EventService.startById(id: string): boolean
	local index: number? = nil
	for i, def in EventConfig.EVENTS do
		if def.id == id then
			index = i
			break
		end
	end

	if not index then
		return false
	end

	if _active then
		endEvent()
	end

	_nextIndex = index
	startEvent()
	return true
end

-- Registriert einen Callback, der laeuft sobald ein Event ZU ENDE ist.
--
-- Anders als PlayerService.onDataLoaded ist die Reihenfolge zu init() hier
-- UNKRITISCH: der Server startet grundsaetzlich in einer Pause (siehe init),
-- das erste Event endet also fruehestens nach EVENT_GAP + EVENT_DURATION
-- Sekunden. Bis dahin sind laengst alle Services angemeldet.
function EventService.onEventStarted(callback: (EventConfig.EventDef) -> ())
	table.insert(_onEventStarted, callback)
end

function EventService.onEventEnded(callback: (EventConfig.EventDef) -> ())
	table.insert(_onEventEnded, callback)
end

function EventService.init()
	-- Wer spaeter dazukommt, hat den letzten Phasenwechsel verpasst — also
	-- bekommt jeder neue Spieler den Stand einmal gezielt zugeschickt. Ohne
	-- das zeigte seine Baerchi-Karte bis zum naechsten Wechsel (bis zu fuenf
	-- Minuten) "gerade kein Event", obwohl das Pit vor ihm leuchtet.
	Players.PlayerAdded:Connect(function(player)
		Remotes.EventPhaseChanged:FireClient(player, phasePayload())
	end)

	print(
		"[EventService] Initialisiert |", #EventConfig.EVENTS, "Events im Wechsel",
		"(manche nur jeden n-ten Durchlauf) | individuelle Dauer,", EventConfig.EVENT_GAP_SECONDS, "s Pause"
	)
end

-- Der Zyklus laeuft erst in start(): dann steht die Welt (das Event-Pit baut
-- MapService.init) und alle onEventStarted/onEventEnded-Rueckrufe sind
-- angemeldet.
function EventService.start()
	-- Server startet in der Pause, nicht mitten in einem Event — sonst wuerde
	-- jeder frisch gestartete Server sofort mit einem laufenden Event
	-- begruesst, was sich nach einem Fehler anfuehlt statt nach Absicht.
	-- HBB Paket 6: die erste Pause eines neuen Servers ist kuerzer.
	local firstGap = if FeatureFlags.isOn("EVENT_V2_TIMER")
		then EventConfig.FIRST_GAP_SECONDS
		else EventConfig.EVENT_GAP_SECONDS
	_phaseEndsAt = os.time() + firstGap
	MapService.setEventPitTheme(nil)

	task.spawn(function()
		while true do
			local ok, err = pcall(tick)
			if not ok then
				warn("[EventService] Tick fehlgeschlagen:", err)
			end
			task.wait(1)
		end
	end)
end

return EventService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">MapService</string><ProtectedString name="Source"><![CDATA[--!strict
-- MapService.luau
-- ServerScriptService/Services/MapService.luau
--
-- Einzige Zustaendigkeit:
--   - Die einzige Schnittstelle zur gebauten Welt: Welt beim Start bauen
--     lassen, Spieler-Plots vergeben, spawnen, neu aufbauen und despawnen,
--     und die sichtbaren Teile aktuell halten (Schilder, Figur, Teich, Eier,
--     Lauf-Turm, Tower-Turm, Event-Pit)
--
-- Das eigentliche BAUEN steht in den Modulen unter Util/MapBuild (MapParts,
-- WorldBuilder, PlotBuilder, PondBuilder, ArenaBuilder, FigureBuilder,
-- LaidEggBuilder). Dieser Service haelt den Zustand (welcher Spieler welchen
-- Slot und welches Plot-Model hat) und entscheidet, WANN gebaut wird. Andere
-- Services sprechen nur mit MapService, nie mit den Buildern.
--
-- Baut physische Roblox-Parts aus IslandData.
-- Kennt keine Spielerdaten ausser IslandData (und den Namen fuer das Schild).
--
-- Alle Masse, Farben und Offsets kommen aus MapConfig. Wie das plot-lokale
-- Koordinatensystem funktioniert (lokales -Z = Richtung Mitte, +Z = nach
-- aussen), steht im Kopf von MapConfig.
--
-- ZWEI ARTEN VON AKTUALISIERUNG — bewusst getrennt:
--   * NEU BAUEN (updateBaerchis, updateBuildingLooks, updateTowerShowcase):
--     teuer, nur wenn sich die Struktur aendert (ein Baerchi kommt dazu, faellt
--     weg oder steigt im Level; ein Gebaeude wechselt den Look; der Tower-Turm
--     bekommt einen neuen Look oder Rekord).
--   * IN-PLACE (updateBaerchiStates, updateBuildingSigns): billig, aendert nur
--     Beschriftung und Transparenz an bereits stehenden Teilen. Dafuer gibt es
--     die Trennung: HP und Honig aendern sich staendig, und dafuer jedes Mal
--     25 Mesh-Figuren neu zu bauen waere Verschwendung.
--   PlotDisplayService entscheidet welche der beiden noetig ist.
--
-- NEUAUFBAU WAEHREND EINER BEWEGUNG — die eine Sperre in dieser Datei:
-- updateBaerchis zerstoert die Figur und baut sie neu. Laeuft sie in dem
-- Moment gerade (Kampf-Lauf oder Weg zum Honig-Teich), verschwaende sie mitten
-- im Schritt. Die Pruefung dagegen steht EINMAL hier drin statt an jeder
-- Aufrufstelle — und der uebersprungene Neuaufbau wird nachgeholt, sobald das
-- Schloss frei ist (siehe scheduleRebuildWhenFree weiter unten). Ohne das
-- Nachholen bliebe die Beschriftung dauerhaft veraltet, weil der Aufrufer
-- (PlotDisplayService) den neuen Stand direkt danach als "dargestellt" merkt.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig = require(ReplicatedStorage.Config.MapConfig)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types     = require(ReplicatedStorage.Network.Types)
local WorldText = require(ReplicatedStorage.Localization.WorldText)
local Loc       = require(ReplicatedStorage.Localization.Loc)

local ActivityLock = require(ServerScriptService.Util.ActivityLock)
local FigureFX     = require(ServerScriptService.Util.FigureFX)

local MapBuild       = ServerScriptService.Util.MapBuild
local MapParts       = require(MapBuild.MapParts)
local WorldBuilder   = require(MapBuild.WorldBuilder)
local PlotBuilder    = require(MapBuild.PlotBuilder)
local PondBuilder    = require(MapBuild.PondBuilder)
local ArenaBuilder   = require(MapBuild.ArenaBuilder)
local FigureBuilder  = require(MapBuild.FigureBuilder)
local LaidEggBuilder = require(MapBuild.LaidEggBuilder)
local IncubatorConfig = require(ReplicatedStorage.Config.IncubatorConfig)
local RecyclerBuilder = require(MapBuild.RecyclerBuilder)
local IncubatorBuilder = require(MapBuild.IncubatorBuilder)   -- Sammel-Update Paket 8

--------------------------------------------------------------------------------
-- Interner Zustand
--------------------------------------------------------------------------------

-- Welcher Slot gehoert welchem Spieler
local _playerSlot: { [Player]: number } = {}

-- Alle gespawnten Plot-Models, key = Player
local _plotModels: { [Player]: Model } = {}

-- Verfuegbare Slots (1 .. PLOT_COUNT), wird in init() gefuellt
local _freeSlots: { number } = {}

-- Fuer welche Spieler gerade ein Waechter darauf wartet, den wegen
-- ActivityLock uebersprungenen Figuren-Neuaufbau nachzuholen. Verhindert, dass
-- mehrere Datenaenderungen waehrend derselben Bewegung mehrere Warte-Schleifen
-- starten — eine reicht, sie liest am Ende ohnehin frische Daten.
local _pendingRebuild: { [Player]: boolean } = {}

-- Woher der nachgeholte Neuaufbau seine FRISCHEN IslandData bekommt.
--
-- Absichtlich als eingehaengte Funktion statt eines require(PlayerService):
-- PlayerService requiret bereits MapService, der umgekehrte Weg waere ein
-- Ringschluss. Ausserdem bleibt damit die Regel
-- im Kopf dieser Datei gueltig — MapService kennt weiterhin keine
-- Spielerdaten ausser IslandData. Eingehaengt wird sie von
-- PlotDisplayService.init(); ohne sie faellt nur das Nachholen aus.
local _islandDataProvider: ((Player) -> Types.IslandData?)? = nil

-- v15: zuletzt gesetzter Tower-Turm und Tower-Symbol am Plot-Schild pro
-- Spieler. MapService kennt die Tower-Daten nicht (sie liegen ausserhalb von
-- IslandData) — PlotDisplayService setzt beides; gemerkt wird es hier, damit
-- ein Neuaufbau des Plots (Rebirth) Turm und Symbol sofort wieder mitbaut.
local _showcase: { [Player]: ArenaBuilder.ShowcaseView } = {}
-- Sammel-Update Paket 8: Platz-Zahl des Inkubators (siehe setIncubatorSlotProvider)
local _incubatorSlots: (Player) -> number = function(_player: Player): number return 1 end
type Badge = { text: string, color: Color3 }
local _badge: { [Player]: Badge } = {}
local _crown: { [Player]: boolean } = {}   -- Paket 9: Top 10 der Endless-Woche

local function badgeText(player: Player, text: string | Types.LocMsg): string | Types.LocMsg
	return if _crown[player] then Loc.msg("fmt.append", { a = "♛", b = text }) else text
end

--------------------------------------------------------------------------------
-- Plot-Inhalt
--------------------------------------------------------------------------------

-- Baut den kompletten Inhalt eines Plots (Gebaeude + Bruecke + PIT + Baerchis).
local function buildPlotContents(plotModel: Model, slot: number, islandData: Types.IslandData, owner: Player)
	local pool = PondBuilder.honeyPool(islandData)
	for _, building in islandData.buildings do
		PlotBuilder.buildBuilding(plotModel, slot, building, pool)
	end

	ArenaBuilder.buildBridge(plotModel, slot)
	ArenaBuilder.buildPit(plotModel, slot)
	PondBuilder.buildPond(plotModel, slot, islandData)
	RecyclerBuilder.build(plotModel, slot, islandData.recycler)
	-- Sammel-Update Paket 8: Inkubator (Plaetze liefert der Daten-Lieferant,
	-- weil sie auch an Rebirths und Index haengen, die nicht in der Insel stehen).
	if FeatureFlags.isOn("INCUBATOR") and islandData.incubator then
		IncubatorBuilder.build(plotModel, slot, islandData.incubator, _incubatorSlots(owner), islandData.baerchis)
	end
	FigureBuilder.renderBaerchis(plotModel, slot, islandData)
	LaidEggBuilder.renderLaidEggs(plotModel, slot, islandData, owner)

	-- v15: Tower-Turm und Symbol, falls schon bekannt (nach einem Rebirth).
	local view = _showcase[owner]
	if view then
		ArenaBuilder.buildShowcase(plotModel, slot, view)
	end
	local badge = _badge[owner]
	if badge then
		PlotBuilder.writeOwnerBadge(plotModel, badgeText(owner, badge.text), badge.color)
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

local MapService = {}

local function claimSlot(): number?
	if #_freeSlots == 0 then return nil end
	return table.remove(_freeSlots, 1)
end

local function releaseSlot(slot: number)
	table.insert(_freeSlots, slot)
	table.sort(_freeSlots)
end

function MapService.spawnIsland(player: Player, islandData: Types.IslandData)
	-- Alten Slot freigeben falls vorhanden (sollte nicht passieren, aber sicher)
	if _playerSlot[player] then
		MapService.despawnIsland(player)
	end

	local slot = claimSlot()
	if not slot then
		warn("[MapService] Kein freier Plot fuer Spieler:", player.Name)
		return
	end

	_playerSlot[player] = slot

	local plotModel = PlotBuilder.buildPlotBase(slot, player)
	_plotModels[player] = plotModel

	buildPlotContents(plotModel, slot, islandData, player)

	print("[MapService] Plot gespawnt fuer:", player.Name, "| Slot:", slot)
end

-- Baut den Plot eines Spielers komplett neu — behaelt aber seinen Slot,
-- damit er nach einem Rebirth an derselben Stelle der Map steht.
function MapService.rebuildIsland(player: Player, islandData: Types.IslandData)
	local slot = _playerSlot[player]
	if not slot then
		-- Noch kein Plot (z.B. Server voll) → normaler Spawn-Versuch
		MapService.spawnIsland(player, islandData)
		return
	end

	local oldModel = _plotModels[player]
	if oldModel then
		oldModel:Destroy()
	end

	local plotModel = PlotBuilder.buildPlotBase(slot, player)
	_plotModels[player] = plotModel

	buildPlotContents(plotModel, slot, islandData, player)

	print("[MapService] Plot neu aufgebaut fuer:", player.Name, "| Slot:", slot)
end

function MapService.despawnIsland(player: Player)
	-- Ein noch wartender Nachhol-Waechter hat hier nichts mehr zu tun. Er
	-- merkt das zwar selbst beim naechsten Durchlauf (kein Plot mehr), aber so
	-- bleibt kein Eintrag fuer einen laengst gegangenen Spieler stehen.
	_pendingRebuild[player] = nil
	_showcase[player] = nil
	_badge[player] = nil
	_crown[player] = nil

	local model = _plotModels[player]
	if model then
		model:Destroy()
		_plotModels[player] = nil
	end

	local slot = _playerSlot[player]
	if slot then
		releaseSlot(slot)
		_playerSlot[player] = nil
	end
end

-- (v15: updatePitLevel ist entfallen — es gibt kein PIT-Level mehr. Der Turm
-- auf der Arena-Insel zeigt jetzt den Tower-Rekord, siehe updateTowerShowcase.)

-- v15: den Tower-Turm auf der Arena-Insel (neu) bauen. Aufrufer ist
-- PlotDisplayService, und nur wenn sich Look oder Rekord geaendert haben
-- (Signatur). `show` = der LOOK hat gewechselt: kurze Aufwertungs-Show (ein
-- Partikel-Stoss an der Spitze, < 2 s).
function MapService.updateTowerShowcase(player: Player, view: ArenaBuilder.ShowcaseView, show: boolean?)
	_showcase[player] = view

	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end

	local built = ArenaBuilder.buildShowcase(model, slot, view)
	if show then
		local foot = ArenaBuilder.showcaseFoot(slot)
		local height = MapConfig.TOWER_SHOWCASE.plinthHeight + view.floors * MapConfig.TOWER_SHOWCASE.floorHeight
		FigureFX.burstAt(foot + Vector3.new(0, height + 2, 0), view.color, built, 60)
	end
end

-- v15: Tower-Symbol unter dem Namen auf dem Plot-Schild ("◆ III · 42").
function MapService.setOwnerBadge(player: Player, text: string | Types.LocMsg, color: Color3)
	_badge[player] = { text = text, color = color }
	local model = _plotModels[player]
	if model then
		PlotBuilder.writeOwnerBadge(model, badgeText(player, text), color)
	end
end

-- Paket 9: Krone vor dem Plot-Symbol fuer die Top 10 der Endless-Woche.
-- Aufrufer ist LeaderboardService (kennt die Wochenliste).
function MapService.setOwnerCrown(player: Player, crowned: boolean)
	if (_crown[player] == true) == crowned then return end
	_crown[player] = if crowned then true else nil
	local badge = _badge[player]
	local model = _plotModels[player]
	if badge and model then
		PlotBuilder.writeOwnerBadge(model, badgeText(player, badge.text), badge.color)
	end
end

-- Farbe der kurzen Aufwertungs-Show beim Look-Wechsel (v15).
local LOOK_UPGRADE_COLOR = Color3.fromRGB(255, 220, 110)
local LOOK_UPGRADE_SPARKS = 40

-- v15: baut ein Gebaeude (oder den Recycler) NUR neu, wenn sich sein Look
-- geaendert hat (Attribut "Look" am Koerper gegen BuildingBehavior.getLook).
-- PlotDisplayService ruft das, wenn die Look-Signatur wechselt; Level-Aenderungen
-- innerhalb eines Looks laufen ueber das billige updateBuildingSigns.
-- `show` = kurze Aufwertungs-Show (ein Partikel-Stoss, < 2 s).
function MapService.updateBuildingLooks(player: Player, islandData: Types.IslandData, show: boolean?)
	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end

	local pool = PondBuilder.honeyPool(islandData)
	for _, building in islandData.buildings do
		local part = model:FindFirstChild(building.id)
		local look = BuildingBehavior.getLook(building.level)
		if part and part:IsA("BasePart") and part:GetAttribute("Look") ~= look then
			local position = part.Position
			part:Destroy()
			PlotBuilder.buildBuilding(model, slot, building, pool)
			if show then
				FigureFX.burstAt(position, LOOK_UPGRADE_COLOR, model, LOOK_UPGRADE_SPARKS)
			end
		end
	end

	local body = model:FindFirstChild(CombConfig.RECYCLER_NAME)
	local recyclerLook = BuildingBehavior.getLook(islandData.recycler.level)
	if body and body:IsA("BasePart") and body:GetAttribute("Look") ~= recyclerLook then
		local position = body.Position
		body:Destroy()
		RecyclerBuilder.build(model, slot, islandData.recycler)
		if show then
			FigureFX.burstAt(position, LOOK_UPGRADE_COLOR, model, LOOK_UPGRADE_SPARKS)
		end
	end
end

-- Haengt die Quelle fuer frische IslandData ein (siehe _islandDataProvider).
-- Wird einmal beim Start von PlotDisplayService aufgerufen.
function MapService.setIslandDataProvider(provider: (Player) -> Types.IslandData?)
	_islandDataProvider = provider
end

-- Wartet, bis die Figur des Spielers nicht mehr in einer Bewegung steckt, und
-- baut sie dann mit FRISCH gelesenen Daten neu.
--
-- Frisch gelesen ist der entscheidende Teil: waehrend der Bewegung koennen
-- weitere Aenderungen anfallen (mehrere Level-Ups waehrend eines Ess-Zyklus),
-- und nach einem Rebirth ist die alte IslandData-Tabelle gar nicht mehr die
-- des Spielers — sie einfach aufzuheben und spaeter nochmal zu rendern wuerde
-- einen veralteten Stand in die Welt stellen.
local function scheduleRebuildWhenFree(player: Player)
	if _pendingRebuild[player] then return end
	_pendingRebuild[player] = true

	task.spawn(function()
		local interval = MapConfig.FIGURE_REBUILD_RETRY_SECONDS
		local waited   = 0

		while waited < MapConfig.FIGURE_REBUILD_TIMEOUT_SECONDS do
			task.wait(interval)
			waited += interval

			-- Spieler weg oder Plot abgeraeumt: es gibt nichts mehr nachzuholen.
			if player.Parent == nil or _plotModels[player] == nil then
				break
			end

			if ActivityLock.isFree(player) then
				local provider = _islandDataProvider
				local island   = if provider then provider(player) else nil

				-- Vor dem erneuten Aufruf freigeben: updateBaerchis darf, falls
				-- inzwischen doch wieder eine Bewegung laeuft, sauber einen
				-- neuen Waechter starten.
				_pendingRebuild[player] = nil

				if island then
					MapService.updateBaerchis(player, island)
				end
				return
			end
		end

		_pendingRebuild[player] = nil
	end)
end

-- Baut die sichtbaren Baerchis eines Spielers NEU. Teuer — nur aufrufen wenn
-- sich der Bestand oder ein Level geaendert hat (siehe PlotDisplayService).
--
-- Steckt die Figur gerade in einer Bewegung, wird der Neuaufbau verschoben
-- statt sie mitten im Schritt zu ersetzen (Begruendung im Kopf der Datei).
function MapService.updateBaerchis(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	if not ActivityLock.isFree(player) then
		scheduleRebuildWhenFree(player)
		return
	end

	FigureBuilder.renderBaerchis(model, slot, islandData)
	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- Baut die herumliegenden Eier eines Spielers neu.
--
-- Anders als updateBaerchis KEINE ActivityLock-Pruefung: Eier bewegen sich
-- nicht und gehoeren niemandem, der sie gerade animiert. Sie duerfen deshalb
-- auch mitten in einem Kampf oder Weg zum Teich erscheinen und verschwinden —
-- genau das muss sogar sein, weil der Baerchi WAEHREND er laeuft legt.
function MapService.updateLaidEggs(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- Haengt den Ei-Einsammel-Handler ein: er laeuft, wenn der BESITZER eines
-- Plots sein eigenes gelegtes Ei mit der Spielfigur beruehrt. Wird einmal
-- beim Start von EggLayService aufgerufen (Pull-Callback statt require:
-- EggLayService requiret bereits MapService, der umgekehrte Weg waere ein
-- Ringschluss). Ohne Handler sammelt Beruehren einfach nichts ein.
function MapService.setEggCollectHandler(handler: (Player, string) -> ())
	LaidEggBuilder.setCollectHandler(handler)
end

-- Rechnet eine Weltposition in das Koordinatensystem des Plots um.
--
-- Gelegte Eier werden PLOT-RELATIV gespeichert, nicht in Weltkoordinaten. Der
-- Grund: welchen der acht Plots ein Spieler bekommt, entscheidet sich bei
-- jedem Join neu (siehe _freeSlots). Absolute Positionen wuerden nach einem
-- Rejoin auf einem anderen Plot liegen — im schlimmsten Fall auf dem eines
-- Nachbarn.
function MapService.worldToPlot(player: Player, worldPosition: Vector3): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end

	local plotCFrame = MapParts.plotCFrame(slot)
	if not plotCFrame then return nil end

	return plotCFrame:PointToObjectSpace(worldPosition)
end

-- Aktualisiert nur Beschriftung und Erschoepfung der bereits stehenden
-- Figuren. Billig — das ist der Weg fuer HP-Aenderungen.
function MapService.updateBaerchiStates(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return end

	for _, baerchi in islandData.baerchis do
		local figure = folder:FindFirstChild("Baerchi_" .. baerchi.uid)
		if figure and figure:IsA("Model") then
			FigureBuilder.writeBaerchiState(figure, baerchi, FigureBuilder.maxHpOf(baerchi))
		end
	end
end

-- Aktualisiert das Level-Attribut einer Gebaeude-Part (fuer Client-UI).
-- Wird nach einem Gebaeude-Upgrade aufgerufen; baut nichts neu.
function MapService.updateBuildingLevel(player: Player, buildingId: Types.BuildingId, level: number)
	local model = _plotModels[player]
	if not model then return end

	local part = model:FindFirstChild(buildingId)
	if part then
		part:SetAttribute("BuildingLevel", level)
	end
end

-- Wohin der Baerchi zum Fressen laeuft.
--
-- Das ist der Standplatz VOR dem Becken (auf den Bohlen), nicht mehr die
-- Beckenmitte. Bis der Teich ein richtiges Becken wurde, war beides dasselbe
-- — und der Baerchi stand mitten im Teich. Jetzt stuende er bis zum Bauch im
-- Beckenboden.
function MapService.getPondPosition(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return PondBuilder.pondStand(slot).Position
end

-- Mitte des Beckens (Weltposition) — z. B. damit gelegte Eier nicht im Honig
-- landen, seit der Baerchi am Becken wohnt (HONEY_POND_V2).
function MapService.getPondCenter(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return PondBuilder.pondGround(slot).Position
end

-- Fuellstand des Teichs nachziehen. Billig — das ist der Weg fuer
-- Honig-Aenderungen (siehe MapService.updateBuildingSigns, das das mit
-- aufruft, weil beides an denselben Werten haengt).
function MapService.updatePondFill(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	local pond = model:FindFirstChild("Pond")
	if not pond then return end

	local fill = pond:FindFirstChild("Fuellung")
	if fill and fill:IsA("BasePart") then
		PondBuilder.writePondFill(fill, PondBuilder.pondGround(slot), PondBuilder.pondFillRatio(islandData))
	end
end

-- Schreibt Level und Honig-Lagerstand auf die Gebaeude-Schilder.
-- Billig — das ist der Weg fuer Honig-Aenderungen.
function MapService.updateBuildingSigns(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local pool = PondBuilder.honeyPool(islandData)

	for _, building in islandData.buildings do
		local part = model:FindFirstChild(building.id)
		if part and part:IsA("BasePart") then
			part:SetAttribute("BuildingLevel", building.level)
			PlotBuilder.writeBuildingState(part, building, pool)
		end
	end

	-- Haengt an denselben Werten wie die Gebaeude-Schilder — deshalb hier
	-- gleich mit erledigt statt eines eigenen Aufrufers in PlotDisplayService.
	MapService.updatePondFill(player, islandData)
end

-- Sammel-Update Paket 8: Inkubator-Stand schreiben (Eier, Zeitmarken,
-- verfuegbare Plaetze). Billig; fehlt das Modell, wird es gebaut.
function MapService.updateIncubator(player: Player, islandData: Types.IslandData, slotCount: number)
	if not FeatureFlags.isOn("INCUBATOR") or not islandData.incubator then return end
	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end
	local existing = model:FindFirstChild(IncubatorConfig.MODEL_NAME)
	if existing and existing:IsA("Model") then
		IncubatorBuilder.writeState(existing, islandData.incubator, slotCount, islandData.baerchis)
	else
		IncubatorBuilder.build(model, slot, islandData.incubator, slotCount, islandData.baerchis)
	end
end

-- INCUBATOR_BREED: das Inkubator-Modell auf dem Plot des Spielers (Ort der
-- gebrueteten Eier), oder nil.
function MapService.getIncubatorModel(player: Player): Model?
	local model = _plotModels[player]
	local found = if model then model:FindFirstChild(IncubatorConfig.MODEL_NAME) else nil
	return if found and found:IsA("Model") then found else nil
end

-- Liefert die Platz-Zahl des Inkubators (setzt PlotDisplayService, weil sie
-- auch an Rebirths und Index-Belohnungen haengt).
function MapService.setIncubatorSlotProvider(provider: (Player) -> number)
	_incubatorSlots = provider
end

-- Schreibt Level, Warteschlange und Lampe des Waben-Recyclers neu.
-- Billig — der Weg fuer jede Aenderung der Warteschlange.
function MapService.updateRecycler(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local body = model:FindFirstChild(CombConfig.RECYCLER_NAME)
	if body and body:IsA("BasePart") then
		RecyclerBuilder.writeState(body, islandData.recycler)
	end
end

-- Die Anzeigetafel ueber der Arena. Bewusst ueber den exakten Pfad gesucht und
-- nicht rekursiv: unter dem Plot haengen bis zu 25 importierte Mesh-Figuren,
-- deren Teilenamen aus einer .glb stammen und die wir nicht kontrollieren.
-- Eine rekursive Suche wuerde bei einem gleichnamigen Teil das Falsche finden
-- — und muesste bei jeder der bis zu 60 Stages den ganzen Baum durchlaufen.
local function findPitBanner(player: Player): BillboardGui?
	local model = _plotModels[player]
	if not model then return nil end

	local platform = model:FindFirstChild("PitPlatform")
	if not platform then return nil end

	local anchor = platform:FindFirstChild("PitBannerAnchor")
	if not anchor then return nil end

	local banner = anchor:FindFirstChild("Banner")
	return if banner and banner:IsA("BillboardGui") then banner else nil
end

-- Die Anzeigetafel ueber der Arena beschriften und einblenden.
-- Aufgerufen von PitArenaService waehrend einer Wiedergabe; MapService kennt
-- den Kampfverlauf nicht und entscheidet deshalb nichts ueber den Inhalt.
-- Titel und Untertitel duerfen Nachrichten (LocMsg) sein: die Tafel sieht
-- jeder Spieler, und jeder liest sie in seiner Sprache (siehe WorldText).
function MapService.setPitBanner(player: Player, title: string | Types.LocMsg, subtitle: string | Types.LocMsg, color: Color3)
	local banner = findPitBanner(player)
	if not banner then return end

	local titleLabel = banner:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		WorldText.set(titleLabel, title)
		titleLabel.TextColor3 = color
	end

	local subLabel = banner:FindFirstChild("Sub")
	if subLabel and subLabel:IsA("TextLabel") then
		WorldText.set(subLabel, subtitle)
	end

	banner.Enabled = true
end

-- Tafel wieder ausblenden. Idempotent — ein zweiter Aufruf schadet nicht.
function MapService.clearPitBanner(player: Player)
	local banner = findPitBanner(player)
	if banner then
		banner.Enabled = false
	end
end

--------------------------------------------------------------------------------
-- Event-Pit: Farbe und Anzeigetafel von aussen setzbar (EventService)
--------------------------------------------------------------------------------

-- Anders als findPitBanner gibt es das Event-Pit nur EINMAL fuer die ganze
-- Welt, nicht pro Spieler — keine Player-Suche noetig.
local function findEventPitContainer(): Model?
	local platform = workspace:FindFirstChild("Platform")
	if not platform then return nil end

	local pit = platform:FindFirstChild("EventPit")
	return if pit and pit:IsA("Model") then pit else nil
end

export type EventTheme = {
	floorColor : Color3,
	fenceColor : Color3,
	ringColor  : Color3,
}

-- Faerbt Boden, Zaun und Ring des Event-Pits um. Mit `theme = nil` kehrt es
-- zum schlichten Stall-Look zurueck (siehe MapConfig, EVENT_PIT_DEFAULT_*).
-- EventService ruft das genau zweimal pro Zyklus: einmal beim Start eines
-- Events mit dessen Farben, einmal beim Ende mit nil.
function MapService.setEventPitTheme(theme: EventTheme?)
	local container = findEventPitContainer()
	if not container then return end

	local floorColor = if theme then theme.floorColor else MapConfig.EVENT_PIT_DEFAULT_FLOOR_COLOR
	local fenceColor = if theme then theme.fenceColor else MapConfig.EVENT_PIT_DEFAULT_FENCE_COLOR
	local ringColor  = if theme then theme.ringColor  else MapConfig.EVENT_PIT_DEFAULT_RING_COLOR

	-- Material wechselt mit: Wood/SmoothPlastic im Stall-Look, Neon waehrend
	-- eines Events — sonst saehe man den Farbwechsel bei Zaun und Ring kaum,
	-- weil beide im Stall-Look bewusst matt sind.
	local activeMaterial = if theme then Enum.Material.Neon else Enum.Material.Wood
	local ringMaterial   = if theme then Enum.Material.Neon else Enum.Material.SmoothPlastic

	local floor = container:FindFirstChild("EventFloor")
	if floor and floor:IsA("BasePart") then
		floor.Color = floorColor
	end

	local ring = container:FindFirstChild("EventRing")
	if ring and ring:IsA("BasePart") then
		ring.Color    = ringColor
		ring.Material = ringMaterial
	end

	for _, child in container:GetChildren() do
		if child.Name:match("^EventFence_") and child:IsA("BasePart") then
			child.Color    = fenceColor
			child.Material = activeMaterial
		end
	end
end

-- Beschriftet die Countdown-Tafel ueber dem Event-Pit. Anders als
-- setPitBanner blendet das hier NICHT ein/aus — die Tafel steht permanent
-- (siehe buildEventPit): sie zeigt entweder den Countdown bis zum naechsten
-- Event oder Name + Restzeit des laufenden.
function MapService.setEventBanner(title: string | Types.LocMsg, subtitle: string | Types.LocMsg, color: Color3, reward: (string | Types.LocMsg)?)
	local container = findEventPitContainer()
	if not container then return end

	local anchor = container:FindFirstChild("EventBannerAnchor")
	if not anchor then return end

	local banner = anchor:FindFirstChild("Banner")
	if not (banner and banner:IsA("BillboardGui")) then return end

	local titleLabel = banner:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		WorldText.set(titleLabel, title)
		titleLabel.TextColor3 = color
	end

	local subLabel = banner:FindFirstChild("Sub")
	if subLabel and subLabel:IsA("TextLabel") then
		WorldText.set(subLabel, subtitle)
	end

	local rewardLabel = banner:FindFirstChild("Reward")
	if rewardLabel and rewardLabel:IsA("TextLabel") then
		WorldText.set(rewardLabel, reward or "")
	end
end

-- Weltposition der PODEST-OBERFLAECHE des Event-Pits in der Weltmitte.
--
-- Anders als getPitPosition NICHT pro Spieler: das Event-Pit gibt es einmal
-- fuer die ganze Welt (siehe findEventPitContainer). EventParticipationService
-- laesst die Figuren aller teilnehmenden Spieler auf dieselbe Flaeche laufen.
--
-- Der Y-Wert ist dieselbe Rechnung wie in buildEventPit (`floorY`), bewusst
-- aus MapConfig neu gerechnet statt aus der gebauten Geometrie gemessen: die
-- Zahl gehoert der Konfiguration, nicht dem Modell.
function MapService.getEventPitPosition(): Vector3
	local center = MapConfig.CENTER
	local floorY = MapConfig.PLATFORM_TOP_Y
		+ MapConfig.EVENT_PIT_GROUND_CLEARANCE
		+ MapConfig.EVENT_PIT_FLOOR_HEIGHT

	return Vector3.new(center.X, floorY, center.Z)
end

-- Radius der begehbaren Event-Flaeche. EventParticipationService prueft damit
-- serverseitig nach, ob eine Figur tatsaechlich noch dort steht, statt sich auf
-- ein gesetztes Flag zu verlassen.
function MapService.getEventPitRadius(): number
	return MapConfig.EVENT_PIT_RADIUS
end

-- Weltposition der Kampfflaeche dieses Spielers.
-- Wird von PitArenaService benoetigt um die Kaempfer zu platzieren.
function MapService.getPitPosition(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return MapParts.pitCenter(slot)
end

-- Das CFrame des Plots (Blickrichtung zur Plattform-Mitte).
-- PitArenaService braucht es, um die Kaempfer sinnvoll auszurichten.
function MapService.getPlotCFrame(player: Player): CFrame?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return MapParts.plotCFrame(slot)
end

-- Die stehende Figur eines Baerchis auf dem Plot, falls vorhanden.
-- PitArenaService schickt genau diese Figur in die Arena und wieder zurueck,
-- statt eine zweite Kopie zu bauen — sonst staende derselbe Baerchi doppelt
-- in der Welt.
function MapService.getBaerchiModel(player: Player, baerchiUid: string): Model?
	local model = _plotModels[player]
	if not model then return nil end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return nil end

	local figure = folder:FindFirstChild("Baerchi_" .. baerchiUid)
	if figure and figure:IsA("Model") then
		return figure
	end
	return nil
end

-- Feiert ein Ereignis (Level-Up, Promotion, Rebirth, ...) SICHTBAR auf dem
-- Plot: Partikel-Stoss, Huepfer, kurzes Aufleuchten (siehe FigureFX.celebrate).
--
-- Bewusst als eigene MapService-Funktion und nicht direkt FigureFX.celebrate
-- vom Aufrufer: der Aufrufer (HoneyService, PromotionService, RebirthService,
-- ...) soll keine Modelle aus der Welt heraussuchen muessen — genau wie bei
-- getBaerchiModel bleibt das MapServices Job. Steht die Figur gerade nicht in
-- der Welt (Plot noch nicht gebaut, Bewegung verzoegert den Neuaufbau), passiert
-- einfach nichts — kein Fehler, der Toast-Text kommt ja trotzdem an.
function MapService.celebrateBaerchi(player: Player, baerchiUid: string, color: Color3)
	local model = MapService.getBaerchiModel(player, baerchiUid)
	if not model then return end

	FigureFX.celebrate(model, color)
end

-- Beschriftung und Transparenz einer Figur mit einem AUSDRUECKLICH
-- angegebenen HP-Wert setzen — auch waehrend eines laufenden PIT-Kampfes.
--
-- Nur fuer PitArenaService: der muss die Figur beim Start der Wiedergabe auf
-- die HP zuruecksetzen, mit denen der Lauf BEGONNEN hat. Die gespeicherten HP
-- stehen zu dem Zeitpunkt laengst auf dem Endwert, der Baerchi saehe sonst
-- schon vor dem ersten Schlag erschoepft aus.
function MapService.setFigureState(model: Model, hp: number, maxHp: number)
	FigureBuilder.writeFigureState(model, hp, maxHp)
end

-- Der Ordner in der Arena, in den die Kampf-Figuren gehoeren.
function MapService.getFighterFolder(player: Player): Folder?
	local model = _plotModels[player]
	if not model then return nil end

	local pit = model:FindFirstChild("PitPlatform")
	if not pit then return nil end

	local fighters = pit:FindFirstChild("Fighters")
	if fighters and fighters:IsA("Folder") then
		return fighters
	end
	return nil
end

-- Baut den PIT-Turm auf genau `level` Etagen aus bzw. ab — idempotent: fehlt
-- eine Etage, wird sie ergaenzt; ist eine zu viel da, wird sie entfernt. Mit
-- `level = 0` verschwindet der Turm komplett.
--
-- PitArenaService ruft das bei jeder Stage mit der neuen Stufenzahl auf, und
-- mit 0 sobald ein Lauf zu Ende ist oder ein neuer beginnt — der Turm bleibt
-- also NIE zwischen zwei Laeufen stehen, genau wie die Kampf-Figuren selbst
-- (siehe clearFighters in PitArenaService).
--
-- Bewegt bei einem Aufbau auch die Anzeigetafel-Verankerung mit nach oben,
-- damit sie ueber dem gewachsenen Turm haengen bleibt statt mittendrin zu
-- stecken.
function MapService.setPitTowerLevel(player: Player, level: number)
	local slot  = _playerSlot[player]
	local model = _plotModels[player]
	if not slot or not model then return end

	local container = model:FindFirstChild("PitPlatform")
	if not container then return end

	local tower = container:FindFirstChild("Tower")
	if not (tower and tower:IsA("Folder")) then return end

	local wanted = math.max(0, math.floor(level))
	local center = MapParts.pitCenter(slot)

	for _, child in tower:GetChildren() do
		local index = tonumber(child.Name:match("^Ring_(%d+)$"))
		if not index or index > wanted then
			child:Destroy()
		end
	end

	for i = 1, wanted do
		if not tower:FindFirstChild("Ring_" .. i) then
			ArenaBuilder.buildTowerRing(tower, center, i)
		end
	end

	local anchor = container:FindFirstChild("PitBannerAnchor")
	if anchor and anchor:IsA("BasePart") then
		local topY = MapConfig.PLATFORM_TOP_Y
			+ wanted * MapConfig.PIT_TOWER_STEP_HEIGHT
			+ MapConfig.PIT_BANNER_HEIGHT
		anchor.CFrame = CFrame.new(center.X, topY, center.Z)
	end
end

-- Hoehe (Y ueber PLATFORM_TOP_Y) der Kampfflaeche bei `level` bereits
-- gewachsenen Etagen. PitArenaService braucht das, um die Kaempfer beim
-- Erklimmen jeder Stage auf die richtige Hoehe zu stellen — dieselbe Formel
-- wie in buildTowerRing, hier aber ohne selbst eine Etage zu bauen.
function MapService.getPitTowerFloorY(level: number): number
	return MapConfig.PLATFORM_TOP_Y + math.max(0, level) * MapConfig.PIT_TOWER_STEP_HEIGHT
end

-- v15: die Bestenlisten-Tafel(n) beschriften (Titel + bis zu
-- LEADERBOARD_BOARD.lines Zeilen). Aufrufer ist LeaderboardService.
-- HBB Paket 5: eine Tafel je Liste; Schluessel = listId, "_rotating" = die
-- eine wechselnde Tafel ohne MAP_V2_BOARDS.
local ROTATING = "_rotating"
local _leaderboardBoards: { [string]: BasePart } = {}
local _liveBoard: BasePart? = nil
local _waspNest: Model? = nil

local function writeBoard(board: BasePart?, title: string, lines: { string }, lineCount: number, titleColor: Color3?)
	if not board then return end
	local surface = board:FindFirstChild("Board")
	if not surface then return end

	local titleLabel = surface:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		titleLabel.Text = title
		if titleColor then titleLabel.TextColor3 = titleColor end
	end
	for i = 1, lineCount do
		local line = surface:FindFirstChild("Line" .. i)
		if line and line:IsA("TextLabel") then
			line.Text = lines[i] or ""
		end
	end
end

-- Gibt es eine feste Tafel fuer `listId`? (sonst: wechselnde Tafel)
function MapService.hasLeaderboardBoard(listId: string): boolean
	return _leaderboardBoards[listId] ~= nil
end

function MapService.writeLeaderboardBoard(title: string, lines: { string }, listId: string?)
	local board = (if listId then _leaderboardBoards[listId] else nil) or _leaderboardBoards[ROTATING]
	writeBoard(board, title, lines, MapConfig.LEADERBOARD_BOARD.lines)
end

-- HBB Paket 6: Live-Kampf-Board beschriften. Aufrufer ist LiveBoardService.
function MapService.writeLiveBoard(title: string, lines: { string }, live: boolean)
	local cfg = MapConfig.LIVE_BOARD
	writeBoard(_liveBoard, title, lines, cfg.lines, if live then cfg.liveColor else cfg.textColor)
end

-- HBB Paket 6: Schild und Leuchten des Wespen-Nests. Aufrufer ist EventService.
function MapService.setWaspNest(text: string, glowing: boolean)
	local nest = _waspNest
	if not nest then return end
	local cfg = MapConfig.WASP_NEST
	local body = nest:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		body.Material = if glowing then Enum.Material.Neon else Enum.Material.Sand
		body.Color    = if glowing then cfg.glowColor else cfg.color
	end
	local anchor = nest:FindFirstChild("SignAnchor")
	local sign = if anchor then anchor:FindFirstChild("Sign") else nil
	local title = if sign then sign:FindFirstChild("Title") else nil
	if title and title:IsA("TextLabel") then
		title.Text = text
	end
end

-- v15: Teile auf der Insel eines Spielers zaehlen (Debug-Befehl "parts",
-- Budget <= 250 pro Insel ohne Baerchi-Mesh). Getrennt nach Bereichen, damit man
-- sieht, wo das Budget hingeht. Die Figuren (importierte Meshes) zaehlen extra.
function MapService.countParts(player: Player): { [string]: number }?
	local model = _plotModels[player]
	if not model then return nil end

	local result: { [string]: number } = { total = 0, figures = 0 }
	for _, child in model:GetChildren() do
		local count = if child:IsA("BasePart") then 1 else 0
		for _, descendant in child:GetDescendants() do
			if descendant:IsA("BasePart") then count += 1 end
		end
		local key = child.Name
		if key == "Baerchis" then
			result.figures += count
		else
			result[key] = (result[key] or 0) + count
			result.total += count
		end
	end
	return result
end

function MapService.init()
	-- Freie Slots einmalig aufbauen
	for slot = 1, MapConfig.PLOT_COUNT do
		table.insert(_freeSlots, slot)
	end

	-- ============================================================
	-- GEOMETRIE-PRUEFUNG
	-- ============================================================
	-- Die Weltgeometrie haengt an einem guten Dutzend Zahlen, die voneinander
	-- abhaengen. Faellt eine aus dem Rahmen, sieht man das im fertigen Spiel als
	-- Loch im Boden oder als Insel im Nichts — und sucht dann im Code statt in
	-- der Config. Diese vier Pruefungen sagen es beim Start, im Klartext.
	--
	-- Sie WARNEN nur und brechen nicht ab: eine Welt mit einer schiefen Zahl ist
	-- immer noch spielbar, und ein harter Abbruch beim Serverstart waere die
	-- schlechtere Rueckmeldung.

	-- 1. Passt das quadratische Beet auf die runde Plot-Insel? Entscheidend ist
	--    die ECKE, nicht die Kante — eine halbe Diagonale, nicht eine halbe Seite.
	local plateCorner = math.sqrt(
		(MapConfig.PLOT_SIZE.X * 0.5) ^ 2 + (MapConfig.PLOT_SIZE.Z * 0.5) ^ 2
	)
	if plateCorner > MapConfig.PLOT_ISLAND_RADIUS then
		warn(
			"[MapService] Das Beet ragt ueber die Plot-Insel:",
			"halbe Diagonale von PLOT_SIZE =", string.format("%.1f", plateCorner),
			"> PLOT_ISLAND_RADIUS =", MapConfig.PLOT_ISLAND_RADIUS
		)
	end

	-- 2. Liegt der Plot-Ring wirklich eine Steglaenge vor der Hauptinsel?
	--    Sonst waere der Steg entweder zu kurz (Luecke) oder zu lang (er endet
	--    auf der Insel).
	local expectedRing = MapConfig.PLATFORM_RADIUS + MapConfig.ISLAND_GAP + MapConfig.PLOT_ISLAND_RADIUS
	if math.abs(MapConfig.PLOT_RING_RADIUS - expectedRing) > 0.5 then
		warn(
			"[MapService] PLOT_RING_RADIUS passt nicht zur Luecke:",
			MapConfig.PLOT_RING_RADIUS, "sollte", expectedRing, "sein",
			"(PLATFORM_RADIUS + ISLAND_GAP + PLOT_ISLAND_RADIUS)"
		)
	end

	-- 3. Beruehren sich zwei benachbarte Plot-Inseln samt Sandkante?
	local shoreRadius = MapConfig.PLOT_ISLAND_RADIUS + MapConfig.SHORE_WIDTH
	local neighbourGap = 2 * MapConfig.PLOT_RING_RADIUS
		* math.sin(math.pi / MapConfig.PLOT_COUNT) - 2 * shoreRadius
	if neighbourGap <= 0 then
		warn(
			"[MapService] Die Plot-Inseln ueberlappen sich:",
			MapConfig.PLOT_COUNT, "Inseln mit Rand", shoreRadius,
			"auf Ring", MapConfig.PLOT_RING_RADIUS
		)
	end

	-- 4. Reicht das Wasser bis hinter die aeusserste Arena?
	local worldEdge = (MapParts.pitCenter(1) - MapConfig.CENTER).Magnitude
		+ MapConfig.PIT_BASE_RADIUS + MapConfig.SHORE_WIDTH
	if worldEdge > MapConfig.WATER_RADIUS then
		warn(
			"[MapService] Die Arenen ragen ueber den Wasserrand:",
			"Weltrand =", string.format("%.0f", worldEdge),
			"> WATER_RADIUS =", MapConfig.WATER_RADIUS
		)
	end

	WorldBuilder.buildPlatform()
	WorldBuilder.buildGlobalLighting()

	-- v15: Bestenlisten-Tafel(n) (LeaderboardService beschriftet sie).
	-- HBB Paket 5/6: Positionen aus MapLayout (dort auch der Layout-Test).
	local platform = workspace:FindFirstChild("Platform") or workspace
	for _, b in MapLayout.leaderboardBoards() do
		local listId = b.listId
		local name = if listId then "LeaderboardBoard_" .. listId else "LeaderboardBoard"
		_leaderboardBoards[listId or ROTATING] = WorldBuilder.buildLeaderboardBoard(platform, b.angleDegrees, name)
	end
	if FeatureFlags.isOn("MAP_V2_LIVE_BOARD") then
		_liveBoard = WorldBuilder.buildLiveBoard(platform)
	end
	if FeatureFlags.isOn("MAP_V2_WASP_NEST") then
		_waspNest = WorldBuilder.buildWaspNest(platform, MapLayout.waspNestCenter())
	end

	-- Sicherheitsnetz: falls PlayerService den Leave-Fall mal verpasst,
	-- bleibt sonst ein Slot dauerhaft belegt.
	Players.PlayerRemoving:Connect(function(player)
		if _playerSlot[player] then
			MapService.despawnIsland(player)
		end
	end)

	print("[MapService] Initialisiert | Plots:", MapConfig.PLOT_COUNT)
end

return MapService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">PitArenaService</string><ProtectedString name="Source"><![CDATA[--!strict
-- PitArenaService.luau
-- ServerScriptService/Services/PitArenaService.luau
--
-- Einzige Zustaendigkeit:
--   - Einen von CombatService fertig simulierten PIT-Lauf in der Arena
--     abspielen und dabei den Lauf ZEITLICH fuehren: Hinweg, Stage fuer Stage,
--     Rueckweg, Zurueckholen und Abbruch
--
-- Zum Fuehren gehoert, dass dieser Service entscheidet, WANN abgerechnet und
-- WANN das Ergebnis verschickt wird — beides haengt an der Wiedergabe:
--   - Abrechnung: CombatService gibt eine Funktion (settle) mit. Sie laeuft
--     GENAU EINMAL mit der Zahl der tatsaechlich gespielten Stages: alle bei
--     normalem Ende, bis einschliesslich der laufenden beim Zurueckholen
--     (requestRecall; vor der ersten Stage: 0), und beim Verlassen so, als
--     waere die begonnene Stage zu Ende gespielt (PlayerService.onPlayerLeaving).
--     WAS abgerechnet wird, weiss nur CombatService; dieser Service fasst
--     Spielerdaten selbst nicht an.
--   - Ergebnis: Remotes.CombatResultReceived geht erst raus, wenn abgerechnet
--     ist. sendResult() ist die einzige Stelle, die es abschickt, und
--     idempotent — alle Abbruch- und Erfolgspfade duerfen es aufrufen.
--   - Phase (ToPit / InPit / Returning) und laufende Stage meldet er fuer
--     die Pet-Leiste (PetModeService liest getPhase).
--
-- Warum auf dem SERVER und nicht im Client: die Arenen liegen in derselben
-- Welt wie alle Plots. Serverseitig kann ein Nachbar ueber den Steg kommen
-- und zuschauen.
--
-- Die Figur wird nicht kopiert, sondern die ECHTE Figur vom Plot wandert in
-- die Arena und danach exakt an ihren Platz zurueck. Eine zweite Kopie waere
-- sonst gleichzeitig auf dem Plot zu sehen.
--
-- ============================================================
-- HEIMKEHR — die eigentliche Schwierigkeit
-- ============================================================
-- Der Ausgangs-Pivot der Figur darf NICHT beim Start jeder Wiedergabe frisch
-- abgelesen werden: startet ein zweiter Lauf waehrend der erste noch laeuft,
-- stuende die Figur da schon in der Arena und wuerde spaeter genau dorthin
-- "zurueckgesetzt". Deshalb merkt sich dieser Service den Platz auf dem Plot
-- getrennt (_home) und raeumt einen laufenden Lauf IMMER erst komplett auf,
-- bevor ein neuer beginnt.
--
-- Abbrechen kann die Wiedergabe ausserdem: der Spieler geht, oder der Plot
-- wird neu gebaut (dann ist die Figur weg). Beides wird geprueft, und in
-- keinem Fall bleibt etwas Halbes stehen.
--
-- ============================================================
-- ZUG UM ZUG
-- ============================================================
-- CombatService gibt pro Stage die einzelnen Zuege mit (Types.FightBeat).
-- Jede Stage wird als Folge von Stoessen gezeigt: die Baerchis laufen
-- aufeinander zu und prallen zusammen (FigureFX.clash). Unter dem eigenen
-- HP-Balken laeuft eine Ladeleiste (Util/FightBars); ist sie voll, kommt die
-- Faehigkeit mit ihrer Show (SkillFX, beim ersten Mal voll, danach als Echo).
-- WELCHE Zuege in die Zeit passen, rechnet FightTimeline.
--
-- startPlayback ist bewusst EINE lange Funktion: sie erzaehlt den Ablauf
-- eines Laufs von vorn nach hinten, und ihre Schritte teilen viel Zustand.
-- Zerlegt in viele kleine Funktionen muesste man zum Verstehen hin und her
-- springen.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)
local MapConfig   = require(ReplicatedStorage.Config.MapConfig)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local SkillConfig = require(ReplicatedStorage.Config.SkillConfig)
local SkillFXConfig = require(ReplicatedStorage.Config.SkillFXConfig)
local BaerchiMesh = require(ReplicatedStorage.Modules.BaerchiMesh)
local FightTimeline = require(ReplicatedStorage.Modules.FightTimeline)
local Types       = require(ReplicatedStorage.Network.Types)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local Remotes     = require(ReplicatedStorage.Network.Remotes)

local PlayerService   = require(ServerScriptService.Services.PlayerService)
local MapService      = require(ServerScriptService.Services.MapService)
local FigureWalker    = require(ServerScriptService.Util.FigureWalker)
local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)
local RateLimiter     = require(ServerScriptService.Util.RateLimiter)   -- Paket 4.3
local FigureFX        = require(ServerScriptService.Util.FigureFX)
local ActivityLock    = require(ServerScriptService.Util.ActivityLock)
local FightBars       = require(ServerScriptService.Util.FightBars)

-- Name unter dem PitArenaService das Bewegungs-Schloss haelt (siehe
-- ActivityLock) — verhindert dass BaerchiAutopilotService den Baerchi
-- waehrend eines Kampf-Laufs zum Honig-Teich abzieht.
local LOCK_HOLDER = "Kampf"

local PitArenaService = {}

-- HBB Paket 5 (MAP_V2_ARENA_SPRINT): auf dem Weg Plot <-> Arena sprintet der
-- Baerchi (MapConfig.ARENA_WALK_SPEED) statt zu gehen — weniger Warten je Lauf.
local function arenaWalkSpeed(): number
	return if FeatureFlags.isOn("MAP_V2_ARENA_SPRINT") then MapConfig.ARENA_WALK_SPEED else MapConfig.WALK_SPEED
end

-- Gleich viele Hopser pro SEKUNDE wie beim Gehen, dafuer weitere: schnelleres
-- Huepfen liest das Auge als Zittern (siehe MapConfig.WALK_BOB_PER_STUD).
local function arenaBobPerStud(): number
	return MapConfig.WALK_BOB_PER_STUD * MapConfig.WALK_SPEED / arenaWalkSpeed()
end

-- Laufende Wiedergabe pro Spieler. Startet ein neuer Lauf, wird der alte
-- Token ungueltig und die alte Schleife beendet sich beim naechsten Schritt.
local _runToken: { [Player]: number } = {}

-- Ergebnis, das der Client noch nicht bekommen hat. Wird gesetzt sobald ein
-- Lauf beginnt und erst gefeuert, wenn der Baerchi sichtbar am Kampf-Spot
-- angekommen ist (siehe sendResult) — vorher liefe die Kampf-UI schon,
-- waehrend er noch zur Arena unterwegs waere. Bleibt die Wiedergabe aus
-- irgendeinem Grund stecken (kein Plot, Fehler waehrend des Laufs), wird an
-- den Abbruchstellen trotzdem gesendet, damit der Client nie ganz ohne
-- Ergebnis dasteht.
--
-- Der Eintrag traegt seinen eigenen Token: `isRunning` verhindert zwar, dass
-- ueberhaupt ein zweiter Lauf waehrend eines laufenden startet, aber ohne den
-- Token wuerde selbst ein knapp daneben abgewiesener Request die
-- Abbruch-Fallbacks eines ANDEREN, spaeter gestarteten Laufs treffen und
-- dessen Ergebnis zu frueh verschicken — genau der Fehler, den sendResult
-- eigentlich beheben soll. sendResult prueft den Token deshalb mit.
-- v12: Abrechnung und Zustand des laufenden Laufs. `entered` = wie viele
-- Stages bereits BEGONNEN haben (fuer die Abrechnung bei Abbruch), `phase`
-- und `stage` fuer die Anzeige, `recall` = Spieler will zurueck.
export type SettleFn = (played: number, recalled: boolean) -> Types.PitRunResult
type Active = {
	token   : number,
	run     : Types.PitRunResult,
	settle  : SettleFn?,
	settled : Types.PitRunResult?,
	sent    : boolean,
	entered : number,
	recall  : boolean,
	beats   : { { Types.FightBeat } }?,   -- v15: Zuege je Stage (Index = Stage im Lauf)
	phase   : string,     -- "ToPit" | "InPit" | "Returning"
	stage   : number?,
}
local _active: { [Player]: Active } = {}

-- Wo die gerade kaempfende Figur auf dem Plot hingehoert. homeFoot ist der
-- Fusspunkt VOR dem Loslaufen (fuer den Weg zurueck), pivot der exakte
-- Ausgangszustand (fuer den abschliessenden Snap in restoreHome).
type Home = { model: Model, pivot: CFrame, homeFoot: Vector3 }
local _home: { [Player]: Home } = {}

-- Sammel-Update 05.10. (Paket 4.3, "schnell den Tower hochfliegen"): Tempo
-- der Wiedergabe je Spieler (1, 2, 4 oder 0 = "Ergebnis sofort"). Die
-- Abrechnung aendert sich NICHT: sie steht ohnehin fest, bevor die Wiedergabe
-- beginnt, und wird am Ende ausgezahlt — schneller abspielen heisst nur
-- schneller ankommen. Gilt ab der naechsten Stage, gemerkt fuer die Sitzung.
local VALID_SPEEDS: { [number]: number } = { [1] = 1, [2] = 2, [4] = 4, [0] = 40 }
local _speed: { [Player]: number } = {}

local function speedFactor(player: Player): number
	return VALID_SPEEDS[_speed[player] or 1] or 1
end

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- Bringt eine noch in der Arena stehende Figur an ihren Platz auf dem Plot
-- zurueck und raeumt ihren Kampf-Balken weg. Idempotent: zweimal aufrufen
-- schadet nicht.
local function restoreHome(player: Player)
	local home = _home[player]
	if not home then return end

	_home[player] = nil

	local model = home.model
	if model.Parent ~= nil then
		FightBars.removeHealthBar(model)
		model:SetAttribute("InArena", nil)

		-- ZUERST abmelden, DANN heimsetzen — nie andersherum. Waehrend des
		-- Kampfs atmet die Figur am Kampf-Spot, ihre gemerkte Ruhelage ist also
		-- die Arena-Position. Ein spaeteres Abmelden wuerde sie genau dorthin
		-- zuruecksetzen und die Heimkehr wieder zunichtemachen.
		FigureFX.stopIdle(model)
		model:PivotTo(home.pivot)

		-- Zuhause angekommen und wieder in Ruhe: `home.pivot` ist garantiert
		-- die saubere Ruhelage, weil startPlayback das Atmen VOR dem Merken
		-- abgeschaltet hat.
		FigureFX.idleBob(model, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
	end
end

-- Alle Gegner-Figuren aus der Arena raeumen.
local function clearFighters(player: Player)
	local fighters = MapService.getFighterFolder(player)
	if not fighters then return end

	for _, child in fighters:GetChildren() do
		child:Destroy()
	end
end

-- Text auf der Anzeigetafel ueber der Arena. Die Tafel selbst gehoert
-- MapService; hier wird nur entschieden WAS draufsteht, weil nur dieser
-- Service den Verlauf des Laufs kennt.
-- v15: "Tower II · Stage 23"
-- Tafel-Texte sind Nachrichten (LocMsg): die Tafel sieht jeder Spieler auf
-- der Plattform, und jeder liest sie in seiner Sprache (MapService/WorldText).
local function stageTitle(towerId: string?, stage: number): Types.LocMsg
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	return Loc.msg("ui.pitboard.stage", { tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), stage = stage })
end

local function showStage(player: Player, towerId: string?, stage: Types.PitStageResult, cleared: number)
	MapService.setPitBanner(
		player,
		stageTitle(towerId, stage.stage),
		-- Sammel-Update 2.4: die Tafel sehen alle Spieler, jeder in seiner
		-- Sprache — deshalb Symbole und Zahlen statt deutscher Woerter.
		if cleared > 0
			then string.format("✔ %d", cleared)
			else "⚔ 1",
		MapConfig.PIT_BANNER_RUNNING
	)
end

local function showSummary(player: Player, run: Types.PitRunResult)
	-- "Geschafft" ist die Zahl gewonnener Stages. Sie kann 0 sein — dann hat
	-- der Baerchi den ersten Gegner nicht ueberlebt, und genau das soll auch
	-- dastehen statt eines beschoenigenden "0 geschafft".
	local won = run.stagesCleared > 0

	MapService.setPitBanner(
		player,
		if won
			then Loc.msg("fmt.append", { a = "✔", b = Loc.msg("ui.pitboard.won", { n = run.stagesCleared }) })
			else Loc.msg("fmt.append", { a = "✖", b = Loc.msg("ui.pitboard.none") }),
		Loc.msg("event.bonus.gummies", { n = run.gummiesWon }),
		if won then MapConfig.PIT_BANNER_WIN else MapConfig.PIT_BANNER_LOSS
	)
end

-- Schickt das Kampfergebnis an den Client — idempotent, weil mehrere
-- Abbruch- und Erfolgspfade das hier alle "auf gut Glueck" aufrufen koennen.
-- Erst danach darf CombatPanel seine Stage-Wiedergabe starten; siehe die
-- Aufrufstelle in startPlayback fuer den genauen Zeitpunkt (Ankunft am
-- Kampf-Spot).
-- `token` muss zu dem Lauf gehoeren, der sendResult aufruft — sonst koennte
-- der Abbruch-Fallback eines ueberholten Laufs A das laengst neu gesetzte
-- _pendingResult eines inzwischen gestarteten Laufs B verschicken, noch
-- bevor dessen eigener Baerchi angekommen ist.
-- v12: rechnet ab (einmal) und gibt das abgerechnete Ergebnis zurueck. Ohne
-- settle-Funktion (Altaufruf) zaehlt der volle Lauf.
local function settleActive(active: Active, played: number, recalled: boolean): Types.PitRunResult
	if active.settled then
		return active.settled
	end

	local settle = active.settle
	local result = active.run
	if settle then
		local ok, res = pcall(settle, played, recalled)
		if ok then
			result = res
		else
			warn("[PitArenaService] Abrechnung fehlgeschlagen:", res)
		end
	end

	active.settled = result
	return result
end

-- Schickt das ABGERECHNETE Ergebnis an den Client — idempotent und nur fuer
-- den Lauf, zu dem der Token gehoert. Wurde noch nicht abgerechnet (Abbruch),
-- wird hier mit den bereits begonnenen Stages abgerechnet.
local function sendResult(player: Player, token: number)
	local active = _active[player]
	if not active or active.token ~= token or active.sent then return end
	active.sent = true

	local result = settleActive(active, active.entered, active.recall)
	if player.Parent ~= nil then
		Remotes.CombatResultReceived:FireClient(player, result)
	end
end

-- Den Erschoepfungs-Zustand nachziehen, der waehrend der Wiedergabe
-- unterdrueckt war.
local function refreshState(player: Player)
	local data = PlayerService.getData(player)
	if data then
		MapService.updateBaerchiStates(player, data.island)
	end
end

--------------------------------------------------------------------------------
-- Wiedergabe
--------------------------------------------------------------------------------

-- Steht die Wiedergabe noch? Prueft alles was sie abbrechen kann:
-- ein neuer Lauf, der Spieler geht, der Plot wird neu gebaut (Figur weg),
-- oder das PIT wird ausgebaut (dann ist der Kaempfer-Ordner mit zerstoert
-- worden und neue Gegner landeten unsichtbar im Nirgendwo).
local function setPhase(player: Player, token: number, phase: string, stage: number?)
	local active = _active[player]
	if active and active.token == token then
		active.phase = phase
		active.stage = stage
	end
end

local function recallWanted(player: Player, token: number): boolean
	local active = _active[player]
	return active ~= nil and active.token == token and active.recall
end

local function stillValid(player: Player, token: number, figure: Model, fighters: Folder): boolean
	if _runToken[player] ~= token then return false end
	if player.Parent == nil then return false end
	if figure.Parent == nil then return false end
	if fighters.Parent == nil then return false end
	return true
end

-- v12: Laesst den Turm Etage fuer Etage von `fromLevel` auf `toLevel` wachsen
-- (oder schrumpfen) und haelt die Figur dabei immer oben auf der aktuellen
-- Etage. Bei sehr hohen Tuermen wachsen mehrere Etagen pro Schritt, damit es
-- nie laenger als `seconds` dauert. Die Figur darf waehrenddessen NICHT im
-- Idle-Loop sein (der Aufrufer meldet sie ab und danach wieder an).
-- Gibt false zurueck, wenn die Wiedergabe unterwegs ungueltig wurde.
local function rideTower(
	player: Player, token: number, figure: Model, fighters: Folder,
	fromLevel: number, toLevel: number, seconds: number,
	selfPos: Vector3, enemyPos: Vector3
): boolean
	local distance = math.abs(toLevel - fromLevel)
	if distance == 0 then return true end

	-- Hoechstens ~20 Schritte pro Sekunde: mehr sieht niemand, und jeder
	-- Schritt baut bzw. entfernt Teile.
	local steps    = math.max(1, math.min(distance, math.floor(seconds * 20)))
	local stepTime = seconds / steps

	for step = 1, steps do
		if not stillValid(player, token, figure, fighters) then return false end

		local level = fromLevel + math.floor((toLevel - fromLevel) * step / steps + 0.5)
		MapService.setPitTowerLevel(player, level)

		local y = MapService.getPitTowerFloorY(level)
		FigurePlacement.placeLookingAt(
			figure,
			Vector3.new(selfPos.X, y, selfPos.Z),
			Vector3.new(enemyPos.X, y, enemyPos.Z)
		)
		task.wait(stepTime)
	end

	return stillValid(player, token, figure, fighters)
end

local function startPlayback(player: Player, run: Types.PitRunResult, settle: SettleFn?, beats: { { Types.FightBeat } }?)
	-- Das Hochzaehlen des Tokens steht ganz oben und vor allem, was fehlschlagen
	-- kann. Ab hier gehoert die Wiedergabe fuer diesen Spieler UNS — und nur
	-- deshalb darf die Fehlerbehandlung in play() bedenkenlos aufraeumen. Stuende
	-- der Token weiter unten und etwas darueber wuerfe, wuerde play() den Zustand
	-- einer noch laufenden aelteren Wiedergabe zerlegen, die anschliessend
	-- munter weiterliefe: Figur zurueck auf dem Plot, aber weiter Gegner in der
	-- Arena und die Tafel wieder an.
	local token = (_runToken[player] or 0) + 1
	_runToken[player] = token

	-- Ab hier ist der Client faellig fuer dieses Ergebnis. Gefeuert wird es
	-- weiter unten erst bei Ankunft am Kampf-Spot — bricht die Wiedergabe
	-- vorher ab (kein Plot, Fehler), sorgen die Abbruchstellen selbst dafuer,
	-- dass es trotzdem noch rausgeht.
	_active[player] = {
		token   = token,
		run     = run,
		settle  = settle,
		settled = nil,
		sent    = false,
		entered = 0,
		recall  = false,
		beats   = beats,
		phase   = "ToPit",
		stage   = nil,
	}

	-- Ein Kampf hat immer Vorrang vor dem automatischen Weg zum Honig-Teich:
	-- forceAcquire nimmt das Bewegungs-Schloss notfalls dem Autopilot weg.
	-- Der bemerkt das selbst (sein isCancelled prueft den Besitzer) und bricht
	-- sein Hinlaufen sauber ab, statt mit dem Kampf um die Figur zu ringen.
	ActivityLock.forceAcquire(player, LOCK_HOLDER)

	-- Einen noch laufenden Lauf komplett aufraeumen. refreshState gehoert
	-- dazu: dessen Wiedergabe hatte den Zustand der Figur unterdrueckt und
	-- kommt wegen des neuen Tokens nicht mehr dazu, ihn nachzuziehen — der
	-- alte Baerchi staende sonst mit veralteter Beschriftung auf dem Plot.
	--
	-- Das passiert bewusst VOR den Abbruchgruenden unten: auch wenn diese
	-- Wiedergabe gar nicht erst startet, muss die alte sauber beendet sein.
	restoreHome(player)
	refreshState(player)
	clearFighters(player)
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)

	-- Es gibt keine Show — Ergebnis trotzdem rausschicken UND das Schloss
	-- wieder freigeben.
	--
	-- Das Freigeben stand hier frueher nicht: forceAcquire oben nimmt das
	-- Schloss immer, die beiden Abbruchgruende unten kamen aber ohne
	-- release() zurueck. Wer also einmal ohne Plot oder ohne gerenderte Figur
	-- in einen Lauf ging, behielt "Kampf" als Schloss-Besitzer fuer den Rest
	-- der Sitzung — der Autopilot ging nie wieder essen, und seit dem
	-- ActivityLock-Schutz wuerden auch Ausruesten, Verwerten und der
	-- Figuren-Neuaufbau dauerhaft abgelehnt. Nur der Fehler-Pfad
	-- (PitArenaService.play) hat freigegeben, der stille Abbruch nicht.
	local function abortPlayback()
		-- Keine Show moeglich: der Lauf zaehlt trotzdem voll (wie vor v12),
		-- er ist ja schon entschieden.
		local active = _active[player]
		if active and active.token == token then
			active.entered = #run.stages
		end
		sendResult(player, token)
		ActivityLock.release(player, LOCK_HOLDER)
		if _active[player] and _active[player].token == token then
			_active[player] = nil
		end
	end

	local center     = MapService.getPitPosition(player)
	local plotCFrame = MapService.getPlotCFrame(player)
	local fighters   = MapService.getFighterFolder(player)
	local figure     = MapService.getBaerchiModel(player, run.baerchiUid)

	-- Fehlt irgendetwas davon (kein Plot, kein Mesh-Template, Figur nicht
	-- gerendert), gibt es einfach keine Show. Der Lauf selbst ist davon
	-- unberuehrt — er ist laengst abgerechnet.
	if not center or not plotCFrame or not fighters or not figure then
		abortPlayback()
		return
	end

	-- typeof statt nur #: kaeme ein Lauf ohne stages-Tabelle herein, waere das
	-- sonst ein Fehler mitten in der Abrechnung statt einer stillen Nicht-Show.
	if typeof(run.stages) ~= "table" or #run.stages == 0 then
		abortPlayback()
		return
	end

	-- Ruhe-Atmen abschalten, BEVOR die Heimatposition gemessen wird: die Figur
	-- schwebt sonst gerade um einen Bruchteil ihres Hubs ueber der Ruhelage,
	-- und genau dieser Versatz wanderte dann in _home.pivot — nach jedem Kampf
	-- staende sie ein Stueckchen hoeher als vorher. stopIdle setzt sie dafuer
	-- selbst auf ihre Ruhelage zurueck.
	FigureFX.stopIdle(figure)

	local homeFoot = FigurePlacement.footOf(figure)   -- Sammel-Update 1.2
	_home[player] = { model = figure, pivot = figure:GetPivot(), homeFoot = homeFoot }

	local maxHp = math.max(1, run.maxHp)

	-- v14: welche Faehigkeit gezeigt wird (SkillFX). Die volle Show laeuft
	-- beim ersten Einsatz eines Laufs, danach nur ein kurzes Echo — sonst
	-- wuerde ein Lauf mit vielen Stages Minuten dauern.
	local fxData = PlayerService.getData(player)
	local fxBaerchi = fxData and fxData.island.baerchis[run.baerchiUid]
	local fxSkillId: string? = fxBaerchi and fxBaerchi.skillId
	local fxShownFull = false

	-- v15: Ladeleiste nur, wenn die Faehigkeit ueberhaupt aufgeladen wird
	-- (Passive und Grundschlag haben charge = 0).
	local fxSkill = fxSkillId and SkillConfig.getById(fxSkillId)
	local showsCharge = fxSkill ~= nil and (fxSkill.charge or 0) > 0

	-- Die beiden Kaempfer stehen sich quer zur Bruecke gegenueber, damit man
	-- sie beim Herueberlaufen von der Seite sieht statt hintereinander.
	local side     = plotCFrame.RightVector
	local selfPos  = center - side * MapConfig.FIGHT_SPACING
	local enemyPos = center + side * MapConfig.FIGHT_SPACING

	-- Die Figur gehoert jetzt uns: MapService laesst ihren Zustand in Ruhe,
	-- bis das Attribut wieder weg ist (sonst saehe sie mitten im Kampf
	-- erschoepft aus, weil die HP serverseitig schon final sind).
	figure:SetAttribute("InArena", true)

	-- Die Figur auf den Zustand VOR dem Lauf zuruecksetzen. Die gespeicherten
	-- HP stehen zu diesem Zeitpunkt schon auf dem Endwert — ohne diese Zeile
	-- stuende der Baerchi bereits blass und mit "erschoepft" beschriftet da,
	-- bevor der erste Gegner ueberhaupt erscheint.
	MapService.setFigureState(figure, run.hpBefore, maxHp)

	task.spawn(function()
		local selfFill: Frame? = nil
		local chargeFill: Frame? = nil

		local ok, err = pcall(function()
			-- Erst hinlaufen: der Kampf soll sichtbar ERST beginnen, wenn der
			-- Baerchi an der Plattform angekommen ist, nicht durch einen
			-- Teleport. FigureWalker haelt den Fusspunkt waehrenddessen exakt
			-- auf Plot-/Bruecken-Hoehe.
			FigureWalker.walk(figure, homeFoot, selfPos, {
				speed       = arenaWalkSpeed(),
				bobPerStud  = arenaBobPerStud(),
				isCancelled = function()
					return not stillValid(player, token, figure, fighters) or recallWanted(player, token)
				end,
			})
			if not stillValid(player, token, figure, fighters) then
				sendResult(player, token)
				return
			end

			-- v12: auf dem Hinweg zurueckgeholt — noch keine Stage begonnen.
			-- Abrechnung mit 0 Stages (erstattet eine bezahlte Fortsetzung),
			-- dann von hier aus heimlaufen.
			if recallWanted(player, token) then
				sendResult(player, token)
				setPhase(player, token, "Returning", nil)
				local here = FigurePlacement.footOf(figure)
				FigureWalker.walk(figure, here, homeFoot, {
					speed       = arenaWalkSpeed(),
					bobPerStud  = arenaBobPerStud(),
					isCancelled = function() return not stillValid(player, token, figure, fighters) end,
				})
				return
			end
			setPhase(player, token, "InPit", nil)

			-- Exakte Ausrichtung zum Gegner: der Lauf endet in Laufrichtung,
			-- gekaempft wird aber gegenueber.
			FigurePlacement.placeLookingAt(figure, selfPos, enemyPos)

			-- Ab hier steht der Baerchi am Kampf-Spot und atmet dort — auch
			-- zwischen den Stages und waehrend der Nachlauf-Pause, in der er
			-- sonst reglos herumstuende. Die Ausfallschritte melden ihn dafuer
			-- selbst kurz ab und danach wieder an (FigureFX.clash).
			FigureFX.idleBob(figure, {
				height = MapConfig.IDLE_BOB_HEIGHT,
				rate   = MapConfig.IDLE_BOB_RATE,
			})

			selfFill = FightBars.attachHealthBar(figure, MapConfig.FIGHT_BAR_SELF_COLOR)
			FightBars.tweenFill(selfFill, run.hpBefore / maxHp, 0.01)
			if showsCharge then
				chargeFill = FightBars.attachChargeBar(figure)
			end

			-- (v12: das Ergebnis geht erst nach der Abrechnung am Ende raus.)

			-- Der Gegner der VORHERIGEN Stage wird erst weggeraeumt wenn der
			-- naechste erscheint. Wuerde er am Ende seiner eigenen Stage
			-- verschwinden, waere die entscheidende letzte Niederlage nie zu
			-- sehen — und in der Nachlauf-Pause staende der eigene Baerchi
			-- allein in der Arena.
			local previousEnemy: Model? = nil

			-- Zaehlt die BEREITS gewonnenen Stages fuer die Anzeigetafel.
			-- Absichtlich nicht run.stagesCleared: das ist das Endergebnis und
			-- waere waehrend der Wiedergabe die halbe Spannung vorweggenommen.
			local cleared = 0

			-- Wo der eigene Baerchi zuletzt stand — auf Bodenhoehe, solange
			-- der Turm noch nicht gewachsen ist, sonst auf der aktuellen
			-- Etage. Der Rueckweg nach der letzten Stage startet von hier,
			-- nicht von der urspruenglichen (Boden-)selfPos.
			local finalSelfPos = selfPos

			-- Aktuelle Turmhoehe (Etagen), fuer den Abstieg am Ende.
			local towerNow = 0

			-- ============================================================
			-- v12: FORTSETZUNG — DER TURM WAECHST ERST BIS ZUR STARTSTAGE
			-- ============================================================
			-- Steigt der Baerchi bei Stage 30 ein, wachsen jetzt alle 29
			-- Etagen darunter sichtbar hoch und er faehrt oben mit. Danach
			-- kaempft er auf genau der Hoehe, auf der Stage 30 bei einem Lauf
			-- von vorn stattfinden wuerde — man sieht, wie weit oben man ist.
			-- v15: gestaucht (TowerConfig.getRunFloor), bei 100 Stages hoechstens
			-- RUN_MAX_FLOORS Etagen.
			local baseLevel = TowerConfig.getRunFloor(run.towerId or "I", run.startStage or 1)
			if baseLevel > 0 and not recallWanted(player, token) then
				MapService.setPitBanner(
					player,
					stageTitle(run.towerId, run.startStage or 1),
					"⬆ …",
					MapConfig.PIT_BANNER_RUNNING
				)

				local riseSeconds = math.min(
					MapConfig.PIT_TOWER_RISE_MAX_SECONDS,
					baseLevel * MapConfig.PIT_TOWER_RISE_SECONDS_PER_LEVEL
				)

				FigureFX.stopIdle(figure)
				if not rideTower(player, token, figure, fighters, 0, baseLevel, riseSeconds, selfPos, enemyPos) then
					return
				end
				FigureFX.idleBob(figure, {
					height = MapConfig.IDLE_BOB_HEIGHT,
					rate   = MapConfig.IDLE_BOB_RATE,
				})

				towerNow     = baseLevel
				finalSelfPos = Vector3.new(selfPos.X, MapService.getPitTowerFloorY(baseLevel), selfPos.Z)
			end

			for index, stage in run.stages do
				if not stillValid(player, token, figure, fighters) then return end

				-- v12: zurueckgeholt — die vorige Stage ist fertig gespielt,
				-- weitere beginnen nicht mehr.
				if recallWanted(player, token) then break end

				local active = _active[player]
				if active and active.token == token then
					active.entered = index
				end
				setPhase(player, token, "InPit", stage.stage)

				-- Etage dieser Stage: die erste Stage kaempft noch auf der
				-- normalen Kampfflaeche (Etage 0) — sichtbar identisch mit dem
				-- Boden, den man von der Bruecke kennt. Jede weitere Stage
				-- bekommt eine neue Turmetage obendrauf (siehe MapConfig,
				-- Abschnitt "PIT-TURM").
				-- v12: absolute Etage — bei einer Fortsetzung steht der Turm
				-- schon (siehe oben), Stage 30 kaempft auf Etage 29.
				local towerLevel = TowerConfig.getRunFloor(run.towerId or "I", stage.stage)
				MapService.setPitTowerLevel(player, towerLevel)
				towerNow = towerLevel

				local floorY        = MapService.getPitTowerFloorY(towerLevel)
				local stageSelfPos  = Vector3.new(selfPos.X, floorY, selfPos.Z)
				local stageEnemyPos = Vector3.new(enemyPos.X, floorY, enemyPos.Z)
				finalSelfPos = stageSelfPos

				-- Ist der Turm inzwischen gewachsen, steht der eigene Baerchi
				-- eine Etage tiefer als er jetzt muesste — er wird VOR dem
				-- naechsten Gegner mit hochgestellt. Ruhe-Atmen dafuer kurz
				-- abmelden und an der neuen Stelle neu anmelden, sonst zoegen
				-- Idle-Loop und diese Bewegung im selben Frame an derselben
				-- Figur (dieselbe Reihenfolge wie in restoreHome).
				if towerLevel > 0 then
					FigureFX.stopIdle(figure)
					FigurePlacement.placeLookingAt(figure, stageSelfPos, stageEnemyPos)
					FigureFX.idleBob(figure, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end

				showStage(player, run.towerId, stage, cleared)

				if previousEnemy and previousEnemy.Parent then
					previousEnemy:Destroy()
				end
				previousEnemy = nil

				local enemy = BaerchiMesh.buildEnemy(stageEnemyPos, MapConfig.FIGHT_ENEMY_COLOR)
				local enemyFill: Frame? = nil

				if enemy then
					FigurePlacement.placeLookingAt(enemy, stageEnemyPos, stageSelfPos)
					enemy.Parent = fighters
					enemyFill = FightBars.attachHealthBar(enemy, MapConfig.FIGHT_BAR_ENEMY_COLOR)
					previousEnemy = enemy

					-- Auch der Gegner soll nicht wie ein Standbild dastehen,
					-- solange er noch lebt.
					FigureFX.idleBob(enemy, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end

				-- ====================================================
				-- v15: DIE STAGE ZUG UM ZUG
				-- ====================================================
				local stageBeats: { Types.FightBeat } = (beats and beats[index]) or {}
				if #stageBeats == 0 then
					-- Ohne Zuege (aelterer Aufrufer): ein einziger Stoss, der
					-- das Ergebnis zeigt — wie vor v15.
					stageBeats = { {
						actor   = if stage.won then "A" else "B",
						kind    = "hit",
						selfHp  = stage.hpAfter / maxHp,
						enemyHp = if stage.won then 0 else 0.35,
						charge  = 0,
						skillId = nil,
					} }
				end

				local plan = FightTimeline.plan(stageBeats, #run.stages, stage.won)
				local fast  = speedFactor(player)   -- Paket 4.3
				local tempo = plan.tempo / fast

				-- Kurz stehen bleiben, damit man den neuen Gegner sieht.
				task.wait(MapConfig.FIGHT_ENEMY_INTRO_SECONDS * tempo)
				if not stillValid(player, token, figure, fighters) then return end

				for _, beatIndex in plan.indices do
					local beat = stageBeats[beatIndex]
					local isSelf = beat.actor == "A"
					local attacker: Model? = if isSelf then figure else enemy
					local target:   Model? = if isSelf then enemy else figure
					local attackerHome = if isSelf then stageSelfPos else stageEnemyPos
					local targetHome   = if isSelf then stageEnemyPos else stageSelfPos
					local isSkill = FightTimeline.isSkillBeat(beat)

					-- Leisten und Treffer-Rueckmeldung genau im Aufprall.
					local function onImpact()
						local barSeconds = MapConfig.FIGHT_BEAT_SECONDS * tempo * 0.5
						FightBars.tweenFill(selfFill, beat.selfHp, barSeconds)
						FightBars.tweenFill(enemyFill, beat.enemyHp, barSeconds)
						FightBars.setCharge(chargeFill, beat.charge, barSeconds)
						if target and target.Parent ~= nil then
							FigureFX.hitFlash(target, MapConfig.FIGHT_HIT_FLASH_COLOR, MapConfig.FIGHT_HIT_FLASH_SECONDS)
						end
						local contact = (stageSelfPos + stageEnemyPos) * 0.5 + Vector3.new(0, 1.5, 0)
						FigureFX.burstAt(contact, MapConfig.FIGHT_HIT_FLASH_COLOR, fighters,
							MapConfig.FIGHT_BUMP_SPARKS * (if isSkill then 3 else 1))
						FigureFX.soundAt(contact, MapConfig.FIGHT_BUMP_SOUND,
							MapConfig.FIGHT_BUMP_VOLUME * (if isSkill then 1.6 else 1), fighters,
							0.9 + math.random() * 0.25)
					end

					if beat.kind == "stunned" then
						-- Betaeubt: kein Stoss, die Figur taumelt.
						if attacker then
							FightBars.setCharge(chargeFill, beat.charge, 0.1)
							FigureFX.stagger(attacker, MapConfig.FIGHT_BEAT_SECONDS * tempo)
						else
							task.wait(MapConfig.FIGHT_BEAT_SECONDS * tempo)
						end
					else
						-- Faehigkeit: Leiste leuchtet voll auf, die Show laeuft,
						-- dann der wuchtige Stoss.
						if isSkill and isSelf then
							FightBars.setCharge(chargeFill, 1, 0.1)
							local showId = beat.skillId or fxSkillId
							if showId then
								-- Paket 4.3: im Schnelldurchlauf nur das kurze Echo
								local full = not fxShownFull and fast <= 1
								fxShownFull = true
								Remotes.SkillFXPlay:FireAllClients({
									owner    = player.UserId,
									skillId  = showId,
									full     = full,
									attacker = figure,
									target   = enemy,
									center   = (stageSelfPos + stageEnemyPos) / 2,
								})
								task.wait(SkillFXConfig.getDuration(showId, full) * (if full then 1 else tempo))
								if not stillValid(player, token, figure, fighters) then return end
							end
						end

						local seconds = FightTimeline.beatSeconds(beat) * tempo
						if attacker then
							FigureFX.clash(attacker, target, attackerHome, targetHome, {
								seconds   = seconds,
								gap       = MapConfig.FIGHT_CONTACT_GAP,
								hop       = MapConfig.FIGHT_HOP_HEIGHT * (if isSkill then 1.6 else 1),
								knockback = if isSkill then MapConfig.FIGHT_SKILL_KNOCKBACK else MapConfig.FIGHT_KNOCKBACK,
								step      = MapConfig.FIGHT_ENEMY_STEP_SHARE,
								onImpact  = onImpact,
							})
						else
							-- Gegner-Mesh fehlt: nur Leisten und Funken.
							onImpact()
							task.wait(seconds)
						end
					end

					if not stillValid(player, token, figure, fighters) then return end
				end

				-- Leisten auf den echten Endstand der Stage (falls Zuege
				-- ausgelassen wurden, stimmt so trotzdem alles).
				FightBars.tweenFill(selfFill, stage.hpAfter / maxHp, 0.15)
				FightBars.tweenFill(enemyFill, if stage.won then 0 else stageBeats[#stageBeats].enemyHp, 0.15)

				if stage.won then
					cleared += 1

					-- Besiegter Gegner kippt um, bevor der naechste kommt.
					-- Beim letzten Gegner macht das die Nachlauf-Pause unten.
					if index < #run.stages and enemy and enemy.Parent ~= nil then
						FigureFX.defeatCollapse(enemy, MapConfig.FIGHT_KO_SECONDS * tempo)
					end
				end
			end

			-- v12: JETZT abrechnen — mit den tatsaechlich gespielten Stages —
			-- und das Ergebnis an den Client schicken.
			local active = _active[player]
			local finalRun = run
			if active and active.token == token then
				finalRun = settleActive(active, active.entered, active.recall)
			end
			sendResult(player, token)

			-- Der letzte Gegner steht waehrend der Nachlauf-Pause noch da;
			-- weggeraeumt wird er unten von clearFighters.
			showSummary(player, finalRun)

			-- Wer die LETZTE Stage verloren hat, kippt sichtbar um, statt
			-- einfach zu verschwinden bzw. unveraendert stehenzubleiben.
			--
			-- Der eigene Baerchi kippt nur, wenn er den Lauf wirklich
			-- erschoepft beendet (hpAfter <= 0). Sonst laeuft er gleich darauf
			-- selbst nach Hause — eine umgekippte Figur, die losmarschiert,
			-- waere schlechter als gar keine Animation. Zurueckgesetzt wird die
			-- Neigung ohnehin von restoreHome.
			local lastStage = finalRun.stages[#finalRun.stages]
			local loser: Model? = nil

			if lastStage and lastStage.won then
				loser = previousEnemy
			elseif finalRun.hpAfter <= 0 then
				loser = figure
			end

			-- Das Umkippen laeuft INNERHALB der Nachlauf-Pause ab, verlaengert
			-- die Wiedergabe also nicht.
			local collapseSeconds = math.min(
				MapConfig.FIGHT_COLLAPSE_SECONDS,
				MapConfig.FIGHT_LINGER_SECONDS
			)

			if loser and loser.Parent ~= nil then
				FigureFX.defeatCollapse(loser, collapseSeconds)
				task.wait(math.max(0, MapConfig.FIGHT_LINGER_SECONDS - collapseSeconds))
			else
				task.wait(MapConfig.FIGHT_LINGER_SECONDS)
			end

			if not stillValid(player, token, figure, fighters) then return end

			-- Ueberlebt (hpAfter > 0): der Baerchi laeuft selbststaendig zu
			-- seinem Platz zurueck. Erschoepft (hpAfter <= 0): er ist ausser
			-- Gefecht und steht einfach wieder normal auf dem Plot — die
			-- anschliessende restoreHome() setzt ihn dafuer direkt zurueck,
			-- ganz ohne Lauf-Animation.
			if finalRun.hpAfter > 0 then
				setPhase(player, token, "Returning", nil)

				-- Vor dem eigenen PivotTo abmelden: sonst zoegen Idle-Loop und
				-- Lauf-Animation im selben Frame an derselben Figur. Wieder
				-- angemeldet wird sie am Ende von restoreHome, auf ihrem Platz.
				FigureFX.stopIdle(figure)

				-- v12: erst mit dem Turm wieder nach unten fahren — sonst liefe
				-- er auf Turmhoehe durch die Luft nach Hause.
				if towerNow > 0 then
					clearFighters(player)
					if not rideTower(player, token, figure, fighters, towerNow, 0, MapConfig.PIT_TOWER_FALL_SECONDS, selfPos, enemyPos) then
						return
					end
					finalSelfPos = selfPos
				end

				FigureWalker.walk(figure, finalSelfPos, homeFoot, {
					speed       = arenaWalkSpeed(),
					bobPerStud  = arenaBobPerStud(),
					isCancelled = function() return not stillValid(player, token, figure, fighters) end,
				})
			end
		end)

		if not ok then
			warn("[PitArenaService] Wiedergabe fehlgeschlagen:", err)
		end

		-- Fallback: ist die Schleife oben aus irgendeinem Grund abgebrochen
		-- oder auf einen Fehler gelaufen, BEVOR der Baerchi angekommen ist,
		-- haette der Client sonst nie ein Ergebnis bekommen. sendResult ist
		-- idempotent — war es schon raus, passiert hier nichts mehr.
		sendResult(player, token)

		-- Nur aufraeumen wenn diese Wiedergabe noch die aktuelle ist —
		-- sonst wuerde man einem bereits gestarteten neuen Lauf die Figur
		-- unter den Fuessen wegziehen.
		if _runToken[player] == token then
			restoreHome(player)
			clearFighters(player)
			MapService.setPitTowerLevel(player, 0)
			MapService.clearPitBanner(player)
			refreshState(player)
			ActivityLock.release(player, LOCK_HOLDER)
			if _active[player] and _active[player].token == token then
				_active[player] = nil
			end
		end
	end)
end

-- Laeuft fuer diesen Spieler gerade eine Wiedergabe (Hinlauf, Stages,
-- Nachlauf oder Ruecklauf)? CombatService fragt das VOR einem neuen
-- RequestStartCombat ab: der Cooldown auf diesem Remote (1s,
-- NetworkConfig) ist kuerzer als eine volle Wiedergabe — ohne diese Sperre
-- koennte ein zweiter Lauf mitten in den ersten hineinstarten und ihm die
-- Figur unter den Fuessen wegziehen.
--
-- _home ist dafuer das richtige Signal: es wird exakt fuer die Dauer einer
-- Wiedergabe gesetzt (startPlayback) und von restoreHome() wieder geleert,
-- egal ob sie normal zu Ende lief oder abgebrochen wurde.
-- HBB Paket 6: alle laufenden Laeufe fuer das Live-Kampf-Board (nur lesen).
function PitArenaService.liveRuns(): { { name: string, towerId: string?, stage: number?, phase: string } }
	local list = {}
	for player, active in _active do
		table.insert(list, {
			name    = player.DisplayName,
			towerId = active.run.towerId,
			stage   = active.stage,
			phase   = active.phase,
		})
	end
	return list
end

function PitArenaService.isRunning(player: Player): boolean
	return _home[player] ~= nil
end

-- Spielt einen fertig ausgerechneten Lauf ab. Kehrt sofort zurueck — die
-- eigentliche Wiedergabe laeuft nebenher.
--
-- Wirft NIE. Der Aufrufer (CombatService) steht mitten in der Abrechnung
-- eines Laufs: ein Fehler in dieser reinen Darstellung darf ihn nicht daran
-- hindern, die Daten zu speichern und den Client zu synchronisieren. Und er
-- darf vor allem keine Figur mit gesetztem "InArena" zuruecklassen — die
-- waere fuer den Rest der Sitzung von jeder Zustands-Aktualisierung
-- ausgenommen.
-- v15: `beats` = die Zuege je Stage (Index wie run.stages). Fehlen sie, wird
-- jede Stage als ein einziger Stoss gezeigt.
function PitArenaService.play(player: Player, run: Types.PitRunResult, settle: SettleFn?, beats: { { Types.FightBeat } }?)
	local ok, err = pcall(startPlayback, player, run, settle, beats)
	if ok then return end

	warn("[PitArenaService] Wiedergabe konnte nicht starten:", err)

	-- Aufraeumen was der abgebrochene Start schon angefasst haben koennte.
	-- Das ist nur deshalb gefahrlos, weil startPlayback den Token als ALLERSTES
	-- hochzaehlt: es gibt an dieser Stelle keine fremde Wiedergabe mehr, der
	-- man etwas wegraeumen koennte.
	--
	-- sendResult zuerst: schlug startPlayback ab, noch bevor es das Ergebnis
	-- verschicken konnte, bekaeme der Client sonst nie eins. _runToken[player]
	-- ist an dieser Stelle bereits der Token DIESES Versuchs — startPlayback
	-- setzt ihn als allerersten Schritt, bevor irgendetwas werfen kann.
	sendResult(player, _runToken[player] or 0)
	restoreHome(player)
	clearFighters(player)
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)
	refreshState(player)
	ActivityLock.release(player, LOCK_HOLDER)
	_active[player] = nil
end

-- v12: Spieler holt den Baerchi zurueck (Pet-Leiste). Auf dem Hinweg kehrt
-- er sofort um; im Kampf endet der Lauf nach der laufenden Stage. Auf dem
-- Rueckweg ist nichts mehr zu tun. true = Anfrage angenommen.
function PitArenaService.requestRecall(player: Player): boolean
	local active = _active[player]
	if not active or active.phase == "Returning" then
		return false
	end
	active.recall = true
	return true
end

-- v12: Phase des laufenden Laufs fuer die Pet-Leiste: "ToPit", "InPit",
-- "Returning" oder nil (kein Lauf). Dazu die laufende Stage (nur im Kampf).
function PitArenaService.getPhase(player: Player): (string?, number?)
	local active = _active[player]
	if not active or _home[player] == nil then
		return nil, nil
	end
	return active.phase, active.stage
end

-- v12: Ist dieser Baerchi gerade in einem noch nicht abgerechneten Lauf?
-- HoneyService lehnt Fuettern dann ab — die Abrechnung setzt die HP am Ende
-- auf den Wert nach der letzten Stage und wuerde eine Heilung dazwischen
-- ueberschreiben.
function PitArenaService.isFighting(player: Player, baerchiUid: string): boolean
	local active = _active[player]
	return active ~= nil and active.settled == nil and active.run.baerchiUid == baerchiUid
end

function PitArenaService.init()
	-- Verlaesst ein Spieler den Server mitten in der Wiedergabe, macht der
	-- Token-Vergleich die laufende Schleife ungueltig. Sein Plot wird ohnehin
	-- despawnt, aufraeumen muss hier nichts mehr.
	Players.PlayerRemoving:Connect(function(player)
		_runToken[player] = nil
		_home[player]     = nil
		_active[player]   = nil
		_speed[player]    = nil
	end)

	-- Paket 4.3: Tempo-Knopf der Pet-Leiste (PetBar).
	RateLimiter.connect(Remotes.RequestPitSpeed, "RequestPitSpeed", function(player, speed: any)
		if typeof(speed) ~= "number" or VALID_SPEEDS[speed] == nil then return end
		_speed[player] = speed
	end)

	-- v12: geht der Spieler mitten im Lauf, wird VOR dem Speichern
	-- abgerechnet — so, als waere die gerade begonnene Stage zu Ende gespielt.
	PlayerService.onPlayerLeaving(function(player)
		local active = _active[player]
		if active then
			settleActive(active, active.entered, active.recall)
		end
	end)

	print("[PitArenaService] Initialisiert")
end

return PitArenaService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">PlotDisplayService</string><ProtectedString name="Source"><![CDATA[--!strict
-- PlotDisplayService.luau
-- ServerScriptService/Services/PlotDisplayService.luau
--
-- Einzige Zustaendigkeit:
--   - Entscheiden WANN die sichtbare Darstellung eines Plots nachgezogen
--     werden muss — und mit welchem der drei unterschiedlich teuren Wege.
--
-- Haengt an PlayerService.onDataChanged. Das feuert bei JEDER Aenderung, also
-- auch bei jedem einzelnen Gummy. Alles jedes Mal neu zu bauen waere
-- Verschwendung, deshalb merkt sich dieser Service drei Signaturen und
-- vergleicht sie:
--
--   STRUKTUR   (uid + Level jedes Baerchis)
--       → MapService.updateBaerchis: baut alle Mesh-Figuren neu. Teuer.
--         Noetig wenn ein Baerchi dazukommt, wegfaellt oder im Level steigt.
--
--   ZUSTAND    (uid + aktuelle HP)
--       → MapService.updateBaerchiStates: schreibt nur Beschriftung und
--         Erschoepfung an bestehende Figuren. Billig. HP aendern sich bei
--         jedem Fuettern und jedem PIT-Lauf — dafuer 25 Meshes neu zu bauen
--         waere absurd.
--
--   GEBAEUDE   (id + Level + Honig)
--       → MapService.updateBuildingSigns: schreibt die Schilder neu. Billig.
--         Honig aendert sich alle 20 Sekunden.
--
--   EIER       (uids der herumliegenden Eier)
--       → MapService.updateLaidEggs: baut die kleinen Kugeln neu. Billig —
--         es sind hoechstens zwoelf, und sie sind keine Meshes.
--         Aendert sich, wenn der Baerchi eines legt oder der Spieler eines
--         aufsammelt.
--
--   RECYCLER   (Level + Warteschlange des Waben-Recyclers)
--       → MapService.updateRecycler: schreibt Schild und Lampe. Billig.
--         Aendert sich jede Sekunde, solange der Recycler arbeitet.
--
--   LOOKS      (v15: Look-Stufe jedes Gebaeudes und des Recyclers)
--       → MapService.updateBuildingLooks: baut genau das Gebaeude neu, dessen
--         Look sich geaendert hat, mit kurzer Aufwertungs-Show. Haengt am
--         LOOK, nicht am Level — ein Ausbau innerhalb eines Looks schreibt nur
--         das Schild (GEBAEUDE oben).
--
--   TOWER      (v15: Look + Etagen + Schildtext des Tower-Turms)
--       → MapService.updateTowerShowcase (Neuaufbau des Turms, Show nur beim
--         Look-Wechsel) und MapService.setOwnerBadge (Symbol am Plot-Schild).
--         Aendert sich nur bei einem neuen Rekord oder Tower.
--
-- Die Figuren und Schilder selbst baut MapService — dieser Service entscheidet
-- nur WANN und WELCHE Tiefe.
--
-- EINE SACHE ENTSCHEIDET DIESER SERVICE BEWUSST NICHT: ob die Figur gerade
-- mitten in einer Bewegung steckt. Diese Sperre sitzt in
-- MapService.updateBaerchis selbst, damit sie fuer JEDEN Aufrufer gilt und
-- nicht an jeder Aufrufstelle wiederholt werden muss. Hier unten wird nur die
-- Quelle fuer frische Daten eingehaengt, mit der MapService den verschobenen
-- Neuaufbau spaeter nachholt (siehe init).
--
-- Wichtig fuer das Verstaendnis des Signatur-Vergleichs: eine verschobene
-- Darstellung gilt hier trotzdem sofort als "dargestellt". Das ist richtig, so
-- lange MapService das Nachholen uebernimmt — waere es andersherum, muesste
-- dieser Service den Zustand einer fremden Warteschlange mitverfolgen.
--
-- Ersetzt den frueheren BaerchiDisplayService, der nur die Figuren kannte und
-- inzwischen aus dem Projekt entfernt ist.

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local IncubatorRules = require(ReplicatedStorage.Modules.IncubatorRules)   -- Paket 8
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local Loc       = require(ReplicatedStorage.Localization.Loc)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)

local PlotDisplayService = {}

type Signatures = {
	incubator : string,   -- Sammel-Update Paket 8
	structure : string,
	state     : string,
	buildings : string,
	eggs      : string,
	recycler  : string,
	looks     : string,
	tower     : string,
}

local _signatures: { [Player]: Signatures } = {}

--------------------------------------------------------------------------------
-- Signaturen
--------------------------------------------------------------------------------

-- Was sich aendern muss, damit die Figur neu gebaut wird: welche Baerchis es
-- gibt, auf welchem Level sie stehen (das Level aendert die Groesse der
-- Beschriftung und kann spaeter das Modell aendern) — UND wer gerade
-- ausgeruestet ist, seit nur noch dieser eine sichtbar gebaut wird. Ohne
-- equippedUid hier wuerde ein Equip-Wechsel auf einen gleich hochstufigen
-- Baerchi denselben String ergeben und die Signatur haelt die Aenderung
-- faelschlich fuer bereits dargestellt.
--
-- Die MUTATION gehoert aus demselben Grund dazu: sie bestimmt Fellfarbe, Aura
-- und das Kuerzel auf dem Namensschild (siehe MapService.buildBaerchiFigure).
-- Normalerweise aendert sie sich nie nach dem Schluepfen — der Mutations-Sturm
-- (EventParticipationService) kann sie aber mitten im Spiel anheben, und ohne
-- diesen Eintrag liefe die Figur bis zum naechsten Insel-Neuaufbau in der
-- alten Farbe weiter.
local function structureSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, string.format("%s:%d:%s:%s", uid, baerchi.level, baerchi.mutation or "-", baerchi.rarity))
	end
	table.sort(parts)
	table.insert(parts, "equipped:" .. (data.island.equippedUid or ""))
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Beschriftung neu geschrieben wird.
local function stateSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, uid .. ":" .. baerchi.currentHp)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Gebaeude-Schilder neu geschrieben werden.
local function buildingSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d:%d", id, building.level, building.honey or 0))
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Eier neu gebaut werden: WELCHE Eier
-- herumliegen. Die Position gehoert bewusst nicht dazu — ein gelegtes Ei
-- bewegt sich nie, es kommt nur dazu oder verschwindet.
local function eggSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for _, egg in data.island.laidEggs or {} do
		table.insert(parts, egg.uid)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit Schild und Lampe des Waben-Recyclers neu
-- geschrieben werden: Level und Warteschlange.
local function recyclerSignature(data: Types.PlayerData): string
	local recycler = data.island.recycler
	return string.format("%d:%d", recycler.level, recycler.queued)
end

-- v15: Look-Stufen. Bewusst NICHT das Level: ein Gebaeude wird nur neu
-- gebaut, wenn es einen neuen Look bekommt (README 4.2).
local function lookSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d", id, BuildingBehavior.getLook(building.level)))
	end
	table.sort(parts)
	table.insert(parts, "Recycler:" .. BuildingBehavior.getLook(data.island.recycler.level))
	return table.concat(parts, "|")
end

-- v15: Tower-Turm: hoechster Tower (Look) und Rekord darin (Etagen + Schild).
local function towerSignature(data: Types.PlayerData): string
	local towerId, record = TowerConfig.bestRecord(data.towers)
	local highest = data.towers.highestTower
	if TowerConfig.getIndex(highest) > TowerConfig.getIndex(towerId) then
		towerId, record = highest, data.towers.records[highest] or 0
	end
	return string.format("%s:%d", towerId, record)
end

-- Sammel-Update Paket 8: Inkubator — belegte Plaetze (Ei + Zeitmarken),
-- Level und Platz-Zahl. Fortschritt rechnet der Client selbst.
local function incubatorSignature(data: Types.PlayerData): string
	local incubator = data.island.incubator
	if not incubator then return "" end
	local parts: { string } = { tostring(incubator.level), tostring(IncubatorRules.slotCountFor(data)) }
	for _, entry in incubator.slots do
		table.insert(parts, string.format("%d=%s@%d", entry.slot, entry.eggType, entry.finishAt))
	end
	-- INCUBATOR_BREED: Baerchis in den Plaetzen (Figur, Takt, letzte Brut)
	for _, entry in incubator.breeders or {} do
		local baerchi = data.island.baerchis[entry.uid]
		table.insert(parts, string.format("b%d=%s:%s:%s@%d", entry.slot, entry.uid,
			if baerchi then baerchi.rarity else "?", if baerchi then tostring(baerchi.mutation) else "",
			entry.lastEggAt))
	end
	return table.concat(parts, "|")
end

local function allSignatures(data: Types.PlayerData): Signatures
	return {
		incubator = incubatorSignature(data),
		structure = structureSignature(data),
		state     = stateSignature(data),
		buildings = buildingSignature(data),
		eggs      = eggSignature(data),
		recycler  = recyclerSignature(data),
		looks     = lookSignature(data),
		tower     = towerSignature(data),
	}
end

-- Turm und Plot-Symbol aus dem Tower-Stand (Signatur "Tower:Rekord").
local function applyTower(player: Player, signature: string, show: boolean)
	local towerId, recordText = string.match(signature, "^([^:]+):(%d+)$")
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	local record = tonumber(recordText) or 0

	MapService.updateTowerShowcase(player, {
		look   = def.look,
		floors = TowerConfig.getShowcaseFloors(def.id, record),
		title  = Loc.msg("ui.world.showcase_title", {
			name = player.DisplayName, tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record,
		}),
		color  = def.color,
	}, show)
	MapService.setOwnerBadge(player, Loc.msg("ui.world.owner_badge", {
		tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record,
	}), def.color)
end

--------------------------------------------------------------------------------
-- Abgleich
--------------------------------------------------------------------------------

local function refresh(player: Player, data: Types.PlayerData)
	local current  = allSignatures(data)
	local previous = _signatures[player]

	if not previous then
		-- Noch keine Signatur (sollte nach onDataLoaded nicht vorkommen):
		-- einmal komplett nachziehen und merken.
		_signatures[player] = current
		MapService.updateBaerchis(player, data.island)
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		return
	end

	if previous.structure ~= current.structure then
		-- Neuaufbau schreibt die Zustaende gleich mit — ein zusaetzliches
		-- updateBaerchiStates waere doppelte Arbeit.
		MapService.updateBaerchis(player, data.island)

	elseif previous.state ~= current.state then
		MapService.updateBaerchiStates(player, data.island)
	end

	if previous.buildings ~= current.buildings then
		MapService.updateBuildingSigns(player, data.island)
	end

	-- Bewusst UNABHAENGIG vom Struktur-Zweig oben: updateBaerchis baut die Eier
	-- zwar mit, kann aber wegen einer laufenden Bewegung verschoben worden sein
	-- (ActivityLock). Genau dann legt der Baerchi aber weiter — und ein frisch
	-- gelegtes Ei soll nicht darauf warten, dass er ankommt.
	if previous.eggs ~= current.eggs then
		MapService.updateLaidEggs(player, data.island)
	end

	if previous.recycler ~= current.recycler then
		MapService.updateRecycler(player, data.island)
	end

	if previous.incubator ~= current.incubator then
		MapService.updateIncubator(player, data.island, IncubatorRules.slotCountFor(data))
	end

	-- v15: neuer Look -> genau dieses Gebaeude neu bauen (mit Show). Nach einem
	-- Rebirth faellt der Look zurueck; rebuildIsland hat die Insel dann schon
	-- komplett neu gebaut, updateBuildingLooks findet nichts mehr zu tun.
	if previous.looks ~= current.looks then
		MapService.updateBuildingLooks(player, data.island, true)
	end

	if previous.tower ~= current.tower then
		local oldTower = string.match(previous.tower, "^([^:]+):")
		local newTower = string.match(current.tower, "^([^:]+):")
		applyTower(player, current.tower, oldTower ~= newTower)
	end

	_signatures[player] = current
end

function PlotDisplayService.init()
	-- MapService darf PlayerService nicht requiren (PlayerService requiret
	-- bereits MapService — das waere ein Ringschluss). Deshalb bekommt es die
	-- Lesefunktion von hier: dieser Service kennt beide ohnehin schon.
	MapService.setIslandDataProvider(function(player: Player): Types.IslandData?
		local data = PlayerService.getData(player)
		return if data then data.island else nil
	end)
	-- Sammel-Update Paket 8: Platz-Zahl des Inkubators (Level, Rebirths, Index).
	MapService.setIncubatorSlotProvider(function(player: Player): number
		local data = PlayerService.getData(player)
		return if data then IncubatorRules.slotCountFor(data) else 1
	end)

	PlayerService.onPlayerReady(function(player, data)
		-- Die Figuren und Schilder stehen zu diesem Zeitpunkt schon
		-- (MapService.spawnIsland laeuft beim Join davor), aber die Daten
		-- haben sich seitdem noch geaendert: die onDataLoaded-Callbacks haben
		-- Offline-Honig gutgeschrieben und offline gelegte Eier eingetragen.
		-- Die Schilder zeigten sonst bis zum naechsten Honig-Tick den Stand von
		-- vor der Gutschrift, und die Eier laegen nur in den Daten.
		--
		-- Deshalb einmal aktiv nachziehen — und ERST DANN die Signatur
		-- merken, sonst haelt der Vergleich unten den Unterschied faelschlich
		-- fuer bereits dargestellt.
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateBaerchiStates(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		MapService.updateIncubator(player, data.island, IncubatorRules.slotCountFor(data))

		local signatures = allSignatures(data)
		applyTower(player, signatures.tower, false)

		_signatures[player] = signatures
	end)

	PlayerService.onDataChanged(refresh)

	Players.PlayerRemoving:Connect(function(player)
		_signatures[player] = nil
	end)

	print("[PlotDisplayService] Initialisiert")
end

return PlotDisplayService
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX28"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">EventKit</string><ProtectedString name="Source"><![CDATA[--!strict
-- EventKit.luau
-- ServerScriptService/Util/EventKit.luau
--
-- Einzige Zustaendigkeit:
--   - Gemeinsame Typen und kleine Werkzeuge der Event-Handler (Teilnehmer,
--     Api, Belohnung, Effekt-Teile, Textmarke ueber der Figur).
--
-- Aus EventHandlers herausgezogen, als das sechste Event (Wespenkoenigin,
-- Util/WaspQueenEvent) dazukam: beide brauchen dieselben Typen und Werkzeuge,
-- und ein gegenseitiges require waere ein Ringschluss. Der Code ist
-- unveraendert aus EventHandlers uebernommen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local Types            = require(ReplicatedStorage.Network.Types)
local WorldText        = require(ReplicatedStorage.Localization.WorldText)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local EventKit = {}

--------------------------------------------------------------------------------
-- Typen
--------------------------------------------------------------------------------

-- Ein Teilnehmer, wie EventParticipationService ihn liefert (dort: Presence).
-- Die Handler lesen ihn und setzen nur die drei Steuerfelder unten.
export type Part = {
	player     : Player,
	figure     : Model,
	baerchiUid : string,
	homeFoot   : Vector3,
	standFoot  : Vector3,
	busy       : boolean?,   -- Figur laeuft gerade (walkTo)
	cancelWalk : boolean?,   -- laufende Bewegung abbrechen
	abducting  : boolean?,   -- UFO hat die Figur gerade
	abductedAt : number?,    -- Sammel-Update 1.1: os.clock() beim Start der Entfuehrung (Waechter)
}

-- Was EventParticipationService den Handlern bereitstellt (buildApi).
export type Api = {
	center       : Vector3,
	radius       : number,
	running      : () -> boolean,
	footOf       : (Model) -> Vector3,
	participants : () -> { Part },
	stillHere    : (Part) -> boolean,
	plotPosition : (Player) -> Vector3?,
	level        : (Part) -> number,
	power        : (Part) -> number,
	-- Sammel-Update 2.4: Text als LocMsg (der Client uebersetzt). Ein
	-- einfacher string bleibt fuer Altstellen erlaubt.
	toast        : (Player, string | Types.LocMsg) -> (),
	recall       : (Player) -> (),
	finishHome   : (Part) -> (),
	ufoReward    : (Part) -> (),
	-- UFO_REJOIN: befristet geschwaecht (Level halbiert) nach dem Absetzen
	weaken       : (Part, number) -> (),
	isWeakened   : (Part) -> boolean,
	walkTo       : (Part, Vector3) -> boolean,

	-- v17 (lebendige Events)
	grantEgg     : (Player, Types.EggType, number) -> boolean,
	notify       : (Player, Types.LocMsg, string?) -> (),
	announce     : (Types.LocMsg, string?) -> (),
	fightStats   : (Part) -> CombatCalculator.FighterStats?,
	finishEarly  : () -> (),
}

-- Belohnung eines Spielers am Event-Ende.
export type Reward = {
	egg          : EventConfig.EventBonus?,
	mutationRoll : boolean?,

	-- v17 (Boss): Zusatz-Belohnungen, ausgezahlt von EventParticipationService
	-- ueber EconomyService / CombRecyclerService.
	gummies        : number?,                   -- Basisbetrag (mit Rebirth-Multiplikator)
	combUnits      : number?,                   -- Wabeneinheiten in den Recycler
	extraEgg       : EventConfig.EventBonus?,   -- zweites Ei (Top-Rang: Sprung-Ei)
	rarityUpFactor : number?,                   -- Rarity-Up-Wurf: Faktor auf EventConfig.RARITY_UP_CHANCE
	notice         : Types.LocMsg?,             -- Zusammenfassung fuer den Spieler
	-- HBB Paket 7: Boss-Stufe (0-4) und ihr Zusatz-Wurf (Mutation)
	bossTier       : number?,
	tierBonus      : EventConfig.EventBonus?,
	tierEggs       : number?,                   -- Basis-Eier der Stufe
	-- Sammel-Update 05.10. (Paket 6.2): Boss besiegt und dieser Spieler hat
	-- Schaden gemacht (besonderer Meilenstein "erster Boss-Sieg").
	bossVictory    : boolean?,
}

export type Session = {
	stop : () -> { [Player]: Reward },
}

export type Handler = (Api, EventConfig.EventDef) -> Session

--------------------------------------------------------------------------------
-- Optik der Textmarke (keine Balance)
--------------------------------------------------------------------------------

-- Textmarke ueber der Figur
local LABEL_SIZE              = UDim2.fromOffset(120, 26)
local LABEL_OFFSET            = Vector3.new(0, 6, 0)
local LABEL_MAX_DISTANCE      = 220
local LABEL_BACK_TRANSPARENCY = 0.35
local LABEL_BACK_COLOR        = Color3.fromRGB(20, 20, 30)
local LABEL_TEXT_COLOR        = Color3.new(1, 1, 1)

--------------------------------------------------------------------------------
-- Werkzeuge
--------------------------------------------------------------------------------

function EventKit.flatDist(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Eigenschaften per Tabelle setzen. Ueber `any`, weil der Klassenname erst
-- zur Laufzeit feststeht und --!strict die Felder sonst nicht kennt.
function EventKit.make(className: string, props: { [string]: any }, parent: Instance): Instance
	local inst: any = Instance.new(className)
	for key, value in props do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

function EventKit.fxPart(props: { [string]: any }, parent: Instance): BasePart
	props.Anchored   = true
	props.CanCollide = false
	props.CanQuery   = false
	props.CanTouch   = false
	props.CastShadow = false
	return EventKit.make("Part", props, parent) :: BasePart
end

function EventKit.rootOf(figure: Model): BasePart?
	return figure.PrimaryPart or figure:FindFirstChildWhichIsA("BasePart", true)
end

-- Kleine Textmarke ueber der Figur (Fortschritt, "Ei!", ...). nil entfernt sie.
-- Woerter kommen als Nachricht (Loc.msg): alle Spieler sehen die Marke, jeder
-- liest sie in seiner Sprache (siehe WorldText). Reine Zahlen gehen als String.
function EventKit.setLabel(part: Part, text: (string | Types.LocMsg)?)
	local figure = part.figure
	if not figure or not figure.Parent then
		return
	end

	local gui = figure:FindFirstChild("EventLabel")
	if not text then
		if gui then
			gui:Destroy()
		end
		return
	end

	if not gui then
		local root = EventKit.rootOf(figure)
		if not root then
			return
		end
		local created = EventKit.make("BillboardGui", {
			Name         = "EventLabel",
			Size         = LABEL_SIZE,
			StudsOffset  = LABEL_OFFSET,
			AlwaysOnTop  = true,
			Adornee      = root,
			MaxDistance  = LABEL_MAX_DISTANCE,
		}, figure)
		EventKit.make("TextLabel", {
			Name                   = "Text",
			Size                   = UDim2.fromScale(1, 1),
			BackgroundTransparency = LABEL_BACK_TRANSPARENCY,
			BackgroundColor3       = LABEL_BACK_COLOR,
			TextColor3             = LABEL_TEXT_COLOR,
			TextScaled             = true,
			Font                   = Enum.Font.GothamBold,
		}, created)
		gui = created
	end

	local label = (gui :: Instance):FindFirstChild("Text")
	if label and label:IsA("TextLabel") then
		WorldText.set(label, text :: string | Types.LocMsg)
	end
end

function EventKit.newFolder(name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name   = name
	folder.Parent = workspace
	return folder
end

return EventKit
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX27"><Properties><string name="Name">MapBuild</string></Properties><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">ArenaBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- ArenaBuilder.luau
-- ServerScriptService/Util/MapBuild/ArenaBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Den Steg zur Arena-Insel, die PIT-Arena, die Ringe des Lauf-Turms und
--     (v15) den staendigen Tower-Turm (Angeberflaeche) bauen
--
-- Die Arena ist eine flache Kampfflaeche. Seit v15 gibt es kein PIT-Level und
-- damit keine Saeulen mehr; den Fortschritt zeigt der Tower-Turm am aeusseren
-- Rand der Insel (Look = hoechster Tower, Hoehe = Rekord, MapConfig.TOWER_LOOKS).
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local Types     = require(ReplicatedStorage.Network.Types)
local WorldText = require(ReplicatedStorage.Localization.WorldText)

local ArenaBuilder = {}

-- Der aeussere Steg: von der Plot-Insel des Spielers auf seine Arena-Insel.
-- Er gehoert zum Spieler und wird deshalb mit dessen Plot-Model gebaut — die
-- INNEREN Stege (Hauptinsel → Plot-Insel) stehen dagegen immer, siehe
-- buildPlatform.
function ArenaBuilder.buildBridge(plotModel: Model, slot: number)
	local islandEdge = MapConfig.PLOT_RING_RADIUS + MapConfig.PLOT_ISLAND_RADIUS

	MapParts.buildSpan(
		plotModel,
		"Bridge",
		MapParts.outwardDirection(slot),
		islandEdge,
		islandEdge + MapConfig.ISLAND_GAP
	)
end

-- Die PIT-Arena am Ende der Bruecke. Flache runde Kampfflaeche.
--
-- Die Kampfflaeche heisst bewusst weiterhin "FightFloor": WorldController
-- haengt genau an diesem Namen seinen Kampf-Prompt auf.
function ArenaBuilder.buildPit(plotModel: Model, slot: number)
	local old = plotModel:FindFirstChild("PitPlatform")
	if old then old:Destroy() end

	local container = Instance.new("Model")
	container.Name   = "PitPlatform"
	container.Parent = plotModel

	local center = MapParts.pitCenter(slot)

	-- Die Arena-Insel: derselbe Aufbau wie jede andere Insel (Sandkante plus
	-- Scheibe), damit sie nicht wie ein Fremdkoerper im Wasser steht. Ihre
	-- Oberflaeche ist der Sockel, auf dem der Steg landet.
	-- Der Sockel liegt PIT_RIM_DROP tiefer als die Kampfflaeche, sonst waeren
	-- die beiden Oberseiten deckungsgleich und wuerden flimmern.
	local rimY = MapConfig.PLATFORM_TOP_Y - MapConfig.PIT_RIM_DROP

	MapParts.buildIsland(
		container,
		"PitBase",
		center,
		MapConfig.PIT_BASE_RADIUS,
		MapConfig.PIT_BASE_COLOR,
		Enum.Material.Slate,
		MapConfig.PIT_RIM_DROP
	)

	-- Leuchtender Ring am Sockelrand: eine etwas breitere Scheibe, die flach
	-- darunter liegt. Sichtbar bleibt nur ihr ueberstehender Rand — derselbe
	-- Trick wie bei der Sandkante, und ein Teil statt eines Dutzends Segmente.
	-- Sie sitzt eine halbe Ringhoehe unter dem Sockel: damit liegt sie
	-- zwischen Sockel und Sandkante, ohne mit einer von beiden auf gleicher
	-- Hoehe zu liegen.
	local ringRadius = MapConfig.PIT_BASE_RADIUS + MapConfig.PIT_RING_OVERHANG
	local ring = MapParts.newPart(
		"PitRing",
		Vector3.new(MapConfig.PIT_RING_HEIGHT, ringRadius * 2, ringRadius * 2),
		CFrame.new(center.X, rimY - MapConfig.PIT_RING_HEIGHT, center.Z)
			* CFrame.Angles(0, 0, math.rad(90)),
		MapConfig.PIT_RING_COLOR,
		Enum.Material.Neon
	)
	ring.Shape      = Enum.PartType.Cylinder
	ring.CanCollide = false
	ring.CanQuery   = false
	ring.Parent     = container

	-- Kampfflaeche: Oberkante auf PLATFORM_TOP_Y, also ein kleiner Absatz ueber
	-- dem Sockelring ringsum.
	local floorY = MapConfig.PLATFORM_TOP_Y - MapConfig.PIT_FLOOR_HEIGHT * 0.5
	local floor = MapParts.newPart(
		"FightFloor",
		Vector3.new(MapConfig.PIT_FLOOR_HEIGHT, MapConfig.PIT_RADIUS * 2, MapConfig.PIT_RADIUS * 2),
		CFrame.new(center.X, floorY, center.Z) * CFrame.Angles(0, 0, math.rad(90)),
		MapConfig.PIT_FLOOR_COLOR,
		Enum.Material.SmoothPlastic
	)
	floor.Shape  = Enum.PartType.Cylinder
	floor.Parent = container

	-- Leuchtender Zaun auf dem Sockelrand.
	--
	-- Zur Steg-Seite bleibt eine Luecke frei, sonst muesste man beim Betreten
	-- der Arena ueber den Zaun springen. Die Steg-Seite ist die Richtung ZUR
	-- Weltmitte, also das Gegenteil der Aussenrichtung des Plots.
	local outward    = MapParts.outwardDirection(slot)
	local inwardAngle = math.atan2(-outward.Z, -outward.X)
	local gap        = math.rad(MapConfig.PIT_FENCE_GAP_DEGREES)
	local postRadius = MapConfig.PIT_BASE_RADIUS - MapConfig.PIT_FENCE_INSET
	local postY      = rimY + MapConfig.PIT_FENCE_SIZE.Y * 0.5

	for i = 1, MapConfig.PIT_FENCE_COUNT do
		local angle = (i - 1) * (2 * math.pi / MapConfig.PIT_FENCE_COUNT)

		-- Winkelabstand zur Steg-Richtung, immer als kuerzester Weg gemessen —
		-- sonst faellt die Luecke bei manchen Plots auseinander.
		local delta = math.abs(((angle - inwardAngle + math.pi) % (2 * math.pi)) - math.pi)

		if delta > gap then
			local post = MapParts.newPart(
				"PitFence_" .. i,
				MapConfig.PIT_FENCE_SIZE,
				CFrame.new(
					center.X + postRadius * math.cos(angle),
					postY,
					center.Z + postRadius * math.sin(angle)
				),
				MapConfig.PIT_FENCE_COLOR,
				Enum.Material.Neon
			)
			post.CanCollide = false
			post.CanQuery   = false
			post.Parent     = container
		end
	end

	-- Ordner fuer die Kampf-Figuren waehrend eines Laufs. Liegt hier, damit
	-- PitArenaService nichts selbst anlegen muss und ein Neuaufbau des PIT
	-- die Figuren automatisch mitnimmt.
	local fighters = Instance.new("Folder")
	fighters.Name   = "Fighters"
	fighters.Parent = container

	-- Ordner fuer die Turm-Etagen, die waehrend eines Laufs Stage fuer Stage
	-- dazukommen (siehe MapService.setPitTowerLevel). Aus demselben Grund wie
	-- Fighters: PitArenaService legt hier nichts selbst an, und ein Neuaufbau
	-- des PIT (z. B. beim Ausbauen) raeumt einen laufenden Turm automatisch mit
	-- weg statt ihn verwaist stehen zu lassen.
	local tower = Instance.new("Folder")
	tower.Name   = "Tower"
	tower.Parent = container

	-- Anzeigetafel ueber der Arena. Sie haengt an einer eigenen unsichtbaren
	-- Part und nicht am Boden: der Boden ist ein um 90 Grad gekippter Zylinder,
	-- an dem "oben" nicht nach oben zeigt. Standardmaessig ausgeschaltet —
	-- eingeblendet wird sie nur waehrend einer Wiedergabe.
	local anchor = MapParts.newPart(
		"PitBannerAnchor",
		Vector3.new(1, 1, 1),
		CFrame.new(center.X, MapConfig.PLATFORM_TOP_Y + MapConfig.PIT_BANNER_HEIGHT, center.Z),
		MapConfig.PIT_FLOOR_COLOR,
		Enum.Material.SmoothPlastic
	)
	anchor.Transparency = 1
	anchor.CanCollide   = false
	anchor.CanQuery     = false
	anchor.CanTouch     = false
	anchor.Parent       = container

	local banner = Instance.new("BillboardGui")
	banner.Name        = "Banner"
	banner.Size        = UDim2.fromScale(MapConfig.PIT_BANNER_SIZE.X, MapConfig.PIT_BANNER_SIZE.Y)
	banner.AlwaysOnTop = false
	banner.MaxDistance = MapConfig.PIT_BANNER_DISTANCE
	banner.Adornee     = anchor
	banner.Enabled     = false
	banner.Parent      = anchor

	local bannerTitle = MapParts.newTextLabel("Title", banner, UDim2.fromScale(1, 0.6), UDim2.fromScale(0, 0))
	bannerTitle.Text  = ""
	MapParts.newTextLabel("Sub", banner, UDim2.fromScale(1, 0.4), UDim2.fromScale(0, 0.6))
end

-- Eine einzelne Turm-Etage: eine Scheibe im selben Radius wie die
-- Kampfflaeche, die direkt auf der vorherigen aufsetzt. `level` ist 1-basiert
-- — Etage 1 ist die erste Scheibe UEBER der normalen Kampfflaeche.
function ArenaBuilder.buildTowerRing(tower: Folder, center: Vector3, level: number)
	local color = MapConfig.PIT_TOWER_COLORS[((level - 1) % #MapConfig.PIT_TOWER_COLORS) + 1]
	local topY  = MapConfig.PLATFORM_TOP_Y + level * MapConfig.PIT_TOWER_STEP_HEIGHT

	local ring = MapParts.newPart(
		"Ring_" .. level,
		Vector3.new(MapConfig.PIT_TOWER_STEP_HEIGHT, MapConfig.PIT_TOWER_RADIUS * 2, MapConfig.PIT_TOWER_RADIUS * 2),
		CFrame.new(center.X, topY - MapConfig.PIT_TOWER_STEP_HEIGHT * 0.5, center.Z)
			* CFrame.Angles(0, 0, math.rad(90)),
		color,
		Enum.Material.SmoothPlastic
	)
	ring.Shape  = Enum.PartType.Cylinder
	ring.Parent = tower
end

--------------------------------------------------------------------------------
-- v15: der Tower-Turm (Angeberflaeche)
--------------------------------------------------------------------------------

export type ShowcaseView = {
	look   : string,   -- Schluessel in MapConfig.TOWER_LOOKS
	floors : number,   -- 1 .. TowerConfig.SHOWCASE_MAX_FLOORS
	title  : string | Types.LocMsg,   -- Schild: "Name · Tower III · 42" (Nachricht, siehe WorldText)
	color  : Color3,
}

-- Mitte des Turm-Fusses (Inselhoehe). HBB Paket 5: am Brueckenkopf auf der
-- Hauptinsel (MAP_V2_SHOWCASE), sonst aussen an der Arena-Insel. Die Formel
-- steht in MapLayout, damit Test und Deko-Freiraum dieselbe benutzen.
function ArenaBuilder.showcaseFoot(slot: number): Vector3
	return MapLayout.showcaseFoot(slot)
end

-- Baut den Turm neu (der alte wird ersetzt). Teile: Sockel (bis ins Wasser),
-- `floors` Etagen aus dem Look, Spitze, Schild. Rein deklarativ aus
-- MapConfig.TOWER_LOOKS — Formaenderungen nur dort.
function ArenaBuilder.buildShowcase(plotModel: Model, slot: number, view: ShowcaseView): Model
	local old = plotModel:FindFirstChild("TowerShowcase")
	if old then old:Destroy() end

	local cfg  = MapConfig.TOWER_SHOWCASE
	local look = MapConfig.TOWER_LOOKS[view.look] or MapConfig.TOWER_LOOKS.Wood
	local foot = ArenaBuilder.showcaseFoot(slot)

	local container = Instance.new("Model")
	container.Name = "TowerShowcase"
	container:SetAttribute("Look", view.look)
	container:SetAttribute("Floors", view.floors)

	-- Sockel: vom Grund der Insel bis knapp ueber die Arena, damit der Turm
	-- nicht auf dem Wasser schwebt.
	local plinthHeight = MapConfig.ISLAND_HEIGHT + cfg.plinthHeight
	local plinth = MapParts.newPart(
		"Sockel",
		Vector3.new(plinthHeight, (cfg.radius + 1.2) * 2, (cfg.radius + 1.2) * 2),
		CFrame.new(foot.X, foot.Y + cfg.plinthHeight - plinthHeight * 0.5, foot.Z) * CFrame.Angles(0, 0, math.rad(90)),
		look.plinth,
		Enum.Material.Slate
	)
	plinth.Shape    = Enum.PartType.Cylinder
	plinth.CanQuery = false
	plinth.Parent   = container

	local floors = math.clamp(math.floor(view.floors), 1, TowerConfig.SHOWCASE_MAX_FLOORS)
	local baseY  = cfg.plinthHeight
	for i = 1, floors do
		local origin = CFrame.new(foot.X, foot.Y + baseY + (i - 1) * cfg.floorHeight, foot.Z)
		MapParts.buildDecor(container, origin, look.floor)
	end

	local topY = baseY + floors * cfg.floorHeight
	MapParts.buildDecor(container, CFrame.new(foot.X, foot.Y + topY, foot.Z), look.top)

	-- Schild ueber der Spitze (Name · Tower · Rekord).
	local anchor = MapParts.newPart(
		"SignAnchor",
		Vector3.new(1, 1, 1),
		CFrame.new(foot.X, foot.Y + topY + MapParts.decorHeight(look.top) + cfg.signGap, foot.Z),
		look.accent,
		Enum.Material.SmoothPlastic
	)
	anchor.Transparency = 1
	anchor.CanCollide   = false
	anchor.CanQuery     = false
	anchor.CanTouch     = false
	anchor.Parent       = container

	local sign = Instance.new("BillboardGui")
	sign.Name        = "Sign"
	sign.Size        = UDim2.fromScale(16, 2.4)
	sign.AlwaysOnTop = false
	sign.MaxDistance = cfg.signDistance
	sign.Adornee     = anchor
	sign.Parent      = anchor

	local title = MapParts.newTextLabel("Title", sign, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	WorldText.set(title, view.title)
	title.TextColor3 = view.color

	container.Parent = plotModel
	return container
end

return ArenaBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">FigureBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- FigureBuilder.luau
-- ServerScriptService/Util/MapBuild/FigureBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Die sichtbare Figur des ausgeruesteten Baerchis bauen und ihren Zustand
--     (Namensschild, HP, erschoepft) anzeigen
--
-- Es gibt pro Plot nur EINE Figur: die des ausgeruesteten Baerchis. Alle
-- anderen Baerchis sind reine Inventar-Daten.
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local BaerchiMesh      = require(ReplicatedStorage.Modules.BaerchiMesh)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local Types            = require(ReplicatedStorage.Network.Types)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local Names     = require(ReplicatedStorage.Localization.Names)
local WorldText = require(ReplicatedStorage.Localization.WorldText)

local FigureFX         = require(ServerScriptService.Util.FigureFX)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local FigureBuilder = {}

-- Beschriftung und Erschoepfungs-Zustand einer bereits stehenden Figur.
-- Getrennt vom Aufbau, weil sich HP staendig aendern und ein kompletter
-- Neuaufbau der Mesh-Figuren dafuer viel zu teuer waere.
function FigureBuilder.writeFigureState(model: Model, rawHp: number, maxHp: number)
	local hp        = math.clamp(rawHp, 0, maxHp)
	local exhausted = hp <= 0

	local label = model:FindFirstChild("Health", true)
	if label and label:IsA("TextLabel") then
		WorldText.set(label, if exhausted
			then Loc.msg("ui.world.exhausted")
			else string.format("%d / %d HP", hp, maxHp))

		label.TextColor3 = if exhausted
			then Color3.fromRGB(255, 120, 120)
			elseif hp < maxHp * 0.34 then Color3.fromRGB(255, 205, 110)
			else Color3.fromRGB(190, 245, 195)
	end

	-- Ein erschoepfter Baerchi wird matt. Bewusst nicht komplett durchsichtig:
	-- er ist ausser Gefecht, nicht weg.
	--
	-- Die urspruengliche Transparenz jedes Teils steht als Attribut daran
	-- (gesetzt beim Aufbau). Sie einfach auf 0 zurueckzusetzen wuerde sonst
	-- absichtliche Durchsichtigkeit im importierten Modell zerstoeren — der
	-- Gummy-Baer ist genau dafuer ein Beispiel.
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local stored = part:GetAttribute("BaseTransparency")
			local base   = if typeof(stored) == "number" then stored else 0

			part.Transparency = if exhausted
				then math.max(base, MapConfig.BAERCHI_EXHAUSTED_TRANSPARENCY)
				else base
		end
	end
end

-- Wie writeFigureState, aber respektiert einen laufenden PIT-Kampf.
--
-- Waehrend eines Laufs gehoert die Figur dem PitArenaService: der Kampf ist
-- serverseitig schon ausgerechnet und die HP stehen bereits auf dem Endwert,
-- waehrend die Wiedergabe in der Arena noch laeuft. Wuerde hier
-- dazwischengeschrieben, saehe der Baerchi ab der ersten Sekunde erschoepft
-- aus statt am Ende. PitArenaService zieht den Zustand selbst nach.
function FigureBuilder.writeBaerchiState(model: Model, baerchi: Types.Baerchi, maxHp: number)
	if model:GetAttribute("InArena") == true then
		return
	end

	FigureBuilder.writeFigureState(model, baerchi.currentHp, maxHp)
end

-- Eine Baerchi-Figur: das geklonte Pet-Mesh aus BaerchiMesh.build. Welches
-- Modell das ist (eigenes fuer diese Rarity oder der gemeinsame Platzhalter)
-- und ob es eingefaerbt wird, entscheidet BaerchiMesh selbst.
--
-- JEDE BasePart der Figur traegt das Attribut "BaerchiUid" und einen eigenen
-- ClickDetector — bei einem Mesh aus mehreren Teilen waere ein einzelner
-- Hitbereich schwer zu treffen. Der Client (WorldController) liest das
-- Attribut beim Klick und schlaegt die Details in seinem eigenen Datenstand
-- nach — dafuer braucht es kein zusaetzliches Remote.
--
-- Fehlt das Mesh-Template noch, gibt BaerchiMesh.build nil zurueck — dann
-- wird diese eine Figur uebersprungen, der Rest des Plots baut sich normal.
function FigureBuilder.buildBaerchiFigure(parent: Instance, baerchi: Types.Baerchi, footPos: Vector3, facing: CFrame): Model?
	local color = BaerchiConfig.getRarityColor(baerchi.rarity)

	-- Ein MUTIERTER Baerchi (seit v11, ersetzt das fruehere binaere Inverted)
	-- bekommt die Farbe seiner Mutations-Stufe und leuchtet (siehe
	-- BaerchiMesh.build). Fuer alle anderen ist der vierte Parameter nil und
	-- es aendert sich nichts.
	local mutationColor = if baerchi.mutation
		then BaerchiConfig.getMutationColor(baerchi.mutation)
		else nil

	local model = BaerchiMesh.build(footPos, color, baerchi.rarity, mutationColor)
	if not model then
		return nil
	end
	model.Name = "Baerchi_" .. baerchi.uid

	-- BaerchiMesh stellt die Figur achsen-parallel hin. Hier wird sie noch in
	-- die Blickrichtung des Plots gedreht — und zwar um die senkrechte Achse
	-- DURCH footPos, nicht um den Modell-Pivot: wo der Pivot im importierten
	-- Mesh liegt, weiss dieses Modul nicht, eine Drehung darum wuerde die
	-- Figur seitlich wegschieben.
	local rotation = facing.Rotation
	local toOrigin = CFrame.new(-footPos)
	model:PivotTo(CFrame.new(footPos) * rotation * toOrigin * model:GetPivot())

	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part:SetAttribute("BaerchiUid", baerchi.uid)

			-- Ausgangs-Transparenz merken, damit der Erschoepfungs-Zustand
			-- sie spaeter nicht ueberschreibt (siehe writeBaerchiState).
			part:SetAttribute("BaseTransparency", part.Transparency)

			local click = Instance.new("ClickDetector")
			click.MaxActivationDistance = MapConfig.BAERCHI_CLICK_DISTANCE
			click.Parent = part
		end
	end

	-- Rarity-Aura: ab Rare ein dezentes Dauer-Glitzern, ab Epic zusaetzlich ein
	-- PointLight. Nutzt dieselbe Farbe wie die Koerpereinfaerbung
	-- (BaerchiConfig.getRarityColor) — Seltenheit soll auch aus der Distanz auf
	-- einen Blick erkennbar sein, nicht erst beim Ranschauen des Namensschilds.
	-- Siehe DESIGN_VORSCHLAG_TRENDANALYSE_2026-09-11.md Abschnitt 5.
	--
	-- Haengt an EINEM zentralen Part (nicht an jedem BasePart wie der
	-- ClickDetector oben): ein Glitzern pro Teilstueck des Mesh saehe wie ein
	-- Funkensturm aus, nicht wie eine Aura.
	local auraAnchor = (model.PrimaryPart :: BasePart?) or (model:FindFirstChildWhichIsA("BasePart", true) :: BasePart?)
	if auraAnchor then
		local rarityKey = baerchi.rarity :: string

		if MapConfig.RARITY_AURA_MIN_SPARKLE[rarityKey] then
			local sparkle = Instance.new("ParticleEmitter")
			sparkle.Name          = "RarityAura"
			sparkle.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
			sparkle.Color         = ColorSequence.new(color)
			sparkle.Size          = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.35),
				NumberSequenceKeypoint.new(1, 0),
			})
			sparkle.Transparency  = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			})
			sparkle.Lifetime      = NumberRange.new(0.8, 1.4)
			sparkle.Speed         = NumberRange.new(1, 3)
			sparkle.SpreadAngle   = Vector2.new(180, 180)
			sparkle.Rate          = MapConfig.RARITY_AURA_PARTICLE_RATE
			sparkle.Parent        = auraAnchor
		end

		if MapConfig.RARITY_AURA_MIN_LIGHT[rarityKey] then
			local light = Instance.new("PointLight")
			light.Name       = "RarityAuraLight"
			light.Color      = color
			light.Range      = MapConfig.RARITY_AURA_LIGHT_RANGE
			light.Brightness = MapConfig.RARITY_AURA_LIGHT_BRIGHTNESS
			light.Parent     = auraAnchor
		end

		-- Mutations-Aura (seit v11): unabhaengig von der Rarity-Aura oben, weil
		-- eine Mutation auch einen Common treffen kann, der sonst nie eine Aura
		-- haette. JEDE Mutation bekommt zumindest ein Punktlicht in ihrer
		-- eigenen Farbe; ab Multiplikator 4x (Celestial/Candy/Lava/Galaxy/
		-- Rainbow — siehe BaerchiConfig.MUTATIONS) zusaetzlich ein dichteres
		-- Glitzern, damit die seltensten Baerchis im Spiel auch aus der
		-- Distanz sofort als etwas Besonderes auffallen.
		if baerchi.mutation then
			local mutColor = BaerchiConfig.getMutationColor(baerchi.mutation)

			local mutLight = Instance.new("PointLight")
			mutLight.Name       = "MutationAuraLight"
			mutLight.Color      = mutColor
			mutLight.Range      = MapConfig.RARITY_AURA_LIGHT_RANGE
			mutLight.Brightness = MapConfig.RARITY_AURA_LIGHT_BRIGHTNESS * 1.5
			mutLight.Parent     = auraAnchor

			if BaerchiConfig.getMutationMultiplier(baerchi.mutation) >= 4 then
				local mutSparkle = Instance.new("ParticleEmitter")
				mutSparkle.Name          = "MutationAura"
				mutSparkle.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
				mutSparkle.Color         = ColorSequence.new(mutColor)
				mutSparkle.Size          = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(1, 0),
				})
				mutSparkle.Transparency  = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.15),
					NumberSequenceKeypoint.new(1, 1),
				})
				mutSparkle.Lifetime      = NumberRange.new(1.0, 1.8)
				mutSparkle.Speed         = NumberRange.new(2, 5)
				mutSparkle.SpreadAngle   = Vector2.new(180, 180)
				mutSparkle.Rate          = MapConfig.RARITY_AURA_PARTICLE_RATE * 2
				mutSparkle.Parent        = auraAnchor
			end
		end
	end

	-- Namensschild ueber dem Kopf (faellt auf den Body zurueck, falls das
	-- Template keinen Part namens "head" hat). Rekursiv gesucht: der Importer
	-- packt die Teile in eine Zwischen-Gruppe.
	--
	-- Drei Zeilen statt zwei seit dem Ei-Legen: Name+Level, HP, und ganz unten
	-- der Ei-Timer. Der Ei-Timer-Text wird HIER nur als leeres Label angelegt —
	-- befuellt wird er rein clientseitig (EggTimerController), weil er
	-- sekuendlich weiterzaehlt und dafuer keine Serverlast noetig ist (siehe
	-- Kommentar-Kopf dort).
	local labelAnchor = (model:FindFirstChild("head", true) :: BasePart?) or model.PrimaryPart
	if labelAnchor then
		-- Sammel-Update 1.4 ("Naechstes Ei in: ist im Baerchi und braucht mehr
		-- Space"): breiter und hoeher (laengere Texte auf Franzoesisch/
		-- Spanisch), und der Abstand kommt aus der echten Oberkante der Figur
		-- (welt-ausgerichtet) statt aus der am body gedrehten Bounding-Box —
		-- das Schild sitzt damit immer UEBER dem Kopf, nie darin.
		local billboard = Instance.new("BillboardGui")
		billboard.Name        = "Label"
		billboard.Size        = UDim2.fromScale(MapConfig.FIGURE_LABEL.width, MapConfig.FIGURE_LABEL.height)
		local _, topY = BaerchiMesh.worldBoundsY(model)
		local anchorY = labelAnchor.Position.Y
		local aboveHead = if topY then math.max(0, (topY :: number) - anchorY) else BaerchiMesh.getHeight(model) * 0.55
		billboard.StudsOffset = Vector3.new(0, aboveHead + MapConfig.FIGURE_LABEL.height * 0.5 + MapConfig.FIGURE_LABEL.gap, 0)
		billboard.AlwaysOnTop = false
		billboard.MaxDistance = MapConfig.BAERCHI_CLICK_DISTANCE
		billboard.Adornee     = labelAnchor
		billboard.Parent      = labelAnchor

		local name = MapParts.newTextLabel("Name", billboard, UDim2.fromScale(1, 0.34), UDim2.fromScale(0, 0))
		-- Das Namensschild ist die zweite Stelle, an der eine Mutation
		-- auffaellt (die erste ist die leuchtende Mutations-Farbe der
		-- Figur selbst). Beides zusammen, weil die Farbe allein bei einer
		-- Rarity mit ungewohnter Palette nicht eindeutig genug waere —
		-- und weil ein Spieler lesen koennen soll, WELCHE der acht Stufen
		-- es genau ist (die Farbe allein verraet das nicht zuverlaessig).
		-- Als Nachricht: jeder Spieler liest den Namen in seiner Sprache (WorldText)
		WorldText.set(name, Loc.msg("ui.world.figure_name", {
			badge = if baerchi.mutation then BaerchiConfig.getMutationBadge(baerchi.mutation) .. " " else "",
			name  = Names.msg.baerchi(baerchi.configId),
			level = baerchi.level,
		}))

		if baerchi.mutation then
			name.TextColor3 = BaerchiConfig.getMutationColor(baerchi.mutation)
		end

		MapParts.newTextLabel("Health", billboard, UDim2.fromScale(1, 0.28), UDim2.fromScale(0, 0.34))

		-- Ei-Timer bekommt die groesste Zeile: er ist der laengste Text.
		local eggTimer = MapParts.newTextLabel("EggTimer", billboard, UDim2.fromScale(1, 0.38), UDim2.fromScale(0, 0.62))
		eggTimer.TextColor3 = Color3.fromRGB(255, 224, 140)   -- Ei-Gold, passend zur HUD-Farbwelt
		eggTimer.Text        = ""   -- EggTimerController fuellt das im ersten Tick
	end

	model.Parent = parent
	return model
end

-- Maximale HP eines Baerchis. Liegt hier statt inline, weil sowohl der Aufbau
-- als auch die In-Place-Aktualisierung sie brauchen.
function FigureBuilder.maxHpOf(baerchi: Types.Baerchi): number
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then return 1 end

	return CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
end

-- Baut die sichtbare Baerchi-Figur eines Plots neu: seit dem Equip-System
-- steht dort hoechstens EINE — der ausgeruestete Baerchi. Alle anderen sind
-- reiner Inventar-Datensatz und werden nicht in die Welt gebaut. Ist keiner
-- ausgeruestet (leerer Plot, z.B. direkt nach einem Rebirth), bleibt der
-- Ordner einfach leer.
function FigureBuilder.renderBaerchis(plotModel: Model, slot: number, islandData: Types.IslandData)
	local old = plotModel:FindFirstChild("Baerchis")
	if old then old:Destroy() end

	local folder = Instance.new("Folder")
	folder.Name   = "Baerchis"
	folder.Parent = plotModel

	local equippedUid = islandData.equippedUid
	local equipped = if equippedUid then islandData.baerchis[equippedUid] else nil
	if not equipped then
		return
	end

	local plotCFrame = MapParts.plotCFrame(slot)
	local home       = MapLayout.baerchiHomeOffset()   -- HONEY_POND_V2: am Becken
	local footPos    = (plotCFrame * CFrame.new(home.X, MapParts.plotSurfaceOffset() + home.Y, home.Z)).Position

	local figure = FigureBuilder.buildBaerchiFigure(folder, equipped, footPos, plotCFrame)
	if figure then
		FigureBuilder.writeBaerchiState(figure, equipped, FigureBuilder.maxHpOf(equipped))

		-- Eine frisch gebaute Figur steht — also atmet sie. Wer sie danach
		-- selbst bewegt (PitArenaService, BaerchiAutopilotService), meldet sie
		-- vorher ab und danach wieder an. Die alte Figur ist eine Zeile weiter
		-- oben zerstoert worden; ihr Registry-Eintrag raeumt sich beim
		-- naechsten Durchlauf des Idle-Loops selbst weg.
		FigureFX.idleBob(figure, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
	end
end

return FigureBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">LaidEggBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- LaidEggBuilder.luau
-- ServerScriptService/Util/MapBuild/LaidEggBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Die gelegten Eier eines Plots in der Welt zeigen und das Beruehren durch
--     den Besitzer an den eingehaengten Handler melden
--
-- Den Handler haengt EggLayService ueber MapService.setEggCollectHandler ein
-- (Pull-Callback statt require, sonst entstuende ein Ringschluss).
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local CollectionService   = game:GetService("CollectionService")
local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local EggConfig        = require(ReplicatedStorage.Config.EggConfig)
local EggLook          = require(ReplicatedStorage.Modules.EggLook)
local EggMesh          = require(ReplicatedStorage.Modules.EggMesh)
local Types            = require(ReplicatedStorage.Network.Types)
local Names     = require(ReplicatedStorage.Localization.Names)
local WorldText = require(ReplicatedStorage.Localization.WorldText)

local FigureFX         = require(ServerScriptService.Util.FigureFX)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local LaidEggBuilder = {}

-- Wird aufgerufen, wenn der BESITZER eines Plots sein eigenes gelegtes Ei mit
-- der Spielfigur beruehrt. Ohne Handler sammelt Beruehren einfach nichts ein.
local _collectHandler: ((Player, string) -> ())? = nil

function LaidEggBuilder.setCollectHandler(handler: (Player, string) -> ())
	_collectHandler = handler
end

-- Attribut, das jedes gelegte Ei traegt. Der Client liest es beim Klick
-- (WorldController) — dieselbe Konvention wie "BaerchiUid" an den Figuren.
LaidEggBuilder.LAID_EGG_ATTRIBUTE = "LaidEggUid"

-- ============================================================================
-- Aussehen
-- ============================================================================
-- Ein gelegtes Ei ist ein GESTAPELTES Ei: ein Rotationsmesh mit sechs abgesetzten Stufen (siehe buildTemplate). Gurte in der Zweitfarbe liegen an den Naehten,
-- Stein-Punkte und eine kleine Spitze oben vervollstaendigen es; seltene Eier
-- bekommen einen Schimmer am Boden.
--
-- Die Ringe wechseln leicht die Helligkeit (Segment-Look), die Gurte setzen das
-- Muster des Pfads (EggLook): Stamm = Punkte, Gold = goldene Krone mit Steinen,
-- Kristall = drei Gurte, Void/Kosmos/Ascension/Event = Neon-Gurte + Leuchtpunkte.
--
-- Teile-Budget: Mesh-Koerper (1 Teil) + 0 bis 3 Gurte + 0 bis 3 Punkte + hoechstens
-- 1 Schimmer = 3 bis 8 Teile je Ei, bis zu 12 Eier je Plot.

local EGG_SCALE        = 0.85   -- gegenueber EggConfig.LAY_EGG_SIZE: Eier bleiben kleiner als ein Baerchi (BAERCHI_SCALE in BaerchiMesh)
local SPARKLE_RATE     = 3      -- Funken/Sekunde bei seltenen Eiern (ein Emitter je Ei)

local function shade(color: Color3, amount: number): Color3
	if amount >= 0 then return color:Lerp(Color3.new(1, 1, 1), amount) end
	return color:Lerp(Color3.new(0, 0, 0), -amount)
end

local function finish(part: Part, parent: Instance)
	part.CanCollide = false
	part.CanTouch   = false
	part.CanQuery   = false
	part.CastShadow = false
	part.Parent     = parent
end

-- Ein stehender Zylinder (Cylinder-Part liegt von Haus aus entlang X; um 90 Grad
-- um Z gekippt steht seine Achse senkrecht), Unterkante auf `y0`.
local function newRing(name: string, origin: CFrame, y0: number, h: number, r: number, color: Color3, material: Enum.Material): Part
	local part = MapParts.newPart(name, Vector3.new(h, r * 2, r * 2),
		origin * CFrame.new(0, y0 + h * 0.5, 0) * CFrame.Angles(0, 0, math.pi / 2), color, material)
	part.Shape = Enum.PartType.Cylinder
	return part
end

-- Ein runder Stein auf dem Mantel eines Rings.
local function newGem(origin: CFrame, y: number, r: number, angle: number, diameter: number, color: Color3, material: Enum.Material, parent: Instance)
	local dir = Vector3.new(math.sin(angle), 0, math.cos(angle))
	local pos = origin:PointToWorldSpace(Vector3.new(0, y, 0) + dir * (r + diameter * 0.05))
	local out = origin:VectorToWorldSpace(dir)
	local gem = MapParts.newPart("Gem", Vector3.new(diameter, diameter * 1.15, diameter * 0.3),
		CFrame.lookAt(pos, pos + out), color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent   = gem
	finish(gem, parent)
end

-- Baut Koerper, Gurte, Steine und Schimmer. Gibt die Wurzel (den Eikoerper)
-- zurueck; sie traegt Attribut und Touch-Kontakt (siehe buildLaidEgg), alle
-- anderen Teile haengen als Kinder daran.
local function buildEggBody(name: string, eggId: string, origin: CFrame, width: number, height: number, parent: Instance): Part
	local look   = EggLook.get(eggId)
	local matte  = Enum.Material.SmoothPlastic
	local trim   = if look.neon then Enum.Material.Neon elseif look.pattern == "band" then Enum.Material.Metal else matte

	-- Schlichter Koerper (Kugel-Mesh): das feine Ei-Mesh legt der Client
	-- darueber (LaidEggMeshController); ohne Client-Mesh bleibt die Kugel.
	local root = MapParts.newPart(name, Vector3.new(width, height, width),
		origin * CFrame.new(0, height * 0.5, 0), look.base, matte)
	local sphere = Instance.new("SpecialMesh")
	sphere.MeshType = Enum.MeshType.Sphere
	sphere.Parent   = root
	root.Parent     = parent
	CollectionService:AddTag(root, "LaidEggBody")

	root.CanCollide = false

	-- Gurte an den Naehten (Kanten 2 bis 4 der Stufen)
	local seams: { number } = {}
	if look.pattern == "band" then
		seams = { 3 }
	elseif look.pattern == "stripes" then
		seams = { 2, 3, 4 }
	elseif look.neon then
		seams = { 2, 4 }
	end
	for _, edge in seams do
		local t = EggMesh.TIER_EDGES[edge]
		finish(newRing("Band", origin, t * height - height * 0.02, height * 0.04,
			EggMesh.radius(t) * width * 0.985 + width * 0.01, look.accent, trim), root)
	end

	-- Steine / Punkte auf dem Bauch (Hoehe 0,41)
	local gemColor = if look.pattern == "band" then Color3.fromRGB(235, 40, 60) else look.accent
	local gemMat   = if look.pattern == "band" or look.neon then Enum.Material.Neon else matte
	if look.pattern == "spots" or look.neon or look.pattern == "band" then
		local count = if look.pattern == "band" then 2 else 3
		local size  = if look.pattern == "spots" then width * 0.26 elseif look.pattern == "band" then width * 0.15 else width * 0.14
		local t     = if look.pattern == "band" then 0.41 else 0.38
		local r     = EggMesh.radius(t) * width * 0.97
		for k = 1, count do
			newGem(origin, t * height, r, (k - 1) * (2 * math.pi / count) + 0.4, size, gemColor, gemMat, root)
		end
	end

	-- Schimmer am Boden und Funken bei seltenen Eiern
	if look.glow then
		root.Reflectance = 0.08
		local disc = MapParts.newPart("Glow", Vector3.new(0.05, width * 1.25, width * 1.25),
			origin * CFrame.new(0, 0.03, 0) * CFrame.Angles(0, 0, math.pi / 2),
			look.base:Lerp(look.accent, 0.5), Enum.Material.Neon)
		disc.Shape        = Enum.PartType.Cylinder
		disc.Transparency = 0.8
		finish(disc, root)

		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
		sparkle.Color         = ColorSequence.new(look.accent)
		sparkle.Size          = NumberSequence.new(0.35, 0)
		sparkle.Lifetime      = NumberRange.new(0.9, 1.5)
		sparkle.Rate          = SPARKLE_RATE
		sparkle.Speed         = NumberRange.new(0.4, 1)
		sparkle.SpreadAngle   = Vector2.new(180, 180)
		sparkle.LightEmission = 1
		sparkle.Parent        = root
	end

	return root
end



-- Kleine Pruefsumme der uid fuer eine stabile Drehung: jedes Ei zeigt sein
-- Muster in eine andere Richtung, aber immer in dieselbe, solange es liegt
-- (der Plot wird bei jeder Aenderung neu gebaut).
local function yawFor(uid: string): number
	local sum = 0
	for index = 1, #uid do
		sum = (sum * 31 + string.byte(uid, index)) % 6283
	end
	return sum / 1000
end

-- Ein gelegtes Ei in der Welt. Eingesammelt wird es, indem die Spielfigur des
-- BESITZERS hindurchlaeuft (Touched) — kein Klick mehr noetig.
--
-- Warum Touched statt ClickDetector: ein Ei anzuklicken heisst erst zielen,
-- dann treffen — bei bis zu zwoelf Eiern auf einem Plot ist das umstaendlich.
-- Der Spieler laesst seinen Baerchi ohnehin standig zum Honig-Teich und
-- zurueck laufen (siehe BaerchiAutopilotService) und hinterlaesst dabei eine
-- Spur aus Eiern — die sollen von selbst eingesammelt werden, sobald man
-- durchlaeuft.
--
-- Server-autoritativ, wie ueberall im Projekt: der Touch-Kontakt loest nicht
-- direkt EggLayService.collect aus (MapService kennt EggLayService nicht,
-- Ringschluss-Gefahr — siehe _collectHandler), sondern ruft nur den
-- eingehaengten Handler auf. Der entscheidet autoritativ, ob das Ei noch da
-- ist und wem es gehoert.
function LaidEggBuilder.buildLaidEgg(parent: Instance, egg: Types.LaidEgg, worldFoot: Vector3, owner: Player): Part?
	local def = EggConfig.data[egg.eggType]
	if not def then
		-- Ei-Typ aus der Config entfernt: still ueberspringen. Ein Ei ohne
		-- Farbe und Namen zu bauen waere schlimmer als keines.
		return nil
	end

	local size   = EggConfig.LAY_EGG_SIZE
	local width  = size.X * EGG_SCALE
	local height = size.Y * EGG_SCALE
	local look   = EggLook.get(egg.eggType)
	local origin = CFrame.new(worldFoot) * CFrame.Angles(0, yawFor(egg.uid), 0)

	-- Wurzel: der breiteste Ring. Er traegt Attribut und Touch-Kontakt; alle
	-- anderen Teile haengen als Kinder daran und verschwinden mit ihm.
	local part = buildEggBody("LaidEgg_" .. egg.uid, egg.eggType, origin, width, height, parent)
	part.CanTouch   = true    -- man soll durch Eier laufen koennen, nicht ueber sie stolpern (CanCollide bleibt aus)
	part.CanQuery   = true
	part.CastShadow = true

	part:SetAttribute(LaidEggBuilder.LAID_EGG_ATTRIBUTE, egg.uid)

	-- Nur EIN erfolgreicher Touch-Kontakt darf einsammeln: Touched feuert
	-- fuer jeden Frame, in dem die Figur noch im Part steckt, erneut. Ohne
	-- diese Sperre wuerde derselbe Durchlauf den Handler viele Male aufrufen
	-- (harmlos, weil EggLayService.collect bei einem bereits entfernten Ei
	-- einfach nichts tut — aber unnoetige Anfragen).
	local collected = false
	local touchConnection: RBXScriptConnection? = nil
	touchConnection = part.Touched:Connect(function(hit: BasePart)
		if collected then return end

		local character = hit.Parent
		if not character then return end

		local toucher = Players:GetPlayerFromCharacter(character)
		if not toucher then return end

		-- Nur der Besitzer des Plots sammelt sein eigenes Ei ein — ein
		-- durchlaufender Nachbar soll fremde Eier nicht mitnehmen koennen.
		if toucher ~= owner then return end

		collected = true
		if touchConnection then
			touchConnection:Disconnect()
		end

		-- Partikel-Stoss in der Ei-Farbe AN WORKSPACE, nicht am "LaidEggs"-
		-- Ordner: der wird gleich durch den Datenwechsel neu aufgebaut
		-- (renderLaidEggs zerstoert ihn komplett), der Burst soll das
		-- ueberleben statt mitten in der Animation zu verschwinden.
		FigureFX.burstAt(part.Position, look.base, workspace)

		local handler = _collectHandler
		if handler then
			handler(toucher, egg.uid)
		end
	end)

	local billboard = Instance.new("BillboardGui")
	billboard.Name        = "Label"
	billboard.Size        = UDim2.fromScale(4.4, 1.3)
	billboard.StudsOffset = Vector3.new(0, height * 0.58 + 0.5, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = EggConfig.LAY_LABEL_DISTANCE
	billboard.Adornee     = part
	billboard.Parent      = part

	local label = MapParts.newTextLabel("Name", billboard, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	WorldText.set(label, Names.msg.eggShort(def.id))
	label.TextColor3       = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = look.base:Lerp(Color3.new(0, 0, 0), 0.65)
	label.TextStrokeTransparency = 0

	return part
end

-- Baut ALLE herumliegenden Eier eines Plots neu.
--
-- Bewusst komplett neu statt einzeln nachzupflegen: es sind hoechstens
-- EggConfig.MAX_UNCOLLECTED_EGGS Stueck (zwoelf kleine Kugeln), und der
-- Vergleich "welches Ei ist neu, welches wurde eingesammelt" waere mehr Code
-- als der gesamte Neuaufbau. Die Baerchi-Figuren sind der Fall, wo sich der
-- Aufwand lohnt — ein Mesh ist um Groessenordnungen teurer als eine Kugel.
--
-- Die Positionen in den Daten sind PLOT-RELATIV (siehe Types.LaidEgg): hier
-- werden sie in Weltkoordinaten zurueckgerechnet.
function LaidEggBuilder.renderLaidEggs(plotModel: Model, slot: number, islandData: Types.IslandData, owner: Player)
	local old = plotModel:FindFirstChild("LaidEggs")
	if old then old:Destroy() end

	local folder = Instance.new("Folder")
	folder.Name   = "LaidEggs"
	folder.Parent = plotModel

	-- Typisiert statt direkt aus islandData gelesen: ein Datenpaket von einem
	-- aelteren Serverstand haette das Feld nicht, und ohne die Annotation
	-- verliert die Schleife darunter den Typ.
	local eggs: { Types.LaidEgg } = islandData.laidEggs or {}
	if #eggs == 0 then
		return
	end

	local plotCFrame = MapParts.plotCFrame(slot)
	if not plotCFrame then return end

	for _, egg in eggs do
		local worldFoot = plotCFrame:PointToWorldSpace(Vector3.new(egg.x, egg.y, egg.z))
		LaidEggBuilder.buildLaidEgg(folder, egg, worldFoot, owner)
	end
end

return LaidEggBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">PlotBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- PlotBuilder.luau
-- ServerScriptService/Util/MapBuild/PlotBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Das Grundgeruest eines Spieler-Plots (Beet, Zaun, Schild) und die
--     Honig-Gebaeude mit Schild und Honig-Tropfen bauen und beschriften
--
-- Gebaeude bestehen aus einem unsichtbaren Koerper (Name, Level, Schild,
-- Client-Prompt) und der deklarativen Deko aus MapConfig.BUILDING_DECOR plus
-- den Zusaetzen ihres Looks (v15, MapConfig.getBuildingDecor). Der Look steht
-- als Attribut "Look" am Koerper — MapService baut ein Gebaeude nur neu, wenn
-- sich der Look aendert.
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types            = require(ReplicatedStorage.Network.Types)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local Names     = require(ReplicatedStorage.Localization.Names)
local WorldText = require(ReplicatedStorage.Localization.WorldText)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local PlotBuilder = {}

-- Zaun an den beiden Seiten des Plots. Vorne und hinten bleibt offen, sonst
-- kaeme man weder auf den Plot noch zur Bruecke.
function PlotBuilder.buildFence(plotModel: Model, slot: number)
	local plotCFrame = MapParts.plotCFrame(slot)
	local halfX = MapConfig.PLOT_SIZE.X * 0.5
	local halfZ = MapConfig.PLOT_SIZE.Z * 0.5

	local postY = MapParts.plotSurfaceOffset() + MapConfig.FENCE_POST_SIZE.Y * 0.5
	local steps = math.max(1, math.floor(MapConfig.PLOT_SIZE.Z / MapConfig.FENCE_POST_SPACING))

	for _, side in { -1, 1 } do
		for i = 0, steps do
			local z = -halfZ + (i / steps) * MapConfig.PLOT_SIZE.Z

			local post = MapParts.newPart(
				"FencePost",
				MapConfig.FENCE_POST_SIZE,
				plotCFrame * CFrame.new(side * halfX, postY, z),
				MapConfig.FENCE_COLOR,
				Enum.Material.Wood
			)
			post.CanCollide = false
			post.Parent     = plotModel
		end

		-- Zwei durchgehende Querlatten statt einzelner Segmente: ein Part
		-- statt acht, und optisch macht es keinen Unterschied.
		for _, heightFactor in { 0.45, 0.85 } do
			local railY = MapParts.plotSurfaceOffset() + MapConfig.FENCE_POST_SIZE.Y * heightFactor

			local rail = MapParts.newPart(
				"FenceRail",
				Vector3.new(MapConfig.FENCE_POST_SIZE.X * 0.6, MapConfig.FENCE_RAIL_HEIGHT, MapConfig.PLOT_SIZE.Z),
				plotCFrame * CFrame.new(side * halfX, railY, 0),
				MapConfig.FENCE_COLOR,
				Enum.Material.Wood
			)
			rail.CanCollide = false
			rail.Parent     = plotModel
		end
	end
end

-- Schild an der zur Mitte zeigenden Kante mit dem Namen des Besitzers.
-- v15: darunter ein kleines Tower-Symbol (hoechster Tower, siehe
-- writeOwnerBadge) — gesetzt von MapService, sobald der Tower-Stand bekannt ist.
function PlotBuilder.buildPlotSign(plotModel: Model, slot: number, ownerName: string)
	local plotCFrame = MapParts.plotCFrame(slot)
	local halfZ = MapConfig.PLOT_SIZE.Z * 0.5

	local boardSize = MapConfig.SIGN_BOARD_SIZE
	local postSize  = MapConfig.SIGN_POST_SIZE

	-- Zwei Pfosten an den Raendern, HINTER dem Brett (lokal +Z = weg von der
	-- Mitte; die Schrift zeigt nach -Z). So verdeckt kein Pfosten die Schrift.
	local postY = MapParts.plotSurfaceOffset() + postSize.Y * 0.5
	local behind = boardSize.Z * 0.5 + postSize.Z * 0.5
	for _, side in { -1, 1 } do
		local post = MapParts.newPart(
			"SignPost",
			postSize,
			plotCFrame * CFrame.new(side * (boardSize.X * 0.5 - postSize.X), postY, -halfZ + 2 + behind),
			MapConfig.SIGN_POST_COLOR,
			Enum.Material.Wood
		)
		post.CanCollide = false
		post.Parent     = plotModel
	end

	local boardY = MapParts.plotSurfaceOffset() + postSize.Y - boardSize.Y * 0.5
	local board = MapParts.newPart(
		"SignBoard",
		boardSize,
		plotCFrame * CFrame.new(0, boardY, -halfZ + 2),
		MapConfig.SIGN_COLOR,
		Enum.Material.Wood
	)
	board.CanCollide = false
	board.Parent     = plotModel

	-- Dunkle Leisten oben und unten (Rahmen statt nacktem Brett)
	for i, dy in { boardSize.Y * 0.5, -boardSize.Y * 0.5 } do
		local trim = MapParts.newPart(
			"SignTrim" .. i,
			Vector3.new(boardSize.X + 0.6, 0.45, boardSize.Z + 0.2),
			plotCFrame * CFrame.new(0, boardY + dy, -halfZ + 2),
			MapConfig.SIGN_TRIM_COLOR,
			Enum.Material.Wood
		)
		trim.CanCollide = false
		trim.Parent     = plotModel
	end

	-- Die Schrift kommt auf die Seite, die zur Plattform-Mitte zeigt. Das ist
	-- die lokale -Z-Seite des Plots und damit die Vorderseite des Boards.
	local surface = Instance.new("SurfaceGui")
	surface.Name        = "SignText"
	surface.Face        = Enum.NormalId.Front
	surface.PixelsPerStud = 40
	surface.Adornee     = board
	surface.Parent      = board

	local label = MapParts.newTextLabel("Owner", surface, UDim2.fromScale(0.9, 0.56), UDim2.fromScale(0.05, 0.08))
	label.TextColor3             = Color3.fromRGB(70, 50, 30)
	label.TextStrokeTransparency = 1
	label.Text                   = ownerName

	local badge = MapParts.newTextLabel("TowerBadge", surface, UDim2.fromScale(0.9, 0.28), UDim2.fromScale(0.05, 0.64))
	badge.TextStrokeTransparency = 1
	badge.Text                   = ""
end

-- v15: Tower-Symbol unter dem Besitzernamen ("◆ III · 42"). Billig, nur Text.
function PlotBuilder.writeOwnerBadge(plotModel: Model, text: string | Types.LocMsg, color: Color3)
	local board = plotModel:FindFirstChild("SignBoard")
	local surface = board and board:FindFirstChild("SignText")
	local badge = surface and surface:FindFirstChild("TowerBadge")
	if badge and badge:IsA("TextLabel") then
		WorldText.set(badge, text)
		badge.TextColor3 = color
	end
end

-- Die Plot-Platte samt Zaun und Schild.
--
-- Das Besitzer-Attribut wird gesetzt BEVOR das Model in den Workspace kommt:
-- der Client bekommt es damit zusammen mit dem Model und muss nicht darauf
-- warten. WorldController haengt daran, ob er ueberhaupt einen Prompt baut.
function PlotBuilder.buildPlotBase(slot: number, owner: Player): Model
	local plotCFrame = MapParts.plotCFrame(slot)

	local model = Instance.new("Model")
	model.Name  = "Plot_" .. slot
	model:SetAttribute("PlotOwner", owner.UserId)

	-- Das Beet: eine quadratische Platte auf der Plot-Insel. Dunkles Gruen wie
	-- die Hauptinsel, darauf dieselben hellen Karos — nur plot-lokal gerastert,
	-- weil das Beet je nach Plot in einem anderen Winkel steht.
	local base = MapParts.newPart(
		"Base",
		MapConfig.PLOT_SIZE,
		plotCFrame * CFrame.new(0, MapConfig.PLOT_SIZE.Y * 0.5, 0),
		MapConfig.GRASS_DARK,
		Enum.Material.Grass
	)
	base.CanCollide = true
	base.Parent     = model

	MapParts.buildCheckerPlate(
		model,
		plotCFrame * CFrame.new(0, MapConfig.PLOT_SIZE.Y, 0),
		MapConfig.PLOT_SIZE.X,
		MapConfig.PLOT_SIZE.Z
	)

	model.PrimaryPart = base

	PlotBuilder.buildFence(model, slot)
	PlotBuilder.buildPlotSign(model, slot, owner.DisplayName)

	-- Der Spieler spawnt (und respawnt nach dem Tod) auf seiner EIGENEN
	-- Insel statt in der Weltmitte — siehe MapConfig.PLAYER_SPAWN_OFFSET fuer
	-- die Wahl der Stelle. Unsichtbar: sie soll wie ein normaler Fleck Wiese
	-- aussehen, kein Extra-Bodenbelag auf dem Plot.
	--
	-- `owner.RespawnLocation` direkt zu setzen (statt sich auf Roblox' eigene
	-- Naechste-SpawnLocation-Auswahl zu verlassen) ist entscheidend: mit acht
	-- SpawnLocations in der Welt (eine pro Plot) waere sonst nicht garantiert,
	-- dass ein Spieler nach dem Tod bei SEINER eigenen landet.
	--
	-- newPart baut nur ein normales Part — eine SpawnLocation braucht die
	-- eigene Roblox-Klasse (Instance.new("SpawnLocation")), deshalb hier von
	-- Hand statt ueber das gemeinsame Util.
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name          = "PlayerSpawn"
	spawnLocation.Size          = Vector3.new(6, 1, 6)
	spawnLocation.CFrame        = plotCFrame * CFrame.new(
		MapConfig.PLAYER_SPAWN_OFFSET.X,
		MapParts.plotSurfaceOffset() + MapConfig.PLAYER_SPAWN_OFFSET.Y + 0.5,
		MapConfig.PLAYER_SPAWN_OFFSET.Z
	)
	spawnLocation.Anchored      = true
	spawnLocation.CanCollide    = false
	spawnLocation.CanQuery      = false
	spawnLocation.Neutral       = true
	spawnLocation.Transparency  = 1
	spawnLocation.Duration      = 0   -- keine Unverwundbarkeits-Phase, das Spiel kennt kein PvP am Spawn
	spawnLocation.Parent        = model

	owner.RespawnLocation = spawnLocation

	model.Parent = workspace

	return model
end

-- Die Honig-Tropfen am Fuss eines Gebaeudes einmalig anlegen. Sie werden
-- danach nur noch ein- und ausgeblendet (writeBuildingState), nie neu gebaut:
-- ein Neuaufbau alle 20 Sekunden mal drei Gebaeude mal acht Spieler waere
-- fuer reine Deko viel zu teuer.
--
-- `ground` ist die Mitte der Grundflaeche des Gebaeudes, also derselbe
-- Ursprung wie fuer die Deko.
--
-- `slots` ist das GROESSTE Lager, das dieses Gebaeude je haben kann — nicht
-- sein aktuelles —, seit v15 aber hoechstens MapConfig.HONEY_DOT_MAX (das Lager
-- des Bienenstocks waechst bis 39). Ueberzaehlige Tropfen stoeren nicht:
-- sichtbar ist ein Tropfen erst, wenn wirklich Honig drin liegt
-- (writeBuildingState).
function PlotBuilder.buildHoneyDots(body: BasePart, ground: CFrame, slots: number)
	if slots <= 0 then return end

	-- Fester Abstand, bis der maximale Bogen erreicht ist — dann ruecken die
	-- Tropfen zusammen, statt sich um das ganze Gebaeude zu wickeln.
	local arc = math.min(
		math.rad(MapConfig.HONEY_DOT_ARC),
		math.rad(MapConfig.HONEY_DOT_SPACING) * math.max(1, slots - 1)
	)

	for i = 1, slots do
		-- Bogen mittig um -Z herum. Bei nur einem Punkt gibt es nichts zu
		-- verteilen — dann steht er genau vorne.
		local t     = if slots > 1 then (i - 1) / (slots - 1) - 0.5 else 0
		local angle = t * arc

		local offset = Vector3.new(
			math.sin(angle) * MapConfig.HONEY_DOT_RADIUS,
			MapConfig.HONEY_DOT_HEIGHT,
			-math.cos(angle) * MapConfig.HONEY_DOT_RADIUS
		)

		local dot = MapParts.newPart(
			"HoneyDot" .. i,
			Vector3.new(MapConfig.HONEY_DOT_SIZE, MapConfig.HONEY_DOT_SIZE, MapConfig.HONEY_DOT_SIZE),
			ground * CFrame.new(offset),
			MapConfig.HONEY_DOT_COLOR,
			Enum.Material.Neon
		)
		dot.Shape        = Enum.PartType.Ball
		dot.Transparency = 1        -- Startzustand: leeres Lager
		dot.CanCollide   = false
		dot.CanQuery     = false
		dot.CanTouch     = false
		dot.Parent       = body
	end
end

-- Alles am Gebaeude, was sich im Betrieb aendert: Schildtext, Honig-Tropfen
-- und der Vorrats-Wert fuer den Fuetter-Prompt. Getrennt vom Aufbau, weil das
-- bei JEDER Honig-Aenderung laeuft (siehe updateBuildingSigns) und deshalb
-- billig bleiben muss.
function PlotBuilder.writeBuildingState(part: BasePart, buildingData: Types.Building, pool: number)
	local config = MapConfig.BUILDING_OFFSETS[buildingData.id]
	if not config then return end

	-- Attribut statt eigenem Remote: der Client haengt seinen Fuetter-Prompt
	-- daran und bekommt jede Aenderung ohne Zutun mit.
	part:SetAttribute("HoneyPool", pool)

	-- Lager DIESES Gebaeudes auf DIESEM Level — beim Bienenstock waechst es mit.
	local capacity = BuildingBehavior.getCapacity(buildingData.id, buildingData.level)
	local honey    = math.clamp(buildingData.honey or 0, 0, capacity)

	-- Ein Tropfen pro eingelagertem Honig. Es koennen mehr Tropfen dastehen als
	-- das aktuelle Lager fasst (gebaut wird nach dem Maximal-Lager) — die
	-- ueberzaehligen bleiben unsichtbar. v15: ist das Lager groesser als
	-- HONEY_DOT_MAX, steht ein Tropfen fuer einen ANTEIL (voll = alle an).
	local dotCount = math.min(BuildingBehavior.getMaxCapacity(buildingData.id), MapConfig.HONEY_DOT_MAX)
	local lit = if capacity <= MapConfig.HONEY_DOT_MAX
		then honey
		else math.ceil(honey * MapConfig.HONEY_DOT_MAX / math.max(1, capacity))
	for i = 1, dotCount do
		local dot = part:FindFirstChild("HoneyDot" .. i)
		if dot and dot:IsA("BasePart") then
			dot.Transparency = if i <= lit then 0 else 1
		end
	end

	local sign = part:FindFirstChild("Sign")
	if not sign or not sign:IsA("BillboardGui") then return end

	local title = sign:FindFirstChild("Title")
	if title and title:IsA("TextLabel") then
		WorldText.set(title, Loc.msg("ui.world.sign_level", {
			name = Names.msg.building(buildingData.id), level = buildingData.level,
		}))
	end

	local stock = sign:FindFirstChild("Stock")
	if stock and stock:IsA("TextLabel") then
		stock.Text = string.format("🍯 %d / %d", honey, capacity)   -- sprachneutral (2.4)

		-- Volles Lager faellt farblich auf: dann steht die Produktion und es
		-- wird Zeit, zurueckzukommen und zu fuettern.
		stock.TextColor3 = if honey >= capacity
			then Color3.fromRGB(255, 215, 100)
			else Color3.fromRGB(235, 235, 235)
	end
end

-- Ein Gebaeude auf dem Plot.
-- Der Name der Part ist die BuildingId — der Client (WorldController) findet
-- darueber das Gebaeude fuer den ProximityPrompt.
--
-- Die Part selbst ist seit v5 unsichtbar und kollidiert nicht: sie ist nur
-- noch Trefferflaeche fuer den Prompt sowie Traeger von Name, Attribut und
-- Schild. Zu SEHEN und anzustossen ist ausschliesslich die Deko. Getrennt,
-- weil das Anklickbare und das Huebsche zwei verschiedene Dinge sind — sonst
-- muesste jede Formaenderung Ruecksicht auf die Trefferflaeche nehmen.
-- Partikel-Effekte des Looks an die gerade gebauten Deko-Teile haengen
-- (MapConfig.BUILDING_LOOK_FX / FX_PRESETS). Fehlt ein Teil, wird der Effekt
-- still uebersprungen — der Test honey_pond.test.lua faengt das vorher ab.
function PlotBuilder.addLookEffects(body: BasePart, buildingId: string, look: number)
	for _, fx in MapConfig.getLookFx(buildingId, look) do
		local target = body:FindFirstChild(fx.piece)
		local preset = MapConfig.FX_PRESETS[fx.preset]
		if target and target:IsA("BasePart") and preset then
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name          = "Fx_" .. fx.preset
			emitter.Texture       = preset.texture
			emitter.Color         = ColorSequence.new(preset.color)
			emitter.Size          = NumberSequence.new(preset.size[1], preset.size[2])
			emitter.Transparency  = NumberSequence.new(preset.transparency[1], preset.transparency[2])
			emitter.Lifetime      = NumberRange.new(preset.lifetime[1], preset.lifetime[2])
			emitter.Rate          = preset.rate
			emitter.Speed         = NumberRange.new(preset.speed[1], preset.speed[2])
			emitter.SpreadAngle   = Vector2.new(preset.spread, preset.spread)
			emitter.Acceleration  = preset.acceleration
			emitter.EmissionDirection = (Enum.NormalId :: any)[preset.emitFrom]
			emitter.LightEmission = preset.lightEmission
			emitter.Parent        = target
		end
	end
end

function PlotBuilder.buildBuilding(plotModel: Model, slot: number, buildingData: Types.Building, pool: number)
	local config = MapConfig.BUILDING_OFFSETS[buildingData.id]
	if not config then return end

	local plotCFrame = MapParts.plotCFrame(slot)
	local localY = MapParts.plotSurfaceOffset() + config.offset.Y + config.size.Y * 0.5

	local part = MapParts.newPart(
		buildingData.id,
		config.size,
		plotCFrame * CFrame.new(config.offset.X, localY, config.offset.Z),
		config.color,
		Enum.Material.SmoothPlastic
	)
	part.Transparency = 1
	part.CanCollide   = false
	part.Parent       = plotModel

	-- Ursprung von Deko UND Honig-Tropfen: Mitte der Grundflaeche des Gebaeudes
	-- auf Plot-Hoehe.
	local ground = plotCFrame * CFrame.new(
		config.offset.X,
		MapParts.plotSurfaceOffset() + config.offset.Y,
		config.offset.Z
	)

	-- v15: Grund-Deko plus die Zusaetze des aktuellen Looks.
	local look  = BuildingBehavior.getLook(buildingData.level)
	local decor = MapConfig.getBuildingDecor(buildingData.id, look)
	MapParts.buildDecor(part, ground, decor)
	PlotBuilder.addLookEffects(part, buildingData.id, look)

	PlotBuilder.buildHoneyDots(part, ground,
		math.min(BuildingBehavior.getMaxCapacity(buildingData.id), MapConfig.HONEY_DOT_MAX))

	-- Level als Attribut: der Client kann es direkt auslesen ohne eigenes Remote
	part:SetAttribute("BuildingLevel", buildingData.level)
	part:SetAttribute("Look", look)

	-- Schild ueber dem Gebaeude: Name, Level und Honig-Lagerstand. Ohne das
	-- muesste man fuer die Frage "ist schon wieder Honig da?" jedes Mal ein
	-- Panel oeffnen.
	--
	-- Die Hoehe richtet sich nach dem hoechsten Deko-Teil, nicht nach der
	-- Koerpergroesse: sonst haengt das Schild nach jeder Formaenderung falsch.
	-- StudsOffset zaehlt ab der MITTE der Part, deshalb die Halbierung.
	local topOfDecor = math.max(MapParts.decorHeight(decor), config.size.Y)

	-- Sammel-Update 2.6 ("UI von Honig-Sumpf weg"): der Honig-Teich bekommt
	-- kein Schild — der Baerchi isst dort von selbst (Autopilot), Text und
	-- Zahlen braucht dort niemand. writeBuildingState kommt ohne Schild aus.
	if buildingData.id == "HoneyPond" then
		PlotBuilder.writeBuildingState(part, buildingData, pool)
		return
	end

	local sign = Instance.new("BillboardGui")
	sign.Name         = "Sign"
	sign.Size         = UDim2.fromScale(9, 2.6)
	sign.StudsOffset  = Vector3.new(0, topOfDecor - config.size.Y * 0.5 + 2, 0)
	sign.AlwaysOnTop  = false
	sign.MaxDistance  = MapConfig.BUILDING_SIGN_DISTANCE
	sign.Adornee      = part
	sign.Parent       = part

	MapParts.newTextLabel("Title", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0))
	MapParts.newTextLabel("Stock", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0.5))

	PlotBuilder.writeBuildingState(part, buildingData, pool)
end

return PlotBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">RecyclerBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- RecyclerBuilder.luau
-- ServerScriptService/Util/MapBuild/RecyclerBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Den Waben-Recycler auf dem Plot bauen und sein Schild/seine Lampe
--     beschriften.
--
-- Wie ein Gebaeude (siehe PlotBuilder.buildBuilding): ein unsichtbarer Koerper,
-- der Name, Attribute und Schild traegt, plus die deklarative Deko aus
-- CombConfig.RECYCLER_DECOR und (v15) den Zusaetzen seines Looks
-- (CombConfig.getDecor). Der Look steht als Attribut "Look" am Koerper. Der Koerper heisst "Recycler"; der Client
-- (CombController) haengt daran den Ausbau-Prompt, aber nur am eigenen Plot.
--
-- Teil von MapService: nur MapService benutzt dieses Modul. Es aendert keine
-- Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local MapConfig  = require(ReplicatedStorage.Config.MapConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types      = require(ReplicatedStorage.Network.Types)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local WorldText = require(ReplicatedStorage.Localization.WorldText)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local RecyclerBuilder = {}

-- Die Insel-Wiese liegt auf PLATFORM_TOP_Y, also auf dem Plot-Ursprung — NICHT
-- auf der Beet-Hoehe (die ist PLOT_SIZE.Y darueber). Der Recycler steht auf dem
-- Gras vor dem Beet, deshalb Boden = Ursprung plus die Karo-Hoehe, damit nichts
-- in den hellen Feldern versinkt.
local function groundOffset(): number
	return MapConfig.GRASS_HEIGHT
end

-- Schreibt Level, Warteschlange und Lampe. Billig; laeuft bei jeder Aenderung
-- der Warteschlange (einmal pro Sekunde, solange gearbeitet wird).
function RecyclerBuilder.writeState(body: BasePart, recycler: Types.RecyclerData)
	-- Attribute: der Client rechnet daraus Prompt-Text und Kosten selbst.
	body:SetAttribute("RecyclerLevel", recycler.level)
	body:SetAttribute("RecyclerQueued", recycler.queued)

	local lamp = body:FindFirstChild("Lampe")
	if lamp and lamp:IsA("BasePart") then
		lamp.Color = if recycler.queued > 0 then CombConfig.LAMP_ACTIVE_COLOR else CombConfig.LAMP_IDLE_COLOR
	end

	local sign = body:FindFirstChild("Sign")
	if not sign or not sign:IsA("BillboardGui") then return end

	local title = sign:FindFirstChild("Title")
	if title and title:IsA("TextLabel") then
		WorldText.set(title, Loc.msg("ui.world.sign_level", {
			name = Loc.msg("ui.recycler.name"), level = recycler.level,
		}))
	end

	local stock = sign:FindFirstChild("Stock")
	if stock and stock:IsA("TextLabel") then
		if recycler.queued > 0 then
			stock.Text = string.format("⬡ %d", recycler.queued)   -- sprachneutral (2.4)
			stock.TextColor3 = CombConfig.LAMP_ACTIVE_COLOR
		else
			-- Sammel-Update 3.6: sprachneutral "⬡ = 12 G" (eine Wabe bringt so viel)
			stock.Text = string.format("⬡ = %d G", CombConfig.getPayPerUnit(recycler.level))
			stock.TextColor3 = Color3.fromRGB(235, 235, 235)
		end
	end
end

-- Baut den Recycler in das Plot-Model.
function RecyclerBuilder.build(plotModel: Model, slot: number, recycler: Types.RecyclerData)
	local plotCFrame = MapParts.plotCFrame(slot)
	local offset = CombConfig.RECYCLER_OFFSET
	local size   = CombConfig.RECYCLER_BODY_SIZE

	local ground = plotCFrame * CFrame.new(offset.X, groundOffset() + offset.Y, offset.Z)

	local body = MapParts.newPart(
		CombConfig.RECYCLER_NAME,
		size,
		ground * CFrame.new(0, size.Y * 0.5, 0),
		Color3.fromRGB(84, 178, 96),
		Enum.Material.SmoothPlastic
	)
	body.Transparency = 1
	body.CanCollide   = false
	body.Parent       = plotModel

	local look  = BuildingBehavior.getLook(recycler.level)
	local decor = CombConfig.getDecor(look)
	MapParts.buildDecor(body, ground, decor)
	body:SetAttribute("Look", look)

	-- Schild ueber dem Trichter, auf die Hoehe der hoechsten Deko gesetzt (wie
	-- bei den Gebaeuden: so haengt es nach einer Formaenderung nicht falsch).
	local top = math.max(MapParts.decorHeight(decor), size.Y)

	local sign = Instance.new("BillboardGui")
	sign.Name        = "Sign"
	sign.Size        = UDim2.fromScale(9, 2.6)
	sign.StudsOffset = Vector3.new(0, top - size.Y * 0.5 + 2, 0)
	sign.AlwaysOnTop = false
	sign.MaxDistance = MapConfig.BUILDING_SIGN_DISTANCE
	sign.Adornee     = body
	sign.Parent      = body

	MapParts.newTextLabel("Title", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0))
	MapParts.newTextLabel("Stock", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0.5))

	RecyclerBuilder.writeState(body, recycler)
end

return RecyclerBuilder
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="Folder" referent="RBX59"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX32"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">IncubatorController</string><ProtectedString name="Source"><![CDATA[--!strict
-- IncubatorController.luau
-- StarterPlayerScripts/Controllers/IncubatorController.luau
--
-- Einzige Zustaendigkeit:
--   - Den Inkubator auf dem EIGENEN Plot lebendig machen (Sammel-Update
--     05.10., Paket 8): Prompt "Inkubator" am Sockel, ueber jeder belegten
--     Kuppel ein Fortschrittsbalken mit Restzeit, Leuchten kurz vor dem
--     Schluepfen und solange das Ei fertig ist.
--
-- Rein clientseitig aus den Attributen der Kuppeln (StartedAt/FinishAt, siehe
-- IncubatorBuilder) — dasselbe Zeitmarken-Prinzip wie EggTimerController:
-- kein Server-Takt pro Ei, kein zusaetzliches Remote. "Jetzt" ist
-- workspace:GetServerTimeNow() (die Marken sind os.time() des Servers).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local Loc             = require(ReplicatedStorage.Localization.Loc)
local Names = require(game:GetService("ReplicatedStorage").Localization.Names)
local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)
local IncubatorConfig = require(ReplicatedStorage.Config.IncubatorConfig)

local PanelManager = require(script.Parent.Parent.UI.PanelManager)
local ClientState  = require(script.Parent.ClientState)
local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local EggCalculator = require(ReplicatedStorage.Modules.EggCalculator)

local IncubatorController = {}

local OWNER_ATTRIBUTE = "PlotOwner"
local TICK_SECONDS    = 0.5
local BAR_COLOR       = Color3.fromRGB(120, 230, 140)
local READY_COLOR     = Color3.fromRGB(255, 220, 90)

type DomeView = { dome: BasePart, gui: BillboardGui, fill: Frame, text: TextLabel, light: PointLight }
local _views: { [BasePart]: DomeView } = {}

local function isOwnPlot(instance: Instance): boolean
	local current: Instance? = instance
	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner == Players.LocalPlayer.UserId
		end
		current = current.Parent
	end
	return false
end

local function attachView(dome: BasePart)
	if _views[dome] then return end

	local gui = Instance.new("BillboardGui")
	gui.Name        = "IncubatorProgress"
	gui.Size        = UDim2.fromScale(4.4, 1.2)
	gui.StudsOffset = Vector3.new(0, dome.Size.Y * 0.5 + 1.0, 0)
	gui.MaxDistance = IncubatorConfig.LOOK.signDistance
	gui.AlwaysOnTop = false
	gui.Adornee     = dome
	gui.Enabled     = false
	gui.Parent      = dome

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Size = UDim2.fromScale(1, 0.38)
	track.Position = UDim2.fromScale(0, 0.62)
	track.BackgroundColor3 = Color3.fromRGB(30, 26, 46)
	track.BorderSizePixel = 0
	track.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = track

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = BAR_COLOR
	fill.BorderSizePixel = 0
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = fill

	local text = Instance.new("TextLabel")
	text.Name = "Time"
	text.Size = UDim2.fromScale(1, 0.6)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0.2
	text.Text = ""
	text.Parent = gui

	local light = Instance.new("PointLight")
	light.Name = "ReadyGlow"
	light.Color = READY_COLOR
	light.Range = 9
	light.Brightness = 0
	light.Parent = dome

	_views[dome] = { dome = dome, gui = gui, fill = fill, text = text, light = light }
end

local function update(view: DomeView, now: number)
	local dome = view.dome
	local eggType = dome:GetAttribute("EggType")
	local startedAt = dome:GetAttribute("StartedAt")
	local finishAt = dome:GetAttribute("FinishAt")
	if typeof(eggType) ~= "string" or eggType == "" or typeof(startedAt) ~= "number" or typeof(finishAt) ~= "number" then
		view.gui.Enabled = false
		view.light.Brightness = 0
		return
	end

	view.gui.Enabled = true
	local total = math.max(1, finishAt - startedAt)
	local left = math.max(0, finishAt - now)
	local share = math.clamp(1 - left / total, 0, 1)
	view.fill.Size = UDim2.fromScale(share, 1)
	if left <= 0 then
		view.text.Text = "✔ " .. Loc.t("ui.incubator.ready")
		view.fill.BackgroundColor3 = READY_COLOR
		-- Fertig: pulsierendes Leuchten, damit man es vom anderen Ende des Plots sieht
		view.light.Brightness = 1.5 + math.sin(os.clock() * 4) * 0.8
	else
		view.text.Text = Loc.formatDuration(math.ceil(left))
		view.fill.BackgroundColor3 = BAR_COLOR
		view.light.Brightness = if left <= IncubatorConfig.GLOW_LAST_SECONDS then 1 else 0
	end
end

--------------------------------------------------------------------------------
-- INCUBATOR_BREED: Schild ueber einem Platz mit Baerchi
--------------------------------------------------------------------------------
-- Wunsch Projektinhaber 05.10.: "Der Baerchi zeigt im Inkubator an, mit
-- welcher Wahrscheinlichkeit welches Ei gebruetet wird." Name, die Chancen
-- (nach EggTree.resolveLaid zusammengefasst — gesperrte Eier rutschen auf den
-- freien Vorgaenger, genau wie beim Server) und die Zeit bis zum naechsten Ei.

local BREED_MAX_LINES = 4

type BreedView = { dome: BasePart, gui: BillboardGui, title: TextLabel, odds: TextLabel, timer: TextLabel, key: string }
local _breedViews: { [BasePart]: BreedView } = {}

local function breedLabel(parent: Instance, name: string, y: number, h: number, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Position = UDim2.fromScale(0, y)
	label.Size = UDim2.fromScale(1, h)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Text = ""
	label.Parent = parent
	return label
end

local function attachBreedView(dome: BasePart)
	if _breedViews[dome] then return end
	local gui = Instance.new("BillboardGui")
	gui.Name        = "BreederInfo"
	gui.Size        = UDim2.fromScale(7, 5)
	gui.StudsOffset = Vector3.new(0, dome.Size.Y * 0.5 + 3.2, 0)
	gui.MaxDistance = IncubatorConfig.LOOK.signDistance
	gui.AlwaysOnTop = false
	gui.Adornee     = dome
	gui.Enabled     = false
	gui.Parent      = dome

	local title = breedLabel(gui, "Title", 0, 0.24, Color3.new(1, 1, 1))
	local odds = breedLabel(gui, "Odds", 0.25, 0.55, Color3.fromRGB(255, 240, 200))
	odds.TextYAlignment = Enum.TextYAlignment.Top
	local timer = breedLabel(gui, "Timer", 0.82, 0.18, BAR_COLOR)
	_breedViews[dome] = { dome = dome, gui = gui, title = title, odds = odds, timer = timer, key = "" }
end

local function eggName(eggType: string): string
	local def = EggConfig.data[eggType :: any]
	return Names.egg(eggType)
end

-- Chancen dieses Baerchis, nach dem tatsaechlich gebrueteten Ei zusammengefasst.
local function oddsText(baerchi: any, eggTree: any): string
	local list = EggCalculator.getResolvedChances(baerchi, eggTree)
	local lines: { string } = {}
	for i, entry in list do
		if i > BREED_MAX_LINES then break end
		local percent = if entry.percent >= 10 then string.format("%d", math.floor(entry.percent + 0.5))
			else Loc.formatDecimal(entry.percent, 1)
		table.insert(lines, string.format("%s  %s%%", eggName(entry.eggType), percent))
	end
	return table.concat(lines, "\n")
end

local function updateBreed(view: BreedView, now: number)
	local dome = view.dome
	local uid = dome:GetAttribute("BreederUid")
	local data = ClientState.get()
	local baerchi = if typeof(uid) == "string" and uid ~= "" and data then data.island.baerchis[uid] else nil
	if not baerchi or not data then
		view.gui.Enabled = false
		view.key = ""
		return
	end
	view.gui.Enabled = true

	-- Name und Chancen nur neu schreiben, wenn sich etwas daran aendert
	local unlockedCount = 0
	if data.eggTree then
		for _ in data.eggTree.unlocked do unlockedCount += 1 end
	end
	local key = table.concat({ uid :: string, baerchi.configId, tostring(baerchi.mutation), Loc.getLanguage(),
		tostring(unlockedCount) }, "|")
	if key ~= view.key then
		view.key = key
		local def = BaerchiConfig.getById(baerchi.configId)
		local name = Names.baerchi(baerchi.configId)
		view.title.Text = string.format("%s · %s", name, Loc.name("rarity." .. baerchi.rarity, baerchi.rarity))
		view.title.TextColor3 = BaerchiConfig.getRarityColor(baerchi.rarity)
		view.odds.Text = oddsText(baerchi, data.eggTree)
	end

	local unlocked = dome:GetAttribute("Unlocked")
	if unlocked == false then
		view.timer.Text = "🔒"
		return
	end
	local lying = 0
	for _, egg in data.island.laidEggs do
		if (egg :: any).fromIncubator then lying += 1 end
	end
	if lying >= IncubatorConfig.BREED_MAX_LYING then
		view.timer.Text = "🥚 " .. Loc.t("ui.incubator.breed_full")
		view.timer.TextColor3 = READY_COLOR
		return
	end
	local last = dome:GetAttribute("LastEggAt")
	local seconds = dome:GetAttribute("BreedSeconds")
	if typeof(last) == "number" and typeof(seconds) == "number" and seconds > 0 then
		local left = math.max(0, last + seconds - now)
		view.timer.Text = "🥚 " .. Loc.formatDuration(math.ceil(left))
		view.timer.TextColor3 = BAR_COLOR
	end
end

-- INCUBATOR_BREED: "Baerchi einsetzen" statt "Oeffnen"
local function actionKey(): string
	return if FeatureFlags.isOn("INCUBATOR_BREED") then "ui.incubator.prompt_breed" else "ui.incubator.prompt_action"
end

local function attachPrompt(base: BasePart)
	if base:FindFirstChild("IncubatorPrompt") then return end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "IncubatorPrompt"
	prompt.ActionText = Loc.t(actionKey())
	prompt.ObjectText = Loc.t("ui.incubator.title")
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	prompt.Triggered:Connect(function()
		PanelManager.open("Incubator")
	end)
	Loc.onChanged(function()
		prompt.ActionText = Loc.t(actionKey())
		prompt.ObjectText = Loc.t("ui.incubator.title")
	end)
end

local function hook(instance: Instance)
	if not instance:IsA("BasePart") then return end
	local model = instance.Parent
	if not model or model.Name ~= IncubatorConfig.MODEL_NAME then return end
	if not isOwnPlot(model) then return end
	if instance.Name == "Base" then
		attachPrompt(instance)
	elseif string.match(instance.Name, "^Dome_%d+$") then
		attachView(instance)
		if FeatureFlags.isOn("INCUBATOR_BREED") then
			attachBreedView(instance)
		end
	end
end

function IncubatorController.init()
	if not FeatureFlags.isOn("INCUBATOR") then return end

	for _, descendant in Workspace:GetDescendants() do
		hook(descendant)
	end
	Workspace.DescendantAdded:Connect(function(instance)
		-- Die Attribute (PlotOwner) haengen am Plot; die Teile kommen dazu.
		task.defer(hook, instance)
	end)

	task.spawn(function()
		while true do
			task.wait(TICK_SECONDS)
			local now = Workspace:GetServerTimeNow()
			for dome, view in _views do
				if dome.Parent == nil then
					_views[dome] = nil
				else
					update(view, now)
				end
			end
			for dome, view in _breedViews do
				if dome.Parent == nil then
					_breedViews[dome] = nil
				else
					local ok, err = pcall(updateBreed, view, now)
					if not ok then warn("[IncubatorController] Brut-Schild:", err) end
				end
			end
		end
	end)
end

return IncubatorController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">WorldController</string><ProtectedString name="Source"><![CDATA[--!strict
-- WorldController.luau
-- StarterPlayerScripts/Controllers/WorldController.luau
--
-- Einzige Zustaendigkeit:
--   - Klicks und Naeherungs-Prompts an Objekten in der Welt in UI-Aktionen
--     uebersetzen
--
-- Es gibt drei Anker in der Welt:
--   1. Baerchi-Figuren (Attribut "BaerchiUid" an Koerper und Kopf)
--      → Detailkarte, ueber einen ClickDetector den der Server schon mitbaut
--   2. Gebaeude-Parts (Name = BuildingId, Attribute "BuildingLevel"/"HoneyPool")
--      → ein hier erzeugter ProximityPrompt (E) oeffnet das Gebaeude-Panel
--   3. Die Kampf-Plattform ("FightFloor" im Model "PitPlatform")
--      → v15: Tower-Wahl (CombatPanel), ueber einen hier erzeugten ProximityPrompt
--   4. v15: FREMDE Spieler (Charakter) und fremde Plot-Schilder
--      → Profilkarte (Inspektor, ProfilePanel), per Klick
--
-- Gelegte Eier sind ABSICHTLICH kein vierter Anker mehr: sie werden nicht
-- mehr angeklickt, sondern serverseitig per Touched eingesammelt, sobald die
-- eigene Spielfigur hindurchlaeuft (siehe MapService.buildLaidEgg). Dieser
-- Controller muss sie deshalb nicht mehr kennen — es gibt am Ei keinen
-- ClickDetector mehr, an den er sich haengen koennte.
--
-- Das Fuettern selbst ist seit dem Equip-/Honig-Teich-System keine manuelle
-- Aktion mehr: der ausgeruestete Baerchi laeuft von alleine zum Teich auf dem
-- Plot, sobald er Honig braucht (siehe BaerchiAutopilotService). Den
-- frueheren "Honig fuettern (E)"-Prompt am Gebaeude gibt es deshalb nicht
-- mehr — er waere jetzt ohnehin nur noch fuer den einen sichtbaren Baerchi
-- relevant gewesen.
--
-- Die Prompts entstehen bewusst auf dem Client: der Server braucht sie nicht
-- zu kennen, weil sie nur ein lokales Fenster oeffnen.
--
-- Besitzer-Pruefung: MapService schreibt das Attribut "PlotOwner" (UserId) an
-- jedes Plot-Model. Prompts entstehen nur am EIGENEN Plot. Vorher erschienen
-- sie auch an fremden Gebaeuden — ungefaehrlich, weil RequestUpgradeBuilding
-- und RequestStartCombat kein Insel-Argument haben und der Server immer auf
-- den Daten des anfragenden Spielers arbeitet, aber irrefuehrend: man haette
-- am Nachbar-Gebaeude sein eigenes ausgebaut.
--
-- Die Zuordnung der Baerchis laeuft ueber das Attribut "BaerchiUid", das
-- MapService an die Koerper-Part schreibt. Der Client braucht dafuer kein
-- eigenes Remote: er hat die vollstaendigen Baerchi-Daten bereits ueber
-- PlayerDataUpdated.
--
-- Ausserdem markiert dieser Controller den EIGENEN Plot mit einem Wegweiser
-- ueber dem Schild. Das gehoert bewusst hierher und nicht zu MapService: der
-- Server baut fuer alle dasselbe, aber "dein Plot" ist fuer jeden ein anderer.
-- Serverseitig muesste man dafuer acht verschiedene Schilder bauen — hier ist
-- es ein einziges Element, das nur der Besitzer sieht.

local Players   = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Loc          = require(ReplicatedStorage.Localization.Loc)
local Remotes      = require(ReplicatedStorage.Network.Remotes)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)

local Theme        = require(script.Parent.Parent.UI.Theme)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local BaerchiPanel = require(script.Parent.Parent.UI.BaerchiPanel)
local PanelManager = require(script.Parent.Parent.UI.PanelManager)

local WorldController = {}

local UID_ATTRIBUTE   = "BaerchiUid"
local LEVEL_ATTRIBUTE = "BuildingLevel"
local OWNER_ATTRIBUTE = "PlotOwner"
local PROMPT_DISTANCE = 14

-- v15 Inspektor: Klick auf fremde Spieler oder fremde Plot-Schilder oeffnet
-- die Profilkarte. Der ClickDetector entsteht nur lokal und heisst "Inspect",
-- damit hookClickable ihn nicht fuer eine Baerchi-Figur haelt.
local INSPECT_NAME     = "Inspect"
local INSPECT_DISTANCE = 60

-- Wegweiser auf den eigenen Plot. Die Plattform ist 480 Studs breit und
-- ueberall gleich gruen; ohne diese Marke sucht man beim ersten Join acht
-- Schilder ab, um das eigene zu finden. Reichweite deshalb so gross, dass sie
-- vom Spawn in der Mitte aus zu sehen ist (Plot-Ring: 165 Studs).
local HOME_MARKER_NAME     = "DeinPlot"
local HOME_MARKER_DISTANCE = 260
local HOME_MARKER_HEIGHT   = 7

-- Gebaeude-Part-Namen wie MapService sie vergibt (= Types.BuildingId)
local BUILDING_NAMES: { [string]: boolean } = {
	Beehive      = true,
	HoneyRefiner = true,
	HoneyPond    = true,
}

-- Bereits verbundene ClickDetectors, damit nichts doppelt haengt
local _connected: { [ClickDetector]: boolean } = {}

--------------------------------------------------------------------------------
-- Baerchi-Figuren
--------------------------------------------------------------------------------

-- Ein ClickDetector in der Welt gehoert einer Baerchi-Figur — Eier haben seit
-- dem Umstieg auf Beruehren-zum-Einsammeln keinen ClickDetector mehr (siehe
-- Kommentar-Kopf).
local function findTarget(detector: ClickDetector): string?
	local part = detector.Parent
	if not part then return nil end

	local baerchiUid = part:GetAttribute(UID_ATTRIBUTE)
	if typeof(baerchiUid) == "string" then
		return baerchiUid
	end

	return nil
end

local function tryHook(detector: ClickDetector): boolean
	if _connected[detector] then return true end

	if findTarget(detector) == nil then return false end

	_connected[detector] = true

	detector.MouseClick:Connect(function()
		-- Beim Klick NEU nachschlagen statt den Wert von oben zu benutzen: die
		-- Part kann inzwischen eine andere uid tragen (Figuren werden bei jedem
		-- Plot-Neuaufbau ersetzt).
		local current = findTarget(detector)
		if not current then return end

		BaerchiPanel.show(current)
	end)

	detector.Destroying:Connect(function()
		_connected[detector] = nil
	end)

	return true
end

local function hookClickable(instance: Instance)
	if not instance:IsA("ClickDetector") then return end
	if instance.Name == INSPECT_NAME then return end
	if tryHook(instance) then return end

	-- Replikation ist nicht sortiert: der ClickDetector kann beim Client
	-- ankommen bevor das Attribut seiner Part da ist. Deshalb einmal im
	-- naechsten Frame erneut versuchen und sonst auf eines der beiden Attribute
	-- warten — welches kommt, weiss man vorher nicht.
	task.defer(function()
		if tryHook(instance) then return end

		local part = instance.Parent
		if not part then return end

		local connection: RBXScriptConnection? = nil
		connection = part:GetAttributeChangedSignal(UID_ATTRIBUTE):Connect(function()
			if tryHook(instance) and connection then
				connection:Disconnect()
			end
		end)
	end)
end

--------------------------------------------------------------------------------
-- Gebaeude und Kampfplattform
--------------------------------------------------------------------------------

-- Beschriftung eines Prompts: liefert (ActionText, ObjectText) in der
-- aktiven Sprache. Als Funktion statt fertiger Texte, damit ein Sprachwechsel
-- alle Prompts neu beschriften kann (siehe Loc.onChanged in init).
type PromptLabels = () -> (string, string)

-- Weak: ein ersetzter Plot nimmt seine Prompts mit, ohne dass sie hier haengen bleiben.
local _promptLabels: { [ProximityPrompt]: PromptLabels } = setmetatable({}, { __mode = "k" }) :: any

local function applyPromptLabels(prompt: ProximityPrompt, labels: PromptLabels)
	local action, object = labels()
	prompt.ActionText = action
	prompt.ObjectText = object
end

-- Ein Prompt an einer Part. `name` dient als Schutz gegen doppeltes Anhaengen:
-- die Parts werden bei jedem Plot-Neuaufbau ersetzt, und ein zweiter Prompt
-- waere ein doppeltes Fenster.
local function addPrompt(
	part: BasePart,
	name: string,
	labels: PromptLabels,
	keyCode: Enum.KeyCode,
	onTriggered: () -> ()
): ProximityPrompt?
	if part:FindFirstChild(name) then return nil end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = name
	applyPromptLabels(prompt, labels)
	_promptLabels[prompt] = labels
	prompt.KeyboardKeyCode       = keyCode
	prompt.MaxActivationDistance = PROMPT_DISTANCE
	prompt.RequiresLineOfSight   = false
	prompt.Parent                = part

	prompt.Triggered:Connect(onTriggered)
	return prompt
end

local function addPanelPrompt(part: BasePart, labels: PromptLabels, panelName: string)
	addPrompt(part, "OpenPanel", labels, Enum.KeyCode.E, function()
		PanelManager.open(panelName)
	end)
end

--------------------------------------------------------------------------------
-- HUD_ROW_V2: Honig-Brunnen ohne Fenster
--------------------------------------------------------------------------------
-- Wunsch Projektinhaber 05.10.: Am Brunnen ploppt nichts mehr auf. E (kurz
-- halten) baut direkt aus, und ueber dem Brunnen steht nur ein Schild mit
-- Level und Preis des naechsten Ausbaus. Verbessern geht nur noch vor Ort
-- (keine Kachel mehr). Der Server prueft wie immer selbst (IslandService).

local POND_SIGN_NAME   = "PondLevelSign"
local POND_PROMPT_HOLD = 0.4
local POND_SIGN_HEIGHT = 9
local POND_SIGN_DISTANCE = 90

type PondView = { part: BasePart, prompt: ProximityPrompt, level: TextLabel, cost: TextLabel, lastLevel: number }
local _ponds: { PondView } = {}

local function pondState(buildingId: string): (number, any?)
	local data = ClientState.get()
	local building = if data then data.island.buildings[buildingId :: any] else nil
	local level = if building then building.level else 1
	return level, BuildingBehavior.getUpgrade(buildingId :: any, level + 1)
end

local function costText(cost: any): string
	local gummies = Theme.formatNumber(cost.costGummies or 0)
	local gold = cost.costGoldGummies or 0
	return if gold > 0
		then Loc.t("ui.recycler.cost_gg", { gummies = gummies, gold = gold })
		else Loc.t("ui.recycler.cost_g", { gummies = gummies })
end

local function writePond(view: PondView)
	local buildingId = view.part.Name
	local level, cost = pondState(buildingId)
	view.level.Text = "Lv. " .. level
	local data = ClientState.get()
	if cost then
		local affordable = data ~= nil and data.gummies >= (cost.costGummies or 0)
			and data.goldGummies >= (cost.costGoldGummies or 0)
		view.cost.Text = "⬆ " .. costText(cost)
		view.cost.TextColor3 = if affordable then Theme.COLORS.good else Theme.COLORS.text
		view.prompt.ActionText = Loc.t("ui.building.prompt_upgrade")
		view.prompt.Enabled = true
	else
		view.cost.Text = Loc.t("ui.recycler.maxed")
		view.cost.TextColor3 = Theme.COLORS.goldGummy
		view.prompt.Enabled = false
	end
	view.prompt.ObjectText = Loc.name("building." .. buildingId .. ".name", buildingId) .. "  Lv." .. level

	-- Kleiner Huepfer am Schild, wenn das Level steigt (statt eines Fensters)
	if level > view.lastLevel and view.lastLevel > 0 then
		local gui = view.level.Parent
		if gui and gui:IsA("BillboardGui") then
			local base = gui.Size
			gui.Size = UDim2.new(base.X.Scale * 1.25, 0, base.Y.Scale * 1.25, 0)
			task.delay(0.25, function()
				if gui.Parent then gui.Size = base end
			end)
		end
	end
	view.lastLevel = level
end

local function attachPond(part: BasePart)
	if part:FindFirstChild(POND_SIGN_NAME) then return end

	local gui = Instance.new("BillboardGui")
	gui.Name        = POND_SIGN_NAME
	gui.Size        = UDim2.fromScale(12, 4)
	gui.StudsOffset = Vector3.new(0, POND_SIGN_HEIGHT, 0)
	gui.MaxDistance = POND_SIGN_DISTANCE
	gui.AlwaysOnTop = false
	gui.Adornee     = part
	gui.Parent      = part

	local level = Instance.new("TextLabel")
	level.Name                   = "Level"
	level.Size                   = UDim2.fromScale(1, 0.58)
	level.BackgroundTransparency = 1
	level.Font                   = Theme.FONT
	level.TextScaled             = true
	level.TextColor3             = Theme.COLORS.goldGummy
	level.TextStrokeTransparency = 0.1
	level.Parent                 = gui

	local cost = Instance.new("TextLabel")
	cost.Name                   = "Cost"
	cost.Position               = UDim2.fromScale(0, 0.6)
	cost.Size                   = UDim2.fromScale(1, 0.4)
	cost.BackgroundTransparency = 1
	cost.Font                   = Theme.FONT
	cost.TextScaled             = true
	cost.TextStrokeTransparency = 0.1
	cost.Parent                 = gui

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = "OpenPanel"   -- gleicher Name: kein zweiter Prompt
	prompt.KeyboardKeyCode       = Enum.KeyCode.E
	prompt.HoldDuration          = POND_PROMPT_HOLD
	prompt.MaxActivationDistance = PROMPT_DISTANCE
	prompt.RequiresLineOfSight   = false
	prompt.Parent                = part
	local buildingId = part.Name
	prompt.Triggered:Connect(function()
		Remotes.RequestUpgradeBuilding:FireServer(buildingId)
	end)

	local view: PondView = { part = part, prompt = prompt, level = level, cost = cost, lastLevel = 0 }
	table.insert(_ponds, view)
	part.Destroying:Connect(function()
		local index = table.find(_ponds, view)
		if index then table.remove(_ponds, index) end
	end)
	writePond(view)
end

local function refreshPonds()
	for _, view in _ponds do
		writePond(view)
	end
end

local function usesPondSign(buildingId: string): boolean
	return FeatureFlags.isOn("HUD_ROW_V2") and buildingId == "HoneyPond"
end

--------------------------------------------------------------------------------
-- Wem gehoert der Plot, in dem dieses Teil steckt?
--
-- MapService setzt das Attribut am Plot-Model, nicht an jedem Teil — also
-- nach oben laufen bis es gefunden wird. Teile ausserhalb eines Plots (die
-- Plattform selbst, Blumen) haben keinen Besitzer und liefern nil.
local function findPlotOwner(instance: Instance): number?
	local current: Instance? = instance

	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner
		end
		current = current.Parent
	end

	return nil
end

local function isOwnPlot(instance: Instance): boolean
	return findPlotOwner(instance) == Players.LocalPlayer.UserId
end

-- Der Wegweiser ueber dem eigenen Plot-Schild.
--
-- Rein lokal erzeugt: er landet nie beim Server und damit auch nie bei den
-- anderen sieben Spielern, die ja alle ihren eigenen sehen sollen. Beim
-- Neuaufbau des Plots verschwindet er mit dem Schild und wird von
-- DescendantAdded wieder angelegt — deshalb die Pruefung auf ein bereits
-- vorhandenes Exemplar.
local function addHomeMarker(board: BasePart)
	if board:FindFirstChild(HOME_MARKER_NAME) then return end

	local marker = Instance.new("BillboardGui")
	marker.Name        = HOME_MARKER_NAME
	marker.Size        = UDim2.fromScale(14, 4)
	marker.StudsOffset = Vector3.new(0, HOME_MARKER_HEIGHT, 0)
	marker.MaxDistance = HOME_MARKER_DISTANCE
	-- Durch die Landschaft hindurch sichtbar: genau dafuer ist er da. Vom
	-- Spawn aus liegt zwischen Spieler und Schild sonst der halbe Plot.
	marker.AlwaysOnTop = true
	marker.Adornee     = board
	marker.Parent      = board

	local label = Instance.new("TextLabel")
	label.Name                   = "Text"
	label.Size                   = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font                   = Theme.FONT
	label.TextScaled             = true
	label.Text                   = "\u{25BC} " .. Loc.t("ui.world.your_plot")
	label.TextColor3             = Theme.COLORS.goldGummy
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
	label.Parent                 = marker
end

--------------------------------------------------------------------------------
-- Inspektor (v15)
--------------------------------------------------------------------------------

-- Haengt einen lokalen ClickDetector an `parent` (Part oder Model), der die
-- Profilkarte von `userId` oeffnet. Der Server prueft selbst, ob der Spieler
-- auf diesem Server ist (ProfileService); hier geht es nur ums Oeffnen.
local function addInspector(parent: Instance, userId: number)
	if parent:FindFirstChild(INSPECT_NAME) then return end
	if userId == Players.LocalPlayer.UserId then return end

	local detector = Instance.new("ClickDetector")
	detector.Name                  = INSPECT_NAME
	detector.MaxActivationDistance = INSPECT_DISTANCE
	detector.Parent                = parent

	detector.MouseClick:Connect(function()
		-- Am Schild beim Klick neu nachschlagen: ein Plot kann inzwischen einem
		-- anderen Spieler gehoeren.
		local target = if parent:IsA("BasePart") then (findPlotOwner(parent) or userId) else userId
		if target == Players.LocalPlayer.UserId then return end
		PanelManager.open("Profile", target)
	end)
end

local function hookCharacter(other: Player, character: Model)
	addInspector(character, other.UserId)
end

local function hookPlayer(other: Player)
	if other == Players.LocalPlayer then return end
	if other.Character then
		hookCharacter(other, other.Character)
	end
	other.CharacterAdded:Connect(function(character)
		hookCharacter(other, character)
	end)
end

local function hookOwnedPart(instance: BasePart)
	if instance.Name == "SignBoard" then
		addHomeMarker(instance)
		return
	end

	if instance.Name == "FightFloor" then
		addPanelPrompt(instance, function()
			return Loc.t("ui.tower.prompt_action"), Loc.t("ui.tower.prompt_object")
		end, PanelManager.ARENA_PANEL)
		return
	end

	if not BUILDING_NAMES[instance.Name] then return end

	-- Fuettern passiert nicht mehr hier (siehe Kommentar-Kopf) — es bleibt nur
	-- noch das Ausbauen.
	--
	-- Jedes Gebaeude hat sein EIGENES Menue (siehe BuildingPanel), und der
	-- Prompt oeffnet genau dieses — nicht mehr eine Liste, in der man das
	-- angeklickte Gebaeude erst suchen muss.
	--
	-- Dasselbe Menue haengt auch an der Kachelleiste rechts. Der Prompt hier ist
	-- also nur noch die Abkuerzung fuer den, der ohnehin davorsteht; gehen MUSS
	-- niemand mehr.
	local buildingId = instance.Name

	-- Sammel-Update 2.6: am Honig-Teich gibt es kein Schild und kein
	-- "Honig essen"-Klicken mehr (der Baerchi isst selbst). Der Prompt hier
	-- ist nur noch "Verbessern" — dazu die Gebaeude-Kachel rechts (MenuBar).

	local function attach()
		if usesPondSign(buildingId) then
			attachPond(instance)
			return
		end
		addPrompt(instance, "OpenPanel", Loc.t("ui.building.prompt_upgrade"), Loc.name("building." .. buildingId .. ".name", buildingId), Enum.KeyCode.E, function()
			PanelManager.open(PanelManager.buildingPanelName(buildingId))
		end)
	end

	-- Das Level-Attribut setzt MapService erst NACH dem Einhaengen der Part.
	-- Beim Client kann die Part deshalb kurz ohne Attribut ankommen —
	-- dann einmal warten statt das Gebaeude zu verpassen.
	if instance:GetAttribute(LEVEL_ATTRIBUTE) ~= nil then
		attach()
		return
	end

	local connection: RBXScriptConnection? = nil
	connection = instance:GetAttributeChangedSignal(LEVEL_ATTRIBUTE):Connect(function()
		attach()
		if connection then
			connection:Disconnect()
		end
	end)
end

local function hookWorldPart(instance: Instance)
	if not instance:IsA("BasePart") then return end

	-- Nur die eigenen Gebaeude und das eigene PIT bekommen einen Prompt.
	-- Vorher erschien er an jedem fremden Plot, was schon deshalb verwirrend
	-- war weil der Server die Anfrage ohnehin immer auf die Daten des
	-- ANFRAGENDEN Spielers anwendet — man haette also am Nachbar-Gebaeude
	-- sein eigenes ausgebaut.
	if isOwnPlot(instance) then
		hookOwnedPart(instance)
		return
	end

	-- v15: fremdes Plot-Schild → Profilkarte des Besitzers
	if instance.Name == "SignBoard" then
		local owner = findPlotOwner(instance)
		if owner then
			addInspector(instance, owner)
			return
		end
	end

	-- Besitzer noch unbekannt: das kann passieren wenn das Teil beim Client
	-- ankommt bevor sein Plot-Model komplett da ist. Einmal im naechsten
	-- Frame erneut versuchen, statt den Prompt fuer immer zu verlieren.
	if findPlotOwner(instance) == nil then
		task.defer(function()
			if not instance.Parent then return end
			if isOwnPlot(instance) then
				hookOwnedPart(instance)
			elseif instance.Name == "SignBoard" then
				local owner = findPlotOwner(instance)
				if owner then addInspector(instance, owner) end
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

local function hook(instance: Instance)
	hookClickable(instance)
	hookWorldPart(instance)
end

function WorldController.init()
	-- Sprachwechsel: alle noch lebenden Prompts neu beschriften
	Loc.onChanged(function()
		for prompt, labels in _promptLabels do
			if prompt.Parent then applyPromptLabels(prompt, labels) end
		end
	end)

	-- Was schon da ist
	for _, descendant in Workspace:GetDescendants() do
		hook(descendant)
	end

	-- Und alles was der Server noch nachliefert. Die Figuren werden bei jeder
	-- Bestandsaenderung neu gebaut, also passiert das staendig.
	Workspace.DescendantAdded:Connect(hook)

	-- v15 Inspektor: fremde Spielfiguren anklickbar machen
	for _, other in Players:GetPlayers() do
		hookPlayer(other)
	end
	Players.PlayerAdded:Connect(hookPlayer)

	-- HUD_ROW_V2: Brunnen-Schild mit Level und Preis aktuell halten
	ClientState.onChanged(refreshPonds)
	Loc.onChanged(refreshPonds)

	print("[WorldController] Initialisiert")
end

return WorldController
]]></ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX33"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!strict
-- Main.client.luau
-- StarterPlayerScripts/Main.client.luau
--
-- Bootstrap des Clients — das Gegenstueck zu GameManager auf dem Server.
-- Einzige Stelle die die Startreihenfolge der Client-Module kennt.
--
-- ACHTUNG beim Umbenennen: die Datei darf NICHT "init.client.luau" heissen.
-- Rojo macht aus einem Ordner mit init-Datei ein Script statt eines
-- Containers — auf StarterPlayerScripts angewandt heisst das, dass der
-- gesamte Client-Teilbaum nie im Spiel ankommt. Genau das hat den
-- Server-Sync schon einmal lahmgelegt.
--
-- Reihenfolge:
--   1. ScreenGui anlegen — alle UI-Module haengen sich dort ein.
--   2. Toast zuerst, damit fruehe Fehlermeldungen schon sichtbar sind.
--   3. ClientState VOR den datengetriebenen UIs: die registrieren sich per
--      onChanged und bekommen den aktuellen Stand sofort nachgereicht.
--   4. Die Panels. Jedes meldet sich in seinem init beim PanelManager an —
--      erst danach duerfen Module laufen die Panels oeffnen wollen.
--   5. Hud und MenuBar: beide sind reine Ausloeser und brauchen die
--      angemeldeten Panels (Rebirth-Pille, Menue-Knoepfe).
--   6. ResultFeed — Toast-Meldungen fuer Recycling und Offline-Ertrag.
--      Muss vor dem ersten Serverpaket stehen, sonst geht der Offline-Report
--      des Joins verloren.
--   7. WorldController zuletzt — er braucht Panel und PanelManager.
--   8. EggTimerController — unabhaengig von allen anderen, braucht nur
--      ClientState (schon initialisiert) und die Figuren in der Welt.
--   9. SkillFXController (v14) — hoert nur auf Remotes.SkillFXPlay.
--
-- Davor, ganz am Anfang: LanguageController. Er legt die Sprache fest, bevor
-- irgendein Text gebaut wird (er braucht ClientState erst, wenn es dort
-- Daten gibt — onChanged meldet den aktuellen Stand sofort nach).

local Players = game:GetService("Players")

local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local root = script.Parent

local Controllers = root:WaitForChild("Controllers")
local UI          = root:WaitForChild("UI")

local ClientState        = require(Controllers:WaitForChild("ClientState"))
local LanguageController = require(Controllers:WaitForChild("LanguageController"))
local ResultFeed         = require(Controllers:WaitForChild("ResultFeed"))
local WorldController    = require(Controllers:WaitForChild("WorldController"))
local EggTimerController = require(Controllers:WaitForChild("EggTimerController"))
local SkillFXController  = require(Controllers:WaitForChild("SkillFXController"))
local CombController     = require(Controllers:WaitForChild("CombController"))
local AmbienceController = require(Controllers:WaitForChild("AmbienceController"))
local EventFXController  = require(Controllers:WaitForChild("EventFXController"))
local LaidEggMeshController = require(Controllers:WaitForChild("LaidEggMeshController"))
local UiEventLogger      = require(Controllers:WaitForChild("UiEventLogger"))
local GuideController    = require(Controllers:WaitForChild("GuideController"))
local UpgradeHintController = require(Controllers:WaitForChild("UpgradeHintController"))
local IncubatorController   = require(Controllers:WaitForChild("IncubatorController"))   -- Sammel-Update 8
local AreaSignController    = require(Controllers:WaitForChild("AreaSignController"))    -- Sammel-Update 3.8

local Toast            = require(UI:WaitForChild("Toast"))
local UiScale          = require(UI:WaitForChild("UiScale"))
local ShopPanel        = require(UI:WaitForChild("ShopPanel"))
local Hud              = require(UI:WaitForChild("Hud"))
local MenuBar          = require(UI:WaitForChild("MenuBar"))
local BaerchiPanel     = require(UI:WaitForChild("BaerchiPanel"))
local BaerchiInventory = require(UI:WaitForChild("BaerchiInventory"))
local HatchPanel       = require(UI:WaitForChild("HatchPanel"))
local CombatPanel      = require(UI:WaitForChild("CombatPanel"))
local BuildingPanel    = require(UI:WaitForChild("BuildingPanel"))
local FusionPanel      = require(UI:WaitForChild("FusionPanel"))
local CharmPanel       = require(UI:WaitForChild("CharmPanel"))
local RebirthDialog    = require(UI:WaitForChild("RebirthDialog"))
local LanguagePanel    = require(UI:WaitForChild("LanguagePanel"))
local PetBar           = require(UI:WaitForChild("PetBar"))
local QuestPanel       = require(UI:WaitForChild("QuestPanel"))
local QuestTracker     = require(UI:WaitForChild("QuestTracker"))
local HudRow           = require(UI:WaitForChild("HudRow"))
local EggTreePanel     = require(UI:WaitForChild("EggTreePanel"))
local LeaderboardPanel = require(UI:WaitForChild("LeaderboardPanel"))
local ProfilePanel     = require(UI:WaitForChild("ProfilePanel"))
local DailyBonusPanel  = require(UI:WaitForChild("DailyBonusPanel"))
local Feedback         = require(UI:WaitForChild("Feedback"))
local Moment           = require(UI:WaitForChild("Moment"))
local ReturnSummary    = require(UI:WaitForChild("ReturnSummary"))
local HomeButton       = require(UI:WaitForChild("HomeButton"))
local RebirthButton    = require(UI:WaitForChild("RebirthButton"))   -- Sammel-Update 2.7
local IncubatorPanel   = require(UI:WaitForChild("IncubatorPanel"))  -- Sammel-Update 8
local CurrencyHint     = require(UI:WaitForChild("CurrencyHint"))    -- Sammel-Update 3.4

--------------------------------------------------------------------------------
-- Oberflaeche
--------------------------------------------------------------------------------

local screenGui = Instance.new("ScreenGui")
screenGui.Name             = "RBL"
screenGui.ResetOnSpawn     = false   -- ueberlebt den Tod des Charakters
screenGui.IgnoreGuiInset   = false   -- laesst Platz fuer die Roblox-Topbar
screenGui.ZIndexBehavior   = Enum.ZIndexBehavior.Sibling
screenGui.Parent           = playerGui

-- Playtest 05.10.: auf grossen Monitoren mitwachsen (siehe UI/UiScale)
UiScale.init(screenGui)

--------------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------------

-- Sprache ALLERERSTES: ab hier liefert Loc den Text in der Roblox-Sprache des
-- Spielers. Ohne das haetten Toast und alle Beschriftungen, die beim Aufbau
-- gesetzt werden, einen Moment lang die Standardsprache.
LanguageController.init()

-- Vom Server gebaute Welt-Texte (Tafeln, Schilder, Prompts) in der Sprache
-- dieses Spielers anzeigen (siehe Localization/WorldText)
require(game:GetService("ReplicatedStorage"):WaitForChild("Localization"):WaitForChild("WorldText")).startClient()

Toast.init(screenGui)
ClientState.init()

BaerchiPanel.init(screenGui)
BaerchiInventory.init(screenGui)
HatchPanel.init(screenGui)
CombatPanel.init(screenGui)
BuildingPanel.init(screenGui)
FusionPanel.init(screenGui)
-- Nach BaerchiPanel: die Detailkarte oeffnet dieses Panel ueber den
-- PanelManager, es muss dafuer angemeldet sein. Die Reihenfolge der init-Aufrufe
-- entscheidet das zwar nicht (geoeffnet wird erst per Klick), aber die Liste
-- hier soll den Aufrufweg widerspiegeln.
CharmPanel.init(screenGui)
RebirthDialog.init(screenGui)
LanguagePanel.init(screenGui)
QuestPanel.init(screenGui)
-- v14: Ei-Baum (oeffnet sich aus dem Ei-Menue)
EggTreePanel.init(screenGui)
-- v15: Bestenliste, Spieler-Profil (Inspector) und Login-Bonus. Vor MenuBar,
-- damit die Menue-Kacheln die Panels schon angemeldet vorfinden.
LeaderboardPanel.init(screenGui)
ProfilePanel.init(screenGui)
DailyBonusPanel.init(screenGui)
ShopPanel.init(screenGui)          -- HBB Paket 10 (nur mit SHOP_V1)
IncubatorPanel.init(screenGui)     -- Sammel-Update Paket 8

Hud.init(screenGui)
MenuBar.init(screenGui)

-- HBB Paket 1: fliegende Icons, grosse Momente, Rueckkehr-Karte. Nach Hud
-- und MenuBar (Ziele der Icons), vor ResultFeed (der Offline-Bericht des
-- Joins kommt sonst an, bevor die Karte bereit ist).
Feedback.init(screenGui)
Moment.init(screenGui)
ReturnSummary.init(screenGui)
-- HBB Paket 5: Heim-Knopf (erscheint nur weit weg vom eigenen Plot)
HomeButton.init(screenGui)
RebirthButton.init(screenGui)   -- Sammel-Update 2.7: fester Rebirth-Knopf
CurrencyHint.init(screenGui)    -- Sammel-Update 3.4: Waehrungs-Hinweise

-- v13: Quest-Karte links (braucht das Quest-Fenster, das oben angemeldet wird)
QuestTracker.init(screenGui)
-- HUD_ROW_V2: Zahnrad · Quests · Shop in einer Zeile (versteckt die Quest-Karte)
HudRow.init(screenGui)

-- v12: untere Pet-Leiste (Event / Fight), legt auch den PitResumeDialog an
PetBar.init(screenGui)

ResultFeed.init()
WorldController.init()
EggTimerController.init()
IncubatorController.init()   -- Sammel-Update Paket 8
AreaSignController.init()    -- Sammel-Update Paket 3.8
-- v14: Faehigkeiten-Show im PIT (unabhaengig von allem anderen)
SkillFXController.init()
-- v15: Waben im Event-Pit und Recycler (braucht Toast, ClientState und die Welt)
CombController.init(screenGui)
-- v16: Himmels-Kulisse (Wolken, Schwebeinseln, Pollen, Schaum) nur auf dem Client
AmbienceController.init()
-- v17: lebendige Events (UFO-Patrouille, Abwuerfe, Boss, Telegraphen); braucht Toast
EventFXController.init()
-- v18: Ei-Mesh der gelegten Eier (EditableMesh gibt es nur auf dem Client)
LaidEggMeshController.init()
-- HBB Paket 0: Messpunkte der Oberflaeche (Panel auf/zu, Stillstand)
UiEventLogger.init()
-- HBB Paket 2: Fuehrung ohne Text (braucht MenuBar und PetBar als Anker)
GuideController.init(screenGui)
-- HBB Paket 3: ⬆ ueber bezahlbaren eigenen Gebaeuden
UpgradeHintController.init()

print("[Client] Bereit")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX58"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">BaerchiInventory</string><ProtectedString name="Source"><![CDATA[--!strict
-- BaerchiInventory.luau
-- StarterPlayerScripts/UI/BaerchiInventory.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Baerchis des Spielers als scrollbare Liste zeigen
--   - Die Zwei-Slot-Auswahl fuer die Fusion verwalten
--   - Die zwei Reiter: "Meine Baerchis" (diese Liste) und "Index" (IndexView)
--
-- Die Liste kommt fertig sortiert aus ClientState.getBaerchiList()
-- (Rarity absteigend, dann Level) — hier wird nichts nachsortiert.
--
-- Die Fusions-Auswahl ist der einzige Zustand den dieses Modul selbst haelt.
-- Das ist erlaubt: welche zwei Zeilen gerade markiert sind, ist eine reine
-- Bedien-Information und kein Spielstand — sie steht in keinem Save und der
-- Server erfaehrt davon erst beim Bestaetigen in FusionPanel.
--
-- Neu aufgebaut wird die Liste nur wenn das Panel sichtbar ist. Kommt ein
-- Update waehrend es zu ist, wird nur ein Merker gesetzt und beim naechsten
-- Oeffnen nachgeholt — sonst baut jede Kampfrunde 25 Zeilen neu.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local Names            = require(ReplicatedStorage.Localization.Names)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Unlock       = require(script.Parent.Unlock)   -- HBB Paket 3
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombatRating = require(ReplicatedStorage.Modules.CombatRating)

-- HBB Paket 4: "⚔ 1,2K" statt HP/ATK in der Zeile
local function ratingText(baerchi: Types.Baerchi): string
	local value, suffix = CombatRating.short(CombatRating.of(baerchi))
	local digits = if suffix ~= "" and value < 100 then 1 else 0
	return "⚔ " .. (if digits > 0 then Loc.formatDecimal(value, digits) else Loc.formatNumber(math.floor(value))) .. suffix
end
local IndexView    = require(script.Parent.IndexView)

local BaerchiInventory = {}

local PANEL_NAME  = "Inventory"
local ROW_HEIGHT  = 48
local TOOLBAR_H   = 32
local FOOTER_H    = 64
local TAB_H       = 32

local _root: Frame?               = nil
local _title: TextLabel?          = nil
local _scroller: ScrollingFrame?  = nil
local _empty: TextLabel?          = nil
local _footer: Frame?             = nil
local _slotLabels: { TextLabel }  = {}
local _fuseButton: TextButton?    = nil
local _modeButton: TextButton?    = nil
local _hint: TextLabel?           = nil
local _listPage: Frame?           = nil
local _tabButtons: { [string]: TextButton } = {}
local _tab = "Pets"   -- "Pets" | "Index"

local _fusionMode = false
local _selection: { string } = {}
local _dirty = true

--------------------------------------------------------------------------------
-- Auswahl
--------------------------------------------------------------------------------

local function isSelected(uid: string): boolean
	return table.find(_selection, uid) ~= nil
end

local function toggleSelection(uid: string)
	local index = table.find(_selection, uid)
	if index then
		table.remove(_selection, index)
		return
	end

	-- Sammel-Update 2.8: B muss dieselbe Rarity wie A haben (der Server
	-- lehnt sonst ab, err.fuse_rarity_mismatch). Die Liste zeigt ohnehin nur
	-- passende — das hier ist das Netz fuer einen Klick waehrend eines Umbaus.
	local first = if _selection[1] then ClientState.getBaerchi(_selection[1]) else nil
	local picked = ClientState.getBaerchi(uid)
	if first and picked and first.rarity ~= picked.rarity then
		return
	end

	-- Sammel-Update 1.3: ein weiterer Klick ersetzt B, nie A — A ist der
	-- Baerchi, von dessen Karte der Spieler kam.
	if #_selection >= 2 then
		table.remove(_selection, 2)
	end
	table.insert(_selection, uid)
end

-- Sammel-Update 2.8: im Fusions-Modus mit gewaehltem A nur Baerchis
-- derselben Rarity zeigen (A selbst bleibt sichtbar, zum Abwaehlen).
local function visibleInFusion(baerchi: Types.Baerchi): boolean
	if not _fusionMode or not _selection[1] then return true end
	if isSelected(baerchi.uid) then return true end
	local first = ClientState.getBaerchi(_selection[1])
	return first == nil or first.rarity == baerchi.rarity
end

-- Sammel-Update 1.3 ("kann keinen 2. auswaehlen"): die Zeilen wurden bei JEDEM
-- Datenstand (Honig, Eier, ... mehrmals pro Sekunde) zerstoert und neu
-- gebaut. Lag ein Tipp gerade dazwischen (Finger runter, Zeile weg, Finger
-- hoch), kam Activated nie an — auf dem Handy fast jedes Mal. Jetzt bleibt
-- die Zeile samt Knopf pro uid stehen, nur der Inhalt wird erneuert.
local _rows: { [string]: Frame } = {}

-- Markierungen wegwerfen die es nicht mehr gibt (verwertet, fusioniert, Rebirth)
local function pruneSelection()
	for i = #_selection, 1, -1 do
		if not ClientState.getBaerchi(_selection[i]) then
			table.remove(_selection, i)
		end
	end
end

--------------------------------------------------------------------------------
-- Aufbau der Liste
--------------------------------------------------------------------------------

-- Zeigt die AKTUELLEN HP, nicht nur das Maximum: seit die HP zwischen
-- PIT-Laeufen stehen bleiben, ist "wer kann ueberhaupt noch kaempfen" die
-- eigentliche Frage beim Durchscrollen der Liste.
local function describeStats(baerchi: Types.Baerchi): string
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then return "" end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)
	-- `or stats.maxHp`: ohne den Rueckfall wuerde ein Baerchi ohne currentHp
	-- (Datenpaket von einem aelteren Serverstand) hier den Aufbau der GANZEN
	-- Liste abbrechen, weil dieser Aufruf mitten in der Zeilen-Schleife steht.
	local hp    = math.clamp(baerchi.currentHp or stats.maxHp, 0, stats.maxHp)

	return string.format("HP %d/%d\nATK %d", hp, stats.maxHp, stats.atk)
end

local function buildRow(parent: Instance, order: number, baerchi: Types.Baerchi)
	local upgradeUi = FeatureFlags.isOn("UI_V2_UPGRADE_TAB")
	-- HBB Paket 4: Farbband statt zwoelf Einzelfarben
	local color = if upgradeUi then Theme.bandColor(baerchi.rarity) else Theme.rarityColor(baerchi.rarity)
	local def   = BaerchiConfig.getById(baerchi.configId)

	local data     = ClientState.get()
	local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

	local uid = baerchi.uid
	local row = _rows[uid]
	local fresh = row == nil or row.Parent == nil
	if fresh then
		row = Theme.panel("Row_" .. uid, parent, Theme.COLORS.panel)
		row.Size = UDim2.new(1, -8, 0, ROW_HEIGHT)
		_rows[uid] = row :: Frame

		-- Die ganze Zeile ist der Knopf: ein durchsichtiger Button darueber.
		-- Er bleibt ueber alle Aktualisierungen bestehen (siehe _rows).
		local hit = Instance.new("TextButton")
		hit.Name                   = "Hit"
		hit.BackgroundTransparency = 1
		hit.Text                   = ""
		hit.Size                   = UDim2.fromScale(1, 1)
		hit.ZIndex                 = 3
		hit.Parent                 = row

		hit.Activated:Connect(function()
			if _fusionMode then
				toggleSelection(uid)
				BaerchiInventory.refresh()
			else
				PanelManager.open("Baerchi", uid)
			end
		end)
	end
	local frame = row :: Frame
	frame.LayoutOrder = order
	frame.Visible     = visibleInFusion(baerchi)
	for _, child in frame:GetChildren() do
		if child.Name == "Accent" or child.Name == "Name" or child.Name == "Sub" or child.Name == "Stats" then
			child:Destroy()
		end
	end
	row = frame

	-- Markierte Zeilen bekommen einen farbigen Rand statt eines eigenen Symbols
	local stroke = row:FindFirstChildOfClass("UIStroke")
	if stroke then
		local marked = _fusionMode and isSelected(uid)
		stroke.Color     = if marked then Theme.COLORS.gummy else Theme.COLORS.outline
		stroke.Thickness = if marked then Theme.OUTLINE_THICKNESS + 2 else Theme.OUTLINE_THICKNESS
	end

	local accent = Instance.new("Frame")
	accent.Name             = "Accent"
	accent.Size             = UDim2.new(0, 6, 1, -14)
	accent.Position         = UDim2.new(0, 8, 0, 7)
	-- Der ausgeruestete Baerchi (der einzige, der auf dem Plot steht und
	-- kaempfen/essen kann) hebt sich hier golden ab statt in Rarity-Farbe —
	-- das ist auf einen Blick wichtiger als die Rarity.
	accent.BackgroundColor3  = if equipped then Theme.COLORS.goldGummy else color
	accent.BorderSizePixel   = 0
	accent.Parent            = row
	Theme.corner(accent, 3)

	-- Eine Mutation ist in einer langen Liste die Information, die man auf
	-- keinen Fall uebersehen darf: die haeufigste Stufe trifft trotzdem nur
	-- 1 von 100 Baerchis. Deshalb hier gleich zweimal — als Kuerzel im Namen
	-- und als Farbe der Unterzeile (seit v11, ersetzt das binaere Inverted).
	local mutation = baerchi.mutation

	local name = Theme.label("Name", row,
		(if equipped then "\u{2605} " else "")
		.. (if mutation then BaerchiConfig.getMutationBadge(mutation) .. " " else "")
		.. Names.baerchi(baerchi.configId))
	name.Position = UDim2.new(0, 22, 0, 5)
	name.Size     = UDim2.new(1, -120, 0, 21)

	local sub = Theme.label("Sub", row, string.format(
		"Lv. %d  —  %s%s",
		baerchi.level,
		Loc.t("rarity." .. baerchi.rarity),
		if mutation then "  —  " .. Loc.name("mutation." .. mutation .. ".name", BaerchiConfig.getMutationDisplayName(mutation)):upper() else ""
	))
	sub.Position   = UDim2.new(0, 22, 0, 26)
	sub.Size       = UDim2.new(1, -120, 0, 16)
	sub.TextColor3 = if mutation then BaerchiConfig.getMutationColor(mutation) else color

	local stats = Theme.label("Stats", row, if upgradeUi then ratingText(baerchi) else describeStats(baerchi))
	stats.AnchorPoint    = Vector2.new(1, 0.5)
	stats.Position       = UDim2.new(1, -10, 0.5, 0)
	stats.Size           = UDim2.new(0, 84, 1, -10)
	stats.TextXAlignment = Enum.TextXAlignment.Right
	stats.TextScaled     = false
	stats.TextSize       = if upgradeUi then 20 else 13
	stats.Font           = if upgradeUi then Theme.FONT else Theme.FONT_BODY
	stats.TextColor3     = if upgradeUi then Theme.COLORS.text else Theme.COLORS.textDim
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

local function updateFooter()
	local footer = _footer
	if footer then
		footer.Visible = _fusionMode
	end

	local scroller = _scroller
	if scroller then
		local reserved = if _fusionMode then FOOTER_H + 6 else 0
		scroller.Size = UDim2.new(1, 0, 1, -(TOOLBAR_H + 6 + reserved))
	end

	for slot = 1, 2 do
		local label = _slotLabels[slot]
		if not label then continue end

		local uid = _selection[slot]
		local baerchi = if uid then ClientState.getBaerchi(uid) else nil

		if baerchi then
			local def = BaerchiConfig.getById(baerchi.configId)
			label.Text       = string.format("%s  Lv.%d", Names.baerchi(baerchi.configId), baerchi.level)
			label.TextColor3  = Theme.rarityColor(baerchi.rarity)
		else
			label.Text       = Loc.t("ui.fusion.slot_empty", { n = slot })
			label.TextColor3  = Theme.COLORS.textDim
		end
	end

	local fuseButton = _fuseButton
	if fuseButton then
		Theme.setEnabled(fuseButton, #_selection == 2)
	end

	local modeButton = _modeButton
	if modeButton then
		modeButton.Text = Loc.t(if _fusionMode then "ui.fusion.mode_on" else "ui.fusion.mode_off")
	end

	local hint = _hint
	if hint then
		hint.Text = if not _fusionMode
			then Loc.t("ui.inventory.hint_card")
			elseif _selection[1] then Loc.t("ui.fusion.hint_pick_b")
			else Loc.t("ui.fusion.hint_pick_a")
	end
end

function BaerchiInventory.refresh()
	local scroller = _scroller
	local root     = _root
	if not scroller or not root then return end

	if not root.Visible then
		_dirty = true
		return
	end
	_dirty = false

	pruneSelection()

	local list = ClientState.getBaerchiList()

	-- Sammel-Update 1.3: nur Zeilen entfernen, deren Baerchi es nicht mehr gibt.
	local alive: { [string]: boolean } = {}
	for _, baerchi in list do alive[baerchi.uid] = true end
	for uid, row in _rows do
		if not alive[uid] then
			row:Destroy()
			_rows[uid] = nil
		end
	end

	local title = _title
	if title then
		title.Text = Loc.t("ui.inventory.title_count", { n = #list })
	end

	local empty = _empty
	if empty then
		empty.Visible = #list == 0
	end

	for order, baerchi in list do
		buildRow(scroller, order, baerchi)
	end

	updateFooter()
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function applyTab()
	-- HBB Paket 3: der Index-Reiter erscheint ab drei entdeckten Arten
	local indexTab = _tabButtons.Index
	if indexTab then
		Unlock.apply("index", indexTab)
		if not indexTab.Visible and _tab == "Index" then _tab = "Pets" end
	end

	local listPage = _listPage
	if listPage then
		listPage.Visible = _tab == "Pets"
	end
	IndexView.setVisible(_tab == "Index" and _root ~= nil and _root.Visible)

	for tab, button in _tabButtons do
		local active = tab == _tab
		button.BackgroundColor3 = if active then Theme.COLORS.accent else Theme.COLORS.panelLight
		button.TextColor3       = if active then Theme.COLORS.outline else Theme.COLORS.text
	end

	-- Sammel-Update 05.10. (Paket 7): "!" am Index-Reiter, solange eine
	-- Belohnung abholbar ist.
	local indexButton = _tabButtons.Index
	if indexButton then
		local badge = indexButton:FindFirstChild("RewardBadge")
		if badge and badge:IsA("GuiObject") then
			badge.Visible = IndexView.claimableCount() > 0
		end
	end

	if _tab == "Pets" then
		BaerchiInventory.refresh()
	end
end

local function openInternal(...: any)
	local root = _root
	if not root then return end

	-- PanelManager.open("Inventory", "Index") springt direkt in den Index
	-- (zum Beispiel aus einer Quest heraus).
	local wanted, uid = ...
	if wanted == "Index" or wanted == "Pets" then
		_tab = wanted
	elseif wanted == "Fuse" then
		-- Playtest 05.10.: Fusion von der Baerchi-Karte aus. Das Fusions-
		-- Fenster selbst hat keine Auswahl; ausgewaehlt wird hier. A ist
		-- dieser Baerchi, B tippt der Spieler in der Liste an.
		_tab = "Pets"
		_fusionMode = true
		table.clear(_selection)
		if typeof(uid) == "string" then table.insert(_selection, uid) end
	end

	root.Visible = true
	applyTab()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
	IndexView.setVisible(false)
end

function BaerchiInventory.show()
	PanelManager.open(PANEL_NAME)
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function BaerchiInventory.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"BaerchiInventory", screenGui,
		Vector2.new(0.46, 0.66),
		Vector2.new(300, 300),
		Vector2.new(520, 580)
	)
	_root  = root
	_title = Theme.dialogHeader(root, Loc.t("ui.menu.baerchis"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	-- Reiter-Leiste: "Meine Baerchis" | "Index"
	local tabBar = Theme.container("Tabs", body)
	tabBar.Size = UDim2.new(1, 0, 0, TAB_H)
	local tabLayout = Theme.listLayout(tabBar, 8, true)
	tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local function addTab(tab: string, key: string, order: number)
		local button = Theme.button("Tab_" .. tab, tabBar, "", Theme.COLORS.panelLight)
		button.Size        = UDim2.new(0, 150, 1, 0)
		button.LayoutOrder = order
		Loc.bind(button, key)
		button.Activated:Connect(function()
			if tab == "Index" then Unlock.markSeen("index") end
			_tab = tab
			applyTab()
		end)
		_tabButtons[tab] = button
	end
	addTab("Pets",  "ui.inventory.tab_pets",  1)
	addTab("Index", "ui.inventory.tab_index", 2)
	do
		local indexButton = _tabButtons.Index
		local badge = Theme.panel("RewardBadge", indexButton, Theme.COLORS.bad)
		badge.AnchorPoint = Vector2.new(1, 0)
		badge.Position = UDim2.new(1, 4, 0, -6)
		badge.Size = UDim2.fromOffset(20, 20)
		badge.ZIndex = 4
		badge.Visible = false
		Theme.corner(badge, 10)
		local bang = Theme.label("Bang", badge, "!")
		bang.Size = UDim2.fromScale(1, 1)
		bang.TextXAlignment = Enum.TextXAlignment.Center
		bang.ZIndex = 5
	end

	-- Beide Seiten teilen sich die Flaeche unter den Reitern.
	local pages = Theme.container("Pages", body)
	pages.Position = UDim2.new(0, 0, 0, TAB_H + 8)
	pages.Size     = UDim2.new(1, 0, 1, -(TAB_H + 8))

	local listPage = Theme.container("ListPage", pages)
	listPage.Size = UDim2.fromScale(1, 1)
	_listPage = listPage

	IndexView.build(pages, root)

	-- Werkzeugleiste: Fusions-Modus an/aus
	local toolbar = Theme.container("Toolbar", listPage)
	toolbar.Size = UDim2.new(1, 0, 0, TOOLBAR_H)

	local modeButton = Theme.button("FusionMode", toolbar, Loc.t("ui.fusion.mode_off"), Theme.COLORS.gummy)
	modeButton.Size = UDim2.new(0, 130, 1, 0)
	_modeButton = modeButton

	local hint = Theme.bodyText("Hint", toolbar, Loc.t("ui.inventory.hint_card"))
	_hint = hint
	hint.Position       = UDim2.new(0, 140, 0, 0)
	hint.Size           = UDim2.new(1, -140, 1, 0)
	hint.TextYAlignment = Enum.TextYAlignment.Center

	modeButton.Activated:Connect(function()
		_fusionMode = not _fusionMode
		if not _fusionMode then
			table.clear(_selection)
		end
		BaerchiInventory.refresh()
	end)

	-- Liste
	local scroller = Theme.scroller("List", listPage)
	scroller.Position = UDim2.new(0, 0, 0, TOOLBAR_H + 6)
	scroller.Size     = UDim2.new(1, 0, 1, -(TOOLBAR_H + 6))
	_scroller = scroller

	local layout = Theme.listLayout(scroller, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local empty = Theme.bodyText("Empty", listPage, Loc.t("ui.inventory.empty"))
	empty.Position = UDim2.new(0, 4, 0, TOOLBAR_H + 16)
	empty.Size     = UDim2.new(1, -8, 0, 40)
	empty.Visible  = false
	_empty = empty

	-- Fussleiste fuer die Fusions-Auswahl
	local footer = Theme.panel("FusionFooter", listPage, Theme.COLORS.panel)
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Position    = UDim2.new(0, 0, 1, 0)
	footer.Size        = UDim2.new(1, -8, 0, FOOTER_H)
	footer.Visible     = false
	_footer = footer

	for slot = 1, 2 do
		local label = Theme.label("Slot" .. slot, footer, Loc.t("ui.fusion.slot_empty", { n = slot }))
		label.Position   = UDim2.new(0, 10, 0, 6 + (slot - 1) * 22)
		label.Size       = UDim2.new(1, -140, 0, 20)
		label.TextColor3  = Theme.COLORS.textDim
		_slotLabels[slot] = label
	end

	local fuseButton = Theme.button("Fuse", footer, Loc.t("ui.fusion.fuse"), Theme.COLORS.gummy)
	fuseButton.AnchorPoint = Vector2.new(1, 0.5)
	fuseButton.Position    = UDim2.new(1, -10, 0.5, 0)
	fuseButton.Size        = UDim2.new(0, 116, 0, 34)
	_fuseButton = fuseButton

	fuseButton.Activated:Connect(function()
		if #_selection < 2 then return end
		PanelManager.open("Fusion", _selection[1], _selection[2])
	end)

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	-- Bestandsaenderungen: sichtbar sofort nachziehen, sonst nur merken
	ClientState.onChanged(function()
		local current = _root
		local indexButton = _tabButtons.Index
		local badge = if indexButton then indexButton:FindFirstChild("RewardBadge") else nil
		if badge and badge:IsA("GuiObject") then
			badge.Visible = IndexView.claimableCount() > 0
		end
		if current and current.Visible then
			BaerchiInventory.refresh()
		else
			_dirty = true
		end
	end)

	-- Sprachwechsel: Zeilen, Titel und Fusions-Leiste neu beschriften
	Loc.onChanged(function()
		_dirty = true
		BaerchiInventory.refresh()
	end)

	print("[BaerchiInventory] Initialisiert")
end

return BaerchiInventory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">BaerchiPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- BaerchiPanel.luau
-- StarterPlayerScripts/UI/BaerchiPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Detailkarte eines einzelnen Baerchis anzeigen
--   - Die Aktionen die genau diesen Baerchi betreffen ausloesen: ausruesten,
--     befoerdern, mit Honig fuettern und verwerten
--
-- SEIT v12 laufen "Zum Event" und "In den PIT" NICHT mehr ueber diese Karte,
-- sondern ueber die untere Pet-Leiste (PetBar). Der ausgeruestete Baerchi kann
-- ausserdem nicht mehr verwertet werden (Ei-Baum-Konzept, Pet-Regeln): der
-- Knopf ist bei ihm gesperrt, der Server lehnt es zusaetzlich ab.
--
-- FUETTERN IST SEIT v7 EINE ENTSCHEIDUNG, kein einzelner Knopf mehr: die drei
-- Gebaeude liefern unterschiedlichen Honig (siehe Config/BuildingBehavior).
-- Deshalb steht hier pro Gebaeude ein eigener Knopf mit seinem eigenen
-- Bestand, in derselben Farbe wie seine Karte im Gebaeude-Panel. Welchen Honig
-- der Spieler verfuettert, entscheidet er — nicht mehr der Server.
--
-- SEIT v8 zeigt die Karte die ZWEITE Fortschrittsachse mit: fuenf Sterne
-- (Promotion), acht Charm-Slots und ein Balken je Stat-Level. Damit wuchs sie
-- ueber die Hoehe eines Handy-Bildschirms hinaus — der Inhalt liegt deshalb
-- jetzt in einem Scroller statt direkt im Rahmen. Das ist der Grund, warum
-- `body` hier eine ScrollingFrame ist und die Zeilen `1, -8` breit sind.
--
-- Wird von WorldController geoeffnet, wenn der Spieler eine Figur auf seiner
-- Insel anklickt, und aus dem Inventar heraus. Die Karte liest ihre Daten
-- ueber die uid aus ClientState — kein zusaetzlicher Server-Roundtrip noetig.
--
-- Die Karte bleibt beim Datenwechsel offen und aktualisiert sich mit (z.B.
-- waehrend eines Kampfes steigt XP), und schliesst sich automatisch wenn der
-- Baerchi verschwindet (verwertet oder fusioniert).
--
-- Die Kampf-Wiedergabe gehoert bewusst NICHT hierher: sie haengt am
-- CombatResultReceived-Listener in CombatPanel und laeuft deshalb egal von
-- wo der Kampf gestartet wurde.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local SkillConfig      = require(ReplicatedStorage.Config.SkillConfig)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local PromotionConfig  = require(ReplicatedStorage.Config.PromotionConfig)
local CharmConfig      = require(ReplicatedStorage.Config.CharmConfig)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggCalculator    = require(ReplicatedStorage.Modules.EggCalculator)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify        = require(script.Parent.Notify)
local Feedback      = require(script.Parent.Feedback)
local Moment        = require(script.Parent.Moment)
local ReturnSummary = require(script.Parent.ReturnSummary)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Unlock       = require(script.Parent.Unlock)   -- HBB Paket 3
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombatRating = require(ReplicatedStorage.Modules.CombatRating)
local Loc          = require(ReplicatedStorage.Localization.Loc)
local Names        = require(ReplicatedStorage.Localization.Names)

-- HBB Paket 4: Kampfwert im Kopf, "Staerker machen" (Befoerdern + Fusion)
local _ratingLabel: TextLabel? = nil
local _ratingRow: Frame? = nil
local _upgradeRow: Frame? = nil

local BaerchiPanel = {}

local PANEL_NAME = "Baerchi"

local _root: Frame?      = nil
local _openUid: string?  = nil

-- Referenzen auf die Felder der Karte
local _titleLabel: TextLabel?  = nil
local _rarityLabel: TextLabel? = nil
local _levelLabel: TextLabel?  = nil
local _statsLabel: TextLabel?  = nil
local _skillLabel: TextLabel?  = nil
local _valueLabel: TextLabel?  = nil
local _xpFill: Frame?          = nil
local _xpText: TextLabel?      = nil
local _hpFill: Frame?          = nil
local _hpText: TextLabel?      = nil
local _accentBar: Frame?       = nil
local _fusionBadge: Frame?         = nil
local _mutationBadge: Frame?       = nil
local _mutationBadgeText: TextLabel? = nil
local _equipButton: TextButton? = nil
local _recycleButton: TextButton? = nil

-- v8: Promotion, Stat-Level, Charms
local _stars: { Frame }            = {}
local _promoteButton: TextButton?  = nil
local _promoteHint: TextLabel?     = nil
type CharmTile = {
	tile   : Frame,
	letter : TextLabel,
}
local _charmSlots: { CharmTile }   = {}
local _charmButton: TextButton?    = nil

-- v10: Eier legen
local _eggRateLabel: TextLabel?    = nil
local _eggChanceLabel: TextLabel?  = nil
local _eggCountLabel: TextLabel?   = nil
local _collectButton: TextButton?  = nil

type StatRow = {
	key  : string,
	fill : Frame,
	text : TextLabel,
}
local _statRows: { StatRow } = {}

-- Ein Fuetter-Knopf pro Gebaeude, key = BuildingId. Text und Verfuegbarkeit
-- ziehen bei jedem Datenwechsel nach (siehe fill).
local _feedButtons: { [string]: TextButton } = {}

--------------------------------------------------------------------------------
-- Inhalt fuellen
--------------------------------------------------------------------------------

-- Wie viele Duplikate fuer die naechste Promotion da sind. Dieselbe Bedingung
-- wie PromotionService.getMaterials: gleicher configId, andere uid, nicht der
-- ausgeruestete Baerchi.
local function countMaterials(target: Types.Baerchi): number
	local data = ClientState.get()
	if not data then return 0 end

	local count = 0
	for uid, baerchi in data.island.baerchis do
		if uid ~= target.uid
			and baerchi.configId == target.configId
			and uid ~= data.island.equippedUid
		then
			count += 1
		end
	end
	return count
end

local function fillPromotion(baerchi: Types.Baerchi)
	local promotion = baerchi.promotionLevel or 0
	local states    = PromotionConfig.getStarStates(promotion)

	for index, star in _stars do
		star.BackgroundColor3 = PromotionConfig.STAR_COLORS[states[index]]
			or PromotionConfig.STAR_COLORS.empty
	end

	local maxed = promotion >= PromotionConfig.MAX_PROMOTION

	if _promoteHint then
		if maxed then
			_promoteHint.Text       = Loc.t("ui.baerchi.promo_maxed", { n = promotion, max = PromotionConfig.MAX_PROMOTION })
			_promoteHint.TextColor3 = Theme.COLORS.goldGummy
		else
			local cost = PromotionConfig.getDuplicateCost(baerchi.rarity, promotion + 1)
			local have = countMaterials(baerchi)

			_promoteHint.Text = Loc.t("ui.baerchi.promo_next", {
				n = promotion, max = PromotionConfig.MAX_PROMOTION, cost = cost, have = have })
			_promoteHint.TextColor3 = if have >= cost then Theme.COLORS.good else Theme.COLORS.textDim
		end
	end

	if _promoteButton then
		local ready = false
		if not maxed then
			local cost = PromotionConfig.getDuplicateCost(baerchi.rarity, promotion + 1)
			ready = countMaterials(baerchi) >= cost
		end

		_promoteButton.Text = Loc.t(if maxed then "ui.baerchi.promo_full" else "ui.baerchi.promote")
		Theme.setEnabled(_promoteButton, ready)
	end
end

local function fillStatLevels(baerchi: Types.Baerchi)
	local cap    = PromotionConfig.getStatCap(baerchi.rarity)
	local levels = baerchi.statLevels

	for _, row in _statRows do
		local value = if levels then (((levels :: any)[row.key]) or 0) else 0
		local ratio = if cap > 0 then math.clamp(value / cap, 0, 1) else 0

		row.fill.Size = UDim2.fromScale(ratio, 1)

		-- EGG hebt sich farblich ab: es ist der einzige der fuenf Stats, der
		-- nichts mit dem Kampf zu tun hat, sondern mit dem Ei-Legen.
		row.fill.BackgroundColor3 = if row.key == "egg"
			then Theme.COLORS.goldGummy
			else Theme.rarityColor(baerchi.rarity)

		local label = PromotionConfig.STAT_LABELS[row.key] or string.upper(row.key)
		row.text.Text = string.format("%s  %d / %d", label, value, cap)
	end
end

local function fillCharms(baerchi: Types.Baerchi)
	local promotion = baerchi.promotionLevel or 0

	-- `or {}`: ein Datenpaket von einem aelteren Serverstand haette das Feld
	-- nicht (dieselbe Vorsichtsmassnahme wie bei currentHp weiter unten).
	local charms: { Types.Charm } = baerchi.charms or {}

	local bySlot: { [number]: Types.Charm } = {}
	for _, charm in charms do
		bySlot[charm.slot] = charm
	end

	local unlocked = 0

	for slot, entry in _charmSlots do
		local isOpen = CharmConfig.isSlotUnlocked(slot, promotion)
		local charm  = if isOpen then bySlot[slot] else nil

		if isOpen then unlocked += 1 end

		if not isOpen then
			entry.letter.Text          = "-"
			entry.letter.TextColor3    = Theme.COLORS.textDim
			entry.tile.BackgroundColor3 = Theme.COLORS.disabled
		elseif not charm then
			entry.letter.Text          = "?"
			entry.letter.TextColor3    = Theme.COLORS.text
			entry.tile.BackgroundColor3 = Theme.COLORS.panelLight
		else
			entry.letter.Text          = CharmConfig.RARITY_LETTER[charm.rarity] or "?"
			entry.letter.TextColor3    = Theme.COLORS.outline
			entry.tile.BackgroundColor3 = CharmConfig.RARITY_COLORS[charm.rarity]
				or Theme.COLORS.panelLight
		end
	end

	if _charmButton then
		_charmButton.Text = Loc.t("ui.baerchi.charms_button", { open = unlocked, total = CharmConfig.SLOT_COUNT })
		Theme.setEnabled(_charmButton, true)
	end
end

-- Der Ei-Abschnitt: wie schnell dieser Baerchi legt und was dabei herauskommen
-- kann. Beide Zahlen kommen aus EggCalculator — dieselbe Rechnung, die der
-- Server benutzt. Eine nachgebaute Formel hier waere beim naechsten Balancing
-- sofort falsch.
local function fillEgg(baerchi: Types.Baerchi)
	local data     = ClientState.get()
	local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

	if _eggRateLabel then
		local interval = EggCalculator.getLayIntervalSeconds(baerchi, false)

		if not interval then
			_eggRateLabel.Text       = Loc.t("ui.baerchi.no_eggs")
			_eggRateLabel.TextColor3 = Theme.COLORS.textDim
		else
			_eggRateLabel.Text = Loc.t(if equipped then "ui.baerchi.lays_every" else "ui.baerchi.lays_every_unequipped",
				{ time = Theme.formatDuration(interval) })
			_eggRateLabel.TextColor3 = if equipped then Theme.COLORS.goldGummy else Theme.COLORS.textDim
		end
	end

	if _eggChanceLabel then
		local chances = EggCalculator.getChances(baerchi)

		if #chances == 0 then
			_eggChanceLabel.Text = ""
		else
			local parts: { string } = {}
			for _, chance in chances do
				table.insert(parts, string.format(
					"%s %d%%",
					Names.eggShort(chance.eggType),
					math.floor(chance.percent + 0.5)
				))
			end
			_eggChanceLabel.Text = table.concat(parts, "   ")
		end
	end

	if _eggCountLabel then
		-- INCUBATOR_BREED: nur die Eier des ausgeruesteten zaehlen gegen seine Grenze
		local laid = if data then EggCalculator.countOwnLaid(data.island.laidEggs) else 0

		_eggCountLabel.Text = Loc.t("ui.baerchi.eggs_on_plot", { n = laid, max = EggConfig.MAX_UNCOLLECTED_EGGS })
		_eggCountLabel.TextColor3 = if laid >= EggConfig.MAX_UNCOLLECTED_EGGS
			then Theme.COLORS.bad
			else Theme.COLORS.textDim
	end

	if _collectButton then
		local laid = if data then #(data.island.laidEggs or {}) else 0
		_collectButton.Text = if laid > 0
			then Loc.t("ui.baerchi.collect_n", { n = laid })
			else Loc.t("ui.baerchi.collect_none")
		Theme.setEnabled(_collectButton, laid > 0)
	end
end

local function fill(baerchi: Types.Baerchi)
	local def = BaerchiConfig.getById(baerchi.configId)
	local color = Theme.rarityColor(baerchi.rarity)

	-- HBB Paket 3: Charms und Verwerten erst, wenn sie gebraucht werden
	if _charmButton then Unlock.apply("charms", _charmButton) end
	if _recycleButton then Unlock.apply("recycling", _recycleButton) end

	-- HBB Paket 4: Farbband statt zwoelf Einzelfarben, Kampfwert gross
	local upgradeUi = FeatureFlags.isOn("UI_V2_UPGRADE_TAB")
	if upgradeUi then
		color = Theme.bandColor(baerchi.rarity)
	end
	local ratingLabel = _ratingLabel
	if ratingLabel then
		if _ratingRow then _ratingRow.Visible = upgradeUi end
		local value, suffix = CombatRating.short(CombatRating.of(baerchi))
		local digits = if suffix ~= "" and value < 100 then 1 else 0
		ratingLabel.Text = "⚔ " .. (if digits > 0 then Loc.formatDecimal(value, digits) else Loc.formatNumber(math.floor(value))) .. suffix
		ratingLabel.TextColor3 = color
	end
	local upgradeRow = _upgradeRow
	if upgradeRow then
		upgradeRow.Visible = upgradeUi and Unlock.isVisible("tab_upgrade")
	end

	if _accentBar   then _accentBar.BackgroundColor3 = color end
	if _titleLabel  then _titleLabel.Text  = Names.baerchi(baerchi.configId) end
	if _rarityLabel then
		_rarityLabel.Text       = string.upper(Names.rarity(baerchi.rarity))
		_rarityLabel.TextColor3 = color
	end
	if _levelLabel then
		_levelLabel.Text = Loc.t("ui.baerchi.level", { level = baerchi.level, max = BaerchiConfig.MAX_LEVEL })
		if baerchi.level >= BaerchiConfig.MAX_LEVEL and (baerchi.endlessLevel or 0) > 0 then
			-- Paket 9: Endless-Level dahinter
			_levelLabel.Text ..= "  " .. Loc.t("ui.baerchi.endless_level", { n = baerchi.endlessLevel or 0 })
		end
	end

	-- Nur der ausgeruestete Baerchi steht auf dem Plot, kaempft und isst von
	-- alleine am Teich — der Knopf zeigt, ob das dieser hier ist, und ruestet
	-- ihn sonst aus.
	if _equipButton then
		local data     = ClientState.get()
		local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

		_equipButton.Text = Loc.t(if equipped then "ui.card.equipped" else "ui.card.equip")
		Theme.setEnabled(_equipButton, not equipped)
	end

	-- Kampfwerte inklusive Fusions-Bonus, damit die Karte zeigt was im PIT zaehlt.
	-- Bewusst ueber CombatCalculator.getEffectiveStats: das ist dieselbe Funktion
	-- die der Server fuer den Kampf benutzt — eine nachgebaute Formel hier waere
	-- beim naechsten Balancing sofort falsch. Seit v8 stecken darin auch
	-- Promotion, Stat-Level und Charms.
	local stats = if def then CombatCalculator.getEffectiveStats(baerchi, def.baseStats) else nil

	if _statsLabel and stats then
		-- Eine Verteidigung gibt es nicht mehr (siehe BaerchiConfig): die drei
		-- Zahlen, die einen Kampf entscheiden, sind Schaden pro Treffer,
		-- Angriffstempo und Ability-Staerke.
		-- Sammel-Update 3.7: Symbole vor den Kuerzeln
		_statsLabel.Text = string.format("⚔ ATK %d   ⚡ SPD %.2f   ✨ PWR %d%%",
			stats.atk, stats.spd, math.floor(stats.pwr * 100 + 0.5))
	end

	-- HP-Balken. Die HP bleiben zwischen PIT-Laeufen stehen: ein leerer Balken
	-- heisst erschoepft, und dann geht kein neuer Lauf mehr los bevor
	-- gefuettert wurde. Das ist die wichtigste Zahl auf dieser Karte.
	if _hpFill and _hpText and stats then
		-- `or stats.maxHp`: currentHp gibt es erst seit v4. Ein Datenpaket von
		-- einem aelteren Serverstand haette das Feld nicht, und math.clamp
		-- wuerde an nil scheitern statt den Baerchi einfach voll anzuzeigen.
		local hp    = math.clamp(baerchi.currentHp or stats.maxHp, 0, stats.maxHp)
		local ratio = if stats.maxHp > 0 then hp / stats.maxHp else 0

		_hpFill.Size = UDim2.fromScale(ratio, 1)
		_hpFill.BackgroundColor3 = if ratio <= 0
			then Theme.COLORS.bad
			elseif ratio < 0.34 then Theme.COLORS.goldGummy
			else Theme.COLORS.good

		_hpText.Text = if hp <= 0
			then Loc.t("ui.card.hp_exhausted", { max = stats.maxHp })
			else string.format("%d / %d HP", hp, stats.maxHp)
	end

	if _skillLabel then
		local skill = SkillConfig.getById(baerchi.skillId)
		_skillLabel.Text = if skill
			then Names.skill(baerchi.skillId) .. " — " .. Names.skillDesc(baerchi.skillId)
			else baerchi.skillId
	end

	-- XP-Balken
	-- Paket 9: auf Max-Level sammeln sich XP nur mit offenem Endless (sonst
	-- immer 0) — dann zeigt der Balken den Weg zum naechsten Endless-Level.
	local endlessXp = baerchi.level >= BaerchiConfig.MAX_LEVEL
		and ((baerchi.endlessLevel or 0) > 0 or baerchi.xp > 0)
	local needed = if endlessXp
		then BaerchiConfig.xpForEndlessLevel(baerchi.endlessLevel or 0)
		else BaerchiConfig.xpForNextLevel(baerchi.level)
	local ratio  = if baerchi.level >= BaerchiConfig.MAX_LEVEL and not endlessXp
		then 1
		else math.clamp(baerchi.xp / math.max(needed, 1), 0, 1)

	if _xpFill then
		_xpFill.Size            = UDim2.fromScale(ratio, 1)
		_xpFill.BackgroundColor3 = color
	end
	if _xpText then
		_xpText.Text = if endlessXp
			then string.format("%s / %s XP", Theme.formatNumber(baerchi.xp), Theme.formatNumber(needed))
			elseif baerchi.level >= BaerchiConfig.MAX_LEVEL
			then "MAX"
			else string.format("%d / %d XP", baerchi.xp, needed)
	end

	-- Verwertungs-Wert, damit man vor dem Verwerten weiss was es bringt.
	-- Feste Quote seit v4 (kein Recycler-Gebaeude mehr).
	if _valueLabel then
		local value = math.floor(
			EconomyConfig.getBaerchiBaseValue(baerchi.rarity, baerchi.level)
			* EconomyConfig.RECYCLE_RETURN
		)
		_valueLabel.Text = Loc.t("ui.baerchi.recycle_value", { n = value })
	end

	-- Pet-Regel (v12): der ausgeruestete Baerchi ist der, der Eier legt — er
	-- darf nicht verwertet werden, sonst stuende der Spieler ohne Leger da.
	-- Tauschen geht ueber "Ausruesten" bei einem anderen. Der Server lehnt es
	-- ohnehin ab, das Ausgrauen spart nur den Klick ins Leere.
	if _recycleButton then
		local data     = ClientState.get()
		local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

		_recycleButton.Text = Loc.t(if equipped then "ui.baerchi.recycle_equipped" else "ui.baerchi.recycle")
		Theme.setEnabled(_recycleButton, not equipped)
	end

	if _fusionBadge then
		_fusionBadge.Visible = baerchi.isFusionResult
	end

	if _mutationBadge then
		local mutation = baerchi.mutation
		_mutationBadge.Visible = mutation ~= nil
		if mutation then
			_mutationBadge.BackgroundColor3 = BaerchiConfig.getMutationColor(mutation)
			if _mutationBadgeText then
				_mutationBadgeText.Text = Names.mutation(mutation):upper()
			end
		end
	end

	fillPromotion(baerchi)
	fillStatLevels(baerchi)
	fillCharms(baerchi)
	fillEgg(baerchi)

	-- Fuetter-Knoepfe: jeder zeigt seinen EIGENEN Bestand und ist nur
	-- anklickbar, wenn dort auch etwas liegt. Leere Lager auszugrauen erspart
	-- den Klick ins Leere — abgelehnt wuerde er ohnehin, aber erst nach dem
	-- Weg zum Server.
	local data = ClientState.get()

	-- Nur Gebaeude, die es auf dieser Insel gibt (HONEY_POND_V2: nur der
	-- Teich); die Knoepfe teilen sich die Zeile gleichmaessig.
	local shown = 0
	for id in _feedButtons do
		if data and data.island.buildings[id :: Types.BuildingId] then shown += 1 end
	end
	for id, button in _feedButtons do
		local building = if data then data.island.buildings[id :: Types.BuildingId] else nil
		local honey = if building then (building.honey or 0) else 0

		button.Visible = building ~= nil
		button.Size = UDim2.new(1 / math.max(1, shown), -6, 1, 0)
		button.Text = string.format("%s %d", Names.buildingShort(id), honey)
		Theme.setEnabled(button, honey > 0)
	end
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function closeInternal()
	_openUid = nil
	local root = _root
	if root then root.Visible = false end
end

local function showInternal(...: any)
	local argument = ...
	if typeof(argument) ~= "string" then return end

	local uid = argument :: string
	local baerchi = ClientState.getBaerchi(uid)
	if not baerchi then
		-- unbekannte uid (fremde Insel oder veralteter Klick)
		PanelManager.close(PANEL_NAME)
		return
	end

	_openUid = uid
	fill(baerchi)

	local root = _root
	if root then root.Visible = true end
end

function BaerchiPanel.close()
	PanelManager.close(PANEL_NAME)
end

function BaerchiPanel.show(uid: string)
	-- Gehoert der Baerchi gar nicht diesem Spieler (Klick auf die Figur eines
	-- Nachbarn auf der gemeinsamen Plattform), passiert einfach nichts.
	--
	-- Frueher lief der Aufruf trotzdem durch: PanelManager.open schliesst
	-- zuerst alle anderen Panels und showInternal machte danach mangels
	-- Daten wieder zu — dem Spieler verschwand also sein gerade offenes
	-- Fenster, sobald er einen fremden Baerchi anklickte.
	if not ClientState.getBaerchi(uid) then
		return
	end

	PanelManager.open(PANEL_NAME, uid)
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function BaerchiPanel.init(screenGui: ScreenGui)
	-- Playtest 05.10.: die einspaltige Karte war zu schmal und lang. Jetzt
	-- zwei Spalten: links wer der Baerchi ist und wie er staerker wird,
	-- rechts Zustand, Werte, Eier und Aktionen.
	--
	-- Seit v8 passt der Inhalt nicht mehr garantiert in den Rahmen (Sterne,
	-- fuenf Stat-Balken, acht Charm-Slots kamen dazu). Statt die Karte immer
	-- weiter wachsen zu lassen, scrollt sie: die Mindesthoehe muss deshalb nur
	-- noch fuer eine bequem lesbare Flaeche reichen, nicht mehr fuer JEDE
	-- Zeile gleichzeitig.
	--
	-- UI-Qualitaet Schritt 2: gemeinsame Huelle (Theme.dialog) wie alle
	-- anderen Menues — passt sich kleinen Bildschirmen an, Name in der
	-- Kopfzeile, grosses Schliessen-X oben rechts. Der fruehere farbige
	-- Rarity-Streifen ist jetzt der Titelbalken selbst.
	local root = Theme.dialog(
		"BaerchiPanel", screenGui,
		Vector2.new(0.72, 0.74),
		Vector2.new(560, 400),
		Vector2.new(920, 680)
	)

	_titleLabel = Theme.dialogHeader(root, "—", function()
		BaerchiPanel.close()
	end)
	local band = root:FindFirstChild("TitleBand")
	if band and band:IsA("Frame") then
		_accentBar = band
	end

	-- Sammel-Update 2.1 wollte ein X oben rechts wie bei allen anderen
	-- Fenstern — das bringt die Kopfzeile (dialogHeader) jetzt mit.

	local shell = Theme.dialogBody(root)

	-- Zwei Spalten, jede scrollt fuer sich. `row()` haengt an die Spalte, die
	-- gerade in `column` steht (umgeschaltet vor dem Abschnitt "Zustand").
	local leftColumn = Theme.scroller("Content", shell)
	leftColumn.Size = UDim2.new(0.5, -6, 1, 0)
	local rightColumn = Theme.scroller("ContentRight", shell)
	rightColumn.Position = UDim2.new(0.5, 6, 0, 0)
	rightColumn.Size = UDim2.new(0.5, -6, 1, 0)
	for _, columnFrame in { leftColumn, rightColumn } do
		local layout = Theme.listLayout(columnFrame, 6)
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	end
	local column: ScrollingFrame = leftColumn

	local nextOrder = 0
	local function row(height: number): Frame
		nextOrder += 1
		local entry = Theme.container("Row", column)
		-- -8: Platz fuer den Scrollbalken, sonst ragt jede Zeile darunter
		-- (Konvention aus Theme.scroller).
		entry.Size        = UDim2.new(1, -8, 0, height)
		entry.LayoutOrder = nextOrder
		return entry
	end

	-- Abschnitts-Titel: bekommt den Loc-Schluessel, nicht den Text, und
	-- beschriftet sich beim Sprachwechsel neu (Loc.bind).
	local function section(key: string)
		local holder = row(16)
		local label  = Theme.sectionLabel("Section", holder, "")
		label.Size = UDim2.fromScale(1, 1)
		Loc.bind(label, key)
	end

	-- Name steht seit UI-Qualitaet Schritt 2 in der Kopfzeile (dialogHeader).

	-- HBB Paket 4: Kampfwert (eine Zahl statt fuenf Werte)
	local ratingRow = row(40)
	ratingRow.Visible = false
	local ratingLabel = Theme.label("Rating", ratingRow, "")
	ratingLabel.Size = UDim2.fromScale(1, 1)
	Theme.outlineText(ratingLabel, 3)
	local ratingLimit = ratingLabel:FindFirstChildOfClass("UITextSizeConstraint")
	if ratingLimit then ratingLimit.MaxTextSize = 36 end
	_ratingLabel = ratingLabel
	_ratingRow = ratingRow

	-- Rarity + Fusions-Badge nebeneinander
	local rarityRow = row(22)
	_rarityLabel = Theme.label("Rarity", rarityRow, "—")
	_rarityLabel.Size       = UDim2.new(0.6, 0, 1, 0)
	_rarityLabel.Font       = Theme.FONT
	_rarityLabel.TextColor3 = Theme.COLORS.accent

	local badge = Theme.panel("FusionBadge", rarityRow, Theme.COLORS.gummy)
	badge.AnchorPoint = Vector2.new(1, 0.5)
	badge.Position    = UDim2.new(1, 0, 0.5, 0)
	badge.Size        = UDim2.new(0, 76, 0, 20)
	badge.Visible     = false
	local badgeText = Theme.label("Text", badge, "")
	Loc.bind(badgeText, "ui.card.badge_fusion")
	badgeText.Size           = UDim2.fromScale(1, 1)
	badgeText.TextXAlignment = Enum.TextXAlignment.Center
	badgeText.TextColor3     = Theme.COLORS.outline
	_fusionBadge = badge

	-- Mutations-Badge (seit v11, ersetzt das binaere INVERTED-Badge). Sitzt
	-- LINKS neben dem Fusions-Badge statt an derselben Stelle: ein Baerchi
	-- kann beides gleichzeitig sein (die hoehere Mutations-Stufe zweier
	-- Inputs vererbt sich an das Fusions-Ergebnis, siehe FusionService
	-- Regel E). Etwas breiter als frueher, weil "CELESTIAL"/"BLOODROT" laenger
	-- sind als "INVERTED".
	local mutBadge = Theme.panel("MutationBadge", rarityRow, Theme.COLORS.accent)
	mutBadge.AnchorPoint = Vector2.new(1, 0.5)
	mutBadge.Position    = UDim2.new(1, -86, 0.5, 0)
	mutBadge.Size        = UDim2.new(0, 96, 0, 20)
	mutBadge.Visible     = false
	local mutText = Theme.label("Text", mutBadge, "")
	mutText.Size           = UDim2.fromScale(1, 1)
	mutText.TextXAlignment = Enum.TextXAlignment.Center
	mutText.TextColor3     = Theme.COLORS.outline
	_mutationBadge     = mutBadge
	_mutationBadgeText = mutText

	-- Level
	local levelRow = row(22)
	_levelLabel = Theme.label("Level", levelRow, "—")
	_levelLabel.Size = UDim2.fromScale(1, 1)

	-- Ausruesten: nur der ausgeruestete Baerchi steht auf dem Plot. Steht
	-- gleich unter dem Level, weil es die erste Entscheidung ist, die man bei
	-- einem neuen Baerchi trifft.
	local equipRow = row(28)
	local equip = Theme.button("Equip", equipRow, Loc.t("ui.card.equip"), Theme.COLORS.accent)
	equip.Size = UDim2.new(1, 0, 1, 0)
	_equipButton = equip
	equip.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Remotes.RequestEquipBaerchi:FireServer(uid)
	end)

	-- HBB Paket 4: "Baerchi staerker machen" — Befoerdern (unten, wie bisher)
	-- und Fusion an einer Stelle. Die Fusion oeffnet das bestehende
	-- Inventar im Fusions-Modus mit diesem Baerchi als A (Playtest 05.10.:
	-- direkt ins Fusions-Fenster ging B nicht auszuwaehlen).
	local upgradeRow = row(34)
	upgradeRow.Visible = false
	local fuse = Theme.button("UpgradeFuse", upgradeRow, "⬆ + 🐻", Theme.COLORS.gummy)
	fuse.Size = UDim2.new(1, 0, 1, 0)
	fuse.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Unlock.markSeen("tab_upgrade")
		-- Auswahl des zweiten Baerchis passiert im Inventar (Fusions-Modus)
		PanelManager.open("Inventory", "Fuse", uid)
	end)
	_upgradeRow = upgradeRow

	-- ---------------------------------------------------------------- Promotion
	section("ui.card.section_promotion")

	-- Fuenf Sterne. Zehn Stufen werden darauf abgebildet, indem die Sterne ein
	-- zweites Mal umgefaerbt werden (siehe PromotionConfig.getStarStates) —
	-- diese Umrechnung passiert dort, nicht hier.
	local starRow = row(26)
	local starLayout = Theme.listLayout(starRow, 6, true)
	starLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	for index = 1, PromotionConfig.STAR_COUNT do
		local star = Theme.panel("Star_" .. index, starRow, PromotionConfig.STAR_COLORS.empty)
		star.Size        = UDim2.new(0, 26, 0, 26)
		star.LayoutOrder = index
		Theme.corner(star, 13)
		table.insert(_stars, star)
	end

	local promoteHintRow = row(30)
	_promoteHint = Theme.bodyText("PromoteHint", promoteHintRow, "")
	_promoteHint.Size = UDim2.fromScale(1, 1)

	local promoteRow = row(32)
	local promote = Theme.button("Promote", promoteRow, Loc.t("ui.card.promote"), Theme.COLORS.goldGummy)
	promote.Size = UDim2.new(1, 0, 1, 0)
	_promoteButton = promote
	promote.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Remotes.RequestPromoteBaerchi:FireServer(uid)
	end)

	-- ------------------------------------------------------------ Battle Charms
	section("ui.card.section_charms")

	local charmRow = row(30)
	local charmLayout = Theme.listLayout(charmRow, 4, true)
	charmLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	for slot = 1, CharmConfig.SLOT_COUNT do
		local tile = Theme.panel("Charm_" .. slot, charmRow, Theme.COLORS.disabled)
		tile.Size        = UDim2.new(0, 28, 0, 28)
		tile.LayoutOrder = slot
		Theme.corner(tile, 8)

		local letter = Theme.label("Letter", tile, "-")
		letter.Size           = UDim2.fromScale(1, 1)
		letter.TextXAlignment = Enum.TextXAlignment.Center
		letter.TextScaled     = false
		letter.TextSize       = 14

		table.insert(_charmSlots, { tile = tile, letter = letter })
	end

	local charmButtonRow = row(30)
	local charms = Theme.button("Charms", charmButtonRow, "", Theme.COLORS.growth)
	charms.Size = UDim2.new(1, 0, 1, 0)
	_charmButton = charms
	charms.Activated:Connect(function()
		Unlock.markSeen("charms")
		local uid = _openUid
		if not uid then return end
		PanelManager.open("Charms", uid)
	end)

	-- ------------------------------------------------------------------- Werte
	column = rightColumn
	section("ui.baerchi.section_state")

	-- HP-Balken (steht bewusst ueber dem XP-Balken: ob der Baerchi kaempfen
	-- kann, ist die haeufigere Frage als wie weit er zum naechsten Level ist)
	local hpRow = row(22)
	local hp = Theme.progress(hpRow)
	hp.track.Size = UDim2.new(1, 0, 1, 0)
	_hpFill = hp.fill
	_hpText = hp.text

	-- XP-Balken
	local xpRow = row(22)
	local xp = Theme.progress(xpRow)
	xp.track.Size = UDim2.new(1, 0, 1, 0)
	_xpFill = xp.fill
	_xpText = xp.text

	-- HBB Paket 4: Einzelwerte (ATK/SPD/PWR) und Stat-Stufen in einem
	-- Aufklapper. Der Kampfwert oben ist die eine Zahl, die man meistens
	-- braucht; wer es genau wissen will, klappt auf. Ohne UI_V2_UPGRADE_TAB
	-- bleibt alles offen wie bisher.
	local detailRows: { Frame } = {}
	local toggleRow = row(26)
	local toggle = Theme.button("DetailsToggle", toggleRow, "", Theme.COLORS.panelLight)
	toggle.Size = UDim2.fromScale(1, 1)
	toggle.TextColor3 = Theme.COLORS.text
	local expanded = not FeatureFlags.isOn("UI_V2_UPGRADE_TAB")
	toggleRow.Visible = not expanded
	local function applyDetails()
		toggle.Text = (if expanded then "▾  " else "▸  ") .. Loc.t("ui.card.details")
		for _, detail in detailRows do
			detail.Visible = expanded
		end
	end
	toggle.Activated:Connect(function()
		expanded = not expanded
		applyDetails()
	end)

	-- Kampfwerte
	local statsRow = row(22)
	table.insert(detailRows, statsRow)
	_statsLabel = Theme.label("Stats", statsRow, "—")
	_statsLabel.Size      = UDim2.new(1, -34, 1, 0)
	_statsLabel.TextColor3 = Theme.COLORS.textDim

	-- Sammel-Update 05.10. (Paket 3.7, "Stats sind unintuitiv"): "?" zeigt
	-- je Stat einen kurzen Satz. Kein Dauertext, nur auf Antippen.
	local statHelpButton = Theme.button("StatHelp", statsRow, "?", Theme.COLORS.panelLight)
	statHelpButton.AnchorPoint = Vector2.new(1, 0.5)
	statHelpButton.Position = UDim2.new(1, 0, 0.5, 0)
	statHelpButton.Size = UDim2.fromOffset(30, 22)
	statHelpButton.TextColor3 = Theme.COLORS.text
	local helpRow = row(96)
	helpRow.Visible = false
	local helpText = Theme.bodyText("StatHelpText", helpRow, Loc.t("ui.stats.help"))
	helpText.Size = UDim2.fromScale(1, 1)
	helpText.TextColor3 = Theme.COLORS.text
	statHelpButton.Activated:Connect(function()
		helpText.Text = Loc.t("ui.stats.help")
		helpRow.Visible = not helpRow.Visible
	end)

	-- ------------------------------------------------------------- Stat-Level
	local statHeader = row(16)
	table.insert(detailRows, statHeader)
	local statHeaderLabel = Theme.sectionLabel("Section", statHeader, Loc.t("ui.stats.levels_head"))
	statHeaderLabel.Size = UDim2.fromScale(1, 1)

	for _, key in PromotionConfig.ALL_STATS do
		local statRow = row(20)
		table.insert(detailRows, statRow)
		local bar     = Theme.progress(statRow)
		bar.track.Size = UDim2.new(1, 0, 1, 0)
		bar.text.TextScaled = false
		bar.text.TextSize   = 13

		table.insert(_statRows, { key = key, fill = bar.fill, text = bar.text })
	end
	applyDetails()

	-- Skill
	section("ui.card.section_skill")
	local skillRow = row(40)
	_skillLabel = Theme.bodyText("Skill", skillRow, "—")
	_skillLabel.Size = UDim2.fromScale(1, 1)

	-- -------------------------------------------------------------------- Eier
	section("ui.baerchi.section_eggs")

	local eggRateRow = row(20)
	_eggRateLabel = Theme.label("EggRate", eggRateRow, "")
	_eggRateLabel.Size       = UDim2.fromScale(1, 1)
	_eggRateLabel.TextScaled = false
	_eggRateLabel.TextSize   = 14

	local eggChanceRow = row(20)
	_eggChanceLabel = Theme.label("EggChances", eggChanceRow, "")
	_eggChanceLabel.Size       = UDim2.fromScale(1, 1)
	_eggChanceLabel.TextScaled = false
	_eggChanceLabel.TextSize   = 13
	_eggChanceLabel.TextColor3 = Theme.COLORS.textDim

	local eggCountRow = row(18)
	_eggCountLabel = Theme.label("EggCount", eggCountRow, "")
	_eggCountLabel.Size       = UDim2.fromScale(1, 1)
	_eggCountLabel.TextScaled = false
	_eggCountLabel.TextSize   = 13

	local collectRow = row(30)
	local collect = Theme.button("CollectEggs", collectRow, Loc.t("ui.baerchi.collect_none"), Theme.COLORS.goldGummy)
	collect.Size = UDim2.new(1, 0, 1, 0)
	_collectButton = collect
	collect.Activated:Connect(function()
		-- Ohne uid: der Server nimmt alles, was gerade herumliegt. Einzelne
		-- Eier sammelt man durch Anklicken in der Welt ein (WorldController).
		Remotes.RequestCollectAllEggs:FireServer()
	end)

	-- ----------------------------------------------------------------- Aktionen
	section("ui.baerchi.section_actions")

	-- Verwertungs-Wert
	local valueRow = row(20)
	_valueLabel = Theme.label("Value", valueRow, "—")
	_valueLabel.Size       = UDim2.fromScale(1, 1)
	_valueLabel.TextColor3 = Theme.COLORS.textDim

	-- Ein Fuetter-Knopf pro Gebaeude statt eines einzigen: die drei liefern
	-- unterschiedlichen Honig, und welchen man verfuettert, ist seit v7 eine
	-- echte Entscheidung. Reihenfolge und Namen kommen aus MapConfig, die
	-- Farben aus Theme — dieselben wie auf den Karten im Gebaeude-Panel, damit
	-- man Knopf und Gebaeude sofort zusammenbringt.
	-- Sammel-Update 2.6: kein "Honig essen"-Klicken mehr (der Baerchi isst am
	-- Teich von selbst). Zeile und Knoepfe bleiben gebaut, aber unsichtbar —
	-- fill() greift weiter auf _feedButtons zu.
	local feedHint = row(18)
	feedHint.Visible = false
	local hint = Theme.label("FeedHint", feedHint, "")
	hint.Size       = UDim2.fromScale(1, 1)
	hint.TextColor3 = Theme.COLORS.textDim

	local feedRow = row(38)
	feedRow.Visible = false   -- Sammel-Update 2.6
	Theme.listLayout(feedRow, 6, true)

	for _, id in MapConfig.BUILDING_ORDER do
		-- Text und Verfuegbarkeit setzt fill() — hier steht nur ein Platzhalter,
		-- damit der Knopf nicht ohne Beschriftung aufblitzt.
		local button = Theme.button("Feed_" .. id, feedRow, "—", Theme.buildingColor(id))
		button.Size = UDim2.new(1 / 3, -6, 1, 0)

		button.Activated:Connect(function()
			local uid = _openUid
			if not uid then return end
			Remotes.RequestFeedHoney:FireServer(uid, id)
		end)

		_feedButtons[id] = button
	end

	-- Verwerten und Schliessen: beides beendet die Karte
	local exitRow = row(36)

	local recycle = Theme.button("Recycle", exitRow, Loc.t("ui.baerchi.recycle"), Theme.COLORS.panelLight)
	recycle.Size       = UDim2.new(1, 0, 1, 0)
	recycle.TextColor3 = Theme.COLORS.text
	_recycleButton = recycle
	recycle.Activated:Connect(function()
		Unlock.markSeen("recycling")
		local uid = _openUid
		if not uid then return end

		Remotes.RequestRecycleBaerchi:FireServer(uid)

		-- Sofort zumachen: bei Erfolg waere die Karte gleich leer, bei
		-- Ablehnung sagt es der Toast. Die Erfolgsmeldung kommt aus
		-- ResultFeed (RecycleResultReceived).
		BaerchiPanel.close()
	end)

	-- Schliessen
	local closeRow = row(34)
	local close = Theme.button("Close", closeRow, Loc.t("ui.common.close"), Theme.COLORS.panelLight)
	close.Size       = UDim2.new(1, 0, 1, 0)
	close.TextColor3 = Theme.COLORS.text
	close.Activated:Connect(BaerchiPanel.close)

	_root = root

	PanelManager.register(PANEL_NAME, {
		open  = showInternal,
		close = closeInternal,
	})

	-- Offene Karte mitziehen: XP steigt im Kampf, und ein verwerteter oder
	-- fusionierter Baerchi existiert nicht mehr — dann zumachen.
	ClientState.onChanged(function()
		local uid = _openUid
		if not uid then return end

		local baerchi = ClientState.getBaerchi(uid)
		if baerchi then
			fill(baerchi)
		else
			BaerchiPanel.close()
		end
	end)

	-- Sprachwechsel bei offener Karte: alle Texte aus fill() neu setzen
	Loc.onChanged(function()
		local uid = _openUid
		local baerchi = if uid then ClientState.getBaerchi(uid) else nil
		if baerchi then fill(baerchi) end
	end)

	Remotes.PromotionResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.PromotionResult

		if #typed.unlockedSlots > 0 then
			local numerals: { string } = {}
			for _, slot in typed.unlockedSlots do
				table.insert(numerals, CharmConfig.SLOT_NUMERALS[slot] or tostring(slot))
			end

			Notify.emit("promotion_slot", function()
				Toast.success(Loc.t("msg.promo_slot", {
					p = typed.newPromotion, max = PromotionConfig.MAX_PROMOTION,
					slots = table.concat(numerals, ", "),
				}))
			end, function()
				Moment.show("slot", Theme.COLORS.goldGummy, "ui.moment.new")
			end)
		else
			Notify.emit("promotion", function()
				Toast.success(Loc.t("msg.promo", { p = typed.newPromotion, max = PromotionConfig.MAX_PROMOTION }))
			end, function()
				Feedback.gain("star", typed.newPromotion)
			end)
		end
	end)

	Remotes.EggCollectedReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.EggCollectResult
		local eggName = Names.egg(typed.eggType)

		-- Leere eggUid heisst "alles auf einmal" (siehe EggLayService.collectAll):
		-- dann steht in inStock die ANZAHL der eingesammelten Eier, nicht der
		-- Lagerbestand einer Sorte.
		-- Neuer Weg: das Ei fliegt ueber den Datenstand zur Eier-Kachel
		-- (UI/Feedback), deshalb hier nur der alte Text.
		if typed.eggUid == "merchant" then
			-- Kauf beim versteckten Haendler (EggMerchantService)
			Notify.emit("egg_bought", function()
				Toast.success(Loc.t("msg.egg_bought", {
					egg = Names.egg(typed.eggType) }))
			end)
		elseif typed.eggUid == "" then
			Notify.emit("egg_collected_all", function()
				Toast.success(Loc.t("msg.eggs_collected_all", { n = typed.inStock }))
			end)
		else
			Notify.emit("egg_collected", function()
				Toast.success(Loc.t("msg.egg_collected", {
					egg = Names.egg(typed.eggType),
					n   = typed.inStock,
				}))
			end)
		end
	end)

	Remotes.OfflineEggReportReceived.OnClientEvent:Connect(function(report: any)
		if typeof(report) ~= "table" then return end
		local typed = report :: Types.OfflineEggReport

		Notify.emit("offline_eggs", function()
			-- Paket 6.1: "Lager voll", wenn die Offline-Grenze gegriffen hat
			if typed.laid <= 0 then
				Toast.info(Loc.t("msg.offline_eggs_full"))
			elseif typed.skipped then
				Toast.success(Loc.t("msg.offline_eggs", { n = typed.laid }) .. "  " .. Loc.t("msg.offline_eggs_full"))
			else
				Toast.success(Loc.t("msg.offline_eggs", { n = typed.laid }))
			end
		end, function()
			if typed.laid > 0 then
				ReturnSummary.addEggs(typed.secondsAway, typed.laid)
			end
		end)
	end)

	Remotes.EventStatGained.OnClientEvent:Connect(function(gain: any)
		if typeof(gain) ~= "table" then return end
		local typed = gain :: Types.EventStatGain

		-- Zwischenmeldung waehrend eines Events: nur der Text, kein "vorbei".
		if typed.midEvent then
			if typed.rarityUp then
				local rarity = typed.rarityUp :: string
				Notify.emit("event_mid_rarity", function()
					Toast.success(Loc.resolve(typed.bonusText or ""))
				end, function()
					Moment.show("rarity", Theme.rarityColor(rarity :: any), "ui.moment.rarity")
				end)
			elseif typed.bonusText then
				local text = typed.bonusText :: any
				Notify.emit("event_mid", function()
					Toast.info(Loc.resolve(text))
				end)
			end
			return
		end

		-- Die Meldung wird aus bis zu zwei Teilen zusammengesetzt: Stat-Stufe
		-- und Bonus. Beide koennen einzeln fehlen — `statKey` ist nil, wenn
		-- schon jeder Stat am Rarity-Cap steht (dann gab es nur den Bonus),
		-- `bonusText` fehlt bei den reinen Trainings-Events. Deshalb hier
		-- zusammensetzen statt eines festen Satzes.
		local eventDef  = EventConfig.getById(typed.eventId)
		local eventName = Names.event(typed.eventId)

		local parts: { string } = {}

		local statKey = typed.statKey
		if statKey then
			table.insert(parts, Loc.t("msg.event.stat_level", {
				stat = PromotionConfig.STAT_LABELS[statKey] or statKey,
				level = typed.newLevel, cap = typed.cap,
			}))
		end

		if typed.bonusText then
			table.insert(parts, Loc.resolve(typed.bonusText))
		end

		if #parts == 0 then
			table.insert(parts, Loc.t("msg.event.all_maxed"))
		end

		-- HBB Paket 1: neuer Weg = Mutation als grosser Moment, Stat-Stufe
		-- als Zahl ueber dem Baerchi. Eier/Gummies des Bonus fliegen ueber
		-- den Datenstand (UI/Feedback).
		Notify.emit("event_end", function()
			Toast.success(Loc.t("msg.event.ended", { event = eventName, text = table.concat(parts, "  •  ") }))
		end, function()
			local mutation = typed.mutation
			if mutation then
				Notify.emit("event_end_mutation", function() end, function()
					Moment.show("mutation", BaerchiConfig.getMutationColor(mutation), "ui.moment.mutation")
				end)
			end
			if statKey then
				Feedback.gain("stat", 1, nil, PromotionConfig.STAT_LABELS[statKey] or statKey)
			end
		end)
	end)

	print("[BaerchiPanel] Initialisiert")
end

return BaerchiPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">BuildingPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- BuildingPanel.luau
-- StarterPlayerScripts/UI/BuildingPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Fuer JEDES Honig-Gebaeude ein eigenes Menue bauen und aktuell halten
--
-- v15: zwei Gebaeude (Bienenstock, Honig-Veredler), Level 1-60 mit Look-Stufe
-- und Meilenstein-Faehigkeiten. Das fruehere Menue der Kampfplattform
-- (PIT-Level) ist entfallen — die Tower-Wahl liegt im CombatPanel. Der Recycler
-- wird an seinem eigenen Prompt ausgebaut (CombController).
--
-- ============================================================
-- WARUM EIGENE MENUES STATT EINER LISTE
-- ============================================================
-- Bis v7 gab es EIN Panel mit drei untereinander gestapelten Karten. Das war
-- richtig, solange die drei Gebaeude dasselbe taten — man wollte sie ja
-- vergleichen. Seit jedes eine eigene Rolle hat (Vorrat / Heilung / Wachstum,
-- siehe Config/BuildingBehavior), vergleicht man nicht mehr, sondern
-- entscheidet sich: "ich brauche jetzt Heilung". Dafuer will man EIN Fenster
-- sehen, das ganz diesem Gebaeude gehoert — mit seiner Farbe, seinem Level und
-- seinem Honig, gross statt in einer Zeile.
--
-- Trotzdem gibt es nur DIESE eine Datei: sie baut viermal dasselbe Geruest mit
-- unterschiedlichen Farben und Inhalten. Drei fast gleiche Panel-Module waeren
-- dieselbe Dopplung, die dieses Projekt an anderen Stellen schon aufgeloest
-- hat.
--
-- Jedes Menue meldet sich unter PanelManager.buildingPanelName(id) an. Diesen
-- Namen benutzen auch die Menueleiste und der Prompt am Gebaeude in der Welt —
-- deshalb steht er im PanelManager und nicht hier.
--
-- ============================================================
-- OHNE HINLAUFEN BEDIENBAR
-- ============================================================
-- Jedes Menue kann BEIDES: ausbauen und den ausgeruesteten Baerchi mit dem
-- Honig genau dieses Gebaeudes fuettern. Zusammen mit den Knoepfen in der
-- Menueleiste heisst das: der Spieler muss zu keinem Gebaeude mehr hinlaufen.
-- Die Prompts in der Welt bleiben trotzdem — wer davorsteht, soll es auch
-- dort anklicken koennen.
--
-- Dieses Modul rechnet nichts aus und formuliert nichts selbst: Effekt-Saetze
-- kommen aus BuildingBehavior, Preise aus EconomyConfig, Namen aus MapConfig,
-- Farben aus Theme. Ein hier nachgebauter Text waere beim naechsten Balancing
-- sofort falsch.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local Names            = require(ReplicatedStorage.Localization.Names)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local MapConfig        = require(ReplicatedStorage.Config.MapConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local BuildingPanel = {}

-- Feste Reihenfolge. Die Gebaeude in IslandData liegen in einer Hash-Tabelle
-- und kommen damit nicht stabil heraus.
--
-- Nur die ids stehen hier: Name kommt aus MapConfig (dasselbe Schild traegt
-- ihn in der Welt), Farbe aus Theme.buildingColor (dieselbe faerbt die
-- Fuetter-Knoepfe auf der Baerchi-Karte).
local BUILDINGS: { { id: Types.BuildingId } } = {
	{ id = "Beehive"      },
	{ id = "HoneyRefiner" },
	{ id = "HoneyPond"    },
}

-- Alles, was ein einzelnes Menue zum Aktualisieren braucht.
type Menu = {
	root       : Frame,
	title      : TextLabel,
	levelBadge : TextLabel,
	subLabel   : TextLabel,
	honeyFill  : Frame,
	honeyText  : TextLabel,
	nowText    : TextLabel,
	nextText   : TextLabel,
	priceText  : TextLabel,
	abilities  : TextLabel,
	upgrade    : TextButton,
	feed       : TextButton?,
}

local _menus: { [string]: Menu } = {}

--------------------------------------------------------------------------------
-- Hilfstexte
--------------------------------------------------------------------------------

local function displayName(buildingId: string): string
	return Names.building(buildingId)
end

-- v15: Meilenstein-Faehigkeiten als eine Zeile ("Lv.10 Auto-Abnahme ✓ ·
-- Lv.30 Goldene Tropfen (bald)").
local function abilitiesText(buildingId: string, level: number): string
	local parts: { string } = {}
	for _, ability in BuildingBehavior.getAbilities(buildingId) do
		local name = Loc.t("ability." .. ability.id)
		local state = if not ability.implemented then Loc.t("ui.ability.soon")
			elseif level >= ability.level then "✓"
			else ""
		table.insert(parts, string.format("Lv.%d %s %s", ability.level, name, state))
	end
	return table.concat(parts, "  ·  ")
end

local function priceText(costGummies: number, costGoldGummies: number): string
	local parts: { string } = {}

	if costGummies > 0 then
		table.insert(parts, Loc.t("event.bonus.gummies", { n = costGummies }))
	end
	if costGoldGummies > 0 then
		table.insert(parts, Loc.t("event.bonus.gold", { n = costGoldGummies }))
	end
	if #parts == 0 then
		return Loc.t("ui.common.free")
	end

	return table.concat(parts, " + ")
end

local function canPay(data: Types.PlayerDataUpdate, costGummies: number, costGoldGummies: number): boolean
	if costGummies > 0 and data.gummies < costGummies then return false end
	if costGoldGummies > 0 and data.goldGummies < costGoldGummies then return false end
	return true
end

--------------------------------------------------------------------------------
-- Das Geruest eines Menues
--------------------------------------------------------------------------------

-- Baut ein Menue in der Farbe `accent`. `withFeed` legt zusaetzlich den
-- Fuetter-Knopf an — die Kampfplattform hat keinen Honig.
local function buildMenu(
	screenGui: ScreenGui,
	panelName: string,
	title: string,
	accent: Color3,
	withFeed: boolean,
	onUpgrade: () -> (),
	onFeed: (() -> ())?
): Menu
	local root = Theme.dialog(
		panelName, screenGui,
		Vector2.new(0.40, 0.62),
		Vector2.new(300, 400),
		Vector2.new(440, 520)
	)

	-- Der Rand des ganzen Fensters traegt die Gebaeudefarbe: schon bevor man
	-- liest, sieht man welches Gebaeude offen ist.
	local outline = root:FindFirstChildOfClass("UIStroke")
	if outline then
		outline.Color = Theme.shade(accent, -0.35)
	end

	--------------------------------------------------------------------------
	-- Kopfbalken mit Verlauf
	--------------------------------------------------------------------------

	local header = Theme.panel("Banner", root, accent)
	header.Size     = UDim2.new(1, 0, 0, 74)
	header.Position = UDim2.fromScale(0, 0)
	Theme.gradient(header, Theme.shade(accent, 0.30), Theme.shade(accent, -0.18))

	-- Rundes Emblem mit der Stufe darin. Zwei Fliegen: es macht den Kopf bunt
	-- UND beantwortet die haeufigste Frage ("auf welcher Stufe bin ich?"),
	-- ohne dass man Text lesen muss.
	local badge = Theme.panel("Badge", header, Theme.shade(accent, -0.30))
	badge.AnchorPoint = Vector2.new(0, 0.5)
	badge.Position    = UDim2.new(0, 12, 0.5, 0)
	badge.Size        = UDim2.new(0, 50, 0, 50)
	Theme.corner(badge, 25)

	local levelBadge = Theme.label("Level", badge, "1")
	levelBadge.Size           = UDim2.fromScale(1, 1)
	levelBadge.TextXAlignment = Enum.TextXAlignment.Center

	local titleLabel = Theme.label("Title", header, title)
	titleLabel.Position   = UDim2.new(0, 72, 0, 12)
	titleLabel.Size       = UDim2.new(1, -118, 0, 30)
	titleLabel.TextColor3 = Theme.COLORS.outline

	local subLabel = Theme.sectionLabel("Sub", header, "", Theme.shade(accent, -0.45))
	subLabel.Position = UDim2.new(0, 72, 0, 42)
	subLabel.Size     = UDim2.new(1, -118, 0, 20)

	-- Gemeinsamer Schliessen-Knopf (grosse Trefferflaeche), oben rechts im Kopf
	local close = Theme.closeButton(header, function()
		PanelManager.close(panelName)
	end, Theme.shade(accent, -0.30))
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position    = UDim2.new(1, -10, 0, 10)

	--------------------------------------------------------------------------
	-- Inhalt
	--------------------------------------------------------------------------

	local body = Theme.container("Body", root)
	body.Position = UDim2.new(0, 0, 0, 74)
	body.Size     = UDim2.new(1, 0, 1, -74)
	Theme.padding(body, 14)

	local layout = Theme.listLayout(body, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local order = 0
	local function row(height: number): Frame
		order += 1
		local frame = Theme.container("Row", body)
		frame.Size        = UDim2.new(1, 0, 0, height)
		frame.LayoutOrder = order
		return frame
	end

	-- Sammel-Update 3.6: ein Satz, was Verbessern bringt
	local whyRow = row(34)
	local whyText = Theme.bodyText("Why", whyRow, Loc.t("ui.building.why"))
	whyText.Size = UDim2.fromScale(1, 1)
	whyText.TextColor3 = Theme.COLORS.goldGummy
	Loc.onChanged(function() whyText.Text = Loc.t("ui.building.why") end)

	-- Honig-Balken: der Wert, den man beim Reinschauen zuerst sucht.
	local honeyHead = row(18)
	Theme.sectionLabel("HoneyHead", honeyHead, Loc.t("ui.building.honey_head"), accent).Size = UDim2.fromScale(1, 1)

	local honeyRow  = row(26)
	local honeyBar  = Theme.progress(honeyRow, accent)
	honeyBar.track.Size = UDim2.new(1, 0, 1, 0)

	-- Was das Gebaeude JETZT kann
	local nowHead = row(18)
	Theme.sectionLabel("NowHead", nowHead, Loc.t("ui.building.now_head"), accent).Size = UDim2.fromScale(1, 1)

	local nowRow  = row(38)
	local nowText = Theme.bodyText("Now", nowRow, "")
	nowText.Size      = UDim2.fromScale(1, 1)
	nowText.TextColor3 = Theme.COLORS.text

	-- Was die naechste Stufe braechte
	local nextHead = row(18)
	Theme.sectionLabel("NextHead", nextHead, Loc.t("ui.building.next_head"), accent).Size = UDim2.fromScale(1, 1)

	local nextRow  = row(38)
	local nextText = Theme.bodyText("Next", nextRow, "")
	nextText.Size = UDim2.fromScale(1, 1)

	local priceRow   = row(22)
	local priceLabel = Theme.label("Price", priceRow, "")
	priceLabel.Size     = UDim2.fromScale(1, 1)
	priceLabel.TextSize = 16
	priceLabel.TextScaled = false

	-- v15: Meilenstein-Faehigkeiten dieses Gebaeudes
	local abilityRow  = row(30)
	local abilityText = Theme.bodyText("Abilities", abilityRow, "")
	abilityText.Size       = UDim2.fromScale(1, 1)
	abilityText.TextColor3 = Theme.COLORS.textDim

	-- Die Knoepfe ganz unten, in der Reihenfolge, in der man sie braucht.
	local upgradeRow = row(44)
	local upgrade    = Theme.bigButton("Upgrade", upgradeRow, Loc.t("ui.building.upgrade_button"), accent)
	upgrade.Size = UDim2.new(1, 0, 1, 0)
	upgrade.Activated:Connect(onUpgrade)

	local feedButton: TextButton? = nil
	if withFeed and onFeed then
		local feedRow = row(38)
		local feed    = Theme.bigButton("Feed", feedRow, Loc.t("ui.building.feed", { n = 0 }), Theme.shade(accent, -0.10))
		feed.Size = UDim2.new(1, 0, 1, 0)
		feed.Activated:Connect(onFeed)
		feedButton = feed
	end

	return {
		root       = root,
		title      = titleLabel,
		levelBadge = levelBadge,
		subLabel   = subLabel,
		honeyFill  = honeyBar.fill,
		honeyText  = honeyBar.text,
		nowText    = nowText,
		nextText   = nextText,
		priceText  = priceLabel,
		abilities  = abilityText,
		upgrade    = upgrade,
		feed       = feedButton,
	}
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

local function refreshBuilding(buildingId: Types.BuildingId)
	local menu = _menus[PanelManager.buildingPanelName(buildingId)]
	if not menu or not menu.root.Visible then return end

	local data = ClientState.get()
	if not data then return end

	local building = data.island.buildings[buildingId]
	local level    = if building then building.level else 1
	local honey    = if building then (building.honey or 0) else 0
	local capacity = math.max(1, BuildingBehavior.getCapacity(buildingId, level))

	menu.levelBadge.Text = tostring(level)
	menu.subLabel.Text   = Loc.t("ui.building.level_look", {
		level = level, max = EconomyConfig.MAX_BUILDING_LEVEL, look = BuildingBehavior.getLook(level),
	})
	menu.abilities.Text  = abilitiesText(buildingId, level)

	menu.honeyFill.Size = UDim2.fromScale(math.clamp(honey / capacity, 0, 1), 1)
	menu.honeyText.Text = string.format("%d / %d", honey, capacity)

	menu.nowText.Text = BuildingBehavior.describeEffect(buildingId, level)

	local next_ = BuildingBehavior.getUpgrade(buildingId, level + 1)

	if next_ then
		local affordable = canPay(data, next_.costGummies, next_.costGoldGummies)

		menu.nextText.Text   = next_.effect
		menu.priceText.Text  = priceText(next_.costGummies, next_.costGoldGummies)
		menu.priceText.TextColor3 = if affordable then Theme.COLORS.good else Theme.COLORS.bad

		menu.upgrade.Text = Loc.t("ui.building.upgrade_button")
		Theme.setEnabled(menu.upgrade, affordable)
	else
		menu.nextText.Text        = Loc.t("ui.building.max")
		menu.priceText.Text       = ""
		menu.upgrade.Text         = Loc.t("ui.building.maxed_button")
		Theme.setEnabled(menu.upgrade, false)
	end

	local feed = menu.feed
	if feed then
		feed.Text = Loc.t("ui.building.feed", { n = honey })
		Theme.setEnabled(feed, honey > 0 and data.island.equippedUid ~= nil)
	end
end

-- Oeffentlich, damit ClientState alle Menues auf einmal nachziehen kann.
function BuildingPanel.refresh()
	for _, entry in BUILDINGS do
		refreshBuilding(entry.id)
	end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function BuildingPanel.init(screenGui: ScreenGui)
	for _, entry in BUILDINGS do
		local id        = entry.id
		local panelName = PanelManager.buildingPanelName(id)

		-- Sammel-Update 2.6: kein "Honig fuettern"-Knopf mehr — der Baerchi
		-- isst selbst (BaerchiAutopilotService). RequestFeedHoney bleibt als
		-- Remote bestehen, nur die Oberflaeche dazu entfaellt.
		local menu = buildMenu(
			screenGui, panelName, displayName(id), Theme.buildingColor(id), false,
			function()
				Remotes.RequestUpgradeBuilding:FireServer(id)
			end,
			function()
				-- Gefuettert wird immer der ausgeruestete Baerchi: nur der steht
				-- in der Welt, und nur er kaempft. Wer einen anderen meint,
				-- ruestet ihn erst aus — dieselbe Regel wie beim Autopiloten.
				local data = ClientState.get()
				local uid  = if data then data.island.equippedUid else nil
				if not uid then return end

				Remotes.RequestFeedHoney:FireServer(uid, id)
			end
		)

		_menus[panelName] = menu

		PanelManager.register(panelName, {
			open = function()
				menu.root.Visible = true
				refreshBuilding(id)
			end,
			close = function()
				menu.root.Visible = false
			end,
		})
	end

	ClientState.onChanged(function()
		BuildingPanel.refresh()
	end)
	-- Sprachwechsel: Titel und alle Zeilen der offenen Menues neu beschriften
	Loc.onChanged(function()
		for _, entry in BUILDINGS do
			local menu = _menus[PanelManager.buildingPanelName(entry.id)]
			if menu then menu.title.Text = displayName(entry.id) end
		end
		BuildingPanel.refresh()
	end)

	print("[BuildingPanel] Initialisiert |", #BUILDINGS, "Gebaeude-Menues")
end

return BuildingPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">CharmPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- CharmPanel.luau
-- StarterPlayerScripts/UI/CharmPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die acht Battle-Charm-Slots eines Baerchis zeigen
--   - Einzelne Slots sperren/freigeben und alle offenen neu wuerfeln
--
-- Wird aus der Baerchi-Detailkarte geoeffnet (Knopf "Charms") und bekommt die
-- uid dabei uebergeben — genau wie BaerchiPanel selbst. Eigene Auswahl haelt
-- dieses Panel nicht.
--
-- ============================================================
-- WAS DIE "PROMOTION TIERS"-LISTE HIER IST — UND WAS NICHT
-- ============================================================
-- Sie zeigt AUSSCHLIESSLICH, ab welcher Promotions-Stufe ein Slot benutzbar
-- wird. Sie sagt NICHT, welcher Stat in einem Slot sitzt: die Slots sind nicht
-- an einen Stat-Typ gebunden, jeder Wurf wuerfelt Rarity UND Stat neu (siehe
-- CharmConfig, Kopf-Kommentar). Wer hier eine Spalte "Bonus" vermisst: die
-- gibt es bewusst nicht.
--
-- Der Server bleibt in jedem Fall autoritativ. Ausgegraute Knoepfe sind nur
-- die freundliche Vorwarnung — abgelehnt wird serverseitig (→ Toast).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Loc             = require(ReplicatedStorage.Localization.Loc)   -- Sammel-Update 2.4
local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local CharmConfig     = require(ReplicatedStorage.Config.CharmConfig)
local PromotionConfig = require(ReplicatedStorage.Config.PromotionConfig)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Loc          = require(ReplicatedStorage.Localization.Loc)
local Names        = require(ReplicatedStorage.Localization.Names)

local CharmPanel = {}

local PANEL_NAME = "Charms"

local _root: Frame?          = nil
local _openUid: string?      = nil
local _titleLabel: TextLabel? = nil
local _hintLabel: TextLabel?  = nil
local _costLabel: TextLabel?  = nil
local _rollButton: TextButton? = nil
local _autoButton: TextButton? = nil

-- Ein Eintrag pro Slot: der Knopf (= Sperr-Umschalter) und seine Beschriftung.
type SlotWidget = {
	slot    : number,
	button  : TextButton,
	letter  : TextLabel,
	lockDot : Frame,
	detail  : TextLabel,
}

local _slots: { SlotWidget } = {}

--------------------------------------------------------------------------------
-- Lesen
--------------------------------------------------------------------------------

local function findCharm(baerchi: Types.Baerchi, slot: number): Types.Charm?
	-- `or {}`: ein Datenpaket von einem aelteren Serverstand haette das Feld
	-- nicht. Die Zuweisung an eine typisierte Variable statt direkt in die
	-- Schleife, damit der Typ dabei nicht verloren geht.
	local charms: { Types.Charm } = baerchi.charms or {}

	for _, charm in charms do
		if charm.slot == slot then
			return charm
		end
	end
	return nil
end

-- Dieselbe Bedingung, nach der CharmService.getRollableSlots wuerfelt.
local function countRollable(baerchi: Types.Baerchi): number
	local count = 0
	for slot = 1, CharmConfig.SLOT_COUNT do
		if CharmConfig.isSlotUnlocked(slot, baerchi.promotionLevel or 0) then
			local charm = findCharm(baerchi, slot)
			if not (charm and charm.locked) then
				count += 1
			end
		end
	end
	return count
end

--------------------------------------------------------------------------------
-- Fuellen
--------------------------------------------------------------------------------

local function fill(baerchi: Types.Baerchi)
	local data      = ClientState.get()
	local promotion = baerchi.promotionLevel or 0

	if _titleLabel then
		_titleLabel.Text = Loc.t("ui.charm.title_baerchi", {
			name = Names.baerchi(baerchi.configId),
			p    = promotion,
			max  = PromotionConfig.MAX_PROMOTION,
		})
	end

	for _, widget in _slots do
		local unlocked = CharmConfig.isSlotUnlocked(widget.slot, promotion)
		local charm    = if unlocked then findCharm(baerchi, widget.slot) else nil

		if not unlocked then
			widget.button.BackgroundColor3 = Theme.COLORS.disabled
			widget.letter.Text             = "-"
			widget.letter.TextColor3       = Theme.COLORS.textDim
			widget.lockDot.Visible         = false
			widget.detail.Text = Loc.t("ui.charm.unlock_at", { n = CharmConfig.getUnlockPromotion(widget.slot) })
			widget.detail.TextColor3 = Theme.COLORS.textDim

		elseif not charm then
			widget.button.BackgroundColor3 = Theme.COLORS.panelLight
			widget.letter.Text             = "?"
			widget.letter.TextColor3       = Theme.COLORS.text
			widget.lockDot.Visible         = false
			widget.detail.Text             = Loc.t("ui.charm.empty_slot")
			widget.detail.TextColor3       = Theme.COLORS.textDim

		else
			local color = CharmConfig.RARITY_COLORS[charm.rarity] or Theme.COLORS.panelLight

			widget.button.BackgroundColor3 = color
			widget.letter.Text             = CharmConfig.RARITY_LETTER[charm.rarity] or "?"
			widget.letter.TextColor3       = Theme.COLORS.outline
			widget.lockDot.Visible         = charm.locked
			widget.detail.Text             = CharmConfig.describe(charm)
			widget.detail.TextColor3       = color
		end
	end

	local rollable = countRollable(baerchi)
	local gold     = if data then data.goldGummies else 0
	local cost     = CharmConfig.ROLL_COST_GOLD_GUMMIES

	if _costLabel then
		_costLabel.Text = Loc.t("ui.charm.cost", { gold = gold, cost = cost })
		_costLabel.TextColor3 = if gold >= cost then Theme.COLORS.goldGummy else Theme.COLORS.bad
	end

	if _hintLabel then
		if rollable == 0 then
			_hintLabel.Text = Loc.t("ui.charm.all_locked")
		else
			_hintLabel.Text = Loc.t("ui.charm.roll_hint", { n = rollable })
		end
	end

	local canRoll = rollable > 0 and gold >= cost
	if _rollButton then Theme.setEnabled(_rollButton, canRoll) end
	if _autoButton then Theme.setEnabled(_autoButton, canRoll) end
end

function CharmPanel.refresh()
	local root = _root
	if not root or not root.Visible then return end

	local uid = _openUid
	if not uid then return end

	local baerchi = ClientState.getBaerchi(uid)
	if baerchi then
		fill(baerchi)
	else
		PanelManager.close(PANEL_NAME)
	end
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local argument = ...
	if typeof(argument) ~= "string" then return end

	local uid = argument :: string
	if not ClientState.getBaerchi(uid) then
		PanelManager.close(PANEL_NAME)
		return
	end

	_openUid = uid

	local root = _root
	if root then root.Visible = true end

	CharmPanel.refresh()
end

local function closeInternal()
	_openUid = nil
	local root = _root
	if root then root.Visible = false end
end

function CharmPanel.show(uid: string)
	if not ClientState.getBaerchi(uid) then return end
	PanelManager.open(PANEL_NAME, uid)
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function CharmPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"CharmPanel", screenGui,
		Vector2.new(0.50, 0.66),
		Vector2.new(320, 420),
		Vector2.new(560, 620)
	)
	_root = root

	_titleLabel = Theme.dialogHeader(root, Loc.t("ui.card.section_charms"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	-- Die acht Slot-Kacheln in zwei Reihen zu vier. Eine Reihe zu acht waere
	-- auf einem Handy zu schmal zum Antippen.
	local slotArea = Theme.container("Slots", body)
	slotArea.Size = UDim2.new(1, 0, 0, 118)

	local grid = Instance.new("UIGridLayout")
	grid.CellSize      = UDim2.new(0.25, -6, 0, 54)
	grid.CellPadding   = UDim2.new(0, 6, 0, 8)
	grid.SortOrder     = Enum.SortOrder.LayoutOrder
	grid.FillDirection = Enum.FillDirection.Horizontal
	grid.Parent        = slotArea

	for slot = 1, CharmConfig.SLOT_COUNT do
		local button = Theme.button("Slot_" .. slot, slotArea, "", Theme.COLORS.panelLight)
		button.LayoutOrder = slot
		button.Text        = ""

		local letter = Theme.label("Letter", button, CharmConfig.SLOT_NUMERALS[slot])
		letter.Size           = UDim2.new(1, 0, 0, 26)
		letter.Position       = UDim2.new(0, 0, 0, 4)
		letter.TextXAlignment = Enum.TextXAlignment.Center
		letter.TextColor3     = Theme.COLORS.outline

		local numeral = Theme.label("Numeral", button, CharmConfig.SLOT_NUMERALS[slot])
		numeral.Size           = UDim2.new(1, 0, 0, 16)
		numeral.Position       = UDim2.new(0, 0, 1, -20)
		numeral.TextXAlignment = Enum.TextXAlignment.Center
		numeral.TextScaled     = false
		numeral.TextSize       = 12
		numeral.TextColor3     = Theme.COLORS.outline

		-- Kleines Schloss-Zeichen oben rechts: gesperrte Slots wuerfelt ein
		-- Wurf nicht mit.
		local lockDot = Theme.panel("Lock", button, Theme.COLORS.outline)
		lockDot.AnchorPoint = Vector2.new(1, 0)
		lockDot.Position    = UDim2.new(1, -2, 0, 2)
		lockDot.Size        = UDim2.new(0, 16, 0, 16)
		lockDot.Visible     = false
		lockDot.ZIndex      = 3
		Theme.corner(lockDot, 8)

		local lockText = Theme.label("Text", lockDot, "")
		Loc.bind(lockText, "ui.charm.lock_letter")
		lockText.Size           = UDim2.fromScale(1, 1)
		lockText.TextXAlignment = Enum.TextXAlignment.Center
		lockText.TextScaled     = false
		lockText.TextSize       = 11
		lockText.ZIndex         = 4

		button.Activated:Connect(function()
			local uid = _openUid
			if not uid then return end
			Remotes.RequestToggleCharmLock:FireServer(uid, slot)
		end)

		table.insert(_slots, {
			slot    = slot,
			button  = button,
			letter  = letter,
			lockDot = lockDot,
			detail  = Theme.label("Detail_" .. slot, body, ""),   -- Position unten
		})
	end

	-- Die Effekt-Zeilen unter den Kacheln: eine pro Slot, scrollbar, damit acht
	-- Zeilen auch auf einem kleinen Bildschirm vollstaendig lesbar bleiben.
	local list = Theme.scroller("Effects", body)
	list.Position = UDim2.new(0, 0, 0, 126)
	list.Size     = UDim2.new(1, 0, 1, -126 - 92)
	Theme.listLayout(list, 3)

	for _, widget in _slots do
		local row = Theme.container("Row_" .. widget.slot, list)
		-- Sammel-Update 2.5 ("Charm Text der Effekte groesser"): 13 -> 18 px,
		-- Zeile 20 -> 28 px, mit duenner dunkler Kontur fuer den Kontrast auf
		-- dem farbigen Text (Rarity-Farben sind teils hell).
		row.Size        = UDim2.new(1, -8, 0, 28)
		row.LayoutOrder = widget.slot

		local numeral = Theme.label("Num", row, CharmConfig.SLOT_NUMERALS[widget.slot])
		numeral.Size       = UDim2.new(0, 44, 1, 0)
		numeral.TextScaled = false
		numeral.TextSize   = 17
		numeral.TextColor3 = Theme.COLORS.textDim

		widget.detail.Parent         = row
		widget.detail.Position       = UDim2.new(0, 48, 0, 0)
		widget.detail.Size           = UDim2.new(1, -48, 1, 0)
		widget.detail.TextScaled     = false
		widget.detail.TextSize       = 18
		widget.detail.TextWrapped    = true
		widget.detail.TextXAlignment = Enum.TextXAlignment.Left
		widget.detail.TextStrokeTransparency = 0.55
		widget.detail.TextStrokeColor3       = Theme.COLORS.outline
	end

	-- Fusszeile: Bestand, Hinweis, zwei Knoepfe.
	local footer = Theme.container("Footer", body)
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Position    = UDim2.new(0, 0, 1, 0)
	footer.Size        = UDim2.new(1, 0, 0, 88)

	_costLabel = Theme.label("Cost", footer, "")
	_costLabel.Size       = UDim2.new(1, 0, 0, 20)
	_costLabel.TextScaled = false
	_costLabel.TextSize   = 14

	_hintLabel = Theme.bodyText("Hint", footer, "")
	_hintLabel.Position = UDim2.new(0, 0, 0, 22)
	_hintLabel.Size     = UDim2.new(1, 0, 0, 26)

	local roll = Theme.button("Roll", footer, Loc.t("ui.charm.roll"), Theme.COLORS.gummy)
	roll.Position = UDim2.new(0, 0, 0, 52)
	roll.Size     = UDim2.new(0.5, -4, 0, 34)
	_rollButton = roll
	roll.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Remotes.RequestRollCharms:FireServer(uid, 1)
	end)

	local auto = Theme.button("AutoRoll", footer, "", Theme.COLORS.goldGummy)
	Loc.bind(auto, "ui.charm.auto_roll", { n = CharmConfig.AUTO_ROLL_COUNT })
	auto.AnchorPoint = Vector2.new(1, 0)
	auto.Position    = UDim2.new(1, 0, 0, 52)
	auto.Size        = UDim2.new(0.5, -4, 0, 34)
	_autoButton = auto
	auto.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Remotes.RequestRollCharms:FireServer(uid, CharmConfig.AUTO_ROLL_COUNT)
	end)

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	ClientState.onChanged(function()
		CharmPanel.refresh()
	end)
	Loc.onChanged(function()
		CharmPanel.refresh()
	end)

	Remotes.CharmRollResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.CharmRollResult

		Notify.emit("charm_roll", function()
			Toast.success(Loc.tn("msg.charm_rolled", typed.rolls, { gold = typed.goldGummiesSpent }))
		end)

		CharmPanel.refresh()
	end)

	print("[CharmPanel] Initialisiert |", CharmConfig.SLOT_COUNT, "Slots")
end

return CharmPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">CombatPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- CombatPanel.luau
-- StarterPlayerScripts/UI/CombatPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die Tower-Wahl zeigen (v15): eine Karte pro Tower mit Look-Farbe,
--     Rekord, Deckel des aktuellen Rebirths und naechstem Meilenstein
--   - Nach einem Lauf eine kurze Ergebnis-Meldung zeigen (Toast), am Deckel den
--     Rebirth-Hinweis mit Knopf zum RebirthDialog, und Meilenstein-Toasts
--
-- Gestartet und zurueckgeholt wird weiterhin ueber den Fight-Knopf der unteren
-- Pet-Leiste (PetBar). Dieses Panel waehlt nur, WOHIN er schickt
-- (RequestSelectTower). Ob ein Tower offen ist, prueft der Server; die Karten
-- rechnen mit denselben Funktionen aus TowerConfig nur fuer die Anzeige.
--
-- Der Ergebnis-Listener haengt am Modul, nicht am Panel: ein Lauf soll seine
-- Meldung auch bringen, wenn das Panel zu ist.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local Names       = require(ReplicatedStorage.Localization.Names)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local EggConfig   = require(ReplicatedStorage.Config.EggConfig)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local Moment       = require(script.Parent.Moment)
local PanelManager = require(script.Parent.PanelManager)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local Icons        = require(script.Parent.Icons)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local CombatPanel = {}

local PANEL_NAME   = "Combat"
local REBIRTH_PANEL = "Rebirth"
local CARD_HEIGHT  = 78

type Card = {
	frame  : Frame,
	stroke : UIStroke?,
	title  : TextLabel,
	info   : TextLabel,
	button : TextButton,
}

local _root: Frame?        = nil
local _info: TextLabel?    = nil
local _hint: Frame?        = nil
local _cards: { [string]: Card } = {}

-- HBB Paket 2: bezahlter Wiedereinstieg ab der letzten Stage als kleiner
-- Knopf (frueher eine Option im PitResumeDialog). Der kostenlose Einstieg
-- ab 65 % laeuft jetzt ohne Frage ueber den Fight-Knopf.
local _resume: TextButton? = nil
local _resumeHint: TextLabel? = nil

local function refreshResume(data: Types.PlayerDataUpdate)
	local button, hintText = _resume, _resumeHint
	if not button or not hintText then return end
	local reached = PitResumeDialog.getProgress(data)
	local towerId = if data.towers then data.towers.selected else TowerConfig.FIRST_TOWER
	local cost = if reached then TowerConfig.getResumeCost(towerId, reached, data.rebirthMult) else 0
	local show = FeatureFlags.isOn("UI_V2_GUIDE") and reached ~= nil and reached > 1 and cost > 0
	button.Visible = show
	hintText.Visible = not show
	if show then
		button.Text = string.format("⏩ %d   %s", reached :: number, Theme.formatNumber(cost))
		Theme.setEnabled(button, cost <= data.gummies)
	end
end

--------------------------------------------------------------------------------
-- Karten
--------------------------------------------------------------------------------

local function towerName(def: TowerConfig.TowerDef): string
	return Loc.t("tower." .. def.id .. ".name")
end

local function buildCard(parent: Instance, def: TowerConfig.TowerDef, order: number): Card
	local frame = Theme.panel("Tower_" .. def.id, parent, Theme.COLORS.panel)
	frame.Size        = UDim2.new(1, -8, 0, CARD_HEIGHT)
	frame.LayoutOrder = order

	-- Farbstreifen links in der Look-Farbe des Towers
	local stripe = Theme.panel("Stripe", frame, def.color)
	stripe.Size     = UDim2.new(0, 14, 1, -12)
	stripe.Position = UDim2.new(0, 6, 0, 6)

	local title = Theme.label("Title", frame, "")
	title.Position   = UDim2.new(0, 28, 0, 6)
	title.Size       = UDim2.new(1, -150, 0, 26)
	title.TextColor3 = Theme.shade(def.color, -0.1)
	Theme.outlineText(title)

	local info = Theme.bodyText("Info", frame, "")
	info.Position = UDim2.new(0, 28, 0, 34)
	info.Size     = UDim2.new(1, -150, 0, CARD_HEIGHT - 38)
	info.TextSize = 13

	local button = Theme.bigButton("Choose", frame, "", def.color)
	button.AnchorPoint = Vector2.new(1, 0.5)
	button.Position    = UDim2.new(1, -10, 0.5, 0)
	button.Size        = UDim2.new(0, 110, 0, 40)
	button.Activated:Connect(function()
		if not button.Active then return end
		Remotes.RequestSelectTower:FireServer(def.id)
	end)

	return {
		frame  = frame,
		stroke = frame:FindFirstChildOfClass("UIStroke"),
		title  = title,
		info   = info,
		button = button,
	}
end

local function refreshCard(card: Card, def: TowerConfig.TowerDef, data: Types.PlayerDataUpdate)
	local towers = data.towers
	local record = if towers then towers.records[def.id] or 0 else 0
	local cap    = TowerConfig.getStageCap(data.rebirthCount, def.id, if towers then towers.records else nil)
	local open   = cap > 0
	local selected = towers ~= nil and towers.selected == def.id
	local endless = def.id == "Endless"   -- HBB Paket 9: ohne Obergrenze

	card.title.Text = if endless then towerName(def) else string.format("%s  (%d)", towerName(def), def.stages)

	if open then
		local claimed = if towers then towers.claimed[def.id] else nil
		local nextStage = TowerConfig.nextMilestoneStage(def.id, claimed, record + 1)
		local lines = {
			if endless
				then Loc.t("ui.tower.record_endless", { record = record })
				else Loc.t("ui.tower.record_cap", { record = record, cap = cap, stages = def.stages }),
		}
		if nextStage then
			table.insert(lines, Loc.t("ui.tower.next_milestone", { stage = nextStage }))
		end
		card.info.Text = table.concat(lines, "\n")
		card.button.Text = if selected then Loc.t("ui.tower.selected") else Loc.t("ui.tower.choose")
		Theme.setEnabled(card.button, not selected)
	else
		card.info.Text = if endless
			then Loc.t("ui.tower.locked_endless")
			else Loc.t("ui.tower.locked", { rebirths = TowerConfig.getOpeningRebirth(def.id) })
		card.button.Text = Loc.t("ui.tower.locked_short")
		Theme.setEnabled(card.button, false)
	end

	local stroke = card.stroke
	if stroke then
		stroke.Color     = if selected then Theme.COLORS.good else Theme.COLORS.outline
		stroke.Thickness = if selected then Theme.OUTLINE_THICKNESS + 2 else Theme.OUTLINE_THICKNESS
	end
end

function CombatPanel.refresh()
	local root = _root
	if not root or not root.Visible then return end

	local data = ClientState.get()
	if not data then return end

	local capTower, capStage = TowerConfig.getCap(data.rebirthCount)
	local capDef = TowerConfig.get(capTower) or TowerConfig.TOWERS[1]
	local info = _info
	if info then
		info.Text = Loc.t("ui.tower.cap_line", { rebirths = data.rebirthCount, tower = towerName(capDef), stage = capStage })
	end

	refreshResume(data)

	for _, def in TowerConfig.TOWERS do
		local card = _cards[def.id]
		if card then refreshCard(card, def, data) end
	end
end

--------------------------------------------------------------------------------
-- Ergebnis des Laufs
--------------------------------------------------------------------------------

local function showCapHint(result: Types.PitRunResult)
	local hint = _hint
	if not hint then return end
	local label = hint:FindFirstChild("Text")
	if label and label:IsA("TextLabel") then
		label.Text = Loc.t("ui.tower.cap_reached", { stage = result.capStage or 0 })
	end
	hint.Visible = true
	task.delay(12, function()
		hint.Visible = false
	end)
end

local function showResult(result: Types.PitRunResult)
	local cleared = result.stagesCleared or 0
	local def = TowerConfig.get(result.towerId or "") or TowerConfig.TOWERS[1]
	local parts = {
		"Tower " .. def.numeral,
		Loc.tn("msg.tower_cleared", cleared),
		"+" .. Theme.formatNumber(result.gummiesWon or 0) .. " Gummies",
	}
	if (result.goldGummiesWon or 0) > 0 then
		table.insert(parts, "+" .. Theme.formatNumber(result.goldGummiesWon) .. " GoldGummies")
	end
	if result.newRecord then
		table.insert(parts, Loc.t("msg.tower_new_record", { stage = result.newRecord }))
	end
	if result.recalled then
		table.insert(parts, Loc.t("msg.tower_recalled"))
	end

	local text = table.concat(parts, "  •  ")
	-- Gummies/GoldGummies fliegen ueber den Datenstand (UI/Feedback); der
	-- neue Rekord ist der Moment, den man sehen soll.
	Notify.emit("tower_result", function()
		if cleared > 0 then Toast.success(text) else Toast.info(text) end
	end, function()
		if result.newRecord then
			Notify.emit("tower_record", function() end, function()
				Moment.show("record", Theme.COLORS.goldGummy, "ui.moment.record")
			end)
		end
	end)

	if result.capReached then
		showCapHint(result)
	end
end

local function showMilestone(reward: Types.TowerMilestoneReward)
	local def = TowerConfig.get(reward.towerId) or TowerConfig.TOWERS[1]
	local parts: { string } = {}
	if reward.gummies > 0 then table.insert(parts, "+" .. Theme.formatNumber(reward.gummies) .. " Gummies") end
	if reward.goldGummies > 0 then table.insert(parts, "+" .. Theme.formatNumber(reward.goldGummies) .. " GoldGummies") end
	if reward.eggType and reward.eggs > 0 then
		table.insert(parts, string.format("+%d %s", reward.eggs, Names.egg(reward.eggType)))
	end
	if reward.blueprints > 0 then table.insert(parts, Loc.t("msg.tower_blueprint")) end
	if (reward.endlessLevels or 0) > 0 then
		table.insert(parts, Loc.t("msg.tower_endless_level", { n = reward.endlessLevels or 0 }))
	end
	Notify.emit("tower_milestone", function()
		Toast.success(Loc.t("msg.tower_milestone", { tower = def.numeral, stage = reward.stage, reward = table.concat(parts, ", ") }))
	end, function()
		Moment.show("milestone", Theme.COLORS.goldGummy, "ui.moment.milestone")
	end)
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local root = _root
	if not root then return end

	root.Visible = true
	CombatPanel.refresh()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function CombatPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"CombatPanel", screenGui,
		Vector2.new(0.50, 0.70),
		Vector2.new(320, 420),
		Vector2.new(560, 600)
	)
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.tower.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	local info = Theme.bodyText("Info", body, "")
	info.Size = UDim2.new(1, -8, 0, 34)
	_info = info

	local scroller = Theme.scroller("List", body)
	scroller.Position = UDim2.new(0, 0, 0, 38)
	scroller.Size     = UDim2.new(1, 0, 1, -84)

	local layout = Theme.listLayout(scroller, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	for order, def in TowerConfig.TOWERS do
		_cards[def.id] = buildCard(scroller, def, order)
	end

	local hintText = Theme.bodyText("Hint", body, Loc.t("ui.tower.hint"))
	hintText.AnchorPoint = Vector2.new(0.5, 1)
	hintText.Position    = UDim2.new(0.5, 0, 1, 0)
	hintText.Size        = UDim2.new(1, -8, 0, 40)
	_resumeHint = hintText

	local resume = Theme.bigButton("ResumeLast", body, "", Theme.COLORS.goldGummy)
	resume.AnchorPoint = Vector2.new(0.5, 1)
	resume.Position    = UDim2.new(0.5, 0, 1, -2)
	resume.Size        = UDim2.new(0, 200, 0, 40)
	resume.Visible     = false
	if Icons.has("gummy") then
		local coin = Icons.make(resume, "gummy")
		coin.AnchorPoint = Vector2.new(1, 0.5)
		coin.Position    = UDim2.new(1, -6, 0.5, 0)
		coin.Size        = UDim2.fromOffset(28, 28)
		coin.ZIndex      = 4
	end
	resume.Activated:Connect(function()
		if not resume.Active then return end
		Remotes.RequestPetMode:FireServer("Fight", "Last")
		PanelManager.close(PANEL_NAME)
	end)
	_resume = resume

	-- Rebirth-Hinweis am Deckel: eigenes kleines Fenster unten in der Mitte,
	-- unabhaengig davon, ob das Panel offen ist.
	local hint = Theme.panel("CapHint", screenGui, Theme.COLORS.panel)
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position    = UDim2.new(0.5, 0, 1, -110)
	hint.Size        = UDim2.fromOffset(420, 70)
	hint.Visible     = false
	hint.ZIndex      = 15
	_hint = hint

	local hintLabel = Theme.bodyText("Text", hint, "")
	hintLabel.Position = UDim2.new(0, 10, 0, 8)
	hintLabel.Size     = UDim2.new(1, -140, 1, -16)
	hintLabel.TextColor3 = Theme.COLORS.text

	local rebirthButton = Theme.bigButton("Rebirth", hint, Loc.t("ui.tower.to_rebirth"), Theme.COLORS.goldGummy)
	rebirthButton.AnchorPoint = Vector2.new(1, 0.5)
	rebirthButton.Position    = UDim2.new(1, -10, 0.5, 0)
	rebirthButton.Size        = UDim2.new(0, 116, 0, 44)
	rebirthButton.Activated:Connect(function()
		hint.Visible = false
		PanelManager.open(REBIRTH_PANEL)
	end)

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	ClientState.onChanged(function()
		CombatPanel.refresh()
	end)

	Loc.onChanged(function()
		CombatPanel.refresh()
	end)

	Remotes.CombatResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.PitRunResult

		-- Auf dem Hinweg zurueckgeholt: es gab keinen Kampf.
		if typed.recalled and (typeof(typed.stages) ~= "table" or #typed.stages == 0) then
			return
		end

		showResult(typed)
	end)

	Remotes.TowerMilestoneReceived.OnClientEvent:Connect(function(reward: any)
		if typeof(reward) ~= "table" then return end
		showMilestone(reward :: Types.TowerMilestoneReward)
	end)

	print("[CombatPanel] Initialisiert |", #TowerConfig.TOWERS, "Tower")
end

return CombatPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">EggTreePanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- EggTreePanel.luau
-- StarterPlayerScripts/UI/EggTreePanel.luau
--
-- v14 (Mega Egg Tree, WP5): das Ei-Baum-Fenster.
--
-- Links der Baum: 20 Knoten in Pfad-Reihen, Linien zwischen Vorgaenger und
-- Nachfolger. Freie Knoten in ihrer Ei-Farbe, gesperrte abgedunkelt mit
-- Schloss, "bereit" (alle Bedingungen erfuellt) leuchtend umrandet.
--
-- Rechts die Detail-Karte des gewaehlten Knotens: was ihm noch fehlt
-- (Fortschrittsbalken je Bedingung), was herausfaellt (Drop-Vorschau mit
-- Chancen), wie viele im Lager liegen, und drei Aktionen: Oeffnen, Pressen
-- (5 -> 1 der naechsten Stufe), Blaupause einsetzen.
--
-- Die Bedingungen rechnet Modules/EggTree — dieselbe Funktion, die der
-- Server zum Freischalten benutzt. Das Panel kann also nie etwas anderes
-- anzeigen, als der Server tut. Es aktualisiert sich live ueber ClientState.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local Loc             = require(ReplicatedStorage.Localization.Loc)
local Names           = require(ReplicatedStorage.Localization.Names)
local EggConfig       = require(ReplicatedStorage.Config.EggConfig)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local EggTree         = require(ReplicatedStorage.Modules.EggTree)
local IndexCalculator = require(ReplicatedStorage.Modules.IndexCalculator)

local Theme          = require(script.Parent.Theme)
local EggIcon = require(script.Parent.EggIcon)
local PanelManager   = require(script.Parent.PanelManager)
local HatchAnimation = require(script.Parent.HatchAnimation)
local ClientState    = require(script.Parent.Parent.Controllers.ClientState)

local EggTreePanel = {}

local PANEL_NAME = "EggTree"
EggTreePanel.PANEL_NAME = PANEL_NAME

local NODE_W   = 112
local NODE_H   = 64
local STEP_X   = 132
local STEP_Y   = 84
local MARGIN   = 18
local DETAIL_W = 270

-- Position (Spalte, Zeile) jedes Knotens im Raster. Folgt dem Bild aus dem
-- Konzept: Stamm oben links, drei Pfade darunter, Kosmos rechts in der
-- Mitte, Ascension als eigene Reihe unten.
local LAYOUT: { [string]: { col: number, row: number } } = {
	BasicEgg         = { col = 0, row = 0 },
	SugarEgg         = { col = 1, row = 0 },
	GoldenEgg        = { col = 2, row = 1 },
	PlatinumEgg      = { col = 3, row = 1 },
	SunEgg           = { col = 4, row = 1 },
	ZenithEgg        = { col = 5, row = 1 },
	CrystalEgg       = { col = 3, row = 2 },
	PrismEgg         = { col = 4, row = 2 },
	AuroraEgg        = { col = 5, row = 2 },
	MistEgg          = { col = 2, row = 3 },
	VoidEgg          = { col = 3, row = 3 },
	ShadowEgg        = { col = 4, row = 3 },
	AbyssEgg         = { col = 5, row = 3 },
	CometEgg         = { col = 6, row = 2 },
	NovaEgg          = { col = 7, row = 2 },
	GalaxyEgg        = { col = 8, row = 2 },
	AscensionEgg     = { col = 1, row = 4.4 },
	TranscendenceEgg = { col = 2, row = 4.4 },
	EternityEgg      = { col = 3, row = 4.4 },
	OmegaEgg         = { col = 4, row = 4.4 },
}

-- Reihen-Beschriftung links (Pfad und sein Ziel).
local ROW_LABELS: { { row: number, path: string } } = {
	{ row = 0,   path = "Stamm" },
	{ row = 1,   path = "Gold" },
	{ row = 2,   path = "Kristall" },
	{ row = 3,   path = "Void" },
	{ row = 4.4, path = "Ascension" },
}

local _root: Frame?            = nil
local _canvas: ScrollingFrame? = nil
local _detail: ScrollingFrame? = nil
local _header: TextLabel?      = nil
local _selected: Types.EggType = "BasicEgg"
local _nodes: { [string]: { frame: Frame, stroke: UIStroke, lock: TextLabel, count: TextLabel, name: TextLabel } } = {}

local function nodeCenter(eggId: string): Vector2
	local p = LAYOUT[eggId]
	return Vector2.new(MARGIN + 70 + p.col * STEP_X + NODE_W / 2, MARGIN + p.row * STEP_Y + NODE_H / 2)
end

local function eggName(eggId: string): string
	local def = EggConfig.data[eggId :: Types.EggType]
	return Names.egg(eggId)
end

local function rarityName(rarity: string): string
	return Loc.name("rarity." .. rarity, rarity)
end

--------------------------------------------------------------------------------
-- Linien
--------------------------------------------------------------------------------

local function line(parent: Instance, a: Vector2, b: Vector2, color: Color3, thickness: number)
	local d = b - a
	local len = d.Magnitude
	local f = Instance.new("Frame")
	f.Name = "Edge"
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
	f.Size = UDim2.fromOffset(len, thickness)
	f.Rotation = math.deg(math.atan2(d.Y, d.X))
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.ZIndex = 11
	f.Parent = parent
end

--------------------------------------------------------------------------------
-- Baum aufbauen (einmalig)
--------------------------------------------------------------------------------

local function buildTree(canvas: ScrollingFrame)
	local maxCol, maxRow = 0, 0
	for _, p in LAYOUT do
		maxCol = math.max(maxCol, p.col)
		maxRow = math.max(maxRow, p.row)
	end
	canvas.CanvasSize = UDim2.fromOffset(MARGIN * 2 + 70 + (maxCol + 1) * STEP_X, MARGIN * 2 + (maxRow + 1) * STEP_Y)

	for _, rl in ROW_LABELS do
		local label = Theme.label("Row_" .. rl.path, canvas, Loc.name("path." .. rl.path, rl.path))
		label.Position = UDim2.fromOffset(4, MARGIN + rl.row * STEP_Y + 8)
		label.Size = UDim2.fromOffset(74, 22)
		label.TextColor3 = BaerchiConfig.getPathColor(rl.path)
		label.ZIndex = 12
		local goal = Theme.bodyText("Goal", canvas, Loc.name("path." .. rl.path .. ".goal", ""))
		goal.Position = UDim2.fromOffset(4, MARGIN + rl.row * STEP_Y + 30)
		goal.Size = UDim2.fromOffset(74, 32)
		goal.TextSize = 11
		goal.ZIndex = 12
	end

	-- Kanten zuerst (liegen unter den Knoten).
	for eggId, def in EggConfig.data do
		if def.parent and LAYOUT[def.parent] then
			line(canvas, nodeCenter(def.parent), nodeCenter(eggId), Theme.COLORS.panelLight, 3)
		end
	end
	local comet = EggConfig.TREE.CometEgg
	if comet and comet.hatchAnyOf then
		for _, req in comet.hatchAnyOf.of do
			line(canvas, nodeCenter(req.egg), nodeCenter("CometEgg"), BaerchiConfig.getPathColor("Kosmos"), 2)
		end
	end

	for eggId, def in EggConfig.data do
		-- Sonder-Eier (EggConfig: special) haben keinen Platz im Baum.
		if not LAYOUT[eggId] then continue end
		local c = nodeCenter(eggId)
		local frame = Theme.panel("Node_" .. eggId, canvas, Theme.COLORS.panel)
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromOffset(c.X, c.Y)
		frame.Size = UDim2.fromOffset(NODE_W, NODE_H)
		frame.ZIndex = 13
		local stroke = frame:FindFirstChildOfClass("UIStroke") :: UIStroke

		local swatch = EggIcon.make(frame, eggId, 38, 14)
		swatch.AnchorPoint = Vector2.new(0, 0.5)
		swatch.Position = UDim2.new(0, 6, 0.5, 0)

		local name = Theme.label("Name", frame, eggName(eggId))
		name.Position = UDim2.fromOffset(42, 6)
		name.Size = UDim2.new(1, -46, 0, 22)
		name.ZIndex = 14

		local count = Theme.label("Count", frame, "")
		count.Position = UDim2.fromOffset(42, 32)
		count.Size = UDim2.new(1, -46, 0, 20)
		count.TextColor3 = Theme.COLORS.good
		count.ZIndex = 14

		local lock = Theme.label("Lock", frame, "")
		lock.AnchorPoint = Vector2.new(1, 0)
		lock.Position = UDim2.new(1, -4, 0, 2)
		lock.Size = UDim2.fromOffset(40, 16)
		lock.TextXAlignment = Enum.TextXAlignment.Right
		lock.TextColor3 = Theme.COLORS.textDim
		lock.ZIndex = 15

		local click = Instance.new("TextButton")
		click.Name = "Click"
		click.BackgroundTransparency = 1
		click.Text = ""
		click.Size = UDim2.fromScale(1, 1)
		click.ZIndex = 16
		click.Parent = frame
		click.Activated:Connect(function()
			_selected = eggId
			EggTreePanel.refresh()
		end)

		_nodes[eggId] = { frame = frame, stroke = stroke, lock = lock, count = count, name = name }
	end
end

--------------------------------------------------------------------------------
-- Detail-Karte
--------------------------------------------------------------------------------

local function conditionText(c: EggTree.Condition): string
	if c.kind == "hatch" then
		return Loc.t("ui.tree.cond_hatch", { egg = eggName(c.egg :: string), have = c.have, need = c.need })
	elseif c.kind == "hatchAny" then
		return Loc.t("ui.tree.cond_any", { have = c.have, need = c.need })
	elseif c.kind == "index" then
		return Loc.t("ui.tree.cond_index", { rarity = rarityName(c.rarity :: string), have = c.have, need = c.need })
	elseif c.kind == "rebirth" then
		return Loc.t("ui.tree.cond_rebirth", { have = c.have, need = c.need })
	elseif c.kind == "blueprint" then
		return Loc.t("ui.tree.cond_blueprint")
	end
	return c.kind
end

local function addRow(parent: Instance, order: number, height: number): Frame
	local row = Theme.container("Row" .. order, parent)
	row.Size = UDim2.new(1, -8, 0, height)
	row.LayoutOrder = order
	return row
end

local function buildDetail(detail: ScrollingFrame, data: Types.PlayerDataUpdate)
	for _, child in detail:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	local eggId = _selected
	local def = EggConfig.data[eggId]
	if not def then return end
	local progress = EggTree.getProgress(data, eggId)
	local stock = data.island.eggStock[eggId] or 0
	local order = 0
	local function nextOrder(): number order += 1 return order end

	local title = Theme.label("Title", addRow(detail, nextOrder(), 28), eggName(eggId))
	title.Size = UDim2.fromScale(1, 1)
	title.TextColor3 = def.color
	Theme.outlineText(title)

	local sub = Theme.bodyText("Sub", addRow(detail, nextOrder(), 36), Loc.t("ui.tree.path_line", {
		path = Loc.name("path." .. def.path, def.path),
		goal = Loc.name("path." .. def.path .. ".goal", ""),
		avg  = Loc.formatDecimal(EggTree.expectedRarity(eggId), 2),
	}))
	sub.Size = UDim2.fromScale(1, 1)

	local status = Theme.label("Status", addRow(detail, nextOrder(), 22),
		if progress.unlocked then Loc.t("ui.tree.unlocked")
		elseif progress.ready then Loc.t("ui.tree.ready")
		else Loc.t("ui.tree.locked"))
	status.Size = UDim2.fromScale(1, 1)
	status.TextColor3 = if progress.unlocked then Theme.COLORS.good else Theme.COLORS.goldGummy

	-- Bedingungen
	if not progress.unlocked and #progress.conditions > 0 then
		Theme.sectionLabel("CondHead", addRow(detail, nextOrder(), 16), Loc.t("ui.tree.needs")).Size = UDim2.fromScale(1, 1)
		for _, c in progress.conditions do
			local row = addRow(detail, nextOrder(), 26)
			local bar = Theme.progress(row, if c.done then Theme.COLORS.good else Theme.COLORS.accent)
			bar.track.Size = UDim2.fromScale(1, 1)
			bar.fill.Size = UDim2.fromScale(math.clamp(c.have / math.max(1, c.need), 0, 1), 1)
			bar.text.Text = conditionText(c)
			if c.parts then
				for _, part in c.parts do
					local prow = addRow(detail, nextOrder(), 20)
					local pl = Theme.bodyText("Part", prow, string.format("   %s %s  %d/%d",
						if part.done then "✓" else "·", eggName(part.egg), part.have, part.need))
					pl.Size = UDim2.fromScale(1, 1)
					pl.TextSize = 12
				end
			end
		end
	end

	-- Lager + Aktionen
	local stockRow = addRow(detail, nextOrder(), 22)
	local stockLabel = Theme.label("Stock", stockRow, Loc.t("ui.tree.in_stock", { n = stock }))
	stockLabel.Size = UDim2.fromScale(1, 1)
	stockLabel.TextColor3 = if stock > 0 then Theme.COLORS.good else Theme.COLORS.textDim

	local openRow = addRow(detail, nextOrder(), 34)
	local openBtn = Theme.bigButton("Open", openRow, Loc.t("ui.tree.open"), Theme.COLORS.accent)
	openBtn.Size = UDim2.fromScale(1, 1)
	Theme.setEnabled(openBtn, stock > 0)
	openBtn.Activated:Connect(function()
		local now = ClientState.get()
		if not now or (now.island.eggStock[eggId] or 0) <= 0 then return end
		HatchAnimation.request(eggId)
		Remotes.RequestHatchEgg:FireServer(eggId)
	end)

	-- Presse: beim Zucker-Ei zwei Wege (Gold / Void)
	if EggConfig.canPress(eggId :: any) then
		local targets: { { path: string?, egg: Types.EggType } } = {}
		if eggId == "SugarEgg" then
			for _, path in { "Gold", "Void" } do
				local t = EggConfig.getNextInPath(eggId, path :: any)
				if t then table.insert(targets, { path = path, egg = t }) end
			end
		else
			local t = EggConfig.getNextInPath(eggId)
			if t then table.insert(targets, { path = nil, egg = t }) end
		end
		for _, target in targets do
			local row = addRow(detail, nextOrder(), 32)
			local free = EggTree.isUnlocked(data.eggTree, target.egg)
			local btn = Theme.button("Press", row, Loc.t("ui.tree.press", {
				n = EggConfig.PRESS.cost, egg = eggName(target.egg),
			}), Theme.COLORS.goldGummy)
			btn.Size = UDim2.fromScale(1, 1)
			Theme.setEnabled(btn, free and stock >= EggConfig.PRESS.cost)
			btn.Activated:Connect(function()
				Remotes.RequestPressEggs:FireServer(eggId, target.path)
			end)
		end
	end

	-- Blaupause
	if EggTree.canUseBlueprint(data, eggId) then
		local row = addRow(detail, nextOrder(), 32)
		local btn = Theme.button("Blueprint", row, Loc.t("ui.tree.use_blueprint", { n = data.eggTree.blueprints }),
			BaerchiConfig.getPathColor("Kosmos"))
		btn.TextColor3 = Theme.COLORS.text
		btn.Size = UDim2.fromScale(1, 1)
		btn.Activated:Connect(function()
			Remotes.RequestUseBlueprint:FireServer(eggId)
		end)
	end

	-- Drop-Vorschau
	Theme.sectionLabel("DropHead", addRow(detail, nextOrder(), 16), Loc.t("ui.tree.drops")).Size = UDim2.fromScale(1, 1)
	for _, node in IndexCalculator.buildTree() do
		if node.eggId == eggId then
			for _, drop in node.drops do
				local bdef = BaerchiConfig.getById(drop.configId)
				if bdef then
					local row = addRow(detail, nextOrder(), 20)
					local known = data.discovered and data.discovered[drop.configId]
					local name = if known then Names.baerchi(drop.configId) else "???"
					local pct = drop.chance * 100
					local pctText = if pct >= 10 then Loc.formatNumber(math.round(pct)) .. "%" else Loc.formatDecimal(pct, 1) .. "%"
					local l = Theme.bodyText("Drop", row, string.format("%s  •  %s  •  %s", pctText, name, rarityName(bdef.rarity)))
					l.Size = UDim2.fromScale(1, 1)
					l.TextSize = 12
					l.TextColor3 = BaerchiConfig.getRarityColor(bdef.rarity)
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

function EggTreePanel.refresh()
	local root = _root
	if not root or not root.Visible then return end
	local data = ClientState.get()
	if not data or not data.eggTree then return end

	if _header then
		_header.Text = Loc.t("ui.tree.title_bp", { n = data.eggTree.blueprints or 0 })
	end

	for eggId, node in _nodes do
		local progress = EggTree.getProgress(data, eggId :: Types.EggType)
		local def = EggConfig.data[eggId :: Types.EggType]
		local stock = data.island.eggStock[eggId :: Types.EggType] or 0
		node.count.Text = if stock > 0 then "x" .. stock else ""
		node.name.Text = eggName(eggId)
		if progress.unlocked then
			node.frame.BackgroundColor3 = Theme.shade(def.color, -0.55)
			node.lock.Text = ""
			node.stroke.Color = Theme.COLORS.outline
			node.stroke.Thickness = 2
		else
			node.frame.BackgroundColor3 = Theme.COLORS.panelDeep
			node.lock.Text = if progress.ready then "!" else Loc.t("ui.tree.lock_short")
			node.stroke.Color = if progress.ready then Theme.COLORS.goldGummy else Theme.COLORS.outline
			node.stroke.Thickness = if progress.ready then 3 else 2
		end
		if eggId == _selected then
			node.stroke.Color = Theme.COLORS.text
			node.stroke.Thickness = 3
		end
	end

	if _detail then
		buildDetail(_detail, data)
	end
end

local function openInternal(eggId: any)
	local root = _root
	if not root then return end
	if typeof(eggId) == "string" and EggConfig.data[eggId :: Types.EggType] then
		_selected = eggId :: Types.EggType
	end
	root.Visible = true
	EggTreePanel.refresh()
end

local function closeInternal()
	if _root then _root.Visible = false end
end

function EggTreePanel.init(screenGui: ScreenGui)
	local root = Theme.dialog("EggTreePanel", screenGui, Vector2.new(0.9, 0.84), Vector2.new(560, 360), Vector2.new(1240, 720))
	_root = root

	_header = Theme.dialogHeader(root, Loc.t("ui.tree.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	local canvas = Instance.new("ScrollingFrame") -- ui-ok: 2D-Leinwand (XY), Theme.scroller kann nur Y
	canvas.Name = "Canvas"
	canvas.BackgroundTransparency = 1
	canvas.BorderSizePixel = 0
	canvas.ScrollBarThickness = 6
	canvas.ScrollBarImageColor3 = Theme.COLORS.panelLight
	canvas.ScrollingDirection = Enum.ScrollingDirection.XY
	canvas.Size = UDim2.new(1, -DETAIL_W - 10, 1, 0)
	canvas.ZIndex = 10
	canvas.Parent = body
	_canvas = canvas

	local detailHost = Theme.panel("Detail", body, Theme.COLORS.panel)
	detailHost.AnchorPoint = Vector2.new(1, 0)
	detailHost.Position = UDim2.new(1, 0, 0, 0)
	detailHost.Size = UDim2.new(0, DETAIL_W, 1, 0)
	detailHost.ZIndex = 10
	local detail = Theme.scroller("List", detailHost)
	detail.Position = UDim2.fromOffset(8, 8)
	detail.Size = UDim2.new(1, -12, 1, -16)
	detail.ZIndex = 11
	local layout = Theme.listLayout(detail, 4)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	_detail = detail

	buildTree(canvas)

	PanelManager.register(PANEL_NAME, { open = openInternal, close = closeInternal })

	ClientState.onChanged(function()
		EggTreePanel.refresh()
	end)
	Loc.onChanged(function()
		if _header then _header.Text = Loc.t("ui.tree.title") end
		EggTreePanel.refresh()
	end)

	print("[EggTreePanel] Initialisiert |", #EggConfig.getOrderedIds(), "Knoten")
end

return EggTreePanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">Feedback</string><ProtectedString name="Source"><![CDATA[--!strict
-- Feedback.luau
-- StarterPlayerScripts/UI/Feedback.luau
--
-- Einzige Zustaendigkeit:
--   - Gewinne ohne Text zeigen: Icon fliegt zur passenden Pille/Kachel,
--     eine Zahl ("+25") steigt auf, Honig/XP/Stufen als Zahl ueber dem Baerchi
--
-- Kontext: HBB Paket 1. Ein Kind soll Belohnungen sehen, nicht lesen.
--
-- Zwei Quellen:
--   1. Waehrungen und Eier erkennt dieses Modul selbst am Datenstand
--      (ClientState): steigt `gummies`, `goldGummies` oder die Summe im
--      Ei-Lager, fliegt ein Icon. So braucht keine Belohnungsstelle eigenen
--      Code, und nichts wird doppelt gezeigt.
--   2. Alles, was keine Pille hat (XP, Honig, Level, Stat-Stufe, Waben,
--      Ausbau), meldet der Aufrufer mit Feedback.gain(kind, amount, origin?).
--
-- Leistung: ein fester Pool wiederverwendeter Elemente und EINE Schleife pro
-- Frame. Kein Thread und kein Tween pro Icon.
--
-- Mit FeatureFlags.UI_V2_FEEDBACK = false zeigt dieses Modul nichts.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local GuiService        = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local Types          = require(ReplicatedStorage.Network.Types)
local FeedbackConfig = require(ReplicatedStorage.Config.FeedbackConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)

local Theme       = require(script.Parent.Theme)
local UiScale     = require(script.Parent.UiScale)
local Icons       = require(script.Parent.Icons)
local Hud         = require(script.Parent.Hud)
local MenuBar     = require(script.Parent.MenuBar)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local Feedback = {}

export type Origin = GuiObject | Vector3 | BasePart

-- Wie jede Art aussieht. `icon` = Name in Icons, `text` = Rueckfall/Praefix.
-- `me` = Zahl ueber dem eigenen Charakter statt ueber dem Baerchi.
local LOOK: { [string]: { icon: string?, text: string, color: Color3, float: boolean, me: boolean? } } = {
	gummies     = { icon = "gummy",     text = "G",  color = Theme.COLORS.gummy,     float = false },
	goldGummies = { icon = "goldgummy", text = "$",  color = Theme.COLORS.goldGummy, float = false },
	eggs        = { icon = "egg",       text = "🥚", color = Theme.COLORS.text,      float = false },
	xp          = { icon = nil,         text = "XP", color = Theme.COLORS.growth,    float = true },
	honey       = { icon = "honey",     text = "",   color = Theme.COLORS.volume,    float = true },
	level       = { icon = nil,         text = "Lv", color = Theme.COLORS.good,      float = true },
	stat        = { icon = nil,         text = "",   color = Theme.COLORS.accent,    float = true },
	comb        = { icon = "honey",     text = "",   color = Theme.COLORS.volume,    float = true, me = true },
	upgrade     = { icon = nil,         text = "⬆",  color = Theme.COLORS.good,      float = true, me = true },
	star        = { icon = nil,         text = "★",  color = Theme.COLORS.goldGummy, float = true },
}

-- Groesse eines fliegenden Icons (px)
local ICON_SIZE = 38
-- Wie hoch die Zahl ueber den Startpunkt steigt (px)
local NUMBER_RISE = 46
-- Wie hoch die Zahl ueber dem Baerchi steigt (Studs)
local FLOAT_RISE = 3
local FLOAT_BASE = 4

type Flyer = {
	frame  : Frame,
	icon   : GuiObject,
	number : TextLabel,
	busy   : boolean,
	t0     : number,
	from   : Vector2,
	to     : Vector2?,
	kind   : string,
	landed : boolean,
}

type Floater = {
	gui    : BillboardGui,
	label  : TextLabel,
	busy   : boolean,
	t0     : number,
}

local _layer: Frame? = nil
local _flyers: { Flyer } = {}
local _floaters: { Floater } = {}

-- Sammeln gleicher Gewinne im MERGE_WINDOW
local _pending: { [string]: { amount: number, origin: Origin?, due: number, suffix: string? } } = {}

-- Letzter bekannter Stand fuer die Erkennung aus ClientState
local _last: { gummies: number, goldGummies: number, eggs: number }? = nil

-- Zwischenspeicher fuer die Figur des ausgeruesteten Baerchis
local _bearPart: BasePart? = nil
local _bearUid: string? = nil

local function enabled(): boolean
	return FeatureFlags.isOn("UI_V2_FEEDBACK")
end

local function formatAmount(kind: string, amount: number, suffix: string?): string
	if suffix then
		return "+" .. Theme.formatNumber(amount) .. " " .. suffix
	end
	local look = LOOK[kind]
	local prefix = if look then look.text else ""
	if kind == "level" then
		return prefix .. " " .. Theme.formatNumber(amount)
	elseif kind == "upgrade" or kind == "star" then
		return prefix .. " " .. Theme.formatNumber(amount)
	elseif kind == "xp" then
		return "+" .. Theme.formatNumber(amount) .. " " .. prefix
	end
	return "+" .. Theme.formatNumber(amount)
end

--------------------------------------------------------------------------------
-- Positionen
--------------------------------------------------------------------------------

local function guiCenter(gui: GuiObject): Vector2
	-- Bildschirm-Pixel -> Oberflaechen-Einheiten (globale UiScale)
	return UiScale.toGui(gui.AbsolutePosition + gui.AbsoluteSize * 0.5)
end

local function worldToScreen(position: Vector3): Vector2?
	local camera = Workspace.CurrentCamera
	if not camera then return nil end
	local point, visible = camera:WorldToViewportPoint(position)
	if not visible then return nil end
	-- Die ScreenGui laesst Platz fuer die Topbar (IgnoreGuiInset = false):
	-- Viewport-Koordinaten muessen um diesen Rand verschoben werden.
	local inset = GuiService:GetGuiInset()
	return UiScale.toGui(Vector2.new(point.X, point.Y) - inset)
end

local function defaultOrigin(): Vector2
	local layer = _layer
	if not layer then return Vector2.zero end
	local size = UiScale.toGui(layer.AbsoluteSize)
	-- Ueber der Pet-Leiste, wo der Blick ohnehin ist
	return Vector2.new(size.X * 0.5, size.Y * 0.72)
end

local function resolveOrigin(origin: Origin?): Vector2
	if typeof(origin) == "Instance" then
		if origin:IsA("GuiObject") then
			return guiCenter(origin)
		elseif origin:IsA("BasePart") then
			return worldToScreen(origin.Position) or defaultOrigin()
		end
	elseif typeof(origin) == "Vector3" then
		return worldToScreen(origin) or defaultOrigin()
	end
	return defaultOrigin()
end

local function targetFor(kind: string): GuiObject?
	local anchor = Hud.getPillAnchor(kind)
	if anchor then return anchor end
	if kind == "eggs" then
		return MenuBar.getTileAnchor("Hatch")
	end
	return nil
end

local function pulseTarget(kind: string, target: GuiObject?)
	if Hud.getPillAnchor(kind) then
		Hud.pulse(kind)
	elseif target then
		local scale = target:FindFirstChild("PulseScale")
		if not scale then
			local created = Instance.new("UIScale")
			created.Name = "PulseScale"
			created.Parent = target
			scale = created
		end
		local uiScale = scale :: UIScale
		uiScale.Scale = 1.15
	end
end

-- Sucht die Figur des eigenen, ausgeruesteten Baerchis (Attribut BaerchiUid,
-- siehe WorldController). Bleibt zwischengespeichert, bis sie verschwindet.
local function findBearPart(): BasePart?
	local data = ClientState.get()
	local uid = if data then data.island.equippedUid else nil
	if not uid then return nil end
	local cached = _bearPart
	if cached and cached.Parent and _bearUid == uid then
		return cached
	end
	_bearPart = nil
	_bearUid = uid
	for _, descendant in Workspace:GetDescendants() do
		if descendant:IsA("BasePart") and descendant:GetAttribute("BaerchiUid") == uid then
			_bearPart = descendant
			return descendant
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Pools
--------------------------------------------------------------------------------

local function makeFlyer(layer: Frame): Flyer
	local frame = Instance.new("Frame")
	frame.Name = "Flyer"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromOffset(ICON_SIZE, ICON_SIZE)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Visible = false
	frame.ZIndex = 60
	frame.Parent = layer

	local number = Theme.label("Number", layer, "")
	number.AnchorPoint = Vector2.new(0.5, 0.5)
	number.Size = UDim2.fromOffset(120, 34)
	number.TextXAlignment = Enum.TextXAlignment.Center
	number.ZIndex = 61
	number.Visible = false
	Theme.outlineText(number, 2)

	return {
		frame = frame, icon = frame, number = number, busy = false,
		t0 = 0, from = Vector2.zero, to = nil, kind = "", landed = false,
	}
end

local function setFlyerLook(flyer: Flyer, kind: string)
	if flyer.kind == kind and flyer.icon ~= flyer.frame then return end
	if flyer.icon ~= flyer.frame then
		flyer.icon:Destroy()
	end
	local look = LOOK[kind]
	local iconName = if look then look.icon else nil
	local icon = Icons.make(flyer.frame, iconName or "", if look then look.text else "?")
	icon.Size = UDim2.fromScale(1, 1)
	icon.ZIndex = 60
	flyer.icon = icon
	flyer.kind = kind
end

local function makeFloater(): Floater
	local gui = Instance.new("BillboardGui")
	gui.Name = "FeedbackFloat"
	gui.Size = UDim2.fromOffset(160, 44)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Enabled = false
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local label = Theme.label("Text", gui, "")
	label.Size = UDim2.fromScale(1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Center
	Theme.outlineText(label, 2)

	return { gui = gui, label = label, busy = false, t0 = 0 }
end

--------------------------------------------------------------------------------
-- Ausloesen
--------------------------------------------------------------------------------

local function launchFlyer(kind: string, amount: number, origin: Origin?)
	local free: Flyer? = nil
	for _, flyer in _flyers do
		if not flyer.busy then
			free = flyer
			break
		end
	end
	-- Alle belegt: die Pille zaehlt den Wert ohnehin hoch. Kein siebtes Icon.
	if not free then return end

	local target = targetFor(kind)
	local from = resolveOrigin(origin)
	setFlyerLook(free, kind)
	free.busy   = true
	free.landed = false
	free.t0     = os.clock()
	free.from   = from
	free.to     = if target then guiCenter(target) else nil
	free.frame.Position = UDim2.fromOffset(from.X, from.Y)
	free.frame.Visible  = true

	local look = LOOK[kind]
	free.number.Text       = formatAmount(kind, amount)
	free.number.TextColor3 = if look then look.color else Theme.COLORS.text
	free.number.Position   = UDim2.fromOffset(from.X, from.Y - 20)
	free.number.TextTransparency = 0
	free.number.Visible    = true
end

local function characterPart(): BasePart?
	local character = Players.LocalPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then return root end
	return nil
end

local function launchFloater(kind: string, amount: number, suffix: string?)
	local look0 = LOOK[kind]
	local part = if look0 and look0.me then characterPart() else findBearPart()
	if not part then return end
	local free: Floater? = nil
	for _, floater in _floaters do
		if not floater.busy then
			free = floater
			break
		end
	end
	if not free then return end
	local look = LOOK[kind]
	free.busy = true
	free.t0 = os.clock()
	free.gui.Adornee = part
	free.gui.StudsOffset = Vector3.new(0, FLOAT_BASE, 0)
	free.gui.Enabled = true
	free.label.Text = formatAmount(kind, amount, suffix)
	free.label.TextColor3 = if look then look.color else Theme.COLORS.text
	free.label.TextTransparency = 0
end

local function flush(kind: string)
	local entry = _pending[kind]
	_pending[kind] = nil
	if not entry or entry.amount == 0 then return end
	local look = LOOK[kind]
	if look and look.float then
		launchFloater(kind, entry.amount, entry.suffix)
	else
		launchFlyer(kind, entry.amount, entry.origin)
	end
end

-- Oeffentlich: einen Gewinn zeigen. Gleiche Arten innerhalb des
-- MERGE_WINDOW werden zu einer Zahl addiert. Bei "level", "upgrade" und
-- "star" ist `amount` die neue Stufe (wird nicht addiert, sondern ersetzt).
-- `suffix`: kurzes Kuerzel hinter der Zahl ("+1 ATK"); nur Zahlen und
-- sprachneutrale Kuerzel, keine Woerter.
function Feedback.gain(kind: string, amount: number, origin: Origin?, suffix: string?)
	if not enabled() then return end
	if not LOOK[kind] then
		warn("[Feedback] Unbekannte Art:", kind)
		return
	end
	local entry = _pending[kind]
	if entry then
		if kind == "level" or kind == "upgrade" or kind == "star" then
			entry.amount = amount
		else
			entry.amount += amount
		end
		entry.origin = origin or entry.origin
		entry.suffix = suffix or entry.suffix
	else
		_pending[kind] = { amount = amount, origin = origin, due = os.clock() + FeedbackConfig.MERGE_WINDOW, suffix = suffix }
	end
end

--------------------------------------------------------------------------------
-- Die eine Schleife
--------------------------------------------------------------------------------

local function easeOut(t: number): number
	return 1 - (1 - t) * (1 - t)
end

local function step()
	local now = os.clock()

	for kind, entry in _pending do
		if now >= entry.due then
			flush(kind)
		end
	end

	local fly = FeedbackConfig.FLY_SECONDS
	local rise = FeedbackConfig.NUMBER_SECONDS
	for _, flyer in _flyers do
		if not flyer.busy then continue end
		local t = now - flyer.t0

		-- Zahl: steigt am Startpunkt auf und blendet aus
		local tn = math.clamp(t / rise, 0, 1)
		flyer.number.Position = UDim2.fromOffset(flyer.from.X, flyer.from.Y - 20 - NUMBER_RISE * easeOut(tn))
		flyer.number.TextTransparency = math.max(0, (tn - 0.6) / 0.4)

		-- Icon: Bogen zum Ziel (ohne Ziel: nur kurz aufsteigen)
		local tf = math.clamp(t / fly, 0, 1)
		local to = flyer.to or (flyer.from - Vector2.new(0, 80))
		local mid = (flyer.from + to) * 0.5 + Vector2.new(0, -90)
		local e = easeOut(tf)
		local a = flyer.from:Lerp(mid, e)
		local b = mid:Lerp(to, e)
		local p = a:Lerp(b, e)
		flyer.frame.Position = UDim2.fromOffset(p.X, p.Y)
		local size = ICON_SIZE * (1 - 0.35 * tf)
		flyer.frame.Size = UDim2.fromOffset(size, size)

		if tf >= 1 and not flyer.landed then
			flyer.landed = true
			flyer.frame.Visible = false
			pulseTarget(flyer.kind, targetFor(flyer.kind))
		end
		if tf >= 1 and tn >= 1 then
			flyer.busy = false
			flyer.number.Visible = false
		end
	end

	local floatTime = FeedbackConfig.FLOAT_SECONDS
	for _, floater in _floaters do
		if not floater.busy then continue end
		local t = math.clamp((now - floater.t0) / floatTime, 0, 1)
		floater.gui.StudsOffset = Vector3.new(0, FLOAT_BASE + FLOAT_RISE * easeOut(t), 0)
		floater.label.TextTransparency = math.max(0, (t - 0.6) / 0.4)
		if t >= 1 then
			floater.busy = false
			floater.gui.Enabled = false
			floater.gui.Adornee = nil
		end
	end

	-- Puls der Kacheln zurueckfedern (Pillen machen das selbst per Tween)
	local tile = MenuBar.getTileAnchor("Hatch")
	if tile then
		local scale = tile:FindFirstChild("PulseScale")
		if scale and scale:IsA("UIScale") and scale.Scale > 1 then
			scale.Scale = math.max(1, scale.Scale - 0.6 * (1 / 60))
		end
	end
end

--------------------------------------------------------------------------------
-- Erkennung aus dem Datenstand
--------------------------------------------------------------------------------

local function countEggs(data: Types.PlayerDataUpdate): number
	local total = 0
	for _, n in data.island.eggStock do
		total += n
	end
	return total
end

local function onData(data: Types.PlayerDataUpdate)
	local now = { gummies = data.gummies, goldGummies = data.goldGummies, eggs = countEggs(data) }
	local last = _last
	_last = now
	-- Erster Stand nach dem Join ist kein Gewinn
	if not last then return end
	if now.gummies > last.gummies then Feedback.gain("gummies", now.gummies - last.gummies) end
	if now.goldGummies > last.goldGummies then Feedback.gain("goldGummies", now.goldGummies - last.goldGummies) end
	if now.eggs > last.eggs then Feedback.gain("eggs", now.eggs - last.eggs) end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function Feedback.init(screenGui: ScreenGui)
	local layer = Theme.container("FeedbackLayer", screenGui)
	layer.Size = UDim2.fromScale(1, 1)
	layer.ZIndex = 60
	_layer = layer

	for _ = 1, FeedbackConfig.MAX_ICONS do
		table.insert(_flyers, makeFlyer(layer))
	end
	for _ = 1, FeedbackConfig.MAX_FLOATS do
		table.insert(_floaters, makeFloater())
	end

	ClientState.onChanged(onData)
	RunService.RenderStepped:Connect(step)

	print("[Feedback] Initialisiert")
end

return Feedback
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">FightStartPrompt</string><ProtectedString name="Source"><![CDATA[--!strict
-- FightStartPrompt.luau
-- StarterPlayerScripts/UI/FightStartPrompt.luau
--
-- Einzige Zustaendigkeit:
--   - Das kleine Feld beim Fight-Klick (FeatureFlags.FIGHT_RESUME_PROMPT):
--     "Ab Stage X weiter" gegen Gummies. Klickt der Spieler nichts, ist es
--     nach AUTO_SECONDS weg und der Lauf startet bei Stage 1.
--
-- Entscheidung Projektinhaber 05.10.: Stages schafft man durch STAERKERE
-- Baerchis. Der Einstieg weiter oben ist eine bewusste Spieler-Entscheidung
-- gegen Waehrung, nie der Standard. (Vorher startete der Fight-Knopf ohne
-- Frage ab 65 % des letzten Laufs und buchte dafuer Gummies ab.)
--
-- Kosten und Start-Stage rechnet PitResumeDialog.offer — dieselbe Rechnung,
-- mit der der Server abbucht. Bezahlbar entscheidet am Ende der Server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local Loc = require(ReplicatedStorage.Localization.Loc)

local Theme           = require(script.Parent.Theme)
local Icons           = require(script.Parent.Icons)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local ClientState     = require(script.Parent.Parent.Controllers.ClientState)

local FightStartPrompt = {}

FightStartPrompt.AUTO_SECONDS = 7

local _root: Frame? = nil
local _resume: TextButton? = nil
local _cost: TextLabel? = nil
local _bar: Frame? = nil
local _onChoose: ((PitResumeDialog.Choice) -> ())? = nil
local _openedAt = 0
local _token = 0

local function finish(choice: PitResumeDialog.Choice)
	local callback = _onChoose
	_onChoose = nil
	_token += 1
	local root = _root
	if root then root.Visible = false end
	if callback then callback(choice) end
end

function FightStartPrompt.isOpen(): boolean
	return _onChoose ~= nil
end

-- Sofort mit Stage 1 starten (zweiter Fight-Klick waehrend das Feld offen ist)
function FightStartPrompt.chooseFresh()
	if _onChoose then finish("Fresh") end
end

-- Oeffnet das Feld, wenn es einen letzten Lauf ueber Stage 1 gibt. Gibt
-- false zurueck, wenn es nichts anzubieten gibt (Aufrufer startet dann
-- selbst bei Stage 1).
function FightStartPrompt.open(onChoose: (PitResumeDialog.Choice) -> ()): boolean
	local root, resume, cost = _root, _resume, _cost
	local data = ClientState.get()
	if not root or not resume or not cost or not data then return false end
	local reached = PitResumeDialog.getProgress(data)
	if not reached or reached <= 1 then return false end

	local stage, price = PitResumeDialog.offer(data, "Last")
	resume.Text = Loc.t("ui.fight.resume", { stage = stage })
	cost.Text = Theme.formatNumber(price)
	Theme.setEnabled(resume, price <= data.gummies)

	_onChoose = onChoose
	_openedAt = os.clock()
	_token += 1
	local token = _token
	root.Visible = true

	task.delay(FightStartPrompt.AUTO_SECONDS, function()
		if token == _token and _onChoose then
			finish("Fresh")
		end
	end)
	return true
end

function FightStartPrompt.init(screenGui: ScreenGui, anchorAbove: GuiObject)
	local root = Theme.panel("FightStartPrompt", screenGui, Theme.COLORS.panelDeep)
	root.AnchorPoint = Vector2.new(0.5, 1)
	root.Size = UDim2.fromOffset(300, 96)
	root.Visible = false
	root.ZIndex = 6
	_root = root

	-- Ueber der Pet-Leiste, und mit ihr mitwandern: auf Touch-Geraeten sitzt
	-- sie nicht mittig, sondern im freien Streifen neben der Steuerung
	-- (TouchSafeArea), und ihr UIScale macht sie kleiner.
	local function follow()
		local barScale = anchorAbove:FindFirstChildOfClass("UIScale")
		local factor = if barScale then barScale.Scale else 1
		root.Position = UDim2.new(
			anchorAbove.Position.X.Scale, anchorAbove.Position.X.Offset,
			1, -(anchorAbove.Size.Y.Offset * factor + 26)
		)
	end
	anchorAbove:GetPropertyChangedSignal("Position"):Connect(follow)
	local barScale = anchorAbove:FindFirstChildOfClass("UIScale")
	if barScale then
		barScale:GetPropertyChangedSignal("Scale"):Connect(follow)
	end
	follow()

	local resume = Theme.bigButton("Resume", root, "", Theme.COLORS.goldGummy)
	resume.Position = UDim2.new(0, 8, 0, 8)
	resume.Size = UDim2.new(1, -16, 0, 44)
	resume.Activated:Connect(function()
		if resume.Active then finish("Last") end
	end)
	_resume = resume

	-- Kosten rechts im Knopf: Gummi-Icon + Zahl
	local coin = Icons.make(resume, "gummy", "G")
	coin.AnchorPoint = Vector2.new(1, 0.5)
	coin.Position = UDim2.new(1, -56, 0.5, 0)
	coin.Size = UDim2.fromOffset(24, 24)
	local cost = Theme.label("Cost", resume, "")
	cost.AnchorPoint = Vector2.new(1, 0.5)
	cost.Position = UDim2.new(1, -8, 0.5, 0)
	cost.Size = UDim2.fromOffset(46, 24)
	_cost = cost

	local fresh = Theme.button("Fresh", root, Loc.t("ui.fight.fresh"), Theme.COLORS.panelLight)
	fresh.Position = UDim2.new(0, 8, 0, 58)
	fresh.Size = UDim2.new(0.42, 0, 0, 26)
	fresh.TextColor3 = Theme.COLORS.text
	Loc.bind(fresh, "ui.fight.fresh")
	fresh.Activated:Connect(function() finish("Fresh") end)

	-- Ablaufbalken: zeigt, dass es gleich von selbst bei Stage 1 losgeht
	local track = Instance.new("Frame")
	track.Name = "Timer"
	track.BackgroundColor3 = Theme.COLORS.panelLight
	track.BorderSizePixel = 0
	track.Position = UDim2.new(0.42, 16, 0, 66)
	track.Size = UDim2.new(0.58, -24, 0, 10)
	track.Parent = root
	Theme.corner(track, 5)
	local bar = Instance.new("Frame")
	bar.BackgroundColor3 = Theme.COLORS.goldGummy
	bar.BorderSizePixel = 0
	bar.Size = UDim2.fromScale(1, 1)
	bar.Parent = track
	Theme.corner(bar, 5)
	_bar = bar

	RunService.RenderStepped:Connect(function()
		if not _onChoose then return end
		local left = math.clamp(1 - (os.clock() - _openedAt) / FightStartPrompt.AUTO_SECONDS, 0, 1)
		local b = _bar
		if b then b.Size = UDim2.fromScale(left, 1) end
	end)

end

return FightStartPrompt
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">FusionPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- FusionPanel.luau
-- StarterPlayerScripts/UI/FusionPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Zwei im Inventar markierte Baerchis bestaetigen und fusionieren
--   - Den Sperr-Schritt anbieten (Ability / Level / Eier von A oder B)
--   - Das Ergebnis kurz zeigen
--
-- Die Auswahl der beiden Baerchis passiert im Inventar (BaerchiInventory,
-- Fusions-Modus). Dieses Panel bekommt die beiden uids beim Oeffnen uebergeben
-- und haelt selbst nur noch die Sperr-Entscheidung.
--
-- ============================================================
-- DREI ANSICHTEN, WEIL DIE FUSION SEIT v8 EINE ENTSCHEIDUNG IST
-- ============================================================
--   1. Auswahl  — was kommt rein, was kommt heraus (Vorschau)
--   2. Sperren  — genau EINE von drei Eigenschaften festlegen
--   3. Ergebnis — was tatsaechlich herausgekommen ist
--
-- Der Sperr-Schritt liegt DAZWISCHEN und nicht in der Auswahl, weil er nur
-- Sinn hat, wenn beide Baerchis feststehen: erst dann gibt es zwei Werte zum
-- Vergleichen. Wer nichts sperren will, klickt einfach durch — "automatisch"
-- ist ueberall der Ausgangszustand.
--
-- ============================================================
-- ZUR VORSCHAU
-- ============================================================
-- Die Fusions-Regel steht verbindlich im Kopf von FusionService. Hier wird sie
-- NUR nachgelesen, um zu zeigen was herauskommt. Seit v14 steigt die Rarity
-- NICHT mehr: das Ergebnis ist die Art des levelhoeheren Baerchis (bei
-- Gleichstand A) in derselben Rarity, mit den besseren Stats beider.
--
-- Abgelehnt wird trotzdem serverseitig: die Vorschau kann veraltet sein.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Loc = require(game:GetService("ReplicatedStorage").Localization.Loc)   -- Sammel-Update 2.4

local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local EconomyConfig   = require(ReplicatedStorage.Config.EconomyConfig)
local PromotionConfig = require(ReplicatedStorage.Config.PromotionConfig)
local SkillConfig     = require(ReplicatedStorage.Config.SkillConfig)
local Loc             = require(ReplicatedStorage.Localization.Loc)
local Names           = require(ReplicatedStorage.Localization.Names)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local FusionPanel = {}

local PANEL_NAME = "Fusion"

local _root: Frame?             = nil
local _selectView: Frame?       = nil
local _lockView: Frame?         = nil
local _resultView: Frame?       = nil
local _slotLabels: { TextLabel } = {}
local _previewLabel: TextLabel? = nil
local _detailLabel: TextLabel?  = nil
local _nextButton: TextButton?  = nil
local _resultTitle: TextLabel?  = nil
local _resultSub: TextLabel?    = nil

local _uidA: string? = nil
local _uidB: string? = nil

-- Die Sperr-Entscheidung. Beide zusammen oder beide nil — der Server
-- verwirft eine halbe Auswahl ohnehin (siehe FusionService.init).
local _lockedProperty: string? = nil
local _lockedFrom: string?     = nil

--------------------------------------------------------------------------------
-- Die drei sperrbaren Eigenschaften
--------------------------------------------------------------------------------

-- `read` liefert den ANZEIGETEXT dieser Eigenschaft fuer einen Baerchi.
-- Was der Server daraus macht, steht in FusionService — hier wird nur gezeigt,
-- worueber man entscheidet.
type LockDef = {
	id    : string,
	label : string,   -- Loc-Schluessel
	read  : (Types.Baerchi) -> string,
}

local LOCK_DEFS: { LockDef } = {
	{
		id    = "ability",
		label = "ui.fusion.lock_ability",
		read  = function(baerchi: Types.Baerchi): string
			return Names.skill(baerchi.skillId)
		end,
	},
	{
		id    = "level",
		label = "ui.fusion.lock_level",
		read  = function(baerchi: Types.Baerchi): string
			return "Lv. " .. baerchi.level
		end,
	},
	{
		id    = "eggs",
		label = "ui.fusion.lock_eggs",
		read  = function(baerchi: Types.Baerchi): string
			local levels = baerchi.statLevels
			local value  = if levels then (levels.egg or 0) else 0
			return Loc.t("ui.fusion.stage", { n = value })
		end,
	},
}

type LockRow = {
	def     : LockDef,
	valueA  : TextLabel,
	valueB  : TextLabel,
	buttons : { [string]: TextButton },   -- "auto" | "A" | "B"
}

local _lockRows: { LockRow } = {}

--------------------------------------------------------------------------------
-- Vorschau
--------------------------------------------------------------------------------

type Preview = {
	ok      : boolean,
	headline: string,
	detail  : string,
}

local function buildPreview(a: Types.Baerchi?, b: Types.Baerchi?): Preview
	local data = ClientState.get()
	if not data or not a or not b then
		return { ok = false, headline = Loc.t("ui.fusion.pick_two"), detail = "" }
	end

	if a.uid == b.uid then
		return { ok = false, headline = Loc.t("ui.fusion.two_needed"), detail = "" }
	end

	if a.rarity ~= b.rarity then
		return {
			ok = false,
			headline = Loc.t("ui.fusion.rarity_mismatch"),
			detail   = Loc.t("ui.fusion.rarity_mismatch_detail", { a = Loc.t("rarity." .. a.rarity), b = Loc.t("rarity." .. b.rarity) }),
		}
	end

	-- Seit v8: das HOEHERE Level, nicht mehr der Durchschnitt (siehe
	-- FusionService, Regel C).
	local resultLevel = math.clamp(math.max(a.level, b.level), 1, BaerchiConfig.MAX_LEVEL)
	local bonus       = EconomyConfig.getFusionStatBonus()

	-- v14: keine hoehere Rarity mehr — die Art des levelhoeheren Inputs.
	local keep = if b.level > a.level then b else a
	local keepDef = BaerchiConfig.getById(keep.configId)
	local headline = string.format("%s  (%s)",
		Names.baerchi(keep.configId),
		Loc.t("rarity." .. keep.rarity))

	local detail = Loc.t("ui.fusion.detail", { level = resultLevel, bonus = math.floor(bonus * 100 + 0.5) })

	return { ok = true, headline = headline, detail = detail }
end

--------------------------------------------------------------------------------
-- Anzeige
--------------------------------------------------------------------------------

local function describe(baerchi: Types.Baerchi?): (string, Color3)
	if not baerchi then
		return Loc.t("ui.fusion.empty"), Theme.COLORS.textDim
	end

	return string.format(
		"%s  —  %s  —  Lv. %d",
		Names.baerchi(baerchi.configId),
		Names.rarity(baerchi.rarity),
		baerchi.level
	), Theme.rarityColor(baerchi.rarity)
end

local function refreshLockRows(a: Types.Baerchi?, b: Types.Baerchi?)
	for _, lockRow in _lockRows do
		lockRow.valueA.Text = if a then lockRow.def.read(a) else "—"
		lockRow.valueB.Text = if b then lockRow.def.read(b) else "—"

		local isLocked = _lockedProperty == lockRow.def.id

		for choice, button in lockRow.buttons do
			local active =
				(choice == "auto" and not isLocked)
				or (isLocked and choice == _lockedFrom)

			-- Aktive Wahl faerbig, die anderen matt. Bewusst ueber die
			-- Hintergrundfarbe und nicht ueber setEnabled: alle drei bleiben
			-- klickbar, sonst koennte man eine Sperre nicht mehr aufheben.
			button.BackgroundColor3 = if active
				then Theme.COLORS.accent
				else Theme.COLORS.panelLight
			button.TextColor3 = if active then Theme.COLORS.outline else Theme.COLORS.text
		end
	end
end

function FusionPanel.refresh()
	local root = _root
	if not root or not root.Visible then return end

	local a = if _uidA then ClientState.getBaerchi(_uidA) else nil
	local b = if _uidB then ClientState.getBaerchi(_uidB) else nil

	local labelA, colorA = describe(a)
	local labelB, colorB = describe(b)

	if _slotLabels[1] then
		_slotLabels[1].Text      = "A:  " .. labelA
		_slotLabels[1].TextColor3 = colorA
	end
	if _slotLabels[2] then
		_slotLabels[2].Text      = "B:  " .. labelB
		_slotLabels[2].TextColor3 = colorB
	end

	local preview = buildPreview(a, b)

	if _previewLabel then
		_previewLabel.Text       = preview.headline
		_previewLabel.TextColor3 = if preview.ok then Theme.COLORS.text else Theme.COLORS.bad
	end
	if _detailLabel then
		_detailLabel.Text = preview.detail
	end
	if _nextButton then
		Theme.setEnabled(_nextButton, preview.ok)
	end

	refreshLockRows(a, b)
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function showView(which: "select" | "lock" | "result")
	if _selectView then _selectView.Visible = which == "select" end
	if _lockView   then _lockView.Visible   = which == "lock"   end
	if _resultView then _resultView.Visible = which == "result" end
end

local function openInternal(...: any)
	local root = _root
	if not root then return end

	local argA, argB = ...

	_uidA = nil
	_uidB = nil
	if typeof(argA) == "string" then _uidA = argA :: string end
	if typeof(argB) == "string" then _uidB = argB :: string end

	-- Jede neue Fusion startet ohne Sperre: eine Auswahl von der letzten
	-- Fusion stillschweigend zu uebernehmen waere die Art Ueberraschung, bei
	-- der hinterher niemand weiss, warum das Ergebnis so aussieht.
	_lockedProperty = nil
	_lockedFrom     = nil

	showView("select")
	root.Visible = true
	FusionPanel.refresh()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
end

--------------------------------------------------------------------------------
-- Ergebnis
--------------------------------------------------------------------------------

local function showResult(result: Types.FusionResult)
	local baerchi = result.resultBaerchi
	local name    = Names.baerchi(baerchi.configId)

	Notify.emit("fusion_result", function()
		Toast.success(Loc.t("msg.fusion_done", { name = name, rarity = Names.rarity(baerchi.rarity), level = baerchi.level }))
	end)

	local root = _root
	if not root or not root.Visible then return end

	if _resultTitle then
		_resultTitle.Text       = name
		_resultTitle.TextColor3 = Theme.rarityColor(baerchi.rarity)
	end
	if _resultSub then
		local levels = baerchi.statLevels
		local cap    = PromotionConfig.getStatCap(baerchi.rarity)

		-- Frueher stand hier noch DEF: das Feld gibt es seit dem Wegfall der
		-- Verteidigung nicht mehr, string.format("%d", nil) brach ab und der
		-- Ergebnis-Bildschirm kam nie. Jetzt die fuenf echten Stat-Stufen.
		_resultSub.Text = Loc.t("ui.fusion.result_detail", {
			rarity = Names.rarity(baerchi.rarity),
			level  = baerchi.level,
			bonus  = math.floor((baerchi.fusionBonus or 0) * 100 + 0.5),
			hp     = if levels then levels.hp  or 0 else 0,
			atk    = if levels then levels.atk or 0 else 0,
			spd    = if levels then levels.spd or 0 else 0,
			pwr    = if levels then levels.pwr or 0 else 0,
			egg    = if levels then levels.egg or 0 else 0,
			cap    = cap,
		})
	end

	showView("result")
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function FusionPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"FusionPanel", screenGui,
		Vector2.new(0.48, 0.56),
		Vector2.new(320, 320),
		Vector2.new(540, 460)
	)
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.fusion.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	-- ------------------------------------------------------- Auswahl-Ansicht
	local selectView = Theme.container("SelectView", body)
	selectView.Size = UDim2.fromScale(1, 1)
	_selectView = selectView

	for slot = 1, 2 do
		local label = Theme.label("Slot" .. slot, selectView, "")
		label.Position   = UDim2.new(0, 4, 0, (slot - 1) * 26)
		label.Size       = UDim2.new(1, -8, 0, 22)
		label.TextColor3  = Theme.COLORS.textDim
		_slotLabels[slot] = label
	end

	local arrow = Theme.label("Arrow", selectView, Loc.t("ui.fusion.becomes"))
	arrow.Position       = UDim2.new(0, 4, 0, 58)
	arrow.Size           = UDim2.new(1, -8, 0, 18)
	arrow.TextXAlignment = Enum.TextXAlignment.Center
	arrow.TextColor3     = Theme.COLORS.textDim

	local previewBox = Theme.panel("Preview", selectView, Theme.COLORS.panel)
	previewBox.Position = UDim2.new(0, 0, 0, 80)
	previewBox.Size     = UDim2.new(1, -8, 0, 106)

	local preview = Theme.label("Headline", previewBox, "")
	preview.Position       = UDim2.new(0, 10, 0, 8)
	preview.Size           = UDim2.new(1, -20, 0, 26)
	preview.TextXAlignment = Enum.TextXAlignment.Center
	_previewLabel = preview

	local detail = Theme.bodyText("Detail", previewBox, "")
	detail.Position       = UDim2.new(0, 10, 0, 36)
	detail.Size           = UDim2.new(1, -20, 0, 62)
	detail.TextXAlignment = Enum.TextXAlignment.Center
	_detailLabel = detail

	local back = Theme.button("Back", selectView, "", Theme.COLORS.panelLight)
	Loc.bind(back, "ui.common.back")
	back.AnchorPoint = Vector2.new(0, 1)
	back.Position    = UDim2.new(0, 0, 1, 0)
	back.Size        = UDim2.new(0.5, -6, 0, 36)
	back.TextColor3  = Theme.COLORS.text
	back.Activated:Connect(function()
		PanelManager.open("Inventory")
	end)

	local next_ = Theme.button("Next", selectView, "", Theme.COLORS.gummy)
	Loc.bind(next_, "ui.common.next")
	next_.AnchorPoint = Vector2.new(1, 1)
	next_.Position    = UDim2.new(1, -8, 1, 0)
	next_.Size        = UDim2.new(0.5, -6, 0, 36)
	_nextButton = next_
	next_.Activated:Connect(function()
		showView("lock")
		FusionPanel.refresh()
	end)

	-- -------------------------------------------------------- Sperr-Ansicht
	local lockView = Theme.container("LockView", body)
	lockView.Size    = UDim2.fromScale(1, 1)
	lockView.Visible = false
	_lockView = lockView

	local lockHint = Theme.bodyText("LockHint", lockView,
		Loc.t("ui.fusion.lock_hint"))
	lockHint.Position = UDim2.new(0, 4, 0, 0)
	lockHint.Size     = UDim2.new(1, -8, 0, 40)

	for index, def in LOCK_DEFS do
		local y = 44 + (index - 1) * 52

		local rowFrame = Theme.panel("Lock_" .. def.id, lockView, Theme.COLORS.panel)
		rowFrame.Position = UDim2.new(0, 0, 0, y)
		rowFrame.Size     = UDim2.new(1, -8, 0, 46)

		local name = Theme.label("Name", rowFrame, "")
		Loc.bind(name, def.label)
		name.Position   = UDim2.new(0, 10, 0, 2)
		name.Size       = UDim2.new(0, 70, 0, 20)
		name.TextScaled = false
		name.TextSize   = 15

		local valueA = Theme.label("ValueA", rowFrame, "—")
		valueA.Position   = UDim2.new(0, 10, 0, 22)
		valueA.Size       = UDim2.new(0, 110, 0, 18)
		valueA.TextScaled = false
		valueA.TextSize   = 12
		valueA.TextColor3 = Theme.COLORS.textDim

		local valueB = Theme.label("ValueB", rowFrame, "—")
		valueB.Position   = UDim2.new(0, 124, 0, 22)
		valueB.Size       = UDim2.new(0, 110, 0, 18)
		valueB.TextScaled = false
		valueB.TextSize   = 12
		valueB.TextColor3 = Theme.COLORS.textDim

		local buttons: { [string]: TextButton } = {}

		local choices = { "auto", "A", "B" }
		for order, choice in choices do
			local button = Theme.button("Choice_" .. choice, rowFrame, choice, Theme.COLORS.panelLight)
		if choice == "auto" then Loc.bind(button, "ui.fusion.auto") end
			button.AnchorPoint = Vector2.new(1, 0.5)
			button.Position    = UDim2.new(1, -8 - (3 - order) * 46, 0.5, 0)
			button.Size        = UDim2.new(0, 42, 0, 28)
			button.TextColor3  = Theme.COLORS.text

			button.Activated:Connect(function()
				if choice == "auto" then
					-- Nur die Sperre DIESER Zeile aufheben; eine Sperre in einer
					-- anderen Zeile bleibt bestehen.
					if _lockedProperty == def.id then
						_lockedProperty = nil
						_lockedFrom     = nil
					end
				else
					-- Es darf immer nur EINE Eigenschaft gesperrt sein: eine
					-- neue Wahl ersetzt deshalb die alte, statt sich dazu zu
					-- gesellen.
					_lockedProperty = def.id
					_lockedFrom     = choice
				end

				FusionPanel.refresh()
			end)

			buttons[choice] = button
		end

		table.insert(_lockRows, {
			def     = def,
			valueA  = valueA,
			valueB  = valueB,
			buttons = buttons,
		})
	end

	local lockBack = Theme.button("LockBack", lockView, "", Theme.COLORS.panelLight)
	Loc.bind(lockBack, "ui.common.back")
	lockBack.AnchorPoint = Vector2.new(0, 1)
	lockBack.Position    = UDim2.new(0, 0, 1, 0)
	lockBack.Size        = UDim2.new(0.5, -6, 0, 36)
	lockBack.TextColor3  = Theme.COLORS.text
	lockBack.Activated:Connect(function()
		showView("select")
		FusionPanel.refresh()
	end)

	local confirm = Theme.button("Confirm", lockView, "", Theme.COLORS.gummy)
	Loc.bind(confirm, "ui.fusion.fuse")
	confirm.AnchorPoint = Vector2.new(1, 1)
	confirm.Position    = UDim2.new(1, -8, 1, 0)
	confirm.Size        = UDim2.new(0.5, -6, 0, 36)
	confirm.Activated:Connect(function()
		local a, b = _uidA, _uidB
		if not a or not b then return end
		Remotes.RequestFuseBaerchis:FireServer(a, b, _lockedProperty, _lockedFrom)
	end)

	-- ------------------------------------------------------ Ergebnis-Ansicht
	local resultView = Theme.container("ResultView", body)
	resultView.Size    = UDim2.fromScale(1, 1)
	resultView.Visible = false
	_resultView = resultView

	local resultHint = Theme.label("Hint", resultView, Loc.t("ui.fusion.success"))
	resultHint.Position       = UDim2.new(0, 4, 0, 6)
	resultHint.Size           = UDim2.new(1, -8, 0, 22)
	resultHint.TextXAlignment = Enum.TextXAlignment.Center
	resultHint.TextColor3     = Theme.COLORS.good

	local resultTitle = Theme.label("Title", resultView, "")
	resultTitle.Position       = UDim2.new(0, 4, 0, 40)
	resultTitle.Size           = UDim2.new(1, -8, 0, 34)
	resultTitle.TextXAlignment = Enum.TextXAlignment.Center
	_resultTitle = resultTitle

	local resultSub = Theme.bodyText("Sub", resultView, "")
	resultSub.Position       = UDim2.new(0, 4, 0, 80)
	resultSub.Size           = UDim2.new(1, -8, 0, 76)
	resultSub.TextXAlignment = Enum.TextXAlignment.Center
	_resultSub = resultSub

	local done = Theme.button("Done", resultView, Loc.t("ui.fusion.to_inventory"), Theme.COLORS.accent)
	done.AnchorPoint = Vector2.new(0.5, 1)
	done.Position    = UDim2.new(0.5, -4, 1, 0)
	done.Size        = UDim2.new(1, -8, 0, 36)
	done.Activated:Connect(function()
		PanelManager.open("Inventory")
	end)

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	ClientState.onChanged(function()
		FusionPanel.refresh()
	end)

	Remotes.FusionResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		showResult(result :: Types.FusionResult)
	end)

	-- Sprachwechsel bei offenem Fenster: Vorschau und Zeilen neu beschriften
	Loc.onChanged(function()
		FusionPanel.refresh()
	end)

	print("[FusionPanel] Initialisiert")
end

return FusionPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">HatchAnimation</string><ProtectedString name="Source"><![CDATA[--!strict
-- HatchAnimation.luau
-- StarterPlayerScripts/UI/HatchAnimation.luau
--
-- Einzige Zustaendigkeit:
--   - Die Ei-Oeffnen-Animation abspielen: Drop, Wackeln, Risse, Aufladen,
--     Burst in der Rarity-Farbe, Reveal-Karte des Baerchis.
--
-- Reine Client-Optik aus UI-Elementen, keine Assets. Der Server entscheidet
-- allein, was aus dem Ei kommt (EggService.openEgg) — die Animation startet
-- trotzdem SOFORT beim Klick (Drop + Wackeln in Schleife) und geht erst zu
-- Rissen und Burst ueber, wenn das Ergebnis da ist. So fuehlt sich der Klick
-- unmittelbar an, ohne dass der Client etwas vorwegnimmt.
--
-- Ablauf pro Ei (bei normaler Rarity rund 3 Sekunden):
--   1. Drop     — Ei faellt von oben ins Bild und federt
--   2. Wackeln  — drei Stufen, jede staerker, mit jeder ein Riss
--   3. Aufladen — starkes Zittern, Gluehen in der Rarity-Farbe
--   4. Burst    — weisser Blitz, Ring, Partikel in der Rarity-Farbe
--   5. Reveal   — Karte mit Name, Rarity, Level, NEU!, Mutation
--
-- Die Rarity bestimmt die Wucht (siehe intensityFor): ab Epic mehr Risse,
-- ab Legendary laenger Wackeln, Bildschirmzittern und mehr Partikel, ab Divine
-- zusaetzlich ein Lichtstrahl. Das skaliert ueber den Rarity-Index und
-- funktioniert damit auch fuer kuenftige Rarities ohne Code-Aenderung.
--
-- Mehrere Eier: jede Oeffnung kommt in eine Warteschlange und wird
-- nacheinander gezeigt. Ergebnisse kommen in derselben Reihenfolge an, in der
-- die Anfragen rausgingen (ein Remote, ein Server-Thread) — deshalb wird ein
-- eintreffendes Ergebnis immer der aeltesten noch offenen Oeffnung zugeordnet.
--
-- Ton: bewusst offen (keine verifizierten Sound-Assets).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local TweenService      = game:GetService("TweenService")

local Types         = require(ReplicatedStorage.Network.Types)
local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local Names         = require(ReplicatedStorage.Localization.Names)

local BaerchiMesh   = require(ReplicatedStorage.Modules.BaerchiMesh)   -- Sammel-Update 2.2: Baerchi gross zeigen
local Loc           = require(ReplicatedStorage.Localization.Loc)

local Theme = require(script.Parent.Theme)
local EggIcon = require(script.Parent.EggIcon)
local Toast = require(script.Parent.Toast)
-- Sammel-Update: fehlte, Notify.emit beim Fehlschlag waere ein Laufzeitfehler.
local Notify = require(script.Parent.Notify)

local HatchAnimation = {}

--------------------------------------------------------------------------------
-- Zahlen (reine Optik, deshalb hier und nicht in einer Config)
--------------------------------------------------------------------------------

local DROP_SECONDS        = 0.4
local WOBBLE_STAGE_SECONDS = 0.45   -- pro Wackel-Stufe (3 Stufen = ~1,4 s)
local CHARGE_SECONDS      = 0.3
-- Sammel-Update 2.2 ("Ei-Oeffnen geht zu schnell weg"): das Ergebnis bleibt
-- mindestens REVEAL_MIN_SECONDS stehen (vorher 1,2 s + 0,8 s) und schliesst
-- danach erst durch Tippen oder nach REVEAL_AUTO_CLOSE Sekunden.
local REVEAL_SECONDS      = 2.5
local REVEAL_MIN_TAP      = 0.8     -- frueher als das schliesst auch ein Tipp nicht
local REVEAL_AUTO_CLOSE   = 7.0
local CARD_SIZE           = Vector2.new(360, 330)
local MODEL_VIEW_HEIGHT   = 150
local FADE_SECONDS        = 0.25
local RESULT_TIMEOUT      = 5       -- Sekunden ohne Server-Antwort, dann Abbruch
local SKIP_AFTER          = 1.0     -- ab hier beschleunigt ein Tap aufs Ergebnis
local EGG_SIZE            = Vector2.new(150, 190)
local BACKDROP_TRANSPARENCY = 0.35

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

type Job = {
	eggType : Types.EggType,
	result  : Types.HatchResult?,
	failed  : string?,     -- Grund, falls der Server abgelehnt hat oder nichts kam
	silent  : boolean,     -- true = die Meldung hat schon der Toast gezeigt (ActionFailed)
	started : number,      -- os.clock() beim Klick (fuer den Timeout)
}

local _screenGui: ScreenGui? = nil
local _queue: { Job } = {}
local _running = false
local _skip = false

--------------------------------------------------------------------------------
-- Intensitaet nach Rarity
--------------------------------------------------------------------------------

type Intensity = {
	cracks    : number,    -- Risse insgesamt
	wobbleMul : number,    -- Faktor auf die Wackel-Dauer
	amplitude : number,    -- Grad, maximales Wackeln in der letzten Stufe
	particles : number,
	shake     : boolean,   -- Bildschirmzittern
	beam      : boolean,   -- Lichtstrahl hinter der Karte
	flash     : number,    -- Deckkraft des weissen Blitzes (0..1)
}

local function intensityFor(rarity: Types.Rarity): Intensity
	-- Common = 1 ... Omega = 12. Unbekannte Rarities zaehlen wie Common.
	local index = BaerchiConfig.getRarityIndex(rarity) or 1

	return {
		cracks    = if index >= 4 then 5 else 3,
		wobbleMul = if index >= 5 then 1.35 else 1,
		amplitude = math.min(10 + index * 2.5, 32),
		particles = math.min(10 + index * 4, 56),
		shake     = index >= 5,
		beam      = index >= 7,
		flash     = if index >= 4 then 0.95 else 0.6,
	}
end

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function tween(instance: Instance, seconds: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local info = TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(instance, info, props)
	t:Play()
	return t
end

-- Wartet `seconds`, bricht aber frueher ab, sobald der Spieler ueberspringt.
local function waitSkippable(seconds: number)
	local untilTime = os.clock() + seconds
	while os.clock() < untilTime do
		if _skip then return end
		RunService.RenderStepped:Wait()
	end
end

local function newFrame(name: string, parent: Instance, size: UDim2, position: UDim2, color: Color3): Frame
	local frame = Instance.new("Frame")
	frame.Name             = name
	frame.Size             = size
	frame.Position         = position
	frame.AnchorPoint      = Vector2.new(0.5, 0.5)
	frame.BackgroundColor3 = color
	frame.BorderSizePixel  = 0
	frame.Parent           = parent
	return frame
end

local function round(frame: Frame)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = frame
end

--------------------------------------------------------------------------------
-- Bausteine der Szene
--------------------------------------------------------------------------------

type Scene = {
	root     : Frame,     -- Vollbild, faengt Taps
	backdrop : Frame,
	stage    : Frame,     -- traegt alles, wird beim Bildschirmzittern verschoben
	glow     : Frame,
	egg      : Frame,
	eggStroke: UIStroke,
	cracks   : Frame,
	label    : TextLabel,
}

local function buildScene(screenGui: ScreenGui, eggType: Types.EggType): Scene
	local eggDef   = EggConfig.data[eggType]
	local eggColor = if eggDef then eggDef.color else Color3.fromRGB(238, 232, 214)

	local root = Instance.new("TextButton")
	root.Name                   = "HatchAnimation"
	root.Text                   = ""
	root.AutoButtonColor        = false
	root.BackgroundTransparency = 1
	root.Size                   = UDim2.fromScale(1, 1)
	root.ZIndex                 = 50
	root.Parent                 = screenGui

	local backdrop = newFrame("Backdrop", root, UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0.5), Color3.new(0, 0, 0))
	backdrop.BackgroundTransparency = 1
	backdrop.ZIndex = 50

	local stage = Instance.new("Frame")
	stage.Name                   = "Stage"
	stage.BackgroundTransparency = 1
	stage.Size                   = UDim2.fromScale(1, 1)
	stage.ZIndex                 = 51
	stage.Parent                 = root

	-- Leuchten hinter dem Ei (erst beim Aufladen sichtbar)
	local glow = newFrame("Glow", stage, UDim2.fromOffset(EGG_SIZE.X * 1.6, EGG_SIZE.Y * 1.5), UDim2.fromScale(0.5, 0.48), Color3.new(1, 1, 1))
	glow.BackgroundTransparency = 1
	glow.ZIndex = 51
	round(glow)

	-- Das Ei: eine Ellipse in der Ei-Farbe mit dickem Cartoon-Rand
	local egg = newFrame("Egg", stage, UDim2.fromOffset(EGG_SIZE.X, EGG_SIZE.Y), UDim2.new(0.5, 0, -0.3, 0), eggColor)
	egg.ZIndex = 52
	round(egg)
	local stroke = Theme.stroke(egg, Theme.COLORS.outline, 4)
	Theme.gradient(egg, Theme.shade(eggColor, 0.25), Theme.shade(eggColor, -0.15))

	-- Muster und Glanzpunkt wie auf dem Ei in der Welt (EggIcon/EggLook)
	EggIcon.decorate(egg, eggType, EGG_SIZE.X / EGG_SIZE.Y, 53)

	local cracks = Instance.new("Frame")
	cracks.Name                   = "Cracks"
	cracks.BackgroundTransparency = 1
	cracks.Size                   = UDim2.fromScale(1, 1)
	cracks.ZIndex                 = 54
	cracks.Parent                 = egg

	local label = Theme.label("Hint", stage, Names.egg(tostring(eggType)))
	label.AnchorPoint    = Vector2.new(0.5, 0)
	label.Position       = UDim2.new(0.5, 0, 0.48, EGG_SIZE.Y * 0.5 + 18)
	label.Size           = UDim2.fromOffset(320, 30)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.ZIndex         = 55
	Theme.outlineText(label)

	return {
		root = root, backdrop = backdrop, stage = stage, glow = glow,
		egg = egg, eggStroke = stroke, cracks = cracks, label = label,
	}
end

-- Ein Riss: zwei kurze, dunkle, schraeg gestellte Striche als Zickzack.
local function addCrack(scene: Scene, index: number)
	local x = 0.25 + ((index * 0.37) % 0.5)
	local y = 0.30 + ((index * 0.23) % 0.4)
	local base = (index % 2 == 0) and 35 or -35

	for part = 0, 1 do
		local line = newFrame("Crack" .. index .. "_" .. part, scene.cracks,
			UDim2.new(0, 0, 0, 4),
			UDim2.fromScale(x + part * 0.08, y + part * 0.07),
			Theme.COLORS.outline)
		line.Rotation = base * (if part == 0 then 1 else -1)
		line.ZIndex   = 54
		tween(line, 0.12, { Size = UDim2.new(0.22, 0, 0, 4) })
	end
end

-- Partikel: kleine Quadrate, die in alle Richtungen auseinanderfliegen.
local function burstParticles(scene: Scene, color: Color3, count: number)
	for index = 1, count do
		local angle    = (index / count) * math.pi * 2 + math.random() * 0.4
		local distance = 180 + math.random() * 220
		local size     = 8 + math.random() * 10

		local particle = newFrame("Particle", scene.stage, UDim2.fromOffset(size, size), UDim2.fromScale(0.5, 0.48),
			if index % 3 == 0 then Color3.new(1, 1, 1) else color)
		particle.ZIndex   = 56
		particle.Rotation = math.random(0, 90)

		tween(particle, 0.6 + math.random() * 0.3, {
			Position = UDim2.new(0.5, math.cos(angle) * distance, 0.48, math.sin(angle) * distance),
			BackgroundTransparency = 1,
			Rotation = particle.Rotation + 180,
		})
		task.delay(1, function()
			particle:Destroy()
		end)
	end
end

local function burstRing(scene: Scene, color: Color3)
	local ring = newFrame("Ring", scene.stage, UDim2.fromOffset(60, 60), UDim2.fromScale(0.5, 0.48), color)
	ring.BackgroundTransparency = 1
	ring.ZIndex = 55
	round(ring)
	local stroke = Theme.stroke(ring, color, 10)

	tween(ring, 0.55, { Size = UDim2.fromOffset(620, 620) })
	tween(stroke, 0.55, { Transparency = 1, Thickness = 2 })
	task.delay(0.6, function()
		ring:Destroy()
	end)
end

local function flash(scene: Scene, strength: number)
	local white = newFrame("Flash", scene.root, UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0.5), Color3.new(1, 1, 1))
	white.BackgroundTransparency = 1 - strength
	white.ZIndex = 60
	tween(white, 0.45, { BackgroundTransparency = 1 })
	task.delay(0.5, function()
		white:Destroy()
	end)
end

local function shakeScreen(scene: Scene, seconds: number, strength: number)
	task.spawn(function()
		local untilTime = os.clock() + seconds
		while os.clock() < untilTime and scene.stage.Parent do
			scene.stage.Position = UDim2.fromOffset(
				math.random(-strength, strength),
				math.random(-strength, strength)
			)
			RunService.RenderStepped:Wait()
		end
		if scene.stage.Parent then
			scene.stage.Position = UDim2.fromOffset(0, 0)
		end
	end)
end

local function beam(scene: Scene, color: Color3)
	for index = 0, 2 do
		local ray = newFrame("Beam" .. index, scene.stage, UDim2.fromOffset(70, 0), UDim2.fromScale(0.5, 0.48), color)
		ray.BackgroundTransparency = 0.35
		ray.Rotation = -20 + index * 20
		ray.ZIndex   = 51
		Theme.gradient(ray, Theme.shade(color, 0.6), color, 0)
		tween(ray, 0.35, { Size = UDim2.fromOffset(70, 1400) })
		task.delay(REVEAL_SECONDS + 0.4, function()
			if ray.Parent then
				tween(ray, FADE_SECONDS, { BackgroundTransparency = 1 })
			end
		end)
	end
end

-- Die Reveal-Karte. Eine Mutation uebernimmt Farbe und Titel und bekommt
-- zusaetzlich einen farbigen Ring um die Karte.
local function buildReveal(scene: Scene, result: Types.HatchResult): Frame
	local baerchi  = result.baerchi
	local def      = BaerchiConfig.getById(baerchi.configId)
	local mutation = baerchi.mutation
	local rarityColor = Theme.rarityColor(baerchi.rarity)
	local color = if mutation then BaerchiConfig.getMutationColor(mutation) else rarityColor

	local card = Theme.panel("RevealCard", scene.stage, Theme.COLORS.panelDeep)
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position    = UDim2.fromScale(0.5, 0.48)
	card.Size        = UDim2.fromOffset(0, 0)
	card.ZIndex      = 57

	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color     = color
		stroke.Thickness = 5
	end

	if mutation then
		local ring = newFrame("MutationRing", card, UDim2.new(1, 22, 1, 22), UDim2.fromScale(0.5, 0.5), color)
		ring.BackgroundTransparency = 1
		ring.ZIndex = 56
		Theme.corner(ring, 22)
		Theme.stroke(ring, color, 4)
	end

	local function cardLabel(name: string, text: string, y: number, height: number, textColor: Color3): TextLabel
		local label = Theme.label(name, card, text)
		label.AnchorPoint    = Vector2.new(0.5, 0)
		label.Position       = UDim2.new(0.5, 0, 0, y)
		label.Size           = UDim2.new(1, -24, 0, height)
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.TextColor3     = textColor
		label.ZIndex         = 58
		return label
	end

	if result.isNew then
		local new = cardLabel("New", Loc.t("ui.hatch.new"), 10, 22, Theme.COLORS.goldGummy)
		Theme.outlineText(new)
	end

	-- Sammel-Update 2.2 (Luccini: "Baerchen bei Eioeffnung zeigen"): der
	-- Baerchi selbst, gross und drehend, in einem ViewportFrame.
	local view = Instance.new("ViewportFrame")
	view.Name                   = "Model"
	view.AnchorPoint            = Vector2.new(0.5, 0)
	view.Position               = UDim2.new(0.5, 0, 0, 34)
	view.Size                   = UDim2.new(1, -40, 0, MODEL_VIEW_HEIGHT)
	view.BackgroundTransparency = 1
	view.ZIndex                 = 58
	view.Ambient                = Color3.fromRGB(200, 200, 210)
	view.LightColor             = Color3.fromRGB(255, 250, 235)
	view.Parent                 = card
	local okModel, model = pcall(function()
		return BaerchiMesh.build(Vector3.zero, rarityColor, baerchi.rarity,
			if mutation then BaerchiConfig.getMutationColor(mutation) else nil)
	end)
	if okModel and model then
		model.Parent = view
		local cf, size = model:GetBoundingBox()
		local camera = Instance.new("Camera")
		camera.FieldOfView = 30
		local radius = math.max(size.X, size.Y, size.Z)
		local distance = radius / (2 * math.tan(math.rad(camera.FieldOfView / 2))) * 1.1
		camera.Parent = view
		view.CurrentCamera = camera
		-- Langsam drehen, solange die Karte steht (Ende: Karte zerstoert).
		local center = cf.Position
		local spin = 0
		local conn: RBXScriptConnection? = nil
		conn = RunService.RenderStepped:Connect(function(dt)
			if not view.Parent then
				if conn then conn:Disconnect() end
				return
			end
			spin += dt * 0.9
			local dir = Vector3.new(math.sin(spin), 0.3, math.cos(spin)).Unit
			camera.CFrame = CFrame.lookAt(center + dir * distance, center)
		end)
	end

	local title = (if mutation then Loc.name("mutation." .. mutation .. ".name", BaerchiConfig.getMutationDisplayName(mutation)):upper() .. "  " else "")
		.. Names.baerchi(baerchi.configId)
	local base = 34 + MODEL_VIEW_HEIGHT
	local titleLabel = cardLabel("Title", title, base + 2, 34, color)
	Theme.outlineText(titleLabel)

	cardLabel("Rarity", string.upper(Loc.t("rarity." .. baerchi.rarity)), base + 40, 24, rarityColor)

	local eggName = Loc.name("egg." .. tostring(result.eggType) .. ".name", tostring(result.eggType))
	local sub = cardLabel("Sub", Loc.t("ui.hatch.sub", {
		level = baerchi.level,
		mutation = if mutation then string.format("  •  %s x%.2g", Loc.name("mutation." .. mutation .. ".name", BaerchiConfig.getMutationDisplayName(mutation)), BaerchiConfig.getMutationMultiplier(mutation)) else "",
		egg = eggName,
	}), base + 66, 40, Theme.COLORS.textDim)
	sub.Font       = Theme.FONT_BODY
	sub.TextScaled = false
	sub.TextSize   = 15

	local tapHint = cardLabel("Tap", Loc.t("ui.hatch.tap_close"), CARD_SIZE.Y - 22, 16, Theme.COLORS.textDim)
	tapHint.TextScaled = false
	tapHint.TextSize   = 13

	tween(card, 0.28, { Size = UDim2.fromOffset(CARD_SIZE.X, CARD_SIZE.Y) }, Enum.EasingStyle.Back)
	return card
end

--------------------------------------------------------------------------------
-- Ablauf einer Oeffnung
--------------------------------------------------------------------------------

local function play(job: Job)
	local screenGui = _screenGui
	if not screenGui then return end

	_skip = false
	local scene = buildScene(screenGui, job.eggType)
	local opened = os.clock()

	scene.root.Activated:Connect(function()
		if os.clock() - opened >= SKIP_AFTER then
			_skip = true
		end
	end)

	-- 1. Drop
	tween(scene.backdrop, 0.25, { BackgroundTransparency = BACKDROP_TRANSPARENCY })
	tween(scene.egg, DROP_SECONDS, { Position = UDim2.fromScale(0.5, 0.48) }, Enum.EasingStyle.Bounce)
	task.wait(DROP_SECONDS)

	-- 2. Wackeln — in Schleife, bis das Ergebnis da ist (oder der Timeout greift).
	-- Danach noch die drei Stufen bis zum Burst. Die Stufen-Dauer haengt an der
	-- Rarity, die erst mit dem Ergebnis bekannt ist — vorher wackelt das Ei
	-- mit der leichtesten Stufe.
	local wobbleClock = 0
	local amplitude = 6
	local connection = RunService.RenderStepped:Connect(function(delta)
		wobbleClock += delta
		scene.egg.Rotation = math.sin(wobbleClock * 18) * amplitude
	end)

	while not job.result and not job.failed do
		if os.clock() - job.started > RESULT_TIMEOUT then
			job.failed = Loc.t("err.hatch_timeout")
			break
		end
		RunService.RenderStepped:Wait()
	end

	local result = job.result
	if not result then
		connection:Disconnect()
		if not job.silent then
			Notify.emit("hatch_failed", function()
				Toast.show(job.failed or Loc.t("err.hatch_failed"), Theme.COLORS.bad)
			end)
		end
		tween(scene.backdrop, FADE_SECONDS, { BackgroundTransparency = 1 })
		tween(scene.egg, FADE_SECONDS, { BackgroundTransparency = 1, Position = UDim2.fromScale(0.5, 1.3) })
		task.wait(FADE_SECONDS)
		scene.root:Destroy()
		return
	end

	local rarityColor = Theme.rarityColor(result.baerchi.rarity)
	local intensity   = intensityFor(result.baerchi.rarity)

	-- Wackel-Stufen mit Rissen
	local crackIndex = 0
	local stages = 3
	for stage = 1, stages do
		amplitude = intensity.amplitude * (stage / stages)
		local cracksNow = math.floor(intensity.cracks * stage / stages) - crackIndex
		for _ = 1, cracksNow do
			crackIndex += 1
			addCrack(scene, crackIndex)
		end
		waitSkippable(WOBBLE_STAGE_SECONDS * intensity.wobbleMul)
		if _skip then break end
	end

	-- 3. Aufladen: Zittern, Gluehen in der Rarity-Farbe
	if not _skip then
		scene.glow.BackgroundColor3 = rarityColor
		tween(scene.glow, CHARGE_SECONDS, { BackgroundTransparency = 0.35, Size = UDim2.fromOffset(EGG_SIZE.X * 2.1, EGG_SIZE.Y * 1.9) })
		tween(scene.eggStroke, CHARGE_SECONDS, { Color = rarityColor, Thickness = 8 })
		amplitude = intensity.amplitude * 1.4
		wobbleClock *= 2.5
		waitSkippable(CHARGE_SECONDS)
	end
	connection:Disconnect()

	-- 4. Burst
	flash(scene, intensity.flash)
	burstRing(scene, rarityColor)
	burstParticles(scene, rarityColor, intensity.particles)
	if intensity.shake then
		shakeScreen(scene, 0.45, 10)
	end
	if intensity.beam then
		beam(scene, rarityColor)
	end

	scene.egg.Visible  = false
	scene.label.Visible = false
	tween(scene.glow, 0.5, { BackgroundTransparency = 1 })

	-- 5. Reveal
	local card = buildReveal(scene, result)

	-- Nach dem Burst darf ein Tap die Karte sofort schliessen.
	_skip = false
	local revealStart = os.clock()
	-- Sammel-Update 2.2: steht mindestens REVEAL_SECONDS (plus Zuschlag fuer
	-- seltene), ein Tipp schliesst ab REVEAL_MIN_TAP, sonst nach REVEAL_AUTO_CLOSE.
	-- Warten in der Schlange weitere Eier, geht es nach der Mindestzeit weiter.
	local minimum = REVEAL_SECONDS + (if intensity.beam then 0.8 elseif intensity.shake then 0.4 else 0)
	while true do
		local shown = os.clock() - revealStart
		if _skip and shown > REVEAL_MIN_TAP then break end
		if shown >= REVEAL_AUTO_CLOSE then break end
		if shown >= minimum and #_queue > 1 then break end
		RunService.RenderStepped:Wait()
	end

	tween(scene.backdrop, FADE_SECONDS, { BackgroundTransparency = 1 })
	tween(card, FADE_SECONDS, { Size = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.wait(FADE_SECONDS)
	scene.root:Destroy()
end

local function pump()
	if _running then return end
	_running = true

	task.spawn(function()
		while #_queue > 0 do
			local job = _queue[1]
			local ok, err = pcall(play, job)
			if not ok then
				warn("[HatchAnimation] Abspielen fehlgeschlagen:", err)
				local gui = _screenGui
				local leftover = if gui then gui:FindFirstChild("HatchAnimation") else nil
				if leftover then leftover:Destroy() end
			end
			table.remove(_queue, 1)
		end
		_running = false
	end)
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Beim Klick auf "Oeffnen": startet (oder reiht ein) eine Animation fuer
-- dieses Ei. Das Ergebnis liefert spaeter deliver().
function HatchAnimation.request(eggType: Types.EggType)
	table.insert(_queue, {
		eggType = eggType,
		result  = nil,
		failed  = nil,
		silent  = false,
		started = os.clock(),
	})
	pump()
end

-- Die aelteste noch offene Oeffnung, oder nil.
local function oldestPending(): Job?
	for _, job in _queue do
		if not job.result and not job.failed then
			return job
		end
	end
	return nil
end

-- Server-Ergebnis eingetroffen. Ohne offene Oeffnung (z.B. ein Debug-Befehl
-- aus der Command Bar) wird eine neue Animation direkt mit Ergebnis gestartet.
function HatchAnimation.deliver(result: Types.HatchResult)
	local job = oldestPending()
	if job then
		job.result = result
		return
	end

	table.insert(_queue, {
		eggType = result.eggType,
		result  = result,
		failed  = nil,
		silent  = false,
		started = os.clock(),
	})
	pump()
end

-- Der Server hat das Oeffnen abgelehnt (ActionFailed fuer RequestHatchEgg).
-- Die Fehlermeldung zeigt der Toast ohnehin — hier wird nur die Animation
-- ohne eigene zweite Meldung beendet.
function HatchAnimation.reject(reason: string)
	local job = oldestPending()
	if job then
		job.failed = reason
		job.silent = true
	end
end

function HatchAnimation.init(screenGui: ScreenGui)
	_screenGui = screenGui

	-- Beim Verlassen nichts haengen lassen
	Players.LocalPlayer.AncestryChanged:Connect(function()
		table.clear(_queue)
	end)

	print("[HatchAnimation] Initialisiert")
end

return HatchAnimation
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">HatchPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- HatchPanel.luau
-- StarterPlayerScripts/UI/HatchPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die Eier im Lager auflisten und per "Oeffnen" sofort oeffnen lassen
--
-- Seit v12 (Ei-Baum-Konzept, Block A) gibt es keine Brut-Slots, keine
-- Brutzeit und keine Preise mehr: das Menue ist nur noch eine Liste der Eier
-- im Lager. Ein Klick auf "Oeffnen" startet sofort die Ei-Animation
-- (HatchAnimation) und schickt die Anfrage an den Server, der allein
-- entscheidet, was herauskommt.
--
-- Eier kommen aus Legen, Events und Rebirth-Meilensteinen. Kaufen kann man
-- nur das Basis-Ei, und das nur beim versteckten Haendler in der Welt —
-- bewusst ohne Hinweis hier.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types     = require(ReplicatedStorage.Network.Types)
local Remotes   = require(ReplicatedStorage.Network.Remotes)
local EggConfig = require(ReplicatedStorage.Config.EggConfig)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local Names     = require(ReplicatedStorage.Localization.Names)
local EggTree   = require(ReplicatedStorage.Modules.EggTree)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)
local IncubatorRules = require(ReplicatedStorage.Modules.IncubatorRules)   -- Sammel-Update 8

local Theme          = require(script.Parent.Theme)
local PanelManager   = require(script.Parent.PanelManager)
local EggIcon        = require(script.Parent.EggIcon)
local HatchAnimation = require(script.Parent.HatchAnimation)
local ClientState    = require(script.Parent.Parent.Controllers.ClientState)

local HatchPanel = {}

local PANEL_NAME = "Hatch"
local EGG_HEIGHT = 84

local _root: Frame?              = nil
local _scroller: ScrollingFrame? = nil
local _signature = ""

--------------------------------------------------------------------------------
-- Reihenfolge der Eier
--------------------------------------------------------------------------------

-- Nach EggConfig.sortOrder: stabil (die Iteration ueber EggConfig.data waere
-- es nicht) und unabhaengig von der frueheren Brutdauer.
local function buildEggOrder(): { Types.EggType }
	local list: { Types.EggType } = {}
	for eggType in EggConfig.data do
		table.insert(list, eggType)
	end

	table.sort(list, function(a, b)
		local orderA = EggConfig.data[a].sortOrder or 999
		local orderB = EggConfig.data[b].sortOrder or 999
		if orderA ~= orderB then
			return orderA < orderB
		end
		return a < b
	end)

	return list
end

local EGG_ORDER = buildEggOrder()

--------------------------------------------------------------------------------
-- Zeilen bauen
--------------------------------------------------------------------------------

local function buildEggCard(parent: Instance, order: number, eggType: Types.EggType, stock: number)
	local def = EggConfig.data[eggType]

	local card = Theme.panel("Egg_" .. eggType, parent, Theme.COLORS.panel)
	card.Size        = UDim2.new(1, -8, 0, EGG_HEIGHT)
	card.LayoutOrder = order

	-- Das Ei links in Farbe und Muster seines Pfads (EggIcon), damit man die
	-- Sorte ohne Lesen erkennt — genau so liegt es auch auf dem Plot.
	local icon = EggIcon.make(card, eggType, 62, 3)
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.Position    = UDim2.new(0, 10, 0.5, 0)

	local name = Theme.label("Name", card, Names.egg(eggType))
	name.Position = UDim2.new(0, 68, 0, 8)
	name.Size     = UDim2.new(1, -200, 0, 22)

	-- v14: ein noch gesperrtes Ei im Lager ist ein Sprung-Ei aus einem Event.
	local data = ClientState.get()
	local locked = data ~= nil and not EggTree.isUnlocked(data.eggTree, eggType)
	local desc = Theme.bodyText("Desc", card, if locked then Loc.t("ui.tree.jump_hint") else Names.eggDesc(eggType))
	desc.Position = UDim2.new(0, 68, 0, 32)
	desc.Size     = UDim2.new(1, -200, 0, 40)

	local count = Theme.label("Count", card, "x" .. stock)
	count.Position       = UDim2.new(1, -128, 0, 8)
	count.Size           = UDim2.new(0, 116, 0, 22)
	count.TextXAlignment = Enum.TextXAlignment.Right
	count.TextColor3     = Theme.COLORS.good

	-- Sammel-Update 05.10. (Paket 8): Eier ab Gold-Stufe gehen in den
	-- Inkubator statt sofort auf (gleiche Regel wie der Server).
	local toIncubator = FeatureFlags.isOn("INCUBATOR") and not FeatureFlags.isOn("INCUBATOR_BREED") and data ~= nil
		and IncubatorRules.requiresIncubator(eggType, IncubatorRules.isUnlocked(data))
	local button = Theme.bigButton("Open", card,
		if toIncubator then Loc.t("ui.hatch.to_incubator") else Loc.t("ui.hatch.open"),
		if toIncubator then Theme.COLORS.growth else Theme.COLORS.accent)
	button.Position = UDim2.new(1, -128, 0, 38)
	button.Size     = UDim2.new(0, 116, 0, 32)

	button.Activated:Connect(function()
		if toIncubator then
			Remotes.RequestIncubatorStart:FireServer(eggType)
			PanelManager.open("Incubator")
			return
		end
		-- Animation zuerst: der Klick soll sich sofort anfuehlen. Was
		-- herauskommt, kommt trotzdem ausschliesslich vom Server.
		HatchAnimation.request(eggType)
		Remotes.RequestHatchEgg:FireServer(eggType)
	end)
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

function HatchPanel.refresh()
	local scroller = _scroller
	local root     = _root
	if not scroller or not root then return end
	if not root.Visible then return end

	local data = ClientState.get()
	if not data then return end

	-- Sammel-Update 1.3-Muster: nur neu bauen, wenn sich das Lager (oder die
	-- Sprache) aendert — sonst zerstoert jeder Datenstand den Knopf unter dem
	-- Finger, und der Tipp kommt nicht an.
	local parts = { Loc.getLanguage(), tostring(IncubatorRules.isUnlocked(data)) }
	for _, eggType in EGG_ORDER do
		local n = data.island.eggStock[eggType] or 0
		if n > 0 then table.insert(parts, eggType .. n) end
	end
	local signature = table.concat(parts, "|")
	if signature == _signature then return end
	_signature = signature

	for _, child in scroller:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	local shown = 0
	for order, eggType in EGG_ORDER do
		local stock = data.island.eggStock[eggType] or 0
		if stock > 0 then
			buildEggCard(scroller, order, eggType, stock)
			shown += 1
		end
	end

	if shown == 0 then
		local empty = Theme.bodyText("Empty", scroller, Loc.t("ui.hatch.empty"))
		empty.Size        = UDim2.new(1, -8, 0, 60)
		empty.LayoutOrder = 1
	end
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local root = _root
	if not root then return end

	root.Visible = true
	_signature = ""
	HatchPanel.refresh()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function HatchPanel.init(screenGui: ScreenGui)
	HatchAnimation.init(screenGui)

	local root = Theme.dialog(
		"HatchPanel", screenGui,
		Vector2.new(0.52, 0.68),
		Vector2.new(320, 320),
		Vector2.new(560, 600)
	)
	_root = root

	local header = Theme.dialogHeader(root, Loc.t("ui.menu.eggs"), function()
		PanelManager.close(PANEL_NAME)
	end)

	-- v14: Knopf zum Ei-Baum (Presse, Freischaltung, Drop-Vorschau)
	local treeButton = Theme.button("TreeButton", header.Parent :: Instance, Loc.t("ui.menu.tree"), Theme.COLORS.growth)
	treeButton.AnchorPoint = Vector2.new(1, 0.5)
	treeButton.Position = UDim2.new(1, -40, 0.5, 0)
	treeButton.Size = UDim2.new(0, 92, 0, 26)
	treeButton.Activated:Connect(function()
		PanelManager.open("EggTree")
	end)
	Loc.onChanged(function()
		treeButton.Text = Loc.t("ui.menu.tree")
	end)

	local body     = Theme.dialogBody(root)
	local scroller = Theme.scroller("List", body)
	scroller.Size = UDim2.fromScale(1, 1)
	_scroller = scroller

	local layout = Theme.listLayout(scroller, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	-- Neue Serverdaten: Lagerbestand neu zeichnen. Nur wenn sichtbar.
	ClientState.onChanged(function()
		HatchPanel.refresh()
	end)

	Remotes.HatchResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		HatchAnimation.deliver(result :: Types.HatchResult)
	end)

	-- Abgelehnt (z.B. Lager inzwischen leer): die Animation ohne Ergebnis
	-- beenden. Die Meldung selbst zeigt der Toast (ActionFailed).
	Remotes.ActionFailed.OnClientEvent:Connect(function(action: any, reason: any)
		if action == "RequestHatchEgg" then
			HatchAnimation.reject(tostring(reason))
		end
	end)

	print("[HatchPanel] Initialisiert")
end

return HatchPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">HomeButton</string><ProtectedString name="Source"><![CDATA[--!strict
-- HomeButton.luau
-- StarterPlayerScripts/UI/HomeButton.luau
--
-- Einzige Zustaendigkeit:
--   - Den Heim-Knopf zeigen, wenn der Spieler weit weg von seinem Plot ist,
--     und RequestGoHome senden
--
-- Kontext: HBB Paket 5 (MAP_V2_HOME). Der Knopf erscheint erst ab
-- SHOW_DISTANCE Studs Abstand zum eigenen Spawn-Pad (Player.RespawnLocation,
-- von PlotBuilder gesetzt). Ob der Teleport erlaubt ist (getragene Waben),
-- entscheidet der Server.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes      = require(ReplicatedStorage.Network.Remotes)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local Loc          = require(ReplicatedStorage.Localization.Loc)

local Theme = require(script.Parent.Theme)
local TouchSafeArea = require(script.Parent.TouchSafeArea)

local HomeButton = {}

local SHOW_DISTANCE = 60
local CHECK_SECONDS = 0.5
-- Breiter als hoch: das Wort ("Maison") braucht Platz
local SIZE = Vector2.new(104, 56)

function HomeButton.init(screenGui: ScreenGui)
	-- Playtest 05.10.: Wort statt Haus-Emoji (das Emoji war winzig und unklar)
	local button = Theme.bigButton("HomeButton", screenGui, Loc.t("ui.home.button"), Theme.COLORS.good)
	Loc.bind(button, "ui.home.button")
	button.AnchorPoint = Vector2.new(0, 1)
	button.Size        = UDim2.fromOffset(SIZE.X, SIZE.Y)

	-- Am PC unten links. Auf Touch-Geraeten liegt dort der Bewegungs-Stick
	-- (Playtest 07.10.) — dann im freien Streifen (TouchSafeArea) ueber der
	-- Pet-Leiste. Die Leiste wird erst nach diesem Knopf gebaut (Main),
	-- deshalb wird sie hier gesucht statt vorausgesetzt.
	local function barHeight(): number
		local bar = screenGui:FindFirstChild("PetBar")
		if not (bar and bar:IsA("GuiObject")) then return 68 end
		local barScale = bar:FindFirstChildOfClass("UIScale")
		return bar.Size.Y.Offset * (if barScale then barScale.Scale else 1)
	end
	local function place()
		local zone = TouchSafeArea.zone(screenGui)
		if zone then
			button.Position = UDim2.new(0, zone.left, 1, -(14 + barHeight() + 10))
		else
			button.Position = UDim2.new(0, 16, 1, -16)
		end
	end
	TouchSafeArea.watch(screenGui, place)
	local function hookBar(child: Instance)
		if child.Name ~= "PetBar" then return end
		local barScale = child:FindFirstChildOfClass("UIScale")
		if barScale then barScale:GetPropertyChangedSignal("Scale"):Connect(place) end
		place()
	end
	screenGui.ChildAdded:Connect(function(child)
		-- Der UIScale der Leiste kommt direkt nach ihr; einen Frame warten
		task.defer(hookBar, child)
	end)
	local existing = screenGui:FindFirstChild("PetBar")
	if existing then hookBar(existing) end
	button.Visible     = false
	button.ZIndex      = 5
	button.Activated:Connect(function()
		Remotes.RequestGoHome:FireServer()
	end)

	task.spawn(function()
		local player = Players.LocalPlayer
		while true do
			task.wait(CHECK_SECONDS)
			local show = false
			if FeatureFlags.isOn("MAP_V2_HOME") then
				local spawn = player.RespawnLocation
				local character = player.Character
				local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
				if spawn and root and root:IsA("BasePart") then
					show = (root.Position - spawn.Position).Magnitude > SHOW_DISTANCE
				end
			end
			button.Visible = show
		end
	end)
end

return HomeButton
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">IncubatorPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- IncubatorPanel.luau
-- StarterPlayerScripts/UI/IncubatorPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Das Fenster des Inkubators (Sammel-Update 05.10., Paket 8): Plaetze mit
--     Ei und Restzeit (Abholen / Beschleunigen), Eier aus dem Lager zum
--     Einlegen, Ausbau mit Vorher/Nachher.
--
-- Rechnet mit Modules/IncubatorRules (dieselben Regeln wie der Server) und
-- workspace:GetServerTimeNow() als "jetzt" — die Zeitmarken der Plaetze sind
-- os.time() des Servers. Entscheiden tut der Server (IncubatorService).
--
-- Neu gebaut wird nur, wenn sich der Inhalt aendert (Signatur); die Restzeiten
-- laufen in einer eigenen Schleife. So geht ein Tipp nicht verloren, weil die
-- Zeile gerade neu gebaut wurde (siehe Sammel-Update 1.3).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local Loc             = require(ReplicatedStorage.Localization.Loc)
local Names = require(game:GetService("ReplicatedStorage").Localization.Names)
local EggConfig       = require(ReplicatedStorage.Config.EggConfig)
local IncubatorConfig = require(ReplicatedStorage.Config.IncubatorConfig)
local IncubatorRules  = require(ReplicatedStorage.Modules.IncubatorRules)

local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local EggCalculator   = require(ReplicatedStorage.Modules.EggCalculator)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local EggIcon      = require(script.Parent.EggIcon)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local IncubatorPanel = {}

local PANEL_NAME = "Incubator"
IncubatorPanel.PANEL_NAME = PANEL_NAME

local ROW_H = 64

local _root: Frame? = nil
local _scroller: ScrollingFrame? = nil
local _signature = ""
-- Zeilen der Plaetze: Restzeit-Label und Knoepfe, damit die Uhr ohne Neubau laeuft
type SlotRow = { slot: number, timeLabel: TextLabel, collect: TextButton, speed: TextButton }
local _slotRows: { SlotRow } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function eggName(eggType: string): string
	local def = EggConfig.data[eggType :: Types.EggType]
	return Names.egg(eggType)
end

local function breedOn(): boolean
	return FeatureFlags.isOn("INCUBATOR_BREED")
end

-- INCUBATOR_BREED: Inhalt haengt an Plaetzen, Baerchis und Ausbau
local function breedSignature(data: any): string
	local incubator = data.island.incubator
	local parts = { "breed", tostring(incubator.level), tostring(IncubatorRules.slotCountFor(data)),
		tostring(data.gummies), tostring(data.goldGummies), Loc.getLanguage(), tostring(data.island.equippedUid) }
	for _, entry in incubator.breeders or {} do
		table.insert(parts, string.format("%d=%s", entry.slot, entry.uid))
	end
	local uids = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(uids, uid .. ":" .. baerchi.rarity .. ":" .. tostring(baerchi.mutation))
	end
	table.sort(uids)
	table.insert(parts, table.concat(uids, ","))
	return table.concat(parts, "|")
end

local function signatureOf(data: any): string
	local incubator = data.island.incubator
	if not incubator then return "none" end
	if breedOn() then return breedSignature(data) end
	local parts = { tostring(incubator.level), tostring(IncubatorRules.slotCountFor(data)),
		tostring(data.gummies), tostring(data.goldGummies), Loc.getLanguage() }
	for _, entry in incubator.slots do
		table.insert(parts, string.format("%d=%s@%d", entry.slot, entry.eggType, entry.finishAt))
	end
	local stock = {}
	for eggType, count in data.island.eggStock do
		if count > 0 then table.insert(stock, eggType .. "x" .. count) end
	end
	table.sort(stock)
	table.insert(parts, table.concat(stock, ","))
	return table.concat(parts, "|")
end

--------------------------------------------------------------------------------
-- Restzeiten (laeuft jede halbe Sekunde, baut nichts neu)
--------------------------------------------------------------------------------

-- INCUBATOR_BREED: Zeit bis zum naechsten Ei je Platz
type BreedRow = { slot: number, timeLabel: TextLabel }
local _breedRows: { BreedRow } = {}

local function tickBreedRows(data: any)
	local incubator = data.island.incubator
	local t = now()
	for _, row in _breedRows do
		local entry = IncubatorRules.findBreeder(incubator.breeders, row.slot)
		local baerchi = if entry then data.island.baerchis[entry.uid] else nil
		if not entry or not baerchi then continue end
		local seconds = IncubatorRules.breedSeconds(baerchi.rarity, incubator.level)
		local left = math.max(0, entry.lastEggAt + seconds - t)
		row.timeLabel.Text = Loc.t("ui.incubator.next_egg", { time = Loc.formatDuration(math.ceil(left)) })
	end
end

local function tickRows()
	local data = ClientState.get()
	if not data or not data.island.incubator then return end
	if breedOn() then
		tickBreedRows(data)
		return
	end
	local t = now()
	for _, row in _slotRows do
		local entry = IncubatorRules.findSlot(data.island.incubator.slots, row.slot)
		if not entry then continue end
		local ready = IncubatorRules.isReady(entry, t)
		row.timeLabel.Text = if ready
			then Loc.t("ui.incubator.ready")
			else Loc.t("ui.incubator.left", { time = Loc.formatDuration(IncubatorRules.remaining(entry, t)) })
		row.timeLabel.TextColor3 = if ready then Theme.COLORS.good else Theme.COLORS.textDim
		row.collect.Visible = ready
		row.speed.Visible = not ready
		row.speed.Text = Loc.t("ui.incubator.speedup", { gold = IncubatorRules.speedUpCost(entry, t) })
	end
end

--------------------------------------------------------------------------------
-- Aufbau des Inhalts
--------------------------------------------------------------------------------

local function sectionRow(parent: Instance, order: number, text: string)
	local holder = Theme.container("Section", parent)
	holder.Size = UDim2.new(1, -8, 0, 20)
	holder.LayoutOrder = order
	Theme.sectionLabel("Label", holder, text).Size = UDim2.fromScale(1, 1)
end

local function baerchiName(baerchi: any): string
	local def = BaerchiConfig.getById(baerchi.configId)
	return Names.baerchi(baerchi.configId)
end

-- Kurze Chancen-Zeile: "Basis-Ei 60% · Zucker-Ei 30% · ..."
local function oddsLine(baerchi: any, eggTree: any, maxEntries: number): string
	local parts: { string } = {}
	for i, entry in EggCalculator.getResolvedChances(baerchi, eggTree) do
		if i > maxEntries then break end
		local percent = if entry.percent >= 10 then string.format("%d", math.floor(entry.percent + 0.5))
			else Loc.formatDecimal(entry.percent, 1)
		table.insert(parts, string.format("%s %s%%", eggName(entry.eggType), percent))
	end
	return table.concat(parts, " · ")
end

local function upgradeSection(scroller: ScrollingFrame, data: any, count: number, nextOrder: () -> number)
	local incubator = data.island.incubator
	sectionRow(scroller, nextOrder(), Loc.t("ui.incubator.upgrade_title", { level = incubator.level }))
	local cost = IncubatorRules.upgradeCost(incubator.level + 1)
	local upRow = Theme.panel("Upgrade", scroller, Theme.COLORS.panel)
	upRow.Size = UDim2.new(1, -8, 0, 70)
	upRow.LayoutOrder = nextOrder()
	local effect = Theme.bodyText("Effect", upRow, "")
	effect.Position = UDim2.new(0, 10, 0, 4)
	effect.Size = UDim2.new(1, -160, 1, -8)
	if cost then
		local nextCount = IncubatorRules.slotCount(incubator.level + 1, data.rebirthCount or 0, data.indexClaimed)
		effect.Text = Loc.t("ui.incubator.upgrade_effect", {
			speedNow  = Loc.formatDecimal(IncubatorRules.speed(incubator.level), 2),
			speedNext = Loc.formatDecimal(IncubatorRules.speed(incubator.level + 1), 2),
			slotsNow  = count,
			slotsNext = nextCount,
		})
		local up = Theme.bigButton("Up", upRow, Loc.t("ui.incubator.upgrade_cost", {
			gummies = cost.gummies, gold = cost.goldGummies }), Theme.COLORS.gummy)
		up.AnchorPoint = Vector2.new(1, 0.5)
		up.Position = UDim2.new(1, -8, 0.5, 0)
		up.Size = UDim2.fromOffset(140, 48)
		Theme.setEnabled(up, data.gummies >= cost.gummies and data.goldGummies >= cost.goldGummies)
		up.Activated:Connect(function()
			Remotes.RequestUpgradeIncubator:FireServer()
		end)
	else
		effect.Text = Loc.t("ui.incubator.max_level")
	end
end

-- INCUBATOR_BREED: Plaetze mit Baerchi (Chancen, naechstes Ei, Herausnehmen),
-- darunter die Baerchis zum Einsetzen und der Ausbau.
local function rebuildBreed(scroller: ScrollingFrame, data: any)
	table.clear(_breedRows)
	local incubator = data.island.incubator
	local breeders = incubator.breeders or {}
	local count = IncubatorRules.slotCountFor(data)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	local hint = Theme.bodyText("Hint", scroller, Loc.t("ui.incubator.breed_hint"))
	hint.Size = UDim2.new(1, -8, 0, 40)
	hint.LayoutOrder = nextOrder()

	sectionRow(scroller, nextOrder(), Loc.t("ui.incubator.slots", { used = #breeders, total = count }))
	local highest = count
	for _, entry in breeders do highest = math.max(highest, entry.slot) end
	for index = 1, highest do
		local entry = IncubatorRules.findBreeder(breeders, index)
		local baerchi = if entry then data.island.baerchis[entry.uid] else nil
		local row = Theme.panel("Slot_" .. index, scroller, Theme.COLORS.panel)
		row.Size = UDim2.new(1, -8, 0, if baerchi then 86 else ROW_H)
		row.LayoutOrder = nextOrder()

		if entry and baerchi then
			local name = Theme.label("Name", row, string.format("%s · %s · Lv.%d",
				baerchiName(baerchi), Loc.name("rarity." .. baerchi.rarity, baerchi.rarity), baerchi.level))
			name.Position = UDim2.new(0, 10, 0, 4)
			name.Size = UDim2.new(1, -150, 0, 22)
			name.TextColor3 = BaerchiConfig.getRarityColor(baerchi.rarity)

			local odds = Theme.bodyText("Odds", row, oddsLine(baerchi, data.eggTree, 4))
			odds.Position = UDim2.new(0, 10, 0, 28)
			odds.Size = UDim2.new(1, -150, 0, 34)
			odds.TextWrapped = true

			local timeLabel = Theme.label("Time", row, "")
			timeLabel.Position = UDim2.new(0, 10, 0, 62)
			timeLabel.Size = UDim2.new(1, -150, 0, 20)
			timeLabel.Font = Theme.FONT_BODY
			timeLabel.TextColor3 = Theme.COLORS.textDim
			if index > count then
				timeLabel.Text = "🔒 " .. Loc.t("ui.incubator.slot_locked")
			else
				table.insert(_breedRows, { slot = index, timeLabel = timeLabel })
			end

			local take = Theme.button("Take", row, Loc.t("ui.incubator.take"), Theme.COLORS.panelLight)
			take.AnchorPoint = Vector2.new(1, 0.5)
			take.Position = UDim2.new(1, -8, 0.5, 0)
			take.Size = UDim2.fromOffset(128, 40)
			take.Activated:Connect(function()
				Remotes.RequestIncubatorBaerchi:FireServer("take", index)
			end)
		else
			local free = Theme.bodyText("Free", row, Loc.t("ui.incubator.free_breed"))
			free.Position = UDim2.new(0, 12, 0, 0)
			free.Size = UDim2.new(1, -24, 1, 0)
			free.TextYAlignment = Enum.TextYAlignment.Center
		end
	end

	-- Baerchis zum Einsetzen --------------------------------------------------
	sectionRow(scroller, nextOrder(), Loc.t("ui.incubator.pick"))
	local freeSlot = IncubatorRules.firstFreeBreeder(breeders, count) ~= nil
	local list: { any } = {}
	for uid, baerchi in data.island.baerchis do
		if IncubatorRules.canBreed(data.island, uid) then table.insert(list, baerchi) end
	end
	local rank: { [string]: number } = {}
	for i, rarity in BaerchiConfig.RARITY_ORDER do rank[rarity] = i end
	table.sort(list, function(a, b)
		local ra, rb = rank[a.rarity] or 0, rank[b.rarity] or 0
		if ra ~= rb then return ra > rb end
		if a.level ~= b.level then return a.level > b.level end
		return a.uid < b.uid
	end)
	if #list == 0 then
		local empty = Theme.bodyText("Empty", scroller, Loc.t("ui.incubator.no_baerchis"))
		empty.Size = UDim2.new(1, -8, 0, 40)
		empty.LayoutOrder = nextOrder()
	end
	for _, baerchi in list do
		local row = Theme.panel("Pick_" .. baerchi.uid, scroller, Theme.COLORS.panel)
		row.Size = UDim2.new(1, -8, 0, 70)
		row.LayoutOrder = nextOrder()

		local name = Theme.label("Name", row, string.format("%s · %s · Lv.%d",
			baerchiName(baerchi), Loc.name("rarity." .. baerchi.rarity, baerchi.rarity), baerchi.level))
		name.Position = UDim2.new(0, 10, 0, 4)
		name.Size = UDim2.new(1, -150, 0, 22)
		name.TextColor3 = BaerchiConfig.getRarityColor(baerchi.rarity)

		local info = Theme.bodyText("Info", row, Loc.t("ui.incubator.breed_rate", {
			time = Loc.formatDuration(IncubatorRules.breedSeconds(baerchi.rarity, incubator.level)) })
			.. "\n" .. oddsLine(baerchi, data.eggTree, 3))
		info.Position = UDim2.new(0, 10, 0, 26)
		info.Size = UDim2.new(1, -150, 0, 40)
		info.TextWrapped = true

		local put = Theme.button("Put", row, Loc.t("ui.incubator.put_baerchi"), Theme.COLORS.accent)
		put.AnchorPoint = Vector2.new(1, 0.5)
		put.Position = UDim2.new(1, -8, 0.5, 0)
		put.Size = UDim2.fromOffset(128, 40)
		Theme.setEnabled(put, freeSlot)
		local uid = baerchi.uid
		put.Activated:Connect(function()
			Remotes.RequestIncubatorBaerchi:FireServer("put", uid)
		end)
	end

	upgradeSection(scroller, data, count, nextOrder)
	tickBreedRows(data)
end

local function rebuild()
	local scroller = _scroller
	if not scroller then return end
	local data = ClientState.get()
	if not data or not data.island.incubator then return end

	for _, child in scroller:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	table.clear(_slotRows)

	if breedOn() then
		rebuildBreed(scroller, data)
		return
	end

	local incubator = data.island.incubator
	local count = IncubatorRules.slotCountFor(data)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	-- Plaetze ---------------------------------------------------------------
	sectionRow(scroller, nextOrder(), Loc.t("ui.incubator.slots", { used = #incubator.slots, total = count }))
	local readyCount = 0
	for index = 1, math.max(count, #incubator.slots) do
		local entry = IncubatorRules.findSlot(incubator.slots, index)
		local row = Theme.panel("Slot_" .. index, scroller, Theme.COLORS.panel)
		row.Size = UDim2.new(1, -8, 0, ROW_H)
		row.LayoutOrder = nextOrder()

		if entry then
			local icon = EggIcon.make(row, entry.eggType, 48, 2)
			icon.AnchorPoint = Vector2.new(0, 0.5)
			icon.Position = UDim2.new(0, 8, 0.5, 0)

			local name = Theme.label("Name", row, eggName(entry.eggType))
			name.Position = UDim2.new(0, 64, 0, 6)
			name.Size = UDim2.new(1, -200, 0, 24)

			local timeLabel = Theme.label("Time", row, "")
			timeLabel.Position = UDim2.new(0, 64, 0, 32)
			timeLabel.Size = UDim2.new(1, -200, 0, 22)
			timeLabel.Font = Theme.FONT_BODY

			local collect = Theme.bigButton("Collect", row, Loc.t("ui.incubator.collect"), Theme.COLORS.good)
			collect.AnchorPoint = Vector2.new(1, 0.5)
			collect.Position = UDim2.new(1, -8, 0.5, 0)
			collect.Size = UDim2.fromOffset(128, 40)
			collect.Activated:Connect(function()
				Remotes.RequestIncubatorCollect:FireServer(index)
			end)

			local speed = Theme.button("Speed", row, "", Theme.COLORS.goldGummy)
			speed.AnchorPoint = Vector2.new(1, 0.5)
			speed.Position = UDim2.new(1, -8, 0.5, 0)
			speed.Size = UDim2.fromOffset(128, 40)
			speed.TextColor3 = Theme.COLORS.outline
			speed.Activated:Connect(function()
				Remotes.RequestIncubatorSpeedUp:FireServer(index)
			end)

			table.insert(_slotRows, { slot = index, timeLabel = timeLabel, collect = collect, speed = speed })
			if IncubatorRules.isReady(entry, now()) then readyCount += 1 end
		else
			local free = Theme.bodyText("Free", row, Loc.t("ui.incubator.free"))
			free.Position = UDim2.new(0, 12, 0, 0)
			free.Size = UDim2.new(1, -24, 1, 0)
			free.TextYAlignment = Enum.TextYAlignment.Center
		end
	end

	if readyCount > 1 then
		local allRow = Theme.container("CollectAll", scroller)
		allRow.Size = UDim2.new(1, -8, 0, 40)
		allRow.LayoutOrder = nextOrder()
		local all = Theme.bigButton("All", allRow, Loc.t("ui.incubator.collect_all", { n = readyCount }), Theme.COLORS.good)
		all.Size = UDim2.fromScale(1, 1)
		all.Activated:Connect(function()
			Remotes.RequestIncubatorCollect:FireServer("all")
		end)
	end

	-- Eier aus dem Lager --------------------------------------------------------
	sectionRow(scroller, nextOrder(), Loc.t("ui.incubator.stock"))
	local freeSlot = IncubatorRules.firstFree(incubator.slots, count) ~= nil
	local ids: { Types.EggType } = {}
	for eggType, n in data.island.eggStock do
		if n > 0 and EggConfig.data[eggType] then table.insert(ids, eggType) end
	end
	table.sort(ids, function(a, b) return EggConfig.data[a].sortOrder < EggConfig.data[b].sortOrder end)
	if #ids == 0 then
		local empty = Theme.bodyText("Empty", scroller, Loc.t("ui.incubator.no_eggs"))
		empty.Size = UDim2.new(1, -8, 0, 40)
		empty.LayoutOrder = nextOrder()
	end
	for _, eggType in ids do
		local row = Theme.panel("Egg_" .. eggType, scroller, Theme.COLORS.panel)
		row.Size = UDim2.new(1, -8, 0, 52)
		row.LayoutOrder = nextOrder()

		local icon = EggIcon.make(row, eggType, 40, 2)
		icon.AnchorPoint = Vector2.new(0, 0.5)
		icon.Position = UDim2.new(0, 8, 0.5, 0)

		local name = Theme.label("Name", row, string.format("%s  x%d", eggName(eggType), data.island.eggStock[eggType] or 0))
		name.Position = UDim2.new(0, 56, 0, 4)
		name.Size = UDim2.new(1, -200, 0, 22)

		local brew = Theme.bodyText("Brew", row, Loc.t("ui.incubator.brew_time", {
			time = Loc.formatDuration(IncubatorRules.brewSeconds(eggType, incubator.level)) }))
		brew.Position = UDim2.new(0, 56, 0, 26)
		brew.Size = UDim2.new(1, -200, 0, 20)

		local put = Theme.button("Put", row, Loc.t("ui.incubator.put"), Theme.COLORS.accent)
		put.AnchorPoint = Vector2.new(1, 0.5)
		put.Position = UDim2.new(1, -8, 0.5, 0)
		put.Size = UDim2.fromOffset(128, 36)
		Theme.setEnabled(put, freeSlot)
		put.Activated:Connect(function()
			Remotes.RequestIncubatorStart:FireServer(eggType)
		end)
	end

	-- Ausbau -------------------------------------------------------------------
	sectionRow(scroller, nextOrder(), Loc.t("ui.incubator.upgrade_title", { level = incubator.level }))
	local cost = IncubatorRules.upgradeCost(incubator.level + 1)
	local upRow = Theme.panel("Upgrade", scroller, Theme.COLORS.panel)
	upRow.Size = UDim2.new(1, -8, 0, 70)
	upRow.LayoutOrder = nextOrder()
	local effect = Theme.bodyText("Effect", upRow, "")
	effect.Position = UDim2.new(0, 10, 0, 4)
	effect.Size = UDim2.new(1, -160, 1, -8)
	if cost then
		local nextCount = IncubatorRules.slotCount(incubator.level + 1, data.rebirthCount or 0, (data :: any).indexClaimed)
		effect.Text = Loc.t("ui.incubator.upgrade_effect", {
			speedNow  = Loc.formatDecimal(IncubatorRules.speed(incubator.level), 2),
			speedNext = Loc.formatDecimal(IncubatorRules.speed(incubator.level + 1), 2),
			slotsNow  = count,
			slotsNext = nextCount,
		})
		local up = Theme.bigButton("Up", upRow, Loc.t("ui.incubator.upgrade_cost", {
			gummies = cost.gummies, gold = cost.goldGummies }), Theme.COLORS.gummy)
		up.AnchorPoint = Vector2.new(1, 0.5)
		up.Position = UDim2.new(1, -8, 0.5, 0)
		up.Size = UDim2.fromOffset(140, 48)
		Theme.setEnabled(up, data.gummies >= cost.gummies and data.goldGummies >= cost.goldGummies)
		up.Activated:Connect(function()
			Remotes.RequestUpgradeIncubator:FireServer()
		end)
	else
		effect.Text = Loc.t("ui.incubator.max_level")
	end

	tickRows()
end

local function refresh()
	local root = _root
	if not root or not root.Visible then return end
	local data = ClientState.get()
	if not data then return end
	local signature = signatureOf(data)
	if signature == _signature then return end
	_signature = signature
	rebuild()
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function IncubatorPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog("IncubatorPanel", screenGui, Vector2.new(0.5, 0.7), Vector2.new(320, 340), Vector2.new(560, 640))
	_root = root
	local header = Theme.dialogHeader(root, Loc.t("ui.incubator.title"), function()
		PanelManager.close(PANEL_NAME)
	end)
	Loc.onChanged(function()
		header.Text = Loc.t("ui.incubator.title")
		_signature = ""
		refresh()
	end)

	local body = Theme.dialogBody(root)
	local scroller = Theme.scroller("List", body)
	scroller.Size = UDim2.fromScale(1, 1)
	_scroller = scroller
	Theme.listLayout(scroller, 6).HorizontalAlignment = Enum.HorizontalAlignment.Left

	PanelManager.register(PANEL_NAME, {
		open = function()
			root.Visible = true
			_signature = ""
			refresh()
		end,
		close = function()
			root.Visible = false
		end,
	})

	ClientState.onChanged(refresh)

	task.spawn(function()
		while true do
			task.wait(0.5)
			if root.Visible then
				-- Ein fertig gewordener Platz aendert die Knoepfe: einmal neu
				-- bauen, wenn sich die Zahl der fertigen aendert.
				local data = ClientState.get()
				if data and data.island.incubator then
					local ready = 0
					for _, entry in data.island.incubator.slots do
						if IncubatorRules.isReady(entry, now()) then ready += 1 end
					end
					if root:GetAttribute("Ready") ~= ready then
						root:SetAttribute("Ready", ready)
						_signature = ""
						refresh()
					end
				end
				tickRows()
			end
		end
	end)

	print("[IncubatorPanel] Initialisiert | Plaetze max", IncubatorConfig.MAX_SLOTS)
end

return IncubatorPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">IndexView</string><ProtectedString name="Source"><![CDATA[--!strict
-- IndexView.luau
-- StarterPlayerScripts/UI/IndexView.luau
--
-- Einzige Zustaendigkeit:
--   - Den Index zeichnen: pro Ei eine Reihe Baerchis mit Wahrscheinlichkeit,
--     entdeckte in Farbe, unentdeckte als schwarze Silhouette
--   - Das kleine Fenster mit den Eiern, aus denen ein Baerchi faellt
--     (PC: Maus drueberhalten, Handy: antippen)
--
-- Zweck ist Orientierung: wer eine schwarze Silhouette sieht, tippt sie an und
-- weiss sofort, WELCHES Ei er oeffnen muss. Der Index liest nur — er schaltet
-- nichts frei. Entdeckt ist ein Baerchi, sobald der Server ihn in
-- data.discovered vermerkt hat (QuestService).
--
-- Die Daten (welche Eier, welche Chancen) kommen komplett aus
-- IndexCalculator/EggConfig; dieses Modul kennt keine einzige Baerchi-id.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types           = require(ReplicatedStorage.Network.Types)
local Loc             = require(ReplicatedStorage.Localization.Loc)
local Names           = require(ReplicatedStorage.Localization.Names)
local EggConfig       = require(ReplicatedStorage.Config.EggConfig)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local IndexCalculator = require(ReplicatedStorage.Modules.IndexCalculator)
local BaerchiMesh     = require(ReplicatedStorage.Modules.BaerchiMesh)
local Remotes           = require(ReplicatedStorage.Network.Remotes)
local FeatureFlags      = require(ReplicatedStorage.Config.FeatureFlags)
local IndexRewardConfig = require(ReplicatedStorage.Config.IndexRewardConfig)   -- Sammel-Update 7

local Theme       = require(script.Parent.Theme)
local UiScale     = require(script.Parent.UiScale)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local IndexView = {}

local TILE_W   = 78
local TILE_H   = 104
local VIEW     = 62
local POP_W    = 210

local _page: Frame?        = nil
local _scroller: ScrollingFrame? = nil
local _summary: TextLabel? = nil
local _popup: Frame?       = nil
local _popupHost: Frame?   = nil

-- Antippen haelt das Fenster fest (Handy); Hover zeigt es nur solange die Maus
-- drauf ist.
local _pinnedId: string? = nil
local _shownId: string?  = nil
local _signature = ""

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function percent(chance: number): string
	local p = chance * 100
	if math.abs(p - math.round(p)) < 0.05 then
		return Loc.formatNumber(math.round(p)) .. "%"
	end
	return Loc.formatDecimal(p, 1) .. "%"
end

local function isDiscovered(configId: string): boolean
	local data = ClientState.get()
	return data ~= nil and data.discovered ~= nil and data.discovered[configId] == true
end

-- Macht aus einem gebauten Baerchi eine schwarze Silhouette.
local function blacken(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Color    = Color3.new(0.04, 0.04, 0.06)
			d.Material = Enum.Material.SmoothPlastic
			if d:IsA("MeshPart") then
				d.TextureID = ""
			end
		elseif d:IsA("Decal") or d:IsA("Texture") or d:IsA("SurfaceAppearance") then
			d:Destroy()
		end
	end
end

-- Zeigt einen Baerchi in einem ViewportFrame. Gibt false zurueck, wenn kein
-- Modell gebaut werden konnte (fehlendes Template) — der Aufrufer zeigt dann
-- ein Fragezeichen.
local function fillViewport(vp: ViewportFrame, configId: string, discovered: boolean): boolean
	local def = BaerchiConfig.getById(configId)
	if not def then return false end

	local ok, model = pcall(function()
		return BaerchiMesh.build(Vector3.zero, Theme.rarityColor(def.rarity), def.rarity, nil)
	end)
	if not ok or not model then return false end

	if not discovered then
		blacken(model)
	end
	model.Parent = vp

	local cf, size = model:GetBoundingBox()
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	local radius = math.max(size.X, size.Y, size.Z)
	local distance = radius / (2 * math.tan(math.rad(camera.FieldOfView / 2))) * 1.15
	-- Leicht von vorne-oben, damit man Gesicht und Koerper sieht.
	local dir = Vector3.new(0.35, 0.25, 1).Unit
	camera.CFrame = CFrame.lookAt(cf.Position + dir * distance, cf.Position)
	camera.Parent = vp
	vp.CurrentCamera = camera
	return true
end

--------------------------------------------------------------------------------
-- Das Fenster "faellt aus diesen Eiern"
--------------------------------------------------------------------------------

local function hidePopup()
	local popup = _popup
	if popup then popup.Visible = false end
	_shownId = nil
end

local function showPopup(configId: string, anchor: GuiObject)
	local popup, host = _popup, _popupHost
	if not popup or not host then return end

	local def = BaerchiConfig.getById(configId)
	if not def then return end

	for _, child in popup:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	local found = isDiscovered(configId)
	local color = Theme.rarityColor(def.rarity)

	local title = Theme.label("Title", popup,
		if found then Names.baerchi(configId) else Loc.t("ui.index.unknown"))
	title.Position = UDim2.new(0, 10, 0, 6)
	title.Size     = UDim2.new(1, -20, 0, 22)

	local rarity = Theme.label("Rarity", popup, Loc.name("rarity." .. def.rarity, def.rarity))
	rarity.Position   = UDim2.new(0, 10, 0, 28)
	rarity.Size       = UDim2.new(1, -20, 0, 16)
	rarity.TextColor3 = color

	local header = Theme.bodyText("DropsFrom", popup, Loc.t("ui.index.drops_from"))
	header.Position = UDim2.new(0, 10, 0, 50)
	header.Size     = UDim2.new(1, -20, 0, 16)

	local data   = ClientState.get()
	local sources = IndexCalculator.sourcesOf(configId)
	local y = 68

	for _, source in sources do
		local eggDef = EggConfig.data[source.eggId :: Types.EggType]
		local row = Theme.container("Src_" .. source.eggId, popup)
		row.Position = UDim2.new(0, 10, 0, y)
		row.Size     = UDim2.new(1, -20, 0, 22)

		local dot = Theme.panel("Dot", row, if eggDef then eggDef.color else Theme.COLORS.accent)
		dot.Position = UDim2.new(0, 0, 0.5, -7)
		dot.Size     = UDim2.new(0, 14, 0, 14)
		Theme.corner(dot, 7)

		local name = Theme.label("Name", row, Loc.name("egg." .. source.eggId .. ".name", source.eggId))
		name.Position = UDim2.new(0, 22, 0, 0)
		name.Size     = UDim2.new(1, -90, 1, 0)
		name.TextSize = 14

		local chance = Theme.label("Chance", row, percent(source.chance))
		chance.AnchorPoint    = Vector2.new(1, 0)
		chance.Position       = UDim2.new(1, 0, 0, 0)
		chance.Size           = UDim2.new(0, 64, 1, 0)
		chance.TextXAlignment = Enum.TextXAlignment.Right
		chance.TextColor3     = Theme.COLORS.goldGummy

		y += 22

		-- Hat der Spieler dieses Ei gerade im Lager? Dann ist das der
		-- naechste Schritt, und genau den soll das Fenster zeigen.
		local stock = if data then (data.island.eggStock :: any)[source.eggId] or 0 else 0
		if stock > 0 then
			local have = Theme.bodyText("Have", popup, Loc.t("ui.index.you_have", { n = stock }))
			have.Position   = UDim2.new(0, 32, 0, y - 4)
			have.Size       = UDim2.new(1, -42, 0, 14)
			have.TextSize   = 12
			have.TextColor3 = Theme.COLORS.good
			y += 14
		end
	end

	if #sources == 0 then
		local none = Theme.bodyText("None", popup, Loc.t("ui.index.no_source"))
		none.Position = UDim2.new(0, 10, 0, y)
		none.Size     = UDim2.new(1, -20, 0, 30)
		y += 30
	end

	popup.Size = UDim2.new(0, POP_W, 0, y + 10)

	-- Neben die Kachel setzen und im Dialog halten.
	-- Bildschirm-Pixel -> Oberflaechen-Einheiten (globale UiScale), dann in die
	-- Einheiten INNERHALB des Dialogs (Theme.dialogScale: auf kleinen
	-- Bildschirmen ist der ganze Dialog verkleinert).
	local inner    = math.max(Theme.dialogScale(host), 0.01)
	local hostPos  = UiScale.toGui(host.AbsolutePosition) / inner
	local hostSize = UiScale.toGui(host.AbsoluteSize) / inner
	local aPos, aSize = UiScale.toGui(anchor.AbsolutePosition) / inner, UiScale.toGui(anchor.AbsoluteSize) / inner

	local x = aPos.X - hostPos.X + aSize.X + 6
	if x + POP_W > hostSize.X then
		x = aPos.X - hostPos.X - POP_W - 6
	end
	x = math.clamp(x, 4, math.max(4, hostSize.X - POP_W - 4))
	local py = math.clamp(aPos.Y - hostPos.Y, 4, math.max(4, hostSize.Y - (y + 10) - 4))

	popup.Position = UDim2.new(0, x, 0, py)
	popup.Visible  = true
	_shownId = configId
end

--------------------------------------------------------------------------------
-- Eine Kachel
--------------------------------------------------------------------------------

local function buildTile(parent: Instance, order: number, drop: IndexCalculator.Drop)
	local def = BaerchiConfig.getById(drop.configId)
	if not def then return end

	local found = isDiscovered(drop.configId)
	local color = Theme.rarityColor(def.rarity)

	local tile = Theme.panel("Tile_" .. drop.configId, parent, Theme.COLORS.panel)
	tile.LayoutOrder = order

	local stroke = tile:FindFirstChildOfClass("UIStroke")
	if stroke and found then stroke.Color = color end

	local vp = Instance.new("ViewportFrame")
	vp.Name                   = "Preview"
	vp.BackgroundColor3       = if found then Theme.shade(color, -0.55) else Color3.fromRGB(70, 66, 92)
	vp.BackgroundTransparency = 0
	vp.BorderSizePixel        = 0
	vp.Ambient                = Color3.fromRGB(180, 180, 190)
	vp.LightColor             = Color3.fromRGB(255, 255, 255)
	vp.AnchorPoint            = Vector2.new(0.5, 0)
	vp.Position               = UDim2.new(0.5, 0, 0, 5)
	vp.Size                   = UDim2.new(0, VIEW, 0, VIEW)
	vp.Parent                 = tile
	Theme.corner(vp, 10)

	if not fillViewport(vp, drop.configId, found) then
		local q = Theme.label("Q", vp, if found then "B" else "?")
		q.Size           = UDim2.fromScale(1, 1)
		q.TextXAlignment = Enum.TextXAlignment.Center
		q.TextColor3     = if found then color else Theme.COLORS.textDim
	end

	local name = Theme.label("Name", tile,
		if found then Names.baerchi(drop.configId) else Loc.t("ui.index.unknown"))
	name.Position       = UDim2.new(0, 3, 0, VIEW + 7)
	name.Size           = UDim2.new(1, -6, 0, 14)
	name.TextXAlignment = Enum.TextXAlignment.Center
	name.TextColor3     = if found then Theme.COLORS.text else Theme.COLORS.textDim

	local chance = Theme.label("Chance", tile, percent(drop.chance))
	chance.Position       = UDim2.new(0, 3, 0, VIEW + 22)
	chance.Size           = UDim2.new(1, -6, 0, 14)
	chance.TextXAlignment = Enum.TextXAlignment.Center
	chance.TextColor3     = Theme.COLORS.goldGummy

	local hit = Instance.new("TextButton")
	hit.Name                   = "Hit"
	hit.BackgroundTransparency = 1
	hit.Text                   = ""
	hit.Size                   = UDim2.fromScale(1, 1)
	hit.ZIndex                 = 5
	hit.Parent                 = tile

	-- Maus: Hover zeigt, Verlassen versteckt (ausser angetippt).
	hit.MouseEnter:Connect(function()
		if _pinnedId == nil then
			showPopup(drop.configId, tile)
		end
	end)
	hit.MouseLeave:Connect(function()
		if _pinnedId == nil and _shownId == drop.configId then
			hidePopup()
		end
	end)
	-- Handy (und Mausklick): antippen haelt fest, nochmal antippen schliesst.
	hit.Activated:Connect(function()
		if _pinnedId == drop.configId then
			_pinnedId = nil
			hidePopup()
		else
			_pinnedId = drop.configId
			showPopup(drop.configId, tile)
		end
	end)
end

--------------------------------------------------------------------------------
-- Aufbau / Aktualisieren
--------------------------------------------------------------------------------

local function currentSignature(): string
	local data = ClientState.get()
	local keys: { string } = {}
	if data and data.discovered then
		for id in data.discovered do table.insert(keys, id) end
	end
	table.sort(keys)
	-- Sammel-Update 7: abgeholte Belohnungen aendern die Knoepfe
	local claimed: { string } = {}
	local claimedMap = if data then (data :: any).indexClaimed else nil
	if claimedMap then
		for id in claimedMap do table.insert(claimed, id) end
	end
	table.sort(claimed)
	return table.concat(keys, ",") .. "|" .. table.concat(claimed, ",") .. "|" .. Loc.getLanguage()
end

--------------------------------------------------------------------------------
-- Sammel-Update 05.10. (Paket 7): Index-Belohnungen
--------------------------------------------------------------------------------

local function claimedMap(): { [string]: boolean }
	local data = ClientState.get()
	return (if data then (data :: any).indexClaimed else nil) or {}
end

local function discoveredMap(): { [string]: boolean }
	local data = ClientState.get()
	return (if data then data.discovered else nil) or {}
end

-- Wie viele Belohnungen gerade abholbar sind (fuer das "!" am Index).
function IndexView.claimableCount(): number
	if not FeatureFlags.isOn("INDEX_REWARDS") then return 0 end
	return #IndexRewardConfig.claimable(discoveredMap(), claimedMap())
end

-- Kurztext der Belohnung ("+2 Gold-Ei · +4.000 Gummies").
local function rewardText(entry: IndexRewardConfig.Entry): string
	local r = entry.reward
	local parts: { string } = {}
	if r.eggs > 0 and r.eggType then
		table.insert(parts, string.format("+%d %s", r.eggs, Loc.name("egg." .. r.eggType .. ".name", r.eggType)))
	end
	if r.gummies > 0 then table.insert(parts, "+" .. Loc.formatNumber(r.gummies) .. " G") end
	if r.goldGummies > 0 then table.insert(parts, "+" .. Loc.formatNumber(r.goldGummies) .. " Gold") end
	if r.blueprints > 0 then table.insert(parts, Loc.t("ui.index_reward.blueprint", { n = r.blueprints })) end
	if r.incubatorSlots > 0 then table.insert(parts, Loc.t("ui.index_reward.slot", { n = r.incubatorSlots })) end
	return table.concat(parts, "  ·  ")
end

-- Abholen-Knopf bzw. Haken rechts in einer Zeile. Gibt nil zurueck, wenn es
-- fuer diese Kollektion nichts zu zeigen gibt (Schalter aus).
local function claimWidget(parent: Instance, entry: IndexRewardConfig.Entry): GuiObject?
	if not FeatureFlags.isOn("INDEX_REWARDS") then return nil end
	if claimedMap()[entry.id] then
		local done = Theme.label("Claimed", parent, "✔")
		done.TextColor3 = Theme.COLORS.good
		done.TextXAlignment = Enum.TextXAlignment.Center
		return done
	end
	local complete = IndexRewardConfig.isComplete(entry, discoveredMap())
	local button = Theme.button("Claim", parent, Loc.t("ui.index_reward.claim"), Theme.COLORS.good)
	button.TextColor3 = Theme.COLORS.outline
	Theme.setEnabled(button, complete)
	button.Activated:Connect(function()
		if not complete then return end
		Remotes.RequestClaimIndexReward:FireServer(entry.id)
	end)
	return button
end

-- Eine Zeile "Sammlung": Name, Fortschritt (3/5), Belohnung, Knopf.
local function collectionRow(parent: Instance, order: number, entry: IndexRewardConfig.Entry, title: string)
	local row = Theme.panel("Reward_" .. entry.id, parent, Theme.COLORS.panel)
	row.Size = UDim2.new(1, -8, 0, 46)
	row.LayoutOrder = order
	local have, total = IndexRewardConfig.progress(entry, discoveredMap())
	local name = Theme.label("Name", row, string.format("%s  (%d/%d)", title, have, total))
	name.Position = UDim2.new(0, 10, 0, 3)
	name.Size = UDim2.new(1, -130, 0, 22)
	local reward = Theme.bodyText("Reward", row, rewardText(entry))
	reward.Position = UDim2.new(0, 10, 0, 24)
	reward.Size = UDim2.new(1, -130, 0, 18)
	reward.TextColor3 = Theme.COLORS.goldGummy
	local widget = claimWidget(row, entry)
	if widget then
		widget.AnchorPoint = Vector2.new(1, 0.5)
		widget.Position = UDim2.new(1, -8, 0.5, 0)
		widget.Size = UDim2.fromOffset(104, 32)
	end
end

local function buildCollections(scroller: Instance)
	if not FeatureFlags.isOn("INDEX_REWARDS") then return end
	local block = Theme.container("Collections", scroller)
	block.LayoutOrder = 0
	block.Size = UDim2.new(1, -8, 0, 0)
	block.AutomaticSize = Enum.AutomaticSize.Y
	Theme.listLayout(block, 4).HorizontalAlignment = Enum.HorizontalAlignment.Left

	local head = Theme.container("Head", block)
	head.LayoutOrder = 0
	head.Size = UDim2.new(1, 0, 0, 22)
	Theme.sectionLabel("Title", head, Loc.t("ui.index_reward.collections")).Size = UDim2.fromScale(1, 1)

	for _, entry in IndexRewardConfig.ENTRIES do
		if entry.kind == "path" then
			collectionRow(block, entry.order, entry, Loc.t("ui.index_reward.path", { path = Loc.name("path." .. entry.key, entry.key) }))
		elseif entry.kind == "rarity" then
			collectionRow(block, entry.order, entry, Loc.t("ui.index_reward.rarity", { rarity = Loc.name("rarity." .. entry.key, entry.key) }))
		elseif entry.kind == "all" then
			collectionRow(block, entry.order, entry, Loc.t("ui.index_reward.all"))
		end
	end
end

function IndexView.refresh(force: boolean?)
	local scroller, page = _scroller, _page
	if not scroller or not page or not page.Visible then return end

	local signature = currentSignature()
	if not force and signature == _signature then return end
	_signature = signature

	hidePopup()
	_pinnedId = nil

	for _, child in scroller:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	local tree  = IndexCalculator.buildTree()
	local total = #IndexCalculator.allPets()
	local found = 0
	for _, configId in IndexCalculator.allPets() do
		if isDiscovered(configId) then found += 1 end
	end

	local summary = _summary
	if summary then
		summary.Text = Loc.t("ui.index.progress", { found = found, total = total })
	end

	-- Sammel-Update 7: Pfad-, Rarity- und Gesamt-Belohnungen oben
	buildCollections(scroller)

	for order, node in tree do
		local eggDef = EggConfig.data[node.eggId :: Types.EggType]

		local section = Theme.container("Egg_" .. node.eggId, scroller)
		section.LayoutOrder   = order
		section.Size          = UDim2.new(1, -8, 0, 0)
		section.AutomaticSize = Enum.AutomaticSize.Y
		local sl = Theme.listLayout(section, 4)
		sl.HorizontalAlignment = Enum.HorizontalAlignment.Left

		local head = Theme.container("Head", section)
		head.LayoutOrder = 1
		head.Size        = UDim2.new(1, 0, 0, 24)

		local dot = Theme.panel("Dot", head, if eggDef then eggDef.color else Theme.COLORS.accent)
		dot.Position = UDim2.new(0, 2, 0.5, -9)
		dot.Size     = UDim2.new(0, 18, 0, 18)
		Theme.corner(dot, 9)

		local sectionFound = 0
		for _, drop in node.drops do
			if isDiscovered(drop.configId) then sectionFound += 1 end
		end

		local title = Theme.label("Title", head,
			Loc.name("egg." .. node.eggId .. ".name", node.eggId)
			.. "  (" .. sectionFound .. "/" .. #node.drops .. ")")
		title.Position = UDim2.new(0, 28, 0, 0)
		title.Size     = UDim2.new(1, -30, 1, 0)

		-- Sammel-Update 7: Belohnung dieser Ei-Reihe (Abholen / Haken)
		local eggEntry = IndexRewardConfig.get("egg:" .. node.eggId)
		if eggEntry then
			local widget = claimWidget(head, eggEntry)
			if widget then
				head.Size = UDim2.new(1, 0, 0, 30)
				title.Size = UDim2.new(1, -150, 1, 0)
				widget.AnchorPoint = Vector2.new(1, 0.5)
				widget.Position = UDim2.new(1, -4, 0.5, 0)
				widget.Size = UDim2.fromOffset(110, 26)
				local hint = Theme.bodyText("RewardHint", head, rewardText(eggEntry))
				hint.AnchorPoint = Vector2.new(1, 0.5)
				hint.Position = UDim2.new(1, -120, 0.5, 0)
				hint.Size = UDim2.fromOffset(170, 26)
				hint.TextXAlignment = Enum.TextXAlignment.Right
				hint.TextColor3 = Theme.COLORS.goldGummy
				title.Size = UDim2.new(1, -330, 1, 0)
			end
		end

		local grid = Theme.container("Grid", section)
		grid.LayoutOrder   = 2
		grid.Size          = UDim2.new(1, 0, 0, 0)
		grid.AutomaticSize = Enum.AutomaticSize.Y

		local layout = Instance.new("UIGridLayout")
		layout.CellSize            = UDim2.new(0, TILE_W, 0, TILE_H)
		layout.CellPadding         = UDim2.new(0, 6, 0, 6)
		layout.SortOrder           = Enum.SortOrder.LayoutOrder
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
		layout.Parent              = grid

		for i, drop in node.drops do
			buildTile(grid, i, drop)
		end
	end
end

-- Fuer BaerchiInventory: Seite zeigen/verstecken.
function IndexView.setVisible(visible: boolean)
	local page = _page
	if not page then return end
	page.Visible = visible
	if visible then
		IndexView.refresh(true)
	else
		hidePopup()
		_pinnedId = nil
	end
end

-- `host` ist der Dialog, in dem das Fenster liegen darf (damit es nicht vom
-- Scroller abgeschnitten wird); `parent` ist die Flaeche fuer die Seite.
function IndexView.build(parent: Instance, host: Frame): Frame
	local page = Theme.container("IndexPage", parent)
	page.Size    = UDim2.fromScale(1, 1)
	page.Visible = false
	_page = page

	local summary = Theme.label("Summary", page, "")
	summary.Size    = UDim2.new(1, 0, 0, 22)
	summary.TextSize = 16
	_summary = summary

	local scroller = Theme.scroller("IndexList", page)
	scroller.Position = UDim2.new(0, 0, 0, 28)
	scroller.Size     = UDim2.new(1, 0, 1, -28)
	_scroller = scroller

	local layout = Theme.listLayout(scroller, 10)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	-- Das Fenster haengt am Dialog, ganz oben.
	local popup = Theme.panel("DropPopup", host, Theme.COLORS.panelDeep)
	popup.Visible = false
	popup.ZIndex  = 50
	popup.Active  = false
	_popup     = popup
	_popupHost = host

	ClientState.onChanged(function()
		IndexView.refresh(false)
	end)
	Loc.onChanged(function()
		IndexView.refresh(true)
	end)

	return page
end

return IndexView
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">LeaderboardPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- LeaderboardPanel.luau
-- StarterPlayerScripts/UI/LeaderboardPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die Bestenlisten im Menue zeigen (v15): drei Reiter (Tower, Rebirths,
--     Sammlung), Top 50 und der eigene Rang.
--
-- Die Daten holt das Panel beim Oeffnen und beim Reiterwechsel ueber die
-- RemoteFunction GetLeaderboard (der Server antwortet aus seinem Cache, der
-- alle 120 s aufgefrischt wird). Ein Klick auf einen Namen eines Spielers auf
-- diesem Server oeffnet seine Profilkarte (Inspektor).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types             = require(ReplicatedStorage.Network.Types)
local Remotes           = require(ReplicatedStorage.Network.Remotes)
local Loc               = require(ReplicatedStorage.Localization.Loc)
local LeaderboardConfig = require(ReplicatedStorage.Config.LeaderboardConfig)
local TowerConfig       = require(ReplicatedStorage.Config.TowerConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)

local LeaderboardPanel = {}

local PANEL_NAME = "Leaderboard"
local ROW_HEIGHT = 26

local _root: Frame? = nil
local _scroller: ScrollingFrame? = nil
local _own: TextLabel? = nil
local _tabs: { [string]: TextButton } = {}
local _list = "Tower"
local _requestId = 0

local function formatValue(listId: string, value: number): string
	if listId == "Tower" then
		local towerId, stage = TowerConfig.fromLeaderboardValue(value)
		local def = TowerConfig.get(towerId) or TowerConfig.TOWERS[1]
		return Loc.t("ui.leaderboard.tower_value", { tower = Loc.t("ui.petbar.tower", { n = def.numeral }), stage = stage })
	end
	return Loc.formatNumber(value)
end

local function render(view: Types.LeaderboardView?)
	local scroller = _scroller
	if not scroller then return end
	for _, child in scroller:GetChildren() do
		if child:IsA("Frame") then child:Destroy() end
	end

	local own = _own
	if not view then
		if own then own.Text = Loc.t("ui.leaderboard.loading") end
		return
	end

	for _, entry in view.entries do
		local mine = entry.userId == Players.LocalPlayer.UserId
		local row = Theme.panel("Row" .. entry.rank, scroller, if mine then Theme.COLORS.panelLight else Theme.COLORS.panel)
		row.Size        = UDim2.new(1, -8, 0, ROW_HEIGHT)
		row.LayoutOrder = entry.rank

		local rank = Theme.label("Rank", row, "#" .. entry.rank)
		rank.Position = UDim2.new(0, 8, 0, 3)
		rank.Size     = UDim2.new(0, 44, 1, -6)
		rank.TextColor3 = if entry.rank <= 3 then Theme.COLORS.goldGummy else Theme.COLORS.textDim

		local name = Instance.new("TextButton")
		name.Name = "Name"
		name.BackgroundTransparency = 1
		name.Font = Theme.FONT
		name.TextScaled = true
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextColor3 = Theme.COLORS.text
		name.Text = entry.name
		name.Position = UDim2.new(0, 56, 0, 3)
		name.Size     = UDim2.new(0.55, -56, 1, -6)
		name.Parent   = row
		name.Activated:Connect(function()
			if Players:GetPlayerByUserId(entry.userId) and entry.userId ~= Players.LocalPlayer.UserId then
				PanelManager.open("Profile", entry.userId)
			end
		end)

		local value = Theme.label("Value", row, formatValue(view.listId, entry.value))
		value.AnchorPoint    = Vector2.new(1, 0)
		value.Position       = UDim2.new(1, -8, 0, 3)
		value.Size           = UDim2.new(0.42, 0, 1, -6)
		value.TextXAlignment = Enum.TextXAlignment.Right
	end

	if own then
		own.Text = if view.ownRank
			then Loc.t("ui.leaderboard.own_rank", { rank = view.ownRank, value = formatValue(view.listId, view.ownValue) })
			else Loc.t("ui.leaderboard.own_unranked", { value = formatValue(view.listId, view.ownValue) })
	end
end

local function load(listId: string)
	_list = listId
	for id, tab in _tabs do
		tab.BackgroundColor3 = if id == listId then Theme.COLORS.accent else Theme.COLORS.panelLight
	end
	render(nil)

	_requestId += 1
	local myRequest = _requestId
	task.spawn(function()
		local ok, view = pcall(function()
			return Remotes.GetLeaderboard:InvokeServer(listId)
		end)
		if myRequest ~= _requestId then return end   -- inzwischen anderer Reiter
		render(if ok and typeof(view) == "table" then view :: Types.LeaderboardView else nil)
	end)
end

function LeaderboardPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog("LeaderboardPanel", screenGui, Vector2.new(0.46, 0.72), Vector2.new(320, 420), Vector2.new(520, 640))
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.leaderboard.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	local tabs = Theme.container("Tabs", body)
	tabs.Size = UDim2.new(1, 0, 0, 30)
	local tabLayout = Theme.listLayout(tabs, 6, true)
	tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	for order, listId in LeaderboardConfig.LISTS do
		local tab = Theme.button("Tab_" .. listId, tabs, Loc.t("ui.leaderboard.list." .. listId), Theme.COLORS.panelLight)
		-- Paket 9: 5 Listen passen nur schmaler (gleich breit, 6 px Luecke)
		tab.Size = UDim2.new(1 / #LeaderboardConfig.LISTS, -6, 1, 0)
		tab.TextScaled = true
		tab.LayoutOrder = order
		tab.TextColor3 = Theme.COLORS.text
		tab.Activated:Connect(function() load(listId) end)
		_tabs[listId] = tab
	end

	local scroller = Theme.scroller("List", body)
	scroller.Position = UDim2.new(0, 0, 0, 38)
	scroller.Size     = UDim2.new(1, 0, 1, -72)
	local layout = Theme.listLayout(scroller, 4)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	_scroller = scroller

	local own = Theme.label("Own", body, "")
	own.AnchorPoint = Vector2.new(0, 1)
	own.Position    = UDim2.new(0, 4, 1, 0)
	own.Size        = UDim2.new(1, -8, 0, 26)
	own.TextColor3  = Theme.COLORS.goldGummy
	_own = own

	PanelManager.register(PANEL_NAME, {
		open = function()
			root.Visible = true
			load(_list)
		end,
		close = function()
			root.Visible = false
		end,
	})

	print("[LeaderboardPanel] Initialisiert")
end

return LeaderboardPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">MenuBar</string><ProtectedString name="Source"><![CDATA[--!strict
-- MenuBar.luau
-- StarterPlayerScripts/UI/MenuBar.luau
--
-- Einzige Zustaendigkeit:
--   - Die schmale Kachelleiste am rechten Bildschirmrand: Eier und Baerchis
--
-- ============================================================
-- WARUM NUR ZWEI KACHELN
-- ============================================================
-- Vorher standen hier sieben Kacheln (Eier, Baerchis, Kampf, drei Gebaeude,
-- Arena). Fuer einen neuen Spieler war das eine Wand aus Knoepfen ohne Antwort
-- auf "was mache ich jetzt?". Drei Dinge sind weggefallen:
--   - Gebaeude und Arena: Man oeffnet sie, indem man am Gebaeude selbst den
--     Prompt benutzt (WorldController). Eine zweite Tuer dorthin ist ueberfluessig.
--   - Kampf: Die PetBar unten ist der bessere Kampf-Knopf.
-- Uebrig bleiben die zwei Dinge, die man von ueberall aus braucht: Eier
-- (zum Schluepfen) und Baerchis (Sammlung, Fusion und der Index).
--
-- Welches Panel offen ist, weiss weiterhin ausschliesslich der PanelManager.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local IncubatorRules   = require(ReplicatedStorage.Modules.IncubatorRules)   -- Sammel-Update 8
local IndexRewardConfig = require(ReplicatedStorage.Config.IndexRewardConfig) -- Sammel-Update 7
local BuildingBehavior  = require(ReplicatedStorage.Config.BuildingBehavior)
local FeatureFlags     = require(ReplicatedStorage.Config.FeatureFlags)
local Workspace        = game:GetService("Workspace")

local Theme        = require(script.Parent.Theme)
local TouchSafeArea = require(script.Parent.TouchSafeArea)
local UiScale      = require(script.Parent.UiScale)
local PanelManager = require(script.Parent.PanelManager)
local Icons        = require(script.Parent.Icons)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Unlock       = require(script.Parent.Unlock)

-- HBB Paket 3: Kachel (Panel-Name) → Element-Id der Freischaltung
local TILE_ELEMENT: { [string]: string } = {
	Hatch = "tile_eggs", Inventory = "tile_bears", EggTree = "tile_tree",
	Leaderboard = "tile_leaderboard", DailyBonus = "tile_daily",
	Shop = "tile_shop",
	Incubator = "tile_incubator",   -- Sammel-Update Paket 8
}

local MenuBar = {}

-- Groessen. TILE ist gleichzeitig die Antippflaeche — darunter wird es auf dem
-- Handy zur Geduldsprobe.
-- HUD_ROW_V2: weniger Kacheln (Verbessern, Inkubator und Shop sind weg),
-- dafuer groesser. Die UIScale unten schrumpft weiterhin auf kleinen Fenstern.
local BIG    = FeatureFlags.isOn("HUD_ROW_V2")
local TILE   = if BIG then 70 else 54
local LABEL  = if BIG then 18 else 16
local GAP    = if BIG then 8 else 6
local WIDTH  = if BIG then 94 else 76

-- Was eine Kachel anzeigt: `value` ist die Beschriftung IN der Kachel,
-- `alert` laesst das rote Ausrufezeichen erscheinen.
type Live = (Types.PlayerDataUpdate) -> (string, boolean)

type Entry = {
	panel  : string,
	-- Beschriftung unter der Kachel. Eine Funktion statt eines Strings, weil
	-- sie bei jedem Sprachwechsel neu ausgewertet wird.
	title  : () -> string,
	color  : Color3,
	symbol : string,
	-- Name des Bild-Icons (siehe Icons); `symbol` ist der Text-Rueckfall
	icon   : string,
	live   : Live?,
}

type Tile = {
	entry : Entry,
	-- Die Beschriftung IN der Kachel ist das Text-Feld des Knopfes selbst: ein
	-- eigenes Label darueber wuerde die Klicks abfangen.
	tile  : TextButton,
	alert : Frame,
	label : TextLabel,
	-- true, wenn die Kachel ein Bild zeigt: dann bleibt ihr Text leer
	image : boolean,
}

local _tiles: { Tile } = {}
local buildAllEntries: () -> { Entry }

-- Sammel-Update 3.5: welches Gebaeude-Menue die Kachel oeffnet
local function buildingPanel(): string
	return PanelManager.buildingPanelName(if FeatureFlags.isOn("HONEY_POND_V2") then "HoneyPond" else "HoneyRefiner")
end
TILE_ELEMENT[buildingPanel()] = "tile_building"

--------------------------------------------------------------------------------
-- Die Eintraege
--------------------------------------------------------------------------------

local function buildEntries(): { Entry }
	local list = buildAllEntries()
	-- HUD_ROW_V2: Honig-Brunnen und Inkubator benutzt man vor Ort (Prompt am
	-- Plot), der Shop sitzt in der Knopf-Zeile oben links (Hud).
	local hidden: { [string]: boolean } = {}
	if not FeatureFlags.isOn("INCUBATOR") then hidden.Incubator = true end
	if BIG then
		hidden.Incubator = true
		hidden.Shop = true
		hidden[buildingPanel()] = true
	end
	for i = #list, 1, -1 do
		if hidden[list[i].panel] then table.remove(list, i) end
	end
	return list
end

function buildAllEntries(): { Entry }
	return {
		{ panel = "Hatch",     title = function() return Loc.t("ui.menu.eggs") end,     color = Theme.COLORS.gummy,  symbol = "EI", icon = "egg" },
		-- Sammel-Update 05.10. (Paket 7): "!" = eine Index-Belohnung ist abholbar.
		{ panel = "Inventory", title = function() return Loc.t("ui.menu.baerchis") end, color = Theme.COLORS.accent, symbol = "BA", icon = "bear",
			live = function(data: Types.PlayerDataUpdate)
				if not FeatureFlags.isOn("INDEX_REWARDS") then return "BA", false end
				return "BA", #IndexRewardConfig.claimable(data.discovered, data.indexClaimed) > 0
			end },
		-- Sammel-Update 05.10. (Paket 3.5/3.6): das Honig-Gebaeude als Kachel
		-- (Verbessern ohne hinzulaufen). "!" = Ausbau bezahlbar.
		{ panel = buildingPanel(), title = function() return Loc.t("ui.menu.building") end, color = Theme.COLORS.goldGummy, symbol = "⬆", icon = "upgrade",
			live = function(data: Types.PlayerDataUpdate)
				local id = if FeatureFlags.isOn("HONEY_POND_V2") then "HoneyPond" else "HoneyRefiner"
				local building = data.island.buildings[id :: any]
				if not building then return "⬆", false end
				local cost = BuildingBehavior.getUpgrade(id :: any, building.level + 1)
				return "⬆", cost ~= nil and data.gummies >= cost.costGummies and data.goldGummies >= (cost.costGoldGummies or 0)
			end },
		-- Sammel-Update 05.10. (Paket 8): Inkubator ("!" = ein Ei ist fertig).
		{ panel = "Incubator", title = function() return Loc.t("ui.incubator.tile") end, color = Theme.COLORS.growth, symbol = "⏳", icon = "incubator",
			live = function(data: Types.PlayerDataUpdate)
				local incubator = data.island.incubator
				if not incubator then return "⏳", false end
				local now = Workspace:GetServerTimeNow()
				local ready = false
				for _, entry in incubator.slots do
					if IncubatorRules.isReady(entry, now) then ready = true end
				end
				return "⏳", ready
			end },
		-- v14: Ei-Baum. Das "!" zeigt eine ungenutzte Blaupause an.
		{ panel = "EggTree", title = function() return Loc.t("ui.menu.tree") end, color = Theme.COLORS.growth, symbol = "BAUM", icon = "tree",
			live = function(data: Types.PlayerDataUpdate)
				local bp = if data.eggTree then data.eggTree.blueprints or 0 else 0
				return "BAUM", bp > 0
			end },
		-- v15: Bestenlisten und Login-Bonus ("!" = heute noch nicht abgeholt)
		{ panel = "Leaderboard", title = function() return Loc.t("ui.menu.leaderboard") end, color = Theme.COLORS.goldGummy, symbol = "TOP", icon = "trophy" },
		{ panel = "DailyBonus", title = function() return Loc.t("ui.menu.daily") end, color = Theme.COLORS.gummy, symbol = "7", icon = "gift",
			live = function(data: Types.PlayerDataUpdate)
				local daily = data.daily
				return if daily then tostring(daily.day) else "7", daily ~= nil and daily.claimable
			end },
		-- HBB Paket 10: Shop ("!" = Gratis-Griff heute noch offen). Sichtbar ab
		-- der 2. Sitzung und nur mit SHOP_V1 (UnlockRules "tile_shop").
		{ panel = "Shop", title = function() return Loc.t("ui.menu.shop") end, color = Theme.COLORS.goldGummy, symbol = "GG", icon = "goldgummy",
			live = function(data: Types.PlayerDataUpdate)
				local shop = data.shop
				return "GG", shop ~= nil and shop.freeReady
			end },
	}
end

--------------------------------------------------------------------------------
-- Eine Kachel
--------------------------------------------------------------------------------

local function buildTile(parent: Instance, order: number, entry: Entry): Tile
	local slot = Theme.container("Slot_" .. entry.panel, parent)
	slot.Size        = UDim2.new(1, 0, 0, TILE + LABEL + 2)
	slot.LayoutOrder = order

	local button = Theme.button("Tile", slot, entry.symbol, entry.color)
	button.AnchorPoint = Vector2.new(0.5, 0)
	button.Position    = UDim2.new(0.5, 0, 0, 0)
	button.Size        = UDim2.new(0, TILE, 0, TILE)
	button.TextColor3  = Theme.COLORS.outline
	Theme.gradient(button, Theme.shade(entry.color, 0.34), Theme.shade(entry.color, -0.16))

	-- Bild-Icon gross in die Kachel. Ohne Asset bleibt das Text-Kuerzel stehen.
	local hasImage = Icons.has(entry.icon)
	if hasImage then
		button.Text = ""
		local icon = Icons.make(button, entry.icon)
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position    = UDim2.fromScale(0.5, 0.52)
		icon.Size        = UDim2.fromScale(0.86, 0.86)
		icon.ZIndex      = 3
	end

	button.Activated:Connect(function()
		local element = TILE_ELEMENT[entry.panel]
		if element then Unlock.markSeen(element) end
		PanelManager.toggle(entry.panel)
	end)

	-- Rotes Ausrufezeichen oben rechts, wie man es aus dem Genre kennt.
	-- Startet unsichtbar und wird von refresh() geschaltet.
	local alert = Theme.panel("Alert", slot, Theme.COLORS.bad)
	alert.AnchorPoint = Vector2.new(1, 0)
	alert.Position    = UDim2.new(0.5, TILE * 0.5 + 5, 0, -4)
	alert.Size        = UDim2.new(0, 20, 0, 20)
	alert.Visible     = false
	alert.ZIndex      = 3
	Theme.corner(alert, 10)

	local bang = Theme.label("Bang", alert, "!")
	bang.Size           = UDim2.fromScale(1, 1)
	bang.TextXAlignment = Enum.TextXAlignment.Center
	bang.ZIndex         = 4

	local label = Theme.label("Name", slot, entry.title())
	label.Position       = UDim2.new(0, 0, 0, TILE + 1)
	label.Size           = UDim2.new(1, 0, 0, LABEL)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextScaled     = false
	label.TextSize       = if BIG then 16 else 14
	Theme.outlineText(label)

	return { entry = entry, tile = button, alert = alert, label = label, image = hasImage }
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

local function refresh(data: Types.PlayerDataUpdate)
	for _, tile in _tiles do
		-- HBB Paket 3: Kachel erst zeigen, wenn sie gebraucht wird; neue
		-- Kacheln tragen das "!" bis zum ersten Antippen.
		local element = TILE_ELEMENT[tile.entry.panel]
		local isNew = false
		if element then
			local slot = tile.tile.Parent
			if slot and slot:IsA("GuiObject") then
				Unlock.apply(element, slot)
			end
			isNew = Unlock.isNew(element)
			tile.alert.Visible = isNew
		end

		local live = tile.entry.live
		if live then
			local ok, value, alert = pcall(live, data)

			-- In pcall: eine kaputte Kachel darf nicht die ganze Leiste
			-- lahmlegen. Ein alter Spielstand ohne ein Gebaeude waere sonst
			-- genau so ein Fall.
			if ok then
				if not tile.image then
					tile.tile.Text = value
				end
				tile.alert.Visible = alert or isNew
			end
		end
	end
end

--------------------------------------------------------------------------------
-- HBB Paket 1: Ziel fliegender Icons (Eier fliegen zur Eier-Kachel)
--------------------------------------------------------------------------------

function MenuBar.getTileAnchor(panel: string): GuiObject?
	for _, tile in _tiles do
		if tile.entry.panel == panel then
			return tile.tile
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function MenuBar.init(screenGui: ScreenGui)
	local entries = buildEntries()
	local slot    = TILE + LABEL + 2
	local height  = #entries * slot + (#entries - 1) * GAP

	local root = Theme.container("MenuBar", screenGui)
	root.AnchorPoint = Vector2.new(1, 0)
	-- Rechte Kante, unter den Rang-/Rebirth-Pillen. Y bewusst als Pixel-Offset:
	-- die Pillen darueber sind ebenfalls pixelhoch, mit Scale wuerde die Leiste
	-- je nach Bildschirmhoehe hineinrutschen.
	root.Position = UDim2.new(0.988, 0, 0, 108)
	root.Size     = UDim2.new(0, WIDTH, 0, height)

	-- Raster statt Liste: eine Spalte wie bisher, auf Touch-Geraeten bei Bedarf
	-- zwei (siehe rescale). Unsichtbare Kacheln (Unlock) ueberspringt es.
	local grid = Instance.new("UIGridLayout")
	grid.CellSize              = UDim2.fromOffset(WIDTH, slot)
	grid.CellPadding           = UDim2.fromOffset(GAP, GAP)
	grid.FillDirection         = Enum.FillDirection.Horizontal
	grid.FillDirectionMaxCells = 1
	grid.HorizontalAlignment   = Enum.HorizontalAlignment.Right
	grid.SortOrder             = Enum.SortOrder.LayoutOrder
	grid.Parent                = root

	-- Auf niedrigen Fenstern (Handy quer, kleines Studio-Fenster) schrumpfen,
	-- damit die Leiste nicht ueber den unteren Rand ragt.
	--
	-- Playtest 07.10.: auf Touch-Geraeten endet die Leiste ueber dem
	-- Sprung-Knopf (unten rechts), sonst oeffnete ein Sprung ein Menue. Wuerden
	-- die Kacheln dafuer in einer Spalte zu klein zum Antippen (< 70 %), werden
	-- es zwei Spalten.
	local MIN_TOUCH_SCALE = 0.7
	local scale = Instance.new("UIScale")
	scale.Parent = root
	local function rescale()
		local bottom = TouchSafeArea.rightBottomReserve(screenGui, 12)
		local room = UiScale.toGui(screenGui.AbsoluteSize.Y) - 108 - bottom

		local columns = 1
		if TouchSafeArea.isTouch() and room / height < MIN_TOUCH_SCALE then
			columns = 2
		end
		local rows = math.ceil(#entries / columns)
		local gridHeight = rows * slot + (rows - 1) * GAP

		grid.FillDirectionMaxCells = columns
		root.Size   = UDim2.fromOffset(columns * WIDTH + (columns - 1) * GAP, gridHeight)
		scale.Scale = math.clamp(room / gridHeight, 0.4, 1)
	end
	TouchSafeArea.watch(screenGui, rescale)

	for order, entry in entries do
		table.insert(_tiles, buildTile(root, order, entry))
	end

	ClientState.onChanged(refresh)

	-- HBB Paket 3: ein Panel, das sich von selbst oeffnet (Login-Bonus u.a.), gilt
	-- ebenso als gesehen wie eines, das per Kachel geoeffnet wurde.
	PanelManager.onOpened(function(name)
		local element = TILE_ELEMENT[name]
		if element then Unlock.markSeen(element) end
	end)

	-- Sprachwechsel: nur die Beschriftungen neu setzen (die Zahlen in den
	-- Kacheln sind sprachunabhaengig)
	Loc.onChanged(function()
		for _, tile in _tiles do
			tile.label.Text = tile.entry.title()
		end
	end)

	print("[MenuBar] Initialisiert |", #entries, "Kacheln")
end

return MenuBar
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">PetBar</string><ProtectedString name="Source"><![CDATA[--!strict
-- PetBar.luau
-- StarterPlayerScripts/UI/PetBar.luau
--
-- Einzige Zustaendigkeit:
--   - Die untere Pet-Leiste: zwei grosse Knoepfe "Event" und "Fight", die den
--     ausgeruesteten Baerchi hinschicken bzw. zurueckholen.
--
-- Die Leiste ZEIGT nur an, was der Server meldet (PetModeChanged) — was ein
-- Klick bedeutet, entscheidet PetModeService. Der Client schickt nur, welcher
-- Knopf gedrueckt wurde, und beim Fight-Knopf ggf. die Wahl aus der
-- Fortsetzungs-Frage (PitResumeDialog).
--
-- Zustaende je Knopf:
--   normal        Normalfarbe, Klick schickt hin
--   unterwegs/da  leuchtet, Text "Zurueckholen"
--   wartet        der Baerchi geht erst heim und dann hierher; Klick bricht ab
--   gesperrt      grau, kleine Zeile mit dem Grund

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local FeatureFlags      = require(ReplicatedStorage.Config.FeatureFlags)

local Remotes          = require(ReplicatedStorage.Network.Remotes)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local Loc              = require(ReplicatedStorage.Localization.Loc)   -- Sammel-Update 2.4
local Names = require(game:GetService("ReplicatedStorage").Localization.Names)

local Theme           = require(script.Parent.Theme)
local UiScale         = require(script.Parent.UiScale)
local TouchSafeArea   = require(script.Parent.TouchSafeArea)
local Icons           = require(script.Parent.Icons)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local FightStartPrompt = require(script.Parent.FightStartPrompt)
local ClientState     = require(script.Parent.Parent.Controllers.ClientState)
local Unlock          = require(script.Parent.Unlock)

local PetBar = {}

local BUTTON_WIDTH  = 210
local BUTTON_HEIGHT = 68    -- Mindesthoehe 56 px fuer Touch
local GAP           = 14

local EVENT_COLOR = Color3.fromRGB(120, 190, 255)
local FIGHT_COLOR = Color3.fromRGB(255,  96,  96)
local GLOW_COLOR  = Color3.fromRGB(255, 236, 140)

type ButtonView = {
	button : TextButton,
	title  : TextLabel,
	sub    : TextLabel,
	stroke : UIStroke,
	color  : Color3,
	icon   : GuiObject,
}

local _event: ButtonView? = nil
local _fight: ButtonView? = nil

-- Letzte Server-Meldung (PetModeChanged)
local _state   = "Home"
-- Sammel-Update 05.10. (Paket 4.3): gewaehltes Wiedergabe-Tempo (0 = sofort)
local SPEED_STEPS = { 1, 2, 4, 0 }
local _bossAt: number? = nil   -- Sammel-Update 5.3
local _speedChoice = 1
local _speedButton: TextButton? = nil
local _pending: string? = nil
local _stage: number? = nil
local _tower: string? = nil   -- v15: Tower des laufenden Kampfs (vom Server)
local _from: string? = nil
local _abducting = false

-- Event-Zyklus (EventPhaseChanged)
local _eventId: string? = nil
local _nextEventId: string? = nil
local _phaseEndsAt = 0

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- HBB Paket 6: Icon je Event fuer den Timer am Knopf (Name aus UI/Icons,
-- sonst das Zeichen als Rueckfall). Die Wespenkoenigin bekommt ein eigenes.
local EVENT_ICON: { [string]: { name: string, fallback: string } } = {
	Ufo            = { name = "ufo",   fallback = "UFO" },
	HotEgg         = { name = "egg",   fallback = "🥚" },
	MutationsSturm = { name = "",      fallback = "🌪" },
	Koenigshuegel  = { name = "crown", fallback = "♛" },
	Schatzgraeber  = { name = "gift",  fallback = "💎" },
	WaspQueen      = { name = "",      fallback = "🐝" },
}

local function clock(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

local function eventLine(): string
	local remaining = _phaseEndsAt - os.clock()
	if _eventId then
		local def = EventConfig.getById(_eventId)
		return string.format("%s  %s", Names.event(_eventId), clock(remaining))
	end
	if _nextEventId then
		return Loc.t("ui.petbar.next_event", { t = clock(remaining) })
	end
	return ""
end

-- Sammel-Update 5.3: "🐝 Boss in 12 min" (bzw. "🐝 Boss LIVE").
local function bossLine(): string
	local at = _bossAt
	if not at then return "" end
	local left = at - os.clock()
	if left <= 0 then return Loc.t("ui.petbar.boss_live") end
	return Loc.t("ui.petbar.boss_in", { min = math.max(1, math.ceil(left / 60)) })
end

-- "Tower II" fuer eine Tower-Id.
local function towerLabel(towerId: string?): string
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	return Loc.t("ui.petbar.tower", { n = def.numeral })
end

-- HP-Anteil des ausgeruesteten Baerchis (nil = keiner da) und der gewaehlte
-- Tower (v15, ersetzt das PIT-Level).
local function fighterInfo(): (number?, string)
	local data = ClientState.get()
	if not data then return nil, "I" end

	local tower = if data.towers then data.towers.selected else "I"
	local uid = data.island.equippedUid
	local baerchi = if uid then data.island.baerchis[uid] else nil
	local def = if baerchi then BaerchiConfig.getById(baerchi.configId) else nil
	if not baerchi or not def then
		return nil, tower
	end

	local maxHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
	local hp = math.clamp(baerchi.currentHp or maxHp, 0, maxHp)
	return hp / math.max(1, maxHp), tower
end

local function paint(view: ButtonView, title: string, sub: string, mode: "normal" | "active" | "waiting" | "disabled")
	view.title.Text = title
	view.sub.Text   = sub

	if mode == "disabled" then
		view.button.Active           = false
		view.button.AutoButtonColor  = false
		view.button.BackgroundColor3 = Theme.COLORS.disabled
		view.stroke.Color            = Theme.COLORS.outline
		view.stroke.Thickness        = Theme.OUTLINE_THICKNESS
		view.title.TextTransparency  = 0.35
		Icons.tint(view.icon, Color3.fromRGB(140, 140, 150))
		return
	end

	Icons.tint(view.icon, Color3.new(1, 1, 1))

	view.button.Active          = true
	view.button.AutoButtonColor = false
	view.title.TextTransparency = 0

	if mode == "active" then
		view.button.BackgroundColor3 = Theme.shade(view.color, 0.15)
		view.stroke.Color            = GLOW_COLOR
		view.stroke.Thickness        = 5
	elseif mode == "waiting" then
		view.button.BackgroundColor3 = Theme.shade(view.color, -0.25)
		view.stroke.Color            = GLOW_COLOR
		view.stroke.Thickness        = 3
	else
		view.button.BackgroundColor3 = view.color
		view.stroke.Color            = Theme.COLORS.outline
		view.stroke.Thickness        = Theme.OUTLINE_THICKNESS
	end
end

--------------------------------------------------------------------------------
-- Anzeige
--------------------------------------------------------------------------------

local _eventIconKey: string? = nil

-- Tauscht das Icon des Event-Knopfs gegen das des kommenden/laufenden Events.
local function setEventIcon(view: ButtonView, eventId: string?)
	local key = eventId or "Ufo"
	if _eventIconKey == key then return end
	_eventIconKey = key
	local look = EVENT_ICON[key] or EVENT_ICON.Ufo
	local old = view.icon
	local icon = Icons.make(view.button, look.name, look.fallback)
	icon.AnchorPoint = old.AnchorPoint
	icon.Position    = old.Position
	icon.Size        = old.Size
	icon.ZIndex      = old.ZIndex
	old:Destroy()
	view.icon = icon
end

local function refresh()
	local event, fight = _event, _fight
	if not event or not fight then return end

	-- Paket 4.3: Tempo-Knopf nur im Tower
	local speedButton = _speedButton
	if speedButton then
		speedButton.Visible = _state == "InPit" or _state == "ToPit"
		speedButton.Text = if _speedChoice == 0 then "⏭ " .. Loc.t("ui.petbar.speed_skip") else "⏩ x" .. _speedChoice
	end

	-- HBB Paket 3: der Event-Knopf erscheint erst nach dem ersten Kampf
	Unlock.apply("button_event", event.button)

	local hpRatio, selectedTower = fighterInfo()
	local hasPet = hpRatio ~= nil

	-- --------------------------------------------------------------- Event
	local eventTitle = Loc.t("ui.petbar.event")
	local recall     = Loc.t("ui.petbar.recall")
	local waiting    = Loc.t("ui.petbar.waiting")
	if not hasPet then
		paint(event, eventTitle, Loc.t("ui.petbar.no_pet"), "disabled")
	elseif _abducting then
		paint(event, eventTitle, Loc.t("ui.petbar.abducted"), "disabled")
	elseif _state == "ToEvent" then
		paint(event, Loc.t("ui.petbar.recall"), Loc.t("ui.petbar.walking_there") .. " • " .. eventLine(), "active")
	elseif _state == "AtEvent" then
		paint(event, Loc.t("ui.petbar.recall"), eventLine(), "active")
	elseif _pending == "Event" then
		paint(event, Loc.t("ui.petbar.waiting"), Loc.t("ui.petbar.switch_hint"), "waiting")
	elseif _state == "Returning" and _from == "Event" then
		paint(event, eventTitle, Loc.t("ui.petbar.coming_home"), "normal")
	elseif FeatureFlags.isOn("EVENT_V2_TIMER") then
		-- HBB Paket 6: Icon des kommenden bzw. laufenden Events + Restzeit,
		-- keine Woerter.
		setEventIcon(event, _eventId or _nextEventId)
		paint(event, clock(_phaseEndsAt - os.clock()), bossLine(), "normal")
	else
		paint(event, eventTitle, eventLine(), "normal")
	end

	-- --------------------------------------------------------------- Fight
	local hpText = if hpRatio then string.format("HP %d%%  •  %s", math.floor(hpRatio * 100 + 0.5), towerLabel(selectedTower)) else ""

	local fightTitle = Loc.t("ui.petbar.fight")
	if not hasPet then
		paint(fight, fightTitle, Loc.t("ui.petbar.no_pet"), "disabled")
	elseif _state == "ToPit" then
		paint(fight, Loc.t("ui.petbar.recall"), Loc.t("ui.petbar.walking_pit"), "active")
	elseif _state == "InPit" then
		paint(fight, Loc.t("ui.petbar.recall"), if _stage then Loc.t("ui.petbar.in_pit_stage", { tower = towerLabel(_tower or selectedTower), stage = _stage }) else towerLabel(_tower or selectedTower), "active")
	elseif _pending == "Fight" then
		paint(fight, Loc.t("ui.petbar.waiting"), Loc.t("ui.petbar.switch_hint_pit"), "waiting")
	elseif _state == "Returning" and _from == "Fight" then
		paint(fight, fightTitle, Loc.t("ui.petbar.coming_home"), "normal")
	elseif (hpRatio or 0) <= 0 then
		paint(fight, fightTitle, Loc.t("ui.petbar.exhausted"), "disabled")
	else
		paint(fight, fightTitle, hpText, "normal")
	end
end

--------------------------------------------------------------------------------
-- Klicks
--------------------------------------------------------------------------------

local function onEventClicked()
	Unlock.markSeen("button_event")
	Remotes.RequestPetMode:FireServer("Event")
end

local function onFightClicked()
	-- Zurueckholen oder einen vorgemerkten Wechsel abbrechen: keine Frage.
	if _state == "ToPit" or _state == "InPit" or _pending == "Fight" then
		Remotes.RequestPetMode:FireServer("Fight")
		return
	end

	-- Neuer Lauf: gibt es einen letzten Lauf in diesem Tower, zuerst die
	-- Fortsetzungs-Frage.
	local data = ClientState.get()

	-- Entscheidung 05.10. (FIGHT_RESUME_PROMPT): Standard ist IMMER Stage 1.
	-- Der Einstieg ab der letzten Stage gegen Gummies ist ein kleines Feld,
	-- das nach 7 s von selbst verschwindet (dann Stage 1). Ein zweiter
	-- Fight-Klick waehrend das Feld offen ist, startet sofort bei Stage 1.
	if FeatureFlags.isOn("FIGHT_RESUME_PROMPT") then
		if FightStartPrompt.isOpen() then
			FightStartPrompt.chooseFresh()
			return
		end
		local opened = FightStartPrompt.open(function(choice)
			Remotes.RequestPetMode:FireServer("Fight", choice)
		end)
		if not opened then
			Remotes.RequestPetMode:FireServer("Fight", "Fresh")
		end
		return
	end

	-- HBB Paket 2: keine Frage mehr. Mit gespeichertem Lauf geht es
	-- kostenlos ab 65 % weiter; der bezahlte Einstieg ab der letzten Stage
	-- ist ein eigener kleiner Knopf im Tower-Fenster (CombatPanel). Der
	-- Server rechnet beide Wege unveraendert.
	if FeatureFlags.isOn("UI_V2_GUIDE") then
		local choice = if data and PitResumeDialog.getProgress(data) then "Percent" else "Fresh"
		Remotes.RequestPetMode:FireServer("Fight", choice)
		return
	end

	if data and PitResumeDialog.getProgress(data) then
		PitResumeDialog.open(function(choice)
			Remotes.RequestPetMode:FireServer("Fight", choice)
		end)
		return
	end

	Remotes.RequestPetMode:FireServer("Fight", "Fresh")
end

--------------------------------------------------------------------------------
-- HBB Paket 2: Anker fuer die Fuehrung (GuideController)
--------------------------------------------------------------------------------

function PetBar.getButton(mode: string): GuiObject?
	local view = if mode == "Fight" then _fight elseif mode == "Event" then _event else nil
	return if view then view.button else nil
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

local function buildButton(parent: Instance, name: string, color: Color3, order: number, onClick: () -> (), iconName: string, fallback: string): ButtonView
	local button = Theme.bigButton(name, parent, "", color)
	button.Size        = UDim2.fromOffset(BUTTON_WIDTH, BUTTON_HEIGHT)
	button.LayoutOrder = order

	local stroke = button:FindFirstChildOfClass("UIStroke") :: UIStroke

	-- Icon links, ragt oben ueber den Knopf hinaus
	local icon = Icons.make(button, iconName, fallback)
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.Position    = UDim2.new(0, 6, 0.5, -6)
	icon.Size        = UDim2.fromOffset(60, 60)
	icon.ZIndex      = 4

	-- Beschriftung setzt refresh() (in der Spielersprache); `name` ist nur der Instanz-Name
	local title = Theme.label("Title", button, "")
	title.Position       = UDim2.new(0, 64, 0, 6)
	title.Size           = UDim2.new(1, -72, 0, 30)
	title.TextXAlignment = Enum.TextXAlignment.Center
	title.TextColor3     = Theme.COLORS.text
	Theme.outlineText(title)

	local sub = Theme.label("Sub", button, "")
	sub.Position       = UDim2.new(0, 64, 1, -26)
	sub.Size           = UDim2.new(1, -70, 0, 18)
	sub.TextXAlignment = Enum.TextXAlignment.Center
	sub.TextScaled     = false
	sub.TextSize       = 12
	sub.Font           = Theme.FONT_BODY
	sub.TextColor3     = Theme.COLORS.outline
	sub.TextTruncate   = Enum.TextTruncate.AtEnd

	button.Activated:Connect(function()
		if not button.Active then return end
		onClick()
	end)

	return { button = button, title = title, sub = sub, stroke = stroke, color = color, icon = icon }
end

function PetBar.init(screenGui: ScreenGui)
	local bar = Theme.container("PetBar", screenGui)
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position    = UDim2.new(0.5, 0, 1, -14)
	bar.Size        = UDim2.fromOffset(BUTTON_WIDTH * 2 + GAP, BUTTON_HEIGHT)
	bar.ZIndex      = 5

	-- Auf schmalen Bildschirmen (Handy) mitskalieren statt ueber den Rand.
	-- Playtest 07.10.: auf Touch-Geraeten ausserdem raus aus der Zone des
	-- Bewegungs-Sticks und weg vom Sprung-Knopf (TouchSafeArea) — sonst
	-- loeste, wer laufen wollte, den Event-Knopf aus.
	local scale = Instance.new("UIScale")
	scale.Parent = bar
	local barWidth = BUTTON_WIDTH * 2 + GAP
	local function rescale()
		local zone = TouchSafeArea.zone(screenGui)
		if zone then
			bar.Position = UDim2.new(0, zone.center, 1, -14)
			scale.Scale  = math.clamp(zone.width / barWidth, 0.5, 1)
		else
			local width = UiScale.toGui(screenGui.AbsoluteSize.X)
			bar.Position = UDim2.new(0.5, 0, 1, -14)
			scale.Scale  = math.clamp((width - 32) / barWidth, 0.6, 1)
		end
	end
	TouchSafeArea.watch(screenGui, rescale)

	local layout = Theme.listLayout(bar, GAP, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	_event = buildButton(bar, "Event", EVENT_COLOR, 1, onEventClicked, "ufo", "UFO")
	_fight = buildButton(bar, "Fight", FIGHT_COLOR, 2, onFightClicked, "swords", "X")

	-- Sammel-Update 05.10. (Paket 4.3): Tempo-Knopf ueber dem Fight-Knopf,
	-- nur waehrend der Baerchi im Tower kaempft. Ein Tipp schaltet
	-- x1 -> x2 -> x4 -> "sofort" -> x1. Der Server spielt ab der naechsten
	-- Stage schneller ab; die Abrechnung bleibt gleich.
	local speedButton = Theme.button("SpeedButton", _fight.button, "⏩ x1", Theme.COLORS.panelLight)
	speedButton.AnchorPoint = Vector2.new(1, 1)
	speedButton.Position    = UDim2.new(1, 0, 0, -6)
	speedButton.Size        = UDim2.fromOffset(96, 34)
	speedButton.ZIndex      = 6
	speedButton.TextColor3  = Theme.COLORS.text
	speedButton.Visible     = false
	_speedButton = speedButton
	speedButton.Activated:Connect(function()
		local index = (table.find(SPEED_STEPS, _speedChoice) or 1) % #SPEED_STEPS + 1
		_speedChoice = SPEED_STEPS[index]
		Remotes.RequestPitSpeed:FireServer(_speedChoice)
		refresh()
	end)
	FightStartPrompt.init(screenGui, bar)

	PitResumeDialog.init(screenGui)

	Remotes.PetModeChanged.OnClientEvent:Connect(function(state: any, pending: any, info: any)
		_state   = if typeof(state) == "string" then state else "Home"
		_pending = if typeof(pending) == "string" then pending else nil
		local typedInfo = if typeof(info) == "table" then info else {}
		_stage     = if typeof(typedInfo.stage) == "number" then typedInfo.stage else nil
		_tower     = if typeof(typedInfo.tower) == "string" then typedInfo.tower else nil
		_from      = if typeof(typedInfo.from) == "string" then typedInfo.from else nil
		_abducting = typedInfo.abducting == true

		-- Laeuft der Baerchi los, ist eine offene Fortsetzungs-Frage hinfaellig.
		if _state ~= "Home" and _state ~= "Returning" and PitResumeDialog.isOpen() then
			PitResumeDialog.close()
		end

		refresh()
	end)

	Remotes.EventPhaseChanged.OnClientEvent:Connect(function(eventId: any, remaining: any, nextEventId: any, untilBoss: any)
		-- Sammel-Update 5.3: Countdown bis zum Boss
		_bossAt      = if typeof(untilBoss) == "number" then os.clock() + untilBoss else nil
		_eventId     = if typeof(eventId) == "string" then eventId else nil
		_nextEventId = if typeof(nextEventId) == "string" then nextEventId else nil
		_phaseEndsAt = os.clock() + (if typeof(remaining) == "number" then remaining else 0)
		refresh()
	end)

	ClientState.onChanged(refresh)
	Loc.onChanged(function() refresh() end)

	-- Restzeit des Events jede Sekunde nachziehen
	local accumulator = 0
	RunService.Heartbeat:Connect(function(delta)
		accumulator += delta
		if accumulator < 1 then return end
		accumulator = 0
		refresh()
	end)

	refresh()
	print("[PetBar] Initialisiert")
end

return PetBar
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">PitResumeDialog</string><ProtectedString name="Source"><![CDATA[--!strict
-- PitResumeDialog.luau
-- StarterPlayerScripts/UI/PitResumeDialog.luau
--
-- Einzige Zustaendigkeit:
--   - Vor einem PIT-Lauf fragen, wo eingestiegen wird: von vorn, ab 65 % des
--     letzten Laufs oder ab der letzten erreichten Stage (gegen Gummies).
--
-- v15: pro Tower. Erscheint nur, wenn es im GEWAEHLTEN Tower einen
-- gespeicherten letzten Lauf gibt (island.towerProgress), auch nach einer
-- Niederlage oder einem Zurueckholen. Startstage und Kosten rechnet
-- TowerConfig — dieselben
-- Funktionen benutzt der Server beim Abbuchen. Nicht bezahlbare Optionen sind
-- sichtbar, aber nicht klickbar. Abbrechen schliesst den Dialog, der Baerchi
-- bleibt zu Hause.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Loc = require(game:GetService("ReplicatedStorage").Localization.Loc)   -- Sammel-Update 2.4

local Types            = require(ReplicatedStorage.Network.Types)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local Loc              = require(ReplicatedStorage.Localization.Loc)

local Theme       = require(script.Parent.Theme)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local PitResumeDialog = {}

export type Choice = "Fresh" | "Percent" | "Last"

local _root: Frame? = nil
local _hpLabel: TextLabel? = nil
local _options: { [Choice]: TextButton } = {}
local _onChoose: ((Choice) -> ())? = nil

local function selectedTower(data: Types.PlayerDataUpdate): string
	return if data.towers then data.towers.selected else TowerConfig.FIRST_TOWER
end

-- Die letzte erreichte Stage im gewaehlten Tower (nil = kein Lauf gespeichert).
function PitResumeDialog.getProgress(data: Types.PlayerDataUpdate): number?
	local progress = data.island.towerProgress
	local reached = if progress then progress[selectedTower(data)] else nil
	if typeof(reached) == "number" and reached >= 1 then
		return reached
	end
	return nil
end

-- Start-Stage und Gummi-Kosten einer Option — dieselbe Rechnung wie
-- CombatService.getResumeOffer (TowerConfig). Oeffentlich fuer FightStartPrompt.
local function offer(data: Types.PlayerDataUpdate, choice: Choice): (number, number)
	if choice == "Fresh" then
		return 1, 0
	end
	local reached = PitResumeDialog.getProgress(data)
	if not reached then
		return 1, 0
	end
	local towerId = selectedTower(data)
	local def = TowerConfig.get(towerId)
	local stage = if choice == "Last"
		then reached
		else TowerConfig.getResumePercentStage(reached)
	stage = math.clamp(stage, 1, if def then def.stages else 1)
	return stage, TowerConfig.getResumeCost(towerId, stage, data.rebirthMult)
end

-- Sammel-Update 2.4: Schluessel statt fester Texte
local LABELS: { [Choice]: string } = {
	Fresh   = "ui.resume.fresh",
	Percent = "ui.resume.percent",
	Last    = "ui.resume.last",
}

local function fill()
	local data = ClientState.get()
	if not data then return end

	for choice, button in _options do
		local stage, cost = offer(data, choice)
		local affordable = cost <= data.gummies

		button.Text = Loc.t("ui.pit_resume.option", {
			label = Loc.t(LABELS[choice]),
			stage = stage,
			cost  = if cost > 0 then Loc.t("event.bonus.gummies", { n = cost }) else Loc.t("ui.resume.free"),
		})
		Theme.setEnabled(button, affordable)
	end

	local hpLabel = _hpLabel
	if hpLabel then
		local uid = data.island.equippedUid
		local baerchi = if uid then data.island.baerchis[uid] else nil
		local def = if baerchi then BaerchiConfig.getById(baerchi.configId) else nil
		local reached = PitResumeDialog.getProgress(data)
		if baerchi and def then
			local maxHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
			local hp = math.clamp(baerchi.currentHp or maxHp, 0, maxHp)
			hpLabel.Text = Loc.t("ui.resume.status", {
				tower = (TowerConfig.get(selectedTower(data)) or TowerConfig.TOWERS[1]).numeral,
				stage = reached or 0,
				hp = hp, max = maxHp, pct = math.floor(hp / math.max(1, maxHp) * 100 + 0.5),
			})
		end
	end
end

function PitResumeDialog.offer(data: Types.PlayerDataUpdate, choice: Choice): (number, number)
	return offer(data, choice)
end

function PitResumeDialog.close()
	_onChoose = nil
	local root = _root
	if root then root.Visible = false end
end

-- Oeffnet den Dialog. `onChoose` bekommt die gewaehlte Option.
function PitResumeDialog.open(onChoose: (Choice) -> ())
	local root = _root
	if not root then return end
	_onChoose = onChoose
	fill()
	root.Visible = true
end

function PitResumeDialog.isOpen(): boolean
	return _root ~= nil and (_root :: Frame).Visible
end

function PitResumeDialog.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"PitResumeDialog", screenGui,
		Vector2.new(0.46, 0.42),
		Vector2.new(300, 280),
		Vector2.new(520, 340)
	)
	root.ZIndex = 20
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.resume.title"), PitResumeDialog.close)

	local body = Theme.dialogBody(root)
	local layout = Theme.listLayout(body, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local hp = Theme.bodyText("Hp", body, "")
	hp.Size        = UDim2.new(1, 0, 0, 20)
	hp.LayoutOrder = 0
	_hpLabel = hp

	local colors: { [Choice]: Color3 } = {
		Fresh   = Theme.COLORS.accent,
		Percent = Theme.COLORS.goldGummy,
		Last    = Theme.COLORS.bad,
	}

	for order, choice in { "Fresh", "Percent", "Last" } :: { Choice } do
		local button = Theme.bigButton("Option_" .. choice, body, Loc.t(LABELS[choice]), colors[choice])
		button.Size        = UDim2.new(1, 0, 0, 44)
		button.LayoutOrder = order
		button.Activated:Connect(function()
			if not button.Active then return end
			local callback = _onChoose
			PitResumeDialog.close()
			if callback then callback(choice) end
		end)
		_options[choice] = button
	end

	local cancel = Theme.button("Cancel", body, "", Theme.COLORS.panelLight)
	Loc.bind(cancel, "ui.common.cancel")
	cancel.Size        = UDim2.new(1, 0, 0, 34)
	cancel.LayoutOrder = 10
	cancel.TextColor3  = Theme.COLORS.text
	cancel.Activated:Connect(PitResumeDialog.close)

	ClientState.onChanged(function()
		if PitResumeDialog.isOpen() then fill() end
	end)
	Loc.onChanged(function()
		if PitResumeDialog.isOpen() then fill() end
	end)

	print("[PitResumeDialog] Initialisiert")
end

return PitResumeDialog
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX52"><Properties><string name="Name">ProfilePanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- ProfilePanel.luau
-- StarterPlayerScripts/UI/ProfilePanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die Profilkarte eines anderen Spielers zeigen (Inspektor, v15):
--     ausgeruesteter Baerchi (Rarity, Mutation, Level, Sterne), hoechster
--     Tower/Rekord, Rebirths, Index x/28 und die Top 3 Baerchis nach Staerke.
--
-- Geoeffnet ueber PanelManager.open("Profile", userId) — vom WorldController
-- (Klick auf Charakter oder Plot-Schild) und vom LeaderboardPanel. Die Karte
-- baut der Server (GetPlayerProfile); hier wird nur angezeigt.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types         = require(ReplicatedStorage.Network.Types)
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local Names         = require(ReplicatedStorage.Localization.Names)
local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local TowerConfig   = require(ReplicatedStorage.Config.TowerConfig)
local PromotionConfig = require(ReplicatedStorage.Config.PromotionConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)

local ProfilePanel = {}

local PANEL_NAME = "Profile"

local _root: Frame? = nil
local _title: TextLabel? = nil
local _lines: TextLabel? = nil
local _requestId = 0

local function baerchiLine(entry: Types.ProfileBaerchi): string
	local name = Names.baerchi(entry.configId)
	local stars = math.floor(math.clamp(entry.promotion, 0, PromotionConfig.MAX_PROMOTION) / 2)
	local mutation = if entry.mutation then " · " .. Loc.name("mutation." .. entry.mutation .. ".name", entry.mutation) else ""
	return string.format("%s  (%s%s)  Lv.%d  %s", name, Loc.name("rarity." .. entry.rarity, entry.rarity), mutation,
		entry.level, string.rep("★", stars))
end

local function render(card: Types.PlayerProfileCard?)
	local title, lines = _title, _lines
	if not title or not lines then return end
	if not card then
		title.Text = Loc.t("ui.profile.title")
		lines.Text = Loc.t("ui.profile.unavailable")
		return
	end

	title.Text = card.name
	local def = TowerConfig.get(card.highestTower) or TowerConfig.TOWERS[1]
	local out: { string } = {
		Loc.t("ui.profile.equipped", { baerchi = if card.equipped then baerchiLine(card.equipped) else "—" }),
		Loc.t("ui.profile.tower", { tower = def.numeral, stage = card.towerRecord }),
		Loc.t("ui.profile.rebirths", { n = card.rebirths }),
		Loc.t("ui.profile.index", { have = card.indexCount, total = card.indexTotal }),
		"",
		Loc.t("ui.profile.top"),
	}
	for i, entry in card.top do
		table.insert(out, string.format("%d. %s", i, baerchiLine(entry)))
	end
	lines.Text = table.concat(out, "\n")
end

local function show(userId: number)
	render(nil)
	local title = _title
	if title then title.Text = Loc.t("ui.leaderboard.loading") end

	_requestId += 1
	local myRequest = _requestId
	task.spawn(function()
		local ok, card = pcall(function()
			return Remotes.GetPlayerProfile:InvokeServer(userId)
		end)
		if myRequest ~= _requestId then return end
		render(if ok and typeof(card) == "table" then card :: Types.PlayerProfileCard else nil)
	end)
end

function ProfilePanel.init(screenGui: ScreenGui)
	local root = Theme.dialog("ProfilePanel", screenGui, Vector2.new(0.42, 0.5), Vector2.new(300, 300), Vector2.new(480, 420))
	_root = root

	_title = Theme.dialogHeader(root, Loc.t("ui.profile.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)
	local lines = Theme.bodyText("Lines", body, "")
	lines.Size       = UDim2.fromScale(1, 1)
	lines.TextColor3 = Theme.COLORS.text
	lines.TextSize   = 15
	_lines = lines

	PanelManager.register(PANEL_NAME, {
		open = function(...: any)
			local userId = select(1, ...)
			if typeof(userId) ~= "number" then return end
			root.Visible = true
			show(userId)
		end,
		close = function()
			root.Visible = false
		end,
	})

	print("[ProfilePanel] Initialisiert")
end

return ProfilePanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX53"><Properties><string name="Name">QuestTracker</string><ProtectedString name="Source"><![CDATA[--!strict
-- QuestTracker.luau
-- StarterPlayerScripts/UI/QuestTracker.luau
--
-- Einzige Zustaendigkeit:
--   - Die kleine Quest-Karte links: immer EINE aktuelle Aufgabe mit Hinweis,
--     Fortschritt und (wenn geschafft) dem Abholen-Knopf
--   - Der Zugang zum Quest-Fenster (Karte antippen)
--   - Der Toast bei ausgezahlter Belohnung
--
-- Das ist die Antwort auf "was mache ich jetzt?": der Spieler muss nichts
-- oeffnen, die naechste sinnvolle Aufgabe steht immer im Bild. Die Karte
-- rechnet nichts, sie zeigt ClientState.get().quests.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")

local Types   = require(ReplicatedStorage.Network.Types)
local Remotes = require(ReplicatedStorage.Network.Remotes)
local Loc     = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local QuestConfig  = require(ReplicatedStorage.Config.QuestConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local Icons        = require(script.Parent.Icons)
local QuestPanel   = require(script.Parent.QuestPanel)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local QuestTracker = {}

local CARD_W = 236
-- Playtest 05.10.: 124 liess "Abholen" und "Tagesbonus" ineinander laufen
local CARD_H = 142

local _card: Frame?          = nil
local _header: TextLabel?    = nil
local _title: TextLabel?     = nil
local _hint: TextLabel?      = nil
local _bar: Theme.Progress?  = nil
local _claim: TextButton?    = nil
local _daily: TextButton?    = nil
local _alert: Frame?         = nil
local _pulse: Tween?         = nil

local function dailyReady(quests: Types.QuestView): (number, number)
	local done, claimable = 0, 0
	for _, entry in quests.daily do
		if entry.claimed then
			done += 1
		elseif entry.progress >= entry.target then
			claimable += 1
		end
	end
	return done, claimable
end

local _bonusOpen = false

-- HBB Paket 2: kompakte Karte (Icon + Zaehler + Belohnungs-Icon). Antippen
-- klappt den Volltext fuer EXPAND_SECONDS auf; ein zweites Antippen oeffnet
-- wie bisher das Quest-Fenster.
local EXPAND_SECONDS = 6
local _expanded = false
local _expandToken = 0
local _questIcon: Frame? = nil
local _reward: Frame? = nil
local _rewardIcon: Frame? = nil
local _rewardLabel: TextLabel? = nil
local _claimCheck: GuiObject? = nil

-- Sammel-Update 05.10. (Paket 3.10, "Quest-UI am Anfang schwierig"): die
-- ERSTE Kettenquest steht immer gross mit Volltext und Fortschritt da, die
-- Tages-Quests erscheinen erst nach ihrem Abschluss.
local _firstQuest = false

local function compact(): boolean
	return FeatureFlags.isOn("UI_V2_GUIDE") and not _expanded and not _firstQuest
end

local function setIcon(holder: Frame?, name: string, fallback: string)
	if not holder then return end
	if holder:GetAttribute("IconName") == name then return end
	holder:SetAttribute("IconName", name)
	for _, child in holder:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	local icon = Icons.make(holder, name, fallback)
	icon.Size = UDim2.fromScale(1, 1)
	icon.ZIndex = 4
end

local function refresh(data: Types.PlayerDataUpdate)
	local quests = data.quests
	local header, title, hint, bar, claim, daily, alert =
		_header, _title, _hint, _bar, _claim, _daily, _alert
	if not quests or not header or not title or not hint or not bar or not claim or not daily or not alert then
		return
	end

	local chain = quests.chain
	_firstQuest = quests.chainDone == 0 and chain ~= nil
	if chain then
		local done = chain.progress >= chain.target
		header.Text = Loc.t("ui.quest.header", { done = quests.chainDone + 1, total = quests.chainTotal })
		title.Text  = QuestPanel.title(chain.id)
		hint.Text   = if done then QuestPanel.rewardText(chain.id) else QuestPanel.hint(chain.id)
		hint.TextColor3 = if done then Theme.COLORS.goldGummy else Theme.COLORS.textDim

		bar.track.Visible = not done
		claim.Visible     = done
		bar.fill.Size     = UDim2.fromScale(math.clamp(chain.progress / math.max(1, chain.target), 0, 1), 1)
		bar.text.Text     = Loc.formatNumber(chain.progress) .. " / " .. Loc.formatNumber(chain.target)

		claim:SetAttribute("QuestId", chain.id)
	else
		header.Text = Loc.t("ui.quest.panel_title")
		title.Text  = Loc.t("ui.quest.chain_done")
		hint.Text   = ""
		bar.track.Visible = false
		claim.Visible     = false
	end

	-- HBB Paket 2: kompakte Darstellung
	local isCompact = compact()
	header.Visible = not isCompact
	title.Visible  = not isCompact
	hint.Visible   = not isCompact
	local questIcon, reward, rewardIcon, rewardLabel, check = _questIcon, _reward, _rewardIcon, _rewardLabel, _claimCheck
	if questIcon and reward and rewardLabel and check then
		local def = if chain then QuestConfig.getById(chain.id) else nil
		questIcon.Visible = isCompact and def ~= nil
		reward.Visible    = isCompact and def ~= nil
		check.Visible     = isCompact and claim.Visible
		claim.TextTransparency = if isCompact then 1 else 0
		if def then
			setIcon(questIcon, QuestConfig.METRIC_ICON[def.metric] or "scroll", "?")
			if def.reward.eggType then
				setIcon(rewardIcon, "egg", "🥚")
				rewardLabel.Text = "+" .. Loc.formatNumber(def.reward.gummies)
			else
				setIcon(rewardIcon, "gummy", "G")
				rewardLabel.Text = "+" .. Loc.formatNumber(def.reward.gummies)
			end
		end
		-- Der Abholen-Knopf bleibt, wo er ist (sein Puls-Tween setzt die Groesse).
		if isCompact then
			bar.track.Position = UDim2.new(0, 64, 0, 18)
			bar.track.Size     = UDim2.new(1, -74, 0, 22)
		else
			bar.track.Position = UDim2.new(0, 10, 0, 80)
			bar.track.Size     = UDim2.new(1, -20, 0, 18)
		end
	end

	local doneCount, claimable = dailyReady(quests)
	daily.Visible = not _firstQuest   -- Paket 3.10: erst nach der ersten Quest
	-- v15: ist der Login-Bonus noch nicht abgeholt, zeigt der untere Knopf
	-- darauf (und oeffnet das Bonus-Fenster statt der Quests).
	local bonusOpen = data.daily ~= nil and data.daily.claimable
	_bonusOpen = bonusOpen
	if isCompact then
		-- Nur Zeichen und Zahlen: Geschenk = Login-Bonus, Rolle = Tagesquests
		daily.Text = if bonusOpen then "🎁" else string.format("📜 %d/%d", doneCount, #quests.daily)
	else
		daily.Text = if bonusOpen
			then Loc.t("ui.daily.tracker_hint")
			else Loc.t("ui.quest.daily_link", { done = doneCount, total = #quests.daily })
	end

	-- Rotes "!" am Karten-Rand: irgendetwas ist abholbereit.
	local chainReady = chain ~= nil and chain.progress >= chain.target
	alert.Visible = chainReady or claimable > 0 or bonusOpen
end

function QuestTracker.init(screenGui: ScreenGui)
	local card = Theme.panel("QuestTracker", screenGui, Theme.COLORS.panelDeep)
	card.Position = UDim2.new(0.012, 12, 0, 148)
	card.Size     = UDim2.new(0, CARD_W, 0, CARD_H)
	card.ZIndex   = 2
	_card = card

	-- Die ganze Karte ist antippbar (oeffnet das Quest-Fenster); die Knoepfe
	-- darauf liegen hoeher und fangen ihre eigenen Klicks ab.
	local hit = Instance.new("TextButton")
	hit.Name                   = "Hit"
	hit.BackgroundTransparency = 1
	hit.Text                   = ""
	hit.Size                   = UDim2.fromScale(1, 1)
	hit.ZIndex                 = 2
	hit.Parent                 = card
	hit.Activated:Connect(function()
		-- HBB Paket 2: erst aufklappen (Volltext), dann erst das Fenster
		if compact() then
			_expanded = true
			_expandToken += 1
			local token = _expandToken
			local data = ClientState.get()
			if data then refresh(data) end
			task.delay(EXPAND_SECONDS, function()
				if token ~= _expandToken then return end
				_expanded = false
				local current = ClientState.get()
				if current then refresh(current) end
			end)
			return
		end
		PanelManager.toggle("Quests")
	end)

	-- Schriftrolle links oben, ragt ueber die Ecke der Karte hinaus
	local icon = Icons.make(card, "scroll", "?")
	icon.Position = UDim2.new(0, -10, 0, -12)
	icon.Size     = UDim2.fromOffset(40, 40)
	icon.ZIndex   = 4

	local header = Theme.label("Header", card, "")
	header.Position   = UDim2.new(0, 36, 0, 5)
	header.Size       = UDim2.new(1, -46, 0, 14)
	header.TextColor3 = Theme.COLORS.accent
	_header = header

	local title = Theme.label("Title", card, "")
	title.Position = UDim2.new(0, 36, 0, 20)
	title.Size     = UDim2.new(1, -46, 0, 22)
	Theme.outlineText(title, 2)
	_title = title

	local hint = Theme.bodyText("Hint", card, "")
	hint.Position  = UDim2.new(0, 10, 0, 44)
	hint.Size      = UDim2.new(1, -20, 0, 32)
	hint.TextSize  = 12
	_hint = hint

	local bar = Theme.progress(card, Theme.COLORS.accent)
	bar.track.Position = UDim2.new(0, 10, 0, 80)
	bar.track.Size     = UDim2.new(1, -20, 0, 18)
	bar.text.TextScaled = false
	bar.text.TextSize   = 12
	_bar = bar

	local claim = Theme.bigButton("Claim", card, "", Theme.COLORS.good)
	-- Mittig verankert: das Pulsieren waechst nach beiden Seiten statt nach rechts unten
	claim.AnchorPoint = Vector2.new(0.5, 0)
	claim.Position = UDim2.new(0.5, 0, 0, 78)
	claim.Size     = UDim2.new(1, -20, 0, 28)
	claim.ZIndex   = 3
	claim.Visible  = false
	Loc.bind(claim, "ui.quest.claim")
	_claim = claim
	claim.Activated:Connect(function()
		local id = claim:GetAttribute("QuestId")
		if typeof(id) == "string" then
			Remotes.RequestClaimQuest:FireServer("chain", id)
		end
	end)

	-- Sanftes Pulsieren, damit ein abholbarer Knopf auffaellt.
	_pulse = TweenService:Create(claim, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Size = UDim2.new(1, -14, 0, 30),
	})
	_pulse:Play()

	local daily = Theme.button("Daily", card, "", Theme.COLORS.panelLight)
	daily.Position   = UDim2.new(0, 10, 1, -30)
	daily.Size       = UDim2.new(1, -20, 0, 22)
	daily.TextColor3 = Theme.COLORS.text
	daily.ZIndex     = 3
	_daily = daily
	daily.Activated:Connect(function()
		PanelManager.toggle(if _bonusOpen then "DailyBonus" else "Quests")
	end)

	local alert = Theme.panel("Alert", card, Theme.COLORS.bad)
	alert.AnchorPoint = Vector2.new(1, 0)
	alert.Position    = UDim2.new(1, 6, 0, -6)
	alert.Size        = UDim2.new(0, 22, 0, 22)
	alert.Visible     = false
	alert.ZIndex      = 4
	Theme.corner(alert, 11)
	local bang = Theme.label("Bang", alert, "!")
	bang.Size           = UDim2.fromScale(1, 1)
	bang.TextXAlignment = Enum.TextXAlignment.Center
	bang.ZIndex         = 5
	_alert = alert

	-- HBB Paket 2: Elemente der kompakten Karte
	local questIcon = Theme.container("QuestIcon", card)
	questIcon.Position = UDim2.new(0, 8, 0, 8)
	questIcon.Size     = UDim2.fromOffset(50, 50)
	questIcon.ZIndex   = 3
	questIcon.Visible  = false
	_questIcon = questIcon

	local reward = Theme.container("Reward", card)
	reward.Position = UDim2.new(0, 64, 0, 46)
	reward.Size     = UDim2.new(1, -74, 0, 28)
	reward.ZIndex   = 3
	reward.Visible  = false
	_reward = reward
	local rewardIcon = Theme.container("Icon", reward)
	rewardIcon.Size = UDim2.fromOffset(28, 28)
	_rewardIcon = rewardIcon
	local rewardLabel = Theme.label("Amount", reward, "")
	rewardLabel.Position = UDim2.new(0, 34, 0, 2)
	rewardLabel.Size     = UDim2.new(1, -34, 1, -4)
	rewardLabel.TextColor3 = Theme.COLORS.goldGummy
	Theme.outlineText(rewardLabel, 2)
	_rewardLabel = rewardLabel

	local check = Icons.make(claim, "check", "✓")
	check.AnchorPoint = Vector2.new(0.5, 0.5)
	check.Position    = UDim2.fromScale(0.5, 0.5)
	check.Size        = UDim2.fromOffset(24, 24)
	check.ZIndex      = 4
	check.Visible     = false
	_claimCheck = check

	ClientState.onChanged(refresh)
	Loc.onChanged(function()
		local data = ClientState.get()
		if data then refresh(data) end
	end)

	Remotes.QuestRewardReceived.OnClientEvent:Connect(function(reward: Types.QuestReward)
		-- Gummies und Eier der Quest fliegen ueber den Datenstand.
		Notify.emit("quest_reward", function()
			Toast.success(Loc.t("ui.quest.toast", { text = QuestPanel.rewardText(reward.questId) }))
		end)
	end)

	print("[QuestTracker] Initialisiert")
end

return QuestTracker
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX54"><Properties><string name="Name">RebirthDialog</string><ProtectedString name="Source"><![CDATA[--!strict
-- RebirthDialog.luau
-- StarterPlayerScripts/UI/RebirthDialog.luau
--
-- Einzige Zustaendigkeit:
--   - Vor dem Rebirth klar sagen was verloren geht und was bleibt
--   - Den Rebirth ausloesen und das Ergebnis bestaetigen
--
-- Der Text unten muss zu RebirthService passen — dort steht die verbindliche
-- Liste. Stand jetzt:
--   verloren : alle Baerchis, alle Gebaeude-Level, PIT-Level, laufende Bruten,
--              Gummies (zurueck auf EconomyConfig.REBIRTH_START_GUMMIES)
--   behalten : GoldGummies, Rang, Statistiken, bereits verdiente AscensionEggs
--   gewonnen : hoeherer Multiplikator, ggf. AscensionEggs (Meilenstein)
-- Wer den Service aendert, aendert diesen Text mit.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types         = require(ReplicatedStorage.Network.Types)
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local TowerConfig   = require(ReplicatedStorage.Config.TowerConfig)   -- Paket 4.1
local EconomyConfig = require(ReplicatedStorage.Config.EconomyConfig)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local Moment       = require(script.Parent.Moment)
local PanelManager = require(script.Parent.PanelManager)
local Icons        = require(script.Parent.Icons)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local RebirthDialog = {}

local PANEL_NAME = "Rebirth"

local _root: Frame?               = nil
local _statusLabel: TextLabel?    = nil
local _costLabel: TextLabel?      = nil
local _lossLabel: TextLabel?      = nil
local _rewardLabel: TextLabel?    = nil
local _confirmButton: TextButton? = nil
-- HBB Paket 2: Icons vor den Zeilen (Vorher/Nachher ohne Saetze)
local _rowIcons: { GuiObject } = {}
local ICON_W = 28

--------------------------------------------------------------------------------
-- Inhalt
--------------------------------------------------------------------------------

function RebirthDialog.refresh()
	local root = _root
	if not root or not root.Visible then return end

	local data = ClientState.get()
	if not data then return end

	-- Sammel-Update 05.10. (Paket 4.1): Bedingung ist eine Stage, kein Preis.
	local records = data.towers and data.towers.records
	local reqTower, reqStage = TowerConfig.getRebirthRequirement(data.rebirthCount, records)
	local reqDef  = TowerConfig.get(reqTower)
	local have    = ((data.island :: any).stageBest or {})[reqTower] or 0
	local nextMult = EconomyConfig.getRebirthMult(data.rebirthCount + 1)
	local eggs    = EconomyConfig.getAscensionEggReward(data.rebirthCount + 1)
	local enough  = TowerConfig.isRebirthReady(data.rebirthCount, (data.island :: any).stageBest, records)

	-- Zahlen uebergibt der Code als Zahlen: Loc formatiert sie je nach Sprache
	-- ("1.500" / "1,500" / "1 500"), der Text legt das Dezimalformat fest ({mult:d2}).
	if _statusLabel then
		_statusLabel.Text = Loc.t("ui.rebirth.status", {
			count = data.rebirthCount,
			mult  = data.rebirthMult,
		})
	end

	if _costLabel then
		_costLabel.Text = Loc.t("ui.rebirth.requirement", {
			tower = if reqDef then reqDef.numeral else reqTower,
			have  = math.min(have, reqStage),
			stage = reqStage,
		})
		_costLabel.TextColor3 = if enough then Theme.COLORS.good else Theme.COLORS.bad
	end

	if _lossLabel then
		_lossLabel.Text = Loc.t("ui.rebirth.loss", { start = EconomyConfig.REBIRTH_START_GUMMIES })
	end

	if _rewardLabel then
		-- v14: Meilensteine koennen jetzt alle vier Ascensions-Eier geben.
		local milestone = EconomyConfig.getRebirthMilestone(data.rebirthCount + 1)
		local onlyAscension = true
		local parts: { string } = {}
		if milestone then
			for _, entry in milestone.eggs do
				if entry.eggType ~= "AscensionEgg" then onlyAscension = false end
				table.insert(parts, string.format("+%d %s", entry.count,
					Loc.name("egg." .. entry.eggType .. ".name", entry.eggType)))
			end
		end
		_rewardLabel.Text = if #parts > 0 and not onlyAscension
			then Loc.t("ui.rebirth.reward_list", { mult = nextMult, eggs = table.concat(parts, ", ") })
			elseif eggs > 0 then Loc.tn("ui.rebirth.reward_eggs", eggs, { mult = nextMult })
			else Loc.t("ui.rebirth.reward", { mult = nextMult })
	end

	if _confirmButton then
		Theme.setEnabled(_confirmButton, enough)
	end

	-- HBB Paket 2: dieselben Zeilen als Icon + Zahl. Die Warnung vor dem
	-- Zuruecksetzen bleibt ein kurzer Satz: sie darf nicht in einem Icon
	-- verschwinden.
	local iconMode = FeatureFlags.isOn("UI_V2_GUIDE")
	for _, icon in _rowIcons do
		icon.Visible = iconMode
	end
	local labels = { _statusLabel, _costLabel, _lossLabel, _rewardLabel }
	for index, label in labels do
		if label then
			-- Platz fuer das Icon links; die Warnung (Zeile 3) hat keins
			local shift = if iconMode and index ~= 3 then ICON_W + 6 else 0
			label.Position = UDim2.new(0, shift + (if index == 3 then 2 else 0), label.Position.Y.Scale, label.Position.Y.Offset)
			label.Size = UDim2.new(1, -8 - shift, label.Size.Y.Scale, label.Size.Y.Offset)
		end
	end
	if iconMode then
		if _statusLabel then
			_statusLabel.Text = string.format("x%s  ➜  x%s",
				Loc.formatDecimal(data.rebirthMult, 2), Loc.formatDecimal(nextMult, 2))
		end
		if _costLabel then
			_costLabel.Text = string.format("%s %s · %s / %s", "🗼",
				if reqDef then reqDef.numeral else reqTower,
				Loc.formatNumber(math.min(have, reqStage)), Loc.formatNumber(reqStage))
		end
		if _lossLabel then
			_lossLabel.Text = "⚠ " .. Loc.t("ui.rebirth.warn_short")
		end
		if _rewardLabel then
			local milestone = EconomyConfig.getRebirthMilestone(data.rebirthCount + 1)
			local total = 0
			if milestone then
				for _, entry in milestone.eggs do total += entry.count end
			end
			total = math.max(total, eggs)
			_rewardLabel.Text = if total > 0 then "+" .. Loc.formatNumber(total) else "—"
		end
	end
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local root = _root
	if not root then return end

	root.Visible = true
	RebirthDialog.refresh()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function RebirthDialog.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"RebirthDialog", screenGui,
		Vector2.new(0.46, 0.50),
		Vector2.new(300, 270),
		Vector2.new(520, 400)
	)
	_root = root

	local title = Theme.dialogHeader(root, "", function()
		PanelManager.close(PANEL_NAME)
	end)
	Loc.bind(title, "ui.rebirth.title")

	local body = Theme.dialogBody(root)

	local status = Theme.label("Status", body, "")
	status.Size = UDim2.new(1, -8, 0, 24)
	_statusLabel = status

	local cost = Theme.label("Cost", body, "")
	cost.Position = UDim2.new(0, 0, 0, 28)
	cost.Size     = UDim2.new(1, -8, 0, 22)
	_costLabel = cost

	local loss = Theme.bodyText("Loss", body, "")
	loss.Position = UDim2.new(0, 2, 0, 56)
	loss.Size     = UDim2.new(1, -8, 0, 86)
	_lossLabel = loss

	local reward = Theme.label("Reward", body, "")
	reward.Position   = UDim2.new(0, 0, 0, 146)
	reward.Size       = UDim2.new(1, -8, 0, 24)
	reward.TextColor3 = Theme.COLORS.goldGummy
	_rewardLabel = reward

	-- HBB Paket 2: Icons fuer Multiplikator, Kosten, Belohnung (Zeile 3 =
	-- Warnung bleibt ohne Icon)
	local function rowIcon(y: number, name: string, fallback: string)
		local icon = Icons.make(body, name, fallback)
		icon.Position = UDim2.new(0, 0, 0, y)
		icon.Size = UDim2.fromOffset(ICON_W, ICON_W)
		icon.Visible = false
		table.insert(_rowIcons, icon)
	end
	rowIcon(-2, "rebirth", "*")
	rowIcon(25, "gummy", "G")
	rowIcon(144, "egg", "🥚")

	local cancel = Theme.button("Cancel", body, "", Theme.COLORS.panelLight)
	Loc.bind(cancel, "ui.rebirth.cancel")
	cancel.AnchorPoint = Vector2.new(0, 1)
	cancel.Position    = UDim2.new(0, 0, 1, 0)
	cancel.Size        = UDim2.new(0.5, -6, 0, 38)
	cancel.TextColor3  = Theme.COLORS.text
	cancel.Activated:Connect(function()
		PanelManager.close(PANEL_NAME)
	end)

	local confirm = Theme.button("Confirm", body, "", Theme.COLORS.gummy)
	Loc.bind(confirm, "ui.rebirth.confirm")
	confirm.AnchorPoint = Vector2.new(1, 1)
	confirm.Position    = UDim2.new(1, -8, 1, 0)
	confirm.Size        = UDim2.new(0.5, -6, 0, 38)
	_confirmButton = confirm

	confirm.Activated:Connect(function()
		Remotes.RequestRebirth:FireServer()
	end)

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	ClientState.onChanged(function()
		RebirthDialog.refresh()
	end)

	-- Sprachwechsel bei offenem Dialog: die Texte aus dem Spielstand neu setzen
	-- (die gebundenen Beschriftungen — Titel, Knoepfe — zieht Loc selbst nach)
	Loc.onChanged(function()
		RebirthDialog.refresh()
	end)

	Remotes.RebirthResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.RebirthResult

		local args = { count = typed.newRebirthCount, mult = typed.newMultiplier }

		local parts: { string } = {}
		local onlyAscension = true
		for _, entry in (typed.milestoneEggs or {}) do
			if entry.eggType ~= "AscensionEgg" then onlyAscension = false end
			table.insert(parts, string.format("%d %s", entry.count,
				Loc.name("egg." .. entry.eggType .. ".name", entry.eggType)))
		end
		Notify.emit("rebirth_done", function()
			if #parts > 0 and not onlyAscension then
				Toast.success(Loc.t("msg.rebirth_done_list", {
					count = typed.newRebirthCount, mult = typed.newMultiplier, eggs = table.concat(parts, ", "),
				}))
			else
				Toast.success(if typed.ascensionEggs > 0
					then Loc.tn("msg.rebirth_done_eggs", typed.ascensionEggs, args)
					else Loc.t("msg.rebirth_done", args))
			end
		end, function()
			-- Meilenstein-Eier fliegen ueber den Datenstand (UI/Feedback).
			Moment.show("rebirth", Theme.COLORS.good, "ui.moment.rebirth")
		end)

		PanelManager.close(PANEL_NAME)
	end)

	print("[RebirthDialog] Initialisiert")
end

return RebirthDialog
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX55"><Properties><string name="Name">ReturnSummary</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReturnSummary.luau
-- StarterPlayerScripts/UI/ReturnSummary.luau
--
-- Einzige Zustaendigkeit:
--   - Beim Zurueckkommen zeigen, was in der Abwesenheit entstanden ist:
--     Uhr + Dauer, Ei + Anzahl, Honig + Anzahl. Nur Icons und Zahlen.
--
-- Kontext: HBB Paket 1. Das ist der wichtigste Moment fuer die Rueckkehr an
-- Tag 2: "Dein Baerchi hat weitergemacht, waehrend du weg warst."
--
-- Die zwei Berichte (OfflineReportReceived fuer Honig, OfflineEggReportReceived
-- fuer Eier) kommen getrennt. Die Karte sammelt beide kurz und erscheint dann
-- einmal. Antippen schliesst sie, sonst verschwindet sie von selbst.

local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Loc            = require(ReplicatedStorage.Localization.Loc)
local FeedbackConfig = require(ReplicatedStorage.Config.FeedbackConfig)

local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)

local ReturnSummary = {}

local ROW_H = 46

local _screenGui: ScreenGui? = nil
local _pending = { seconds = 0, honey = 0, eggs = 0 }
local _scheduled = false

local function addRow(parent: Instance, order: number, iconName: string, fallback: string, text: string)
	local row = Theme.container("Row", parent)
	row.Size = UDim2.new(1, 0, 0, ROW_H)
	row.LayoutOrder = order

	local icon = Icons.make(row, iconName, fallback)
	icon.Size = UDim2.fromOffset(ROW_H - 4, ROW_H - 4)
	icon.Position = UDim2.fromOffset(4, 2)

	local value = Theme.label("Value", row, text)
	value.Position = UDim2.fromOffset(ROW_H + 10, 4)
	value.Size = UDim2.new(1, -(ROW_H + 14), 1, -8)
	Theme.outlineText(value, 2)
end

local function show()
	_scheduled = false
	local gui = _screenGui
	if not gui then return end
	local report = _pending
	_pending = { seconds = 0, honey = 0, eggs = 0 }
	if report.honey <= 0 and report.eggs <= 0 then return end

	local rows = 1 + (if report.eggs > 0 then 1 else 0) + (if report.honey > 0 then 1 else 0)

	local card = Theme.panel("ReturnSummary", gui, Theme.COLORS.panelDeep)
	card.AnchorPoint = Vector2.new(0.5, 0)
	card.Position = UDim2.new(0.5, 0, 0, 70)
	card.Size = UDim2.fromOffset(220, rows * (ROW_H + 6) + 16)
	card.ZIndex = 55
	Theme.padding(card, 8)

	-- Zeilen in einem eigenen Rahmen, damit das Listen-Layout den
	-- Schliessen-Knopf darueber nicht mit anordnet.
	local list = Theme.container("Rows", card)
	list.Size = UDim2.fromScale(1, 1)
	Theme.listLayout(list, 6)

	-- Die ganze Karte ist der Schliessen-Knopf: Kinder tippen sie einfach weg.
	local hit = Instance.new("TextButton")
	hit.Name = "Close"
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 60
	hit.Parent = card

	-- Uhr gibt es nicht als Bild; das Kuerzel ist sprachneutral.
	addRow(list, 1, "", "⏱", Loc.formatDuration(report.seconds))
	if report.eggs > 0 then
		addRow(list, 2, "egg", "🥚", "+" .. Loc.formatNumber(report.eggs))
	end
	if report.honey > 0 then
		addRow(list, 3, "honey", "H", "+" .. Loc.formatNumber(report.honey))
	end

	local scale = Instance.new("UIScale")
	scale.Scale = 0.3
	scale.Parent = card
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

	local closed = false
	local function close()
		if closed then return end
		closed = true
		local tween = TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 })
		tween:Play()
		tween.Completed:Wait()
		card:Destroy()
	end
	hit.Activated:Connect(close)
	task.delay(FeedbackConfig.RETURN_SHOW_SECONDS, close)
end

local function schedule()
	if _scheduled then return end
	_scheduled = true
	task.delay(FeedbackConfig.RETURN_COLLECT_SECONDS, show)
end

function ReturnSummary.addHoney(secondsAway: number, honey: number)
	_pending.seconds = math.max(_pending.seconds, secondsAway)
	_pending.honey += honey
	schedule()
end

function ReturnSummary.addEggs(secondsAway: number, eggs: number)
	_pending.seconds = math.max(_pending.seconds, secondsAway)
	_pending.eggs += eggs
	schedule()
end

function ReturnSummary.init(screenGui: ScreenGui)
	_screenGui = screenGui
end

return ReturnSummary
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX56"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!strict
-- Theme.luau
-- StarterPlayerScripts/UI/Theme.luau
--
-- Einzige Zustaendigkeit:
--   - Farben, Schrift und Baustein-Helfer fuer das gesamte UI
--
-- Kein UI-Modul definiert eigene Farben oder baut Frames von Hand —
-- alles laeuft hier durch. Wenn der Look sich aendert, aendert er sich hier.
--
-- Die Rarity-Farben kommen bewusst NICHT von hier, sondern aus
-- BaerchiConfig.RARITY_COLORS: der Server faerbt die Figuren auf der Insel
-- mit denselben Werten, und die duerfen nicht auseinanderlaufen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")

local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local Types         = require(ReplicatedStorage.Network.Types)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local RarityBandConfig = require(ReplicatedStorage.Config.RarityBandConfig)  -- HBB Paket 4

local Theme = {}

--------------------------------------------------------------------------------
-- Farben
--------------------------------------------------------------------------------

Theme.COLORS = {
	-- Flaechen
	panel      = Color3.fromRGB( 52,  46,  78),
	panelDeep  = Color3.fromRGB( 38,  34,  58),
	panelLight = Color3.fromRGB( 72,  64, 104),

	-- Rahmen (der dicke dunkle Cartoon-Rand)
	outline    = Color3.fromRGB( 24,  20,  38),

	-- Schrift
	text       = Color3.fromRGB(255, 255, 255),
	textDim    = Color3.fromRGB(188, 182, 210),

	-- Waehrungen
	gummy      = Color3.fromRGB(255, 105, 150),
	goldGummy  = Color3.fromRGB(255, 196,  60),

	-- Zustaende
	good       = Color3.fromRGB( 76, 217, 100),
	bad        = Color3.fromRGB(255,  82,  82),
	accent     = Color3.fromRGB(120, 190, 255),

	-- Die drei Gebaeude-Rollen (siehe Theme.buildingColor). Benannt nach der
	-- ROLLE, nicht nach dem Gebaeude: die Farbe soll sagen WOFUER sein Honig
	-- gut ist.
	volume     = Color3.fromRGB(255, 186,  62),   -- Vorrat
	healing    = Color3.fromRGB( 92, 222, 160),   -- Heilung
	growth     = Color3.fromRGB(178, 148, 255),   -- Wachstum

	-- Ausgegrauter Button (siehe Theme.setEnabled)
	disabled   = Color3.fromRGB( 84,  80, 104),
}

Theme.FONT      = Enum.Font.FredokaOne
Theme.FONT_BODY = Enum.Font.GothamMedium

-- Dicke des Cartoon-Rands
Theme.OUTLINE_THICKNESS = 3
Theme.CORNER_RADIUS     = 14

function Theme.rarityColor(rarity: Types.Rarity): Color3
	return BaerchiConfig.getRarityColor(rarity)
end

-- Akzentfarbe eines Honig-Gebaeudes.
--
-- Die Zuordnung steht an EINER Stelle, genau wie bei rarityColor: das
-- Gebaeude-Panel faerbt damit seine Karten, die Baerchi-Detailkarte ihre
-- Fuetter-Knoepfe. Zwei getrennte Listen waeren die naechste Stelle, an der
-- Farbe und Gebaeude auseinanderlaufen.
--
-- Was die Farben BEDEUTEN, steht bei den Rollen in Config/BuildingBehavior:
-- Bienenstock = Vorrat, Honigtopf = Heilung, Honig-Presse = Wachstum.
local BUILDING_COLORS: { [string]: Color3 } = {
	Beehive    = Theme.COLORS.volume,
	HoneyRefiner = Theme.COLORS.growth,
	HoneyPond  = Theme.COLORS.goldGummy,   -- Honig-Teich / -Brunnen (HONEY_POND_V2)
}

-- HBB Paket 4: Farben der fuenf Rarity-Baender (Zuordnung in
-- Config/RarityBandConfig). Kraeftig und weit auseinander, damit ein Kind
-- sie ohne Text unterscheidet.
Theme.BAND_COLORS = {
	Color3.fromRGB(176, 190, 204),   -- 1 grau
	Color3.fromRGB( 46, 155, 255),   -- 2 blau
	Color3.fromRGB(255, 176,  32),   -- 3 gold
	Color3.fromRGB(168,  85, 247),   -- 4 lila
	Color3.fromRGB(255,  70, 110),   -- 5 rot-pink
}

function Theme.bandColor(rarity: string): Color3
	return Theme.BAND_COLORS[RarityBandConfig.bandOf(rarity)] or Theme.BAND_COLORS[1]
end

function Theme.buildingColor(buildingId: string): Color3
	return BUILDING_COLORS[buildingId] or Theme.COLORS.accent
end

--------------------------------------------------------------------------------
-- Bausteine
--------------------------------------------------------------------------------

function Theme.corner(parent: Instance, radius: number?): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or Theme.CORNER_RADIUS)
	corner.Parent = parent
	return corner
end

function Theme.stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color        = color or Theme.COLORS.outline
	stroke.Thickness    = thickness or Theme.OUTLINE_THICKNESS
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent       = parent
	return stroke
end

-- Hellere bzw. dunklere Variante einer Farbe. `amount` > 0 hellt auf, < 0
-- dunkelt ab, jeweils 0..1. Damit muss keine Farbvariante von Hand gepflegt
-- werden — jede Flaeche kann sich ihre Abstufung aus der Grundfarbe holen.
function Theme.shade(color: Color3, amount: number): Color3
	if amount >= 0 then
		return color:Lerp(Color3.new(1, 1, 1), math.clamp(amount, 0, 1))
	end
	return color:Lerp(Color3.new(0, 0, 0), math.clamp(-amount, 0, 1))
end

-- Farbverlauf ueber eine Flaeche.
--
-- Der kuerzeste Weg von "Platzhalter" zu "Spiel": eine flache Farbe sieht aus
-- wie ein unfertiges Rechteck, dieselbe Farbe mit einem Verlauf sieht aus wie
-- ein Knopf. Wird fuer die Kopfbalken und die grossen Knoepfe der
-- Gebaeude-Menues benutzt.
--
-- `rotation` in Grad: 90 = von oben nach unten (Standard).
function Theme.gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	-- Ein vorhandener Verlauf wird ueberschrieben statt gestapelt: zwei
	-- UIGradients multiplizieren sich und machen den Knopf dunkel. So kann
	-- Theme.button schon einen Grundverlauf setzen, und bigButton oder eine
	-- Kachel faerbt ihn nur um.
	local gradient = parent:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, top),
		ColorSequenceKeypoint.new(1, bottom),
	})
	gradient.Rotation = rotation or 90
	gradient.Parent   = parent
	return gradient
end

function Theme.padding(parent: Instance, px: number): UIPadding
	local padding = Instance.new("UIPadding")
	padding.PaddingTop    = UDim.new(0, px)
	padding.PaddingBottom = UDim.new(0, px)
	padding.PaddingLeft   = UDim.new(0, px)
	padding.PaddingRight  = UDim.new(0, px)
	padding.Parent        = parent
	return padding
end

function Theme.listLayout(parent: Instance, padding: number, horizontal: boolean?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.FillDirection       = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	layout.SortOrder           = Enum.SortOrder.LayoutOrder
	layout.Padding             = UDim.new(0, padding)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment   = Enum.VerticalAlignment.Top
	layout.Parent              = parent
	return layout
end

-- Durchsichtiger Container ohne Rand
function Theme.container(name: string, parent: Instance): Frame
	local frame = Instance.new("Frame")
	frame.Name                   = name
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel        = 0
	frame.Parent                 = parent
	return frame
end

-- Gefuellte Flaeche mit Rundung und Cartoon-Rand
function Theme.panel(name: string, parent: Instance, color: Color3?): Frame
	local frame = Instance.new("Frame")
	frame.Name            = name
	frame.BackgroundColor3 = color or Theme.COLORS.panel
	frame.BorderSizePixel = 0
	frame.Parent          = parent

	Theme.corner(frame)
	Theme.stroke(frame)
	-- Leichter Verlauf: eine flache Flaeche wirkt wie ein Platzhalter, mit
	-- hellerer Oberkante wie ein Spielelement.
	-- (Ein UIGradient MULTIPLIZIERT sich auf die Hintergrundfarbe: weiss =
	-- unveraendert, grau = dunkler. Deshalb neutrale Farben, nicht shade().)
	Theme.gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(196, 196, 208))
	return frame
end

-- Heller Glanzstreifen auf der oberen Haelfte eines Knopfes — der kleine
-- Kniff, der aus einem Rechteck einen "Cartoon-Knopf" macht. Faengt keine
-- Klicks ab (Frame, nicht aktiv).
function Theme.shine(parent: GuiObject, radius: number?): Frame
	local shine = Instance.new("Frame")
	shine.Name                   = "Shine"
	shine.AnchorPoint            = Vector2.new(0.5, 0)
	shine.Position               = UDim2.new(0.5, 0, 0, 3)
	shine.Size                   = UDim2.new(1, -10, 0.42, 0)
	shine.BackgroundColor3       = Color3.new(1, 1, 1)
	shine.BackgroundTransparency = 0.82
	shine.BorderSizePixel        = 0
	shine.Active                 = false
	shine.Parent                 = parent
	Theme.corner(shine, radius or 8)
	return shine
end

-- Weiches Anwachsen beim Drueberfahren, Eindruecken beim Druecken. Ein
-- UIScale statt Size, damit Layouts und Tweens an der Groesse unberuehrt bleiben.
local PRESS_TWEEN = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function Theme.pressable(button: GuiButton, hover: number?)
	local grow = hover or 1.06
	local scale = Instance.new("UIScale")
	scale.Name   = "PressScale"
	scale.Parent = button

	local function to(target: number)
		TweenService:Create(scale, PRESS_TWEEN, { Scale = target }):Play()
	end

	button.MouseEnter:Connect(function()
		if button.Active then to(grow) end
	end)
	button.MouseLeave:Connect(function()
		to(1)
	end)
	button.MouseButton1Down:Connect(function()
		if button.Active then to(0.93) end
	end)
	button.MouseButton1Up:Connect(function()
		if button.Active then to(grow) end
	end)
end

function Theme.label(name: string, parent: Instance, text: string?): TextLabel
	local label = Instance.new("TextLabel")
	label.Name                   = name
	label.BackgroundTransparency = 1
	label.Font                   = Theme.FONT
	label.Text                   = text or ""
	label.TextColor3             = Theme.COLORS.text
	label.TextScaled             = true
	label.TextXAlignment         = Enum.TextXAlignment.Left
	label.Parent                 = parent

	-- Verhindert absurd grosse Schrift auf hohen Frames
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 28
	constraint.MinTextSize = 8
	constraint.Parent      = label

	return label
end

-- Kleiner, mehrzeiliger Fliesstext (Beschreibungen, Effekt-Texte).
-- Bewusst mit fester TextSize statt TextScaled: umgebrochener Text
-- wird sonst je nach Zeilenzahl unterschiedlich gross.
function Theme.bodyText(name: string, parent: Instance, text: string?): TextLabel
	local label = Instance.new("TextLabel")
	label.Name                   = name
	label.BackgroundTransparency = 1
	label.Font                   = Theme.FONT_BODY
	label.Text                   = text or ""
	label.TextColor3             = Theme.COLORS.textDim
	label.TextScaled             = false
	label.TextSize               = 14
	label.TextWrapped            = true
	label.TextXAlignment         = Enum.TextXAlignment.Left
	label.TextYAlignment         = Enum.TextYAlignment.Top
	label.Parent                 = parent
	return label
end

function Theme.button(name: string, parent: Instance, text: string, color: Color3?): TextButton
	local button = Instance.new("TextButton")
	button.Name             = name
	button.BackgroundColor3  = color or Theme.COLORS.accent
	button.BorderSizePixel   = 0
	button.Font              = Theme.FONT
	button.Text              = text
	button.TextColor3        = Theme.COLORS.outline
	button.TextScaled        = true
	button.AutoButtonColor   = true
	button.Parent            = parent

	Theme.corner(button, 12)
	Theme.stroke(button)

	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 24
	constraint.MinTextSize = 8
	constraint.Parent      = button

	-- Cartoon-Look: Verlauf + Glanzstreifen + Hover/Druck-Animation.
	-- AutoButtonColor aus: der Standard-Abdunkler faerbt sonst den ganzen
	-- Verlauf grau; die Animation uebernimmt das Feedback.
	-- Neutraler Verlauf (multipliziert sich auf die Knopffarbe, siehe panel).
	Theme.gradient(button, Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 190, 200))
	Theme.shine(button, 9)
	button.AutoButtonColor = false
	Theme.pressable(button)

	return button
end

-- Button ausgrauen bzw. wieder freigeben.
--
-- Das ist reiner Komfort: der Server prueft jede Anfrage selbst und schickt
-- bei Ablehnung ein ActionFailed (→ Toast). Ein ausgegrauter Button ist nur
-- die freundliche Vorwarnung, nie die Absicherung.
--
-- Die urspruengliche Farbe wird beim ersten Ausgrauen als Attribut gemerkt,
-- damit der Aufrufer sie nicht selbst mitschleppen muss.
-- Grosser, bunter Aktionsknopf mit Verlauf — der Knopf, um den herum ein
-- Menue gebaut wird ("AUSBAUEN", "FUETTERN"). Bewusst deutlich hoeher und
-- kraeftiger als Theme.button: in einem Menue soll auf einen Blick klar sein,
-- was der Hauptzweck ist.
function Theme.bigButton(name: string, parent: Instance, text: string, color: Color3): TextButton
	local button = Theme.button(name, parent, text, color)
	Theme.gradient(button, Theme.shade(color, 0.28), Theme.shade(color, -0.12))
	return button
end

-- Dunkler Umriss um die Schrift — der Look, den Roblox-Spiele fuer Beschriftungen
-- ueber bunten Flaechen benutzen. Ohne ihn verschwindet weisser Text auf gelben
-- Kacheln, und mit ihm wirkt jede Beschriftung wie aufgeklebt statt wie
-- hineingerechnet.
function Theme.outlineText(label: TextLabel, thickness: number?): TextLabel
	label.TextStrokeColor3       = Theme.COLORS.outline
	label.TextStrokeTransparency = 0
	label.RichText               = false

	local stroke = Instance.new("UIStroke")
	stroke.Color         = Theme.COLORS.outline
	stroke.Thickness     = thickness or 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent        = label

	return label
end

-- Kleine Grossbuchstaben-Ueberschrift ueber einem Abschnitt einer Karte.
function Theme.sectionLabel(name: string, parent: Instance, text: string, color: Color3?): TextLabel
	local label = Theme.label(name, parent, string.upper(text))
	label.TextColor3 = color or Theme.COLORS.textDim
	label.TextScaled = false
	label.TextSize   = 13
	label.Font       = Theme.FONT
	return label
end

function Theme.setEnabled(button: TextButton, enabled: boolean)
	local stored = button:GetAttribute("EnabledColor")
	if typeof(stored) ~= "Color3" then
		stored = button.BackgroundColor3
		button:SetAttribute("EnabledColor", stored)
	end

	button.Active          = enabled
	local shine = button:FindFirstChild("Shine")
	if shine and shine:IsA("GuiObject") then
		shine.Visible = enabled
	end
	button.BackgroundColor3 = if enabled then (stored :: Color3) else Theme.COLORS.disabled
	button.TextTransparency = if enabled then 0 else 0.4

	-- Ein Verlauf (Theme.bigButton) multipliziert sich auf die Hintergrundfarbe
	-- und wuerde den ausgegrauten Knopf weiter bunt aussehen lassen. Deshalb
	-- geht er beim Ausgrauen mit aus.
	local gradient = button:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Enabled = enabled
	end
end

-- Scrollbare Liste. Der Aufrufer haengt ein Theme.listLayout hinein und
-- setzt seine Zeilen auf UDim2.new(1, -8, 0, hoehe) — die -8 lassen Platz
-- fuer den Scrollbalken, sonst ragt jede Zeile darunter.
function Theme.scroller(name: string, parent: Instance): ScrollingFrame
	local scroller = Instance.new("ScrollingFrame")
	scroller.Name                   = name
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel        = 0
	scroller.ScrollBarThickness     = 6
	scroller.ScrollBarImageColor3   = Theme.COLORS.panelLight
	scroller.CanvasSize             = UDim2.new()
	scroller.AutomaticCanvasSize    = Enum.AutomaticSize.Y
	scroller.ScrollingDirection     = Enum.ScrollingDirection.Y
	scroller.Parent                 = parent
	return scroller
end

export type Progress = {
	track : Frame,
	fill  : Frame,
	text  : TextLabel,
}

-- Fortschrittsbalken mit Text darueber (Brut-Timer, XP, Kampf-HP).
function Theme.progress(parent: Instance, fillColor: Color3?): Progress
	local track = Theme.panel("Track", parent, Theme.COLORS.panelDeep)
	track.ClipsDescendants = true   -- damit der Fuellbalken die Rundung nicht ueberragt

	local fill = Instance.new("Frame")
	fill.Name             = "Fill"
	fill.Size             = UDim2.fromScale(0, 1)
	fill.BackgroundColor3  = fillColor or Theme.COLORS.accent
	fill.BorderSizePixel   = 0
	fill.Parent            = track
	Theme.corner(fill, 12)
	Theme.gradient(fill, Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 170, 185))
	Theme.shine(fill, 6).Size = UDim2.new(1, -8, 0.4, 0)

	local text = Theme.label("Text", track, "")
	text.Size           = UDim2.fromScale(1, 1)
	text.TextXAlignment = Enum.TextXAlignment.Center
	text.ZIndex         = 3
	Theme.outlineText(text, 2)

	return { track = track, fill = fill, text = text }
end

--------------------------------------------------------------------------------
-- Dialoge
--------------------------------------------------------------------------------

-- Ein Dialog laesst mindestens so viel vom Bildschirm frei (Anteil, je Achse).
local DIALOG_SCREEN_FILL = 0.94

-- Name des UIScale, mit dem ein Dialog auf kleine Bildschirme passt (siehe
-- Theme.dialog und Theme.dialogScale).
local FIT_SCALE_NAME = "FitScale"

-- Schliessen-Knopf (Sammel-Update 2.1: 44x40) plus eine unsichtbare
-- Trefferflaeche 56x56 darum — auf dem Handy trifft ein Daumen sonst leicht
-- daneben (Richtwert 44 pt).
local CLOSE_HIT = 56

-- Zentriertes Panel, standardmaessig unsichtbar. Groesse in Scale, damit es
-- auf Handy und Monitor passt; die Constraints halten es lesbar.
--
-- UI-Qualitaet Schritt 2: die Mindestgroesse (minSize) war auf kleinen
-- Bildschirmen groesser als der Bildschirm selbst — ein Handy quer hat ohne
-- Topbar rund 350 px Hoehe, Charms/Bestenliste/Kampf brauchen 420. Kopfzeile
-- und Schliessen-X lagen dann ausserhalb. Jetzt verkleinert ein UIScale
-- (FitScale) den GANZEN Dialog gleichmaessig, bis er passt: das Layout bleibt
-- wie gebaut, nur kleiner. Auf normalen Bildschirmen ist der Faktor 1.
function Theme.dialog(name: string, parent: Instance, scale: Vector2, minSize: Vector2, maxSize: Vector2): Frame
	local root = Theme.panel(name, parent, Theme.COLORS.panelDeep)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position    = UDim2.fromScale(0.5, 0.5)
	root.Size        = UDim2.fromScale(scale.X, scale.Y)
	root.Visible     = false
	root.ZIndex      = 10

	local constraint = Instance.new("UISizeConstraint")
	constraint.MinSize = minSize
	constraint.MaxSize = maxSize
	constraint.Parent  = root

	local fit = Instance.new("UIScale")
	fit.Name   = FIT_SCALE_NAME
	fit.Parent = root

	if parent:IsA("LayerCollector") then
		local screen = parent :: LayerCollector
		local function refit()
			-- AbsoluteSize sind echte Pixel; die globale UiScale (>= 1) rechnet
			-- sie in Oberflaechen-Einheiten um, in denen minSize gemeint ist.
			local global = screen:FindFirstChild("GlobalScale")
			local globalScale = if global and global:IsA("UIScale") then math.max(global.Scale, 0.01) else 1
			local room = screen.AbsoluteSize / globalScale * DIALOG_SCREEN_FILL
			if room.X <= 0 or room.Y <= 0 then return end
			fit.Scale = math.min(1, room.X / minSize.X, room.Y / minSize.Y)
		end
		screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
		-- Die globale UiScale kann nach dem Dialog angelegt werden (Main) und
		-- aendert sich mit der Fenstergroesse.
		screen.ChildAdded:Connect(function(child)
			if child.Name == "GlobalScale" and child:IsA("UIScale") then
				child:GetPropertyChangedSignal("Scale"):Connect(refit)
				refit()
			end
		end)
		local global = screen:FindFirstChild("GlobalScale")
		if global and global:IsA("UIScale") then
			global:GetPropertyChangedSignal("Scale"):Connect(refit)
		end
		refit()
	end

	return root
end

-- Gesamter Verkleinerungsfaktor der Dialoge, in denen `gui` steckt (1 = keiner).
-- Fuer Code, der AbsolutePosition/AbsoluteSize in eine Position INNERHALB eines
-- Dialogs zurueckrechnet (IndexView): erst UiScale.toGui, dann durch diesen Wert.
function Theme.dialogScale(gui: Instance): number
	local factor = 1
	local node: Instance? = gui
	while node do
		local fit = node:FindFirstChild(FIT_SCALE_NAME)
		if fit and fit:IsA("UIScale") then
			factor *= fit.Scale
		end
		node = node.Parent
	end
	return factor
end

-- Sammel-Update 2.1: der eine Schliessen-Knopf fuer alle Fenster (oben
-- rechts, gross genug zum Tippen). Fenster ohne dialogHeader (Baerchi-Karte)
-- setzen ihn direkt. `color` optional (Gebaeude-Menue: Ton seiner Farbe).
-- UI-Qualitaet: dazu eine unsichtbare Trefferflaeche (CLOSE_HIT) als Kind —
-- sie liegt ueber dem Knopf (ZIndexBehavior.Sibling) und nimmt jeden Klick in
-- ihrem Bereich an, auch knapp neben dem sichtbaren X.
function Theme.closeButton(parent: Instance, onClose: () -> (), color: Color3?): TextButton
	local close = Theme.button("Close", parent, "X", color or Theme.COLORS.bad)
	close.AnchorPoint = Vector2.new(1, 0.5)
	close.Position    = UDim2.new(1, 4, 0.5, 0)
	close.Size        = UDim2.new(0, 44, 0, 40)
	close.TextColor3  = Theme.COLORS.text
	close.ZIndex      = math.max(close.ZIndex, 12)
	close.Activated:Connect(onClose)

	local hit = Instance.new("TextButton")
	hit.Name                   = "CloseHit"
	hit.AnchorPoint            = Vector2.new(0.5, 0.5)
	hit.Position               = UDim2.fromScale(0.5, 0.5)
	hit.Size                   = UDim2.fromOffset(CLOSE_HIT, CLOSE_HIT)
	hit.BackgroundTransparency = 1
	hit.Text                   = ""
	hit.AutoButtonColor        = false
	hit.ZIndex                 = close.ZIndex
	hit.Parent                 = close
	hit.Activated:Connect(onClose)

	return close
end

-- Kopfzeile eines Dialogs: Titel links, Schliessen-Kreuz rechts.
-- Gibt das Titel-Label zurueck, damit der Aufrufer es spaeter aendern kann.
function Theme.dialogHeader(root: Frame, title: string, onClose: () -> ()): TextLabel
	-- Farbiger Titelbalken hinter der Kopfzeile (zuerst gebaut, liegt darum
	-- unter Titel und Kreuz).
	local band = Instance.new("Frame")
	band.Name             = "TitleBand"
	band.Position         = UDim2.new(0, 6, 0, 5)
	band.Size             = UDim2.new(1, -12, 0, 42)
	band.BackgroundColor3 = Color3.fromRGB(122, 104, 204)
	band.BorderSizePixel  = 0
	band.Parent           = root
	Theme.corner(band, 12)
	Theme.stroke(band, Theme.COLORS.outline, 2)
	Theme.gradient(band, Color3.fromRGB(255, 255, 255), Color3.fromRGB(176, 170, 215))
	Theme.shine(band, 8).Size = UDim2.new(1, -12, 0.36, 0)

	local header = Theme.container("Header", root)
	header.Position = UDim2.new(0, 14, 0, 11)
	header.Size     = UDim2.new(1, -28, 0, 30)

	local label = Theme.label("Title", header, title)
	label.Size = UDim2.new(1, -52, 1, 0)
	Theme.outlineText(label, 2)

	-- Sammel-Update 2.1: groesserer X-Knopf (Tippflaeche ~44 px, Apple/
	-- Google-Empfehlung) — er ragt bewusst etwas ueber die Kopfzeile hinaus.
	Theme.closeButton(header, onClose)

	return label
end

-- Inhaltsflaeche unter der Kopfzeile.
function Theme.dialogBody(root: Frame): Frame
	local body = Theme.container("Body", root)
	body.Position = UDim2.new(0, 14, 0, 48)
	body.Size     = UDim2.new(1, -28, 1, -62)
	return body
end

--------------------------------------------------------------------------------
-- Formatierung
--------------------------------------------------------------------------------

-- Grosse Zahlen lesbar machen: 1234567 → "1.234.567" (de/es), "1,234,567" (en),
-- "1 234 567" (fr). Das Trennzeichen kommt aus der Sprache des Spielers — die
-- Logik steht in Loc, damit Server-Texte und UI dieselbe Formatierung teilen.
-- Bleibt als Theme-Funktion bestehen, damit kein UI-Modul umgeschrieben werden
-- muss, das schon formatNumber benutzt.
function Theme.formatNumber(value: number): string
	return Loc.formatNumber(value)
end

-- Restzeiten: "45s", "2m 05s", "1h 12m" (Einheiten je nach Sprache)
function Theme.formatDuration(seconds: number): string
	return Loc.formatDuration(seconds)
end

return Theme
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX57"><Properties><string name="Name">TouchSafeArea</string><ProtectedString name="Source"><![CDATA[--!strict
-- TouchSafeArea.luau
-- StarterPlayerScripts/UI/TouchSafeArea.luau
--
-- Einzige Zustaendigkeit:
--   - Auf Touch-Geraeten wissen, wo die Roblox-Steuerung liegt, und den
--     freien Streifen unten dazwischen liefern.
--
-- Warum (Playtest 07.10., Handy): die Pet-Leiste (Event/Fight) lag unten
-- mittig und war 434 breit — auf einem Handy quer (~844 breit) reichte der
-- Event-Knopf in die Zone des Bewegungs-Sticks. Wer laufen wollte, tippte auf
-- "Event". Der Heim-Knopf lag sogar ganz in dieser Zone (unten links).
--
-- Die Zonen sind die der Standard-Steuerung (PlayerModule, nicht von uns
-- gebaut, deshalb hier als Konstanten nachgebildet):
--   * Bewegungs-Stick (DynamicThumbstick): reagiert in den linken 40 % der
--     Breite, unteres Zwei-Drittel der Hoehe.
--   * Sprung-Knopf: unten rechts. Kleine Bildschirme (kuerzere Seite <= 500 px)
--     70 px gross, 25 px vom Rand; sonst 120 px, 50 px vom Rand.
-- Wir halten links und rechts davon Abstand und legen unsere Knoepfe in den
-- Streifen dazwischen.
--
-- Am PC/Konsole (kein Touch) ist der ganze untere Rand frei — dann liefert
-- `zone` nil und die Aufrufer behalten ihr bisheriges Layout.

local UserInputService = game:GetService("UserInputService")

local UiScale = require(script.Parent.UiScale)

local TouchSafeArea = {}

-- Anteil der Breite, auf den der Bewegungs-Stick reagiert, plus Luft
local THUMBSTICK_WIDTH = 0.40
local THUMBSTICK_GAP   = 16

-- Sprung-Knopf (Pixel) je nach Bildschirmgroesse, plus Luft daneben
local JUMP_SMALL = { size = 70,  margin = 25, below = 500 }
local JUMP_LARGE = { size = 120, margin = 50 }
local JUMP_GAP   = 16

export type Zone = {
	left  : number,   -- linke Kante des freien Streifens (Oberflaechen-Einheiten)
	right : number,   -- rechte Kante
	width : number,
	center: number,   -- Mitte, als Offset von der linken Bildschirmkante
}

-- Touch-Steuerung aktiv? Tablets mit Tastatur benutzen sie nicht.
function TouchSafeArea.isTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- Freier Streifen unten zwischen Bewegungs-Stick und Sprung-Knopf, oder nil
-- ohne Touch-Steuerung.
function TouchSafeArea.zone(screenGui: ScreenGui): Zone?
	if not TouchSafeArea.isTouch() then
		return nil
	end

	local pixels = screenGui.AbsoluteSize
	local shortSide = math.min(pixels.X, pixels.Y)
	local jump = if shortSide <= JUMP_SMALL.below then JUMP_SMALL else JUMP_LARGE

	local width = UiScale.toGui(pixels.X)
	local left  = width * THUMBSTICK_WIDTH + THUMBSTICK_GAP
	local right = width - UiScale.toGui(jump.size + jump.margin) - JUMP_GAP
	if right <= left then
		return nil
	end
	return { left = left, right = right, width = right - left, center = (left + right) / 2 }
end

-- Wie viel Hoehe rechts unten frei bleiben muss (Oberflaechen-Einheiten):
-- mit Touch-Steuerung der Sprung-Knopf samt Rand und Luft, sonst `fallback`.
-- Fuer alles, was am rechten Rand nach unten waechst (MenuBar).
function TouchSafeArea.rightBottomReserve(screenGui: ScreenGui, fallback: number): number
	if not TouchSafeArea.isTouch() then
		return fallback
	end
	local pixels = screenGui.AbsoluteSize
	local jump = if math.min(pixels.X, pixels.Y) <= JUMP_SMALL.below then JUMP_SMALL else JUMP_LARGE
	return math.max(fallback, UiScale.toGui(jump.size + jump.margin) + JUMP_GAP)
end

-- Ruft `callback` jetzt und bei jeder Groessen- oder Eingabeart-Aenderung.
function TouchSafeArea.watch(screenGui: ScreenGui, callback: () -> ())
	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(callback)
	UserInputService:GetPropertyChangedSignal("KeyboardEnabled"):Connect(callback)
	UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(callback)
	callback()
end

return TouchSafeArea
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
