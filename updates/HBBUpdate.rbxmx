--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

local function getById(id: string): EventDef?
	for _, def in EVENTS do
		if def.id == id then
			return def
		end
	end
	return nil
end

-- Laeuft dieses Event im Durchlauf `cycle` (ab 1 gezaehlt)?
local function isScheduledInCycle(def: EventDef, cycle: number): boolean
	local n = def.everyNthCycle
	if not n or n <= 1 then return true end
	return cycle % n == 0
end

local function getDuration(def: EventDef): number
	return def.durationSeconds or EVENT_DURATION_SECONDS
end

-- HBB Paket 6: Sekunden, bis Event `targetId` das naechste Mal STARTET
-- (0 = laeuft gerade). Rein, nach demselben Ablauf wie EventService:
-- Event -> Pause (EVENT_GAP_SECONDS) -> naechstes geplantes Event.
--   activeId  laufendes Event oder nil (Pause)
--   remaining Restsekunden der aktuellen Phase
--   nextIndex/nextCycle  Stand von EventService (_nextIndex, _nextCycle)
-- nil, wenn das Event im Zyklus nie vorkommt.
local function secondsUntilStart(targetId: string, activeId: string?, remaining: number,
	nextIndex: number, nextCycle: number): number?
	if activeId == targetId then return 0 end
	local t = math.max(0, remaining)
	if activeId then
		t += EVENT_GAP_SECONDS   -- erst endet das laufende Event, dann Pause
	end

	local index, cycle = nextIndex, nextCycle
	local count = #EVENTS
	for _ = 1, count * 8 do
		local def = EVENTS[index]
		if isScheduledInCycle(def, cycle) then
			if def.id == targetId then return t end
			t += getDuration(def) + EVENT_GAP_SECONDS
		end
		index += 1
		if index > count then
			index = 1
			cycle += 1
		end
	end
	return nil
end

local function getRarityUpChance(rarity: string): number
	return RARITY_UP_CHANCE[rarity] or 0
end

local function getMutationFactor(rarity: string): number
	return MUTATION_RARITY_FACTOR[rarity] or 1
end

-- Liefert eine Nachricht (LocMsg) statt eines fertigen Satzes: die Tafel
-- baut der Server, lesen tut sie jeder Spieler in seiner Sprache. Der Client
-- loest sie mit Loc.resolve auf, Log-Ausgaben ebenso (dann in Serversprache).
local function describeBonus(bonus: EventBonus?): Types.LocMsg?
	if not bonus then
		return nil
	end

	local amount = bonus.amount or 0

	if bonus.kind == "honey" then
		return Loc.msg("event.bonus.honey", { n = amount })

	elseif bonus.kind == "eggs" then
		if bonus.eggPick == "jump" then
			return Loc.msg("event.bonus.jump", { n = amount })
		elseif bonus.eggPick == "highest" then
			return Loc.msg("event.bonus.highest", { n = amount })
		end
		local eggType = bonus.eggType or "BasicEgg"
		return Loc.msg("event.bonus.eggs", { n = amount, egg = Loc.msg("egg." .. eggType .. ".name") })

	elseif bonus.kind == "gummies" then
		return Loc.msg("event.bonus.gummies", { n = amount })

	elseif bonus.kind == "goldGummies" then
		return Loc.msg("event.bonus.gold", { n = amount })

	elseif bonus.kind == "mutation" then
		return Loc.msg("event.bonus.mutation", { pct = math.floor((bonus.chance or 0) * 100 + 0.5) })
	end

	return nil
end

-- Die vollstaendige Belohnung in einer Zeile, fuer Tafel und UI.
local function describeReward(def: EventDef): Types.LocMsg
	if def.rewardText then
		return Loc.msg("event." .. def.id .. ".reward")
	end

	local bonusPart = describeBonus(def.bonus)
	if bonusPart then
		return bonusPart
	end

	return Loc.msg("event.bonus.unknown")
end

--------------------------------------------------------------------------------
-- Sammel-Update 05.10. (Paket 5.2): KAMPF UM DIE MITTE
--------------------------------------------------------------------------------
-- Waehrend eines Events stossen die Event-Baerchis Spieler, die KEIN eigenes
-- Baerchi im Event haben und ihnen im Pit zu nahe kommen (Rueckstoss + kurze
-- Verlangsamung + kurze Waben-Pause). Die Baerchis kaempfen zuerst
-- untereinander (Handler); greifen tun sie nur, wenn sie gerade frei sind.
-- Annahmen (Abschnitt 11.10, Standard): kein Angriff auf Spieler mit eigenem
-- Baerchi im Pit, kein Festhalten (Abklingzeit je Spieler), nur im Pit-Radius.
local PIT_BRAWL = {
	TICK_SECONDS        = 0.5,
	REACH               = 9,      -- Studs: so nah muss der Spieler am Baerchi sein
	PLAYER_COOLDOWN     = 4,      -- Sekunden: so oft wird ein Spieler hoechstens gestossen
	BAERCHI_COOLDOWN    = 2.5,    -- Sekunden: so oft greift ein Baerchi hoechstens an
	KNOCKBACK_SPEED     = 55,
	SLOW_FACTOR         = 0.7,
	SLOW_SECONDS        = 1.5,
	PICKUP_PAUSE_SECONDS = 1.5,
	LUNGE_DISTANCE      = 2.5,
	LUNGE_SECONDS       = 0.3,
}

return {
	EMERGENCY_BASIC_EGG_CHANCE = EMERGENCY_BASIC_EGG_CHANCE,
	EVENT_DURATION_SECONDS = EVENT_DURATION_SECONDS,
	EVENT_GAP_SECONDS      = EVENT_GAP_SECONDS,
	FIRST_GAP_SECONDS      = FIRST_GAP_SECONDS,
	BOSS_TIERS             = BOSS_TIERS,
	EVENTS                 = EVENTS,

	UFO                    = UFO,
	DUEL                   = DUEL,
	RARITY_UP_CHANCE       = RARITY_UP_CHANCE,
	MUTATION_RARITY_FACTOR = MUTATION_RARITY_FACTOR,
	STORM                  = STORM,
	HOT_EGG                = HOT_EGG,
	KING                   = KING,
	TREASURE               = TREASURE,
	WASP_QUEEN             = WASP_QUEEN,

	getById           = getById,
	getDuration       = getDuration,
	isScheduledInCycle = isScheduledInCycle,
	secondsUntilStart  = secondsUntilStart,
	getRarityUpChance = getRarityUpChance,
	getMutationFactor = getMutationFactor,
	describeBonus     = describeBonus,
	describeReward    = describeReward,
	PIT_BRAWL         = PIT_BRAWL,   -- Sammel-Update 5.2
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">FeatureFlags</string><ProtectedString name="Source"><![CDATA[--!strict
-- FeatureFlags.luau
-- ReplicatedStorage/Config/FeatureFlags.luau
--
-- Einzige Zustaendigkeit:
--   - Schalter fuer jede sichtbare Aenderung aus dem Honey-Bear-Brawl-Plan
--
-- Jede neue Anzeige haengt an genau einem Schalter. `true` = neuer Weg,
-- `false` = das Spiel verhaelt sich wie vor dem jeweiligen Paket. So bleibt
-- jede Aenderung einzeln zuruecknehmbar, ohne Code anzufassen.
--
-- Liegt in ReplicatedStorage, weil Server UND Client dieselbe Antwort brauchen
-- (z.B. Boss-Stufen: Server zahlt aus, Client zeigt die Truhe).
--
-- Ein unbekannter Name ist ein Tippfehler. In Studio bricht isOn dann mit
-- einem Fehler ab, damit er sofort auffaellt; im Live-Spiel gilt der Schalter
-- still als aus, damit ein Tippfehler keinen Server abstuerzen laesst.

local RunService = game:GetService("RunService")

local FLAGS: { [string]: boolean } = {
	-- Paket 1: Icons und Zahlen statt Text-Toasts
	UI_V2_FEEDBACK    = true,
	-- Paket 2: Beam-Fuehrung, Quest-Tracker mit Icons, ruhige Dialoge
	UI_V2_GUIDE       = true,
	-- Paket 3: Elemente erscheinen erst, wenn man sie braucht
	UI_V2_PROGRESSIVE = true,
	-- Paket 4: Upgrade-Tab, Kampfwert-Zahl, Rarity-Baender
	UI_V2_UPGRADE_TAB = true,

	-- Paket 5: Map ohne Umbau
	MAP_V2_MERCHANT   = true,
	MAP_V2_HOME       = true,
	MAP_V2_SHOWCASE   = true,
	MAP_V2_BOARDS     = true,
	MAP_V2_ARENA_SPRINT = true,   -- Baerchi sprintet zur Arena und zurueck
	-- Paket 6
	MAP_V2_LIVE_BOARD = true,
	MAP_V2_WASP_NEST  = true,
	EVENT_V2_TIMER    = true,

	-- Honig-Teich statt Stock + Veredler: EIN Gebaeude, Looks bis zum
	-- Honig-Springbrunnen, Baerchi wohnt am Becken (kein Hin- und Herlaufen).
	-- Bericht: docs/HBB_HONIG_TEICH_2026-10-05.md
	HONEY_POND_V2      = true,

	-- Entscheidung 05.10.: Laeufe starten immer bei Stage 1. Ab der letzten
	-- Stage nur per Klick gegen Gummies (kleines Feld, 7 s, UI/FightStartPrompt).
	FIGHT_RESUME_PROMPT = true,

	-- HBB Paket 10: Shop mit Gratis-Griff (GoldGummies) und Robux-Paketen
	-- (Pakete erst sichtbar, wenn ShopConfig eine Product-ID hat).
	-- Bericht: docs/HBB_PAKET_10_SHOP_2026-10-05.md
	SHOP_V1            = true,

	-- Playtest 05.10.: Basis-Eier (unbegrenzt beim Haendler) nicht pressbar
	PRESS_NO_BASIC_EGG = true,

	-- Paket 7: Boss-Belohnung nach Stufen
	BOSS_TIERS        = true,

	-- GoldGummies nur noch aus Tages-Quests (spaeter: Gratis-Griff im Shop)
	-- und nur noch fuer Charms. Keine Gold-Kosten bei Gebaeuden/Recycler, kein
	-- Gold aus Tower-Laeufen, Meilensteinen oder Login-Bonus.
	-- Bericht: docs/HBB_GOLD_NUR_CHARMS_2026-10-05.md
	GOLD_CHARMS_ONLY  = true,

	-- Paket 8/9: neue Pacing-Werte. Bleibt aus, bis der Mensch die Tabelle
	-- freigegeben hat (Stopp-Punkt im Plan).
	PACING_V2         = false,
	-- Paket 9: Endless-Tower (Stage 101+), freigegeben 05.10.
	-- Bericht: docs/HBB_PAKET_9_ENDLESS_2026-10-05.md
	ENDLESS           = true,

	-- Sammel-Update 05.10. (docs/SAMMEL_UPDATE_UMGESETZT_2026-10-05.md):
	-- Paket 8: Inkubator auf dem Plot. Aus = Eier gehen wie vorher sofort auf,
	-- der Inkubator wird weder gebaut noch angeboten.
	INCUBATOR         = true,
	-- Paket 7: Index-Belohnungen (Abholen im Index).
	INDEX_REWARDS     = true,
	-- Paket 5.2: Kampf um die Mitte — gegnerische Event-Baerchis stossen
	-- Spieler ohne eigenen Baerchi im Event-Pit.
	PIT_BRAWL         = true,
	-- Paket 3.8: Bereichs-Schilder (zwei Woerter) auf der Hauptinsel.
	AREA_SIGNS        = true,
	-- Wunsch 05.10.: Baerchi darf mehrmals ins selbe UFO; nach dem Absetzen
	-- ist sein Level fuer EventConfig.UFO.DROP_WEAKEN_SECONDS halbiert.
	-- Aus = wie vorher (wer schon an Bord war, geht heim).
	UFO_REJOIN        = true,
	-- Wunsch 05.10.: aufgeraeumtes HUD. Honig-Brunnen nur vor Ort verbessern
	-- (E, kein Fenster, Schild mit Level und Preis), keine Kacheln "Verbessern"
	-- und "Inkubator" mehr, Quests als kleiner Knopf neben dem Zahnrad, Shop
	-- daneben (eine Zeile), groessere Kacheln rechts.
	HUD_ROW_V2        = true,
	-- Wunsch 05.10.: Inkubator = Baerchi hineinsetzen, er bruetet je nach
	-- Rarity im Takt zusaetzliche Eier (IncubatorConfig.BREED_*). Eier gehen
	-- wieder sofort auf (kein Brueten von Eiern mehr). Aus = Ei-Inkubator wie
	-- im Sammel-Update.
	INCUBATOR_BREED   = true,

	-- 08.10. (Tower-Terminal): Tower N+1 oeffnet, sobald Tower N geschafft ist
	-- (Rekord >= Stage-Zahl), statt ueber Rebirths. Der Deckel pro Rebirth
	-- begrenzt dann nichts mehr. Aus = alte Regel (STAGE_CAP_BY_REBIRTH).
	TOWER_UNLOCK_BY_CLEAR = true,
	-- 08.10.: Tower-Terminal an der Bruecke (Paket B2)
	TOWER_TERMINAL    = true,
	-- 08.10.: neues Tower-Panel im Look Theme.v2 (Paket D); aus = altes CombatPanel
	TOWER_PANEL_V2    = true,
}

local FeatureFlags = {}

FeatureFlags.FLAGS = FLAGS

function FeatureFlags.isOn(name: string): boolean
	local value = FLAGS[name]
	if value == nil then
		if RunService:IsStudio() then
			error("[FeatureFlags] Unbekannter Schalter: " .. tostring(name), 2)
		end
		return false
	end
	return value
end

return FeatureFlags
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">FeedbackConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- FeedbackConfig.luau
-- ReplicatedStorage/Config/FeedbackConfig.luau
--
-- Einzige Zustaendigkeit:
--   - Zuordnung "Meldungs-Anlass → Darstellungs-Klasse" (HBB Paket 1)
--
-- Daten statt Code: wer einen Anlass anders zeigen will, aendert hier eine
-- Zeile, ohne Logik anzufassen. Jede Stelle im Client, die frueher einen
-- Toast ausloeste, meldet sich jetzt ueber UI/Notify mit einem Schluessel
-- aus dieser Tabelle. tools/check_feedback.py schlaegt fehl, wenn ein
-- benutzter Schluessel hier fehlt.
--
-- Klassen:
--   ICON   Zahl/Belohnung: fliegendes Icon und Zahl (UI/Feedback)
--   MOMENT selten und wichtig: grosses Icon in der Mitte (UI/Moment)
--   TOAST  Fehler und Hinweise, die man lesen muss: bleibt Text
--   NONE   sieht man ohnehin (Panel, Balken, Figur): entfaellt
--
-- Mit FeatureFlags.UI_V2_FEEDBACK = false wird jeder Anlass wieder als
-- Toast gezeigt, genau wie vorher.

export type Class = "ICON" | "MOMENT" | "TOAST" | "NONE"

local CLASSES: { [string]: Class } = {
	-- Fehler und Hinweise
	action_failed      = "TOAST",   -- ActionFailed vom Server (Toast.init)
	hatch_failed       = "TOAST",   -- Server antwortet nicht beim Oeffnen (HatchAnimation)
	event_notice_info  = "TOAST",   -- Event-Hinweis zum Mitmachen ("Gib das heisse Ei weiter")
	event_notice_big   = "TOAST",   -- Ansage an alle: Boss kommt/besiegt, Jackpot eines anderen
	event_mid          = "TOAST",   -- Zwischenmeldung waehrend eines Events (Server-Text)

	-- Seltene Momente
	event_mid_rarity   = "MOMENT",  -- UFO: Rarity-Aufstieg
	event_end_mutation = "MOMENT",  -- Event-Ende mit neuer Mutation
	tree_unlocked      = "MOMENT",  -- Ei-Baum: neues Ei frei
	tower_record       = "MOMENT",  -- neuer Tower-Rekord
	tower_milestone    = "MOMENT",  -- Tower-Meilenstein (alle 5 Stages)
	promotion_slot     = "MOMENT",  -- Befoerderung schaltet Charm-Slot frei
	rebirth_done       = "MOMENT",

	-- Zahlen und Belohnungen
	recycle_result     = "ICON",
	offline_honey      = "ICON",    -- Rueckkehr-Anzeige
	offline_eggs       = "ICON",    -- Rueckkehr-Anzeige
	level_up           = "ICON",    -- "Lv 5" ueber dem Baerchi
	feed               = "ICON",    -- XP-Zahl ueber dem Baerchi
	egg_pressed        = "ICON",
	-- Sammel-Update 05.10.
	index_reward       = "MOMENT",  -- Paket 7: Index-Belohnung abgeholt
	special_milestone  = "MOMENT",  -- Paket 6.2: Ascensions-Ei aus besonderem Meilenstein
	incubator          = "ICON",    -- Paket 8: Ei in den Inkubator gelegt / beschleunigt
	comb_delivered     = "ICON",
	recycler_upgraded  = "ICON",
	tower_unlocked     = "MOMENT",  -- 08.10.: neuer Tower frei (Tower-Terminal)
	terminal_locked    = "TOAST",   -- 08.10.: Terminal noch gesperrt (Hinweis statt Panel)
	tower_result       = "ICON",
	promotion          = "ICON",
	egg_collected      = "ICON",
	egg_bought         = "ICON",
	egg_collected_all  = "ICON",
	event_end          = "ICON",    -- Stat-Stufe +1 ueber dem Baerchi
	daily_claimed      = "ICON",
	quest_reward       = "ICON",
	event_notice_good  = "ICON",    -- Event-Belohnung (Gummies/Waben/Fund); Rarity-Aufstieg als Moment

	-- Sieht man ohnehin
	boss_hit           = "NONE",    -- Rueckstoss + Verlangsamung sind deutlich genug
	charm_roll         = "NONE",    -- das Charm-Panel zeigt das Ergebnis
	fusion_result      = "NONE",    -- das Fusions-Panel zeigt das Ergebnis
}

local FeedbackConfig = {}

FeedbackConfig.CLASSES = CLASSES

-- Fliegende Icons
FeedbackConfig.MERGE_WINDOW   = 0.4   -- gleiche Gewinne in diesem Fenster → eine Zahl
FeedbackConfig.MAX_ICONS      = 6     -- gleichzeitig fliegende Icons
FeedbackConfig.FLY_SECONDS    = 0.65
FeedbackConfig.NUMBER_SECONDS = 0.9   -- Aufsteigen der Zahl "+25"
FeedbackConfig.FLOAT_SECONDS  = 1.1   -- Zahl ueber dem Baerchi
FeedbackConfig.MAX_FLOATS     = 4

-- Grosser Moment
FeedbackConfig.MOMENT_SECONDS = 1.6
FeedbackConfig.MOMENT_QUEUE   = 3     -- mehr wartet nie (aeltere fallen weg)
FeedbackConfig.MOMENT_SOUND   = "rbxasset://sounds/electronicpingshort.wav"
FeedbackConfig.MOMENT_VOLUME  = 0.4

-- Rueckkehr-Anzeige: beide Offline-Berichte kommen getrennt; so lange wird
-- gesammelt, bevor die Karte erscheint.
FeedbackConfig.RETURN_COLLECT_SECONDS = 1.2
FeedbackConfig.RETURN_SHOW_SECONDS    = 6

-- 08.10. (Paket G): Erfolgs-Effekt nach einem BESTAETIGTEN Ausbau
-- (UI/UpgradeFX). Alles zusammen bleibt unter 1,2 s.
FeedbackConfig.UPGRADE_FX = {
	POP_SECONDS      = 0.32,   -- Aufspringen und Zurueckfedern des Gebaeudes
	POP_SCALE        = 1.12,   -- groesster Faktor beim Aufspringen
	POP_SCALE_BIG    = 1.18,   -- dasselbe beim Look-Wechsel
	SPARKS           = 14,     -- Funken (EIN Emitter, einmal ausgeloest)
	SPARKS_BIG       = 34,
	SPARK_LIFETIME   = 0.9,
	NUMBER_SECONDS   = 1.15,   -- schwebende Zahl "Level 7 ➜ 8"
	NUMBER_RISE      = 5,      -- Studs
	NUMBER_SIZE      = Vector2.new(260, 64),   -- px
	NUMBER_SIZE_BIG  = Vector2.new(360, 110),
	LOOK_WAIT        = 1.0,    -- so lange auf den Neubau beim Look-Wechsel warten
	PROMPT_LOCK      = 0.4,    -- Prompt nach einem Druck kurz sperren (kein Doppelkauf)
}

function FeedbackConfig.classOf(key: string): Class?
	return CLASSES[key]
end

return FeedbackConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">GamepassConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- GamepassConfig.luau
-- ReplicatedStorage/Config/GamepassConfig.luau
--
-- Einzige Zustaendigkeit:
--   - Die Gamepasses des Spiels (08.10., Paket C): Id, Texte, Icon.
--
-- id = 0 heisst "noch nicht angelegt": der Knopf zeigt "Bald", loest keinen
-- Kauf aus, und niemand besitzt den Pass (ausser per Debug "pass on").
-- Anlegen: Creator Dashboard -> Spiel -> Monetization -> Passes -> Pass
-- erstellen -> die Asset-ID hier eintragen. Der Preis steht nur im Dashboard.
--
-- Besitz steht NICHT im Spielstand: GamepassService fragt Roblox
-- (UserOwnsGamePassAsync) beim Join und nach einem Kauf und haelt das
-- Ergebnis im Speicher; der Client liest es am Attribut des Spielers.

local GamepassConfig = {}

export type PassDef = {
	id      : number,   -- Gamepass-Asset-ID, 0 = nicht angelegt
	nameKey : string,   -- Loc-Schluessel Name
	descKey : string,   -- Loc-Schluessel kurze Beschreibung
	icon    : string,   -- Name in UI/Icons
}

GamepassConfig.PASSES = {
	-- Gratis-Skip: der Einstieg ab der letzten Stage kostet immer 0 Gummies
	-- (CombatService fragt GamepassService; der Client zeigt nur an).
	SKIP_PASS = { id = 0, nameKey = "ui.pass.skip.name", descKey = "ui.pass.skip.desc", icon = "crown" },
} :: { [string]: PassDef }

-- Attribut am Player: "Pass_<KEY>" = true/false (Anzeige im Client)
GamepassConfig.ATTRIBUTE_PREFIX = "Pass_"

function GamepassConfig.get(key: string): PassDef?
	return GamepassConfig.PASSES[key]
end

function GamepassConfig.isReady(key: string): boolean
	local def = GamepassConfig.PASSES[key]
	return def ~= nil and def.id > 0
end

function GamepassConfig.attributeName(key: string): string
	return GamepassConfig.ATTRIBUTE_PREFIX .. key
end

return GamepassConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">IncubatorConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- IncubatorConfig.luau
-- ReplicatedStorage/Config/IncubatorConfig.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Zahlen des Inkubators (Sammel-Update 05.10., Paket 8): Plaetze,
--     Brutzeiten, Ausbau-Kosten, Beschleunigen, Aussehen auf dem Plot.
--
-- Die Regeln (wie viele Plaetze, wann fertig, was kostet das Beschleunigen)
-- stehen als reine Funktionen in Modules/IncubatorRules — Server
-- (IncubatorService) und Client (IncubatorPanel/-Controller) rechnen damit.
--
-- Entscheidungen aus Abschnitt 11.6 (Standard, alle als ANNAHME benannt):
--   * Basis- und Zucker-Ei bleiben sofort oeffenbar (INSTANT_MAX_TIER = 2,
--     README: "alles ab Stufe Gold nur ueber den Inkubator").
--   * 1 Platz frei ab dem ersten Kampf.
--   * Beschleunigen mit GoldGummies: ja.

local IncubatorConfig = {}

-- Hoechstens so viele sichtbare Plaetze (Kuppeln auf dem Plot).
IncubatorConfig.MAX_SLOTS = 6

-- Plaetze aus dem Ausbau-Level (Level -> Plaetze ab diesem Level).
IncubatorConfig.SLOTS_BY_LEVEL = {
	{ level = 1,  slots = 1 },
	{ level = 10, slots = 2 },
	{ level = 25, slots = 3 },
}

-- +1 Platz ab diesem Rebirth (bleibt danach).
IncubatorConfig.REBIRTH_BONUS_FROM = 2

-- Index-Belohnungen (Pfad fertig) geben weitere Plaetze, siehe
-- IndexRewardConfig.incubatorSlots.

-- Ausbau: Level 1-60 wie die Gebaeude. Kosten = Gebaeude-Kurve
-- (EconomyConfig.HONEY_UPGRADE_COSTS) x COST_FACTOR — eine zweite Geldsenke
-- vor dem Rebirth (Paket 4.4, Entscheidung 11.5). Ein Rebirth setzt das Level
-- zurueck, die Eier in den Plaetzen bleiben.
IncubatorConfig.MAX_LEVEL   = 60
IncubatorConfig.COST_FACTOR = 0.6

-- Jedes Level ueber 1 bruetet um diesen Anteil schneller (Level 60: x2,18).
IncubatorConfig.SPEED_PER_LEVEL = 0.02

-- Brutzeit (Sekunden auf Level 1) nach Stufe des Eis (EggConfig.tier).
-- Basis-Ei 30 s, danach deutlich laenger nach oben. Stufe 0 = Sonder-Eier
-- (UFO-Jackpot). Niedrige Eier schluepfen damit schnell (Paket 6.5,
-- zweite Auslegung von "brueten").
IncubatorConfig.BREW_SECONDS_BY_TIER = {
	[0]  = 120,
	[1]  = 30,
	[2]  = 60,
	[3]  = 180,
	[4]  = 360,
	[5]  = 720,
	[6]  = 1200,
	[7]  = 1800,
	[8]  = 2700,
	[9]  = 3600,
	[10] = 5400,
	[11] = 7200,
} :: { [number]: number }

-- Eier bis zu dieser Stufe duerfen weiter SOFORT geoeffnet werden.
IncubatorConfig.INSTANT_MAX_TIER = 2

-- Beschleunigen: GoldGummies je angefangene Rest-Minute (mind. 1).
IncubatorConfig.SPEEDUP_GOLD_PER_MINUTE = 1

-- Kurz vor dem Schluepfen leuchtet die Kuppel (Client).
IncubatorConfig.GLOW_LAST_SECONDS = 10

-- Aussehen auf dem Plot (Plot-Koordinaten, siehe IncubatorBuilder). Steht
-- auf dem Beet links hinten, wo vorher nichts stand (Paket 8.2, Option 1:
-- der Plot bleibt, der Inkubator fuellt die Flaeche). Teile: Sockel 2 +
-- je Kuppel 3 = hoechstens 20 (PART_BUDGET).
IncubatorConfig.LOOK = {
	offset       = Vector3.new(-20, 0, 20),
	baseSize     = Vector3.new(19, 1.2, 12),
	baseColor    = Color3.fromRGB(122, 104, 204),
	trimColor    = Color3.fromRGB(255, 214, 90),
	columns      = 3,
	spacing      = Vector3.new(6, 0, 5.5),
	padSize      = Vector3.new(0.6, 4.2, 4.2),   -- Zylinder (liegend: X = Hoehe)
	padColor     = Color3.fromRGB(80, 70, 140),
	domeSize     = Vector3.new(4.2, 4.2, 4.2),
	domeColor    = Color3.fromRGB(190, 230, 255),
	domeTransparency = 0.55,
	lockedTransparency = 0.85,
	eggSize      = Vector3.new(1.7, 2.3, 1.7),
	signDistance = 80,
}
IncubatorConfig.PART_BUDGET = 20

IncubatorConfig.MODEL_NAME = "Incubator"

--------------------------------------------------------------------------------
-- INCUBATOR_BREED (Wunsch Projektinhaber 05.10.)
--------------------------------------------------------------------------------
-- Man setzt einen Baerchi in den Inkubator, und er bruetet im Takt seiner
-- Rarity zusaetzliche Eier — zusaetzlich zu denen des ausgeruesteten. Welche
-- Eier: seine eigene eggTable (wie beim Legen), gesperrte Eier rutschen wie
-- beim Legen auf den freien Vorgaenger (EggTree.resolveLaid).
--
-- Takt in Sekunden pro Ei auf Inkubator-Level 1, je Rarity. Hoehere Rarity =
-- schnellerer Takt (und bessere Eier aus der eigenen Tabelle). Der Ausbau
-- beschleunigt wie bisher (SPEED_PER_LEVEL). Bewusst langsamer als das Legen
-- des ausgeruesteten Baerchis (Common legt alle 2,5-3 min): der Inkubator ist
-- ein Zusatz, kein Ersatz. ANNAHME, zum Nachstellen.
IncubatorConfig.BREED_SECONDS_BY_RARITY = {
	Common    = 900,   -- 15 min
	Uncommon  = 840,
	Rare      = 780,
	Epic      = 720,   -- 12 min
	Legendary = 660,
	Mythic    = 600,   -- 10 min
	Divine    = 570,
	Cosmic    = 540,
	Secret    = 510,
	Godly     = 480,   -- 8 min
	Eternal   = 450,
	Omega     = 420,   -- 7 min
} :: { [string]: number }
IncubatorConfig.BREED_DEFAULT_SECONDS = 900

-- Gebruetete Eier fallen neben den Inkubator und werden wie gelegte Eier
-- durch Darueberlaufen eingesammelt. Eigene Obergrenze (zaehlt nicht gegen
-- EggConfig.MAX_UNCOLLECTED_EGGS); offline langsamer und kleiner gedeckelt,
-- wie beim Legen (EggConfig.OFFLINE_SLOWDOWN).
IncubatorConfig.BREED_MAX_LYING        = 8
IncubatorConfig.BREED_OFFLINE_MAX      = 4
-- Abstand der Eier von der Sockel-Mitte (Studs, Bereich) — knapp vor dem Rand.
IncubatorConfig.BREED_DROP_MIN         = 11
IncubatorConfig.BREED_DROP_MAX         = 13
-- Hoehe der Mini-Figur in der Kuppel (Studs).
IncubatorConfig.BREED_FIGURE_HEIGHT    = 2.6

return IncubatorConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">IndexRewardConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- IndexRewardConfig.luau
-- ReplicatedStorage/Config/IndexRewardConfig.luau
--
-- Einzige Zustaendigkeit:
--   - Welche Kollektionen im Index eine Belohnung haben, wann sie fertig sind
--     und was sie bringen (Sammel-Update 05.10., Paket 7).
--
-- Server (IndexRewardService: pruefen und auszahlen) und Client (IndexView:
-- Fortschritt, "Abholen", "!" am Index) rechnen mit denselben Funktionen.
--
-- Vier Ebenen (Entscheidung 11.7, Standard: alle vier):
--   egg:<EggType>   alle Baerchis, die aus diesem Ei schluepfen koennen,
--                   entdeckt -> Gummies + Eier dieses Typs
--   path:<PathId>   alle Eier des Pfads fertig (Stamm, Gold, Kristall, Void,
--                   Kosmos) -> GoldGummies + Blaupause + 1 Inkubator-Platz
--   rarity:<Rarity> alle Baerchis dieser Rarity -> GoldGummies (= Charm-Wuerfe,
--                   seit GOLD_CHARMS_ONLY zahlt man Charms mit Gold)
--   all             der ganze Index -> 2 Ascensions-Eier (zaehlt als
--                   besonderer Meilenstein, Paket 6.2)
--
-- "Entdeckt" = die Art (data.discovered), Mutationen zaehlen nicht (Annahme
-- aus dem Plan; ein Mutations-Index waere ein eigener Ausbau).
--
-- Ascensions-Eier tauchen hier NUR bei "all" auf. Die Ei-Belohnung eines
-- Ascensions-Pfad-Eis ist deshalb Gold statt Eier (sonst waere das eine
-- dritte Quelle, siehe tools/check_consistency.py, Abschnitt 9).
--
-- Alle Zahlen sind ANNAHMEN (im Bericht SAMMEL_UPDATE_UMGESETZT benannt).

local Types         = require(script.Parent.Parent.Network.Types)
local EggConfig     = require(script.Parent.EggConfig)
local BaerchiConfig = require(script.Parent.BaerchiConfig)

local IndexRewardConfig = {}

export type Reward = {
	gummies        : number,
	goldGummies    : number,
	eggType        : Types.EggType?,
	eggs           : number,
	blueprints     : number,
	incubatorSlots : number,
}

export type Entry = {
	id      : string,
	kind    : string,                 -- "egg" | "path" | "rarity" | "all"
	key     : string,                 -- EggType / PathId / Rarity / "all"
	members : { string },             -- configIds, die entdeckt sein muessen
	reward  : Reward,
	order   : number,                 -- Anzeige-Reihenfolge
}

--------------------------------------------------------------------------------
-- Zahlen
--------------------------------------------------------------------------------

-- Ei-Reihe: Gummies = EGG_GUMMIES_BASE x EGG_GUMMIES_GROWTH^(Stufe-1),
-- ausgezahlt ueber EconomyService (mit Rebirth-Multiplikator). Dazu
-- EGG_COUNT Eier derselben Sorte.
IndexRewardConfig.EGG_GUMMIES_BASE   = 2000
IndexRewardConfig.EGG_GUMMIES_GROWTH = 5
IndexRewardConfig.EGG_COUNT          = 2
IndexRewardConfig.ASCENSION_EGG_GOLD = 60     -- statt Eiern (siehe Kopf)

-- Pfad: GoldGummies je Pfad, dazu 1 Blaupause und 1 Inkubator-Platz.
IndexRewardConfig.PATHS = { "Stamm", "Gold", "Kristall", "Void", "Kosmos" }
IndexRewardConfig.PATH_GOLD = {
	Stamm = 80, Gold = 200, Kristall = 200, Void = 200, Kosmos = 400,
}
IndexRewardConfig.PATH_BLUEPRINTS      = 1
IndexRewardConfig.PATH_INCUBATOR_SLOTS = 1

-- Rarity: GoldGummies = RARITY_GOLD_PER_INDEX x Rarity-Index (Common 1 ... Omega 12).
IndexRewardConfig.RARITY_GOLD_PER_INDEX = 20

-- Ganzer Index (besonderer Meilenstein).
IndexRewardConfig.ALL_EGGS = { eggType = "AscensionEgg" :: Types.EggType, count = 2 }
IndexRewardConfig.ALL_GOLD = 500

--------------------------------------------------------------------------------
-- Aufbau der Liste (aus EggConfig/BaerchiConfig berechnet)
--------------------------------------------------------------------------------

local function emptyReward(): Reward
	return { gummies = 0, goldGummies = 0, eggType = nil, eggs = 0, blueprints = 0, incubatorSlots = 0 }
end

local function sortedKeys(set: { [string]: boolean }): { string }
	local list = {}
	for id in set do table.insert(list, id) end
	table.sort(list)
	return list
end

local ENTRIES: { Entry } = {}
local BY_ID: { [string]: Entry } = {}

local function add(entry: Entry)
	table.insert(ENTRIES, entry)
	BY_ID[entry.id] = entry
end

do
	local order = 0

	-- Ei-Reihen (in Baum-Reihenfolge; Sonder-Eier ausserhalb des Baums nicht)
	local eggMembers: { [string]: { [string]: boolean } } = {}
	for _, eggId in EggConfig.getOrderedIds() do
		local egg = EggConfig.data[eggId]
		local set: { [string]: boolean } = {}
		for configId, weight in egg.hatchTable do
			if weight > 0 and BaerchiConfig.data[configId] then set[configId] = true end
		end
		eggMembers[eggId] = set

		local reward = emptyReward()
		reward.gummies = math.floor(IndexRewardConfig.EGG_GUMMIES_BASE
			* IndexRewardConfig.EGG_GUMMIES_GROWTH ^ (math.max(egg.tier, 1) - 1))
		if egg.path == "Ascension" then
			reward.goldGummies = IndexRewardConfig.ASCENSION_EGG_GOLD
		else
			reward.eggType = eggId
			reward.eggs    = IndexRewardConfig.EGG_COUNT
		end
		order += 1
		add({ id = "egg:" .. eggId, kind = "egg", key = eggId, members = sortedKeys(set), reward = reward, order = order })
	end

	-- Pfade: Vereinigung aller Ei-Reihen des Pfads
	for _, path in IndexRewardConfig.PATHS do
		local set: { [string]: boolean } = {}
		for eggId, members in eggMembers do
			if EggConfig.data[eggId].path == path then
				for configId in members do set[configId] = true end
			end
		end
		local reward = emptyReward()
		reward.goldGummies    = IndexRewardConfig.PATH_GOLD[path] or 0
		reward.blueprints     = IndexRewardConfig.PATH_BLUEPRINTS
		reward.incubatorSlots = IndexRewardConfig.PATH_INCUBATOR_SLOTS
		order += 1
		add({ id = "path:" .. path, kind = "path", key = path, members = sortedKeys(set), reward = reward, order = order })
	end

	-- Rarities
	local byRarity: { [string]: { [string]: boolean } } = {}
	for configId, def in BaerchiConfig.data do
		byRarity[def.rarity] = byRarity[def.rarity] or {}
		byRarity[def.rarity][configId] = true
	end
	local rarities = {}
	for rarity in byRarity do table.insert(rarities, rarity) end
	table.sort(rarities, function(a, b)
		return (BaerchiConfig.getRarityIndex(a :: any) or 0) < (BaerchiConfig.getRarityIndex(b :: any) or 0)
	end)
	for _, rarity in rarities do
		local reward = emptyReward()
		reward.goldGummies = IndexRewardConfig.RARITY_GOLD_PER_INDEX * (BaerchiConfig.getRarityIndex(rarity :: any) or 1)
		order += 1
		add({ id = "rarity:" .. rarity, kind = "rarity", key = rarity, members = sortedKeys(byRarity[rarity]), reward = reward, order = order })
	end

	-- Ganzer Index
	local all: { [string]: boolean } = {}
	for configId in BaerchiConfig.data do all[configId] = true end
	local reward = emptyReward()
	reward.eggType     = IndexRewardConfig.ALL_EGGS.eggType
	reward.eggs        = IndexRewardConfig.ALL_EGGS.count
	reward.goldGummies = IndexRewardConfig.ALL_GOLD
	order += 1
	add({ id = "all", kind = "all", key = "all", members = sortedKeys(all), reward = reward, order = order })
end

IndexRewardConfig.ENTRIES = ENTRIES

--------------------------------------------------------------------------------
-- Abfragen
--------------------------------------------------------------------------------

function IndexRewardConfig.get(id: string): Entry?
	return BY_ID[id]
end

-- (entdeckt, gesamt) einer Kollektion.
function IndexRewardConfig.progress(entry: Entry, discovered: { [string]: boolean }?): (number, number)
	local have = 0
	if discovered then
		for _, configId in entry.members do
			if discovered[configId] then have += 1 end
		end
	end
	return have, #entry.members
end

function IndexRewardConfig.isComplete(entry: Entry, discovered: { [string]: boolean }?): boolean
	local have, total = IndexRewardConfig.progress(entry, discovered)
	return total > 0 and have >= total
end

-- Alle fertigen, noch nicht abgeholten Belohnungen (fuer "!" und Hinweis).
function IndexRewardConfig.claimable(discovered: { [string]: boolean }?, claimed: { [string]: boolean }?): { string }
	local list = {}
	for _, entry in ENTRIES do
		if not (claimed and claimed[entry.id]) and IndexRewardConfig.isComplete(entry, discovered) then
			table.insert(list, entry.id)
		end
	end
	return list
end

-- Zusaetzliche Inkubator-Plaetze aus abgeholten Belohnungen (Paket 8).
function IndexRewardConfig.incubatorSlots(claimed: { [string]: boolean }?): number
	local n = 0
	if claimed then
		for id in claimed do
			local entry = BY_ID[id]
			if entry then n += entry.reward.incubatorSlots end
		end
	end
	return n
end

return IndexRewardConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">MapConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- MapConfig.luau
-- ReplicatedStorage/Config/MapConfig.luau
--
-- Alle Positionen, Groessen und visuellen Werte fuer die Map.
-- MapService hat keine einzige hardcodierte Zahl.
--
-- ============================================================
-- WELT-AUFBAU: INSELN IM WASSER
-- ============================================================
-- Drei Ringe aus Inseln, alle mit Holzstegen verbunden, rundherum Wasser:
--
--                        (A)
--                         |
--                        [P]
--                         |
--             (A)—[P]— (( C )) —[P]—(A)      8 mal, alle 45 Grad
--                         |
--                        [P]
--                         |
--                        (A)
--
--   (( C ))  Hauptinsel: Spawn, Honigmast, freie Karo-Wiese. Hier landen
--            alle und hier laufen sich alle ueber den Weg.
--   [P]      Plot-Insel: eine pro Spieler, mit dem eigenen Beet, den drei
--            Gebaeuden und dem Honig-Teich.
--   (A)      Arena-Insel: die eigene PIT-Arena, ein Stueck weiter draussen.
--
-- WARUM INSELN STATT EINER PLATTFORM
-- Vorher war alles eine einzige 480 Studs breite Scheibe, auf der die Plots
-- als Rechtecke lagen. Das las sich aus der Spielerkamera als eine grosse
-- gruene Flaeche mit Markierungen darauf — man sah nicht, wo der eigene
-- Bereich anfaengt. Getrennte Inseln beantworten das ohne ein einziges
-- Schild: was zu mir gehoert, ist das, was am Ende MEINES Stegs liegt.
--
-- Alle drei Abstaende sind derselbe Wert (ISLAND_GAP) und damit auch alle
-- Stege gleich lang. Ein Steg ueberbrueckt IMMER genau eine Luecke — es gibt
-- keine zweite Laengen-Zahl mehr, die davon abweichen koennte.
--
-- Die Wiese ist KARIERT (zwei Gruentoene). Gebaut wird nur die helle Haelfte
-- als flache Teile auf der dunklen Inselscheibe; das Raster liegt in
-- Weltkoordinaten, laeuft also ueber alle Inseln durch. Die frueheren
-- Lego-Noppen sind dafuer weg: Noppen UND Karos uebereinander ergeben nur
-- Unruhe, und das Karo ist das, was die Flaeche gliedert.
--
-- ============================================================
-- PLOT-LOKALES KOORDINATENSYSTEM (wichtig!)
-- ============================================================
-- Jeder Plot bekommt in MapService ein eigenes CFrame, das zur Plattform-
-- MITTE schaut. Alle Offsets hier unten sind deshalb LOKAL zu diesem Plot:
--
--     lokales -Z  = Richtung Plattform-Mitte
--     lokales +Z  = nach aussen (Richtung Rand → Bruecke → PIT)
--     lokales +X  = seitlich (rechts, wenn man vom Plot zur Mitte schaut)
--
-- Nur dadurch stehen die Gebaeude bei allen 8 Winkeln richtig herum statt
-- verdreht. Das Y in den Offsets ist eine ZUSATZ-Hoehe ueber dem Plot-Boden;
-- die eigentliche Standhoehe rechnet MapService selbst aus der jeweiligen
-- Teilegroesse aus, damit nichts schwebt oder im Boden steckt.

--------------------------------------------------------------------------------
-- Hauptinsel, Wasser, Karo-Wiese
--------------------------------------------------------------------------------

local CENTER = Vector3.new(0, 0, 0)

-- Oberkante JEDER Insel. Alles andere wird relativ dazu berechnet —
-- die Welt laesst sich damit an einer einzigen Zahl hoch/runter schieben.
local PLATFORM_TOP_Y = 0

-- War 150. Von der eigenen Plot-Insel bis zur Mitte war das ein spuerbar
-- langer Fussmarsch quer ueber die Hauptinsel — genau die Strecke, die am
-- meisten zaehlt, weil man sie bei jedem Ei, jedem Ausruesten und jedem
-- Rebirth-Blick zur Mitte zuruecklegt. 120 kuerzt das um ein Fuenftel, ohne
-- die Hauptinsel eng wirken zu lassen (das Spawn-Pad ist 24 Studs breit,
-- bleibt also weiterhin ein kleiner Punkt darauf).
local PLATFORM_RADIUS = 120

-- Wie dick eine Insel ist. Sie steckt damit sichtbar im Wasser statt wie eine
-- Scheibe darauf zu liegen — bei 16 Studs sieht man von der Kamerahoehe eines
-- Spielers eine richtige Kante, keinen Strich.
local ISLAND_HEIGHT = 16

-- Abstand zwischen zwei Inseln UND damit die Laenge jedes Stegs. Ein Steg
-- ueberbrueckt immer genau eine Luecke, deshalb gibt es nur diese eine Zahl.
-- War 44 (rund drei Sekunden bei WALK_SPEED). 34 bleibt immer noch lang genug,
-- dass die Inseln spuerbar getrennt wirken, kuerzt aber jede der beiden
-- Bruecken pro Weg (Hauptinsel→Plot, Plot→Arena) um gut zwei Sekunden.
local ISLAND_GAP = 34

-- ============================================================
-- KARO-WIESE
-- ============================================================
-- Zwei Gruentoene im Schachbrett. Gebaut werden NUR die hellen Felder als
-- flache Teile — die dunkle Haelfte ist die Inselscheibe selbst. Das halbiert
-- die Teilezahl gegenueber "jedes Feld ein Teil" bei exakt demselben Bild.
--
-- GRASS_TILE gilt fuer die ganze Welt, und das Raster liegt in WELT-
-- Koordinaten mit Ursprung im Weltmittelpunkt: die Karos laufen dadurch ueber
-- alle Inseln durch, statt auf jeder neu anzusetzen. Nur die Plot-Beete
-- rastern plot-lokal (siehe unten) — sonst laege das Karo auf einem gedrehten
-- Beet schief.
--
-- 24 Studs sind bewusst gross: bei 12 wirkt die Wiese aus der Spielerkamera
-- wie ein Muster statt wie Felder, und die Teilezahl vervierfacht sich.
--
-- Das Beet auf der Plot-Insel rastert FEINER (PLOT_GRASS_TILE). Es ist die
-- Flaeche, auf der man selbst steht und auf die man die ganze Zeit schaut;
-- 24er-Felder waeren darauf nur drei Reihen und wuerden gar nicht mehr als
-- Karo lesen. Dieselbe Ueberlegung wie bei einem Teppich gegenueber einer
-- Wiese. 72 / 18 geht glatt auf, es bleibt kein Reststreifen an einer Kante.
local GRASS_TILE      = 24
local PLOT_GRASS_TILE = 18
local GRASS_HEIGHT    = 0.08   -- wie weit ein helles Feld ueber der Scheibe liegt
local GRASS_DARK      = Color3.fromRGB( 58, 140,  62)
local GRASS_LIGHT     = Color3.fromRGB( 92, 178,  82)

-- Sandkante am Wasser: eine BREITERE Scheibe, die ein Stueck tiefer liegt.
-- Ringsum bleibt dadurch ein Sandstreifen sichtbar, ohne dass dafuer ein Ring
-- aus Einzelteilen gebaut werden muesste.
--
-- SHORE_DROP und WATER_DROP bilden zusammen eine Treppe: Wiese 0, Sand -1,
-- Wasser -2.6. Beide Stufen sind niedrig genug, dass eine Roblox-Figur sie
-- ohne Springen hochgeht — wer ins Wasser faellt, laeuft einfach zurueck an
-- Land. Waeren sie hoeher, waere jeder Fehltritt eine Sackgasse.
local SHORE_WIDTH = 8
local SHORE_DROP  = 1.0
local SHORE_COLOR = Color3.fromRGB(238, 214, 158)

-- Das Wasser ist EINE grosse Scheibe unter allem.
--
-- Sie ist begehbar (CanCollide): wer vom Steg faellt, landet auf der
-- Oberflaeche und laeuft zurueck, statt ins Leere zu stuerzen. In einem Spiel,
-- in dem man staendig ueber schmale Stege laeuft, ist das die freundlichere
-- Loesung — ein Sturz waere reine Strafe ohne Spielinhalt.
--
-- WATER_RADIUS muss die aeusserste Arena mit Sandkante umschliessen; das
-- prueft MapService beim Start. War 700 — mit der kleineren Welt reicht 650
-- fuer denselben grosszuegigen Rand offenen Wassers dahinter.
local WATER_RADIUS       = 650
local WATER_DROP         = 2.6    -- wie weit unter Inselhoehe die Oberflaeche liegt
local WATER_HEIGHT       = 10
local WATER_COLOR        = Color3.fromRGB(64, 164, 214)
local WATER_TRANSPARENCY = 0.28

-- Not-Spawn in der Mitte der Wiese. Greift nur noch, wenn ein Spieler
-- ausnahmsweise KEINEN eigenen Plot bekommt (Server voll, siehe
-- MapService.spawnIsland) — der normale Weg ist seit dem Insel-Spawn
-- (siehe PLAYER_SPAWN_OFFSET unten) die eigene Insel, nicht mehr die Mitte.
-- Unsichtbar, damit sie nicht als zweiter Bodenbelag unter dem Event-Pit
-- durchscheint.
local SPAWN_SIZE = Vector3.new(10, 1, 10)
local SPAWN_COLOR = Color3.fromRGB(240, 230, 200)

-- ============================================================
-- EVENT-PIT: DER STALL IN DER MITTE
-- ============================================================
-- Ein rundes, eingezaeuntes Podest genau in der Weltmitte, unter dem
-- Honigmast. Normalerweise ein schlichter Holz-Stall — sobald ein Event
-- laeuft, faerbt EventService Boden, Zaun und Ring in dessen Farben um
-- (siehe MapService.setEventPitTheme) und die Anzeigetafel darueber zeigt
-- Name und Restzeit. Ausserhalb eines Events zeigt dieselbe Tafel den
-- Countdown bis zum naechsten (siehe MapService.setEventBanner).
--
-- Acht Zaunluecken statt einer (wie bei den Spieler-Arenen): das Pit steht
-- in der Mitte aller acht Stege, nicht am Ende von nur einem. Jede Luecke
-- liegt genau in der Aussenrichtung eines Plots — wer von seiner Bruecke
-- kommt, laeuft geradewegs hinein statt am Zaun entlang zu suchen.
--
-- Podesthoehe 2 Studs, derselbe Trick wie beim Plot-Beet (PLOT_SIZE.Y):
-- ein klarer Schritt nach oben statt eines Absenk-Tricks, niedrig genug zum
-- Hochlaufen ohne Springen.
local EVENT_PIT_RADIUS       = 50
local EVENT_PIT_FLOOR_HEIGHT = 2

-- Sicherheitsabstand zwischen dem Karo-Rasen (GRASS_HEIGHT ueber
-- PLATFORM_TOP_Y) und der Podest-Unterkante — derselbe Grundgedanke wie
-- BRIDGE_SINK/GRASS_HEIGHT selbst: ohne diesen Puffer laege die Unterkante
-- GENAU auf Rasenhoehe, und ein paar Karo-Kacheln direkt am Podestrand
-- wuerden mit der Unterkante flimmern bzw. leicht durchscheinen — genau der
-- "das Pit steckt teilweise im Boden"-Effekt. Mit dem Puffer liegt die
-- Unterkante immer sauber ueber dem Rasen, egal welche Kachel gerade
-- darunterliegt.
local EVENT_PIT_GROUND_CLEARANCE = 0.3

-- Stall-Look: gedeckte Stroh-/Holztoene, kein Glimmen. Erst ein Event macht
-- daraus etwas Auffaelliges (siehe EventConfig.EVENTS).
local EVENT_PIT_DEFAULT_FLOOR_COLOR = Color3.fromRGB(178, 150, 100)
local EVENT_PIT_DEFAULT_FENCE_COLOR = Color3.fromRGB(150, 105, 60)
local EVENT_PIT_DEFAULT_RING_COLOR  = Color3.fromRGB(120,  98,  70)

local EVENT_PIT_RING_OVERHANG = 1.6
local EVENT_PIT_RING_HEIGHT   = 0.7

local EVENT_PIT_FENCE_COUNT       = 28
local EVENT_PIT_FENCE_SIZE        = Vector3.new(1.0, 5.0, 1.0)
local EVENT_PIT_FENCE_GAP_DEGREES = 9     -- Oeffnung je Bruecken-Richtung, halber Winkel je Seite
local EVENT_PIT_FENCE_INSET       = 1.6

-- Anzeigetafel: anders als bei den Spieler-Arenen IMMER eingeblendet — sie
-- ist der einzige Ort, an dem der Event-Countdown steht.
-- Playtest 05.10.: bei 16 lag die Tafel im Honigmast (Spitze ~33) und die
-- Schrift lief durch ihn hindurch. 38 = Unterkante ueber dem Tropfen.
local EVENT_PIT_BANNER_HEIGHT   = 38
local EVENT_PIT_BANNER_SIZE     = Vector2.new(22, 6)
local EVENT_PIT_BANNER_DISTANCE = 300
local EVENT_PIT_BANNER_IDLE_COLOR = Color3.fromRGB(230, 220, 200)

--------------------------------------------------------------------------------
-- Spieler-Plots
--------------------------------------------------------------------------------

local PLOT_COUNT = 8

-- Jeder Plot ist eine eigene RUNDE Insel; darauf liegt das quadratische Beet.
--
-- PLOT_ISLAND_RADIUS muss die ECKEN des Beetes decken, nicht seine Kanten:
-- bei 72x72 liegt eine Ecke 50.9 Studs von der Mitte. 58 laesst also rund
-- 7 Studs Wiesenrand ums Beet, dahinter kommt die Sandkante. Zu knapp, und
-- das Beet ragt an vier Stellen ueber die Insel; MapService prueft das beim
-- Start.
local PLOT_ISLAND_RADIUS = 58

-- Abstand der Insel-MITTE zur Weltmitte. Ergibt sich aus den Radien und der
-- Luecke: Hauptinsel-Rand + Steg + halbe Plot-Insel.
--     120 + 34 + 58 = 212
-- MapService rechnet das beim Start nach und warnt, wenn es nicht passt.
-- PLOT_ISLAND_RADIUS selbst bleibt unangetastet: er haengt fest an PLOT_SIZE
-- (die Insel muss die Beet-Ecken decken) — an dieser Zahl zu drehen wuerde das
-- Beet ueber den Inselrand ragen lassen, nicht nur den Weg dorthin verkuerzen.
local PLOT_RING_RADIUS = 212
local PLOT_SIZE        = Vector3.new(72, 2, 72)

-- Der Wiesenrand der Plot-Insel, auf dem das Beet steht. Etwas dunkler als das
-- Karo, damit das Beet als eigene Flaeche liest und nicht mit der Insel
-- verschwimmt.
local PLOT_ISLAND_COLOR = Color3.fromRGB(70, 152, 70)

-- Zaun an den beiden SEITEN des Plots (lokales +X und -X). Vorne (+Z, Richtung
-- Bruecke) und hinten (-Z, Richtung Mitte) bleibt bewusst offen — sonst muesste
-- man ueber den Zaun springen um auf den eigenen Plot oder zur Bruecke zu kommen.
local FENCE_POST_SIZE    = Vector3.new(1.2, 5, 1.2)
local FENCE_POST_SPACING = 9
local FENCE_RAIL_HEIGHT  = 0.8
local FENCE_COLOR        = Color3.fromRGB(225, 215, 190)

-- Schild an der zur Mitte zeigenden Kante: zeigt, wem der Plot gehoert
local SIGN_POST_SIZE  = Vector3.new(0.8, 7, 0.8)
-- Playtest 05.10.: 16 breit wirkte langgezogen, und EIN Pfosten in der Mitte
-- ragte vorne durch die Schrift. Jetzt 12 breit, zwei Pfosten HINTER dem Brett
-- an den Raendern, dunkle Leisten oben und unten.
local SIGN_BOARD_SIZE = Vector3.new(12, 5.2, 0.6)
local SIGN_TRIM_COLOR = Color3.fromRGB(150, 105, 60)
local SIGN_POST_COLOR = Color3.fromRGB(150, 105, 60)
local SIGN_COLOR      = Color3.fromRGB(245, 235, 205)

-- Blumen auf der freien Wiese der Hauptinsel. Rein optisch, deterministisch
-- gesetzt (fester Zufallsstartwert), damit die Welt bei jedem Server-Start
-- gleich aussieht.
--
-- Weniger als vorher (90), weil die Hauptinsel nur noch ein Fuenftel der
-- frueheren Flaeche hat: dieselbe Zahl waere jetzt ein Blumenfeld, und die
-- Karos darunter waeren nicht mehr zu sehen.
local FLOWER_COUNT      = 46
local FLOWER_SEED       = 20260903
local FLOWER_STEM_SIZE  = Vector3.new(0.4, 3, 0.4)
local FLOWER_HEAD_SIZE  = 1.8
local FLOWER_STEM_COLOR = Color3.fromRGB(70, 150, 55)
local FLOWER_COLORS: { Color3 } = {
	Color3.fromRGB(255, 235, 120),
	Color3.fromRGB(255, 160, 190),
	Color3.fromRGB(180, 165, 255),
	Color3.fromRGB(255, 255, 255),
}

--------------------------------------------------------------------------------
-- Gebaeude auf dem Plot (Offsets im PLOT-LOKALEN Raum, siehe Kopf)
--------------------------------------------------------------------------------

-- Die zwei Honig-Gebaeude (v15: Bienenstock und Honig-Veredler) stehen ab dem
-- ersten Join auf dem Plot (siehe Types.createDefaultPlayerData). Der dritte
-- Ausbau, der Waben-Recycler, steht vorne am Steg (CombConfig.RECYCLER_OFFSET). Sie stehen in einer Reihe an der zur Mitte
-- zeigenden Seite (-Z), damit die vordere Haelfte des Plots (+Z) frei bleibt
-- fuer die Baerchis und den Weg zur Bruecke.
--
-- Der Part-Name ist die BuildingId — der Client findet darueber das Gebaeude
-- fuer den ProximityPrompt. Wer hier einen Schluessel aendert, muss ihn auch
-- in Types.BuildingId, BuildingBehavior und IslandService.VALID_BUILDINGS
-- aendern; tools/check_consistency.py prueft alle Listen gegeneinander.
-- displayName steht bewusst HIER und nicht im Client: das Schild in der Welt
-- (MapService) und das Gebaeude-Panel (BuildingPanel) benennen dasselbe
-- Objekt. Zwei getrennte Listen waeren die naechste Stelle, an der etwas
-- auseinanderlaeuft.
-- shortName steht aus demselben Grund hier wie displayName: seit v7 waehlt der
-- Spieler auf der Baerchi-Detailkarte aus, welchen Honig er verfuettert, und
-- auf einen Knopf von einem Drittel Kartenbreite passt "Honig-Presse" nicht.
-- Eine zweite Namensliste im Client waere die naechste Stelle, an der etwas
-- auseinanderlaeuft.
local BUILDING_OFFSETS: { [string]: { offset: Vector3, size: Vector3, color: Color3, displayName: string, shortName: string } } = {
	Beehive = {
		offset      = Vector3.new(-22, 0, -22),
		size        = Vector3.new(12, 11, 12),
		color       = Color3.fromRGB(240, 190, 70),    -- Bienenstock-Gelb
		displayName = "Bienenstock",
		shortName   = "Stock",
	},
	-- v15: Honigtopf + Honig-Presse -> Honig-Veredler ("Honig-Veredler" ist ein
	-- Platzhalter-Name). Steht dort, wo die Presse stand; die Mitte (frueher
	-- der Topf) bleibt frei.
	HoneyRefiner = {
		offset      = Vector3.new(22, 0, -22),
		size        = Vector3.new(12, 11, 12),
		color       = Color3.fromRGB(205, 135, 45),    -- Honig-Orange
		displayName = "Honig-Veredler",
		shortName   = "Veredler",
	},
	-- Honig-Teich (HONEY_POND_V2): ersetzt Stock und Veredler. Steht mitten im
	-- hinteren Plot-Teil (wo die beiden standen), damit sein Brunnen vom Steg
	-- aus zu sehen ist. Der Koerper ist so gross wie Becken + Steinkranz; die
	-- Look-Deko (BUILDING_LOOK_DECOR.HoneyPond) waechst darin bis zum
	-- Honig-Springbrunnen. Das Becken selbst baut PondBuilder an derselben Stelle.
	HoneyPond = {
		offset      = Vector3.new(0, 0, -14),
		size        = Vector3.new(20, 15, 20),
		color       = Color3.fromRGB(255, 190, 60),    -- Honig-Gold
		displayName = "Honig-Brunnen",
		shortName   = "Brunnen",
	},
}

-- Feste Reihenfolge fuer alles was die Gebaeude AUFLISTET (Panel, Schilder).
-- Die Gebaeude-Tabelle in IslandData ist eine Hash-Tabelle und damit nicht
-- stabil sortiert.
local BUILDING_ORDER: { string } = { "Beehive", "HoneyRefiner", "HoneyPond" }

--------------------------------------------------------------------------------
-- Aussehen der Gebaeude
--------------------------------------------------------------------------------

-- Die Part aus BUILDING_OFFSETS ist seit v5 nur noch der unsichtbare Koerper:
-- sie traegt Namen, Attribut und Schild, und der Client haengt seinen
-- ProximityPrompt daran. Sie kollidiert NICHT — dagegen laufen kann man nur
-- an den Teilen, die hier `solid = true` tragen. WIE ein Gebaeude aussieht
-- steht also hier, als reine Beschreibung, ohne eine Zeile Code.
--
-- Warum getrennt: der Klotz von vorher war der Grund, dass alle drei Gebaeude
-- gleich aussahen und man sie nur am Schild unterscheiden konnte. Wer die Form
-- aendern will, aendert diese Liste und fasst MapService nicht an.
--
-- Koordinaten sind GEBAEUDE-lokal: Ursprung ist die Mitte der Grundflaeche auf
-- Plot-Hoehe, +Y ist nach oben, -Z zeigt zur Plattform-Mitte (also zu der
-- Seite, von der der Spieler kommt) und +Z zu den Baerchis.
--
-- shape/rotation: ein Cylinder liegt in Roblox von Haus aus entlang X. Damit
-- er STEHT, braucht er rotation = Vector3.new(0, 0, 90) — die Size ist dann
-- (Hoehe, Durchmesser, Durchmesser). Das ist die haeufigste Stolperfalle hier.
-- solid: dagegen laeuft man. Standard ist false, weil die meisten Teile nur
-- Zierrat sind (Wimpel, Flugloch, Honig-Fuellung) und man daran sonst haengen
-- bliebe. Der KOERPER selbst kollidiert seit v5 nicht mehr: er ist ein Kasten
-- in der Groesse aus BUILDING_OFFSETS und passt damit nicht mehr zur
-- sichtbaren Form — bei der offenen Presse etwa wuerde man mitten in der Luft
-- zwischen den Pfosten stehenbleiben. Also markiert die Config genau die
-- Teile, die den Umriss ausmachen.
export type DecorPiece = {
	name     : string,
	shape    : Enum.PartType,
	size     : Vector3,
	offset   : Vector3,
	color    : Color3,
	material : Enum.Material?,
	rotation : Vector3?,   -- Grad, optional
	solid    : boolean?,   -- Standard: false
}

local UPRIGHT = Vector3.new(0, 0, 90)   -- macht aus einem liegenden einen stehenden Cylinder

local WOOD       = Color3.fromRGB(160, 110, 65)
local WOOD_DARK  = Color3.fromRGB(118,  80,  46)
local HONEY      = Color3.fromRGB(245, 175,  45)
local HONEY_DEEP = Color3.fromRGB(205, 135,  45)
local METAL      = Color3.fromRGB(150, 152, 158)

