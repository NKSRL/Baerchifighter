	----------------------------------------------------------------------------
	-- UI-Qualitaet: Beschreibungen aus den Configs (Baerchis, Eier, Skills, Events, Charms)
	----------------------------------------------------------------------------
	["baerchi.RedBaerchi.desc"]           = "The classic. Reliable, unfussy.",
	["baerchi.GreenBaerchi.desc"]         = "A bit tougher, but slower.",
	["baerchi.YellowBaerchi.desc"]        = "Fast but fragile. A glass cannon.",
	["baerchi.BlueBaerchi.desc"]          = "Solid all round.",
	["baerchi.OrangeBaerchi.desc"]        = "High damage, average stamina.",
	["baerchi.SugarBaerchi.desc"]         = "Smells like candy, hits like a truck.",
	["baerchi.CrystalBaerchi.desc"]       = "Sharp-edged and lightning fast. Breaks easily.",
	["baerchi.GoldenGrizzly.desc"]        = "Rare, mighty, and knows it.",
	["baerchi.VoidBaerchi.desc"]          = "Comes out of nowhere. Leaves the same way.",
	["baerchi.RainbowBaerchi.desc"]       = "Every colour. Every power.",
	["baerchi.AncientBaerchi.desc"]       = "Was around before Gummies were invented.",
	["baerchi.CosmicBaerchi.desc"]        = "A piece of the night sky with fur.",
	["baerchi.PhoenixBaerchi.desc"]       = "Falls once. Always gets back up.",
	["baerchi.GlacierBaerchi.desc"]       = "Wherever he looks, everything slows down.",
	["baerchi.PhantomBaerchi.desc"]       = "You barely see him. His eggs, you do.",
	["baerchi.SeraphBaerchi.desc"]        = "Six wings, a heart of honey.",
	["baerchi.NorthernLightBaerchi.desc"] = "Dances across the sky, faster than the eye.",
	["baerchi.EclipseBaerchi.desc"]       = "When he shows up, it goes dark at noon.",
	["baerchi.CometBaerchi.desc"]         = "Arrives with a bang. Leaves a crater.",
	["baerchi.NebulaBaerchi.desc"]        = "Fur made of burning stardust.",
	["baerchi.PulsarBaerchi.desc"]        = "Ticks like a clock. Every beat louder.",
	["baerchi.ShadeBaerchi.desc"]         = "Nobody has ever fully seen him.",
	["baerchi.RiddleBaerchi.desc"]        = "Answers every question with another one.",
	["baerchi.TitanBaerchi.desc"]         = "Carries mountains like they were gummy bears.",
	["baerchi.GenesisBaerchi.desc"]       = "In the beginning was the Baerchi.",
	["baerchi.ChronosBaerchi.desc"]       = "Always arrives right on time.",
	["baerchi.InfinityBaerchi.desc"]      = "Never stops. Really never.",
	["baerchi.OmegaBaerchi.desc"]         = "The last Baerchi. Nothing comes after.",
	["egg.BasicEgg.desc"]                 = "A perfectly normal egg. What will hatch?",
	["egg.SugarEgg.desc"]                 = "Tastes sweet. So does what's inside.",
	["egg.GoldenEgg.desc"]                = "Suspiciously shiny. Rare or better guaranteed.",
	["egg.PlatinumEgg.desc"]              = "Heavy as lead, worth more than gold.",
	["egg.SunEgg.desc"]                   = "Warm in your hand. Very warm.",
	["egg.ZenithEgg.desc"]                = "The peak of the Gold path.",
	["egg.CrystalEgg.desc"]               = "See-through. You can almost tell what's inside.",
	["egg.PrismEgg.desc"]                 = "Splits light into seven colours.",
	["egg.AuroraEgg.desc"]                = "Glows like the northern sky.",
	["egg.MistEgg.desc"]                  = "Feels cold and damp.",
	["egg.VoidEgg.desc"]                  = "Blacker than black.",
	["egg.ShadowEgg.desc"]                = "Casts no shadow. It IS one.",
	["egg.AbyssEgg.desc"]                 = "Rock bottom. There's nothing below.",
	["egg.CometEgg.desc"]                 = "Trails a tail of sparks behind it.",
	["egg.NovaEgg.desc"]                  = "About to explode.",
	["egg.GalaxyEgg.desc"]                = "A whole universe in one shell.",
	["egg.AscensionEgg.desc"]             = "Earned, not bought. Legendary guaranteed.",
	["egg.TranscendenceEgg.desc"]         = "Beyond anything money can buy.",
	["egg.EternityEgg.desc"]              = "It was always here. It stays forever.",
	["egg.OmegaEgg.desc"]                 = "The last egg. 30% Omega.",
	["egg.UfoJackpotEgg.desc"]            = "Dropped by the UFO. A very rare find.",
	["egg.BasicEgg.short"]                = "Basic",
	["egg.SugarEgg.short"]                = "Sugar",
	["egg.GoldenEgg.short"]               = "Gold",
	["egg.PlatinumEgg.short"]             = "Platinum",
	["egg.SunEgg.short"]                  = "Sun",
	["egg.ZenithEgg.short"]               = "Zenith",
	["egg.CrystalEgg.short"]              = "Crystal",
	["egg.PrismEgg.short"]                = "Prism",
