]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX29"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">BaerchiMesh</string><ProtectedString name="Source"><![CDATA[--!strict
-- BaerchiMesh.luau
-- ReplicatedStorage/Modules/BaerchiMesh.luau
--
-- Einzige Zustaendigkeit:
--   - Eine sichtbare Baerchi-Figur aus dem passenden importierten Pet-Mesh
--     klonen, ggf. einfaerben und im Raum positionieren.
--
-- Ersetzt das fruehere prozedurale BaerchiRig (Parts aus Konfig-Zahlen
-- zusammengesetzt) durch echte gemeshte Modelle (blockybearpet.glb,
-- gummybearpet.glb, ...). Jedes Modell liegt als .rbxm in
-- ReplicatedStorage/Assets — Rojo synct lose .rbxm/.rbxmx-Dateien in einem
-- $path-Ordner automatisch als Instanz, benannt nach dem Dateinamen.
--
-- MEHRERE MODELLE PRO RARITY (statt einem Modell fuer alle 6 Rarities):
--   - "BaerchiTemplate_<Rarity>" (z.B. "BaerchiTemplate_Uncommon") wird
--     genutzt wenn vorhanden — das ist ein bewusst fuer genau diese Rarity
--     gestaltetes Modell und bleibt in seiner ORIGINAL-Farbe (kein Tinting).
--   - Rarities OHNE eigenes Modell fallen auf das gemeinsame
--     "BaerchiTemplate" zurueck und werden mit der Rarity-Farbe eingefaerbt
--     (Platzhalter, bis ein eigenes Modell da ist).
--   - Ausnahme: Common selbst benutzt "BaerchiTemplate" (keine Rarity-
--     Endung noetig, das IST das Standardmodell) und bleibt IMMER in
--     Original-Farbe, nie eingefaerbt.
-- Ein neues Modell fuer eine weitere Rarity braucht also KEINE Code-
-- Aenderung: einfach "BaerchiTemplate_<Rarity>.rbxm" nach
-- src/shared/Assets/ legen (siehe Setup-Schritt unten) — ab dann wird diese
-- Rarity automatisch nicht mehr eingefaerbt.
--
-- Fell-Teile (im GLB mit den "fur"/"candy"-artigen Materialien) werden bei
-- Platzhalter-Rarities mit der Rarity-Farbe eingefaerbt. Schnauze, Nase,
-- Mund und Augen bleiben in JEDEM Modell unangetastet — das ist die
-- Wiedererkennung als eine Marke, nicht die Rarity-Farbe (gleiches Prinzip
-- wie zuvor bei BaerchiRig.SignatureColors).
--
-- ============================================================
-- EINMALIGER SETUP-SCHRITT IN STUDIO PRO MODELL (kann ich nicht
-- automatisieren, weil ich Studio nicht selbst bedienen kann):
--   1. Die .glb-Datei ueber den 3D-Importer in ein leeres Model laden.
--   2. Pruefen, dass die Teile so heissen wie unten in FUR_PART_NAMES:
--      head, ear_left, ear_right, snout, nose, mouth, eye_white_left,
--      eye_pupil_left, eye_white_right, eye_pupil_right, body, leg_left,
--      leg_right. Falls der Importer Namen aendert/dedupliziert (z.B.
--      "head_1"), hier in FUR_PART_NAMES nachziehen.
--   3. Das Model umbenennen:
--        Common     → "BaerchiTemplate"            (Standardmodell, kein Suffix)
--        Uncommon   → "BaerchiTemplate_Uncommon"
--        Rare       → "BaerchiTemplate_Rare"        (folgt bald)
--        usw.
--      und als .rbxm exportieren nach src/shared/Assets/<Name>.rbxm.
--   4. Rojo synct das automatisch als ReplicatedStorage.Assets.<Name>.
-- Fehlt fuer eine Rarity sowohl ihr eigenes Modell als auch das gemeinsame
-- "BaerchiTemplate": BaerchiMesh.build gibt nil zurueck und warnt einmal
-- pro Rarity, die Insel baut sich sonst normal (nur ohne diese Baerchis).
-- ============================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapConfig = require(ReplicatedStorage.Config.MapConfig)
local Types      = require(ReplicatedStorage.Network.Types)

local BaerchiMesh = {}

-- Eigene Baerchis sind etwas groesser als das Template, damit sie neben den
-- gelegten Eiern (EGG_SCALE im LaidEggBuilder) klar die Hauptfigur bleiben.
local BAERCHI_SCALE = 1.15

-- Namen der Parts/MeshParts die die Fellfarbe bekommen (nur bei Platzhalter-
-- Rarities relevant, siehe Kommentar-Kopf). Muss mit den Node-Namen in
-- JEDEM importierten GLB uebereinstimmen (siehe Setup-Schritt oben) —
-- bisher bei blockybearpet.glb und gummybearpet.glb identisch.
local FUR_PART_NAMES: { [string]: boolean } = {
	head      = true,
	ear_left  = true,
	ear_right = true,
	body      = true,
	leg_left  = true,
	leg_right = true,
}

type Resolved = { model: Model, isDedicated: boolean }
local _resolved: { [string]: Resolved } = {}
local _warnedMissing: { [string]: boolean } = {}

-- Findet das Template fuer eine Rarity und ob es ihr EIGENES ist (dann keine
-- Faerbung) oder der gemeinsame Platzhalter (dann Faerbung mit Rarity-Farbe).
local function resolveTemplate(rarity: Types.Rarity): (Model?, boolean)
	local cached = _resolved[rarity]
	if cached then
		return cached.model, cached.isDedicated
	end

	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		return nil, false
	end

	local dedicated = assets:FindFirstChild("BaerchiTemplate_" .. rarity)
	if dedicated and dedicated:IsA("Model") then
		_resolved[rarity] = { model = dedicated, isDedicated = true }
		return dedicated, true
	end

	local fallback = assets:FindFirstChild("BaerchiTemplate")
	if fallback and fallback:IsA("Model") then
		-- Common IST das Standardmodell (kein eigenes "_Common"-Asset noetig)
		-- und bleibt deshalb immer unveraendert. Alle anderen Rarities ohne
		-- eigenes Modell sind hier nur Platzhalter → Faerbung.
		local isDedicated = (rarity == "Common")
		_resolved[rarity] = { model = fallback, isDedicated = isDedicated }
		return fallback, isDedicated
	end

	return nil, false
end

-- Klont ein Template, richtet die Teile her und faerbt optional das Fell.
-- Gemeinsamer Kern von build() und buildEnemy() — der Unterschied zwischen
-- den beiden ist nur, WELCHES Template genommen und OB eingefaerbt wird.
local function cloneAndPrepare(template: Model, furColor: Color3?): Model
	local model = template:Clone()
	model.Name  = "BaerchiMesh"

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true

			-- Bewusst solide (nicht CanCollide=false wie z.B. Deko-Teile):
			-- der Spieler soll sich auf seinen Baerchi draufstellen koennen,
			-- statt durch ihn hindurchzulaufen. Anchored+CanCollide blockiert
			-- zwar Spieler-Charaktere, stoesst aber selbst nichts an — zwei
			-- solide Baerchi-Figuren (z.B. eigener Baerchi und PIT-Gegner)
			-- koennen sich deshalb trotzdem ueberlappend positionieren, ohne
			-- dass sich beide gegenseitig wegschieben.
			descendant.CanCollide = true

			if furColor and FUR_PART_NAMES[descendant.Name] then
				descendant.Color = furColor
			end
		end
	end

	-- Rekursiv suchen: der Importer packt die eigentlichen Teile oft in eine
	-- zusaetzliche Zwischen-Gruppe (z.B. "blocky_bear_pet"), "body" ist also
	-- meist kein direktes Kind des Root-Models.
	if not model.PrimaryPart then
		local body = model:FindFirstChild("body", true)
		if body and body:IsA("BasePart") then
			model.PrimaryPart = body
		end
	end

	return model
end

-- Stellt ein Modell so hin, dass die Unterkante seiner Bounding-Box auf
-- footPos steht. Die Fusshoehe kommt damit aus dem echten Mesh und nicht aus
-- einer Konfig-Zahl — das funktioniert unabhaengig davon wie gross oder klein
-- das exportierte Modell tatsaechlich ist.
--
-- Sammel-Update 1.2 ("kleine Figuren stecken in den Tower-Platten"):
-- Model:GetBoundingBox() ist nach dem PrimaryPart (body) ausgerichtet, nicht
-- nach der Welt. Ist der body eines importierten Modells gekippt (bei den
-- Rarity-eigenen Modellen unterschiedlich), ist size.Y gar nicht die Hoehe —
-- die berechnete Unterkante liegt dann zu hoch oder zu tief, und kleine
-- Figuren verschwinden in der Platte. Die Unterkante kommt deshalb aus den
-- WELT-ausgerichteten Grenzen jedes sichtbaren Teils (worldBottomY).
function BaerchiMesh.worldBoundsY(model: Model): (number?, number?)
	local bottom: number? = nil
	local top: number? = nil
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 1 then
			local cf, sz = d.CFrame, d.Size
			local halfY = 0.5 * (
				math.abs(cf.RightVector.Y) * sz.X
				+ math.abs(cf.UpVector.Y) * sz.Y
				+ math.abs(cf.LookVector.Y) * sz.Z
			)
			local lo, hi = cf.Position.Y - halfY, cf.Position.Y + halfY
			if bottom == nil or lo < (bottom :: number) then bottom = lo end
			if top == nil or hi > (top :: number) then top = hi end
		end
	end
	return bottom, top
end

function BaerchiMesh.worldBottomY(model: Model): number?
	local bottom = BaerchiMesh.worldBoundsY(model)
	return bottom
end

local function standOn(model: Model, footPos: Vector3)
	local boundingCFrame, size = model:GetBoundingBox()
	local bottomY = BaerchiMesh.worldBottomY(model) or (boundingCFrame.Position.Y - size.Y * 0.5)
	local offset  = footPos - Vector3.new(boundingCFrame.Position.X, bottomY, boundingCFrame.Position.Z)
	model:PivotTo(model:GetPivot() + offset)
end

-- Macht eine Figur als MUTIERT erkennbar (seit v11 — ersetzt das fruehere
-- binaere "Inverted", derselbe visuelle Mechanismus, jetzt mit der Farbe der
-- getroffenen Mutations-Stufe statt der festen Komplementaerfarbe).
--
-- Zwei Dinge zusammen, weil eines allein nicht reicht:
--   1. Fell auf die Farbe der Mutations-Stufe (BaerchiConfig.getMutationColor).
--   2. Material auf Neon — die Figur leuchtet.
--
-- Warum die Faerbung hier nochmal passiert, obwohl cloneAndPrepare das schon
-- kann: fuer eine Rarity MIT eigenem Modell faerbt cloneAndPrepare bewusst
-- gar nicht (isDedicated). Ein mutierter Legendary saehe damit exakt aus wie
-- ein normaler — die eine Sache, die auf keinen Fall passieren darf, wenn ein
-- Baerchi eine der seltenen Mutations-Stufen trifft. Deshalb setzt sich eine
-- Mutation auch ueber ein eigenes Modell hinweg.
local function markMutation(model: Model, mutationColor: Color3)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and FUR_PART_NAMES[descendant.Name] then
			descendant.Color    = mutationColor
			descendant.Material = Enum.Material.Neon
		end
	end
end

-- Klont das passende Template fuer diese Rarity, faerbt es falls es nur ein
-- Platzhalter ist, und stellt es bei footPos auf den Boden (Y = Fusshoehe,
-- XZ = Mitte der Standflaeche). Gibt nil zurueck wenn kein Template
-- existiert — MapService faengt das ab.
--
-- `mutationColor` ist gesetzt, wenn dieser Baerchi eine Mutation hat (der
-- Aufrufer holt die Farbe aus BaerchiConfig.getMutationColor). nil = normaler,
-- unmutierter Baerchi.
function BaerchiMesh.build(
	footPos: Vector3,
	rarityColor: Color3,
	rarity: Types.Rarity,
	mutationColor: Color3?
): Model?
	local template, isDedicated = resolveTemplate(rarity)
	if not template then
		if not _warnedMissing[rarity] then
			warn(
				"[BaerchiMesh] Kein Template fuer Rarity " .. rarity .. " gefunden",
				"(weder ReplicatedStorage.Assets.BaerchiTemplate_" .. rarity .. " noch .BaerchiTemplate) —",
				"Baerchis dieser Rarity werden nicht gebaut. Siehe Kommentar-Kopf in BaerchiMesh.luau."
			)
			_warnedMissing[rarity] = true
		end
		return nil
	end

	local model = cloneAndPrepare(template, if isDedicated then nil else rarityColor)
	model:ScaleTo(model:GetScale() * BAERCHI_SCALE)   -- relativ: das Template traegt schon einen eigenen Massstab

	if mutationColor then
		markMutation(model, mutationColor)
	end

	standOn(model, footPos)

	return model
end

-- Baut eine GEGNER-Figur fuer die PIT-Arena: immer das Standard-Modell,
-- immer eingefaerbt.
--
-- Bewusst getrennt von build(): ein Gegner hat keine Rarity, und er soll sich
-- auf den ersten Blick vom eigenen Baerchi unterscheiden — deshalb nie ein
-- Rarity-eigenes Modell, egal welches gerade importiert ist.
function BaerchiMesh.buildEnemy(footPos: Vector3, color: Color3): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local template = assets and assets:FindFirstChild("BaerchiTemplate")

	if not template or not template:IsA("Model") then
		-- Eigene Warnung noetig: build() warnt nur wenn fuer eine Rarity
		-- WEDER ein eigenes NOCH das Standard-Modell existiert. Haben alle
		-- Baerchis eines Spielers ein Rarity-eigenes Modell, faellt das
		-- fehlende Standard-Modell dort gar nicht auf — und der PIT-Kampf
		-- liefe dann ohne jeden Gegner ab, ohne Hinweis irgendwo.
		if not _warnedMissing["__enemy"] then
			warn(
				"[BaerchiMesh] ReplicatedStorage.Assets.BaerchiTemplate fehlt —",
				"die PIT-Gegner werden nicht gebaut. Das Standard-Modell wird",
				"auch dann gebraucht wenn jede Rarity ein eigenes hat."
			)
			_warnedMissing["__enemy"] = true
		end
		return nil
	end

	local model = cloneAndPrepare(template, color)
	model.Name  = "Enemy"
	standOn(model, footPos)

	return model
end

-- Hoehe der Figur (fuer den Billboard-Offset des Namensschilds). Nutzt die
-- echte Bounding-Box statt einer Konfig-Zahl. Faellt auf
-- MapConfig.BAERCHI_FALLBACK_HEIGHT zurueck, falls das Template kaputt/leer
-- importiert wurde (Bounding-Box-Hoehe 0) — sonst wuerde das Namensschild
-- im Boden des Baerchis stecken.
function BaerchiMesh.getHeight(model: Model): number
	local _, size = model:GetBoundingBox()
	if size.Y <= 0 then
		return MapConfig.BAERCHI_FALLBACK_HEIGHT
	end
	return size.Y
end

return BaerchiMesh
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">EggCalculator</string><ProtectedString name="Source"><![CDATA[--!strict
-- EggCalculator.luau
-- ReplicatedStorage/Modules/EggCalculator.luau
--
-- Reine Funktionen fuer das Ei-Legen.
-- Kein State, keine Services — nur Mathe. Genau wie CombatCalculator, nur fuer
-- die andere Haelfte des Spiels.
--
-- ============================================================
-- WARUM DAS EIN EIGENES MODUL IST UND NICHT IN CombatCalculator STEHT
-- ============================================================
-- CombatCalculator beantwortet "wie stark ist dieser Baerchi im Kampf". Das
-- Legeintervall hat damit nichts zu tun: es taucht in keiner Kampfformel auf,
-- und ein Baerchi, der gut legt, ist deswegen nicht besser im PIT.
--
-- Beide Module rechnen aber nach demselben Muster — Basiswert, dann Level,
-- dann Stat-Stufen, dann Mutation. Wer eines von beiden aendert, sollte ins
-- andere schauen.
--
-- ============================================================
-- DIE FORMEL
-- ============================================================
--     Tempo    = 1 + Level-Anteil + Stufen-Anteil
--     Tempo   *= (1 + Mutations-Bonus)         -- 0 ohne Mutation, sonst gestuft
--     Intervall = Grundintervall / Tempo       -- Sekunden pro Ei
--     Intervall = max(Intervall, Untergrenze)
--
-- Level und Stat-Stufen ADDIEREN sich im Tempo, statt sich zu multiplizieren.
-- Das ist bewusst anders als bei den Kampfwerten (dort multipliziert sich
-- alles): beim Kampf soll sich jede Fortschrittsachse mit jeder anderen
-- verstaerken, weil eine mitwachsende Gegenseite existiert. Beim Ei-Legen gibt
-- es die nicht — multiplizierte Achsen wuerden hier nur dafuer sorgen, dass ein
-- ausgebauter Baerchi die Obergrenze in Sekunden fuellt und die Zahlen danach
-- egal sind.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local Types         = require(ReplicatedStorage.Network.Types)
local EggTree       = require(ReplicatedStorage.Modules.EggTree)

local EggCalculator = {}

--------------------------------------------------------------------------------
-- Legeintervall
--------------------------------------------------------------------------------

-- Sekunden, die dieser Baerchi fuer EIN Ei braucht.
--
-- `offline = true` rechnet mit der gebremsten Rate (EggConfig.OFFLINE_SLOWDOWN):
-- die Produktion laeuft weiter, waehrend der Spieler weg ist, aber langsamer.
--
-- Gibt nil zurueck, wenn dieser Baerchi ueberhaupt keine Eier legen kann
-- (unbekannter configId oder leere eggTable). Der Aufrufer laesst ihn dann
-- einfach nicht legen — das ist kein Fehler, sondern ein moeglicher Zustand.
function EggCalculator.getLayIntervalSeconds(baerchi: Types.Baerchi, offline: boolean?): number?
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		return nil
	end

	local base = def.layIntervalSeconds
	if not base or base <= 0 then
		return nil
	end

	if not def.eggTable or #def.eggTable == 0 then
		return nil
	end

	-- Level: jedes Level addiert LAY_LEVEL_GAIN des GRUNDTEMPOS.
	-- Warum linear und nicht exponentiell wie HP/ATK: siehe EggConfig,
	-- Kommentar bei LAY_LEVEL_GAIN.
	local level      = math.max(baerchi.level or 1, 1)
	local levelPart  = (level - 1) * EggConfig.LAY_LEVEL_GAIN

	-- EGG-Stat-Stufen (waechst durch Event-Teilnahme, gedeckelt durch die
	-- Rarity — siehe PromotionConfig.STAT_CAP).
	local statLevels = baerchi.statLevels
	local eggLevels  = if statLevels then (statLevels.egg or 0) else 0
	local statPart   = eggLevels * EggConfig.LAY_STAT_LEVEL_GAIN

	local speed = 1 + levelPart + statPart

	-- Mutation zaehlt EGG als vollwertigen Stat (voller Multiplikator-Anteil),
	-- anders als SPD und PWR mit ihrem gedrittelten Anteil. Siehe
	-- BaerchiConfig.getMutationBonus. Fuer baerchi.mutation == nil liefert das
	-- einen Nullbonus, hier also ohne Sonderfall immer korrekt.
	local mutationBonus = BaerchiConfig.getMutationBonus(baerchi.mutation)
	speed *= (1 + mutationBonus.egg)

	-- Paket 6.5: niedrige Rarities legen schneller (EggConfig.LAY_RARITY_FACTOR).
	local rarityFactor = EggConfig.LAY_RARITY_FACTOR[def.rarity] or 1
	local interval = base * rarityFactor / math.max(speed, 0.01)

	if offline then
		interval *= EggConfig.OFFLINE_SLOWDOWN
	end

	return math.max(interval, EggConfig.MIN_LAY_INTERVAL_SECONDS)
end

--------------------------------------------------------------------------------
-- Welches Ei
--------------------------------------------------------------------------------

-- Wuerfelt den Typ des naechsten Eis aus der persoenlichen Tabelle dieses
-- Baerchis. Gibt nil zurueck, wenn er keine legen kann.
--
-- Die Tabelle ist pro Baerchi verschieden und haengt ausdruecklich NICHT an
-- der Rarity: ein Common kann eine andere Mischung legen als ein Epic. Siehe
-- BaerchiConfig, Kommentar bei eggTable.
function EggCalculator.rollEggType(baerchi: Types.Baerchi): Types.EggType?
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def or not def.eggTable then
		return nil
	end
	return EggConfig.rollEggType(def.eggTable)
end

-- Die Chancen dieses Baerchis als lesbare Liste, absteigend sortiert.
-- Fuer die Anzeige auf der Detailkarte — der Spieler soll sehen koennen, was
-- sein Baerchi ueberhaupt legen kann, ohne es sich zusammenzuzaehlen.
export type ChanceEntry = {
	eggType : Types.EggType,
	percent : number,
}

function EggCalculator.getChances(baerchi: Types.Baerchi): { ChanceEntry }
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def or not def.eggTable then
		return {}
	end

	local total = 0
	for _, entry in def.eggTable do
		if entry.weight > 0 then
			total += entry.weight
		end
	end
	if total <= 0 then
		return {}
	end

	local result: { ChanceEntry } = {}
	for _, entry in def.eggTable do
		if entry.weight > 0 then
			table.insert(result, {
				eggType = entry.eggType,
				percent = entry.weight / total * 100,
			})
		end
	end

	table.sort(result, function(a, b)
		if a.percent ~= b.percent then
			return a.percent > b.percent
		end
		-- Bei Gleichstand nach Namen: die Iteration ueber die Config-Tabelle
		-- ist stabil, aber eine zweite Sortier-Bedingung kostet nichts und
		-- macht die Anzeige garantiert reproduzierbar.
		return a.eggType < b.eggType
	end)

	return result
end

-- INCUBATOR_BREED: wie viele der liegenden Eier vom ausgeruesteten Baerchi
-- stammen (die aus dem Inkubator haben ihre eigene Obergrenze).
function EggCalculator.countOwnLaid(laidEggs: { Types.LaidEgg }?): number
	local n = 0
	for _, egg in laidEggs or {} do
		if not egg.fromIncubator then n += 1 end
	end
	return n
end

-- INCUBATOR_BREED: die Chancen so, wie sie tatsaechlich herauskommen —
-- gesperrte Eier rutschen auf den freien Vorgaenger (EggTree.resolveLaid),
-- genau wie beim Legen und Brueten auf dem Server. Gleiche Eier werden
-- zusammengezaehlt; absteigend sortiert.
function EggCalculator.getResolvedChances(baerchi: Types.Baerchi, eggTree: Types.EggTreeState?): { ChanceEntry }
	local merged: { [string]: number } = {}
	for _, entry in EggCalculator.getChances(baerchi) do
		local eggType = EggTree.resolveLaid(eggTree, entry.eggType)
		merged[eggType] = (merged[eggType] or 0) + entry.percent
	end
	local result: { ChanceEntry } = {}
	for eggType, percent in merged do
		table.insert(result, { eggType = eggType :: Types.EggType, percent = percent })
	end
	table.sort(result, function(a, b)
		if a.percent ~= b.percent then return a.percent > b.percent end
		return a.eggType < b.eggType
	end)
	return result
end

return EggCalculator
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">EggTree</string><ProtectedString name="Source"><![CDATA[--!strict
-- EggTree.luau
-- ReplicatedStorage/Modules/EggTree.luau
--
-- Einzige Zustaendigkeit (v14, Mega Egg Tree):
--   - Aus EggConfig.TREE und dem Spielstand ableiten, welche Knoten frei
--     sind, was jedem Knoten noch fehlt, und welches Ei beim Legen an die
--     Stelle eines gesperrten tritt.
--
-- Reine Funktionen, kein Netzwerk, kein UI. Server (EggService,
-- EggLayService, RebirthService) und Client (EggTreePanel) rechnen mit
-- denselben Funktionen — das Panel zeigt also genau die Bedingungen, die der
-- Server auch prueft.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types         = require(ReplicatedStorage.Network.Types)
local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)

local EggTree = {}

-- Was EggTree vom Spielstand braucht. PlayerData UND PlayerDataUpdate
-- (Client) passen beide hinein.
export type TreeInput = {
	eggTree      : Types.EggTreeState?,
	discovered   : { [string]: boolean }?,
	rebirthCount : number?,
}

export type Condition = {
	kind  : string,         -- "hatch" | "hatchAny" | "index" | "rebirth" | "blueprint"
	egg   : Types.EggType?, -- bei hatch
	rarity: Types.Rarity?,  -- bei index
	have  : number,
	need  : number,
	done  : boolean,
	-- nur bei hatchAny: die einzelnen Eier
	parts : { { egg: Types.EggType, have: number, need: number, done: boolean } }?,
	needParts : number?,
}

export type NodeProgress = {
	egg        : Types.EggType,
	unlocked   : boolean,
	ready      : boolean,      -- alle Bedingungen erfuellt (wird beim naechsten evaluate frei)
	bypassed   : boolean,      -- Blaupause eingesetzt
	conditions : { Condition },
}

function EggTree.newState(): Types.EggTreeState
	return {
		unlocked   = { BasicEgg = true, SugarEgg = true },
		hatched    = {},
		pressed    = {},
		blueprints = 0,
		bypass     = {},
	}
end

-- Fehlende Felder eines (alten oder kaputten) Stands ergaenzen.
function EggTree.sanitize(state: any): Types.EggTreeState
	if typeof(state) ~= "table" then
		return EggTree.newState()
	end
	if typeof(state.unlocked) ~= "table" then state.unlocked = {} end
	if typeof(state.hatched) ~= "table" then state.hatched = {} end
	if typeof(state.pressed) ~= "table" then state.pressed = {} end
	if typeof(state.bypass) ~= "table" then state.bypass = {} end
	if typeof(state.blueprints) ~= "number" then state.blueprints = 0 end
	for eggId, node in EggConfig.TREE do
		if node.start then state.unlocked[eggId] = true end
	end
	-- Unbekannte Ei-Typen (aus einer spaeteren/aelteren Config) entfernen.
	for eggId in state.unlocked do
		if not EggConfig.data[eggId :: Types.EggType] then state.unlocked[eggId] = nil end
	end
	return state :: Types.EggTreeState
end

function EggTree.isUnlocked(state: Types.EggTreeState?, eggType: Types.EggType): boolean
	if not state then
		local node = EggConfig.TREE[eggType]
		return node ~= nil and node.start == true
	end
	return state.unlocked[eggType] == true
end

-- Wie viele VERSCHIEDENE Baerchis dieser Rarity der Spieler entdeckt hat.
function EggTree.countDiscovered(discovered: { [string]: boolean }?, rarity: Types.Rarity): number
	if not discovered then return 0 end
	local n = 0
	for configId, seen in discovered do
		if seen then
			local def = BaerchiConfig.getById(configId)
			if def and def.rarity == rarity then
				n += 1
			end
		end
	end
	return n
end

local function hatchedOf(state: Types.EggTreeState?, egg: Types.EggType): number
	if not state then return 0 end
	return state.hatched[egg] or 0
end

-- Alle Bedingungen eines Knotens mit aktuellem Stand.
function EggTree.getProgress(input: TreeInput, eggType: Types.EggType): NodeProgress
	local state = input.eggTree
	local node = EggConfig.TREE[eggType] or {}
	local bypassed = state ~= nil and state.bypass[eggType] == true
	local conditions: { Condition } = {}

	if not node.start then
		if node.hatch and not bypassed then
			for _, req in node.hatch do
				local have = hatchedOf(state, req.egg)
				table.insert(conditions, {
					kind = "hatch", egg = req.egg, have = math.min(have, req.count),
					need = req.count, done = have >= req.count,
				})
			end
		end

		if node.hatchAnyOf and not bypassed then
			local parts = {}
			local doneCount = 0
			for _, req in node.hatchAnyOf.of do
				local have = hatchedOf(state, req.egg)
				local done = have >= req.count
				if done then doneCount += 1 end
				table.insert(parts, { egg = req.egg, have = math.min(have, req.count), need = req.count, done = done })
			end
			table.insert(conditions, {
				kind = "hatchAny", have = doneCount, need = node.hatchAnyOf.need,
				done = doneCount >= node.hatchAnyOf.need, parts = parts, needParts = node.hatchAnyOf.need,
			})
		end

		if node.index and not bypassed then
			local have = EggTree.countDiscovered(input.discovered, node.index.rarity)
			table.insert(conditions, {
				kind = "index", rarity = node.index.rarity, have = math.min(have, node.index.count),
				need = node.index.count, done = have >= node.index.count,
			})
		end

		if bypassed then
			table.insert(conditions, { kind = "blueprint", have = 1, need = 1, done = true })
		end

		if node.rebirth and node.rebirth > 0 then
			local have = input.rebirthCount or 0
			table.insert(conditions, {
				kind = "rebirth", have = math.min(have, node.rebirth), need = node.rebirth,
				done = have >= node.rebirth,
			})
		end
	end

	local ready = true
	for _, c in conditions do
		if not c.done then ready = false break end
	end

	return {
		egg        = eggType,
		unlocked   = EggTree.isUnlocked(state, eggType),
		ready      = ready,
		bypassed   = bypassed,
		conditions = conditions,
	}
end

-- Prueft alle Knoten und schaltet frei, was bereit ist. Mehrere Runden, weil
-- eine Freischaltung keine andere ausloest (Bedingungen haengen an
-- Hatch-Zaehlern, nicht an Freischaltungen) — eine Runde reicht, die
-- Schleife ist nur Vorsorge. Gibt die NEU freien Eier zurueck.
function EggTree.evaluate(input: TreeInput): { Types.EggType }
	local state = input.eggTree
	if not state then return {} end
	local newly: { Types.EggType } = {}
	for _, eggId in EggConfig.getOrderedIds() do
		if not state.unlocked[eggId] then
			local progress = EggTree.getProgress(input, eggId)
			if progress.ready then
				state.unlocked[eggId] = true
				table.insert(newly, eggId)
			end
		end
	end
	return newly
end

-- Kann auf diesem Knoten eine Blaupause eingesetzt werden? Nur, wenn er noch
-- gesperrt ist, nicht schon eine hat, kein reiner Rebirth-Knoten ist und sein
-- Vorgaenger (bzw. beim Kometen-Ei: zwei der drei Endeier) schon frei ist.
-- So schaltet eine Blaupause immer das NAECHSTE Ei frei, nie eins mitten im
-- Nirgendwo.
function EggTree.canUseBlueprint(input: TreeInput, eggType: Types.EggType): boolean
	local state = input.eggTree
	if not state or state.blueprints <= 0 then return false end
	if state.unlocked[eggType] or state.bypass[eggType] then return false end
	local node = EggConfig.TREE[eggType]
	local egg = EggConfig.data[eggType]
	if not node or not egg or node.start then return false end
	if not node.hatch and not node.hatchAnyOf then return false end
	if egg.parent then
		return state.unlocked[egg.parent] == true
	end
	if node.hatchAnyOf then
		local n = 0
		for _, req in node.hatchAnyOf.of do
			if state.unlocked[req.egg] then n += 1 end
		end
		return n >= node.hatchAnyOf.need
	end
	return false
end

-- ============================================================
-- LEGE-FALLBACK
-- ============================================================
-- Wuerfelt ein Baerchi ein noch GESPERRTES Ei, wird stattdessen das hoechste
-- freigeschaltete Ei desselben Pfads gelegt — also der naechste freie
-- Vorgaenger. Im Stamm endet die Kette bei Basis/Zucker, die immer frei
-- sind. Nichts geht verloren, nichts wird uebersprungen.
--
-- Sonderfaelle:
--   * Kometen-Ei (kein Vorgaenger im eigenen Pfad): das hoechste freie der
--     drei Endeier, sonst deren Fallback.
--   * Ascensions-Pfad: wird NIE gelegt (Sammel-Update 05.10., Paket 6.2).
--     Ascension-Eier gibt es nur aus Rebirth- und besonderen Meilensteinen.
--     Steht doch einmal eins in einer Lege-Tabelle (alter Stand, Tippfehler),
--     wird daraus ein Zucker-Ei statt eines Geschenks.
function EggTree.resolveLaid(state: Types.EggTreeState?, eggType: Types.EggType): Types.EggType
	local def = EggConfig.data[eggType]
	if def and def.path == "Ascension" then
		return "SugarEgg"
	end
	if EggTree.isUnlocked(state, eggType) then
		return eggType
	end

	local egg = EggConfig.data[eggType]
	if not egg then
		return "BasicEgg"
	end

	if egg.parent then
		return EggTree.resolveLaid(state, egg.parent)
	end

	local node = EggConfig.TREE[eggType]
	if node and node.hatchAnyOf then
		local best: Types.EggType = "SugarEgg"
		local bestTier = 0
		for _, req in node.hatchAnyOf.of do
			local candidate = EggTree.resolveLaid(state, req.egg)
			local tier = EggConfig.data[candidate].tier
			if tier > bestTier then
				best, bestTier = candidate, tier
			end
		end
		return best
	end

	return "SugarEgg"
end

-- Void-Identitaet: ein gelegtes Ei kann eine Stufe aufsteigen (Chance je
-- Baerchi, BaerchiConfig.layUpgradeChance). Ziel ist die naechste Stufe im
-- Pfad des Eis — beim Zucker-Ei die im Pfad des Baerchis (Void-Baerchi:
-- Nebel-Ei). Nur, wenn das Ziel schon frei ist; sonst nil (kein Aufstieg).
function EggTree.upgradeTarget(state: Types.EggTreeState?, eggType: Types.EggType, petPath: string?): Types.EggType?
	local egg = EggConfig.data[eggType]
	if not egg or egg.path == "Ascension" then return nil end
	local prefer: string? = nil
	if egg.path == "Stamm" and eggType == "SugarEgg" then
		prefer = if petPath == "Gold" or petPath == "Void" then petPath else "Void"
	end
	local target = EggConfig.getNextInPath(eggType, prefer :: any)
	if target and EggTree.isUnlocked(state, target) then
		return target
	end
	return nil
end

-- Das hoechste freie Ei ueber alle Pfade ausser Ascension (Events).
-- Bei Gleichstand der Stufe gewinnt die kleinere sortOrder (stabil).
function EggTree.highestUnlocked(state: Types.EggTreeState?): Types.EggType
	local best: Types.EggType = "SugarEgg"
	local bestTier, bestOrder = 0, math.huge
	for eggId, egg in EggConfig.data do
		if egg.path ~= "Ascension" and not egg.special and EggTree.isUnlocked(state, eggId) then
			if egg.tier > bestTier or (egg.tier == bestTier and egg.sortOrder < bestOrder) then
				best, bestTier, bestOrder = eggId, egg.tier, egg.sortOrder
			end
		end
	end
	return best
end

-- "Sprung-Ei" (Events): eine Stufe ueber dem hoechsten freien Ei. Gewaehlt
-- wird zufaellig unter den gesperrten Kindern freier Knoten (ohne
-- Ascension). Gibt nil, wenn es keins gibt (alles frei).
function EggTree.pickJumpEgg(state: Types.EggTreeState?): Types.EggType?
	local options: { Types.EggType } = {}
	for _, eggId in EggConfig.getOrderedIds() do
		local egg = EggConfig.data[eggId]
		if egg.path ~= "Ascension" and not EggTree.isUnlocked(state, eggId) then
			local parentFree = (egg.parent ~= nil and EggTree.isUnlocked(state, egg.parent :: Types.EggType))
			if not egg.parent then
				local node = EggConfig.TREE[eggId]
				if node and node.hatchAnyOf then
					local n = 0
					for _, req in node.hatchAnyOf.of do
						if EggTree.isUnlocked(state, req.egg) then n += 1 end
					end
					parentFree = n >= node.hatchAnyOf.need
				end
			end
			if parentFree then table.insert(options, eggId) end
		end
	end
	if #options == 0 then return nil end
	return options[math.random(1, #options)]
end

-- Erwartete Rarity (1 = Common ... 12 = Omega) eines Eis — fuer Pruefskripte
-- und die Anzeige "Ø".
function EggTree.expectedRarity(eggType: Types.EggType): number
	local dist = EggConfig.RARITY_DIST[eggType]
	if not dist then return 0 end
	local sum, total = 0, 0
	for rarity, percent in dist do
		sum += BaerchiConfig.getRarityIndex(rarity :: Types.Rarity) * percent
		total += percent
	end
	return if total > 0 then sum / total else 0
end

return EggTree
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">GuideSteps</string><ProtectedString name="Source"><![CDATA[--!strict
-- GuideSteps.luau
-- ReplicatedStorage/Modules/GuideSteps.luau
--
-- Einzige Zustaendigkeit:
--   - Aus dem Spielstand ableiten, welcher Fuehrungsschritt gerade dran ist
--     (reine Funktion, keine Roblox-Dienste, kein eigenes Feld im Spielstand)
--
-- Kontext: HBB Paket 2. Ein neues Kind soll ohne Text sehen, was als
-- Naechstes kommt. Der Client (GuideController) zeigt den Schritt als Beam in
-- der Welt oder als pulsierenden Pfeil am Knopf.
--
-- Jeder Schritt endet, sobald seine Bedingung aus den Daten erfuellt ist.
-- Ein Tutorial-Fortschritt wird nirgends gespeichert.
--
-- Reihenfolge (Abweichung vom Plan-Vorschlag, siehe Bericht): ein frisches
-- Konto hat noch keinen Baerchi und damit keine gelegten Eier. Deshalb zuerst
-- oeffnen, dann kaempfen; "gelegtes Ei einsammeln" kommt, sobald eines liegt.
--
-- Keine requires: das Modul laeuft unveraendert im Luau-Test
-- (tools/luau-tests/guide_steps.test.lua).

-- Sammel-Update 05.10. (Paket 3.5): Einsteiger-Kette Ei oeffnen -> kaempfen ->
-- Waben holen und im Recycler abgeben -> Gebaeude verbessern -> Event. Jeder
-- Schritt bekommt im Client einen Satz, was er bringt ("guide.<step>").
--
-- 08.10. (Tower-Terminal): nach dem ersten Schaffen von Tower I der Schritt
-- "tower": zum Terminal an der Bruecke, dort zur Karte von Tower II. Fertig,
-- sobald ein anderer Tower gewaehlt ist oder dort schon gekaempft wurde.
-- Ausnahme von der Veteranen-Regel (siehe towerSwitchPending).
export type Step = "hatch" | "fight" | "collect" | "merchant" | "combs" | "upgrade" | "event" | "tower"

-- Nur die Felder, die hier gelesen werden. PlayerDataUpdate (Client) und
-- PlayerData (Server) passen beide hinein.
export type View = {
	rebirthCount : number,
	island : {
		baerchis      : { [string]: any },
		eggStock      : { [string]: number },
		laidEggs      : { any },
		towerProgress : { [string]: number }?,
		buildings     : { [string]: { level: number } }?,   -- Sammel-Update 3.5
		recycler      : { level: number }?,
	},
	towers : { records: { [string]: number }, selected: string?, unlocked: { [string]: boolean }? }?,
	quests : { chainDone: number }?,
	stats  : { totalEventsCompleted: number?, totalCombsDelivered: number? }?,
	gummies : number?,
}

-- Optionen, die der Aufrufer aus Configs mitgibt (haelt das Modul frei von
-- requires). merchantPrice = Preis eines Basis-Eis beim Haendler; nil = der
-- Haendler-Schritt ist aus (Flag MAP_V2_MERCHANT).
export type Options = {
	merchantPrice : number?,
}

local GuideSteps = {}

-- Ab hier gilt ein Spielstand nicht mehr als neu: kein Schritt mehr.
GuideSteps.VETERAN_CHAIN_DONE = 4

local function isEmpty(map: { [any]: any }?): boolean
	return map == nil or next(map) == nil
end

local function countMap(map: { [any]: number }): number
	local total = 0
	for _, n in map do
		total += n
	end
	return total
end

function GuideSteps.isVeteran(view: View): boolean
	if (view.rebirthCount or 0) > 0 then return true end
	local quests = view.quests
	return quests ~= nil and (quests.chainDone or 0) >= GuideSteps.VETERAN_CHAIN_DONE
end

function GuideSteps.hasFought(view: View): boolean
	local towers = view.towers
	if towers and not isEmpty(towers.records) then return true end
	return not isEmpty(view.island.towerProgress)
end

-- Sammel-Update 3.5: irgendein Gebaeude (oder der Recycler) ueber Level 1.
function GuideSteps.hasUpgraded(view: View): boolean
	local recycler = view.island.recycler
	if recycler and (recycler.level or 1) > 1 then return true end
	for _, building in view.island.buildings or {} do
		if (building.level or 1) > 1 then return true end
	end
	return false
end

function GuideSteps.eventsDone(view: View): number
	local stats = view.stats
	return if stats then (stats.totalEventsCompleted or 0) else 0
end

-- 08.10.: Tower II ist frei (Tower I geschafft), aber der Spieler hat noch
-- nie gewechselt: weiter in Tower I gewaehlt und in keinem anderen Tower
-- gekaempft. Nur ohne Rebirth.
--
-- Bewusst VOR der Veteranen-Regel "4 Ketten-Quests": die ist nach fuenf
-- gewonnenen Kaempfen erfuellt, also lange bevor jemand Tower I schafft —
-- mit ihr saehe diesen Schritt praktisch niemand. Sie schuetzt alte Konten
-- vor der Einfuehrung; das Umstellen ist dagegen fuer jeden neu (Annahme,
-- im Bericht). Die Rebirth-Regel gilt weiter.
function GuideSteps.towerSwitchPending(view: View): boolean
	if (view.rebirthCount or 0) > 0 then return false end
	local towers = view.towers
	if not towers or not towers.unlocked or towers.unlocked.II ~= true then return false end
	if (towers.selected or "I") ~= "I" then return false end
	for towerId, record in towers.records do
		if towerId ~= "I" and record > 0 then return false end
	end
	return true
end

-- Der aktuelle Schritt oder nil (fertig bzw. kein neuer Spieler).
function GuideSteps.current(view: View, options: Options?): Step?
	if GuideSteps.towerSwitchPending(view) then
		return "tower"
	end
	if GuideSteps.isVeteran(view) then
		return nil
	end

	local island = view.island
	local hasBaerchi = not isEmpty(island.baerchis)
	local eggsInStock = countMap(island.eggStock)

	-- 1. Ei oeffnen: noch kein Baerchi, aber ein Ei im Lager
	if not hasBaerchi then
		if eggsInStock > 0 then
			return "hatch"
		end
		-- Kein Ei, kein Baerchi: zum Haendler, wenn es den Schritt gibt
		local price = if options then options.merchantPrice else nil
		if price and (view.gummies or 0) >= price then
			return "merchant"
		end
		return nil
	end

	-- 2. Erster Kampf
	if not GuideSteps.hasFought(view) then
		return "fight"
	end

	-- 3. Gelegtes Ei einsammeln (nur waehrend der Einfuehrung)
	local onboarding = GuideSteps.eventsDone(view) == 0
	if onboarding and #island.laidEggs > 0 then
		return "collect"
	end

	-- 4. Sammel-Update 3.5: Waben holen und im Recycler abgeben
	local stats = view.stats
	if onboarding and stats and (stats.totalCombsDelivered or 0) == 0 then
		return "combs"
	end

	-- 5. Sammel-Update 3.5: ein Gebaeude verbessern
	if onboarding and not GuideSteps.hasUpgraded(view) then
		return "upgrade"
	end

	-- 6. Erstes Event (der Client zeigt diesen Schritt nur kurz, Paket 3.2)
	if onboarding then
		return "event"
	end

	-- 5. Kein Ei mehr (weder im Lager noch auf dem Plot), Gummies reichen:
	-- zum Haendler (HBB Paket 5, nur solange der Spieler neu ist)
	local price = if options then options.merchantPrice else nil
	if price and eggsInStock == 0 and #island.laidEggs == 0 and (view.gummies or 0) >= price then
		return "merchant"
	end

	return nil
end

return GuideSteps
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">IncubatorRules</string><ProtectedString name="Source"><![CDATA[--!strict
-- IncubatorRules.luau
-- ReplicatedStorage/Modules/IncubatorRules.luau
--
-- Einzige Zustaendigkeit:
--   - Die Rechenregeln des Inkubators als reine Funktionen (Sammel-Update
--     05.10., Paket 8): Freischaltung, Platz-Zahl, Brutzeit, fertig?,
--     Beschleunigungs-Kosten, Ausbau-Kosten.
--
-- Keine Roblox-Dienste, keine Zeit-Abfrage: `now` kommt immer von aussen.
-- Damit laeuft die Zeitrechnung (auch der Offline-Fall) im reinen Test
-- (tools/luau-tests/incubator.test.lua) und auf Server und Client gleich.
--
-- WARUM ZEITMARKEN STATT TIMER: wie Honig und Recycler. Ein Platz traegt
-- startedAt/finishAt; fertig ist er, sobald now >= finishAt — egal, ob der
-- Spieler dazwischen offline war oder der Server neu gestartet ist. Kein
-- Thread pro Ei.

local Types             = require(script.Parent.Parent.Network.Types)
local IncubatorConfig   = require(script.Parent.Parent.Config.IncubatorConfig)
local EggConfig         = require(script.Parent.Parent.Config.EggConfig)
local EconomyConfig     = require(script.Parent.Parent.Config.EconomyConfig)
local IndexRewardConfig = require(script.Parent.Parent.Config.IndexRewardConfig)

local IncubatorRules = {}

-- Frei ab dem ersten Kampf (Entscheidung 11.6). Gleiche Bedingung wie
-- UnlockRules.hasFought, aber nur aus den gespeicherten Werten.
function IncubatorRules.isUnlocked(data: any): boolean
	if (data.rebirthCount or 0) > 0 then return true end
	local towers = data.towers
	if towers and towers.records and next(towers.records) ~= nil then return true end
	local stats = data.stats or {}
	return (stats.totalFightsWon or 0) + (stats.totalFightsLost or 0) > 0
end

-- Plaetze aus Level, Rebirths und Index-Belohnungen, hoechstens MAX_SLOTS.
function IncubatorRules.slotCount(level: number, rebirthCount: number, indexClaimed: { [string]: boolean }?): number
	local n = 0
	for _, step in IncubatorConfig.SLOTS_BY_LEVEL do
		if level >= step.level then n = step.slots end
	end
	if rebirthCount >= IncubatorConfig.REBIRTH_BONUS_FROM then n += 1 end
	n += IndexRewardConfig.incubatorSlots(indexClaimed)
	return math.clamp(n, 1, IncubatorConfig.MAX_SLOTS)
end

function IncubatorRules.slotCountFor(data: any): number
	local incubator = data.island and data.island.incubator
	local level = if incubator then incubator.level or 1 else 1
	--------------------------------------------------------------------------------
-- INCUBATOR_BREED: Baerchis im Inkubator
--------------------------------------------------------------------------------

-- Sekunden pro gebruetetes Ei fuer diese Rarity auf diesem Level.
-- `offline` bremst wie beim Legen (offlineSlowdown, vom Aufrufer).
function IncubatorRules.breedSeconds(rarity: string, level: number, offlineSlowdown: number?): number
	local base = IncubatorConfig.BREED_SECONDS_BY_RARITY[rarity] or IncubatorConfig.BREED_DEFAULT_SECONDS
	local seconds = base / IncubatorRules.speed(level) * (offlineSlowdown or 1)
	return math.max(1, math.floor(seconds + 0.5))
end

-- Wie viele Eier seit `lastEggAt` faellig sind (0, wenn keins).
function IncubatorRules.breedDue(lastEggAt: number, now: number, seconds: number): number
	if seconds <= 0 or now <= lastEggAt then return 0 end
	return math.floor((now - lastEggAt) / seconds)
end

-- Der Eintrag fuer Platz `index` in `breeders`, oder nil.
function IncubatorRules.findBreeder(breeders: { Types.IncubatorBreeder }?, index: number): (Types.IncubatorBreeder?, number?)
	for i, entry in breeders or {} do
		if entry.slot == index then return entry, i end
	end
	return nil, nil
end

-- Sitzt dieser Baerchi im Inkubator? Gibt den Platz zurueck.
function IncubatorRules.breederSlotOf(breeders: { Types.IncubatorBreeder }?, uid: string): number?
	for _, entry in breeders or {} do
		if entry.uid == uid then return entry.slot end
	end
	return nil
end

-- Der erste freie Baerchi-Platz (1 .. count), oder nil.
function IncubatorRules.firstFreeBreeder(breeders: { Types.IncubatorBreeder }?, count: number): number?
	for index = 1, count do
		if not IncubatorRules.findBreeder(breeders, index) then return index end
	end
	return nil
end

-- Darf dieser Baerchi hinein? Gibt (ok, Fehler-Schluessel) zurueck.
-- Der ausgeruestete legt schon selbst — er bleibt draussen.
function IncubatorRules.canBreed(island: any, uid: string): (boolean, string?)
	if not island.baerchis[uid] then return false, "err.baerchi_not_found" end
	if island.equippedUid == uid then return false, "err.incubator_equipped" end
	local incubator = island.incubator
	if incubator and IncubatorRules.breederSlotOf(incubator.breeders, uid) then
		return false, "err.incubator_already_in"
	end
	return true, nil
end

return IncubatorRules.slotCount(level, data.rebirthCount or 0, data.indexClaimed)
end

-- Tempo-Faktor des Levels (1 auf Level 1).
function IncubatorRules.speed(level: number): number
	return 1 + math.max(0, math.floor(level) - 1) * IncubatorConfig.SPEED_PER_LEVEL
end

-- Brutzeit in Sekunden fuer dieses Ei auf diesem Level.
function IncubatorRules.brewSeconds(eggType: Types.EggType, level: number): number
	local egg = EggConfig.data[eggType]
	local tier = if egg then egg.tier else 1
	local base = IncubatorConfig.BREW_SECONDS_BY_TIER[tier] or IncubatorConfig.BREW_SECONDS_BY_TIER[11]
	return math.max(1, math.floor(base / IncubatorRules.speed(level) + 0.5))
end

-- Muss dieses Ei in den Inkubator (statt sofort aufzugehen)? Nur, wenn der
-- Inkubator schon frei ist — vorher geht alles sofort (sonst haengt ein
-- neuer Spieler mit einem gelegten Gold-Ei fest).
function IncubatorRules.requiresIncubator(eggType: Types.EggType, unlocked: boolean): boolean
	if not unlocked then return false end
	local egg = EggConfig.data[eggType]
	if not egg then return false end
	return egg.tier > IncubatorConfig.INSTANT_MAX_TIER or egg.special == true
end

function IncubatorRules.isReady(slot: Types.IncubatorSlot, now: number): boolean
	return now >= slot.finishAt
end

function IncubatorRules.remaining(slot: Types.IncubatorSlot, now: number): number
	return math.max(0, slot.finishAt - now)
end

-- Anteil 0..1 (fuer Fortschrittsbalken).
function IncubatorRules.progress(slot: Types.IncubatorSlot, now: number): number
	local total = math.max(1, slot.finishAt - slot.startedAt)
	return math.clamp((now - slot.startedAt) / total, 0, 1)
end

-- GoldGummies fuer "sofort fertig" (0 = schon fertig).
function IncubatorRules.speedUpCost(slot: Types.IncubatorSlot, now: number): number
	local left = IncubatorRules.remaining(slot, now)
	if left <= 0 then return 0 end
	return math.max(1, math.ceil(left / 60)) * IncubatorConfig.SPEEDUP_GOLD_PER_MINUTE
end

-- Kosten fuer Level `targetLevel` (nil = gibt es nicht).
function IncubatorRules.upgradeCost(targetLevel: number): { gummies: number, goldGummies: number }?
	if targetLevel < 2 or targetLevel > IncubatorConfig.MAX_LEVEL then return nil end
	local base = EconomyConfig.HONEY_UPGRADE_COSTS[targetLevel]
	if not base then return nil end
	return {
		gummies     = math.floor(base.gummies * IncubatorConfig.COST_FACTOR),
		goldGummies = math.floor((base.goldGummies or 0) * IncubatorConfig.COST_FACTOR),
	}
end

-- Der Eintrag in `slots` fuer Platz `index`, oder nil (frei).
function IncubatorRules.findSlot(slots: { Types.IncubatorSlot }, index: number): (Types.IncubatorSlot?, number?)
	for i, entry in slots do
		if entry.slot == index then return entry, i end
	end
	return nil, nil
end

-- Der erste freie Platz (1 .. count), oder nil.
function IncubatorRules.firstFree(slots: { Types.IncubatorSlot }, count: number): number?
	for index = 1, count do
		if not IncubatorRules.findSlot(slots, index) then return index end
	end
	return nil
end

--------------------------------------------------------------------------------
-- INCUBATOR_BREED: Baerchis im Inkubator
--------------------------------------------------------------------------------

-- Sekunden pro gebruetetes Ei fuer diese Rarity auf diesem Level.
-- `offline` bremst wie beim Legen (offlineSlowdown, vom Aufrufer).
function IncubatorRules.breedSeconds(rarity: string, level: number, offlineSlowdown: number?): number
	local base = IncubatorConfig.BREED_SECONDS_BY_RARITY[rarity] or IncubatorConfig.BREED_DEFAULT_SECONDS
	local seconds = base / IncubatorRules.speed(level) * (offlineSlowdown or 1)
	return math.max(1, math.floor(seconds + 0.5))
end

-- Wie viele Eier seit `lastEggAt` faellig sind (0, wenn keins).
function IncubatorRules.breedDue(lastEggAt: number, now: number, seconds: number): number
	if seconds <= 0 or now <= lastEggAt then return 0 end
	return math.floor((now - lastEggAt) / seconds)
end

-- Der Eintrag fuer Platz `index` in `breeders`, oder nil.
function IncubatorRules.findBreeder(breeders: { Types.IncubatorBreeder }?, index: number): (Types.IncubatorBreeder?, number?)
	for i, entry in breeders or {} do
		if entry.slot == index then return entry, i end
	end
	return nil, nil
end

-- Sitzt dieser Baerchi im Inkubator? Gibt den Platz zurueck.
function IncubatorRules.breederSlotOf(breeders: { Types.IncubatorBreeder }?, uid: string): number?
	for _, entry in breeders or {} do
		if entry.uid == uid then return entry.slot end
	end
	return nil
end

-- Der erste freie Baerchi-Platz (1 .. count), oder nil.
function IncubatorRules.firstFreeBreeder(breeders: { Types.IncubatorBreeder }?, count: number): number?
	for index = 1, count do
		if not IncubatorRules.findBreeder(breeders, index) then return index end
	end
	return nil
end

-- Darf dieser Baerchi hinein? Gibt (ok, Fehler-Schluessel) zurueck.
-- Der ausgeruestete legt schon selbst — er bleibt draussen.
function IncubatorRules.canBreed(island: any, uid: string): (boolean, string?)
	if not island.baerchis[uid] then return false, "err.baerchi_not_found" end
	if island.equippedUid == uid then return false, "err.incubator_equipped" end
	local incubator = island.incubator
	if incubator and IncubatorRules.breederSlotOf(incubator.breeders, uid) then
		return false, "err.incubator_already_in"
	end
	return true, nil
end

return IncubatorRules
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">UnlockRules</string><ProtectedString name="Source"><![CDATA[--!strict
-- UnlockRules.luau
-- ReplicatedStorage/Modules/UnlockRules.luau
--
-- Einzige Zustaendigkeit:
--   - Aus dem Spielstand ableiten, welche Bedienelemente ein Spieler schon
--     sieht (reine Funktion, keine Roblox-Dienste)
--
-- Kontext: HBB Paket 3 (progressive Freischaltung). Die erste Sitzung zeigt
-- eine Waehrung, zwei Kacheln (Eier, Baerchis) und den Fight-Knopf; alles
-- andere kommt, wenn der Spieler es braucht.
--
-- Die Freischaltung ist REIN KOSMETISCH. Der Server sperrt nichts; wer ein
-- Panel auf anderem Weg erreicht, darf es benutzen. Kein Spielstand-Wert
-- haengt an dieser Tabelle.
--
-- Jede Regel ist MONOTON: einmal frei, immer frei. Wo die Datenquelle das
-- nicht ist (Waehrung, Anzahl Baerchis), steht ein monotoner Ersatz (Zaehler
-- in stats) — und zusaetzlich gilt ein Element als frei, sobald es in
-- `uiSeen` steht (Latch, gesetzt von UiStateService).
--
-- Keine requires: laeuft unveraendert im Luau-Test
-- (tools/luau-tests/unlock_rules.test.lua).

export type View = {
	rebirthCount : number,
	goldGummies  : number,
	island : {
		baerchis      : { [string]: any },
		towerProgress : { [string]: number }?,
	},
	towers     : { records: { [string]: number } }?,
	discovered : { [string]: boolean }?,
	eggTree    : { unlocked: { [string]: boolean } }?,
	stats      : { [string]: number }?,
	uiSeen     : { [string]: boolean }?,
}

local UnlockRules = {}

-- Alle Element-IDs. Zugleich die Whitelist fuer RequestMarkUiSeen.
UnlockRules.ELEMENTS = {
	"pill_gummies", "tile_eggs", "tile_bears", "button_fight",
	"button_event", "tile_leaderboard", "tile_daily", "pill_gold",
	"tile_tree", "tab_upgrade", "charms", "recycling",
	"pill_rank", "pill_rebirth", "index", "tile_shop",
	"tile_incubator",   -- Sammel-Update 05.10. (Paket 8): ab dem ersten Kampf
	"tile_building",    -- Sammel-Update 05.10. (Paket 3.5): Gebaeude verbessern, ab dem ersten Kampf
	-- Sammel-Update 05.10. (Paket 3.4): einmalige Waehrungs-Hinweise. Nie von
	-- selbst "sichtbar" (Bedingung false), nur als gesehen-Markierung.
	"hint_gummies", "hint_gold",
}

-- Schwellen (Default-Annahmen aus dem Plan, im Bericht benannt)
UnlockRules.TREE_HATCHED       = 10
UnlockRules.UPGRADE_HATCHED    = 2
UnlockRules.CHARMS_TOWER_I     = 15
UnlockRules.RECYCLE_HATCHED    = 21   -- "mehr als 20 Baerchis" (monotoner Ersatz)
UnlockRules.INDEX_DISCOVERED   = 3
-- Paket 10: Shop ab der zweiten Sitzung (stats.sessions, PlayerService zaehlt).
-- SHOP_ENABLED spiegelt FeatureFlags.SHOP_V1: dieses Modul hat bewusst keine
-- requires (laeuft im reinen Luau-Test), deshalb setzen ShopService (Server)
-- und ShopPanel (Client) den Wert beim Start.
UnlockRules.SHOP_ENABLED       = false
UnlockRules.SHOP_SESSIONS      = 2

local ALWAYS: { [string]: boolean } = {
	pill_gummies = true, tile_eggs = true, tile_bears = true, button_fight = true,
}
UnlockRules.ALWAYS = ALWAYS

local function count(map: { [any]: any }?): number
	local n = 0
	if map then
		for _ in map do n += 1 end
	end
	return n
end

local function stat(view: View, key: string): number
	local stats = view.stats
	return if stats then (stats[key] or 0) else 0
end

-- Erster beendeter Kampf: Rekord in irgendeinem Tower, gespeicherter
-- letzter Lauf, oder ein Kampf-Zaehler.
function UnlockRules.hasFought(view: View): boolean
	local towers = view.towers
	if towers and next(towers.records) ~= nil then return true end
	local progress = view.island.towerProgress
	if progress and next(progress) ~= nil then return true end
	return stat(view, "totalFightsWon") + stat(view, "totalFightsLost") > 0
end

-- Bedingung ohne Latch
local function condition(view: View, id: string): boolean
	if ALWAYS[id] then return true end
	local fought = UnlockRules.hasFought(view)
	local hatched = stat(view, "totalHatched")
	local rebirths = view.rebirthCount or 0

	if id == "button_event" or id == "tile_leaderboard" or id == "tile_daily" or id == "tile_incubator" or id == "tile_building" then
		return fought or rebirths > 0
	elseif id == "pill_gold" then
		return (view.goldGummies or 0) > 0
	elseif id == "tile_tree" then
		-- Start-Knoten sind BasicEgg und SugarEgg; mehr = erstes EggTreeUnlocked
		local unlocked = if view.eggTree then count(view.eggTree.unlocked) else 0
		return hatched >= UnlockRules.TREE_HATCHED or unlocked > 2 or rebirths > 0
	elseif id == "tab_upgrade" then
		return hatched >= UnlockRules.UPGRADE_HATCHED or rebirths > 0
	elseif id == "charms" then
		local towers = view.towers
		local recordI = if towers then (towers.records.I or 0) else 0
		return rebirths >= 1 or recordI >= UnlockRules.CHARMS_TOWER_I
	elseif id == "recycling" then
		return hatched >= UnlockRules.RECYCLE_HATCHED or rebirths > 0
	elseif id == "pill_rank" or id == "pill_rebirth" then
		return rebirths >= 1
	elseif id == "index" then
		return count(view.discovered) >= UnlockRules.INDEX_DISCOVERED
	elseif id == "tile_shop" then
		local stats = view.stats
		local sessions = if stats then (stats.sessions or 0) else 0
		return UnlockRules.SHOP_ENABLED and sessions >= UnlockRules.SHOP_SESSIONS
	end
	return false
end

function UnlockRules.isVisible(view: View, id: string): boolean
	local seen = view.uiSeen
	if seen and seen[id] then return true end
	return condition(view, id)
end

-- { [elementId] = sichtbar }
function UnlockRules.visible(view: View): { [string]: boolean }
	local result: { [string]: boolean } = {}
	for _, id in UnlockRules.ELEMENTS do
		result[id] = UnlockRules.isVisible(view, id)
	end
	return result
end

-- Hat der Spielstand schon Fortschritt? (Veteranen bekommen beim ersten
-- Laden alles Sichtbare als "gesehen", damit keine Badge-Flut entsteht.)
function UnlockRules.hasProgress(view: View): boolean
	return stat(view, "totalHatched") > 0 or (view.rebirthCount or 0) > 0 or UnlockRules.hasFought(view)
end

return UnlockRules
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX32"><Properties><string name="Name">Network</string></Properties><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!strict
-- Remotes.luau
-- ReplicatedStorage/Network/Remotes.luau
--
-- Alle RemoteEvents und RemoteFunctions als benannte Konstanten.
-- Kein Magic-String im gesamten Projekt.
-- Server und Client importieren von hier.
--
-- Konvention: der Feldname hier ist gleichzeitig der Schluessel in
-- NetworkConfig.REMOTE_COOLDOWNS — RateLimiter verlaesst sich darauf.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

-- ============================================================
-- WARUM DIE FALLUNTERSCHEIDUNG SERVER/CLIENT
-- ============================================================
-- Nur der SERVER legt die Remotes an. Der Client wartet ausschliesslich
-- darauf, dass sie repliziert werden.
--
-- Ohne diese Trennung koennte ein Client-Skript, das laeuft bevor der Ordner
-- bei ihm angekommen ist, sich selbst einen EIGENEN "RemoteFolder" mit
-- eigenen, rein lokalen RemoteEvents bauen. Die kommen nie beim Server an
-- und der Server erreicht sie nie — das Spiel saehe vollstaendig normal aus
-- und wuerde einfach gar nichts tun, ohne eine einzige Fehlermeldung. Das ist
-- eine der unangenehmsten Fehlerarten ueberhaupt, deshalb hier explizit.
local IS_SERVER = RunService:IsServer()

local folder: Instance
if IS_SERVER then
	local existing = ReplicatedStorage:FindFirstChild("RemoteFolder")
	if existing then
		folder = existing
	else
		local created = Instance.new("Folder")
		created.Name   = "RemoteFolder"
		created.Parent = ReplicatedStorage
		folder = created
	end
else
	folder = ReplicatedStorage:WaitForChild("RemoteFolder")
end

local function getOrCreateEvent(name: string): RemoteEvent
	if not IS_SERVER then
		return folder:WaitForChild(name) :: RemoteEvent
	end

	local existing = folder:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local remote  = Instance.new("RemoteEvent")
	remote.Name   = name
	remote.Parent = folder
	return remote
end

local function getOrCreateFunction(name: string): RemoteFunction
	if not IS_SERVER then
		return folder:WaitForChild(name) :: RemoteFunction
	end

	local existing = folder:FindFirstChild(name)
	if existing and existing:IsA("RemoteFunction") then
		return existing
	end
	local remote  = Instance.new("RemoteFunction")
	remote.Name   = name
	remote.Parent = folder
	return remote
end

-- ============================================================
-- Server → Client Events
-- ============================================================

-- Wird nach jeder Zustandsaenderung gefeuert
-- Args: PlayerDataUpdate
local PlayerDataUpdated = getOrCreateEvent("PlayerDataUpdated")

-- Kampfergebnis anzeigen (Animation auf Client)
-- Args: CombatResult
local CombatResultReceived = getOrCreateEvent("CombatResultReceived")

-- Hatch-Ergebnis anzeigen (Gacha-Animation auf Client)
-- Args: HatchResult
local HatchResultReceived = getOrCreateEvent("HatchResultReceived")

-- Fusions-Ergebnis anzeigen
-- Args: FusionResult
local FusionResultReceived = getOrCreateEvent("FusionResultReceived")

-- Recycling-Ergebnis anzeigen
-- Args: RecycleResult
local RecycleResultReceived = getOrCreateEvent("RecycleResultReceived")

-- Rebirth durchgefuehrt
-- Args: RebirthResult
local RebirthResultReceived = getOrCreateEvent("RebirthResultReceived")

-- Offline-Ertrag beim Join
-- Args: OfflineReport
local OfflineReportReceived = getOrCreateEvent("OfflineReportReceived")

-- Ein Honig wurde verfuettert: Heilung, XP und ggf. Level-Up
-- Args: FeedResult
local FeedResultReceived = getOrCreateEvent("FeedResultReceived")

-- Ein Baerchi wurde befoerdert
-- Args: PromotionResult
local PromotionResultReceived = getOrCreateEvent("PromotionResultReceived")

-- Charms wurden neu gewuerfelt (ein Wurf oder ein Auto-Roll-Paket)
-- Args: CharmRollResult
local CharmRollResultReceived = getOrCreateEvent("CharmRollResultReceived")

-- Ein Stat-Level ist durch Event-Teilnahme gestiegen
-- Args: EventStatGain
local EventStatGained = getOrCreateEvent("EventStatGained")

-- Der ausgeruestete Baerchi ist am Event angekommen bzw. wieder zuhause.
-- Reiner Anzeige-Zustand fuer den "Zum Event"-Knopf — die Wahrheit darueber,
-- wer am Event steht, liegt ausschliesslich serverseitig
-- (EventParticipationService), dieser Event teilt sie nur mit.
-- Args: atEvent: boolean, baerchiUid: string?
local EventPresenceChanged = getOrCreateEvent("EventPresenceChanged")

-- Der Event-Zyklus hat die Phase gewechselt: ein Event hat begonnen oder ist
-- vorbei. Geht an ALLE Spieler (der Zyklus ist fuer alle derselbe) und beim
-- Join zusaetzlich einmal gezielt an den neuen Spieler.
--
-- Uebertragen wird nur die eventId, NICHT die Belohnung: den Katalog kennt der
-- Client selbst (EventConfig liegt in ReplicatedStorage), und ein zweiter
-- Uebertragungsweg fuer dieselben Zahlen waere genau die Art Doppelung, die
-- beim naechsten Balancing auseinander laeuft.
--
-- Args: eventId: string?  (nil = gerade Pause),
--       secondsRemaining: number,
--       nextEventId: string  (was als naechstes laeuft — waehrend der Pause
--                             die eigentlich wichtige Angabe, weil der Spieler
--                             danach entscheidet, ob er seinen Baerchi
--                             losschickt)
local EventPhaseChanged = getOrCreateEvent("EventPhaseChanged")

-- Ein gelegtes Ei wurde eingesammelt und liegt jetzt im Lager
-- Args: EggCollectResult
local EggCollectedReceived = getOrCreateEvent("EggCollectedReceived")

-- Beim Join: wie viele Eier waehrend der Abwesenheit dazugekommen sind
-- Args: OfflineEggReport
local OfflineEggReportReceived = getOrCreateEvent("OfflineEggReportReceived")

-- v15: Der Spieler hat seinen Waben-Stapel auf der eigenen Insel abgegeben.
-- Reiner Anzeige-Anlass (Meldung); die Waben gehen serverseitig direkt in die
-- Warteschlange des Recyclers (CombRecyclerService).
-- Args: count: number (Waben), units: number (Wabeneinheiten, goldene zaehlen mehr)
local CombDelivered = getOrCreateEvent("CombDelivered")

-- v15: Der Waben-Recycler wurde ausgebaut.
-- Args: newLevel: number
local RecyclerUpgraded = getOrCreateEvent("RecyclerUpgraded")

-- v12: Zustand des ausgeruesteten Baerchis fuer die untere Pet-Leiste
-- (PetBar). Die Wahrheit liegt ausschliesslich in PetModeService, dieser
-- Event teilt sie nur mit.
-- Args: state: string  ("Home" | "ToEvent" | "AtEvent" | "ToPit" | "InPit" | "Returning"),
--       pending: string? ("Event" | "Fight" — vorgemerktes Ziel beim Wechsel),
--       info: { stage: number? }?  (laufende Stage im PIT, fuer die Beschriftung)
local PetModeChanged = getOrCreateEvent("PetModeChanged")

-- Eine Anfrage wurde serverseitig abgelehnt — Client zeigt Toast/Fehlertext.
-- Args: action: string, reason: Types.LocMsg  (Schluessel + Zahlen, KEIN fertiger
--       Satz: der Client baut den Text in der Sprache des Spielers, siehe
--       Localization/Loc. Ein einfacher String wird als Altlast unveraendert
--       angezeigt.)
-- v13: Quest-Belohnung wurde ausgezahlt (Toast). Args: reward: Types.QuestReward
local QuestRewardReceived = getOrCreateEvent("QuestRewardReceived")

local ActionFailed = getOrCreateEvent("ActionFailed")

-- v17 (lebendige Events): Meldung waehrend eines Events, als LocMsg (der
-- Client uebersetzt). Geht an einen Spieler oder an alle (Jackpot, Boss).
-- Args: msg: Types.LocMsg, style: ("info" | "good" | "big")?
local EventNotice = getOrCreateEvent("EventNotice")

-- v17: Telegraph einer Boss-Attacke (an alle). Args: Types.HazardTelegraph
local EventTelegraph = getOrCreateEvent("EventTelegraph")

-- v17: Der eigene Charakter wurde von einer Boss-Attacke getroffen.
-- Args: Types.HazardHit
local EventHazardHit = getOrCreateEvent("EventHazardHit")

-- v15 (Tower): ein Tower-Meilenstein wurde ausgezahlt (Toast).
-- Args: Types.TowerMilestoneReward
local TowerMilestoneReceived = getOrCreateEvent("TowerMilestoneReceived")
-- 08.10.: ein Tower ist durch Schaffen des vorherigen frei geworden
-- (Server → Client, Argument: TowerId). Feier-Moment + "NEU"-Abzeichen.
local TowerUnlocked = getOrCreateEvent("TowerUnlocked")

-- v15: Login-Bonus ausgezahlt (Toast). Args: Types.DailyBonusResult
local DailyBonusReceived = getOrCreateEvent("DailyBonusReceived")

-- v14 (Mega Egg Tree): Ei-Baum, Ei-Presse, Blaupausen, Faehigkeiten-Show
local EggTreeUnlocked        = getOrCreateEvent("EggTreeUnlocked")        -- S->C (Types.EggUnlockResult)
local EggPressResultReceived = getOrCreateEvent("EggPressResultReceived") -- S->C (Types.EggPressResult)
local SkillFXPlay            = getOrCreateEvent("SkillFXPlay")            -- S->C (alle Clients, siehe PitArenaService)
local RequestPressEggs       = getOrCreateEvent("RequestPressEggs")       -- C->S (eggType, path?)
local RequestUseBlueprint    = getOrCreateEvent("RequestUseBlueprint")    -- C->S (eggType)

-- ============================================================
-- Client → Server Events (Anfragen)
-- ============================================================

-- Spieler oeffnet ein Ei aus seinem Lager (seit v12 sofort, ohne Brutzeit
-- und ohne Kauf). Ergebnis kommt ueber HatchResultReceived.
-- Args: eggType: string
local RequestHatchEgg = getOrCreateEvent("RequestHatchEgg")

-- v13: Quest-Belohnung abholen. Der Server prueft selbst, ob die Quest erledigt ist.
-- Args: kind: "chain" | "daily", questId: string
local RequestClaimQuest = getOrCreateEvent("RequestClaimQuest")

-- v12: Pet-Leiste. Der Client sagt nur, welcher Knopf gedrueckt wurde — was
-- daraus folgt (hinschicken, zurueckholen, wechseln), entscheidet
-- PetModeService.
-- Args: mode: "Event" | "Fight" | "Home",
--       resume: ("Fresh" | "Percent" | "Last")?  (nur bei "Fight": Wahl aus der
--               Fortsetzungs-Frage; nil = von vorn)
local RequestPetMode = getOrCreateEvent("RequestPetMode")

-- Spieler will ein Gebaeude upgraden
-- Args: buildingId: string
local RequestUpgradeBuilding = getOrCreateEvent("RequestUpgradeBuilding")

-- (v15: RequestUpgradePit ist entfallen — es gibt kein PIT-Level mehr.)

-- v15: Tower waehlen, in den der Fight-Knopf schickt. Der Server prueft, ob
-- der Tower beim aktuellen Rebirth offen ist (TowerConfig.isOpen).
-- Args: towerId: string
local RequestSelectTower = getOrCreateEvent("RequestSelectTower")
-- 08.10. (Paket C): Kauf-Dialog fuer einen Gamepass (Argument: Pass-Key aus
-- GamepassConfig). Der Server prueft Id und Besitz.
local RequestBuyGamepass = getOrCreateEvent("RequestBuyGamepass")

-- v15: taeglichen Login-Bonus abholen. Der Server prueft UTC-Tag,
-- Gnadenfrist und doppelte Abholung (Modules/LoginBonusCalc).
-- Args: (keine)
local RequestClaimDailyBonus = getOrCreateEvent("RequestClaimDailyBonus")

-- v15: Waben-Recycler ausbauen (kein Argument: es gibt nur einen pro Insel)
local RequestUpgradeRecycler = getOrCreateEvent("RequestUpgradeRecycler")

-- Spieler will zwei Baerchis fusionieren
--
-- Args: uidA: string, uidB: string,
--       lockedProperty: ("ability" | "level" | "eggs")?,   -- nil = alles automatisch
--       lockedFrom:     ("A" | "B")?                        -- nur wenn lockedProperty gesetzt
--
-- Die beiden letzten Argumente kommen aus dem Sperr-Schritt des Fusions-Menues
-- (siehe FusionPanel). Sie sind optional: ein Aufruf ohne sie verhaelt sich wie
-- vor der Erweiterung, alles automatisch nach der Standard-Regel.
local RequestFuseBaerchis = getOrCreateEvent("RequestFuseBaerchis")

-- Spieler will einen Baerchi mit Duplikaten befoerdern
-- Args: baerchiUid: string
local RequestPromoteBaerchi = getOrCreateEvent("RequestPromoteBaerchi")

-- Spieler will die Charms eines Baerchis neu wuerfeln.
-- `rolls` ist die Anzahl der Wuerfe in EINEM Paket (1 = "Roll Charms",
-- CharmConfig.AUTO_ROLL_COUNT = "Auto Roll"). Siehe CharmConfig, Kommentar bei
-- AUTO_ROLL_COUNT, warum das ein Paket ist und keine Schleife auf dem Client.
-- Args: baerchiUid: string, rolls: number?
local RequestRollCharms = getOrCreateEvent("RequestRollCharms")

-- Spieler will einen Charm-Slot gegen erneutes Wuerfeln sperren/freigeben
-- Args: baerchiUid: string, slot: number
local RequestToggleCharmLock = getOrCreateEvent("RequestToggleCharmLock")

-- Spieler sammelt ein gelegtes Ei auf, das in der Welt liegt.
-- Args: eggUid: string  (Types.LaidEgg.uid — NICHT die Position: die aendert
--       sich nicht, aber eine uid ist eindeutig auch dann noch, wenn zwei Eier
--       uebereinander liegen.)
local RequestCollectEgg = getOrCreateEvent("RequestCollectEgg")

-- Spieler sammelt ALLE herumliegenden Eier auf einmal auf.
-- Args: (keine)
local RequestCollectAllEggs = getOrCreateEvent("RequestCollectAllEggs")

-- Spieler will einen Baerchi verwerten
-- Args: baerchiUid: string
local RequestRecycleBaerchi = getOrCreateEvent("RequestRecycleBaerchi")

-- Spieler will einen Baerchi mit einem Honig fuettern (heilt + gibt XP).
-- Aus welchem Gebaeude der Honig kommt, entscheidet der Server (bestes zuerst).
-- Args: baerchiUid: string
local RequestFeedHoney = getOrCreateEvent("RequestFeedHoney")

-- Spieler will einen Baerchi ausruesten. Es steht immer nur EINER auf dem
-- Plot — die anderen bleiben im Inventar. Siehe IslandService.equipBaerchi.
-- Args: baerchiUid: string
local RequestEquipBaerchi = getOrCreateEvent("RequestEquipBaerchi")

-- Spieler will Rebirth machen
-- Args: (keine)
local RequestRebirth = getOrCreateEvent("RequestRebirth")

-- Spieler waehlt seine Sprache. nil/"auto" = zurueck auf die Roblox-Sprache.
-- Args: language: string?   ("de" | "en" | "fr" | "es")
local RequestSetLanguage = getOrCreateEvent("RequestSetLanguage")

-- HBB Paket 0: Messpunkte der Oberflaeche (Panel geoeffnet, Panel schnell
-- wieder geschlossen, Spieler steht still). Reine Statistik, aendert nichts
-- am Spielstand. Der Server prueft Art und Panel-Namen gegen
-- FunnelConfig und deckelt die Anzahl pro Sitzung.
-- Args: kind: "PanelOpened" | "PanelQuickClose" | "IdleStanding",
--       panelName: string?
local RequestLogUiEvent = getOrCreateEvent("RequestLogUiEvent")

-- HBB Paket 3: Bedienelemente als "gesehen" markieren (Badge verschwindet).
-- Rein kosmetisch; der Server prueft nur die Ids gegen UnlockRules.ELEMENTS.
-- Args: ids: string | { string }
local RequestMarkUiSeen = getOrCreateEvent("RequestMarkUiSeen")

-- HBB Paket 5: Heim-Knopf. Der Server teleportiert auf den eigenen Plot,
-- ausser der Spieler traegt Waben (dann ActionFailed).
-- Args: (keine)
local RequestGoHome = getOrCreateEvent("RequestGoHome")
-- HBB Paket 10: Shop — Gratis-Griff (Client -> Server, keine Argumente)
local RequestClaimFreeGrab = getOrCreateEvent("RequestClaimFreeGrab")

-- ============================================================
-- Sammel-Update 05.10.
-- ============================================================
-- Paket 4.3: Tower-Wiedergabe beschleunigen. Args: speed (1 | 2 | 4 | 0 = sofort)
local RequestPitSpeed = getOrCreateEvent("RequestPitSpeed")
-- Paket 7: Index-Belohnung abholen. Args: rewardId (IndexRewardConfig)
local RequestClaimIndexReward = getOrCreateEvent("RequestClaimIndexReward")
-- Paket 7: Belohnung ausgezahlt (S->C, Toast). Args: Types.IndexRewardResult
local IndexRewardReceived = getOrCreateEvent("IndexRewardReceived")
-- Paket 6.2: besonderer Meilenstein ausgezahlt (S->C). Args: Types.SpecialMilestoneResult
local SpecialMilestoneReceived = getOrCreateEvent("SpecialMilestoneReceived")
-- Paket 8: Inkubator. Start (eggType), Abholen (slot), Beschleunigen (slot),
-- Ausbauen (keine Args). Das Schluepfen meldet HatchResultReceived.
local RequestIncubatorStart   = getOrCreateEvent("RequestIncubatorStart")
local RequestIncubatorCollect = getOrCreateEvent("RequestIncubatorCollect")
local RequestIncubatorSpeedUp = getOrCreateEvent("RequestIncubatorSpeedUp")
local RequestUpgradeIncubator = getOrCreateEvent("RequestUpgradeIncubator")
-- INCUBATOR_BREED: ("put", baerchiUid) / ("take", platz)
local RequestIncubatorBaerchi = getOrCreateEvent("RequestIncubatorBaerchi")
-- Paket 8: S->C Hinweis "Platz belegt / fertig / abgeholt" (Feedback, Ton).
-- Args: { slot: number, kind: "start" | "ready" | "collect" | "speedup" | "upgrade" }
local IncubatorChanged = getOrCreateEvent("IncubatorChanged")

-- ============================================================
-- Client → Server Functions (brauchen eine Antwort)
-- ============================================================

-- Spieler fragt seine aktuellen Daten an (z.B. nach Reconnect)
-- Returns: PlayerDataUpdate?
local GetPlayerData = getOrCreateFunction("GetPlayerData")

-- v15: eine Bestenliste (LeaderboardService, gecacht).
-- Args: listId: "Tower" | "Rebirths" | "Collection"
-- Returns: Types.LeaderboardView?
local GetLeaderboard = getOrCreateFunction("GetLeaderboard")

-- v15: Profilkarte eines anderen Spielers auf DIESEM Server (Inspektor).
-- Args: userId: number
-- Returns: Types.PlayerProfileCard?
local GetPlayerProfile = getOrCreateFunction("GetPlayerProfile")

return {
	-- Server → Client
	PlayerDataUpdated     = PlayerDataUpdated,
	CombatResultReceived  = CombatResultReceived,
	HatchResultReceived   = HatchResultReceived,
	FusionResultReceived  = FusionResultReceived,
	RecycleResultReceived = RecycleResultReceived,
	RebirthResultReceived = RebirthResultReceived,
	OfflineReportReceived = OfflineReportReceived,
	FeedResultReceived    = FeedResultReceived,
	PromotionResultReceived = PromotionResultReceived,
	CharmRollResultReceived = CharmRollResultReceived,
	EventStatGained         = EventStatGained,
	EventPresenceChanged    = EventPresenceChanged,
	EventPhaseChanged       = EventPhaseChanged,
	EggCollectedReceived    = EggCollectedReceived,
	OfflineEggReportReceived = OfflineEggReportReceived,
	PetModeChanged          = PetModeChanged,
	CombDelivered           = CombDelivered,
	RecyclerUpgraded        = RecyclerUpgraded,
	QuestRewardReceived     = QuestRewardReceived,
	ActionFailed          = ActionFailed,
	EventNotice           = EventNotice,
	EventTelegraph        = EventTelegraph,
	EventHazardHit        = EventHazardHit,

	TowerMilestoneReceived = TowerMilestoneReceived,
	TowerUnlocked          = TowerUnlocked,
	DailyBonusReceived     = DailyBonusReceived,

	EggTreeUnlocked        = EggTreeUnlocked,
	EggPressResultReceived = EggPressResultReceived,
	SkillFXPlay            = SkillFXPlay,
	RequestPressEggs       = RequestPressEggs,
	RequestUseBlueprint    = RequestUseBlueprint,

	-- Client → Server
	RequestHatchEgg        = RequestHatchEgg,
	RequestClaimQuest      = RequestClaimQuest,
	RequestPetMode         = RequestPetMode,
	RequestUpgradeBuilding = RequestUpgradeBuilding,
	RequestSelectTower     = RequestSelectTower,
	RequestBuyGamepass     = RequestBuyGamepass,
	RequestClaimDailyBonus = RequestClaimDailyBonus,
	RequestUpgradeRecycler = RequestUpgradeRecycler,
	RequestFuseBaerchis    = RequestFuseBaerchis,
	RequestRecycleBaerchi  = RequestRecycleBaerchi,
	RequestFeedHoney       = RequestFeedHoney,
	RequestEquipBaerchi    = RequestEquipBaerchi,
	RequestRebirth         = RequestRebirth,
	RequestSetLanguage     = RequestSetLanguage,
	RequestPromoteBaerchi  = RequestPromoteBaerchi,
	RequestRollCharms      = RequestRollCharms,
	RequestToggleCharmLock = RequestToggleCharmLock,
	RequestCollectEgg      = RequestCollectEgg,
	RequestCollectAllEggs  = RequestCollectAllEggs,
	RequestLogUiEvent      = RequestLogUiEvent,
	RequestMarkUiSeen      = RequestMarkUiSeen,
	RequestGoHome          = RequestGoHome,
	RequestClaimFreeGrab   = RequestClaimFreeGrab,

	-- Sammel-Update 05.10.
	RequestPitSpeed          = RequestPitSpeed,
	RequestClaimIndexReward  = RequestClaimIndexReward,
	IndexRewardReceived      = IndexRewardReceived,
	SpecialMilestoneReceived = SpecialMilestoneReceived,
	RequestIncubatorStart    = RequestIncubatorStart,
	RequestIncubatorCollect  = RequestIncubatorCollect,
	RequestIncubatorSpeedUp  = RequestIncubatorSpeedUp,
	RequestUpgradeIncubator  = RequestUpgradeIncubator,
	RequestIncubatorBaerchi  = RequestIncubatorBaerchi,
	IncubatorChanged         = IncubatorChanged,

	-- Functions
	GetPlayerData          = GetPlayerData,
	GetLeaderboard         = GetLeaderboard,
	GetPlayerProfile       = GetPlayerProfile,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">Types</string><ProtectedString name="Source"><![CDATA[--!strict
-- Types.luau
-- ReplicatedStorage/Network/Types.luau
--
-- Einzige Wahrheit fuer alle Datenstrukturen im Spiel.
-- Wird auf Server UND Client importiert.
-- Wenn sich ein Feld aendert, aendert es sich hier — nirgendwo sonst.

--------------------------------------------------------------------------------
-- Enums
--------------------------------------------------------------------------------

local HoneyPondMode = require(script.Parent.Parent.Modules.HoneyPondMode)
local FeatureFlags  = require(script.Parent.Parent.Config.FeatureFlags)

export type Rarity =
	| "Common"
	| "Uncommon"
	| "Rare"
	| "Epic"
	| "Legendary"
	| "Mythic"
	| "Divine"
	| "Cosmic"
	| "Secret"
	| "Godly"
	| "Eternal"
	| "Omega"

-- v14 (Mega Egg Tree): 20 Eier in einem Freischalt-Baum. Welches Ei zu
-- welchem Pfad gehoert und wie es frei wird, steht in EggConfig (TREE).
export type EggType =
	-- Stamm
	| "BasicEgg"
	| "SugarEgg"
	-- Gold-Pfad
	| "GoldenEgg"
	| "PlatinumEgg"
	| "SunEgg"
	| "ZenithEgg"
	-- Kristall-Pfad
	| "CrystalEgg"
	| "PrismEgg"
	| "AuroraEgg"
	-- Void-Pfad
	| "MistEgg"
	| "VoidEgg"
	| "ShadowEgg"
	| "AbyssEgg"
	-- Kosmos-Pfad
	| "CometEgg"
	| "NovaEgg"
	| "GalaxyEgg"
	-- Ascensions-Pfad (nur Rebirth)
	| "AscensionEgg"
	| "TranscendenceEgg"
	| "EternityEgg"
	| "OmegaEgg"
	-- Sonder-Eier ausserhalb des Baums (EggConfig: special = true)
	| "UfoJackpotEgg"

-- v14: die Pfade des Ei-Baums. Ein Pfad ist kein Upgrade, sondern ein
-- Spielziel (Gold = stark, Kristall = schnell, Void = selten, Kosmos =
-- Allrounder, Ascension = Rebirth). Siehe BaerchiConfig.PATHS.
export type PathId = "Stamm" | "Gold" | "Kristall" | "Void" | "Kosmos" | "Ascension"
	| "Event"   -- Sonder-Eier aus Events (nicht im Baum, nie freischaltbar)

-- v11: MUTATION-SYSTEM (ersetzt das binaere isInverted-Feld).
--
-- Acht Stufen statt einem einzigen Bonus — Namen und Werte (Multiplikator,
-- Farbe, Wuerfel-Gewicht) stehen NICHT hier, sondern in
-- Config/BaerchiConfig.MUTATIONS (dieselbe Trennung wie bei Rarity: Types
-- kennt nur die Werte-Menge, BaerchiConfig kennt die Bedeutung dahinter).
-- Aufsteigend sortiert nach Seltenheit/Staerke — BaerchiConfig.MUTATION_ORDER
-- haelt exakt diese Reihenfolge fuer Fusions-Vergleiche ("hoehere Stufe
-- gewinnt").
export type MutationId =
	| "Gold"
	| "Diamond"
	| "Bloodrot"
	| "Celestial"
	| "Candy"
	| "Lava"
	| "Galaxy"
	| "Rainbow"

-- Gebaeude sind seit v4 reine HONIG-Produzenten: jedes stellt regelmaessig
-- einen Honig her und lagert eine begrenzte Menge davon. Ein Honig an einen
-- Baerchi verfuettert heilt ihn und gibt XP — die einzige XP-Quelle im Spiel
-- (Kaempfe geben keine XP mehr).
--
-- Seit v15 (Gebaeude Option B) sind es noch ZWEI Honig-Gebaeude, und nur eine
-- Datei weiss, was sie koennen: Config/BuildingBehavior.luau. Kurz:
--   Beehive       Vorrat   — groesseres Lager, schnellere Produktion
--   HoneyRefiner  Veredeln — sein Level hebt Heilung UND XP jedes Honigs
--                            (verschmolzen aus Honigtopf und Honig-Presse;
--                            "Honig-Veredler" ist ein Platzhalter-Name)
-- Das dritte Gebaeude, der Waben-Recycler, liegt in island.recycler.
--
-- Level 1-60 (EconomyConfig.MAX_BUILDING_LEVEL), Look-Stufe aus dem Level
-- (BuildingBehavior.getLook).
--
-- Seit dem Honig-Teich (FeatureFlags.HONEY_POND_V2) ist es EIN Gebaeude:
--   HoneyPond     Honig-Teich — kann alles, was Stock und Veredler zusammen
--                 koennen; seine Looks wachsen bis zum Honig-Springbrunnen.
-- Die jeweils nicht aktiven liegen in IslandData.retiredBuildings
-- (Modules/HoneyPondMode).
export type BuildingId =
	| "Beehive"        -- Bienenstock
	| "HoneyRefiner"   -- Honig-Veredler (Platzhalter-Name)
	| "HoneyPond"      -- Honig-Teich (HONEY_POND_V2)
-- Fusion ist seit v3 kein Gebaeude mehr — sie laeuft rein ueber GUI
-- (FusionPanel/BaerchiInventory) und ist von Anfang an freigeschaltet.
-- Recycling ist seit v4 ebenfalls eine reine GUI-Funktion mit festem Wert
-- (EconomyConfig.RECYCLE_RETURN). Eier werden seit v12 sofort geoeffnet,
-- es gibt keine Brut-Slots mehr.

export type SkillId = string  -- "SugarRush", "GummySmash", "BearHug", etc.
                               -- String damit neue Skills nur Config-Eintraege sind

-- Rarity eines BATTLE-CHARMS. Bewusst eine eigene Kette, nicht Types.Rarity:
-- ein Charm hat andere Stufen als ein Baerchi ("Super Rare", "Ascended"), und
-- die Odds der einen duerfen sich nicht verschieben, wenn jemand die andere
-- erweitert. Zahlen und Farben stehen in Config/CharmConfig.
export type CharmRarity =
	| "Common"
	| "Uncommon"
	| "Rare"
	| "SuperRare"
	| "Legendary"
	| "Ascended"

-- Ein einzelner ausgeruesteter Battle-Charm.
--
-- Der Slot steht IM Eintrag statt als Tabellen-Schluessel: eine Lua-Tabelle mit
-- Luecken in den Zahlen-Schluesseln ({[1]=..., [5]=...}) laesst sich nicht in
-- einem DataStore ablegen. Baerchi.charms ist deshalb eine dichte Liste, in der
-- nur die tatsaechlich gewuerfelten Slots vorkommen — nach `slot` sortiert.
export type Charm = {
	slot   : number,        -- 1-8, siehe CharmConfig.SLOT_COUNT
	rarity : CharmRarity,   -- erster Wurf
	statId : string,        -- zweiter Wurf, Eintrag aus CharmConfig.STAT_POOL
	value  : number,        -- konkreter Bonus (Faktor bzw. flacher Wert, siehe STAT_POOL.mode)
	locked : boolean,       -- vom Spieler gegen erneutes Wuerfeln gesperrt
}

-- Fortschritt JEDES EINZELNEN Stats durch Event-Teilnahme, gedeckelt durch die
-- rarity-abhaengige Obergrenze (PromotionConfig.STAT_CAP). Voellig getrennt von
-- Baerchi.level, das ueber Honig/XP waechst — zwei unabhaengige Achsen.
--
-- Seit v10 sind alle fuenf echt: `egg` war lange ein Balken ohne Wirkung, weil
-- es das Ei-Legen noch nicht gab. Jetzt beschleunigt es das Legen (siehe
-- EggConfig.LAY_STAT_LEVEL_GAIN).
export type StatLevels = {
	hp  : number,
	atk : number,
	spd : number,   -- Angriffsgeschwindigkeit
	pwr : number,   -- Ability-Staerke (skaliert den Skill-Schaden)
	egg : number,   -- Lege-Tempo (siehe EggCalculator)
}

--------------------------------------------------------------------------------
-- Kern-Einheit: Baerchi
--------------------------------------------------------------------------------

export type Baerchi = {
	uid            : string,   -- eindeutige Instanz-ID ("b_1721abc...")
	configId       : string,   -- Schluessel in BaerchiConfig ("RedBaerchi", "GoldenGrizzly")
	rarity         : Rarity,
	level          : number,   -- 1 - BaerchiConfig.MAX_LEVEL
	xp             : number,   -- XP-Fortschritt zum naechsten Level
	endlessLevel   : number?,  -- Paket 9: Level ueber MAX_LEVEL (nil = 0), bleibt ueber Rebirths
	skillId        : SkillId,  -- aktiver Skill (durch Fusion ueberschreibbar)
	isFusionResult : boolean,  -- fuer UI-Badge "FUSION"
	fusionBonus    : number,   -- 0.0 = kein Bonus, 0.25 = +25% HP/ATK
	                           -- wird beim Fusionieren gesetzt (EconomyConfig.FUSION_STAT_BONUS)
	                           -- und von CombatCalculator.getEffectiveStats angewendet
	currentHp      : number,   -- aktuelle Lebenspunkte, bleiben zwischen PIT-Laeufen
	                           -- stehen. 0 = erschoepft, der Baerchi kann erst
	                           -- wieder kaempfen wenn er mit Honig gefuettert wurde.
	                           -- Obergrenze ist maxHp aus getEffectiveStats.

	-- v8: die zweite Fortschrittsachse (siehe Config/PromotionConfig).
	promotionLevel : number,       -- 0 - PromotionConfig.MAX_PROMOTION, angezeigt als 5 Sterne
	statLevels     : StatLevels,   -- waechst durch Event-Teilnahme
	charms         : { Charm },    -- dichte Liste, nach slot sortiert (siehe Charm)

	-- v8: nur bei einem FUSIONS-Ergebnis gesetzt, sonst nil.
	--
	-- Basiswerte haengen sonst ausschliesslich am configId
	-- (BaerchiConfig.data[configId].baseStats). Seit der neuen Fusions-Regel
	-- ("pro Stat der bessere der beiden Eltern") kann ein Fusions-Ergebnis aber
	-- hoehere Basiswerte tragen, als sein eigener configId hergibt — genau
	-- dafuer ist dieses Feld da.
	--
	-- CombatCalculator.getEffectiveStats bevorzugt die hier gesetzten Werte.
	-- Fuer JEDEN nicht fusionierten Baerchi bleibt das Feld nil und das
	-- Verhalten unveraendert.
	baseStatOverride : {
		hp  : number?,
		atk : number?,
		spd : number?,
		pwr : number?,
	}?,

	-- v11: MUTATION (ersetzt das fruehere binaere isInverted-Feld aus v9).
	--
	-- Eine seltene Variante JEDES Baerchis (Wurf beim Schluepfen:
	-- BaerchiConfig.rollMutation()), diesmal GESTUFT statt binaer: acht
	-- Stufen mit steigendem Stat-Multiplikator, steigender Seltenheit und
	-- eigener Farbe/Leuchten (siehe BaerchiConfig.MUTATIONS). nil = keine
	-- Mutation, der weit ueberwiegende Normalfall.
	--
	-- Bewusst ein eigenes Feld und KEINE eigene Rarity: die Rarity steuert
	-- Gacha-Gewichte, Stat-Obergrenzen, Fusions-Kette und Farben. Mutation an
	-- sie zu haengen haette all das mitverbogen — derselbe Grund wie zuvor bei
	-- Inverted, nur jetzt mit mehr als zwei moeglichen Zustaenden.
	mutation : MutationId?,
}

--------------------------------------------------------------------------------
-- Insel-Daten
--------------------------------------------------------------------------------

export type Building = {
	id    : BuildingId,
	level : number,   -- 1 .. EconomyConfig.MAX_BUILDING_LEVEL (60)

	-- Eingelagerter Honig, 0 .. EconomyConfig.HONEY_CAPACITY.
	honey : number,

	-- os.time() des zuletzt ANGERECHNETEN Honigs. Die Produktion laeuft nicht
	-- ueber einen Timer sondern wird aus dieser Zeitmarke nachgerechnet
	-- (gleiches Prinzip wie HatchingEgg.readyAt) — dadurch produzieren die
	-- Gebaeude auch waehrend der Spieler offline ist, ohne Server-Loop.
	lastProducedAt : number,
}

-- v12: Brut-Slots (HatchingEgg, island.hatchingEggs) sind entfallen. Ein Ei
-- aus dem Lager wird per Klick sofort geoeffnet (EggService.openEgg). Die
-- Migration (Util/PlayerMigration) legt laufende Bruten alter Spielstaende zurueck
-- ins Lager.

-- v15: TOWER-SYSTEM (ersetzt das PIT-Level).
--
-- Vier Tower mit eigener Stage-Zahl und eigenem Gegner-Wachstum, Zahlen in
-- Config/TowerConfig. "I" Holz (30 Stages), "II" Stein (45), "III" Gold (60),
-- "Final" Kristall (100).
export type TowerId = "I" | "II" | "III" | "Final" | "Endless"   -- Endless: HBB Paket 9

-- Permanenter Tower-Fortschritt. Liegt bewusst AUSSERHALB von island (wie
-- eggTree): ein Rebirth setzt die Insel zurueck, Rekorde und abgeholte
-- Meilensteine bleiben.
--
--   records      beste geschaffte Stage je Tower (zaehlt nur bis zum Deckel
--                des jeweiligen Rebirths, siehe TowerConfig.getStageCap)
--   claimed      abgeholte Meilenstein-Stages je Tower. Die Stage steht als
--                TEXT-Schluessel ("5", "10"): eine Lua-Tabelle mit Luecken in
--                Zahlen-Schluesseln laesst sich nicht im DataStore ablegen
--                (derselbe Grund wie bei Baerchi.charms).
--   highestTower hoechster je erreichte Tower (Look des Turms, Abzeichen)
--   selected     der Tower, in den der Fight-Knopf schickt
--   unlocked     v17 (08.10.): freigeschaltete Tower. Tower N+1 geht auf,
--                sobald Tower N geschafft ist (TowerConfig.UNLOCK_AFTER);
--                die Migration traegt ein, was vorher per Rebirth offen war
--                (Bestandsschutz). Tower I steht immer drin.
export type TowerState = {
	records      : { [string]: number },
	claimed      : { [string]: { [string]: boolean } },
	highestTower : string,
	selected     : string,
	unlocked     : { [string]: boolean },
	endlessWeek  : { week: number, best: number }?, -- Paket 9: beste Endless-Stage der Woche
}

-- v15: Taeglicher Login-Bonus (Config/LoginBonusConfig). Tage zaehlen nach
-- UTC (os.time() // 86400). streak = wie viele Tage des 7-Tage-Zyklus schon
-- abgeholt sind (0-7); lastClaimDay = UTC-Tag der letzten Abholung (0 = nie).
export type DailyState = {
	lastClaimDay : number,
	streak       : number,
}

-- Ein GELEGTES Ei: liegt sichtbar in der Welt und wartet darauf, angeklickt zu
-- werden. Erst beim Einsammeln wird daraus ein Eintrag in eggStock, der sich
-- ausbrueten laesst.
--
-- Die Position steht als drei Zahlen drin, nicht als Vector3: ein DataStore
-- kann nur einfache Werte speichern, ein Vector3 waere beim naechsten Laden
-- verschwunden.
--
-- Warum das Ei ueberhaupt eine Position hat: es wird dort abgelegt, wo der
-- Baerchi im Moment des Legens stand. Wer seinen Baerchi zum Honig-Teich und
-- zurueck laufen laesst, findet danach eine Spur aus Eiern — genau das ist
-- gewollt.
export type LaidEgg = {
	uid     : string,     -- eindeutig, wird zum Einsammeln benutzt
	eggType : EggType,
	laidAt  : number,     -- os.time(), nur fuer die Anzeige ("gerade eben")
	x       : number,
	y       : number,     -- Fusspunkt, das Ei sitzt mit seiner Unterkante darauf
	z       : number,
	-- INCUBATOR_BREED: vom Inkubator gebruetet (eigene Obergrenze, zaehlt
	-- nicht gegen die des ausgeruesteten Baerchis).
	fromIncubator : boolean?,
}

-- v15: der Waben-Recycler vor der Basis (siehe Config/CombConfig). Er nimmt die
-- Waben, die der Spieler im Event-Pit gesammelt hat, in eine Warteschlange und
-- verwandelt sie nach und nach in Gummies. Wie Building.lastProducedAt laeuft
-- das ueber eine Zeitmarke und nicht ueber einen Timer, damit er auch offline
-- weiterarbeitet.
export type RecyclerData = {
	level           : number,   -- 1 .. CombConfig.RECYCLER_MAX_LEVEL
	queued          : number,   -- Wabeneinheiten, die noch verarbeitet werden muessen
	progress        : number,   -- angefangene Einheit (0 .. <1), damit keine Bruchteile verloren gehen
	lastProcessedAt : number,   -- os.time() der letzten Verrechnung
}

export type IslandData = {
	buildings    : { [BuildingId]: Building },
	-- HONEY_POND_V2: Gebaeude, die im aktuellen Modus nicht gelten (Teich
	-- bzw. Stock + Veredler). Bleiben erhalten, kommen beim Zurueckschalten
	-- wieder (Modules/HoneyPondMode). nil = keine.
	retiredBuildings : { [BuildingId]: Building }?,
	baerchis     : { [string]: Baerchi },     -- key = Baerchi.uid
	eggStock     : { [EggType]: number },     -- Eier im Lager (Legen, Events, Rebirth, Haendler)

	-- Der EINE Baerchi, der auf dem Plot steht: laeuft selbststaendig zum
	-- Honig-Teich, in den PIT und wieder zurueck. Alle anderen bleiben reiner
	-- Inventar-Datensatz und werden nicht in der Welt gebaut (MapService
	-- rendert ausschliesslich diesen). nil = noch keiner ausgeruestet (leerer
	-- Plot) — kommt nur direkt nach dem ersten Ei oder nach einem Rebirth vor,
	-- IslandService ruestet den ersten geschluepften Baerchi automatisch aus.
	equippedUid  : string?,

	-- v10: Eier, die der ausgeruestete Baerchi gelegt hat und die noch
	-- herumliegen. Gedeckelt durch EggConfig.MAX_UNCOLLECTED_EGGS.
	laidEggs : { LaidEgg },

	-- os.time() des zuletzt ANGERECHNETEN Eis. Genau wie
	-- Building.lastProducedAt: die Produktion laeuft nicht ueber einen Timer,
	-- sondern wird aus dieser Zeitmarke nachgerechnet — dadurch legt der
	-- Baerchi auch waehrend der Spieler offline ist weiter (langsamer, siehe
	-- EggConfig.OFFLINE_SLOWDOWN) und es braucht keinen Server-Loop dafuer.
	lastEggAt : number,

	-- v15: Waben-Recycler (Level 1-60 + Warteschlange).
	recycler : RecyclerData,

	-- v15: letzte erreichte Stage je Tower fuer die Fortsetzungs-Frage
	-- (ersetzt pitProgress). Schluessel = TowerId. Gehoert zur Insel, weil ein
	-- Rebirth den Baerchi auf Level 1 setzt und ein alter Einstieg dann
	-- sinnlos waere.
	towerProgress : { [string]: number },

	-- v15: Erstattung fuer gekaufte PIT-Level (Migration v14 -> v15). Die
	-- Migration schreibt den Betrag, TowerService zahlt ihn beim Join ueber
	-- EconomyService aus und setzt das Feld auf 0.
	pitRefund : number,

	-- v16 (Sammel-Update, Paket 4.1): beste geschaffte Stage je Tower in
	-- DIESEM Leben (seit dem letzten Rebirth). Die Rebirth-Bedingung
	-- (TowerConfig.getRebirthRequirement) prueft dagegen — nicht gegen die
	-- dauerhaften Rekorde, sonst koennte ein Veteran mehrere Rebirths am Stueck
	-- machen. Liegt in der Insel, damit ein Rebirth es von selbst leert.
	stageBest : { [string]: number },

	-- v16 (Sammel-Update, Paket 8): der Inkubator auf dem Plot.
	incubator : IncubatorData,
}

-- v16 (Paket 8): ein belegter Brut-Platz. Zeitmarken statt Timer (wie
-- Honig und Recycler): fertig ist das Ei, sobald os.time() >= finishAt —
-- auch wenn der Spieler dazwischen offline war. `slot` steht IM Eintrag
-- (dichte Liste, derselbe DataStore-Grund wie bei Baerchi.charms).
export type IncubatorSlot = {
	slot      : number,    -- 1 .. IncubatorConfig.MAX_SLOTS
	eggType   : EggType,
	startedAt : number,
	finishAt  : number,
}

-- v16 (Paket 8): Level (Ausbau mit Gummies, Geldsenke vor dem Rebirth) und
-- die belegten Plaetze. Ein Rebirth setzt das Level zurueck, die Eier in den
-- Plaetzen bleiben (wie das Ei-Lager).
export type IncubatorData = {
	level : number,
	slots : { IncubatorSlot },
	-- INCUBATOR_BREED (Wunsch 05.10.): Baerchis, die im Inkubator sitzen und
	-- im Takt ihrer Rarity zusaetzliche Eier bruehten. Optional, damit alte
	-- Staende ohne das Feld gueltig bleiben (PlayerMigration fuellt es).
	breeders : { IncubatorBreeder }?,
}

-- INCUBATOR_BREED: ein belegter Platz mit Baerchi. `lastEggAt` ist die
-- Zeitmarke (os.time) des letzten Eis — wie island.lastEggAt beim Legen.
export type IncubatorBreeder = {
	slot      : number,    -- 1 .. IncubatorConfig.MAX_SLOTS
	uid       : string,    -- island.baerchis[uid]
	lastEggAt : number,
}

--------------------------------------------------------------------------------
-- Lokalisierte Nachrichten (Server → Client)
--------------------------------------------------------------------------------

-- Der Server formuliert nie einen Satz. Er schickt einen Schluessel plus Zahlen
-- bzw. Namen, der Client baut daraus den Text in der Sprache des Spielers
-- (siehe Localization/Loc). Ein Argument darf selbst wieder eine LocMsg sein,
-- damit z.B. ein Eiername in der Sprache des Spielers eingesetzt wird.
--
-- Konvention fuer Schluessel: "err.*" fuer abgelehnte Aktionen, "msg.*" fuer
-- Meldungen, "ui.*" fuer feste Beschriftungen. Die Texte stehen ausschliesslich
-- in Localization/Strings/<sprache>.luau.
export type LocArg = string | number | LocMsg
export type LocMsg = {
	k : string,                      -- Schluessel
	a : { [string]: LocArg }?,       -- Platzhalter-Werte
}

--------------------------------------------------------------------------------
-- Quests und Index (v13)
--------------------------------------------------------------------------------

-- Gespeicherter Quest-Stand. Gespeichert wird bewusst NUR, was sich nicht aus
-- den Spielzaehlern ableiten laesst: wie viele Kettenquests schon abgeholt
-- wurden, und der Tagesstand. Den Fortschritt selbst rechnet QuestProgress
-- jedes Mal frisch aus data.stats / island — so gibt es keine zweite Wahrheit,
-- die auseinanderlaufen kann, und kein anderer Service muss Quests kennen.
export type QuestBaseline = {
	hatched     : number,
	fightsWon   : number,
	gummies     : number,
}

export type QuestState = {
	chainClaimed : number,                    -- Kettenquests, die schon abgeholt sind
	day          : number,                    -- Tagesnummer (UTC), siehe QuestConfig.dayOf
	baseline     : QuestBaseline,             -- Zaehlerstand zu Tagesbeginn
	dailyClaimed : { [string]: boolean },     -- abgeholte Tages-Quests von `day`
}

-- Eine Zeile in der Quest-Anzeige (Server -> Client). Keine Texte: der Client
-- baut sie aus der id (Schluessel "quest.<id>.title").
export type QuestEntry = {
	id       : string,
	kind     : string,   -- "chain" | "daily"
	progress : number,   -- schon auf `target` gedeckelt
	target   : number,
	claimed  : boolean,
}

export type QuestView = {
	chain      : QuestEntry?,   -- aktuelle Kettenquest, nil = Kette komplett
	chainDone  : number,        -- wie viele der Kette erledigt sind
	chainTotal : number,
	daily      : { QuestEntry },
	dailyResetIn : number,      -- Sekunden bis zum naechsten Tageswechsel
}

-- Belohnungs-Meldung (Server -> Client), fuer den Toast.
export type QuestReward = {
	questId : string,
	gummies : number,
	eggType : EggType?,
	goldGummies : number?,   -- GOLD_CHARMS_ONLY: Tages-Quests
}

--------------------------------------------------------------------------------
-- Ei-Baum (v14)
--------------------------------------------------------------------------------

-- Fortschritt im Ei-Baum. Liegt bewusst AUSSERHALB von island: ein Rebirth
-- setzt die Insel zurueck, den Baum aber nicht — er ist der lange Grind.
--
--   unlocked   Eier, deren Knoten frei ist (einmal frei, immer frei)
--   hatched    wie oft jedes Ei schon geoeffnet wurde (Freischalt-Bedingung)
--   pressed    wie oft jedes Ei in der Ei-Presse entstanden ist (Statistik)
--   blueprints Blaupausen aus Events, noch nicht eingesetzt
--   bypass     Knoten, deren Hatch- und Index-Bedingung eine Blaupause
--              ersetzt hat (das Rebirth-Gate gilt trotzdem)
export type EggTreeState = {
	unlocked   : { [string]: boolean },
	hatched    : { [string]: number },
	pressed    : { [string]: number },
	blueprints : number,
	bypass     : { [string]: boolean },
}

--------------------------------------------------------------------------------
-- Spieler-Rang
--------------------------------------------------------------------------------

export type Rank = {
	tier   : number,  -- 1, 2, 3 ...
	name   : string,  -- "Gummy Hatchling", "Sugar Brawler", "Golden Champion" ...
	points : number,  -- Rangpunkte (PvP Arena)
}

--------------------------------------------------------------------------------
-- Sitzungs-Sperre
--------------------------------------------------------------------------------

-- jobId ist game.JobId des haltenden Servers, lockedAt sein os.time() beim
-- letzten Laden oder Speichern.
export type SessionLock = {
	jobId    : string,
	lockedAt : number,
}

--------------------------------------------------------------------------------
-- PlayerData — alles was im DataStore landet
--------------------------------------------------------------------------------

-- HBB Paket 10: Shop-Teil des Spielstands (Regeln: Modules/ShopRules)
export type ShopState = {
	freeGrabDay : number,     -- UTC-Tag des letzten Gratis-Griffs, -1 = nie
	receipts    : { string }, -- zuletzt ausgezahlte Robux-Kauf-IDs
}

-- HBB Paket 10: was der Client fuer das Shop-Fenster braucht
export type ShopView = {
	freeReady  : boolean,
	nextFreeIn : number,      -- Sekunden bis zum naechsten UTC-Tag
	freeGold   : number,
}

export type PlayerData = {
	-- Schema
	version    : number,   -- fuer Migrationen beim Laden alter Daten
	createdAt  : number,   -- Unix-Timestamp
	lastSeenAt : number,   -- fuer Offline-Gummy-Farm-Berechnung

	-- Waehrungen
	gummies     : number,  -- aktiv: PIT-Kaempfe, Quests, Recycling
	goldGummies : number,  -- Premium: PIT-Meilensteine, Events

	-- Progression
	rebirthCount : number,   -- Anzahl Rebirths
	rebirthMult  : number,   -- Earnings-Multiplikator (1.0 → 1.5 → 2.25 ...)
	rank         : Rank,

	-- Gewaehlte Sprache ("de" | "en" | "fr" | "es"). nil = der Spieler hat nie
	-- gewaehlt, es gilt die Roblox-Sprache seines Clients. Bewusst OHNE
	-- Versions-Sprung: ein fehlendes Feld liest sich in Lua ohnehin als nil
	-- und bedeutet genau "automatisch" (wie equippedUid in v6).
	language     : string?,

	-- Insel
	island : IslandData,

	-- Nur serverseitig relevant (wird nicht an Client gesendet)
	stats : {
		totalGummiesEarned  : number,
		totalFightsWon      : number,
		totalFightsLost     : number,
		totalFusions        : number,
		totalRebirths       : number,
		totalRecycled       : number,
		totalHatched        : number,   -- v13: geoeffnete Eier (Quest-Zaehler)
		-- HBB Paket 2: Events, an deren Ende der Baerchi belohnt wurde
		-- (Fuehrung: "erstes Event geschafft"). Alte Staende starten bei 0.
		totalEventsCompleted : number,
		-- Sammel-Update 05.10. (Paket 6.2): Boss-Siege mit eigenem Schaden
		-- (besonderer Meilenstein "erster Boss-Sieg"). Alte Staende starten bei 0.
		bossVictories : number,
		-- Sammel-Update 05.10. (Paket 3.5): im Recycler abgegebene Waben
		-- (Einfuehrung "Waben abgeben"). Alte Staende starten bei 0.
		totalCombsDelivered : number,
	},

	-- v13: Index. Jede configId, die der Spieler je besessen hat (auch nach
	-- Recycling/Fusion/Rebirth). Wird nie geleert.
	discovered : { [string]: boolean },

	-- HBB Paket 3: welche Bedienelemente der Spieler schon gesehen hat
	-- (Badge "!" nur fuer neue). Rein kosmetisch, gesetzt nur von
	-- UiStateService; Ids siehe Modules/UnlockRules.ELEMENTS.
	uiSeen : { [string]: boolean },

	-- HBB Paket 10: Shop (Gratis-Griff, gemerkte Robux-Kaeufe)
	shop : ShopState,

	-- v13: Quest-Stand
	quests : QuestState,

	-- v14: Ei-Baum (ueberlebt Rebirths)
	eggTree : EggTreeState,

	-- v15: Tower-Rekorde und Meilensteine (ueberleben Rebirths)
	towers : TowerState,

	-- v15: taeglicher Login-Bonus
	daily : DailyState,

	-- v16 (Sammel-Update, Paket 7): abgeholte Index-Belohnungen
	-- (Schluessel = IndexRewardConfig-Id, z.B. "egg:BasicEgg", "path:Gold").
	indexClaimed : { [string]: boolean },

	-- v16 (Sammel-Update, Paket 6.2): ausgezahlte besondere Meilensteine
	-- (EconomyConfig.SPECIAL_MILESTONES, einmalig pro Konto, auch rueckwirkend).
	specialClaimed : { [string]: boolean },

	-- Welcher Server den Spielstand gerade haelt (siehe Util/SessionLock).
	-- Nur serverseitig, geht nie an den Client. nil = niemand; das ist der
	-- Stand nach einem sauberen Verlassen und bei jedem alten Spielstand,
	-- deshalb ohne Versions-Sprung.
	session : SessionLock?,
}

--------------------------------------------------------------------------------
-- Netzwerk-Typen (Server → Client Updates)
--------------------------------------------------------------------------------

-- Wird nach jeder relevanten Aenderung gefeuert.
-- Stats werden bewusst weggelassen (kein Leak sensibler Serverdaten).
export type PlayerDataUpdate = {
	gummies      : number,
	goldGummies  : number,
	rebirthCount : number,
	rebirthMult  : number,
	rank         : Rank,
	language     : string?,
	island       : IslandData,
	discovered   : { [string]: boolean },
	quests       : QuestView,
	eggTree      : EggTreeState,   -- v14
	towers       : TowerState,     -- v15
	daily        : DailyView,      -- v15
	-- HBB Paket 2: fuer Fuehrung und Freischaltung (rein lesend im Client)
	stats        : { [string]: number }?,
	createdAt    : number?,
	uiSeen       : { [string]: boolean }?,   -- HBB Paket 3
	shop         : ShopView?,                -- HBB Paket 10
	indexClaimed : { [string]: boolean }?,   -- v16: Paket 7
}

-- v15: was der Client fuer das Login-Bonus-Fenster braucht (fertig
-- ausgewertet vom Server, siehe LoginBonusService.buildView).
--   day        welcher Tag des Zyklus heute dran ist (1-7)
--   claimable  heute noch nicht abgeholt
--   streak     schon abgeholte Tage im laufenden Zyklus
--   resetIn    Sekunden bis zum naechsten UTC-Tag
export type DailyView = {
	day       : number,
	claimable : boolean,
	streak    : number,
	resetIn   : number,
}

-- Eine einzelne Kampf-AKTION (v14: Runden-Log). Bleibt serverseitig in
-- CombatCalculator und wird NICHT komplett an den Client geschickt: ein
-- PIT-Lauf hat viele Stages, das ganze Protokoll waere ein Vielfaches der
-- Nutzlast. Der Client bekommt pro Stage nur die Zusammenfassung
-- (PitStageResult.skillUses / firstSkillRound) — genug fuer die SkillFX.
--
-- Seit v14 handelt jeder Kaempfer nach seiner SPD (siehe CombatCalculator),
-- ein Eintrag ist deshalb EINE Aktion von A oder B, nicht mehr eine
-- Doppelrunde.
export type RoundLogEntry = {
	roundNumber     : number,     -- wievielte Aktion von A (der Baerchi)
	actor           : string,     -- "A" | "B"
	-- v15: was in diesem Zug passiert ist: "hit" (Stoss), "skill"
	-- (Faehigkeit), "burst" (Feuerstoss nach Letzter Chance), "stunned"
	kind            : string,
	chargeA         : number,     -- v15: Ladestand von A nach dem Zug (0..1)
	skillUsed       : boolean,
	skillId         : string?,
	damage          : number,     -- wirklich abgezogene HP beim Ziel
	heal            : number,
	absorbed        : number,     -- vom Schild abgefangen
	effects         : { string }?, -- "stun", "slow", "dot", "burn:12", "laststand" ...
	attackerHpAfter : number,     -- HP von A nach der Aktion
	defenderHpAfter : number,     -- HP von B nach der Aktion
}

-- v15: ein Zug fuer die WIEDERGABE in der Arena (aus RoundLogEntry
-- verdichtet). Bleibt serverseitig: CombatService baut die Liste,
-- PitArenaService spielt sie ab (Stoesse, Faehigkeiten, Lebens- und
-- Ladeleisten). HP und Ladung als Anteil 0..1, damit die Leisten direkt
-- gesetzt werden koennen.
export type FightBeat = {
	actor   : string,    -- "A" = der Baerchi, "B" = der Gegner
	kind    : string,    -- "hit" | "skill" | "burst" | "stunned"
	selfHp  : number,    -- HP des Baerchis nach dem Zug (0..1)
	enemyHp : number,    -- HP des Gegners nach dem Zug (0..1)
	charge  : number,    -- Ladestand der Faehigkeit des Baerchis (0..1)
	skillId : string?,   -- bei "skill"/"burst"
}

-- Eine bestandene (oder verlorene) Stage innerhalb eines PIT-Laufs.
export type PitStageResult = {
	stage      : number,
	won        : boolean,
	rounds     : number,
	hpAfter    : number,   -- HP des Baerchis NACH dieser Stage
	gummiesWon : number,
	-- v14: fuer die Fähigkeiten-Animation (SkillFX)
	skillUses       : number?,   -- wie oft der Skill in dieser Stage kam
	firstSkillRound : number?,   -- erste Aktion mit Skill (nil = keiner)
}

-- Ergebnis eines kompletten PIT-Laufs.
--
-- Ein Lauf ist kein einzelner Kampf mehr: der Baerchi kaempft Stage fuer
-- Stage weiter, solange er ueberlebt. Seine HP werden zwischen den Stages
-- NICHT zurueckgesetzt — der Lauf endet erst wenn er verliert. Danach steht
-- er erschoepft (hpAfter, meist 0) auf dem Plot und muss mit Honig
-- hochgefuettert werden.
export type PitRunResult = {
	baerchiUid    : string,
	towerId       : string?,          -- v15: in welchem Tower der Lauf war
	capStage      : number?,          -- v15: Deckel des Rebirths in diesem Tower (Belohnung/Rekord nur bis hier)
	capReached    : boolean?,         -- v15: der Lauf hat den Deckel erreicht (Rebirth-Hinweis)
	newRecord     : number?,          -- v15: neuer Tower-Rekord (nil = keiner)
	startStage    : number,           -- v12: erste gespielte Stage (1 = von vorn, sonst Fortsetzung)
	recalled      : boolean,          -- v12: true = vom Spieler nach einer Stage zurueckgeholt
	corrected     : boolean?,         -- v12: true = nachgeschicktes, gekuerztes Ergebnis nach dem Zurueckholen
	stagesCleared : number,           -- wie viele Stages gewonnen wurden
	stages        : { PitStageResult },
	gummiesWon    : number,           -- Summe ueber alle Stages, bereits mit rebirthMult
	goldGummiesWon: number,           -- Meilenstein-Belohnung (siehe EconomyConfig)
	hpBefore      : number,           -- HP mit denen der Lauf gestartet wurde
	hpAfter       : number,
	maxHp         : number,
}

-- Ergebnis einer Fuetterung: ein Honig heilt und gibt XP.
export type FeedResult = {
	baerchiUid : string,
	buildingId : BuildingId,   -- aus welchem Gebaeude der Honig kam
	hpGained   : number,
	xpGained   : number,
	leveledUp  : boolean,
	newLevel   : number,
	hpAfter    : number,
	maxHp      : number,
}

export type HatchResult = {
	eggType  : EggType,
	baerchi  : Baerchi,
	isNew    : boolean,   -- erstes Mal dieser configId → besondere Animation
}

-- Ergebnis eines Charm-Wurfs, eines Events oder einer Fusion enthaelt den
-- Baerchi selbst — `mutation` steht dort mit drin, ein eigener Typ dafuer
-- waere ueberfluessig.

export type FusionResult = {
	resultBaerchi : Baerchi,
	consumedUids  : { string },
}

export type RecycleResult = {
	consumedUid   : string,
	gummiesGained : number,
	goldGummiesGained : number,
}

-- Ergebnis einer Befoerderung (PromotionService).
export type PromotionResult = {
	baerchiUid       : string,
	newPromotion     : number,      -- 1 - PromotionConfig.MAX_PROMOTION
	consumedUids     : { string },  -- die verbrauchten Duplikate
	unlockedSlots    : { number },  -- Charm-Slots, die durch DIESE Stufe dazukamen
}

-- Ergebnis eines Charm-Wurf-Pakets (CharmService).
--
-- `rolls` ist die Anzahl der tatsaechlich durchgefuehrten Wuerfe: bei einem
-- Auto-Roll kann sie kleiner sein als angefragt, wenn zwischendurch die
-- GoldGummies ausgehen. Der Client zeigt genau diese Zahl an, nicht die
-- angefragte — sonst behauptet die Oberflaeche etwas, das nicht passiert ist.
export type CharmRollResult = {
	baerchiUid       : string,
	rolls            : number,
	goldGummiesSpent : number,
	charms           : { Charm },   -- Stand NACH allen Wuerfen
}

-- Ein gelegtes Ei wurde eingesammelt (fuer den Toast beim Spieler).
export type EggCollectResult = {
	eggUid   : string,
	eggType  : EggType,
	inStock  : number,   -- wie viele von dieser Sorte jetzt im Lager liegen
}

-- Beim Join nachgerechnete Eier aus der Abwesenheit. Wird zusammen mit dem
-- Honig-Bericht gezeigt (siehe OfflineReport) — aber als eigener Typ, weil
-- die beiden Systeme sonst aneinander haengen wuerden.
export type OfflineEggReport = {
	laid        : number,   -- wie viele Eier nachgelegt wurden
	skipped     : boolean,  -- true wenn die Obergrenze das Nachlegen gebremst hat
	secondsAway : number,
}

-- Was eine Event-Teilnahme gebracht hat (EventParticipationService).
--
-- Heisst weiterhin "StatGain", weil die Stat-Stufe der Kern der Belohnung ist —
-- seit dem Event-Katalog (EventConfig) kann aber zusaetzlich ein Bonus dazu
-- kommen, und in einem Fall NUR der Bonus.
export type EventStatGain = {
	baerchiUid : string,
	eventId    : string,

	-- Welcher Stat gestiegen ist ("hp" | "atk" | "spd" | "pwr" | "egg").
	--
	-- nil heisst: es gab KEINE Stat-Stufe, weil bereits jeder Stat dieses
	-- Baerchis an seiner Rarity-Obergrenze steht. Der Bonus unten wurde
	-- trotzdem vergeben — deshalb ist das kein Fehlerfall, und der Client muss
	-- diesen Fall anzeigen koennen statt ihn zu verwerfen.
	statKey    : string?,
	newLevel   : number,   -- 0, wenn statKey nil ist
	cap        : number,

	-- Der Zusatz-Ertrag dieses Events als fertiger Text ("+1x Goldenes Ei").
	-- nil = dieses Event hatte keinen Bonus, oder der Wurf ging daneben
	-- (Mutations-Sturm). Bewusst als Text und nicht als Zahlenfeld pro
	-- Bonus-Art: der Client zeigt ihn nur an, und die Formulierung soll an
	-- EINER Stelle stehen (EventConfig.describeBonus bzw. der Ausgabe-Text in
	-- EventParticipationService).
	bonusText  : (string | LocMsg)?,   -- Sammel-Update 2.4: meist LocMsg

	-- Gesetzt, wenn der Baerchi durch dieses Event eine (bessere) Mutation
	-- bekommen hat — der seltenste Ausgang im ganzen Event-System, deshalb als
	-- eigenes Feld statt nur im Text: der Client faerbt den Hinweis damit ein.
	mutation   : MutationId?,

	-- true: Zwischenmeldung WAEHREND eines Events (UFO-Kampf, Fund, Entfuehrung)
	-- statt Abschlussmeldung. Der Client zeigt dann nur `bonusText`.
	midEvent   : boolean?,

	-- Neue Rarity, falls das UFO den Baerchi aufsteigen liess.
	rarityUp   : string?,
}

-- Telegraph einer Boss-Attacke (Server → alle Clients, Remotes.EventTelegraph).
-- Die Wahrheit (wer getroffen wird) rechnet der Server zum Zeitpunkt hitAt;
-- der Client zeichnet nur die Warnflaeche von jetzt bis hitAt.
--   kind = "ring"    Kreisring um `center` zwischen `inner` und `outer`
--   kind = "circles" Kreise mit Radius `radius` um jeden Punkt in `points`
--   kind = "lane"    Bahn von `from` nach `to`, Breite `width`
-- warnAt/hitAt sind Serverzeiten (workspace:GetServerTimeNow()).
export type HazardTelegraph = {
	kind   : "ring" | "circles" | "lane",
	center : Vector3?,
	inner  : number?,
	outer  : number?,
	points : { Vector3 }?,
	radius : number?,
	from   : Vector3?,
	to     : Vector3?,
	width  : number?,
	warnAt : number,
	hitAt  : number,
}

-- Treffer einer Boss-Attacke am eigenen Charakter (Server → ein Client,
-- Remotes.EventHazardHit). Der Server hat entschieden; der Client fuehrt nur
-- die Physik an seinem eigenen Charakter aus (er besitzt ihn).
export type HazardHit = {
	push        : Vector3,   -- Rueckstoss (Studs/s, waagerecht)
	slowFactor  : number,    -- WalkSpeed-Faktor fuer slowSeconds
	slowSeconds : number,
	-- Sammel-Update 05.10. (Paket 5.2): "boss" (Standard) oder "brawl"
	-- (gegnerischer Event-Baerchi) — nur fuer die Meldung beim Client.
	source      : string?,
}

export type RebirthResult = {
	newRebirthCount : number,
	newMultiplier   : number,
	ascensionEggs   : number,   -- Summe aller Meilenstein-Eier (0 = keine), fuer alte Anzeigen
	-- v14: Meilenstein-Eier nach Sorte (Ascension, Transzendenz, Ewigkeit, Omega)
	milestoneEggs   : { { eggType: EggType, count: number } }?,
}

-- v14: ein Knoten im Ei-Baum ist frei geworden (fuer den Toast).
export type EggUnlockResult = {
	eggType : EggType,
	reason  : string,    -- "tree" | "blueprint" | "rebirth" | "migration"
}

-- v14: Ergebnis der Ei-Presse.
export type EggPressResult = {
	fromEgg : EggType,
	toEgg   : EggType,
	used    : number,
}

-- v15: ein Tower-Meilenstein wurde ausgezahlt (Toast).
export type TowerMilestoneReward = {
	towerId     : string,
	stage       : number,
	gummies     : number,   -- ohne Rebirth-Multiplikator
	goldGummies : number,
	eggType     : EggType?,
	eggs        : number,
	blueprints  : number,
	endlessLevels : number?, -- Paket 9: +Endless-Level fuer den ausgeruesteten Baerchi
}

-- v15: eine Zeile einer Bestenliste (Server → Client).
export type LeaderboardEntry = {
	rank   : number,
	userId : number,
	name   : string,
	value  : number,
}

-- v15: eine Bestenliste. listId = "Tower" | "Rebirths" | "Collection".
-- ownRank = Rang des Anfragenden (nil = nicht in den Top N).
export type LeaderboardView = {
	listId    : string,
	entries   : { LeaderboardEntry },
	ownRank   : number?,
	ownValue  : number,
	updatedAt : number,
}

-- v15: die Profilkarte eines anderen Spielers (Inspektor). Der Server baut sie
-- aus den Daten im Speicher — rohe PlayerData gehen nie an fremde Clients.
export type ProfileBaerchi = {
	configId  : string,
	rarity    : Rarity,
	mutation  : MutationId?,
	level     : number,
	promotion : number,
	power     : number,   -- grobe Staerke (fuer die Top-3-Sortierung)
}

export type PlayerProfileCard = {
	userId       : number,
	name         : string,
	equipped     : ProfileBaerchi?,
	highestTower : string,
	towerRecord  : number,
	rebirths     : number,
	indexCount   : number,
	indexTotal   : number,
	top          : { ProfileBaerchi },
}

-- v16 (Sammel-Update, Paket 6.2): ein besonderer Meilenstein wurde
-- ausgezahlt (Toast). id = Schluessel in EconomyConfig.SPECIAL_MILESTONES.
export type SpecialMilestoneResult = {
	id   : string,
	eggs : { { eggType: EggType, count: number } },
}

-- v16 (Sammel-Update, Paket 7): eine Index-Belohnung wurde abgeholt (Toast).
export type IndexRewardResult = {
	rewardId       : string,
	gummies        : number,
	goldGummies    : number,
	eggType        : EggType?,
	eggs           : number,
	blueprints     : number,
	incubatorSlots : number,
}

-- v15: Ergebnis des Login-Bonus (Toast).
export type DailyBonusResult = {
	day         : number,
	gummies     : number,
	goldGummies : number,
	eggType     : EggType?,
	eggs        : number,
	blueprint   : boolean,
}

-- Offline-Ertrag beim Join (Server → Client, direkt nach dem ersten Sync).
-- Seit v4 ist das der Honig, den die Gebaeude waehrend der Abwesenheit
-- produziert haben — gedeckelt durch EconomyConfig.HONEY_CAPACITY pro
-- Gebaeude, laenger weg bringt also nichts zusaetzlich.
export type OfflineReport = {
	secondsAway  : number,
	honeyGained  : number,
}

--------------------------------------------------------------------------------
-- Default-Fabrik (nur PlayerService darf dies aufrufen)
--------------------------------------------------------------------------------

local function createDefaultPlayerData(): PlayerData
	local now = os.time()

	local data: PlayerData = {
		-- v11: das binaere isInverted-Feld weicht dem gestuften Mutation-System
		-- (siehe Baerchi.mutation und BaerchiConfig.MUTATIONS). Die Migration in
		-- PlayerService bildet alte isInverted=true-Eintraege auf eine feste
		-- Mutation ab und entfernt das alte Feld — DAS ist der Grund, warum
		-- diese Zahl steigen MUSS: es wird wieder etwas ENTFERNT, nicht nur
		-- ein fehlendes Feld angelegt (dieselbe Konvention wie beim v9-Sprung).
		--
		-- v10: der ausgeruestete Baerchi legt Eier. Neu sind island.laidEggs
		-- und island.lastEggAt; die Migration legt beide an.
		--
		-- v9: DEF ist ersatzlos entfallen, PWR (Ability-Staerke) ist an seine
		-- Stelle getreten, und jeder Baerchi hat ein isInverted-Feld bekommen.
		-- Die Migration (Util/PlayerMigration) raeumt dafuer die alten def-Eintraege
		-- aus statLevels und baseStatOverride weg — DAS ist der Grund, warum
		-- diese Zahl steigen MUSS: die Migration entfernt etwas, statt nur ein
		-- fehlendes Feld anzulegen.
		--
		-- v8: jeder Baerchi hat drei neue Felder bekommen (promotionLevel,
		-- statLevels, charms) plus das optionale baseStatOverride. Die
		-- zugehoerige Migration (Util/PlayerMigration) legt sie auf bestehenden
		-- Baerchis an — sie erkennt fehlende Felder selbst und ist deshalb
		-- gefahrlos wiederholbar.
		--
		-- v7: eigene Rolle pro Gebaeude. KEIN neues Feld — die Zahl stieg
		-- trotzdem, weil die zugehoerige Migration (Util/PlayerMigration) einen Wert
		-- UMRECHNET (die Presse erbt einmalig das hoechste Gebaeude-Level) und
		-- deshalb genau einmal laufen darf.
		-- v13: Quests + Index. Neu: discovered, quests, stats.totalHatched. Die
		-- Migration seedet discovered aus den vorhandenen Baerchis und setzt
		-- totalHatched auf deren Anzahl, damit Veteranen nicht bei null starten.
		-- v12: Brut-Slots entfallen (Eier werden sofort geoeffnet), die
		-- Migration legt laufende Bruten zurueck ins Lager und ENTFERNT
		-- island.hatchingEggs. Neu: island.pitProgress (optional).
		-- v15: Gebaeude Option B (Honigtopf + Honig-Presse -> HoneyRefiner),
		-- Level 1-60, Tower statt PIT-Level (towers, island.towerProgress,
		-- island.pitRefund), Login-Bonus (daily). Die Migration RECHNET um
		-- (Veredler-Level, PIT-Erstattung, alter Rekord) — deshalb Sprung.
		-- v16 (Sammel-Update 05.10.): island.stageBest (Rebirth nach Stage),
		-- island.incubator (Inkubator), indexClaimed (Index-Belohnungen),
		-- specialClaimed (besondere Meilensteine). EINE gemeinsame Migration;
		-- sie legt nur an und saeet stageBest aus towerProgress, fasst keine
		-- Waehrung an.
		-- v17 (08.10., Tower-Terminal): towers.unlocked. Die Migration RECHNET
		-- die alte Rebirth-Regel in Freischaltungen um (Bestandsschutz) und
		-- darf das nur einmal — deshalb Sprung.
		version    = 17,  -- v17: Tower-Freischaltung durch Schaffen, v16: Sammel-Update, v15: Tower + Gebaeude B + Login-Bonus, v14: Ei-Baum, v13: Quests + Index (discovered, quests, stats.totalHatched), v12: Sofort-Oeffnen + pitProgress, v11: Mutation-System (v10: Eier legen, v9: PWR statt DEF + Inverted, v8: Promotion/Charms/Stat-Level, v7: Gebaeude-Rollen, v6: equippedUid, v5: Ei-uid, v4: Honig-Gebaeude + currentHp)
		createdAt  = now,
		lastSeenAt = now,

		gummies     = 100,
		goldGummies = 0,

		rebirthCount = 0,
		rebirthMult  = 1.0,

		rank = {
			tier   = 1,
			name   = "Gummy Hatchling",
			points = 0,
		},

		island = {
			-- Beide Honig-Gebaeude stehen ab dem ersten Join auf dem Plot und
			-- fangen sofort an zu produzieren.
			buildings = {
				Beehive      = { id = "Beehive",      level = 1, honey = 0, lastProducedAt = now },
				HoneyRefiner = { id = "HoneyRefiner", level = 1, honey = 0, lastProducedAt = now },
				HoneyPond    = { id = "HoneyPond",    level = 1, honey = 0, lastProducedAt = now },
			},
			baerchis     = {},
			eggStock     = {
				-- Sammel-Update 05.10. (Paket 6.4, "mehr Eier am Anfang"): 3 -> 6.
				-- Die ersten Minuten sollen mehrere Schluepf-Momente haben, bevor das
				-- Legen uebernimmt. Ein Rebirth setzt das Lager NICHT zurueck (siehe
				-- RebirthService), Veteranen bekommen also nichts doppelt.
				BasicEgg = 6,  -- Starter-Eier fuer den ersten Join
			},
			equippedUid  = nil,   -- noch kein Baerchi da, der ausgeruestet sein koennte

			laidEggs  = {},
			lastEggAt = now,

			recycler = { level = 1, queued = 0, progress = 0, lastProcessedAt = now },

			towerProgress = {},
			pitRefund     = 0,

			stageBest = {},                       -- v16: Paket 4.1
			incubator = { level = 1, slots = {}, breeders = {} },  -- v16: Paket 8
		},

		stats = {
			totalGummiesEarned  = 0,
			totalFightsWon      = 0,
			totalFightsLost     = 0,
			totalFusions        = 0,
			totalRebirths       = 0,
			totalRecycled       = 0,
			totalHatched        = 0,
			totalEventsCompleted = 0,
			bossVictories        = 0,   -- v16: Paket 6.2
			totalCombsDelivered  = 0,   -- v16: Paket 3.5
			sessions             = 0,   -- HBB Paket 10: Sitzungen (Shop ab der 2.)
		},

		-- HBB Paket 10: Shop (Modules/ShopRules). freeGrabDay = UTC-Tag des
		-- letzten Gratis-Griffs (-1 = nie), receipts = gemerkte Robux-Kauf-IDs.
		shop = { freeGrabDay = -1, receipts = {} },

		discovered = {},
		uiSeen     = {},

		eggTree = {
			unlocked   = { BasicEgg = true, SugarEgg = true },
			hatched    = {},
			pressed    = {},
			blueprints = 0,
			bypass     = {},
		},

		towers = {
			records      = {},
			claimed      = {},
			highestTower = "I",
			selected     = "I",
			unlocked     = { I = true },   -- v17
		},

		daily = {
			lastClaimDay = 0,
			streak       = 0,
		},

		indexClaimed   = {},   -- v16: Paket 7
		specialClaimed = {},   -- v16: Paket 6.2

		quests = {
			chainClaimed = 0,
			day          = 0,   -- 0 = noch nie gesetzt; QuestService setzt beim Join den Tag
			baseline     = { hatched = 0, fightsWon = 0, gummies = 0 },
			dailyClaimed = {},
		},
	}

	-- Honig-Teich oder Stock + Veredler, je nach Schalter (neue Spieler und
	-- Rebirth gehen beide hierueber).
	HoneyPondMode.apply(data.island, FeatureFlags.isOn("HONEY_POND_V2"), now)
	return data
end

return {
	createDefaultPlayerData = createDefaultPlayerData,
}
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX72"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX35"><Properties><string name="Name">Core</string></Properties><Item class="Script" referent="RBX34"><Properties><string name="Name">GameManager</string><ProtectedString name="Source"><![CDATA[--!strict
-- GameManager.server.luau
-- ServerScriptService/Core/GameManager.server.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Services laden und in drei Phasen starten
--
-- Kein anderes Skript startet Services. Die drei Phasen:
--   1. laden   alle Module per require — danach existiert jedes Modul
--   2. init()  jeder Service richtet sich ein: Remotes verbinden, Rueckrufe
--              bei anderen Services anmelden (onDataLoaded, onEventEnded ...)
--   3. start() erst jetzt passiert etwas mit Spielern oder Zeit: PlayerService
--              laedt verbundene Spieler, EventService startet den Zyklus
--
-- Weil kein Service in init() schon Spieler verarbeitet, ist die Reihenfolge
-- in REGISTRY beliebig: jeder Rueckruf ist angemeldet, bevor der erste
-- Spieler geladen wird. Ein neuer Service traegt sich irgendwo ein und
-- verschiebt Arbeit mit Spielern in ein start().

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService          = game:GetService("RunService")

-- ALLERERSTE Zeile mit Wirkung, bevor irgendein Service laedt: kein Spieler
-- soll automatisch in der Weltmitte landen. Stattdessen spawnt PlayerService
-- jeden Spieler explizit auf seiner eigenen Insel (player:LoadCharacter(),
-- erst NACHDEM MapService.spawnIsland sein RespawnLocation gesetzt hat — siehe
-- PlayerService.onPlayerAdded). Muss vor jedem require() stehen: ein Spieler
-- kann in Studio-Play-Solo bereits verbunden sein, sobald dieses Skript
-- ueberhaupt zu laufen beginnt.
Players.CharacterAutoLoads = false

-- Der Name links ist nur fuer den Studio-Debug-Hook am Ende der Datei
-- relevant. Gruppiert nach Thema, nicht nach Abhaengigkeit.
local REGISTRY: { { name: string, module: ModuleScript } } = {
	-- Infrastruktur
	{ name = "RateLimiter",    module = ServerScriptService.Util.RateLimiter },
	{ name = "PlayerService",  module = ServerScriptService.Services.PlayerService },
	{ name = "EconomyService", module = ServerScriptService.Services.EconomyService },

	-- Welt und Darstellung
	{ name = "MapService",              module = ServerScriptService.Services.MapService },
	{ name = "PlotDisplayService",      module = ServerScriptService.Services.PlotDisplayService },
	{ name = "BaerchiAutopilotService", module = ServerScriptService.Services.BaerchiAutopilotService },

	-- Insel, Honig, Eier
	{ name = "IslandService",      module = ServerScriptService.Services.IslandService },
	{ name = "HoneyService",       module = ServerScriptService.Services.HoneyService },
	{ name = "EggService",         module = ServerScriptService.Services.EggService },
	{ name = "EggMerchantService", module = ServerScriptService.Services.EggMerchantService },
	{ name = "EggLayService",      module = ServerScriptService.Services.EggLayService },
	{ name = "EggTreeService",     module = ServerScriptService.Services.EggTreeService },
	-- Sammel-Update 05.10.: Inkubator (Paket 8), Index-Belohnungen (Paket 7),
	-- besondere Meilensteine (Paket 6.2)
	{ name = "IncubatorService",        module = ServerScriptService.Services.IncubatorService },
	{ name = "IndexRewardService",      module = ServerScriptService.Services.IndexRewardService },
	{ name = "SpecialMilestoneService", module = ServerScriptService.Services.SpecialMilestoneService },

	-- Kampf
	{ name = "PitArenaService", module = ServerScriptService.Services.PitArenaService },
	{ name = "CombatService",   module = ServerScriptService.Services.CombatService },
	{ name = "PetModeService",  module = ServerScriptService.Services.PetModeService },
	-- v15: Tower-Fortschritt (ersetzt das PIT-Level)
	{ name = "TowerService",    module = ServerScriptService.Services.TowerService },
	{ name = "GamepassService", module = ServerScriptService.Services.GamepassService },   -- 08.10. Paket C

	-- Events
	{ name = "EventService",              module = ServerScriptService.Services.EventService },
	{ name = "EventParticipationService", module = ServerScriptService.Services.EventParticipationService },
	-- Sammel-Update 05.10. (Paket 5.2): Kampf um die Mitte
	{ name = "PitBrawlService",           module = ServerScriptService.Services.PitBrawlService },

	-- Waben: Sammeln im Event-Pit und der Recycler auf dem Plot
	{ name = "CombRecyclerService", module = ServerScriptService.Services.CombRecyclerService },
	{ name = "CombService",         module = ServerScriptService.Services.CombService },

	-- Baerchis veraendern
	{ name = "FusionService",    module = ServerScriptService.Services.FusionService },
	{ name = "RecycleService",   module = ServerScriptService.Services.RecycleService },
	{ name = "PromotionService", module = ServerScriptService.Services.PromotionService },
	{ name = "CharmService",     module = ServerScriptService.Services.CharmService },
	{ name = "RebirthService",   module = ServerScriptService.Services.RebirthService },

	-- Meta
	{ name = "QuestService",    module = ServerScriptService.Services.QuestService },
	{ name = "SettingsService", module = ServerScriptService.Services.SettingsService },

	-- v15: Angeben (Bestenlisten, Inspektor, Abzeichen) und Login-Bonus
	{ name = "LeaderboardService", module = ServerScriptService.Services.LeaderboardService },
	{ name = "ProfileService",     module = ServerScriptService.Services.ProfileService },
	{ name = "PlayerBadgeService", module = ServerScriptService.Services.PlayerBadgeService },
	{ name = "LoginBonusService",  module = ServerScriptService.Services.LoginBonusService },

	-- HBB Paket 0: Messpunkte (Onboarding-Trichter, UI-Ereignisse)
	{ name = "FunnelService",      module = ServerScriptService.Services.FunnelService },
	-- HBB Paket 3: Anzeigestand (welche Bedienelemente schon gesehen sind)
	{ name = "UiStateService",     module = ServerScriptService.Services.UiStateService },
	-- HBB Paket 5: Heim-Knopf (zurueck auf den eigenen Plot)
	{ name = "HomeService",        module = ServerScriptService.Services.HomeService },
	-- HBB Paket 6: Live-Kampf-Board auf der Hauptinsel
	{ name = "LiveBoardService",   module = ServerScriptService.Services.LiveBoardService },
	-- HBB Paket 10: Shop (Gratis-Griff, Robux-Goldpakete)
	{ name = "ShopService",        module = ServerScriptService.Services.ShopService },

	-- Kein Spiel-Service: die Studio-Test-Schnittstelle
	{ name = "DebugService", module = ServerScriptService.Services.DebugService },
}

local loaded: { [string]: any } = {}

for _, entry in REGISTRY do
	loaded[entry.name] = require(entry.module)
end

for _, entry in REGISTRY do
	local service = loaded[entry.name]
	if service.init then
		service.init()
	end
end

for _, entry in REGISTRY do
	local service = loaded[entry.name]
	if service.start then
		service.start()
	end
end

--------------------------------------------------------------------------------
-- Studio-Debug-Hook
--
-- Legt die tatsaechlich laufenden Service-Instanzen unter _G.RBL ab.
-- Nur in Studio — im Live-Spiel existiert der Hook nicht.
--
-- ACHTUNG, gemessen und bestaetigt: die Studio Command Bar laeuft in einem
-- EIGENEN Lua-VM. Sie sieht dieses _G NICHT, und ein dortiges
-- require(ServerScriptService.Services.PlayerService) liefert eine zweite,
-- nie initialisierte Kopie des Moduls mit leerem _playerData — Aufrufe darauf
-- laufen still ins Leere. Zum Testen aus der Command Bar deshalb IMMER die
-- BindableFunction benutzen, die DebugService anlegt:
--
--   game.ServerScriptService.RBLDebug:Invoke("help")
--
-- _G.RBL ist nur fuer anderen Server-Code im selben VM gedacht.
--------------------------------------------------------------------------------

if RunService:IsStudio() then
	local debugTable: { [string]: any } = {}
	for name, service in loaded do
		debugTable[name] = service
	end

	-- Configs und Factories gleich mitgeben, die braucht man beim Testen staendig
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	debugTable.EconomyConfig  = require(ReplicatedStorage.Config.EconomyConfig)
	debugTable.BaerchiConfig  = require(ReplicatedStorage.Config.BaerchiConfig)
	debugTable.EggConfig      = require(ReplicatedStorage.Config.EggConfig)
	debugTable.BaerchiFactory = require(ReplicatedStorage.Modules.BaerchiFactory)

	_G.RBL = debugTable
	print("[GameManager] Studio-Debug-Hook aktiv — Zugriff ueber _G.RBL")
end

print("[GameManager] Alle Services gestartet")
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX58"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">BaerchiAutopilotService</string><ProtectedString name="Source"><![CDATA[--!strict
-- BaerchiAutopilotService.luau
-- ServerScriptService/Services/BaerchiAutopilotService.luau
--
-- Einzige Zustaendigkeit:
--   - Den AUSGERUESTETEN Baerchi von sich aus zum Honig-Teich auf dem
--     eigenen Plot laufen und dort essen lassen, sobald welcher da ist —
--     auch bei vollen HP, solange noch Level drin sind (siehe shouldEat
--     unten). Das Spiel ist auf laengeres AFK-Grinden ausgelegt: wer online
--     ist, aber gerade nicht selbst spielt, soll trotzdem weiter Fortschritt
--     machen, solange Honig produziert wird.
--
-- Essen ist seit dem Equip-System die einzige automatische Aktion im Spiel:
-- Kaempfen, Ausbauen und Fusion loest weiterhin der Spieler selbst aus. Es
-- gibt nur noch EINEN Baerchi auf dem Plot zu sehen (siehe MapService,
-- IslandService) — ein Fuetter-Knopf am Gebaeude fuer "irgendeinen erschoepften
-- Baerchi" waere ohne die anderen sichtbaren Baerchis ohnehin bedeutungslos.
-- Stattdessen kuemmert sich der ausgeruestete Baerchi selbst darum.
--
-- Die eigentliche Heilung/XP-Vergabe passiert weiterhin in HoneyService.feed
-- (einzige Stelle die Honig verbraucht) — dieser Service entscheidet nur WANN
-- und spielt das Hinlaufen sichtbar ab.
--
-- ActivityLock verhindert, dass der Baerchi gleichzeitig zum Teich laeuft
-- UND in den PIT geschickt wird; ein Kampf hat dabei immer Vorrang
-- (PitArenaService nimmt das Schloss notfalls per forceAcquire weg).

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local FigurePlacement  = require(ServerScriptService.Util.FigurePlacement)   -- Sammel-Update 1.2
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local Types            = require(ReplicatedStorage.Network.Types)

local FigureWalker  = require(ServerScriptService.Util.FigureWalker)
local FigureFX      = require(ServerScriptService.Util.FigureFX)
local ActivityLock  = require(ServerScriptService.Util.ActivityLock)
local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)
local HoneyService  = require(ServerScriptService.Services.HoneyService)

local BaerchiAutopilotService = {}

local LOCK_HOLDER = "Autopilot"

-- Wie oft nachgesehen wird, ob der ausgeruestete Baerchi essen gehen sollte.
-- Muss nicht schnell sein: das Fuettern selbst ist nicht zeitkritisch, nur
-- regelmaessig genug, dass es sich von alleine anfuehlt.
local CHECK_INTERVAL = 3

-- Wie lange am Teich "gegessen" wird, bevor es zurueckgeht — rein optisch,
-- der eigentliche Honig-Abzug passiert sofort beim Ankommen. Diese Zeit wird
-- von der Vorbeuge-Bewegung (FigureFX.leanForward) genau ausgefuellt, statt
-- sie einfach abzuwarten.
local EAT_PAUSE_SECONDS = 1.2

local function footPosOf(model: Model): Vector3
	return FigurePlacement.footOf(model)   -- Sammel-Update 1.2
end

-- Braucht der ausgeruestete Baerchi gerade Honig, und ist welcher da?
--
-- Seit v8 gilt das auch bei VOLLEN HP: Honig ist die einzige XP-Quelle im
-- Spiel (siehe HoneyService, Kopf-Kommentar), und das Spiel ist bewusst auf
-- laengeres AFK-Grinden ausgelegt — der ausgeruestete Baerchi soll von
-- alleine weiteressen und -leveln, solange er auf dem Plot steht, nicht nur
-- wenn er gerade verletzt aus dem PIT kommt. Einzige Grenze ist das
-- Maximal-Level: darueber hinaus braechte weiteressen nichts mehr, und der
-- Honig bleibt dann fuer die Heilung nach dem naechsten Kampf liegen.
local function shouldEat(data: Types.PlayerData, baerchi: Types.Baerchi): boolean
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then return false end

	local maxHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
	if maxHp <= 0 then return false end

	if HoneyService.getTotalHoney(data) <= 0 then
		return false
	end

	local hpRatio = math.clamp(baerchi.currentHp or maxHp, 0, maxHp) / maxHp
	if hpRatio < 1 then
		return true
	end

	-- Voll geheilt: nur noch fuers Leveln weiteressen, und nur solange das
	-- ueberhaupt noch etwas bringt (Paket 9: mit offenem Endless immer).
	return baerchi.level < BaerchiConfig.MAX_LEVEL or TowerConfig.isEndlessOpen(data.towers.records)
end

local function runEatCycle(player: Player, baerchiUid: string)
	if not ActivityLock.tryAcquire(player, LOCK_HOLDER) then
		return
	end

	task.spawn(function()
		-- Wird gesetzt, sobald feststeht welche Figur bewegt wird — damit sie
		-- nach der Sequenz (auch nach einem Fehler) wieder atmen darf.
		local moved: Model? = nil

		local ok, err = pcall(function()
			local figure = MapService.getBaerchiModel(player, baerchiUid)
			local pond   = MapService.getPondPosition(player)
			if not figure or not pond then
				return
			end

			-- Ruhe-Atmen abschalten, BEVOR der Heimat-Fusspunkt gemessen wird:
			-- sonst waere der gemerkte Punkt um einen Teil des Hubs zu hoch und
			-- der Baerchi kaeme jedes Mal ein Stueckchen ueber dem Boden an.
			-- Ausserdem wuerden sich Idle-Loop und Lauf sonst gegenseitig
			-- ueberschreiben.
			moved = figure
			FigureFX.stopIdle(figure)

			local homeFoot = footPosOf(figure)

			-- Bricht ab, sobald irgendetwas dem Baerchi das Schloss abnimmt
			-- (ein Kampf), er von der Karte verschwindet, oder gar nicht mehr
			-- der ausgeruestete Baerchi ist (equipBaerchi hat inzwischen die
			-- Figur ausgetauscht).
			local function cancelled(): boolean
				return ActivityLock.owner(player) ~= LOCK_HOLDER
					or player.Parent == nil
					or figure.Parent == nil
					or MapService.getBaerchiModel(player, baerchiUid) ~= figure
			end

			FigureWalker.walk(figure, homeFoot, pond, {
				speed       = MapConfig.WALK_SPEED,
				isCancelled = cancelled,
			})
			if cancelled() then return end

			-- HoneyService.feed prueft selbst nochmal ob es sich noch lohnt
			-- (Honig da, Baerchi nicht laengst anderweitig geheilt) — der
			-- Lauf zum Teich dauert ein paar Sekunden, in denen sich das
			-- theoretisch geaendert haben kann.
			if PlayerService.getData(player) then
				HoneyService.feed(player, baerchiUid)
			end

			-- Statt die Fress-Pause einfach abzuwarten: sich hinunterbeugen,
			-- kurz unten bleiben, wieder aufrichten. Dauert exakt so lange wie
			-- das bisherige task.wait — die Sequenz wird also nicht laenger,
			-- man sieht nur, dass er frisst.
			FigureFX.leanForward(figure, MapConfig.EAT_LEAN_DEGREES, EAT_PAUSE_SECONDS)
			if cancelled() then return end

			FigureWalker.walk(figure, pond, homeFoot, {
				speed       = MapConfig.WALK_SPEED,
				isCancelled = cancelled,
			})
		end)

		if not ok then
			warn("[BaerchiAutopilotService] Ess-Sequenz fehlgeschlagen:", err)
		end

		-- Wieder atmen lassen — aber NUR wenn die Figur noch uns gehoert.
		-- Wurde die Sequenz abgebrochen, weil ein Kampf das Schloss per
		-- forceAcquire uebernommen hat, bewegt PitArenaService die Figur
		-- gerade selbst; ein Idle-Loop wuerde ihm dabei dazwischenfunken.
		-- Dieselbe Bedingung, unter der auch das Schloss noch unseres ist.
		if moved and moved.Parent ~= nil and ActivityLock.owner(player) == LOCK_HOLDER then
			FigureFX.idleBob(moved, {
				height = MapConfig.IDLE_BOB_HEIGHT,
				rate   = MapConfig.IDLE_BOB_RATE,
			})
		end

		ActivityLock.release(player, LOCK_HOLDER)
	end)
end

local function tick()
	for _, player in Players:GetPlayers() do
		local data = PlayerService.getData(player)
		if not data then continue end

		local uid = data.island.equippedUid
		if not uid then continue end

		local baerchi = data.island.baerchis[uid]
		if not baerchi then continue end

		if ActivityLock.isFree(player) and shouldEat(data, baerchi) then
			runEatCycle(player, uid)
		end
	end
end

function BaerchiAutopilotService.init()
	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)

			local ok, err = pcall(tick)
			if not ok then
				warn("[BaerchiAutopilotService] Tick fehlgeschlagen:", err)
			end
		end
	end)

	print("[BaerchiAutopilotService] Initialisiert | Intervall:", CHECK_INTERVAL, "s")
end

return BaerchiAutopilotService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">CombService</string><ProtectedString name="Source"><![CDATA[--!strict
-- CombService.luau
-- ServerScriptService/Services/CombService.luau
--
-- Einzige Zustaendigkeit:
--   - Honigwaben im Event-Pit: entstehen lassen, vom Spieler aufsammeln lassen,
--     als Stapel ueber seinem Kopf zeigen, ihn innerhalb des Pits verlangsamen
--     und den Stapel abgeben, sobald er seine eigene Insel betritt.
--
-- Was mit den abgegebenen Waben passiert (Warteschlange, Gummies, Ausbau),
-- gehoert CombRecyclerService. Dieser Service reicht sie nur dorthin durch
-- (CombRecyclerService.deposit) und kennt weder Gummies noch den Spielstand.
--
-- Was ein Spieler gerade TRAEGT, ist bewusst kein Spielstand: es lebt nur hier,
-- im Arbeitsspeicher, und geht beim Tod oder Verlassen verloren. Das haelt das
-- Sammeln spannend (nicht im Pit sterben!) und erspart dem DataStore eine
-- Zahl, die sich zehnmal pro Sekunde aendert. Alle Zahlen: Config/CombConfig.
--
-- WARUM DER SERVER DAS ALLES MACHT: Der Stapel soll fuer ALLE sichtbar sein
-- (jeder sieht, wer schwer beladen durchs Pit schleicht), und das Einsammeln
-- darf kein Client behaupten koennen. Der Server prueft deshalb im Takt
-- (PICKUP_CHECK_SECONDS) die Position jedes Spielers gegen die Waben — ein
-- Touched-Event pro Wabe waere bei bis zu 40 Waben und 8 Spielern unzuverlaessiger
-- und teurer.
--
-- Anzeige beim Client: Player-Attribute "CombsCarried" / "CombsMax" / "CombsUnits"
-- (CombController zeigt sie an) und das Remote CombDelivered fuer die Abgabe.
--
-- NACHSCHUB (Slot-Modell, Rechnung in Util/CombSlots): eine aufgehobene Wabe
-- behaelt ihren Slot. Erst die Abgabe (deliver) oder der Verlust eines Stapels
-- traegt sie in die Respawn-Warteschlange ein; ein Takt-Loop spawnt faellige
-- Waben, fuellt freie Slots nach und laesst bei fast leerem Pit troepfeln.
-- Die Abgabe kennt dieser Service selbst (er ruft CombRecyclerService.deposit),
-- deshalb plant er den Respawn hier ein: kein Rueckruf vom Recycler noetig,
-- kein Zirkelbezug.
--
-- WABENTHEMEN (CombConfig.THEMES): ein Event setzt per setTheme/clearTheme ein
-- Thema (Lava im Hot Egg, Koenigsgelee beim Boss). Das Thema bestimmt Skin,
-- Wert, Slot-Zahl, Nachschub-Tempo und Tragebremse. Der Wert einer Wabe wird
-- beim Aufheben festgeschrieben. launchCombs laesst Waben einfliegen
-- (Vulkan-Ausbruch, Waben-Regen): der Server legt Landepunkt und Flugzeit
-- fest und schreibt beides als Attribute, der Client zeichnet den Flug.

local Players             = game:GetService("Players")
local Workspace           = game:GetService("Workspace")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Remotes    = require(ReplicatedStorage.Network.Remotes)

local CombBuilder = require(ServerScriptService.Util.CombBuilder)
local CombSlots   = require(ServerScriptService.Util.CombSlots)

local MapService          = require(ServerScriptService.Services.MapService)
local CombRecyclerService = require(ServerScriptService.Services.CombRecyclerService)
local PlayerService = require(ServerScriptService.Services.PlayerService)   -- Sammel-Update 3.5

local CombService = {}

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

type WorldComb = {
	model       : Model,
	position    : Vector3,   -- Bodenpunkt unter der Wabe
	units       : number,
	isGold      : boolean,
	themeId     : string?,
	yaw         : number,
	phase       : number,
	availableAt : number,    -- os.clock(); fliegende Waben erst nach der Landung
}

type CarriedItem = { isGold: boolean, units: number, themeId: string?, slow: number }

type Carried = {
	items  : { CarriedItem },
	models : { Model },
	units  : number,
	folder : Folder?,
}

local WORLD_FOLDER_NAME = "EventPitCombs"
local STACK_FOLDER_NAME = "CombStack"

local _worldFolder: Folder? = nil
local _world: { WorldComb } = {}

local _carried: { [Player]: Carried } = {}

-- Fuer welche Spieler wir WalkSpeed veraendert haben. Nur dann fassen wir ihn
-- wieder an: ein Spieler, der nie Waben getragen hat, behaelt, was immer ein
-- anderes System ihm gesetzt hat.
local _slowed: { [Player]: boolean } = {}
-- Sammel-Update 05.10. (Paket 5.2): kurze Aufheb-Pause nach einem Stoss im
-- Kampf um die Mitte (PitBrawlService).
local _pickupPausedUntil: { [Player]: number } = {}

local _random = Random.new()

-- Respawn-Warteschlange und Zeitgeber (Zeitbasis: os.clock, nur Server).
local _slots = CombSlots.new()

-- Aktives Wabenthema (CombConfig.THEMES), nil = normale Waben.
local _themeId: string? = nil

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function getCarried(player: Player): Carried
	local carried = _carried[player]
	if not carried then
		carried = { items = {}, models = {}, units = 0, folder = nil }
		_carried[player] = carried
	end
	return carried
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

local function publishCarried(player: Player)
	local carried = getCarried(player)
	player:SetAttribute("CombsCarried", #carried.items)
	player:SetAttribute("CombsMax", CombConfig.MAX_CARRY)
	player:SetAttribute("CombsUnits", carried.units)
end

-- Wie schnell der Spieler IM PIT mit diesem Stapel laeuft. Jede Wabe bremst
-- mit dem Wert ihres Themas (Lava ist schwerer).
local function pitWalkSpeed(carried: Carried): number
	local slow = 0
	for _, item in carried.items do
		slow += item.slow
	end
	local factor = math.max(CombConfig.MIN_SPEED_FACTOR, 1 - slow)
	return CombConfig.BASE_WALK_SPEED * factor
end

local function restoreSpeed(player: Player)
	if not _slowed[player] then return end
	_slowed[player] = nil

	local humanoid = getHumanoid(player)
	if humanoid then
		humanoid.WalkSpeed = CombConfig.BASE_WALK_SPEED
	end
end

--------------------------------------------------------------------------------
-- Waben in der Welt
--------------------------------------------------------------------------------

-- Wie viele Waben gerade auf Koepfen getragen werden (belegen ihre Slots).
local function heldTotal(): number
	local total = 0
	for _, carried in _carried do
		total += #carried.items
	end
	return total
end

-- Aktuelle Slot-Zahl (= Hoechstzahl im Pit).
local function currentLimit(): number
	local theme = CombConfig.getTheme(_themeId)
	return if theme then theme.limit else CombConfig.MAX_WORLD_COMBS
end

-- Abstand beim Nachfuellen freier Slots (ein Thema kann es beschleunigen).
local function refillInterval(): number
	local theme = CombConfig.getTheme(_themeId)
	local factor = if theme then math.max(0.1, theme.spawnRateFactor) else 1
	return CombConfig.SPAWN_INTERVAL_SECONDS / factor
end

local function tooCloseToOthers(position: Vector3): boolean
	for _, comb in _world do
		if flatDistance(comb.position, position) < CombConfig.SPAWN_MIN_DISTANCE then
			return true
		end
	end
	return false
end

-- Freie Stelle im Ring des Pits (gleichmaessig ueber die Flaeche, sqrt, sonst
-- klumpen die Waben in der Mitte), bis zu 8 Versuche gegen Ueberlappung.
local function findFreeGround(): Vector3?
	local center = MapService.getEventPitPosition()
	local minR2 = CombConfig.SPAWN_RADIUS_MIN * CombConfig.SPAWN_RADIUS_MIN
	local maxR2 = CombConfig.SPAWN_RADIUS_MAX * CombConfig.SPAWN_RADIUS_MAX

	for _ = 1, 8 do
		local radius = math.sqrt(minR2 + (maxR2 - minR2) * _random:NextNumber())
		local angle  = _random:NextNumber() * math.pi * 2
		local ground = Vector3.new(
			center.X + math.cos(angle) * radius,
			center.Y,
			center.Z + math.sin(angle) * radius
		)
		if not tooCloseToOthers(ground) then
			return ground
		end
	end
	return nil
end

-- Baut das Model einer Wabe im Pit (aktuelles Thema).
local function buildModel(comb: WorldComb): Model
	local model = CombBuilder.buildWorldComb(comb.position, comb.yaw, comb.isGold, comb.units, comb.phase, comb.themeId)
	-- Fuer den Auftauch-Effekt im Client (CombController), vor dem
	-- Einhaengen gesetzt, damit es mit dem Model ankommt.
	model:SetAttribute("SpawnTime", Workspace:GetServerTimeNow())
	return model
end

-- Legt eine neue Wabe auf `ground`. `flight` = Flug von `from` ueber
-- `seconds` (Client zeichnet ihn aus den Attributen, aufheben erst danach).
local function placeComb(ground: Vector3, flight: { from: Vector3, seconds: number }?): boolean
	local folder = _worldFolder
	if not folder then return false end

	-- Gold-Chance bleibt pro Spawn gleich (8 %), auch bei Respawn und Thema.
	local isGold = _random:NextNumber() < CombConfig.GOLD_CHANCE
	local comb: WorldComb = {
		model       = nil :: any,
		position    = ground,
		units       = CombConfig.getUnits(isGold, _themeId),
		isGold      = isGold,
		themeId     = _themeId,
		yaw         = _random:NextNumber() * math.pi * 2,
		phase       = _random:NextNumber() * math.pi * 2,
		availableAt = 0,
	}

	local model = buildModel(comb)
	if flight then
		local now = Workspace:GetServerTimeNow()
		model:SetAttribute("FlyFrom", flight.from)
		model:SetAttribute("FlyStart", now)
		model:SetAttribute("FlyEnd", now + flight.seconds)
		comb.availableAt = os.clock() + flight.seconds
	end
	model.Parent = folder
	comb.model = model

	table.insert(_world, comb)
	return true
end

local function spawnComb(): boolean
	if not _worldFolder then return false end
	if #_world >= currentLimit() then return false end

	local ground = findFreeGround()
	if not ground then return false end
	return placeComb(ground, nil)
end

-- Baut alle Waben im Pit mit dem aktuellen Thema neu (Skin + Wert).
local function reskinWorld()
	local folder = _worldFolder
	if not folder then return end
	for _, comb in _world do
		comb.themeId = _themeId
		comb.units   = CombConfig.getUnits(comb.isGold, _themeId)
		local old = comb.model
		local model = buildModel(comb)
		-- Kein Auftauch-Effekt beim Umfaerben: nur der Burst in der Mitte.
		model:SetAttribute("SpawnTime", 0)
		if comb.availableAt > os.clock() then
			for _, name in { "FlyFrom", "FlyStart", "FlyEnd" } do
				model:SetAttribute(name, old:GetAttribute(name))
			end
		end
		model.Parent = folder
		comb.model = model
		old:Destroy()
	end
end

local function removeWorldComb(index: number)
	local comb = _world[index]
	comb.model:Destroy()
	table.remove(_world, index)
end

--------------------------------------------------------------------------------
-- Der Stapel ueber dem Kopf
--------------------------------------------------------------------------------

local function ensureStackFolder(player: Player, carried: Carried): Folder?
	local character = player.Character
	if not character then return nil end

	local existing = carried.folder
	if existing and existing.Parent == character then
		return existing
	end

	local folder = Instance.new("Folder")
	folder.Name   = STACK_FOLDER_NAME
	folder.Parent = character
	carried.folder = folder
	return folder
end

local function clearStack(player: Player)
	local carried = _carried[player]
	if not carried then return end

	if carried.folder then
		carried.folder:Destroy()
	end
	carried.folder = nil
	table.clear(carried.items)
	table.clear(carried.models)
	carried.units = 0

	publishCarried(player)
end

-- Der Stapel geht verloren (Tod, Verlassen, neuer Charakter): seine Slots
-- werden nach ORPHAN_RELEASE_SECONDS frei, die Waben kommen ins Pit zurueck.
local function releaseOrphans(carried: Carried?)
	if not carried then return end
	local count = #carried.items
	if count > 0 then
		CombSlots.schedule(_slots, os.clock() + CombConfig.ORPHAN_RELEASE_SECONDS, count)
	end
end

local function loseStack(player: Player)
	releaseOrphans(_carried[player])
	clearStack(player)
end

local function addToStack(player: Player, comb: WorldComb): boolean
	local carried = getCarried(player)
	if #carried.items >= CombConfig.MAX_CARRY then return false end

	local character = player.Character
	local head = if character then character:FindFirstChild("Head") else nil
	if not head or not head:IsA("BasePart") then return false end

	local folder = ensureStackFolder(player, carried)
	if not folder then return false end

	-- Wert und Gewicht werden HIER festgeschrieben: endet das Thema, behaelt
	-- die getragene Wabe beides.
	table.insert(carried.items, {
		isGold  = comb.isGold,
		units   = comb.units,
		themeId = comb.themeId,
		slow    = CombConfig.getSlowPerComb(comb.themeId),
	})
	carried.units += comb.units

	local model = CombBuilder.buildStackComb(head, #carried.items, comb.isGold, folder, comb.themeId)
	table.insert(carried.models, model)

	publishCarried(player)
	return true
end

--------------------------------------------------------------------------------
-- Der Takt: aufsammeln, bremsen, abgeben
--------------------------------------------------------------------------------

local function tryPickup(player: Player, root: BasePart)
	if os.clock() < (_pickupPausedUntil[player] or 0) then return end   -- Paket 5.2
	local carried = getCarried(player)
	if #carried.items >= CombConfig.MAX_CARRY then return end

	-- v15: Recycler-Faehigkeit "Sammelradius" (BuildingBehavior.MILESTONES).
	local radius = CombConfig.PICKUP_RADIUS
	if BuildingBehavior.hasAbility("Recycler", CombRecyclerService.getLevel(player), "CollectRadius") then
		radius *= CombConfig.COLLECT_RADIUS_FACTOR
	end

	-- Rueckwaerts, weil beim Aufheben Eintraege aus der Liste verschwinden.
	local now = os.clock()
	for i = #_world, 1, -1 do
		local comb = _world[i]
		local dy = math.abs(root.Position.Y - comb.position.Y)

		if comb.availableAt <= now
			and dy <= CombConfig.PICKUP_MAX_HEIGHT
			and flatDistance(root.Position, comb.position) <= radius
		then
			if addToStack(player, comb) then
				removeWorldComb(i)
			end

			if #carried.items >= CombConfig.MAX_CARRY then return end
		end
	end
end

local function deliver(player: Player)
	local carried = getCarried(player)
	local count   = #carried.items
	local units   = carried.units
	if count == 0 then return end

	-- Erst abgeben, dann leeren: scheitert die Abgabe (Spieldaten noch nicht
	-- geladen), behaelt der Spieler seinen Stapel und es wird beim naechsten
	-- Takt erneut versucht.
	if not CombRecyclerService.deposit(player, units) then return end

	-- Sammel-Update 05.10. (Paket 3.5): Zaehler fuer die Einfuehrung
	-- ("Waben im Recycler abgeben"). Monoton, im Spielstand.
	local data = PlayerService.getData(player)
	if data then
		local stats = data.stats :: any
		stats.totalCombsDelivered = (stats.totalCombsDelivered or 0) + count
	end

	-- Jede abgegebene Wabe kommt nach der Respawn-Zeit zurueck ins Pit.
	local delay = CombConfig.getRespawnDelay(CombRecyclerService.getLevel(player))
	CombSlots.schedule(_slots, os.clock() + delay, count)

	clearStack(player)
	restoreSpeed(player)

	Remotes.CombDelivered:FireClient(player, count, units)
end

local function checkPlayer(player: Player)
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid = getHumanoid(player)
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then return end

	local carried = _carried[player]
	local count   = if carried then #carried.items else 0

	local center = MapService.getEventPitPosition()
	local inPit  = flatDistance(root.Position, center) <= MapService.getEventPitRadius()

	if inPit then
		tryPickup(player, root)
		count = #getCarried(player).items
	end

	-- Tempo: nur im Pit und nur mit Last. Ausserhalb wieder normal.
	if inPit and count > 0 then
		_slowed[player] = true
		humanoid.WalkSpeed = pitWalkSpeed(getCarried(player))
	else
		restoreSpeed(player)
	end

	-- Abgabe: eigene Insel betreten.
	if count > 0 then
		local plotCFrame = MapService.getPlotCFrame(player)
		if plotCFrame and flatDistance(root.Position, plotCFrame.Position) <= CombConfig.DELIVER_RADIUS then
			deliver(player)
		end
	end
end

--------------------------------------------------------------------------------
-- Spieler- und Charakter-Lebenszyklus
--------------------------------------------------------------------------------

local function hookCharacter(player: Player, character: Model)
	-- Neuer Charakter = leerer Stapel. Der alte Stapel haengt am alten
	-- Charakter und verschwindet mit ihm; hier nur die Buchfuehrung nachziehen.
	-- Hatte er noch Waben (Charakter ohne Tod ersetzt), werden die Slots frei.
	releaseOrphans(_carried[player])
	_carried[player] = { items = {}, models = {}, units = 0, folder = nil }
	_slowed[player] = nil
	publishCarried(player)

	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid and humanoid:IsA("Humanoid") then
		humanoid.Died:Connect(function()
			-- Wer im Pit stirbt, verliert seine Waben (siehe Kopf der Datei).
			loseStack(player)
			_slowed[player] = nil
		end)
	end
end

local function hookPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		hookCharacter(player, character)
	end)

	if player.Character then
		task.spawn(hookCharacter, player, player.Character)
	else
		publishCarried(player)
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Wie viele Waben liegen gerade im Pit (fuer Debug und Tests).
-- Sammel-Update 05.10. (Paket 5.2): Waben-Aufheben kurz pausieren.
function CombService.pausePickup(player: Player, seconds: number)
	_pickupPausedUntil[player] = math.max(_pickupPausedUntil[player] or 0, os.clock() + seconds)
end

function CombService.getWorldCount(): number
	return #_world
end

-- Wie viele Waben dieser Spieler gerade traegt.
function CombService.getCarriedCount(player: Player): number
	local carried = _carried[player]
	return if carried then #carried.items else 0
end

-- Nur fuer den Studio-Test (DebugService): sofort `n` Waben ins Pit legen
-- (am Slot-Modell vorbei, aber nie ueber das Limit im Pit).
function CombService.debugSpawn(n: number)
	for _ = 1, n do
		spawnComb()
	end
end

-- Setzt das Wabenthema (CombConfig.THEMES[themeId]) oder hebt es auf (nil).
-- Bestehende Waben im Pit wechseln sofort Skin und Wert (ein Funken-Burst in
-- der Pit-Mitte); getragene behalten ihren Wert. Endet ein Thema mit mehr
-- Waben im Pit als normal erlaubt, verschwinden die ueberzaehligen (ihre Slots
-- gab es nur waehrend des Themas).
function CombService.setTheme(themeId: string?)
	if themeId and not CombConfig.getTheme(themeId) then
		warn("[CombService] Unbekanntes Wabenthema:", themeId)
		themeId = nil
	end
	if themeId == _themeId then return end

	local previous = CombConfig.getTheme(_themeId)
	_themeId = themeId

	local limit = currentLimit()
	while #_world > limit do
		removeWorldComb(_random:NextInteger(1, #_world))
	end

	reskinWorld()

	local theme = CombConfig.getTheme(themeId) or previous
	local folder = _worldFolder
	if theme and folder then
		local center = MapService.getEventPitPosition()
		CombBuilder.themeBurst(center + Vector3.new(0, 3, 0), theme.burstColor, folder)
	end
	print("[CombService] Wabenthema:", themeId or "normal", "| Slots", limit)
end

function CombService.clearTheme()
	CombService.setTheme(nil)
end

function CombService.getTheme(): string?
	return _themeId
end

-- Laesst bis zu `count` Waben einfliegen und landen (Vulkan-Ausbruch aus
-- `origin`, Waben-Regen von oben, wenn origin nil ist). Nie ueber das Limit im
-- Pit; die gelandeten Waben sind ganz normale Waben im Slot-Modell. Gibt die
-- Zahl der gestarteten Waben zurueck.
function CombService.launchCombs(count: number, origin: Vector3?): number
	local launched = 0
	for _ = 1, math.max(0, math.floor(count)) do
		if #_world >= currentLimit() then break end
		local ground = findFreeGround()
		if ground then
			local landing = ground + Vector3.new(0, CombConfig.WORLD_HOVER, 0)
			local from = origin or (landing + Vector3.new(0, CombConfig.RAIN_DROP_HEIGHT, 0))
			if placeComb(ground, { from = from, seconds = CombConfig.FLIGHT_SECONDS }) then
				launched += 1
			end
		end
	end
	return launched
end

-- Stand des Slot-Modells (fuer DebugService und Tests).
function CombService.getSlotInfo(): { world: number, held: number, queued: number, limit: number }
	return {
		world  = #_world,
		held   = heldTotal(),
		queued = CombSlots.pending(_slots),
		limit  = currentLimit(),
	}
end

-- Ein Takt des Nachschubs: so viele Waben spawnen, wie das Slot-Modell sagt.
local function respawnTick()
	local count = CombSlots.tick(_slots, {
		now            = os.clock(),
		world          = #_world,
		held           = heldTotal(),
		limit          = currentLimit(),
		refillInterval = refillInterval(),
		minWorld       = CombConfig.MIN_WORLD_COMBS,
		trickleSeconds = CombConfig.MIN_TRICKLE_SECONDS,
	})
	for _ = 1, count do
		spawnComb()
	end
end

function CombService.init()
	-- nichts anzumelden; alles Zeitabhaengige laeuft in start()
	print("[CombService] Initialisiert | max.", CombConfig.MAX_WORLD_COMBS, "Waben im Pit")
end

-- Erst in start(): dann steht die Welt (das Event-Pit baut MapService.init) und
-- Spieler werden geladen.
function CombService.start()
	local folder = Instance.new("Folder")
	folder.Name   = WORLD_FOLDER_NAME
	folder.Parent = Workspace
	_worldFolder  = folder

	for _ = 1, CombConfig.INITIAL_COMBS do
		spawnComb()
	end

	Players.PlayerAdded:Connect(hookPlayer)
	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		releaseOrphans(_carried[player])
		_carried[player] = nil
		_slowed[player] = nil
	end)

	-- Nachschub (Slot-Modell): Respawn, Nachfuellen, Troepfeln
	task.spawn(function()
		while true do
			task.wait(CombConfig.RESPAWN_TICK_SECONDS)
			local ok, err = pcall(respawnTick)
			if not ok then
				warn("[CombService] Spawn fehlgeschlagen:", err)
			end
		end
	end)

	-- Aufsammeln, bremsen, abgeben
	task.spawn(function()
		while true do
			task.wait(CombConfig.PICKUP_CHECK_SECONDS)
			for _, player in Players:GetPlayers() do
				local ok, err = pcall(checkPlayer, player)
				if not ok then
					warn("[CombService] Pruefung fehlgeschlagen:", err)
				end
			end
		end
	end)
end

return CombService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[--!strict
-- CombatService.luau
-- ServerScriptService/Services/CombatService.luau
--
-- Einzige Zustaendigkeit:
--   - Einen TOWER-LAUF validieren, durchsimulieren und (am Ende der
--     Wiedergabe) abrechnen
--
-- v15: Es gibt kein PIT-Level mehr. Gekaempft wird im gewaehlten Tower
-- (TowerService.getSelected); Gegner und Stage-Gummies kommen aus TowerConfig,
-- Rekord, Meilensteine und Deckel fuehrt TowerService (recordRun). Bis zu 100
-- Stages werden IN PORTIONEN simuliert (SIM_STAGES_PER_STEP pro task.wait),
-- damit ein langer Lauf keinen Frame-Spike auf dem Server macht.
--
-- Ein Lauf ist kein einzelner Kampf: der Baerchi kaempft Stage fuer Stage
-- weiter, solange er gewinnt, und seine HP werden zwischen den Stages NICHT
-- zurueckgesetzt. Kaempfe geben KEINE XP (die kommt nur aus Honig).
--
-- ============================================================
-- SEIT v12: SIMULATION SOFORT, ABRECHNUNG SPAETER
-- ============================================================
-- Der Lauf wird weiterhin KOMPLETT im Voraus simuliert. Der Server kennt das
-- Ergebnis also, bevor die Figur losgeht — der Client kann am Ausgang nichts
-- drehen. Neu ist nur, WANN abgerechnet wird: nicht mehr vor der Wiedergabe,
-- sondern erst, wenn PitArenaService weiss, wie viele Stages tatsaechlich
-- gespielt wurden. Der Spieler kann den Baerchi naemlich zurueckholen
-- (PetBar, Knopf "Fight" nochmal): dann endet der Lauf nach der aktuellen
-- Stage, und es zaehlen nur die bis dahin geschafften.
--
-- Dafuer bekommt PitArenaService eine Abrechnungs-Funktion (settle) mit. Sie
-- laeuft genau einmal — am Ende der Wiedergabe, beim Zurueckholen, bei einem
-- Abbruch oder, wenn der Spieler mitten im Lauf geht, ueber
-- PlayerService.onPlayerLeaving (dann so, als waere die aktuelle Stage zu Ende
-- gespielt).
--
-- ============================================================
-- FORTSETZUNG (v12)
-- ============================================================
-- Vor dem Lauf kann der Spieler weiter oben einsteigen (PitResumeDialog):
--   "Fresh"   Stage 1, kostenlos
--   "Percent" bei 65 % der Stage-Tiefe seines letzten Laufs
--   "Last"    bei der letzten erreichten Stage
-- Kosten und Startstage rechnet TowerConfig (dieselben Funktionen nutzt der
-- Client fuer die Anzeige). Der letzte Lauf steht pro Tower in
-- island.towerProgress (v15).
--
-- Gegner-Werte und Belohnungen kommen aus TowerConfig, die Simulation aus
-- CombatCalculator. rebirthMult wendet ausschliesslich
-- EconomyService.awardGummies an. Der weiche Deckel: ueber den Deckel hinaus
-- wird gekaempft, Stage-Gummies und GoldGummies gibt es aber nur bis dorthin.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local PlayerService   = require(ServerScriptService.Services.PlayerService)
local EconomyService  = require(ServerScriptService.Services.EconomyService)
local PitArenaService = require(ServerScriptService.Services.PitArenaService)
local TowerService    = require(ServerScriptService.Services.TowerService)
local FunnelService = require(ServerScriptService.Services.FunnelService)  -- HBB: Messpunkte
local GamepassService = require(ServerScriptService.Services.GamepassService)  -- 08.10. Paket C
local Loc           = require(ReplicatedStorage.Localization.Loc)

local CombatService = {}

-- So viele Stages werden am Stueck simuliert, dann gibt der Server einen
-- Frame frei (task.wait). Rein technisch, kein Balancing-Wert.
local SIM_STAGES_PER_STEP = 10

-- Spieler, deren Lauf gerade simuliert wird (die Simulation yieldet jetzt —
-- ein zweiter Knopfdruck darf nicht dazwischen einen zweiten Lauf starten).
local _simulating: { [Player]: boolean } = {}

export type ResumeChoice = "Fresh" | "Percent" | "Last"

local function fail(player: Player, reason: Types.LocMsg | string)
	Remotes.ActionFailed:FireClient(player, "RequestPetMode", reason)
end

-- Gegner-Snapshot fuer eine Stage. Die Werte selbst kommen komplett aus
-- TowerConfig — hier wird nur umgepackt.
local function buildEnemySnapshot(towerId: string, stage: number): CombatCalculator.CombatSnapshot
	local stats = TowerConfig.getEnemyStats(towerId, stage)

	return {
		uid    = string.format("enemy_%s_s%d", towerId, stage),
		stats  = stats,
		hp     = stats.maxHp,
		charge = 0,
	}
end

-- Letzte erreichte Stage in diesem Tower (0 = kein Lauf gespeichert).
function CombatService.getProgress(data: Types.PlayerData, towerId: string): number
	local reached = data.island.towerProgress[towerId]
	return if typeof(reached) == "number" and reached >= 1 then reached else 0
end

-- Startstage und Kosten fuer eine Fortsetzungs-Wahl. nil = Wahl ungueltig
-- (kein letzter Lauf in diesem Tower).
-- `hasPass` (08.10.): Gamepass Gratis-Skip -> Kosten 0 (nur der Server fragt
-- GamepassService; ein gefaelschter Client aendert daran nichts).
function CombatService.getResumeOffer(data: Types.PlayerData, towerId: string, choice: ResumeChoice, hasPass: boolean?): (number?, number)
	if choice == "Fresh" then
		return 1, 0
	end

	local reached = CombatService.getProgress(data, towerId)
	if reached <= 0 then
		return nil, 0
	end

	local startStage = if choice == "Last"
		then reached
		else TowerConfig.getResumePercentStage(reached)

	local def = TowerConfig.get(towerId)
	startStage = math.clamp(startStage, 1, if def then def.stages else 1)
	return startStage, TowerConfig.getResumeCost(towerId, startStage, data.rebirthMult, hasPass)
end

-- Startet einen Tower-Lauf. Gibt true zurueck, wenn er losgeht — sonst hat
-- der Spieler bereits ein ActionFailed mit dem Grund bekommen.
function CombatService.startPitRun(player: Player, baerchiUid: string, choice: ResumeChoice?): boolean
	-- Ein zweiter Lauf darf nie in einen laufenden hineinstarten (die Figur
	-- wuerde sonst mitten in der Wiedergabe weggezogen).
	if PitArenaService.isRunning(player) or _simulating[player] then
		fail(player, Loc.msg("err.combat_busy"))
		return false
	end
	_simulating[player] = true
	local ok, started = pcall(CombatService._startRun, player, baerchiUid, choice)
	_simulating[player] = nil
	if not ok then
		warn("[CombatService] Lauf konnte nicht starten:", started)
		return false
	end
	return started
end

function CombatService._startRun(player: Player, baerchiUid: string, choice: ResumeChoice?): boolean

	local data = PlayerService.getData(player)
	if not data then return false end

	local baerchi = data.island.baerchis[baerchiUid]
	if not baerchi then
		fail(player, Loc.msg("err.baerchi_not_found"))
		return false
	end

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		warn("[CombatService] Unbekannter configId:", baerchi.configId)
		fail(player, Loc.msg("err.baerchi_data_corrupt"))
		return false
	end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)

	-- Der gespeicherte Wert kann ueber maxHp liegen, wenn der Baerchi seit dem
	-- letzten Lauf ein Level gestiegen ist — deshalb immer klemmen.
	local hp = math.clamp(baerchi.currentHp, 0, stats.maxHp)
	if hp <= 0 then
		fail(player, Loc.msg("err.combat_exhausted"))
		return false
	end

	local towerId = TowerService.getSelected(data)
	local tower = TowerConfig.get(towerId)
	if not tower then
		fail(player, Loc.msg("err.tower_unknown"))
		return false
	end
	-- Deckel beim START festhalten: ein Rebirth waehrend des Laufs ist
	-- unmoeglich (der Lauf gehoert zur Insel), sicher ist sicher.
	local capStage = TowerService.getStageCap(data, towerId)

	local startStage, cost = CombatService.getResumeOffer(data, towerId, choice or "Fresh",
		GamepassService.owns(player, "SKIP_PASS"))
	if not startStage then
		fail(player, Loc.msg("err.combat_no_last_run"))
		return false
	end

	if cost > 0 then
		local ok, reason = EconomyService.spendGummies(player, cost)
		if not ok then
			fail(player, reason)
			return false
		end
	end

	local hpBefore = hp

	-- ============================================================
	-- SIMULATION (komplett im Voraus)
	-- ============================================================
	local stages: { Types.PitStageResult } = {}
	-- v15: pro Stage die einzelnen Zuege fuer die Wiedergabe (Stoesse,
	-- Faehigkeiten). Bleibt auf dem Server — PitArenaService spielt sie ab,
	-- der Client sieht nur das Ergebnis in der Welt.
	local beats: { { Types.FightBeat } } = {}
	local lastStage = tower.stages

	-- v15: die Aufladung der Faehigkeit bleibt ueber die Stages erhalten.
	local charge = 0
	local simulatedInStep = 0

	for stage = startStage, lastStage do
		-- In Portionen: nach SIM_STAGES_PER_STEP Stages einen Frame freigeben.
		simulatedInStep += 1
		if simulatedInStep > SIM_STAGES_PER_STEP then
			simulatedInStep = 1
			task.wait()
			if player.Parent == nil then
				-- Gegangen, waehrend simuliert wurde: bezahlte Fortsetzung zurueck.
				if cost > 0 then EconomyService.awardGummiesFlat(player, cost) end
				return false
			end
		end

		local playerSnapshot: CombatCalculator.CombatSnapshot = {
			uid    = baerchi.uid,
			stats  = stats,
			hp     = hp,
			charge = charge,
		}
		local enemySnapshot = buildEnemySnapshot(towerId, stage)
		local enemyMax = math.max(1, enemySnapshot.stats.maxHp)

		local result = CombatCalculator.simulate(playerSnapshot, enemySnapshot, true)
		local won    = result.winnerUid == baerchi.uid

		hp = math.clamp(playerSnapshot.hp, 0, stats.maxHp)
		charge = playerSnapshot.charge or 0

		local stageBeats: { Types.FightBeat } = {}
		for _, entry in result.log do
			table.insert(stageBeats, {
				actor   = entry.actor,
				kind    = entry.kind,
				selfHp  = math.clamp(entry.attackerHpAfter / math.max(1, stats.maxHp), 0, 1),
				enemyHp = math.clamp(entry.defenderHpAfter / enemyMax, 0, 1),
				charge  = entry.chargeA,
				skillId = entry.skillId,
			})
		end
		table.insert(beats, stageBeats)

		table.insert(stages, {
			stage      = stage,
			won        = won,
			rounds     = result.rounds,
			hpAfter    = hp,
			-- Basiswert ohne rebirthMult; ausgezahlt wird erst in settle.
			-- Weicher Deckel: ueber dem Deckel gibt es nichts.
			gummiesWon = if won and stage <= capStage then TowerConfig.getStageReward(towerId, stage) else 0,
			-- v14: fuer die Faehigkeiten-Show (PitArenaService -> SkillFX)
			skillUses       = result.skillUses,
			firstSkillRound = result.firstSkillRound,
		})

		-- Ein Sieg mit 0 HP kann vorkommen (bei Rundenlimit entscheidet der
		-- HP-Vergleich) — dann ist der Lauf trotzdem vorbei.
		if not won or hp <= 0 then
			break
		end
	end

	local fullRun: Types.PitRunResult = {
		baerchiUid     = baerchiUid,
		towerId        = towerId,
		capStage       = capStage,
		startStage     = startStage,
		recalled       = false,
		stagesCleared  = 0,
		stages         = stages,
		gummiesWon     = 0,
		goldGummiesWon = 0,
		hpBefore       = hpBefore,
		hpAfter        = hpBefore,
		maxHp          = stats.maxHp,
	}

	-- ============================================================
	-- ABRECHNUNG (laeuft genau einmal, aufgerufen von PitArenaService)
	-- ============================================================
	-- played = wie viele Stages tatsaechlich gespielt wurden (0..#stages).
	-- recalled = der Spieler hat zurueckgeholt.
	local settled: Types.PitRunResult? = nil

	local function settle(played: number, recalled: boolean): Types.PitRunResult
		if settled then
			return settled
		end

		played = math.clamp(math.floor(played), 0, #stages)

		local playedStages: { Types.PitStageResult } = {}
		local cleared     = 0
		local paidCleared = 0   -- geschaffte Stages bis zum Deckel (GoldGummies)
		local highestWon  = 0
		local baseGummies = 0
		for index = 1, played do
			local stage = stages[index]
			table.insert(playedStages, stage)
			if stage.won then
				cleared += 1
				baseGummies += stage.gummiesWon
				highestWon = math.max(highestWon, stage.stage)
				if stage.stage <= capStage then
					paidCleared += 1
				end
			end
		end

		local hpAfter = if played > 0 then playedStages[played].hpAfter else hpBefore

		-- Den aktuellen Spielstand holen: der Spieler kann waehrenddessen
		-- gegangen sein (dann laeuft das hier aus onPlayerLeaving, die Daten
		-- sind noch da).
		local current = PlayerService.getData(player)
		local result: Types.PitRunResult = {
			baerchiUid     = baerchiUid,
			towerId        = towerId,
			capStage       = capStage,
			startStage     = startStage,
			recalled       = recalled,
			corrected      = played < #stages,
			stagesCleared  = cleared,
			stages         = playedStages,
			gummiesWon     = 0,
			goldGummiesWon = 0,
			hpBefore       = hpBefore,
			hpAfter        = hpAfter,
			maxHp          = stats.maxHp,
		}

		if not current then
			settled = result
			return result
		end

		if played == 0 then
			-- Zurueckgeholt, bevor die erste Stage begann: nichts passiert.
			-- Eine bezahlte Fortsetzung wird erstattet — der Spieler hat
			-- nichts davon gehabt.
			if cost > 0 then
				EconomyService.awardGummiesFlat(player, cost)
			end
		else
			local fighter = current.island.baerchis[baerchiUid]
			if fighter then
				-- Erschoepfungszustand festhalten: DAS ist die Verbindung zum
				-- Fuettern.
				fighter.currentHp = hpAfter
			end

			if baseGummies > 0 then
				result.gummiesWon = EconomyService.awardGummies(player, baseGummies)
			end

			local goldReward = TowerConfig.getRunGold(towerId, paidCleared)
			if goldReward > 0 then
				result.goldGummiesWon = EconomyService.awardGoldGummies(player, goldReward)
			end

			if cleared > 0 then
				current.stats.totalFightsWon += cleared
			end
			if not playedStages[played].won then
				current.stats.totalFightsLost += 1
			end

			-- v15: Rekord, Meilensteine, Deckel-Hinweis (TowerService).
			local newRecord, capReached = TowerService.recordRun(player, current, towerId, highestWon)
			result.newRecord  = newRecord
			result.capReached = capReached

			-- Fuer die Fortsetzungs-Frage: die letzte Stage, in die er
			-- eingetreten ist — pro Tower.
			current.island.towerProgress[towerId] = playedStages[played].stage
		end

		FunnelService.step(player, "F06_FirstFightEnded")
		PlayerService.markDirty(player)
		PlayerService.saveNow(player)

		print(
			"[CombatService]", player.Name,
			"| Tower", towerId, "ab Stage", startStage,
			"| gespielt:", played, "/", #stages,
			if recalled then "(zurueckgeholt)" else "",
			"| geschafft:", cleared,
			"| HP:", hpAfter, "/", stats.maxHp,
			"| Gummies:", result.gummiesWon,
			"| Gold:", result.goldGummiesWon
		)

		settled = result
		return result
	end

	-- Den Client informiert NICHT dieser Service, sondern PitArenaService — am
	-- Ende der Wiedergabe mit dem abgerechneten Ergebnis.
	PitArenaService.play(player, fullRun, settle, beats)
	FunnelService.step(player, "F05_FirstFightStarted")

	-- Kosten sind schon abgezogen: syncen, damit die Anzeige stimmt.
	if cost > 0 then
		PlayerService.markDirty(player)
	end

	print("[CombatService]", player.Name, "| Tower-Lauf startet: Tower", towerId,
		"| ab Stage", startStage, "| Kosten:", cost, "| simuliert:", #stages, "Stages")

	return true
end

function CombatService.init()
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		_simulating[player] = nil
	end)

	-- Seit v12 kein eigener Remote mehr: gestartet wird ueber die Pet-Leiste
	-- (PetModeService.RequestPetMode).
	print("[CombatService] Initialisiert")
end

return CombatService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">DebugService</string><ProtectedString name="Source"><![CDATA[--!strict
-- DebugService.luau
-- ServerScriptService/Services/DebugService.luau
--
-- Einzige Zustaendigkeit:
--   - Test-Befehle aus der Studio Command Bar entgegennehmen
--
-- NUR IN STUDIO. Im veroeffentlichten Spiel macht init() nichts und die
-- BindableFunction existiert nicht.
--
-- Warum eine BindableFunction und nicht einfach _G oder ein require?
--   Die Command Bar laeuft in einem eigenen Lua-VM. Sie hat deshalb
--     * ihren eigenen require-Cache  → require(PlayerService) liefert dort eine
--       ZWEITE, nie initialisierte Kopie mit leerem _playerData, und
--     * ihr eigenes _G               → im Server gesetzte Globals sind unsichtbar.
--   Aufrufe auf der Kopie laufen still ins Leere, was beim Testen extrem
--   verwirrend ist. Eine BindableFunction ist eine Instanz im DataModel:
--   ihr OnInvoke wurde vom echten Server-Script gesetzt und laeuft daher
--   garantiert im echten Server-VM, mit dem echten Zustand.
--
-- Benutzung (Command Bar, Server-Kontext, Play laeuft):
--   local D = game.ServerScriptService.RBLDebug
--   D:Invoke("info")
--   D:Invoke("give", 100000, 1000)
--   D:Invoke("add", "RedBaerchi", 10)
--   D:Invoke("add", "RedBaerchi", 10, "Rainbow")   -- Mutation (siehe BaerchiConfig.MUTATIONS)
--   D:Invoke("stats", uid)                    -- Kampfwerte inkl. PWR
--   D:Invoke("list")
--   D:Invoke("fuse", uidA, uidB)
--   D:Invoke("recycle", uid)
--   D:Invoke("building", "Beehive", 5)   -- Level 1-60 (v15), Look folgt automatisch
--   D:Invoke("building", "HoneyRefiner", 60)
--   D:Invoke("hatch", "BasicEgg")   -- legt ein Ei ins Lager und oeffnet es sofort (v12)
--   D:Invoke("egg", "GoldenEgg", 5) -- 5 Eier ins Lager legen (ohne zu oeffnen)
--   D:Invoke("pitprogress", 12)     -- letzten Lauf im gewaehlten Tower auf Stage 12 setzen (Fortsetzungs-Test)
--   D:Invoke("petmode")             -- aktueller Zustand der Pet-Leiste
--   D:Invoke("pm", "Fight", "Last")  -- wie ein Klick auf die Pet-Leiste
--   D:Invoke("honey")               -- alle Honig-Lager sofort voll
--   D:Invoke("feed", uid, 20)       -- 20x fuettern (heilt + gibt XP)
--   D:Invoke("fight", uid)          -- kompletter Lauf im gewaehlten Tower
--   D:Invoke("rebirth")
--
-- v8 (Promotion / Charms / Event-Teilnahme):
--   D:Invoke("promote", uid)        -- braucht genug Duplikate, siehe "add"
--   D:Invoke("charms", uid)         -- alle acht Slots im Klartext
--   D:Invoke("roll", uid, 5)        -- 5x wuerfeln (kostet GoldGummies)
--   D:Invoke("lock", uid, 1)        -- Slot I sperren/freigeben
--   D:Invoke("event")               -- ausgeruesteten Baerchi zum Event schicken
--   D:Invoke("skipevent")           -- laufende Phase sofort beenden
--   D:Invoke("events")              -- Katalog: alle Events mit ihrer Belohnung
--   D:Invoke("startevent", "ZauberZirkel")  -- genau dieses Event sofort starten
--
-- v10 (Eier legen):
--   D:Invoke("eggs")            -- was liegt herum, wie schnell legt er, welche Chancen
--   D:Invoke("lay", 5)          -- 5 Eier sofort legen (ohne aufs Intervall zu warten)
--   D:Invoke("collect")         -- alles einsammeln
--   D:Invoke("eggtime", 60)     -- Zeitmarke 60 Minuten zurueck, Tick legt nach
--
-- v15 (Waben im Event-Pit, Recycler):
--   D:Invoke("combs", 20)           -- 20 Waben sofort ins Pit legen (Stand ausgeben)
--   D:Invoke("queue", 50)           -- 50 Wabeneinheiten in die Recycler-Warteschlange
--   D:Invoke("recycler", 5)         -- Recycler-Level setzen (ohne Kosten), Stand ausgeben
--
-- v15 (Tower, Gebaeude 1-60, Angeben, Login-Bonus):
--   D:Invoke("tower", "II", 20)     -- Tower II waehlen und ab Stage 20 kaempfen (Fortsetzung gratis)
--   D:Invoke("towerrecord", "III", 45) -- Rekord setzen (Meilensteine bis dorthin werden ausgezahlt)
--   D:Invoke("rebirthcap")          -- Deckel des aktuellen Rebirths in allen Towern
--   D:Invoke("stagebest", "I", 30)  -- Sammel-Update: beste Stage dieses Lebens (Rebirth-Bedingung)
--   D:Invoke("incubator", "done")   -- Sammel-Update: Inkubator-Stand, "done" = alle Eier fertig
--   D:Invoke("incubator", "breed")  -- INCUBATOR_BREED: jedes Baerchi im Inkubator bruetet sofort ein Ei
--   D:Invoke("dailyshift", 1)       -- Login-Bonus: so tun, als waeren 1 Tag(e) vergangen
--   D:Invoke("lbflush")             -- Bestenlisten sofort schreiben und neu lesen
--   D:Invoke("parts")               -- Teile auf der eigenen Insel zaehlen (Budget 250)
--   D:Invoke("v14save")             -- Spielstand im alten v14-Format simulieren + migrieren
--
-- v17 (lebendige Events):
--   D:Invoke("startevent", "Ufo")   -- UFO-Patrouille mit Abwuerfen
--   D:Invoke("jackpot")             -- naechster UFO-Abwurf ist sicher ein Jackpot (Stand des Pity-Zaehlers)
--   D:Invoke("combtheme", "HotEgg") -- Wabenthema setzen ("off" = normal)
--   D:Invoke("launch", 10)          -- 10 Waben einfliegen lassen (Vulkan aus der Mitte)
--   D:Invoke("startevent", "WaspQueen") -- Boss-Event sofort (laeuft sonst nur jeden 2. Durchlauf)
--
-- v14 (Mega Egg Tree):
--   D:Invoke("tree")                 -- alle 20 Knoten mit Bedingungen und Stand
--   D:Invoke("unlock", "SunEgg")     -- einen Knoten freischalten ("all" = alle)
--   D:Invoke("hatched", "SugarEgg", 15) -- Hatch-Zaehler setzen (Freischalt-Test)
--   D:Invoke("blueprint", 1)         -- Blaupausen gutschreiben
--   D:Invoke("useblueprint", "PlatinumEgg")
--   D:Invoke("press", "SugarEgg", "Void") -- 5 Zucker-Eier -> 1 Nebel-Ei
--   D:Invoke("setrebirth", 10)       -- Rebirth-Zaehler setzen (ohne Reset)
--   D:Invoke("skilltest", "OmegaBaerchi", 30) -- einen Kampf mit Runden-Log
--   D:Invoke("snapshot")             -- Spielstand merken (fuer Tests)
--   D:Invoke("restore")              -- gemerkten Spielstand zurueckschreiben
--
-- HBB Paket 0 (Test-Zustaende, erst "snapshot"):
--   D:Invoke("state", "fresh")       -- neues Konto, Trichter F01–F10 misst
--   D:Invoke("state", "hatch10")     -- dazu zehn geoeffnete Basis-Eier
--   D:Invoke("state", "tower1")      -- dazu Tower I geschafft (Rekord 30)
--
-- Ein kompletter Event-Durchlauf ohne acht Minuten Wartezeit:
--   D:Invoke("skipevent")   → Pause endet, Event laeuft
--   D:Invoke("event")       → Baerchi laeuft hin (ein paar Sekunden abwarten)
--   D:Invoke("skipevent")   → Event endet, Stat-Stufe wird vergeben
--
-- Rueckgaben sind einfache Tabellen/Zahlen — BindableFunctions kopieren
-- Werte ueber die VM-Grenze, Funktionen und Metatables kommen nicht durch.

local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local Loc = require(ReplicatedStorage.Localization.Loc)   -- Belohnung ist eine LocMsg
local CharmConfig      = require(ReplicatedStorage.Config.CharmConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local BaerchiFactory   = require(ReplicatedStorage.Modules.BaerchiFactory)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggCalculator    = require(ReplicatedStorage.Modules.EggCalculator)
local CombConfig       = require(ReplicatedStorage.Config.CombConfig)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local IslandService  = require(ServerScriptService.Services.IslandService)
local EggService     = require(ServerScriptService.Services.EggService)
local CombatService  = require(ServerScriptService.Services.CombatService)
local FusionService  = require(ServerScriptService.Services.FusionService)
local RecycleService = require(ServerScriptService.Services.RecycleService)
local RebirthService = require(ServerScriptService.Services.RebirthService)
local HoneyService   = require(ServerScriptService.Services.HoneyService)
local MapService     = require(ServerScriptService.Services.MapService)

-- v8
local PromotionService          = require(ServerScriptService.Services.PromotionService)
local CharmService              = require(ServerScriptService.Services.CharmService)
local EventService              = require(ServerScriptService.Services.EventService)
local EventParticipationService = require(ServerScriptService.Services.EventParticipationService)

-- v10
local EggLayService             = require(ServerScriptService.Services.EggLayService)

-- v14
local EggTreeService            = require(ServerScriptService.Services.EggTreeService)
local EggTree                   = require(ReplicatedStorage.Modules.EggTree)
local CombatConfig              = require(ReplicatedStorage.Config.CombatConfig)

-- v12
local ActivityLock = require(ServerScriptService.Util.ActivityLock)  -- Paket 1.1: Lock-Halter ausgeben
local PetModeService            = require(ServerScriptService.Services.PetModeService)
local PitArenaService           = require(ServerScriptService.Services.PitArenaService)

-- v15 (Waben)
local CombService               = require(ServerScriptService.Services.CombService)
local CombRecyclerService       = require(ServerScriptService.Services.CombRecyclerService)

-- v15 (Tower, Angeben, Login-Bonus)
local TowerConfig               = require(ReplicatedStorage.Config.TowerConfig)
local TowerService              = require(ServerScriptService.Services.TowerService)
local GamepassService           = require(ServerScriptService.Services.GamepassService)   -- 08.10. Paket C
local LeaderboardService        = require(ServerScriptService.Services.LeaderboardService)
local LoginBonusService         = require(ServerScriptService.Services.LoginBonusService)
local PlayerMigration           = require(ServerScriptService.Util.PlayerMigration)

-- v17 (lebendige Events)
local JackpotRoll               = require(ServerScriptService.Util.JackpotRoll)

-- HBB Paket 0
local FunnelService             = require(ServerScriptService.Services.FunnelService)

local DebugService = {}

local BINDABLE_NAME = "RBLDebug"

--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

-- Der erste Spieler im Server. Fuer Solo-Tests in Studio genau richtig.
local function firstPlayer(): Player?
	return Players:GetPlayers()[1]
end

local function requireData(): (Player?, Types.PlayerData?, string?)
	local player = firstPlayer()
	if not player then
		return nil, nil, "Kein Spieler im Spiel — laeuft der Play-Modus?"
	end

	local data = PlayerService.getData(player)
	if not data then
		return player, nil, "Daten fuer " .. player.Name .. " noch nicht geladen"
	end

	return player, data, nil
end

local function countBaerchis(data: Types.PlayerData): number
	local n = 0
	for _ in data.island.baerchis do n += 1 end
	return n
end

--------------------------------------------------------------------------------
-- Befehle
--------------------------------------------------------------------------------

local commands: { [string]: (Player, Types.PlayerData, ...any) -> any } = {}

commands.info = function(player, data)
	local buildings: { [string]: number } = {}
	for id, building in data.island.buildings do
		buildings[id] = building.level
	end

	return {
		player       = player.Name,
		gummies      = data.gummies,
		goldGummies  = data.goldGummies,
		rebirthCount = data.rebirthCount,
		rebirthMult  = data.rebirthMult,
		baerchis     = countBaerchis(data),
		towers       = data.towers,
		towerProgress = data.island.towerProgress,
		buildings    = buildings,
		eggStock     = data.island.eggStock,
	}
end

-- Waehrung schenken. Ohne rebirthMult, du bekommst exakt die Zahl.
commands.give = function(player, _data, gummies: any, gold: any)
	EconomyService.awardGummiesFlat(player, tonumber(gummies) or 100000)
	EconomyService.awardGoldGummies(player, tonumber(gold) or 1000)
	return commands.info(player, PlayerService.getDataOrError(player))
end

-- Alle Baerchis als flache Liste (uid zum Weiterverwenden)
commands.list = function(_player, data)
	local out = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(out, {
			uid      = uid,
			configId = baerchi.configId,
			rarity   = baerchi.rarity,
			level    = baerchi.level,
			xp       = baerchi.xp,
			fusion   = baerchi.isFusionResult,
			bonus    = baerchi.fusionBonus,

			-- v8: die zweite Fortschrittsachse. `charms` bewusst nur als Anzahl
			-- — die Detailwerte holt man sich ueber "charms <uid>", sonst wird
			-- die Liste in der Command Bar unlesbar.
			promo    = baerchi.promotionLevel or 0,
			stats    = baerchi.statLevels,
			charms   = #(baerchi.charms or {}),
			mutation = baerchi.mutation,
		})
	end
	table.sort(out, function(a, b) return a.uid < b.uid end)
	return out
end

-- Baerchi direkt erzeugen, ohne Ei.
--
-- Das dritte Argument setzt eine Mutation (siehe BaerchiConfig.MUTATIONS fuer
-- gueltige Namen: Gold/Diamond/Bloodrot/Celestial/Candy/Lava/Galaxy/Rainbow).
-- Ohne diesen Weg waeren Mutationen in Studio praktisch nicht testbar: die
-- Gesamtchance beim Schluepfen liegt bei 1.5%, die seltenste Stufe (Rainbow)
-- bei 0.0005% — man muesste also im Schnitt 200'000 Eier ausbrueten.
--   D:Invoke("add", "RedBaerchi", 10)              -- normal
--   D:Invoke("add", "RedBaerchi", 10, "Rainbow")   -- mit Mutation
commands.add = function(player, data, configId: any, level: any, mutation: any)
	local mutationId: any = nil
	if typeof(mutation) == "string" and BaerchiConfig.MUTATIONS[mutation :: any] then
		mutationId = mutation
	end

	local baerchi = BaerchiFactory.create(tostring(configId), {
		level    = tonumber(level) or 1,
		mutation = mutationId,
	})
	if not baerchi then
		return { error = "Unbekannter configId: " .. tostring(configId) }
	end

	data.island.baerchis[baerchi.uid] = baerchi
	PlayerService.markDirty(player)

	return {
		uid      = baerchi.uid,
		configId = baerchi.configId,
		rarity   = baerchi.rarity,
		level    = baerchi.level,
		mutation = baerchi.mutation,
	}
end

-- Die Kampfwerte eines Baerchis so, wie der Kampf sie sieht. Praktisch, um
-- Promotion, Stat-Stufen, Charms und Mutation gegeneinander nachzurechnen.
commands.stats = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		return { error = "Unbekannter configId: " .. baerchi.configId }
	end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)

	return {
		configId = baerchi.configId,
		level    = baerchi.level,
		mutation = baerchi.mutation,
		promo    = baerchi.promotionLevel or 0,
		maxHp    = stats.maxHp,
		atk      = stats.atk,
		spd      = stats.spd,
		pwrProzent = math.floor(stats.pwr * 100 + 0.5),
		skill    = stats.skillId,
	}
end

-- Gebaeude-Level direkt setzen (umgeht die Kosten)
commands.building = function(player, data, buildingId: any, level: any)
	local building = data.island.buildings[buildingId]
	if not building then
		return { error = "Unbekanntes Gebaeude: " .. tostring(buildingId) }
	end

	-- clampBuildingLevel rundet mit ab: ohne das landete eine 5.5 aus der
	-- Command Bar als Kommazahl in den Daten und jedes spaetere
	-- string.format("%d", level) wuerde daran scheitern.
	building.level = EconomyConfig.clampBuildingLevel(tonumber(level) or 1)
	MapService.updateBuildingLevel(player, buildingId, building.level)
	PlayerService.markDirty(player)

	return { building = buildingId, level = building.level, look = BuildingBehavior.getLook(building.level) }
end

-- v12: Ei ins Lager legen und sofort oeffnen (es gibt keine Brut mehr)
commands.hatch = function(player, data, eggType: any)
	local egg = tostring(eggType or "BasicEgg")
	if not EggConfig.data[egg :: Types.EggType] then
		return { error = "Unbekannter Egg-Typ: " .. egg }
	end

	data.island.eggStock[egg :: Types.EggType] = (data.island.eggStock[egg :: Types.EggType] or 0) + 1
	local result = EggService.openEgg(player, egg :: Types.EggType)
	if not result then
		return { error = "Oeffnen fehlgeschlagen" }
	end

	return {
		configId = result.baerchi.configId,
		rarity   = result.baerchi.rarity,
		mutation = result.baerchi.mutation,
		neu      = result.isNew,
	}
end

-- v12: Eier ins Lager legen, ohne sie zu oeffnen (fuer Tests im Ei-Menue)
commands.egg = function(player, data, eggType: any, count: any)
	local egg = tostring(eggType or "BasicEgg")
	if not EggConfig.data[egg :: Types.EggType] then
		return { error = "Unbekannter Egg-Typ: " .. egg }
	end

	local amount = math.clamp(tonumber(count) or 1, 1, 100)
	data.island.eggStock[egg :: Types.EggType] = (data.island.eggStock[egg :: Types.EggType] or 0) + amount
	PlayerService.markDirty(player)
	return { lager = data.island.eggStock }
end

-- v12/v15: gespeicherten letzten Lauf im gewaehlten Tower setzen (0 = loeschen)
commands.pitprogress = function(player, data, stage: any)
	local reached = math.floor(tonumber(stage) or 0)
	local towerId = data.towers.selected
	data.island.towerProgress[towerId] = if reached > 0 then reached else nil
	PlayerService.markDirty(player)
	return { tower = towerId, towerProgress = data.island.towerProgress }
end

-- v15: Tower waehlen (auch einen noch geschlossenen) und ab `stage` kaempfen.
-- Die Fortsetzungs-Kosten werden vorher gutgeschrieben (Test ohne Grind).
commands.tower = function(player, data, towerId: any, stage: any)
	local id = tostring(towerId or "I")
	local def = TowerConfig.get(id)
	if not def then
		return { error = "Unbekannter Tower: " .. id .. " (I, II, III, Final)" }
	end
	local uid = data.island.equippedUid
	if not uid then
		return { error = "Kein Baerchi ausgeruestet" }
	end
	TowerService.debugOpenAll(data)
	data.towers.selected = id
	local start = math.clamp(math.floor(tonumber(stage) or 1), 1, def.stages)
	local choice = "Fresh"
	if start > 1 then
		data.island.towerProgress[id] = start
		local _, cost = CombatService.getResumeOffer(data, id, "Last")
		if cost > 0 then EconomyService.awardGummiesFlat(player, cost) end
		choice = "Last"
	end
	PlayerService.markDirty(player)
	task.spawn(PetModeService.request, player, "Fight", choice :: any)
	return {
		tower = id, ab = start, deckel = TowerConfig.getStageCap(data.rebirthCount, id, data.towers.records, data.towers.unlocked),
		gegnerStage1 = TowerConfig.getEnemyStats(id, start),
	}
end

-- 08.10. (Paket C): Gamepass-Besitz fuer diese Sitzung erzwingen.
-- D:Invoke("pass", "on")  /  ("pass", "off")  /  ("pass", "reset") = wieder Roblox
-- Optional mit Key: D:Invoke("pass", "on", "SKIP_PASS")
commands.pass = function(player, _data, mode: any, key: any)
	local passKey = tostring(key or "SKIP_PASS")
	local m = tostring(mode or "on")
	local value: boolean? = if m == "on" then true elseif m == "off" then false else nil
	GamepassService.debugSet(player, passKey, value)
	return { pass = passKey, besitz = GamepassService.owns(player, passKey) }
end

-- v15: Tower-Rekord direkt setzen (Meilensteine bis dorthin werden ausgezahlt)
commands.towerrecord = function(player, data, towerId: any, stage: any)
	local id = tostring(towerId or "I")
	if not TowerConfig.get(id) then
		return { error = "Unbekannter Tower: " .. id }
	end
	TowerService.debugSetRecord(player, id, tonumber(stage) or 0)
	return { towers = data.towers }
end

-- v15: Deckel des aktuellen Rebirths
commands.rebirthcap = function(_player, data)
	local caps: { [string]: number } = {}
	for _, def in TowerConfig.TOWERS do
		caps[def.id] = TowerConfig.getStageCap(data.rebirthCount, def.id, data.towers.records, data.towers.unlocked)
	end
	local capTower, capStage = TowerConfig.getCap(data.rebirthCount)
	return { rebirths = data.rebirthCount, deckelTower = capTower, deckelStage = capStage, proTower = caps }
end

-- Sammel-Update 05.10. (Paket 4.1): beste Stage dieses Lebens setzen und die
-- Rebirth-Bedingung zeigen. D:Invoke("stagebest", "I", 30)
commands.stagebest = function(player, data, towerId: any, stage: any)
	if typeof(towerId) == "string" and TowerConfig.get(towerId) then
		data.island.stageBest[towerId] = math.max(0, math.floor(tonumber(stage) or 0))
		PlayerService.markDirty(player)
	end
	local reqTower, reqStage = TowerConfig.getRebirthRequirement(data.rebirthCount, data.towers.records)
	return {
		stageBest  = data.island.stageBest,
		bedingung  = reqTower .. "/" .. reqStage,
		bereit     = TowerConfig.isRebirthReady(data.rebirthCount, data.island.stageBest, data.towers.records),
	}
end

-- Sammel-Update 05.10. (Paket 8): Inkubator-Stand; "done" macht alle Eier fertig.
commands.incubator = function(player, data, action: any)
	local incubator = data.island.incubator
	if action == "done" then
		for _, entry in incubator.slots do entry.finishAt = os.time() end
		PlayerService.markDirty(player)
	elseif action == "breed" then
		-- INCUBATOR_BREED: jedes Baerchi im Inkubator bruetet sofort ein Ei.
		-- Lazy require: kein weiterer Modul-Local (200er-Grenze).
		local made = require(ServerScriptService.Services.IncubatorService).breedNow(player)
		return { gebruetet = made, baerchis = incubator.breeders }
	end
	return { level = incubator.level, plaetze = incubator.slots, baerchis = incubator.breeders }
end

-- v15: Login-Bonus — so tun, als waeren `days` Tage vergangen
commands.dailyshift = function(player, _data, days: any)
	return LoginBonusService.debugShift(player, math.floor(tonumber(days) or 1))
end

-- v15: Bestenlisten sofort schreiben und neu lesen
commands.lbflush = function(_player, _data)
	return LeaderboardService.flush()
end

-- v15: Teile auf der eigenen Insel zaehlen (Budget: 250 ohne Baerchi-Figuren)
commands.parts = function(player, _data)
	return MapService.countParts(player) or { error = "kein Plot" }
end

-- v15: den aktuellen Spielstand in ein v14-Format zuruckverwandeln (Topf L7,
-- Presse L4, PIT 5, letzter Lauf Stage 12) und durch die Migration schicken —
-- das Ergebnis wird NICHT uebernommen, nur angezeigt (Migrations-Probe).
commands.v14save = function(_player, data)
	local HttpServiceLocal = game:GetService("HttpService")
	local copy = HttpServiceLocal:JSONDecode(HttpServiceLocal:JSONEncode(data))
	copy.version = 14
	copy.towers = nil
	copy.daily = nil
	copy.island.towerProgress = nil
	copy.island.pitRefund = nil
	copy.island.pitLevel = 5
	copy.island.pitProgress = { pitLevel = 5, reachedStage = 12 }
	copy.island.buildings.HoneyRefiner = nil
	copy.island.buildings.HoneyPot   = { id = "HoneyPot",   level = 7, honey = 4, lastProducedAt = os.time() }
	copy.island.buildings.HoneyPress = { id = "HoneyPress", level = 4, honey = 5, lastProducedAt = os.time() }
	local migrated = PlayerMigration.applyDefaults(copy)
	return {
		version   = migrated.version,
		veredler  = migrated.island.buildings.HoneyRefiner,
		erstattung = migrated.island.pitRefund,
		rekorde   = migrated.towers.records,
	}
end

commands.petmode = function(player, data)
	local pitPhase, stage = PitArenaService.getPhase(player)
	return {
		zuHause     = PetModeService.isHome(player),
		pit         = pitPhase,
		stage       = stage,
		event       = EventParticipationService.getPhase(player),
		-- Sammel-Update Paket 1.1: wer haelt die Figur gerade? (UFO-Einfrieren)
		lockHalter  = ActivityLock.owner(player) or "frei",
		entfuehrt   = EventParticipationService.isAbducting(player),
		towerProgress = data.island.towerProgress,
		eggStock    = data.island.eggStock,
		gummies     = data.gummies,
		lastEggAt   = data.island.lastEggAt,
	}
end

commands.pm = function(player, data, mode: any, resume: any)
	PetModeService.request(player, tostring(mode or "Home"), if resume then tostring(resume) :: any else nil)
	return commands.petmode(player, data)
end

commands.fight = function(player, _data, uid: any)
	CombatService.startPitRun(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

-- Alle Honig-Lager sofort fuellen (umgeht die Wartezeit).
-- Ohne das dauert jeder Level-Test 20 Sekunden pro Honig.

-- v15: Waben im Event-Pit legen und Zustand ausgeben
commands.combs = function(player, data, n: any)
	local count = if typeof(n) == "number" then math.clamp(math.floor(n), 0, 100) else 0
	if count > 0 then
		CombService.debugSpawn(count)
	end

	local recycler = data.island.recycler
	local slots = CombService.getSlotInfo()
	return {
		wabenImPit    = CombService.getWorldCount(),
		getragen      = CombService.getCarriedCount(player),
		getragenAlle  = slots.held,
		respawnQueue  = slots.queued,
		slotLimit     = slots.limit,
		recyclerLevel = recycler.level,
		warteschlange = recycler.queued,
	}
end

-- v17: naechsten UFO-Abwurf als Jackpot erzwingen; Stand des Pity-Zaehlers
commands.jackpot = function(_player, _data)
	JackpotRoll.ufo.forceNext = true
	return {
		naechsterIstJackpot = true,
		abwuerfeSeitJackpot = JackpotRoll.ufo.sinceLast,
		abwuerfeGesamt      = JackpotRoll.ufo.total,
		jackpotsGesamt      = JackpotRoll.ufo.jackpots,
		pity                = EventConfig.UFO.JACKPOT_PITY_DROPS,
	}
end

-- v17: Wabenthema setzen ("off" = normal)
commands.combtheme = function(_player, _data, themeId: any)
	local id = if typeof(themeId) == "string" and themeId ~= "off" then themeId else nil
	CombService.setTheme(id)
	local slots = CombService.getSlotInfo()
	return { thema = CombService.getTheme() or "normal", wabenImPit = slots.world, slotLimit = slots.limit }
end

-- v17: Waben einfliegen lassen (wie ein Vulkan-Ausbruch aus der Pit-Mitte)
commands.launch = function(_player, _data, n: any)
	local count = if typeof(n) == "number" then math.clamp(math.floor(n), 1, 30) else 10
	local origin = MapService.getEventPitPosition() + Vector3.new(0, 2, 0)
	return { gestartet = CombService.launchCombs(count, origin), slots = CombService.getSlotInfo() }
end

-- v15: Wabeneinheiten direkt in die Warteschlange des Recyclers legen
commands.queue = function(player, data, n: any)
	local units = if typeof(n) == "number" then math.clamp(math.floor(n), 0, 100000) else 0
	if units > 0 then
		CombRecyclerService.deposit(player, units)
	end

	local recycler = data.island.recycler
	return {
		warteschlange = recycler.queued,
		level         = recycler.level,
		gummies       = data.gummies,
	}
end

-- v15: Recycler-Level direkt setzen (ohne Kosten)
commands.recycler = function(player, data, level: any)
	local recycler = data.island.recycler
	if typeof(level) == "number" then
		recycler.level = CombConfig.clampLevel(level)
		PlayerService.markDirty(player)
	end

	return {
		level         = recycler.level,
		gummiesJeEinheit = CombConfig.getPayPerUnit(recycler.level),
		einheitenProSek  = CombConfig.getSpeed(recycler.level),
		warteschlange = recycler.queued,
	}
end

commands.honey = function(player, data)
	local filled: { [string]: number } = {}

	for _, building in data.island.buildings do
		-- Lager DIESES Gebaeudes auf DIESEM Level: der Bienenstock fasst seit
		-- v7 mehr als die anderen beiden.
		building.honey          = BuildingBehavior.getCapacity(building.id, building.level)
		building.lastProducedAt = os.time()
		filled[building.id]     = building.honey
	end

	PlayerService.markDirty(player)
	return { honey = filled }
end

-- Einen Baerchi fuettern (heilt + gibt XP), so oft wie angegeben
commands.feed = function(player, _data, uid: any, times: any)
	local count = math.clamp(tonumber(times) or 1, 1, 100)

	for _ = 1, count do
		HoneyService.feed(player, tostring(uid))
	end

	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Fusion. Die beiden letzten Argumente sind der Sperr-Schritt aus dem
-- Fusions-Menue (siehe FusionService, Regel C) und duerfen weggelassen werden —
-- dann laeuft alles automatisch.
--   D:Invoke("fuse", uidA, uidB)                   -- alles automatisch
--   D:Invoke("fuse", uidA, uidB, "ability", "B")   -- Skill kommt von B
commands.fuse = function(player, _data, uidA: any, uidB: any, lockedProperty: any, lockedFrom: any)
	local property = if lockedProperty ~= nil then tostring(lockedProperty) else nil
	local from     = if lockedFrom ~= nil then tostring(lockedFrom) else nil

	FusionService.fuse(player, tostring(uidA), tostring(uidB), property :: any, from :: any)
	return commands.list(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v8: Promotion, Charms, Event-Teilnahme
--------------------------------------------------------------------------------

-- Befoerdern. Legt die noetigen Duplikate NICHT selbst an — wer testen will,
-- ruft vorher mehrfach "add <configId>" auf. Genau so merkt man, ob die
-- Material-Pruefung tut, was sie soll.
commands.promote = function(player, _data, uid: any)
	PromotionService.promote(player, tostring(uid))
	return commands.list(player, PlayerService.getDataOrError(player))
end

-- Charms wuerfeln. Kostet echte GoldGummies — vorher "give 0 100000".
commands.roll = function(player, _data, uid: any, times: any)
	CharmService.rollCharms(player, tostring(uid), tonumber(times) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Alle acht Slots eines Baerchis im Klartext.
commands.charms = function(_player, data, uid: any)
	local baerchi = data.island.baerchis[tostring(uid)]
	if not baerchi then
		return { error = "Baerchi nicht gefunden: " .. tostring(uid) }
	end

	local bySlot: { [number]: any } = {}
	for _, charm in baerchi.charms or {} do
		bySlot[charm.slot] = charm
	end

	local out = {}
	for slot = 1, CharmConfig.SLOT_COUNT do
		local charm = bySlot[slot]
		out[slot] = {
			slot     = CharmConfig.SLOT_NUMERALS[slot],
			offen    = CharmConfig.isSlotUnlocked(slot, baerchi.promotionLevel or 0),
			abPromo  = CharmConfig.getUnlockPromotion(slot),
			rarity   = if charm then charm.rarity else nil,
			effekt   = if charm then CharmConfig.describe(charm) else nil,
			gesperrt = if charm then charm.locked else nil,
		}
	end

	return { promotion = baerchi.promotionLevel or 0, slots = out }
end

-- Einen Charm-Slot sperren/freigeben.
commands.lock = function(player, _data, uid: any, slot: any)
	CharmService.toggleLock(player, tostring(uid), tonumber(slot) or 1)
	return commands.charms(player, PlayerService.getDataOrError(player), uid)
end

-- Den ausgeruesteten Baerchi zum Event schicken bzw. zurueckholen.
commands.event = function(player, _data)
	EventParticipationService.sendToEvent(player)
	return { unterwegs = true }
end

commands.recall = function(player, _data)
	EventParticipationService.recall(player)
	return { unterwegs = true }
end

--------------------------------------------------------------------------------
-- v10: Eier legen
--------------------------------------------------------------------------------

-- Legt sofort ein Ei, ohne auf das Intervall zu warten. Mehrfach aufrufen, um
-- den Plot zu fuellen und die Obergrenze zu pruefen.
commands.lay = function(player, _data, times: any)
    local count  = math.clamp(tonumber(times) or 1, 1, 30)
    local laid   = 0

    for _ = 1, count do
        if EggLayService.layNow(player) then
            laid += 1
        else
            break   -- Obergrenze erreicht oder kein Baerchi ausgeruestet
        end
    end

    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Was gerade herumliegt, plus die Werte des ausgeruesteten Legers.
commands.eggs = function(_player, data)
    local out = {}
    for _, egg in data.island.laidEggs or {} do
        table.insert(out, { uid = egg.uid, typ = egg.eggType })
    end

    local uid     = data.island.equippedUid
    local baerchi = if uid then data.island.baerchis[uid] else nil

    local rate: any = "kein Baerchi ausgeruestet"
    local chancen: any = nil

    if baerchi then
        local online  = EggCalculator.getLayIntervalSeconds(baerchi, false)
        local offline = EggCalculator.getLayIntervalSeconds(baerchi, true)

        rate = {
            configId       = baerchi.configId,
            level          = baerchi.level,
            eggStufe       = (baerchi.statLevels :: any).egg or 0,
            mutation       = baerchi.mutation,
            sekundenOnline = if online then math.floor(online + 0.5) else nil,
            sekundenOffline= if offline then math.floor(offline + 0.5) else nil,
        }

        chancen = {}
        for _, chance in EggCalculator.getChances(baerchi) do
            table.insert(chancen, string.format("%s %.0f%%", chance.eggType, chance.percent))
        end
    end

    return {
        liegen  = #out,
        maximum = EggConfig.MAX_UNCOLLECTED_EGGS,
        eier    = out,
        lager   = data.island.eggStock,
        leger   = rate,
        chancen = chancen,
    }
end

-- Alle herumliegenden Eier einsammeln (dasselbe wie der Knopf auf der Karte).
commands.collect = function(player, _data)
    EggLayService.collectAll(player)
    return commands.eggs(player, PlayerService.getDataOrError(player))
end

-- Die Zeitmarke kuenstlich in die Vergangenheit setzen und danach nachrechnen
-- lassen — so laesst sich das OFFLINE-Nachholen pruefen, ohne den Server zu
-- verlassen. Der naechste Tick (max. 5s) legt dann die faelligen Eier.
--
-- Achtung: der Tick rechnet mit der ONLINE-Rate. Das echte Offline-Verhalten
-- (langsamer, siehe EggConfig.OFFLINE_SLOWDOWN) sieht man nur beim Rejoin.
commands.eggtime = function(player, data, minutes: any)
    local back = math.clamp(tonumber(minutes) or 30, 1, 10000)
    data.island.lastEggAt = os.time() - back * 60
    PlayerService.markDirty(player)

    return { zurueckgestellt = back .. " Minuten", hinweis = "naechster Tick legt nach (max. 5s)" }
end

-- Die laufende Phase sofort beenden. Zweimal aufgerufen bekommt man also aus
-- der Pause heraus ein vollstaendiges Event samt Belohnung, ohne acht Minuten
-- zu warten:
--   D:Invoke("skipevent")   -- Pause vorbei, Event laeuft
--   D:Invoke("event")       -- Baerchi hinschicken, ankommen lassen
--   D:Invoke("skipevent")   -- Event vorbei → Stat-Stufe wird vergeben
commands.skipevent = function(_player, _data)
	EventService.skipPhase()

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		belohnung    = if active then Loc.resolve(EventConfig.describeReward(active)) else nil,
		naechstes    = EventService.getNext().displayName,
		restSekunden = EventService.getRemainingSeconds(),
	}
end

-- Der ganze Katalog mit Belohnung, in der Reihenfolge, in der die Events
-- laufen. Praktisch, um die ids fuer "startevent" nachzuschlagen.
commands.events = function(_player, _data)
	local katalog = {}
	for index, def in EventConfig.EVENTS do
		table.insert(katalog, string.format(
			"%d. %s (%s) — %s",
			index, def.displayName, def.id, Loc.resolve(EventConfig.describeReward(def))
		))
	end

	local active = EventService.getActive()
	return {
		laeuftJetzt  = if active then active.displayName else "Pause",
		restSekunden = EventService.getRemainingSeconds(),
		naechstes    = EventService.getNext().displayName,
		takt         = string.format(
			"individuelle Dauer je Event / %ds Pause",
			EventConfig.EVENT_GAP_SECONDS
		),
		katalog      = katalog,
	}
end

-- Ein BESTIMMTES Event sofort starten, statt sich durch den Zyklus zu warten.
-- Ein voller Durchlauf durch alle zehn Events dauert 80 Minuten — ohne diesen
-- Befehl waere z.B. der Mutations-Sturm praktisch nicht testbar.
--
-- Laeuft gerade ein anderes Event, wird es vorher ordentlich beendet (die
-- Anwesenden bekommen also noch ihre Belohnung, siehe EventService.startById).
commands.startevent = function(_player, _data, id: any)
	local eventId = tostring(id or "")

	if not EventService.startById(eventId) then
		local ids = {}
		for _, def in EventConfig.EVENTS do
			table.insert(ids, def.id)
		end
		return { error = "Unbekannte Event-id: " .. eventId, verfuegbar = ids }
	end

	local active = EventService.getActive()
	return {
		gestartet    = if active then active.displayName else "?",
		belohnung    = if active then Loc.resolve(EventConfig.describeReward(active)) else nil,
		restSekunden = EventService.getRemainingSeconds(),
		hinweis      = "jetzt 'event' aufrufen, um den Baerchi hinzuschicken — er muss beim ENDE dort stehen",
	}
end

commands.recycle = function(player, _data, uid: any)
	RecycleService.recycle(player, tostring(uid))
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.upgrade = function(player, _data, buildingId: any)
	IslandService.upgradeBuilding(player, buildingId)
	return commands.info(player, PlayerService.getDataOrError(player))
end

commands.rebirth = function(player, _data)
	RebirthService.rebirth(player)
	return commands.info(player, PlayerService.getDataOrError(player))
end

--------------------------------------------------------------------------------
-- v14: Ei-Baum
--------------------------------------------------------------------------------

commands.tree = function(_player, data)
	local out = { blueprints = data.eggTree.blueprints, rebirths = data.rebirthCount }
	for _, eggId in EggConfig.getOrderedIds() do
		local p = EggTree.getProgress(data, eggId)
		local parts = {}
		for _, c in p.conditions do
			local label = c.kind .. (if c.egg then ":" .. c.egg elseif c.rarity then ":" .. c.rarity else "")
			table.insert(parts, string.format("%s %d/%d%s", label, c.have, c.need, if c.done then " ok" else ""))
		end
		out[string.format("%02d %s", EggConfig.data[eggId].sortOrder, eggId)] = string.format("%s | hatched %d | lager %d | %s",
			if p.unlocked then "FREI" else "zu", data.eggTree.hatched[eggId] or 0,
			data.island.eggStock[eggId] or 0, table.concat(parts, ", "))
	end
	return out
end

commands.unlock = function(player, data, eggType: any)
	if eggType == "all" then
		for _, eggId in EggConfig.getOrderedIds() do
			EggTreeService.forceUnlock(player, data, eggId, "debug")
		end
	elseif typeof(eggType) == "string" and EggConfig.data[eggType :: Types.EggType] then
		EggTreeService.forceUnlock(player, data, eggType :: Types.EggType, "debug")
	else
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.hatched = function(player, data, eggType: any, count: any)
	if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then
		return { error = "Unbekanntes Ei: " .. tostring(eggType) }
	end
	data.eggTree.hatched[eggType] = math.max(0, math.floor(tonumber(count) or 0))
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

commands.blueprint = function(player, data, amount: any)
	EggTreeService.grantBlueprint(player, data, tonumber(amount) or 1)
	PlayerService.markDirty(player)
	return { blueprints = data.eggTree.blueprints }
end

commands.useblueprint = function(player, data, eggType: any)
	local ok = EggTreeService.useBlueprint(player, eggType)
	return { ok = ok, tree = commands.tree(player, data) }
end

commands.press = function(player, data, eggType: any, path: any)
	local result = EggTreeService.press(player, eggType, path)
	return { result = result, stock = data.island.eggStock }
end

commands.setrebirth = function(player, data, count: any)
	data.rebirthCount = math.max(0, math.floor(tonumber(count) or 0))
	data.rebirthMult  = EconomyConfig.getRebirthMult(data.rebirthCount)
	PlayerService.markDirty(player)
	return commands.tree(player, data)
end

-- Spielstand fuer Tests sichern und zuruecksetzen. Die Kopie liegt nur im
-- Speicher dieses Servers (nicht im DataStore).
local HttpService = game:GetService("HttpService")
local _snapshot: string? = nil

commands.snapshot = function(_player, data)
	_snapshot = HttpService:JSONEncode(data)
	return { ok = true, bytes = #(_snapshot :: string) }
end

commands.restore = function(player, data)
	if not _snapshot then return { error = "Kein Snapshot" } end
	local saved = HttpService:JSONDecode(_snapshot :: string)
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in saved do (data :: any)[k] = v end
	MapService.rebuildIsland(player, data.island)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return { ok = true }
end

-- HBB Paket 0: feste Test-Zustaende fuer Playtests und Studio-Testschritte.
--   fresh   = Startstand eines neuen Kontos (createdAt = jetzt → Trichter misst)
--   hatch10 = fresh + zehn geoeffnete Basis-Eier
--   tower1  = hatch10 + Tower I geschafft (Rekord 30, Meilensteine ausgezahlt)
--
-- Studio spielt gegen den ECHTEN DataStore. Deshalb verlangt der Befehl einen
-- vorherigen "snapshot"; zurueck geht es mit "restore". Der Snapshot liegt nur
-- im Speicher dieses Servers — vor "Stop" also restore aufrufen.
--
-- Der Baerchi sollte zu Hause stehen (kein Kampf, kein Event), sonst haelt ein
-- anderer Service noch die alte Figur.
local TEST_STATES = { fresh = true, hatch10 = true, tower1 = true }
local TEST_HATCH_COUNT = 10
local TEST_TOWER_RECORD = 30

commands.state = function(player, data, name: any)
	local stateName = tostring(name or "")
	if not TEST_STATES[stateName] then
		return { error = "Unbekannter Zustand: " .. stateName, verfuegbar = { "fresh", "hatch10", "tower1" } }
	end
	if not _snapshot then
		return { error = "Erst D:Invoke(\"snapshot\") — Studio schreibt in den echten Spielstand" }
	end

	-- 1. fresh: alles ersetzen ausser Sitzungs-Sperre und Sprache
	local session  = (data :: any).session
	local language = data.language
	local fresh = PlayerService.buildDefaultData()
	for k in data :: any do (data :: any)[k] = nil end
	for k, v in fresh :: any do (data :: any)[k] = v end
	;(data :: any).session = session
	data.language = language
	MapService.rebuildIsland(player, data.island)
	FunnelService.debugReset(player)

	-- 2. hatch10: ueber den echten Weg oeffnen, damit Zaehler, Index und
	-- Auto-Ausruesten genau wie im Spiel laufen.
	if stateName == "hatch10" or stateName == "tower1" then
		data.island.eggStock.BasicEgg = (data.island.eggStock.BasicEgg or 0) + TEST_HATCH_COUNT
		for _ = 1, TEST_HATCH_COUNT do
			EggService.openEgg(player, "BasicEgg")
		end
	end

	-- 3. tower1: Rekord setzen, Meilensteine wie bei "towerrecord"
	if stateName == "tower1" then
		TowerService.debugSetRecord(player, "I", TEST_TOWER_RECORD)
	end

	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return {
		ok = true,
		zustand = stateName,
		baerchis = countBaerchis(data),
		lager = data.island.eggStock,
		rekorde = data.towers.records,
		hinweis = "Zurueck mit D:Invoke(\"restore\")",
	}
end

-- Ein einzelner Kampf mit Runden-Log (Faehigkeiten pruefen).
commands.skilltest = function(_player, _data, configId: any, stage: any)
	local b = BaerchiFactory.create(tostring(configId), { level = 20 })
	if not b then return { error = "Unbekannter Baerchi" } end
	local def = BaerchiConfig.getById(b.configId)
	local stats = CombatCalculator.getEffectiveStats(b, (def :: any).baseStats)
	local es = CombatConfig.getEnemyStats(1, tonumber(stage) or 20)
	local me = { uid = "me", stats = stats, hp = stats.maxHp, charge = 0 }
	local en = { uid = "en", stats = es, hp = es.maxHp, charge = 0 }
	local r = CombatCalculator.simulate(me, en)
	local lines = {}
	for i, e in r.log do
		if i > 40 then break end
		table.insert(lines, string.format("%s r%d %s dmg %d heal %d abs %d | A %d B %d %s",
			e.actor, e.roundNumber, e.skillId or "-", e.damage, e.heal, e.absorbed,
			e.attackerHpAfter, e.defenderHpAfter, if e.effects then table.concat(e.effects, ",") else ""))
	end
	return { winner = r.winnerUid, rounds = r.rounds, skillUses = r.skillUses, log = lines }
end

commands.help = function()
	return {
		"info", "give <gummies> <gold>", "list",
		"add <configId> <level> [mutation]", "stats <uid>",
		"building <id> <level>",
		"hatch <eggType>", "egg <eggType> [anzahl]", "pitprogress <stage>", "honey", "feed <uid> <times>",
		"fight <uid>",
		"fuse <uidA> <uidB> [ability|level|eggs] [A|B]",
		"recycle <uid>", "upgrade <buildingId>", "rebirth",

		-- v8
		"promote <uid>", "charms <uid>", "roll <uid> [anzahl]", "lock <uid> <slot>",
		"event", "recall", "skipevent", "events", "startevent <eventId>",

		-- v10
		"eggs", "lay [anzahl]", "collect", "eggtime <minuten>",

		-- v12
		"petmode", "pm <Event|Fight|Home> [Fresh|Percent|Last]",

		-- v14
		"tree", "unlock <eggType|all>", "hatched <eggType> <n>", "blueprint [n]",
		"useblueprint <eggType>", "press <eggType> [Gold|Kristall|Void]", "setrebirth <n>",
		"skilltest <configId> [stage]", "snapshot", "restore",
		-- HBB Paket 0
		"state <fresh|hatch10|tower1>  (erst snapshot!)",

		-- v15
		"combs [anzahl]", "queue <einheiten>", "recycler [level]",

		-- v15 (Tower/Gebaeude/Angeben/Login-Bonus)
		"tower <I|II|III|Final> <stage>", "towerrecord <id> <stage>", "rebirthcap",
		"pass <on|off|reset> [KEY]  (08.10.: Gamepass Gratis-Skip testen)",
		"dailyshift <tage>", "lbflush", "parts", "v14save",

		-- v17
		"jackpot", "combtheme <themeId|off>", "launch [anzahl]",
	}
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function DebugService.init()
	if not RunService:IsStudio() then
		return   -- im Live-Spiel gibt es diesen Service schlicht nicht
	end

	local existing = ServerScriptService:FindFirstChild(BINDABLE_NAME)
	if existing then existing:Destroy() end

	local bindable = Instance.new("BindableFunction")
	bindable.Name   = BINDABLE_NAME
	bindable.Parent = ServerScriptService

	bindable.OnInvoke = function(command: any, ...)
		local name = tostring(command or "help")
		local handler = commands[name]
		if not handler then
			return { error = "Unbekannter Befehl: " .. name, verfuegbar = commands.help() }
		end

		if name == "help" then
			return commands.help()
		end

		local player, data, reason = requireData()
		if not player or not data then
			return { error = reason }
		end

		local ok, result = pcall(handler, player, data, ...)
		if not ok then
			return { error = tostring(result) }
		end
		return result
	end

	print("[DebugService] Initialisiert | Command Bar: game.ServerScriptService." .. BINDABLE_NAME .. ":Invoke(\"help\")")
end

return DebugService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">EggLayService</string><ProtectedString name="Source"><![CDATA[--!strict
-- EggLayService.luau
-- ServerScriptService/Services/EggLayService.luau
--
-- Einzige Zustaendigkeit:
--   - Den ausgeruesteten Baerchi regelmaessig ein Ei dort ablegen lassen, wo
--     er gerade steht
--   - Diese Eier einsammeln lassen (dann landen sie im Lager und sind
--     ausbruetbar)
--
-- ============================================================
-- WIE DAS LEGEN GETAKTET IST
-- ============================================================
-- Wie bei den Honig-Gebaeuden laeuft KEIN Timer pro Ei. Stattdessen steht auf
-- der Insel eine Zeitmarke (island.lastEggAt), und wie viele Eier faellig sind,
-- wird daraus nachgerechnet. Das hat drei Vorteile:
--
--   1. Es laeuft auch waehrend der Spieler offline ist weiter (langsamer, siehe
--      EggConfig.OFFLINE_SLOWDOWN) — ohne dass dafuer irgendwo ein Server
--      laufen muesste.
--   2. Ein ausgesetzter Tick (Server-Ruckler) verschiebt nichts.
--   3. Es gibt nur EINE Rechnung fuer online und offline, naemlich
--      EggCalculator — nicht zwei, die beim naechsten Balancing auseinander
--      laufen.
--
-- ============================================================
-- WARUM DIE PRODUKTION BEI VOLLEM LAGER ANHAELT
-- ============================================================
-- Liegen bereits EggConfig.MAX_UNCOLLECTED_EGGS Eier herum, wird die Zeitmarke
-- trotzdem auf jetzt gesetzt. Die Wartezeit sammelt sich also NICHT an, und wer
-- nach drei Tagen zurueckkommt, findet zwoelf Eier — nicht dreihundert.
--
-- Das ist exakt dasselbe Verhalten wie beim vollen Honig-Lager (siehe
-- HoneyService): laenger wegbleiben bringt nichts zusaetzlich. Wer mehr will,
-- kommt oefter vorbei und sammelt ein.
--
-- ============================================================
-- SEIT v12: GELEGT WIRD NUR AUF DEM PLOT
-- ============================================================
-- Ist der Baerchi am Event oder im PIT (oder auf dem Weg dorthin bzw.
-- zurueck), PAUSIERT der Lege-Timer: island.lastEggAt wird in jedem Tick um
-- die vergangene Zeit nach vorne geschoben. Kommt er heim, laeuft der Timer
-- von dort weiter, der bisherige Fortschritt bleibt — und es entsteht kein
-- Nachholen fuer die Zeit unterwegs. Der Weg zum Honig-Teich zaehlt als zu
-- Hause (PetModeService.isHome). Ist die Figur gerade nicht sichtbar (Neubau),
-- wird in dem Tick nicht gelegt; faellige Eier kommen im naechsten.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types         = require(ReplicatedStorage.Network.Types)
local FigurePlacement  = require(ServerScriptService.Util.FigurePlacement)   -- Sammel-Update 1.2
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local MapConfig     = require(ReplicatedStorage.Config.MapConfig)
local EggCalculator = require(ReplicatedStorage.Modules.EggCalculator)
local EggTree       = require(ReplicatedStorage.Modules.EggTree)
local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)
local IslandService = require(ServerScriptService.Services.IslandService)
local RateLimiter   = require(ServerScriptService.Util.RateLimiter)
-- v12: nur fuer "ist der Baerchi zu Hause?"
local PetModeService = require(ServerScriptService.Services.PetModeService)

local EggLayService = {}

--------------------------------------------------------------------------------
-- Konstanten
--------------------------------------------------------------------------------

-- Wie oft nachgesehen wird, ob ein Ei faellig ist. Muss nicht schnell sein:
-- das kuerzeste moegliche Intervall ist EggConfig.MIN_LAY_INTERVAL_SECONDS
-- (15s), und faellige Eier gehen nicht verloren — sie werden beim naechsten
-- Tick aus der Zeitmarke nachgerechnet.
local CHECK_INTERVAL = 5

-- Laufender Zaehler fuer die Ei-uid. os.time() allein reicht nicht: bei einem
-- Offline-Nachholen entstehen mehrere Eier in derselben Sekunde.
local _eggCounter = 0

-- v12: Zeitpunkt des letzten Ticks pro Spieler (fuer die Pause) und ob der
-- Baerchi im letzten Tick unterwegs war (fuer den einen Sync bei der Rueckkehr).
local _lastTick: { [Player]: number } = {}
local _wasAway: { [Player]: boolean } = {}

local function newEggUid(): string
	_eggCounter += 1
	return string.format("e_laid_%d_%d_%d", os.time(), _eggCounter, math.random(1000, 9999))
end

--------------------------------------------------------------------------------
-- Wohin das Ei faellt
--------------------------------------------------------------------------------

local function footPosOf(model: Model): Vector3
	return FigurePlacement.footOf(model)   -- Sammel-Update 1.2
end

-- Der Ort, an dem das naechste Ei landet: neben dem Baerchi, wo er GERADE
-- steht. Laeuft er zum Honig-Teich, liegen die Eier auf dem Weg dorthin.
--
-- Der seitliche Versatz ist Zufall im Umkreis von LAY_SCATTER_RADIUS — ohne
-- ihn laegen mehrere Eier exakt uebereinander, wenn der Baerchi laenger an
-- derselben Stelle steht, und man koennte nur das oberste anklicken.
--
-- ============================================================
-- DAS ERGEBNIS IST PLOT-RELATIV, NICHT ABSOLUT
-- ============================================================
-- Welchen der acht Plots ein Spieler bekommt, entscheidet sich bei jedem Join
-- neu. Eine Weltposition zu speichern hiesse: nach einem Rejoin liegen die
-- Eier dort, wo der Plot BEIM LEGEN war — moeglicherweise auf dem Plot eines
-- Nachbarn. Deshalb rechnet MapService.worldToPlot sie in Plot-Koordinaten um,
-- und beim Bauen wieder zurueck.
--
-- Gibt nil zurueck, wenn es gerade keine Figur und keinen Plot gibt. Dann wird
-- schlicht nicht gelegt.
local function pickDropPosition(player: Player, baerchiUid: string): Vector3?
	local figure = MapService.getBaerchiModel(player, baerchiUid)

	local origin: Vector3
	if figure then
		origin = footPosOf(figure)
	else
		-- Kein sichtbarer Baerchi (typisch beim Offline-Nachholen, bevor der
		-- Plot fertig ist): um den Plot-Mittelpunkt herum ablegen.
		local plot = MapService.getPlotCFrame(player)
		if not plot then
			return nil
		end
		origin = plot.Position
	end

	local angle    = math.random() * math.pi * 2
	local distance = math.random() * EggConfig.LAY_SCATTER_RADIUS

	local dx, dz = math.cos(angle) * distance, math.sin(angle) * distance
	local world = Vector3.new(origin.X + dx, origin.Y, origin.Z + dz)

	-- Seit der Baerchi am Becken wohnt (HONEY_POND_V2), koennte ein Ei im
	-- Honig landen. Dann auf die andere Seite des Baerchis spiegeln — dort
	-- ist es immer weiter vom Becken weg als der Baerchi selbst.
	local pond = MapService.getPondCenter(player)
	if pond then
		local keepOut = MapConfig.POND_RADIUS + MapConfig.POND_RIM_WIDTH + 1.5
		if Vector3.new(world.X - pond.X, 0, world.Z - pond.Z).Magnitude < keepOut then
			world = Vector3.new(origin.X - dx, origin.Y, origin.Z - dz)
		end
	end

	return MapService.worldToPlot(player, world)
end

--------------------------------------------------------------------------------
-- Legen
--------------------------------------------------------------------------------

-- Legt EIN Ei, wenn Platz ist. Gibt true zurueck wenn es geklappt hat.
--
-- Aendert die Daten, aber loest KEIN markDirty aus: beim Offline-Nachholen
-- entstehen mehrere Eier hintereinander, und ein Sync pro Ei waere sinnlose
-- Netzlast. Der Aufrufer synchronisiert einmal am Ende.
local function layOne(player: Player, data: Types.PlayerData, baerchi: Types.Baerchi, cap: number?): boolean
	local island = data.island

	-- cap: Offline-Nachholen legt nur bis EggConfig.OFFLINE_MAX_EGGS (Paket 6.1).
	-- INCUBATOR_BREED: Eier aus dem Inkubator haben ihre eigene Grenze.
	local lying = EggCalculator.countOwnLaid(island.laidEggs)
	if lying >= (cap or EggConfig.MAX_UNCOLLECTED_EGGS) then
		return false
	end

	local rolled = EggCalculator.rollEggType(baerchi)
	if not rolled then
		return false
	end

	-- v14: gesperrtes Ei -> naechster freier Vorgaenger im selben Pfad
	-- (EggTree.resolveLaid). Nichts geht verloren, nichts wird uebersprungen.
	local eggType = EggTree.resolveLaid(data.eggTree, rolled)

	-- v14: Void-Identitaet — mit layUpgradeChance steigt das Ei eine Stufe
	-- auf, falls die naechste Stufe schon frei ist.
	local def = BaerchiConfig.getById(baerchi.configId)
	if def and def.layUpgradeChance and def.layUpgradeChance > 0 and math.random() < def.layUpgradeChance then
		local up = EggTree.upgradeTarget(data.eggTree, eggType, def.path)
		if up then
			eggType = up
			-- Sichtbar machen: das Omen des Phantoms (volle Show nur beim
			-- Phantom selbst, sonst ein kurzes Echo).
			local figure = MapService.getBaerchiModel(player, baerchi.uid)
			if figure then
				Remotes.SkillFXPlay:FireAllClients({
					owner    = player.UserId,
					skillId  = "PhantomOmen",
					full     = baerchi.skillId == "PhantomOmen",
					attacker = figure,
					target   = nil,
				})
			end
		end
	end

	local position = pickDropPosition(player, baerchi.uid)
	if not position then
		return false
	end

	table.insert(island.laidEggs, {
		uid     = newEggUid(),
		eggType = eggType,
		laidAt  = os.time(),
		x       = position.X,
		y       = position.Y,
		z       = position.Z,
	})

	return true
end

-- Rechnet nach, wie viele Eier seit island.lastEggAt faellig geworden sind,
-- und legt sie. Gibt zurueck, wie viele es tatsaechlich wurden und ob die
-- Obergrenze dabei gebremst hat.
--
-- `offline` steuert nur die Rate (siehe EggCalculator) — die Rechnung selbst
-- ist fuer beide Faelle dieselbe.
local function catchUp(player: Player, data: Types.PlayerData, offline: boolean): (number, boolean)
	local island  = data.island
	local uid     = island.equippedUid
	local baerchi = if uid then island.baerchis[uid] else nil

	-- Kein ausgeruesteter Baerchi: es legt niemand. Die Zeitmarke wird
	-- trotzdem nachgezogen, sonst wuerde beim naechsten Ausruesten die ganze
	-- Zwischenzeit auf einmal gutgeschrieben — fuer einen Baerchi, der da noch
	-- gar nicht stand.
	if not baerchi then
		island.lastEggAt = os.time()
		return 0, false
	end

	local interval = EggCalculator.getLayIntervalSeconds(baerchi, offline)
	if not interval then
		island.lastEggAt = os.time()
		return 0, false
	end

	local now     = os.time()
	local elapsed = now - (island.lastEggAt or now)
	if elapsed <= 0 then
		return 0, false
	end

	local due = math.floor(elapsed / interval)
	if due <= 0 then
		return 0, false
	end

	local laid    = 0
	local blocked = false

	local cap = if offline then EggConfig.OFFLINE_MAX_EGGS else EggConfig.MAX_UNCOLLECTED_EGGS
	for _ = 1, due do
		if layOne(player, data, baerchi, cap) then
			laid += 1
		else
			blocked = true
			break
		end
	end

	-- Zeitmarke immer auf jetzt — auch wenn die Obergrenze gebremst hat.
	-- Genau das ist die Stelle, an der sich die Wartezeit NICHT ansammelt
	-- (siehe Kopf-Kommentar).
	island.lastEggAt = now

	return laid, blocked
end

--------------------------------------------------------------------------------
-- Einsammeln
--------------------------------------------------------------------------------

local function fail(player: Player, action: string, reason: Types.LocMsg?)
	Remotes.ActionFailed:FireClient(player, action, reason or Loc.msg("err.unknown"))
end

-- Nimmt EIN Ei aus der Liste und schreibt es dem Lager gut.
-- Gibt den Ei-Typ zurueck, oder nil wenn es das Ei nicht (mehr) gibt.
local function takeEgg(data: Types.PlayerData, eggUid: string): Types.EggType?
	local island = data.island

	for index, egg in island.laidEggs do
		if egg.uid == eggUid then
			table.remove(island.laidEggs, index)

			local stock = island.eggStock
			stock[egg.eggType] = (stock[egg.eggType] or 0) + 1

			return egg.eggType
		end
	end

	return nil
end

function EggLayService.collect(player: Player, eggUid: string)
	local data = PlayerService.getData(player)
	if not data then return end

	local eggType = takeEgg(data, eggUid)
	if not eggType then
		-- Kein Fehler des Spielers: zwei schnelle Klicks auf dasselbe Ei, oder
		-- ein Klick auf ein Ei, das der "alles einsammeln"-Knopf gerade
		-- weggeraeumt hat. Still ignorieren statt einen Toast zu werfen.
		return
	end

	local result: Types.EggCollectResult = {
		eggUid  = eggUid,
		eggType = eggType,
		inStock = data.island.eggStock[eggType] or 0,
	}

	Remotes.EggCollectedReceived:FireClient(player, result)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
end

function EggLayService.collectAll(player: Player)
	local data = PlayerService.getData(player)
	if not data then return end

	local eggs = data.island.laidEggs
	if #eggs == 0 then
		fail(player, "RequestCollectAllEggs", Loc.msg("err.egg_none_lying"))
		return
	end

	-- Ueber eine Kopie der uids laufen: takeEgg entfernt aus derselben Liste,
	-- ueber die wir sonst iterieren wuerden.
	local uids: { string } = {}
	for _, egg in eggs do
		table.insert(uids, egg.uid)
	end

	local last: Types.EggType? = nil
	local count = 0

	for _, uid in uids do
		local eggType = takeEgg(data, uid)
		if eggType then
			last  = eggType
			count += 1
		end
	end

	if count == 0 then
		return
	end

	-- Ein Ergebnis fuer den ganzen Schwung. `eggUid` bleibt leer: es war nicht
	-- EIN Ei, und ein erfundener Wert waere schlimmer als ein leerer.
	local result: Types.EggCollectResult = {
		eggUid  = "",
		eggType = last :: Types.EggType,
		inStock = count,
	}

	Remotes.EggCollectedReceived:FireClient(player, result)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	print("[EggLayService]", player.Name, "| alle Eier eingesammelt:", count)
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Legt sofort ein Ei, unabhaengig von der Zeitmarke. NUR fuer den Studio-Test
-- (DebugService): auf ein echtes Intervall zu warten macht das Ei-System sonst
-- praktisch unpruefbar.
function EggLayService.layNow(player: Player): boolean
	local data = PlayerService.getData(player)
	if not data then return false end

	local uid     = data.island.equippedUid
	local baerchi = if uid then data.island.baerchis[uid] else nil
	if not baerchi then return false end

	local ok = layOne(player, data, baerchi)
	if ok then
		PlayerService.markDirty(player)
	end
	return ok
end

--------------------------------------------------------------------------------
-- Takt
--------------------------------------------------------------------------------

local function tick()
	for _, player in Players:GetPlayers() do
		local data = PlayerService.getData(player)
		if not data then continue end

		local now = os.time()
		local dt  = now - (_lastTick[player] or now)
		_lastTick[player] = now

		-- v12: unterwegs (Event/PIT) -> Timer einfrieren.
		if not PetModeService.isHome(player) then
			if dt > 0 then
				data.island.lastEggAt = math.min(now, (data.island.lastEggAt or now) + dt)
			end
			_wasAway[player] = true
			continue
		end

		-- Gerade heimgekommen: einmal syncen, damit die Countdown-Anzeige
		-- (EggTimerController) die verschobene Zeitmarke bekommt.
		if _wasAway[player] then
			_wasAway[player] = nil
			PlayerService.markDirty(player)
		end

		-- Nur legen, wenn die Figur wirklich auf dem Plot steht.
		local uid = data.island.equippedUid
		if uid and not MapService.getBaerchiModel(player, uid) then
			continue
		end

		local laid = catchUp(player, data, false)
		if laid > 0 then
			-- markDirty zieht die sichtbaren Eier ueber PlotDisplayService nach.
			PlayerService.markDirty(player)
		end
	end
end

function EggLayService.init()
	-- Einsammeln per Beruehrung: MapService baut an jedem gelegten Ei einen
	-- Touched-Handler, kennt aber EggLayService nicht (Ringschluss-Gefahr,
	-- siehe MapService._eggCollectHandler). Deshalb haengt sich hier die
	-- eigentliche Sammel-Funktion ein — derselbe Weg fuehrt seit jeher zum
	-- Klick-Remote unten, nur der Ausloeser ist jetzt Beruehren statt Klicken.
	MapService.setEggCollectHandler(function(player: Player, eggUid: string)
		EggLayService.collect(player, eggUid)
	end)

	RateLimiter.connect(Remotes.RequestCollectEgg, "RequestCollectEgg", function(player, eggUid: any)
		if typeof(eggUid) ~= "string" then return end
		EggLayService.collect(player, eggUid)
	end)

	RateLimiter.connect(Remotes.RequestCollectAllEggs, "RequestCollectAllEggs", function(player)
		EggLayService.collectAll(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		_lastTick[player] = nil
		_wasAway[player]  = nil
	end)

	-- Offline-Nachholen beim Join.
	PlayerService.onDataLoaded(function(player, data)
		-- Gelegt wird vom AUSGERUESTETEN Baerchi. Ein alter Spielstand kann
		-- beim Laden noch keinen (gueltigen) haben; IslandService ruestet in
		-- seinem eigenen onDataLoaded zwar nach, aber die Reihenfolge der
		-- Callbacks ist nicht zugesichert. autoEquipIfNone ist idempotent,
		-- der zweite Aufruf tut nichts.
		IslandService.autoEquipIfNone(data)

		local secondsAway = os.time() - (data.lastSeenAt or os.time())
		local laid, blocked = catchUp(player, data, true)

		-- Paket 6.1: auch melden, wenn die Offline-Grenze alles gebremst hat
		-- (0 gelegt, Lager voll) — sonst wundert sich der Spieler, warum nichts kam.
		if laid > 0 or (blocked and secondsAway >= 60) then
			local report: Types.OfflineEggReport = {
				laid        = laid,
				skipped     = blocked,
				secondsAway = math.max(0, secondsAway),
			}
			Remotes.OfflineEggReportReceived:FireClient(player, report)

			print(
				"[EggLayService]", player.Name,
				"| offline gelegt:", laid,
				if blocked then "| Obergrenze erreicht" else ""
			)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)

			local ok, err = pcall(tick)
			if not ok then
				warn("[EggLayService] Tick fehlgeschlagen:", err)
			end
		end
	end)

	print(
		"[EggLayService] Initialisiert | Intervall:", CHECK_INTERVAL, "s |",
		"max", EggConfig.MAX_UNCOLLECTED_EGGS, "Eier gleichzeitig"
	)
end

return EggLayService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">EggMerchantService</string><ProtectedString name="Source"><![CDATA[--!strict
-- EggMerchantService.luau
-- ServerScriptService/Services/EggMerchantService.luau
--
-- Einzige Zustaendigkeit:
--   - Den versteckten Basis-Ei-Haendler in der Welt aufstellen und Kaeufe
--     dort entgegennehmen (inklusive Entfernungspruefung).
--
-- Seit v12 ist das die EINZIGE Stelle, an der man ein Ei kaufen kann. Kein
-- Menue-Eintrag, kein HUD-Hinweis, kein Marker — wer den Stand findet, kann
-- hier fuer Gummies ein Basis-Ei holen. Lage und Preis stehen in
-- EggConfig.MERCHANT.
--
-- Warum ein serverseitiger ProximityPrompt statt eines eigenen Remotes:
-- Triggered feuert direkt auf dem Server mit dem ausloesenden Spieler. Es
-- gibt also keinen Remote, den ein Skript von ueberall aufrufen koennte, und
-- die Entfernung wird hier trotzdem noch einmal selbst geprueft (Roblox'
-- eigene Pruefung ist nicht dokumentiert genug, um sich allein darauf zu
-- verlassen).

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local EggConfig = require(ReplicatedStorage.Config.EggConfig)
local MapConfig = require(ReplicatedStorage.Config.MapConfig)
local Remotes   = require(ReplicatedStorage.Network.Remotes)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)  -- HBB Paket 5
local Loc       = require(ReplicatedStorage.Localization.Loc)

local EggService = require(ServerScriptService.Services.EggService)

local EggMerchantService = {}

local MODEL_NAME = "EggMerchant"

-- Gegen Doppel-Ausloesen (zwei schnelle E-Druecke): ein Kauf pro Spieler und
-- so vielen Sekunden. Kein Balancing-Wert, nur Entprellung.
local BUY_COOLDOWN = 0.5
local _lastBuy: { [Player]: number } = {}

local WOOD      = Color3.fromRGB(150, 105, 62)
local WOOD_DARK = Color3.fromRGB(112, 76, 44)
local CLOTH_A   = Color3.fromRGB(235, 228, 205)
local CLOTH_B   = Color3.fromRGB(196, 92, 82)

local _counter: BasePart? = nil

local function newPart(name: string, size: Vector3, cframe: CFrame, color: Color3, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name       = name
	part.Size       = size
	part.CFrame     = cframe
	part.Color      = color
	part.Material   = Enum.Material.Wood
	part.Anchored   = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent     = parent
	return part
end

-- Wo der Stand steht: auf dem Ring um die Weltmitte, mit der Theke zur Mitte.
local function standCFrame(): CFrame
	local merchant = EggConfig.MERCHANT
	-- HBB Paket 5: sichtbarer Platz am Weg zum Event-Pit
	local place = if FeatureFlags.isOn("MAP_V2_MERCHANT") then EggConfig.MERCHANT_V2 else merchant
	local angle    = math.rad(place.angleDegrees)
	local position = Vector3.new(
		MapConfig.CENTER.X + place.radius * math.cos(angle),
		MapConfig.PLATFORM_TOP_Y,
		MapConfig.CENTER.Z + place.radius * math.sin(angle)
	)
	return CFrame.lookAt(position, Vector3.new(MapConfig.CENTER.X, position.Y, MapConfig.CENTER.Z))
end

-- Ein kleiner Marktstand: Theke, zwei Pfosten, gestreiftes Dach, ein Ei auf
-- der Theke. Bewusst klein und unscheinbar (gleiche Holzfarben wie Zaeune und
-- Stege), damit er zwischen den Blumen am Inselrand nicht auffaellt.
local function buildStand(): BasePart
	local existing = workspace:FindFirstChild(MODEL_NAME)
	if existing then existing:Destroy() end

	local model = Instance.new("Model")
	model.Name = MODEL_NAME

	local base = standCFrame()
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end

	local counter = newPart("Counter", Vector3.new(6, 2.6, 2.4), at(0, 1.3, 0), WOOD, model)
	newPart("CounterTop", Vector3.new(6.4, 0.3, 2.8), at(0, 2.75, 0), WOOD_DARK, model)

	newPart("PostL", Vector3.new(0.4, 6.2, 0.4), at(-2.9, 3.1, 1.0), WOOD_DARK, model)
	newPart("PostR", Vector3.new(0.4, 6.2, 0.4), at( 2.9, 3.1, 1.0), WOOD_DARK, model)

	-- Gestreiftes Dach aus vier Bahnen, leicht nach vorn geneigt
	for index = 0, 3 do
		local stripe = newPart(
			"Awning" .. index,
			Vector3.new(1.6, 0.2, 3.4),
			at(-2.4 + index * 1.6, 6.1, 0.2) * CFrame.Angles(math.rad(-12), 0, 0),
			if index % 2 == 0 then CLOTH_A else CLOTH_B,
			model
		)
		stripe.Material = Enum.Material.Fabric
	end

	-- Das Ei auf der Theke, in der Farbe des Basis-Eis
	local egg = newPart("Egg", Vector3.new(1.4, 1.9, 1.4), at(0, 3.85, -0.2), EggConfig.data[EggConfig.MERCHANT.eggType].color, model)
	egg.Shape    = Enum.PartType.Ball
	egg.Material = Enum.Material.SmoothPlastic
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale    = Vector3.new(1, 1, 1)
	mesh.Parent   = egg
	egg.CanCollide = false

	-- HBB Paket 5: Ei-Schild ueber dem Stand (Billboard mit Bild, kein Text),
	-- damit man den Haendler von weitem erkennt. Keine Teile, kein Licht.
	if FeatureFlags.isOn("MAP_V2_MERCHANT") then
		local sign = EggConfig.MERCHANT_V2
		local board = Instance.new("BillboardGui")
		board.Name = "EggSign"
		board.Size = UDim2.new(sign.signSize, 0, sign.signSize, 0)
		board.StudsOffset = Vector3.new(0, sign.signHeight - 1.3, 0)
		board.LightInfluence = 0
		board.MaxDistance = 400
		board.Adornee = counter
		board.Parent = counter
		local image = Instance.new("ImageLabel")
		image.BackgroundTransparency = 1
		image.Size = UDim2.fromScale(1, 1)
		image.Image = sign.signImage
		image.ScaleType = Enum.ScaleType.Fit
		image.Parent = board
	end

	model.PrimaryPart = counter
	model.Parent = workspace

	return counter
end

local function onTriggered(player: Player)
	local counter = _counter
	if not counter then return end

	local now = os.clock()
	if now - (_lastBuy[player] or 0) < BUY_COOLDOWN then
		return
	end
	_lastBuy[player] = now

	-- Eigene Entfernungspruefung: nur wer wirklich am Stand steht, kauft.
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then return end

	if (root.Position - counter.Position).Magnitude > EggConfig.MERCHANT.maxBuyDistance then
		Remotes.ActionFailed:FireClient(player, "BuyBasicEgg", Loc.msg("err.merchant_far"))
		return
	end

	if EggService.buyFromMerchant(player) then
		-- Sammel-Update 2.3 ("Animation groesser, wenn man Ei kauft"): das
		-- gekaufte Ei wird sofort geoeffnet — der Client spielt dafuer die
		-- grosse Schluepf-Animation (HatchResultReceived ohne offene Anfrage
		-- startet sie direkt, siehe HatchAnimation.deliver). Klappt das
		-- Oeffnen nicht, liegt das Ei im Lager und es gibt den alten Toast.
		if EggService.openEgg(player, EggConfig.MERCHANT.eggType) then
			return
		end
		-- Kurze Bestaetigung ueber den bestehenden Ei-Eingang (Toast "+1 Basis-Ei")
		Remotes.EggCollectedReceived:FireClient(player, {
			eggUid  = "merchant",
			eggType = EggConfig.MERCHANT.eggType,
			inStock = -1,   -- -1 = Anzeige ohne Lagerzahl
		})
	end
end

function EggMerchantService.init()
	local counter = buildStand()
	_counter = counter

	local merchant = EggConfig.MERCHANT
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = "BuyPrompt"
	-- Sammel-Update 2.4: der Prompt ist fuer alle gleich (Server-Objekt) —
	-- deshalb sprachneutral: Ei + Preis.
	prompt.ActionText            = string.format("🥚 +1  (%d G)", merchant.priceGummies)
	prompt.ObjectText            = "🥚"
	prompt.MaxActivationDistance = merchant.promptDistance
	prompt.RequiresLineOfSight   = false
	prompt.HoldDuration          = 0
	prompt.Parent                = counter

	prompt.Triggered:Connect(onTriggered)

	Players.PlayerRemoving:Connect(function(player)
		_lastBuy[player] = nil
	end)

	print("[EggMerchantService] Initialisiert | Stand bei", counter.Position)
end

return EggMerchantService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">EggService</string><ProtectedString name="Source"><![CDATA[--!strict
-- EggService.luau
-- ServerScriptService/Services/EggService.luau
--
-- Einzige Zustaendigkeit:
--   - Ein Ei aus dem Lager oeffnen: Gacha-Roll, Mutations-Wurf, neuer Baerchi
--   - Den Kauf eines Basis-Eis beim versteckten Haendler abrechnen
--   - v17: Eier als Belohnung ins Lager legen (grantEggs, z.B. UFO-Abwurf),
--     damit Event-Code nie selbst in island.eggStock schreibt
--
-- Seit v12 (Ei-Baum-Konzept, Block A) gibt es KEINE Brutzeit mehr: ein Klick
-- auf "Oeffnen" nimmt ein Ei aus island.eggStock und liefert sofort das
-- Ergebnis. Es gibt auch keinen Kauf ueber das Menue mehr. Eier kommen aus
-- Legen, Events, Rebirth-Meilensteinen und — als einzige Kaufmoeglichkeit —
-- vom Basis-Ei-Haendler (EggMerchantService ruft buyFromMerchant auf).
--
-- Das Oeffnen ist bewusst EIN Schritt auf dem Server: Bestand pruefen,
-- abziehen, wuerfeln, eintragen. Der Client spielt waehrenddessen schon die
-- Ei-Animation ab (HatchAnimation) und bekommt das Ergebnis per
-- HatchResultReceived. Entscheiden tut ausschliesslich dieser Service.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types          = require(ReplicatedStorage.Network.Types)
local Remotes        = require(ReplicatedStorage.Network.Remotes)
local EggConfig      = require(ReplicatedStorage.Config.EggConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)
local IncubatorRules = require(ReplicatedStorage.Modules.IncubatorRules)   -- Sammel-Update 8
local BaerchiConfig  = require(ReplicatedStorage.Config.BaerchiConfig)
local GachaRoller    = require(ReplicatedStorage.Modules.GachaRoller)
local BaerchiFactory = require(ReplicatedStorage.Modules.BaerchiFactory)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local IslandService  = require(ServerScriptService.Services.IslandService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)
local FunnelService = require(ServerScriptService.Services.FunnelService)  -- HBB: Messpunkte
local Loc           = require(ReplicatedStorage.Localization.Loc)

local EggService = {}

local function fail(player: Player, action: string, reason: Types.LocMsg | string)
	Remotes.ActionFailed:FireClient(player, action, reason)
end

--------------------------------------------------------------------------------
-- Ei oeffnen
--------------------------------------------------------------------------------

-- Oeffnet ein Ei des Typs aus dem Lager. Gibt das Ergebnis zurueck (fuer den
-- DebugService) oder nil, wenn es nicht ging — der Spieler bekommt dann
-- ein ActionFailed.
--
-- Sammel-Update 05.10. (Paket 8): Eier ab Gold-Stufe gehen nur noch ueber den
-- Inkubator auf (IncubatorRules.requiresIncubator). Der Inkubator selbst ruft
-- diese Funktion beim Abholen mit `fromIncubator = true` — das Schluepfen
-- (Gacha, Mutation, Index, Quests, Auto-Ausruesten) bleibt so an EINER Stelle.
function EggService.openEgg(player: Player, eggType: Types.EggType, fromIncubator: boolean?): Types.HatchResult?
	local data = PlayerService.getData(player)
	if not data then return nil end

	if not EggConfig.data[eggType] then
		fail(player, "RequestHatchEgg", Loc.msg("err.egg_unknown_type"))
		return nil
	end

	if not fromIncubator and FeatureFlags.isOn("INCUBATOR") and not FeatureFlags.isOn("INCUBATOR_BREED")
		and IncubatorRules.requiresIncubator(eggType, IncubatorRules.isUnlocked(data)) then
		fail(player, "RequestHatchEgg", Loc.msg("err.egg_needs_incubator", { egg = Loc.msg("egg." .. eggType .. ".name") }))
		return nil
	end

	local stock = data.island.eggStock[eggType] or 0
	if stock <= 0 then
		fail(player, "RequestHatchEgg", Loc.msg("err.egg_none_in_stock", { egg = Loc.msg("egg." .. eggType .. ".name") }))
		return nil
	end

	-- Gacha-Roll
	local weightedTable = EggConfig.getNormalizedTable(eggType)
	local entries: { GachaRoller.WeightedEntry } = {}
	for _, weighted in weightedTable do
		table.insert(entries, { configId = weighted.configId, weight = weighted.weight })
	end

	local wonConfigId = GachaRoller.roll(entries)

	-- ============================================================
	-- DER MUTATIONS-WURF
	-- ============================================================
	-- Die EINZIGE Stelle im Spiel, an der ein Baerchi mit einer Mutation
	-- entstehen kann (Fusion vererbt nur, Events werten nur auf). Bewusst hier
	-- und nicht in BaerchiFactory: dort wuerde jeder Aufruf wuerfeln — auch der
	-- Debug-Service und die Fusion. Unabhaengig vom Gacha-Roll darueber.
	local mutation = BaerchiConfig.rollMutation()

	-- Erst pruefen, ob der Baerchi erzeugbar ist, und ERST DANN das Ei
	-- abziehen — sonst waere es bei einem Config-Tippfehler ersatzlos weg.
	local newBaerchi = BaerchiFactory.create(wonConfigId, { mutation = mutation })
	if not newBaerchi then
		fail(player, "RequestHatchEgg", Loc.msg("err.egg_internal"))
		return nil
	end

	-- "Neu" = diese Art ist noch nicht auf der Insel
	local isNew = true
	for _, existing in data.island.baerchis do
		if existing.configId == wonConfigId then
			isNew = false
			break
		end
	end

	data.island.eggStock[eggType] = stock - 1
	data.island.baerchis[newBaerchi.uid] = newBaerchi
	-- v13: Zaehler fuer die Quests (siehe QuestProgress)
	data.stats.totalHatched += 1
	-- v14: Zaehler fuer den Ei-Baum. Zaehlt auch bei einem noch gesperrten
	-- Ei (Sprung-Ei aus einem Event) — der Fortschritt geht nicht verloren.
	-- Ob dadurch ein Knoten frei wird, prueft EggTreeService bei der
	-- naechsten Datenaenderung (markDirty unten loest sie aus).
	data.eggTree.hatched[eggType] = (data.eggTree.hatched[eggType] or 0) + 1

	-- Erster Baerchi ueberhaupt: dann ruestet er sich automatisch aus, sonst
	-- bliebe der Plot leer.
	IslandService.autoEquipIfNone(data)

	local result: Types.HatchResult = {
		eggType = eggType,
		baerchi = newBaerchi,
		isNew   = isNew,
	}

	Remotes.HatchResultReceived:FireClient(player, result)
	FunnelService.step(player, "F03_FirstEggOpened")
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	print("[EggService]", player.Name, "oeffnet", eggType, "->", wonConfigId, "(", newBaerchi.rarity, ")",
		isNew and "| NEU" or "",
		mutation and ("| MUTATION: " .. mutation) or "")

	return result
end

--------------------------------------------------------------------------------
-- Haendler-Kauf (einzige Kaufmoeglichkeit)
--------------------------------------------------------------------------------

-- Bucht den Kauf eines Basis-Eis ab und legt es ins Lager. Die
-- Entfernungspruefung macht der Aufrufer (EggMerchantService), weil nur er
-- weiss, wo der Haendler steht.
function EggService.buyFromMerchant(player: Player): boolean
	local data = PlayerService.getData(player)
	if not data then return false end

	local merchant = EggConfig.MERCHANT
	local ok, reason = EconomyService.spendGummies(player, merchant.priceGummies)
	if not ok then
		fail(player, "BuyBasicEgg", reason)
		return false
	end

	data.island.eggStock[merchant.eggType] = (data.island.eggStock[merchant.eggType] or 0) + 1
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	print("[EggService]", player.Name, "kauft", merchant.eggType, "beim Haendler fuer", merchant.priceGummies)
	return true
end

--------------------------------------------------------------------------------
-- v17: Eier als Belohnung ins Lager
--------------------------------------------------------------------------------

-- Legt `amount` Eier dieser Sorte ins Lager (gesperrte Baum-Eier und
-- Sonder-Eier inklusive: oeffnen geht immer, siehe openEgg). Gibt false, wenn
-- die Daten fehlen oder die Sorte unbekannt ist.
function EggService.grantEggs(player: Player, eggType: Types.EggType, amount: number): boolean
	local data = PlayerService.getData(player)
	if not data then return false end
	if not EggConfig.data[eggType] then
		warn("[EggService] grantEggs: unbekannte Sorte", eggType)
		return false
	end
	local n = math.max(0, math.floor(amount))
	if n <= 0 then return true end

	data.island.eggStock[eggType] = (data.island.eggStock[eggType] or 0) + n
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return true
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function EggService.init()
	RateLimiter.connect(Remotes.RequestHatchEgg, "RequestHatchEgg", function(player, eggType: any)
		-- Typ-Validierung (Client-Input immer misstrauen)
		if typeof(eggType) ~= "string" then return end
		if not EggConfig.data[eggType :: Types.EggType] then
			fail(player, "RequestHatchEgg", Loc.msg("err.egg_unknown_type"))
			return
		end

		EggService.openEgg(player, eggType :: Types.EggType)
	end)

	print("[EggService] Initialisiert")
end

return EggService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">EventHandlers</string><ProtectedString name="Source"><![CDATA[--!strict
-- EventHandlers.luau
-- ServerScriptService/Services/EventHandlers.luau
--
-- Einzige Zustaendigkeit:
--   - Den Ablauf der fuenf Events in der Event-Area spielen:
--     Ufo, HotEgg, MutationsSturm, Koenigshuegel, Schatzgraeber
--
-- Kein eigener Eintrag im GameManager: EventParticipationService ruft den
-- passenden Handler beim Event-Start auf. Das sechste Event (Wespenkoenigin)
-- steht wegen seiner Groesse in Util/WaspQueenEvent; gemeinsame Typen und
-- Werkzeuge in Util/EventKit.
--
-- Bewegte Dinge (UFO, Kisten, Koenigin) sind reine Funktionen der Serverzeit
-- (Modules/EventMotion): der Server schreibt nur die Startzeit als Attribut,
-- der Client (EventFXController) bewegt die Optik. Waben-Themen und
-- fliegende Waben laufen ueber CombService (setTheme, launchCombs).
--
-- Jeder Handler hat die Signatur   handler(api, def) -> session
-- und die Session hat   session.stop() -> results
-- wobei results = { [Player] = { egg = EventBonus?, mutationRoll = boolean? } }
-- die Belohnungen sind, die EventParticipationService am Event-ENDE auszahlt.
-- (Das UFO zahlt seine Belohnung schon beim Absetzen aus, dort ist results leer.)
--
-- `api` stellt EventParticipationService bereit (siehe dort, buildApi): die
-- Handler fassen weder Spielerdaten noch ActivityLock direkt an, sie laufen
-- nur mit Figuren ueber api.walkTo und lesen api.participants().
--
-- Zahlen, die das Spiel veraendern (Dauern, Abstaende, Abklingzeiten,
-- Zufallsstreuung), stehen in EventConfig. Reine Optik (Farben, Groessen,
-- Animationszeiten) steht als benannte Konstante unten in dieser Datei.

local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local Workspace           = game:GetService("Workspace")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local EventConfig     = require(ReplicatedStorage.Config.EventConfig)
local FigureFX        = require(ServerScriptService.Util.FigureFX)
local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)
local EventKit        = require(ServerScriptService.Util.EventKit)
local JackpotRoll     = require(ServerScriptService.Util.JackpotRoll)
local WaspQueenEvent  = require(ServerScriptService.Util.WaspQueenEvent)
local CombService     = require(ServerScriptService.Services.CombService)
local EventMotion     = require(ReplicatedStorage.Modules.EventMotion)
local Loc             = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)

local EventHandlers = {}

--------------------------------------------------------------------------------
-- Typen (stehen in Util/EventKit, hier unter den gewohnten Namen)
--------------------------------------------------------------------------------

export type Part    = EventKit.Part
export type Api     = EventKit.Api
export type Reward  = EventKit.Reward
export type Session = EventKit.Session
export type Handler = EventKit.Handler

--------------------------------------------------------------------------------
-- Optik (keine Balance — aendert nur, wie es aussieht)
--------------------------------------------------------------------------------

-- Duell: abwechselnde Ausfallschritte, am Ende blitzt der Verlierer rot
local DUEL_LUNGE_DISTANCE      = 2
local DUEL_LUNGE_SECONDS       = 0.3
local DUEL_LUNGE_GAP_SECONDS   = 0.35
local DUEL_END_MARGIN_SECONDS  = 0.4
local DUEL_LOSER_FLASH_COLOR   = Color3.fromRGB(255, 80, 80)
local DUEL_LOSER_FLASH_SECONDS = 0.6

-- Wer jemanden beruehren soll, laeuft auf diesen Anteil von TOUCH_DISTANCE
-- heran — sicher innerhalb, ohne in die andere Figur zu laufen.
local APPROACH_SHARE = 0.7
-- Wer auf den Beam/Huegel zulaeuft, steuert diesen Anteil des Radius an.
local INNER_TARGET_SHARE = 0.5

-- Wartendes Wippen (im Beam) und Jubel-Wippen (nach Weitergabe/Huegel)
local WAIT_BOB    = { height = 0.8, rate = 1.1 }
local CHEER_BOB   = { height = 1.6, rate = 2.2 }
local DIG_BOB     = { height = 0.35, rate = 3 }

-- UFO
local UFO_HOVER_HEIGHT        = EventMotion.UFO_HOVER_HEIGHT
local UFO_COLOR               = Color3.fromRGB(120, 255, 190)
local UFO_CLOSED_COLOR        = Color3.fromRGB(255, 90, 90)
local UFO_DISC_COLOR          = Color3.fromRGB(170, 180, 195)
local UFO_DISC_SIZE           = Vector3.new(3, 26, 26)
local UFO_DOME_SIZE           = Vector3.new(12, 10, 12)
local UFO_DOME_LIFT           = 3
local UFO_DOME_TRANSPARENCY   = 0.3
local UFO_BEAM_TRANSPARENCY   = 0.65
local UFO_RING_TRANSPARENCY   = 0.3
local UFO_RING_CLOSED_TRANSPARENCY = 0.85
local UFO_RING_THICKNESS      = 0.3
local UFO_RING_LIFT           = 0.25
local UFO_BURST_COUNT         = 24
-- Entfuehrung: hoch zum UFO, rueber zum Plot, schweben, absetzen
local UFO_PICKUP_BELOW_DISC   = 6
local UFO_LIFT_SECONDS        = 2.0
local UFO_LIFT_TURNS          = 2
local UFO_TRANSPORT_HEIGHT    = 40
local UFO_TRANSPORT_SECONDS   = 3.0
local UFO_TRANSPORT_TURNS     = 1
local UFO_HOVER_BOB_HEIGHT    = 1.2
local UFO_HOVER_BOB_RATE      = 2
local UFO_HOVER_SPIN_RATE     = 1.5
local UFO_HOVER_STEP_SECONDS  = 0.1
local UFO_DROP_HEIGHT         = 4
local UFO_DROP_SECONDS        = 1.5
-- Abgeworfene Kiste (die Kiste bewegt der Client, siehe EventFXController)
local CRATE_SIZE              = Vector3.new(3, 3, 3)
local CRATE_COLOR             = Color3.fromRGB(150, 105, 60)
local CRATE_GOLD_COLOR        = Color3.fromRGB(255, 205, 60)
local CANOPY_SIZE             = Vector3.new(8, 3, 8)
local CANOPY_LIFT             = 6
local CANOPY_COLOR            = Color3.fromRGB(120, 255, 190)
local MARK_THICKNESS          = 0.25
local MARK_TRANSPARENCY       = 0.35
local MARK_COLOR              = Color3.fromRGB(120, 255, 190)
local MARK_GOLD_COLOR         = Color3.fromRGB(255, 215, 70)
local PILLAR_HEIGHT           = 90
local PILLAR_WIDTH            = 2.2
local PILLAR_TRANSPARENCY     = 0.45

-- Hot Egg: Warnring vor dem Vulkan-Ausbruch
local ERUPTION_RING_RADIUS    = 7
local ERUPTION_RING_COLOR     = Color3.fromRGB(255, 90, 30)
local ERUPTION_RING_THICKNESS = 0.35
local ERUPTION_ORIGIN_LIFT    = 2

-- Hot Egg
local HOT_EGG_FIRE_SIZE       = 8
local HOT_EGG_FIRE_HEAT       = 6
local HOT_EGG_FIRE_COLOR      = Color3.fromRGB(255, 120, 40)
local HOT_EGG_FIRE_COLOR_2    = Color3.fromRGB(255, 60, 20)
-- Etwas Spielraum beim Uebergeben: die Figur bleibt APPROACH_SHARE vor dem
-- Ziel stehen, der Laufweg ist aber nicht zentimetergenau.
local HOT_EGG_PASS_SLACK      = 1.5

-- Mutations-Sturm
local STORM_COLOR             = Color3.fromRGB(255, 90, 235)
local STORM_BOLT_SIZE         = Vector3.new(0.8, 70, 0.8)
local STORM_BOLT_TRANSPARENCY = 0.1
local STORM_BOLT_SECONDS      = 0.3
local STORM_BURST_LIFT        = 2
local STORM_BURST_COUNT       = 24
local STORM_FLASH_SECONDS     = 0.5
local STORM_CLEANUP_SECONDS   = 1

-- Koenigshuegel
local HILL_COLOR              = Color3.fromRGB(255, 215, 70)
local HILL_TRANSPARENCY       = 0.45
local HILL_THICKNESS          = 0.4
local HILL_LIFT               = 0.3

-- Schatzgraeber
local MOUND_SIZE              = Vector3.new(4, 1.6, 4)
local MOUND_LIFT              = 0.6
local MOUND_COLOR             = Color3.fromRGB(120, 85, 50)
local BOMB_BLAST_RADIUS       = 6     -- nur Optik: BlastPressure ist 0
local BOMB_COLLAPSE_SECONDS   = 0.8
local FIND_COLOR              = Color3.fromRGB(255, 220, 90)
local FIND_BURST_LIFT         = 1
local FIND_BURST_COUNT        = 20
-- Wie oft waehrend des Grabens geprueft wird, ob abgebrochen wurde, und wie
-- oft neue Teilnehmer ihren Lauf bekommen.
local DIG_CHECK_SECONDS       = 0.25
local TREASURE_JOIN_CHECK_SECONDS = 1

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local flatDist  = EventKit.flatDist
local make      = EventKit.make
local fxPart    = EventKit.fxPart
local rootOf    = EventKit.rootOf
local setLabel  = EventKit.setLabel
local newFolder = EventKit.newFolder

-- Kurzer Kampf zweier Teilnehmer: serverseitiger Vergleich (ATK/HP-basiert,
-- siehe api.power) mit etwas Zufall. Dauert fix `seconds`. Gibt Gewinner und
-- Verlierer zurueck.
local function duel(api: Api, a: Part, b: Part, seconds: number): (Part, Part)
	local spread = EventConfig.DUEL.POWER_SPREAD
	local ra = api.power(a) * (1 - spread + math.random() * spread * 2)
	local rb = api.power(b) * (1 - spread + math.random() * spread * 2)

	local winner, loser = a, b
	if rb > ra then
		winner, loser = b, a
	end

	local startedAt = os.clock()
	task.spawn(function()
		while os.clock() - startedAt < seconds - DUEL_END_MARGIN_SECONDS and api.running() do
			-- Sammel-Update 1.1: eine entfuehrte Figur gehoert dem UFO, kein
			-- Ausfallschritt darf sie zurueckreissen.
			if a.abducting or b.abducting then
				break
			end
			if a.figure and b.figure and a.figure.Parent and b.figure.Parent then
				pcall(FigureFX.attackLunge, a.figure, b.figure:GetPivot().Position, DUEL_LUNGE_DISTANCE, DUEL_LUNGE_SECONDS)
				task.wait(DUEL_LUNGE_GAP_SECONDS)
				pcall(FigureFX.attackLunge, b.figure, a.figure:GetPivot().Position, DUEL_LUNGE_DISTANCE, DUEL_LUNGE_SECONDS)
				task.wait(DUEL_LUNGE_GAP_SECONDS)
			else
				break
			end
		end
	end)

	task.wait(seconds)

	if loser.figure and loser.figure.Parent then
		pcall(FigureFX.hitFlash, loser.figure, DUEL_LOSER_FLASH_COLOR, DUEL_LOSER_FLASH_SECONDS)
	end

	return winner, loser
end

local function moveFoot(figure: Model, from: Vector3, to: Vector3, seconds: number, spin: number?)
	local startedAt = os.clock()
	while true do
		local t = math.clamp((os.clock() - startedAt) / seconds, 0, 1)
		FigurePlacement.place(
			figure,
			from:Lerp(to, t),
			CFrame.Angles(0, (spin or 0) * t, 0)
		)
		if t >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
end

--------------------------------------------------------------------------------
-- UFO
--------------------------------------------------------------------------------

type UfoState = {
	progress   : number,
	moving     : boolean,
	fightUntil : number,
	coolUntil  : number,
	abducting  : boolean,
	inBeam     : boolean,
}

function EventHandlers.Ufo(api: Api, def: EventConfig.EventDef): Session
	local cfg    = EventConfig.UFO
	local REJOIN = FeatureFlags.isOn("UFO_REJOIN")
	local center = api.center
	local ringR  = api.radius * cfg.BEAM_RADIUS_FACTOR
	local hoverY = center.Y + UFO_HOVER_HEIGHT

	local running    = true
	local beamOpen   = true
	local idleTimer  = 0
	local fightPause = 0
	local states: { [Part]: UfoState } = {}
	local taken: { [Player]: boolean } = {}     -- in DIESEM Event schon entfuehrt
	local pairCool: { [string]: number } = {}   -- ["uidA|uidB"] = os.clock(), bis zu dem nicht erneut gekaempft wird

	local folder = newFolder("EventUfo")

	-- PATROUILLE: das UFO fliegt auf der Bahn aus EventMotion. Der Server
	-- rechnet nur Positionen aus (Beam, Abwurf), bewegt aber nichts: die
	-- Teile stehen am Startpunkt, der Client zieht das Model jedes Frame aus
	-- derselben Funktion nach (Attribute StartTime/Center am Ordner).
	local startTime = Workspace:GetServerTimeNow()
	folder:SetAttribute("StartTime", startTime)
	folder:SetAttribute("Center", center)

	local function ringCenterAt(serverTime: number): Vector3
		return EventMotion.ufoGround(center, startTime, serverTime)
	end

	local ufoModel = Instance.new("Model")
	ufoModel.Name = "Ufo"
	ufoModel.Parent = folder

	local ground0 = ringCenterAt(startTime)

	-- UFO-Optik: Scheibe, Kuppel, Beam, Ring am Boden (alles im Model, ein
	-- PivotTo pro Frame beim Client)
	local discPos = Vector3.new(ground0.X, hoverY, ground0.Z)
	fxPart({
		Name = "Disc", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Metal,
		Color = UFO_DISC_COLOR, Size = UFO_DISC_SIZE,
		CFrame = CFrame.new(discPos) * CFrame.Angles(0, 0, math.rad(90)),
	}, ufoModel)
	fxPart({
		Name = "Dome", Shape = Enum.PartType.Ball, Material = Enum.Material.Glass,
		Color = UFO_COLOR, Transparency = UFO_DOME_TRANSPARENCY, Size = UFO_DOME_SIZE,
		CFrame = CFrame.new(discPos + Vector3.new(0, UFO_DOME_LIFT, 0)),
	}, ufoModel)
	local beamHeight = hoverY - center.Y
	local beam = fxPart({
		Name = "Beam", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon,
		Color = UFO_COLOR, Transparency = UFO_BEAM_TRANSPARENCY,
		Size = Vector3.new(beamHeight, ringR * 2, ringR * 2),
		CFrame = CFrame.new(Vector3.new(ground0.X, center.Y + beamHeight / 2, ground0.Z)) * CFrame.Angles(0, 0, math.rad(90)),
	}, ufoModel)
	local ring = fxPart({
		Name = "Ring", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon,
		Color = UFO_COLOR, Transparency = UFO_RING_TRANSPARENCY,
		Size = Vector3.new(UFO_RING_THICKNESS, ringR * 2, ringR * 2),
		CFrame = CFrame.new(Vector3.new(ground0.X, center.Y + UFO_RING_LIFT, ground0.Z)) * CFrame.Angles(0, 0, math.rad(90)),
	}, ufoModel)
	-- Drehpunkt = Bodenpunkt unter dem UFO: der Client setzt das Model mit
	-- PivotTo(CFrame.new(EventMotion.ufoGround(...))) genau dorthin.
	ufoModel.WorldPivot = CFrame.new(ground0)

	local function setBeam(open: boolean)
		beamOpen = open
		beam.Transparency = if open then UFO_BEAM_TRANSPARENCY else 1
		ring.Transparency = if open then UFO_RING_TRANSPARENCY else UFO_RING_CLOSED_TRANSPARENCY
		ring.Color        = if open then UFO_COLOR else UFO_CLOSED_COLOR
	end

	local function stateOf(part: Part): UfoState
		local st = states[part]
		if not st then
			st = { progress = 0, moving = false, fightUntil = 0, coolUntil = 0, abducting = false, inBeam = false }
			states[part] = st
		end
		return st
	end

	local function abduct(part: Part, st: UfoState)
		st.abducting     = true
		part.abducting   = true
		part.abductedAt  = os.clock()
		-- UFO_REJOIN: nicht mehr sperren — wer abgesetzt wurde, darf wieder her,
		-- ist dann aber geschwaecht (api.weaken beim Absetzen).
		if not REJOIN then
			taken[part.player] = true
		end
		setLabel(part, "🛸!")

		-- Sammel-Update 1.1 ("Baerchi bleibt bei UFO stehen"): verliert der
		-- Service die Teilnahme mitten in der Entfuehrung (Rebirth, Neubau,
		-- Kampf nimmt das Schloss, Waechter hat abgebrochen), gehoert die Figur
		-- jemand anderem. Dann sofort aufhoeren, sie zu bewegen — sonst ziehen
		-- zwei Stellen an derselben Figur und sie bleibt irgendwo haengen.
		local function lost(): boolean
			return not api.stillHere(part)
		end

		task.spawn(function()
			local ok, err = pcall(function()
				local figure = part.figure
				local player = part.player
				api.toast(player, Loc.msg("msg.ufo.abducted"))

				local startFoot = api.footOf(figure)
				local here      = ringCenterAt(Workspace:GetServerTimeNow())
				local ufoFoot   = Vector3.new(here.X, hoverY - UFO_PICKUP_BELOW_DISC, here.Z)
				pcall(FigureFX.burstAt, startFoot, UFO_COLOR, folder, UFO_BURST_COUNT)

				-- 1) hochgezogen
				FigureFX.stopIdle(figure)
				moveFoot(figure, startFoot, ufoFoot, UFO_LIFT_SECONDS, math.pi * 2 * UFO_LIFT_TURNS)
				if lost() then return end

				-- 2) Transport zum Plot des Spielers
				local plotPos = api.plotPosition(player)
				local overPlot = (plotPos or ufoFoot) + Vector3.new(0, UFO_TRANSPORT_HEIGHT, 0)
				setLabel(part, "🛸 ...")
				moveFoot(figure, ufoFoot, overPlot, UFO_TRANSPORT_SECONDS, math.pi * 2 * UFO_TRANSPORT_TURNS)
				if lost() then return end

				-- 3) Wartezeit ueber dem Plot
				local waitStart = os.clock()
				while os.clock() - waitStart < cfg.ABDUCT_WAIT_SECONDS do
					if lost() or figure.Parent == nil then return end
					local left = math.ceil(cfg.ABDUCT_WAIT_SECONDS - (os.clock() - waitStart))
					-- Sprachneutral (Sammel-Update 2.4): Symbol + Zahl statt Text
					setLabel(part, string.format("🛸 %ds", left))
					local hovered = os.clock() - waitStart
					FigurePlacement.place(
						figure,
						overPlot + Vector3.new(0, math.sin(hovered * UFO_HOVER_BOB_RATE) * UFO_HOVER_BOB_HEIGHT, 0),
						CFrame.Angles(0, hovered * UFO_HOVER_SPIN_RATE, 0)
					)
					task.wait(UFO_HOVER_STEP_SECONDS)
				end

				-- 4) Absetzen auf dem Plot
				setLabel(part, nil)
				if lost() then return end
				local homeFoot = part.homeFoot
				moveFoot(figure, overPlot, homeFoot + Vector3.new(0, UFO_DROP_HEIGHT, 0), UFO_DROP_SECONDS, 0)
				api.finishHome(part)
				api.ufoReward(part)
				if REJOIN then
					api.weaken(part, cfg.DROP_WEAKEN_SECONDS)
				end
			end)

			if not ok then
				warn("[EventHandlers.Ufo] Entfuehrung fehlgeschlagen:", err)
				pcall(setLabel, part, nil)
				pcall(api.finishHome, part)
			elseif lost() then
				-- Abgebrochen: Label weg, Schloss und Figur hat schon der neue
				-- Halter (EventParticipationService.tick hat geraeumt).
				pcall(setLabel, part, nil)
			end
		end)
	end

	local function startFight(a: Part, b: Part, sa: UfoState, sb: UfoState, now: number)
		sa.fightUntil = now + cfg.FIGHT_SECONDS
		sb.fightUntil = now + cfg.FIGHT_SECONDS
		fightPause    = now + cfg.FIGHT_SECONDS
		a.cancelWalk, b.cancelWalk = true, true
		setLabel(a, "⚔")
		setLabel(b, "⚔")

		task.spawn(function()
			local ok, err = pcall(function()
				local winner, loser = duel(api, a, b, cfg.FIGHT_SECONDS)
				local sw, sl = stateOf(winner), stateOf(loser)

				-- Verlierer: aus dem Ring gedraengt, beginnt von vorne.
				sl.progress  = 0
				sl.coolUntil = os.clock() + cfg.LOSER_COOLDOWN_SECONDS
				api.toast(loser.player, Loc.msg("msg.ufo.fight_lost"))
				api.toast(winner.player, Loc.msg("msg.ufo.fight_won"))
				setLabel(winner, nil)
				setLabel(loser, nil)

				sl.moving = true
				task.spawn(function()
					api.walkTo(loser, loser.standFoot)
					sl.moving = false
				end)
				sw.fightUntil = 0
			end)
			if not ok then
				warn("[EventHandlers.Ufo] Kampf fehlgeschlagen:", err)
			end
		end)
	end

	local function closeBeam()
		for part, st in states do
			st.progress = 0
			setLabel(part, nil)
		end
		for _, part in api.participants() do
			api.toast(part.player, Loc.msg("msg.ufo.beam_reset"))
		end
		setBeam(false)
		task.delay(cfg.BEAM_REOPEN_SECONDS, function()
			if running then
				idleTimer = 0
				setBeam(true)
			end
		end)
	end

	for _, part in api.participants() do
		api.toast(part.player, Loc.msg("msg.ufo.start", { s = cfg.BEAM_REQUIRED_SECONDS }))
	end
	api.announce(Loc.msg("msg.ufo.patrol"), "info")

	local dt = cfg.TICK_SECONDS
	task.spawn(function()
		while running do
			task.wait(dt)
			local ok, err = pcall(function()
				local parts = api.participants()
				local now   = os.clock()
				local anyInBeam = false
				local inBeamList: { Part } = {}

				-- Der Ring wandert mit dem UFO: jetzt hier, gleich dort.
				local serverNow  = Workspace:GetServerTimeNow()
				local ringCenter = ringCenterAt(serverNow)
				local ringAhead  = ringCenterAt(serverNow + cfg.FOLLOW_LEAD_SECONDS)

				for _, part in parts do
					local st = stateOf(part)
					-- Sammel-Update 1.1: Wer in diesem UFO schon entfuehrt war und
					-- erneut hergeschickt wurde, wurde frueher hier nur
					-- uebersprungen und stand bis zum Event-Ende eingefroren im
					-- Pit. Jetzt geht er mit einem Hinweis wieder heim.
					if taken[part.player] and not st.abducting and not part.busy and not st.moving then
						st.moving = true
						api.toast(part.player, Loc.msg("msg.ufo.already_taken"))
						api.recall(part.player)
						continue
					end
					if st.abducting or taken[part.player] then
						continue
					end
					local foot = api.footOf(part.figure)
					st.inBeam = beamOpen and flatDist(foot, ringCenter) <= ringR
					if st.inBeam and now >= st.fightUntil then
						anyInBeam = true
						table.insert(inBeamList, part)
					end
				end

				-- Wer nicht im Beam steht, laeuft zum Beam: bevorzugt zu einem
				-- Baerchi, das schon drin steht (Regel 2), sonst zur eigenen Seite.
				for _, part in parts do
					local st = stateOf(part)
					if st.abducting or taken[part.player] then continue end
					if beamOpen and not st.inBeam and not st.moving and not part.busy
						and now >= st.fightUntil and now >= st.coolUntil then

						st.moving = true
						local target: Vector3
						local anchor = inBeamList[1]
						if anchor and anchor ~= part then
							local af   = api.footOf(anchor.figure)
							local from = api.footOf(part.figure)
							local dir  = Vector3.new(from.X - af.X, 0, from.Z - af.Z)
							if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
							target = af + dir.Unit * (cfg.TOUCH_DISTANCE * APPROACH_SHARE)
						else
							local dir = Vector3.new(part.standFoot.X - ringAhead.X, 0, part.standFoot.Z - ringAhead.Z)
							if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
							target = ringAhead + dir.Unit * (ringR * INNER_TARGET_SHARE)
						end

						task.spawn(function()
							api.walkTo(part, target)
							st.moving = false
							if running and api.stillHere(part) and not st.abducting then
								pcall(FigureFX.idleBob, part.figure, WAIT_BOB)
							end
						end)
					end
				end

				-- Wer im Ring steht, bleibt drin: rutscht der Ring weg, laeuft der
				-- Baerchi zur Ring-Mitte von gleich nach (Fortschritt laeuft weiter).
				for _, part in inBeamList do
					local st = stateOf(part)
					if not st.moving and not part.busy and now >= st.fightUntil
						and flatDist(api.footOf(part.figure), ringAhead) > ringR * cfg.FOLLOW_SHARE then
						st.moving = true
						task.spawn(function()
							api.walkTo(part, ringAhead)
							st.moving = false
							if running and api.stillHere(part) and not st.abducting then
								pcall(FigureFX.idleBob, part.figure, WAIT_BOB)
							end
						end)
					end
				end

				-- Beruehrung -> Kampf (mindestens einer im Beam)
				for i = 1, #parts do
					for j = i + 1, #parts do
						local a, b = parts[i], parts[j]
						local sa, sb = stateOf(a), stateOf(b)
						if sa.abducting or sb.abducting or taken[a.player] or taken[b.player] then continue end
						if now < sa.fightUntil or now < sb.fightUntil then continue end
						if not (sa.inBeam or sb.inBeam) then continue end
						local key = a.baerchiUid .. "|" .. b.baerchiUid
						if pairCool[key] and now < pairCool[key] then continue end
						if flatDist(api.footOf(a.figure), api.footOf(b.figure)) <= cfg.TOUCH_DISTANCE then
							pairCool[key] = now + cfg.FIGHT_SECONDS + cfg.PAIR_COOLDOWN_EXTRA_SECONDS
							startFight(a, b, sa, sb, now)
						end
					end
				end

				-- Beam-Fortschritt (pausiert waehrend eines Kampfes)
				if beamOpen and now >= fightPause then
					for _, part in inBeamList do
						local st = stateOf(part)
						st.progress += dt
						setLabel(part, string.format("%d / %ds", math.floor(st.progress), cfg.BEAM_REQUIRED_SECONDS))
						if st.progress >= cfg.BEAM_REQUIRED_SECONDS then
							abduct(part, st)
						end
					end
				end

				-- Beam-Timeout
				if beamOpen then
					if anyInBeam or now < fightPause then
						idleTimer = 0
					else
						idleTimer += dt
						if idleTimer >= cfg.BEAM_IDLE_TIMEOUT_SECONDS then
							closeBeam()
						end
					end
				end
			end)
			if not ok then
				warn("[EventHandlers.Ufo] Tick fehlgeschlagen:", err)
			end
		end
	end)

	----------------------------------------------------------------------------
	-- EI-ABWURF (alle DROP_INTERVAL_SECONDS, 1 % Jackpot mit Pity)
	----------------------------------------------------------------------------
	type Drop = { model: Model, landing: Vector3, landAt: number, jackpot: boolean, taken: boolean }
	local drops: { Drop } = {}
	local duration = EventConfig.getDuration(def)

	local function buildDrop(landing: Vector3, releaseAt: number, landAt: number, jackpot: boolean): Model
		local model = Instance.new("Model")
		model.Name = "UfoDrop"
		model:SetAttribute("ReleaseAt", releaseAt)
		model:SetAttribute("LandAt", landAt)
		model:SetAttribute("Jackpot", jackpot)

		local crateColor = if jackpot then CRATE_GOLD_COLOR else CRATE_COLOR
		fxPart({
			Name = "Crate", Material = if jackpot then Enum.Material.Neon else Enum.Material.WoodPlanks,
			Color = crateColor, Size = CRATE_SIZE,
			CFrame = CFrame.new(landing + Vector3.new(0, CRATE_SIZE.Y / 2, 0)),
		}, model)
		fxPart({
			Name = "Canopy", Shape = Enum.PartType.Ball, Material = Enum.Material.SmoothPlastic,
			Color = if jackpot then CRATE_GOLD_COLOR else CANOPY_COLOR, Size = CANOPY_SIZE,
			CFrame = CFrame.new(landing + Vector3.new(0, CRATE_SIZE.Y + CANOPY_LIFT, 0)),
		}, model)
		model.WorldPivot = CFrame.new(landing)

		-- Landekreis (Telegraph) und beim Jackpot die Lichtsaeule: liegen fest
		-- am Boden, gehoeren deshalb NICHT zum fallenden Model.
		fxPart({
			Name = "Mark", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon,
			Color = if jackpot then MARK_GOLD_COLOR else MARK_COLOR, Transparency = MARK_TRANSPARENCY,
			Size = Vector3.new(MARK_THICKNESS, cfg.DROP_PICKUP_RADIUS * 2, cfg.DROP_PICKUP_RADIUS * 2),
			CFrame = CFrame.new(landing + Vector3.new(0, UFO_RING_LIFT, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		}, model)
		if jackpot then
			fxPart({
				Name = "Pillar", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon,
				Color = CRATE_GOLD_COLOR, Transparency = PILLAR_TRANSPARENCY,
				Size = Vector3.new(PILLAR_HEIGHT, PILLAR_WIDTH, PILLAR_WIDTH),
				CFrame = CFrame.new(landing + Vector3.new(0, PILLAR_HEIGHT / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			}, model)
		end
		model.Parent = folder
		return model
	end

	-- Plant die Abwuerfe: DROP_FIRST_SECONDS, dann alle DROP_INTERVAL_SECONDS,
	-- solange die Landung noch im Event liegt. Ein Thread fuer alle Abwuerfe.
	task.spawn(function()
		local landRel = cfg.DROP_FIRST_SECONDS
		while running and landRel < duration do
			local landAt    = startTime + landRel
			local releaseAt = landAt - cfg.DROP_TELEGRAPH_SECONDS
			local waitFor   = releaseAt - Workspace:GetServerTimeNow()
			if waitFor > 0 then task.wait(waitFor) end
			if not running then break end

			local ok, err = pcall(function()
				-- Landepunkt = Bodenpunkt unter dem UFO im Moment der Landung.
				local landing = ringCenterAt(landAt)
				local jackpot = JackpotRoll.roll(JackpotRoll.ufo, cfg.JACKPOT_CHANCE, cfg.JACKPOT_PITY_DROPS, math.random())
				local model = buildDrop(landing, releaseAt, landAt, jackpot)
				table.insert(drops, { model = model, landing = landing, landAt = landAt, jackpot = jackpot, taken = false })
				if jackpot then
					api.announce(Loc.msg("msg.ufo.jackpot_drop"), "big")
				end
			end)
			if not ok then
				warn("[EventHandlers.Ufo] Abwurf fehlgeschlagen:", err)
			end
			landRel += cfg.DROP_INTERVAL_SECONDS
		end
	end)

	-- Aufheben: Spieler-CHARAKTER am Landepunkt, der Naechste gewinnt. Der
	-- Server prueft im Takt (wie bei den Waben), der Client meldet nichts.
	task.spawn(function()
		while running do
			task.wait(cfg.DROP_CHECK_SECONDS)
			local ok, err = pcall(function()
				local serverNow = Workspace:GetServerTimeNow()
				for _, drop in drops do
					if drop.taken or serverNow < drop.landAt then continue end

					local winner: Player? = nil
					local best = math.huge
					for _, player in Players:GetPlayers() do
						local character = player.Character
						local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
						if root and root:IsA("BasePart") then
							local d = flatDist(root.Position, drop.landing)
							if d <= cfg.DROP_PICKUP_RADIUS and math.abs(root.Position.Y - drop.landing.Y) <= cfg.DROP_PICKUP_MAX_HEIGHT and d < best then
								winner, best = player, d
							end
						end
					end

					if winner then
						local eggType = if drop.jackpot then cfg.JACKPOT_EGG else cfg.DROP_EGG
						if api.grantEgg(winner, eggType, 1) then
							drop.taken = true
							drop.model:Destroy()
							api.notify(winner, Loc.msg("msg.ufo.drop_picked", { egg = Loc.msg("egg." .. eggType .. ".name") }), "good")
							if drop.jackpot then
								api.announce(Loc.msg("msg.ufo.jackpot_picked", { player = winner.DisplayName }), "big")
							end
						end
					end
				end
			end)
			if not ok then
				warn("[EventHandlers.Ufo] Aufheben fehlgeschlagen:", err)
			end
		end
	end)

	return {
		stop = function()
			running = false
			for part in states do
				if not part.abducting then
					part.cancelWalk = true
				end
				pcall(setLabel, part, nil)
			end
			folder:Destroy()
			return {}
		end,
	}
end

--------------------------------------------------------------------------------
-- Hot Egg
--------------------------------------------------------------------------------

function EventHandlers.HotEgg(api: Api, def: EventConfig.EventDef): Session
	local cfg = EventConfig.HOT_EGG

	local running       = true
	local holder: Part? = nil
	local lastHolder: Part? = nil
	local cooldownUntil = 0
	local chasing       = false
	local fire: Instance? = nil

	-- LAVA-WABEN: das Wabenthema gilt fuer die ganze Event-Dauer (CombService
	-- kennt Skin, Wert, Slots und Tempo). Hier steht nur der Aufruf.
	CombService.setTheme(cfg.COMB_THEME)
	api.announce(Loc.msg("msg.hotegg.lava"), "info")

	-- VULKAN-AUSBRUCH: Warnring in der Mitte, dann fliegen Lava-Waben in
	-- alle Richtungen (Landepunkte legt CombService fest, den Flug zeichnet
	-- der Client aus der Serverzeit).
	local volcano = newFolder("EventVolcano")
	task.spawn(function()
		while running do
			task.wait(math.max(0, cfg.ERUPTION_INTERVAL_SECONDS - cfg.ERUPTION_WARN_SECONDS))
			if not running then break end
			local ok, err = pcall(function()
				local ring = fxPart({
					Name = "EruptionWarning", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon,
					Color = ERUPTION_RING_COLOR, Transparency = 0.2,
					Size = Vector3.new(ERUPTION_RING_THICKNESS, ERUPTION_RING_RADIUS * 2, ERUPTION_RING_RADIUS * 2),
					CFrame = CFrame.new(api.center + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				}, volcano)
				task.wait(cfg.ERUPTION_WARN_SECONDS)
				ring:Destroy()
				if running then
					CombService.launchCombs(
						math.random(cfg.ERUPTION_MIN, cfg.ERUPTION_MAX),
						api.center + Vector3.new(0, ERUPTION_ORIGIN_LIFT, 0)
					)
				end
			end)
			if not ok then
				warn("[EventHandlers.HotEgg] Ausbruch fehlgeschlagen:", err)
			end
		end
	end)

	local function setHolder(part: Part?)
		if fire then
			fire:Destroy()
			fire = nil
		end
		if holder then
			setLabel(holder, nil)
		end
		holder = part
		if part and part.figure then
			local root = rootOf(part.figure)
			if root then
				fire = make("Fire", {
					Size = HOT_EGG_FIRE_SIZE, Heat = HOT_EGG_FIRE_HEAT,
					Color = HOT_EGG_FIRE_COLOR, SecondaryColor = HOT_EGG_FIRE_COLOR_2,
				}, root)
			end
			setLabel(part, "🔥🥚")
			api.toast(part.player, Loc.msg("msg.hotegg.holder"))
		end
	end

	task.spawn(function()
		while running do
			task.wait(cfg.CHECK_INTERVAL_SECONDS)
			local ok, err = pcall(function()
				local parts = api.participants()

				local current = holder
				if current and not api.stillHere(current) then
					setHolder(nil)
					current = nil
				end
				if not current and #parts > 0 then
					current = parts[math.random(1, #parts)]
					setHolder(current)
				end

				if not current or chasing or current.busy or #parts < 2 then
					return
				end
				if os.clock() < cooldownUntil then
					return
				end

				local chaser: Part = current
				local hf = api.footOf(chaser.figure)
				local best: Part? = nil
				local bestDist = math.huge
				for _, other in parts do
					if other ~= chaser and other ~= lastHolder then
						local d = flatDist(hf, api.footOf(other.figure))
						if d < bestDist then
							best, bestDist = other, d
						end
					end
				end
				local target: Part = best or (if parts[1] ~= chaser then parts[1] else parts[2])

				chasing = true
				task.spawn(function()
					local ef = api.footOf(target.figure)
					local dir = Vector3.new(hf.X - ef.X, 0, hf.Z - ef.Z)
					if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
					api.walkTo(chaser, ef + dir.Unit * (cfg.TOUCH_DISTANCE * APPROACH_SHARE))

					if running and holder == chaser and api.stillHere(target) and api.stillHere(chaser)
						and flatDist(api.footOf(chaser.figure), api.footOf(target.figure)) <= cfg.TOUCH_DISTANCE + HOT_EGG_PASS_SLACK then
						lastHolder    = chaser
						cooldownUntil = os.clock() + cfg.PASS_COOLDOWN_SECONDS
						setHolder(target)
						task.spawn(function()
							api.walkTo(chaser, chaser.standFoot)
							if running and api.stillHere(chaser) then
								pcall(FigureFX.idleBob, chaser.figure, CHEER_BOB)
							end
						end)
					end
					chasing = false
				end)
			end)
			if not ok then
				warn("[EventHandlers.HotEgg] Tick fehlgeschlagen:", err)
			end
		end
	end)

	return {
		stop = function()
			running = false
			local results: { [Player]: Reward } = {}
			for _, part in api.participants() do
				part.cancelWalk = true
			end
			local last = holder
			if last and api.stillHere(last) then
				results[last.player] = { egg = def.bonus }
			end
			if last then
				setLabel(last, nil)
			end
			local flame = fire
			if flame then
				flame:Destroy()
			end
			volcano:Destroy()
			-- Waben im Pit werden wieder normal; getragene behalten ihren Wert.
			CombService.clearTheme()
			return results
		end,
	}
end

--------------------------------------------------------------------------------
-- Mutations-Sturm
--------------------------------------------------------------------------------

function EventHandlers.MutationsSturm(api: Api, _def: EventConfig.EventDef): Session
	local cfg     = EventConfig.STORM
	local running = true
	local folder  = newFolder("EventStorm")

	local function strike(part: Part)
		local pos = api.footOf(part.figure)
		local bolt = fxPart({
			Name = "Bolt", Material = Enum.Material.Neon, Color = STORM_COLOR,
			Transparency = STORM_BOLT_TRANSPARENCY, Size = STORM_BOLT_SIZE,
			CFrame = CFrame.new(pos + Vector3.new(0, STORM_BOLT_SIZE.Y / 2, 0)),
		}, folder)
		pcall(FigureFX.burstAt, pos + Vector3.new(0, STORM_BURST_LIFT, 0), STORM_COLOR, folder, STORM_BURST_COUNT)
		pcall(FigureFX.hitFlash, part.figure, STORM_COLOR, STORM_FLASH_SECONDS)
		task.delay(STORM_BOLT_SECONDS, function()
			bolt:Destroy()
		end)
	end

	task.spawn(function()
		while running do
			task.wait(cfg.STRIKE_INTERVAL_SECONDS)
			if not running then break end
			local ok, err = pcall(function()
				local parts = api.participants()
				if #parts > 0 then
					strike(parts[math.random(1, #parts)])
				end
			end)
			if not ok then
				warn("[EventHandlers.MutationsSturm] Blitz fehlgeschlagen:", err)
			end
		end
	end)

	return {
		stop = function()
			running = false
			local results: { [Player]: Reward } = {}
			for _, part in api.participants() do
				results[part.player] = { mutationRoll = true }
				pcall(strike, part)
			end
			task.delay(STORM_CLEANUP_SECONDS, function()
				folder:Destroy()
			end)
			return results
		end,
	}
end

--------------------------------------------------------------------------------
-- Koenigshuegel
--------------------------------------------------------------------------------

function EventHandlers.Koenigshuegel(api: Api, def: EventConfig.EventDef): Session
	local cfg     = EventConfig.KING
	local running = true
	local center  = api.center
	local hillR   = api.radius * cfg.HILL_RADIUS_FACTOR
	local folder  = newFolder("EventKing")

	fxPart({
		Name = "Hill", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon,
		Color = HILL_COLOR, Transparency = HILL_TRANSPARENCY,
		Size = Vector3.new(HILL_THICKNESS, hillR * 2, hillR * 2),
		CFrame = CFrame.new(Vector3.new(center.X, center.Y + HILL_LIFT, center.Z)) * CFrame.Angles(0, 0, math.rad(90)),
	}, folder)

	local seconds: { [Player]: number } = {}   -- Sekunden oben
	local coolUntil: { [Part]: number } = {}   -- os.clock()
	local fighting  = false

	local function onHill(part: Part): boolean
		return flatDist(api.footOf(part.figure), center) <= hillR
	end

	task.spawn(function()
		while running do
			task.wait(cfg.TICK_SECONDS)
			local ok, err = pcall(function()
				local parts = api.participants()
				local king: Part? = nil
				local kingTime = -1
				for _, part in parts do
					local up = onHill(part)
					if up then
						seconds[part.player] = (seconds[part.player] or 0) + cfg.TICK_SECONDS
					end
					local t = seconds[part.player] or 0
					if up and t > kingTime then
						king, kingTime = part, t
					end
					setLabel(part, string.format("⛰ %ds", math.floor(seconds[part.player] or 0)))
				end

				for _, part in parts do
					if part.busy or fighting or os.clock() < (coolUntil[part] or 0) then
						continue
					end

					if not onHill(part) then
						local dir = Vector3.new(part.standFoot.X - center.X, 0, part.standFoot.Z - center.Z)
						if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
						local target = center + dir.Unit * (hillR * INNER_TARGET_SHARE)
						if king and king ~= part then
							local kf = api.footOf(king.figure)
							local from = api.footOf(part.figure)
							local d = Vector3.new(from.X - kf.X, 0, from.Z - kf.Z)
							if d.Magnitude < 0.1 then d = Vector3.new(1, 0, 0) end
							target = kf + d.Unit * cfg.CHALLENGE_DISTANCE
						end
						task.spawn(function()
							api.walkTo(part, target)
							if running and api.stillHere(part) then
								pcall(FigureFX.idleBob, part.figure, CHEER_BOB)
							end
						end)
					elseif king and king ~= part and not king.busy then
						-- Herausforderer: zum Koenig laufen und kaempfen
						local kf = api.footOf(king.figure)
						local pf = api.footOf(part.figure)
						if flatDist(kf, pf) > cfg.TOUCH_DISTANCE then
							local d = Vector3.new(pf.X - kf.X, 0, pf.Z - kf.Z)
							if d.Magnitude < 0.1 then d = Vector3.new(1, 0, 0) end
							task.spawn(function()
								api.walkTo(part, kf + d.Unit * cfg.CHALLENGE_DISTANCE)
							end)
						end
					end
				end

				-- Beruehrung zweier Teilnehmer auf dem Huegel -> Kampf
				if not fighting then
					for i = 1, #parts do
						for j = i + 1, #parts do
							local a, b = parts[i], parts[j]
							if onHill(a) and onHill(b)
								and flatDist(api.footOf(a.figure), api.footOf(b.figure)) <= cfg.TOUCH_DISTANCE
								and os.clock() >= (coolUntil[a] or 0) and os.clock() >= (coolUntil[b] or 0) then

								fighting = true
								a.cancelWalk, b.cancelWalk = true, true
								task.spawn(function()
									local ok2, err2 = pcall(function()
										local winner, loser = duel(api, a, b, cfg.DUEL_SECONDS)
										coolUntil[loser] = os.clock() + cfg.LOSER_COOLDOWN_SECONDS
										api.toast(loser.player, Loc.msg("msg.hill.pushed"))
										api.toast(winner.player, Loc.msg("msg.hill.holding"))
										api.walkTo(loser, loser.standFoot)
									end)
									if not ok2 then
										warn("[EventHandlers.Koenigshuegel] Kampf fehlgeschlagen:", err2)
									end
									fighting = false
								end)
								return
							end
						end
					end
				end
			end)
			if not ok then
				warn("[EventHandlers.Koenigshuegel] Tick fehlgeschlagen:", err)
			end
		end
	end)

	return {
		stop = function()
			running = false
			local results: { [Player]: Reward } = {}
			local bestPlayer: Player? = nil
			local bestTime = 0
			for _, part in api.participants() do
				part.cancelWalk = true
				setLabel(part, nil)
				local t = seconds[part.player] or 0
				if t > bestTime then
					bestPlayer, bestTime = part.player, t
				end
			end
			if bestPlayer then
				results[bestPlayer] = { egg = def.bonus }
			end
			folder:Destroy()
			return results
		end,
	}
end

--------------------------------------------------------------------------------
-- Schatzgraeber
--------------------------------------------------------------------------------

function EventHandlers.Schatzgraeber(api: Api, _def: EventConfig.EventDef): Session
	local cfg     = EventConfig.TREASURE
	local running = true
	local center  = api.center
	local folder  = newFolder("EventTreasure")

	local started: { [Part]: boolean } = {}
	local finds: { [Player]: number } = {}    -- Anzahl Funde
	local bombed: { [Player]: boolean } = {}

	local function randomSite(): Vector3
		local angle = math.random() * math.pi * 2
		local dist  = api.radius * (cfg.SITE_MIN_RADIUS_FACTOR
			+ math.random() * (cfg.SITE_MAX_RADIUS_FACTOR - cfg.SITE_MIN_RADIUS_FACTOR))
		return Vector3.new(center.X + math.cos(angle) * dist, center.Y, center.Z + math.sin(angle) * dist)
	end

	local function run(part: Part)
		local level   = api.level(part)
		local sites   = math.min(cfg.MAX_SITES, cfg.BASE_SITES + math.floor(level / cfg.LEVEL_PER_EXTRA_SITE))
		local digTime = math.max(cfg.MIN_DIG_SECONDS, cfg.BASE_DIG_SECONDS - level * cfg.DIG_SECONDS_PER_LEVEL)
		local player  = part.player

		finds[player] = finds[player] or 0
		api.toast(player, Loc.msg("msg.dig.start", { n = sites }))

		for i = 1, sites do
			if not running or not api.stillHere(part) then return end

			local pos = randomSite()
			local mound = fxPart({
				Name = "Mound", Shape = Enum.PartType.Ball, Material = Enum.Material.Ground,
				Color = MOUND_COLOR, Size = MOUND_SIZE,
				CFrame = CFrame.new(pos + Vector3.new(0, MOUND_LIFT, 0)),
			}, folder)
			local isBomb = math.random() < cfg.BOMB_SHARE

			if not api.walkTo(part, pos) then
				mound:Destroy()
				return
			end

			-- graben
			setLabel(part, string.format("⛏ %d/%d", i, sites))
			pcall(FigureFX.idleBob, part.figure, DIG_BOB)
			local t0 = os.clock()
			while os.clock() - t0 < digTime do
				if not running or not api.stillHere(part) then
					mound:Destroy()
					setLabel(part, nil)
					return
				end
				task.wait(DIG_CHECK_SECONDS)
			end
			pcall(FigureFX.stopIdle, part.figure)
			mound:Destroy()

			if isBomb then
				local boom = Instance.new("Explosion")
				boom.Position = pos
				boom.BlastRadius = BOMB_BLAST_RADIUS
				boom.BlastPressure = 0
				boom.DestroyJointRadiusPercent = 0
				boom.Parent = folder
				pcall(FigureFX.defeatCollapse, part.figure, BOMB_COLLAPSE_SECONDS)
				finds[player] = 0
				bombed[player] = true
				setLabel(part, nil)
				api.toast(player, Loc.msg("msg.dig.bomb"))
				api.recall(player)
				return
			end

			finds[player] += 1
			pcall(FigureFX.burstAt, pos + Vector3.new(0, FIND_BURST_LIFT, 0), FIND_COLOR, folder, FIND_BURST_COUNT)
			api.toast(player, Loc.msg("msg.dig.find", { n = finds[player] }))
		end

		setLabel(part, nil)
		api.toast(player, Loc.msg("msg.dig.done", { n = finds[player] }))
		if api.walkTo(part, part.standFoot) and running and api.stillHere(part) then
			pcall(FigureFX.idleBob, part.figure, DIG_BOB)
		end
	end

	task.spawn(function()
		while running do
			local ok, err = pcall(function()
				for _, part in api.participants() do
					if not started[part] and not bombed[part.player] then
						started[part] = true
						task.spawn(function()
							local ok2, err2 = pcall(run, part)
							if not ok2 then
								warn("[EventHandlers.Schatzgraeber] Lauf fehlgeschlagen:", err2)
							end
						end)
					end
				end
			end)
			if not ok then
				warn("[EventHandlers.Schatzgraeber] Tick fehlgeschlagen:", err)
			end
			task.wait(TREASURE_JOIN_CHECK_SECONDS)
		end
	end)

	return {
		stop = function()
			running = false
			local results: { [Player]: Reward } = {}
			for _, part in api.participants() do
				part.cancelWalk = true
				setLabel(part, nil)
				local n = finds[part.player] or 0
				if n > 0 and not bombed[part.player] then
					local reward: any = nil
					for _, tier in cfg.REWARDS do
						if n >= tier.minFinds then
							reward = tier
						end
					end
					if reward then
						results[part.player] = { egg = {
							kind = "eggs", eggType = reward.eggType, eggPick = reward.eggPick,
							amount = reward.amount, blueprintChance = reward.blueprintChance,
						} }
					end
				end
			end
			folder:Destroy()
			return results
		end,
	}
end

--------------------------------------------------------------------------------
-- Wespenkoenigin (Boss-Event, Ablauf in Util/WaspQueenEvent)
--------------------------------------------------------------------------------

function EventHandlers.WaspQueen(api: Api, def: EventConfig.EventDef): Session
	return WaspQueenEvent.run(api, def)
end

return EventHandlers
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">EventParticipationService</string><ProtectedString name="Source"><![CDATA[--!strict
-- EventParticipationService.luau
-- ServerScriptService/Services/EventParticipationService.luau
--
-- Einzige Zustaendigkeit:
--   - Den ausgeruesteten Baerchi eines Spielers auf Knopfdruck in die
--     Event-Area in der Weltmitte schicken und wieder zurueckholen
--   - Beim ENDE eines Events an jeden dort tatsaechlich anwesenden Baerchi
--     die Belohnung dieses Events auszahlen
--
-- WAS es gibt, steht ausschliesslich in EventConfig (Stat-Fokus und Bonus je
-- Event) — hier steht nur, WIE es ausgezahlt wird. Waehrungen laufen dabei
-- ueber EconomyService, nie ueber einen direkten Feldzugriff: die Projektregel
-- "nur EconomyService aendert Waehrungen" gilt auch fuer Event-Belohnungen.
--
-- ============================================================
-- WARUM DAS EIN EIGENER SERVICE IST
-- ============================================================
-- EventService faehrt den Zyklus und weiss nichts von Spielern. MapService
-- baut Geometrie. BaerchiAutopilotService laesst die Figur zum Honig-Teich
-- laufen. Die Teilnahme braucht alle drei, gehoert aber in keinen davon: sie
-- ist die erste Stelle im Projekt, an der eine Spieleraktion, ein Weltzustand
-- (laeuft ein Event?) und Spielerdaten (Stat-Level) zusammenkommen.
--
-- ============================================================
-- WARUM DIE ANWESENHEIT SERVERSEITIG FESTGESTELLT WIRD
-- ============================================================
-- Der Client schickt ausschliesslich "ich moechte hin" bzw. "hol ihn zurueck".
-- WO die Figur danach steht, bestimmt allein dieser Service (er bewegt sie
-- selbst) und er prueft es beim Verteilen der Belohnung noch einmal an der
-- tatsaechlichen Weltposition nach. Ein Client, der "ich bin am Event"
-- behauptet, bekommt davon nichts — sonst waere der Stat-Fortschritt in fuenf
-- Minuten nachgebaut.
--
-- ============================================================
-- BEWUSST EINFACH GEHALTEN (Vorgabe des Projektinhabers)
-- ============================================================
-- Genau EIN Baerchi pro Spieler (der ausgeruestete — nur er hat ueberhaupt
-- eine Figur in der Welt), kein Auto-Send, kein Offline-Fortschritt, keine
-- mehrfache Belegung. Das groessere AFK-Grind-System um Events herum ist laut
-- Projektinhaber ausdruecklich ein spaeterer, eigener Auftrag. Wer das hier
-- erweitert: die Stelle dafuer ist _present (eine Liste statt eines Eintrags)
-- und awardStatLevel/awardBonus (die schon jetzt pro Baerchi arbeiten).

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local PromotionConfig  = require(ReplicatedStorage.Config.PromotionConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggTree          = require(ReplicatedStorage.Modules.EggTree)

local FigureWalker    = require(ServerScriptService.Util.FigureWalker)
local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)
local FigureFX        = require(ServerScriptService.Util.FigureFX)
local ActivityLock    = require(ServerScriptService.Util.ActivityLock)
local RateLimiter     = require(ServerScriptService.Util.RateLimiter)
local PlayerService   = require(ServerScriptService.Services.PlayerService)
local EconomyService  = require(ServerScriptService.Services.EconomyService)
local MapService      = require(ServerScriptService.Services.MapService)
local EventService    = require(ServerScriptService.Services.EventService)
local EventHandlers   = require(ServerScriptService.Services.EventHandlers)
local EggTreeService  = require(ServerScriptService.Services.EggTreeService)
local EggService      = require(ServerScriptService.Services.EggService)
local CombRecyclerService = require(ServerScriptService.Services.CombRecyclerService)
local FunnelService = require(ServerScriptService.Services.FunnelService)  -- HBB: Messpunkte
local Loc           = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)

local EventParticipationService = {}

--------------------------------------------------------------------------------
-- Konstanten
--------------------------------------------------------------------------------

-- Halter-Name fuer ActivityLock. Wird fuer die GESAMTE Zeit gehalten, in der
-- der Baerchi unterwegs zum Event ist oder dort steht — sonst wuerde ihn der
-- Autopilot mitten am Event zum Honig-Teich zurueckrufen.
--
-- Bewusste Folge: waehrend der Teilnahme isst der Baerchi nicht. Das ist der
-- Preis fuers Hinschicken und macht die Entscheidung erst zu einer.
local LOCK_HOLDER = "EventParticipation"

-- Sammel-Update 1.1: so lange darf eine UFO-Entfuehrung hoechstens dauern
-- (Hochziehen 2 s + Transport 3 s + Warten + Absetzen 1,5 s, grosszuegig
-- aufgerundet). Danach greift der Waechter in tick().
local ABDUCT_WATCHDOG_SECONDS = EventConfig.UFO.ABDUCT_WAIT_SECONDS + 30

-- Der Weg von einem Plot (Ring-Radius 212) in die Mitte ist lang. Mit der
-- normalen MapConfig.WALK_SPEED waere man ueber zehn Sekunden unterwegs —
-- deshalb hier doppeltes Tempo: sichtbar hinlaufen ja, Geduldsprobe nein.
local EVENT_WALK_SPEED = MapConfig.WALK_SPEED * 2

-- Wie weit vom Mittelpunkt entfernt ein Baerchi auf dem Podest steht, als
-- Anteil des Podest-Radius. Bewusst nicht 0: bei mehreren Spielern staenden
-- sonst alle Figuren ineinander. Jeder steht auf SEINER Seite (Richtung des
-- eigenen Plots, siehe standPosition) — dieselben acht Richtungen, in denen
-- auch die Zaunluecken sitzen.
local STAND_RADIUS_FACTOR = 0.55

-- Wie oft nachgesehen wird, ob eine Teilnahme noch gilt (Figur weg, Schloss
-- von einem Kampf uebernommen, Baerchi nicht mehr ausgeruestet). Muss nicht
-- schnell sein — es geht nur darum, dass ein ungueltiger Zustand nicht bis zum
-- Event-Ende liegen bleibt.
local CHECK_INTERVAL = 4

-- Wie sich der Baerchi waehrend eines Events bewegt. Die Zuordnung zum
-- Event-Typ steht in EventConfig.EventDef.action — hier nur, wie sich das in
-- Zahlen der Ruhe-Animation uebersetzt.
--
-- Bewusst ueber die vorhandene Idle-Bewegung statt ueber eigene Animationen:
-- die Baerchi-Meshes sind nicht gerigt (siehe FigureWalker, Kopf-Kommentar),
-- eine echte "faengt Bienen"-Animation gaebe es fuer dieses Modell gar nicht.
-- Der Spieler soll sehen, DASS sein Baerchi mitmacht — mehr ist fuer das
-- Basis-Spiel nicht gefordert.
local ACTION_MOTION: { [string]: { height: number, rate: number } } = {
	bounce = { height = 1.60, rate = 2.20 },   -- kraeftiges Huepfen
	lean   = { height = 0.35, rate = 3.00 },   -- schnelles, flaches Nicken
	spin   = { height = 0.80, rate = 1.10 },   -- ruhiges Wiegen
}

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

type Presence = {
	baerchiUid : string,
	homeFoot   : Vector3,   -- wohin zurueckgelaufen wird
	standFoot  : Vector3,   -- wo auf dem Podest gestanden wird
	arrivedAt  : number,    -- os.time(), nur fuers Log

	-- Von Event-Handlern genutzt (siehe buildApi):
	player     : Player?,
	figure     : Model?,
	busy       : boolean?,        -- Figur laeuft gerade (walkTo)
	cancelWalk : boolean?,        -- laufende Bewegung abbrechen
	abducting  : boolean?,        -- UFO hat die Figur gerade
}

-- Spieler, deren Baerchi gerade AM Event steht (fertig angekommen).
local _present: { [Player]: Presence } = {}

-- Spieler, deren Baerchi gerade laeuft (hin oder zurueck). Verhindert, dass
-- zwei Laufbewegungen gleichzeitig an derselben Figur ziehen.
local _walking: { [Player]: boolean } = {}

-- Laufender Event-Handler (siehe Services/EventHandlers) samt Token. Der Token
-- steigt bei jedem Start/Ende; api.running() vergleicht damit.
local _session: any = nil
local _sessionToken = 0

-- Spieler, die waehrend einer Handler-Bewegung "zurueck" gedrueckt haben.
local _recallPending: { [Player]: boolean } = {}

-- v12: Richtung des laufenden Wegs ("to" = zum Event, "back" = heim) fuer die
-- Pet-Leiste, und der Wunsch, einen Hinweg abzubrechen (Zurueckholen, bevor
-- der Baerchi angekommen ist).
local _walkDir: { [Player]: string } = {}
local _cancelTo: { [Player]: boolean } = {}

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function fail(player: Player, action: string, reason: Types.LocMsg | string)
	Remotes.ActionFailed:FireClient(player, action, reason)
end

local function notifyPresence(player: Player, atEvent: boolean, baerchiUid: string?)
	Remotes.EventPresenceChanged:FireClient(player, atEvent, baerchiUid)
end

local function footPosOf(model: Model): Vector3
	return FigurePlacement.footOf(model)   -- Sammel-Update 1.2
end

-- Der Standplatz dieses Spielers auf dem Podest: auf der Seite, aus der er
-- kommt. Ohne Plot-Information (sollte nicht vorkommen) faellt es auf die
-- Mitte zurueck — lieber uebereinander stehen als gar nicht ankommen.
local function standPosition(player: Player): Vector3
	local center = MapService.getEventPitPosition()
	local plot   = MapService.getPlotCFrame(player)

	if not plot then
		return center
	end

	local flat = Vector3.new(plot.Position.X - center.X, 0, plot.Position.Z - center.Z)
	if flat.Magnitude < 1e-3 then
		return center
	end

	return center + flat.Unit * (MapService.getEventPitRadius() * STAND_RADIUS_FACTOR)
end

-- Steht diese Figur tatsaechlich (noch) auf dem Podest?
-- Das ist die Pruefung, die den Fortschritt vor gefaelschten Client-Meldungen
-- schuetzt — siehe Kopf-Kommentar.
local function isOnEventFloor(model: Model): boolean
	local center = MapService.getEventPitPosition()
	local foot   = footPosOf(model)
	local flat   = Vector3.new(foot.X - center.X, 0, foot.Z - center.Z)

	return flat.Magnitude <= MapService.getEventPitRadius()
end

-- Die Bewegung, die der Baerchi waehrend des laufenden Events zeigt.
local function playEventMotion(model: Model)
	local active = EventService.getActive()
	local motion = if active then ACTION_MOTION[active.action] else nil

	if not motion then
		-- Kein Event aktiv: der Baerchi steht einfach dekorativ herum und
		-- atmet. Ausdrueckliche Vorgabe — das ist kein Fehlerzustand, und
		-- niemand muss ihn deshalb zurueckholen.
		FigureFX.idleBob(model, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
		return
	end

	FigureFX.idleBob(model, { height = motion.height, rate = motion.rate })
end

--------------------------------------------------------------------------------
-- Hin und zurueck
--------------------------------------------------------------------------------

-- Gibt true zurueck, wenn der Baerchi losgeht.
function EventParticipationService.sendToEvent(player: Player): boolean
	local data = PlayerService.getData(player)
	if not data then return false end

	if _present[player] or _walking[player] then
		fail(player, "RequestPetMode", Loc.msg("err.event_already_away"))
		return false
	end

	local uid = data.island.equippedUid
	if not uid or not data.island.baerchis[uid] then
		fail(player, "RequestPetMode", Loc.msg("err.event_no_equipped"))
		return false
	end

	local figure = MapService.getBaerchiModel(player, uid)
	if not figure then
		fail(player, "RequestPetMode", Loc.msg("err.event_not_on_plot"))
		return false
	end

	-- v12: ein vom Spieler ausgeloester Weg zum Event hat Vorrang vor dem
	-- Honig-Autopilot (wie der Kampf). Dem Autopilot wird das Schloss
	-- abgenommen — er bemerkt das selbst und bricht sauber ab. Haelt es
	-- jemand anderes (Kampf), wird weiter abgelehnt; die Reihenfolge regelt
	-- dann PetModeService.
	if ActivityLock.owner(player) == "Autopilot" then
		ActivityLock.forceAcquire(player, LOCK_HOLDER)
	elseif not ActivityLock.tryAcquire(player, LOCK_HOLDER) then
		fail(player, "RequestPetMode", Loc.msg("err.baerchi_busy"))
		return false
	end

	_walking[player]  = true
	_walkDir[player]  = "to"
	_cancelTo[player] = nil

	task.spawn(function()
		local ok, err = pcall(function()
			FigureFX.stopIdle(figure)

			local homeFoot  = footPosOf(figure)
			local standFoot = standPosition(player)

			local function cancelled(): boolean
				return ActivityLock.owner(player) ~= LOCK_HOLDER
					or player.Parent == nil
					or figure.Parent == nil
					or MapService.getBaerchiModel(player, uid) ~= figure
			end

			FigureWalker.walk(figure, homeFoot, standFoot, {
				speed       = EVENT_WALK_SPEED,
				isCancelled = function(): boolean
					return cancelled() or _cancelTo[player] == true
				end,
			})

			if cancelled() then
				return
			end

			-- v12: auf dem Hinweg zurueckgeholt — von hier aus umkehren.
			if _cancelTo[player] then
				_cancelTo[player] = nil
				_walkDir[player]  = "back"
				FigureWalker.walk(figure, footPosOf(figure), homeFoot, {
					speed       = EVENT_WALK_SPEED,
					isCancelled = cancelled,
				})
				if not cancelled() then
					FigurePlacement.place(figure, homeFoot, figure:GetPivot().Rotation)
					FigureFX.idleBob(figure, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end
				return
			end

			-- FigureWalker haelt die Y-Koordinate des STARTPUNKTES ueber die
			-- ganze Strecke (siehe dort). Das Event-Podest liegt hoeher als der
			-- Plot, also wird die Figur hier noch einmal sauber auf die
			-- Podest-Oberflaeche gesetzt — mit Blick zur Mitte.
			FigurePlacement.placeLookingAt(figure, standFoot, MapService.getEventPitPosition())

			_present[player] = {
				player     = player,
				baerchiUid = uid,
				homeFoot   = homeFoot,
				standFoot  = standFoot,
				arrivedAt  = os.time(),
			}

			playEventMotion(figure)
			notifyPresence(player, true, uid)

			print("[EventParticipationService]", player.Name, "| am Event:", uid)
		end)


		_walking[player]  = nil
		_walkDir[player]  = nil
		_cancelTo[player] = nil

		if not ok then
			warn("[EventParticipationService] Hinweg fehlgeschlagen:", err)
		end

		-- Nicht angekommen (abgebrochen oder Fehler): Schloss wieder freigeben,
		-- sonst bliebe der Spieler dauerhaft blockiert.
		if not _present[player] then
			ActivityLock.release(player, LOCK_HOLDER)
			notifyPresence(player, false, nil)
		end
	end)

	return true
end

-- Gibt true zurueck, wenn der Rueckweg angestossen wurde (oder schon laeuft).
function EventParticipationService.recall(player: Player): boolean
	local presence = _present[player]
	if not presence then
		-- v12: noch auf dem Hinweg — umkehren lassen.
		if _walking[player] and _walkDir[player] == "to" then
			_cancelTo[player] = true
			return true
		end
		return _walking[player] == true
	end

	if presence.abducting then
		fail(player, "RequestPetMode", Loc.msg("err.event_ufo"))
		return false
	end

	-- Ein Event-Handler bewegt die Figur gerade: Bewegung abbrechen, der
	-- Rueckweg startet direkt danach (siehe walkTo in buildApi).
	if presence.busy then
		_recallPending[player] = true
		presence.cancelWalk = true
		return true
	end

	if _walking[player] then
		return true   -- laeuft schon zurueck
	end

	local figure = MapService.getBaerchiModel(player, presence.baerchiUid)

	-- Figur ist weg (Equip-Wechsel, Rebirth, Insel neu gebaut): Zustand
	-- einfach aufraeumen statt einen Rueckweg zu erfinden.
	if not figure then
		_present[player] = nil
		ActivityLock.release(player, LOCK_HOLDER)
		notifyPresence(player, false, nil)
		return true
	end

	_walking[player]  = true
	_walkDir[player]  = "back"
	_present[player]  = nil
	notifyPresence(player, false, presence.baerchiUid)

	task.spawn(function()
		local ok, err = pcall(function()
			FigureFX.stopIdle(figure)

			local function cancelled(): boolean
				return ActivityLock.owner(player) ~= LOCK_HOLDER
					or player.Parent == nil
					or figure.Parent == nil
			end

			FigureWalker.walk(figure, footPosOf(figure), presence.homeFoot, {
				speed       = EVENT_WALK_SPEED,
				isCancelled = cancelled,
			})

			if cancelled() then
				return
			end

			FigurePlacement.place(figure, presence.homeFoot, figure:GetPivot().Rotation)
			FigureFX.idleBob(figure, {
				height = MapConfig.IDLE_BOB_HEIGHT,
				rate   = MapConfig.IDLE_BOB_RATE,
			})
		end)

		_walking[player] = nil
		_walkDir[player] = nil
		ActivityLock.release(player, LOCK_HOLDER)

		if not ok then
			warn("[EventParticipationService] Rueckweg fehlgeschlagen:", err)
		end
	end)

	return true
end

--------------------------------------------------------------------------------
-- Belohnung am Event-Ende
--------------------------------------------------------------------------------

-- Vergibt EINE Stat-Stufe an diesen Baerchi.
--
-- `focus` ist der Stat, auf den das laufende Event ausgelegt ist
-- (EventConfig.EventDef.statFocus) — bei den Trainings-Events also fest, bei
-- allen anderen nil.
--
-- Reihenfolge:
--   1. Der Fokus-Stat, sofern er noch unter der Rarity-Obergrenze liegt.
--   2. Sonst zufaellig unter allen Stats, die noch Luft haben. Wuerde man
--      blind aus allen fuenf ziehen, liefe eine Teilnahme umso oefter ins
--      Leere, je weiter der Baerchi schon ist — und ausgerechnet dann, wenn
--      der Spieler am meisten Zeit investiert hat.
--
-- Dass ein gedeckelter Fokus-Stat auf Zufall zurueckfaellt statt nichts zu tun,
-- ist Absicht: sonst waere ein Trainings-Event fuer genau die Spieler wertlos,
-- die es am laengsten besucht haben.
--
-- Gibt den gewaehlten Stat-Schluessel zurueck, oder nil wenn schon ALLES am
-- Anschlag ist.
local function awardStatLevel(baerchi: Types.Baerchi, focus: string?): string?
	local cap = PromotionConfig.getStatCap(baerchi.rarity)

	-- Einmal auf `any` umgebogen und ab dann unter eigenem Namen benutzt: die
	-- Stat-Schluessel kommen als String herein (PromotionConfig.GROWABLE_STATS
	-- bzw. EventConfig.statFocus), und Types.StatLevels hat feste Felder.
	-- Ausserdem darf so keine Zuweisung mehr mit "(" beginnen — eine Zeile, die
	-- mit einer Klammer anfaengt, liest Luau als Fortsetzung der vorherigen.
	local levels = baerchi.statLevels :: any

	if focus and (levels[focus] or 0) < cap then
		levels[focus] = (levels[focus] or 0) + 1
		return focus
	end

	local candidates: { string } = {}
	for _, key in PromotionConfig.GROWABLE_STATS do
		if (levels[key] or 0) < cap then
			table.insert(candidates, key)
		end
	end

	if #candidates == 0 then
		return nil
	end

	local key = candidates[math.random(1, #candidates)]
	levels[key] = (levels[key] or 0) + 1

	return key
end

-- Zahlt den Zusatz-Ertrag eines Events aus (EventConfig.EventDef.bonus).
--
-- Gibt zurueck:
--   1. eine Nachricht (LocMsg, "+1x Goldenes Ei"), oder nil wenn es
--      nichts zu melden gibt (Event ohne Bonus, oder Mutations-Wurf daneben),
--   2. die neue Mutation, falls dieses Event dem Baerchi eine verschafft hat.
--
-- Der Baerchi wird hier NUR beim Mutations-Bonus angefasst; alles andere geht
-- an den Spieler (Lager, Waehrung) und nicht an die Figur.
local function awardBonus(
	player: Player,
	data: Types.PlayerData,
	baerchi: Types.Baerchi,
	bonus: EventConfig.EventBonus?
): (Types.LocMsg?, Types.MutationId?)

	if not bonus then
		return nil, nil
	end

	local amount = math.max(0, math.floor(bonus.amount or 0))

	-- HONIG in JEDES Gebaeude, gedeckelt auf dessen Lager. Der Ueberlauf
	-- verfaellt bewusst, statt sich anzusammeln: die Lagergroesse ist die
	-- Bremse des ganzen Honig-Systems (siehe BuildingBehavior), und ein Event
	-- darf sie nicht aushebeln.
	if bonus.kind == "honey" then
		local added = 0

		for _, building in data.island.buildings do
			local capacity = BuildingBehavior.getCapacity(building.id, building.level)
			local before   = building.honey or 0
			local after    = math.min(capacity, before + amount)

			added += after - before
			building.honey = after
		end

		if added <= 0 then
			return Loc.msg("msg.event.honey_full"), nil
		end
		return Loc.msg("msg.event.honey", { n = added }), nil
	end

	-- EIER ins Lager, nicht in einen Brut-Slot: die Brut startet der Spieler
	-- selbst (die Slots koennen gerade belegt sein), und im Lager geht nichts
	-- verloren.
	if bonus.kind == "eggs" then
		if amount <= 0 then
			return nil, nil
		end

		-- v14 (WP10): Sorte nach dem Ei-Baum des Spielers waehlen.
		local eggType: Types.EggType = bonus.eggType or "BasicEgg"
		local isJump = false
		if bonus.eggPick == "jump" then
			local jump = EggTree.pickJumpEgg(data.eggTree)
			if jump then
				eggType = jump
				isJump = true
			else
				eggType = EggTree.highestUnlocked(data.eggTree)
			end
		elseif bonus.eggPick == "highest" then
			eggType = EggTree.highestUnlocked(data.eggTree)
		end
		data.island.eggStock[eggType] = (data.island.eggStock[eggType] or 0) + amount

		-- Sammel-Update 2.4: Text als LocMsg, der Client uebersetzt.
		local text = Loc.msg(if isJump then "msg.event.eggs_jump" else "msg.event.eggs", {
			n = amount, egg = Loc.msg("egg." .. eggType .. ".name"),
		})

		-- Blaupause (Koenigshuegel, Schatzgraeber mit 5 Funden)
		if (bonus.blueprintChance or 0) > 0 and math.random() < (bonus.blueprintChance :: number) then
			EggTreeService.grantBlueprint(player, data, 1)
			text = Loc.join(text, Loc.msg("msg.event.blueprint"))
		end

		-- Notfall-Ei (zusaetzlich, siehe EventConfig.EMERGENCY_BASIC_EGG_CHANCE)
		if math.random() < EventConfig.EMERGENCY_BASIC_EGG_CHANCE then
			data.island.eggStock.BasicEgg = (data.island.eggStock.BasicEgg or 0) + 1
			text = Loc.join(text, Loc.msg("msg.event.eggs", { n = 1, egg = Loc.msg("egg.BasicEgg.name") }))
		end

		return text, nil
	end

	-- WAEHRUNG immer ueber EconomyService: der rebirthMult gehoert dorthin und
	-- nirgendwo sonst hin (awardGummies wendet ihn an, awardGoldGummies
	-- bewusst nicht — GoldGummies sind die Premium-Waehrung).
	if bonus.kind == "gummies" then
		local final = EconomyService.awardGummies(player, amount)
		if final <= 0 then
			return nil, nil
		end
		return Loc.msg("msg.event.gummies", { n = final }), nil
	end

	if bonus.kind == "goldGummies" then
		local final = EconomyService.awardGoldGummies(player, amount)
		if final <= 0 then
			return nil, nil
		end
		return Loc.msg("msg.event.gold", { n = final }), nil
	end

	-- MUTATION: zwei getrennte Wuerfe. Erst die Event-Chance (kommt ueberhaupt
	-- etwas?), dann die Stufe (welche?). Der zweite Wurf benutzt bewusst
	-- rollMutationTier und NICHT rollMutation: sonst waere das Ergebnis auch
	-- nach einem Treffer noch in 98.5% der Faelle "keine Mutation".
	if bonus.kind == "mutation" then
		-- Die Chance sinkt mit der Rarity (EventConfig.MUTATION_RARITY_FACTOR).
		local chance = (bonus.chance or 0) * EventConfig.getMutationFactor(baerchi.rarity)
		if math.random() >= chance then
			return nil, nil   -- daneben — der Normalfall, kein Text noetig
		end

		local rolled = BaerchiConfig.rollMutationTier()
		local better = BaerchiConfig.pickHigherMutation(baerchi.mutation, rolled)

		-- Nur nach OBEN: wer schon Lava traegt, kann sie hier nie gegen Gold
		-- eintauschen. Der Fehlversuch wird trotzdem gemeldet — ein Treffer,
		-- der nichts veraendert, saehe sonst aus wie ein verschlucktes Ergebnis.
		if better == baerchi.mutation then
			return Loc.msg("msg.event.mutation_weaker", { m = Loc.msg("mutation." .. rolled .. ".name") }), nil
		end

		baerchi.mutation = better
		return Loc.msg("msg.event.mutation", { m = Loc.msg("mutation." .. (better :: string) .. ".name") }), better
	end

	return nil, nil
end

-- Wurf auf einen Rarity-Aufstieg um EINE Stufe (UFO-Absetzen, Boss-Top-Rang).
-- Gibt die neue Rarity zurueck oder nil.
local function rollRarityUp(baerchi: Types.Baerchi, chance: number): string?
	if chance <= 0 or math.random() >= chance then
		return nil
	end
	local nextRarity = BaerchiConfig.getNextRarity(baerchi.rarity)
	if nextRarity then
		baerchi.rarity = nextRarity
		return nextRarity
	end
	return nil
end

-- v17: Zusatz-Belohnungen eines Handler-Ergebnisses (Boss): Gummies,
-- Wabeneinheiten, zweites Ei, Rarity-Up-Wurf. Waehrungen ueber
-- EconomyService, Waben ueber CombRecyclerService, nie direkt.
-- Gibt (Meldungen als LocMsg, Meldung des zweiten Eis, neue Rarity) zurueck.
local function awardExtras(
	player: Player,
	data: Types.PlayerData,
	baerchi: Types.Baerchi,
	result: EventHandlers.Reward
): ({ Types.LocMsg }, Types.LocMsg?, string?)
	local notes: { Types.LocMsg } = {}
	local eggText: Types.LocMsg? = nil

	if result.extraEgg then
		eggText = awardBonus(player, data, baerchi, result.extraEgg)
	end

	-- HBB Paket 7: Mutations-Wurf der Boss-Stufe 4 (gleicher Weg wie der
	-- Mutations-Sturm). Der Text haengt an die Ei-Zeile an.
	if result.tierBonus then
		local tierText = awardBonus(player, data, baerchi, result.tierBonus)
		if tierText then
			eggText = if eggText then Loc.join(eggText, tierText) else tierText
		end
	end
	if (result.tierEggs or 0) > 0 then
		EggService.grantEggs(player, "BasicEgg", result.tierEggs :: number)
	end
	if result.bossTier and result.bossTier > 0 then
		table.insert(notes, Loc.msg("msg.boss.tier", { tier = result.bossTier }))
	end

	local gummies = result.gummies or 0
	if gummies > 0 then
		local final = EconomyService.awardGummies(player, gummies)
		if final > 0 then table.insert(notes, Loc.msg("msg.event.gummies", { n = final })) end
	end

	local units = result.combUnits or 0
	if units > 0 and CombRecyclerService.deposit(player, units) then
		table.insert(notes, Loc.msg("msg.event.combs", { n = units }))
	end

	local rarityUp: string? = nil
	if (result.rarityUpFactor or 0) > 0 then
		local oldRarity = baerchi.rarity
		local chance = (result.rarityUpFactor :: number) * EventConfig.getRarityUpChance(oldRarity)
		rarityUp = rollRarityUp(baerchi, chance)
		if rarityUp then
			table.insert(notes, Loc.msg("msg.event.rarity_up", {
				from = Loc.msg("rarity." .. oldRarity), to = Loc.msg("rarity." .. rarityUp),
			}))
		end
	end

	return notes, eggText, rarityUp
end

local function onEventEnded(finished: EventConfig.EventDef)
	-- Handler zuerst beenden: er liefert, wer was bekommt.
	local results: any = {}
	if _session then
		local ok, res = pcall(_session.stop)
		if ok and res then
			results = res
		else
			warn("[EventParticipationService] Handler-stop fehlgeschlagen:", res)
		end
		_session = nil
	end
	_sessionToken += 1

	for player, presence in _present do
		local data = PlayerService.getData(player)
		if not data then continue end

		local baerchi = data.island.baerchis[presence.baerchiUid]
		if not baerchi then continue end

		-- Zweite, unabhaengige Pruefung: steht die Figur wirklich noch dort?
		-- _present allein wuerde reichen, solange sich niemand dazwischen an der
		-- Figur zu schaffen macht — aber genau das kann passieren (Kampf, der
		-- das Schloss uebernimmt). Die Weltposition ist die Wahrheit.
		local figure = MapService.getBaerchiModel(player, presence.baerchiUid)
		if not figure or not isOnEventFloor(figure) then
			continue
		end

		-- maxHp kann durch den neuen Stat-Level steigen — und seit dem
		-- Mutations-Sturm sogar sprunghaft (eine Mutation multipliziert die
		-- Basiswerte, siehe BaerchiConfig.getMutationBonus). Die Differenz wird
		-- gutgeschrieben, damit ein Fortschritt den Baerchi nicht relativ
		-- SCHWAECHER macht (mehr maxHp bei gleichen currentHp waere ein
		-- leererer Balken als vorher).
		--
		-- Deshalb steht der Messpunkt VOR beiden Belohnungen und wird erst
		-- NACH beiden ausgewertet: Stat-Stufe und Mutation koennen in
		-- derselben Teilnahme zusammenkommen.
		local def      = BaerchiConfig.getById(baerchi.configId)
		local beforeHp = if def then CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp else 0

		-- Nur wer im Handler-Ergebnis steht, bekommt etwas (Stat-Stufen gibt es
		-- nur beim UFO, und dort sofort beim Absetzen, nicht hier).
		local result = results[player]
		if not result then
			continue
		end
		FunnelService.step(player, "F09_FirstEventCompleted")
		data.stats.totalEventsCompleted = (data.stats.totalEventsCompleted or 0) + 1
		-- Sammel-Update 05.10. (Paket 6.2): Boss-Siege zaehlen (besonderer
		-- Meilenstein, SpecialMilestoneService zahlt beim naechsten Datenstand).
		if result.bossVictory then
			local stats = data.stats :: any
			stats.bossVictories = (stats.bossVictories or 0) + 1
		end

		local bonus: EventConfig.EventBonus? = nil
		if result.egg then
			bonus = result.egg
		elseif result.mutationRoll then
			bonus = finished.bonus
		end

		local key: string? = nil
		local bonusText, mutation = awardBonus(player, data, baerchi, bonus)

		-- v17: Zusatz-Belohnungen (Boss) und die lokalisierte Zusammenfassung
		-- des Handlers.
		local notes, extraEggText, rarityUp = awardExtras(player, data, baerchi, result)
		if extraEggText then
			bonusText = if bonusText then Loc.join(bonusText, extraEggText) else extraEggText
		end
		if player.Parent ~= nil then
			if result.notice then
				Remotes.EventNotice:FireClient(player, result.notice, "good")
			end
			for _, note in notes do
				Remotes.EventNotice:FireClient(player, note, "good")
			end
		end
		if rarityUp then
			MapService.celebrateBaerchi(player, presence.baerchiUid, BaerchiConfig.getRarityColor(baerchi.rarity))
		end

		-- Weder eine Stufe (alles am Rarity-Cap) noch ein Bonus: dann gibt es
		-- auch nichts zu melden und nichts zu speichern.
		if not key and not bonusText and #notes == 0 then
			continue
		end

		if def then
			local afterHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
			baerchi.currentHp = math.clamp(
				(baerchi.currentHp or 0) + math.max(0, afterHp - beforeHp),
				0,
				afterHp
			)
		end

		local gain: Types.EventStatGain = {
			baerchiUid = presence.baerchiUid,
			eventId    = finished.id,
			statKey    = key,
			newLevel   = if key then (baerchi.statLevels :: any)[key] else 0,
			cap        = PromotionConfig.getStatCap(baerchi.rarity),
			bonusText  = bonusText,
			mutation   = mutation,
		}

		Remotes.EventStatGained:FireClient(player, gain)
		PlayerService.markDirty(player)
		PlayerService.saveNow(player)

		-- Eine frisch gewonnene Mutation aendert Fellfarbe UND Aura der Figur.
		-- Beides zieht der normale Weg nach: markDirty oben laesst
		-- PlotDisplayService die Figur neu bauen, sobald das ActivityLock frei
		-- ist (die Mutation steht dafuer in dessen Struktur-Signatur). "Sobald
		-- frei" heisst hier: wenn der Baerchi vom Event zurueck ist — waehrend
		-- er dort steht, haelt DIESER Service das Schloss.
		--
		-- Damit der Moment trotzdem sofort sichtbar ist, gibt es hier einen
		-- Partikel-Stoss in der Farbe der neuen Stufe. Die Figur umzubauen,
		-- waehrend sie auf dem Podest steht, waere die schlechtere Loesung: sie
		-- wuerde dabei an ihren Platz auf dem Plot zurueckspringen.
		if mutation then
			MapService.celebrateBaerchi(
				player,
				presence.baerchiUid,
				BaerchiConfig.getMutationColor(mutation)
			)
		end

		-- Nur Server-Log (kein Spieler sieht das)
		local statText = "no stat level"
		if key then
			statText = string.format("%s %d/%d", key, gain.newLevel, gain.cap)
		end

		print(
			"[EventParticipationService]", player.Name,
			"|", finished.id,
			"→", statText,
			if bonusText then "| " .. Loc.resolve(bonusText) else ""
		)
	end

	-- Nach dem Event weiter dekorativ herumstehen (siehe playEventMotion):
	-- der Baerchi wird NICHT automatisch zurueckgeschickt. Wer die naechste
	-- Runde mitnehmen will, laesst ihn einfach stehen.
	for player, presence in _present do
		local figure = MapService.getBaerchiModel(player, presence.baerchiUid)
		if figure then
			playEventMotion(figure)
		end
	end
end

--------------------------------------------------------------------------------
-- Schnittstelle fuer die Event-Handler (Services/EventHandlers)
--------------------------------------------------------------------------------

-- Meldung an den Spieler waehrend eines Events (Toast beim Client).
local function toast(player: Player, text: string | Types.LocMsg)
	if player.Parent == nil then
		return
	end
	local gain: any = {
		baerchiUid = "",
		eventId    = "",
		statKey    = nil,
		newLevel   = 0,
		cap        = 0,
		bonusText  = text,
		mutation   = nil,
		midEvent   = true,
	}
	Remotes.EventStatGained:FireClient(player, gain)
end

--------------------------------------------------------------------------------
-- UFO_REJOIN: befristete Schwaechung nach dem UFO-Absetzen
--------------------------------------------------------------------------------
-- Nur Laufzeit (nicht gespeichert): uid -> os.clock(), bis zu der das Level in
-- Event-Duellen mit EventConfig.UFO.DROP_WEAKEN_LEVEL_FACTOR zaehlt. Die Figur
-- traegt das Attribut "WeakUntil" (Serverzeit), damit der Client es zeigen kann.
local _weakUntil: { [string]: number } = {}

local function isWeakened(baerchiUid: string): boolean
	local untilAt = _weakUntil[baerchiUid]
	if not untilAt then return false end
	if os.clock() >= untilAt then
		_weakUntil[baerchiUid] = nil
		return false
	end
	return true
end

local function weakenedLevel(baerchiUid: string, level: number): number
	if not isWeakened(baerchiUid) then return level end
	return math.max(1, math.floor(level * EventConfig.UFO.DROP_WEAKEN_LEVEL_FACTOR))
end

local function weaken(player: Player, baerchiUid: string, seconds: number)
	if not FeatureFlags.isOn("UFO_REJOIN") or seconds <= 0 then return end
	_weakUntil[baerchiUid] = os.clock() + seconds
	local figure = MapService.getBaerchiModel(player, baerchiUid)
	if figure then
		figure:SetAttribute("WeakUntil", workspace:GetServerTimeNow() + seconds)
		-- Sichtbar fuer alle (sprachneutral): "💫 ½ Lv 42s" ueber dem Kopf.
		local root = figure.PrimaryPart or figure:FindFirstChildWhichIsA("BasePart")
		local old = figure:FindFirstChild("WeakLabel")
		if old then old:Destroy() end
		if root then
			local gui = Instance.new("BillboardGui")
			gui.Name        = "WeakLabel"
			gui.Size        = UDim2.fromOffset(120, 28)
			gui.StudsOffset = Vector3.new(0, 7.5, 0)
			gui.AlwaysOnTop = true
			gui.MaxDistance = 120
			gui.Adornee     = root
			local text = Instance.new("TextLabel")
			text.Size                   = UDim2.fromScale(1, 1)
			text.BackgroundTransparency = 1
			text.Font                   = Enum.Font.GothamBold
			text.TextScaled             = true
			text.TextColor3             = Color3.fromRGB(190, 170, 255)
			text.TextStrokeTransparency = 0.2
			text.Parent = gui
			gui.Parent = figure
			local untilAt = _weakUntil[baerchiUid]
			task.spawn(function()
				while gui.Parent and _weakUntil[baerchiUid] == untilAt and os.clock() < untilAt do
					text.Text = string.format("💫 ½ Lv %ds", math.ceil(untilAt - os.clock()))
					task.wait(1)
				end
				gui:Destroy()
			end)
		end
	end
	if player.Parent ~= nil then
		Remotes.EventNotice:FireClient(player, Loc.msg("msg.ufo.weakened", { s = seconds }), "info")
	end
end

-- Setzt die Figur wieder aufs Plot und beendet die Teilnahme (UFO-Absetzen).
local function finishHome(presence: any)
	local player: Player = presence.player
	local figure = MapService.getBaerchiModel(player, presence.baerchiUid)

	if _present[player] == presence then
		_present[player] = nil
	end

	if figure then
		-- Sammel-Update 1.1: ERST das Atmen abmelden, dann setzen. Sonst
		-- springt idleBob -> stopIdle die Figur auf ihre alte Ruhelage zurueck
		-- (z.B. mitten im Event-Pit) und sie "atmet" dort weiter, obwohl sie
		-- laut Daten schon zu Hause ist — genau das eingefrorene Bild.
		FigureFX.stopIdle(figure)
		FigurePlacement.place(figure, presence.homeFoot, figure:GetPivot().Rotation)
		FigureFX.idleBob(figure, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
	end

	ActivityLock.release(player, LOCK_HOLDER)
	if player.Parent ~= nil then
		notifyPresence(player, false, nil)
	end
end

-- UFO-Belohnung beim Absetzen: +1 auf alle Stats (begrenzt durch STAT_CAP)
-- und der Rarity-Up-Wurf (EventConfig.RARITY_UP_CHANCE).
local function applyUfoReward(presence: any)
	local player: Player = presence.player
	local data = PlayerService.getData(player)
	if not data then return end

	local baerchi = data.island.baerchis[presence.baerchiUid]
	if not baerchi then return end

	local def      = BaerchiConfig.getById(baerchi.configId)
	local beforeHp = if def then CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp else 0

	local cap    = PromotionConfig.getStatCap(baerchi.rarity)
	local levels = baerchi.statLevels :: any
	local gained: { string } = {}

	for _, key in PromotionConfig.GROWABLE_STATS do
		local old = levels[key] or 0
		if old < cap then
			levels[key] = math.min(cap, old + EventConfig.UFO.STAT_GAIN_PER_STAT)
			table.insert(gained, PromotionConfig.STAT_LABELS[key] or key)
		end
	end

	-- Rarity-Up: nur eine Stufe, Chance sinkt mit der aktuellen Rarity.
	local oldRarity = baerchi.rarity
	local rarityUp = rollRarityUp(baerchi, EventConfig.getRarityUpChance(oldRarity))

	-- Mehr maxHp (Stat-Stufe, hoehere Rarity): Differenz gutschreiben.
	if def then
		local afterHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
		baerchi.currentHp = math.clamp(
			(baerchi.currentHp or 0) + math.max(0, afterHp - beforeHp),
			0,
			afterHp
		)
	end

	-- Sammel-Update 2.4: als LocMsg (Stat-Kuerzel sind in allen Sprachen gleich)
	local text: Types.LocMsg = if #gained > 0
		then Loc.msg("msg.ufo.reward_stats", { stats = table.concat(gained, "/") })
		else Loc.msg("msg.ufo.reward_maxed")
	if rarityUp then
		text = Loc.join(text, Loc.msg("msg.event.rarity_up", {
			from = Loc.msg("rarity." .. oldRarity), to = Loc.msg("rarity." .. rarityUp),
		}))
	end

	local gain: any = {
		baerchiUid = presence.baerchiUid,
		eventId    = "Ufo",
		statKey    = nil,
		newLevel   = 0,
		cap        = PromotionConfig.getStatCap(baerchi.rarity),
		bonusText  = text :: any,
		mutation   = nil,
		midEvent   = true,
		rarityUp   = rarityUp,
	}
	Remotes.EventStatGained:FireClient(player, gain)

	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	MapService.celebrateBaerchi(player, presence.baerchiUid, BaerchiConfig.getRarityColor(baerchi.rarity))

	print("[EventParticipationService]", player.Name, "| UFO:", Loc.resolve(text))
end

local function buildApi(token: number): any
	local api: any = {}

	api.center = MapService.getEventPitPosition()
	api.radius = MapService.getEventPitRadius()

	api.running = function(): boolean
		return _sessionToken == token
	end

	api.footOf = footPosOf

	-- Alle Teilnehmer, die gerade am Event stehen und deren Figur existiert.
	-- Entfuehrte (abducting) sind nicht dabei.
	api.participants = function(): { any }
		local list = {}
		for player, presence in _present do
			local figure = MapService.getBaerchiModel(player, presence.baerchiUid)
			if figure and not presence.abducting then
				presence.player = player
				presence.figure = figure
				table.insert(list, presence)
			end
		end
		return list
	end

	api.stillHere = function(part: any): boolean
		return part.player ~= nil and _present[part.player] == part
	end

	api.plotPosition = function(player: Player): Vector3?
		local cf = MapService.getPlotCFrame(player)
		return if cf then cf.Position else nil
	end

	api.level = function(part: any): number
		local data = PlayerService.getData(part.player)
		local baerchi = if data then data.island.baerchis[part.baerchiUid] else nil
		return if baerchi then weakenedLevel(part.baerchiUid, baerchi.level) else 1
	end

	-- Kampfstaerke fuer Duelle: ATK * maxHp (wie CombatCalculator).
	api.power = function(part: any): number
		local data = PlayerService.getData(part.player)
		local found = if data then data.island.baerchis[part.baerchiUid] else nil
		if not found then return 1 end
		local baerchi: any = found
		-- UFO_REJOIN: geschwaecht = mit halbem Level rechnen (Kopie, die
		-- gespeicherten Daten bleiben unberuehrt).
		local level = weakenedLevel(part.baerchiUid, baerchi.level)
		if level ~= baerchi.level then
			baerchi = table.clone(baerchi)
			baerchi.level = level
		end
		local def = BaerchiConfig.getById(baerchi.configId)
		if def then
			local ok, stats = pcall(CombatCalculator.getEffectiveStats, baerchi, def.baseStats)
			if ok and stats then
				local s: any = stats
				return math.max(1, s.atk or 1) * math.max(1, s.maxHp or 1)
			end
		end
		return math.max(1, baerchi.level)
	end

	api.toast = toast

	api.recall = function(player: Player)
		EventParticipationService.recall(player)
	end

	api.finishHome = finishHome
	api.ufoReward  = applyUfoReward

	-- UFO_REJOIN: nach dem Absetzen geschwaecht (Level halbiert, befristet).
	api.weaken = function(part: any, seconds: number)
		weaken(part.player, part.baerchiUid, seconds)
	end
	api.isWeakened = function(part: any): boolean
		return isWeakened(part.baerchiUid)
	end

	-- v17: Eier direkt ins Lager (UFO-Abwurf), ueber EggService.
	api.grantEgg = function(player: Player, eggType: Types.EggType, amount: number): boolean
		return EggService.grantEggs(player, eggType, amount)
	end

	-- v17: lokalisierte Meldungen (LocMsg) an einen Spieler bzw. an alle.
	api.notify = function(player: Player, msg: Types.LocMsg, style: string?)
		if player.Parent ~= nil then
			Remotes.EventNotice:FireClient(player, msg, style)
		end
	end
	api.announce = function(msg: Types.LocMsg, style: string?)
		Remotes.EventNotice:FireAllClients(msg, style)
	end

	-- v17: effektive Kampfwerte des Baerchis (fuer den Boss-Schaden, siehe
	-- Modules/BossBalance). nil, wenn Daten oder Baerchi fehlen.
	api.fightStats = function(part: any): any
		local data = PlayerService.getData(part.player)
		local baerchi = if data then data.island.baerchis[part.baerchiUid] else nil
		if not baerchi then return nil end
		local def = BaerchiConfig.getById(baerchi.configId)
		if not def then return nil end
		local ok, stats = pcall(CombatCalculator.getEffectiveStats, baerchi, def.baseStats)
		return if ok then stats else nil
	end

	-- v17: das laufende Event vorzeitig beenden (Boss besiegt). Laeuft ueber
	-- den normalen Weg: EventService stellt nur die Uhr vor, das Ende samt
	-- Auszahlung macht der naechste Takt.
	api.finishEarly = function()
		if _sessionToken == token then
			EventService.skipPhase()
		end
	end

	-- Laeuft die Figur zu `target` (nur X/Z, Y bleibt). Blockiert bis zur
	-- Ankunft oder bis die Bewegung abgebrochen wurde. true = angekommen.
	api.walkTo = function(part: any, target: Vector3): boolean
		local figure: Model? = part.figure
		if not figure or not figure.Parent or part.busy or _present[part.player] ~= part then
			return false
		end

		part.busy       = true
		part.cancelWalk = false

		local ok, err = pcall(function()
			FigureFX.stopIdle(figure)
			local from = footPosOf(figure)
			FigureWalker.walk(figure, from, Vector3.new(target.X, from.Y, target.Z), {
				speed       = EVENT_WALK_SPEED,
				isCancelled = function(): boolean
					return part.cancelWalk == true
						or _present[part.player] ~= part
						or figure.Parent == nil
				end,
			})
		end)
		if not ok then
			warn("[EventParticipationService] walkTo fehlgeschlagen:", err)
		end

		local cancelled = part.cancelWalk == true or _present[part.player] ~= part
		part.busy       = false
		part.cancelWalk = false

		-- Der Spieler wollte waehrenddessen zurueck: jetzt ausfuehren.
		if _recallPending[part.player] and _present[part.player] == part then
			_recallPending[part.player] = nil
			EventParticipationService.recall(part.player)
			return false
		end

		return ok and not cancelled
	end

	return api
end

local function onEventStarted(def: EventConfig.EventDef)
	if _session then
		pcall(_session.stop)
		_session = nil
	end

	_sessionToken += 1

	local handler = (EventHandlers :: any)[def.handler]
	if not handler then
		warn("[EventParticipationService] Kein Handler fuer Event:", def.id, def.handler)
		return
	end

	local ok, session = pcall(handler, buildApi(_sessionToken), def)
	if ok then
		_session = session
	else
		warn("[EventParticipationService] Handler-Start fehlgeschlagen:", session)
	end
end

--------------------------------------------------------------------------------
-- Aufraeumen
--------------------------------------------------------------------------------

-- Eine Teilnahme kann auf drei Wegen ungueltig werden, ohne dass jemand
-- "zurueck" gedrueckt hat: ein Kampf nimmt das Schloss per forceAcquire, die
-- Figur verschwindet (Rebirth, Insel-Neuaufbau), oder der Baerchi ist nicht
-- mehr der ausgeruestete. In allen drei Faellen wird der Eintrag hier still
-- geraeumt — die Figur selbst gehoert dann bereits jemand anderem.
local function tick()
	for player, presence in _present do
		local data = PlayerService.getData(player)

		-- Sammel-Update 1.1 (UFO-Einfrieren): Waechter fuer die Entfuehrung.
		-- Haengt der Ablauf (Fehler ausserhalb des pcall, Thread gestorben),
		-- blieb der Baerchi bisher fuer immer "entfuehrt": Schloss gehalten,
		-- kein Legen, kein Honig-Teich. Nach der laengsten moeglichen Dauer
		-- plus Puffer wird er hier sicher heimgesetzt.
		if presence.abducting and presence.abductedAt
			and os.clock() - presence.abductedAt > ABDUCT_WATCHDOG_SECONDS then
			warn("[EventParticipationService] Entfuehrung haengt, setze heim:", player.Name)
			presence.abducting = false
			pcall(finishHome, presence)
			continue
		end

		local lost = data == nil
			or player.Parent == nil
			or ActivityLock.owner(player) ~= LOCK_HOLDER
			or (data :: Types.PlayerData).island.equippedUid ~= presence.baerchiUid
			or MapService.getBaerchiModel(player, presence.baerchiUid) == nil

		if lost then
			_present[player] = nil
			ActivityLock.release(player, LOCK_HOLDER)

			if player.Parent ~= nil then
				notifyPresence(player, false, nil)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- v12: Phase fuer die Pet-Leiste: "ToEvent", "AtEvent", "Returning" oder nil.
function EventParticipationService.getPhase(player: Player): string?
	if _present[player] then
		return "AtEvent"
	end
	if _walking[player] then
		return if _walkDir[player] == "to" and not _cancelTo[player] then "ToEvent" else "Returning"
	end
	return nil
end

-- Sammel-Update 05.10. (Paket 5.2): wer steht gerade mit welcher Figur am
-- Event (fuer PitBrawlService). Nur lesend; "busy" = laeuft/kaempft gerade,
-- dann greift die Figur niemanden an.
function EventParticipationService.getParticipants(): { { player: Player, figure: Model, busy: boolean } }
	local list = {}
	for player, presence in _present do
		local figure = MapService.getBaerchiModel(player, presence.baerchiUid)
		if figure and figure.Parent and not presence.abducting then
			table.insert(list, { player = player, figure = figure, busy = presence.busy == true })
		end
	end
	return list
end

function EventParticipationService.isPresent(player: Player): boolean
	return _present[player] ~= nil
end

-- v12: wird der Baerchi gerade vom UFO entfuehrt? (Event-Knopf gesperrt)
function EventParticipationService.isAbducting(player: Player): boolean
	local presence = _present[player]
	return presence ~= nil and presence.abducting == true
end

function EventParticipationService.init()
	-- (v12: Hinschicken und Zurueckholen laufen ueber PetModeService /
	-- RequestPetMode, nicht mehr ueber eigene Remotes.)

	EventService.onEventStarted(onEventStarted)
	EventService.onEventEnded(onEventEnded)

	-- Beim Start eines Events die Bewegung der bereits Anwesenden umstellen —
	-- sonst nickt ein Baerchi weiter im Pausen-Takt, obwohl das Event laeuft.
	-- Bewusst ueber denselben Tick wie die Aufraeum-Pruefung: ein zweiter
	-- Callback in EventService waere mehr Mechanik als der Effekt wert ist.
	Players.PlayerRemoving:Connect(function(player)
		_present[player]  = nil
		_walking[player]  = nil
		_walkDir[player]  = nil
		_cancelTo[player] = nil
	end)

	task.spawn(function()
		local lastEventId: string? = nil

		while true do
			task.wait(CHECK_INTERVAL)

			local ok, err = pcall(function()
				tick()

				local active  = EventService.getActive()
				local nowId   = if active then active.id else nil

				if nowId ~= lastEventId then
					lastEventId = nowId
					for player, presence in _present do
						local figure = MapService.getBaerchiModel(player, presence.baerchiUid)
						if figure and not presence.busy and not presence.abducting then
							playEventMotion(figure)
						end
					end
				end
			end)

			if not ok then
				warn("[EventParticipationService] Tick fehlgeschlagen:", err)
			end
		end
	end)

	print("[EventParticipationService] Initialisiert | Intervall:", CHECK_INTERVAL, "s")
end

return EventParticipationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[--!strict
-- EventService.luau
-- ServerScriptService/Services/EventService.luau
--
-- Einzige Zustaendigkeit:
--   - Den Event-Zyklus fahren (Pause → Event → Pause → ...)
--   - Das Event-Pit in der Weltmitte entsprechend umfaerben (MapService)
--   - Die Countdown-Tafel darueber beschriften
--
-- Kennt weiterhin WEDER Spielerdaten NOCH Waehrung. Dass ein Event inzwischen
-- eine spielerische Auswirkung hat (Stat-Fortschritt fuer teilnehmende
-- Baerchis), aendert daran nichts: dieser Service meldet nur, WANN ein Event
-- endet — was daraufhin passiert, entscheidet allein
-- EventParticipationService ueber den onEventEnded-Callback weiter unten.
--
-- Genau diese Trennung ist der Grund, warum der Zyklus hier keine einzige
-- Zeile Spiellogik bekommt: sonst waere dieser Service beim naechsten Feature
-- ("Event gibt auch Honig") die Stelle, an der drei fremde Systeme
-- zusammenlaufen.
--
-- ============================================================
-- WARUM EIN EIGENER SERVICE UND NICHT TEIL VON MAPSERVICE
-- ============================================================
-- MapService baut und AENDERT Geometrie, entscheidet aber nirgendwo sonst
-- WANN etwas passiert — das ist ueberall sonst Sache des aufrufenden Service
-- (CombatService/PitArenaService fuer den Kampf-Ablauf, HoneyService fuer die
-- Produktions-Zeitpunkte). Der Event-Zyklus ist genau so ein "wann", also
-- bekommt er einen eigenen, kleinen Service statt MapService eine zweite
-- Zustaendigkeit aufzubuerden.

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local EventConfig = require(ReplicatedStorage.Config.EventConfig)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local Names       = require(ReplicatedStorage.Localization.Names)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)  -- HBB Paket 6
local MapConfig    = require(ReplicatedStorage.Config.MapConfig)
local Remotes      = require(ReplicatedStorage.Network.Remotes)
local MapService   = require(ServerScriptService.Services.MapService)

local EventService = {}

-- Das Boss-Event, auf das das Wespen-Nest zeigt (EventConfig.EVENTS)
local WASP_QUEEN_ID = "WaspQueen"

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

-- Das gerade laufende Event, oder nil waehrend einer Pause.
local _active: EventConfig.EventDef? = nil

-- Zeitstempel (os.time()), an dem die aktuelle Phase (Event ODER Pause) endet.
local _phaseEndsAt = 0

-- Index in EventConfig.EVENTS, der als naechstes drankommt. Der Reihe nach,
-- kein Zufall — siehe EventConfig, Kommentar bei EVENTS.
local _nextIndex = 1

-- In welchem Durchlauf des Zyklus das naechste Event liegt (ab 1). Events mit
-- everyNthCycle (Boss) laufen nur in passenden Durchlaeufen; die Regel steht
-- in EventConfig.isScheduledInCycle, hier wird nur weitergezaehlt.
local _nextCycle = 1

-- Beobachter, die beim START eines Events benachrichtigt werden wollen
-- (EventParticipationService startet damit den Event-Handler).
local _onEventStarted: { (EventConfig.EventDef) -> () } = {}

-- Beobachter, die beim ENDE eines Events benachrichtigt werden wollen.
-- Aktuell genau einer: EventParticipationService, der dann die Stat-Stufen
-- an die anwesenden Baerchis verteilt.
local _onEventEnded: { (EventConfig.EventDef) -> () } = {}

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function formatCountdown(seconds: number): string
	local clamped = math.max(0, math.floor(seconds))
	local minutes = clamped // 60
	local secs    = clamped % 60
	return string.format("%d:%02d", minutes, secs)
end

-- Die drei Angaben einer Phasen-Meldung: laufendes Event (nil in der Pause),
-- Restzeit der Phase, und welches Event als naechstes kommt.
--
-- Das NAECHSTE Event gehoert mit dazu, weil der Spieler waehrend der Pause
-- entscheidet: nur wenn er weiss, was gleich laeuft, kann er seinen Baerchi
-- rechtzeitig losschicken (der Weg in die Mitte dauert selbst ein paar
-- Sekunden). Auf der Tafel steht dieselbe Information — die sieht aber nur,
-- wer gerade in die Weltmitte schaut.
-- Sammel-Update 05.10. (Paket 5.3): vierte Angabe = Sekunden bis zur
-- naechsten Wespenkoenigin (0 = laeuft gerade, nil = unbekannt). Die Pet-
-- Leiste zeigt daraus "Boss in X min" — der 50-Minuten-Zyklus fuehlt sich
-- kuerzer an, wenn man sieht, worauf man wartet.
local function phasePayload(): (string?, number, string, number?)
	local remaining = math.max(0, _phaseEndsAt - os.time())
	local activeId = if _active then _active.id else nil
	return
		activeId,
		remaining,
		EventConfig.EVENTS[_nextIndex].id,
		EventConfig.secondsUntilStart(WASP_QUEEN_ID, activeId, remaining, _nextIndex, _nextCycle)
end

-- Sagt ALLEN Clients, welches Event gerade laeuft (bzw. dass Pause ist).
--
-- Nur bei einem PHASENWECHSEL und beim Join, nicht im Sekundentakt: die Uhr
-- steht sichtbar auf der Tafel in der Welt, dafuer braucht es kein Remote. Der
-- Client benutzt die Meldung ausschliesslich, um auf der Baerchi-Karte
-- anzuzeigen, was eine Teilnahme gerade bringen wuerde (siehe BaerchiPanel).
local function broadcastPhase()
	Remotes.EventPhaseChanged:FireAllClients(phasePayload())
end

-- Stellt _nextIndex auf das naechste Event, das im jeweiligen Durchlauf
-- laeuft. Beim Umlauf (letztes → erstes Event) beginnt ein neuer Durchlauf.
local function advance()
	local count = #EventConfig.EVENTS
	for _ = 1, count * 2 do
		_nextIndex += 1
		if _nextIndex > count then
			_nextIndex = 1
			_nextCycle += 1
		end
		if EventConfig.isScheduledInCycle(EventConfig.EVENTS[_nextIndex], _nextCycle) then
			return
		end
	end
end

local function startEvent()
	local def = EventConfig.EVENTS[_nextIndex]
	advance()

	_active      = def
	_phaseEndsAt = os.time() + EventConfig.getDuration(def)

	MapService.setEventPitTheme({
		floorColor = def.floorColor,
		fenceColor = def.fenceColor,
		ringColor  = def.ringColor,
	})

	broadcastPhase()

	print("[EventService] Event gestartet:", def.displayName, "|", Loc.resolve(EventConfig.describeReward(def)))

	for _, callback in _onEventStarted do
		local ok, err = pcall(callback, def)
		if not ok then
			warn("[EventService] onEventStarted-Callback fehlgeschlagen:", err)
		end
	end
end

local function endEvent()
	local finished = _active
	_active      = nil
	_phaseEndsAt = os.time() + EventConfig.EVENT_GAP_SECONDS

	MapService.setEventPitTheme(nil)
	broadcastPhase()

	if finished then
		print("[EventService] Event beendet:", finished.displayName)

		-- Beobachter NACH dem Aufraeumen benachrichtigen: sie sollen einen
		-- Zustand vorfinden, in dem das Event nachweislich vorbei ist
		-- (getActive() gibt bereits nil zurueck). Jeder Callback in pcall — ein
		-- Fehler beim Verteilen der Belohnung darf den Zyklus nicht anhalten,
		-- sonst stuende die Event-Uhr fuer den ganzen Server still.
		for _, callback in _onEventEnded do
			local ok, err = pcall(callback, finished)
			if not ok then
				warn("[EventService] onEventEnded-Callback fehlgeschlagen:", err)
			end
		end
	end
end

-- Ein Tick pro Sekunde: Phase ggf. wechseln, danach die Tafel nachziehen.
-- Zeit wird immer aus os.time()/_phaseEndsAt neu gerechnet statt einfach
-- runtergezaehlt — ein einzelner ausgesetzter Tick (Server-Laghlack) darf die
-- Uhr nicht verschieben.
local function tick()
	local remaining = _phaseEndsAt - os.time()

	if remaining <= 0 then
		if _active then
			endEvent()
		else
			startEvent()
		end
		remaining = _phaseEndsAt - os.time()
	end

	-- Auf der Tafel steht IMMER auch die Belohnung — bei zehn Events im
	-- Wechsel waere "Naechstes Event / in 4:12" sonst keine Information, auf
	-- die man eine Entscheidung stuetzen kann. Waehrend der Pause wird deshalb
	-- zusaetzlich angekuendigt, WELCHES Event als naechstes kommt: nur so kann
	-- ein Spieler seinen Baerchi rechtzeitig hinschicken, wenn genau dieses
	-- Event den Stat bringt, den er braucht.
	if _active then
		-- Tafel-Texte als Nachrichten: jeder Spieler liest sie in seiner Sprache.
		MapService.setEventBanner(
			-- Sammel-Update 2.4: die Tafel sehen alle — Zeichen statt Woerter
			Loc.msg("ui.eventboard.live", { event = Names.msg.event(_active.id) }),
			string.format("⏱ %s", formatCountdown(remaining)),
			_active.bannerColor,
			EventConfig.describeReward(_active)
		)
	else
		local upcoming = EventConfig.EVENTS[_nextIndex]

		MapService.setEventBanner(
			Loc.msg("fmt.append", { a = "⏭", b = Names.msg.event(upcoming.id) }),
			string.format("⏱ %s", formatCountdown(remaining)),
			MapConfig.EVENT_PIT_BANNER_IDLE_COLOR,
			EventConfig.describeReward(upcoming)
		)
	end

	-- HBB Paket 6: Wespen-Nest am Mast zaehlt bis zur Koenigin herunter
	-- (sprachneutral: Biene + Uhr) und leuchtet kurz davor und waehrenddessen.
	if FeatureFlags.isOn("MAP_V2_WASP_NEST") then
		local activeId = if _active then _active.id else nil
		local untilBoss = EventConfig.secondsUntilStart(WASP_QUEEN_ID, activeId, remaining, _nextIndex, _nextCycle)
		if untilBoss then
			MapService.setWaspNest(
				if untilBoss == 0 then "🐝 LIVE" else "🐝 " .. formatCountdown(untilBoss),
				untilBoss <= MapConfig.WASP_NEST.glowSeconds
			)
		end
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Das gerade laufende Event, falls eins laeuft — nil waehrend einer Pause.
-- Wird von EventParticipationService gelesen (und vom Client ueber dessen
-- Zustandsmeldungen indirekt mitbekommen).
function EventService.getActive(): EventConfig.EventDef?
	return _active
end

-- Das Event, das als NAECHSTES an der Reihe ist. Waehrend einer Pause ist das
-- der Countdown-Gegenstand auf der Tafel; waehrend eines laufenden Events ist
-- es das darauf folgende.
--
-- Gibt es immer (der Zyklus ist ein Ring), deshalb kein optionaler Rueckgabewert.
function EventService.getNext(): EventConfig.EventDef
	return EventConfig.EVENTS[_nextIndex]
end

-- Sekunden bis zum Ende der laufenden Phase (Event ODER Pause). Nie negativ.
function EventService.getRemainingSeconds(): number
	return math.max(0, _phaseEndsAt - os.time())
end

-- Beendet die laufende Phase sofort — laeuft gerade ein Event, ist es danach
-- vorbei (inklusive aller onEventEnded-Callbacks); ist gerade Pause, startet
-- sofort das naechste Event.
--
-- Nur fuer den Studio-Test gedacht (DebugService): ein Zyklus aus 3 Minuten
-- Event und 5 Minuten Pause laesst sich sonst nicht in vertretbarer Zeit
-- durchspielen. Bewusst KEIN eigener Sonderweg — es wird nur die Uhr
-- vorgestellt, den Rest macht der normale tick(). Dadurch kann dieser Aufruf
-- auch nichts kaputt machen, was im echten Ablauf nicht ohnehin passiert.
function EventService.skipPhase()
	_phaseEndsAt = os.time()
end

-- Stellt den Zyklus so, dass als naechstes GENAU dieses Event kommt, und
-- startet es sofort. Gibt false zurueck, wenn es die id nicht gibt.
--
-- Ebenfalls nur fuer den Studio-Test gedacht (DebugService): bei zehn Events
-- im Wechsel dauert ein voller Durchlauf 80 Minuten — ein bestimmtes Event
-- abzuwarten waere sonst keine Testmoeglichkeit, sondern eine Geduldsprobe.
--
-- Laeuft gerade ein Event, wird es ordentlich beendet (inklusive aller
-- onEventEnded-Callbacks, also auch der Belohnungen) statt einfach ersetzt —
-- sonst haette ein Testaufruf nebenbei die Teilnahme aller Anwesenden
-- verschluckt.
function EventService.startById(id: string): boolean
	local index: number? = nil
	for i, def in EventConfig.EVENTS do
		if def.id == id then
			index = i
			break
		end
	end

	if not index then
		return false
	end

	if _active then
		endEvent()
	end

	_nextIndex = index
	startEvent()
	return true
end

-- Registriert einen Callback, der laeuft sobald ein Event ZU ENDE ist.
--
-- Anders als PlayerService.onDataLoaded ist die Reihenfolge zu init() hier
-- UNKRITISCH: der Server startet grundsaetzlich in einer Pause (siehe init),
-- das erste Event endet also fruehestens nach EVENT_GAP + EVENT_DURATION
-- Sekunden. Bis dahin sind laengst alle Services angemeldet.
function EventService.onEventStarted(callback: (EventConfig.EventDef) -> ())
	table.insert(_onEventStarted, callback)
end

function EventService.onEventEnded(callback: (EventConfig.EventDef) -> ())
	table.insert(_onEventEnded, callback)
end

function EventService.init()
	-- Wer spaeter dazukommt, hat den letzten Phasenwechsel verpasst — also
	-- bekommt jeder neue Spieler den Stand einmal gezielt zugeschickt. Ohne
	-- das zeigte seine Baerchi-Karte bis zum naechsten Wechsel (bis zu fuenf
	-- Minuten) "gerade kein Event", obwohl das Pit vor ihm leuchtet.
	Players.PlayerAdded:Connect(function(player)
		Remotes.EventPhaseChanged:FireClient(player, phasePayload())
	end)

	print(
		"[EventService] Initialisiert |", #EventConfig.EVENTS, "Events im Wechsel",
		"(manche nur jeden n-ten Durchlauf) | individuelle Dauer,", EventConfig.EVENT_GAP_SECONDS, "s Pause"
	)
end

-- Der Zyklus laeuft erst in start(): dann steht die Welt (das Event-Pit baut
-- MapService.init) und alle onEventStarted/onEventEnded-Rueckrufe sind
-- angemeldet.
function EventService.start()
	-- Server startet in der Pause, nicht mitten in einem Event — sonst wuerde
	-- jeder frisch gestartete Server sofort mit einem laufenden Event
	-- begruesst, was sich nach einem Fehler anfuehlt statt nach Absicht.
	-- HBB Paket 6: die erste Pause eines neuen Servers ist kuerzer.
	local firstGap = if FeatureFlags.isOn("EVENT_V2_TIMER")
		then EventConfig.FIRST_GAP_SECONDS
		else EventConfig.EVENT_GAP_SECONDS
	_phaseEndsAt = os.time() + firstGap
	MapService.setEventPitTheme(nil)

	task.spawn(function()
		while true do
			local ok, err = pcall(tick)
			if not ok then
				warn("[EventService] Tick fehlgeschlagen:", err)
			end
			task.wait(1)
		end
	end)
end

return EventService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">GamepassService</string><ProtectedString name="Source"><![CDATA[--!strict
-- GamepassService.luau
-- ServerScriptService/Services/GamepassService.luau
--
-- Einzige Zustaendigkeit:
--   - Gamepass-Besitz pruefen und im Speicher halten (08.10., Paket C):
--     beim Join und nach PromptGamePassPurchaseFinished
--     (MarketplaceService.UserOwnsGamePassAsync, mit pcall); den Kauf-Dialog
--     ausloesen (RequestBuyGamepass).
--
-- Besitz steht NICHT im Spielstand (Roblox ist die Wahrheit). Fuer die
-- Anzeige schreibt der Service ein Attribut an den Player
-- (GamepassConfig.attributeName); Kosten rechnet nur der Server mit
-- GamepassService.owns (z. B. CombatService beim bezahlten Einstieg).
--
-- id = 0 (nicht angelegt): niemand besitzt den Pass, ein Kaufwunsch wird
-- still verworfen (der Knopf zeigt "Bald") — kein Fehler, kein Crash.
-- Studio: Debug "pass <KEY> on|off" setzt den Besitz fuer diese Sitzung.

local Players            = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Remotes        = require(ReplicatedStorage.Network.Remotes)
local GamepassConfig = require(ReplicatedStorage.Config.GamepassConfig)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local GamepassService = {}

-- Spieler -> Pass-Key -> Besitz (aus Roblox)
local _owned: { [Player]: { [string]: boolean } } = {}
-- Debug-Uebersteuerung (nur Studio): Spieler -> Key -> Besitz
local _debug: { [Player]: { [string]: boolean } } = {}

local function publish(player: Player, key: string)
	player:SetAttribute(GamepassConfig.attributeName(key), GamepassService.owns(player, key))
end

-- Besitz eines Passes (Debug vor Roblox). Nie ein Fehler.
function GamepassService.owns(player: Player, key: string): boolean
	local forced = _debug[player]
	if forced and forced[key] ~= nil then
		return forced[key]
	end
	local owned = _owned[player]
	return owned ~= nil and owned[key] == true
end

-- Fragt Roblox fuer alle angelegten Passes (pcall: der Dienst kann ausfallen,
-- dann bleibt der bekannte Stand bzw. "nicht besessen").
function GamepassService.refresh(player: Player)
	local owned = _owned[player] or {}
	_owned[player] = owned
	for key, def in GamepassConfig.PASSES do
		if def.id > 0 then
			local ok, result = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
			end)
			if ok then
				owned[key] = result == true
			else
				warn("[GamepassService] Besitz nicht pruefbar:", player.Name, key, result)
			end
		else
			owned[key] = false
		end
		publish(player, key)
	end
end

-- Debug (Studio): Besitz fuer diese Sitzung erzwingen; nil = wieder Roblox.
function GamepassService.debugSet(player: Player, key: string, value: boolean?)
	local forced = _debug[player] or {}
	_debug[player] = forced
	forced[key] = value
	publish(player, key)
end

local function keyForId(passId: number): string?
	for key, def in GamepassConfig.PASSES do
		if def.id > 0 and def.id == passId then return key end
	end
	return nil
end

function GamepassService.init()
	RateLimiter.connect(Remotes.RequestBuyGamepass, "RequestBuyGamepass", function(player, key: any)
		if typeof(key) ~= "string" then return end
		local def = GamepassConfig.get(key)
		if not def or def.id <= 0 then return end          -- "Bald": still verwerfen
		if GamepassService.owns(player, key) then return end
		local ok, err = pcall(function()
			MarketplaceService:PromptGamePassPurchase(player, def.id)
		end)
		if not ok then warn("[GamepassService] Kauf-Dialog fehlgeschlagen:", err) end
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		local key = keyForId(passId)
		if not key or not purchased then return end
		local owned = _owned[player] or {}
		_owned[player] = owned
		owned[key] = true
		publish(player, key)
		print("[GamepassService]", player.Name, "hat gekauft:", key)
	end)

	Players.PlayerRemoving:Connect(function(player)
		_owned[player] = nil
		_debug[player] = nil
	end)

	print("[GamepassService] Initialisiert")
end

function GamepassService.start()
	for _, player in Players:GetPlayers() do
		task.spawn(GamepassService.refresh, player)
	end
	Players.PlayerAdded:Connect(function(player)
		GamepassService.refresh(player)
	end)
end

return GamepassService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">IncubatorService</string><ProtectedString name="Source"><![CDATA[--!strict
-- IncubatorService.luau
-- ServerScriptService/Services/IncubatorService.luau
--
-- Einzige Zustaendigkeit:
--   - Der Inkubator (Sammel-Update 05.10., Paket 8): Eier aus dem Lager in
--     freie Plaetze legen, fertige abholen (Schluepfen anstossen),
--     beschleunigen (GoldGummies) und ausbauen (Gummies).
--
-- Kontext: "Mein Plot ist so gross, aber es passiert hier so wenig." Eier ab
-- der Gold-Stufe brauchen jetzt Brutzeit; man legt sie hinein, kommt zurueck
-- und holt das Baerchi ab. Basis- und Zucker-Ei gehen weiter sofort auf
-- (IncubatorRules.requiresIncubator).
--
-- Was NICHT hier passiert:
--   * Das Schluepfen selbst: EggService.openEgg (Gacha, Mutation, Index,
--     Quests, Auto-Ausruesten bleiben an einer Stelle). Zum Abholen legt
--     dieser Service das Ei kurz zurueck ins Lager und ruft openEgg mit
--     fromIncubator = true — geht dabei etwas schief, liegt das Ei im Lager
--     und ist nicht verloren.
--   * Waehrungen: nur ueber EconomyService.
--   * Anzeige: PlotDisplayService/MapService (Signatur), der Client rechnet
--     Fortschritt und "fertig" selbst aus den Zeitmarken.
--
-- Kein Timer pro Ei: jeder Platz traegt startedAt/finishAt (Zeitmarken wie
-- Honig und Recycler) und ist fertig, sobald os.time() >= finishAt — auch
-- offline und ueber Server-Neustarts hinweg.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local Loc             = require(ReplicatedStorage.Localization.Loc)
local EggConfig       = require(ReplicatedStorage.Config.EggConfig)
local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)
local IncubatorConfig = require(ReplicatedStorage.Config.IncubatorConfig)
local IncubatorRules  = require(ReplicatedStorage.Modules.IncubatorRules)

local EggCalculator   = require(ReplicatedStorage.Modules.EggCalculator)
local EggTree         = require(ReplicatedStorage.Modules.EggTree)

local Players        = game:GetService("Players")
local PlayerService  = require(ServerScriptService.Services.PlayerService)
local MapService     = require(ServerScriptService.Services.MapService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local EggService     = require(ServerScriptService.Services.EggService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local IncubatorService = {}

local function fail(player: Player, action: string, reason: Types.LocMsg)
	Remotes.ActionFailed:FireClient(player, action, reason)
end

local function changed(player: Player, slot: number, kind: string)
	Remotes.IncubatorChanged:FireClient(player, { slot = slot, kind = kind })
end

-- Gemeinsame Vorpruefung. Gibt die Daten zurueck, wenn der Inkubator benutzbar ist.
local function usable(player: Player, action: string): Types.PlayerData?
	if not FeatureFlags.isOn("INCUBATOR") then return nil end
	local data = PlayerService.getData(player)
	if not data then return nil end
	if not IncubatorRules.isUnlocked(data) then
		fail(player, action, Loc.msg("err.incubator_locked"))
		return nil
	end
	return data
end

--------------------------------------------------------------------------------
-- Einlegen
--------------------------------------------------------------------------------

function IncubatorService.start(player: Player, eggType: Types.EggType): boolean
	-- INCUBATOR_BREED: Eier werden nicht mehr gebruetet, sie gehen sofort auf.
	if FeatureFlags.isOn("INCUBATOR_BREED") then return false end
	local data = usable(player, "RequestIncubatorStart")
	if not data then return false end

	local egg = EggConfig.data[eggType]
	if not egg then
		fail(player, "RequestIncubatorStart", Loc.msg("err.egg_unknown_type"))
		return false
	end

	local stock = data.island.eggStock[eggType] or 0
	if stock <= 0 then
		fail(player, "RequestIncubatorStart", Loc.msg("err.egg_none_in_stock", { egg = Loc.msg("egg." .. eggType .. ".name") }))
		return false
	end

	local incubator = data.island.incubator
	local count = IncubatorRules.slotCountFor(data)
	local index = IncubatorRules.firstFree(incubator.slots, count)
	if not index then
		fail(player, "RequestIncubatorStart", Loc.msg("err.incubator_full"))
		return false
	end

	local now = os.time()
	data.island.eggStock[eggType] = stock - 1
	table.insert(incubator.slots, {
		slot      = index,
		eggType   = eggType,
		startedAt = now,
		finishAt  = now + IncubatorRules.brewSeconds(eggType, incubator.level),
	})
	table.sort(incubator.slots, function(a, b) return a.slot < b.slot end)

	changed(player, index, "start")
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return true
end

--------------------------------------------------------------------------------
-- Abholen
--------------------------------------------------------------------------------

function IncubatorService.collect(player: Player, index: number): Types.HatchResult?
	local data = usable(player, "RequestIncubatorCollect")
	if not data then return nil end

	local incubator = data.island.incubator
	local entry, position = IncubatorRules.findSlot(incubator.slots, index)
	if not entry or not position then
		fail(player, "RequestIncubatorCollect", Loc.msg("err.incubator_empty"))
		return nil
	end
	if not IncubatorRules.isReady(entry, os.time()) then
		fail(player, "RequestIncubatorCollect", Loc.msg("err.incubator_not_ready", {
			time = Loc.formatDuration(IncubatorRules.remaining(entry, os.time())),
		}))
		return nil
	end

	-- Ei zurueck ins Lager und ueber den normalen Weg oeffnen (siehe Kopf).
	table.remove(incubator.slots, position)
	local stock = data.island.eggStock
	stock[entry.eggType] = (stock[entry.eggType] or 0) + 1

	local result = EggService.openEgg(player, entry.eggType, true)
	changed(player, index, "collect")
	if not result then
		-- openEgg hat schon gemeldet; das Ei liegt im Lager.
		PlayerService.markDirty(player)
	end
	return result
end

-- Alle fertigen auf einmal (Plot-Prompt).
function IncubatorService.collectAll(player: Player)
	local data = usable(player, "RequestIncubatorCollect")
	if not data then return end
	local now = os.time()
	local ready: { number } = {}
	for _, entry in data.island.incubator.slots do
		if IncubatorRules.isReady(entry, now) then table.insert(ready, entry.slot) end
	end
	if #ready == 0 then
		fail(player, "RequestIncubatorCollect", Loc.msg("err.incubator_none_ready"))
		return
	end
	for _, index in ready do
		IncubatorService.collect(player, index)
	end
end

--------------------------------------------------------------------------------
-- Beschleunigen
--------------------------------------------------------------------------------

function IncubatorService.speedUp(player: Player, index: number): boolean
	local data = usable(player, "RequestIncubatorSpeedUp")
	if not data then return false end

	local entry = IncubatorRules.findSlot(data.island.incubator.slots, index)
	if not entry then
		fail(player, "RequestIncubatorSpeedUp", Loc.msg("err.incubator_empty"))
		return false
	end

	local now = os.time()
	local cost = IncubatorRules.speedUpCost(entry, now)
	if cost <= 0 then return true end

	local ok, reason = EconomyService.spendGoldGummies(player, cost)
	if not ok then
		fail(player, "RequestIncubatorSpeedUp", reason or Loc.msg("err.unknown"))
		return false
	end

	entry.finishAt = now
	changed(player, index, "speedup")
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return true
end

--------------------------------------------------------------------------------
-- Ausbauen (Geldsenke vor dem Rebirth, Paket 4.4)
--------------------------------------------------------------------------------

function IncubatorService.upgrade(player: Player): boolean
	local data = usable(player, "RequestUpgradeIncubator")
	if not data then return false end

	local incubator = data.island.incubator
	local target = incubator.level + 1
	local cost = IncubatorRules.upgradeCost(target)
	if not cost then
		fail(player, "RequestUpgradeIncubator", Loc.msg("err.incubator_max"))
		return false
	end
	if data.gummies < cost.gummies then
		fail(player, "RequestUpgradeIncubator", Loc.msg("err.not_enough_gummies", { need = cost.gummies, have = data.gummies }))
		return false
	end
	if data.goldGummies < cost.goldGummies then
		fail(player, "RequestUpgradeIncubator", Loc.msg("err.not_enough_gold_gummies", { need = cost.goldGummies, have = data.goldGummies }))
		return false
	end

	local ok, reason = EconomyService.spendGummies(player, cost.gummies)
	if not ok then
		fail(player, "RequestUpgradeIncubator", reason or Loc.msg("err.unknown"))
		return false
	end
	if cost.goldGummies > 0 then
		local okGold, reasonGold = EconomyService.spendGoldGummies(player, cost.goldGummies)
		if not okGold then
			-- Gummies zurueck: die Pruefung oben hat schon gesagt, dass es reicht,
			-- das hier ist nur das Netz fuer einen gleichzeitigen zweiten Abzug.
			EconomyService.awardGummiesFlat(player, cost.gummies)
			fail(player, "RequestUpgradeIncubator", reasonGold or Loc.msg("err.unknown"))
			return false
		end
	end

	incubator.level = target
	-- Laufende Bruten behalten ihre Zeit (sie wurde beim Einlegen festgelegt);
	-- das neue Tempo gilt fuer die naechsten Eier.
	changed(player, 0, "upgrade")
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return true
end

--------------------------------------------------------------------------------
-- INCUBATOR_BREED: Baerchis bruehten Eier (Wunsch Projektinhaber 05.10.)
--------------------------------------------------------------------------------
-- Ein Baerchi im Inkubator bruetet im Takt seiner Rarity Eier aus seiner
-- eigenen Tabelle (IncubatorRules.breedSeconds, EggCalculator.rollEggType).
-- Die Eier fallen neben den Inkubator in island.laidEggs (fromIncubator) und
-- werden wie gelegte Eier durch Darueberlaufen eingesammelt. Kein Timer pro
-- Baerchi: jeder Platz traegt lastEggAt, faellig wird nachgerechnet — auch
-- offline (gebremst wie das Legen, eigene kleinere Obergrenze).

local BREED_TICK_SECONDS = 5
local _breedCounter = 0

local function breeding(): boolean
	return FeatureFlags.isOn("INCUBATOR") and FeatureFlags.isOn("INCUBATOR_BREED")
end

local function breedersOf(data: Types.PlayerData): { Types.IncubatorBreeder }
	local incubator = data.island.incubator
	if not incubator.breeders then incubator.breeders = {} end
	return incubator.breeders :: { Types.IncubatorBreeder }
end

local function lyingFromIncubator(data: Types.PlayerData): number
	local n = 0
	for _, egg in data.island.laidEggs do
		if egg.fromIncubator then n += 1 end
	end
	return n
end

-- Ort fuer ein gebruetetes Ei (plot-relativ wie alle gelegten Eier), oder nil.
local function dropPosition(player: Player): Vector3?
	local model = MapService.getIncubatorModel(player)
	local base = if model then model.PrimaryPart else nil
	if not base then return nil end
	local angle = math.random() * math.pi * 2
	local radius = IncubatorConfig.BREED_DROP_MIN
		+ math.random() * (IncubatorConfig.BREED_DROP_MAX - IncubatorConfig.BREED_DROP_MIN)
	local ground = base.Position.Y - base.Size.Y * 0.5
	local world = Vector3.new(base.Position.X + math.cos(angle) * radius, ground, base.Position.Z + math.sin(angle) * radius)
	return MapService.worldToPlot(player, world)
end

-- Raeumt Plaetze, deren Baerchi es nicht mehr gibt (Fusion, Verwerten) oder
-- der inzwischen ausgeruestet ist (der legt dann selbst). Gibt true zurueck,
-- wenn sich etwas geaendert hat.
local function cleanBreeders(data: Types.PlayerData): boolean
	local breeders = breedersOf(data)
	local changedAny = false
	for i = #breeders, 1, -1 do
		local entry = breeders[i]
		if not data.island.baerchis[entry.uid] or data.island.equippedUid == entry.uid then
			table.remove(breeders, i)
			changedAny = true
		end
	end
	return changedAny
end

-- Bruetet die faelligen Eier aller Plaetze. Gibt die Zahl neuer Eier zurueck.
local function breed(player: Player, data: Types.PlayerData, offline: boolean): number
	local incubator = data.island.incubator
	local breeders = breedersOf(data)
	local now = os.time()
	local cap = if offline then IncubatorConfig.BREED_OFFLINE_MAX else IncubatorConfig.BREED_MAX_LYING
	local lying = lyingFromIncubator(data)
	local made = 0
	local count = IncubatorRules.slotCountFor(data)

	for _, entry in breeders do
		local baerchi = data.island.baerchis[entry.uid]
		if not baerchi then continue end
		-- Platz ueber der aktuellen Platz-Zahl (Rebirth setzt das Level
		-- zurueck): der Baerchi sitzt noch, bruetet aber nicht.
		if entry.slot > count then
			entry.lastEggAt = now
			continue
		end
		local seconds = IncubatorRules.breedSeconds(baerchi.rarity, incubator.level,
			if offline then EggConfig.OFFLINE_SLOWDOWN else nil)
		local due = IncubatorRules.breedDue(entry.lastEggAt, now, seconds)
		if due <= 0 then continue end

		local produced = 0
		for _ = 1, due do
			if lying >= cap then break end
			local rolled = EggCalculator.rollEggType(baerchi)
			local position = if rolled then dropPosition(player) else nil
			if not rolled or not position then break end
			produced += 1
			_breedCounter += 1
			table.insert(data.island.laidEggs, {
				uid           = string.format("e_inc_%d_%d_%d", now, _breedCounter, math.random(1000, 9999)),
				eggType       = EggTree.resolveLaid(data.eggTree, rolled),
				laidAt        = now,
				x             = position.X,
				y             = position.Y,
				z             = position.Z,
				fromIncubator = true,
			})
			lying += 1
			made += 1
		end
		-- Wie beim Legen: bei voller Obergrenze sammelt sich nichts an.
		-- Sonst bleibt der angebrochene Rest fuer das naechste Ei erhalten.
		-- Ohne Inkubator-Modell (Plot im Neubau) nur das Gebruetete abziehen,
		-- der Rest kommt im naechsten Takt.
		if lying >= cap then
			entry.lastEggAt = now
		else
			entry.lastEggAt += produced * seconds
		end
	end
	return made
end

function IncubatorService.putBaerchi(player: Player, uid: string): boolean
	if not breeding() then return false end
	local data = usable(player, "RequestIncubatorBaerchi")
	if not data then return false end

	local ok, reason = IncubatorRules.canBreed(data.island, uid)
	if not ok then
		fail(player, "RequestIncubatorBaerchi", Loc.msg(reason or "err.unknown"))
		return false
	end
	local breeders = breedersOf(data)
	local index = IncubatorRules.firstFreeBreeder(breeders, IncubatorRules.slotCountFor(data))
	if not index then
		fail(player, "RequestIncubatorBaerchi", Loc.msg("err.incubator_full"))
		return false
	end

	table.insert(breeders, { slot = index, uid = uid, lastEggAt = os.time() })
	table.sort(breeders, function(a, b) return a.slot < b.slot end)

	changed(player, index, "put")
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return true
end

function IncubatorService.takeBaerchi(player: Player, index: number): boolean
	if not breeding() then return false end
	local data = usable(player, "RequestIncubatorBaerchi")
	if not data then return false end

	local _, position = IncubatorRules.findBreeder(breedersOf(data), index)
	if not position then
		fail(player, "RequestIncubatorBaerchi", Loc.msg("err.incubator_empty"))
		return false
	end
	table.remove(breedersOf(data), position)

	changed(player, index, "take")
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	return true
end

-- Umstieg auf INCUBATOR_BREED: Eier aus dem alten Ei-Inkubator gehen ins
-- Lager zurueck (sie oeffnen jetzt sofort). Niemand verliert ein Ei.
local function returnBrewingEggs(data: Types.PlayerData): boolean
	local slots = data.island.incubator.slots
	if #slots == 0 then return false end
	local stock = data.island.eggStock
	for _, entry in slots do
		stock[entry.eggType] = (stock[entry.eggType] or 0) + 1
	end
	table.clear(slots)
	return true
end

-- Spieler, deren Offline-Nachholen noch auf den Plot wartet: der Online-Takt
-- laesst sie aus, sonst zaehlte die Offline-Zeit zum vollen Online-Tempo.
local _offlinePending: { [Player]: boolean } = {}

local function breedTick()
	for _, player in Players:GetPlayers() do
		if _offlinePending[player] then continue end
		local data = PlayerService.getData(player)
		if not data or not data.island.incubator then continue end
		local dirty = cleanBreeders(data)
		if breed(player, data, false) > 0 then dirty = true end
		if dirty then PlayerService.markDirty(player) end
	end
end

-- Nur fuer den Studio-Test (DebugService): jedes Baerchi im Inkubator
-- bruetet sofort ein Ei.
function IncubatorService.breedNow(player: Player): number
	local data = PlayerService.getData(player)
	if not data then return 0 end
	for _, entry in breedersOf(data) do
		local baerchi = data.island.baerchis[entry.uid]
		if baerchi then
			entry.lastEggAt -= IncubatorRules.breedSeconds(baerchi.rarity, data.island.incubator.level)
		end
	end
	local made = breed(player, data, false)
	PlayerService.markDirty(player)
	return made
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function IncubatorService.init()
	RateLimiter.connect(Remotes.RequestIncubatorStart, "RequestIncubatorStart", function(player, eggType: any)
		if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then return end
		IncubatorService.start(player, eggType :: Types.EggType)
	end)

	RateLimiter.connect(Remotes.RequestIncubatorCollect, "RequestIncubatorCollect", function(player, index: any)
		if index == "all" then
			IncubatorService.collectAll(player)
			return
		end
		if typeof(index) ~= "number" or index ~= math.floor(index) or index < 1 or index > IncubatorConfig.MAX_SLOTS then return end
		IncubatorService.collect(player, index)
	end)

	RateLimiter.connect(Remotes.RequestIncubatorSpeedUp, "RequestIncubatorSpeedUp", function(player, index: any)
		if typeof(index) ~= "number" or index ~= math.floor(index) or index < 1 or index > IncubatorConfig.MAX_SLOTS then return end
		IncubatorService.speedUp(player, index)
	end)

	RateLimiter.connect(Remotes.RequestUpgradeIncubator, "RequestUpgradeIncubator", function(player)
		IncubatorService.upgrade(player)
	end)

	-- INCUBATOR_BREED
	RateLimiter.connect(Remotes.RequestIncubatorBaerchi, "RequestIncubatorBaerchi", function(player, action: any, arg: any)
		if action == "put" and typeof(arg) == "string" then
			IncubatorService.putBaerchi(player, arg)
		elseif action == "take" and typeof(arg) == "number" and arg == math.floor(arg)
			and arg >= 1 and arg <= IncubatorConfig.MAX_SLOTS then
			IncubatorService.takeBaerchi(player, arg)
		end
	end)

	if breeding() then
		PlayerService.onDataLoaded(function(player, data)
			if not data.island.incubator then return end
			local dirty = returnBrewingEggs(data)
			if cleanBreeders(data) then dirty = true end
			if dirty then PlayerService.markDirty(player) end
			-- Offline-Nachholen, sobald der Inkubator auf dem Plot steht
			-- (die Eier brauchen einen Ort). Hoechstens 30 s warten.
			_offlinePending[player] = true
			task.spawn(function()
				for _ = 1, 60 do
					if MapService.getIncubatorModel(player) or player.Parent == nil then break end
					task.wait(0.5)
				end
				_offlinePending[player] = nil
				if player.Parent == nil then return end
				if not MapService.getIncubatorModel(player) then
					-- Kein Ort fuer Eier: die Offline-Zeit verfaellt (wie volles Lager)
					for _, entry in breedersOf(data) do entry.lastEggAt = os.time() end
					return
				end
				if breed(player, data, true) > 0 then PlayerService.markDirty(player) end
			end)
		end)

		Players.PlayerRemoving:Connect(function(player)
			_offlinePending[player] = nil
		end)

		task.spawn(function()
			while true do
				task.wait(BREED_TICK_SECONDS)
				local ok, err = pcall(breedTick)
				if not ok then
					warn("[IncubatorService] Brut-Takt fehlgeschlagen:", err)
				end
			end
		end)
	end

	print("[IncubatorService] Initialisiert | Plaetze max", IncubatorConfig.MAX_SLOTS,
		"| Baerchi-Brut:", breeding())
end

return IncubatorService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">IndexRewardService</string><ProtectedString name="Source"><![CDATA[--!strict
-- IndexRewardService.luau
-- ServerScriptService/Services/IndexRewardService.luau
--
-- Einzige Zustaendigkeit:
--   - Index-Belohnungen (Sammel-Update 05.10., Paket 7): pruefen, ob eine
--     Kollektion fertig ist, und sie beim Abholen auszahlen.
--
-- Welche Kollektionen es gibt und was sie bringen, steht in
-- Config/IndexRewardConfig. Abgeholt wird bewusst von Hand (kein
-- automatisches Auszahlen) und auch rueckwirkend: wer eine Reihe schon
-- komplett hat, holt sie sofort ab.
--
-- Auszahlung nur ueber die bestehenden Wege: Gummies und GoldGummies ueber
-- EconomyService, Eier ueber EggService.grantEggs, Blaupausen ueber
-- EggTreeService.grantBlueprint. Inkubator-Plaetze werden nicht gespeichert,
-- sondern aus indexClaimed abgeleitet (IndexRewardConfig.incubatorSlots).
--
-- Beobachter an onDataChanged: meldet einmal pro Sitzung, wenn eine neue
-- Belohnung abholbar wird (Hinweis), mit task.defer und ohne markDirty —
-- er aendert nichts am Spielstand.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Players             = game:GetService("Players")

local Types             = require(ReplicatedStorage.Network.Types)
local Remotes           = require(ReplicatedStorage.Network.Remotes)
local Loc               = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags      = require(ReplicatedStorage.Config.FeatureFlags)
local IndexRewardConfig = require(ReplicatedStorage.Config.IndexRewardConfig)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local EggService     = require(ServerScriptService.Services.EggService)
local EggTreeService = require(ServerScriptService.Services.EggTreeService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local IndexRewardService = {}

-- Was dieser Spieler in dieser Sitzung schon als abholbar gemeldet bekam.
local _announced: { [Player]: { [string]: boolean } } = {}

local function fail(player: Player, reason: Types.LocMsg)
	Remotes.ActionFailed:FireClient(player, "RequestClaimIndexReward", reason)
end

function IndexRewardService.claim(player: Player, rewardId: string): Types.IndexRewardResult?
	if not FeatureFlags.isOn("INDEX_REWARDS") then return nil end
	local data = PlayerService.getData(player)
	if not data then return nil end

	local entry = IndexRewardConfig.get(rewardId)
	if not entry then
		fail(player, Loc.msg("err.index_reward_unknown"))
		return nil
	end
	if data.indexClaimed[rewardId] then
		fail(player, Loc.msg("err.index_reward_claimed"))
		return nil
	end
	if not IndexRewardConfig.isComplete(entry, data.discovered) then
		local have, total = IndexRewardConfig.progress(entry, data.discovered)
		fail(player, Loc.msg("err.index_reward_incomplete", { have = have, total = total }))
		return nil
	end

	-- Erst als abgeholt markieren, dann auszahlen: ein zweiter Klick im
	-- selben Moment findet den Haken schon gesetzt.
	data.indexClaimed[rewardId] = true

	local reward = entry.reward
	local result: Types.IndexRewardResult = {
		rewardId       = rewardId,
		gummies        = 0,
		goldGummies    = 0,
		eggType        = reward.eggType,
		eggs           = 0,
		blueprints     = reward.blueprints,
		incubatorSlots = reward.incubatorSlots,
	}
	if reward.gummies > 0 then
		result.gummies = EconomyService.awardGummies(player, reward.gummies)
	end
	if reward.goldGummies > 0 then
		result.goldGummies = EconomyService.awardGoldGummies(player, reward.goldGummies)
	end
	if reward.eggType and reward.eggs > 0 and EggService.grantEggs(player, reward.eggType, reward.eggs) then
		result.eggs = reward.eggs
	end
	if reward.blueprints > 0 then
		EggTreeService.grantBlueprint(player, data, reward.blueprints)
	end

	Remotes.IndexRewardReceived:FireClient(player, result)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	print("[IndexRewardService]", player.Name, "| abgeholt:", rewardId)
	return result
end

local function onDataChanged(player: Player, data: Types.PlayerData)
	if not FeatureFlags.isOn("INDEX_REWARDS") then return end
	local seen = _announced[player]
	if not seen then
		-- Erster Stand der Sitzung: was schon abholbar ist, zeigt das "!" am
		-- Index; ein Extra-Hinweis kommt nur fuer NEU fertige Reihen.
		seen = {}
		for _, id in IndexRewardConfig.claimable(data.discovered, data.indexClaimed) do
			seen[id] = true
		end
		_announced[player] = seen
		return
	end
	local fresh: { string } = {}
	for _, id in IndexRewardConfig.claimable(data.discovered, data.indexClaimed) do
		if not seen[id] then
			seen[id] = true
			table.insert(fresh, id)
		end
	end
	if #fresh > 0 then
		task.defer(function()
			if player.Parent then
				Remotes.EventNotice:FireClient(player, Loc.msg("msg.index_reward_ready"), "good")
			end
		end)
	end
end

function IndexRewardService.init()
	RateLimiter.connect(Remotes.RequestClaimIndexReward, "RequestClaimIndexReward", function(player, rewardId: any)
		if typeof(rewardId) ~= "string" or #rewardId > 64 then return end
		IndexRewardService.claim(player, rewardId)
	end)
	PlayerService.onDataChanged(onDataChanged)
	Players.PlayerRemoving:Connect(function(player)
		_announced[player] = nil
	end)
	print("[IndexRewardService] Initialisiert |", #IndexRewardConfig.ENTRIES, "Belohnungen")
end

return IndexRewardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">MapService</string><ProtectedString name="Source"><![CDATA[--!strict
-- MapService.luau
-- ServerScriptService/Services/MapService.luau
--
-- Einzige Zustaendigkeit:
--   - Die einzige Schnittstelle zur gebauten Welt: Welt beim Start bauen
--     lassen, Spieler-Plots vergeben, spawnen, neu aufbauen und despawnen,
--     und die sichtbaren Teile aktuell halten (Schilder, Figur, Teich, Eier,
--     Lauf-Turm, Tower-Turm, Event-Pit)
--
-- Das eigentliche BAUEN steht in den Modulen unter Util/MapBuild (MapParts,
-- WorldBuilder, PlotBuilder, PondBuilder, ArenaBuilder, FigureBuilder,
-- LaidEggBuilder). Dieser Service haelt den Zustand (welcher Spieler welchen
-- Slot und welches Plot-Model hat) und entscheidet, WANN gebaut wird. Andere
-- Services sprechen nur mit MapService, nie mit den Buildern.
--
-- Baut physische Roblox-Parts aus IslandData.
-- Kennt keine Spielerdaten ausser IslandData (und den Namen fuer das Schild).
--
-- Alle Masse, Farben und Offsets kommen aus MapConfig. Wie das plot-lokale
-- Koordinatensystem funktioniert (lokales -Z = Richtung Mitte, +Z = nach
-- aussen), steht im Kopf von MapConfig.
--
-- ZWEI ARTEN VON AKTUALISIERUNG — bewusst getrennt:
--   * NEU BAUEN (updateBaerchis, updateBuildingLooks, updateTowerShowcase):
--     teuer, nur wenn sich die Struktur aendert (ein Baerchi kommt dazu, faellt
--     weg oder steigt im Level; ein Gebaeude wechselt den Look; der Tower-Turm
--     bekommt einen neuen Look oder Rekord).
--   * IN-PLACE (updateBaerchiStates, updateBuildingSigns): billig, aendert nur
--     Beschriftung und Transparenz an bereits stehenden Teilen. Dafuer gibt es
--     die Trennung: HP und Honig aendern sich staendig, und dafuer jedes Mal
--     25 Mesh-Figuren neu zu bauen waere Verschwendung.
--   PlotDisplayService entscheidet welche der beiden noetig ist.
--
-- NEUAUFBAU WAEHREND EINER BEWEGUNG — die eine Sperre in dieser Datei:
-- updateBaerchis zerstoert die Figur und baut sie neu. Laeuft sie in dem
-- Moment gerade (Kampf-Lauf oder Weg zum Honig-Teich), verschwaende sie mitten
-- im Schritt. Die Pruefung dagegen steht EINMAL hier drin statt an jeder
-- Aufrufstelle — und der uebersprungene Neuaufbau wird nachgeholt, sobald das
-- Schloss frei ist (siehe scheduleRebuildWhenFree weiter unten). Ohne das
-- Nachholen bliebe die Beschriftung dauerhaft veraltet, weil der Aufrufer
-- (PlotDisplayService) den neuen Stand direkt danach als "dargestellt" merkt.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig = require(ReplicatedStorage.Config.MapConfig)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types     = require(ReplicatedStorage.Network.Types)
local WorldText = require(ReplicatedStorage.Localization.WorldText)
local Loc       = require(ReplicatedStorage.Localization.Loc)

local ActivityLock = require(ServerScriptService.Util.ActivityLock)
local FigureFX     = require(ServerScriptService.Util.FigureFX)

local MapBuild       = ServerScriptService.Util.MapBuild
local MapParts       = require(MapBuild.MapParts)
local WorldBuilder   = require(MapBuild.WorldBuilder)
local PlotBuilder    = require(MapBuild.PlotBuilder)
local PondBuilder    = require(MapBuild.PondBuilder)
local ArenaBuilder   = require(MapBuild.ArenaBuilder)
local FigureBuilder  = require(MapBuild.FigureBuilder)
local LaidEggBuilder = require(MapBuild.LaidEggBuilder)
local IncubatorConfig = require(ReplicatedStorage.Config.IncubatorConfig)
local RecyclerBuilder = require(MapBuild.RecyclerBuilder)
local IncubatorBuilder = require(MapBuild.IncubatorBuilder)   -- Sammel-Update Paket 8
local TerminalBuilder  = require(MapBuild.TerminalBuilder)    -- 08.10. Tower-Terminal

--------------------------------------------------------------------------------
-- Interner Zustand
--------------------------------------------------------------------------------

-- Welcher Slot gehoert welchem Spieler
local _playerSlot: { [Player]: number } = {}

-- Alle gespawnten Plot-Models, key = Player
local _plotModels: { [Player]: Model } = {}

-- Verfuegbare Slots (1 .. PLOT_COUNT), wird in init() gefuellt
local _freeSlots: { number } = {}

-- Fuer welche Spieler gerade ein Waechter darauf wartet, den wegen
-- ActivityLock uebersprungenen Figuren-Neuaufbau nachzuholen. Verhindert, dass
-- mehrere Datenaenderungen waehrend derselben Bewegung mehrere Warte-Schleifen
-- starten — eine reicht, sie liest am Ende ohnehin frische Daten.
local _pendingRebuild: { [Player]: boolean } = {}

-- Woher der nachgeholte Neuaufbau seine FRISCHEN IslandData bekommt.
--
-- Absichtlich als eingehaengte Funktion statt eines require(PlayerService):
-- PlayerService requiret bereits MapService, der umgekehrte Weg waere ein
-- Ringschluss. Ausserdem bleibt damit die Regel
-- im Kopf dieser Datei gueltig — MapService kennt weiterhin keine
-- Spielerdaten ausser IslandData. Eingehaengt wird sie von
-- PlotDisplayService.init(); ohne sie faellt nur das Nachholen aus.
local _islandDataProvider: ((Player) -> Types.IslandData?)? = nil

-- v15: zuletzt gesetzter Tower-Turm und Tower-Symbol am Plot-Schild pro
-- Spieler. MapService kennt die Tower-Daten nicht (sie liegen ausserhalb von
-- IslandData) — PlotDisplayService setzt beides; gemerkt wird es hier, damit
-- ein Neuaufbau des Plots (Rebirth) Turm und Symbol sofort wieder mitbaut.
local _showcase: { [Player]: ArenaBuilder.ShowcaseView } = {}
-- Sammel-Update Paket 8: Platz-Zahl des Inkubators (siehe setIncubatorSlotProvider)
local _incubatorSlots: (Player) -> number = function(_player: Player): number return 1 end
type Badge = { text: string, color: Color3 }
local _badge: { [Player]: Badge } = {}
local _crown: { [Player]: boolean } = {}   -- Paket 9: Top 10 der Endless-Woche
-- 08.10.: zuletzt gesetzter Terminal-Zustand (Neuaufbau nach Rebirth baut ihn mit)
local _terminal: { [Player]: TerminalBuilder.TerminalView } = {}

local function badgeText(player: Player, text: string | Types.LocMsg): string | Types.LocMsg
	return if _crown[player] then Loc.msg("fmt.append", { a = "♛", b = text }) else text
end

--------------------------------------------------------------------------------
-- Plot-Inhalt
--------------------------------------------------------------------------------

-- Baut den kompletten Inhalt eines Plots (Gebaeude + Bruecke + PIT + Baerchis).
local function buildPlotContents(plotModel: Model, slot: number, islandData: Types.IslandData, owner: Player)
	local pool = PondBuilder.honeyPool(islandData)
	for _, building in islandData.buildings do
		PlotBuilder.buildBuilding(plotModel, slot, building, pool)
	end

	ArenaBuilder.buildBridge(plotModel, slot)
	ArenaBuilder.buildPit(plotModel, slot)
	PondBuilder.buildPond(plotModel, slot, islandData)
	RecyclerBuilder.build(plotModel, slot, islandData.recycler)
	-- Sammel-Update Paket 8: Inkubator (Plaetze liefert der Daten-Lieferant,
	-- weil sie auch an Rebirths und Index haengen, die nicht in der Insel stehen).
	if FeatureFlags.isOn("INCUBATOR") and islandData.incubator then
		IncubatorBuilder.build(plotModel, slot, islandData.incubator, _incubatorSlots(owner), islandData.baerchis)
	end
	-- 08.10.: Tower-Terminal am Stegbeginn (Zustand nur als Attribute)
	if FeatureFlags.isOn("TOWER_TERMINAL") then
		TerminalBuilder.build(plotModel, slot, _terminal[owner])
	end
	FigureBuilder.renderBaerchis(plotModel, slot, islandData)
	LaidEggBuilder.renderLaidEggs(plotModel, slot, islandData, owner)

	-- v15: Tower-Turm und Symbol, falls schon bekannt (nach einem Rebirth).
	local view = _showcase[owner]
	if view then
		ArenaBuilder.buildShowcase(plotModel, slot, view)
	end
	local badge = _badge[owner]
	if badge then
		PlotBuilder.writeOwnerBadge(plotModel, badgeText(owner, badge.text), badge.color)
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

local MapService = {}

local function claimSlot(): number?
	if #_freeSlots == 0 then return nil end
	return table.remove(_freeSlots, 1)
end

local function releaseSlot(slot: number)
	table.insert(_freeSlots, slot)
	table.sort(_freeSlots)
end

function MapService.spawnIsland(player: Player, islandData: Types.IslandData)
	-- Alten Slot freigeben falls vorhanden (sollte nicht passieren, aber sicher)
	if _playerSlot[player] then
		MapService.despawnIsland(player)
	end

	local slot = claimSlot()
	if not slot then
		warn("[MapService] Kein freier Plot fuer Spieler:", player.Name)
		return
	end

	_playerSlot[player] = slot

	local plotModel = PlotBuilder.buildPlotBase(slot, player)
	_plotModels[player] = plotModel

	buildPlotContents(plotModel, slot, islandData, player)

	print("[MapService] Plot gespawnt fuer:", player.Name, "| Slot:", slot)
end

-- Baut den Plot eines Spielers komplett neu — behaelt aber seinen Slot,
-- damit er nach einem Rebirth an derselben Stelle der Map steht.
function MapService.rebuildIsland(player: Player, islandData: Types.IslandData)
	local slot = _playerSlot[player]
	if not slot then
		-- Noch kein Plot (z.B. Server voll) → normaler Spawn-Versuch
		MapService.spawnIsland(player, islandData)
		return
	end

	local oldModel = _plotModels[player]
	if oldModel then
		oldModel:Destroy()
	end

	local plotModel = PlotBuilder.buildPlotBase(slot, player)
	_plotModels[player] = plotModel

	buildPlotContents(plotModel, slot, islandData, player)

	print("[MapService] Plot neu aufgebaut fuer:", player.Name, "| Slot:", slot)
end

function MapService.despawnIsland(player: Player)
	-- Ein noch wartender Nachhol-Waechter hat hier nichts mehr zu tun. Er
	-- merkt das zwar selbst beim naechsten Durchlauf (kein Plot mehr), aber so
	-- bleibt kein Eintrag fuer einen laengst gegangenen Spieler stehen.
	_pendingRebuild[player] = nil
	_showcase[player] = nil
	_badge[player] = nil
	_crown[player] = nil
	_terminal[player] = nil

	local model = _plotModels[player]
	if model then
		model:Destroy()
		_plotModels[player] = nil
	end

	local slot = _playerSlot[player]
	if slot then
		releaseSlot(slot)
		_playerSlot[player] = nil
	end
end

-- (v15: updatePitLevel ist entfallen — es gibt kein PIT-Level mehr. Der Turm
-- auf der Arena-Insel zeigt jetzt den Tower-Rekord, siehe updateTowerShowcase.)

-- v15: den Tower-Turm auf der Arena-Insel (neu) bauen. Aufrufer ist
-- PlotDisplayService, und nur wenn sich Look oder Rekord geaendert haben
-- (Signatur). `show` = der LOOK hat gewechselt: kurze Aufwertungs-Show (ein
-- Partikel-Stoss an der Spitze, < 2 s).
function MapService.updateTowerShowcase(player: Player, view: ArenaBuilder.ShowcaseView, show: boolean?)
	_showcase[player] = view

	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end

	local built = ArenaBuilder.buildShowcase(model, slot, view)
	if show then
		local foot = ArenaBuilder.showcaseFoot(slot)
		local height = MapConfig.TOWER_SHOWCASE.plinthHeight + view.floors * MapConfig.TOWER_SHOWCASE.floorHeight
		FigureFX.burstAt(foot + Vector3.new(0, height + 2, 0), view.color, built, 60)
	end
end

-- v15: Tower-Symbol unter dem Namen auf dem Plot-Schild ("◆ III · 42").
function MapService.setOwnerBadge(player: Player, text: string | Types.LocMsg, color: Color3)
	_badge[player] = { text = text, color = color }
	local model = _plotModels[player]
	if model then
		PlotBuilder.writeOwnerBadge(model, badgeText(player, text), color)
	end
end

-- Paket 9: Krone vor dem Plot-Symbol fuer die Top 10 der Endless-Woche.
-- Aufrufer ist LeaderboardService (kennt die Wochenliste).
function MapService.setOwnerCrown(player: Player, crowned: boolean)
	if (_crown[player] == true) == crowned then return end
	_crown[player] = if crowned then true else nil
	local badge = _badge[player]
	local model = _plotModels[player]
	if badge and model then
		PlotBuilder.writeOwnerBadge(model, badgeText(player, badge.text), badge.color)
	end
end

-- Farbe der kurzen Aufwertungs-Show beim Look-Wechsel (v15).
local LOOK_UPGRADE_COLOR = Color3.fromRGB(255, 220, 110)
local LOOK_UPGRADE_SPARKS = 40

-- v15: baut ein Gebaeude (oder den Recycler) NUR neu, wenn sich sein Look
-- geaendert hat (Attribut "Look" am Koerper gegen BuildingBehavior.getLook).
-- PlotDisplayService ruft das, wenn die Look-Signatur wechselt; Level-Aenderungen
-- innerhalb eines Looks laufen ueber das billige updateBuildingSigns.
-- `show` = kurze Aufwertungs-Show (ein Partikel-Stoss, < 2 s).
function MapService.updateBuildingLooks(player: Player, islandData: Types.IslandData, show: boolean?)
	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end

	local pool = PondBuilder.honeyPool(islandData)
	for _, building in islandData.buildings do
		local part = model:FindFirstChild(building.id)
		local look = BuildingBehavior.getLook(building.level)
		if part and part:IsA("BasePart") and part:GetAttribute("Look") ~= look then
			local position = part.Position
			part:Destroy()
			PlotBuilder.buildBuilding(model, slot, building, pool)
			if show then
				FigureFX.burstAt(position, LOOK_UPGRADE_COLOR, model, LOOK_UPGRADE_SPARKS)
			end
		end
	end

	local body = model:FindFirstChild(CombConfig.RECYCLER_NAME)
	local recyclerLook = BuildingBehavior.getLook(islandData.recycler.level)
	if body and body:IsA("BasePart") and body:GetAttribute("Look") ~= recyclerLook then
		local position = body.Position
		body:Destroy()
		RecyclerBuilder.build(model, slot, islandData.recycler)
		if show then
			FigureFX.burstAt(position, LOOK_UPGRADE_COLOR, model, LOOK_UPGRADE_SPARKS)
		end
	end
end

-- Haengt die Quelle fuer frische IslandData ein (siehe _islandDataProvider).
-- Wird einmal beim Start von PlotDisplayService aufgerufen.
function MapService.setIslandDataProvider(provider: (Player) -> Types.IslandData?)
	_islandDataProvider = provider
end

-- Wartet, bis die Figur des Spielers nicht mehr in einer Bewegung steckt, und
-- baut sie dann mit FRISCH gelesenen Daten neu.
--
-- Frisch gelesen ist der entscheidende Teil: waehrend der Bewegung koennen
-- weitere Aenderungen anfallen (mehrere Level-Ups waehrend eines Ess-Zyklus),
-- und nach einem Rebirth ist die alte IslandData-Tabelle gar nicht mehr die
-- des Spielers — sie einfach aufzuheben und spaeter nochmal zu rendern wuerde
-- einen veralteten Stand in die Welt stellen.
local function scheduleRebuildWhenFree(player: Player)
	if _pendingRebuild[player] then return end
	_pendingRebuild[player] = true

	task.spawn(function()
		local interval = MapConfig.FIGURE_REBUILD_RETRY_SECONDS
		local waited   = 0

		while waited < MapConfig.FIGURE_REBUILD_TIMEOUT_SECONDS do
			task.wait(interval)
			waited += interval

			-- Spieler weg oder Plot abgeraeumt: es gibt nichts mehr nachzuholen.
			if player.Parent == nil or _plotModels[player] == nil then
				break
			end

			if ActivityLock.isFree(player) then
				local provider = _islandDataProvider
				local island   = if provider then provider(player) else nil

				-- Vor dem erneuten Aufruf freigeben: updateBaerchis darf, falls
				-- inzwischen doch wieder eine Bewegung laeuft, sauber einen
				-- neuen Waechter starten.
				_pendingRebuild[player] = nil

				if island then
					MapService.updateBaerchis(player, island)
				end
				return
			end
		end

		_pendingRebuild[player] = nil
	end)
end

-- Baut die sichtbaren Baerchis eines Spielers NEU. Teuer — nur aufrufen wenn
-- sich der Bestand oder ein Level geaendert hat (siehe PlotDisplayService).
--
-- Steckt die Figur gerade in einer Bewegung, wird der Neuaufbau verschoben
-- statt sie mitten im Schritt zu ersetzen (Begruendung im Kopf der Datei).
function MapService.updateBaerchis(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	if not ActivityLock.isFree(player) then
		scheduleRebuildWhenFree(player)
		return
	end

	FigureBuilder.renderBaerchis(model, slot, islandData)
	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- Baut die herumliegenden Eier eines Spielers neu.
--
-- Anders als updateBaerchis KEINE ActivityLock-Pruefung: Eier bewegen sich
-- nicht und gehoeren niemandem, der sie gerade animiert. Sie duerfen deshalb
-- auch mitten in einem Kampf oder Weg zum Teich erscheinen und verschwinden —
-- genau das muss sogar sein, weil der Baerchi WAEHREND er laeuft legt.
function MapService.updateLaidEggs(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	LaidEggBuilder.renderLaidEggs(model, slot, islandData, player)
end

-- Haengt den Ei-Einsammel-Handler ein: er laeuft, wenn der BESITZER eines
-- Plots sein eigenes gelegtes Ei mit der Spielfigur beruehrt. Wird einmal
-- beim Start von EggLayService aufgerufen (Pull-Callback statt require:
-- EggLayService requiret bereits MapService, der umgekehrte Weg waere ein
-- Ringschluss). Ohne Handler sammelt Beruehren einfach nichts ein.
function MapService.setEggCollectHandler(handler: (Player, string) -> ())
	LaidEggBuilder.setCollectHandler(handler)
end

-- Rechnet eine Weltposition in das Koordinatensystem des Plots um.
--
-- Gelegte Eier werden PLOT-RELATIV gespeichert, nicht in Weltkoordinaten. Der
-- Grund: welchen der acht Plots ein Spieler bekommt, entscheidet sich bei
-- jedem Join neu (siehe _freeSlots). Absolute Positionen wuerden nach einem
-- Rejoin auf einem anderen Plot liegen — im schlimmsten Fall auf dem eines
-- Nachbarn.
function MapService.worldToPlot(player: Player, worldPosition: Vector3): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end

	local plotCFrame = MapParts.plotCFrame(slot)
	if not plotCFrame then return nil end

	return plotCFrame:PointToObjectSpace(worldPosition)
end

-- Aktualisiert nur Beschriftung und Erschoepfung der bereits stehenden
-- Figuren. Billig — das ist der Weg fuer HP-Aenderungen.
function MapService.updateBaerchiStates(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return end

	for _, baerchi in islandData.baerchis do
		local figure = folder:FindFirstChild("Baerchi_" .. baerchi.uid)
		if figure and figure:IsA("Model") then
			FigureBuilder.writeBaerchiState(figure, baerchi, FigureBuilder.maxHpOf(baerchi))
		end
	end
end

-- Aktualisiert das Level-Attribut einer Gebaeude-Part (fuer Client-UI).
-- Wird nach einem Gebaeude-Upgrade aufgerufen; baut nichts neu.
function MapService.updateBuildingLevel(player: Player, buildingId: Types.BuildingId, level: number)
	local model = _plotModels[player]
	if not model then return end

	local part = model:FindFirstChild(buildingId)
	if part then
		part:SetAttribute("BuildingLevel", level)
	end
end

-- Wohin der Baerchi zum Fressen laeuft.
--
-- Das ist der Standplatz VOR dem Becken (auf den Bohlen), nicht mehr die
-- Beckenmitte. Bis der Teich ein richtiges Becken wurde, war beides dasselbe
-- — und der Baerchi stand mitten im Teich. Jetzt stuende er bis zum Bauch im
-- Beckenboden.
function MapService.getPondPosition(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return PondBuilder.pondStand(slot).Position
end

-- Mitte des Beckens (Weltposition) — z. B. damit gelegte Eier nicht im Honig
-- landen, seit der Baerchi am Becken wohnt (HONEY_POND_V2).
function MapService.getPondCenter(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return PondBuilder.pondGround(slot).Position
end

-- Fuellstand des Teichs nachziehen. Billig — das ist der Weg fuer
-- Honig-Aenderungen (siehe MapService.updateBuildingSigns, das das mit
-- aufruft, weil beides an denselben Werten haengt).
function MapService.updatePondFill(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local slot = _playerSlot[player]
	if not slot then return end

	local pond = model:FindFirstChild("Pond")
	if not pond then return end

	local fill = pond:FindFirstChild("Fuellung")
	if fill and fill:IsA("BasePart") then
		PondBuilder.writePondFill(fill, PondBuilder.pondGround(slot), PondBuilder.pondFillRatio(islandData))
	end
end

-- Schreibt Level und Honig-Lagerstand auf die Gebaeude-Schilder.
-- Billig — das ist der Weg fuer Honig-Aenderungen.
function MapService.updateBuildingSigns(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local pool = PondBuilder.honeyPool(islandData)

	for _, building in islandData.buildings do
		local part = model:FindFirstChild(building.id)
		if part and part:IsA("BasePart") then
			part:SetAttribute("BuildingLevel", building.level)
			PlotBuilder.writeBuildingState(part, building, pool)
		end
	end

	-- Haengt an denselben Werten wie die Gebaeude-Schilder — deshalb hier
	-- gleich mit erledigt statt eines eigenen Aufrufers in PlotDisplayService.
	MapService.updatePondFill(player, islandData)
end

-- Sammel-Update Paket 8: Inkubator-Stand schreiben (Eier, Zeitmarken,
-- verfuegbare Plaetze). Billig; fehlt das Modell, wird es gebaut.
function MapService.updateIncubator(player: Player, islandData: Types.IslandData, slotCount: number)
	if not FeatureFlags.isOn("INCUBATOR") or not islandData.incubator then return end
	local model = _plotModels[player]
	local slot  = _playerSlot[player]
	if not model or not slot then return end
	local existing = model:FindFirstChild(IncubatorConfig.MODEL_NAME)
	if existing and existing:IsA("Model") then
		IncubatorBuilder.writeState(existing, islandData.incubator, slotCount, islandData.baerchis)
	else
		IncubatorBuilder.build(model, slot, islandData.incubator, slotCount, islandData.baerchis)
	end
end

-- INCUBATOR_BREED: das Inkubator-Modell auf dem Plot des Spielers (Ort der
-- gebrueteten Eier), oder nil.
function MapService.getIncubatorModel(player: Player): Model?
	local model = _plotModels[player]
	local found = if model then model:FindFirstChild(IncubatorConfig.MODEL_NAME) else nil
	return if found and found:IsA("Model") then found else nil
end

-- Liefert die Platz-Zahl des Inkubators (setzt PlotDisplayService, weil sie
-- auch an Rebirths und Index-Belohnungen haengt).
function MapService.setIncubatorSlotProvider(provider: (Player) -> number)
	_incubatorSlots = provider
end

-- 08.10.: Zustand des Tower-Terminals (Attribute, kein Neubau). Aufrufer ist
-- PlotDisplayService bei geaenderter Signatur.
function MapService.updateTerminal(player: Player, view: TerminalBuilder.TerminalView)
	_terminal[player] = view
	local model = _plotModels[player]
	local terminal = if model then model:FindFirstChild(TerminalBuilder.MODEL_NAME) else nil
	if terminal and terminal:IsA("Model") then
		TerminalBuilder.writeState(terminal, view)
	end
end

-- Schreibt Level, Warteschlange und Lampe des Waben-Recyclers neu.
-- Billig — der Weg fuer jede Aenderung der Warteschlange.
function MapService.updateRecycler(player: Player, islandData: Types.IslandData)
	local model = _plotModels[player]
	if not model then return end

	local body = model:FindFirstChild(CombConfig.RECYCLER_NAME)
	if body and body:IsA("BasePart") then
		RecyclerBuilder.writeState(body, islandData.recycler)
	end
end

-- Die Anzeigetafel ueber der Arena. Bewusst ueber den exakten Pfad gesucht und
-- nicht rekursiv: unter dem Plot haengen bis zu 25 importierte Mesh-Figuren,
-- deren Teilenamen aus einer .glb stammen und die wir nicht kontrollieren.
-- Eine rekursive Suche wuerde bei einem gleichnamigen Teil das Falsche finden
-- — und muesste bei jeder der bis zu 60 Stages den ganzen Baum durchlaufen.
local function findPitBanner(player: Player): BillboardGui?
	local model = _plotModels[player]
	if not model then return nil end

	local platform = model:FindFirstChild("PitPlatform")
	if not platform then return nil end

	local anchor = platform:FindFirstChild("PitBannerAnchor")
	if not anchor then return nil end

	local banner = anchor:FindFirstChild("Banner")
	return if banner and banner:IsA("BillboardGui") then banner else nil
end

-- Die Anzeigetafel ueber der Arena beschriften und einblenden.
-- Aufgerufen von PitArenaService waehrend einer Wiedergabe; MapService kennt
-- den Kampfverlauf nicht und entscheidet deshalb nichts ueber den Inhalt.
-- Titel und Untertitel duerfen Nachrichten (LocMsg) sein: die Tafel sieht
-- jeder Spieler, und jeder liest sie in seiner Sprache (siehe WorldText).
function MapService.setPitBanner(player: Player, title: string | Types.LocMsg, subtitle: string | Types.LocMsg, color: Color3)
	local banner = findPitBanner(player)
	if not banner then return end

	local titleLabel = banner:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		WorldText.set(titleLabel, title)
		titleLabel.TextColor3 = color
	end

	local subLabel = banner:FindFirstChild("Sub")
	if subLabel and subLabel:IsA("TextLabel") then
		WorldText.set(subLabel, subtitle)
	end

	banner.Enabled = true
end

-- Tafel wieder ausblenden. Idempotent — ein zweiter Aufruf schadet nicht.
function MapService.clearPitBanner(player: Player)
	local banner = findPitBanner(player)
	if banner then
		banner.Enabled = false
	end
end

--------------------------------------------------------------------------------
-- Event-Pit: Farbe und Anzeigetafel von aussen setzbar (EventService)
--------------------------------------------------------------------------------

-- Anders als findPitBanner gibt es das Event-Pit nur EINMAL fuer die ganze
-- Welt, nicht pro Spieler — keine Player-Suche noetig.
local function findEventPitContainer(): Model?
	local platform = workspace:FindFirstChild("Platform")
	if not platform then return nil end

	local pit = platform:FindFirstChild("EventPit")
	return if pit and pit:IsA("Model") then pit else nil
end

export type EventTheme = {
	floorColor : Color3,
	fenceColor : Color3,
	ringColor  : Color3,
}

-- Faerbt Boden, Zaun und Ring des Event-Pits um. Mit `theme = nil` kehrt es
-- zum schlichten Stall-Look zurueck (siehe MapConfig, EVENT_PIT_DEFAULT_*).
-- EventService ruft das genau zweimal pro Zyklus: einmal beim Start eines
-- Events mit dessen Farben, einmal beim Ende mit nil.
function MapService.setEventPitTheme(theme: EventTheme?)
	local container = findEventPitContainer()
	if not container then return end

	local floorColor = if theme then theme.floorColor else MapConfig.EVENT_PIT_DEFAULT_FLOOR_COLOR
	local fenceColor = if theme then theme.fenceColor else MapConfig.EVENT_PIT_DEFAULT_FENCE_COLOR
	local ringColor  = if theme then theme.ringColor  else MapConfig.EVENT_PIT_DEFAULT_RING_COLOR

	-- Material wechselt mit: Wood/SmoothPlastic im Stall-Look, Neon waehrend
	-- eines Events — sonst saehe man den Farbwechsel bei Zaun und Ring kaum,
	-- weil beide im Stall-Look bewusst matt sind.
	local activeMaterial = if theme then Enum.Material.Neon else Enum.Material.Wood
	local ringMaterial   = if theme then Enum.Material.Neon else Enum.Material.SmoothPlastic

	local floor = container:FindFirstChild("EventFloor")
	if floor and floor:IsA("BasePart") then
		floor.Color = floorColor
	end

	local ring = container:FindFirstChild("EventRing")
	if ring and ring:IsA("BasePart") then
		ring.Color    = ringColor
		ring.Material = ringMaterial
	end

	for _, child in container:GetChildren() do
		if child.Name:match("^EventFence_") and child:IsA("BasePart") then
			child.Color    = fenceColor
			child.Material = activeMaterial
		end
	end
end

-- Beschriftet die Countdown-Tafel ueber dem Event-Pit. Anders als
-- setPitBanner blendet das hier NICHT ein/aus — die Tafel steht permanent
-- (siehe buildEventPit): sie zeigt entweder den Countdown bis zum naechsten
-- Event oder Name + Restzeit des laufenden.
function MapService.setEventBanner(title: string | Types.LocMsg, subtitle: string | Types.LocMsg, color: Color3, reward: (string | Types.LocMsg)?)
	local container = findEventPitContainer()
	if not container then return end

	local anchor = container:FindFirstChild("EventBannerAnchor")
	if not anchor then return end

	local banner = anchor:FindFirstChild("Banner")
	if not (banner and banner:IsA("BillboardGui")) then return end

	local titleLabel = banner:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		WorldText.set(titleLabel, title)
		titleLabel.TextColor3 = color
	end

	local subLabel = banner:FindFirstChild("Sub")
	if subLabel and subLabel:IsA("TextLabel") then
		WorldText.set(subLabel, subtitle)
	end

	local rewardLabel = banner:FindFirstChild("Reward")
	if rewardLabel and rewardLabel:IsA("TextLabel") then
		WorldText.set(rewardLabel, reward or "")
	end
end

-- Weltposition der PODEST-OBERFLAECHE des Event-Pits in der Weltmitte.
--
-- Anders als getPitPosition NICHT pro Spieler: das Event-Pit gibt es einmal
-- fuer die ganze Welt (siehe findEventPitContainer). EventParticipationService
-- laesst die Figuren aller teilnehmenden Spieler auf dieselbe Flaeche laufen.
--
-- Der Y-Wert ist dieselbe Rechnung wie in buildEventPit (`floorY`), bewusst
-- aus MapConfig neu gerechnet statt aus der gebauten Geometrie gemessen: die
-- Zahl gehoert der Konfiguration, nicht dem Modell.
function MapService.getEventPitPosition(): Vector3
	local center = MapConfig.CENTER
	local floorY = MapConfig.PLATFORM_TOP_Y
		+ MapConfig.EVENT_PIT_GROUND_CLEARANCE
		+ MapConfig.EVENT_PIT_FLOOR_HEIGHT

	return Vector3.new(center.X, floorY, center.Z)
end

-- Radius der begehbaren Event-Flaeche. EventParticipationService prueft damit
-- serverseitig nach, ob eine Figur tatsaechlich noch dort steht, statt sich auf
-- ein gesetztes Flag zu verlassen.
function MapService.getEventPitRadius(): number
	return MapConfig.EVENT_PIT_RADIUS
end

-- Weltposition der Kampfflaeche dieses Spielers.
-- Wird von PitArenaService benoetigt um die Kaempfer zu platzieren.
function MapService.getPitPosition(player: Player): Vector3?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return MapParts.pitCenter(slot)
end

-- Das CFrame des Plots (Blickrichtung zur Plattform-Mitte).
-- PitArenaService braucht es, um die Kaempfer sinnvoll auszurichten.
function MapService.getPlotCFrame(player: Player): CFrame?
	local slot = _playerSlot[player]
	if not slot then return nil end
	return MapParts.plotCFrame(slot)
end

-- Die stehende Figur eines Baerchis auf dem Plot, falls vorhanden.
-- PitArenaService schickt genau diese Figur in die Arena und wieder zurueck,
-- statt eine zweite Kopie zu bauen — sonst staende derselbe Baerchi doppelt
-- in der Welt.
function MapService.getBaerchiModel(player: Player, baerchiUid: string): Model?
	local model = _plotModels[player]
	if not model then return nil end

	local folder = model:FindFirstChild("Baerchis")
	if not folder then return nil end

	local figure = folder:FindFirstChild("Baerchi_" .. baerchiUid)
	if figure and figure:IsA("Model") then
		return figure
	end
	return nil
end

-- Feiert ein Ereignis (Level-Up, Promotion, Rebirth, ...) SICHTBAR auf dem
-- Plot: Partikel-Stoss, Huepfer, kurzes Aufleuchten (siehe FigureFX.celebrate).
--
-- Bewusst als eigene MapService-Funktion und nicht direkt FigureFX.celebrate
-- vom Aufrufer: der Aufrufer (HoneyService, PromotionService, RebirthService,
-- ...) soll keine Modelle aus der Welt heraussuchen muessen — genau wie bei
-- getBaerchiModel bleibt das MapServices Job. Steht die Figur gerade nicht in
-- der Welt (Plot noch nicht gebaut, Bewegung verzoegert den Neuaufbau), passiert
-- einfach nichts — kein Fehler, der Toast-Text kommt ja trotzdem an.
function MapService.celebrateBaerchi(player: Player, baerchiUid: string, color: Color3)
	local model = MapService.getBaerchiModel(player, baerchiUid)
	if not model then return end

	FigureFX.celebrate(model, color)
end

-- Beschriftung und Transparenz einer Figur mit einem AUSDRUECKLICH
-- angegebenen HP-Wert setzen — auch waehrend eines laufenden PIT-Kampfes.
--
-- Nur fuer PitArenaService: der muss die Figur beim Start der Wiedergabe auf
-- die HP zuruecksetzen, mit denen der Lauf BEGONNEN hat. Die gespeicherten HP
-- stehen zu dem Zeitpunkt laengst auf dem Endwert, der Baerchi saehe sonst
-- schon vor dem ersten Schlag erschoepft aus.
function MapService.setFigureState(model: Model, hp: number, maxHp: number)
	FigureBuilder.writeFigureState(model, hp, maxHp)
end

-- Der Ordner in der Arena, in den die Kampf-Figuren gehoeren.
function MapService.getFighterFolder(player: Player): Folder?
	local model = _plotModels[player]
	if not model then return nil end

	local pit = model:FindFirstChild("PitPlatform")
	if not pit then return nil end

	local fighters = pit:FindFirstChild("Fighters")
	if fighters and fighters:IsA("Folder") then
		return fighters
	end
	return nil
end

-- Baut den PIT-Turm auf genau `level` Etagen aus bzw. ab — idempotent: fehlt
-- eine Etage, wird sie ergaenzt; ist eine zu viel da, wird sie entfernt. Mit
-- `level = 0` verschwindet der Turm komplett.
--
-- PitArenaService ruft das bei jeder Stage mit der neuen Stufenzahl auf, und
-- mit 0 sobald ein Lauf zu Ende ist oder ein neuer beginnt — der Turm bleibt
-- also NIE zwischen zwei Laeufen stehen, genau wie die Kampf-Figuren selbst
-- (siehe clearFighters in PitArenaService).
--
-- Bewegt bei einem Aufbau auch die Anzeigetafel-Verankerung mit nach oben,
-- damit sie ueber dem gewachsenen Turm haengen bleibt statt mittendrin zu
-- stecken.
function MapService.setPitTowerLevel(player: Player, level: number)
	local slot  = _playerSlot[player]
	local model = _plotModels[player]
	if not slot or not model then return end

	local container = model:FindFirstChild("PitPlatform")
	if not container then return end

	local tower = container:FindFirstChild("Tower")
	if not (tower and tower:IsA("Folder")) then return end

	local wanted = math.max(0, math.floor(level))
	local center = MapParts.pitCenter(slot)

	for _, child in tower:GetChildren() do
		local index = tonumber(child.Name:match("^Ring_(%d+)$"))
		if not index or index > wanted then
			child:Destroy()
		end
	end

	for i = 1, wanted do
		if not tower:FindFirstChild("Ring_" .. i) then
			ArenaBuilder.buildTowerRing(tower, center, i)
		end
	end

	local anchor = container:FindFirstChild("PitBannerAnchor")
	if anchor and anchor:IsA("BasePart") then
		local topY = MapConfig.PLATFORM_TOP_Y
			+ wanted * MapConfig.PIT_TOWER_STEP_HEIGHT
			+ MapConfig.PIT_BANNER_HEIGHT
		anchor.CFrame = CFrame.new(center.X, topY, center.Z)
	end
end

-- Hoehe (Y ueber PLATFORM_TOP_Y) der Kampfflaeche bei `level` bereits
-- gewachsenen Etagen. PitArenaService braucht das, um die Kaempfer beim
-- Erklimmen jeder Stage auf die richtige Hoehe zu stellen — dieselbe Formel
-- wie in buildTowerRing, hier aber ohne selbst eine Etage zu bauen.
function MapService.getPitTowerFloorY(level: number): number
	return MapConfig.PLATFORM_TOP_Y + math.max(0, level) * MapConfig.PIT_TOWER_STEP_HEIGHT
end

-- v15: die Bestenlisten-Tafel(n) beschriften (Titel + bis zu
-- LEADERBOARD_BOARD.lines Zeilen). Aufrufer ist LeaderboardService.
-- HBB Paket 5: eine Tafel je Liste; Schluessel = listId, "_rotating" = die
-- eine wechselnde Tafel ohne MAP_V2_BOARDS.
local ROTATING = "_rotating"
local _leaderboardBoards: { [string]: BasePart } = {}
local _liveBoard: BasePart? = nil
local _waspNest: Model? = nil

local function writeBoard(board: BasePart?, title: string, lines: { string }, lineCount: number, titleColor: Color3?)
	if not board then return end
	local surface = board:FindFirstChild("Board")
	if not surface then return end

	local titleLabel = surface:FindFirstChild("Title")
	if titleLabel and titleLabel:IsA("TextLabel") then
		titleLabel.Text = title
		if titleColor then titleLabel.TextColor3 = titleColor end
	end
	for i = 1, lineCount do
		local line = surface:FindFirstChild("Line" .. i)
		if line and line:IsA("TextLabel") then
			line.Text = lines[i] or ""
		end
	end
end

-- Gibt es eine feste Tafel fuer `listId`? (sonst: wechselnde Tafel)
function MapService.hasLeaderboardBoard(listId: string): boolean
	return _leaderboardBoards[listId] ~= nil
end

function MapService.writeLeaderboardBoard(title: string, lines: { string }, listId: string?)
	local board = (if listId then _leaderboardBoards[listId] else nil) or _leaderboardBoards[ROTATING]
	writeBoard(board, title, lines, MapConfig.LEADERBOARD_BOARD.lines)
end

-- HBB Paket 6: Live-Kampf-Board beschriften. Aufrufer ist LiveBoardService.
function MapService.writeLiveBoard(title: string, lines: { string }, live: boolean)
	local cfg = MapConfig.LIVE_BOARD
	writeBoard(_liveBoard, title, lines, cfg.lines, if live then cfg.liveColor else cfg.textColor)
end

-- HBB Paket 6: Schild und Leuchten des Wespen-Nests. Aufrufer ist EventService.
function MapService.setWaspNest(text: string, glowing: boolean)
	local nest = _waspNest
	if not nest then return end
	local cfg = MapConfig.WASP_NEST
	local body = nest:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		body.Material = if glowing then Enum.Material.Neon else Enum.Material.Sand
		body.Color    = if glowing then cfg.glowColor else cfg.color
	end
	local anchor = nest:FindFirstChild("SignAnchor")
	local sign = if anchor then anchor:FindFirstChild("Sign") else nil
	local title = if sign then sign:FindFirstChild("Title") else nil
	if title and title:IsA("TextLabel") then
		title.Text = text
	end
end

-- v15: Teile auf der Insel eines Spielers zaehlen (Debug-Befehl "parts",
-- Budget <= 250 pro Insel ohne Baerchi-Mesh). Getrennt nach Bereichen, damit man
-- sieht, wo das Budget hingeht. Die Figuren (importierte Meshes) zaehlen extra.
function MapService.countParts(player: Player): { [string]: number }?
	local model = _plotModels[player]
	if not model then return nil end

	local result: { [string]: number } = { total = 0, figures = 0 }
	for _, child in model:GetChildren() do
		local count = if child:IsA("BasePart") then 1 else 0
		for _, descendant in child:GetDescendants() do
			if descendant:IsA("BasePart") then count += 1 end
		end
		local key = child.Name
		if key == "Baerchis" then
			result.figures += count
		else
			result[key] = (result[key] or 0) + count
			result.total += count
		end
	end
	return result
end

function MapService.init()
	-- Freie Slots einmalig aufbauen
	for slot = 1, MapConfig.PLOT_COUNT do
		table.insert(_freeSlots, slot)
	end

	-- ============================================================
	-- GEOMETRIE-PRUEFUNG
	-- ============================================================
	-- Die Weltgeometrie haengt an einem guten Dutzend Zahlen, die voneinander
	-- abhaengen. Faellt eine aus dem Rahmen, sieht man das im fertigen Spiel als
	-- Loch im Boden oder als Insel im Nichts — und sucht dann im Code statt in
	-- der Config. Diese vier Pruefungen sagen es beim Start, im Klartext.
	--
	-- Sie WARNEN nur und brechen nicht ab: eine Welt mit einer schiefen Zahl ist
	-- immer noch spielbar, und ein harter Abbruch beim Serverstart waere die
	-- schlechtere Rueckmeldung.

	-- 1. Passt das quadratische Beet auf die runde Plot-Insel? Entscheidend ist
	--    die ECKE, nicht die Kante — eine halbe Diagonale, nicht eine halbe Seite.
	local plateCorner = math.sqrt(
		(MapConfig.PLOT_SIZE.X * 0.5) ^ 2 + (MapConfig.PLOT_SIZE.Z * 0.5) ^ 2
	)
	if plateCorner > MapConfig.PLOT_ISLAND_RADIUS then
		warn(
			"[MapService] Das Beet ragt ueber die Plot-Insel:",
			"halbe Diagonale von PLOT_SIZE =", string.format("%.1f", plateCorner),
			"> PLOT_ISLAND_RADIUS =", MapConfig.PLOT_ISLAND_RADIUS
		)
	end

	-- 2. Liegt der Plot-Ring wirklich eine Steglaenge vor der Hauptinsel?
	--    Sonst waere der Steg entweder zu kurz (Luecke) oder zu lang (er endet
	--    auf der Insel).
	local expectedRing = MapConfig.PLATFORM_RADIUS + MapConfig.ISLAND_GAP + MapConfig.PLOT_ISLAND_RADIUS
	if math.abs(MapConfig.PLOT_RING_RADIUS - expectedRing) > 0.5 then
		warn(
			"[MapService] PLOT_RING_RADIUS passt nicht zur Luecke:",
			MapConfig.PLOT_RING_RADIUS, "sollte", expectedRing, "sein",
			"(PLATFORM_RADIUS + ISLAND_GAP + PLOT_ISLAND_RADIUS)"
		)
	end

	-- 3. Beruehren sich zwei benachbarte Plot-Inseln samt Sandkante?
	local shoreRadius = MapConfig.PLOT_ISLAND_RADIUS + MapConfig.SHORE_WIDTH
	local neighbourGap = 2 * MapConfig.PLOT_RING_RADIUS
		* math.sin(math.pi / MapConfig.PLOT_COUNT) - 2 * shoreRadius
	if neighbourGap <= 0 then
		warn(
			"[MapService] Die Plot-Inseln ueberlappen sich:",
			MapConfig.PLOT_COUNT, "Inseln mit Rand", shoreRadius,
			"auf Ring", MapConfig.PLOT_RING_RADIUS
		)
	end

	-- 4. Reicht das Wasser bis hinter die aeusserste Arena?
	local worldEdge = (MapParts.pitCenter(1) - MapConfig.CENTER).Magnitude
		+ MapConfig.PIT_BASE_RADIUS + MapConfig.SHORE_WIDTH
	if worldEdge > MapConfig.WATER_RADIUS then
		warn(
			"[MapService] Die Arenen ragen ueber den Wasserrand:",
			"Weltrand =", string.format("%.0f", worldEdge),
			"> WATER_RADIUS =", MapConfig.WATER_RADIUS
		)
	end

	WorldBuilder.buildPlatform()
	WorldBuilder.buildGlobalLighting()

	-- v15: Bestenlisten-Tafel(n) (LeaderboardService beschriftet sie).
	-- HBB Paket 5/6: Positionen aus MapLayout (dort auch der Layout-Test).
	local platform = workspace:FindFirstChild("Platform") or workspace
	for _, b in MapLayout.leaderboardBoards() do
		local listId = b.listId
		local name = if listId then "LeaderboardBoard_" .. listId else "LeaderboardBoard"
		_leaderboardBoards[listId or ROTATING] = WorldBuilder.buildLeaderboardBoard(platform, b.angleDegrees, name)
	end
	if FeatureFlags.isOn("MAP_V2_LIVE_BOARD") then
		_liveBoard = WorldBuilder.buildLiveBoard(platform)
	end
	if FeatureFlags.isOn("MAP_V2_WASP_NEST") then
		_waspNest = WorldBuilder.buildWaspNest(platform, MapLayout.waspNestCenter())
	end

	-- Sicherheitsnetz: falls PlayerService den Leave-Fall mal verpasst,
	-- bleibt sonst ein Slot dauerhaft belegt.
	Players.PlayerRemoving:Connect(function(player)
		if _playerSlot[player] then
			MapService.despawnIsland(player)
		end
	end)

	print("[MapService] Initialisiert | Plots:", MapConfig.PLOT_COUNT)
end

return MapService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">PetModeService</string><ProtectedString name="Source"><![CDATA[--!strict
-- PetModeService.luau
-- ServerScriptService/Services/PetModeService.luau
--
-- Einzige Zustaendigkeit:
--   - Die untere Pet-Leiste (Event / Fight) serverseitig entscheiden: was ein
--     Knopfdruck bedeutet (hinschicken, zurueckholen, wechseln) und in welchem
--     Zustand der ausgeruestete Baerchi gerade ist.
--
-- ============================================================
-- WARUM EIN EIGENER SERVICE
-- ============================================================
-- Event-Teilnahme (EventParticipationService) und PIT-Lauf
-- (CombatService/PitArenaService) bewegen dieselbe Figur. Die Leiste macht
-- beides exklusiv und erlaubt den Wechsel per Klick ("erst heim, dann
-- dorthin"). Diese Reihenfolge soll nicht an zwei Services UND dem Client
-- haengen — deshalb entscheidet sie hier, an einer Stelle.
--
-- Der Zustand wird NICHT selbst nachgefuehrt, sondern aus den beiden
-- Services abgelesen (getPhase). Damit kann er nie von der Wirklichkeit
-- abweichen: laeuft die Figur, sagt das der Service, der sie bewegt. Hier
-- liegt nur das VORGEMERKTE Ziel beim Wechsel.
--
-- Zustaende (an den Client ueber PetModeChanged):
--   Home       auf dem Plot (Honig-Teich zaehlt dazu, siehe Konzept)
--   ToEvent    auf dem Weg zum Event-Pit       AtEvent  dort
--   ToPit      auf dem Weg in die eigene Arena  InPit    im Kampf
--   Returning  auf dem Heimweg (von Event oder PIT)
--
-- Ein Klick (RequestPetMode "Event"/"Fight"):
--   - gleicher Modus aktiv         -> zurueckholen
--   - zu Hause                     -> hinschicken
--   - anderer Modus aktiv/Heimweg  -> Ziel vormerken, anderen zurueckholen;
--                                     zu Hause startet das Ziel automatisch.
--                                     Nochmal klicken bricht den Wechsel ab.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Remotes = require(ReplicatedStorage.Network.Remotes)
local Loc     = require(ReplicatedStorage.Localization.Loc)   -- Sammel-Update 2.4

local PlayerService             = require(ServerScriptService.Services.PlayerService)
local CombatService             = require(ServerScriptService.Services.CombatService)
local PitArenaService           = require(ServerScriptService.Services.PitArenaService)
local EventParticipationService = require(ServerScriptService.Services.EventParticipationService)
local RateLimiter               = require(ServerScriptService.Util.RateLimiter)
local FunnelService = require(ServerScriptService.Services.FunnelService)  -- HBB: Messpunkte

local PetModeService = {}

-- Wie oft der Zustand abgelesen und (bei Aenderung) an den Client gemeldet
-- wird. Kurz genug, dass die Leiste sofort reagiert und die Stage-Anzeige
-- mitlaeuft; bei hoechstens acht Spielern vernachlaessigbar.
local TICK_SECONDS = 0.2

export type Mode  = "Event" | "Fight"
type Pending = { mode: Mode, resume: CombatService.ResumeChoice? }

local VALID_RESUME: { [string]: boolean } = { Fresh = true, Percent = true, Last = true }

local _pending: { [Player]: Pending } = {}
local _lastSent: { [Player]: string } = {}

--------------------------------------------------------------------------------
-- Zustand ablesen
--------------------------------------------------------------------------------

-- Gibt Zustand, laufende Stage (nur im PIT) und den Modus zurueck, aus dem
-- ein Heimweg kommt.
local function readState(player: Player): (string, number?, Mode?)
	local pitPhase, stage = PitArenaService.getPhase(player)
	if pitPhase then
		return pitPhase, stage, "Fight"
	end

	local eventPhase = EventParticipationService.getPhase(player)
	if eventPhase then
		return eventPhase, nil, "Event"
	end

	return "Home", nil, nil
end

-- Welcher Modus ist gerade AKTIV (hin oder dort)? Ein Heimweg zaehlt nicht.
local function activeMode(state: string): Mode?
	if state == "ToEvent" or state == "AtEvent" then return "Event" end
	if state == "ToPit" or state == "InPit" then return "Fight" end
	return nil
end

-- Ist der Baerchi zu Hause auf dem Plot? (EggLayService: Legen nur dann)
function PetModeService.isHome(player: Player): boolean
	local state = readState(player)
	return state == "Home"
end

--------------------------------------------------------------------------------
-- Aktionen
--------------------------------------------------------------------------------

local function recall(player: Player, mode: Mode)
	if mode == "Event" then
		EventParticipationService.recall(player)
	else
		PitArenaService.requestRecall(player)
	end
end

local function start(player: Player, mode: Mode, resume: CombatService.ResumeChoice?): boolean
	if mode == "Event" then
		return EventParticipationService.sendToEvent(player)
	end

	local data = PlayerService.getData(player)
	local uid  = if data then data.island.equippedUid else nil
	if not uid then
		Remotes.ActionFailed:FireClient(player, "RequestPetMode", Loc.msg("ui.petbar.no_pet"))
		return false
	end
	return CombatService.startPitRun(player, uid, resume)
end

local function broadcast(player: Player, force: boolean?)
	local state, stage, from = readState(player)
	local pending = _pending[player]
	local abducting = EventParticipationService.isAbducting(player)

	-- v15: in welchem Tower gekaempft wird (Pet-Leiste "Tower II · Stage 23").
	local data = PlayerService.getData(player)
	local tower = if data then data.towers.selected else nil

	local signature = table.concat({
		state,
		tostring(stage),
		tostring(tower),
		tostring(from),
		if pending then pending.mode else "-",
		tostring(abducting),
	}, "|")

	if not force and _lastSent[player] == signature then
		return
	end
	_lastSent[player] = signature

	Remotes.PetModeChanged:FireClient(player, state, if pending then pending.mode else nil, {
		stage     = stage,
		tower     = tower,
		from      = from,
		abducting = abducting,
	})
end

-- Ein Knopfdruck aus der Pet-Leiste.
function PetModeService.request(player: Player, mode: string, resume: CombatService.ResumeChoice?)
	local state = readState(player)
	local active = activeMode(state)

	if mode == "Home" then
		_pending[player] = nil
		if active then recall(player, active) end
		broadcast(player)
		return
	end

	if mode ~= "Event" and mode ~= "Fight" then
		return
	end
	local wanted: Mode = mode :: Mode
	if wanted == "Event" then FunnelService.step(player, "F08_EventButtonPressed") end

	if active == wanted then
		-- Gleicher Knopf nochmal: zurueckholen.
		_pending[player] = nil
		recall(player, wanted)

	elseif state == "Home" then
		_pending[player] = nil
		start(player, wanted, resume)

	else
		-- Anderer Modus aktiv oder Heimweg: Wechsel vormerken bzw. abbrechen.
		local pending = _pending[player]
		if pending and pending.mode == wanted then
			_pending[player] = nil
		else
			_pending[player] = { mode = wanted, resume = resume }
			if active then recall(player, active) end
		end
	end

	broadcast(player)
end

local function tick()
	for _, player in Players:GetPlayers() do
		if not PlayerService.getData(player) then continue end

		-- Vorgemerkter Wechsel: sobald der Baerchi zu Hause ist, losschicken.
		local pending = _pending[player]
		if pending and readState(player) == "Home" then
			_pending[player] = nil
			-- v15: der Start simuliert in Portionen (yieldet) — nicht den Takt
			-- fuer alle anderen Spieler aufhalten.
			task.spawn(start, player, pending.mode, pending.resume)
		end

		broadcast(player)
	end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function PetModeService.init()
	RateLimiter.connect(Remotes.RequestPetMode, "RequestPetMode", function(player, mode: any, resume: any)
		if typeof(mode) ~= "string" then return end

		local choice: CombatService.ResumeChoice? = nil
		if typeof(resume) == "string" and VALID_RESUME[resume] then
			choice = resume :: CombatService.ResumeChoice
		end

		PetModeService.request(player, mode, choice)
	end)

	Players.PlayerRemoving:Connect(function(player)
		_pending[player]  = nil
		_lastSent[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(TICK_SECONDS)
			local ok, err = pcall(tick)
			if not ok then
				warn("[PetModeService] Tick fehlgeschlagen:", err)
			end
		end
	end)

	print("[PetModeService] Initialisiert")
end

return PetModeService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">PitArenaService</string><ProtectedString name="Source"><![CDATA[--!strict
-- PitArenaService.luau
-- ServerScriptService/Services/PitArenaService.luau
--
-- Einzige Zustaendigkeit:
--   - Einen von CombatService fertig simulierten PIT-Lauf in der Arena
--     abspielen und dabei den Lauf ZEITLICH fuehren: Hinweg, Stage fuer Stage,
--     Rueckweg, Zurueckholen und Abbruch
--
-- Zum Fuehren gehoert, dass dieser Service entscheidet, WANN abgerechnet und
-- WANN das Ergebnis verschickt wird — beides haengt an der Wiedergabe:
--   - Abrechnung: CombatService gibt eine Funktion (settle) mit. Sie laeuft
--     GENAU EINMAL mit der Zahl der tatsaechlich gespielten Stages: alle bei
--     normalem Ende, bis einschliesslich der laufenden beim Zurueckholen
--     (requestRecall; vor der ersten Stage: 0), und beim Verlassen so, als
--     waere die begonnene Stage zu Ende gespielt (PlayerService.onPlayerLeaving).
--     WAS abgerechnet wird, weiss nur CombatService; dieser Service fasst
--     Spielerdaten selbst nicht an.
--   - Ergebnis: Remotes.CombatResultReceived geht erst raus, wenn abgerechnet
--     ist. sendResult() ist die einzige Stelle, die es abschickt, und
--     idempotent — alle Abbruch- und Erfolgspfade duerfen es aufrufen.
--   - Phase (ToPit / InPit / Returning) und laufende Stage meldet er fuer
--     die Pet-Leiste (PetModeService liest getPhase).
--
-- Warum auf dem SERVER und nicht im Client: die Arenen liegen in derselben
-- Welt wie alle Plots. Serverseitig kann ein Nachbar ueber den Steg kommen
-- und zuschauen.
--
-- Die Figur wird nicht kopiert, sondern die ECHTE Figur vom Plot wandert in
-- die Arena und danach exakt an ihren Platz zurueck. Eine zweite Kopie waere
-- sonst gleichzeitig auf dem Plot zu sehen.
--
-- ============================================================
-- HEIMKEHR — die eigentliche Schwierigkeit
-- ============================================================
-- Der Ausgangs-Pivot der Figur darf NICHT beim Start jeder Wiedergabe frisch
-- abgelesen werden: startet ein zweiter Lauf waehrend der erste noch laeuft,
-- stuende die Figur da schon in der Arena und wuerde spaeter genau dorthin
-- "zurueckgesetzt". Deshalb merkt sich dieser Service den Platz auf dem Plot
-- getrennt (_home) und raeumt einen laufenden Lauf IMMER erst komplett auf,
-- bevor ein neuer beginnt.
--
-- Abbrechen kann die Wiedergabe ausserdem: der Spieler geht, oder der Plot
-- wird neu gebaut (dann ist die Figur weg). Beides wird geprueft, und in
-- keinem Fall bleibt etwas Halbes stehen.
--
-- ============================================================
-- ZUG UM ZUG
-- ============================================================
-- CombatService gibt pro Stage die einzelnen Zuege mit (Types.FightBeat).
-- Jede Stage wird als Folge von Stoessen gezeigt: die Baerchis laufen
-- aufeinander zu und prallen zusammen (FigureFX.clash). Unter dem eigenen
-- HP-Balken laeuft eine Ladeleiste (Util/FightBars); ist sie voll, kommt die
-- Faehigkeit mit ihrer Show (SkillFX, beim ersten Mal voll, danach als Echo).
-- WELCHE Zuege in die Zeit passen, rechnet FightTimeline.
--
-- startPlayback ist bewusst EINE lange Funktion: sie erzaehlt den Ablauf
-- eines Laufs von vorn nach hinten, und ihre Schritte teilen viel Zustand.
-- Zerlegt in viele kleine Funktionen muesste man zum Verstehen hin und her
-- springen.

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)
local MapConfig   = require(ReplicatedStorage.Config.MapConfig)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local SkillConfig = require(ReplicatedStorage.Config.SkillConfig)
local SkillFXConfig = require(ReplicatedStorage.Config.SkillFXConfig)
local BaerchiMesh = require(ReplicatedStorage.Modules.BaerchiMesh)
local FightTimeline = require(ReplicatedStorage.Modules.FightTimeline)
local Types       = require(ReplicatedStorage.Network.Types)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local Remotes     = require(ReplicatedStorage.Network.Remotes)

local PlayerService   = require(ServerScriptService.Services.PlayerService)
local MapService      = require(ServerScriptService.Services.MapService)
local FigureWalker    = require(ServerScriptService.Util.FigureWalker)
local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)
local RateLimiter     = require(ServerScriptService.Util.RateLimiter)   -- Paket 4.3
local FigureFX        = require(ServerScriptService.Util.FigureFX)
local ActivityLock    = require(ServerScriptService.Util.ActivityLock)
local FightBars       = require(ServerScriptService.Util.FightBars)

-- Name unter dem PitArenaService das Bewegungs-Schloss haelt (siehe
-- ActivityLock) — verhindert dass BaerchiAutopilotService den Baerchi
-- waehrend eines Kampf-Laufs zum Honig-Teich abzieht.
local LOCK_HOLDER = "Kampf"

local PitArenaService = {}

-- HBB Paket 5 (MAP_V2_ARENA_SPRINT): auf dem Weg Plot <-> Arena sprintet der
-- Baerchi (MapConfig.ARENA_WALK_SPEED) statt zu gehen — weniger Warten je Lauf.
local function arenaWalkSpeed(): number
	return if FeatureFlags.isOn("MAP_V2_ARENA_SPRINT") then MapConfig.ARENA_WALK_SPEED else MapConfig.WALK_SPEED
end

-- Gleich viele Hopser pro SEKUNDE wie beim Gehen, dafuer weitere: schnelleres
-- Huepfen liest das Auge als Zittern (siehe MapConfig.WALK_BOB_PER_STUD).
local function arenaBobPerStud(): number
	return MapConfig.WALK_BOB_PER_STUD * MapConfig.WALK_SPEED / arenaWalkSpeed()
end

-- Laufende Wiedergabe pro Spieler. Startet ein neuer Lauf, wird der alte
-- Token ungueltig und die alte Schleife beendet sich beim naechsten Schritt.
local _runToken: { [Player]: number } = {}

-- Ergebnis, das der Client noch nicht bekommen hat. Wird gesetzt sobald ein
-- Lauf beginnt und erst gefeuert, wenn der Baerchi sichtbar am Kampf-Spot
-- angekommen ist (siehe sendResult) — vorher liefe die Kampf-UI schon,
-- waehrend er noch zur Arena unterwegs waere. Bleibt die Wiedergabe aus
-- irgendeinem Grund stecken (kein Plot, Fehler waehrend des Laufs), wird an
-- den Abbruchstellen trotzdem gesendet, damit der Client nie ganz ohne
-- Ergebnis dasteht.
--
-- Der Eintrag traegt seinen eigenen Token: `isRunning` verhindert zwar, dass
-- ueberhaupt ein zweiter Lauf waehrend eines laufenden startet, aber ohne den
-- Token wuerde selbst ein knapp daneben abgewiesener Request die
-- Abbruch-Fallbacks eines ANDEREN, spaeter gestarteten Laufs treffen und
-- dessen Ergebnis zu frueh verschicken — genau der Fehler, den sendResult
-- eigentlich beheben soll. sendResult prueft den Token deshalb mit.
-- v12: Abrechnung und Zustand des laufenden Laufs. `entered` = wie viele
-- Stages bereits BEGONNEN haben (fuer die Abrechnung bei Abbruch), `phase`
-- und `stage` fuer die Anzeige, `recall` = Spieler will zurueck.
export type SettleFn = (played: number, recalled: boolean) -> Types.PitRunResult
type Active = {
	token   : number,
	run     : Types.PitRunResult,
	settle  : SettleFn?,
	settled : Types.PitRunResult?,
	sent    : boolean,
	entered : number,
	recall  : boolean,
	beats   : { { Types.FightBeat } }?,   -- v15: Zuege je Stage (Index = Stage im Lauf)
	phase   : string,     -- "ToPit" | "InPit" | "Returning"
	stage   : number?,
}
local _active: { [Player]: Active } = {}

-- Wo die gerade kaempfende Figur auf dem Plot hingehoert. homeFoot ist der
-- Fusspunkt VOR dem Loslaufen (fuer den Weg zurueck), pivot der exakte
-- Ausgangszustand (fuer den abschliessenden Snap in restoreHome).
type Home = { model: Model, pivot: CFrame, homeFoot: Vector3 }
local _home: { [Player]: Home } = {}

-- Sammel-Update 05.10. (Paket 4.3, "schnell den Tower hochfliegen"): Tempo
-- der Wiedergabe je Spieler (1, 2, 4 oder 0 = "Ergebnis sofort"). Die
-- Abrechnung aendert sich NICHT: sie steht ohnehin fest, bevor die Wiedergabe
-- beginnt, und wird am Ende ausgezahlt — schneller abspielen heisst nur
-- schneller ankommen. Gilt ab der naechsten Stage, gemerkt fuer die Sitzung.
local VALID_SPEEDS: { [number]: number } = { [1] = 1, [2] = 2, [4] = 4, [0] = 40 }
local _speed: { [Player]: number } = {}

local function speedFactor(player: Player): number
	return VALID_SPEEDS[_speed[player] or 1] or 1
end

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- Bringt eine noch in der Arena stehende Figur an ihren Platz auf dem Plot
-- zurueck und raeumt ihren Kampf-Balken weg. Idempotent: zweimal aufrufen
-- schadet nicht.
local function restoreHome(player: Player)
	local home = _home[player]
	if not home then return end

	_home[player] = nil

	local model = home.model
	if model.Parent ~= nil then
		FightBars.removeHealthBar(model)
		model:SetAttribute("InArena", nil)

		-- ZUERST abmelden, DANN heimsetzen — nie andersherum. Waehrend des
		-- Kampfs atmet die Figur am Kampf-Spot, ihre gemerkte Ruhelage ist also
		-- die Arena-Position. Ein spaeteres Abmelden wuerde sie genau dorthin
		-- zuruecksetzen und die Heimkehr wieder zunichtemachen.
		FigureFX.stopIdle(model)
		model:PivotTo(home.pivot)

		-- Zuhause angekommen und wieder in Ruhe: `home.pivot` ist garantiert
		-- die saubere Ruhelage, weil startPlayback das Atmen VOR dem Merken
		-- abgeschaltet hat.
		FigureFX.idleBob(model, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
	end
end

-- Alle Gegner-Figuren aus der Arena raeumen.
local function clearFighters(player: Player)
	local fighters = MapService.getFighterFolder(player)
	if not fighters then return end

	for _, child in fighters:GetChildren() do
		child:Destroy()
	end
end

-- Text auf der Anzeigetafel ueber der Arena. Die Tafel selbst gehoert
-- MapService; hier wird nur entschieden WAS draufsteht, weil nur dieser
-- Service den Verlauf des Laufs kennt.
-- v15: "Tower II · Stage 23"
-- Tafel-Texte sind Nachrichten (LocMsg): die Tafel sieht jeder Spieler auf
-- der Plattform, und jeder liest sie in seiner Sprache (MapService/WorldText).
local function stageTitle(towerId: string?, stage: number): Types.LocMsg
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	return Loc.msg("ui.pitboard.stage", { tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), stage = stage })
end

local function showStage(player: Player, towerId: string?, stage: Types.PitStageResult, cleared: number)
	MapService.setPitBanner(
		player,
		stageTitle(towerId, stage.stage),
		-- Sammel-Update 2.4: die Tafel sehen alle Spieler, jeder in seiner
		-- Sprache — deshalb Symbole und Zahlen statt deutscher Woerter.
		if cleared > 0
			then string.format("✔ %d", cleared)
			else "⚔ 1",
		MapConfig.PIT_BANNER_RUNNING
	)
end

local function showSummary(player: Player, run: Types.PitRunResult)
	-- "Geschafft" ist die Zahl gewonnener Stages. Sie kann 0 sein — dann hat
	-- der Baerchi den ersten Gegner nicht ueberlebt, und genau das soll auch
	-- dastehen statt eines beschoenigenden "0 geschafft".
	local won = run.stagesCleared > 0

	MapService.setPitBanner(
		player,
		if won
			then Loc.msg("fmt.append", { a = "✔", b = Loc.msg("ui.pitboard.won", { n = run.stagesCleared }) })
			else Loc.msg("fmt.append", { a = "✖", b = Loc.msg("ui.pitboard.none") }),
		Loc.msg("event.bonus.gummies", { n = run.gummiesWon }),
		if won then MapConfig.PIT_BANNER_WIN else MapConfig.PIT_BANNER_LOSS
	)
end

-- Schickt das Kampfergebnis an den Client — idempotent, weil mehrere
-- Abbruch- und Erfolgspfade das hier alle "auf gut Glueck" aufrufen koennen.
-- Erst danach darf CombatPanel seine Stage-Wiedergabe starten; siehe die
-- Aufrufstelle in startPlayback fuer den genauen Zeitpunkt (Ankunft am
-- Kampf-Spot).
-- `token` muss zu dem Lauf gehoeren, der sendResult aufruft — sonst koennte
-- der Abbruch-Fallback eines ueberholten Laufs A das laengst neu gesetzte
-- _pendingResult eines inzwischen gestarteten Laufs B verschicken, noch
-- bevor dessen eigener Baerchi angekommen ist.
-- v12: rechnet ab (einmal) und gibt das abgerechnete Ergebnis zurueck. Ohne
-- settle-Funktion (Altaufruf) zaehlt der volle Lauf.
local function settleActive(active: Active, played: number, recalled: boolean): Types.PitRunResult
	if active.settled then
		return active.settled
	end

	local settle = active.settle
	local result = active.run
	if settle then
		local ok, res = pcall(settle, played, recalled)
		if ok then
			result = res
		else
			warn("[PitArenaService] Abrechnung fehlgeschlagen:", res)
		end
	end

	active.settled = result
	return result
end

-- Schickt das ABGERECHNETE Ergebnis an den Client — idempotent und nur fuer
-- den Lauf, zu dem der Token gehoert. Wurde noch nicht abgerechnet (Abbruch),
-- wird hier mit den bereits begonnenen Stages abgerechnet.
local function sendResult(player: Player, token: number)
	local active = _active[player]
	if not active or active.token ~= token or active.sent then return end
	active.sent = true

	local result = settleActive(active, active.entered, active.recall)
	if player.Parent ~= nil then
		Remotes.CombatResultReceived:FireClient(player, result)
	end
end

-- Den Erschoepfungs-Zustand nachziehen, der waehrend der Wiedergabe
-- unterdrueckt war.
local function refreshState(player: Player)
	local data = PlayerService.getData(player)
	if data then
		MapService.updateBaerchiStates(player, data.island)
	end
end

--------------------------------------------------------------------------------
-- Wiedergabe
--------------------------------------------------------------------------------

-- Steht die Wiedergabe noch? Prueft alles was sie abbrechen kann:
-- ein neuer Lauf, der Spieler geht, der Plot wird neu gebaut (Figur weg),
-- oder das PIT wird ausgebaut (dann ist der Kaempfer-Ordner mit zerstoert
-- worden und neue Gegner landeten unsichtbar im Nirgendwo).
local function setPhase(player: Player, token: number, phase: string, stage: number?)
	local active = _active[player]
	if active and active.token == token then
		active.phase = phase
		active.stage = stage
	end
end

local function recallWanted(player: Player, token: number): boolean
	local active = _active[player]
	return active ~= nil and active.token == token and active.recall
end

local function stillValid(player: Player, token: number, figure: Model, fighters: Folder): boolean
	if _runToken[player] ~= token then return false end
	if player.Parent == nil then return false end
	if figure.Parent == nil then return false end
	if fighters.Parent == nil then return false end
	return true
end

-- v12: Laesst den Turm Etage fuer Etage von `fromLevel` auf `toLevel` wachsen
-- (oder schrumpfen) und haelt die Figur dabei immer oben auf der aktuellen
-- Etage. Bei sehr hohen Tuermen wachsen mehrere Etagen pro Schritt, damit es
-- nie laenger als `seconds` dauert. Die Figur darf waehrenddessen NICHT im
-- Idle-Loop sein (der Aufrufer meldet sie ab und danach wieder an).
-- Gibt false zurueck, wenn die Wiedergabe unterwegs ungueltig wurde.
local function rideTower(
	player: Player, token: number, figure: Model, fighters: Folder,
	fromLevel: number, toLevel: number, seconds: number,
	selfPos: Vector3, enemyPos: Vector3
): boolean
	local distance = math.abs(toLevel - fromLevel)
	if distance == 0 then return true end

	-- Hoechstens ~20 Schritte pro Sekunde: mehr sieht niemand, und jeder
	-- Schritt baut bzw. entfernt Teile.
	local steps    = math.max(1, math.min(distance, math.floor(seconds * 20)))
	local stepTime = seconds / steps

	for step = 1, steps do
		if not stillValid(player, token, figure, fighters) then return false end

		local level = fromLevel + math.floor((toLevel - fromLevel) * step / steps + 0.5)
		MapService.setPitTowerLevel(player, level)

		local y = MapService.getPitTowerFloorY(level)
		FigurePlacement.placeLookingAt(
			figure,
			Vector3.new(selfPos.X, y, selfPos.Z),
			Vector3.new(enemyPos.X, y, enemyPos.Z)
		)
		task.wait(stepTime)
	end

	return stillValid(player, token, figure, fighters)
end

local function startPlayback(player: Player, run: Types.PitRunResult, settle: SettleFn?, beats: { { Types.FightBeat } }?)
	-- Das Hochzaehlen des Tokens steht ganz oben und vor allem, was fehlschlagen
	-- kann. Ab hier gehoert die Wiedergabe fuer diesen Spieler UNS — und nur
	-- deshalb darf die Fehlerbehandlung in play() bedenkenlos aufraeumen. Stuende
	-- der Token weiter unten und etwas darueber wuerfe, wuerde play() den Zustand
	-- einer noch laufenden aelteren Wiedergabe zerlegen, die anschliessend
	-- munter weiterliefe: Figur zurueck auf dem Plot, aber weiter Gegner in der
	-- Arena und die Tafel wieder an.
	local token = (_runToken[player] or 0) + 1
	_runToken[player] = token

	-- Ab hier ist der Client faellig fuer dieses Ergebnis. Gefeuert wird es
	-- weiter unten erst bei Ankunft am Kampf-Spot — bricht die Wiedergabe
	-- vorher ab (kein Plot, Fehler), sorgen die Abbruchstellen selbst dafuer,
	-- dass es trotzdem noch rausgeht.
	_active[player] = {
		token   = token,
		run     = run,
		settle  = settle,
		settled = nil,
		sent    = false,
		entered = 0,
		recall  = false,
		beats   = beats,
		phase   = "ToPit",
		stage   = nil,
	}

	-- Ein Kampf hat immer Vorrang vor dem automatischen Weg zum Honig-Teich:
	-- forceAcquire nimmt das Bewegungs-Schloss notfalls dem Autopilot weg.
	-- Der bemerkt das selbst (sein isCancelled prueft den Besitzer) und bricht
	-- sein Hinlaufen sauber ab, statt mit dem Kampf um die Figur zu ringen.
	ActivityLock.forceAcquire(player, LOCK_HOLDER)

	-- Einen noch laufenden Lauf komplett aufraeumen. refreshState gehoert
	-- dazu: dessen Wiedergabe hatte den Zustand der Figur unterdrueckt und
	-- kommt wegen des neuen Tokens nicht mehr dazu, ihn nachzuziehen — der
	-- alte Baerchi staende sonst mit veralteter Beschriftung auf dem Plot.
	--
	-- Das passiert bewusst VOR den Abbruchgruenden unten: auch wenn diese
	-- Wiedergabe gar nicht erst startet, muss die alte sauber beendet sein.
	restoreHome(player)
	refreshState(player)
	clearFighters(player)
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)

	-- Es gibt keine Show — Ergebnis trotzdem rausschicken UND das Schloss
	-- wieder freigeben.
	--
	-- Das Freigeben stand hier frueher nicht: forceAcquire oben nimmt das
	-- Schloss immer, die beiden Abbruchgruende unten kamen aber ohne
	-- release() zurueck. Wer also einmal ohne Plot oder ohne gerenderte Figur
	-- in einen Lauf ging, behielt "Kampf" als Schloss-Besitzer fuer den Rest
	-- der Sitzung — der Autopilot ging nie wieder essen, und seit dem
	-- ActivityLock-Schutz wuerden auch Ausruesten, Verwerten und der
	-- Figuren-Neuaufbau dauerhaft abgelehnt. Nur der Fehler-Pfad
	-- (PitArenaService.play) hat freigegeben, der stille Abbruch nicht.
	local function abortPlayback()
		-- Keine Show moeglich: der Lauf zaehlt trotzdem voll (wie vor v12),
		-- er ist ja schon entschieden.
		local active = _active[player]
		if active and active.token == token then
			active.entered = #run.stages
		end
		sendResult(player, token)
		ActivityLock.release(player, LOCK_HOLDER)
		if _active[player] and _active[player].token == token then
			_active[player] = nil
		end
	end

	local center     = MapService.getPitPosition(player)
	local plotCFrame = MapService.getPlotCFrame(player)
	local fighters   = MapService.getFighterFolder(player)
	local figure     = MapService.getBaerchiModel(player, run.baerchiUid)

	-- Fehlt irgendetwas davon (kein Plot, kein Mesh-Template, Figur nicht
	-- gerendert), gibt es einfach keine Show. Der Lauf selbst ist davon
	-- unberuehrt — er ist laengst abgerechnet.
	if not center or not plotCFrame or not fighters or not figure then
		abortPlayback()
		return
	end

	-- typeof statt nur #: kaeme ein Lauf ohne stages-Tabelle herein, waere das
	-- sonst ein Fehler mitten in der Abrechnung statt einer stillen Nicht-Show.
	if typeof(run.stages) ~= "table" or #run.stages == 0 then
		abortPlayback()
		return
	end

	-- Ruhe-Atmen abschalten, BEVOR die Heimatposition gemessen wird: die Figur
	-- schwebt sonst gerade um einen Bruchteil ihres Hubs ueber der Ruhelage,
	-- und genau dieser Versatz wanderte dann in _home.pivot — nach jedem Kampf
	-- staende sie ein Stueckchen hoeher als vorher. stopIdle setzt sie dafuer
	-- selbst auf ihre Ruhelage zurueck.
	FigureFX.stopIdle(figure)

	local homeFoot = FigurePlacement.footOf(figure)   -- Sammel-Update 1.2
	_home[player] = { model = figure, pivot = figure:GetPivot(), homeFoot = homeFoot }

	local maxHp = math.max(1, run.maxHp)

	-- v14: welche Faehigkeit gezeigt wird (SkillFX). Die volle Show laeuft
	-- beim ersten Einsatz eines Laufs, danach nur ein kurzes Echo — sonst
	-- wuerde ein Lauf mit vielen Stages Minuten dauern.
	local fxData = PlayerService.getData(player)
	local fxBaerchi = fxData and fxData.island.baerchis[run.baerchiUid]
	local fxSkillId: string? = fxBaerchi and fxBaerchi.skillId
	local fxShownFull = false

	-- v15: Ladeleiste nur, wenn die Faehigkeit ueberhaupt aufgeladen wird
	-- (Passive und Grundschlag haben charge = 0).
	local fxSkill = fxSkillId and SkillConfig.getById(fxSkillId)
	local showsCharge = fxSkill ~= nil and (fxSkill.charge or 0) > 0

	-- Die beiden Kaempfer stehen sich quer zur Bruecke gegenueber, damit man
	-- sie beim Herueberlaufen von der Seite sieht statt hintereinander.
	local side     = plotCFrame.RightVector
	local selfPos  = center - side * MapConfig.FIGHT_SPACING
	local enemyPos = center + side * MapConfig.FIGHT_SPACING

	-- Die Figur gehoert jetzt uns: MapService laesst ihren Zustand in Ruhe,
	-- bis das Attribut wieder weg ist (sonst saehe sie mitten im Kampf
	-- erschoepft aus, weil die HP serverseitig schon final sind).
	figure:SetAttribute("InArena", true)

	-- Die Figur auf den Zustand VOR dem Lauf zuruecksetzen. Die gespeicherten
	-- HP stehen zu diesem Zeitpunkt schon auf dem Endwert — ohne diese Zeile
	-- stuende der Baerchi bereits blass und mit "erschoepft" beschriftet da,
	-- bevor der erste Gegner ueberhaupt erscheint.
	MapService.setFigureState(figure, run.hpBefore, maxHp)

	task.spawn(function()
		local selfFill: Frame? = nil
		local chargeFill: Frame? = nil

		local ok, err = pcall(function()
			-- Erst hinlaufen: der Kampf soll sichtbar ERST beginnen, wenn der
			-- Baerchi an der Plattform angekommen ist, nicht durch einen
			-- Teleport. FigureWalker haelt den Fusspunkt waehrenddessen exakt
			-- auf Plot-/Bruecken-Hoehe.
			FigureWalker.walk(figure, homeFoot, selfPos, {
				speed       = arenaWalkSpeed(),
				bobPerStud  = arenaBobPerStud(),
				isCancelled = function()
					return not stillValid(player, token, figure, fighters) or recallWanted(player, token)
				end,
			})
			if not stillValid(player, token, figure, fighters) then
				sendResult(player, token)
				return
			end

			-- v12: auf dem Hinweg zurueckgeholt — noch keine Stage begonnen.
			-- Abrechnung mit 0 Stages (erstattet eine bezahlte Fortsetzung),
			-- dann von hier aus heimlaufen.
			if recallWanted(player, token) then
				sendResult(player, token)
				setPhase(player, token, "Returning", nil)
				local here = FigurePlacement.footOf(figure)
				FigureWalker.walk(figure, here, homeFoot, {
					speed       = arenaWalkSpeed(),
					bobPerStud  = arenaBobPerStud(),
					isCancelled = function() return not stillValid(player, token, figure, fighters) end,
				})
				return
			end
			setPhase(player, token, "InPit", nil)

			-- Exakte Ausrichtung zum Gegner: der Lauf endet in Laufrichtung,
			-- gekaempft wird aber gegenueber.
			FigurePlacement.placeLookingAt(figure, selfPos, enemyPos)

			-- Ab hier steht der Baerchi am Kampf-Spot und atmet dort — auch
			-- zwischen den Stages und waehrend der Nachlauf-Pause, in der er
			-- sonst reglos herumstuende. Die Ausfallschritte melden ihn dafuer
			-- selbst kurz ab und danach wieder an (FigureFX.clash).
			FigureFX.idleBob(figure, {
				height = MapConfig.IDLE_BOB_HEIGHT,
				rate   = MapConfig.IDLE_BOB_RATE,
			})

			selfFill = FightBars.attachHealthBar(figure, MapConfig.FIGHT_BAR_SELF_COLOR)
			FightBars.tweenFill(selfFill, run.hpBefore / maxHp, 0.01)
			if showsCharge then
				chargeFill = FightBars.attachChargeBar(figure)
			end

			-- (v12: das Ergebnis geht erst nach der Abrechnung am Ende raus.)

			-- Der Gegner der VORHERIGEN Stage wird erst weggeraeumt wenn der
			-- naechste erscheint. Wuerde er am Ende seiner eigenen Stage
			-- verschwinden, waere die entscheidende letzte Niederlage nie zu
			-- sehen — und in der Nachlauf-Pause staende der eigene Baerchi
			-- allein in der Arena.
			local previousEnemy: Model? = nil

			-- Zaehlt die BEREITS gewonnenen Stages fuer die Anzeigetafel.
			-- Absichtlich nicht run.stagesCleared: das ist das Endergebnis und
			-- waere waehrend der Wiedergabe die halbe Spannung vorweggenommen.
			local cleared = 0

			-- Wo der eigene Baerchi zuletzt stand — auf Bodenhoehe, solange
			-- der Turm noch nicht gewachsen ist, sonst auf der aktuellen
			-- Etage. Der Rueckweg nach der letzten Stage startet von hier,
			-- nicht von der urspruenglichen (Boden-)selfPos.
			local finalSelfPos = selfPos

			-- Aktuelle Turmhoehe (Etagen), fuer den Abstieg am Ende.
			local towerNow = 0

			-- ============================================================
			-- v12: FORTSETZUNG — DER TURM WAECHST ERST BIS ZUR STARTSTAGE
			-- ============================================================
			-- Steigt der Baerchi bei Stage 30 ein, wachsen jetzt alle 29
			-- Etagen darunter sichtbar hoch und er faehrt oben mit. Danach
			-- kaempft er auf genau der Hoehe, auf der Stage 30 bei einem Lauf
			-- von vorn stattfinden wuerde — man sieht, wie weit oben man ist.
			-- v15: gestaucht (TowerConfig.getRunFloor), bei 100 Stages hoechstens
			-- RUN_MAX_FLOORS Etagen.
			local baseLevel = TowerConfig.getRunFloor(run.towerId or "I", run.startStage or 1)
			if baseLevel > 0 and not recallWanted(player, token) then
				MapService.setPitBanner(
					player,
					stageTitle(run.towerId, run.startStage or 1),
					"⬆ …",
					MapConfig.PIT_BANNER_RUNNING
				)

				local riseSeconds = math.min(
					MapConfig.PIT_TOWER_RISE_MAX_SECONDS,
					baseLevel * MapConfig.PIT_TOWER_RISE_SECONDS_PER_LEVEL
				)

				FigureFX.stopIdle(figure)
				if not rideTower(player, token, figure, fighters, 0, baseLevel, riseSeconds, selfPos, enemyPos) then
					return
				end
				FigureFX.idleBob(figure, {
					height = MapConfig.IDLE_BOB_HEIGHT,
					rate   = MapConfig.IDLE_BOB_RATE,
				})

				towerNow     = baseLevel
				finalSelfPos = Vector3.new(selfPos.X, MapService.getPitTowerFloorY(baseLevel), selfPos.Z)
			end

			for index, stage in run.stages do
				if not stillValid(player, token, figure, fighters) then return end

				-- v12: zurueckgeholt — die vorige Stage ist fertig gespielt,
				-- weitere beginnen nicht mehr.
				if recallWanted(player, token) then break end

				local active = _active[player]
				if active and active.token == token then
					active.entered = index
				end
				setPhase(player, token, "InPit", stage.stage)

				-- Etage dieser Stage: die erste Stage kaempft noch auf der
				-- normalen Kampfflaeche (Etage 0) — sichtbar identisch mit dem
				-- Boden, den man von der Bruecke kennt. Jede weitere Stage
				-- bekommt eine neue Turmetage obendrauf (siehe MapConfig,
				-- Abschnitt "PIT-TURM").
				-- v12: absolute Etage — bei einer Fortsetzung steht der Turm
				-- schon (siehe oben), Stage 30 kaempft auf Etage 29.
				local towerLevel = TowerConfig.getRunFloor(run.towerId or "I", stage.stage)
				MapService.setPitTowerLevel(player, towerLevel)
				towerNow = towerLevel

				local floorY        = MapService.getPitTowerFloorY(towerLevel)
				local stageSelfPos  = Vector3.new(selfPos.X, floorY, selfPos.Z)
				local stageEnemyPos = Vector3.new(enemyPos.X, floorY, enemyPos.Z)
				finalSelfPos = stageSelfPos

				-- Ist der Turm inzwischen gewachsen, steht der eigene Baerchi
				-- eine Etage tiefer als er jetzt muesste — er wird VOR dem
				-- naechsten Gegner mit hochgestellt. Ruhe-Atmen dafuer kurz
				-- abmelden und an der neuen Stelle neu anmelden, sonst zoegen
				-- Idle-Loop und diese Bewegung im selben Frame an derselben
				-- Figur (dieselbe Reihenfolge wie in restoreHome).
				if towerLevel > 0 then
					FigureFX.stopIdle(figure)
					FigurePlacement.placeLookingAt(figure, stageSelfPos, stageEnemyPos)
					FigureFX.idleBob(figure, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end

				showStage(player, run.towerId, stage, cleared)

				if previousEnemy and previousEnemy.Parent then
					previousEnemy:Destroy()
				end
				previousEnemy = nil

				local enemy = BaerchiMesh.buildEnemy(stageEnemyPos, MapConfig.FIGHT_ENEMY_COLOR)
				local enemyFill: Frame? = nil

				if enemy then
					FigurePlacement.placeLookingAt(enemy, stageEnemyPos, stageSelfPos)
					enemy.Parent = fighters
					enemyFill = FightBars.attachHealthBar(enemy, MapConfig.FIGHT_BAR_ENEMY_COLOR)
					previousEnemy = enemy

					-- Auch der Gegner soll nicht wie ein Standbild dastehen,
					-- solange er noch lebt.
					FigureFX.idleBob(enemy, {
						height = MapConfig.IDLE_BOB_HEIGHT,
						rate   = MapConfig.IDLE_BOB_RATE,
					})
				end

				-- ====================================================
				-- v15: DIE STAGE ZUG UM ZUG
				-- ====================================================
				local stageBeats: { Types.FightBeat } = (beats and beats[index]) or {}
				if #stageBeats == 0 then
					-- Ohne Zuege (aelterer Aufrufer): ein einziger Stoss, der
					-- das Ergebnis zeigt — wie vor v15.
					stageBeats = { {
						actor   = if stage.won then "A" else "B",
						kind    = "hit",
						selfHp  = stage.hpAfter / maxHp,
						enemyHp = if stage.won then 0 else 0.35,
						charge  = 0,
						skillId = nil,
					} }
				end

				local plan = FightTimeline.plan(stageBeats, #run.stages, stage.won)
				local fast  = speedFactor(player)   -- Paket 4.3
				local tempo = plan.tempo / fast

				-- Kurz stehen bleiben, damit man den neuen Gegner sieht.
				task.wait(MapConfig.FIGHT_ENEMY_INTRO_SECONDS * tempo)
				if not stillValid(player, token, figure, fighters) then return end

				for _, beatIndex in plan.indices do
					local beat = stageBeats[beatIndex]
					local isSelf = beat.actor == "A"
					local attacker: Model? = if isSelf then figure else enemy
					local target:   Model? = if isSelf then enemy else figure
					local attackerHome = if isSelf then stageSelfPos else stageEnemyPos
					local targetHome   = if isSelf then stageEnemyPos else stageSelfPos
					local isSkill = FightTimeline.isSkillBeat(beat)

					-- Leisten und Treffer-Rueckmeldung genau im Aufprall.
					local function onImpact()
						local barSeconds = MapConfig.FIGHT_BEAT_SECONDS * tempo * 0.5
						FightBars.tweenFill(selfFill, beat.selfHp, barSeconds)
						FightBars.tweenFill(enemyFill, beat.enemyHp, barSeconds)
						FightBars.setCharge(chargeFill, beat.charge, barSeconds)
						if target and target.Parent ~= nil then
							FigureFX.hitFlash(target, MapConfig.FIGHT_HIT_FLASH_COLOR, MapConfig.FIGHT_HIT_FLASH_SECONDS)
						end
						local contact = (stageSelfPos + stageEnemyPos) * 0.5 + Vector3.new(0, 1.5, 0)
						FigureFX.burstAt(contact, MapConfig.FIGHT_HIT_FLASH_COLOR, fighters,
							MapConfig.FIGHT_BUMP_SPARKS * (if isSkill then 3 else 1))
						FigureFX.soundAt(contact, MapConfig.FIGHT_BUMP_SOUND,
							MapConfig.FIGHT_BUMP_VOLUME * (if isSkill then 1.6 else 1), fighters,
							0.9 + math.random() * 0.25)
					end

					if beat.kind == "stunned" then
						-- Betaeubt: kein Stoss, die Figur taumelt.
						if attacker then
							FightBars.setCharge(chargeFill, beat.charge, 0.1)
							FigureFX.stagger(attacker, MapConfig.FIGHT_BEAT_SECONDS * tempo)
						else
							task.wait(MapConfig.FIGHT_BEAT_SECONDS * tempo)
						end
					else
						-- Faehigkeit: Leiste leuchtet voll auf, die Show laeuft,
						-- dann der wuchtige Stoss.
						if isSkill and isSelf then
							FightBars.setCharge(chargeFill, 1, 0.1)
							local showId = beat.skillId or fxSkillId
							if showId then
								-- Paket 4.3: im Schnelldurchlauf nur das kurze Echo
								local full = not fxShownFull and fast <= 1
								fxShownFull = true
								Remotes.SkillFXPlay:FireAllClients({
									owner    = player.UserId,
									skillId  = showId,
									full     = full,
									attacker = figure,
									target   = enemy,
									center   = (stageSelfPos + stageEnemyPos) / 2,
								})
								task.wait(SkillFXConfig.getDuration(showId, full) * (if full then 1 else tempo))
								if not stillValid(player, token, figure, fighters) then return end
							end
						end

						local seconds = FightTimeline.beatSeconds(beat) * tempo
						if attacker then
							FigureFX.clash(attacker, target, attackerHome, targetHome, {
								seconds   = seconds,
								gap       = MapConfig.FIGHT_CONTACT_GAP,
								hop       = MapConfig.FIGHT_HOP_HEIGHT * (if isSkill then 1.6 else 1),
								knockback = if isSkill then MapConfig.FIGHT_SKILL_KNOCKBACK else MapConfig.FIGHT_KNOCKBACK,
								step      = MapConfig.FIGHT_ENEMY_STEP_SHARE,
								onImpact  = onImpact,
							})
						else
							-- Gegner-Mesh fehlt: nur Leisten und Funken.
							onImpact()
							task.wait(seconds)
						end
					end

					if not stillValid(player, token, figure, fighters) then return end
				end

				-- Leisten auf den echten Endstand der Stage (falls Zuege
				-- ausgelassen wurden, stimmt so trotzdem alles).
				FightBars.tweenFill(selfFill, stage.hpAfter / maxHp, 0.15)
				FightBars.tweenFill(enemyFill, if stage.won then 0 else stageBeats[#stageBeats].enemyHp, 0.15)

				if stage.won then
					cleared += 1

					-- Besiegter Gegner kippt um, bevor der naechste kommt.
					-- Beim letzten Gegner macht das die Nachlauf-Pause unten.
					if index < #run.stages and enemy and enemy.Parent ~= nil then
						FigureFX.defeatCollapse(enemy, MapConfig.FIGHT_KO_SECONDS * tempo)
					end
				end
			end

			-- v12: JETZT abrechnen — mit den tatsaechlich gespielten Stages —
			-- und das Ergebnis an den Client schicken.
			local active = _active[player]
			local finalRun = run
			if active and active.token == token then
				finalRun = settleActive(active, active.entered, active.recall)
			end
			sendResult(player, token)

			-- Der letzte Gegner steht waehrend der Nachlauf-Pause noch da;
			-- weggeraeumt wird er unten von clearFighters.
			showSummary(player, finalRun)

			-- Wer die LETZTE Stage verloren hat, kippt sichtbar um, statt
			-- einfach zu verschwinden bzw. unveraendert stehenzubleiben.
			--
			-- Der eigene Baerchi kippt nur, wenn er den Lauf wirklich
			-- erschoepft beendet (hpAfter <= 0). Sonst laeuft er gleich darauf
			-- selbst nach Hause — eine umgekippte Figur, die losmarschiert,
			-- waere schlechter als gar keine Animation. Zurueckgesetzt wird die
			-- Neigung ohnehin von restoreHome.
			local lastStage = finalRun.stages[#finalRun.stages]
			local loser: Model? = nil

			if lastStage and lastStage.won then
				loser = previousEnemy
			elseif finalRun.hpAfter <= 0 then
				loser = figure
			end

			-- Das Umkippen laeuft INNERHALB der Nachlauf-Pause ab, verlaengert
			-- die Wiedergabe also nicht.
			local collapseSeconds = math.min(
				MapConfig.FIGHT_COLLAPSE_SECONDS,
				MapConfig.FIGHT_LINGER_SECONDS
			)

			if loser and loser.Parent ~= nil then
				FigureFX.defeatCollapse(loser, collapseSeconds)
				task.wait(math.max(0, MapConfig.FIGHT_LINGER_SECONDS - collapseSeconds))
			else
				task.wait(MapConfig.FIGHT_LINGER_SECONDS)
			end

			if not stillValid(player, token, figure, fighters) then return end

			-- Ueberlebt (hpAfter > 0): der Baerchi laeuft selbststaendig zu
			-- seinem Platz zurueck. Erschoepft (hpAfter <= 0): er ist ausser
			-- Gefecht und steht einfach wieder normal auf dem Plot — die
			-- anschliessende restoreHome() setzt ihn dafuer direkt zurueck,
			-- ganz ohne Lauf-Animation.
			if finalRun.hpAfter > 0 then
				setPhase(player, token, "Returning", nil)

				-- Vor dem eigenen PivotTo abmelden: sonst zoegen Idle-Loop und
				-- Lauf-Animation im selben Frame an derselben Figur. Wieder
				-- angemeldet wird sie am Ende von restoreHome, auf ihrem Platz.
				FigureFX.stopIdle(figure)

				-- v12: erst mit dem Turm wieder nach unten fahren — sonst liefe
				-- er auf Turmhoehe durch die Luft nach Hause.
				if towerNow > 0 then
					clearFighters(player)
					if not rideTower(player, token, figure, fighters, towerNow, 0, MapConfig.PIT_TOWER_FALL_SECONDS, selfPos, enemyPos) then
						return
					end
					finalSelfPos = selfPos
				end

				FigureWalker.walk(figure, finalSelfPos, homeFoot, {
					speed       = arenaWalkSpeed(),
					bobPerStud  = arenaBobPerStud(),
					isCancelled = function() return not stillValid(player, token, figure, fighters) end,
				})
			end
		end)

		if not ok then
			warn("[PitArenaService] Wiedergabe fehlgeschlagen:", err)
		end

		-- Fallback: ist die Schleife oben aus irgendeinem Grund abgebrochen
		-- oder auf einen Fehler gelaufen, BEVOR der Baerchi angekommen ist,
		-- haette der Client sonst nie ein Ergebnis bekommen. sendResult ist
		-- idempotent — war es schon raus, passiert hier nichts mehr.
		sendResult(player, token)

		-- Nur aufraeumen wenn diese Wiedergabe noch die aktuelle ist —
		-- sonst wuerde man einem bereits gestarteten neuen Lauf die Figur
		-- unter den Fuessen wegziehen.
		if _runToken[player] == token then
			restoreHome(player)
			clearFighters(player)
			MapService.setPitTowerLevel(player, 0)
			MapService.clearPitBanner(player)
			refreshState(player)
			ActivityLock.release(player, LOCK_HOLDER)
			if _active[player] and _active[player].token == token then
				_active[player] = nil
			end
		end
	end)
end

-- Laeuft fuer diesen Spieler gerade eine Wiedergabe (Hinlauf, Stages,
-- Nachlauf oder Ruecklauf)? CombatService fragt das VOR einem neuen
-- RequestStartCombat ab: der Cooldown auf diesem Remote (1s,
-- NetworkConfig) ist kuerzer als eine volle Wiedergabe — ohne diese Sperre
-- koennte ein zweiter Lauf mitten in den ersten hineinstarten und ihm die
-- Figur unter den Fuessen wegziehen.
--
-- _home ist dafuer das richtige Signal: es wird exakt fuer die Dauer einer
-- Wiedergabe gesetzt (startPlayback) und von restoreHome() wieder geleert,
-- egal ob sie normal zu Ende lief oder abgebrochen wurde.
-- HBB Paket 6: alle laufenden Laeufe fuer das Live-Kampf-Board (nur lesen).
function PitArenaService.liveRuns(): { { name: string, towerId: string?, stage: number?, phase: string } }
	local list = {}
	for player, active in _active do
		table.insert(list, {
			name    = player.DisplayName,
			towerId = active.run.towerId,
			stage   = active.stage,
			phase   = active.phase,
		})
	end
	return list
end

function PitArenaService.isRunning(player: Player): boolean
	return _home[player] ~= nil
end

-- Spielt einen fertig ausgerechneten Lauf ab. Kehrt sofort zurueck — die
-- eigentliche Wiedergabe laeuft nebenher.
--
-- Wirft NIE. Der Aufrufer (CombatService) steht mitten in der Abrechnung
-- eines Laufs: ein Fehler in dieser reinen Darstellung darf ihn nicht daran
-- hindern, die Daten zu speichern und den Client zu synchronisieren. Und er
-- darf vor allem keine Figur mit gesetztem "InArena" zuruecklassen — die
-- waere fuer den Rest der Sitzung von jeder Zustands-Aktualisierung
-- ausgenommen.
-- v15: `beats` = die Zuege je Stage (Index wie run.stages). Fehlen sie, wird
-- jede Stage als ein einziger Stoss gezeigt.
function PitArenaService.play(player: Player, run: Types.PitRunResult, settle: SettleFn?, beats: { { Types.FightBeat } }?)
	local ok, err = pcall(startPlayback, player, run, settle, beats)
	if ok then return end

	warn("[PitArenaService] Wiedergabe konnte nicht starten:", err)

	-- Aufraeumen was der abgebrochene Start schon angefasst haben koennte.
	-- Das ist nur deshalb gefahrlos, weil startPlayback den Token als ALLERSTES
	-- hochzaehlt: es gibt an dieser Stelle keine fremde Wiedergabe mehr, der
	-- man etwas wegraeumen koennte.
	--
	-- sendResult zuerst: schlug startPlayback ab, noch bevor es das Ergebnis
	-- verschicken konnte, bekaeme der Client sonst nie eins. _runToken[player]
	-- ist an dieser Stelle bereits der Token DIESES Versuchs — startPlayback
	-- setzt ihn als allerersten Schritt, bevor irgendetwas werfen kann.
	sendResult(player, _runToken[player] or 0)
	restoreHome(player)
	clearFighters(player)
	MapService.setPitTowerLevel(player, 0)
	MapService.clearPitBanner(player)
	refreshState(player)
	ActivityLock.release(player, LOCK_HOLDER)
	_active[player] = nil
end

-- v12: Spieler holt den Baerchi zurueck (Pet-Leiste). Auf dem Hinweg kehrt
-- er sofort um; im Kampf endet der Lauf nach der laufenden Stage. Auf dem
-- Rueckweg ist nichts mehr zu tun. true = Anfrage angenommen.
function PitArenaService.requestRecall(player: Player): boolean
	local active = _active[player]
	if not active or active.phase == "Returning" then
		return false
	end
	active.recall = true
	return true
end

-- v12: Phase des laufenden Laufs fuer die Pet-Leiste: "ToPit", "InPit",
-- "Returning" oder nil (kein Lauf). Dazu die laufende Stage (nur im Kampf).
function PitArenaService.getPhase(player: Player): (string?, number?)
	local active = _active[player]
	if not active or _home[player] == nil then
		return nil, nil
	end
	return active.phase, active.stage
end

-- v12: Ist dieser Baerchi gerade in einem noch nicht abgerechneten Lauf?
-- HoneyService lehnt Fuettern dann ab — die Abrechnung setzt die HP am Ende
-- auf den Wert nach der letzten Stage und wuerde eine Heilung dazwischen
-- ueberschreiben.
function PitArenaService.isFighting(player: Player, baerchiUid: string): boolean
	local active = _active[player]
	return active ~= nil and active.settled == nil and active.run.baerchiUid == baerchiUid
end

function PitArenaService.init()
	-- Verlaesst ein Spieler den Server mitten in der Wiedergabe, macht der
	-- Token-Vergleich die laufende Schleife ungueltig. Sein Plot wird ohnehin
	-- despawnt, aufraeumen muss hier nichts mehr.
	Players.PlayerRemoving:Connect(function(player)
		_runToken[player] = nil
		_home[player]     = nil
		_active[player]   = nil
		_speed[player]    = nil
	end)

	-- Paket 4.3: Tempo-Knopf der Pet-Leiste (PetBar).
	RateLimiter.connect(Remotes.RequestPitSpeed, "RequestPitSpeed", function(player, speed: any)
		if typeof(speed) ~= "number" or VALID_SPEEDS[speed] == nil then return end
		_speed[player] = speed
	end)

	-- v12: geht der Spieler mitten im Lauf, wird VOR dem Speichern
	-- abgerechnet — so, als waere die gerade begonnene Stage zu Ende gespielt.
	PlayerService.onPlayerLeaving(function(player)
		local active = _active[player]
		if active then
			settleActive(active, active.entered, active.recall)
		end
	end)

	print("[PitArenaService] Initialisiert")
end

return PitArenaService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX52"><Properties><string name="Name">PitBrawlService</string><ProtectedString name="Source"><![CDATA[--!strict
-- PitBrawlService.luau
-- ServerScriptService/Services/PitBrawlService.luau
--
-- Einzige Zustaendigkeit:
--   - Kampf um die Mitte (Sammel-Update 05.10., Paket 5.2): waehrend eines
--     Events stossen freie Event-Baerchis Spieler-Charaktere, die KEIN
--     eigenes Baerchi im Event haben und ihnen im Pit zu nahe kommen.
--
-- "Erst kaempfen die Baerchis gegenseitig, dann greifen sie den Spieler an,
-- wenn kein Baerchi da ist. Damit kaempfen alle um die Mitte."
--
-- Regeln (Annahmen, Abschnitt 11.10, Zahlen in EventConfig.PIT_BRAWL):
--   * Nur waehrend eines laufenden Events, nur im Pit-Radius.
--   * Wer selbst ein Baerchi am Event hat, wird nie gestossen.
--   * Ein Baerchi, das gerade laeuft/kaempft (busy), greift nicht an — die
--     Duelle der Handler gehen vor.
--   * Kein Festhalten: Abklingzeit je Spieler und je Baerchi.
--   * Ein Stoss = Rueckstoss + kurze Verlangsamung (EventHazardHit wie beim
--     Boss) + kurze Waben-Pause (CombService.pausePickup). Kein Schaden.
--
-- Der Server entscheidet, der Client fuehrt den Stoss an seinem eigenen
-- Charakter aus. EIN Takt fuer alle (kein Thread pro Baerchi). Bei einem
-- Spieler allein passiert nichts (es gibt kein gegnerisches Baerchi).

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types        = require(ReplicatedStorage.Network.Types)
local Remotes      = require(ReplicatedStorage.Network.Remotes)
local EventConfig  = require(ReplicatedStorage.Config.EventConfig)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local EventService              = require(ServerScriptService.Services.EventService)
local EventParticipationService = require(ServerScriptService.Services.EventParticipationService)
local MapService                = require(ServerScriptService.Services.MapService)
local CombService               = require(ServerScriptService.Services.CombService)
local FigureFX                  = require(ServerScriptService.Util.FigureFX)
local FigurePlacement           = require(ServerScriptService.Util.FigurePlacement)

local PitBrawlService = {}

local _playerCool: { [Player]: number } = {}
local _figureCool: { [Model]: number } = {}

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function tick()
	if not EventService.getActive() then return end
	local cfg = EventConfig.PIT_BRAWL
	local participants = EventParticipationService.getParticipants()
	if #participants == 0 then return end

	local center = MapService.getEventPitPosition()
	local radius = MapService.getEventPitRadius()
	local now = os.clock()

	for _, player in Players:GetPlayers() do
		if EventParticipationService.isPresent(player) then continue end
		if now < (_playerCool[player] or 0) then continue end
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if not (root and root:IsA("BasePart")) then continue end
		if flat(root.Position - center).Magnitude > radius then continue end

		-- naechstes freies, fremdes Baerchi in Reichweite
		local best: { player: Player, figure: Model, busy: boolean }? = nil
		local bestDist = cfg.REACH
		for _, part in participants do
			if part.player ~= player and not part.busy and now >= (_figureCool[part.figure] or 0) then
				local foot = FigurePlacement.footOf(part.figure)
				local dist = flat(root.Position - foot).Magnitude
				if dist <= bestDist then
					best, bestDist = part, dist
				end
			end
		end
		if not best then continue end

		local foot = FigurePlacement.footOf(best.figure)
		local away = flat(root.Position - foot)
		local dir = if away.Magnitude > 0.1 then away.Unit else Vector3.new(1, 0, 0)

		_playerCool[player] = now + cfg.PLAYER_COOLDOWN
		_figureCool[best.figure] = now + cfg.BAERCHI_COOLDOWN

		pcall(FigureFX.attackLunge, best.figure, root.Position, cfg.LUNGE_DISTANCE, cfg.LUNGE_SECONDS)
		local hit: Types.HazardHit = {
			push        = dir * cfg.KNOCKBACK_SPEED,
			slowFactor  = cfg.SLOW_FACTOR,
			slowSeconds = cfg.SLOW_SECONDS,
			source      = "brawl",
		}
		Remotes.EventHazardHit:FireClient(player, hit)
		CombService.pausePickup(player, cfg.PICKUP_PAUSE_SECONDS)
	end
end

function PitBrawlService.init()
	Players.PlayerRemoving:Connect(function(player)
		_playerCool[player] = nil
	end)
end

function PitBrawlService.start()
	if not FeatureFlags.isOn("PIT_BRAWL") then return end
	task.spawn(function()
		while true do
			task.wait(EventConfig.PIT_BRAWL.TICK_SECONDS)
			local ok, err = pcall(tick)
			if not ok then
				warn("[PitBrawlService] Takt fehlgeschlagen:", err)
			end
			-- verschwundene Figuren vergessen
			for figure in _figureCool do
				if figure.Parent == nil then _figureCool[figure] = nil end
			end
		end
	end)
	print("[PitBrawlService] Gestartet | Reichweite", EventConfig.PIT_BRAWL.REACH)
end

return PitBrawlService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX53"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source"><![CDATA[--!strict
-- PlayerService.luau
-- ServerScriptService/Services/PlayerService.luau
--
-- Einzige Zustaendigkeit:
--   - Spielerdaten laden (DataStore) und im Speicher halten
--   - Spielerdaten speichern (beim Leave und periodisch)
--   - Insel spawnen/despawnen via MapService
--   - Anderen Services Zugriff auf PlayerData geben
--
-- Kein anderer Service beruehrt den DataStore. Geschrieben wird mit
-- UpdateAsync und einer Sitzungs-Sperre im Spielstand (Util/SessionLock),
-- damit zwei Server nie gegenseitig ihren Fortschritt ueberschreiben. Die
-- Migration alter Spielstaende steht in Util/PlayerMigration.
--
-- Hinweis zu onDataLoaded():
--   PlayerService darf EconomyService NICHT requiren (EconomyService requiret
--   PlayerService — das waere ein Zirkel). Services die beim Join etwas
--   gutschreiben wollen (z.B. HoneyService fuer den Offline-Honig) registrieren
--   deshalb hier einen Callback statt selbst an PlayerAdded zu haengen —
--   nur so ist garantiert dass die Daten zum Zeitpunkt des Callbacks geladen sind.

local Players       = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local QuestProgress   = require(ReplicatedStorage.Modules.QuestProgress)
local ShopRules     = require(ReplicatedStorage.Modules.ShopRules)
local ShopConfig    = require(ReplicatedStorage.Config.ShopConfig)
local MapService      = require(ServerScriptService.Services.MapService)
local RateLimiter     = require(ServerScriptService.Util.RateLimiter)
local PlayerMigration = require(ServerScriptService.Util.PlayerMigration)
local SessionLock     = require(ServerScriptService.Util.SessionLock)

--------------------------------------------------------------------------------
-- Konstanten
--------------------------------------------------------------------------------

local DATA_STORE_NAME = "PlayerData_v1"
-- v1 im Namen: wenn wir das Schema brechen, wird es v2 und alte Daten
-- werden nicht mehr geladen (sauberer als Migration fuer early dev).
-- Nicht-brechende Feld-Ergaenzungen laufen ueber
-- PlayerMigration.applyDefaults().

-- Spaetestens nach so vielen Sekunden wird auf jeden Fall gespeichert.
local SAVE_INTERVAL = 60

-- Fruehestens nach so vielen Sekunden darf derselbe Schluessel wieder
-- geschrieben werden. Roblox drosselt Schreibvorgaenge auf denselben
-- Schluessel unterhalb von etwa sechs Sekunden und verwirft sie irgendwann
-- ganz. saveNow() wird von vielen Stellen aufgerufen (Ei oeffnen,
-- fusionieren, verwerten, kaempfen, zwei Upgrades, Rebirth) — ohne diese
-- Bremse kaeme ein normal spielender Mensch auf mehrere Schreibvorgaenge
-- pro Sekunde.
local MIN_SAVE_GAP = 7

-- Wie oft nachgesehen wird ob jemand faellig ist.
local SAVE_TICK = 5

--------------------------------------------------------------------------------
-- DataStore-Zugriff
--
-- GetDataStore() wirft in einem unveroeffentlichten Place ("You must publish
-- this place to the web to access DataStore") und in Studio ohne aktivierte
-- API-Services. Frueher stand der Aufruf auf Modulebene — ein Fehler dort hat
-- PlayerService, EconomyService und damit den ganzen GameManager mitgerissen.
--
-- Deshalb: verzoegert holen, in pcall, und bei Nichtverfuegbarkeit auf einen
-- reinen Sitzungs-Speicher zurueckfallen. Das Spiel bleibt in Studio komplett
-- testbar (inklusive Leave/Rejoin und Offline-Ertrag), nur ueberlebt der
-- Fortschritt keinen Server-Neustart. Im veroeffentlichten Place greift
-- automatisch der echte DataStore.
--------------------------------------------------------------------------------

local _dataStore: DataStore? = nil
local _dataStoreChecked = false

-- Fallback wenn kein DataStore verfuegbar ist, key = "player_<UserId>"
local _sessionStore: { [string]: Types.PlayerData } = {}

local function getDataStore(): DataStore?
	if _dataStoreChecked then
		return _dataStore
	end
	_dataStoreChecked = true

	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(DATA_STORE_NAME)
	end)

	if ok then
		_dataStore = result
	else
		warn(
			"[PlayerService] DataStore nicht verfuegbar —",
			"Fortschritt wird nur fuer diese Server-Sitzung gehalten.",
			"Grund:", result
		)
	end

	return _dataStore
end

local function storageKey(player: Player): string
	return "player_" .. player.UserId
end

--------------------------------------------------------------------------------
-- Interner Zustand
-- Nur dieser Service liest/schreibt diese Tabelle.
--------------------------------------------------------------------------------

-- Alle geladenen Spielerdaten im Speicher, key = Player
local _playerData: { [Player]: Types.PlayerData } = {}

-- Timestamp des letzten Saves pro Spieler
local _lastSave: { [Player]: number } = {}

-- Spieler die gerade geladen werden (verhindert Doppel-Joins)
local _loading: { [Player]: boolean } = {}

-- Spieler deren Spielstand NICHT geladen werden konnte. Ihre Sitzung ist
-- spielbar, wird aber nie gespeichert — sonst wuerden die frischen
-- Standardwerte den echten Spielstand ueberschreiben.
local _noSave: { [Player]: boolean } = {}

-- Spieler die gespeichert werden wollen, aber gerade in der Schonfrist
-- stecken (siehe MIN_SAVE_GAP). Die Auto-Save-Schleife holt sie nach.
local _pendingSave: { [Player]: boolean } = {}

-- Callbacks anderer Services, ausgefuehrt direkt nach dem Laden
local _onDataLoaded: { (Player, Types.PlayerData) -> () } = {}

-- Callbacks anderer Services, ausgefuehrt nach allen _onDataLoaded
local _onPlayerReady: { (Player, Types.PlayerData) -> () } = {}

-- Callbacks anderer Services, ausgefuehrt bei jedem markDirty
local _onDataChanged: { (Player, Types.PlayerData) -> () } = {}

-- v12: Callbacks, die beim Verlassen (und beim Server-Shutdown) laufen,
-- BEVOR gespeichert wird. Grund: ein PIT-Lauf wird erst am Ende seiner
-- Wiedergabe abgerechnet (PitArenaService). Verlaesst der Spieler mitten im
-- Lauf, muss die Abrechnung noch in den Spielstand, bevor er geschrieben
-- wird — die Reihenfolge zweier PlayerRemoving-Verbindungen ist dafuer
-- nicht verlaesslich genug.
local _onPlayerLeaving: { (Player, Types.PlayerData) -> () } = {}

local function runLeavingCallbacks(player: Player, data: Types.PlayerData)
	for _, callback in _onPlayerLeaving do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[PlayerService] onPlayerLeaving-Callback fehlgeschlagen:", err)
		end
	end
end

--------------------------------------------------------------------------------
-- Hilfsfunktionen (privat)
--------------------------------------------------------------------------------

-- Wie oft das Laden bei einem DataStore-Fehler erneut versucht wird, und wie
-- lange dazwischen gewartet wird (verdoppelt sich jedes Mal).
local LOAD_RETRIES     = 3
local LOAD_RETRY_DELAY = 2

-- Haelt ein anderer Server den Spielstand noch (siehe Util/SessionLock), wird
-- so oft im Abstand von SESSION_WAIT_SECONDS erneut gefragt. Der Normalfall
-- ist ein schneller Serverwechsel: der alte Server schreibt beim Verlassen und
-- gibt die Sperre dabei frei, das dauert Sekunden. Insgesamt 30 Sekunden
-- reichen dafuer und sind kurz genug, dass der Spieler nicht ewig wartet.
local SESSION_WAIT_ATTEMPTS = 5
local SESSION_WAIT_SECONDS  = 6

-- In Studio ist game.JobId leer. Alle Studio-Sitzungen gelten dann als
-- derselbe Server, sonst sperrte man sich beim Neustart einer Testsitzung
-- selbst aus.
local function currentJobId(): string
	return if game.JobId ~= "" then game.JobId else "studio"
end

-- Ein Ladeversuch: liest den Spielstand und traegt im SELBEN Schreibvorgang
-- diesen Server als Halter ein (UpdateAsync ist dafuer atomar). Ergebnis:
--   "ok"     data ist der rohe Spielstand (isNew = frisch angelegt)
--   "locked" ein anderer Server haelt ihn, es wurde nichts geschrieben
--   "error"  der DataStore hat geworfen, data ist die Fehlermeldung
local function tryLoadAndClaim(store: DataStore, key: string): (string, any, boolean)
	local jobId = currentJobId()
	local outcome = "ok"
	local loaded: any = nil
	local isNew = false

	local success, err = pcall(function()
		store:UpdateAsync(key, function(old: any)
			-- Roblox kann diesen Rueckruf mehrfach aufrufen (Konflikt beim
			-- Schreiben). Deshalb setzt jeder Durchlauf alle Ergebnisse neu.
			local now = os.time()
			if old ~= nil and SessionLock.isHeldByOther(old.session, jobId, now) then
				outcome, loaded, isNew = "locked", nil, false
				return nil   -- nil = nichts schreiben
			end

			local data = if old ~= nil then old else Types.createDefaultPlayerData()
			data.session = SessionLock.claim(jobId, now)
			outcome, loaded, isNew = "ok", data, old == nil
			return data
		end)
	end)

	if not success then
		return "error", err, false
	end
	return outcome, loaded, isNew
end

-- Liefert (Spielstand, darf gespeichert werden).
local function loadFromDataStore(player: Player): (Types.PlayerData, boolean)
	local key   = storageKey(player)
	local store = getDataStore()

	-- Kein DataStore (unveroeffentlichter Place / Studio ohne API-Services):
	-- aus dem Sitzungs-Speicher lesen, damit Leave/Rejoin trotzdem testbar ist.
	if not store then
		local cached = _sessionStore[key]
		if cached then
			return PlayerMigration.applyDefaults(cached), true
		end
		return Types.createDefaultPlayerData(), true
	end

	-- Mehrfach versuchen: ein einzelner DataStore-Aussetzer (Drosselung,
	-- Roblox-Stoerung) ist haeufig und geht meist beim zweiten Versuch durch.
	-- Fehler und fremde Sperre werden getrennt gezaehlt, weil sie verschieden
	-- lange brauchen, um sich aufzuloesen.
	local lastError: any = nil
	local errors = 0
	local waits  = 0

	while true do
		local outcome, result, isNew = tryLoadAndClaim(store, key)

		if outcome == "ok" then
			-- Ein frischer Spielstand ist schon aktuell; nur alte Staende
			-- laufen durch die Migration.
			if isNew then
				return result, true
			end
			return PlayerMigration.applyDefaults(result), true
		end

		if outcome == "locked" then
			waits += 1
			if waits >= SESSION_WAIT_ATTEMPTS then
				-- Der andere Server meldet sich weiter. Ihn zu ueberschreiben
				-- hiesse, seinen Fortschritt zu loeschen. Also dieselbe
				-- Behandlung wie ein Lesefehler: spielbar, aber nie gespeichert.
				warn(
					"[PlayerService] Spielstand von", player.Name,
					"wird noch von einem anderen Server gehalten — Sitzung laeuft OHNE Speichern weiter."
				)
				return Types.createDefaultPlayerData(), false
			end
			task.wait(SESSION_WAIT_SECONDS)
		else
			errors += 1
			lastError = result
			if errors >= LOAD_RETRIES then
				break
			end
			task.wait(LOAD_RETRY_DELAY * errors)
		end

		-- Wer waehrend des Wartens geht, braucht keinen Spielstand mehr.
		if player.Parent == nil then
			return Types.createDefaultPlayerData(), false
		end
	end

	-- Auch nach allen Versuchen kein Erfolg. Der Spieler bekommt eine
	-- spielbare Sitzung, aber sie DARF NICHT GESPEICHERT werden:
	-- sonst wuerde der Auto-Save die frischen Standardwerte ueber einen
	-- vollkommen intakten Spielstand schreiben und ihn dauerhaft loeschen.
	warn(
		"[PlayerService] Laden endgueltig fehlgeschlagen fuer", player.Name,
		"— Sitzung laeuft OHNE Speichern weiter. Grund:", lastError
	)
	return Types.createDefaultPlayerData(), false
end

-- Schreibt den Spielstand. release = true beim Verlassen und beim Shutdown:
-- dann wird die Sitzungs-Sperre freigegeben, damit der naechste Server sofort
-- laden kann, statt auf ihren Ablauf zu warten.
local function saveToDataStore(player: Player, data: Types.PlayerData, release: boolean): boolean
	-- Konnte der Spielstand nicht geladen werden, wird auch nicht gespeichert.
	-- Siehe loadFromDataStore: sonst ueberschreibt eine Standard-Datei den
	-- echten Spielstand.
	if _noSave[player] then
		return false
	end

	-- Zeitstempel VOR dem Schreiben setzen. UpdateAsync haelt den Thread an;
	-- stuende die Zeile darunter, wuerde die Auto-Save-Schleife waehrend des
	-- Wartens immer wieder dieselbe Bedingung erfuellen und dutzende
	-- gleichzeitige Schreibvorgaenge auf denselben Schluessel ausloesen.
	_lastSave[player] = os.time()
	data.lastSeenAt   = os.time()

	local key   = storageKey(player)
	local store = getDataStore()

	if not store then
		_sessionStore[key] = data
		return true
	end

	-- UpdateAsync statt SetAsync: es liest den gespeicherten Stand, bevor es
	-- schreibt. Hat inzwischen ein anderer Server die Sperre uebernommen (weil
	-- unsere abgelaufen ist), wird NICHT geschrieben — dessen Stand ist neuer.
	local jobId = currentJobId()
	local lostLock = false

	local success, err = pcall(function()
		store:UpdateAsync(key, function(old: any)
			local now = os.time()
			if old ~= nil and SessionLock.isHeldByOther(old.session, jobId, now) then
				lostLock = true
				return nil
			end
			lostLock = false
			data.session = if release then nil else SessionLock.claim(jobId, now)
			return data
		end)
	end)

	if not success then
		warn("[PlayerService] DataStore-Fehler beim Speichern fuer", player.Name, ":", err)
	elseif lostLock then
		-- Ab jetzt gilt der andere Server. Diese Sitzung schreibt nie wieder,
		-- sonst wechselten sich zwei Staende gegenseitig ab.
		_noSave[player] = true
		warn(
			"[PlayerService] Sitzungs-Sperre von", player.Name,
			"liegt bei einem anderen Server — diese Sitzung speichert nicht mehr."
		)
	end

	-- HBB Paket 10: Rueckmeldung fuer Robux-Kaeufe (ShopService.processReceipt)
	return success and not lostLock
end

-- v15: wer die Login-Bonus-Sicht baut (LoginBonusService haengt sich ein —
-- dort liegt der Debug-Zeitversatz; ein require waere ein Ringschluss).
local _dailyViewProvider: ((Types.PlayerData) -> Types.DailyView)? = nil

local function dailyView(data: Types.PlayerData): Types.DailyView
	local provider = _dailyViewProvider
	if provider then
		local ok, view = pcall(provider, data)
		if ok then return view end
	end
	return { day = 1, claimable = false, streak = 0, resetIn = 0 }
end

-- Baut das Client-Paket aus den Serverdaten.
-- Stats bleiben bewusst draussen (kein Leak sensibler Serverdaten).
-- HBB Paket 10: Sicht fuer das Shop-Fenster
local function shopView(data: Types.PlayerData): Types.ShopView?
	local shop = (data :: any).shop
	if not shop then return nil end
	local now = os.time()
	return {
		freeReady  = ShopRules.freeReady(shop, now),
		nextFreeIn = ShopRules.secondsUntilNextDay(now),
		freeGold   = ShopConfig.FREE_GRAB_GOLD,
	}
end

local function buildUpdate(data: Types.PlayerData): Types.PlayerDataUpdate
	return {
		gummies      = data.gummies,
		goldGummies  = data.goldGummies,
		rebirthCount = data.rebirthCount,
		rebirthMult  = data.rebirthMult,
		rank         = data.rank,
		language     = data.language,
		island       = data.island,
		discovered   = data.discovered,
		quests       = QuestProgress.buildView(data, os.time()),
		eggTree      = data.eggTree,
		towers       = data.towers,
		daily        = dailyView(data),
		-- HBB Paket 2: Zaehler und Konto-Alter fuer Fuehrung/Freischaltung
		stats        = data.stats :: any,
		createdAt    = data.createdAt,
		uiSeen       = data.uiSeen,   -- HBB Paket 3
		shop         = shopView(data),  -- HBB Paket 10
		indexClaimed = data.indexClaimed,   -- Sammel-Update Paket 7
	}
end

-- Sendet den aktuellen Spielerzustand an den Client
-- Wird nach jeder relevanten Aenderung aufgerufen
local function syncToClient(player: Player)
	local data = _playerData[player]
	if not data then return end

	Remotes.PlayerDataUpdated:FireClient(player, buildUpdate(data))
end

--------------------------------------------------------------------------------
-- Oeffentliche API
-- Andere Services rufen diese Funktionen auf.
--------------------------------------------------------------------------------

local PlayerService = {}

-- Gibt PlayerData zurueck — nil wenn noch nicht geladen
function PlayerService.getData(player: Player): Types.PlayerData?
	return _playerData[player]
end

-- Gibt PlayerData zurueck und wirft einen Fehler wenn nicht vorhanden
-- Fuer Services die sicher sind dass der Spieler eingeloggt ist
function PlayerService.getDataOrError(player: Player): Types.PlayerData
	local data = _playerData[player]
	assert(data, "[PlayerService] Keine Daten fuer Spieler: " .. player.Name)
	return data
end

-- Wird von anderen Services aufgerufen nachdem sie Daten veraendert haben.
-- Loest Client-Sync aus. Services aendern Daten direkt auf dem Objekt,
-- rufen dann markDirty() — kein Kopieren, kein Callback-Hell.
function PlayerService.markDirty(player: Player)
	syncToClient(player)

	local data = _playerData[player]
	if not data then return end

	-- Beobachter benachrichtigen (z.B. PlotDisplayService, das die Figuren und
	-- Schilder auf der Insel nachzieht). Ein Callback darf hier NICHT selbst
	-- markDirty aufrufen — das waere eine Endlosschleife.
	for _, callback in _onDataChanged do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[PlayerService] onDataChanged-Callback fehlgeschlagen:", err)
		end
	end
end

-- Nach einer wichtigen Aenderung speichern (Kauf, Kampf, Rebirth).
--
-- "Sofort" nur wenn die Schonfrist abgelaufen ist — sonst wird es lediglich
-- vorgemerkt und die Auto-Save-Schleife holt es nach, sobald sie darf. Ohne
-- das wuerde Roblox die Schreibvorgaenge irgendwann verwerfen, und dann waere
-- ausgerechnet der Fortschritt weg, den dieser Aufruf sichern sollte.
--
-- Der Leave- und der Shutdown-Weg gehen bewusst direkt auf saveToDataStore
-- und umgehen die Bremse: dort gibt es kein spaeter mehr.
function PlayerService.saveNow(player: Player)
	local data = _playerData[player]
	if not data then return end

	if os.time() - (_lastSave[player] or 0) >= MIN_SAVE_GAP then
		saveToDataStore(player, data, false)
	else
		_pendingSave[player] = true
	end
end

-- HBB Paket 10: SOFORT speichern und melden, ob es geklappt hat. Nur fuer
-- Robux-Kaeufe: Roblox verlangt, dass ein Kauf gespeichert ist, bevor
-- ProcessReceipt "gewaehrt" meldet. Umgeht bewusst MIN_SAVE_GAP (Kaeufe sind
-- selten). Blockiert, bis UpdateAsync fertig ist.
function PlayerService.saveConfirmed(player: Player): boolean
	local data = _playerData[player]
	if not data then return false end
	_pendingSave[player] = nil
	return saveToDataStore(player, data, false)
end

-- v15: LoginBonusService haengt hier ein, wie die Login-Bonus-Sicht im
-- Client-Paket gebaut wird.
function PlayerService.setDailyViewProvider(provider: (Types.PlayerData) -> Types.DailyView)
	_dailyViewProvider = provider
end

-- Frische Standard-Insel. Einzige erlaubte Quelle fuer einen Insel-Reset —
-- RebirthService benutzt dies statt Types.createDefaultPlayerData selbst
-- aufzurufen (Regel: nur PlayerService ruft die Default-Fabrik auf).
function PlayerService.buildDefaultIsland(): Types.IslandData
	return Types.createDefaultPlayerData().island
end

-- HBB Paket 0: kompletter Startstand fuer den Debug-Zustand "fresh"
-- (DebugService). Aus demselben Grund wie oben hier und nicht dort.
function PlayerService.buildDefaultData(): Types.PlayerData
	return Types.createDefaultPlayerData()
end

-- Registriert einen Callback der laeuft sobald die Daten eines Spielers
-- geladen und seine Insel gespawnt ist — aber bevor der erste Client-Sync
-- rausgeht. Hier gehoert alles hin, was die Daten beim Join noch aendert
-- (Offline-Honig, Offline-Eier, Ausruesten). Aus init() aufrufen: Spieler
-- werden erst in start() geladen, also verpasst kein Callback einen Join.
--
-- Die Callbacks laufen in Anmelde-Reihenfolge. Keiner darf sich auf einen
-- anderen verlassen; wer den fertigen Stand braucht, nimmt onPlayerReady.
function PlayerService.onDataLoaded(callback: (Player, Types.PlayerData) -> ())
	table.insert(_onDataLoaded, callback)
end

-- Registriert einen Callback der nach ALLEN onDataLoaded-Callbacks laeuft,
-- direkt vor dem ersten Client-Sync. Fuer alles, was den fertig geladenen
-- Stand nur anzeigt (Schilder, gelegte Eier in der Welt). Darf die Daten
-- nicht mehr aendern.
function PlayerService.onPlayerReady(callback: (Player, Types.PlayerData) -> ())
	table.insert(_onPlayerReady, callback)
end

-- Registriert einen Callback der bei JEDER Datenaenderung laeuft (markDirty).
-- Wird oft aufgerufen — der Callback muss selbst entscheiden ob er wirklich
-- etwas tun muss, und darf nicht seinerseits markDirty aufrufen.
function PlayerService.onDataChanged(callback: (Player, Types.PlayerData) -> ())
	table.insert(_onDataChanged, callback)
end

-- v12: Callback, der beim Verlassen VOR dem Speichern laeuft (siehe
-- _onPlayerLeaving). Darf Daten aendern, aber nicht yielden.
function PlayerService.onPlayerLeaving(callback: (Player, Types.PlayerData) -> ())
	table.insert(_onPlayerLeaving, callback)
end

--------------------------------------------------------------------------------
-- Join / Leave
--------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	if _loading[player] then return end
	_loading[player] = true

	-- Daten laden (kann einen Moment dauern).
	--
	-- Zusaetzlich in pcall: die Migration (PlayerMigration) rechnet fuer alte
	-- Spielstaende echte Kampfwerte aus. Ein einzelner kaputter Eintrag darf
	-- den Join nicht mittendrin abbrechen — sonst bliebe _loading fuer immer
	-- gesetzt, der Spieler haette nie Daten und jedes Remote liefe still ins
	-- Leere, ohne dass irgendwo ein Fehler sichtbar waere.
	local ok, data, canSave = pcall(loadFromDataStore, player)

	if not ok then
		warn("[PlayerService] Spielstand von", player.Name, "ist beschaedigt:", data)
		data    = Types.createDefaultPlayerData()
		canSave = false   -- niemals ueber einen Stand schreiben den wir nicht lesen konnten
	end

	-- Spieler kann waehrend des Ladens schon wieder weg sein
	if player.Parent == nil then
		_loading[player] = nil
		return
	end

	if not canSave then
		_noSave[player] = true
	end

	_playerData[player] = data
	_lastSave[player]   = os.time()
	_loading[player]    = nil

	-- Insel spawnen — setzt dabei auch player.RespawnLocation auf die eigene
	-- Insel (siehe MapService.buildPlotBase).
	MapService.spawnIsland(player, data.island)

	-- Erst JETZT den Charakter laden: Players.CharacterAutoLoads steht in
	-- GameManager auf false, genau damit kein Spieler zwischen Join und
	-- geladenen Daten kurz in der Weltmitte auftaucht. RespawnLocation ist ab
	-- hier gesetzt (oder, falls der Server keinen freien Plot mehr hatte,
	-- eben nicht — dann faellt LoadCharacter auf den Not-Spawn zurueck, siehe
	-- MapService.buildPlatform).
	player:LoadCharacter()

	-- Andere Services informieren (Offline-Progress etc.)
	-- pcall: ein fehlerhafter Callback darf den Join nicht abbrechen.
	for _, callback in _onDataLoaded do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[PlayerService] onDataLoaded-Callback fehlgeschlagen:", err)
		end
	end

	-- HBB Paket 10: jede geladene Sitzung zaehlt (Shop ab der zweiten)
	data.stats.sessions = (data.stats.sessions or 0) + 1

	for _, callback in _onPlayerReady do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[PlayerService] onPlayerReady-Callback fehlgeschlagen:", err)
		end
	end

	-- Ersten Sync zum Client
	syncToClient(player)

	print("[PlayerService] Spieler geladen:", player.Name,
		"| Gummies:", data.gummies,
		"| Rebirths:", data.rebirthCount)
end

local function onPlayerRemoving(player: Player)
	local data = _playerData[player]
	if data then
		runLeavingCallbacks(player, data)
		saveToDataStore(player, data, true)
		MapService.despawnIsland(player)
	end

	_playerData[player]  = nil
	_lastSave[player]    = nil
	_loading[player]     = nil
	_noSave[player]      = nil
	_pendingSave[player] = nil

	print("[PlayerService] Spieler entfernt:", player.Name)
end

--------------------------------------------------------------------------------
-- Auto-Save Loop
--------------------------------------------------------------------------------

-- Bewusst eine eigene Schleife und nicht Heartbeat: ein Speicher-Timer hat
-- nichts an der Bildwiederholrate zu suchen. Vorher lief die Pruefung 60 mal
-- pro Sekunde und ein einzelner faelliger Spieler loeste dutzende parallele
-- Schreibvorgaenge aus, weil das Schreiben den Thread anhaelt.
local function startAutoSave()
	task.spawn(function()
		while true do
			task.wait(SAVE_TICK)

			local now = os.time()
			for player, data in _playerData do
				local since = now - (_lastSave[player] or 0)

				-- Zwei Gruende zu speichern: es liegt eine Vormerkung aus
				-- saveNow vor, oder es ist einfach lange genug her.
				local wanted = _pendingSave[player] or since >= SAVE_INTERVAL

				if wanted and since >= MIN_SAVE_GAP then
					_pendingSave[player] = nil

					local ok, err = pcall(saveToDataStore, player, data, false)
					if not ok then
						warn("[PlayerService] Auto-Save fehlgeschlagen fuer", player.Name, ":", err)
					end
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function PlayerService.init()
	-- Reconnect-Fall: Client fragt seinen Zustand aktiv an.
	-- Ohne diesen Handler blockiert ein GetPlayerData-Invoke ewig.
	RateLimiter.connectFunction(Remotes.GetPlayerData, "GetPlayerData", function(player: Player)
		local data = _playerData[player]
		if not data then
			-- Noch nicht fertig geladen — Client soll auf PlayerDataUpdated warten
			return nil
		end
		return buildUpdate(data)
	end)

	-- Sicherheitsnetz: beim Server-Shutdown alle speichern
	game:BindToClose(function()
		for player, data in _playerData do
			runLeavingCallbacks(player, data)
			saveToDataStore(player, data, true)
		end
	end)

	startAutoSave()

	-- Verfuegbarkeit einmal beim Start pruefen, damit die Warnung im Log steht
	-- bevor der erste Spieler joint — und nicht mitten in einem Join auftaucht.
	if getDataStore() then
		print("[PlayerService] Initialisiert | DataStore aktiv")
	else
		print("[PlayerService] Initialisiert | OHNE DataStore — nur Sitzungs-Speicher")
	end
end

-- Erst hier werden Spieler geladen: GameManager ruft start() nach ALLEN
-- init(). Damit hat jeder Service seine Callbacks angemeldet, bevor der erste
-- Join sie ausloest — egal, wo er in der Startliste steht.
function PlayerService.start()
	-- Bereits verbundene Spieler (in Studio-Play-Solo ist der Spieler oft
	-- schon da, bevor der Server mit dem Starten fertig ist)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
end

return PlayerService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX54"><Properties><string name="Name">PlotDisplayService</string><ProtectedString name="Source"><![CDATA[--!strict
-- PlotDisplayService.luau
-- ServerScriptService/Services/PlotDisplayService.luau
--
-- Einzige Zustaendigkeit:
--   - Entscheiden WANN die sichtbare Darstellung eines Plots nachgezogen
--     werden muss — und mit welchem der drei unterschiedlich teuren Wege.
--
-- Haengt an PlayerService.onDataChanged. Das feuert bei JEDER Aenderung, also
-- auch bei jedem einzelnen Gummy. Alles jedes Mal neu zu bauen waere
-- Verschwendung, deshalb merkt sich dieser Service drei Signaturen und
-- vergleicht sie:
--
--   STRUKTUR   (uid + Level jedes Baerchis)
--       → MapService.updateBaerchis: baut alle Mesh-Figuren neu. Teuer.
--         Noetig wenn ein Baerchi dazukommt, wegfaellt oder im Level steigt.
--
--   ZUSTAND    (uid + aktuelle HP)
--       → MapService.updateBaerchiStates: schreibt nur Beschriftung und
--         Erschoepfung an bestehende Figuren. Billig. HP aendern sich bei
--         jedem Fuettern und jedem PIT-Lauf — dafuer 25 Meshes neu zu bauen
--         waere absurd.
--
--   GEBAEUDE   (id + Level + Honig)
--       → MapService.updateBuildingSigns: schreibt die Schilder neu. Billig.
--         Honig aendert sich alle 20 Sekunden.
--
--   EIER       (uids der herumliegenden Eier)
--       → MapService.updateLaidEggs: baut die kleinen Kugeln neu. Billig —
--         es sind hoechstens zwoelf, und sie sind keine Meshes.
--         Aendert sich, wenn der Baerchi eines legt oder der Spieler eines
--         aufsammelt.
--
--   RECYCLER   (Level + Warteschlange des Waben-Recyclers)
--       → MapService.updateRecycler: schreibt Schild und Lampe. Billig.
--         Aendert sich jede Sekunde, solange der Recycler arbeitet.
--
--   LOOKS      (v15: Look-Stufe jedes Gebaeudes und des Recyclers)
--       → MapService.updateBuildingLooks: baut genau das Gebaeude neu, dessen
--         Look sich geaendert hat, mit kurzer Aufwertungs-Show. Haengt am
--         LOOK, nicht am Level — ein Ausbau innerhalb eines Looks schreibt nur
--         das Schild (GEBAEUDE oben).
--
--   TOWER      (v15: Look + Etagen + Schildtext des Tower-Turms)
--       → MapService.updateTowerShowcase (Neuaufbau des Turms, Show nur beim
--         Look-Wechsel) und MapService.setOwnerBadge (Symbol am Plot-Schild).
--         Aendert sich nur bei einem neuen Rekord oder Tower.
--
--   TERMINAL   (08.10.: Zustand, gewaehlter Tower, Rekord, Fortschritt)
--      → MapService.updateTerminal: schreibt nur Attribute, kein Neubau.
--
-- Die Figuren und Schilder selbst baut MapService — dieser Service entscheidet
-- nur WANN und WELCHE Tiefe.
--
-- EINE SACHE ENTSCHEIDET DIESER SERVICE BEWUSST NICHT: ob die Figur gerade
-- mitten in einer Bewegung steckt. Diese Sperre sitzt in
-- MapService.updateBaerchis selbst, damit sie fuer JEDEN Aufrufer gilt und
-- nicht an jeder Aufrufstelle wiederholt werden muss. Hier unten wird nur die
-- Quelle fuer frische Daten eingehaengt, mit der MapService den verschobenen
-- Neuaufbau spaeter nachholt (siehe init).
--
-- Wichtig fuer das Verstaendnis des Signatur-Vergleichs: eine verschobene
-- Darstellung gilt hier trotzdem sofort als "dargestellt". Das ist richtig, so
-- lange MapService das Nachholen uebernimmt — waere es andersherum, muesste
-- dieser Service den Zustand einer fremden Warteschlange mitverfolgen.
--
-- Ersetzt den frueheren BaerchiDisplayService, der nur die Figuren kannte und
-- inzwischen aus dem Projekt entfernt ist.

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local IncubatorRules = require(ReplicatedStorage.Modules.IncubatorRules)   -- Paket 8
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local Loc       = require(ReplicatedStorage.Localization.Loc)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)

local PlotDisplayService = {}

type Signatures = {
	incubator : string,   -- Sammel-Update Paket 8
	structure : string,
	state     : string,
	buildings : string,
	eggs      : string,
	recycler  : string,
	looks     : string,
	tower     : string,
	terminal  : string,   -- 08.10. Tower-Terminal
}

local _signatures: { [Player]: Signatures } = {}

--------------------------------------------------------------------------------
-- Signaturen
--------------------------------------------------------------------------------

-- Was sich aendern muss, damit die Figur neu gebaut wird: welche Baerchis es
-- gibt, auf welchem Level sie stehen (das Level aendert die Groesse der
-- Beschriftung und kann spaeter das Modell aendern) — UND wer gerade
-- ausgeruestet ist, seit nur noch dieser eine sichtbar gebaut wird. Ohne
-- equippedUid hier wuerde ein Equip-Wechsel auf einen gleich hochstufigen
-- Baerchi denselben String ergeben und die Signatur haelt die Aenderung
-- faelschlich fuer bereits dargestellt.
--
-- Die MUTATION gehoert aus demselben Grund dazu: sie bestimmt Fellfarbe, Aura
-- und das Kuerzel auf dem Namensschild (siehe MapService.buildBaerchiFigure).
-- Normalerweise aendert sie sich nie nach dem Schluepfen — der Mutations-Sturm
-- (EventParticipationService) kann sie aber mitten im Spiel anheben, und ohne
-- diesen Eintrag liefe die Figur bis zum naechsten Insel-Neuaufbau in der
-- alten Farbe weiter.
local function structureSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, string.format("%s:%d:%s:%s", uid, baerchi.level, baerchi.mutation or "-", baerchi.rarity))
	end
	table.sort(parts)
	table.insert(parts, "equipped:" .. (data.island.equippedUid or ""))
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Beschriftung neu geschrieben wird.
local function stateSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(parts, uid .. ":" .. baerchi.currentHp)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Gebaeude-Schilder neu geschrieben werden.
local function buildingSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d:%d", id, building.level, building.honey or 0))
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit die Eier neu gebaut werden: WELCHE Eier
-- herumliegen. Die Position gehoert bewusst nicht dazu — ein gelegtes Ei
-- bewegt sich nie, es kommt nur dazu oder verschwindet.
local function eggSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for _, egg in data.island.laidEggs or {} do
		table.insert(parts, egg.uid)
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

-- Was sich aendern muss, damit Schild und Lampe des Waben-Recyclers neu
-- geschrieben werden: Level und Warteschlange.
local function recyclerSignature(data: Types.PlayerData): string
	local recycler = data.island.recycler
	return string.format("%d:%d", recycler.level, recycler.queued)
end

-- v15: Look-Stufen. Bewusst NICHT das Level: ein Gebaeude wird nur neu
-- gebaut, wenn es einen neuen Look bekommt (README 4.2).
local function lookSignature(data: Types.PlayerData): string
	local parts: { string } = {}
	for id, building in data.island.buildings do
		table.insert(parts, string.format("%s:%d", id, BuildingBehavior.getLook(building.level)))
	end
	table.sort(parts)
	table.insert(parts, "Recycler:" .. BuildingBehavior.getLook(data.island.recycler.level))
	return table.concat(parts, "|")
end

-- v15: Tower-Turm: hoechster Tower (Look) und Rekord darin (Etagen + Schild).
local function towerSignature(data: Types.PlayerData): string
	local towerId, record = TowerConfig.bestRecord(data.towers)
	local highest = data.towers.highestTower
	if TowerConfig.getIndex(highest) > TowerConfig.getIndex(towerId) then
		towerId, record = highest, data.towers.records[highest] or 0
	end
	return string.format("%s:%d", towerId, record)
end

-- Sammel-Update Paket 8: Inkubator — belegte Plaetze (Ei + Zeitmarken),
-- Level und Platz-Zahl. Fortschritt rechnet der Client selbst.
local function incubatorSignature(data: Types.PlayerData): string
	local incubator = data.island.incubator
	if not incubator then return "" end
	local parts: { string } = { tostring(incubator.level), tostring(IncubatorRules.slotCountFor(data)) }
	for _, entry in incubator.slots do
		table.insert(parts, string.format("%d=%s@%d", entry.slot, entry.eggType, entry.finishAt))
	end
	-- INCUBATOR_BREED: Baerchis in den Plaetzen (Figur, Takt, letzte Brut)
	for _, entry in incubator.breeders or {} do
		local baerchi = data.island.baerchis[entry.uid]
		table.insert(parts, string.format("b%d=%s:%s:%s@%d", entry.slot, entry.uid,
			if baerchi then baerchi.rarity else "?", if baerchi then tostring(baerchi.mutation) else "",
			entry.lastEggAt))
	end
	return table.concat(parts, "|")
end

-- 08.10.: Tower-Terminal — Zustand, gewaehlter Tower, Rekord, Fortschritt.
local function terminalView(data: Types.PlayerData): { state: string, tower: string, record: number, nextTower: string, newTower: string, progress: number, needed: number }
	local towers = data.towers
	local nextTower, newTower = "", ""
	for _, def in TowerConfig.TOWERS do
		if newTower == "" and TowerConfig.isNew(def.id, towers) then
			newTower = def.id
		end
		if nextTower == "" and not TowerConfig.isUnlockedByClear(def.id, towers.records, towers.unlocked) then
			nextTower = def.id
		end
	end
	local _, progress, needed = TowerConfig.getUnlockProgress(nextTower, towers.records)
	return {
		state     = TowerConfig.terminalState(towers),
		tower     = towers.selected,
		record    = towers.records[towers.selected] or 0,
		nextTower = nextTower,
		newTower  = newTower,
		progress  = progress,
		needed    = needed,
	}
end

local function terminalSignature(data: Types.PlayerData): string
	local v = terminalView(data)
	return string.format("%s|%s|%d|%s|%s|%d|%d", v.state, v.tower, v.record, v.nextTower, v.newTower, v.progress, v.needed)
end

local function allSignatures(data: Types.PlayerData): Signatures
	return {
		terminal  = terminalSignature(data),
		incubator = incubatorSignature(data),
		structure = structureSignature(data),
		state     = stateSignature(data),
		buildings = buildingSignature(data),
		eggs      = eggSignature(data),
		recycler  = recyclerSignature(data),
		looks     = lookSignature(data),
		tower     = towerSignature(data),
	}
end

-- Turm und Plot-Symbol aus dem Tower-Stand (Signatur "Tower:Rekord").
local function applyTower(player: Player, signature: string, show: boolean)
	local towerId, recordText = string.match(signature, "^([^:]+):(%d+)$")
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	local record = tonumber(recordText) or 0

	MapService.updateTowerShowcase(player, {
		look   = def.look,
		floors = TowerConfig.getShowcaseFloors(def.id, record),
		title  = Loc.msg("ui.world.showcase_title", {
			name = player.DisplayName, tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record,
		}),
		color  = def.color,
	}, show)
	MapService.setOwnerBadge(player, Loc.msg("ui.world.owner_badge", {
		tower = Loc.msg("ui.petbar.tower", { n = def.numeral }), record = record,
	}), def.color)
end

--------------------------------------------------------------------------------
-- Abgleich
--------------------------------------------------------------------------------

local function refresh(player: Player, data: Types.PlayerData)
	local current  = allSignatures(data)
	local previous = _signatures[player]

	if not previous then
		-- Noch keine Signatur (sollte nach onDataLoaded nicht vorkommen):
		-- einmal komplett nachziehen und merken.
		_signatures[player] = current
		MapService.updateBaerchis(player, data.island)
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		return
	end

	if previous.structure ~= current.structure then
		-- Neuaufbau schreibt die Zustaende gleich mit — ein zusaetzliches
		-- updateBaerchiStates waere doppelte Arbeit.
		MapService.updateBaerchis(player, data.island)

	elseif previous.state ~= current.state then
		MapService.updateBaerchiStates(player, data.island)
	end

	if previous.buildings ~= current.buildings then
		MapService.updateBuildingSigns(player, data.island)
	end

	-- Bewusst UNABHAENGIG vom Struktur-Zweig oben: updateBaerchis baut die Eier
	-- zwar mit, kann aber wegen einer laufenden Bewegung verschoben worden sein
	-- (ActivityLock). Genau dann legt der Baerchi aber weiter — und ein frisch
	-- gelegtes Ei soll nicht darauf warten, dass er ankommt.
	if previous.eggs ~= current.eggs then
		MapService.updateLaidEggs(player, data.island)
	end

	if previous.recycler ~= current.recycler then
		MapService.updateRecycler(player, data.island)
	end

	if previous.incubator ~= current.incubator then
		MapService.updateIncubator(player, data.island, IncubatorRules.slotCountFor(data))
	end

	-- v15: neuer Look -> genau dieses Gebaeude neu bauen (mit Show). Nach einem
	-- Rebirth faellt der Look zurueck; rebuildIsland hat die Insel dann schon
	-- komplett neu gebaut, updateBuildingLooks findet nichts mehr zu tun.
	if previous.looks ~= current.looks then
		MapService.updateBuildingLooks(player, data.island, true)
	end

	if previous.terminal ~= current.terminal then
		MapService.updateTerminal(player, terminalView(data))
	end

	if previous.tower ~= current.tower then
		local oldTower = string.match(previous.tower, "^([^:]+):")
		local newTower = string.match(current.tower, "^([^:]+):")
		applyTower(player, current.tower, oldTower ~= newTower)
	end

	_signatures[player] = current
end

function PlotDisplayService.init()
	-- MapService darf PlayerService nicht requiren (PlayerService requiret
	-- bereits MapService — das waere ein Ringschluss). Deshalb bekommt es die
	-- Lesefunktion von hier: dieser Service kennt beide ohnehin schon.
	MapService.setIslandDataProvider(function(player: Player): Types.IslandData?
		local data = PlayerService.getData(player)
		return if data then data.island else nil
	end)
	-- Sammel-Update Paket 8: Platz-Zahl des Inkubators (Level, Rebirths, Index).
	MapService.setIncubatorSlotProvider(function(player: Player): number
		local data = PlayerService.getData(player)
		return if data then IncubatorRules.slotCountFor(data) else 1
	end)

	PlayerService.onPlayerReady(function(player, data)
		-- Die Figuren und Schilder stehen zu diesem Zeitpunkt schon
		-- (MapService.spawnIsland laeuft beim Join davor), aber die Daten
		-- haben sich seitdem noch geaendert: die onDataLoaded-Callbacks haben
		-- Offline-Honig gutgeschrieben und offline gelegte Eier eingetragen.
		-- Die Schilder zeigten sonst bis zum naechsten Honig-Tick den Stand von
		-- vor der Gutschrift, und die Eier laegen nur in den Daten.
		--
		-- Deshalb einmal aktiv nachziehen — und ERST DANN die Signatur
		-- merken, sonst haelt der Vergleich unten den Unterschied faelschlich
		-- fuer bereits dargestellt.
		MapService.updateBuildingSigns(player, data.island)
		MapService.updateBaerchiStates(player, data.island)
		MapService.updateLaidEggs(player, data.island)
		MapService.updateRecycler(player, data.island)
		MapService.updateIncubator(player, data.island, IncubatorRules.slotCountFor(data))

		local signatures = allSignatures(data)
		applyTower(player, signatures.tower, false)
		MapService.updateTerminal(player, terminalView(data))

		_signatures[player] = signatures
	end)

	PlayerService.onDataChanged(refresh)

	Players.PlayerRemoving:Connect(function(player)
		_signatures[player] = nil
	end)

	print("[PlotDisplayService] Initialisiert")
end

return PlotDisplayService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX55"><Properties><string name="Name">RebirthService</string><ProtectedString name="Source"><![CDATA[--!strict
-- RebirthService.luau
-- ServerScriptService/Services/RebirthService.luau
--
-- Einzige Zustaendigkeit:
--   - Rebirth-Requests validieren und ausfuehren
--   - Insel zuruecksetzen, Multiplikator neu setzen, Meilenstein-Eier vergeben
--
-- Was ein Rebirth kostet und was er einbringt:
--   Bedingung  : (Sammel-Update 05.10.) eine Tower-Stage in diesem Leben,
--                TowerConfig.getRebirthRequirement — KEINE Gummies mehr
--   Verloren   : alle Gebaeude-Level, der Fortsetzen-Stand der Tower,
--                Gummies (zurueck auf REBIRTH_START_GUMMIES),
--                Baerchi-LEVEL und -XP (siehe unten)
--   Behalten   : alle Baerchis SELBST (inkl. wer gerade ausgeruestet ist,
--                Rarity, Skill, Fusion-Bonus), GoldGummies, Rang,
--                Statistiken, der Ei-Baum (v14), Tower-Rekorde und
--                Meilensteine (v15) und ALLE Eier im Lager
--                (v14 — vorher nur die Ascensions-Eier; seit kein Ei mehr
--                kaufbar ist, waere jedes andere Ei ein echter Verlust).
--                Herumliegende Eier wandern beim Rebirth ins Lager.
--   Gewonnen   : hoeherer rebirthMult + ggf. Meilenstein-Eier
--                (EconomyConfig.REBIRTH_MILESTONES, v14: alle vier
--                Ascensions-Eier, teils mit Freischaltung im Ei-Baum)
--
-- GoldGummies bleiben bewusst erhalten: sie sind die "harte" Waehrung fuer
-- die spaeten Gebaeude-Level und wuerden sonst jeden Rebirth entwerten.
--
-- Baerchis bleiben seit v8 als SAMMLUNG erhalten (vorher: komplett geloescht)
-- — das Sammeln ist der eigentliche langfristige Fortschritt im Spiel
-- (Grow-a-...-Fighter-Prinzip), ein Rebirth soll die Gebaeude-Spirale
-- zuruecksetzen, nicht die Sammlung wegnehmen. Ihr LEVEL faellt aber
-- weiterhin auf 1 zurueck: Honig-Fuettern (die einzige XP-Quelle, siehe
-- HoneyService) ist an die Gebaeude gekoppelt, die der Rebirth ja gerade
-- zuruecksetzt — bliebe das Level stehen, waere ein Rebirth am Ende ein
-- reiner Gewinn ohne jeden Rueckschritt, und nicht mehr der bewusste
-- Neustart-Trade-off, den das Spiel damit anbieten soll.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)   -- Paket 4.1: Rebirth nach Stage
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local MapService     = require(ServerScriptService.Services.MapService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)
local EggTreeService = require(ServerScriptService.Services.EggTreeService)

-- Feier-Farbe fuer einen Rebirth (siehe MapService.celebrateBaerchi) — Weiss,
-- fuer den "frischer Neustart"-Blitz statt einer Rarity- oder Rollen-Farbe.
local REBIRTH_CELEBRATE_COLOR = Color3.fromRGB(255, 255, 255)

local RebirthService = {}

local function fail(player: Player, reason: Types.LocMsg?)
	Remotes.ActionFailed:FireClient(player, "RequestRebirth", reason or Loc.msg("err.unknown"))
end

-- Setzt Level und XP eines Baerchis auf den Werkszustand zurueck und heilt
-- ihn dabei komplett — sonst stuende er nach dem Rebirth auf Level 1 mit den
-- (viel zu hohen) HP seines alten Levels da, oder umgekehrt erschoepft, wenn
-- die alten HP ueber der neuen, kleineren maxHp lagen.
--
-- Unbekannter configId (kaputter/veralteter Datensatz): Level/XP trotzdem
-- zuruecksetzen, HP aber unangetastet lassen — ohne Basiswerte laesst sich
-- keine maxHp berechnen, und ein Absturz hier wuerde den gesamten Rebirth
-- abbrechen, obwohl schon Gummies abgebucht sind.
local function resetBaerchiToLevelOne(baerchi: Types.Baerchi)
	baerchi.level = 1
	baerchi.xp    = 0

	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then
		warn("[RebirthService] Unbekannter configId beim Rebirth-Reset:", baerchi.configId)
		return
	end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)
	baerchi.currentHp = stats.maxHp
end

function RebirthService.rebirth(player: Player)
	local data = PlayerService.getData(player)
	if not data then return end

	-- Sammel-Update 05.10. (Paket 4.1): kein Gummy-Preis mehr. Bedingung ist
	-- eine Tower-Stage, in DIESEM Leben geschafft (island.stageBest, siehe
	-- TowerConfig.getRebirthRequirement). Gummies verfallen beim Rebirth
	-- trotzdem (resetGummies unten) — wer vorher alles ausgibt, verliert nichts.
	if not TowerConfig.isRebirthReady(data.rebirthCount, data.island.stageBest, data.towers.records) then
		local towerId, stage = TowerConfig.getRebirthRequirement(data.rebirthCount, data.towers.records)
		local def = TowerConfig.get(towerId)
		fail(player, Loc.msg("err.rebirth_stage", {
			tower = if def then def.numeral else towerId,
			stage = stage,
			have  = (data.island.stageBest or {})[towerId] or 0,
		}))
		return
	end
	local cost = 0   -- nur noch fuer das Protokoll unten

	-- v14: ALLE Eier ueberleben den Reset (vorher nur Ascension). Seit kein
	-- Ei mehr kaufbar ist, waere jedes andere ein echter Verlust. Was noch
	-- auf dem Plot liegt, wandert mit ins Lager.
	local keptStock: { [Types.EggType]: number } = {}
	for eggType, count in data.island.eggStock do
		keptStock[eggType] = count
	end
	for _, egg in data.island.laidEggs do
		keptStock[egg.eggType] = (keptStock[egg.eggType] or 0) + 1
	end

	-- Baerchis (und wer davon gerade ausgeruestet ist) ueberleben den Reset
	-- ebenfalls — siehe Kopf-Kommentar. `equippedUid` einfach mit
	-- durchreichen statt neu zuzuweisen: zeigt der ausgeruestete Baerchi noch
	-- auf einen Eintrag in `keptBaerchis`, bleibt er nach dem Rebirth
	-- weiterhin ausgeruestet, MapService.rebuildIsland baut seine Figur ganz
	-- normal wieder mit auf.
	local keptBaerchis    = data.island.baerchis
	local keptEquippedUid = data.island.equippedUid

	-- Level und XP fallen trotzdem zurueck auf den Anfang — siehe Kopf-
	-- Kommentar. Die Baerchis selbst (Rarity, Skill, Fusion-Bonus, ...)
	-- bleiben dabei unangetastet, nur Fortschritt UEBER Level 1 hinaus geht
	-- verloren.
	for _, baerchi in keptBaerchis do
		resetBaerchiToLevelOne(baerchi)
	end

	-- Insel auf Werkszustand
	local freshIsland = PlayerService.buildDefaultIsland()
	-- Die Start-Basis-Eier gibt es nur fuer neue Spieler, nicht pro Rebirth.
	freshIsland.eggStock = keptStock
	freshIsland.baerchis    = keptBaerchis
	freshIsland.equippedUid = keptEquippedUid
	-- Sammel-Update Paket 8: Eier im Inkubator bleiben (wie das Ei-Lager),
	-- das Ausbau-Level faellt zurueck (Geldsenke vor dem Rebirth). Plaetze
	-- ueber der neuen Platz-Zahl lassen sich noch abholen, aber nicht neu belegen.
	local oldIncubator = data.island.incubator
	if oldIncubator and freshIsland.incubator then
		freshIsland.incubator.slots = oldIncubator.slots
		-- INCUBATOR_BREED: die Baerchis bleiben sitzen (die Sammlung bleibt
		-- beim Rebirth); IncubatorService raeumt fehlende im naechsten Takt.
		freshIsland.incubator.breeders = oldIncubator.breeders or {}
	end
	data.island = freshIsland

	-- Progression hochzaehlen
	data.rebirthCount += 1
	data.rebirthMult   = EconomyConfig.getRebirthMult(data.rebirthCount)
	data.stats.totalRebirths += 1

	-- Ueber EconomyService statt eines direkten Feld-Schreibzugriffs — nur
	-- der darf Waehrungen anfassen, auch beim Zuruecksetzen auf einen Fixwert.
	EconomyService.resetGummies(player, EconomyConfig.REBIRTH_START_GUMMIES)

	-- Meilenstein-Belohnung (v14: alle vier Ascensions-Eier)
	local eggReward = 0
	local milestoneEggs: { { eggType: Types.EggType, count: number } } = {}
	local milestone = EconomyConfig.getRebirthMilestone(data.rebirthCount)
	if milestone then
		for _, entry in milestone.eggs do
			local stock = data.island.eggStock[entry.eggType] or 0
			data.island.eggStock[entry.eggType] = stock + entry.count
			eggReward += entry.count
			table.insert(milestoneEggs, { eggType = entry.eggType, count = entry.count })
		end
		for _, eggType in (milestone.unlock or {}) do
			EggTreeService.forceUnlock(player, data, eggType, "rebirth")
		end
	end
	-- Rebirth-Gates im Baum (Sonnen-Ei ab Rebirth 3 usw.)
	EggTreeService.check(player, data, "rebirth")

	-- Sichtbare Insel neu aufbauen (Gebaeude auf Level 1, PIT wieder Level 1).
	-- rebuildIsland behaelt den Insel-Slot — der Spieler soll nach dem Rebirth
	-- nicht ploetzlich an einer anderen Stelle der Map stehen.
	MapService.rebuildIsland(player, data.island)

	-- Sichtbar feiern — NACH rebuildIsland, sonst existiert die Figur (mit
	-- ihrem frisch auf Level 1 zurueckgesetzten Stand) noch gar nicht in der
	-- Welt. Nur wenn ueberhaupt einer ausgeruestet ist: direkt nach dem ALLER-
	-- ersten Ei (vor dem ersten Rebirth ueberhaupt) waere keptEquippedUid nil.
	if keptEquippedUid then
		MapService.celebrateBaerchi(player, keptEquippedUid, REBIRTH_CELEBRATE_COLOR)
	end

	local result: Types.RebirthResult = {
		newRebirthCount = data.rebirthCount,
		newMultiplier   = data.rebirthMult,
		ascensionEggs   = eggReward,
		milestoneEggs   = milestoneEggs,
	}

	Remotes.RebirthResultReceived:FireClient(player, result)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	print(
		"[RebirthService]", player.Name,
		"| Rebirth #", data.rebirthCount,
		"| Kosten:", cost,
		"| neuer Multi:", data.rebirthMult,
		"| Meilenstein-Eier:", eggReward
	)
end

function RebirthService.init()
	RateLimiter.connect(Remotes.RequestRebirth, "RequestRebirth", function(player)
		RebirthService.rebirth(player)
	end)

	print("[RebirthService] Initialisiert")
end

return RebirthService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX56"><Properties><string name="Name">SpecialMilestoneService</string><ProtectedString name="Source"><![CDATA[--!strict
-- SpecialMilestoneService.luau
-- ServerScriptService/Services/SpecialMilestoneService.luau
--
-- Einzige Zustaendigkeit:
--   - Die besonderen Meilensteine (Sammel-Update 05.10., Paket 6.2) einmalig
--     pro Konto auszahlen, sobald sie erreicht sind — auch rueckwirkend.
--
-- Regel (fuer CONTEXT_BRIEFING): Ascensions-Eier haben genau zwei Quellen —
-- Rebirth-Meilensteine (RebirthService) und die besonderen Meilensteine
-- (EconomyConfig.SPECIAL_MILESTONES, hier; die Gesamt-Index-Belohnung zaehlt
-- dazu und wird im Index abgeholt). tools/check_consistency.py prueft das.
--
-- Wie TowerService die Tower-Meilensteine: Pruefung beim Join und bei jeder
-- Datenaenderung, gemerkt in data.specialClaimed. Der Beobachter aendert die
-- Daten nur im task.defer (nie synchron markDirty im Beobachter).

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types         = require(ReplicatedStorage.Network.Types)
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local EconomyConfig = require(ReplicatedStorage.Config.EconomyConfig)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local EggService    = require(ServerScriptService.Services.EggService)

local SpecialMilestoneService = {}

local _pending: { [Player]: boolean } = {}

local function reached(data: Types.PlayerData, m: EconomyConfig.SpecialMilestone): boolean
	if m.kind == "tower" then
		return ((data.towers.records or {})[m.tower or ""] or 0) >= (m.stage or math.huge)
	elseif m.kind == "stat" then
		return ((data.stats :: any)[m.stat or ""] or 0) >= (m.atLeast or math.huge)
	end
	return false
end

-- Offene, erreichte Meilensteine (rein lesend).
local function due(data: Types.PlayerData): { EconomyConfig.SpecialMilestone }
	local list = {}
	for _, m in EconomyConfig.SPECIAL_MILESTONES do
		if not data.specialClaimed[m.id] and reached(data, m) then
			table.insert(list, m)
		end
	end
	return list
end

local function payOut(player: Player, data: Types.PlayerData)
	for _, m in due(data) do
		data.specialClaimed[m.id] = true
		for _, entry in m.eggs do
			EggService.grantEggs(player, entry.eggType, entry.count)
		end
		local result: Types.SpecialMilestoneResult = { id = m.id, eggs = m.eggs }
		Remotes.SpecialMilestoneReceived:FireClient(player, result)
		print("[SpecialMilestoneService]", player.Name, "| besonderer Meilenstein:", m.id)
	end
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
end

local function check(player: Player, data: Types.PlayerData)
	if _pending[player] or #due(data) == 0 then return end
	_pending[player] = true
	task.defer(function()
		_pending[player] = nil
		if player.Parent and PlayerService.getData(player) == data then
			payOut(player, data)
		end
	end)
end

function SpecialMilestoneService.init()
	PlayerService.onDataChanged(check)
	PlayerService.onPlayerReady(check)
	print("[SpecialMilestoneService] Initialisiert |", #EconomyConfig.SPECIAL_MILESTONES, "Meilensteine")
end

return SpecialMilestoneService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX57"><Properties><string name="Name">TowerService</string><ProtectedString name="Source"><![CDATA[--!strict
-- TowerService.luau
-- ServerScriptService/Services/TowerService.luau
--
-- Einzige Zustaendigkeit:
--   - Den permanenten Tower-Fortschritt fuehren (v15, ersetzt das PIT-Level):
--     Tower-Wahl, Freischaltung (08.10.: durch Schaffen des vorherigen
--     Towers, towers.unlocked, Meldung TowerUnlocked; ohne
--     FeatureFlags.TOWER_UNLOCK_BY_CLEAR der alte Deckel pro Rebirth),
--     Rekorde, Meilensteine (auch rueckwirkend) und die PIT-Erstattung aus
--     der Migration.
--
-- Was ein Lauf ist und wie er simuliert wird, weiss CombatService; dieser
-- Service sagt ihm nur, in welchem Tower gekaempft wird, bis wohin es Belohnung
-- gibt, und nimmt am Ende das Ergebnis entgegen (recordRun). Die Zahlen stehen
-- in Config/TowerConfig.
--
-- Die Daten (data.towers) liegen ausserhalb der Insel wie der Ei-Baum: ein
-- Rebirth setzt die Insel zurueck, Rekorde und abgeholte Meilensteine bleiben.
--
-- Auszahlungen laufen ausschliesslich ueber die zustaendigen Services:
-- Gummies/GoldGummies ueber EconomyService (Meilensteine OHNE Multiplikator,
-- awardGummiesFlat), Eier ueber EggService.grantEggs, Blaupausen ueber
-- EggTreeService.grantBlueprint.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local LeaderboardConfig = require(ReplicatedStorage.Config.LeaderboardConfig)  -- Paket 9: Woche
local EggTree     = require(ReplicatedStorage.Modules.EggTree)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local EggService     = require(ServerScriptService.Services.EggService)
local EggTreeService = require(ServerScriptService.Services.EggTreeService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local TowerService = {}

-- Nur Studio/Debug: Spielstaende, fuer die jeder Tower offen ist (Kampf in allen
-- vier Towern ohne Rebirths testen). Schluessel = die Daten-Tabelle, schwach.
local _debugOpen: { [any]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function fail(player: Player, reason: Types.LocMsg)
	Remotes.ActionFailed:FireClient(player, "RequestSelectTower", reason)
end

--------------------------------------------------------------------------------
-- Lesen
--------------------------------------------------------------------------------

-- Deckel in diesem Tower (0 = Tower noch zu). 08.10.: mit
-- TOWER_UNLOCK_BY_CLEAR die volle Stage-Zahl jedes freigeschalteten Towers.
function TowerService.getStageCap(data: Types.PlayerData, towerId: string): number
	local cap = TowerConfig.getStageCap(data.rebirthCount, towerId, data.towers.records, data.towers.unlocked)
	if cap <= 0 and _debugOpen[data] then
		local def = TowerConfig.get(towerId)
		return if def then def.stages else 0
	end
	return cap
end

-- Der gewaehlte Tower; ist er (z. B. nach einer Datenreparatur) nicht offen,
-- der hoechste offene.
function TowerService.getSelected(data: Types.PlayerData): string
	local selected = data.towers.selected
	if TowerConfig.isOpen(data.rebirthCount, selected, data.towers.records, data.towers.unlocked) or (_debugOpen[data] and TowerConfig.isValidId(selected)) then
		return selected
	end
	-- Sonst der hoechste offene Tower (Tower I ist immer offen)
	local best = TowerConfig.FIRST_TOWER :: string
	for _, def in TowerConfig.TOWERS do
		if TowerConfig.isOpen(data.rebirthCount, def.id, data.towers.records, data.towers.unlocked) then
			best = def.id
		end
	end
	return best
end

--------------------------------------------------------------------------------
-- Freischaltung (08.10.)
--------------------------------------------------------------------------------

-- Traegt die Tower ein, die `towerId` mit seinem Rekord oeffnet. `announce`:
-- dem Spieler melden (TowerUnlocked → Feier-Moment, "NEU"-Abzeichen). Beim
-- Join nur still nachtragen, sonst kaeme die Meldung bei jedem Betreten.
local function applyUnlocks(player: Player, data: Types.PlayerData, towerId: string, announce: boolean)
	if not FeatureFlags.isOn("TOWER_UNLOCK_BY_CLEAR") then return end
	local towers = data.towers
	if typeof(towers.unlocked) ~= "table" then towers.unlocked = {} end
	for _, nextId in TowerConfig.unlocksAfterClear(towerId, towers.records[towerId] or 0) do
		if towers.unlocked[nextId] ~= true then
			towers.unlocked[nextId] = true
			if announce then
				-- Nach dem Lauf-Ergebnis zeigen (Ergebnis-Toast zuerst)
				task.delay(1.5, function()
					if player.Parent then
						Remotes.TowerUnlocked:FireClient(player, nextId)
					end
				end)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Meilensteine
--------------------------------------------------------------------------------

-- Zahlt einen einzelnen Meilenstein aus (einmalig) und meldet ihn dem Client.
-- Gibt true zurueck, wenn er neu abgeholt wurde.
local function grantMilestone(player: Player, data: Types.PlayerData, towerId: string, stage: number): boolean
	local milestone = TowerConfig.getMilestone(towerId, stage)
	if not milestone then return false end

	local claimed = data.towers.claimed[towerId]
	if not claimed then
		claimed = {}
		data.towers.claimed[towerId] = claimed
	end
	local key = tostring(stage)
	if claimed[key] then return false end
	claimed[key] = true

	local reward: Types.TowerMilestoneReward = {
		towerId     = towerId,
		stage       = stage,
		gummies     = 0,
		goldGummies = 0,
		eggType     = nil,
		eggs        = 0,
		blueprints  = 0,
	}

	if milestone.gummies > 0 then
		reward.gummies = EconomyService.awardGummiesFlat(player, milestone.gummies)
	end
	if milestone.goldGummies > 0 then
		reward.goldGummies = EconomyService.awardGoldGummies(player, milestone.goldGummies)
	end
	if milestone.eggs > 0 then
		local eggType = EggTree.highestUnlocked(data.eggTree)
		if EggService.grantEggs(player, eggType, milestone.eggs) then
			reward.eggType = eggType
			reward.eggs = milestone.eggs
		end
	end
	if milestone.blueprints > 0 then
		EggTreeService.grantBlueprint(player, data, milestone.blueprints)
		reward.blueprints = milestone.blueprints
	end
	if milestone.endlessLevels > 0 then
		local baerchi = data.island.equippedUid and data.island.baerchis[data.island.equippedUid]
		if baerchi then
			baerchi.endlessLevel = (baerchi.endlessLevel or 0) + milestone.endlessLevels
			reward.endlessLevels = milestone.endlessLevels
		end
	end

	-- Kurz verzoegert: beim Join haengt der Client sein UI erst noch an.
	task.delay(1, function()
		if player.Parent then
			Remotes.TowerMilestoneReceived:FireClient(player, reward)
		end
	end)
	return true
end

-- Alle noch offenen Meilensteine bis einschliesslich `upTo` (rueckwirkend).
local function grantMilestonesUpTo(player: Player, data: Types.PlayerData, towerId: string, upTo: number): number
	local granted = 0
	local stage = TowerConfig.MILESTONE_EVERY
	while stage <= upTo do
		if grantMilestone(player, data, towerId, stage) then
			granted += 1
		end
		stage += TowerConfig.MILESTONE_EVERY
	end
	return granted
end

--------------------------------------------------------------------------------
-- Ergebnis eines Laufs
--------------------------------------------------------------------------------

-- Vom CombatService am Ende eines Laufs aufgerufen. `highestWon` = hoechste
-- gewonnene Stage dieses Laufs. Rekord und Meilensteine zaehlen nur bis zum
-- Deckel (weich). Gibt den neuen Rekord (nil = keiner) und zurueck, ob der Lauf
-- den Deckel erreicht hat (Rebirth-Hinweis, nur wenn der Deckel ein echtes
-- Limit ist).
function TowerService.recordRun(player: Player, data: Types.PlayerData, towerId: string, highestWon: number): (number?, boolean)
	local def = TowerConfig.get(towerId)
	if not def or highestWon <= 0 then return nil, false end

	local cap = TowerService.getStageCap(data, towerId)
	local counted = math.min(highestWon, cap)

	-- Sammel-Update 05.10. (Paket 4.1): beste Stage dieses Lebens fuer die
	-- Rebirth-Bedingung. Ungedeckelt: die Bedingung liegt ohnehin unter dem
	-- Deckel, und ein Spieler, der darueber kaempft, hat sie erst recht erfuellt.
	local island = data.island
	if typeof(island.stageBest) ~= "table" then island.stageBest = {} end
	island.stageBest[towerId] = math.max(island.stageBest[towerId] or 0, highestWon)

	local newRecord: number? = nil
	local previous = data.towers.records[towerId] or 0
	if counted > previous then
		data.towers.records[towerId] = counted
		newRecord = counted
		if def.index > TowerConfig.getIndex(data.towers.highestTower) then
			data.towers.highestTower = towerId
		end
		grantMilestonesUpTo(player, data, towerId, counted)
		applyUnlocks(player, data, towerId, true)
	end

	-- Paket 9: beste Endless-Stage dieser Woche (Wochen-Bestenliste).
	if towerId == "Endless" then
		local week = LeaderboardConfig.weekOf(os.time())
		local entry = data.towers.endlessWeek
		if not entry or entry.week ~= week then
			entry = { week = week, best = 0 }
			data.towers.endlessWeek = entry
		end
		entry.best = math.max(entry.best, counted)
	end

	local capReached = highestWon >= cap and TowerConfig.isCapLimiting(data.rebirthCount, towerId)
	return newRecord, capReached
end

--------------------------------------------------------------------------------
-- Tower waehlen
--------------------------------------------------------------------------------

function TowerService.select(player: Player, towerId: string)
	local data = PlayerService.getData(player)
	if not data then return end

	if not TowerConfig.isValidId(towerId) then
		fail(player, Loc.msg("err.tower_unknown"))
		return
	end
	if not TowerConfig.isOpen(data.rebirthCount, towerId, data.towers.records, data.towers.unlocked)
		and not _debugOpen[data] then
		if towerId == "Endless" then
			fail(player, Loc.msg("err.tower_locked_endless"))
		elseif FeatureFlags.isOn("TOWER_UNLOCK_BY_CLEAR") then
			local prev, _, needed = TowerConfig.getUnlockProgress(towerId, data.towers.records)
			fail(player, Loc.msg("err.tower_locked_clear", {
				tower = Loc.msg("tower." .. (prev or TowerConfig.FIRST_TOWER) .. ".name"),
				stages = needed,
			}))
		else
			fail(player, Loc.msg("err.tower_locked", { rebirths = TowerConfig.getOpeningRebirth(towerId) }))
		end
		return
	end
	if data.towers.selected == towerId then return end

	data.towers.selected = towerId
	PlayerService.markDirty(player)
end

-- Debug: alle Tower fuer diesen Spielstand oeffnen (bis zum Verlassen).
function TowerService.debugOpenAll(data: Types.PlayerData)
	_debugOpen[data] = true
end

-- Debug: Rekord direkt setzen (mit Meilensteinen bis dorthin).
function TowerService.debugSetRecord(player: Player, towerId: string, stage: number)
	local data = PlayerService.getData(player)
	local def = TowerConfig.get(towerId)
	if not data or not def then return end
	local value = math.clamp(math.floor(stage), 0, def.stages)
	data.towers.records[towerId] = value
	if value > 0 and def.index > TowerConfig.getIndex(data.towers.highestTower) then
		data.towers.highestTower = towerId
	end
	grantMilestonesUpTo(player, data, towerId, value)
	applyUnlocks(player, data, towerId, true)
	PlayerService.markDirty(player)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function TowerService.init()
	RateLimiter.connect(Remotes.RequestSelectTower, "RequestSelectTower", function(player, towerId: any)
		if typeof(towerId) ~= "string" then return end
		TowerService.select(player, towerId)
	end)

	PlayerService.onDataLoaded(function(player, data)
		-- 1. PIT-Erstattung aus der Migration v14 -> v15 (einmalig).
		local refund = data.island.pitRefund or 0
		if refund > 0 then
			data.island.pitRefund = 0
			local paid = EconomyService.awardGummiesFlat(player, refund)
			task.delay(4, function()
				if player.Parent then
					Remotes.EventNotice:FireClient(player, Loc.msg("msg.pit_refund", { amount = paid }), "good")
				end
			end)
			print("[TowerService]", player.Name, "| PIT-Erstattung:", paid)
		end

		-- 2. Rueckwirkende Meilensteine (migrierter Rekord, oder ein neuer
		--    Meilenstein in der Config).
		for towerId, record in data.towers.records do
			grantMilestonesUpTo(player, data, towerId, record)
			applyUnlocks(player, data, towerId, false)
		end

		-- 3. Gewaehlter Tower muss offen sein.
		data.towers.selected = TowerService.getSelected(data)
	end)

	print("[TowerService] Initialisiert |", #TowerConfig.TOWERS, "Tower")
end

return TowerService
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX71"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX59"><Properties><string name="Name">EventKit</string><ProtectedString name="Source"><![CDATA[--!strict
-- EventKit.luau
-- ServerScriptService/Util/EventKit.luau
--
-- Einzige Zustaendigkeit:
--   - Gemeinsame Typen und kleine Werkzeuge der Event-Handler (Teilnehmer,
--     Api, Belohnung, Effekt-Teile, Textmarke ueber der Figur).
--
-- Aus EventHandlers herausgezogen, als das sechste Event (Wespenkoenigin,
-- Util/WaspQueenEvent) dazukam: beide brauchen dieselben Typen und Werkzeuge,
-- und ein gegenseitiges require waere ein Ringschluss. Der Code ist
-- unveraendert aus EventHandlers uebernommen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local Types            = require(ReplicatedStorage.Network.Types)
local WorldText        = require(ReplicatedStorage.Localization.WorldText)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local EventKit = {}

--------------------------------------------------------------------------------
-- Typen
--------------------------------------------------------------------------------

-- Ein Teilnehmer, wie EventParticipationService ihn liefert (dort: Presence).
-- Die Handler lesen ihn und setzen nur die drei Steuerfelder unten.
export type Part = {
	player     : Player,
	figure     : Model,
	baerchiUid : string,
	homeFoot   : Vector3,
	standFoot  : Vector3,
	busy       : boolean?,   -- Figur laeuft gerade (walkTo)
	cancelWalk : boolean?,   -- laufende Bewegung abbrechen
	abducting  : boolean?,   -- UFO hat die Figur gerade
	abductedAt : number?,    -- Sammel-Update 1.1: os.clock() beim Start der Entfuehrung (Waechter)
}

-- Was EventParticipationService den Handlern bereitstellt (buildApi).
export type Api = {
	center       : Vector3,
	radius       : number,
	running      : () -> boolean,
	footOf       : (Model) -> Vector3,
	participants : () -> { Part },
	stillHere    : (Part) -> boolean,
	plotPosition : (Player) -> Vector3?,
	level        : (Part) -> number,
	power        : (Part) -> number,
	-- Sammel-Update 2.4: Text als LocMsg (der Client uebersetzt). Ein
	-- einfacher string bleibt fuer Altstellen erlaubt.
	toast        : (Player, string | Types.LocMsg) -> (),
	recall       : (Player) -> (),
	finishHome   : (Part) -> (),
	ufoReward    : (Part) -> (),
	-- UFO_REJOIN: befristet geschwaecht (Level halbiert) nach dem Absetzen
	weaken       : (Part, number) -> (),
	isWeakened   : (Part) -> boolean,
	walkTo       : (Part, Vector3) -> boolean,

	-- v17 (lebendige Events)
	grantEgg     : (Player, Types.EggType, number) -> boolean,
	notify       : (Player, Types.LocMsg, string?) -> (),
	announce     : (Types.LocMsg, string?) -> (),
	fightStats   : (Part) -> CombatCalculator.FighterStats?,
	finishEarly  : () -> (),
}

-- Belohnung eines Spielers am Event-Ende.
export type Reward = {
	egg          : EventConfig.EventBonus?,
	mutationRoll : boolean?,

	-- v17 (Boss): Zusatz-Belohnungen, ausgezahlt von EventParticipationService
	-- ueber EconomyService / CombRecyclerService.
	gummies        : number?,                   -- Basisbetrag (mit Rebirth-Multiplikator)
	combUnits      : number?,                   -- Wabeneinheiten in den Recycler
	extraEgg       : EventConfig.EventBonus?,   -- zweites Ei (Top-Rang: Sprung-Ei)
	rarityUpFactor : number?,                   -- Rarity-Up-Wurf: Faktor auf EventConfig.RARITY_UP_CHANCE
	notice         : Types.LocMsg?,             -- Zusammenfassung fuer den Spieler
	-- HBB Paket 7: Boss-Stufe (0-4) und ihr Zusatz-Wurf (Mutation)
	bossTier       : number?,
	tierBonus      : EventConfig.EventBonus?,
	tierEggs       : number?,                   -- Basis-Eier der Stufe
	-- Sammel-Update 05.10. (Paket 6.2): Boss besiegt und dieser Spieler hat
	-- Schaden gemacht (besonderer Meilenstein "erster Boss-Sieg").
	bossVictory    : boolean?,
}

export type Session = {
	stop : () -> { [Player]: Reward },
}

export type Handler = (Api, EventConfig.EventDef) -> Session

--------------------------------------------------------------------------------
-- Optik der Textmarke (keine Balance)
--------------------------------------------------------------------------------

-- Textmarke ueber der Figur
local LABEL_SIZE              = UDim2.fromOffset(120, 26)
local LABEL_OFFSET            = Vector3.new(0, 6, 0)
local LABEL_MAX_DISTANCE      = 220
local LABEL_BACK_TRANSPARENCY = 0.35
local LABEL_BACK_COLOR        = Color3.fromRGB(20, 20, 30)
local LABEL_TEXT_COLOR        = Color3.new(1, 1, 1)

--------------------------------------------------------------------------------
-- Werkzeuge
--------------------------------------------------------------------------------

function EventKit.flatDist(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Eigenschaften per Tabelle setzen. Ueber `any`, weil der Klassenname erst
-- zur Laufzeit feststeht und --!strict die Felder sonst nicht kennt.
function EventKit.make(className: string, props: { [string]: any }, parent: Instance): Instance
	local inst: any = Instance.new(className)
	for key, value in props do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

function EventKit.fxPart(props: { [string]: any }, parent: Instance): BasePart
	props.Anchored   = true
	props.CanCollide = false
	props.CanQuery   = false
	props.CanTouch   = false
	props.CastShadow = false
	return EventKit.make("Part", props, parent) :: BasePart
end

function EventKit.rootOf(figure: Model): BasePart?
	return figure.PrimaryPart or figure:FindFirstChildWhichIsA("BasePart", true)
end

-- Kleine Textmarke ueber der Figur (Fortschritt, "Ei!", ...). nil entfernt sie.
-- Woerter kommen als Nachricht (Loc.msg): alle Spieler sehen die Marke, jeder
-- liest sie in seiner Sprache (siehe WorldText). Reine Zahlen gehen als String.
function EventKit.setLabel(part: Part, text: (string | Types.LocMsg)?)
	local figure = part.figure
	if not figure or not figure.Parent then
		return
	end

	local gui = figure:FindFirstChild("EventLabel")
	if not text then
		if gui then
			gui:Destroy()
		end
		return
	end

	if not gui then
		local root = EventKit.rootOf(figure)
		if not root then
			return
		end
		local created = EventKit.make("BillboardGui", {
			Name         = "EventLabel",
			Size         = LABEL_SIZE,
			StudsOffset  = LABEL_OFFSET,
			AlwaysOnTop  = true,
			Adornee      = root,
			MaxDistance  = LABEL_MAX_DISTANCE,
		}, figure)
		EventKit.make("TextLabel", {
			Name                   = "Text",
			Size                   = UDim2.fromScale(1, 1),
			BackgroundTransparency = LABEL_BACK_TRANSPARENCY,
			BackgroundColor3       = LABEL_BACK_COLOR,
			TextColor3             = LABEL_TEXT_COLOR,
			TextScaled             = true,
			Font                   = Enum.Font.GothamBold,
		}, created)
		gui = created
	end

	local label = (gui :: Instance):FindFirstChild("Text")
	if label and label:IsA("TextLabel") then
		WorldText.set(label, text :: string | Types.LocMsg)
	end
end

function EventKit.newFolder(name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name   = name
	folder.Parent = workspace
	return folder
end

return EventKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX60"><Properties><string name="Name">FigureFX</string><ProtectedString name="Source"><![CDATA[--!strict
-- FigureFX.luau
-- ServerScriptService/Util/FigureFX.luau
--
-- Einzige Zustaendigkeit:
--   - Kleine, rein kosmetische Bewegungen an einem Model abspielen:
--     Ausfallschritt, Treffer-Blitz, Umkippen, Vorbeugen, Ruhe-Atmen,
--     seit v15 Zusammenprall (clash), Taumeln und Aufprall-Ton.
--
-- Dieses Modul kennt WEDER Spielerdaten NOCH Remotes NOCH Gebaeude oder
-- Kaempfe — nur Model, CFrame und Zahlen. Es entscheidet WIE eine Bewegung
-- aussieht; WANN sie passiert, entscheidet der aufrufende Service
-- (PitArenaService, BaerchiAutopilotService, MapService). Genau diese Trennung
-- ist der Grund, warum es eine eigene Datei ist und nicht in PitArenaService
-- steht.
--
-- ============================================================
-- KEIN RIG, KEIN ANIMATOR
-- ============================================================
-- Die importierten Baerchi-Meshes haben keine Motor6D-Gelenke (siehe
-- BaerchiMesh.luau / FigureWalker.luau) — eine klassische Skelett-Animation
-- kann daran nicht ansetzen. Alles hier bewegt deshalb das GANZE Model per
-- PivotTo, genau wie FigureWalker. Der Fusspunkt bleibt dabei ueberall auf dem
-- Boden: entweder ueber FigurePlacement (Ausfallschritt) oder ueber eine
-- Drehung um eine Achse, die DURCH den Fusspunkt geht (Vorbeugen, Umkippen).
-- Ein Motor6D oder AnimationController wird hier bewusst NICHT eingefuehrt.
--
-- ============================================================
-- WER WELCHE ZAHL BESTIMMT
-- ============================================================
-- Dauer, Distanz und Farbe kommen als Argument herein — die stehen in
-- MapConfig, weil sie Balance/Optik des Spiels sind. Was hier unten als
-- Konstante steht, ist die FORM der Bewegung (wie hoch der Hopser im
-- Verhaeltnis zur Ausfall-Distanz ist, wie lange die Figur beim Fressen unten
-- bleibt). Die gehoert zur Bewegung selbst, nicht zum Spiel — genauso wie
-- FigureWalker seine Huepf-Vorgaben selbst mitbringt.

local RunService          = game:GetService("RunService")
local TweenService        = game:GetService("TweenService")
local Debris              = game:GetService("Debris")
local ServerScriptService = game:GetService("ServerScriptService")

local FigurePlacement = require(ServerScriptService.Util.FigurePlacement)

local FigureFX = {}

--------------------------------------------------------------------------------
-- Form-Konstanten (siehe Kopf: das WIE, nicht das WIEVIEL)
--------------------------------------------------------------------------------

-- Huepf-Hoehe des Ausfallschritts als Anteil seiner Distanz. Ein Ausfall ohne
-- jede Hoehe sieht aus wie Schlittern.
local LUNGE_HOP_SHARE = 0.35

-- Wie weit eine besiegte Figur nach HINTEN wegkippt, und wie weit sie dabei
-- absackt (als Anteil ihrer eigenen Hoehe, damit es bei jedem Mesh passt).
local COLLAPSE_DEGREES    = 74
local COLLAPSE_SINK_SHARE = 0.18

-- Anteil der Fress-Dauer, den die Figur unten bleibt. Der Rest teilt sich auf
-- Runterbeugen und Wiederaufrichten auf.
local LEAN_HOLD_SHARE = 0.40

-- Deckkraft des Treffer-Blitzes. Voll deckend waere ein Farbklecks statt eines
-- Aufleuchtens.
local FLASH_FILL_TRANSPARENCY = 0.45

-- Ruhe-Atmen: Vorgaben, falls der Aufrufer keine mitgibt.
local IDLE_DEFAULT_HEIGHT = 0.16   -- Studs
local IDLE_DEFAULT_RATE   = 1.5    -- Schwingungen pro Sekunde

-- Feier-Momente (celebrate/burstAt) — siehe Abschnitt weiter unten.
-- Die Zahlen hier sind FORM (wie ein Partikel-Stoss aussieht), nicht Balance
-- — deshalb hier und nicht in MapConfig, genau wie beim Rest dieser Datei.
local CELEBRATE_PARTICLE_COUNT   = 24
local CELEBRATE_HOP_HEIGHT_SHARE = 0.45   -- Anteil der Modellhoehe
local CELEBRATE_FLASH_SECONDS    = 0.35
local CELEBRATE_DEFAULT_SECONDS  = 0.6

-- Kuerzeste sinnvolle Dauer — schuetzt vor Division durch Null bei 0.
local MIN_SECONDS = 0.05

local EPSILON = 1e-3

--------------------------------------------------------------------------------
-- Interne Hilfen
--------------------------------------------------------------------------------

-- Fusspunkt eines Models: Mitte der Unterkante seiner Bounding-Box. Dieselbe
-- Groesse, mit der FigurePlacement und FigureWalker rechnen.
local function footOf(model: Model): Vector3
	return FigurePlacement.footOf(model)   -- Sammel-Update 1.2
end

local function heightOf(model: Model): number
	local _, size = model:GetBoundingBox()
	return size.Y
end

-- Laeuft `seconds` lang und ruft `step(t)` jeden Frame mit t von 0 bis 1.
-- Bricht ab, sobald das Model aus der Welt verschwindet (Plot neu gebaut,
-- Gegner weggeraeumt, Spieler weg) — dieselbe defensive Pruefung, die auch
-- FigureWalker und PitArenaService machen.
--
-- Gibt zurueck, ob die Bewegung ganz durchgelaufen ist.
local function animate(model: Model, seconds: number, step: (t: number) -> ()): boolean
	local duration = math.max(seconds, MIN_SECONDS)
	local elapsed  = 0

	while elapsed < duration do
		local dt = RunService.Heartbeat:Wait()
		elapsed += dt

		if model.Parent == nil then
			return false
		end

		step(math.clamp(elapsed / duration, 0, 1))
	end

	return true
end

-- Die waagerechte Achse, um die eine Figur nach vorne oder hinten kippt:
-- quer zu ihrer Blickrichtung.
local function tiltAxis(pivot: CFrame): Vector3
	local right = Vector3.new(pivot.RightVector.X, 0, pivot.RightVector.Z)
	if right.Magnitude < EPSILON then
		return Vector3.xAxis
	end
	return right.Unit
end

-- Kippt `basePivot` um `radians` um eine Achse, die DURCH `foot` geht — die
-- Fuesse bleiben also stehen, nur der Koerper neigt sich. Zusaetzlich sackt
-- die Figur um `sink` Studs ab.
--
-- Vorzeichen: positive Radiant kippen nach HINTEN (Rechte-Hand-Regel um den
-- RightVector schwenkt den UpVector Richtung +Z, und Blickrichtung ist -Z).
-- Wer nach vorne will, uebergibt einen negativen Wert.
local function tilted(basePivot: CFrame, foot: Vector3, radians: number, sink: number): CFrame
	local hinge = CFrame.new(foot)
	local turn  = CFrame.fromAxisAngle(tiltAxis(basePivot), radians)

	return (hinge * turn * hinge:Inverse() * basePivot) + Vector3.new(0, -sink, 0)
end

--------------------------------------------------------------------------------
-- Ruhe-Atmen: EIN Loop fuer ALLE Figuren
--------------------------------------------------------------------------------
--
-- Pro Figur eine eigene RunService-Verbindung waere bei 8 Spielern plus deren
-- Arena-Gegnern ein gutes Dutzend paralleler Schleifen fuer eine Bewegung, die
-- sich in einem einzigen Callback genauso rechnen laesst. Deshalb: eine
-- Registry, ein Heartbeat.
--
-- Die Verbindung entsteht erst mit der ersten Figur und loest sich wieder,
-- sobald keine mehr registriert ist — ein leerer Server laesst also gar nichts
-- mitlaufen.

export type IdleOptions = {
	height : number?,   -- Studs Hub, Standard IDLE_DEFAULT_HEIGHT
	rate   : number?,   -- Schwingungen pro Sekunde, Standard IDLE_DEFAULT_RATE
}

type IdleEntry = {
	basePivot : CFrame,        -- Ruhelage, auf die jederzeit zurueckgesetzt wird
	options   : IdleOptions,   -- gemerkt, um nach einer Bewegung gleich weiterzumachen
	height    : number,
	rate      : number,
	phase     : number,        -- damit nicht alle Figuren im Gleichschritt wippen
}

local _idle: { [Model]: IdleEntry } = {}
local _idleConnection: RBXScriptConnection? = nil
local _idleClock = 0

local function stepIdle(dt: number)
	_idleClock += dt

	for model, entry in _idle do
		if model.Parent == nil then
			-- Figur ist aus der Welt verschwunden (Plot neu gebaut, Gegner
			-- weggeraeumt). Kein Aufrufer muss daran denken, sich abzumelden.
			_idle[model] = nil
			continue
		end

		-- (1 - cos) laeuft von 0 sanft nach oben und zurueck auf 0 — die Figur
		-- geht also nie UNTER ihre Ruhelage und damit nie in den Boden.
		local swing = (1 - math.cos(_idleClock * entry.rate * math.pi * 2 + entry.phase)) * 0.5
		model:PivotTo(entry.basePivot + Vector3.new(0, swing * entry.height, 0))
	end

	if next(_idle) == nil and _idleConnection then
		_idleConnection:Disconnect()
		_idleConnection = nil
	end
end

local function ensureIdleLoop()
	if _idleConnection then return end
	_idleConnection = RunService.Heartbeat:Connect(stepIdle)
end

-- Meldet eine STEHENDE Figur zum Ruhe-Atmen an und gibt die Stopp-Funktion
-- zurueck. Wer die Figur selbst bewegen will, muss vorher abmelden — sonst
-- ueberschreiben sich Idle-Loop und Bewegung gegenseitig.
--
-- Nochmal fuer dieselbe Figur aufgerufen: die alte Anmeldung wird sauber
-- beendet (Ruhelage wiederhergestellt) und die aktuelle Lage als neue Ruhelage
-- genommen. Ohne das wuerde sich der Hub bei jedem Neuanmelden aufaddieren.
function FigureFX.idleBob(model: Model, options: IdleOptions?): () -> ()
	FigureFX.stopIdle(model)

	local opts: IdleOptions = options or {}

	_idle[model] = {
		basePivot = model:GetPivot(),
		options   = opts,
		height    = opts.height or IDLE_DEFAULT_HEIGHT,
		rate      = opts.rate or IDLE_DEFAULT_RATE,
		phase     = math.random() * math.pi * 2,
	}

	ensureIdleLoop()

	return function()
		FigureFX.stopIdle(model)
	end
end

-- Meldet eine Figur ab und stellt ihre Ruhelage wieder her. Ohne das
-- Zuruecksetzen bliebe sie um den halben Hub in der Luft stehen — und genau
-- dieser Versatz wuerde in PitArenaService._home als "Heimatposition"
-- gespeichert.
--
-- Fuer eine nicht angemeldete Figur passiert nichts.
function FigureFX.stopIdle(model: Model)
	local entry = _idle[model]
	if not entry then return end

	_idle[model] = nil

	if model.Parent ~= nil then
		model:PivotTo(entry.basePivot)
	end
end

-- Nimmt einer Figur das Ruhe-Atmen fuer die Dauer einer eigenen Bewegung weg.
-- Gibt eine Funktion zurueck, die es an der DANN aktuellen Stelle wieder
-- aufnimmt — oder nil, wenn die Figur gar nicht geatmet hat.
local function takeOver(model: Model): (() -> ())?
	local entry = _idle[model]
	if not entry then return nil end

	FigureFX.stopIdle(model)

	return function()
		if model.Parent ~= nil then
			FigureFX.idleBob(model, entry.options)
		end
	end
end

--------------------------------------------------------------------------------
-- Kampf- und Fress-Bausteine
--------------------------------------------------------------------------------

-- Kurzer Ausfallschritt in Richtung `towardPosition` und zurueck: die Figur
-- setzt nach vorne, hebt dabei leicht ab und landet wieder exakt auf ihrem
-- Ausgangs-Fusspunkt. Die Ausrichtung bleibt unveraendert — sie schaut den
-- Gegner ja schon an.
--
-- Blockiert bis die Bewegung durch ist (wie FigureWalker.walk), damit der
-- Aufrufer die Reihenfolge im Kampf bestimmen kann.
function FigureFX.attackLunge(model: Model, towardPosition: Vector3, distance: number, duration: number)
	local resume = takeOver(model)

	local facing = model:GetPivot().Rotation
	local foot   = footOf(model)

	local flat  = Vector3.new(towardPosition.X, foot.Y, towardPosition.Z)
	local delta = flat - foot

	-- Steht der Gegner praktisch auf demselben Punkt, gibt es keine Richtung —
	-- dann bleibt der Ausfall aus, statt in eine zufaellige Richtung zu gehen.
	if delta.Magnitude > EPSILON then
		local direction = delta.Unit
		local hop       = distance * LUNGE_HOP_SHARE

		animate(model, duration, function(t)
			-- sin(pi*t): 0 → 1 → 0, also hin und wieder zurueck in einem Zug.
			local swing = math.sin(t * math.pi)
			FigurePlacement.place(
				model,
				foot + direction * (distance * swing) + Vector3.new(0, hop * swing, 0),
				facing
			)
		end)

		-- Immer sauber auf dem Ausgangspunkt enden, auch nach einem Abbruch.
		if model.Parent ~= nil then
			FigurePlacement.place(model, foot, facing)
		end
	end

	if resume then resume() end
end

-- Kurzes Aufleuchten als Treffer-Rueckmeldung. Kehrt sofort zurueck; das
-- Ausblenden laeuft nebenher.
--
-- Bewusst ein Highlight statt eines Farbpulses auf allen BaseParts: die
-- eigenen Farben und Transparenzen der Figur sind bereits belegt (Rarity-
-- Einfaerbung in BaerchiMesh, Erschoepfungs-Transparenz in MapService, die
-- Ausgangswerte liegen als Attribute an den Parts). Ein Highlight legt sich
-- darueber, ohne einen dieser Werte anzufassen — es kann also auch nichts
-- falsch wiederherstellen, wenn zwei Treffer kurz hintereinander kommen.
--
-- Occluded statt AlwaysOnTop: sonst leuchtete der Treffer quer ueber die
-- Plattform durch die Landschaft hindurch.
function FigureFX.hitFlash(model: Model, color: Color3, duration: number)
	local seconds = math.max(duration, MIN_SECONDS)

	local previous = model:FindFirstChild("HitFlash")
	if previous then
		previous:Destroy()
	end

	local highlight = Instance.new("Highlight")
	highlight.Name                = "HitFlash"
	highlight.FillColor           = color
	highlight.FillTransparency    = FLASH_FILL_TRANSPARENCY
	highlight.OutlineTransparency = 1
	highlight.DepthMode           = Enum.HighlightDepthMode.Occluded
	highlight.Adornee             = model
	highlight.Parent              = model

	TweenService:Create(
		highlight,
		TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ FillTransparency = 1 }
	):Play()

	task.delay(seconds, function()
		if highlight.Parent ~= nil then
			highlight:Destroy()
		end
	end)
end

-- Die Figur kippt nach hinten weg und sackt dabei etwas ab, statt einfach zu
-- verschwinden. Gedacht fuer den Moment VOR dem Aufraeumen — das Entfernen
-- selbst bleibt Sache des Aufrufers.
--
-- Meldet die Figur vom Ruhe-Atmen ab und nimmt es bewusst NICHT wieder auf:
-- eine umgekippte Figur soll liegen bleiben, nicht weiteratmen.
--
-- Blockiert bis die Bewegung durch ist.
function FigureFX.defeatCollapse(model: Model, duration: number)
	FigureFX.stopIdle(model)

	local basePivot = model:GetPivot()
	local foot      = footOf(model)
	local radians   = math.rad(COLLAPSE_DEGREES)
	local sink      = heightOf(model) * COLLAPSE_SINK_SHARE

	animate(model, duration, function(t)
		-- Quadratisch statt linear: erst langsam wegkippen, dann fallen.
		local fall = t * t
		model:PivotTo(tilted(basePivot, foot, radians * fall, sink * fall))
	end)
end

-- Die Figur beugt sich nach vorne, bleibt kurz unten und richtet sich wieder
-- auf — die "ich fresse gerade"-Bewegung am Honig-Teich.
--
-- `duration` ist die GESAMTE Dauer inklusive Verharren, damit der Aufrufer
-- einfach seine bisherige Wartezeit durchreichen kann, statt sie aufzuteilen.
-- Blockiert genau so lange.
function FigureFX.leanForward(model: Model, degrees: number, duration: number)
	local resume = takeOver(model)

	local basePivot = model:GetPivot()
	local foot      = footOf(model)

	-- Negativ = nach vorne (siehe tilted).
	local radians = -math.rad(degrees)
	local move    = (1 - LEAN_HOLD_SHARE) * 0.5   -- Anteil fuer Runter bzw. Hoch

	animate(model, duration, function(t)
		local amount: number
		if t < move then
			amount = t / move                      -- runterbeugen
		elseif t < move + LEAN_HOLD_SHARE then
			amount = 1                             -- unten bleiben
		else
			amount = (1 - t) / move                -- wieder aufrichten
		end

		model:PivotTo(tilted(basePivot, foot, radians * math.clamp(amount, 0, 1), 0))
	end)

	-- Sauber aufgerichtet enden, auch nach einem Abbruch.
	if model.Parent ~= nil then
		model:PivotTo(basePivot)
	end

	if resume then resume() end
end

--------------------------------------------------------------------------------
-- v15: Zusammenprall (Kampf-Choreografie)
--------------------------------------------------------------------------------
-- Ein Stoss im PIT: der Angreifer rennt auf den Gegner zu und springt ihn an,
-- der Gegner kommt ihm ein Stueck entgegen, beim Aufprall wird der Getroffene
-- zurueckgestossen, danach gehen beide an ihre Plaetze zurueck.
--
-- Anders als attackLunge bewegt clash ZWEI Figuren in einem Zug — getrennte
-- Aufrufe liefen nicht im Gleichtakt, und der Aufprall muss fuer beide im
-- selben Frame passieren.
--
-- Die Plaetze (Fusspunkte) kommen herein, statt sie hier abzulesen: im Kampf
-- weiss nur der Aufrufer, wo die Figuren hingehoeren (Turmetage). Waere eine
-- Figur von einem abgebrochenen Stoss noch verschoben, wuerde sie so trotzdem
-- wieder exakt auf ihren Platz gesetzt.

export type ClashOptions = {
	seconds   : number,           -- Gesamtdauer
	gap       : number,           -- Abstand der Fusspunkte beim Aufprall
	hop       : number,           -- Hoehe des Ansprungs
	knockback : number,           -- wie weit der Getroffene zurueckfliegt
	step      : number?,          -- Anteil des Wegs, den der Getroffene entgegenkommt
	onImpact  : (() -> ())?,      -- genau im Aufprall-Frame (Balken, Funken, Ton)
}

-- Form des Stosses (v15.1: natuerlicher). Anteile an der Gesamtdauer:
--   0 .. RUN_END     beide LAUFEN aufeinander zu: kleine Schritt-Huepfer,
--                    nach vorne geneigt, erst langsam, dann schneller
--   .. IMPACT_AT     der Angreifer setzt zum kurzen Sprung an (Bogen)
--   .. RECOIL_END    Aufprall: der Getroffene fliegt zurueck, der Angreifer
--                    prallt ab
--   .. 1             beide trotten an ihre Plaetze zurueck (kleine Schritte)
local CLASH_RUN_END      = 0.46
local CLASH_IMPACT_AT    = 0.60
local CLASH_RECOIL_END   = 0.76
local CLASH_LEAP_SHARE   = 0.30   -- Sprungweite als Anteil des Anlaufwegs
local CLASH_RUN_STEPS    = 4      -- Schritt-Huepfer waehrend des Anlaufs
local CLASH_BACK_STEPS   = 3      -- ... auf dem Rueckweg
local CLASH_STEP_HOP     = 0.30   -- Huepfhoehe eines Schritts, Anteil von `hop`
local CLASH_LEAN_DEGREES = 12     -- Vorlage beim Rennen
local CLASH_RECOIL_HOP   = 0.35   -- Huepfer des Getroffenen, Anteil von `hop`
local CLASH_BOUNCE       = 0.25   -- Angreifer prallt um diesen Anteil von `gap` ab
local CLASH_TARGET_DELAY = 0.25   -- der Getroffene laeuft etwas spaeter los

-- Weiche Kurve 0 → 1 (langsam rein, schnell, langsam raus).
local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end

-- Schritt-Huepfer: |sin| ergibt eine Folge kleiner Boegen, nie unter 0.
local function stepLift(k: number, steps: number, height: number): number
	return math.abs(math.sin(k * steps * math.pi)) * height
end

-- Figur auf `foot` stellen, mit Blick `facing`, um `degrees` nach vorne
-- geneigt (Fuesse bleiben am Boden, siehe tilted).
local function placeLeaning(model: Model, foot: Vector3, lift: number, facing: CFrame, degrees: number)
	FigurePlacement.place(model, foot + Vector3.new(0, lift, 0), facing)
	if degrees ~= 0 then
		model:PivotTo(tilted(model:GetPivot(), foot + Vector3.new(0, lift, 0), -math.rad(degrees), 0))
	end
end

-- Blockiert bis der Stoss durch ist. `target` darf fehlen (Gegner-Mesh nicht
-- da) — dann springt der Angreifer ins Leere, onImpact kommt trotzdem.
function FigureFX.clash(attacker: Model, target: Model?, attackerHome: Vector3, targetHome: Vector3, options: ClashOptions)
	local resumeA = takeOver(attacker)
	local resumeB = if target then takeOver(target) else nil

	local facingA = attacker:GetPivot().Rotation
	local facingB = if target then target:GetPivot().Rotation else facingA

	local flatTarget = Vector3.new(targetHome.X, attackerHome.Y, targetHome.Z)
	local delta = flatTarget - attackerHome
	local distance = delta.Magnitude
	local dir = if distance > EPSILON then delta.Unit else Vector3.zAxis

	-- Treffpunkt: der Getroffene kommt `step` des Wegs entgegen, der
	-- Angreifer landet `gap` davor. Der letzte Teil seines Wegs ist ein
	-- Sprung, davor wird gelaufen.
	local stepShare = options.step or 0
	local travel = math.max(0, distance - options.gap)
	local targetMeet = targetHome - dir * (travel * stepShare)
	local attackerMeet = Vector3.new(targetMeet.X, attackerHome.Y, targetMeet.Z) - dir * options.gap
	local runWay = (attackerMeet - attackerHome).Magnitude
	local leapStart = attackerMeet - dir * (runWay * CLASH_LEAP_SHARE)
	local targetPushed = targetHome + dir * options.knockback
	local attackerBounce = attackerMeet - dir * (options.gap * CLASH_BOUNCE)

	local stepHop = options.hop * CLASH_STEP_HOP
	local impacted = false

	local function placeTarget(foot: Vector3, lift: number, lean: number)
		if target and target.Parent ~= nil then
			placeLeaning(target, foot, lift, facingB, lean)
		end
	end

	animate(attacker, options.seconds, function(t)
		if t < CLASH_RUN_END then
			-- Anlauf: beschleunigen (k^1.6), Schritt-Huepfer, Vorlage.
			local k = t / CLASH_RUN_END
			local pos = attackerHome:Lerp(leapStart, k ^ 1.6)
			placeLeaning(attacker, pos, stepLift(k, CLASH_RUN_STEPS, stepHop), facingA,
				CLASH_LEAN_DEGREES * math.min(1, k * 3))

			-- Der Getroffene laeuft etwas spaeter los, ebenfalls mit Schritten.
			local kb = math.clamp((t / CLASH_IMPACT_AT - CLASH_TARGET_DELAY) / (1 - CLASH_TARGET_DELAY), 0, 1)
			placeTarget(targetHome:Lerp(targetMeet, smooth(kb)),
				stepLift(kb, CLASH_RUN_STEPS - 1, stepHop * 0.8), CLASH_LEAN_DEGREES * 0.6 * math.min(1, kb * 3))
		elseif t < CLASH_IMPACT_AT then
			-- Sprung: flacher Bogen bis zum Treffpunkt, leicht vorgebeugt.
			local k = (t - CLASH_RUN_END) / (CLASH_IMPACT_AT - CLASH_RUN_END)
			local lift = math.sin(k * math.pi) * options.hop
			placeLeaning(attacker, leapStart:Lerp(attackerMeet, k), lift, facingA, CLASH_LEAN_DEGREES * 1.3)

			local kb = math.clamp((t / CLASH_IMPACT_AT - CLASH_TARGET_DELAY) / (1 - CLASH_TARGET_DELAY), 0, 1)
			placeTarget(targetHome:Lerp(targetMeet, smooth(kb)), 0, CLASH_LEAN_DEGREES * 0.6)
		elseif t < CLASH_RECOIL_END then
			if not impacted then
				impacted = true
				if options.onImpact then
					options.onImpact()
				end
			end
			local k = (t - CLASH_IMPACT_AT) / (CLASH_RECOIL_END - CLASH_IMPACT_AT)
			local ease = 1 - (1 - k) * (1 - k)
			placeLeaning(attacker, attackerMeet:Lerp(attackerBounce, ease), 0, facingA, CLASH_LEAN_DEGREES * (1 - k))
			-- Der Getroffene wird nach hinten gekippt zurueckgestossen.
			local lift = math.sin(k * math.pi) * options.hop * CLASH_RECOIL_HOP
			placeTarget(targetMeet:Lerp(targetPushed, ease), lift, -CLASH_LEAN_DEGREES * math.sin(k * math.pi))
		else
			-- Zurueck an die Plaetze, in kleinen Schritten statt zu gleiten.
			local k = (t - CLASH_RECOIL_END) / (1 - CLASH_RECOIL_END)
			local e = smooth(k)
			placeLeaning(attacker, attackerBounce:Lerp(attackerHome, e), stepLift(k, CLASH_BACK_STEPS, stepHop * 0.6), facingA, 0)
			placeTarget(targetPushed:Lerp(targetHome, e), stepLift(k, CLASH_BACK_STEPS - 1, stepHop * 0.5), 0)
		end
	end)

	-- Bei sehr kurzen Dauern kann der Aufprall-Frame uebersprungen werden.
	if not impacted and options.onImpact then
		options.onImpact()
	end

	-- Immer exakt auf den Plaetzen enden, auch nach einem Abbruch.
	if attacker.Parent ~= nil then
		FigurePlacement.place(attacker, attackerHome, facingA)
	end
	if target and target.Parent ~= nil then
		FigurePlacement.place(target, targetHome, facingB)
	end

	if resumeA then resumeA() end
	if resumeB then resumeB() end
end

-- Taumeln (betaeubt): die Figur wankt kurz hin und her, Fuesse bleiben
-- stehen. Blockiert bis die Bewegung durch ist.
local STAGGER_DEGREES = 12
local STAGGER_SWINGS  = 2

function FigureFX.stagger(model: Model, duration: number)
	local resume = takeOver(model)

	local basePivot = model:GetPivot()
	local foot      = footOf(model)
	local radians   = math.rad(STAGGER_DEGREES)

	animate(model, duration, function(t)
		local swing = math.sin(t * math.pi * 2 * STAGGER_SWINGS) * (1 - t)
		model:PivotTo(tilted(basePivot, foot, radians * swing, 0))
	end)

	if model.Parent ~= nil then
		model:PivotTo(basePivot)
	end

	if resume then resume() end
end

-- Ein kurzer Ton an einer Weltposition (Aufprall). Alle Spieler in der Naehe
-- hoeren ihn, weil er serverseitig in der Welt haengt. Leise Grenzen fuer die
-- Reichweite, damit ein Kampf nicht ueber die ganze Karte schallt.
function FigureFX.soundAt(position: Vector3, soundId: string, volume: number, parent: Instance, pitch: number?)
	local anchor = Instance.new("Part")
	anchor.Name         = "FXSound"
	anchor.Anchored     = true
	anchor.CanCollide   = false
	anchor.CanTouch     = false
	anchor.CanQuery     = false
	anchor.Transparency = 1
	anchor.Size         = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame       = CFrame.new(position)
	anchor.Parent       = parent

	local sound = Instance.new("Sound")
	sound.SoundId            = soundId
	sound.Volume             = volume
	sound.PlaybackSpeed      = pitch or 1
	sound.RollOffMode        = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 8
	sound.RollOffMaxDistance = 70
	sound.Parent             = anchor
	sound:Play()

	Debris:AddItem(anchor, 2)
end

--------------------------------------------------------------------------------
-- Feier-Momente: Partikel-Stoss + Huepfer + Aufleuchten
--------------------------------------------------------------------------------
-- Fuer Ereignisse, die vorher nur als Toast-Text sichtbar waren (Level-Up,
-- Promotion, Rebirth, Ei einsammeln) — siehe
-- DESIGN_VORSCHLAG_TRENDANALYSE_2026-09-11.md, Abschnitt 4. WICHTIG: das
-- passiert in der geteilten Welt, alle 8 Spieler sehen es mit, nicht nur der
-- Besitzer — genau das macht den Unterschied zu einem reinen UI-Toast.

-- Ein einmaliger Partikel-Stoss an einer Attachment/BasePart. Feuert sofort
-- `count` Partikel und raeumt sich selbst ab (Debris) — kein Dauer-Emitter,
-- der irgendwo vergessen werden koennte.
local function burstParticles(parent: Instance, color: Color3, count: number)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture      = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color        = ColorSequence.new(color)
	emitter.Size          = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency  = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime      = NumberRange.new(0.5, 0.9)
	emitter.Speed         = NumberRange.new(6, 12)
	emitter.SpreadAngle   = Vector2.new(180, 180)
	emitter.Rate          = 0   -- kein Dauerstrom, nur der Emit()-Stoss unten
	emitter.Parent        = parent

	emitter:Emit(count)

	Debris:AddItem(emitter, 1.2)
end

-- Feier-Moment an einer FIGUR: ein kurzer Freuden-Huepfer (rein vertikal,
-- Fusspunkt bleibt stehen), ein Partikel-Stoss in `color`, und ein kurzes
-- Aufleuchten (wiederverwendet hitFlash — dieselbe Technik, andere Bedeutung).
--
-- Blockiert NICHT: laeuft als eigene Coroutine, damit der aufrufende Service
-- (der gerade PlayerService.markDirty/saveNow aufrufen will) nicht auf eine
-- Zierbewegung warten muss.
function FigureFX.celebrate(model: Model, color: Color3, duration: number?)
	local seconds = math.max(duration or CELEBRATE_DEFAULT_SECONDS, MIN_SECONDS)

	local anchor = (model.PrimaryPart :: BasePart?) or (model:FindFirstChildWhichIsA("BasePart", true) :: BasePart?)
	if anchor then
		local attachment = Instance.new("Attachment")
		attachment.Name   = "CelebrateBurst"
		attachment.Parent = anchor

		burstParticles(attachment, color, CELEBRATE_PARTICLE_COUNT)
		Debris:AddItem(attachment, 1.3)
	end

	FigureFX.hitFlash(model, color, CELEBRATE_FLASH_SECONDS)

	task.spawn(function()
		local resume = takeOver(model)

		local basePivot = model:GetPivot()
		local hop        = heightOf(model) * CELEBRATE_HOP_HEIGHT_SHARE

		animate(model, seconds, function(t)
			-- sin(pi*t): hoch und wieder runter in einem Zug, wie ein einzelner
			-- Freudensprung — dieselbe Kurve wie beim Ausfallschritt.
			local swing = math.sin(t * math.pi)
			model:PivotTo(basePivot + Vector3.new(0, hop * swing, 0))
		end)

		if model.Parent ~= nil then
			model:PivotTo(basePivot)
		end

		if resume then resume() end
	end)
end

-- Feier-Moment an einer FESTEN WELTPOSITION, ohne Model — fuer Momente wie
-- das Einsammeln eines Eis, wo es keine Figur gibt, an die der Effekt haengen
-- koennte. Baut einen unsichtbaren, nicht-kollidierenden Anker-Part, feuert
-- den Partikel-Stoss, und raeumt beides selbst wieder ab.
function FigureFX.burstAt(position: Vector3, color: Color3, parent: Instance, count: number?)
	local anchor = Instance.new("Part")
	anchor.Name         = "FXAnchor"
	anchor.Anchored     = true
	anchor.CanCollide   = false
	anchor.CanTouch     = false
	anchor.CanQuery     = false
	anchor.Transparency = 1
	anchor.Size         = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame       = CFrame.new(position)
	anchor.Parent       = parent

	burstParticles(anchor, color, count or CELEBRATE_PARTICLE_COUNT)

	Debris:AddItem(anchor, 1.3)
end

return FigureFX
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX61"><Properties><string name="Name">FigurePlacement</string><ProtectedString name="Source"><![CDATA[--!strict
-- FigurePlacement.luau
-- ServerScriptService/Util/FigurePlacement.luau
--
-- Einzige Zustaendigkeit:
--   - Ein Model so hinstellen, dass die Unterkante seiner Bounding-Box exakt
--     auf einem Fusspunkt liegt — in einer vorgegebenen Blickrichtung.
--
-- Warum es diese Datei gibt:
-- Genau das stand vorher zweimal fast identisch im Projekt — als
-- FigureWalker.placeFoot (laeuft jeden Frame waehrend einer Bewegung) und als
-- PitArenaService.placeModel (stellt die Kaempfer in der Arena auf). Beide
-- taten dasselbe und unterschieden sich nur darin, WORAUF sie ausrichten:
-- eine fertige facing-CFrame gegenueber "schau zu diesem Punkt". Hier steht
-- jetzt die eine Implementierung; das "schau zu X" ist eine duenne Schicht
-- darueber (placeLookingAt).
--
-- Eigenes Util statt einer Funktion in FigureWalker: Hinstellen ist keine
-- Lauf-Animation. PitArenaService stellt Gegner auf, die nie einen Schritt
-- machen, und muesste sonst einen "Walker" requiren, nur um ein Model
-- hinzustellen.
--
-- ============================================================
-- ZWEI SCHRITTE — UND DIE REIHENFOLGE IST WICHTIG
-- ============================================================
-- Erst drehen, dann messen und verschieben. Andersherum wuerde die Drehung das
-- Model wieder von seinem Standpunkt wegschieben, weil sich die
-- achsenparallele Bounding-Box beim Drehen aendert. Aus demselben Grund wird
-- JEDES Mal neu gemessen statt den Pivot einmalig zu verschieben: bei jeder
-- neuen Drehung laege eine gemerkte Verschiebung leicht daneben.
--
-- Die Ausrichtung wird ABSOLUT gesetzt, nicht auf die bestehende
-- draufgerechnet. Wer die aktuelle Drehung behalten will, uebergibt
-- `model:GetPivot().Rotation`. Das setzt voraus, dass der Pivot des
-- importierten Mesh selbst ungedreht ist — waere er das nicht, staenden schon
-- die Figuren auf dem Plot schief.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local BaerchiMesh       = require(ReplicatedStorage.Modules.BaerchiMesh)

local FigurePlacement = {}

-- Ab welchem Abstand ein Blickziel ueberhaupt eine Richtung ergibt. Darunter
-- waere CFrame.lookAt nicht definiert (Ziel == Standpunkt).
local LOOK_EPSILON = 1e-3

-- Dreht `model` auf die Drehung von `facing` und stellt es danach so hin, dass
-- die Unterkante seiner Bounding-Box auf `footPos` liegt.
function FigurePlacement.place(model: Model, footPos: Vector3, facing: CFrame)
	model:PivotTo(CFrame.new(model:GetPivot().Position) * facing.Rotation)

	-- Sammel-Update 1.2: Unterkante WELT-ausgerichtet aus den sichtbaren
	-- Teilen (BaerchiMesh.worldBottomY), nicht aus der am body gedrehten
	-- Bounding-Box — sonst steckten kleine Figuren in den Tower-Platten.
	local boxCFrame, size = model:GetBoundingBox()
	local bottomCenter = Vector3.new(
		boxCFrame.Position.X,
		BaerchiMesh.worldBottomY(model) or (boxCFrame.Position.Y - size.Y * 0.5),
		boxCFrame.Position.Z
	)

	model:PivotTo(model:GetPivot() + (footPos - bottomCenter))
end

-- Sammel-Update 1.2: Fusspunkt einer Figur (Mitte unten, Unterkante
-- welt-ausgerichtet). Muss zu place() passen: place(m, footOf(m), ...) darf
-- die Figur nicht verschieben — sonst wandert sie bei jedem Schritt.
-- Alle Dienste, die "wo steht die Figur" fragen, nehmen diese Funktion.
function FigurePlacement.footOf(model: Model): Vector3
	local boxCFrame, size = model:GetBoundingBox()
	return Vector3.new(
		boxCFrame.Position.X,
		BaerchiMesh.worldBottomY(model) or (boxCFrame.Position.Y - size.Y * 0.5),
		boxCFrame.Position.Z
	)
end

-- Wie place(), aber die Blickrichtung ergibt sich aus einem Zielpunkt: das
-- Model schaut von `footPos` zu `lookTarget`, nur um die senkrechte Achse
-- (die Hoehe des Ziels wird bewusst ignoriert — sonst wuerde die Figur sich
-- nach vorne oder hinten neigen).
--
-- Liegt das Ziel praktisch auf dem Fusspunkt, bleibt die aktuelle Drehung
-- stehen, statt sie auf eine undefinierte Richtung zu setzen.
function FigurePlacement.placeLookingAt(model: Model, footPos: Vector3, lookTarget: Vector3)
	local flatTarget = Vector3.new(lookTarget.X, footPos.Y, lookTarget.Z)

	local facing = if (flatTarget - footPos).Magnitude > LOOK_EPSILON
		then CFrame.lookAt(footPos, flatTarget)
		else model:GetPivot()

	FigurePlacement.place(model, footPos, facing)
end

return FigurePlacement
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX68"><Properties><string name="Name">MapBuild</string></Properties><Item class="ModuleScript" referent="RBX62"><Properties><string name="Name">FigureBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- FigureBuilder.luau
-- ServerScriptService/Util/MapBuild/FigureBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Die sichtbare Figur des ausgeruesteten Baerchis bauen und ihren Zustand
--     (Namensschild, HP, erschoepft) anzeigen
--
-- Es gibt pro Plot nur EINE Figur: die des ausgeruesteten Baerchis. Alle
-- anderen Baerchis sind reine Inventar-Daten.
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local BaerchiMesh      = require(ReplicatedStorage.Modules.BaerchiMesh)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local Types            = require(ReplicatedStorage.Network.Types)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local Names     = require(ReplicatedStorage.Localization.Names)
local WorldText = require(ReplicatedStorage.Localization.WorldText)

local FigureFX         = require(ServerScriptService.Util.FigureFX)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local FigureBuilder = {}

-- Beschriftung und Erschoepfungs-Zustand einer bereits stehenden Figur.
-- Getrennt vom Aufbau, weil sich HP staendig aendern und ein kompletter
-- Neuaufbau der Mesh-Figuren dafuer viel zu teuer waere.
function FigureBuilder.writeFigureState(model: Model, rawHp: number, maxHp: number)
	local hp        = math.clamp(rawHp, 0, maxHp)
	local exhausted = hp <= 0

	local label = model:FindFirstChild("Health", true)
	if label and label:IsA("TextLabel") then
		WorldText.set(label, if exhausted
			then Loc.msg("ui.world.exhausted")
			else string.format("%d / %d HP", hp, maxHp))

		label.TextColor3 = if exhausted
			then Color3.fromRGB(255, 120, 120)
			elseif hp < maxHp * 0.34 then Color3.fromRGB(255, 205, 110)
			else Color3.fromRGB(190, 245, 195)
	end

	-- Ein erschoepfter Baerchi wird matt. Bewusst nicht komplett durchsichtig:
	-- er ist ausser Gefecht, nicht weg.
	--
	-- Die urspruengliche Transparenz jedes Teils steht als Attribut daran
	-- (gesetzt beim Aufbau). Sie einfach auf 0 zurueckzusetzen wuerde sonst
	-- absichtliche Durchsichtigkeit im importierten Modell zerstoeren — der
	-- Gummy-Baer ist genau dafuer ein Beispiel.
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local stored = part:GetAttribute("BaseTransparency")
			local base   = if typeof(stored) == "number" then stored else 0

			part.Transparency = if exhausted
				then math.max(base, MapConfig.BAERCHI_EXHAUSTED_TRANSPARENCY)
				else base
		end
	end
end

-- Wie writeFigureState, aber respektiert einen laufenden PIT-Kampf.
--
-- Waehrend eines Laufs gehoert die Figur dem PitArenaService: der Kampf ist
-- serverseitig schon ausgerechnet und die HP stehen bereits auf dem Endwert,
-- waehrend die Wiedergabe in der Arena noch laeuft. Wuerde hier
-- dazwischengeschrieben, saehe der Baerchi ab der ersten Sekunde erschoepft
-- aus statt am Ende. PitArenaService zieht den Zustand selbst nach.
function FigureBuilder.writeBaerchiState(model: Model, baerchi: Types.Baerchi, maxHp: number)
	if model:GetAttribute("InArena") == true then
		return
	end

	FigureBuilder.writeFigureState(model, baerchi.currentHp, maxHp)
end

-- Eine Baerchi-Figur: das geklonte Pet-Mesh aus BaerchiMesh.build. Welches
-- Modell das ist (eigenes fuer diese Rarity oder der gemeinsame Platzhalter)
-- und ob es eingefaerbt wird, entscheidet BaerchiMesh selbst.
--
-- JEDE BasePart der Figur traegt das Attribut "BaerchiUid" und einen eigenen
-- ClickDetector — bei einem Mesh aus mehreren Teilen waere ein einzelner
-- Hitbereich schwer zu treffen. Der Client (WorldController) liest das
-- Attribut beim Klick und schlaegt die Details in seinem eigenen Datenstand
-- nach — dafuer braucht es kein zusaetzliches Remote.
--
-- Fehlt das Mesh-Template noch, gibt BaerchiMesh.build nil zurueck — dann
-- wird diese eine Figur uebersprungen, der Rest des Plots baut sich normal.
function FigureBuilder.buildBaerchiFigure(parent: Instance, baerchi: Types.Baerchi, footPos: Vector3, facing: CFrame): Model?
	local color = BaerchiConfig.getRarityColor(baerchi.rarity)

	-- Ein MUTIERTER Baerchi (seit v11, ersetzt das fruehere binaere Inverted)
	-- bekommt die Farbe seiner Mutations-Stufe und leuchtet (siehe
	-- BaerchiMesh.build). Fuer alle anderen ist der vierte Parameter nil und
	-- es aendert sich nichts.
	local mutationColor = if baerchi.mutation
		then BaerchiConfig.getMutationColor(baerchi.mutation)
		else nil

	local model = BaerchiMesh.build(footPos, color, baerchi.rarity, mutationColor)
	if not model then
		return nil
	end
	model.Name = "Baerchi_" .. baerchi.uid

	-- BaerchiMesh stellt die Figur achsen-parallel hin. Hier wird sie noch in
	-- die Blickrichtung des Plots gedreht — und zwar um die senkrechte Achse
	-- DURCH footPos, nicht um den Modell-Pivot: wo der Pivot im importierten
	-- Mesh liegt, weiss dieses Modul nicht, eine Drehung darum wuerde die
	-- Figur seitlich wegschieben.
	local rotation = facing.Rotation
	local toOrigin = CFrame.new(-footPos)
	model:PivotTo(CFrame.new(footPos) * rotation * toOrigin * model:GetPivot())

	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part:SetAttribute("BaerchiUid", baerchi.uid)

			-- Ausgangs-Transparenz merken, damit der Erschoepfungs-Zustand
			-- sie spaeter nicht ueberschreibt (siehe writeBaerchiState).
			part:SetAttribute("BaseTransparency", part.Transparency)

			local click = Instance.new("ClickDetector")
			click.MaxActivationDistance = MapConfig.BAERCHI_CLICK_DISTANCE
			click.Parent = part
		end
	end

	-- Rarity-Aura: ab Rare ein dezentes Dauer-Glitzern, ab Epic zusaetzlich ein
	-- PointLight. Nutzt dieselbe Farbe wie die Koerpereinfaerbung
	-- (BaerchiConfig.getRarityColor) — Seltenheit soll auch aus der Distanz auf
	-- einen Blick erkennbar sein, nicht erst beim Ranschauen des Namensschilds.
	-- Siehe DESIGN_VORSCHLAG_TRENDANALYSE_2026-09-11.md Abschnitt 5.
	--
	-- Haengt an EINEM zentralen Part (nicht an jedem BasePart wie der
	-- ClickDetector oben): ein Glitzern pro Teilstueck des Mesh saehe wie ein
	-- Funkensturm aus, nicht wie eine Aura.
	local auraAnchor = (model.PrimaryPart :: BasePart?) or (model:FindFirstChildWhichIsA("BasePart", true) :: BasePart?)
	if auraAnchor then
		local rarityKey = baerchi.rarity :: string

		if MapConfig.RARITY_AURA_MIN_SPARKLE[rarityKey] then
			local sparkle = Instance.new("ParticleEmitter")
			sparkle.Name          = "RarityAura"
			sparkle.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
			sparkle.Color         = ColorSequence.new(color)
			sparkle.Size          = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.35),
				NumberSequenceKeypoint.new(1, 0),
			})
			sparkle.Transparency  = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			})
			sparkle.Lifetime      = NumberRange.new(0.8, 1.4)
			sparkle.Speed         = NumberRange.new(1, 3)
			sparkle.SpreadAngle   = Vector2.new(180, 180)
			sparkle.Rate          = MapConfig.RARITY_AURA_PARTICLE_RATE
			sparkle.Parent        = auraAnchor
		end

		if MapConfig.RARITY_AURA_MIN_LIGHT[rarityKey] then
			local light = Instance.new("PointLight")
			light.Name       = "RarityAuraLight"
			light.Color      = color
			light.Range      = MapConfig.RARITY_AURA_LIGHT_RANGE
			light.Brightness = MapConfig.RARITY_AURA_LIGHT_BRIGHTNESS
			light.Parent     = auraAnchor
		end

		-- Mutations-Aura (seit v11): unabhaengig von der Rarity-Aura oben, weil
		-- eine Mutation auch einen Common treffen kann, der sonst nie eine Aura
		-- haette. JEDE Mutation bekommt zumindest ein Punktlicht in ihrer
		-- eigenen Farbe; ab Multiplikator 4x (Celestial/Candy/Lava/Galaxy/
		-- Rainbow — siehe BaerchiConfig.MUTATIONS) zusaetzlich ein dichteres
		-- Glitzern, damit die seltensten Baerchis im Spiel auch aus der
		-- Distanz sofort als etwas Besonderes auffallen.
		if baerchi.mutation then
			local mutColor = BaerchiConfig.getMutationColor(baerchi.mutation)

			local mutLight = Instance.new("PointLight")
			mutLight.Name       = "MutationAuraLight"
			mutLight.Color      = mutColor
			mutLight.Range      = MapConfig.RARITY_AURA_LIGHT_RANGE
			mutLight.Brightness = MapConfig.RARITY_AURA_LIGHT_BRIGHTNESS * 1.5
			mutLight.Parent     = auraAnchor

			if BaerchiConfig.getMutationMultiplier(baerchi.mutation) >= 4 then
				local mutSparkle = Instance.new("ParticleEmitter")
				mutSparkle.Name          = "MutationAura"
				mutSparkle.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
				mutSparkle.Color         = ColorSequence.new(mutColor)
				mutSparkle.Size          = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(1, 0),
				})
				mutSparkle.Transparency  = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.15),
					NumberSequenceKeypoint.new(1, 1),
				})
				mutSparkle.Lifetime      = NumberRange.new(1.0, 1.8)
				mutSparkle.Speed         = NumberRange.new(2, 5)
				mutSparkle.SpreadAngle   = Vector2.new(180, 180)
				mutSparkle.Rate          = MapConfig.RARITY_AURA_PARTICLE_RATE * 2
				mutSparkle.Parent        = auraAnchor
			end
		end
	end

	-- Namensschild ueber dem Kopf (faellt auf den Body zurueck, falls das
	-- Template keinen Part namens "head" hat). Rekursiv gesucht: der Importer
	-- packt die Teile in eine Zwischen-Gruppe.
	--
	-- Drei Zeilen statt zwei seit dem Ei-Legen: Name+Level, HP, und ganz unten
	-- der Ei-Timer. Der Ei-Timer-Text wird HIER nur als leeres Label angelegt —
	-- befuellt wird er rein clientseitig (EggTimerController), weil er
	-- sekuendlich weiterzaehlt und dafuer keine Serverlast noetig ist (siehe
	-- Kommentar-Kopf dort).
	local labelAnchor = (model:FindFirstChild("head", true) :: BasePart?) or model.PrimaryPart
	if labelAnchor then
		-- Sammel-Update 1.4 ("Naechstes Ei in: ist im Baerchi und braucht mehr
		-- Space"): breiter und hoeher (laengere Texte auf Franzoesisch/
		-- Spanisch), und der Abstand kommt aus der echten Oberkante der Figur
		-- (welt-ausgerichtet) statt aus der am body gedrehten Bounding-Box —
		-- das Schild sitzt damit immer UEBER dem Kopf, nie darin.
		local billboard = Instance.new("BillboardGui")
		billboard.Name        = "Label"
		billboard.Size        = UDim2.fromScale(MapConfig.FIGURE_LABEL.width, MapConfig.FIGURE_LABEL.height)
		local _, topY = BaerchiMesh.worldBoundsY(model)
		local anchorY = labelAnchor.Position.Y
		local aboveHead = if topY then math.max(0, (topY :: number) - anchorY) else BaerchiMesh.getHeight(model) * 0.55
		billboard.StudsOffset = Vector3.new(0, aboveHead + MapConfig.FIGURE_LABEL.height * 0.5 + MapConfig.FIGURE_LABEL.gap, 0)
		billboard.AlwaysOnTop = false
		billboard.MaxDistance = MapConfig.BAERCHI_CLICK_DISTANCE
		billboard.Adornee     = labelAnchor
		billboard.Parent      = labelAnchor

		local name = MapParts.newTextLabel("Name", billboard, UDim2.fromScale(1, 0.34), UDim2.fromScale(0, 0))
		-- Das Namensschild ist die zweite Stelle, an der eine Mutation
		-- auffaellt (die erste ist die leuchtende Mutations-Farbe der
		-- Figur selbst). Beides zusammen, weil die Farbe allein bei einer
		-- Rarity mit ungewohnter Palette nicht eindeutig genug waere —
		-- und weil ein Spieler lesen koennen soll, WELCHE der acht Stufen
		-- es genau ist (die Farbe allein verraet das nicht zuverlaessig).
		-- Als Nachricht: jeder Spieler liest den Namen in seiner Sprache (WorldText)
		WorldText.set(name, Loc.msg("ui.world.figure_name", {
			badge = if baerchi.mutation then BaerchiConfig.getMutationBadge(baerchi.mutation) .. " " else "",
			name  = Names.msg.baerchi(baerchi.configId),
			level = baerchi.level,
		}))

		if baerchi.mutation then
			name.TextColor3 = BaerchiConfig.getMutationColor(baerchi.mutation)
		end

		MapParts.newTextLabel("Health", billboard, UDim2.fromScale(1, 0.28), UDim2.fromScale(0, 0.34))

		-- Ei-Timer bekommt die groesste Zeile: er ist der laengste Text.
		local eggTimer = MapParts.newTextLabel("EggTimer", billboard, UDim2.fromScale(1, 0.38), UDim2.fromScale(0, 0.62))
		eggTimer.TextColor3 = Color3.fromRGB(255, 224, 140)   -- Ei-Gold, passend zur HUD-Farbwelt
		eggTimer.Text        = ""   -- EggTimerController fuellt das im ersten Tick
	end

	model.Parent = parent
	return model
end

-- Maximale HP eines Baerchis. Liegt hier statt inline, weil sowohl der Aufbau
-- als auch die In-Place-Aktualisierung sie brauchen.
function FigureBuilder.maxHpOf(baerchi: Types.Baerchi): number
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then return 1 end

	return CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
end

-- Baut die sichtbare Baerchi-Figur eines Plots neu: seit dem Equip-System
-- steht dort hoechstens EINE — der ausgeruestete Baerchi. Alle anderen sind
-- reiner Inventar-Datensatz und werden nicht in die Welt gebaut. Ist keiner
-- ausgeruestet (leerer Plot, z.B. direkt nach einem Rebirth), bleibt der
-- Ordner einfach leer.
function FigureBuilder.renderBaerchis(plotModel: Model, slot: number, islandData: Types.IslandData)
	local old = plotModel:FindFirstChild("Baerchis")
	if old then old:Destroy() end

	local folder = Instance.new("Folder")
	folder.Name   = "Baerchis"
	folder.Parent = plotModel

	local equippedUid = islandData.equippedUid
	local equipped = if equippedUid then islandData.baerchis[equippedUid] else nil
	if not equipped then
		return
	end

	local plotCFrame = MapParts.plotCFrame(slot)
	local home       = MapLayout.baerchiHomeOffset()   -- HONEY_POND_V2: am Becken
	local footPos    = (plotCFrame * CFrame.new(home.X, MapParts.plotSurfaceOffset() + home.Y, home.Z)).Position

	local figure = FigureBuilder.buildBaerchiFigure(folder, equipped, footPos, plotCFrame)
	if figure then
		FigureBuilder.writeBaerchiState(figure, equipped, FigureBuilder.maxHpOf(equipped))

		-- Eine frisch gebaute Figur steht — also atmet sie. Wer sie danach
		-- selbst bewegt (PitArenaService, BaerchiAutopilotService), meldet sie
		-- vorher ab und danach wieder an. Die alte Figur ist eine Zeile weiter
		-- oben zerstoert worden; ihr Registry-Eintrag raeumt sich beim
		-- naechsten Durchlauf des Idle-Loops selbst weg.
		FigureFX.idleBob(figure, {
			height = MapConfig.IDLE_BOB_HEIGHT,
			rate   = MapConfig.IDLE_BOB_RATE,
		})
	end
end

return FigureBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX63"><Properties><string name="Name">IncubatorBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- IncubatorBuilder.luau
-- ServerScriptService/Util/MapBuild/IncubatorBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Den Inkubator auf dem Plot bauen (Sockel + Glaskuppeln) und den Stand
--     jeder Kuppel schreiben (Ei sichtbar, Zeitmarken als Attribute).
--
-- Kontext: Sammel-Update 05.10., Paket 8. Teil von MapService, nur MapService
-- benutzt dieses Modul; es aendert keine Spielerdaten.
--
-- Teile-Budget (IncubatorConfig.PART_BUDGET = 20): Sockel 1 + Zierleiste 1 +
-- je Kuppel Polster, Glas, Ei (3 x 6). Fortschrittsbalken und Leuchten macht
-- der Client (IncubatorController) aus den Attributen StartedAt/FinishAt —
-- ohne Server-Takt pro Ei.
--
-- Die Kuppeln heissen "Dome_<n>" und tragen die Attribute:
--   Slot (n), Unlocked (Platz verfuegbar), EggType ("" = leer),
--   StartedAt, FinishAt (os.time, 0 = leer).

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types           = require(ReplicatedStorage.Network.Types)
local EggConfig       = require(ReplicatedStorage.Config.EggConfig)
local IncubatorConfig = require(ReplicatedStorage.Config.IncubatorConfig)
local IncubatorRules  = require(ReplicatedStorage.Modules.IncubatorRules)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local BaerchiMesh     = require(ReplicatedStorage.Modules.BaerchiMesh)
local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local IncubatorBuilder = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))   -- Zylinder stehend

-- Mitte der Kuppel `index` relativ zum Sockel (2 Reihen x 3 Spalten).
local function domeOffset(index: number): Vector3
	local look = IncubatorConfig.LOOK
	local cols = look.columns
	local col = (index - 1) % cols
	local row = math.floor((index - 1) / cols)
	local rows = math.ceil(IncubatorConfig.MAX_SLOTS / cols)
	return Vector3.new(
		(col - (cols - 1) * 0.5) * look.spacing.X,
		0,
		(row - (rows - 1) * 0.5) * look.spacing.Z
	)
end

-- INCUBATOR_BREED: kleine Figur des Baerchis in der Kuppel. Wird nur neu
-- gebaut, wenn ein anderer Baerchi im Platz sitzt (Attribut "Uid"). Die Teile
-- der Figur zaehlen nicht zum PART_BUDGET des Sockels (wie die Plot-Figuren).
local function placeBreederFigure(model: Model, index: number, baerchi: Types.Baerchi?)
	local name = "Breeder_" .. index
	local old = model:FindFirstChild(name)
	if old and baerchi and old:GetAttribute("Uid") == baerchi.uid then return end
	if old then old:Destroy() end
	if not baerchi then return end

	local pad = model:FindFirstChild("Pad_" .. index)
	if not (pad and pad:IsA("BasePart")) then return end
	local look = IncubatorConfig.LOOK
	local foot = pad.Position + Vector3.new(0, look.padSize.X * 0.5, 0)
	local mutationColor = if baerchi.mutation then BaerchiConfig.getMutationColor(baerchi.mutation) else nil
	local ok, figure = pcall(BaerchiMesh.build, foot, BaerchiConfig.getRarityColor(baerchi.rarity), baerchi.rarity, mutationColor)
	if not ok or not figure then return end

	-- Auf Kuppel-Groesse schrumpfen, dann wieder auf das Polster stellen.
	local height = BaerchiMesh.getHeight(figure)
	if height > 0 then
		figure:ScaleTo(figure:GetScale() * IncubatorConfig.BREED_FIGURE_HEIGHT / height)
	end
	local bottom = BaerchiMesh.worldBottomY(figure)
	if bottom then
		figure:PivotTo(figure:GetPivot() + Vector3.new(0, foot.Y - bottom, 0))
	end
	for _, part in figure:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
		end
	end
	figure.Name = name
	figure:SetAttribute("Uid", baerchi.uid)
	figure.Parent = model
end

-- Schreibt den Stand aller Kuppeln (billig, laeuft bei jeder Aenderung).
function IncubatorBuilder.writeState(model: Model, incubator: Types.IncubatorData, slotCount: number,
	baerchis: { [string]: Types.Baerchi }?)
	local breed = FeatureFlags.isOn("INCUBATOR_BREED")
	local look = IncubatorConfig.LOOK
	model:SetAttribute("Level", incubator.level)
	model:SetAttribute("SlotCount", slotCount)
	for index = 1, IncubatorConfig.MAX_SLOTS do
		local dome = model:FindFirstChild("Dome_" .. index)
		if not (dome and dome:IsA("BasePart")) then continue end
		local entry = IncubatorRules.findSlot(incubator.slots, index)
		local unlocked = index <= slotCount
		dome:SetAttribute("Unlocked", unlocked)
		dome:SetAttribute("EggType", if entry then entry.eggType else "")
		dome:SetAttribute("StartedAt", if entry then entry.startedAt else 0)
		dome:SetAttribute("FinishAt", if entry then entry.finishAt else 0)
		dome.Transparency = if unlocked or entry then look.domeTransparency else look.lockedTransparency

		local egg = model:FindFirstChild("Egg_" .. index)
		if egg and egg:IsA("BasePart") then
			local def = if entry then EggConfig.data[entry.eggType] else nil
			egg.Transparency = if def then 0 else 1
			if def then egg.Color = def.color end
		end

		-- INCUBATOR_BREED: Baerchi im Platz. Attribute fuer die Anzeige
		-- (IncubatorController): BreederUid, LastEggAt, BreedSeconds.
		local breeder = if breed then IncubatorRules.findBreeder(incubator.breeders, index) else nil
		local baerchi = if breeder and baerchis then baerchis[breeder.uid] else nil
		dome:SetAttribute("BreederUid", if baerchi then baerchi.uid else "")
		dome:SetAttribute("LastEggAt", if breeder then breeder.lastEggAt else 0)
		dome:SetAttribute("BreedSeconds", if baerchi then IncubatorRules.breedSeconds(baerchi.rarity, incubator.level) else 0)
		if baerchi then
			dome.Transparency = look.domeTransparency
		end
		placeBreederFigure(model, index, baerchi)
	end
end

-- Baut den Inkubator neu (ein alter wird ersetzt).
function IncubatorBuilder.build(plotModel: Model, slot: number, incubator: Types.IncubatorData, slotCount: number,
	baerchis: { [string]: Types.Baerchi }?): Model
	local old = plotModel:FindFirstChild(IncubatorConfig.MODEL_NAME)
	if old then old:Destroy() end

	local look = IncubatorConfig.LOOK
	local model = Instance.new("Model")
	model.Name = IncubatorConfig.MODEL_NAME

	local ground = MapParts.plotCFrame(slot)
		* CFrame.new(look.offset.X, MapParts.plotSurfaceOffset() + look.offset.Y, look.offset.Z)

	local base = MapParts.newPart("Base", look.baseSize, ground * CFrame.new(0, look.baseSize.Y * 0.5, 0),
		look.baseColor, Enum.Material.SmoothPlastic)
	base.Parent = model
	model.PrimaryPart = base

	local trim = MapParts.newPart("Trim",
		Vector3.new(look.baseSize.X + 0.6, 0.3, look.baseSize.Z + 0.6),
		ground * CFrame.new(0, 0.15, 0), look.trimColor, Enum.Material.Neon)
	trim.CanCollide = false
	trim.Parent = model

	local top = look.baseSize.Y
	for index = 1, IncubatorConfig.MAX_SLOTS do
		local at = ground * CFrame.new(domeOffset(index))

		local pad = MapParts.newPart("Pad_" .. index, look.padSize,
			at * CFrame.new(0, top + look.padSize.X * 0.5, 0) * UPRIGHT, look.padColor, Enum.Material.SmoothPlastic)
		pad.Shape = Enum.PartType.Cylinder
		pad.CanCollide = false
		pad.Parent = model

		local padTop = top + look.padSize.X
		local egg = MapParts.newPart("Egg_" .. index, look.eggSize,
			at * CFrame.new(0, padTop + look.eggSize.Y * 0.5, 0), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
		egg.Shape = Enum.PartType.Ball
		egg.CanCollide = false
		egg.Transparency = 1
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = egg
		egg.Parent = model

		local dome = MapParts.newPart("Dome_" .. index, look.domeSize,
			at * CFrame.new(0, padTop + look.domeSize.Y * 0.35, 0), look.domeColor, Enum.Material.Glass)
		dome.Shape = Enum.PartType.Ball
		dome.CanCollide = false
		dome:SetAttribute("Slot", index)
		dome.Parent = model
	end

	model.Parent = plotModel
	IncubatorBuilder.writeState(model, incubator, slotCount, baerchis)
	return model
end

return IncubatorBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX64"><Properties><string name="Name">PlotBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- PlotBuilder.luau
-- ServerScriptService/Util/MapBuild/PlotBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Das Grundgeruest eines Spieler-Plots (Beet, Zaun, Schild) und die
--     Honig-Gebaeude mit Schild und Honig-Tropfen bauen und beschriften
--
-- Gebaeude bestehen aus einem unsichtbaren Koerper (Name, Level, Schild,
-- Client-Prompt) und der deklarativen Deko aus MapConfig.BUILDING_DECOR plus
-- den Zusaetzen ihres Looks (v15, MapConfig.getBuildingDecor). Der Look steht
-- als Attribut "Look" am Koerper — MapService baut ein Gebaeude nur neu, wenn
-- sich der Look aendert.
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types            = require(ReplicatedStorage.Network.Types)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local Names     = require(ReplicatedStorage.Localization.Names)
local WorldText = require(ReplicatedStorage.Localization.WorldText)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local PlotBuilder = {}

-- Zaun an den beiden Seiten des Plots. Vorne und hinten bleibt offen, sonst
-- kaeme man weder auf den Plot noch zur Bruecke.
function PlotBuilder.buildFence(plotModel: Model, slot: number)
	local plotCFrame = MapParts.plotCFrame(slot)
	local halfX = MapConfig.PLOT_SIZE.X * 0.5
	local halfZ = MapConfig.PLOT_SIZE.Z * 0.5

	local postY = MapParts.plotSurfaceOffset() + MapConfig.FENCE_POST_SIZE.Y * 0.5
	local steps = math.max(1, math.floor(MapConfig.PLOT_SIZE.Z / MapConfig.FENCE_POST_SPACING))

	for _, side in { -1, 1 } do
		for i = 0, steps do
			local z = -halfZ + (i / steps) * MapConfig.PLOT_SIZE.Z

			local post = MapParts.newPart(
				"FencePost",
				MapConfig.FENCE_POST_SIZE,
				plotCFrame * CFrame.new(side * halfX, postY, z),
				MapConfig.FENCE_COLOR,
				Enum.Material.Wood
			)
			post.CanCollide = false
			post.Parent     = plotModel
		end

		-- Zwei durchgehende Querlatten statt einzelner Segmente: ein Part
		-- statt acht, und optisch macht es keinen Unterschied.
		for _, heightFactor in { 0.45, 0.85 } do
			local railY = MapParts.plotSurfaceOffset() + MapConfig.FENCE_POST_SIZE.Y * heightFactor

			local rail = MapParts.newPart(
				"FenceRail",
				Vector3.new(MapConfig.FENCE_POST_SIZE.X * 0.6, MapConfig.FENCE_RAIL_HEIGHT, MapConfig.PLOT_SIZE.Z),
				plotCFrame * CFrame.new(side * halfX, railY, 0),
				MapConfig.FENCE_COLOR,
				Enum.Material.Wood
			)
			rail.CanCollide = false
			rail.Parent     = plotModel
		end
	end
end

-- Schild an der zur Mitte zeigenden Kante mit dem Namen des Besitzers.
-- v15: darunter ein kleines Tower-Symbol (hoechster Tower, siehe
-- writeOwnerBadge) — gesetzt von MapService, sobald der Tower-Stand bekannt ist.
function PlotBuilder.buildPlotSign(plotModel: Model, slot: number, ownerName: string)
	local plotCFrame = MapParts.plotCFrame(slot)
	local halfZ = MapConfig.PLOT_SIZE.Z * 0.5

	local boardSize = MapConfig.SIGN_BOARD_SIZE
	local postSize  = MapConfig.SIGN_POST_SIZE

	-- Zwei Pfosten an den Raendern, HINTER dem Brett (lokal +Z = weg von der
	-- Mitte; die Schrift zeigt nach -Z). So verdeckt kein Pfosten die Schrift.
	local postY = MapParts.plotSurfaceOffset() + postSize.Y * 0.5
	local behind = boardSize.Z * 0.5 + postSize.Z * 0.5
	for _, side in { -1, 1 } do
		local post = MapParts.newPart(
			"SignPost",
			postSize,
			plotCFrame * CFrame.new(side * (boardSize.X * 0.5 - postSize.X), postY, -halfZ + 2 + behind),
			MapConfig.SIGN_POST_COLOR,
			Enum.Material.Wood
		)
		post.CanCollide = false
		post.Parent     = plotModel
	end

	local boardY = MapParts.plotSurfaceOffset() + postSize.Y - boardSize.Y * 0.5
	local board = MapParts.newPart(
		"SignBoard",
		boardSize,
		plotCFrame * CFrame.new(0, boardY, -halfZ + 2),
		MapConfig.SIGN_COLOR,
		Enum.Material.Wood
	)
	board.CanCollide = false
	board.Parent     = plotModel

	-- Dunkle Leisten oben und unten (Rahmen statt nacktem Brett)
	for i, dy in { boardSize.Y * 0.5, -boardSize.Y * 0.5 } do
		local trim = MapParts.newPart(
			"SignTrim" .. i,
			Vector3.new(boardSize.X + 0.6, 0.45, boardSize.Z + 0.2),
			plotCFrame * CFrame.new(0, boardY + dy, -halfZ + 2),
			MapConfig.SIGN_TRIM_COLOR,
			Enum.Material.Wood
		)
		trim.CanCollide = false
		trim.Parent     = plotModel
	end

	-- Die Schrift kommt auf die Seite, die zur Plattform-Mitte zeigt. Das ist
	-- die lokale -Z-Seite des Plots und damit die Vorderseite des Boards.
	local surface = Instance.new("SurfaceGui")
	surface.Name        = "SignText"
	surface.Face        = Enum.NormalId.Front
	surface.PixelsPerStud = 40
	surface.Adornee     = board
	surface.Parent      = board

	local label = MapParts.newTextLabel("Owner", surface, UDim2.fromScale(0.9, 0.56), UDim2.fromScale(0.05, 0.08))
	label.TextColor3             = Color3.fromRGB(70, 50, 30)
	label.TextStrokeTransparency = 1
	label.Text                   = ownerName

	local badge = MapParts.newTextLabel("TowerBadge", surface, UDim2.fromScale(0.9, 0.28), UDim2.fromScale(0.05, 0.64))
	badge.TextStrokeTransparency = 1
	badge.Text                   = ""
end

-- v15: Tower-Symbol unter dem Besitzernamen ("◆ III · 42"). Billig, nur Text.
function PlotBuilder.writeOwnerBadge(plotModel: Model, text: string | Types.LocMsg, color: Color3)
	local board = plotModel:FindFirstChild("SignBoard")
	local surface = board and board:FindFirstChild("SignText")
	local badge = surface and surface:FindFirstChild("TowerBadge")
	if badge and badge:IsA("TextLabel") then
		WorldText.set(badge, text)
		badge.TextColor3 = color
	end
end

-- Die Plot-Platte samt Zaun und Schild.
--
-- Das Besitzer-Attribut wird gesetzt BEVOR das Model in den Workspace kommt:
-- der Client bekommt es damit zusammen mit dem Model und muss nicht darauf
-- warten. WorldController haengt daran, ob er ueberhaupt einen Prompt baut.
function PlotBuilder.buildPlotBase(slot: number, owner: Player): Model
	local plotCFrame = MapParts.plotCFrame(slot)

	local model = Instance.new("Model")
	model.Name  = "Plot_" .. slot
	model:SetAttribute("PlotOwner", owner.UserId)

	-- Das Beet: eine quadratische Platte auf der Plot-Insel. Dunkles Gruen wie
	-- die Hauptinsel, darauf dieselben hellen Karos — nur plot-lokal gerastert,
	-- weil das Beet je nach Plot in einem anderen Winkel steht.
	local base = MapParts.newPart(
		"Base",
		MapConfig.PLOT_SIZE,
		plotCFrame * CFrame.new(0, MapConfig.PLOT_SIZE.Y * 0.5, 0),
		MapConfig.GRASS_DARK,
		Enum.Material.Grass
	)
	base.CanCollide = true
	base.Parent     = model

	MapParts.buildCheckerPlate(
		model,
		plotCFrame * CFrame.new(0, MapConfig.PLOT_SIZE.Y, 0),
		MapConfig.PLOT_SIZE.X,
		MapConfig.PLOT_SIZE.Z
	)

	model.PrimaryPart = base

	PlotBuilder.buildFence(model, slot)
	PlotBuilder.buildPlotSign(model, slot, owner.DisplayName)

	-- Der Spieler spawnt (und respawnt nach dem Tod) auf seiner EIGENEN
	-- Insel statt in der Weltmitte — siehe MapConfig.PLAYER_SPAWN_OFFSET fuer
	-- die Wahl der Stelle. Unsichtbar: sie soll wie ein normaler Fleck Wiese
	-- aussehen, kein Extra-Bodenbelag auf dem Plot.
	--
	-- `owner.RespawnLocation` direkt zu setzen (statt sich auf Roblox' eigene
	-- Naechste-SpawnLocation-Auswahl zu verlassen) ist entscheidend: mit acht
	-- SpawnLocations in der Welt (eine pro Plot) waere sonst nicht garantiert,
	-- dass ein Spieler nach dem Tod bei SEINER eigenen landet.
	--
	-- newPart baut nur ein normales Part — eine SpawnLocation braucht die
	-- eigene Roblox-Klasse (Instance.new("SpawnLocation")), deshalb hier von
	-- Hand statt ueber das gemeinsame Util.
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name          = "PlayerSpawn"
	spawnLocation.Size          = Vector3.new(6, 1, 6)
	spawnLocation.CFrame        = plotCFrame * CFrame.new(
		MapConfig.PLAYER_SPAWN_OFFSET.X,
		MapParts.plotSurfaceOffset() + MapConfig.PLAYER_SPAWN_OFFSET.Y + 0.5,
		MapConfig.PLAYER_SPAWN_OFFSET.Z
	)
	spawnLocation.Anchored      = true
	spawnLocation.CanCollide    = false
	spawnLocation.CanQuery      = false
	spawnLocation.Neutral       = true
	spawnLocation.Transparency  = 1
	spawnLocation.Duration      = 0   -- keine Unverwundbarkeits-Phase, das Spiel kennt kein PvP am Spawn
	spawnLocation.Parent        = model

	owner.RespawnLocation = spawnLocation

	model.Parent = workspace

	return model
end

-- Die Honig-Tropfen am Fuss eines Gebaeudes einmalig anlegen. Sie werden
-- danach nur noch ein- und ausgeblendet (writeBuildingState), nie neu gebaut:
-- ein Neuaufbau alle 20 Sekunden mal drei Gebaeude mal acht Spieler waere
-- fuer reine Deko viel zu teuer.
--
-- `ground` ist die Mitte der Grundflaeche des Gebaeudes, also derselbe
-- Ursprung wie fuer die Deko.
--
-- `slots` ist das GROESSTE Lager, das dieses Gebaeude je haben kann — nicht
-- sein aktuelles —, seit v15 aber hoechstens MapConfig.HONEY_DOT_MAX (das Lager
-- des Bienenstocks waechst bis 39). Ueberzaehlige Tropfen stoeren nicht:
-- sichtbar ist ein Tropfen erst, wenn wirklich Honig drin liegt
-- (writeBuildingState).
function PlotBuilder.buildHoneyDots(body: BasePart, ground: CFrame, slots: number)
	if slots <= 0 then return end

	-- Fester Abstand, bis der maximale Bogen erreicht ist — dann ruecken die
	-- Tropfen zusammen, statt sich um das ganze Gebaeude zu wickeln.
	local arc = math.min(
		math.rad(MapConfig.HONEY_DOT_ARC),
		math.rad(MapConfig.HONEY_DOT_SPACING) * math.max(1, slots - 1)
	)

	for i = 1, slots do
		-- Bogen mittig um -Z herum. Bei nur einem Punkt gibt es nichts zu
		-- verteilen — dann steht er genau vorne.
		local t     = if slots > 1 then (i - 1) / (slots - 1) - 0.5 else 0
		local angle = t * arc

		local offset = Vector3.new(
			math.sin(angle) * MapConfig.HONEY_DOT_RADIUS,
			MapConfig.HONEY_DOT_HEIGHT,
			-math.cos(angle) * MapConfig.HONEY_DOT_RADIUS
		)

		local dot = MapParts.newPart(
			"HoneyDot" .. i,
			Vector3.new(MapConfig.HONEY_DOT_SIZE, MapConfig.HONEY_DOT_SIZE, MapConfig.HONEY_DOT_SIZE),
			ground * CFrame.new(offset),
			MapConfig.HONEY_DOT_COLOR,
			Enum.Material.Neon
		)
		dot.Shape        = Enum.PartType.Ball
		dot.Transparency = 1        -- Startzustand: leeres Lager
		dot.CanCollide   = false
		dot.CanQuery     = false
		dot.CanTouch     = false
		dot.Parent       = body
	end
end

-- Alles am Gebaeude, was sich im Betrieb aendert: Schildtext, Honig-Tropfen
-- und der Vorrats-Wert fuer den Fuetter-Prompt. Getrennt vom Aufbau, weil das
-- bei JEDER Honig-Aenderung laeuft (siehe updateBuildingSigns) und deshalb
-- billig bleiben muss.
function PlotBuilder.writeBuildingState(part: BasePart, buildingData: Types.Building, pool: number)
	local config = MapConfig.BUILDING_OFFSETS[buildingData.id]
	if not config then return end

	-- Attribut statt eigenem Remote: der Client haengt seinen Fuetter-Prompt
	-- daran und bekommt jede Aenderung ohne Zutun mit.
	part:SetAttribute("HoneyPool", pool)

	-- Lager DIESES Gebaeudes auf DIESEM Level — beim Bienenstock waechst es mit.
	local capacity = BuildingBehavior.getCapacity(buildingData.id, buildingData.level)
	local honey    = math.clamp(buildingData.honey or 0, 0, capacity)

	-- Ein Tropfen pro eingelagertem Honig. Es koennen mehr Tropfen dastehen als
	-- das aktuelle Lager fasst (gebaut wird nach dem Maximal-Lager) — die
	-- ueberzaehligen bleiben unsichtbar. v15: ist das Lager groesser als
	-- HONEY_DOT_MAX, steht ein Tropfen fuer einen ANTEIL (voll = alle an).
	local dotCount = math.min(BuildingBehavior.getMaxCapacity(buildingData.id), MapConfig.HONEY_DOT_MAX)
	local lit = if capacity <= MapConfig.HONEY_DOT_MAX
		then honey
		else math.ceil(honey * MapConfig.HONEY_DOT_MAX / math.max(1, capacity))
	for i = 1, dotCount do
		local dot = part:FindFirstChild("HoneyDot" .. i)
		if dot and dot:IsA("BasePart") then
			dot.Transparency = if i <= lit then 0 else 1
		end
	end

	local sign = part:FindFirstChild("Sign")
	if not sign or not sign:IsA("BillboardGui") then return end

	local title = sign:FindFirstChild("Title")
	if title and title:IsA("TextLabel") then
		WorldText.set(title, Loc.msg("ui.world.sign_level", {
			name = Names.msg.building(buildingData.id), level = buildingData.level,
		}))
	end

	local stock = sign:FindFirstChild("Stock")
	if stock and stock:IsA("TextLabel") then
		stock.Text = string.format("🍯 %d / %d", honey, capacity)   -- sprachneutral (2.4)

		-- Volles Lager faellt farblich auf: dann steht die Produktion und es
		-- wird Zeit, zurueckzukommen und zu fuettern.
		stock.TextColor3 = if honey >= capacity
			then Color3.fromRGB(255, 215, 100)
			else Color3.fromRGB(235, 235, 235)
	end
end

-- Ein Gebaeude auf dem Plot.
-- Der Name der Part ist die BuildingId — der Client (WorldController) findet
-- darueber das Gebaeude fuer den ProximityPrompt.
--
-- Die Part selbst ist seit v5 unsichtbar und kollidiert nicht: sie ist nur
-- noch Trefferflaeche fuer den Prompt sowie Traeger von Name, Attribut und
-- Schild. Zu SEHEN und anzustossen ist ausschliesslich die Deko. Getrennt,
-- weil das Anklickbare und das Huebsche zwei verschiedene Dinge sind — sonst
-- muesste jede Formaenderung Ruecksicht auf die Trefferflaeche nehmen.
-- Partikel-Effekte des Looks an die gerade gebauten Deko-Teile haengen
-- (MapConfig.BUILDING_LOOK_FX / FX_PRESETS). Fehlt ein Teil, wird der Effekt
-- still uebersprungen — der Test honey_pond.test.lua faengt das vorher ab.
function PlotBuilder.addLookEffects(body: BasePart, buildingId: string, look: number)
	for _, fx in MapConfig.getLookFx(buildingId, look) do
		local target = body:FindFirstChild(fx.piece)
		local preset = MapConfig.FX_PRESETS[fx.preset]
		if target and target:IsA("BasePart") and preset then
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name          = "Fx_" .. fx.preset
			emitter.Texture       = preset.texture
			emitter.Color         = ColorSequence.new(preset.color)
			emitter.Size          = NumberSequence.new(preset.size[1], preset.size[2])
			emitter.Transparency  = NumberSequence.new(preset.transparency[1], preset.transparency[2])
			emitter.Lifetime      = NumberRange.new(preset.lifetime[1], preset.lifetime[2])
			emitter.Rate          = preset.rate
			emitter.Speed         = NumberRange.new(preset.speed[1], preset.speed[2])
			emitter.SpreadAngle   = Vector2.new(preset.spread, preset.spread)
			emitter.Acceleration  = preset.acceleration
			emitter.EmissionDirection = (Enum.NormalId :: any)[preset.emitFrom]
			emitter.LightEmission = preset.lightEmission
			emitter.Parent        = target
		end
	end
end

function PlotBuilder.buildBuilding(plotModel: Model, slot: number, buildingData: Types.Building, pool: number)
	local config = MapConfig.BUILDING_OFFSETS[buildingData.id]
	if not config then return end

	local plotCFrame = MapParts.plotCFrame(slot)
	local localY = MapParts.plotSurfaceOffset() + config.offset.Y + config.size.Y * 0.5

	local part = MapParts.newPart(
		buildingData.id,
		config.size,
		plotCFrame * CFrame.new(config.offset.X, localY, config.offset.Z),
		config.color,
		Enum.Material.SmoothPlastic
	)
	part.Transparency = 1
	part.CanCollide   = false
	part.Parent       = plotModel

	-- Ursprung von Deko UND Honig-Tropfen: Mitte der Grundflaeche des Gebaeudes
	-- auf Plot-Hoehe.
	local ground = plotCFrame * CFrame.new(
		config.offset.X,
		MapParts.plotSurfaceOffset() + config.offset.Y,
		config.offset.Z
	)

	-- v15: Grund-Deko plus die Zusaetze des aktuellen Looks.
	local look  = BuildingBehavior.getLook(buildingData.level)
	local decor = MapConfig.getBuildingDecor(buildingData.id, look)
	MapParts.buildDecor(part, ground, decor)
	PlotBuilder.addLookEffects(part, buildingData.id, look)

	PlotBuilder.buildHoneyDots(part, ground,
		math.min(BuildingBehavior.getMaxCapacity(buildingData.id), MapConfig.HONEY_DOT_MAX))

	-- Level als Attribut: der Client kann es direkt auslesen ohne eigenes Remote
	part:SetAttribute("BuildingLevel", buildingData.level)
	part:SetAttribute("Look", look)

	-- Schild ueber dem Gebaeude: Name, Level und Honig-Lagerstand. Ohne das
	-- muesste man fuer die Frage "ist schon wieder Honig da?" jedes Mal ein
	-- Panel oeffnen.
	--
	-- Die Hoehe richtet sich nach dem hoechsten Deko-Teil, nicht nach der
	-- Koerpergroesse: sonst haengt das Schild nach jeder Formaenderung falsch.
	-- StudsOffset zaehlt ab der MITTE der Part, deshalb die Halbierung.
	local topOfDecor = math.max(MapParts.decorHeight(decor), config.size.Y)

	-- Sammel-Update 2.6 ("UI von Honig-Sumpf weg"): der Honig-Teich bekommt
	-- kein Schild — der Baerchi isst dort von selbst (Autopilot), Text und
	-- Zahlen braucht dort niemand. writeBuildingState kommt ohne Schild aus.
	if buildingData.id == "HoneyPond" then
		PlotBuilder.writeBuildingState(part, buildingData, pool)
		return
	end

	local sign = Instance.new("BillboardGui")
	sign.Name         = "Sign"
	sign.Size         = UDim2.fromScale(9, 2.6)
	sign.StudsOffset  = Vector3.new(0, topOfDecor - config.size.Y * 0.5 + 2, 0)
	sign.AlwaysOnTop  = false
	sign.MaxDistance  = MapConfig.BUILDING_SIGN_DISTANCE
	sign.Adornee      = part
	sign.Parent       = part

	MapParts.newTextLabel("Title", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0))
	MapParts.newTextLabel("Stock", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0.5))

	PlotBuilder.writeBuildingState(part, buildingData, pool)
end

return PlotBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX65"><Properties><string name="Name">PondBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- PondBuilder.luau
-- ServerScriptService/Util/MapBuild/PondBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Den Honig-Teich eines Plots bauen und seinen Fuellstand anzeigen
--
-- Der Fuellstand ist der gelagerte Honig aller Gebaeude (honeyPool). Der
-- ausgeruestete Baerchi isst am Steg (pondStand).
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types            = require(ReplicatedStorage.Network.Types)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local PondBuilder = {}

-- Der gesamte Honig-Vorrat einer Insel.
--
-- Wird als Attribut an JEDES Gebaeude geschrieben, nicht nur der eigene
-- Bestand: gefuettert wird auf der Baerchi-Detailkarte, und dort stehen alle
-- drei Vorraete nebeneinander zur Wahl. Wer vor dem Bienenstock steht, soll
-- deshalb sehen, dass ueberhaupt noch Honig da ist — auch wenn er im Honigtopf
-- nebenan liegt.
function PondBuilder.honeyPool(islandData: Types.IslandData): number
	local total = 0
	for _, building in islandData.buildings do
		total += math.max(0, building.honey or 0)
	end
	return total
end

-- Wie voll der Teich angezeigt wird: Anteil des GESAMTEN Honig-Vorrats an der
-- Lagermenge, die diese Insel auf ihren AKTUELLEN Leveln fasst.
--
-- Bewusst die aktuelle und nicht die theoretisch maximale Menge: der
-- Bienenstock vergroessert sein Lager mit jedem Level, und ein Teich, der nach
-- einem Ausbau ploetzlich leerer aussieht, waere die falsche Rueckmeldung.
-- So heisst "voller Teich" immer dasselbe — alle Lager sind voll.
function PondBuilder.pondFillRatio(islandData: Types.IslandData): number
	local capacity = BuildingBehavior.getTotalCapacity(islandData.buildings)
	if capacity <= 0 then return 0 end
	return math.clamp(PondBuilder.honeyPool(islandData) / capacity, 0, 1)
end

-- Der Boden-Ursprung des Teichs fuer einen Plot.
--
-- Mitte des Beckens auf Beet-Hoehe — dieselbe Rolle wie `ground` bei den
-- Gebaeuden, aber zusaetzlich GEDREHT: das lokale -Z zeigt zum Baerchi-Platz,
-- also dorthin, wo der Baerchi herkommt und beim Fressen steht. Genau
-- dieselbe Regel wie beim Plot-CFrame ("-Z zeigt dorthin, wo man herkommt"),
-- und der Grund, warum die Offsets in MapConfig.POND_DECOR ohne einen einzigen
-- Winkel auskommen.
--
-- Faellt die Richtung weg (Teich exakt auf dem Baerchi-Platz — kann nur durch
-- eine kaputte Config passieren), bleibt die Plot-Ausrichtung stehen: lieber
-- ein Teich, der in die falsche Richtung schaut, als gar keiner.
function PondBuilder.pondGround(slot: number): CFrame
	local plotCFrame = MapParts.plotCFrame(slot)

	-- Lage und Richtung aus MapLayout (HONEY_POND_V2: Teich in der Plot-Mitte
	-- hinten, Standplatz nach +Z; sonst wie bisher zum Baerchi-Platz).
	local offset = MapLayout.pondOffset()
	local center = CFrame.new(offset.X, MapParts.plotSurfaceOffset() + offset.Y, offset.Z)
	local toHome = MapLayout.pondFacing()

	-- CFrame.lookAt richtet -Z auf das Ziel aus (siehe buildPlotCFrame).
	local facing = CFrame.lookAt(center.Position, center.Position + toHome)
	return plotCFrame * facing
end

-- Der Standplatz vor dem Becken: teich-lokal auf -Z, um Beckenrand plus
-- Abstand von der Mitte entfernt. Hier landet der Baerchi, hier liegen die
-- Bohlen, und genau hier hat der Steinkranz seine Luecke.
function PondBuilder.pondStandDistance(): number
	return MapLayout.pondStandDistance()
end

function PondBuilder.pondStand(slot: number): CFrame
	return PondBuilder.pondGround(slot) * CFrame.new(0, 0, -PondBuilder.pondStandDistance())
end

-- Setzt die Fuellhoehe der "Fuellung"-Part auf den aktuellen Vorrat. Getrennt
-- vom Aufbau, weil das bei jeder Honig-Aenderung laeuft (siehe
-- updateBuildingSigns) und deshalb billig bleiben muss — kein Neuaufbau.
--
-- `ground` ist derselbe Ursprung wie beim Aufbau: die Fuellung waechst von
-- dort nach oben, statt ueber die WELT-Position herumzurechnen (die haengt
-- vom Plot-Winkel ab und ist dafuer ungeeignet).
function PondBuilder.writePondFill(fill: BasePart, ground: CFrame, ratio: number)
	-- Breiter UND hoeher (siehe MapConfig): nur hoeher waere aus der
	-- Spielerkamera kaum abzulesen, nur breiter saehe aus wie ein Aufkleber.
	local maxRadius = MapConfig.POND_RADIUS - MapConfig.POND_FILL_INSET
	local scale     = MapConfig.POND_FILL_MIN_SCALE
		+ (1 - MapConfig.POND_FILL_MIN_SCALE) * math.clamp(ratio, 0, 1)

	local radius = maxRadius * scale
	local height = MapConfig.POND_FILL_MIN_HEIGHT
		+ (MapConfig.POND_FILL_MAX_HEIGHT - MapConfig.POND_FILL_MIN_HEIGHT) * math.clamp(ratio, 0, 1)

	-- Der Honig steht AUF dem Beckenboden, nicht auf dem Beet.
	fill.CFrame = ground
		* CFrame.new(0, MapConfig.POND_FLOOR_TOP + height * 0.5, 0)
		* CFrame.Angles(0, 0, math.rad(90))
	fill.Size   = Vector3.new(height, radius * 2, radius * 2)

	fill.Transparency = if ratio <= 0 then 1 else MapConfig.POND_FILL_TRANSPARENCY
end

-- Eine der beiden flachen Scheiben des Beckens (Sandkante bzw. Beckenboden).
-- Beide sind dicker als der sichtbare Teil; der Rest steckt im Beet, damit
-- unten nichts durchscheint.
function PondBuilder.buildPondDisc(parent: Instance, ground: CFrame, name: string, radius: number, top: number, color: Color3, material: Enum.Material)
	local disc = MapParts.newPart(
		name,
		Vector3.new(MapConfig.POND_DISC_HEIGHT, radius * 2, radius * 2),
		ground * CFrame.new(0, top - MapConfig.POND_DISC_HEIGHT * 0.5, 0)
			* CFrame.Angles(0, 0, math.rad(90)),
		color,
		material
	)
	disc.Shape      = Enum.PartType.Cylinder
	disc.CanCollide = true
	disc.CanQuery   = false
	disc.Parent     = parent
end

-- Der Steinkranz: die Beckenwand.
--
-- Er laesst auf der Seite zum Baerchi-Platz eine Luecke frei — dieselbe Idee
-- wie beim Zaun um die Arena, und aus demselben Grund: durch eine Wand kommt
-- man nicht. Groessen und Farben wechseln reihum durch, damit es nach
-- gesammelten Feldsteinen aussieht und nicht nach einer Perlenkette.
function PondBuilder.buildPondStones(parent: Instance, ground: CFrame)
	local ringRadius = MapConfig.POND_RADIUS + MapConfig.POND_RIM_WIDTH * 0.5
	local gap        = math.rad(MapConfig.POND_STONE_GAP_DEGREES)

	-- Die Steine stehen bei (sin a, cos a): a = 0 ist teich-lokales +Z,
	-- a = pi ist -Z. Die Luecke liegt also bei pi.
	local gapAngle = math.pi

	for i = 1, MapConfig.POND_STONE_COUNT do
		local angle = (i - 1) * (2 * math.pi / MapConfig.POND_STONE_COUNT)

		-- Winkelabstand zur Luecke, immer als kuerzester Weg gemessen.
		local delta = math.abs(((angle - gapAngle + math.pi) % (2 * math.pi)) - math.pi)

		if delta > gap then
			local size  = MapConfig.POND_STONE_SIZES[((i - 1) % #MapConfig.POND_STONE_SIZES) + 1]
			local color = MapConfig.POND_STONE_COLORS[((i - 1) % #MapConfig.POND_STONE_COLORS) + 1]

			-- Etwas eingegraben: die Steine sollen im Sand liegen und nicht
			-- auf dem Boden balancieren. Sie sind leicht gestaucht, damit sie
			-- nach Feldsteinen aussehen und nicht nach Murmeln.
			local stone = MapParts.newPart(
				"Stein_" .. i,
				Vector3.new(size, size * 0.82, size),
				ground * CFrame.new(
					math.sin(angle) * ringRadius,
					MapConfig.POND_RIM_TOP + size * 0.30,
					math.cos(angle) * ringRadius
				),
				color,
				Enum.Material.Slate
			)
			stone.Shape      = Enum.PartType.Ball
			stone.CanCollide = true
			stone.CanQuery   = false
			stone.Parent     = parent
		end
	end
end

-- Die zwei Bohlen vor der Luecke, auf denen der Baerchi beim Fressen steht,
-- plus zwei Pfloecke daneben. Sie liegen um den Standplatz herum, den auch
-- MapService.getPondPosition zurueckgibt — eine Rechnung, kein zweiter Satz
-- Zahlen (siehe MapConfig.POND_STAND_GAP).
function PondBuilder.buildPondPlanks(parent: Instance, ground: CFrame)
	local stand = PondBuilder.pondStandDistance()
	local step: number = (MapConfig.POND_PLANK_SIZE.Z + MapConfig.POND_PLANK_GAP) * 0.5
	local y: number    = MapConfig.POND_PLANK_TOP - MapConfig.POND_PLANK_SIZE.Y * 0.5

	for i, offset in { -step, step } do
		local plank = MapParts.newPart(
			"Bohle_" .. i,
			MapConfig.POND_PLANK_SIZE,
			ground * CFrame.new(0, y, -stand + offset),
			MapConfig.POND_PLANK_COLORS[((i - 1) % #MapConfig.POND_PLANK_COLORS) + 1],
			Enum.Material.WoodPlanks
		)
		plank.CanCollide = false
		plank.CanQuery   = false
		plank.Parent     = parent
	end

	-- Pfloecke: kleine Pfosten an beiden Bohlen-Enden. CFrame.Angles(0, 0, 90)
	-- stellt den Zylinder AUFRECHT (seine Laenge ist Size.X) — deshalb muss
	-- auch die Hoehe aus Size.X kommen. 08.10.: vorher stand hier
	-- Size.Y * 0.4 (der Durchmesser), der Pfosten steckte 0.49 im Beet.
	for i, side in { -1, 1 } do
		local peg = MapParts.newPart(
			"Pflock_" .. i,
			MapConfig.POND_PEG_SIZE,
			ground * CFrame.new(side * MapConfig.POND_PEG_SPREAD, MapConfig.POND_PEG_SIZE.X * MapConfig.POND_PEG_LIFT, -stand)
				* CFrame.Angles(0, 0, math.rad(90)),
			MapConfig.POND_PLANK_COLORS[2],
			Enum.Material.Wood
		)
		peg.Shape      = Enum.PartType.Cylinder
		peg.CanCollide = false
		peg.CanQuery   = false
		peg.Parent     = parent
	end
end

-- Der Honig-Teich auf dem Plot: Sandkante, Steinkranz, abgesenkter Beckenboden
-- und darauf der Honig, dessen Flaeche und Hoehe den Gesamt-Vorrat zeigen. Der
-- ausgeruestete Baerchi laeuft zu den Bohlen davor, um zu essen (siehe
-- BaerchiAutopilotService).
function PondBuilder.buildPond(plotModel: Model, slot: number, islandData: Types.IslandData)
	local old = plotModel:FindFirstChild("Pond")
	if old then old:Destroy() end

	local ground = PondBuilder.pondGround(slot)

	local pond = Instance.new("Model")
	pond.Name   = "Pond"
	pond.Parent = plotModel

	-- Sandkante zuerst und TIEFER als der Beckenboden: nur so bleibt sie
	-- ringsum als Streifen sichtbar, ohne dass ein Ring aus Einzelteilen
	-- noetig waere — derselbe Trick wie am Ufer jeder Insel.
	PondBuilder.buildPondDisc(
		pond, ground, "Rand",
		MapConfig.POND_RADIUS + MapConfig.POND_RIM_WIDTH,
		MapConfig.POND_RIM_TOP,
		MapConfig.POND_RIM_COLOR,
		Enum.Material.Sand
	)
	PondBuilder.buildPondDisc(
		pond, ground, "Boden",
		MapConfig.POND_RADIUS,
		MapConfig.POND_FLOOR_TOP,
		MapConfig.POND_FLOOR_COLOR,
		Enum.Material.Slate
	)

	PondBuilder.buildPondStones(pond, ground)
	PondBuilder.buildPondPlanks(pond, ground)
	-- Mit HONEY_POND_V2 schmueckt der Brunnen (Gebaeude HoneyPond) das
	-- Becken; der Honigloeffel wuerde in seine Schale ragen.
	if not FeatureFlags.isOn("HONEY_POND_V2") then
		MapParts.buildDecor(pond, ground, MapConfig.POND_DECOR)
	end

	-- Als Platzhalter-Groesse angelegt — writePondFill setzt Groesse und
	-- Position gleich im Anschluss auf den echten Vorrat.
	local fill = MapParts.newPart(
		"Fuellung",
		Vector3.new(0.05, MapConfig.POND_RADIUS, MapConfig.POND_RADIUS),
		ground,
		MapConfig.POND_FILL_COLOR,
		Enum.Material.Neon
	)
	fill.Shape      = Enum.PartType.Cylinder
	fill.CanCollide = false
	fill.CanQuery   = false
	fill.CanTouch   = false
	fill.Parent     = pond

	PondBuilder.writePondFill(fill, ground, PondBuilder.pondFillRatio(islandData))
end

return PondBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX66"><Properties><string name="Name">RecyclerBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- RecyclerBuilder.luau
-- ServerScriptService/Util/MapBuild/RecyclerBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Den Waben-Recycler auf dem Plot bauen und sein Schild/seine Lampe
--     beschriften.
--
-- Wie ein Gebaeude (siehe PlotBuilder.buildBuilding): ein unsichtbarer Koerper,
-- der Name, Attribute und Schild traegt, plus die deklarative Deko aus
-- CombConfig.RECYCLER_DECOR und (v15) den Zusaetzen seines Looks
-- (CombConfig.getDecor). Der Look steht als Attribut "Look" am Koerper. Der Koerper heisst "Recycler"; der Client
-- (CombController) haengt daran den Ausbau-Prompt, aber nur am eigenen Plot.
--
-- Teil von MapService: nur MapService benutzt dieses Modul. Es aendert keine
-- Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local MapConfig  = require(ReplicatedStorage.Config.MapConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types      = require(ReplicatedStorage.Network.Types)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local WorldText = require(ReplicatedStorage.Localization.WorldText)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local RecyclerBuilder = {}

-- Die Insel-Wiese liegt auf PLATFORM_TOP_Y, also auf dem Plot-Ursprung — NICHT
-- auf der Beet-Hoehe (die ist PLOT_SIZE.Y darueber). Der Recycler steht auf dem
-- Gras vor dem Beet, deshalb Boden = Ursprung plus die Karo-Hoehe, damit nichts
-- in den hellen Feldern versinkt.
local function groundOffset(): number
	return MapConfig.GRASS_HEIGHT
end

-- Schreibt Level, Warteschlange und Lampe. Billig; laeuft bei jeder Aenderung
-- der Warteschlange (einmal pro Sekunde, solange gearbeitet wird).
function RecyclerBuilder.writeState(body: BasePart, recycler: Types.RecyclerData)
	-- Attribute: der Client rechnet daraus Prompt-Text und Kosten selbst.
	body:SetAttribute("RecyclerLevel", recycler.level)
	body:SetAttribute("RecyclerQueued", recycler.queued)

	local lamp = body:FindFirstChild("Lampe")
	if lamp and lamp:IsA("BasePart") then
		lamp.Color = if recycler.queued > 0 then CombConfig.LAMP_ACTIVE_COLOR else CombConfig.LAMP_IDLE_COLOR
	end

	local sign = body:FindFirstChild("Sign")
	if not sign or not sign:IsA("BillboardGui") then return end

	local title = sign:FindFirstChild("Title")
	if title and title:IsA("TextLabel") then
		WorldText.set(title, Loc.msg("ui.world.sign_level", {
			name = Loc.msg("ui.recycler.name"), level = recycler.level,
		}))
	end

	local stock = sign:FindFirstChild("Stock")
	if stock and stock:IsA("TextLabel") then
		if recycler.queued > 0 then
			stock.Text = string.format("⬡ %d", recycler.queued)   -- sprachneutral (2.4)
			stock.TextColor3 = CombConfig.LAMP_ACTIVE_COLOR
		else
			-- Sammel-Update 3.6: sprachneutral "⬡ = 12 G" (eine Wabe bringt so viel)
			stock.Text = string.format("⬡ = %d G", CombConfig.getPayPerUnit(recycler.level))
			stock.TextColor3 = Color3.fromRGB(235, 235, 235)
		end
	end
end

-- Baut den Recycler in das Plot-Model.
function RecyclerBuilder.build(plotModel: Model, slot: number, recycler: Types.RecyclerData)
	local plotCFrame = MapParts.plotCFrame(slot)
	local offset = CombConfig.RECYCLER_OFFSET
	local size   = CombConfig.RECYCLER_BODY_SIZE

	local ground = plotCFrame * CFrame.new(offset.X, groundOffset() + offset.Y, offset.Z)

	local body = MapParts.newPart(
		CombConfig.RECYCLER_NAME,
		size,
		ground * CFrame.new(0, size.Y * 0.5, 0),
		Color3.fromRGB(84, 178, 96),
		Enum.Material.SmoothPlastic
	)
	body.Transparency = 1
	body.CanCollide   = false
	body.Parent       = plotModel

	local look  = BuildingBehavior.getLook(recycler.level)
	local decor = CombConfig.getDecor(look)
	MapParts.buildDecor(body, ground, decor)
	body:SetAttribute("Look", look)

	-- Schild ueber dem Trichter, auf die Hoehe der hoechsten Deko gesetzt (wie
	-- bei den Gebaeuden: so haengt es nach einer Formaenderung nicht falsch).
	local top = math.max(MapParts.decorHeight(decor), size.Y)

	local sign = Instance.new("BillboardGui")
	sign.Name        = "Sign"
	sign.Size        = UDim2.fromScale(9, 2.6)
	sign.StudsOffset = Vector3.new(0, top - size.Y * 0.5 + 2, 0)
	sign.AlwaysOnTop = false
	sign.MaxDistance = MapConfig.BUILDING_SIGN_DISTANCE
	sign.Adornee     = body
	sign.Parent      = body

	MapParts.newTextLabel("Title", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0))
	MapParts.newTextLabel("Stock", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0.5))

	RecyclerBuilder.writeState(body, recycler)
end

return RecyclerBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX67"><Properties><string name="Name">TerminalBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- TerminalBuilder.luau
-- ServerScriptService/Util/MapBuild/TerminalBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Das Tower-Terminal am Stegbeginn bauen (08.10., Paket B2) und seinen
--     Zustand als Attribute an das Model schreiben.
--
-- Gebaut wird EINMAL mit dem Plot, rein aus MapConfig.TOWER_TERMINAL (wie die
-- Gebaeude-Deko). Was der Bildschirm zeigt, steht nur in Attributen; den Text
-- in der Sprache des Betrachters, die Lampenfarbe, das Blinken, das "!" und
-- den Prompt macht der Client (Controllers/TerminalController). Kein Neubau
-- bei einer Aenderung, keine Emitter, keine Lichter.
--
-- Attribute am Model "TowerTerminal":
--   State     "locked" | "ready" | "normal" (TowerConfig.terminalState)
--   Tower     gewaehlter Tower (Id)
--   Record    Rekord im gewaehlten Tower
--   NextTower Tower, der als naechstes aufgeht ("" = keiner)
--   NewTower  frisch freier Tower ("NEU", "" = keiner)
--   Progress  Rekord im Vorgaenger dieses Towers (Fortschritt "12/30")
--   Needed    noetige Stage im Vorgaenger
--
-- Teil von MapService: nur MapService benutzt dieses Modul. Es aendert keine
-- Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig = require(ReplicatedStorage.Config.MapConfig)
local MapParts  = require(ServerScriptService.Util.MapBuild.MapParts)

local TerminalBuilder = {}

TerminalBuilder.MODEL_NAME = "TowerTerminal"

export type TerminalView = {
	state     : string,
	tower     : string,
	record    : number,
	nextTower : string,
	newTower  : string,
	progress  : number,
	needed    : number,
}

-- Boden-Ursprung des Terminals (plot-lokal versetzt und gedreht).
function TerminalBuilder.origin(slot: number): CFrame
	local cfg = MapConfig.TOWER_TERMINAL
	return MapParts.plotCFrame(slot)
		* CFrame.new(cfg.offset)
		* CFrame.Angles(0, math.rad(cfg.yaw), 0)
end

function TerminalBuilder.writeState(model: Model, view: TerminalView)
	model:SetAttribute("State", view.state)
	model:SetAttribute("Tower", view.tower)
	model:SetAttribute("Record", view.record)
	model:SetAttribute("NextTower", view.nextTower)
	model:SetAttribute("NewTower", view.newTower)
	model:SetAttribute("Progress", view.progress)
	model:SetAttribute("Needed", view.needed)
end

function TerminalBuilder.build(plotModel: Model, slot: number, view: TerminalView?): Model
	local old = plotModel:FindFirstChild(TerminalBuilder.MODEL_NAME)
	if old then old:Destroy() end

	local model = Instance.new("Model")
	model.Name = TerminalBuilder.MODEL_NAME
	local origin = TerminalBuilder.origin(slot)
	MapParts.buildDecor(model, origin, MapConfig.TOWER_TERMINAL.pieces)
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") then
			part.CastShadow = part.Name == "Kopf" or part.Name == "Saeule" or part.Name == "Sockel"
		end
	end
	-- Pivot auf den Boden-Ursprung: der Client findet so "vorne" und "oben".
	model.WorldPivot = origin
	if view then
		TerminalBuilder.writeState(model, view)
	else
		TerminalBuilder.writeState(model, { state = "locked", tower = "I", record = 0, nextTower = "II", newTower = "", progress = 0, needed = 0 })
	end
	model.Parent = plotModel
	return model
end

return TerminalBuilder
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX69"><Properties><string name="Name">PlayerMigration</string><ProtectedString name="Source"><![CDATA[--!strict
-- PlayerMigration.luau
-- ServerScriptService/Util/PlayerMigration.luau
--
-- Einzige Zustaendigkeit:
--   - Einen geladenen Spielstand beliebiger frueherer Version auf die aktuelle
--     Struktur (Types.PlayerData) bringen
--
-- Gehoert fachlich zu PlayerService und wird nur von dort aufgerufen. Es ist
-- ein eigenes Modul, weil es eine reine Funktion ist (Tabelle rein, Tabelle
-- raus, kein DataStore, kein Spieler-Objekt) und deshalb ohne Studio getestet
-- werden kann: tools/luau-tests/migration.test.lua schickt alte Spielstaende
-- hindurch und prueft das Ergebnis gegen Types.createDefaultPlayerData.
--
-- Regel fuer neue Felder: jedes Feld, das in Types.PlayerData dazukommt, wird
-- hier nachgeruestet (oder ausdruecklich begruendet, warum nil reicht). Eine
-- Migration, die Werte UMRECHNET statt Fehlendes anzulegen, haengt an
-- data.version und darf nur einmal laufen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local PromotionConfig  = require(ReplicatedStorage.Config.PromotionConfig)
local CharmConfig      = require(ReplicatedStorage.Config.CharmConfig)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggTree          = require(ReplicatedStorage.Modules.EggTree)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local FeatureFlags     = require(ReplicatedStorage.Config.FeatureFlags)
local HoneyPondMode    = require(ReplicatedStorage.Modules.HoneyPondMode)

local PlayerMigration = {}

-- Fehlende Felder aus Default auffuellen (einfache Migration fuer neue Felder).
-- Muss jedes Feld abdecken das seit dem ersten Release in Types.luau
-- dazugekommen ist — sonst crasht alter Save-Stand beim ersten Zugriff.
function PlayerMigration.applyDefaults(data: Types.PlayerData): Types.PlayerData
	local default = Types.createDefaultPlayerData()

	-- Neue Top-Level-Felder
	if data.gummies      == nil then data.gummies      = default.gummies      end
	if data.goldGummies  == nil then data.goldGummies  = default.goldGummies  end
	if data.rebirthCount == nil then data.rebirthCount = default.rebirthCount end
	if data.rebirthMult  == nil then data.rebirthMult  = default.rebirthMult  end
	if data.rank         == nil then data.rank         = default.rank         end
	if data.island       == nil then data.island       = default.island       end
	if data.stats        == nil then data.stats        = default.stats        end
	if data.createdAt    == nil then data.createdAt    = default.createdAt    end
	if data.lastSeenAt   == nil then data.lastSeenAt   = default.lastSeenAt   end

	-- Neue Stats-Felder (dynamischer Key → bewusst ueber any, sonst meckert --!strict)
	local stats     = data.stats    :: any
	local defStats  = default.stats :: any

	-- HBB Paket 10: Sitzungszaehler. Ein Konto, das schon aelter als 10 min
	-- ist, war mindestens einmal da — es zaehlt als 1, damit Veteranen den
	-- Shop schon bei diesem Join (= Sitzung 2, PlayerService zaehlt hoch) sehen.
	if stats.sessions == nil then
		stats.sessions = if os.time() - (data.createdAt or os.time()) >= 600 then 1 else 0
	end
	for key, value in defStats do
		if stats[key] == nil then
			stats[key] = value
		end
	end

	-- highestTowerFloor gehoerte zu einem Tower-Modus, den es nicht gibt. Das
	-- Feld wird entfernt, damit es nicht bei jedem Speichern wieder im
	-- DataStore landet. Am Feld erkennbar und deshalb ohne Versions-Sprung
	-- wiederholbar; ein Wert geht nicht verloren, er war immer 0.
	stats.highestTowerFloor = nil

	-- Neue Island-Felder
	local island = data.island
	if island.baerchis  == nil then island.baerchis  = {} end
	if island.eggStock  == nil then island.eggStock  = { BasicEgg = 3 } end

	-- language: kein Nachruesten noetig — nil bedeutet "automatisch" (die
	-- Roblox-Sprache des Clients), und genau das soll ein alter Spielstand
	-- bekommen. Kein Versions-Sprung. Siehe SettingsService.
	--
	-- v6: equippedUid. Kein Nachruesten noetig — ein fehlendes Feld liest
	-- sich in Lua ohnehin als nil, und IslandService.autoEquipIfNone laeuft
	-- bei jedem Join (onDataLoaded) und ruestet automatisch den ersten
	-- vorhandenen Baerchi aus, falls noch/wieder keiner steht.

	-- ============================================================
	-- ============================================================
	-- v13: QUESTS + INDEX
	-- ============================================================
	-- Neue Felder: discovered, quests, stats.totalHatched (das Stats-Feld legt
	-- die Schleife oben schon mit 0 an). Fuer Spielstaende VOR v13 wird
	-- discovered aus den vorhandenen Baerchis gesaeet und totalHatched auf
	-- deren Anzahl gesetzt, damit Veteranen nicht bei null anfangen.
	if data.discovered == nil then
		data.discovered = {}
		for _, baerchi in data.island.baerchis do
			data.discovered[baerchi.configId] = true
		end
	end

	if (data.version or 0) < 13 then
		local owned = 0
		for _ in data.island.baerchis do owned += 1 end
		data.stats.totalHatched = math.max(data.stats.totalHatched or 0, owned)
	end

	-- HBB Paket 3: uiSeen. Leer nachruesten; UiStateService markiert beim
	-- ersten Laden eines Stands mit Fortschritt alles Sichtbare als gesehen
	-- (keine Badge-Flut fuer Veteranen). Kein Versions-Sprung.
	if data.uiSeen == nil then
		data.uiSeen = {}
	end

	-- HBB Paket 10: Shop-Teil. Leer nachruesten, kaputte Felder reparieren.
	local shop = (data :: any).shop
	if typeof(shop) ~= "table" then
		(data :: any).shop = default.shop
	else
		if typeof(shop.freeGrabDay) ~= "number" then shop.freeGrabDay = -1 end
		if typeof(shop.receipts) ~= "table" then shop.receipts = {} end
	end

	if data.quests == nil then
		data.quests = default.quests
	end

	-- ============================================================
	-- v14: EI-BAUM (Mega Egg Tree)
	-- ============================================================
	-- Neues Top-Level-Feld eggTree (ausserhalb der Insel, damit ein Rebirth
	-- es nicht loescht). Bestandsspieler bekommen die Knoten der Eier frei,
	-- die sie schon im Lager haben oder die auf ihrem Plot liegen — wer ein
	-- Goldenes Ei besitzt, soll es nicht ploetzlich "gesperrt" sehen. Die
	-- Rebirth-Knoten (Ascensions-Pfad) schaltet evaluate unten frei.
	--
	-- Gefahrlos wiederholbar: sanitize ergaenzt nur Fehlendes, und die
	-- Lager-Freischaltung laeuft nur fuer Spielstaende vor v14.
	local hadTree = data.eggTree ~= nil
	data.eggTree = EggTree.sanitize(data.eggTree)
	if not hadTree and (data.version or 0) < 14 then
		for eggType, count in island.eggStock do
			if (count or 0) > 0 and EggConfig.data[eggType] then
				data.eggTree.unlocked[eggType] = true
			end
		end
		for _, egg in (island.laidEggs or {}) do
			if EggConfig.data[egg.eggType] then
				data.eggTree.unlocked[egg.eggType] = true
			end
		end
	end
	-- Unbekannte Ei-Typen im Lager (alte Config) werden zum Basis-Ei.
	local stockAny = island.eggStock :: any
	for eggType, count in stockAny do
		if not EggConfig.data[eggType] then
			stockAny.BasicEgg = (stockAny.BasicEgg or 0) + (tonumber(count) or 0)
			stockAny[eggType] = nil
		end
	end
	EggTree.evaluate(data)

	-- v12: BRUT-SLOTS ENTFALLEN (Eier werden sofort geoeffnet)
	-- ============================================================
	-- Alte Spielstaende koennen noch laufende oder fertige Bruten in
	-- island.hatchingEggs haben. Die gehen NICHT verloren: jedes Ei wandert
	-- als ungeoeffnetes Ei zurueck ins Lager, danach wird das Feld entfernt.
	-- Ein Ei-Typ, den es nicht mehr gibt, wird zum Basis-Ei (dieselbe Regel,
	-- die frueher beim Abholen galt).
	--
	-- Gefahrlos wiederholbar: beim zweiten Durchlauf ist das Feld schon nil.
	-- Ueber `any`, weil Types.IslandData das Feld seit v12 nicht mehr kennt.
	local legacyIsland = island :: any
	if legacyIsland.hatchingEggs ~= nil then
		if typeof(legacyIsland.hatchingEggs) == "table" then
			for _, egg in legacyIsland.hatchingEggs do
				local eggType = if typeof(egg) == "table" then egg.eggType else nil
				if typeof(eggType) ~= "string" or not EggConfig.data[eggType :: Types.EggType] then
					eggType = "BasicEgg"
				end
				local stock = island.eggStock :: any
				stock[eggType] = (stock[eggType] or 0) + 1
			end
		end
		legacyIsland.hatchingEggs = nil
	end

	-- v12: pitProgress muss nur gueltig sein, wenn es da ist (nil = kein
	-- gespeicherter Lauf). Ein halber Eintrag wird verworfen statt geraten.
	local progress = legacyIsland.pitProgress
	if progress ~= nil and (typeof(progress) ~= "table"
		or typeof(progress.pitLevel) ~= "number"
		or typeof(progress.reachedStage) ~= "number")
	then
		legacyIsland.pitProgress = nil
	end

	-- v10: gelegte Eier.
	--
	-- lastEggAt bewusst auf JETZT statt auf createdAt: ein Spielstand, der vor
	-- diesem Feature entstanden ist, hat keine Ei-Zeit — wuerde man hier
	-- createdAt einsetzen, bekaeme er beim ersten Join nach dem Update die
	-- Obergrenze auf einen Schlag geschenkt, fuer eine Zeit, in der es das
	-- Legen noch gar nicht gab.
	if island.laidEggs == nil then
		island.laidEggs = {}
	else
		-- Nur vollstaendige Eintraege behalten. Ein Ei ohne uid liesse sich nie
		-- einsammeln und laege bis in alle Ewigkeit auf dem Plot herum.
		local cleaned: { Types.LaidEgg } = {}
		for _, egg in island.laidEggs do
			if typeof(egg.uid) == "string" and #egg.uid > 0
				and typeof(egg.eggType) == "string"
				and typeof(egg.x) == "number"
				and typeof(egg.y) == "number"
				and typeof(egg.z) == "number"
			then
				table.insert(cleaned, egg)
			end
		end
		island.laidEggs = cleaned
	end

	if island.lastEggAt == nil then
		island.lastEggAt = os.time()
	end

	-- v15: Waben-Recycler. Feldweise nachgeruestet (wie lastEggAt), deshalb
	-- gefahrlos wiederholbar und ohne Versionssprung.
	local recycler = (island :: any).recycler
	if typeof(recycler) ~= "table" then
		(island :: any).recycler = { level = 1, queued = 0, progress = 0, lastProcessedAt = os.time() }
	else
		if typeof(recycler.level) ~= "number" then recycler.level = 1 end
		if typeof(recycler.queued) ~= "number" then recycler.queued = 0 end
		if typeof(recycler.progress) ~= "number" then recycler.progress = 0 end
		if typeof(recycler.lastProcessedAt) ~= "number" then recycler.lastProcessedAt = os.time() end
	end

	-- (v5 hatte hier die uid-Nachruestung der Brut-Eier — seit v12 gibt es
	-- keine Brut-Eier mehr, siehe oben.)

	-- v4: die Gebaeude sind komplett ausgetauscht. Frueher gab es Hatchery,
	-- GummyFarm, Recycler (und davor FusionLab) mit je eigener Funktion —
	-- jetzt reine Honig-Produzenten. Alte Eintraege werden entfernt und
	-- die neuen angelegt; das Level laesst sich nicht sinnvoll uebertragen,
	-- weil die Gebaeude etwas voellig anderes tun.
	--
	-- (Honigtopf und Honig-Presse bleiben hier noch stehen: die v7- und die
	-- v15-Migration weiter unten brauchen ihre Level. Entfernt werden sie erst
	-- in der v15-Zusammenlegung.)
	local OBSOLETE_BUILDINGS = { "Hatchery", "GummyFarm", "Recycler", "FusionLab" }

	if island.buildings == nil then
		island.buildings = default.island.buildings
	else
		local buildings = island.buildings :: any

		for _, obsolete in OBSOLETE_BUILDINGS do
			buildings[obsolete] = nil
		end

		for buildingId, building in default.island.buildings do
			local existing = buildings[buildingId]
			if existing == nil then
				buildings[buildingId] = {
					id             = building.id,
					level          = building.level,
					honey          = building.honey,
					lastProducedAt = building.lastProducedAt,
				}
			else
				-- v4: Honig-Felder auf bereits vorhandenen Gebaeuden nachruesten
				if existing.honey == nil then
					existing.honey = 0
				end
				if existing.lastProducedAt == nil then
					existing.lastProducedAt = os.time()
				end
			end
		end
	end

	-- v7: die drei Gebaeude haben eigene Rollen bekommen (siehe
	-- Config/BuildingBehavior). Die XP pro Honig haengen seitdem allein am Level
	-- der Honig-Presse — vorher am Level des Gebaeudes, aus dem der Honig kam,
	-- also an allen dreien.
	--
	-- Ohne Ausgleich wuerde ein laufender Spielstand dabei XP VERLIEREN: wer
	-- seinen Bienenstock auf Level 5 stehen hat und die Presse auf Level 1,
	-- bekaeme ploetzlich 30 statt 135 XP pro Honig. Deshalb erbt die Presse
	-- einmalig das hoechste Level, das dieser Spielstand bei irgendeinem
	-- Gebaeude erreicht hatte. Danach ist die XP-Ausbeute mindestens so gut wie
	-- vorher, und niemand muss etwas nachkaufen.
	--
	-- DAS IST DIE ERSTE MIGRATION, DIE AN DER VERSIONSNUMMER HAENGEN MUSS
	-- (siehe den Kommentar bei data.version am Ende dieser Funktion): sie
	-- rechnet einen Wert um, statt ein fehlendes Feld anzulegen. Liefe sie bei
	-- jedem Join erneut, wuerde die Presse jedes Mal wieder auf das Maximum
	-- hochgezogen — der Spieler koennte die anderen beiden nie ueberholen.
	if (data.version or 0) < 7 then
		local press = (island.buildings :: any).HoneyPress

		if press then
			local highest = press.level or 1

			for _, building in island.buildings do
				highest = math.max(highest, building.level or 1)
			end

			press.level = highest
		end
	end

	-- ============================================================
	-- v15: GEBAEUDE OPTION B — Honigtopf + Honig-Presse -> Honig-Veredler
	-- ============================================================
	-- Niemand verliert etwas: der Veredler bekommt das HOEHERE der beiden alten
	-- Level (er kann beides: XP wie die Presse, Heilung wie der Topf), und der
	-- eingelagerte Honig beider wird zusammengelegt (gedeckelt auf sein Lager).
	-- Haengt an der Version, weil es UMRECHNET; danach sind Topf und Presse weg.
	-- Ueber `any`, weil Types.BuildingId die alten Ids nicht mehr kennt.
	do
		local buildings = island.buildings :: any
		if (data.version or 0) < 15 then
			local pot     = buildings.HoneyPot
			local press   = buildings.HoneyPress
			local refiner = buildings.HoneyRefiner
			-- Mit HONEY_POND_V2 legt der Standard keinen Veredler mehr an; fuer
			-- die Zusammenlegung (und danach den Teich) wird er hier angelegt.
			if refiner == nil and (pot or press) then
				refiner = { id = "HoneyRefiner", level = 1, honey = 0, lastProducedAt = os.time() }
				buildings.HoneyRefiner = refiner
			end
			if refiner and (pot or press) then
				local level = math.max(refiner.level or 1,
					if pot then pot.level or 1 else 1,
					if press then press.level or 1 else 1)
				refiner.level = math.clamp(level, 1, EconomyConfig.MAX_BUILDING_LEVEL)

				local honey = (if pot then pot.honey or 0 else 0) + (if press then press.honey or 0 else 0)
				refiner.honey = math.clamp(honey, 0, BuildingBehavior.getCapacity("HoneyRefiner", refiner.level))
			end
		end

		-- Honig-Teich (HONEY_POND_V2) bzw. zurueck zu Stock + Veredler. MUSS vor
		-- dem Aufraeumen unten laufen: sonst waeren die gerade nicht geltenden
		-- Gebaeude schon geloescht statt im Ruhestand (island.retiredBuildings).
		HoneyPondMode.apply(island, FeatureFlags.isOn("HONEY_POND_V2"), os.time())
		local pond = buildings[HoneyPondMode.POND]
		if pond then
			pond.level = EconomyConfig.clampBuildingLevel(pond.level or 1)
			pond.honey = math.clamp(pond.honey or 0, 0, BuildingBehavior.getCapacity("HoneyPond", pond.level))
		end

		-- Alles, was es nicht (mehr) gibt, verschwindet — auch Topf und Presse
		-- nach der Zusammenlegung. Am Feld erkennbar, deshalb wiederholbar.
		for buildingId in buildings do
			if default.island.buildings[buildingId] == nil then
				buildings[buildingId] = nil
			end
		end

		-- Level auf den gueltigen Bereich (1-60) klemmen.
		for _, building in buildings do
			building.level = EconomyConfig.clampBuildingLevel(building.level or 1)
		end
	end

	-- ============================================================
	-- v15: TOWER STATT PIT-LEVEL
	-- ============================================================
	-- 1. Erstattung: die Summe der bezahlten PIT-Ausbaukosten landet in
	--    island.pitRefund. Die Migration fasst KEINE Waehrung an —
	--    TowerService zahlt den Betrag beim Join ueber EconomyService aus.
	-- 2. Rekord: der alte letzte Lauf (pitProgress) wird in die gleich starke
	--    Tower-Stage umgerechnet (TowerConfig.legacyPitToTower) und als
	--    permanenter Rekord eingetragen. Die zugehoerigen Meilensteine vergibt
	--    TowerService beim Join rueckwirkend.
	-- 3. pitLevel, pitProgress und stats.highestPitLevel werden entfernt.
	--
	-- Gilt reachedStage als "geschafft"? reachedStage ist die letzte Stage, in
	-- die der Baerchi eingetreten ist — gewonnen oder verloren. Bewusst
	-- grosszuegig als Rekord gezaehlt: niemand soll durch die Umstellung weniger
	-- haben (ANNAHME, im Bericht).
	data.towers = (data :: any).towers
	if typeof(data.towers) ~= "table" then
		data.towers = {
			records      = {},
			claimed      = {},
			highestTower = TowerConfig.FIRST_TOWER,
			selected     = TowerConfig.FIRST_TOWER,
		}
	end
	local towers = data.towers :: any
	if typeof(towers.records) ~= "table" then towers.records = {} end
	if typeof(towers.claimed) ~= "table" then towers.claimed = {} end

	if (data.version or 0) < 15 then
		local legacyLevel = tonumber(legacyIsland.pitLevel) or 1
		local refund = TowerConfig.legacyPitRefund(legacyLevel)
		legacyIsland.pitRefund = (tonumber(legacyIsland.pitRefund) or 0) + refund

		local legacyProgress = legacyIsland.pitProgress
		if typeof(legacyProgress) == "table" then
			local towerId, stage = TowerConfig.legacyPitToTower(
				tonumber(legacyProgress.pitLevel) or legacyLevel,
				tonumber(legacyProgress.reachedStage) or 0
			)
			if towerId and stage > 0 then
				towers.records[towerId] = math.max(tonumber(towers.records[towerId]) or 0, stage)
			end
		end
	end
	legacyIsland.pitLevel    = nil
	legacyIsland.pitProgress = nil
	stats.highestPitLevel    = nil

	-- Rekorde: nur gueltige Tower, nur Zahlen, nur bis zur Stage-Zahl.
	for towerId, record in towers.records do
		local def = TowerConfig.get(towerId)
		local value = tonumber(record)
		if not def or not value or value <= 0 then
			towers.records[towerId] = nil
		else
			towers.records[towerId] = math.clamp(math.floor(value), 0, def.stages)
		end
	end
	-- Meilensteine: Tabelle je Tower mit TEXT-Schluesseln (siehe Types).
	for towerId, claimed in towers.claimed do
		if not TowerConfig.get(towerId) or typeof(claimed) ~= "table" then
			towers.claimed[towerId] = nil
		else
			local cleaned: { [string]: boolean } = {}
			for stage, flag in claimed do
				if flag == true and tonumber(stage) then
					cleaned[tostring(math.floor(tonumber(stage) :: number))] = true
				end
			end
			towers.claimed[towerId] = cleaned
		end
	end
	-- Hoechster Tower = der hoechste mit Rekord (nie niedriger als gespeichert).
	local highest = if TowerConfig.isValidId(towers.highestTower) then towers.highestTower else TowerConfig.FIRST_TOWER
	for towerId in towers.records do
		if TowerConfig.getIndex(towerId) > TowerConfig.getIndex(highest) then
			highest = towerId
		end
	end
	towers.highestTower = highest

	-- v17 (08.10.): Freischaltung durch Schaffen. Bestandsschutz: was nach der
	-- ALTEN Regel (Deckel pro Rebirth) offen war oder einen Rekord hat, bleibt
	-- offen — niemand verliert Zugang. Nur einmal (Version), danach fuehrt
	-- TowerService die Tabelle. Unbekannte Eintraege fliegen raus.
	if typeof(towers.unlocked) ~= "table" then
		towers.unlocked = {}
	end
	local unlocked = towers.unlocked :: { [string]: boolean }
	for towerId, flag in unlocked do
		if flag ~= true or not TowerConfig.isValidId(towerId) then
			unlocked[towerId] = nil
		end
	end
	unlocked[TowerConfig.FIRST_TOWER] = true
	local rebirths = tonumber((data :: any).rebirthCount) or 0
	for _, def in TowerConfig.TOWERS do
		local wasOpen = (data.version or 0) < 17
			and TowerConfig.getLegacyStageCap(rebirths, def.id, towers.records) > 0
		if wasOpen or TowerConfig.isUnlockedByClear(def.id, towers.records, nil) then
			unlocked[def.id] = true
		end
	end

	if not TowerConfig.isValidId(towers.selected) then
		towers.selected = TowerConfig.FIRST_TOWER
	end

	-- Fortsetzen pro Tower (ersetzt pitProgress) und Erstattungs-Feld.
	if typeof(legacyIsland.towerProgress) ~= "table" then
		legacyIsland.towerProgress = {}
	else
		for towerId, stage in legacyIsland.towerProgress do
			if not TowerConfig.get(towerId) or typeof(stage) ~= "number" or stage < 1 then
				legacyIsland.towerProgress[towerId] = nil
			end
		end
	end
	if typeof(legacyIsland.pitRefund) ~= "number" or legacyIsland.pitRefund < 0 then
		legacyIsland.pitRefund = 0
	end

	-- v15: Login-Bonus. Feldweise, wiederholbar.
	local daily = (data :: any).daily
	if typeof(daily) ~= "table" then
		(data :: any).daily = { lastClaimDay = 0, streak = 0 }
	else
		if typeof(daily.lastClaimDay) ~= "number" then daily.lastClaimDay = 0 end
		if typeof(daily.streak) ~= "number" then daily.streak = 0 end
	end

	-- v8: die zweite Fortschrittsachse (Promotion, Stat-Level, Charms).
	--
	-- Steht bewusst VOR der currentHp-Migration weiter unten: die rechnet mit
	-- CombatCalculator.getEffectiveStats, und das liest inzwischen genau diese
	-- Felder. Es kaeme auch ohne zurecht (es faengt fehlende Felder mit 0 ab),
	-- aber ein Spielstand soll die Migration nicht in halb fertigem Zustand
	-- durchlaufen — das ist die Art Reihenfolge-Abhaengigkeit, die man erst
	-- Monate spaeter bemerkt.
	--
	-- Erkennt fehlende Felder einzeln statt an der Versionsnummer und ist
	-- deshalb gefahrlos wiederholbar (dieselbe Konvention wie v2/v4/v5).
	for _, baerchi in island.baerchis do
		if baerchi.promotionLevel == nil then
			baerchi.promotionLevel = 0
		end

		if baerchi.statLevels == nil then
			baerchi.statLevels = PromotionConfig.newStatLevels()
		else
			-- Einzelne Stat-Schluessel nachruesten: `egg` kam als letzter dazu,
			-- und ein kuenftiger fuenfter Stat soll hier ebenfalls landen, ohne
			-- dass die ganze Tabelle ersetzt (und damit der Fortschritt
			-- geloescht) wird.
			local levels = baerchi.statLevels :: any
			for _, key in PromotionConfig.ALL_STATS do
				if levels[key] == nil then
					levels[key] = 0
				end
			end
		end

		if baerchi.charms == nil then
			baerchi.charms = {}
		else
			-- Nur gueltige Eintraege behalten. Ein Charm ohne Slot oder mit
			-- einem Stat-Typ, den es nicht mehr gibt (Pool-Aenderung), waere
			-- sonst ein stiller Rechenfehler in getEffectiveStats.
			local cleaned: { Types.Charm } = {}
			for _, charm in baerchi.charms do
				local slotOk = typeof(charm.slot) == "number"
					and charm.slot >= 1
					and charm.slot <= CharmConfig.SLOT_COUNT

				if slotOk and CharmConfig.getStatDef(charm.statId) then
					if charm.locked == nil then
						charm.locked = false
					end
					table.insert(cleaned, charm)
				end
			end
			table.sort(cleaned, function(a, b)
				return a.slot < b.slot
			end)
			baerchi.charms = cleaned
		end

		-- baseStatOverride bleibt absichtlich ungesetzt: nil heisst "Basiswerte
		-- kommen wie immer aus BaerchiConfig", und genau das gilt fuer jeden
		-- Baerchi, der vor dieser Version entstanden ist — auch fuer die
		-- damaligen Fusions-Ergebnisse (die haben ihren Vorteil ueber
		-- fusionBonus, nicht ueber die Basiswerte).

		-- ============================================================
		-- v9: DEF ist weg, PWR ist da, Inverted ist neu
		-- ============================================================
		-- Anders als alles darueber RAEUMT diese Migration etwas WEG. Ein
		-- statLevels.def oder ein baseStatOverride.def aus v8 zeigt auf einen
		-- Stat, den es nicht mehr gibt — stehen bleiben duerfte er trotzdem
		-- nicht: er landete beim naechsten Speichern wieder im DataStore und
		-- waere in einem Jahr ein Feld, das niemand mehr einordnen kann.
		--
		-- Der alte def-WERT wird NICHT in pwr uebertragen. Die beiden haben
		-- nichts miteinander zu tun (Schadensreduktion gegen Ability-Staerke),
		-- und ein Baerchi mit acht DEF-Stufen haette sonst still acht Stufen
		-- eines voellig anderen Stats geschenkt bekommen. pwr faengt bei 0 an.
		local statLevels = baerchi.statLevels :: any
		if statLevels.def ~= nil then
			statLevels.def = nil
		end
		if statLevels.pwr == nil then
			statLevels.pwr = 0
		end

		local override = baerchi.baseStatOverride :: any
		if override ~= nil then
			override.def = nil

			-- Ein Fusions-Ergebnis aus v8 hat einen gemischten Basiswert fuer
			-- hp/atk/spd, aber keinen fuer pwr (den Stat gab es noch nicht).
			-- nil ist hier genau richtig: getEffectiveStats faellt dann auf den
			-- pwr-Wert seines configId zurueck.
		end

		-- ============================================================
		-- v11: MUTATION-SYSTEM ERSETZT INVERTED
		-- ============================================================
		-- Das binaere isInverted-Feld weicht dem gestuften Mutation-System
		-- (siehe BaerchiConfig.MUTATIONS). Alte Spielstaende kannten hoechstens
		-- isInverted = true.
		--
		-- ANNAHME, nicht vom Projektinhaber vorgegeben: ein zuvor invertierter
		-- Baerchi wird auf die Mutation "Diamond" abgebildet (0.3% Wurf-Chance,
		-- damit nahe an der alten INVERTED_CHANCE von 0.5% — eine exakte
		-- Entsprechung gibt es nicht, weil das alte System nur eine einzige
		-- Stufe kannte). Wer eine andere Zuordnung will, ist das hier die
		-- einzige Stelle, die es aendern muss.
		--
		-- Erkennt das alte Feld selbst (ueber `any`, weil Types.Baerchi es seit
		-- v11 nicht mehr kennt) und ist deshalb gefahrlos wiederholbar: beim
		-- ersten Durchlauf wird das alte Feld entfernt, jeder weitere Durchlauf
		-- findet es dann bereits als nil vor und tut nichts mehr.
		local legacy = baerchi :: any
		if legacy.isInverted == true and baerchi.mutation == nil then
			baerchi.mutation = "Diamond"
		end
		legacy.isInverted = nil
	end

	-- v2: fusionBonus auf allen bestehenden Baerchis
	for _, baerchi in island.baerchis do
		if baerchi.fusionBonus == nil then
			baerchi.fusionBonus = 0
		end
		if baerchi.isFusionResult == nil then
			baerchi.isFusionResult = false
		end
	end

	-- v4: currentHp auf allen bestehenden Baerchis.
	-- Sie haben unter dem neuen System noch nicht gekaempft, starten also mit
	-- vollen HP. CombatCalculator wird dafuer bewusst hier requiret: es ist
	-- ein reines Rechenmodul ohne Zustand, und maxHp soll es nur EINE Formel
	-- im ganzen Projekt geben.
	for _, baerchi in island.baerchis do
		if baerchi.currentHp == nil then
			local baerchiDef = BaerchiConfig.getById(baerchi.configId)

			if baerchiDef then
				-- In pcall: getEffectiveStats rechnet mit level und
				-- fusionBonus. Fehlt einem uralten Eintrag eines davon, waere
				-- der Fehler sonst mitten im Join — und ein einziger kaputter
				-- Baerchi wuerde den ganzen Spielstand unbrauchbar machen.
				local ok, maxHp = pcall(function()
					return CombatCalculator.getEffectiveStats(baerchi, baerchiDef.baseStats).maxHp
				end)

				baerchi.currentHp = if ok then maxHp else 0
				if not ok then
					warn("[PlayerService] Kaputter Baerchi-Eintrag migriert:", baerchi.configId, maxHp)
				end
			else
				-- Unbekannter configId (Config-Eintrag entfernt): nicht raten,
				-- lieber erschoepft starten als mit erfundenen Werten.
				baerchi.currentHp = 0
			end
		end
	end

	-- ============================================================
	-- v16: SAMMEL-UPDATE 05.10. (eine gemeinsame Migration)
	-- ============================================================
	-- Nur Anlegen, keine Waehrung. Am Feld erkennbar und damit wiederholbar.
	--   island.stageBest   Rebirth nach Stage (Paket 4.1). Fuer Staende VOR
	--                      v16 aus towerProgress gesaeet (dort steht die
	--                      zuletzt BETRETENE Stage, geschafft ist eine
	--                      weniger) — wer kurz vor dem alten Gummy-Rebirth
	--                      stand, muss nicht bei null anfangen.
	--   island.incubator   Paket 8, Level 1, keine Eier
	--   indexClaimed       Paket 7, leer (rueckwirkend abholbar)
	--   specialClaimed     Paket 6.2, leer (SpecialMilestoneService zahlt
	--                      beim Join rueckwirkend aus)
	if typeof(island.stageBest) ~= "table" then
		local best: { [string]: number } = {}
		if (data.version or 0) < 16 and typeof(island.towerProgress) == "table" then
			for towerId, entered in island.towerProgress :: any do
				local n = (tonumber(entered) or 0) - 1
				if typeof(towerId) == "string" and n > 0 then
					best[towerId] = n
				end
			end
		end
		island.stageBest = best
	end
	local incubator = (island :: any).incubator
	if typeof(incubator) ~= "table" then
		island.incubator = { level = 1, slots = {}, breeders = {} }
	else
		if typeof(incubator.level) ~= "number" or incubator.level < 1 then incubator.level = 1 end
		if typeof(incubator.slots) ~= "table" then incubator.slots = {} end
		-- INCUBATOR_BREED: Liste der bruetenden Baerchis (fehlt in v16-Staenden)
		if typeof(incubator.breeders) ~= "table" then incubator.breeders = {} end
	end
	if typeof((data :: any).indexClaimed) ~= "table" then
		data.indexClaimed = {}
	end
	if typeof((data :: any).specialClaimed) ~= "table" then
		data.specialClaimed = {}
	end

	-- Zum Schluss die Versionsnummer nachziehen. Sie steuert heute keine der
	-- Migrationen oben — die pruefen alle einzeln auf fehlende Felder und
	-- laufen deshalb harmlos bei jedem Laden. Sie ist trotzdem wichtig: sobald
	-- eine kuenftige Migration NICHT mehr am Feld erkennbar ist (weil sie zum
	-- Beispiel Werte umrechnet statt welche anzulegen), ist diese Zahl der
	-- einzige Weg, sie nicht bei jedem Join erneut auszufuehren. Wer
	-- Types.createDefaultPlayerData um ein Feld erweitert, erhoeht sie dort.
	data.version = default.version
	return data
end

return PlayerMigration
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX70"><Properties><string name="Name">WaspQueenEvent</string><ProtectedString name="Source"><![CDATA[--!strict
-- WaspQueenEvent.luau
-- ServerScriptService/Util/WaspQueenEvent.luau
--
-- Einzige Zustaendigkeit:
--   - Den Ablauf des Boss-Events "Wespenkoenigin" spielen: Ankuendigung,
--     Kampf in zwei Phasen, Attacken als Telegraph, Schaden im Takt,
--     Belohnung nach Schadensanteil (als Ergebnis fuer EventParticipationService).
--
-- Das ist der Handler EventHandlers.WaspQueen (gleiche Signatur wie alle
-- Handler: run(api, def) -> session, session.stop() -> results). Er steht in
-- einer eigenen Datei, weil er so gross ist wie zwei andere Events zusammen.
--
-- PERFORMANCE: Die Koenigin ist EIN Model, das der Server nie bewegt. Ihre
-- Bahn ist eine reine Funktion der Serverzeit (Modules/EventMotion); der
-- Server schreibt Start- und Phasenzeit als Attribute, der Client
-- (EventFXController) bewegt die Optik. Wespen und Stacheln gibt es nur als
-- Daten: der Server schickt pro Attacke einen Telegraph (Remotes.EventTelegraph),
-- der Client zeichnet die Warnflaeche, der Server rechnet bei hitAt aus, wer
-- getroffen ist. Schaden laeuft in EINEM Takt (TICK_SECONDS) fuer alle.
--
-- REGELN (siehe EventConfig.WASP_QUEEN):
--   * Baerchis am Event kaempfen automatisch. Ihr Schaden pro Sekunde kommt
--     aus dem echten Kampfmodell (Modules/BossBalance), keine eigene Formel.
--   * Spieler-Charaktere im Pit feuern an (CHEER_FACTOR) und muessen den
--     Telegraphen ausweichen. Ein Treffer stoesst zurueck und bremst (das
--     fuehrt der Client an seinem eigenen Charakter aus) und setzt den Schaden
--     des eigenen Baerchis HIT_STUN_SECONDS aus. Niemand stirbt.
--   * Phase 2 unter PHASE2_AT: schnellere Attacken, Waben-Regen mit dem
--     Wabenthema "Koenigsgelee" (CombService).
--   * Besiegt: Event endet sofort (api.finishEarly), Belohnung fuer alle ueber
--     MIN_DAMAGE_SHARE. Zeit abgelaufen: die Koenigin flieht, Teilbelohnung.

local Players             = game:GetService("Players")
local Workspace           = game:GetService("Workspace")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local EventConfig = require(ReplicatedStorage.Config.EventConfig)
local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local EventMotion = require(ReplicatedStorage.Modules.EventMotion)
local BossBalance = require(ReplicatedStorage.Modules.BossBalance)
local Loc         = require(ReplicatedStorage.Localization.Loc)
-- HBB Paket 7: Belohnungsstufen
local BossTiers    = require(ReplicatedStorage.Modules.BossTiers)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local EventKit    = require(ServerScriptService.Util.EventKit)
local CombService = require(ServerScriptService.Services.CombService)

local WaspQueenEvent = {}

--------------------------------------------------------------------------------
-- Optik (keine Balance)
--------------------------------------------------------------------------------

local QUEEN_YELLOW   = Color3.fromRGB(255, 196,  40)
local QUEEN_BLACK    = Color3.fromRGB( 40,  32,  28)
local QUEEN_WING     = Color3.fromRGB(210, 235, 255)
local QUEEN_CROWN    = Color3.fromRGB(255, 225,  90)
local QUEEN_SCALE    = 1.6

-- Reihenfolge der Attacken (Phase 2 nimmt dieselbe Reihenfolge, nur schneller).
local ATTACK_ORDER: { "ring" | "circles" | "lane" } = { "ring", "circles", "lane", "circles" }

-- Bahn des Schwarms: so weit vor und hinter dem Zielpunkt (Studs).
local SWARM_HALF_LENGTH = 55

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local flatDist = EventKit.flatDist

local function rootOfPlayer(player: Player): BasePart?
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- Abstand eines Punkts zur Strecke a→b (waagerecht).
local function distToSegment(p: Vector3, a: Vector3, b: Vector3): number
	local ab = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local ap = Vector3.new(p.X - a.X, 0, p.Z - a.Z)
	local len2 = ab:Dot(ab)
	if len2 < 1e-6 then return ap.Magnitude end
	local k = math.clamp(ap:Dot(ab) / len2, 0, 1)
	return (ap - ab * k).Magnitude
end

local function flatUnit(v: Vector3): Vector3
	local flat = Vector3.new(v.X, 0, v.Z)
	if flat.Magnitude < 1e-3 then
		return Vector3.new(1, 0, 0)
	end
	return flat.Unit
end

-- Baut die Koenigin als EIN Model, Drehpunkt = ihre Pose zu `pose`.
local function buildQueen(parent: Instance, pose: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "WaspQueen"

	local s = QUEEN_SCALE
	local function piece(props: { [string]: any }, offset: CFrame)
		props.CFrame = pose * offset
		EventKit.fxPart(props, model)
	end

	-- Hinterleib (gelb, zwei schwarze Streifen, Stachel), Brust, Kopf, Krone, Fluegel
	piece({ Name = "Abdomen", Shape = Enum.PartType.Ball, Material = Enum.Material.SmoothPlastic,
		Color = QUEEN_YELLOW, Size = Vector3.new(6, 6, 9) * s }, CFrame.new(0, 0, 5 * s))
	piece({ Name = "Stripe1", Shape = Enum.PartType.Cylinder, Material = Enum.Material.SmoothPlastic,
		Color = QUEEN_BLACK, Size = Vector3.new(1, 6.2, 6.2) * s }, CFrame.new(0, 0, 4 * s) * CFrame.Angles(0, math.rad(90), 0))
	piece({ Name = "Stripe2", Shape = Enum.PartType.Cylinder, Material = Enum.Material.SmoothPlastic,
		Color = QUEEN_BLACK, Size = Vector3.new(1, 5.4, 5.4) * s }, CFrame.new(0, 0, 6.6 * s) * CFrame.Angles(0, math.rad(90), 0))
	piece({ Name = "Stinger", Material = Enum.Material.Neon,
		Color = QUEEN_BLACK, Size = Vector3.new(0.8, 0.8, 3) * s }, CFrame.new(0, -0.5 * s, 10 * s))
	piece({ Name = "Thorax", Shape = Enum.PartType.Ball, Material = Enum.Material.SmoothPlastic,
		Color = QUEEN_BLACK, Size = Vector3.new(4.5, 4.5, 4.5) * s }, CFrame.new(0, 0.4 * s, 0))
	piece({ Name = "Head", Shape = Enum.PartType.Ball, Material = Enum.Material.SmoothPlastic,
		Color = QUEEN_YELLOW, Size = Vector3.new(4, 3.6, 3.6) * s }, CFrame.new(0, 0.8 * s, -3.5 * s))
	piece({ Name = "Crown", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon,
		Color = QUEEN_CROWN, Size = Vector3.new(1.2, 2.6, 2.6) * s }, CFrame.new(0, 3 * s, -3.5 * s) * CFrame.Angles(0, 0, math.rad(90)))
	piece({ Name = "WingL", Material = Enum.Material.Glass, Transparency = 0.35,
		Color = QUEEN_WING, Size = Vector3.new(9, 0.3, 4) * s }, CFrame.new(-5 * s, 3 * s, 1 * s) * CFrame.Angles(0, 0, math.rad(20)))
	piece({ Name = "WingR", Material = Enum.Material.Glass, Transparency = 0.35,
		Color = QUEEN_WING, Size = Vector3.new(9, 0.3, 4) * s }, CFrame.new(5 * s, 3 * s, 1 * s) * CFrame.Angles(0, 0, math.rad(-20)))

	model.WorldPivot = pose
	model.Parent = parent
	return model
end

--------------------------------------------------------------------------------
-- Der Handler
--------------------------------------------------------------------------------

function WaspQueenEvent.run(api: EventKit.Api, def: EventConfig.EventDef): EventKit.Session
	local cfg     = EventConfig.WASP_QUEEN
	local center  = api.center
	local running = true

	local folder = EventKit.newFolder("EventWaspQueen")
	local now0 = Workspace:GetServerTimeNow()
	local fightStart = now0 + cfg.ANNOUNCE_SECONDS

	-- Attribute fuer den Client: Bahn-Startzeit, Mitte, Kampfbeginn.
	folder:SetAttribute("StartTime", fightStart)
	folder:SetAttribute("Center", center)

	local queen = buildQueen(folder, EventMotion.queenPose(center, fightStart, fightStart, nil))

	-- Kampf-Zustand (nur im Speicher)
	local maxHp = 0
	local hp = 0
	local phase2At: number? = nil
	local victory = false
	local fighting = false
	local damage: { [Player]: number } = {}
	local stunUntil: { [Player]: number } = {}   -- os.clock()
	local dpsOf: { [string]: number } = {}       -- je baerchiUid
	-- HBB Paket 7: Potenzial (DPS x Zeit am Boss) und Aktivitaet je Spieler
	local potential: { [Player]: number } = {}
	local lastActive: { [Player]: number } = {}  -- os.clock()
	local lastPos: { [Player]: Vector3 } = {}
	local nextActivityCheck = 0

	local function publishHp()
		queen:SetAttribute("MaxHP", math.floor(maxHp))
		queen:SetAttribute("HP", math.max(0, math.floor(hp)))
	end

	local function measureDps(part: EventKit.Part): number
		local cached = dpsOf[part.baerchiUid]
		if cached then return cached end
		local stats = api.fightStats(part)
		local dps = if stats then BossBalance.dpsFromStats(stats) else 0
		dpsOf[part.baerchiUid] = dps
		return dps
	end

	local function inPit(position: Vector3): boolean
		return flatDist(position, center) <= api.radius
	end

	api.announce(Loc.msg("msg.boss.announce", { seconds = cfg.ANNOUNCE_SECONDS }), "big")

	----------------------------------------------------------------------------
	-- Attacken
	----------------------------------------------------------------------------

	-- Spieler-Charaktere, die gerade im Pit stehen (nur sie koennen getroffen werden).
	local function playersInPit(): { { player: Player, root: BasePart } }
		local list = {}
		for _, player in Players:GetPlayers() do
			local root = rootOfPlayer(player)
			if root and inPit(root.Position) then
				table.insert(list, { player = player, root = root })
			end
		end
		return list
	end

	local function randomPitPoint(): Vector3
		local angle = math.random() * math.pi * 2
		local r = api.radius * math.sqrt(math.random()) * 0.85
		return center + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
	end

	local function onGround(p: Vector3): Vector3
		return Vector3.new(p.X, center.Y, p.Z)
	end

	-- Wer ist bei hitAt in der Flaeche? Treffer: Rueckstoss + Bremse beim
	-- Client, Schadenspause fuer seinen Baerchi.
	local function resolve(t: Types.HazardTelegraph)
		for _, entry in playersInPit() do
			local p = entry.root.Position
			local hit = false
			local pushFrom: Vector3 = center

			if t.kind == "ring" and t.center then
				local d = flatDist(p, t.center)
				hit = d >= (t.inner or 0) and d <= (t.outer or 0)
				pushFrom = t.center
			elseif t.kind == "circles" and t.points then
				for _, point in t.points do
					if flatDist(p, point) <= (t.radius or 0) then
						hit = true
						pushFrom = point
						break
					end
				end
			elseif t.kind == "lane" and t.from and t.to then
				hit = distToSegment(p, t.from, t.to) <= (t.width or 0) / 2
				if hit then
					-- seitlich aus der Bahn stossen
					local along = flatUnit(t.to - t.from)
					local side = Vector3.new(-along.Z, 0, along.X)
					local rel = Vector3.new(p.X - t.from.X, 0, p.Z - t.from.Z)
					pushFrom = p - (if rel:Dot(side) >= 0 then side else -side)
				end
			end

			if hit then
				stunUntil[entry.player] = os.clock() + cfg.HIT_STUN_SECONDS
				local hitInfo: Types.HazardHit = {
					push        = flatUnit(p - pushFrom) * cfg.KNOCKBACK_SPEED,
					slowFactor  = cfg.SLOW_FACTOR,
					slowSeconds = cfg.SLOW_SECONDS,
				}
				Remotes.EventHazardHit:FireClient(entry.player, hitInfo)
			end
		end
	end

	local attackIndex = 0
	local function launchAttack()
		attackIndex += 1
		local kind = ATTACK_ORDER[(attackIndex - 1) % #ATTACK_ORDER + 1]
		local serverNow = Workspace:GetServerTimeNow()
		local hitAt = serverNow + cfg.TELEGRAPH_SECONDS
		local targets = playersInPit()

		local telegraph: Types.HazardTelegraph
		if kind == "ring" then
			telegraph = {
				kind = "ring",
				center = EventMotion.queenGround(center, fightStart, hitAt, phase2At),
				inner = cfg.SHOCK_INNER, outer = cfg.SHOCK_OUTER,
				warnAt = serverNow, hitAt = hitAt,
			}
		elseif kind == "circles" then
			local count = if phase2At then cfg.STING_COUNT_PHASE2 else cfg.STING_COUNT
			local points: { Vector3 } = {}
			for i = 1, count do
				local target = targets[((i - 1) % math.max(1, #targets)) + 1]
				-- Erst auf Spieler zielen, dann um sie herum streuen.
				local base = if target and i <= #targets then onGround(target.root.Position) else randomPitPoint()
				table.insert(points, base)
			end
			telegraph = {
				kind = "circles", points = points, radius = cfg.STING_RADIUS,
				warnAt = serverNow, hitAt = hitAt,
			}
		else
			local target = if #targets > 0 then targets[math.random(1, #targets)] else nil
			local through = if target then onGround(target.root.Position) else randomPitPoint()
			local angle = math.random() * math.pi * 2
			local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
			telegraph = {
				kind = "lane",
				from = through - dir * SWARM_HALF_LENGTH, to = through + dir * SWARM_HALF_LENGTH,
				width = cfg.SWARM_WIDTH,
				warnAt = serverNow, hitAt = hitAt,
			}
		end

		Remotes.EventTelegraph:FireAllClients(telegraph)
		task.delay(cfg.TELEGRAPH_SECONDS, function()
			if running and fighting then
				local ok, err = pcall(resolve, telegraph)
				if not ok then
					warn("[WaspQueen] Treffer-Pruefung fehlgeschlagen:", err)
				end
			end
		end)
	end

	----------------------------------------------------------------------------
	-- Kampf-Takt
	----------------------------------------------------------------------------

	local nextAttack = 0
	local nextRain = 0

	local function startFight()
		local dpsList: { number } = {}
		for _, part in api.participants() do
			table.insert(dpsList, measureDps(part))
		end
		maxHp = BossBalance.bossHp(dpsList)
		hp = maxHp
		publishHp()
		fighting = true
		nextAttack = os.clock() + cfg.PHASE1_ATTACK_INTERVAL
		api.announce(Loc.msg("msg.boss.fight"), "big")
		print(string.format("[WaspQueen] Kampf beginnt | %d Baerchis | HP %d", #dpsList, maxHp))
	end

	local function fightTick()
		local now = os.clock()
		local elapsed = Workspace:GetServerTimeNow() - fightStart

		-- Wer erst jetzt dazukommt, macht den Kampf nicht kuerzer.
		local total = 0
		local checkActivity = now >= nextActivityCheck
		if checkActivity then
			nextActivityCheck = now + EventConfig.BOSS_TIERS.ACTIVE_CHECK_SECONDS
		end
		for _, part in api.participants() do
			local uid = part.baerchiUid
			if dpsOf[uid] == nil then
				local dps = measureDps(part)
				local extra = BossBalance.lateJoinHp(dps, elapsed)
				maxHp += extra
				hp += extra
			end

			local player = part.player

			-- HBB Paket 7: was der eigene Baerchi in dieser Zeit haette machen
			-- koennen (ohne Anfeuern, ohne Treffer) — Massstab der Stufe.
			potential[player] = (potential[player] or 0) + (dpsOf[uid] or 0) * cfg.TICK_SECONDS
			if checkActivity then
				local root = rootOfPlayer(player)
				if root then
					local before = lastPos[player]
					if before and (root.Position - before).Magnitude > EventConfig.BOSS_TIERS.ACTIVE_MOVE_STUDS then
						lastActive[player] = now
					end
					lastPos[player] = root.Position
				end
			end

			if now >= (stunUntil[player] or 0) then
				local root = rootOfPlayer(player)
				local cheer = if root and inPit(root.Position) then cfg.CHEER_FACTOR else 1
				local dmg = (dpsOf[uid] or 0) * cfg.TICK_SECONDS * cheer
				damage[player] = (damage[player] or 0) + dmg
				total += dmg
			end
		end
		hp -= total
		publishHp()

		-- Phase 2
		if not phase2At and hp <= maxHp * cfg.PHASE2_AT then
			phase2At = Workspace:GetServerTimeNow()
			queen:SetAttribute("Phase2At", phase2At)
			CombService.setTheme(cfg.RAIN_THEME)
			nextRain = now
			api.announce(Loc.msg("msg.boss.phase2"), "big")
		end
		if phase2At and now >= nextRain then
			CombService.launchCombs(cfg.RAIN_COUNT, nil)
			nextRain = now + cfg.RAIN_INTERVAL_SECONDS
		end

		-- Attacken
		if now >= nextAttack then
			launchAttack()
			nextAttack = now + (if phase2At then cfg.PHASE2_ATTACK_INTERVAL else cfg.PHASE1_ATTACK_INTERVAL)
		end

		-- Sieg
		if hp <= 0 then
			victory = true
			fighting = false
			api.announce(Loc.msg("msg.boss.victory"), "big")
			print(string.format("[WaspQueen] Besiegt nach %.0f s", elapsed))
			api.finishEarly()
		end
	end

	task.spawn(function()
		local untilFight = fightStart - Workspace:GetServerTimeNow()
		if untilFight > 0 then task.wait(untilFight) end
		if not running then return end

		local ok, err = pcall(startFight)
		if not ok then
			warn("[WaspQueen] Kampfbeginn fehlgeschlagen:", err)
			return
		end

		while running and fighting do
			task.wait(cfg.TICK_SECONDS)
			if not running or not fighting then break end
			local ok2, err2 = pcall(fightTick)
			if not ok2 then
				warn("[WaspQueen] Takt fehlgeschlagen:", err2)
			end
		end
	end)

	----------------------------------------------------------------------------
	-- Ende: Belohnung nach Schadensanteil
	----------------------------------------------------------------------------

	return {
		stop = function()
			running = false
			fighting = false

			if not victory and maxHp > 0 then
				api.announce(Loc.msg("msg.boss.fled"), "info")
			end

			local results: { [Player]: EventKit.Reward } = {}
			local payouts = BossBalance.payouts(damage, victory)
			for player, pay in payouts do
				if not pay.qualified then
					-- Mit Stufen bekommt auch er etwas (unten): keine "zu wenig"-Meldung.
					if FeatureFlags.isOn("BOSS_TIERS") then continue end
					api.notify(player, Loc.msg("msg.boss.too_little", { min = math.floor(cfg.MIN_DAMAGE_SHARE * 100) }), "info")
					continue
				end

				local reward: EventKit.Reward = {
					gummies   = pay.gummies,
					combUnits = pay.combUnits,
					notice    = Loc.msg("msg.boss.reward", {
						rank  = pay.rank,
						share = math.floor(pay.share * 100 + 0.5),
					}),
				}

				-- Sammel-Update 05.10. (Paket 6.2): Boss-Sieg merken (besonderer
				-- Meilenstein, Zaehler stats.bossVictories).
				reward.bossVictory = victory
				if pay.victoryEgg then
					if math.random() < cfg.JACKPOT_CHANCE then
						reward.egg = { kind = "eggs", eggType = EventConfig.UFO.JACKPOT_EGG, amount = 1 }
						api.announce(Loc.msg("msg.boss.jackpot", { player = player.DisplayName }), "big")
					else
						reward.egg = def.bonus
					end
				end
				if pay.top then
					reward.extraEgg = { kind = "eggs", eggPick = "jump", amount = 1 }
					reward.rarityUpFactor = cfg.RARITY_UP_FACTOR
				end
				results[player] = reward
			end

			-- HBB Paket 7: Stufen ZUSAETZLICH zur Anteils-Belohnung oben. Jeder
			-- mit Schaden >= 1 bekommt etwas, auch unter MIN_DAMAGE_SHARE.
			if FeatureFlags.isOn("BOSS_TIERS") then
				local tiersCfg = EventConfig.BOSS_TIERS
				local now = os.clock()
				for player, dmg in damage do
					local active = now - (lastActive[player] or -math.huge) <= tiersCfg.ACTIVE_WINDOW_SECONDS
					local tier = BossTiers.tierFor(dmg, potential[player] or 0, active, victory, tiersCfg)
					local pay = tiersCfg.REWARDS[tier]
					if tier <= 0 or not pay then continue end

					local reward: EventKit.Reward = results[player] or {}
					reward.gummies   = (reward.gummies or 0) + pay.gummies
					reward.combUnits = (reward.combUnits or 0) + pay.combUnits
					reward.bossTier  = tier
					if pay.mutationRoll then
						reward.tierBonus = { kind = "mutation", chance = tiersCfg.MUTATION_CHANCE }
					end
					-- Eier zahlt EventParticipationService mit dem Rest aus (gleiche
					-- Pruefung, ob der Baerchi noch am Event steht).
					reward.tierEggs = pay.basicEggs
					results[player] = reward
					print(string.format("[WaspQueen] %s | Stufe %d | Schaden %.0f / Potenzial %.0f | aktiv %s",
						player.Name, tier, dmg, potential[player] or 0, tostring(active)))
				end
			end

			-- Waben im Pit wieder normal (getragene behalten ihren Wert).
			CombService.clearTheme()
			folder:Destroy()
			return results
		end,
	}
end

return WaspQueenEvent
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX112"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX82"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX73"><Properties><string name="Name">AreaSignController</string><ProtectedString name="Source"><![CDATA[--!strict
-- AreaSignController.luau
-- StarterPlayerScripts/Controllers/AreaSignController.luau
--
-- Einzige Zustaendigkeit:
--   - Grosse Bereichs-Schilder in der Welt (Sammel-Update 05.10., Paket 3.8):
--     zwei Woerter, was ein Bereich macht ("Waben-Feld", "Ei-Haendler", ...).
--
-- Rein clientseitig: ein BillboardGui pro Bereich, an ein schon vorhandenes
-- Teil gehaengt (Adornee) und in PlayerGui abgelegt — KEIN neues Teil in der
-- Welt, also nichts am Teile-Budget. Weil jeder Client sein eigenes Schild
-- baut, steht es in SEINER Sprache (Schluessel "area.<id>").
--
-- Plot-Schilder (Honig-Teich, Recycler, Inkubator, Arena) nur am eigenen Plot
-- — fremde Plots sind nicht das, was ein neuer Spieler verstehen muss.
--
-- Mit FeatureFlags.AREA_SIGNS = false baut dieses Modul nichts.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local Loc          = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local AreaSignController = {}

local OWNER_ATTRIBUTE = "PlotOwner"
local SIGN_DISTANCE   = 220
local TEXT_COLOR      = Color3.fromRGB(255, 236, 170)

-- Teil-Name -> { Schluessel, nur eigener Plot?, Hoehe ueber dem Teil }
type SignDef = { key: string, own: boolean, lift: number, size: Vector2 }
local SIGNS: { [string]: SignDef } = {
	EventFloor = { key = "area.pit",       own = false, lift = 26, size = Vector2.new(22, 5) },
	Counter    = { key = "area.merchant",  own = false, lift = 11, size = Vector2.new(14, 3.4) },
	LiveBoard  = { key = "area.live",      own = false, lift = 12, size = Vector2.new(14, 3.4) },
	HoneyPond  = { key = "area.pond",      own = true,  lift = 14, size = Vector2.new(14, 3.4) },
	Recycler   = { key = "area.recycler",  own = true,  lift = 12, size = Vector2.new(14, 3.4) },
	Base       = { key = "area.incubator", own = true,  lift = 9,  size = Vector2.new(14, 3.4) },
	FightFloor = { key = "area.arena",     own = true,  lift = 16, size = Vector2.new(16, 3.8) },
}

local _container: Folder? = nil
local _signs: { [BasePart]: TextLabel } = {}

local function ownerOf(instance: Instance): number?
	local current: Instance? = instance
	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then return owner end
		current = current.Parent
	end
	return nil
end

local function matches(part: BasePart, def: SignDef): boolean
	-- "Counter" gibt es nur am Haendler, "Base" nur am Inkubator: Eltern pruefen
	if part.Name == "Counter" and (not part.Parent or part.Parent.Name ~= "EggMerchant") then return false end
	if part.Name == "Base" and (not part.Parent or part.Parent.Name ~= "Incubator") then return false end
	local owner = ownerOf(part)
	if def.own then
		return owner == Players.LocalPlayer.UserId
	end
	return true
end

local function attach(part: BasePart)
	local def = SIGNS[part.Name]
	local container = _container
	if not def or not container or _signs[part] or not matches(part, def) then return end

	local gui = Instance.new("BillboardGui")
	gui.Name = "AreaSign_" .. part.Name
	gui.Adornee = part
	gui.Size = UDim2.fromScale(def.size.X, def.size.Y)
	gui.StudsOffsetWorldSpace = Vector3.new(0, def.lift, 0)
	gui.MaxDistance = SIGN_DISTANCE
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Parent = container

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = TEXT_COLOR
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(40, 28, 20)
	label.Text = Loc.t(def.key)
	label:SetAttribute("Key", def.key)
	label.Parent = gui

	_signs[part] = label
	part.AncestryChanged:Connect(function()
		if part.Parent == nil then
			_signs[part] = nil
			gui:Destroy()
		end
	end)
end

local function hook(instance: Instance)
	if instance:IsA("BasePart") and SIGNS[instance.Name] then
		-- Plot-Attribute und Eltern stehen beim Einhaengen evtl. noch nicht
		task.defer(attach, instance)
	end
end

function AreaSignController.init()
	if not FeatureFlags.isOn("AREA_SIGNS") then return end
	local folder = Instance.new("Folder")
	folder.Name = "AreaSigns"
	folder.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	_container = folder

	for _, descendant in Workspace:GetDescendants() do
		hook(descendant)
	end
	Workspace.DescendantAdded:Connect(hook)

	Loc.onChanged(function()
		for _, label in _signs do
			local key = label:GetAttribute("Key")
			if typeof(key) == "string" then label.Text = Loc.t(key) end
		end
	end)
end

return AreaSignController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX74"><Properties><string name="Name">CombController</string><ProtectedString name="Source"><![CDATA[--!strict
-- CombController.luau
-- StarterPlayerScripts/Controllers/CombController.luau
--
-- Einzige Zustaendigkeit:
--   - Alles, was der Spieler von den Honigwaben im Event-Pit und vom
--     Waben-Recycler SIEHT und ausloest:
--       1. Eine kleine Anzeige "Waben 12/25" (nur wenn er welche traegt)
--       2. Meldungen bei Abgabe und Recycler-Ausbau
--       3. Den Ausbau-Prompt am EIGENEN Recycler
--       4. Das Wippen und Drehen der im Pit liegenden Waben
--
-- Die Wahrheit liegt komplett auf dem Server (CombService, CombRecyclerService):
-- was getragen wird, kommt ueber Player-Attribute ("CombsCarried"/"CombsMax"),
-- Level und Warteschlange des Recyclers ueber PlayerDataUpdated. Dieser Controller
-- rechnet nichts und entscheidet nichts.
--
-- Der Prompt entsteht auf dem Client, nur am eigenen Plot — dasselbe Muster wie
-- die Gebaeude-Prompts im WorldController (der Server wendet die Anfrage ohnehin
-- immer auf die Daten des anfragenden Spielers an).

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local MapConfig  = require(ReplicatedStorage.Config.MapConfig)
local Remotes    = require(ReplicatedStorage.Network.Remotes)
local Loc        = require(ReplicatedStorage.Localization.Loc)
local FeedbackConfig = require(ReplicatedStorage.Config.FeedbackConfig)

local Theme       = require(script.Parent.Parent.UI.Theme)
local Toast       = require(script.Parent.Parent.UI.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify      = require(script.Parent.Parent.UI.Notify)
local Feedback    = require(script.Parent.Parent.UI.Feedback)
local ClientState = require(script.Parent.ClientState)

local CombController = {}

local localPlayer = Players.LocalPlayer

local WORLD_FOLDER_NAME = "EventPitCombs"
local OWNER_ATTRIBUTE   = "PlotOwner"
local PROMPT_NAME       = "UpgradeRecycler"
local PROMPT_DISTANCE   = 14
-- 08.10. (Paket G): ein Druck statt Halten; gegen Doppelkauf sperrt sich der
-- Prompt danach kurz (FeedbackConfig.UPGRADE_FX.PROMPT_LOCK).
local PROMPT_HOLD       = 0

-- Wippen und Drehen der Waben im Pit (rein optisch, nur auf diesem Client)
local BOB_HEIGHT = 0.32
local BOB_RATE   = 2.0    -- Schwingungen pro Sekunde (in Radiant: * 1)
local SPIN_RATE  = 0.9    -- Radiant pro Sekunde

--------------------------------------------------------------------------------
-- Anzeige "Waben x/y"
--------------------------------------------------------------------------------

local _pill: Frame? = nil
local _carryLabel: TextLabel? = nil
local _hintLabel: TextLabel? = nil

local function isInPit(): boolean
	local character = localPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not root or not root:IsA("BasePart") then return false end

	local flat = Vector3.new(
		root.Position.X - MapConfig.CENTER.X,
		0,
		root.Position.Z - MapConfig.CENTER.Z
	)
	return flat.Magnitude <= MapConfig.EVENT_PIT_RADIUS
end

local function refreshCarry()
	local pill, carryLabel, hint = _pill, _carryLabel, _hintLabel
	if not pill or not carryLabel or not hint then return end

	local count = localPlayer:GetAttribute("CombsCarried")
	local max   = localPlayer:GetAttribute("CombsMax")
	if typeof(count) ~= "number" or typeof(max) ~= "number" or count <= 0 then
		pill.Visible = false
		return
	end

	pill.Visible = true
	carryLabel.Text = Loc.t("ui.comb.carry", { n = count, max = max })

	if count >= max then
		hint.Text = Loc.t("ui.comb.full")
		hint.TextColor3 = Theme.COLORS.goldGummy
	elseif isInPit() then
		hint.Text = Loc.t("ui.comb.slow")
		hint.TextColor3 = Theme.COLORS.textDim
	else
		hint.Text = ""
	end
end

local function buildPill(screenGui: ScreenGui)
	local pill = Theme.panel("CombPill", screenGui, Theme.COLORS.panel)
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.Position    = UDim2.new(0.5, 0, 0, 12)
	pill.Size        = UDim2.new(0, 250, 0, 54)
	pill.Visible     = false

	local carry = Theme.label("Carry", pill, "")
	carry.Position       = UDim2.new(0, 10, 0, 4)
	carry.Size           = UDim2.new(1, -20, 0, 26)
	carry.TextXAlignment = Enum.TextXAlignment.Center
	carry.TextColor3     = Theme.COLORS.goldGummy

	local hint = Theme.bodyText("Hint", pill, "")
	hint.Position       = UDim2.new(0, 10, 0, 30)
	hint.Size           = UDim2.new(1, -20, 0, 20)
	hint.TextXAlignment = Enum.TextXAlignment.Center

	_pill        = pill
	_carryLabel  = carry
	_hintLabel   = hint
end

--------------------------------------------------------------------------------
-- Recycler-Prompt (nur am eigenen Plot)
--------------------------------------------------------------------------------

local function findPlotOwner(instance: Instance): number?
	local current: Instance? = instance
	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner
		end
		current = current.Parent
	end
	return nil
end

local function costText(level: number): string
	local cost = CombConfig.getUpgradeCost(level + 1)
	if not cost then
		return Loc.t("ui.recycler.maxed")
	end

	local text = if cost.goldGummies > 0
		then Loc.t("ui.recycler.cost_gg", { gummies = Theme.formatNumber(cost.gummies), gold = cost.goldGummies })
		else Loc.t("ui.recycler.cost_g", { gummies = Theme.formatNumber(cost.gummies) })

	return Loc.t("ui.recycler.upgrade", { cost = text })
end

local _locked: { [ProximityPrompt]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function writePrompt(prompt: ProximityPrompt)
	local data = ClientState.get()
	local level = if data then data.island.recycler.level else 1

	prompt.ObjectText = string.format("%s  Lv.%d", Loc.t("ui.recycler.name"), level)

	if level >= CombConfig.RECYCLER_MAX_LEVEL then
		prompt.ActionText = Loc.t("ui.recycler.maxed")
		prompt.Enabled    = false
	else
		-- Reicht es nicht, steht im Prompt, wie viel fehlt (ausgrauen kann der
		-- Standard-Prompt nicht); der Server lehnt einen Druck dann ab.
		local cost = CombConfig.getUpgradeCost(level + 1)
		local missing = if cost and data then cost.gummies - data.gummies else 0
		prompt.ActionText = if missing > 0
			then Loc.t("ui.upgrade.prompt_need", { missing = Theme.formatNumber(missing) })
			else costText(level)
		prompt.Enabled    = not _locked[prompt]
	end
end

local _prompts: { ProximityPrompt } = {}

local function attachPrompt(body: BasePart)
	if body:FindFirstChild(PROMPT_NAME) then return end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = PROMPT_NAME
	prompt.KeyboardKeyCode       = Enum.KeyCode.E
	prompt.HoldDuration          = PROMPT_HOLD
	prompt.MaxActivationDistance = PROMPT_DISTANCE
	prompt.RequiresLineOfSight   = false
	prompt.Parent                = body

	prompt.Triggered:Connect(function()
		if _locked[prompt] then return end
		_locked[prompt] = true
		prompt.Enabled = false
		Remotes.RequestUpgradeRecycler:FireServer()
		task.delay(FeedbackConfig.UPGRADE_FX.PROMPT_LOCK, function()
			_locked[prompt] = nil
			if prompt.Parent then writePrompt(prompt) end
		end)
	end)

	table.insert(_prompts, prompt)
	prompt.Destroying:Connect(function()
		local index = table.find(_prompts, prompt)
		if index then table.remove(_prompts, index) end
	end)

	writePrompt(prompt)
end

local function hookWorldPart(instance: Instance)
	if not instance:IsA("BasePart") then return end
	if instance.Name ~= CombConfig.RECYCLER_NAME then return end

	local function tryAttach()
		if findPlotOwner(instance) == localPlayer.UserId then
			attachPrompt(instance)
			return true
		end
		return false
	end

	if tryAttach() then return end

	-- Replikation ist nicht sortiert: das Plot-Model kann beim Client ankommen,
	-- bevor sein Besitzer-Attribut da ist. Einmal im naechsten Frame nachsehen.
	task.defer(function()
		if instance.Parent then
			tryAttach()
		end
	end)
end

--------------------------------------------------------------------------------
-- Waben im Pit: Wippen und Drehen
--------------------------------------------------------------------------------

-- `fly` = Einflug (Vulkan-Ausbruch, Waben-Regen): von `from` zur Ruhelage
-- zwischen den Serverzeiten `start` und `finish` (Attribute FlyFrom/FlyStart/FlyEnd).
type Fly = { from: Vector3, start: number, finish: number }
type Bob = { base: CFrame?, phase: number, spawnTime: number, fly: Fly? }

local _bobbing: { [Model]: Bob } = {}

-- Wie oft trackComb auf fehlende Attribute wartet (je ein Frame), bevor die
-- Wabe aufgegeben wird. Attribute kommen mit dem Model selbst an; das ist nur
-- ein Sicherheitsnetz.
local BASE_RETRY_FRAMES = 6

-- Auftauch-Effekt frisch gespawnter Waben: steigt aus dem Boden und federt nach.
local POP_SECONDS = 0.45
local POP_DEPTH   = 1.6

-- Baut die Ruhelage aus den Attributen "Pos"/"Yaw" (CombBuilder.buildWorldComb).
-- NIE aus GetPivot(): siehe Kopf von buildWorldComb.
local function readBase(model: Model): CFrame?
	local pos = model:GetAttribute("Pos")
	local yaw = model:GetAttribute("Yaw")
	if typeof(pos) ~= "Vector3" or typeof(yaw) ~= "number" then
		return nil
	end
	return CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
end

local function trackComb(child: Instance)
	if not child:IsA("Model") then return end
	local model = child :: Model

	local phase = model:GetAttribute("Phase")
	local spawnTime = model:GetAttribute("SpawnTime")
	local flyFrom   = model:GetAttribute("FlyFrom")
	local flyStart  = model:GetAttribute("FlyStart")
	local flyEnd    = model:GetAttribute("FlyEnd")
	local fly: Fly? = nil
	if typeof(flyFrom) == "Vector3" and typeof(flyStart) == "number" and typeof(flyEnd) == "number" then
		fly = { from = flyFrom, start = flyStart, finish = flyEnd }
	end
	local bob: Bob = {
		base      = readBase(model),
		phase     = if typeof(phase) == "number" then phase else 0,
		-- Fliegende Waben tauchen nicht zusaetzlich aus dem Boden auf.
		spawnTime = if fly then 0 elseif typeof(spawnTime) == "number" then spawnTime else 0,
		fly       = fly,
	}
	_bobbing[model] = bob

	if bob.base then return end

	-- Sicherheitsnetz: Attribute fehlen noch. Ein paar Frames nachsehen, bis
	-- dahin ueberspringt animateCombs diese Wabe (kein PivotTo mit Identitaet).
	task.spawn(function()
		for _ = 1, BASE_RETRY_FRAMES do
			task.wait()
			if _bobbing[model] ~= bob then return end
			local base = readBase(model)
			if base then
				bob.base = base
				return
			end
		end
	end)
end

local function hookWorldFolder(folder: Instance)
	for _, child in folder:GetChildren() do
		trackComb(child)
	end
	folder.ChildAdded:Connect(trackComb)
	folder.ChildRemoved:Connect(function(child)
		if child:IsA("Model") then
			_bobbing[child] = nil
		end
	end)
end

-- Versatz nach unten waehrend des Auftauchens (0 = fertig). Ueberschwingt kurz.
local function popOffset(now: number, spawnTime: number): number
	local age = now - spawnTime
	if spawnTime <= 0 or age >= POP_SECONDS or age < 0 then return 0 end
	local k = age / POP_SECONDS
	-- 1 → 0 mit kleinem Ueberschwinger (Back-Ease-Out)
	local c = 1.7
	local eased = 1 + (c + 1) * (k - 1) ^ 3 + c * (k - 1) ^ 2
	return -POP_DEPTH * (1 - eased)
end

-- Einflug: Bogen von `from` zur Ruhelage, Hoehe CombConfig.FLIGHT_ARC_HEIGHT.
-- nil = Flug ist vorbei (oder hat noch nicht begonnen und die Wabe wartet oben).
local function flyPosition(fly: Fly, landing: Vector3, now: number): Vector3?
	if now >= fly.finish then return nil end
	local span = math.max(0.05, fly.finish - fly.start)
	local k = math.clamp((now - fly.start) / span, 0, 1)
	local arc = 4 * k * (1 - k) * CombConfig.FLIGHT_ARC_HEIGHT
	return fly.from:Lerp(landing, k) + Vector3.new(0, arc, 0)
end

local function animateCombs()
	local t = os.clock()
	local serverNow = Workspace:GetServerTimeNow()
	for model, bob in _bobbing do
		local base = bob.base
		local fly = bob.fly
		if base and fly and model.Parent then
			local pos = flyPosition(fly, base.Position, serverNow)
			if pos then
				model:PivotTo(CFrame.new(pos) * CFrame.Angles(t * 6, t * SPIN_RATE * 3, 0))
				continue
			end
			bob.fly = nil
		end
		if base and model.Parent then
			local lift = math.sin(t * BOB_RATE + bob.phase) * BOB_HEIGHT + popOffset(serverNow, bob.spawnTime)
			model:PivotTo(base * CFrame.new(0, lift, 0) * CFrame.Angles(0, t * SPIN_RATE + bob.phase, 0))
		end
	end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function CombController.init(screenGui: ScreenGui)
	buildPill(screenGui)

	for _, name in { "CombsCarried", "CombsMax" } do
		localPlayer:GetAttributeChangedSignal(name):Connect(refreshCarry)
	end
	refreshCarry()

	-- "Im Pit" aendert sich ohne Attribut-Aenderung, deshalb ein gemuetlicher
	-- Takt fuer den Hinweistext.
	task.spawn(function()
		while true do
			task.wait(0.4)
			refreshCarry()
		end
	end)

	Remotes.CombDelivered.OnClientEvent:Connect(function(count: any, _units: any)
		if typeof(count) ~= "number" then return end
		Notify.emit("comb_delivered", function()
			Toast.success(Loc.tn("msg.comb_delivered", count))
		end, function()
			Feedback.gain("comb", count)
		end)
	end)

	Remotes.RecyclerUpgraded.OnClientEvent:Connect(function(level: any)
		if typeof(level) ~= "number" then return end
		Notify.emit("recycler_upgraded", function()
			Toast.success(Loc.t("msg.recycler_upgraded", { level = level }))
		end, function()
			-- Paket G: den Moment zeigt UI/UpgradeFX am Recycler selbst
			-- (aus dem Datenstand) — hier kein zweites "⬆" ueber dem Spieler.
		end)
	end)

	-- Prompt-Text nachziehen, wenn sich Level/Gummies aendern oder die Sprache
	ClientState.onChanged(function()
		for _, prompt in _prompts do
			writePrompt(prompt)
		end
	end)
	Loc.onChanged(function()
		for _, prompt in _prompts do
			writePrompt(prompt)
		end
		refreshCarry()
	end)

	for _, descendant in Workspace:GetDescendants() do
		hookWorldPart(descendant)
	end
	Workspace.DescendantAdded:Connect(hookWorldPart)

	local existing = Workspace:FindFirstChild(WORLD_FOLDER_NAME)
	if existing then
		hookWorldFolder(existing)
	end
	Workspace.ChildAdded:Connect(function(child)
		if child.Name == WORLD_FOLDER_NAME then
			hookWorldFolder(child)
		end
	end)

	RunService.RenderStepped:Connect(animateCombs)

	print("[CombController] Initialisiert")
end

return CombController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX75"><Properties><string name="Name">EggTimerController</string><ProtectedString name="Source"><![CDATA[--!strict
-- EggTimerController.luau
-- StarterPlayerScripts/Controllers/EggTimerController.luau
--
-- Einzige Zustaendigkeit:
--   - Auf dem Feld, direkt am Namensschild des EIGENEN Baerchis, anzeigen,
--     wie lange es noch bis zum naechsten gelegten Ei dauert.
--
-- ============================================================
-- WARUM DAS REIN CLIENTSEITIG TICKT
-- ============================================================
-- Der Server schickt nur EINEN Zeitstempel (island.lastEggAt), keinen
-- laufenden Countdown — dasselbe Zeitmarken-Prinzip wie ueberall im Projekt
-- (Honig, Brut-Timer). Eine Anzeige, die jede Sekunde weiterzaehlt, braucht
-- dafuer keinen einzigen zusaetzlichen Netzwerk-Roundtrip: das Legeintervall
-- steht als reine Formel in EggCalculator (geteiltes Modul, ReplicatedStorage)
-- und ist auf dem Client genauso berechenbar wie auf dem Server.
--
-- Das ist eine bewusste Ausnahme von "der Client hat keinen eigenen
-- Wahrheitsstand" — hier wird nichts SIMULIERT, nur eine bereits bekannte
-- Formel auf einen bereits bekannten Zeitstempel angewendet. Sobald der
-- naechste PlayerDataUpdated hereinkommt (z.B. weil das Ei tatsaechlich
-- gelegt wurde), zeigt der naechste Tick automatisch wieder den echten Stand.
--
-- ============================================================
-- WARUM NUR DER EIGENE BAERCHI
-- ============================================================
-- PlayerDataUpdated liefert ausschliesslich die eigene Insel (siehe
-- ClientState-Kommentar-Kopf) — fuer die Baerchis anderer Spieler haette
-- dieser Client also gar keine Zahlen, mit denen er rechnen koennte.

local Players   = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local EggCalculator = require(ReplicatedStorage.Modules.EggCalculator)
local Loc           = require(ReplicatedStorage.Localization.Loc)

local ClientState = require(script.Parent.ClientState)

local EggTimerController = {}

local OWNER_ATTRIBUTE = "PlotOwner"
local UID_ATTRIBUTE   = "BaerchiUid"
local TICK_SECONDS     = 1

-- Das aktuell bekannte Label des EIGENEN Baerchis, plus seine uid. Wird bei
-- jedem Neuaufbau der Figur (Level-Up, Equip-Wechsel) neu gefunden und
-- ersetzt automatisch den alten Eintrag.
local _label: TextLabel? = nil
local _uid: string? = nil

-- v12: Zustand der Pet-Leiste (PetModeChanged). Ist der Baerchi unterwegs
-- (Event/PIT), pausiert der Lege-Timer auf dem Server — dann zeigt das
-- Schild das an, statt herunterzuzaehlen.
local _petState = "Home"

--------------------------------------------------------------------------------
-- Wem gehoert der Plot, in dem dieses Teil steckt?
--
-- Dieselbe Logik wie in WorldController.findPlotOwner. Bewusst hier noch
-- einmal (kurz genug) statt geteilt, damit dieser Controller unabhaengig
-- bleibt und nichts von WorldControllers interner Struktur wissen muss.
--------------------------------------------------------------------------------
local function findPlotOwner(instance: Instance): number?
	local current: Instance? = instance

	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner
		end
		current = current.Parent
	end

	return nil
end

local function isOwnPlot(instance: Instance): boolean
	return findPlotOwner(instance) == Players.LocalPlayer.UserId
end

--------------------------------------------------------------------------------
-- Anzeige
--------------------------------------------------------------------------------

local function formatSeconds(totalSeconds: number): string
	local seconds = math.max(0, math.floor(totalSeconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

-- Schreibt den aktuellen Countdown in das gemerkte Label. Laeuft jede Sekunde
-- UND sofort nach dem Einhaengen eines neuen Labels, damit nicht bis zu einer
-- Sekunde lang "kein Text" zu sehen ist.
local function refresh()
	local label = _label
	local uid   = _uid
	if not label or not uid then return end

	if not label.Parent then
		-- Figur wurde inzwischen neu aufgebaut (altes Label zerstoert) — der
		-- naechste hook() findet das neue Label von selbst.
		_label = nil
		_uid   = nil
		return
	end

	local data = ClientState.get()
	if not data then return end

	-- Der Baerchi kann inzwischen umgeruestet worden sein, ohne dass diese
	-- Figur schon durch eine neue ersetzt wurde (kurzes Zeitfenster waehrend
	-- MapService neu baut) — dann lieber nichts anzeigen als etwas Falsches.
	if data.island.equippedUid ~= uid then
		label.Text = ""
		return
	end

	local baerchi = data.island.baerchis[uid]
	if not baerchi then
		label.Text = ""
		return
	end

	if _petState ~= "Home" then
		label.Text = Loc.t("ui.egg.paused")
		return
	end

	if EggCalculator.countOwnLaid(data.island.laidEggs) >= EggConfig.MAX_UNCOLLECTED_EGGS then
		label.Text = Loc.t("ui.egg.full")
		return
	end

	local interval = EggCalculator.getLayIntervalSeconds(baerchi, false)
	if not interval then
		-- Dieser Baerchi legt grundsaetzlich keine Eier (kein layIntervalSeconds
		-- oder keine eggTable in seiner Config).
		label.Text = ""
		return
	end

	local nextAt      = (data.island.lastEggAt or os.time()) + interval
	local secondsLeft = nextAt - os.time()

	label.Text = if secondsLeft <= 0
		then Loc.t("ui.egg.soon")
		else Loc.t("ui.egg.next", { time = formatSeconds(secondsLeft) })
end

--------------------------------------------------------------------------------
-- Label finden
--------------------------------------------------------------------------------

-- Sucht am Modell der gerade angekommenen Part nach dem "EggTimer"-Label, das
-- MapService.buildBaerchiFigure im Namensschild mit anlegt. Nur fuer den
-- EIGENEN Plot — fuer fremde Baerchis gibt es weder Daten noch einen Grund,
-- deren Timer mitzuzaehlen.
local function tryHookFigurePart(part: BasePart): boolean
	local uid = part:GetAttribute(UID_ATTRIBUTE)
	if typeof(uid) ~= "string" then return false end
	if not isOwnPlot(part) then return false end

	local model = part:FindFirstAncestorWhichIsA("Model")
	if not model then return false end

	local label = model:FindFirstChild("EggTimer", true)
	if not (label and label:IsA("TextLabel")) then return false end

	_label = label
	_uid   = uid
	refresh()

	return true
end

local function hook(instance: Instance)
	if not instance:IsA("BasePart") then return end
	tryHookFigurePart(instance)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function EggTimerController.init()
	for _, descendant in Workspace:GetDescendants() do
		hook(descendant)
	end

	-- Die Figuren werden bei jedem Struktur-Neuaufbau ersetzt (siehe
	-- PlotDisplayService) — also staendig neu einhaengen.
	Workspace.DescendantAdded:Connect(hook)

	-- Bei einem Sprachwechsel sofort neu beschriften statt bis zum naechsten
	-- Sekunden-Tick zu warten.
	Loc.onChanged(function()
		refresh()
	end)

	local Remotes = require(ReplicatedStorage.Network.Remotes)
	Remotes.PetModeChanged.OnClientEvent:Connect(function(state: any)
		_petState = if typeof(state) == "string" then state else "Home"
		pcall(refresh)
	end)

	task.spawn(function()
		while true do
			task.wait(TICK_SECONDS)

			local ok, err = pcall(refresh)
			if not ok then
				warn("[EggTimerController] Tick fehlgeschlagen:", err)
			end
		end
	end)

	print("[EggTimerController] Initialisiert")
end

return EggTimerController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX76"><Properties><string name="Name">EventFXController</string><ProtectedString name="Source"><![CDATA[--!strict
-- EventFXController.luau
-- StarterPlayerScripts/Controllers/EventFXController.luau
--
-- Einzige Zustaendigkeit:
--   - Die bewegte Optik der lebendigen Events zeichnen: UFO-Patrouille,
--     fallende Abwurf-Kisten, Wespenkoenigin (samt HP-Leiste), Telegraphen der
--     Boss-Attacken, Himmel beim Boss — und Treffer am eigenen Charakter
--     ausfuehren und Event-Meldungen anzeigen.
--
-- Der Client rechnet und entscheidet nichts: Bahnen kommen aus
-- Modules/EventMotion (reine Funktionen der Serverzeit) und den Attributen,
-- die der Server einmal setzt (StartTime, Center, LandAt, Phase2At, HP).
-- Ob jemand getroffen ist, hat der Server entschieden (Remotes.EventHazardHit);
-- hier wird nur die Physik am EIGENEN Charakter ausgefuehrt, den der Client
-- besitzt.
--
-- PERFORMANCE: EIN RenderStepped fuer alles, ein PivotTo pro bewegtem Model
-- und Frame. Telegraphen sind wenige lokale Teile, die nach dem Treffer
-- verschwinden. Keine Lichter, keine Emitter.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local Lighting          = game:GetService("Lighting")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local EventMotion = require(ReplicatedStorage.Modules.EventMotion)
local Loc         = require(ReplicatedStorage.Localization.Loc)

local Theme = require(script.Parent.Parent.UI.Theme)
local Toast = require(script.Parent.Parent.UI.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify   = require(script.Parent.Parent.UI.Notify)
local Feedback = require(script.Parent.Parent.UI.Feedback)
local Moment   = require(script.Parent.Parent.UI.Moment)

local EventFXController = {}

local localPlayer = Players.LocalPlayer

--------------------------------------------------------------------------------
-- Optik (keine Balance)
--------------------------------------------------------------------------------

local UFO_FOLDER   = "EventUfo"
local QUEEN_FOLDER = "EventWaspQueen"

local QUEEN_DESCENT_HEIGHT = 60          -- waehrend der Ankuendigung von so hoch herab
local QUEEN_SPIN_WINGS     = 18          -- Fluegelschlag (Grad)

local TELEGRAPH_COLOR      = Color3.fromRGB(255, 70, 50)
local TELEGRAPH_SAFE_COLOR = Color3.fromRGB(90, 230, 120)
local TELEGRAPH_FLASH      = 0.25        -- so lange blitzt die Flaeche beim Treffer
local TELEGRAPH_THICKNESS  = 0.3
local TELEGRAPH_LIFT       = 0.35

local HP_BAR_SIZE    = UDim2.fromOffset(260, 46)
local HP_BAR_OFFSET  = Vector3.new(0, 14, 0)
local HP_BAR_COLOR   = Color3.fromRGB(255, 190, 40)
local HP_BAR_BACK    = Color3.fromRGB(30, 26, 22)

local SKY_TINT       = Color3.fromRGB(255, 205, 170)
local SKY_BRIGHTNESS = -0.12
local SKY_SATURATION = -0.15
local SKY_TWEEN      = 3

local HIT_UPWARD     = 22               -- kleiner Hopser beim Rueckstoss

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

type Crate = { model: Model, release: number, land: number, parts: { { part: BasePart, base: CFrame } }, canopy: BasePart?, landed: boolean }

local _ufo: { folder: Instance, model: Model?, start: number, center: Vector3 }? = nil
local _crates: { [Model]: Crate } = {}
local _queen: { folder: Instance, model: Model?, start: number, center: Vector3 }? = nil
local _telegraphs: { { parts: { BasePart }, hitAt: number, until_: number } } = {}
local _fxFolder: Folder? = nil

local function fxFolder(): Folder
	local folder = _fxFolder
	if folder and folder.Parent then
		return folder
	end
	local created = Instance.new("Folder")
	created.Name = "EventFX_Local"
	created.Parent = Workspace
	_fxFolder = created
	return created
end

local function localPart(props: { [string]: any }): BasePart
	local part: any = Instance.new("Part")
	part.Anchored   = true
	part.CanCollide = false
	part.CanQuery   = false
	part.CanTouch   = false
	part.CastShadow = false
	for key, value in props do
		part[key] = value
	end
	part.Parent = fxFolder()
	return part
end

--------------------------------------------------------------------------------
-- UFO und Kisten
--------------------------------------------------------------------------------

local function trackCrate(child: Instance)
	if not child:IsA("Model") or child.Name ~= "UfoDrop" then return end
	local release = child:GetAttribute("ReleaseAt")
	local land    = child:GetAttribute("LandAt")
	if typeof(release) ~= "number" or typeof(land) ~= "number" then return end

	-- Nur Kiste und Schirm fallen; Landekreis und Lichtsaeule stehen am Boden.
	local parts = {}
	for _, name in { "Crate", "Canopy" } do
		local part = child:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			table.insert(parts, { part = part, base = part.CFrame })
		end
	end
	local canopy = child:FindFirstChild("Canopy")
	_crates[child] = {
		model = child, release = release, land = land, parts = parts,
		canopy = if canopy and canopy:IsA("BasePart") then canopy else nil,
		landed = false,
	}
end

local function hookUfoFolder(folder: Instance)
	local start  = folder:GetAttribute("StartTime")
	local center = folder:GetAttribute("Center")
	if typeof(start) ~= "number" or typeof(center) ~= "Vector3" then
		-- Attribute kommen mit dem Ordner; ein Frame spaeter nochmal.
		task.defer(function()
			if folder.Parent and not _ufo then hookUfoFolder(folder) end
		end)
		return
	end
	local model = folder:FindFirstChild("Ufo")
	_ufo = { folder = folder, model = if model and model:IsA("Model") then model else nil, start = start, center = center }

	for _, child in folder:GetChildren() do
		trackCrate(child)
	end
	folder.ChildAdded:Connect(function(child)
		if child.Name == "Ufo" and child:IsA("Model") and _ufo and _ufo.folder == folder then
			_ufo.model = child
		end
		-- Kinder eines Models kommen evtl. nach dem Model an.
		task.defer(trackCrate, child)
	end)
	folder.ChildRemoved:Connect(function(child)
		if child:IsA("Model") then _crates[child] = nil end
	end)
end

local function animateUfo(now: number)
	local ufo = _ufo
	if not ufo then return end
	if not ufo.folder.Parent then
		_ufo = nil
		table.clear(_crates)
		return
	end
	local model = ufo.model
	if model and model.Parent then
		model:PivotTo(CFrame.new(EventMotion.ufoGround(ufo.center, ufo.start, now)))
	end

	for crateModel, crate in _crates do
		if not crateModel.Parent then
			_crates[crateModel] = nil
			continue
		end
		if crate.landed then continue end
		local height = if now < crate.release then EventMotion.DROP_FALL_HEIGHT else EventMotion.dropHeight(crate.release, crate.land, now)
		-- Vor dem Abwurf noch unsichtbar (unter dem UFO): ganz oben halten.
		for _, entry in crate.parts do
			entry.part.CFrame = entry.base + Vector3.new(0, height, 0)
		end
		if now >= crate.land then
			crate.landed = true
			local canopy = crate.canopy
			if canopy then canopy.Transparency = 1 end
		end
	end
end

--------------------------------------------------------------------------------
-- Wespenkoenigin
--------------------------------------------------------------------------------

local _hpFill: Frame? = nil
local _hpText: TextLabel? = nil

local function refreshHp(model: Model)
	local fill, text = _hpFill, _hpText
	if not fill or not text then return end
	local hp = model:GetAttribute("HP")
	local maxHp = model:GetAttribute("MaxHP")
	if typeof(hp) ~= "number" or typeof(maxHp) ~= "number" or maxHp <= 0 then
		fill.Size = UDim2.fromScale(1, 1)
		text.Text = Loc.t("ui.boss.name")
		return
	end
	fill.Size = UDim2.fromScale(math.clamp(hp / maxHp, 0, 1), 1)
	text.Text = Loc.t("ui.boss.hp", { hp = Loc.formatNumber(hp), max = Loc.formatNumber(maxHp) })
end

local function buildHpBar(model: Model)
	local head = model:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then return end

	local gui = Instance.new("BillboardGui")
	gui.Name        = "BossHp"
	gui.Size        = HP_BAR_SIZE
	gui.StudsOffset = HP_BAR_OFFSET
	gui.AlwaysOnTop = true
	gui.Adornee     = head
	gui.Parent      = model

	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.new(1, 0, 0, 18)
	back.Position = UDim2.new(0, 0, 1, -18)
	back.BackgroundColor3 = HP_BAR_BACK
	back.BorderSizePixel = 0
	back.Parent = gui
	Theme.corner(back, 6)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = HP_BAR_COLOR
	fill.BorderSizePixel = 0
	fill.Parent = back
	Theme.corner(fill, 6)

	local text = Theme.label("Name", gui, "")
	text.Size = UDim2.new(1, 0, 0, 24)
	text.TextXAlignment = Enum.TextXAlignment.Center
	text.TextColor3 = Theme.COLORS.goldGummy

	_hpFill, _hpText = fill, text
	refreshHp(model)
	model:GetAttributeChangedSignal("HP"):Connect(function() refreshHp(model) end)
	model:GetAttributeChangedSignal("MaxHP"):Connect(function() refreshHp(model) end)
end

local function hookQueenFolder(folder: Instance)
	local start  = folder:GetAttribute("StartTime")
	local center = folder:GetAttribute("Center")
	if typeof(start) ~= "number" or typeof(center) ~= "Vector3" then
		task.defer(function()
			if folder.Parent and not _queen then hookQueenFolder(folder) end
		end)
		return
	end
	_queen = { folder = folder, model = nil, start = start, center = center }

	local function adopt(child: Instance)
		if child.Name == "WaspQueen" and child:IsA("Model") and _queen and _queen.folder == folder then
			_queen.model = child
			task.defer(buildHpBar, child)
		end
	end
	for _, child in folder:GetChildren() do adopt(child) end
	folder.ChildAdded:Connect(adopt)
end

local function animateQueen(now: number)
	local queen = _queen
	if not queen then return end
	if not queen.folder.Parent then
		_queen = nil
		_hpFill, _hpText = nil, nil
		return
	end
	local model = queen.model
	if not model or not model.Parent then return end

	local phase2 = model:GetAttribute("Phase2At")
	local phase2At = if typeof(phase2) == "number" then phase2 else nil
	local pose: CFrame
	if now < queen.start then
		-- Ankuendigung: sinkt von oben herab auf ihre Bahn.
		local remaining = queen.start - now
		pose = EventMotion.queenPose(queen.center, queen.start, queen.start, nil)
			+ Vector3.new(0, QUEEN_DESCENT_HEIGHT * math.clamp(remaining / 20, 0, 1), 0)
	else
		pose = EventMotion.queenPose(queen.center, queen.start, now, phase2At)
	end
	model:PivotTo(pose)

	-- Fluegelschlag (lokal, rein optisch)
	local flap = math.rad(math.sin(now * 30) * QUEEN_SPIN_WINGS)
	for _, name in { "WingL", "WingR" } do
		local wing = model:FindFirstChild(name)
		if wing and wing:IsA("BasePart") then
			local sign = if name == "WingL" then 1 else -1
			wing.Transparency = 0.35 + 0.15 * math.abs(math.sin(now * 30))
			wing.CFrame = pose * CFrame.new(-5 * 1.6 * sign, 3 * 1.6, 1.6) * CFrame.Angles(0, 0, math.rad(20) * sign + flap * sign)
		end
	end
end

--------------------------------------------------------------------------------
-- Telegraphen
--------------------------------------------------------------------------------

local function disc(position: Vector3, radius: number, color: Color3, lift: number): BasePart
	return localPart({
		Name = "Telegraph", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon,
		Color = color, Transparency = 0.55,
		Size = Vector3.new(TELEGRAPH_THICKNESS, radius * 2, radius * 2),
		CFrame = CFrame.new(position + Vector3.new(0, lift, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	})
end

local function showTelegraph(t: Types.HazardTelegraph)
	local parts: { BasePart } = {}
	if t.kind == "ring" and t.center then
		table.insert(parts, disc(t.center, t.outer or 0, TELEGRAPH_COLOR, TELEGRAPH_LIFT))
		-- Innen ist sicher: gruene Scheibe knapp darueber.
		table.insert(parts, disc(t.center, t.inner or 0, TELEGRAPH_SAFE_COLOR, TELEGRAPH_LIFT + 0.05))
	elseif t.kind == "circles" and t.points then
		for _, point in t.points do
			table.insert(parts, disc(point, t.radius or 0, TELEGRAPH_COLOR, TELEGRAPH_LIFT))
		end
	elseif t.kind == "lane" and t.from and t.to then
		local from, to = t.from, t.to
		local mid = (from + to) / 2
		local length = (Vector3.new(to.X - from.X, 0, to.Z - from.Z)).Magnitude
		table.insert(parts, localPart({
			Name = "Telegraph", Material = Enum.Material.Neon, Color = TELEGRAPH_COLOR, Transparency = 0.55,
			Size = Vector3.new(t.width or 0, TELEGRAPH_THICKNESS, length),
			CFrame = CFrame.lookAt(mid + Vector3.new(0, TELEGRAPH_LIFT, 0), Vector3.new(to.X, mid.Y + TELEGRAPH_LIFT, to.Z)),
		}))
	end
	table.insert(_telegraphs, { parts = parts, hitAt = t.hitAt, until_ = t.hitAt + TELEGRAPH_FLASH })
end

local function animateTelegraphs(now: number)
	for i = #_telegraphs, 1, -1 do
		local t = _telegraphs[i]
		if now >= t.until_ then
			for _, part in t.parts do part:Destroy() end
			table.remove(_telegraphs, i)
		elseif now >= t.hitAt then
			for _, part in t.parts do part.Transparency = 0.05 end
		else
			-- pulsiert schneller, je naeher der Treffer
			local left = t.hitAt - now
			local pulse = 0.45 + 0.2 * math.sin(now * (8 + 12 / math.max(0.2, left)))
			for _, part in t.parts do
				if part.Color ~= TELEGRAPH_SAFE_COLOR then
					part.Transparency = pulse
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Treffer am eigenen Charakter
--------------------------------------------------------------------------------

local _slowToken = 0

local function onHit(info: any)
	if typeof(info) ~= "table" or typeof(info.push) ~= "Vector3" then return end
	local character = localPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not root or not root:IsA("BasePart") or not humanoid then return end

	root.AssemblyLinearVelocity = info.push + Vector3.new(0, HIT_UPWARD, 0)

	local factor  = if typeof(info.slowFactor) == "number" then info.slowFactor else 1
	local seconds = if typeof(info.slowSeconds) == "number" then info.slowSeconds else 0
	if factor < 1 and seconds > 0 then
		_slowToken += 1
		local token = _slowToken
		local before = humanoid.WalkSpeed
		local slowed = before * factor
		humanoid.WalkSpeed = slowed
		task.delay(seconds, function()
			-- Nur zuruecksetzen, wenn niemand sonst (CombService) inzwischen
			-- einen anderen Wert gesetzt hat.
			if token == _slowToken and humanoid.Parent and humanoid.WalkSpeed == slowed then
				humanoid.WalkSpeed = before
			end
		end)
	end
	Notify.emit("boss_hit", function()
		-- Sammel-Update 5.2: Stoss eines gegnerischen Baerchis im Pit
		Toast.show(Loc.t(if info.source == "brawl" then "ui.brawl.hit" else "ui.boss.hit"), Theme.COLORS.bad)
	end)
end

--------------------------------------------------------------------------------
-- Himmel beim Boss
--------------------------------------------------------------------------------

local _sky: ColorCorrectionEffect? = nil

local function setBossSky(active: boolean)
	local sky = _sky
	if not sky then
		local created = Instance.new("ColorCorrectionEffect")
		created.Name = "BossSky_Local"
		created.Parent = Lighting
		sky = created
		_sky = created
	end
	local effect = sky :: ColorCorrectionEffect
	TweenService:Create(effect, TweenInfo.new(SKY_TWEEN), {
		TintColor  = if active then SKY_TINT else Color3.new(1, 1, 1),
		Brightness = if active then SKY_BRIGHTNESS else 0,
		Saturation = if active then SKY_SATURATION else 0,
	}):Play()
end

--------------------------------------------------------------------------------
-- Belohnungs-Momente (Icon-Weg von "event_notice_good")
--------------------------------------------------------------------------------

-- HBB Paket 7: Truhenfarbe je Boss-Stufe 1..4 (Bronze, Silber, Gold, Lila)
local BOSS_TIER_COLORS = {
	Color3.fromRGB(205, 127, 50), Color3.fromRGB(200, 210, 225),
	Color3.fromRGB(255, 200, 40), Color3.fromRGB(190, 110, 255),
}

-- Zeigt zu einer bekannten Belohnungsnotiz das passende Bild ohne Text.
-- Rueckgabe false = Notiz unbekannt, der Aufrufer faellt auf den Toast zurueck.
local function playRewardMoment(key: any, args: any): boolean
	if key == "msg.boss.tier" then
		-- Truhe in der Stufenfarbe; die Inhalte fliegen danach ueber den
		-- Datenstand in die Pillen.
		local tier = if typeof(args) == "table" and typeof(args.tier) == "number" then args.tier else 1
		Moment.show("chest", BOSS_TIER_COLORS[math.clamp(tier, 1, 4)], nil)
	elseif key == "msg.event.rarity_up" then
		local to = if typeof(args) == "table" and Loc.isMsg(args.to) then args.to.k else nil
		local rarity = if typeof(to) == "string" then string.gsub(to, "^rarity%.", "") else nil
		Moment.show("rarity", if rarity then Theme.rarityColor(rarity :: any) else Theme.COLORS.goldGummy, "ui.moment.rarity")
	elseif key == "msg.event.combs" then
		local n = if typeof(args) == "table" and typeof(args.n) == "number" then args.n else 1
		Feedback.gain("comb", n)
	elseif key == "msg.event.gummies" or key == "msg.ufo.drop_picked" then
		-- schon ueber den Datenstand sichtbar
	else
		return false
	end
	return true
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function EventFXController.init()
	local function onWorkspaceChild(child: Instance)
		if child.Name == UFO_FOLDER then
			hookUfoFolder(child)
		elseif child.Name == QUEEN_FOLDER then
			hookQueenFolder(child)
		end
	end
	for _, child in Workspace:GetChildren() do
		onWorkspaceChild(child)
	end
	Workspace.ChildAdded:Connect(onWorkspaceChild)

	Remotes.EventTelegraph.OnClientEvent:Connect(function(t: any)
		if typeof(t) ~= "table" or typeof(t.hitAt) ~= "number" then return end
		showTelegraph(t :: Types.HazardTelegraph)
	end)

	Remotes.EventHazardHit.OnClientEvent:Connect(onHit)

	Remotes.EventNotice.OnClientEvent:Connect(function(msg: any, style: any)
		if not Loc.isMsg(msg) and typeof(msg) ~= "string" then return end
		if style == "big" then
			Notify.emit("event_notice_big", function()
				Toast.show(msg, Theme.COLORS.goldGummy)
			end)
		elseif style == "good" then
			Notify.emit("event_notice_good", function()
				Toast.success(msg)
			end, function()
				-- Gummies und Eier fliegen schon ueber den Datenstand
				-- (UI/Feedback). Hier nur, was dort nicht sichtbar wird.
				if not (Loc.isMsg(msg) and playRewardMoment((msg :: any).k, (msg :: any).a)) then
					-- Unbekannte Belohnungsnotiz: lieber lesen als verlieren
					Toast.success(msg)
				end
			end)
		else
			Notify.emit("event_notice_info", function()
				Toast.info(msg)
			end)
		end
	end)

	Remotes.EventPhaseChanged.OnClientEvent:Connect(function(eventId: any)
		setBossSky(eventId == "WaspQueen")
	end)

	RunService.RenderStepped:Connect(function()
		local now = Workspace:GetServerTimeNow()
		animateUfo(now)
		animateQueen(now)
		animateTelegraphs(now)
	end)

	print("[EventFXController] Initialisiert")
end

return EventFXController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX77"><Properties><string name="Name">GuideController</string><ProtectedString name="Source"><![CDATA[--!strict
-- GuideController.luau
-- StarterPlayerScripts/Controllers/GuideController.luau
--
-- Einzige Zustaendigkeit:
--   - Den aktuellen Fuehrungsschritt (Modules/GuideSteps) sichtbar machen:
--     Ziel in der Welt → leuchtender Beam vom Charakter zum Ziel,
--     Ziel in der Oberflaeche → pulsierender Rahmen und Pfeil am Knopf
--
-- Kontext: HBB Paket 2. Kein Text, hoechstens ein Icon. Passiert eine Weile
-- nichts (FeedbackConfig/GUIDE_HINT_SECONDS), wird die Hervorhebung staerker
-- ("Timed Hint").
--
-- Alles hier ist rein lokal: der Beam, die Attachments und der Rahmen
-- existieren nur auf diesem Client, ohne Kollision und ohne Remote.
--
-- Mit FeatureFlags.UI_V2_GUIDE = false zeigt dieses Modul nichts.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local GuideSteps   = require(ReplicatedStorage.Modules.GuideSteps)
local EggConfig    = require(ReplicatedStorage.Config.EggConfig)
local Loc          = require(ReplicatedStorage.Localization.Loc)   -- Sammel-Update 3.5
local PanelManager = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("PanelManager"))

local UI          = script.Parent.Parent:WaitForChild("UI")
local Theme       = require(UI:WaitForChild("Theme"))
local UiScale     = require(UI:WaitForChild("UiScale"))
local MenuBar     = require(UI:WaitForChild("MenuBar"))
local PetBar      = require(UI:WaitForChild("PetBar"))
local TowerPanel  = require(UI:WaitForChild("TowerPanel"))          -- 08.10. Schritt "tower"
local TerminalController = require(script.Parent.TerminalController)
local ClientState = require(script.Parent.ClientState)

local GuideController = {}

-- Nach so vielen Sekunden ohne Fortschritt wird die Hervorhebung staerker.
local HINT_AFTER_SECONDS = 12

-- Sammel-Update 05.10.:
-- 3.1 groessere Pfeile (vorher 40 px, Wippen 8/18 px)
local ARROW_SIZE   = 84
local ARROW_BOUNCE = 16
local ARROW_BOUNCE_STRONG = 30
-- 3.2 der Event-Schritt ist am Anfang unwichtig: er zeigt sich nur so lange
-- und verschwindet dann (bis zum naechsten Join).
local EVENT_STEP_SECONDS = 8
-- 3.5 ein Satz, was der Schritt bringt (Schluessel "guide.<step>")
local HINT_WIDTH = 300
local HIGHLIGHT_COLOR = Color3.fromRGB(255, 236, 140)
local BEAM_COLOR      = Color3.fromRGB(255, 220, 90)
local LAID_EGG_ATTRIBUTE = "LaidEggUid"

local _step: string? = nil
local _stepSince = 0
-- Welt-Ziel, im Takt von evaluate() gesucht (nicht jeden Frame: die Suche
-- laeuft ueber den Workspace)
local _worldTarget: BasePart? = nil

local _frame: Frame? = nil
local _stroke: UIStroke? = nil
local _arrow: TextLabel? = nil
local _hint: TextLabel? = nil

local _beam: Beam? = nil
local _from: Attachment? = nil
local _to: Attachment? = nil

--------------------------------------------------------------------------------
-- Ziele
--------------------------------------------------------------------------------

local function uiTarget(step: string): GuiObject?
	if step == "hatch" then
		return MenuBar.getTileAnchor("Hatch")
	elseif step == "fight" then
		return PetBar.getButton("Fight")
	elseif step == "event" then
		return PetBar.getButton("Event")
	elseif step == "tower" then
		-- 08.10.: im offenen Tower-Panel der Waehlen-Knopf von Tower II;
		-- sonst zeigt der Strahl zum Terminal (worldTarget)
		return TowerPanel.getGuideTarget()
	elseif step == "upgrade" then
		-- HUD_ROW_V2: keine Kachel mehr, der Strahl zeigt zum Brunnen (worldTarget)
		if FeatureFlags.isOn("HUD_ROW_V2") then return nil end
		-- Sammel-Update 3.5: Gebaeude-Kachel rechts
		return MenuBar.getTileAnchor(PanelManager.buildingPanelName(
			if FeatureFlags.isOn("HONEY_POND_V2") then "HoneyPond" else "HoneyRefiner"))
	end
	return nil
end

local function characterRoot(): BasePart?
	local character = Players.LocalPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	return if root and root:IsA("BasePart") then root else nil
end

-- Naechstes EIGENES gelegtes Ei (uid steht in den eigenen Daten).
local function nearestOwnEgg(): BasePart?
	local data = ClientState.get()
	local root = characterRoot()
	if not data or not root then return nil end
	local own: { [string]: boolean } = {}
	for _, egg in data.island.laidEggs do
		own[(egg :: any).uid] = true
	end
	local best: BasePart? = nil
	local bestDist = math.huge
	for _, descendant in Workspace:GetDescendants() do
		if descendant:IsA("BasePart") then
			local uid = descendant:GetAttribute(LAID_EGG_ATTRIBUTE)
			if typeof(uid) == "string" and own[uid] then
				local dist = (descendant.Position - root.Position).Magnitude
				if dist < bestDist then
					best, bestDist = descendant, dist
				end
			end
		end
	end
	return best
end

-- Theke des Ei-Haendlers (EggMerchantService baut das Model "EggMerchant")
local function merchantCounter(): BasePart?
	local model = Workspace:FindFirstChild("EggMerchant")
	local counter = if model then model:FindFirstChild("Counter") else nil
	return if counter and counter:IsA("BasePart") then counter else nil
end

-- Recycler auf dem EIGENEN Plot (Attribut PlotOwner am Plot-Model).
local function ownRecycler(): BasePart?
	for _, descendant in Workspace:GetDescendants() do
		if descendant.Name == "Recycler" and descendant:IsA("BasePart") then
			local model = descendant.Parent
			if model and model:GetAttribute("PlotOwner") == Players.LocalPlayer.UserId then
				return descendant
			end
		end
	end
	return nil
end

-- HUD_ROW_V2: Honig-Gebaeude auf dem EIGENEN Plot (Prompt "Verbessern").
local function ownHoneyBuilding(): BasePart?
	local id = if FeatureFlags.isOn("HONEY_POND_V2") then "HoneyPond" else "HoneyRefiner"
	for _, descendant in Workspace:GetDescendants() do
		if descendant.Name == id and descendant:IsA("BasePart") then
			local current: Instance? = descendant
			while current do
				local owner = current:GetAttribute("PlotOwner")
				if typeof(owner) == "number" then
					if owner == Players.LocalPlayer.UserId then return descendant end
					break
				end
				current = current.Parent
			end
		end
	end
	return nil
end

local function worldTarget(step: string): BasePart?
	if step == "tower" then
		if TowerPanel.isOpen() then return nil end
		return TerminalController.getOwnScreen()
	end
	if step == "upgrade" and FeatureFlags.isOn("HUD_ROW_V2") then
		return ownHoneyBuilding()
	elseif step == "collect" then
		return nearestOwnEgg()
	elseif step == "merchant" then
		return merchantCounter()
	elseif step == "combs" then
		-- Sammel-Update 3.5: mit Waben auf dem Kopf zum eigenen Recycler,
		-- sonst zu den Waben in die Mitte.
		local carried = Players.LocalPlayer:GetAttribute("CombsCarried")
		if typeof(carried) == "number" and carried > 0 then
			return ownRecycler()
		end
		local pit = Workspace:FindFirstChild("EventFloor", true)
		return if pit and pit:IsA("BasePart") then pit else nil
	end
	return nil
end

--------------------------------------------------------------------------------
-- Darstellung
--------------------------------------------------------------------------------

local function clearBeam()
	if _beam then _beam:Destroy() end
	if _from then _from:Destroy() end
	if _to then _to:Destroy() end
	_beam, _from, _to = nil, nil, nil
end

local function showBeam(target: BasePart)
	local root = characterRoot()
	if not root then
		clearBeam()
		return
	end
	if _to and _to.Parent == target and _from and _from.Parent == root then
		return
	end
	clearBeam()
	local from = Instance.new("Attachment")
	from.Name = "GuideFrom"
	from.Parent = root
	local to = Instance.new("Attachment")
	to.Name = "GuideTo"
	to.Position = Vector3.new(0, 1, 0)
	to.Parent = target
	local beam = Instance.new("Beam")
	beam.Name = "GuideBeam"
	beam.Attachment0 = from
	beam.Attachment1 = to
	beam.Color = ColorSequence.new(BEAM_COLOR)
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Width0 = 0.5
	beam.Width1 = 0.5
	beam.Segments = 12
	beam.CurveSize0 = 4
	beam.Transparency = NumberSequence.new(0.15)
	beam.Parent = root
	_beam, _from, _to = beam, from, to
end

local function hideHighlight()
	if _frame then _frame.Visible = false end
	if _arrow then _arrow.Visible = false end
end

-- Sammel-Update 3.5: Satz zum Schritt, unten mittig ueber der Pet-Leiste.
local function showHint(step: string?)
	local hint = _hint
	if not hint then return end
	local key = if step then "guide." .. step else nil
	if key and Loc.has(key) then
		hint.Text = Loc.t(key)
		hint.Visible = true
	else
		hint.Visible = false
	end
end

local function showHighlight(target: GuiObject, strong: boolean, t: number)
	local frame, stroke, arrow = _frame, _stroke, _arrow
	if not frame or not stroke or not arrow then return end
	if not target.Visible then
		hideHighlight()
		return
	end
	-- Bildschirm-Pixel -> Oberflaechen-Einheiten (globale UiScale)
	local pos, size = UiScale.toGui(target.AbsolutePosition), UiScale.toGui(target.AbsoluteSize)
	local pad = 6
	frame.Position = UDim2.fromOffset(pos.X - pad, pos.Y - pad)
	frame.Size = UDim2.fromOffset(size.X + pad * 2, size.Y + pad * 2)
	frame.Visible = true

	local wave = (math.sin(t * (if strong then 9 else 5)) + 1) * 0.5
	stroke.Thickness = (if strong then 5 else 3) + wave * (if strong then 4 else 2)
	stroke.Transparency = 0.1 + (1 - wave) * 0.4

	-- Pfeil zeigt von oben auf den Knopf (die Kachelleiste rechts: von links)
	local screen = frame.Parent :: GuiObject
	local fromLeft = pos.X > UiScale.toGui(screen.AbsoluteSize.X) * 0.8
	local bounce = wave * (if strong then ARROW_BOUNCE_STRONG else ARROW_BOUNCE)
	arrow.Visible = true
	if fromLeft then
		-- "➡" statt "➜": "➜" kann die Spielschrift nicht darstellen.
		arrow.Text = "➡"
		arrow.Position = UDim2.fromOffset(pos.X - ARROW_SIZE - 6 - bounce, pos.Y + size.Y * 0.5 - ARROW_SIZE * 0.5)
	else
		arrow.Text = "⬇"
		arrow.Position = UDim2.fromOffset(pos.X + size.X * 0.5 - ARROW_SIZE * 0.5, pos.Y - ARROW_SIZE - 6 - bounce)
	end
end

--------------------------------------------------------------------------------
-- Takt
--------------------------------------------------------------------------------

local function evaluate()
	local data = ClientState.get()
	local step: string? = nil
	if data and FeatureFlags.isOn("UI_V2_GUIDE") then
		-- HBB Paket 5: Haendler-Schritt nur mit sichtbarem Haendler
		local options = if FeatureFlags.isOn("MAP_V2_MERCHANT")
			then { merchantPrice = EggConfig.MERCHANT.priceGummies }
			else nil
		step = GuideSteps.current(data :: any, options)
	end
	if step ~= _step then
		_step = step
		_stepSince = os.clock()
	end
	_worldTarget = if step then worldTarget(step) else nil
end

local function render()
	local step = _step
	local now = os.clock()
	-- Sammel-Update 3.2: Event-Schritt nur kurz
	if step == "event" and now - _stepSince > EVENT_STEP_SECONDS then
		step = nil
	end
	showHint(step)
	if not step then
		hideHighlight()
		clearBeam()
		return
	end
	local strong = now - _stepSince >= HINT_AFTER_SECONDS

	local target = uiTarget(step)
	if target then
		clearBeam()
		showHighlight(target, strong, now)
		return
	end
	hideHighlight()

	local part = _worldTarget
	if part and part.Parent then
		showBeam(part)
		local beam = _beam
		if beam then
			local w = if strong then 0.9 + math.sin(now * 8) * 0.3 else 0.5
			beam.Width0, beam.Width1 = w, w
		end
	else
		clearBeam()
	end
end

function GuideController.init(screenGui: ScreenGui)
	local frame = Theme.container("GuideHighlight", screenGui)
	frame.ZIndex = 40
	frame.Visible = false
	Theme.corner(frame, 16)
	local stroke = Instance.new("UIStroke")
	stroke.Color = HIGHLIGHT_COLOR
	stroke.Thickness = 3
	stroke.Parent = frame
	_frame, _stroke = frame, stroke

	local arrow = Theme.label("GuideArrow", screenGui, "⬇")
	arrow.Size = UDim2.fromOffset(ARROW_SIZE, ARROW_SIZE)
	local arrowLimit = arrow:FindFirstChildOfClass("UITextSizeConstraint")
	if arrowLimit then arrowLimit.MaxTextSize = ARROW_SIZE end
	arrow.TextXAlignment = Enum.TextXAlignment.Center
	arrow.TextColor3 = HIGHLIGHT_COLOR
	arrow.ZIndex = 41
	arrow.Visible = false
	Theme.outlineText(arrow, 3)
	_arrow = arrow

	-- Sammel-Update 3.5: ein Satz pro Schritt
	local hint = Theme.label("GuideHint", screenGui, "")
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position = UDim2.new(0.5, 0, 1, -112)
	hint.Size = UDim2.fromOffset(HINT_WIDTH, 44)
	hint.TextXAlignment = Enum.TextXAlignment.Center
	hint.TextWrapped = true
	hint.TextColor3 = HIGHLIGHT_COLOR
	hint.ZIndex = 41
	hint.Visible = false
	Theme.outlineText(hint, 2)
	_hint = hint
	Loc.onChanged(function() showHint(_step) end)

	ClientState.onChanged(function()
		evaluate()
	end)

	-- Gelegte Eier tauchen ohne Datenaenderung auf/ab (Replikation): der
	-- Welt-Schritt wird deshalb im Takt neu gesucht, die Anzeige jeden Frame.
	local accumulator = 0
	RunService.RenderStepped:Connect(function(delta)
		accumulator += delta
		if accumulator >= 0.5 then
			accumulator = 0
			evaluate()
		end
		render()
	end)

	print("[GuideController] Initialisiert")
end

return GuideController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX78"><Properties><string name="Name">IncubatorController</string><ProtectedString name="Source"><![CDATA[--!strict
-- IncubatorController.luau
-- StarterPlayerScripts/Controllers/IncubatorController.luau
--
-- Einzige Zustaendigkeit:
--   - Den Inkubator auf dem EIGENEN Plot lebendig machen (Sammel-Update
--     05.10., Paket 8): Prompt "Inkubator" am Sockel, ueber jeder belegten
--     Kuppel ein Fortschrittsbalken mit Restzeit, Leuchten kurz vor dem
--     Schluepfen und solange das Ei fertig ist.
--
-- Rein clientseitig aus den Attributen der Kuppeln (StartedAt/FinishAt, siehe
-- IncubatorBuilder) — dasselbe Zeitmarken-Prinzip wie EggTimerController:
-- kein Server-Takt pro Ei, kein zusaetzliches Remote. "Jetzt" ist
-- workspace:GetServerTimeNow() (die Marken sind os.time() des Servers).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local Loc             = require(ReplicatedStorage.Localization.Loc)
local Names = require(game:GetService("ReplicatedStorage").Localization.Names)
local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)
local IncubatorConfig = require(ReplicatedStorage.Config.IncubatorConfig)

local PanelManager = require(script.Parent.Parent.UI.PanelManager)
local ClientState  = require(script.Parent.ClientState)
local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local EggCalculator = require(ReplicatedStorage.Modules.EggCalculator)

local IncubatorController = {}

local OWNER_ATTRIBUTE = "PlotOwner"
local TICK_SECONDS    = 0.5
local BAR_COLOR       = Color3.fromRGB(120, 230, 140)
local READY_COLOR     = Color3.fromRGB(255, 220, 90)

type DomeView = { dome: BasePart, gui: BillboardGui, fill: Frame, text: TextLabel, light: PointLight }
local _views: { [BasePart]: DomeView } = {}

local function isOwnPlot(instance: Instance): boolean
	local current: Instance? = instance
	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner == Players.LocalPlayer.UserId
		end
		current = current.Parent
	end
	return false
end

local function attachView(dome: BasePart)
	if _views[dome] then return end

	local gui = Instance.new("BillboardGui")
	gui.Name        = "IncubatorProgress"
	gui.Size        = UDim2.fromScale(4.4, 1.2)
	gui.StudsOffset = Vector3.new(0, dome.Size.Y * 0.5 + 1.0, 0)
	gui.MaxDistance = IncubatorConfig.LOOK.signDistance
	gui.AlwaysOnTop = false
	gui.Adornee     = dome
	gui.Enabled     = false
	gui.Parent      = dome

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Size = UDim2.fromScale(1, 0.38)
	track.Position = UDim2.fromScale(0, 0.62)
	track.BackgroundColor3 = Color3.fromRGB(30, 26, 46)
	track.BorderSizePixel = 0
	track.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = track

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = BAR_COLOR
	fill.BorderSizePixel = 0
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = fill

	local text = Instance.new("TextLabel")
	text.Name = "Time"
	text.Size = UDim2.fromScale(1, 0.6)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0.2
	text.Text = ""
	text.Parent = gui

	local light = Instance.new("PointLight")
	light.Name = "ReadyGlow"
	light.Color = READY_COLOR
	light.Range = 9
	light.Brightness = 0
	light.Parent = dome

	_views[dome] = { dome = dome, gui = gui, fill = fill, text = text, light = light }
end

local function update(view: DomeView, now: number)
	local dome = view.dome
	local eggType = dome:GetAttribute("EggType")
	local startedAt = dome:GetAttribute("StartedAt")
	local finishAt = dome:GetAttribute("FinishAt")
	if typeof(eggType) ~= "string" or eggType == "" or typeof(startedAt) ~= "number" or typeof(finishAt) ~= "number" then
		view.gui.Enabled = false
		view.light.Brightness = 0
		return
	end

	view.gui.Enabled = true
	local total = math.max(1, finishAt - startedAt)
	local left = math.max(0, finishAt - now)
	local share = math.clamp(1 - left / total, 0, 1)
	view.fill.Size = UDim2.fromScale(share, 1)
	if left <= 0 then
		view.text.Text = "✔ " .. Loc.t("ui.incubator.ready")
		view.fill.BackgroundColor3 = READY_COLOR
		-- Fertig: pulsierendes Leuchten, damit man es vom anderen Ende des Plots sieht
		view.light.Brightness = 1.5 + math.sin(os.clock() * 4) * 0.8
	else
		view.text.Text = Loc.formatDuration(math.ceil(left))
		view.fill.BackgroundColor3 = BAR_COLOR
		view.light.Brightness = if left <= IncubatorConfig.GLOW_LAST_SECONDS then 1 else 0
	end
end

--------------------------------------------------------------------------------
-- INCUBATOR_BREED: Schild ueber einem Platz mit Baerchi
--------------------------------------------------------------------------------
-- Wunsch Projektinhaber 05.10.: "Der Baerchi zeigt im Inkubator an, mit
-- welcher Wahrscheinlichkeit welches Ei gebruetet wird." Name, die Chancen
-- (nach EggTree.resolveLaid zusammengefasst — gesperrte Eier rutschen auf den
-- freien Vorgaenger, genau wie beim Server) und die Zeit bis zum naechsten Ei.

local BREED_MAX_LINES = 4

type BreedView = { dome: BasePart, gui: BillboardGui, title: TextLabel, odds: TextLabel, timer: TextLabel, key: string }
local _breedViews: { [BasePart]: BreedView } = {}

local function breedLabel(parent: Instance, name: string, y: number, h: number, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Position = UDim2.fromScale(0, y)
	label.Size = UDim2.fromScale(1, h)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Text = ""
	label.Parent = parent
	return label
end

local function attachBreedView(dome: BasePart)
	if _breedViews[dome] then return end
	local gui = Instance.new("BillboardGui")
	gui.Name        = "BreederInfo"
	gui.Size        = UDim2.fromScale(7, 5)
	gui.StudsOffset = Vector3.new(0, dome.Size.Y * 0.5 + 3.2, 0)
	gui.MaxDistance = IncubatorConfig.LOOK.signDistance
	gui.AlwaysOnTop = false
	gui.Adornee     = dome
	gui.Enabled     = false
	gui.Parent      = dome

	local title = breedLabel(gui, "Title", 0, 0.24, Color3.new(1, 1, 1))
	local odds = breedLabel(gui, "Odds", 0.25, 0.55, Color3.fromRGB(255, 240, 200))
	odds.TextYAlignment = Enum.TextYAlignment.Top
	local timer = breedLabel(gui, "Timer", 0.82, 0.18, BAR_COLOR)
	_breedViews[dome] = { dome = dome, gui = gui, title = title, odds = odds, timer = timer, key = "" }
end

local function eggName(eggType: string): string
	local def = EggConfig.data[eggType :: any]
	return Names.egg(eggType)
end

-- Chancen dieses Baerchis, nach dem tatsaechlich gebrueteten Ei zusammengefasst.
local function oddsText(baerchi: any, eggTree: any): string
	local list = EggCalculator.getResolvedChances(baerchi, eggTree)
	local lines: { string } = {}
	for i, entry in list do
		if i > BREED_MAX_LINES then break end
		local percent = if entry.percent >= 10 then string.format("%d", math.floor(entry.percent + 0.5))
			else Loc.formatDecimal(entry.percent, 1)
		table.insert(lines, string.format("%s  %s%%", eggName(entry.eggType), percent))
	end
	return table.concat(lines, "\n")
end

local function updateBreed(view: BreedView, now: number)
	local dome = view.dome
	local uid = dome:GetAttribute("BreederUid")
	local data = ClientState.get()
	local baerchi = if typeof(uid) == "string" and uid ~= "" and data then data.island.baerchis[uid] else nil
	if not baerchi or not data then
		view.gui.Enabled = false
		view.key = ""
		return
	end
	view.gui.Enabled = true

	-- Name und Chancen nur neu schreiben, wenn sich etwas daran aendert
	local unlockedCount = 0
	if data.eggTree then
		for _ in data.eggTree.unlocked do unlockedCount += 1 end
	end
	local key = table.concat({ uid :: string, baerchi.configId, tostring(baerchi.mutation), Loc.getLanguage(),
		tostring(unlockedCount) }, "|")
	if key ~= view.key then
		view.key = key
		local def = BaerchiConfig.getById(baerchi.configId)
		local name = Names.baerchi(baerchi.configId)
		view.title.Text = string.format("%s · %s", name, Loc.name("rarity." .. baerchi.rarity, baerchi.rarity))
		view.title.TextColor3 = BaerchiConfig.getRarityColor(baerchi.rarity)
		view.odds.Text = oddsText(baerchi, data.eggTree)
	end

	local unlocked = dome:GetAttribute("Unlocked")
	if unlocked == false then
		view.timer.Text = "🔒"
		return
	end
	local lying = 0
	for _, egg in data.island.laidEggs do
		if (egg :: any).fromIncubator then lying += 1 end
	end
	if lying >= IncubatorConfig.BREED_MAX_LYING then
		view.timer.Text = "🥚 " .. Loc.t("ui.incubator.breed_full")
		view.timer.TextColor3 = READY_COLOR
		return
	end
	local last = dome:GetAttribute("LastEggAt")
	local seconds = dome:GetAttribute("BreedSeconds")
	if typeof(last) == "number" and typeof(seconds) == "number" and seconds > 0 then
		local left = math.max(0, last + seconds - now)
		view.timer.Text = "🥚 " .. Loc.formatDuration(math.ceil(left))
		view.timer.TextColor3 = BAR_COLOR
	end
end

-- INCUBATOR_BREED: "Baerchi einsetzen" statt "Oeffnen"
local function actionKey(): string
	return if FeatureFlags.isOn("INCUBATOR_BREED") then "ui.incubator.prompt_breed" else "ui.incubator.prompt_action"
end

local function attachPrompt(base: BasePart)
	if base:FindFirstChild("IncubatorPrompt") then return end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "IncubatorPrompt"
	prompt.ActionText = Loc.t(actionKey())
	prompt.ObjectText = Loc.t("ui.incubator.title")
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	prompt.Triggered:Connect(function()
		PanelManager.open("Incubator")
	end)
	Loc.onChanged(function()
		prompt.ActionText = Loc.t(actionKey())
		prompt.ObjectText = Loc.t("ui.incubator.title")
	end)
end

local function hook(instance: Instance)
	if not instance:IsA("BasePart") then return end
	local model = instance.Parent
	if not model or model.Name ~= IncubatorConfig.MODEL_NAME then return end
	if not isOwnPlot(model) then return end
	if instance.Name == "Base" then
		attachPrompt(instance)
	elseif string.match(instance.Name, "^Dome_%d+$") then
		attachView(instance)
		if FeatureFlags.isOn("INCUBATOR_BREED") then
			attachBreedView(instance)
		end
	end
end

function IncubatorController.init()
	if not FeatureFlags.isOn("INCUBATOR") then return end

	for _, descendant in Workspace:GetDescendants() do
		hook(descendant)
	end
	Workspace.DescendantAdded:Connect(function(instance)
		-- Die Attribute (PlotOwner) haengen am Plot; die Teile kommen dazu.
		task.defer(hook, instance)
	end)

	task.spawn(function()
		while true do
			task.wait(TICK_SECONDS)
			local now = Workspace:GetServerTimeNow()
			for dome, view in _views do
				if dome.Parent == nil then
					_views[dome] = nil
				else
					update(view, now)
				end
			end
			for dome, view in _breedViews do
				if dome.Parent == nil then
					_breedViews[dome] = nil
				else
					local ok, err = pcall(updateBreed, view, now)
					if not ok then warn("[IncubatorController] Brut-Schild:", err) end
				end
			end
		end
	end)
end

return IncubatorController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX79"><Properties><string name="Name">ResultFeed</string><ProtectedString name="Source"><![CDATA[--!strict
-- ResultFeed.luau
-- StarterPlayerScripts/Controllers/ResultFeed.luau
--
-- Einzige Zustaendigkeit:
--   - Server-Ergebnisse die nur eine kurze Meldung brauchen in Toasts uebersetzen
--
-- Hier landen genau die Events ohne eigene Oberflaeche:
--   RecycleResultReceived  — der Baerchi ist weg, es zaehlt nur der Erloes
--   OfflineReportReceived  — einmal beim Join, wenn die Gebaeude weiterliefen
--   FeedResultReceived     — nur der Level-Up ist eine Meldung wert; die
--                            Heilung sieht man direkt am HP-Balken der Karte
--
-- Alles mit eigener Anzeige haengt bewusst NICHT hier, sondern im jeweiligen
-- Panel: Hatch-Reveal in HatchPanel, Kampf-Wiedergabe in CombatPanel,
-- Fusions-Ergebnis in FusionPanel, Rebirth-Bestaetigung in RebirthDialog.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types   = require(ReplicatedStorage.Network.Types)
local Remotes = require(ReplicatedStorage.Network.Remotes)
local Loc     = require(ReplicatedStorage.Localization.Loc)

local Toast = require(script.Parent.Parent.UI.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify        = require(script.Parent.Parent.UI.Notify)
local Feedback      = require(script.Parent.Parent.UI.Feedback)
local Moment        = require(script.Parent.Parent.UI.Moment)
local ReturnSummary = require(script.Parent.Parent.UI.ReturnSummary)
local Theme         = require(script.Parent.Parent.UI.Theme)

local ResultFeed = {}

function ResultFeed.init()
	Remotes.RecycleResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.RecycleResult

		-- Gummies fliegen ueber den Datenstand (UI/Feedback), daher kein
		-- zweiter Weg fuer den neuen Pfad.
		Notify.emit("recycle_result", function()
			-- Zahlen formatiert Loc selbst (Trenner je nach Sprache)
			if typed.goldGummiesGained > 0 then
				Toast.success(Loc.t("msg.recycled_gold", { gummies = typed.gummiesGained, gold = typed.goldGummiesGained }))
			else
				Toast.success(Loc.t("msg.recycled", { gummies = typed.gummiesGained }))
			end
		end)
	end)

	Remotes.OfflineReportReceived.OnClientEvent:Connect(function(report: any)
		if typeof(report) ~= "table" then return end
		local typed = report :: Types.OfflineReport

		-- Kein Banner wenn nichts passiert ist: der Spieler war nur kurz weg
		-- oder die Lager waren schon voll.
		if typed.secondsAway <= 0 or typed.honeyGained <= 0 then return end

		Notify.emit("offline_honey", function()
			Toast.success(Loc.t("msg.offline_honey", {
				time  = Loc.formatDuration(typed.secondsAway),
				honey = typed.honeyGained,
			}))
		end, function()
			ReturnSummary.addHoney(typed.secondsAway, typed.honeyGained)
		end)
	end)

	Remotes.FeedResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.FeedResult

		-- HBB Paket 1: die XP steigen als Zahl ueber dem Baerchi auf (der
		-- Autopilot fuettert still, dann kommt hier nur der Level-Up an).
		if (typed.xpGained or 0) > 0 then
			Notify.emit("feed", function() end, function()
				Feedback.gain("xp", typed.xpGained)
			end)
		end

		-- Jede Fuetterung als Text zu melden waere Dauerbeschuss — der HP- und
		-- der XP-Balken auf der Karte zeigen das ohnehin live. Nur der Level-Up
		-- ist ein Moment, den man nicht verpassen soll.
		if not typed.leveledUp then return end

		Notify.emit("level_up", function()
			Toast.success(Loc.t("msg.level_up", { level = typed.newLevel }))
		end, function()
			Feedback.gain("level", typed.newLevel)
		end)
	end)

	-- v14: ein Knoten im Ei-Baum ist frei geworden
	Remotes.EggTreeUnlocked.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" or typeof(result.eggType) ~= "string" then return end
		local egg = Loc.name("egg." .. result.eggType .. ".name", result.eggType)
		Notify.emit("tree_unlocked", function()
			Toast.success(Loc.t("msg.tree_unlocked", { egg = egg }))
		end, function()
			Moment.show("unlock", Theme.COLORS.growth, "ui.moment.new")
		end)
	end)

	-- v14: Ei-Presse
	Remotes.EggPressResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.EggPressResult
		-- Die Lagersumme sinkt beim Pressen (5 rein, 1 raus), die Erkennung am
		-- Datenstand sieht also keinen Gewinn: das neue Ei hier selbst zeigen.
		Notify.emit("egg_pressed", function()
			Toast.success(Loc.t("msg.pressed", {
				n    = typed.used,
				from = Loc.name("egg." .. typed.fromEgg .. ".name", typed.fromEgg),
				to   = Loc.name("egg." .. typed.toEgg .. ".name", typed.toEgg),
			}))
		end, function()
			Feedback.gain("eggs", 1)
		end)
	end)

	-- Sammel-Update 05.10. (Paket 7): Index-Belohnung abgeholt
	Remotes.IndexRewardReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" or typeof(result.rewardId) ~= "string" then return end
		local typed = result :: Types.IndexRewardResult
		local parts: { string } = {}
		if typed.eggs > 0 and typed.eggType then
			table.insert(parts, string.format("+%d %s", typed.eggs, Loc.name("egg." .. typed.eggType .. ".name", typed.eggType)))
		end
		if typed.gummies > 0 then table.insert(parts, "+" .. Loc.formatNumber(typed.gummies) .. " Gummies") end
		if typed.goldGummies > 0 then table.insert(parts, "+" .. Loc.formatNumber(typed.goldGummies) .. " GoldGummies") end
		if typed.blueprints > 0 then table.insert(parts, Loc.t("ui.index_reward.blueprint", { n = typed.blueprints })) end
		if typed.incubatorSlots > 0 then table.insert(parts, Loc.t("ui.index_reward.slot", { n = typed.incubatorSlots })) end
		Notify.emit("index_reward", function()
			Toast.success(Loc.t("msg.index_reward", { text = table.concat(parts, "  ·  ") }))
		end, function()
			Moment.show("milestone", Theme.COLORS.goldGummy, "ui.moment.milestone")
		end)
	end)

	-- Sammel-Update 05.10. (Paket 6.2): besonderer Meilenstein (Ascensions-Eier)
	Remotes.SpecialMilestoneReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" or typeof(result.id) ~= "string" then return end
		local typed = result :: Types.SpecialMilestoneResult
		local n, eggType = 0, "AscensionEgg"
		for _, entry in typed.eggs do
			n += entry.count
			eggType = entry.eggType
		end
		Notify.emit("special_milestone", function()
			Toast.success(Loc.t("msg.special_milestone", {
				name = Loc.t("milestone." .. typed.id),
				n    = n,
				egg  = Loc.name("egg." .. eggType .. ".name", eggType),
			}))
		end, function()
			Moment.show("milestone", Theme.COLORS.goldGummy, "ui.moment.milestone")
		end)
	end)

	-- Sammel-Update 05.10. (Paket 8): Inkubator — kurze Bestaetigung beim Einlegen
	Remotes.IncubatorChanged.OnClientEvent:Connect(function(info: any)
		if typeof(info) ~= "table" then return end
		if info.kind == "start" or info.kind == "speedup" or info.kind == "upgrade" then
			Notify.emit("incubator", function()
				Toast.info(Loc.t("msg.incubator." .. tostring(info.kind)))
			end)
		end
	end)

	print("[ResultFeed] Initialisiert")
end

return ResultFeed
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX80"><Properties><string name="Name">TerminalController</string><ProtectedString name="Source"><![CDATA[--!strict
-- TerminalController.luau
-- StarterPlayerScripts/Controllers/TerminalController.luau
--
-- Einzige Zustaendigkeit:
--   - Das Tower-Terminal an der Bruecke (08.10., Paket B2) lebendig machen:
--     Bildschirm (SurfaceGui, in der Sprache des Betrachters), Lampenfarbe
--     und Blinken, "!"-Marker, und am EIGENEN Terminal der Prompt
--     "Tower waehlen", der das Tower-Panel oeffnet.
--
-- Der Server baut das Terminal einmal (TerminalBuilder) und schreibt nur
-- Attribute (State, Tower, Record, NextTower, NewTower, Progress, Needed). Hier wird
-- daraus Text und Licht — ohne Neubau, ohne Emitter, ohne Light-Instanz
-- (Neon + Bloom). Eine Heartbeat-Schleife fuer das Blinken aller Terminals.
--
-- Zustaende (TowerConfig.terminalState):
--   locked  Bildschirm dunkel mit Schloss und "Tower I 12/30", Lampe rot;
--           der Prompt oeffnet nichts, sondern zeigt einen Hinweis
--   ready   Bildschirm leuchtet "NEU: Tower II!", Lampe gruen blinkend, "!"
--   normal  ruhig, zeigt den gewaehlten Tower und den Rekord

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Loc          = require(ReplicatedStorage.Localization.Loc)
local MapConfig    = require(ReplicatedStorage.Config.MapConfig)
local TowerConfig  = require(ReplicatedStorage.Config.TowerConfig)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local UI           = script.Parent.Parent:WaitForChild("UI")
local Theme        = require(UI:WaitForChild("Theme"))
local Kit          = require(UI:WaitForChild("Kit"))
local Icons        = require(UI:WaitForChild("Icons"))
local Notify       = require(UI:WaitForChild("Notify"))
local Toast        = require(UI:WaitForChild("Toast"))
local PanelManager = require(UI:WaitForChild("PanelManager"))

local TerminalController = {}

local MODEL_NAME = "TowerTerminal"
local CFG = MapConfig.TOWER_TERMINAL
local T = Kit.T

type View = {
	model   : Model,
	screen  : SurfaceGui,
	bg      : Frame,
	badgeHolder : Frame,
	lock    : GuiObject,
	title   : TextLabel,
	line    : TextLabel,
	bar     : Kit.Progress,
	lamp    : BasePart?,
	marker  : BillboardGui,
	prompt  : ProximityPrompt?,
	badgeKey: string,
}

local _views: { [Model]: View } = {}

local function isOwn(model: Model): boolean
	local plot = model.Parent
	return plot ~= nil and plot:GetAttribute("PlotOwner") == Players.LocalPlayer.UserId
end

local function attr(model: Model, name: string, default: any): any
	local value = model:GetAttribute(name)
	return if value == nil then default else value
end

local function towerName(id: string): string
	return Loc.t("tower." .. id .. ".name")
end

local function write(view: View)
	local model = view.model
	local state = attr(model, "State", "locked") :: string
	local towerId = attr(model, "Tower", "I") :: string
	local record = attr(model, "Record", 0) :: number
	local nextTower = attr(model, "NextTower", "") :: string
	local progress = attr(model, "Progress", 0) :: number
	local needed = attr(model, "Needed", 0) :: number
	local def = TowerConfig.get(towerId) or TowerConfig.TOWERS[1]

	-- Abzeichen nur neu bauen, wenn sich Tower oder Zustand aendern
	local key = state .. ":" .. def.id
	if view.badgeKey ~= key then
		view.badgeKey = key
		for _, child in view.badgeHolder:GetChildren() do child:Destroy() end
		local shown = if state == "locked" then (TowerConfig.get(nextTower) or def) else def
		local badge = Kit.towerBadge("Badge", view.badgeHolder, shown.look, shown.color, shown.numeral, 150)
		badge.Size = UDim2.fromScale(1, 1)
		badge.ZIndex = 3
	end

	view.lock.Visible = state == "locked"
	if state == "locked" then
		local prev = TowerConfig.UNLOCK_AFTER[nextTower] or TowerConfig.FIRST_TOWER
		view.title.Text = Loc.t("ui.terminal.screen_locked")
		view.title.TextColor3 = Color3.fromRGB(255, 120, 120)
		view.line.Text = Loc.t("ui.terminal.screen_unlock_by", { tower = towerName(prev) })
		view.bar.track.Visible = true
		view.bar.set(if needed > 0 then progress / needed else 0, string.format("%d/%d", progress, needed))
		view.bg.BackgroundColor3 = Color3.fromRGB(28, 22, 36)
	elseif state == "ready" then
		local newId = attr(model, "NewTower", towerId) :: string
		view.title.Text = Loc.t("ui.terminal.screen_new", { tower = towerName(newId) })
		view.title.TextColor3 = Color3.fromRGB(140, 255, 150)
		view.line.Text = Loc.t("ui.terminal.prompt_action")
		view.bar.track.Visible = false
		view.bg.BackgroundColor3 = Theme.shade(def.color, -0.55)
	else
		view.title.Text = towerName(def.id)
		view.title.TextColor3 = T.color.white
		view.line.Text = if def.id == "Endless"
			then Loc.t("ui.tower2.record_endless", { record = record })
			else Loc.t("ui.tower2.record", { record = record, stages = def.stages })
		view.bar.track.Visible = def.id ~= "Endless"
		view.bar.set(record / math.max(1, def.stages), "")
		view.bg.BackgroundColor3 = Theme.shade(def.color, -0.6)
	end

	view.marker.Enabled = state == "ready" and isOwn(model)

	local prompt = view.prompt
	if prompt then
		if state == "locked" then
			local prev = TowerConfig.UNLOCK_AFTER[nextTower] or TowerConfig.FIRST_TOWER
			prompt.ActionText = Loc.t("ui.terminal.prompt_locked", { tower = towerName(prev), have = progress, need = needed })
		else
			prompt.ActionText = Loc.t("ui.terminal.prompt_action")
		end
		prompt.ObjectText = Loc.t("ui.terminal.prompt_object")
	end
end

local function buildScreen(model: Model): View?
	local screenPart = model:FindFirstChild(CFG.screenPart)
	if not screenPart or not screenPart:IsA("BasePart") then return nil end

	local gui = Instance.new("SurfaceGui")
	gui.Name = "TerminalScreen"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = CFG.screenPixels
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.MaxDistance = 120
	gui.Adornee = screenPart
	gui.Parent = screenPart

	local bg = Kit.frame("Bg", gui, Color3.fromRGB(28, 22, 36))
	bg.Size = UDim2.fromScale(1, 1)
	local glow = Instance.new("UIGradient")
	glow.Rotation = 90
	glow.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150))
	glow.Parent = bg

	local badgeHolder = Kit.frame("BadgeHolder", bg)
	badgeHolder.AnchorPoint = Vector2.new(0, 0.5)
	badgeHolder.Position = UDim2.new(0, 24, 0.5, 0)
	badgeHolder.Size = UDim2.fromOffset(150, 150)

	local lock = Icons.make(badgeHolder, "lock", "🔒")
	lock.AnchorPoint = Vector2.new(0.5, 0.5)
	lock.Position = UDim2.fromScale(0.5, 0.5)
	lock.Size = UDim2.fromOffset(110, 110)
	lock.ZIndex = 8

	local title = Kit.text("Title", bg, "", 48, { color = T.color.white, stroke = 4, min = 24 })
	title.Position = UDim2.fromOffset(196, 30)
	title.Size = UDim2.new(1, -212, 0, 60)
	local line = Kit.text("Line", bg, "", 32, { color = Color3.fromRGB(240, 230, 210), stroke = 3, min = 20 })
	line.Position = UDim2.fromOffset(196, 96)
	line.Size = UDim2.new(1, -212, 0, 44)
	local bar = Kit.progress("Bar", bg, 36, T.color.honey)
	bar.track.Position = UDim2.fromOffset(196, 156)
	bar.track.Size = UDim2.new(1, -212, 0, 36)

	-- "!" ueber dem Terminal (nur am eigenen, im Zustand "ready")
	local marker = Instance.new("BillboardGui")
	marker.Name = "TerminalMarker"
	marker.Size = UDim2.fromOffset(64, 64)
	marker.StudsOffsetWorldSpace = Vector3.new(0, CFG.markerHeight, 0)
	marker.AlwaysOnTop = true
	marker.LightInfluence = 0
	marker.MaxDistance = 180
	marker.Enabled = false
	marker.Adornee = model.PrimaryPart or screenPart
	marker.Parent = screenPart
	local bang = Kit.text("Bang", marker, "!", 56, { color = Color3.fromRGB(255, 230, 80), stroke = 4, align = Enum.TextXAlignment.Center })
	bang.Size = UDim2.fromScale(1, 1)

	local lamp = model:FindFirstChild(CFG.lampPart)
	local view: View = {
		model = model, screen = gui, bg = bg, badgeHolder = badgeHolder, lock = lock,
		title = title, line = line, bar = bar,
		lamp = if lamp and lamp:IsA("BasePart") then lamp else nil,
		marker = marker, prompt = nil, badgeKey = "",
	}

	if isOwn(model) then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "TerminalPrompt"
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0   -- Paket G: ein Druck genuegt
		prompt.MaxActivationDistance = CFG.promptDistance
		prompt.RequiresLineOfSight = false
		prompt.Parent = screenPart
		prompt.Triggered:Connect(function()
			if attr(model, "State", "locked") == "locked" then
				local nextTower = attr(model, "NextTower", "II") :: string
				local prev = TowerConfig.UNLOCK_AFTER[nextTower] or TowerConfig.FIRST_TOWER
				local needed = attr(model, "Needed", 0)
				Notify.emit("terminal_locked", function()
					Toast.info(Loc.t("msg.terminal_locked", { tower = towerName(prev), need = needed }))
				end)
				return
			end
			Kit.playSound("click")
			PanelManager.open(PanelManager.ARENA_PANEL)
		end)
		view.prompt = prompt
	end

	model.AttributeChanged:Connect(function()
		write(view)
	end)
	model.Destroying:Connect(function()
		_views[model] = nil
	end)
	write(view)
	return view
end

local function hook(instance: Instance)
	if not instance:IsA("Model") or instance.Name ~= MODEL_NAME then return end
	if _views[instance] then return end
	-- Teile kommen evtl. nach dem Model an; einen Frame warten
	task.defer(function()
		if not instance.Parent or _views[instance] then return end
		if not instance:FindFirstChild(CFG.screenPart) then
			instance:WaitForChild(CFG.screenPart, 5)
		end
		local view = buildScreen(instance)
		if view then _views[instance] = view end
	end)
end

-- Lampe: Farbe nach Zustand, "ready" blinkt (eine Schleife fuer alle)
local function blink()
	local on = (os.clock() % (CFG.blinkSeconds * 2)) < CFG.blinkSeconds
	for model, view in _views do
		local lamp = view.lamp
		if lamp then
			local state = attr(model, "State", "locked") :: string
			local color = CFG.lampColors[state] or CFG.lampColors.normal
			if state == "ready" then
				lamp.Color = if on then color else Theme.shade(color, -0.6)
			else
				lamp.Color = color
			end
		end
		if view.marker.Enabled then
			view.marker.StudsOffsetWorldSpace = Vector3.new(0, CFG.markerHeight + math.sin(os.clock() * 4) * 0.4, 0)
		end
	end
end

-- Fuer die Fuehrung: der Bildschirm des eigenen Terminals.
function TerminalController.getOwnScreen(): BasePart?
	for model in _views do
		if isOwn(model) then
			local part = model:FindFirstChild(CFG.screenPart)
			if part and part:IsA("BasePart") then return part end
		end
	end
	return nil
end

function TerminalController.init()
	if not FeatureFlags.isOn("TOWER_TERMINAL") then return end
	for _, descendant in Workspace:GetDescendants() do
		hook(descendant)
	end
	Workspace.DescendantAdded:Connect(hook)
	Loc.onChanged(function()
		for _, view in _views do write(view) end
	end)
	RunService.Heartbeat:Connect(blink)
	print("[TerminalController] Initialisiert")
end

return TerminalController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX81"><Properties><string name="Name">WorldController</string><ProtectedString name="Source"><![CDATA[--!strict
-- WorldController.luau
-- StarterPlayerScripts/Controllers/WorldController.luau
--
-- Einzige Zustaendigkeit:
--   - Klicks und Naeherungs-Prompts an Objekten in der Welt in UI-Aktionen
--     uebersetzen
--
-- Es gibt drei Anker in der Welt:
--   1. Baerchi-Figuren (Attribut "BaerchiUid" an Koerper und Kopf)
--      → Detailkarte, ueber einen ClickDetector den der Server schon mitbaut
--   2. Gebaeude-Parts (Name = BuildingId, Attribute "BuildingLevel"/"HoneyPool")
--      → ein hier erzeugter ProximityPrompt (E) oeffnet das Gebaeude-Panel
--   3. Die Kampf-Plattform ("FightFloor" im Model "PitPlatform")
--      → v15: Tower-Wahl (CombatPanel), ueber einen hier erzeugten ProximityPrompt
--   4. v15: FREMDE Spieler (Charakter) und fremde Plot-Schilder
--      → Profilkarte (Inspektor, ProfilePanel), per Klick
--
-- Gelegte Eier sind ABSICHTLICH kein vierter Anker mehr: sie werden nicht
-- mehr angeklickt, sondern serverseitig per Touched eingesammelt, sobald die
-- eigene Spielfigur hindurchlaeuft (siehe MapService.buildLaidEgg). Dieser
-- Controller muss sie deshalb nicht mehr kennen — es gibt am Ei keinen
-- ClickDetector mehr, an den er sich haengen koennte.
--
-- Das Fuettern selbst ist seit dem Equip-/Honig-Teich-System keine manuelle
-- Aktion mehr: der ausgeruestete Baerchi laeuft von alleine zum Teich auf dem
-- Plot, sobald er Honig braucht (siehe BaerchiAutopilotService). Den
-- frueheren "Honig fuettern (E)"-Prompt am Gebaeude gibt es deshalb nicht
-- mehr — er waere jetzt ohnehin nur noch fuer den einen sichtbaren Baerchi
-- relevant gewesen.
--
-- Die Prompts entstehen bewusst auf dem Client: der Server braucht sie nicht
-- zu kennen, weil sie nur ein lokales Fenster oeffnen.
--
-- Besitzer-Pruefung: MapService schreibt das Attribut "PlotOwner" (UserId) an
-- jedes Plot-Model. Prompts entstehen nur am EIGENEN Plot. Vorher erschienen
-- sie auch an fremden Gebaeuden — ungefaehrlich, weil RequestUpgradeBuilding
-- und RequestStartCombat kein Insel-Argument haben und der Server immer auf
-- den Daten des anfragenden Spielers arbeitet, aber irrefuehrend: man haette
-- am Nachbar-Gebaeude sein eigenes ausgebaut.
--
-- Die Zuordnung der Baerchis laeuft ueber das Attribut "BaerchiUid", das
-- MapService an die Koerper-Part schreibt. Der Client braucht dafuer kein
-- eigenes Remote: er hat die vollstaendigen Baerchi-Daten bereits ueber
-- PlayerDataUpdated.
--
-- Ausserdem markiert dieser Controller den EIGENEN Plot mit einem Wegweiser
-- ueber dem Schild. Das gehoert bewusst hierher und nicht zu MapService: der
-- Server baut fuer alle dasselbe, aber "dein Plot" ist fuer jeden ein anderer.
-- Serverseitig muesste man dafuer acht verschiedene Schilder bauen — hier ist
-- es ein einziges Element, das nur der Besitzer sieht.

local Players   = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Loc          = require(ReplicatedStorage.Localization.Loc)
local Remotes      = require(ReplicatedStorage.Network.Remotes)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)

local FeedbackConfig = require(ReplicatedStorage.Config.FeedbackConfig)

local Theme        = require(script.Parent.Parent.UI.Theme)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local BaerchiPanel = require(script.Parent.Parent.UI.BaerchiPanel)
local PanelManager = require(script.Parent.Parent.UI.PanelManager)

local WorldController = {}

local UID_ATTRIBUTE   = "BaerchiUid"
local LEVEL_ATTRIBUTE = "BuildingLevel"
local OWNER_ATTRIBUTE = "PlotOwner"
local PROMPT_DISTANCE = 14

-- v15 Inspektor: Klick auf fremde Spieler oder fremde Plot-Schilder oeffnet
-- die Profilkarte. Der ClickDetector entsteht nur lokal und heisst "Inspect",
-- damit hookClickable ihn nicht fuer eine Baerchi-Figur haelt.
local INSPECT_NAME     = "Inspect"
local INSPECT_DISTANCE = 60

-- Wegweiser auf den eigenen Plot. Die Plattform ist 480 Studs breit und
-- ueberall gleich gruen; ohne diese Marke sucht man beim ersten Join acht
-- Schilder ab, um das eigene zu finden. Reichweite deshalb so gross, dass sie
-- vom Spawn in der Mitte aus zu sehen ist (Plot-Ring: 165 Studs).
local HOME_MARKER_NAME     = "DeinPlot"
local HOME_MARKER_DISTANCE = 260
local HOME_MARKER_HEIGHT   = 7

-- Gebaeude-Part-Namen wie MapService sie vergibt (= Types.BuildingId)
local BUILDING_NAMES: { [string]: boolean } = {
	Beehive      = true,
	HoneyRefiner = true,
	HoneyPond    = true,
}

-- Bereits verbundene ClickDetectors, damit nichts doppelt haengt
local _connected: { [ClickDetector]: boolean } = {}

--------------------------------------------------------------------------------
-- Baerchi-Figuren
--------------------------------------------------------------------------------

-- Ein ClickDetector in der Welt gehoert einer Baerchi-Figur — Eier haben seit
-- dem Umstieg auf Beruehren-zum-Einsammeln keinen ClickDetector mehr (siehe
-- Kommentar-Kopf).
local function findTarget(detector: ClickDetector): string?
	local part = detector.Parent
	if not part then return nil end

	local baerchiUid = part:GetAttribute(UID_ATTRIBUTE)
	if typeof(baerchiUid) == "string" then
		return baerchiUid
	end

	return nil
end

local function tryHook(detector: ClickDetector): boolean
	if _connected[detector] then return true end

	if findTarget(detector) == nil then return false end

	_connected[detector] = true

	detector.MouseClick:Connect(function()
		-- Beim Klick NEU nachschlagen statt den Wert von oben zu benutzen: die
		-- Part kann inzwischen eine andere uid tragen (Figuren werden bei jedem
		-- Plot-Neuaufbau ersetzt).
		local current = findTarget(detector)
		if not current then return end

		BaerchiPanel.show(current)
	end)

	detector.Destroying:Connect(function()
		_connected[detector] = nil
	end)

	return true
end

local function hookClickable(instance: Instance)
	if not instance:IsA("ClickDetector") then return end
	if instance.Name == INSPECT_NAME then return end
	if tryHook(instance) then return end

	-- Replikation ist nicht sortiert: der ClickDetector kann beim Client
	-- ankommen bevor das Attribut seiner Part da ist. Deshalb einmal im
	-- naechsten Frame erneut versuchen und sonst auf eines der beiden Attribute
	-- warten — welches kommt, weiss man vorher nicht.
	task.defer(function()
		if tryHook(instance) then return end

		local part = instance.Parent
		if not part then return end

		local connection: RBXScriptConnection? = nil
		connection = part:GetAttributeChangedSignal(UID_ATTRIBUTE):Connect(function()
			if tryHook(instance) and connection then
				connection:Disconnect()
			end
		end)
	end)
end

--------------------------------------------------------------------------------
-- Gebaeude und Kampfplattform
--------------------------------------------------------------------------------

-- Beschriftung eines Prompts: liefert (ActionText, ObjectText) in der
-- aktiven Sprache. Als Funktion statt fertiger Texte, damit ein Sprachwechsel
-- alle Prompts neu beschriften kann (siehe Loc.onChanged in init).
type PromptLabels = () -> (string, string)

-- Weak: ein ersetzter Plot nimmt seine Prompts mit, ohne dass sie hier haengen bleiben.
local _promptLabels: { [ProximityPrompt]: PromptLabels } = setmetatable({}, { __mode = "k" }) :: any

local function applyPromptLabels(prompt: ProximityPrompt, labels: PromptLabels)
	local action, object = labels()
	prompt.ActionText = action
	prompt.ObjectText = object
end

-- Ein Prompt an einer Part. `name` dient als Schutz gegen doppeltes Anhaengen:
-- die Parts werden bei jedem Plot-Neuaufbau ersetzt, und ein zweiter Prompt
-- waere ein doppeltes Fenster.
local function addPrompt(
	part: BasePart,
	name: string,
	labels: PromptLabels,
	keyCode: Enum.KeyCode,
	onTriggered: () -> ()
): ProximityPrompt?
	if part:FindFirstChild(name) then return nil end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = name
	applyPromptLabels(prompt, labels)
	_promptLabels[prompt] = labels
	prompt.KeyboardKeyCode       = keyCode
	prompt.MaxActivationDistance = PROMPT_DISTANCE
	prompt.RequiresLineOfSight   = false
	prompt.Parent                = part

	prompt.Triggered:Connect(onTriggered)
	return prompt
end

local function addPanelPrompt(part: BasePart, labels: PromptLabels, panelName: string)
	addPrompt(part, "OpenPanel", labels, Enum.KeyCode.E, function()
		PanelManager.open(panelName)
	end)
end

--------------------------------------------------------------------------------
-- HUD_ROW_V2: Honig-Brunnen ohne Fenster
--------------------------------------------------------------------------------
-- Wunsch Projektinhaber 05.10.: Am Brunnen ploppt nichts mehr auf. E baut
-- direkt aus, und ueber dem Brunnen steht nur ein Schild mit Level und Preis
-- des naechsten Ausbaus. Verbessern geht nur noch vor Ort (keine Kachel
-- mehr). Der Server prueft wie immer selbst (IslandService).
--
-- 08.10. (Paket G): EIN Druck auf E (Antippen am Handy) statt Halten. Gegen
-- Doppelkauf sperrt sich der Prompt danach kurz (FeedbackConfig.UPGRADE_FX.
-- PROMPT_LOCK); der Server bleibt massgeblich (Kosten, Level-Cap,
-- RateLimiter). Den Erfolgs-Effekt zeigt UI/UpgradeFX, sobald der Server den
-- Ausbau gebucht hat.

local POND_SIGN_NAME   = "PondLevelSign"
local POND_PROMPT_HOLD = 0
local POND_SIGN_HEIGHT = 9
local POND_SIGN_DISTANCE = 90

type PondView = { part: BasePart, prompt: ProximityPrompt, level: TextLabel, cost: TextLabel, lastLevel: number, locked: boolean }
local _ponds: { PondView } = {}

local function pondState(buildingId: string): (number, any?)
	local data = ClientState.get()
	local building = if data then data.island.buildings[buildingId :: any] else nil
	local level = if building then building.level else 1
	return level, BuildingBehavior.getUpgrade(buildingId :: any, level + 1)
end

local function costText(cost: any): string
	local gummies = Theme.formatNumber(cost.costGummies or 0)
	local gold = cost.costGoldGummies or 0
	return if gold > 0
		then Loc.t("ui.recycler.cost_gg", { gummies = gummies, gold = gold })
		else Loc.t("ui.recycler.cost_g", { gummies = gummies })
end

local function writePond(view: PondView)
	local buildingId = view.part.Name
	local level, cost = pondState(buildingId)
	view.level.Text = "Lv. " .. level
	local data = ClientState.get()
	if cost then
		local affordable = data ~= nil and data.gummies >= (cost.costGummies or 0)
			and data.goldGummies >= (cost.costGoldGummies or 0)
		view.cost.Text = "⬆ " .. costText(cost)
		view.cost.TextColor3 = if affordable then Theme.COLORS.good else Theme.COLORS.text
		-- Preis steht im Prompt; reicht es nicht, steht dort, wie viel fehlt
		-- (der Standard-Prompt laesst sich nicht ausgrauen). Druecken geht
		-- trotzdem: der Server lehnt mit der bekannten Meldung ab.
		view.prompt.ActionText = if affordable
			then Loc.t("ui.upgrade.prompt_buy", { cost = Theme.formatNumber(cost.costGummies or 0) })
			else Loc.t("ui.upgrade.prompt_need", { missing = Theme.formatNumber(math.max(0, (cost.costGummies or 0) - (if data then data.gummies else 0))) })
		if not view.locked then
			view.prompt.Enabled = true
		end
	else
		view.cost.Text = Loc.t("ui.recycler.maxed")
		view.cost.TextColor3 = Theme.COLORS.goldGummy
		view.prompt.Enabled = false
	end
	view.prompt.ObjectText = Loc.name("building." .. buildingId .. ".name", buildingId) .. "  Lv." .. level

	-- Kleiner Huepfer am Schild, wenn das Level steigt (statt eines Fensters)
	if level > view.lastLevel and view.lastLevel > 0 then
		local gui = view.level.Parent
		if gui and gui:IsA("BillboardGui") then
			local base = gui.Size
			gui.Size = UDim2.new(base.X.Scale * 1.25, 0, base.Y.Scale * 1.25, 0)
			task.delay(0.25, function()
				if gui.Parent then gui.Size = base end
			end)
		end
	end
	view.lastLevel = level
end

local function attachPond(part: BasePart)
	if part:FindFirstChild(POND_SIGN_NAME) then return end

	local gui = Instance.new("BillboardGui")
	gui.Name        = POND_SIGN_NAME
	gui.Size        = UDim2.fromScale(12, 4)
	gui.StudsOffset = Vector3.new(0, POND_SIGN_HEIGHT, 0)
	gui.MaxDistance = POND_SIGN_DISTANCE
	gui.AlwaysOnTop = false
	gui.Adornee     = part
	gui.Parent      = part

	local level = Instance.new("TextLabel")
	level.Name                   = "Level"
	level.Size                   = UDim2.fromScale(1, 0.58)
	level.BackgroundTransparency = 1
	level.Font                   = Theme.FONT
	level.TextScaled             = true
	level.TextColor3             = Theme.COLORS.goldGummy
	level.TextStrokeTransparency = 0.1
	level.Parent                 = gui

	local cost = Instance.new("TextLabel")
	cost.Name                   = "Cost"
	cost.Position               = UDim2.fromScale(0, 0.6)
	cost.Size                   = UDim2.fromScale(1, 0.4)
	cost.BackgroundTransparency = 1
	cost.Font                   = Theme.FONT
	cost.TextScaled             = true
	cost.TextStrokeTransparency = 0.1
	cost.Parent                 = gui

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = "OpenPanel"   -- gleicher Name: kein zweiter Prompt
	prompt.KeyboardKeyCode       = Enum.KeyCode.E
	prompt.HoldDuration          = POND_PROMPT_HOLD
	prompt.MaxActivationDistance = PROMPT_DISTANCE
	prompt.RequiresLineOfSight   = false
	prompt.Parent                = part
	local buildingId = part.Name
	local view: PondView = { part = part, prompt = prompt, level = level, cost = cost, lastLevel = 0, locked = false }
	prompt.Triggered:Connect(function()
		if view.locked then return end
		view.locked = true
		prompt.Enabled = false
		Remotes.RequestUpgradeBuilding:FireServer(buildingId)
		task.delay(FeedbackConfig.UPGRADE_FX.PROMPT_LOCK, function()
			view.locked = false
			if prompt.Parent then writePond(view) end
		end)
	end)

	table.insert(_ponds, view)
	part.Destroying:Connect(function()
		local index = table.find(_ponds, view)
		if index then table.remove(_ponds, index) end
	end)
	writePond(view)
end

local function refreshPonds()
	for _, view in _ponds do
		writePond(view)
	end
end

local function usesPondSign(buildingId: string): boolean
	return FeatureFlags.isOn("HUD_ROW_V2") and buildingId == "HoneyPond"
end

--------------------------------------------------------------------------------
-- Wem gehoert der Plot, in dem dieses Teil steckt?
--
-- MapService setzt das Attribut am Plot-Model, nicht an jedem Teil — also
-- nach oben laufen bis es gefunden wird. Teile ausserhalb eines Plots (die
-- Plattform selbst, Blumen) haben keinen Besitzer und liefern nil.
local function findPlotOwner(instance: Instance): number?
	local current: Instance? = instance

	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner
		end
		current = current.Parent
	end

	return nil
end

local function isOwnPlot(instance: Instance): boolean
	return findPlotOwner(instance) == Players.LocalPlayer.UserId
end

-- Der Wegweiser ueber dem eigenen Plot-Schild.
--
-- Rein lokal erzeugt: er landet nie beim Server und damit auch nie bei den
-- anderen sieben Spielern, die ja alle ihren eigenen sehen sollen. Beim
-- Neuaufbau des Plots verschwindet er mit dem Schild und wird von
-- DescendantAdded wieder angelegt — deshalb die Pruefung auf ein bereits
-- vorhandenes Exemplar.
local function addHomeMarker(board: BasePart)
	if board:FindFirstChild(HOME_MARKER_NAME) then return end

	local marker = Instance.new("BillboardGui")
	marker.Name        = HOME_MARKER_NAME
	marker.Size        = UDim2.fromScale(14, 4)
	marker.StudsOffset = Vector3.new(0, HOME_MARKER_HEIGHT, 0)
	marker.MaxDistance = HOME_MARKER_DISTANCE
	-- Durch die Landschaft hindurch sichtbar: genau dafuer ist er da. Vom
	-- Spawn aus liegt zwischen Spieler und Schild sonst der halbe Plot.
	marker.AlwaysOnTop = true
	marker.Adornee     = board
	marker.Parent      = board

	local label = Instance.new("TextLabel")
	label.Name                   = "Text"
	label.Size                   = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font                   = Theme.FONT
	label.TextScaled             = true
	label.Text                   = "\u{25BC} " .. Loc.t("ui.world.your_plot")
	label.TextColor3             = Theme.COLORS.goldGummy
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
	label.Parent                 = marker
end

--------------------------------------------------------------------------------
-- Inspektor (v15)
--------------------------------------------------------------------------------

-- Haengt einen lokalen ClickDetector an `parent` (Part oder Model), der die
-- Profilkarte von `userId` oeffnet. Der Server prueft selbst, ob der Spieler
-- auf diesem Server ist (ProfileService); hier geht es nur ums Oeffnen.
local function addInspector(parent: Instance, userId: number)
	if parent:FindFirstChild(INSPECT_NAME) then return end
	if userId == Players.LocalPlayer.UserId then return end

	local detector = Instance.new("ClickDetector")
	detector.Name                  = INSPECT_NAME
	detector.MaxActivationDistance = INSPECT_DISTANCE
	detector.Parent                = parent

	detector.MouseClick:Connect(function()
		-- Am Schild beim Klick neu nachschlagen: ein Plot kann inzwischen einem
		-- anderen Spieler gehoeren.
		local target = if parent:IsA("BasePart") then (findPlotOwner(parent) or userId) else userId
		if target == Players.LocalPlayer.UserId then return end
		PanelManager.open("Profile", target)
	end)
end

local function hookCharacter(other: Player, character: Model)
	addInspector(character, other.UserId)
end

local function hookPlayer(other: Player)
	if other == Players.LocalPlayer then return end
	if other.Character then
		hookCharacter(other, other.Character)
	end
	other.CharacterAdded:Connect(function(character)
		hookCharacter(other, character)
	end)
end

local function hookOwnedPart(instance: BasePart)
	if instance.Name == "SignBoard" then
		addHomeMarker(instance)
		return
	end

	if instance.Name == "FightFloor" then
		addPanelPrompt(instance, function()
			return Loc.t("ui.tower.prompt_action"), Loc.t("ui.tower.prompt_object")
		end, PanelManager.ARENA_PANEL)
		return
	end

	if not BUILDING_NAMES[instance.Name] then return end

	-- Fuettern passiert nicht mehr hier (siehe Kommentar-Kopf) — es bleibt nur
	-- noch das Ausbauen.
	--
	-- Jedes Gebaeude hat sein EIGENES Menue (siehe BuildingPanel), und der
	-- Prompt oeffnet genau dieses — nicht mehr eine Liste, in der man das
	-- angeklickte Gebaeude erst suchen muss.
	--
	-- Dasselbe Menue haengt auch an der Kachelleiste rechts. Der Prompt hier ist
	-- also nur noch die Abkuerzung fuer den, der ohnehin davorsteht; gehen MUSS
	-- niemand mehr.
	local buildingId = instance.Name

	-- Sammel-Update 2.6: am Honig-Teich gibt es kein Schild und kein
	-- "Honig essen"-Klicken mehr (der Baerchi isst selbst). Der Prompt hier
	-- ist nur noch "Verbessern" — dazu die Gebaeude-Kachel rechts (MenuBar).

	local function attach()
		if usesPondSign(buildingId) then
			attachPond(instance)
			return
		end
		addPrompt(instance, "OpenPanel", function()
			return Loc.t("ui.building.prompt_upgrade"), Loc.name("building." .. buildingId .. ".name", buildingId)
		end, Enum.KeyCode.E, function()
			PanelManager.open(PanelManager.buildingPanelName(buildingId))
		end)
	end

	-- Das Level-Attribut setzt MapService erst NACH dem Einhaengen der Part.
	-- Beim Client kann die Part deshalb kurz ohne Attribut ankommen —
	-- dann einmal warten statt das Gebaeude zu verpassen.
	if instance:GetAttribute(LEVEL_ATTRIBUTE) ~= nil then
		attach()
		return
	end

	local connection: RBXScriptConnection? = nil
	connection = instance:GetAttributeChangedSignal(LEVEL_ATTRIBUTE):Connect(function()
		attach()
		if connection then
			connection:Disconnect()
		end
	end)
end

local function hookWorldPart(instance: Instance)
	if not instance:IsA("BasePart") then return end

	-- Nur die eigenen Gebaeude und das eigene PIT bekommen einen Prompt.
	-- Vorher erschien er an jedem fremden Plot, was schon deshalb verwirrend
	-- war weil der Server die Anfrage ohnehin immer auf die Daten des
	-- ANFRAGENDEN Spielers anwendet — man haette also am Nachbar-Gebaeude
	-- sein eigenes ausgebaut.
	if isOwnPlot(instance) then
		hookOwnedPart(instance)
		return
	end

	-- v15: fremdes Plot-Schild → Profilkarte des Besitzers
	if instance.Name == "SignBoard" then
		local owner = findPlotOwner(instance)
		if owner then
			addInspector(instance, owner)
			return
		end
	end

	-- Besitzer noch unbekannt: das kann passieren wenn das Teil beim Client
	-- ankommt bevor sein Plot-Model komplett da ist. Einmal im naechsten
	-- Frame erneut versuchen, statt den Prompt fuer immer zu verlieren.
	if findPlotOwner(instance) == nil then
		task.defer(function()
			if not instance.Parent then return end
			if isOwnPlot(instance) then
				hookOwnedPart(instance)
			elseif instance.Name == "SignBoard" then
				local owner = findPlotOwner(instance)
				if owner then addInspector(instance, owner) end
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

local function hook(instance: Instance)
	hookClickable(instance)
	hookWorldPart(instance)
end

function WorldController.init()
	-- Sprachwechsel: alle noch lebenden Prompts neu beschriften
	Loc.onChanged(function()
		for prompt, labels in _promptLabels do
			if prompt.Parent then applyPromptLabels(prompt, labels) end
		end
	end)

	-- Was schon da ist
	for _, descendant in Workspace:GetDescendants() do
		hook(descendant)
	end

	-- Und alles was der Server noch nachliefert. Die Figuren werden bei jeder
	-- Bestandsaenderung neu gebaut, also passiert das staendig.
	Workspace.DescendantAdded:Connect(hook)

	-- v15 Inspektor: fremde Spielfiguren anklickbar machen
	for _, other in Players:GetPlayers() do
		hookPlayer(other)
	end
	Players.PlayerAdded:Connect(hookPlayer)

	-- HUD_ROW_V2: Brunnen-Schild mit Level und Preis aktuell halten
	ClientState.onChanged(refreshPonds)
	Loc.onChanged(refreshPonds)

	print("[WorldController] Initialisiert")
end

return WorldController
]]></ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX83"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!strict
-- Main.client.luau
-- StarterPlayerScripts/Main.client.luau
--
-- Bootstrap des Clients — das Gegenstueck zu GameManager auf dem Server.
-- Einzige Stelle die die Startreihenfolge der Client-Module kennt.
--
-- ACHTUNG beim Umbenennen: die Datei darf NICHT "init.client.luau" heissen.
-- Rojo macht aus einem Ordner mit init-Datei ein Script statt eines
-- Containers — auf StarterPlayerScripts angewandt heisst das, dass der
-- gesamte Client-Teilbaum nie im Spiel ankommt. Genau das hat den
-- Server-Sync schon einmal lahmgelegt.
--
-- Reihenfolge:
--   1. ScreenGui anlegen — alle UI-Module haengen sich dort ein.
--   2. Toast zuerst, damit fruehe Fehlermeldungen schon sichtbar sind.
--   3. ClientState VOR den datengetriebenen UIs: die registrieren sich per
--      onChanged und bekommen den aktuellen Stand sofort nachgereicht.
--   4. Die Panels. Jedes meldet sich in seinem init beim PanelManager an —
--      erst danach duerfen Module laufen die Panels oeffnen wollen.
--   5. Hud und MenuBar: beide sind reine Ausloeser und brauchen die
--      angemeldeten Panels (Rebirth-Pille, Menue-Knoepfe).
--   6. ResultFeed — Toast-Meldungen fuer Recycling und Offline-Ertrag.
--      Muss vor dem ersten Serverpaket stehen, sonst geht der Offline-Report
--      des Joins verloren.
--   7. WorldController zuletzt — er braucht Panel und PanelManager.
--   8. EggTimerController — unabhaengig von allen anderen, braucht nur
--      ClientState (schon initialisiert) und die Figuren in der Welt.
--   9. SkillFXController (v14) — hoert nur auf Remotes.SkillFXPlay.
--
-- Davor, ganz am Anfang: LanguageController. Er legt die Sprache fest, bevor
-- irgendein Text gebaut wird (er braucht ClientState erst, wenn es dort
-- Daten gibt — onChanged meldet den aktuellen Stand sofort nach).

local Players = game:GetService("Players")

local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local root = script.Parent

local Controllers = root:WaitForChild("Controllers")
local UI          = root:WaitForChild("UI")

local ClientState        = require(Controllers:WaitForChild("ClientState"))
local LanguageController = require(Controllers:WaitForChild("LanguageController"))
local ResultFeed         = require(Controllers:WaitForChild("ResultFeed"))
local WorldController    = require(Controllers:WaitForChild("WorldController"))
local EggTimerController = require(Controllers:WaitForChild("EggTimerController"))
local SkillFXController  = require(Controllers:WaitForChild("SkillFXController"))
local CombController     = require(Controllers:WaitForChild("CombController"))
local AmbienceController = require(Controllers:WaitForChild("AmbienceController"))
local EventFXController  = require(Controllers:WaitForChild("EventFXController"))
local LaidEggMeshController = require(Controllers:WaitForChild("LaidEggMeshController"))
local UiEventLogger      = require(Controllers:WaitForChild("UiEventLogger"))
local GuideController    = require(Controllers:WaitForChild("GuideController"))
local UpgradeHintController = require(Controllers:WaitForChild("UpgradeHintController"))
local IncubatorController   = require(Controllers:WaitForChild("IncubatorController"))   -- Sammel-Update 8
local AreaSignController    = require(Controllers:WaitForChild("AreaSignController"))    -- Sammel-Update 3.8
local TerminalController    = require(Controllers:WaitForChild("TerminalController"))    -- 08.10. Tower-Terminal

local Toast            = require(UI:WaitForChild("Toast"))
local UiScale          = require(UI:WaitForChild("UiScale"))
local ShopPanel        = require(UI:WaitForChild("ShopPanel"))
local Hud              = require(UI:WaitForChild("Hud"))
local MenuBar          = require(UI:WaitForChild("MenuBar"))
local BaerchiPanel     = require(UI:WaitForChild("BaerchiPanel"))
local BaerchiInventory = require(UI:WaitForChild("BaerchiInventory"))
local HatchPanel       = require(UI:WaitForChild("HatchPanel"))
local CombatPanel      = require(UI:WaitForChild("CombatPanel"))
local TowerPanel       = require(UI:WaitForChild("TowerPanel"))     -- 08.10. Paket D
local BuildingPanel    = require(UI:WaitForChild("BuildingPanel"))
local FusionPanel      = require(UI:WaitForChild("FusionPanel"))
local CharmPanel       = require(UI:WaitForChild("CharmPanel"))
local RebirthDialog    = require(UI:WaitForChild("RebirthDialog"))
local LanguagePanel    = require(UI:WaitForChild("LanguagePanel"))
local PetBar           = require(UI:WaitForChild("PetBar"))
local QuestPanel       = require(UI:WaitForChild("QuestPanel"))
local QuestTracker     = require(UI:WaitForChild("QuestTracker"))
local HudRow           = require(UI:WaitForChild("HudRow"))
local EggTreePanel     = require(UI:WaitForChild("EggTreePanel"))
local LeaderboardPanel = require(UI:WaitForChild("LeaderboardPanel"))
local ProfilePanel     = require(UI:WaitForChild("ProfilePanel"))
local DailyBonusPanel  = require(UI:WaitForChild("DailyBonusPanel"))
local Feedback         = require(UI:WaitForChild("Feedback"))
local UpgradeFX        = require(UI:WaitForChild("UpgradeFX"))   -- 08.10. Paket G
local Moment           = require(UI:WaitForChild("Moment"))
local ReturnSummary    = require(UI:WaitForChild("ReturnSummary"))
local HomeButton       = require(UI:WaitForChild("HomeButton"))
local RebirthButton    = require(UI:WaitForChild("RebirthButton"))   -- Sammel-Update 2.7
local IncubatorPanel   = require(UI:WaitForChild("IncubatorPanel"))  -- Sammel-Update 8
local CurrencyHint     = require(UI:WaitForChild("CurrencyHint"))    -- Sammel-Update 3.4

--------------------------------------------------------------------------------
-- Oberflaeche
--------------------------------------------------------------------------------

local screenGui = Instance.new("ScreenGui")
screenGui.Name             = "RBL"
screenGui.ResetOnSpawn     = false   -- ueberlebt den Tod des Charakters
screenGui.IgnoreGuiInset   = false   -- laesst Platz fuer die Roblox-Topbar
screenGui.ZIndexBehavior   = Enum.ZIndexBehavior.Sibling
screenGui.Parent           = playerGui

-- Playtest 05.10.: auf grossen Monitoren mitwachsen (siehe UI/UiScale)
UiScale.init(screenGui)

--------------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------------

-- Sprache ALLERERSTES: ab hier liefert Loc den Text in der Roblox-Sprache des
-- Spielers. Ohne das haetten Toast und alle Beschriftungen, die beim Aufbau
-- gesetzt werden, einen Moment lang die Standardsprache.
LanguageController.init()

-- Vom Server gebaute Welt-Texte (Tafeln, Schilder, Prompts) in der Sprache
-- dieses Spielers anzeigen (siehe Localization/WorldText)
require(game:GetService("ReplicatedStorage"):WaitForChild("Localization"):WaitForChild("WorldText")).startClient()

Toast.init(screenGui)
ClientState.init()

BaerchiPanel.init(screenGui)
BaerchiInventory.init(screenGui)
HatchPanel.init(screenGui)
CombatPanel.init(screenGui)
TowerPanel.init(screenGui)         -- 08.10. Paket D (nur mit TOWER_PANEL_V2)
BuildingPanel.init(screenGui)
FusionPanel.init(screenGui)
-- Nach BaerchiPanel: die Detailkarte oeffnet dieses Panel ueber den
-- PanelManager, es muss dafuer angemeldet sein. Die Reihenfolge der init-Aufrufe
-- entscheidet das zwar nicht (geoeffnet wird erst per Klick), aber die Liste
-- hier soll den Aufrufweg widerspiegeln.
CharmPanel.init(screenGui)
RebirthDialog.init(screenGui)
LanguagePanel.init(screenGui)
QuestPanel.init(screenGui)
-- v14: Ei-Baum (oeffnet sich aus dem Ei-Menue)
EggTreePanel.init(screenGui)
-- v15: Bestenliste, Spieler-Profil (Inspector) und Login-Bonus. Vor MenuBar,
-- damit die Menue-Kacheln die Panels schon angemeldet vorfinden.
LeaderboardPanel.init(screenGui)
ProfilePanel.init(screenGui)
DailyBonusPanel.init(screenGui)
ShopPanel.init(screenGui)          -- HBB Paket 10 (nur mit SHOP_V1)
IncubatorPanel.init(screenGui)     -- Sammel-Update Paket 8

Hud.init(screenGui)
MenuBar.init(screenGui)

-- HBB Paket 1: fliegende Icons, grosse Momente, Rueckkehr-Karte. Nach Hud
-- und MenuBar (Ziele der Icons), vor ResultFeed (der Offline-Bericht des
-- Joins kommt sonst an, bevor die Karte bereit ist).
Feedback.init(screenGui)
UpgradeFX.init()                -- 08.10. Paket G: Erfolgs-Moment beim Ausbau
Moment.init(screenGui)
ReturnSummary.init(screenGui)
-- HBB Paket 5: Heim-Knopf (erscheint nur weit weg vom eigenen Plot)
HomeButton.init(screenGui)
RebirthButton.init(screenGui)   -- Sammel-Update 2.7: fester Rebirth-Knopf
CurrencyHint.init(screenGui)    -- Sammel-Update 3.4: Waehrungs-Hinweise

-- v13: Quest-Karte links (braucht das Quest-Fenster, das oben angemeldet wird)
QuestTracker.init(screenGui)
-- HUD_ROW_V2: Zahnrad · Quests · Shop in einer Zeile (versteckt die Quest-Karte)
HudRow.init(screenGui)

-- v12: untere Pet-Leiste (Event / Fight), legt auch den PitResumeDialog an
PetBar.init(screenGui)

ResultFeed.init()
WorldController.init()
EggTimerController.init()
IncubatorController.init()   -- Sammel-Update Paket 8
AreaSignController.init()    -- Sammel-Update Paket 3.8
TerminalController.init()    -- 08.10. Tower-Terminal an der Bruecke
-- v14: Faehigkeiten-Show im PIT (unabhaengig von allem anderen)
SkillFXController.init()
-- v15: Waben im Event-Pit und Recycler (braucht Toast, ClientState und die Welt)
CombController.init(screenGui)
-- v16: Himmels-Kulisse (Wolken, Schwebeinseln, Pollen, Schaum) nur auf dem Client
AmbienceController.init()
-- v17: lebendige Events (UFO-Patrouille, Abwuerfe, Boss, Telegraphen); braucht Toast
EventFXController.init()
-- v18: Ei-Mesh der gelegten Eier (EditableMesh gibt es nur auf dem Client)
LaidEggMeshController.init()
-- HBB Paket 0: Messpunkte der Oberflaeche (Panel auf/zu, Stillstand)
UiEventLogger.init()
-- HBB Paket 2: Fuehrung ohne Text (braucht MenuBar und PetBar als Anker)
GuideController.init(screenGui)
-- HBB Paket 3: ⬆ ueber bezahlbaren eigenen Gebaeuden
UpgradeHintController.init()

print("[Client] Bereit")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX111"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX84"><Properties><string name="Name">BaerchiInventory</string><ProtectedString name="Source"><![CDATA[--!strict
-- BaerchiInventory.luau
-- StarterPlayerScripts/UI/BaerchiInventory.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Baerchis des Spielers als scrollbare Liste zeigen
--   - Die Zwei-Slot-Auswahl fuer die Fusion verwalten
--   - Die zwei Reiter: "Meine Baerchis" (diese Liste) und "Index" (IndexView)
--
-- Die Liste kommt fertig sortiert aus ClientState.getBaerchiList()
-- (Rarity absteigend, dann Level) — hier wird nichts nachsortiert.
--
-- Die Fusions-Auswahl ist der einzige Zustand den dieses Modul selbst haelt.
-- Das ist erlaubt: welche zwei Zeilen gerade markiert sind, ist eine reine
-- Bedien-Information und kein Spielstand — sie steht in keinem Save und der
-- Server erfaehrt davon erst beim Bestaetigen in FusionPanel.
--
-- Neu aufgebaut wird die Liste nur wenn das Panel sichtbar ist. Kommt ein
-- Update waehrend es zu ist, wird nur ein Merker gesetzt und beim naechsten
-- Oeffnen nachgeholt — sonst baut jede Kampfrunde 25 Zeilen neu.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local Names            = require(ReplicatedStorage.Localization.Names)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Unlock       = require(script.Parent.Unlock)   -- HBB Paket 3
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombatRating = require(ReplicatedStorage.Modules.CombatRating)

-- HBB Paket 4: "⚔ 1,2K" statt HP/ATK in der Zeile
local function ratingText(baerchi: Types.Baerchi): string
	local value, suffix = CombatRating.short(CombatRating.of(baerchi))
	local digits = if suffix ~= "" and value < 100 then 1 else 0
	return "⚔ " .. (if digits > 0 then Loc.formatDecimal(value, digits) else Loc.formatNumber(math.floor(value))) .. suffix
end
local IndexView    = require(script.Parent.IndexView)

local BaerchiInventory = {}

local PANEL_NAME  = "Inventory"
local ROW_HEIGHT  = 48
local TOOLBAR_H   = 32
local FOOTER_H    = 64
local TAB_H       = 32

local _root: Frame?               = nil
local _title: TextLabel?          = nil
local _scroller: ScrollingFrame?  = nil
local _empty: TextLabel?          = nil
local _footer: Frame?             = nil
local _slotLabels: { TextLabel }  = {}
local _fuseButton: TextButton?    = nil
local _modeButton: TextButton?    = nil
local _hint: TextLabel?           = nil
local _listPage: Frame?           = nil
local _tabButtons: { [string]: TextButton } = {}
local _tab = "Pets"   -- "Pets" | "Index"

local _fusionMode = false
local _selection: { string } = {}
local _dirty = true

--------------------------------------------------------------------------------
-- Auswahl
--------------------------------------------------------------------------------

local function isSelected(uid: string): boolean
	return table.find(_selection, uid) ~= nil
end

local function toggleSelection(uid: string)
	local index = table.find(_selection, uid)
	if index then
		table.remove(_selection, index)
		return
	end

	-- Sammel-Update 2.8: B muss dieselbe Rarity wie A haben (der Server
	-- lehnt sonst ab, err.fuse_rarity_mismatch). Die Liste zeigt ohnehin nur
	-- passende — das hier ist das Netz fuer einen Klick waehrend eines Umbaus.
	local first = if _selection[1] then ClientState.getBaerchi(_selection[1]) else nil
	local picked = ClientState.getBaerchi(uid)
	if first and picked and first.rarity ~= picked.rarity then
		return
	end

	-- Sammel-Update 1.3: ein weiterer Klick ersetzt B, nie A — A ist der
	-- Baerchi, von dessen Karte der Spieler kam.
	if #_selection >= 2 then
		table.remove(_selection, 2)
	end
	table.insert(_selection, uid)
end

-- Sammel-Update 2.8: im Fusions-Modus mit gewaehltem A nur Baerchis
-- derselben Rarity zeigen (A selbst bleibt sichtbar, zum Abwaehlen).
local function visibleInFusion(baerchi: Types.Baerchi): boolean
	if not _fusionMode or not _selection[1] then return true end
	if isSelected(baerchi.uid) then return true end
	local first = ClientState.getBaerchi(_selection[1])
	return first == nil or first.rarity == baerchi.rarity
end

-- Sammel-Update 1.3 ("kann keinen 2. auswaehlen"): die Zeilen wurden bei JEDEM
-- Datenstand (Honig, Eier, ... mehrmals pro Sekunde) zerstoert und neu
-- gebaut. Lag ein Tipp gerade dazwischen (Finger runter, Zeile weg, Finger
-- hoch), kam Activated nie an — auf dem Handy fast jedes Mal. Jetzt bleibt
-- die Zeile samt Knopf pro uid stehen, nur der Inhalt wird erneuert.
local _rows: { [string]: Frame } = {}

-- Markierungen wegwerfen die es nicht mehr gibt (verwertet, fusioniert, Rebirth)
local function pruneSelection()
	for i = #_selection, 1, -1 do
		if not ClientState.getBaerchi(_selection[i]) then
			table.remove(_selection, i)
		end
	end
end

--------------------------------------------------------------------------------
-- Aufbau der Liste
--------------------------------------------------------------------------------

-- Zeigt die AKTUELLEN HP, nicht nur das Maximum: seit die HP zwischen
-- PIT-Laeufen stehen bleiben, ist "wer kann ueberhaupt noch kaempfen" die
-- eigentliche Frage beim Durchscrollen der Liste.
local function describeStats(baerchi: Types.Baerchi): string
	local def = BaerchiConfig.getById(baerchi.configId)
	if not def then return "" end

	local stats = CombatCalculator.getEffectiveStats(baerchi, def.baseStats)
	-- `or stats.maxHp`: ohne den Rueckfall wuerde ein Baerchi ohne currentHp
	-- (Datenpaket von einem aelteren Serverstand) hier den Aufbau der GANZEN
	-- Liste abbrechen, weil dieser Aufruf mitten in der Zeilen-Schleife steht.
	local hp    = math.clamp(baerchi.currentHp or stats.maxHp, 0, stats.maxHp)

	return string.format("HP %d/%d\nATK %d", hp, stats.maxHp, stats.atk)
end

local function buildRow(parent: Instance, order: number, baerchi: Types.Baerchi)
	local upgradeUi = FeatureFlags.isOn("UI_V2_UPGRADE_TAB")
	-- HBB Paket 4: Farbband statt zwoelf Einzelfarben
	local color = if upgradeUi then Theme.bandColor(baerchi.rarity) else Theme.rarityColor(baerchi.rarity)
	local def   = BaerchiConfig.getById(baerchi.configId)

	local data     = ClientState.get()
	local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

	local uid = baerchi.uid
	local row = _rows[uid]
	local fresh = row == nil or row.Parent == nil
	if fresh then
		row = Theme.panel("Row_" .. uid, parent, Theme.COLORS.panel)
		row.Size = UDim2.new(1, -8, 0, ROW_HEIGHT)
		_rows[uid] = row :: Frame

		-- Die ganze Zeile ist der Knopf: ein durchsichtiger Button darueber.
		-- Er bleibt ueber alle Aktualisierungen bestehen (siehe _rows).
		local hit = Instance.new("TextButton")
		hit.Name                   = "Hit"
		hit.BackgroundTransparency = 1
		hit.Text                   = ""
		hit.Size                   = UDim2.fromScale(1, 1)
		hit.ZIndex                 = 3
		hit.Parent                 = row

		hit.Activated:Connect(function()
			if _fusionMode then
				toggleSelection(uid)
				BaerchiInventory.refresh()
			else
				PanelManager.open("Baerchi", uid)
			end
		end)
	end
	local frame = row :: Frame
	frame.LayoutOrder = order
	frame.Visible     = visibleInFusion(baerchi)
	for _, child in frame:GetChildren() do
		if child.Name == "Accent" or child.Name == "Name" or child.Name == "Sub" or child.Name == "Stats" then
			child:Destroy()
		end
	end
	row = frame

	-- Markierte Zeilen bekommen einen farbigen Rand statt eines eigenen Symbols
	local stroke = row:FindFirstChildOfClass("UIStroke")
	if stroke then
		local marked = _fusionMode and isSelected(uid)
		stroke.Color     = if marked then Theme.COLORS.gummy else Theme.COLORS.outline
		stroke.Thickness = if marked then Theme.OUTLINE_THICKNESS + 2 else Theme.OUTLINE_THICKNESS
	end

	local accent = Instance.new("Frame")
	accent.Name             = "Accent"
	accent.Size             = UDim2.new(0, 6, 1, -14)
	accent.Position         = UDim2.new(0, 8, 0, 7)
	-- Der ausgeruestete Baerchi (der einzige, der auf dem Plot steht und
	-- kaempfen/essen kann) hebt sich hier golden ab statt in Rarity-Farbe —
	-- das ist auf einen Blick wichtiger als die Rarity.
	accent.BackgroundColor3  = if equipped then Theme.COLORS.goldGummy else color
	accent.BorderSizePixel   = 0
	accent.Parent            = row
	Theme.corner(accent, 3)

	-- Eine Mutation ist in einer langen Liste die Information, die man auf
	-- keinen Fall uebersehen darf: die haeufigste Stufe trifft trotzdem nur
	-- 1 von 100 Baerchis. Deshalb hier gleich zweimal — als Kuerzel im Namen
	-- und als Farbe der Unterzeile (seit v11, ersetzt das binaere Inverted).
	local mutation = baerchi.mutation

	local name = Theme.label("Name", row,
		(if equipped then "\u{2605} " else "")
		.. (if mutation then BaerchiConfig.getMutationBadge(mutation) .. " " else "")
		.. Names.baerchi(baerchi.configId))
	name.Position = UDim2.new(0, 22, 0, 5)
	name.Size     = UDim2.new(1, -120, 0, 21)

	local sub = Theme.label("Sub", row, string.format(
		"Lv. %d  —  %s%s",
		baerchi.level,
		Loc.t("rarity." .. baerchi.rarity),
		if mutation then "  —  " .. Loc.name("mutation." .. mutation .. ".name", BaerchiConfig.getMutationDisplayName(mutation)):upper() else ""
	))
	sub.Position   = UDim2.new(0, 22, 0, 26)
	sub.Size       = UDim2.new(1, -120, 0, 16)
	sub.TextColor3 = if mutation then BaerchiConfig.getMutationColor(mutation) else color

	local stats = Theme.label("Stats", row, if upgradeUi then ratingText(baerchi) else describeStats(baerchi))
	stats.AnchorPoint    = Vector2.new(1, 0.5)
	stats.Position       = UDim2.new(1, -10, 0.5, 0)
	stats.Size           = UDim2.new(0, 84, 1, -10)
	stats.TextXAlignment = Enum.TextXAlignment.Right
	stats.TextScaled     = false
	stats.TextSize       = if upgradeUi then 20 else 13
	stats.Font           = if upgradeUi then Theme.FONT else Theme.FONT_BODY
	stats.TextColor3     = if upgradeUi then Theme.COLORS.text else Theme.COLORS.textDim
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

local function updateFooter()
	local footer = _footer
	if footer then
		footer.Visible = _fusionMode
	end

	local scroller = _scroller
	if scroller then
		local reserved = if _fusionMode then FOOTER_H + 6 else 0
		scroller.Size = UDim2.new(1, 0, 1, -(TOOLBAR_H + 6 + reserved))
	end

	for slot = 1, 2 do
		local label = _slotLabels[slot]
		if not label then continue end

		local uid = _selection[slot]
		local baerchi = if uid then ClientState.getBaerchi(uid) else nil

		if baerchi then
			local def = BaerchiConfig.getById(baerchi.configId)
			label.Text       = string.format("%s  Lv.%d", Names.baerchi(baerchi.configId), baerchi.level)
			label.TextColor3  = Theme.rarityColor(baerchi.rarity)
		else
			label.Text       = Loc.t("ui.fusion.slot_empty", { n = slot })
			label.TextColor3  = Theme.COLORS.textDim
		end
	end

	local fuseButton = _fuseButton
	if fuseButton then
		Theme.setEnabled(fuseButton, #_selection == 2)
	end

	local modeButton = _modeButton
	if modeButton then
		modeButton.Text = Loc.t(if _fusionMode then "ui.fusion.mode_on" else "ui.fusion.mode_off")
	end

	local hint = _hint
	if hint then
		hint.Text = if not _fusionMode
			then Loc.t("ui.inventory.hint_card")
			elseif _selection[1] then Loc.t("ui.fusion.hint_pick_b")
			else Loc.t("ui.fusion.hint_pick_a")
	end
end

function BaerchiInventory.refresh()
	local scroller = _scroller
	local root     = _root
	if not scroller or not root then return end

	if not root.Visible then
		_dirty = true
		return
	end
	_dirty = false

	pruneSelection()

	local list = ClientState.getBaerchiList()

	-- Sammel-Update 1.3: nur Zeilen entfernen, deren Baerchi es nicht mehr gibt.
	local alive: { [string]: boolean } = {}
	for _, baerchi in list do alive[baerchi.uid] = true end
	for uid, row in _rows do
		if not alive[uid] then
			row:Destroy()
			_rows[uid] = nil
		end
	end

	local title = _title
	if title then
		title.Text = Loc.t("ui.inventory.title_count", { n = #list })
	end

	local empty = _empty
	if empty then
		empty.Visible = #list == 0
	end

	for order, baerchi in list do
		buildRow(scroller, order, baerchi)
	end

	updateFooter()
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function applyTab()
	-- HBB Paket 3: der Index-Reiter erscheint ab drei entdeckten Arten
	local indexTab = _tabButtons.Index
	if indexTab then
		Unlock.apply("index", indexTab)
		if not indexTab.Visible and _tab == "Index" then _tab = "Pets" end
	end

	local listPage = _listPage
	if listPage then
		listPage.Visible = _tab == "Pets"
	end
	IndexView.setVisible(_tab == "Index" and _root ~= nil and _root.Visible)

	for tab, button in _tabButtons do
		local active = tab == _tab
		button.BackgroundColor3 = if active then Theme.COLORS.accent else Theme.COLORS.panelLight
		button.TextColor3       = if active then Theme.COLORS.outline else Theme.COLORS.text
	end

	-- Sammel-Update 05.10. (Paket 7): "!" am Index-Reiter, solange eine
	-- Belohnung abholbar ist.
	local indexButton = _tabButtons.Index
	if indexButton then
		local badge = indexButton:FindFirstChild("RewardBadge")
		if badge and badge:IsA("GuiObject") then
			badge.Visible = IndexView.claimableCount() > 0
		end
	end

	if _tab == "Pets" then
		BaerchiInventory.refresh()
	end
end

local function openInternal(...: any)
	local root = _root
	if not root then return end

	-- PanelManager.open("Inventory", "Index") springt direkt in den Index
	-- (zum Beispiel aus einer Quest heraus).
	local wanted, uid = ...
	if wanted == "Index" or wanted == "Pets" then
		_tab = wanted
	elseif wanted == "Fuse" then
		-- Playtest 05.10.: Fusion von der Baerchi-Karte aus. Das Fusions-
		-- Fenster selbst hat keine Auswahl; ausgewaehlt wird hier. A ist
		-- dieser Baerchi, B tippt der Spieler in der Liste an.
		_tab = "Pets"
		_fusionMode = true
		table.clear(_selection)
		if typeof(uid) == "string" then table.insert(_selection, uid) end
	end

	root.Visible = true
	applyTab()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
	IndexView.setVisible(false)
end

function BaerchiInventory.show()
	PanelManager.open(PANEL_NAME)
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function BaerchiInventory.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"BaerchiInventory", screenGui,
		Vector2.new(0.46, 0.66),
		Vector2.new(300, 300),
		Vector2.new(520, 580)
	)
	_root  = root
	_title = Theme.dialogHeader(root, Loc.t("ui.menu.baerchis"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	-- Reiter-Leiste: "Meine Baerchis" | "Index"
	local tabBar = Theme.container("Tabs", body)
	tabBar.Size = UDim2.new(1, 0, 0, TAB_H)
	local tabLayout = Theme.listLayout(tabBar, 8, true)
	tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local function addTab(tab: string, key: string, order: number)
		local button = Theme.button("Tab_" .. tab, tabBar, "", Theme.COLORS.panelLight)
		button.Size        = UDim2.new(0, 150, 1, 0)
		button.LayoutOrder = order
		Loc.bind(button, key)
		button.Activated:Connect(function()
			if tab == "Index" then Unlock.markSeen("index") end
			_tab = tab
			applyTab()
		end)
		_tabButtons[tab] = button
	end
	addTab("Pets",  "ui.inventory.tab_pets",  1)
	addTab("Index", "ui.inventory.tab_index", 2)
	do
		local indexButton = _tabButtons.Index
		local badge = Theme.panel("RewardBadge", indexButton, Theme.COLORS.bad)
		badge.AnchorPoint = Vector2.new(1, 0)
		badge.Position = UDim2.new(1, 4, 0, -6)
		badge.Size = UDim2.fromOffset(20, 20)
		badge.ZIndex = 4
		badge.Visible = false
		Theme.corner(badge, 10)
		local bang = Theme.label("Bang", badge, "!")
		bang.Size = UDim2.fromScale(1, 1)
		bang.TextXAlignment = Enum.TextXAlignment.Center
		bang.ZIndex = 5
	end

	-- Beide Seiten teilen sich die Flaeche unter den Reitern.
	local pages = Theme.container("Pages", body)
	pages.Position = UDim2.new(0, 0, 0, TAB_H + 8)
	pages.Size     = UDim2.new(1, 0, 1, -(TAB_H + 8))

	local listPage = Theme.container("ListPage", pages)
	listPage.Size = UDim2.fromScale(1, 1)
	_listPage = listPage

	IndexView.build(pages, root)

	-- Werkzeugleiste: Fusions-Modus an/aus
	local toolbar = Theme.container("Toolbar", listPage)
	toolbar.Size = UDim2.new(1, 0, 0, TOOLBAR_H)

	local modeButton = Theme.button("FusionMode", toolbar, Loc.t("ui.fusion.mode_off"), Theme.COLORS.gummy)
	modeButton.Size = UDim2.new(0, 130, 1, 0)
	_modeButton = modeButton

	local hint = Theme.bodyText("Hint", toolbar, Loc.t("ui.inventory.hint_card"))
	_hint = hint
	hint.Position       = UDim2.new(0, 140, 0, 0)
	hint.Size           = UDim2.new(1, -140, 1, 0)
	hint.TextYAlignment = Enum.TextYAlignment.Center

	modeButton.Activated:Connect(function()
		_fusionMode = not _fusionMode
		if not _fusionMode then
			table.clear(_selection)
		end
		BaerchiInventory.refresh()
	end)

	-- Liste
	local scroller = Theme.scroller("List", listPage)
	scroller.Position = UDim2.new(0, 0, 0, TOOLBAR_H + 6)
	scroller.Size     = UDim2.new(1, 0, 1, -(TOOLBAR_H + 6))
	_scroller = scroller

	local layout = Theme.listLayout(scroller, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local empty = Theme.bodyText("Empty", listPage, Loc.t("ui.inventory.empty"))
	empty.Position = UDim2.new(0, 4, 0, TOOLBAR_H + 16)
	empty.Size     = UDim2.new(1, -8, 0, 40)
	empty.Visible  = false
	_empty = empty

	-- Fussleiste fuer die Fusions-Auswahl
	local footer = Theme.panel("FusionFooter", listPage, Theme.COLORS.panel)
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Position    = UDim2.new(0, 0, 1, 0)
	footer.Size        = UDim2.new(1, -8, 0, FOOTER_H)
	footer.Visible     = false
	_footer = footer

	for slot = 1, 2 do
		local label = Theme.label("Slot" .. slot, footer, Loc.t("ui.fusion.slot_empty", { n = slot }))
		label.Position   = UDim2.new(0, 10, 0, 6 + (slot - 1) * 22)
		label.Size       = UDim2.new(1, -140, 0, 20)
		label.TextColor3  = Theme.COLORS.textDim
		_slotLabels[slot] = label
	end

	local fuseButton = Theme.button("Fuse", footer, Loc.t("ui.fusion.fuse"), Theme.COLORS.gummy)
	fuseButton.AnchorPoint = Vector2.new(1, 0.5)
	fuseButton.Position    = UDim2.new(1, -10, 0.5, 0)
	fuseButton.Size        = UDim2.new(0, 116, 0, 34)
	_fuseButton = fuseButton

	fuseButton.Activated:Connect(function()
		if #_selection < 2 then return end
		PanelManager.open("Fusion", _selection[1], _selection[2])
	end)

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	-- Bestandsaenderungen: sichtbar sofort nachziehen, sonst nur merken
	ClientState.onChanged(function()
		local current = _root
		local indexButton = _tabButtons.Index
		local badge = if indexButton then indexButton:FindFirstChild("RewardBadge") else nil
		if badge and badge:IsA("GuiObject") then
			badge.Visible = IndexView.claimableCount() > 0
		end
		if current and current.Visible then
			BaerchiInventory.refresh()
		else
			_dirty = true
		end
	end)

	-- Sprachwechsel: Zeilen, Titel und Fusions-Leiste neu beschriften
	Loc.onChanged(function()
		_dirty = true
		BaerchiInventory.refresh()
	end)

	print("[BaerchiInventory] Initialisiert")
end

return BaerchiInventory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX85"><Properties><string name="Name">BaerchiPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- BaerchiPanel.luau
-- StarterPlayerScripts/UI/BaerchiPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Detailkarte eines einzelnen Baerchis anzeigen
--   - Die Aktionen die genau diesen Baerchi betreffen ausloesen: ausruesten,
--     befoerdern, mit Honig fuettern und verwerten
--
-- SEIT v12 laufen "Zum Event" und "In den PIT" NICHT mehr ueber diese Karte,
-- sondern ueber die untere Pet-Leiste (PetBar). Der ausgeruestete Baerchi kann
-- ausserdem nicht mehr verwertet werden (Ei-Baum-Konzept, Pet-Regeln): der
-- Knopf ist bei ihm gesperrt, der Server lehnt es zusaetzlich ab.
--
-- FUETTERN IST SEIT v7 EINE ENTSCHEIDUNG, kein einzelner Knopf mehr: die drei
-- Gebaeude liefern unterschiedlichen Honig (siehe Config/BuildingBehavior).
-- Deshalb steht hier pro Gebaeude ein eigener Knopf mit seinem eigenen
-- Bestand, in derselben Farbe wie seine Karte im Gebaeude-Panel. Welchen Honig
-- der Spieler verfuettert, entscheidet er — nicht mehr der Server.
--
-- SEIT v8 zeigt die Karte die ZWEITE Fortschrittsachse mit: fuenf Sterne
-- (Promotion), acht Charm-Slots und ein Balken je Stat-Level. Damit wuchs sie
-- ueber die Hoehe eines Handy-Bildschirms hinaus — der Inhalt liegt deshalb
-- jetzt in einem Scroller statt direkt im Rahmen. Das ist der Grund, warum
-- `body` hier eine ScrollingFrame ist und die Zeilen `1, -8` breit sind.
--
-- Wird von WorldController geoeffnet, wenn der Spieler eine Figur auf seiner
-- Insel anklickt, und aus dem Inventar heraus. Die Karte liest ihre Daten
-- ueber die uid aus ClientState — kein zusaetzlicher Server-Roundtrip noetig.
--
-- Die Karte bleibt beim Datenwechsel offen und aktualisiert sich mit (z.B.
-- waehrend eines Kampfes steigt XP), und schliesst sich automatisch wenn der
-- Baerchi verschwindet (verwertet oder fusioniert).
--
-- Die Kampf-Wiedergabe gehoert bewusst NICHT hierher: sie haengt am
-- CombatResultReceived-Listener in CombatPanel und laeuft deshalb egal von
-- wo der Kampf gestartet wurde.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local SkillConfig      = require(ReplicatedStorage.Config.SkillConfig)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local PromotionConfig  = require(ReplicatedStorage.Config.PromotionConfig)
local CharmConfig      = require(ReplicatedStorage.Config.CharmConfig)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local EggCalculator    = require(ReplicatedStorage.Modules.EggCalculator)
local EggConfig        = require(ReplicatedStorage.Config.EggConfig)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify        = require(script.Parent.Notify)
local Feedback      = require(script.Parent.Feedback)
local Moment        = require(script.Parent.Moment)
local ReturnSummary = require(script.Parent.ReturnSummary)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Unlock       = require(script.Parent.Unlock)   -- HBB Paket 3
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local CombatRating = require(ReplicatedStorage.Modules.CombatRating)
local Loc          = require(ReplicatedStorage.Localization.Loc)
local Names        = require(ReplicatedStorage.Localization.Names)

-- HBB Paket 4: Kampfwert im Kopf, "Staerker machen" (Befoerdern + Fusion)
local _ratingLabel: TextLabel? = nil
local _ratingRow: Frame? = nil
local _upgradeRow: Frame? = nil

local BaerchiPanel = {}

local PANEL_NAME = "Baerchi"

local _root: Frame?      = nil
local _openUid: string?  = nil

-- Referenzen auf die Felder der Karte
local _titleLabel: TextLabel?  = nil
local _rarityLabel: TextLabel? = nil
local _levelLabel: TextLabel?  = nil
local _statsLabel: TextLabel?  = nil
local _skillLabel: TextLabel?  = nil
local _valueLabel: TextLabel?  = nil
local _xpFill: Frame?          = nil
local _xpText: TextLabel?      = nil
local _hpFill: Frame?          = nil
local _hpText: TextLabel?      = nil
local _accentBar: Frame?       = nil
local _fusionBadge: Frame?         = nil
local _mutationBadge: Frame?       = nil
local _mutationBadgeText: TextLabel? = nil
local _equipButton: TextButton? = nil
local _recycleButton: TextButton? = nil

-- v8: Promotion, Stat-Level, Charms
local _stars: { Frame }            = {}
local _promoteButton: TextButton?  = nil
local _promoteHint: TextLabel?     = nil
type CharmTile = {
	tile   : Frame,
	letter : TextLabel,
}
local _charmSlots: { CharmTile }   = {}
local _charmButton: TextButton?    = nil

-- v10: Eier legen
local _eggRateLabel: TextLabel?    = nil
local _eggChanceLabel: TextLabel?  = nil
local _eggCountLabel: TextLabel?   = nil
local _collectButton: TextButton?  = nil

type StatRow = {
	key  : string,
	fill : Frame,
	text : TextLabel,
}
local _statRows: { StatRow } = {}

-- Ein Fuetter-Knopf pro Gebaeude, key = BuildingId. Text und Verfuegbarkeit
-- ziehen bei jedem Datenwechsel nach (siehe fill).
local _feedButtons: { [string]: TextButton } = {}

--------------------------------------------------------------------------------
-- Inhalt fuellen
--------------------------------------------------------------------------------

-- Wie viele Duplikate fuer die naechste Promotion da sind. Dieselbe Bedingung
-- wie PromotionService.getMaterials: gleicher configId, andere uid, nicht der
-- ausgeruestete Baerchi.
local function countMaterials(target: Types.Baerchi): number
	local data = ClientState.get()
	if not data then return 0 end

	local count = 0
	for uid, baerchi in data.island.baerchis do
		if uid ~= target.uid
			and baerchi.configId == target.configId
			and uid ~= data.island.equippedUid
		then
			count += 1
		end
	end
	return count
end

local function fillPromotion(baerchi: Types.Baerchi)
	local promotion = baerchi.promotionLevel or 0
	local states    = PromotionConfig.getStarStates(promotion)

	for index, star in _stars do
		star.BackgroundColor3 = PromotionConfig.STAR_COLORS[states[index]]
			or PromotionConfig.STAR_COLORS.empty
	end

	local maxed = promotion >= PromotionConfig.MAX_PROMOTION

	if _promoteHint then
		if maxed then
			_promoteHint.Text       = Loc.t("ui.baerchi.promo_maxed", { n = promotion, max = PromotionConfig.MAX_PROMOTION })
			_promoteHint.TextColor3 = Theme.COLORS.goldGummy
		else
			local cost = PromotionConfig.getDuplicateCost(baerchi.rarity, promotion + 1)
			local have = countMaterials(baerchi)

			_promoteHint.Text = Loc.t("ui.baerchi.promo_next", {
				n = promotion, max = PromotionConfig.MAX_PROMOTION, cost = cost, have = have })
			_promoteHint.TextColor3 = if have >= cost then Theme.COLORS.good else Theme.COLORS.textDim
		end
	end

	if _promoteButton then
		local ready = false
		if not maxed then
			local cost = PromotionConfig.getDuplicateCost(baerchi.rarity, promotion + 1)
			ready = countMaterials(baerchi) >= cost
		end

		_promoteButton.Text = Loc.t(if maxed then "ui.baerchi.promo_full" else "ui.baerchi.promote")
		Theme.setEnabled(_promoteButton, ready)
	end
end

local function fillStatLevels(baerchi: Types.Baerchi)
	local cap    = PromotionConfig.getStatCap(baerchi.rarity)
	local levels = baerchi.statLevels

	for _, row in _statRows do
		local value = if levels then (((levels :: any)[row.key]) or 0) else 0
		local ratio = if cap > 0 then math.clamp(value / cap, 0, 1) else 0

		row.fill.Size = UDim2.fromScale(ratio, 1)

		-- EGG hebt sich farblich ab: es ist der einzige der fuenf Stats, der
		-- nichts mit dem Kampf zu tun hat, sondern mit dem Ei-Legen.
		row.fill.BackgroundColor3 = if row.key == "egg"
			then Theme.COLORS.goldGummy
			else Theme.rarityColor(baerchi.rarity)

		local label = PromotionConfig.STAT_LABELS[row.key] or string.upper(row.key)
		row.text.Text = string.format("%s  %d / %d", label, value, cap)
	end
end

local function fillCharms(baerchi: Types.Baerchi)
	local promotion = baerchi.promotionLevel or 0

	-- `or {}`: ein Datenpaket von einem aelteren Serverstand haette das Feld
	-- nicht (dieselbe Vorsichtsmassnahme wie bei currentHp weiter unten).
	local charms: { Types.Charm } = baerchi.charms or {}

	local bySlot: { [number]: Types.Charm } = {}
	for _, charm in charms do
		bySlot[charm.slot] = charm
	end

	local unlocked = 0

	for slot, entry in _charmSlots do
		local isOpen = CharmConfig.isSlotUnlocked(slot, promotion)
		local charm  = if isOpen then bySlot[slot] else nil

		if isOpen then unlocked += 1 end

		if not isOpen then
			entry.letter.Text          = "-"
			entry.letter.TextColor3    = Theme.COLORS.textDim
			entry.tile.BackgroundColor3 = Theme.COLORS.disabled
		elseif not charm then
			entry.letter.Text          = "?"
			entry.letter.TextColor3    = Theme.COLORS.text
			entry.tile.BackgroundColor3 = Theme.COLORS.panelLight
		else
			entry.letter.Text          = CharmConfig.RARITY_LETTER[charm.rarity] or "?"
			entry.letter.TextColor3    = Theme.COLORS.outline
			entry.tile.BackgroundColor3 = CharmConfig.RARITY_COLORS[charm.rarity]
				or Theme.COLORS.panelLight
		end
	end

	if _charmButton then
		_charmButton.Text = Loc.t("ui.baerchi.charms_button", { open = unlocked, total = CharmConfig.SLOT_COUNT })
		Theme.setEnabled(_charmButton, true)
	end
end

-- Der Ei-Abschnitt: wie schnell dieser Baerchi legt und was dabei herauskommen
-- kann. Beide Zahlen kommen aus EggCalculator — dieselbe Rechnung, die der
-- Server benutzt. Eine nachgebaute Formel hier waere beim naechsten Balancing
-- sofort falsch.
local function fillEgg(baerchi: Types.Baerchi)
	local data     = ClientState.get()
	local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

	if _eggRateLabel then
		local interval = EggCalculator.getLayIntervalSeconds(baerchi, false)

		if not interval then
			_eggRateLabel.Text       = Loc.t("ui.baerchi.no_eggs")
			_eggRateLabel.TextColor3 = Theme.COLORS.textDim
		else
			_eggRateLabel.Text = Loc.t(if equipped then "ui.baerchi.lays_every" else "ui.baerchi.lays_every_unequipped",
				{ time = Theme.formatDuration(interval) })
			_eggRateLabel.TextColor3 = if equipped then Theme.COLORS.goldGummy else Theme.COLORS.textDim
		end
	end

	if _eggChanceLabel then
		local chances = EggCalculator.getChances(baerchi)

		if #chances == 0 then
			_eggChanceLabel.Text = ""
		else
			local parts: { string } = {}
			for _, chance in chances do
				table.insert(parts, string.format(
					"%s %d%%",
					Names.eggShort(chance.eggType),
					math.floor(chance.percent + 0.5)
				))
			end
			_eggChanceLabel.Text = table.concat(parts, "   ")
		end
	end

	if _eggCountLabel then
		-- INCUBATOR_BREED: nur die Eier des ausgeruesteten zaehlen gegen seine Grenze
		local laid = if data then EggCalculator.countOwnLaid(data.island.laidEggs) else 0

		_eggCountLabel.Text = Loc.t("ui.baerchi.eggs_on_plot", { n = laid, max = EggConfig.MAX_UNCOLLECTED_EGGS })
		_eggCountLabel.TextColor3 = if laid >= EggConfig.MAX_UNCOLLECTED_EGGS
			then Theme.COLORS.bad
			else Theme.COLORS.textDim
	end

	if _collectButton then
		local laid = if data then #(data.island.laidEggs or {}) else 0
		_collectButton.Text = if laid > 0
			then Loc.t("ui.baerchi.collect_n", { n = laid })
			else Loc.t("ui.baerchi.collect_none")
		Theme.setEnabled(_collectButton, laid > 0)
	end
end

local function fill(baerchi: Types.Baerchi)
	local def = BaerchiConfig.getById(baerchi.configId)
	local color = Theme.rarityColor(baerchi.rarity)

	-- HBB Paket 3: Charms und Verwerten erst, wenn sie gebraucht werden
	if _charmButton then Unlock.apply("charms", _charmButton) end
	if _recycleButton then Unlock.apply("recycling", _recycleButton) end

	-- HBB Paket 4: Farbband statt zwoelf Einzelfarben, Kampfwert gross
	local upgradeUi = FeatureFlags.isOn("UI_V2_UPGRADE_TAB")
	if upgradeUi then
		color = Theme.bandColor(baerchi.rarity)
	end
	local ratingLabel = _ratingLabel
	if ratingLabel then
		if _ratingRow then _ratingRow.Visible = upgradeUi end
		local value, suffix = CombatRating.short(CombatRating.of(baerchi))
		local digits = if suffix ~= "" and value < 100 then 1 else 0
		ratingLabel.Text = "⚔ " .. (if digits > 0 then Loc.formatDecimal(value, digits) else Loc.formatNumber(math.floor(value))) .. suffix
		ratingLabel.TextColor3 = color
	end
	local upgradeRow = _upgradeRow
	if upgradeRow then
		upgradeRow.Visible = upgradeUi and Unlock.isVisible("tab_upgrade")
	end

	if _accentBar   then _accentBar.BackgroundColor3 = color end
	if _titleLabel  then _titleLabel.Text  = Names.baerchi(baerchi.configId) end
	if _rarityLabel then
		_rarityLabel.Text       = string.upper(Names.rarity(baerchi.rarity))
		_rarityLabel.TextColor3 = color
	end
	if _levelLabel then
		_levelLabel.Text = Loc.t("ui.baerchi.level", { level = baerchi.level, max = BaerchiConfig.MAX_LEVEL })
		if baerchi.level >= BaerchiConfig.MAX_LEVEL and (baerchi.endlessLevel or 0) > 0 then
			-- Paket 9: Endless-Level dahinter
			_levelLabel.Text ..= "  " .. Loc.t("ui.baerchi.endless_level", { n = baerchi.endlessLevel or 0 })
		end
	end

	-- Nur der ausgeruestete Baerchi steht auf dem Plot, kaempft und isst von
	-- alleine am Teich — der Knopf zeigt, ob das dieser hier ist, und ruestet
	-- ihn sonst aus.
	if _equipButton then
		local data     = ClientState.get()
		local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

		_equipButton.Text = Loc.t(if equipped then "ui.card.equipped" else "ui.card.equip")
		Theme.setEnabled(_equipButton, not equipped)
	end

	-- Kampfwerte inklusive Fusions-Bonus, damit die Karte zeigt was im PIT zaehlt.
	-- Bewusst ueber CombatCalculator.getEffectiveStats: das ist dieselbe Funktion
	-- die der Server fuer den Kampf benutzt — eine nachgebaute Formel hier waere
	-- beim naechsten Balancing sofort falsch. Seit v8 stecken darin auch
	-- Promotion, Stat-Level und Charms.
	local stats = if def then CombatCalculator.getEffectiveStats(baerchi, def.baseStats) else nil

	if _statsLabel and stats then
		-- Eine Verteidigung gibt es nicht mehr (siehe BaerchiConfig): die drei
		-- Zahlen, die einen Kampf entscheiden, sind Schaden pro Treffer,
		-- Angriffstempo und Ability-Staerke.
		-- Sammel-Update 3.7: Symbole vor den Kuerzeln
		_statsLabel.Text = string.format("⚔ ATK %d   ⚡ SPD %.2f   ✨ PWR %d%%",
			stats.atk, stats.spd, math.floor(stats.pwr * 100 + 0.5))
	end

	-- HP-Balken. Die HP bleiben zwischen PIT-Laeufen stehen: ein leerer Balken
	-- heisst erschoepft, und dann geht kein neuer Lauf mehr los bevor
	-- gefuettert wurde. Das ist die wichtigste Zahl auf dieser Karte.
	if _hpFill and _hpText and stats then
		-- `or stats.maxHp`: currentHp gibt es erst seit v4. Ein Datenpaket von
		-- einem aelteren Serverstand haette das Feld nicht, und math.clamp
		-- wuerde an nil scheitern statt den Baerchi einfach voll anzuzeigen.
		local hp    = math.clamp(baerchi.currentHp or stats.maxHp, 0, stats.maxHp)
		local ratio = if stats.maxHp > 0 then hp / stats.maxHp else 0

		_hpFill.Size = UDim2.fromScale(ratio, 1)
		_hpFill.BackgroundColor3 = if ratio <= 0
			then Theme.COLORS.bad
			elseif ratio < 0.34 then Theme.COLORS.goldGummy
			else Theme.COLORS.good

		_hpText.Text = if hp <= 0
			then Loc.t("ui.card.hp_exhausted", { max = stats.maxHp })
			else string.format("%d / %d HP", hp, stats.maxHp)
	end

	if _skillLabel then
		local skill = SkillConfig.getById(baerchi.skillId)
		_skillLabel.Text = if skill
			then Names.skill(baerchi.skillId) .. " — " .. Names.skillDesc(baerchi.skillId)
			else baerchi.skillId
	end

	-- XP-Balken
	-- Paket 9: auf Max-Level sammeln sich XP nur mit offenem Endless (sonst
	-- immer 0) — dann zeigt der Balken den Weg zum naechsten Endless-Level.
	local endlessXp = baerchi.level >= BaerchiConfig.MAX_LEVEL
		and ((baerchi.endlessLevel or 0) > 0 or baerchi.xp > 0)
	local needed = if endlessXp
		then BaerchiConfig.xpForEndlessLevel(baerchi.endlessLevel or 0)
		else BaerchiConfig.xpForNextLevel(baerchi.level)
	local ratio  = if baerchi.level >= BaerchiConfig.MAX_LEVEL and not endlessXp
		then 1
		else math.clamp(baerchi.xp / math.max(needed, 1), 0, 1)

	if _xpFill then
		_xpFill.Size            = UDim2.fromScale(ratio, 1)
		_xpFill.BackgroundColor3 = color
	end
	if _xpText then
		_xpText.Text = if endlessXp
			then string.format("%s / %s XP", Theme.formatNumber(baerchi.xp), Theme.formatNumber(needed))
			elseif baerchi.level >= BaerchiConfig.MAX_LEVEL
			then "MAX"
			else string.format("%d / %d XP", baerchi.xp, needed)
	end

	-- Verwertungs-Wert, damit man vor dem Verwerten weiss was es bringt.
	-- Feste Quote seit v4 (kein Recycler-Gebaeude mehr).
	if _valueLabel then
		local value = math.floor(
			EconomyConfig.getBaerchiBaseValue(baerchi.rarity, baerchi.level)
			* EconomyConfig.RECYCLE_RETURN
		)
		_valueLabel.Text = Loc.t("ui.baerchi.recycle_value", { n = value })
	end

	-- Pet-Regel (v12): der ausgeruestete Baerchi ist der, der Eier legt — er
	-- darf nicht verwertet werden, sonst stuende der Spieler ohne Leger da.
	-- Tauschen geht ueber "Ausruesten" bei einem anderen. Der Server lehnt es
	-- ohnehin ab, das Ausgrauen spart nur den Klick ins Leere.
	if _recycleButton then
		local data     = ClientState.get()
		local equipped = data ~= nil and data.island.equippedUid == baerchi.uid

		_recycleButton.Text = Loc.t(if equipped then "ui.baerchi.recycle_equipped" else "ui.baerchi.recycle")
		Theme.setEnabled(_recycleButton, not equipped)
	end

	if _fusionBadge then
		_fusionBadge.Visible = baerchi.isFusionResult
	end

	if _mutationBadge then
		local mutation = baerchi.mutation
		_mutationBadge.Visible = mutation ~= nil
		if mutation then
			_mutationBadge.BackgroundColor3 = BaerchiConfig.getMutationColor(mutation)
			if _mutationBadgeText then
				_mutationBadgeText.Text = Names.mutation(mutation):upper()
			end
		end
	end

	fillPromotion(baerchi)
	fillStatLevels(baerchi)
	fillCharms(baerchi)
	fillEgg(baerchi)

	-- Fuetter-Knoepfe: jeder zeigt seinen EIGENEN Bestand und ist nur
	-- anklickbar, wenn dort auch etwas liegt. Leere Lager auszugrauen erspart
	-- den Klick ins Leere — abgelehnt wuerde er ohnehin, aber erst nach dem
	-- Weg zum Server.
	local data = ClientState.get()

	-- Nur Gebaeude, die es auf dieser Insel gibt (HONEY_POND_V2: nur der
	-- Teich); die Knoepfe teilen sich die Zeile gleichmaessig.
	local shown = 0
	for id in _feedButtons do
		if data and data.island.buildings[id :: Types.BuildingId] then shown += 1 end
	end
	for id, button in _feedButtons do
		local building = if data then data.island.buildings[id :: Types.BuildingId] else nil
		local honey = if building then (building.honey or 0) else 0

		button.Visible = building ~= nil
		button.Size = UDim2.new(1 / math.max(1, shown), -6, 1, 0)
		button.Text = string.format("%s %d", Names.buildingShort(id), honey)
		Theme.setEnabled(button, honey > 0)
	end
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function closeInternal()
	_openUid = nil
	local root = _root
	if root then root.Visible = false end
end

local function showInternal(...: any)
	local argument = ...
	if typeof(argument) ~= "string" then return end

	local uid = argument :: string
	local baerchi = ClientState.getBaerchi(uid)
	if not baerchi then
		-- unbekannte uid (fremde Insel oder veralteter Klick)
		PanelManager.close(PANEL_NAME)
		return
	end

	_openUid = uid
	fill(baerchi)

	local root = _root
	if root then root.Visible = true end
end

function BaerchiPanel.close()
	PanelManager.close(PANEL_NAME)
end

function BaerchiPanel.show(uid: string)
	-- Gehoert der Baerchi gar nicht diesem Spieler (Klick auf die Figur eines
	-- Nachbarn auf der gemeinsamen Plattform), passiert einfach nichts.
	--
	-- Frueher lief der Aufruf trotzdem durch: PanelManager.open schliesst
	-- zuerst alle anderen Panels und showInternal machte danach mangels
	-- Daten wieder zu — dem Spieler verschwand also sein gerade offenes
	-- Fenster, sobald er einen fremden Baerchi anklickte.
	if not ClientState.getBaerchi(uid) then
		return
	end

	PanelManager.open(PANEL_NAME, uid)
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function BaerchiPanel.init(screenGui: ScreenGui)
	-- Playtest 05.10.: die einspaltige Karte war zu schmal und lang. Jetzt
	-- zwei Spalten: links wer der Baerchi ist und wie er staerker wird,
	-- rechts Zustand, Werte, Eier und Aktionen.
	--
	-- Seit v8 passt der Inhalt nicht mehr garantiert in den Rahmen (Sterne,
	-- fuenf Stat-Balken, acht Charm-Slots kamen dazu). Statt die Karte immer
	-- weiter wachsen zu lassen, scrollt sie: die Mindesthoehe muss deshalb nur
	-- noch fuer eine bequem lesbare Flaeche reichen, nicht mehr fuer JEDE
	-- Zeile gleichzeitig.
	--
	-- UI-Qualitaet Schritt 2: gemeinsame Huelle (Theme.dialog) wie alle
	-- anderen Menues — passt sich kleinen Bildschirmen an, Name in der
	-- Kopfzeile, grosses Schliessen-X oben rechts. Der fruehere farbige
	-- Rarity-Streifen ist jetzt der Titelbalken selbst.
	local root = Theme.dialog(
		"BaerchiPanel", screenGui,
		Vector2.new(0.72, 0.74),
		Vector2.new(560, 400),
		Vector2.new(920, 680)
	)

	_titleLabel = Theme.dialogHeader(root, "—", function()
		BaerchiPanel.close()
	end)
	local band = root:FindFirstChild("TitleBand")
	if band and band:IsA("Frame") then
		_accentBar = band
	end

	-- Sammel-Update 2.1 wollte ein X oben rechts wie bei allen anderen
	-- Fenstern — das bringt die Kopfzeile (dialogHeader) jetzt mit.

	local shell = Theme.dialogBody(root)

	-- Zwei Spalten, jede scrollt fuer sich. `row()` haengt an die Spalte, die
	-- gerade in `column` steht (umgeschaltet vor dem Abschnitt "Zustand").
	local leftColumn = Theme.scroller("Content", shell)
	leftColumn.Size = UDim2.new(0.5, -6, 1, 0)
	local rightColumn = Theme.scroller("ContentRight", shell)
	rightColumn.Position = UDim2.new(0.5, 6, 0, 0)
	rightColumn.Size = UDim2.new(0.5, -6, 1, 0)
	for _, columnFrame in { leftColumn, rightColumn } do
		local layout = Theme.listLayout(columnFrame, 6)
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	end
	local column: ScrollingFrame = leftColumn

	local nextOrder = 0
	local function row(height: number): Frame
		nextOrder += 1
		local entry = Theme.container("Row", column)
		-- -8: Platz fuer den Scrollbalken, sonst ragt jede Zeile darunter
		-- (Konvention aus Theme.scroller).
		entry.Size        = UDim2.new(1, -8, 0, height)
		entry.LayoutOrder = nextOrder
		return entry
	end

	-- Abschnitts-Titel: bekommt den Loc-Schluessel, nicht den Text, und
	-- beschriftet sich beim Sprachwechsel neu (Loc.bind).
	local function section(key: string)
		local holder = row(16)
		local label  = Theme.sectionLabel("Section", holder, "")
		label.Size = UDim2.fromScale(1, 1)
		Loc.bind(label, key)
	end

	-- Name steht seit UI-Qualitaet Schritt 2 in der Kopfzeile (dialogHeader).

	-- HBB Paket 4: Kampfwert (eine Zahl statt fuenf Werte)
	local ratingRow = row(40)
	ratingRow.Visible = false
	local ratingLabel = Theme.label("Rating", ratingRow, "")
	ratingLabel.Size = UDim2.fromScale(1, 1)
	Theme.outlineText(ratingLabel, 3)
	local ratingLimit = ratingLabel:FindFirstChildOfClass("UITextSizeConstraint")
	if ratingLimit then ratingLimit.MaxTextSize = 36 end
	_ratingLabel = ratingLabel
	_ratingRow = ratingRow

	-- Rarity + Fusions-Badge nebeneinander
	local rarityRow = row(22)
	_rarityLabel = Theme.label("Rarity", rarityRow, "—")
	_rarityLabel.Size       = UDim2.new(0.6, 0, 1, 0)
	_rarityLabel.Font       = Theme.FONT
	_rarityLabel.TextColor3 = Theme.COLORS.accent

	local badge = Theme.panel("FusionBadge", rarityRow, Theme.COLORS.gummy)
	badge.AnchorPoint = Vector2.new(1, 0.5)
	badge.Position    = UDim2.new(1, 0, 0.5, 0)
	badge.Size        = UDim2.new(0, 76, 0, 20)
	badge.Visible     = false
	local badgeText = Theme.label("Text", badge, "")
	Loc.bind(badgeText, "ui.card.badge_fusion")
	badgeText.Size           = UDim2.fromScale(1, 1)
	badgeText.TextXAlignment = Enum.TextXAlignment.Center
	badgeText.TextColor3     = Theme.COLORS.outline
	_fusionBadge = badge

	-- Mutations-Badge (seit v11, ersetzt das binaere INVERTED-Badge). Sitzt
	-- LINKS neben dem Fusions-Badge statt an derselben Stelle: ein Baerchi
	-- kann beides gleichzeitig sein (die hoehere Mutations-Stufe zweier
	-- Inputs vererbt sich an das Fusions-Ergebnis, siehe FusionService
	-- Regel E). Etwas breiter als frueher, weil "CELESTIAL"/"BLOODROT" laenger
	-- sind als "INVERTED".
	local mutBadge = Theme.panel("MutationBadge", rarityRow, Theme.COLORS.accent)
	mutBadge.AnchorPoint = Vector2.new(1, 0.5)
	mutBadge.Position    = UDim2.new(1, -86, 0.5, 0)
	mutBadge.Size        = UDim2.new(0, 96, 0, 20)
	mutBadge.Visible     = false
	local mutText = Theme.label("Text", mutBadge, "")
	mutText.Size           = UDim2.fromScale(1, 1)
	mutText.TextXAlignment = Enum.TextXAlignment.Center
	mutText.TextColor3     = Theme.COLORS.outline
	_mutationBadge     = mutBadge
	_mutationBadgeText = mutText

	-- Level
	local levelRow = row(22)
	_levelLabel = Theme.label("Level", levelRow, "—")
	_levelLabel.Size = UDim2.fromScale(1, 1)

	-- Ausruesten: nur der ausgeruestete Baerchi steht auf dem Plot. Steht
	-- gleich unter dem Level, weil es die erste Entscheidung ist, die man bei
	-- einem neuen Baerchi trifft.
	local equipRow = row(28)
	local equip = Theme.button("Equip", equipRow, Loc.t("ui.card.equip"), Theme.COLORS.accent)
	equip.Size = UDim2.new(1, 0, 1, 0)
	_equipButton = equip
	equip.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Remotes.RequestEquipBaerchi:FireServer(uid)
	end)

	-- HBB Paket 4: "Baerchi staerker machen" — Befoerdern (unten, wie bisher)
	-- und Fusion an einer Stelle. Die Fusion oeffnet das bestehende
	-- Inventar im Fusions-Modus mit diesem Baerchi als A (Playtest 05.10.:
	-- direkt ins Fusions-Fenster ging B nicht auszuwaehlen).
	local upgradeRow = row(34)
	upgradeRow.Visible = false
	local fuse = Theme.button("UpgradeFuse", upgradeRow, "⬆ + 🐻", Theme.COLORS.gummy)
	fuse.Size = UDim2.new(1, 0, 1, 0)
	fuse.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Unlock.markSeen("tab_upgrade")
		-- Auswahl des zweiten Baerchis passiert im Inventar (Fusions-Modus)
		PanelManager.open("Inventory", "Fuse", uid)
	end)
	_upgradeRow = upgradeRow

	-- ---------------------------------------------------------------- Promotion
	section("ui.card.section_promotion")

	-- Fuenf Sterne. Zehn Stufen werden darauf abgebildet, indem die Sterne ein
	-- zweites Mal umgefaerbt werden (siehe PromotionConfig.getStarStates) —
	-- diese Umrechnung passiert dort, nicht hier.
	local starRow = row(26)
	local starLayout = Theme.listLayout(starRow, 6, true)
	starLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	for index = 1, PromotionConfig.STAR_COUNT do
		local star = Theme.panel("Star_" .. index, starRow, PromotionConfig.STAR_COLORS.empty)
		star.Size        = UDim2.new(0, 26, 0, 26)
		star.LayoutOrder = index
		Theme.corner(star, 13)
		table.insert(_stars, star)
	end

	local promoteHintRow = row(30)
	_promoteHint = Theme.bodyText("PromoteHint", promoteHintRow, "")
	_promoteHint.Size = UDim2.fromScale(1, 1)

	local promoteRow = row(32)
	local promote = Theme.button("Promote", promoteRow, Loc.t("ui.card.promote"), Theme.COLORS.goldGummy)
	promote.Size = UDim2.new(1, 0, 1, 0)
	_promoteButton = promote
	promote.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Remotes.RequestPromoteBaerchi:FireServer(uid)
	end)

	-- ------------------------------------------------------------ Battle Charms
	section("ui.card.section_charms")

	local charmRow = row(30)
	local charmLayout = Theme.listLayout(charmRow, 4, true)
	charmLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	for slot = 1, CharmConfig.SLOT_COUNT do
		local tile = Theme.panel("Charm_" .. slot, charmRow, Theme.COLORS.disabled)
		tile.Size        = UDim2.new(0, 28, 0, 28)
		tile.LayoutOrder = slot
		Theme.corner(tile, 8)

		local letter = Theme.label("Letter", tile, "-")
		letter.Size           = UDim2.fromScale(1, 1)
		letter.TextXAlignment = Enum.TextXAlignment.Center
		letter.TextScaled     = false
		letter.TextSize       = 14

		table.insert(_charmSlots, { tile = tile, letter = letter })
	end

	local charmButtonRow = row(30)
	local charms = Theme.button("Charms", charmButtonRow, "", Theme.COLORS.growth)
	charms.Size = UDim2.new(1, 0, 1, 0)
	_charmButton = charms
	charms.Activated:Connect(function()
		Unlock.markSeen("charms")
		local uid = _openUid
		if not uid then return end
		PanelManager.open("Charms", uid)
	end)

	-- ------------------------------------------------------------------- Werte
	column = rightColumn
	section("ui.baerchi.section_state")

	-- HP-Balken (steht bewusst ueber dem XP-Balken: ob der Baerchi kaempfen
	-- kann, ist die haeufigere Frage als wie weit er zum naechsten Level ist)
	local hpRow = row(22)
	local hp = Theme.progress(hpRow)
	hp.track.Size = UDim2.new(1, 0, 1, 0)
	_hpFill = hp.fill
	_hpText = hp.text

	-- XP-Balken
	local xpRow = row(22)
	local xp = Theme.progress(xpRow)
	xp.track.Size = UDim2.new(1, 0, 1, 0)
	_xpFill = xp.fill
	_xpText = xp.text

	-- HBB Paket 4: Einzelwerte (ATK/SPD/PWR) und Stat-Stufen in einem
	-- Aufklapper. Der Kampfwert oben ist die eine Zahl, die man meistens
	-- braucht; wer es genau wissen will, klappt auf. Ohne UI_V2_UPGRADE_TAB
	-- bleibt alles offen wie bisher.
	local detailRows: { Frame } = {}
	local toggleRow = row(26)
	local toggle = Theme.button("DetailsToggle", toggleRow, "", Theme.COLORS.panelLight)
	toggle.Size = UDim2.fromScale(1, 1)
	toggle.TextColor3 = Theme.COLORS.text
	local expanded = not FeatureFlags.isOn("UI_V2_UPGRADE_TAB")
	toggleRow.Visible = not expanded
	local function applyDetails()
		toggle.Text = (if expanded then "▾  " else "▸  ") .. Loc.t("ui.card.details")
		for _, detail in detailRows do
			detail.Visible = expanded
		end
	end
	toggle.Activated:Connect(function()
		expanded = not expanded
		applyDetails()
	end)

	-- Kampfwerte
	local statsRow = row(22)
	table.insert(detailRows, statsRow)
	_statsLabel = Theme.label("Stats", statsRow, "—")
	_statsLabel.Size      = UDim2.new(1, -34, 1, 0)
	_statsLabel.TextColor3 = Theme.COLORS.textDim

	-- Sammel-Update 05.10. (Paket 3.7, "Stats sind unintuitiv"): "?" zeigt
	-- je Stat einen kurzen Satz. Kein Dauertext, nur auf Antippen.
	local statHelpButton = Theme.button("StatHelp", statsRow, "?", Theme.COLORS.panelLight)
	statHelpButton.AnchorPoint = Vector2.new(1, 0.5)
	statHelpButton.Position = UDim2.new(1, 0, 0.5, 0)
	statHelpButton.Size = UDim2.fromOffset(30, 22)
	statHelpButton.TextColor3 = Theme.COLORS.text
	local helpRow = row(96)
	helpRow.Visible = false
	local helpText = Theme.bodyText("StatHelpText", helpRow, Loc.t("ui.stats.help"))
	helpText.Size = UDim2.fromScale(1, 1)
	helpText.TextColor3 = Theme.COLORS.text
	statHelpButton.Activated:Connect(function()
		helpText.Text = Loc.t("ui.stats.help")
		helpRow.Visible = not helpRow.Visible
	end)

	-- ------------------------------------------------------------- Stat-Level
	local statHeader = row(16)
	table.insert(detailRows, statHeader)
	local statHeaderLabel = Theme.sectionLabel("Section", statHeader, Loc.t("ui.stats.levels_head"))
	statHeaderLabel.Size = UDim2.fromScale(1, 1)

	for _, key in PromotionConfig.ALL_STATS do
		local statRow = row(20)
		table.insert(detailRows, statRow)
		local bar     = Theme.progress(statRow)
		bar.track.Size = UDim2.new(1, 0, 1, 0)
		bar.text.TextScaled = false
		bar.text.TextSize   = 13

		table.insert(_statRows, { key = key, fill = bar.fill, text = bar.text })
	end
	applyDetails()

	-- Skill
	section("ui.card.section_skill")
	local skillRow = row(40)
	_skillLabel = Theme.bodyText("Skill", skillRow, "—")
	_skillLabel.Size = UDim2.fromScale(1, 1)

	-- -------------------------------------------------------------------- Eier
	section("ui.baerchi.section_eggs")

	local eggRateRow = row(20)
	_eggRateLabel = Theme.label("EggRate", eggRateRow, "")
	_eggRateLabel.Size       = UDim2.fromScale(1, 1)
	_eggRateLabel.TextScaled = false
	_eggRateLabel.TextSize   = 14

	local eggChanceRow = row(20)
	_eggChanceLabel = Theme.label("EggChances", eggChanceRow, "")
	_eggChanceLabel.Size       = UDim2.fromScale(1, 1)
	_eggChanceLabel.TextScaled = false
	_eggChanceLabel.TextSize   = 13
	_eggChanceLabel.TextColor3 = Theme.COLORS.textDim

	local eggCountRow = row(18)
	_eggCountLabel = Theme.label("EggCount", eggCountRow, "")
	_eggCountLabel.Size       = UDim2.fromScale(1, 1)
	_eggCountLabel.TextScaled = false
	_eggCountLabel.TextSize   = 13

	local collectRow = row(30)
	local collect = Theme.button("CollectEggs", collectRow, Loc.t("ui.baerchi.collect_none"), Theme.COLORS.goldGummy)
	collect.Size = UDim2.new(1, 0, 1, 0)
	_collectButton = collect
	collect.Activated:Connect(function()
		-- Ohne uid: der Server nimmt alles, was gerade herumliegt. Einzelne
		-- Eier sammelt man durch Anklicken in der Welt ein (WorldController).
		Remotes.RequestCollectAllEggs:FireServer()
	end)

	-- ----------------------------------------------------------------- Aktionen
	section("ui.baerchi.section_actions")

	-- Verwertungs-Wert
	local valueRow = row(20)
	_valueLabel = Theme.label("Value", valueRow, "—")
	_valueLabel.Size       = UDim2.fromScale(1, 1)
	_valueLabel.TextColor3 = Theme.COLORS.textDim

	-- Ein Fuetter-Knopf pro Gebaeude statt eines einzigen: die drei liefern
	-- unterschiedlichen Honig, und welchen man verfuettert, ist seit v7 eine
	-- echte Entscheidung. Reihenfolge und Namen kommen aus MapConfig, die
	-- Farben aus Theme — dieselben wie auf den Karten im Gebaeude-Panel, damit
	-- man Knopf und Gebaeude sofort zusammenbringt.
	-- Sammel-Update 2.6: kein "Honig essen"-Klicken mehr (der Baerchi isst am
	-- Teich von selbst). Zeile und Knoepfe bleiben gebaut, aber unsichtbar —
	-- fill() greift weiter auf _feedButtons zu.
	local feedHint = row(18)
	feedHint.Visible = false
	local hint = Theme.label("FeedHint", feedHint, "")
	hint.Size       = UDim2.fromScale(1, 1)
	hint.TextColor3 = Theme.COLORS.textDim

	local feedRow = row(38)
	feedRow.Visible = false   -- Sammel-Update 2.6
	Theme.listLayout(feedRow, 6, true)

	for _, id in MapConfig.BUILDING_ORDER do
		-- Text und Verfuegbarkeit setzt fill() — hier steht nur ein Platzhalter,
		-- damit der Knopf nicht ohne Beschriftung aufblitzt.
		local button = Theme.button("Feed_" .. id, feedRow, "—", Theme.buildingColor(id))
		button.Size = UDim2.new(1 / 3, -6, 1, 0)

		button.Activated:Connect(function()
			local uid = _openUid
			if not uid then return end
			Remotes.RequestFeedHoney:FireServer(uid, id)
		end)

		_feedButtons[id] = button
	end

	-- Verwerten und Schliessen: beides beendet die Karte
	local exitRow = row(36)

	local recycle = Theme.button("Recycle", exitRow, Loc.t("ui.baerchi.recycle"), Theme.COLORS.panelLight)
	recycle.Size       = UDim2.new(1, 0, 1, 0)
	recycle.TextColor3 = Theme.COLORS.text
	_recycleButton = recycle
	recycle.Activated:Connect(function()
		Unlock.markSeen("recycling")
		local uid = _openUid
		if not uid then return end

		Remotes.RequestRecycleBaerchi:FireServer(uid)

		-- Sofort zumachen: bei Erfolg waere die Karte gleich leer, bei
		-- Ablehnung sagt es der Toast. Die Erfolgsmeldung kommt aus
		-- ResultFeed (RecycleResultReceived).
		BaerchiPanel.close()
	end)

	-- Schliessen
	local closeRow = row(34)
	local close = Theme.button("Close", closeRow, Loc.t("ui.common.close"), Theme.COLORS.panelLight)
	close.Size       = UDim2.new(1, 0, 1, 0)
	close.TextColor3 = Theme.COLORS.text
	close.Activated:Connect(BaerchiPanel.close)

	_root = root

	PanelManager.register(PANEL_NAME, {
		open  = showInternal,
		close = closeInternal,
	})

	-- Offene Karte mitziehen: XP steigt im Kampf, und ein verwerteter oder
	-- fusionierter Baerchi existiert nicht mehr — dann zumachen.
	ClientState.onChanged(function()
		local uid = _openUid
		if not uid then return end

		local baerchi = ClientState.getBaerchi(uid)
		if baerchi then
			fill(baerchi)
		else
			BaerchiPanel.close()
		end
	end)

	-- Sprachwechsel bei offener Karte: alle Texte aus fill() neu setzen
	Loc.onChanged(function()
		local uid = _openUid
		local baerchi = if uid then ClientState.getBaerchi(uid) else nil
		if baerchi then fill(baerchi) end
	end)

	Remotes.PromotionResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.PromotionResult

		if #typed.unlockedSlots > 0 then
			local numerals: { string } = {}
			for _, slot in typed.unlockedSlots do
				table.insert(numerals, CharmConfig.SLOT_NUMERALS[slot] or tostring(slot))
			end

			Notify.emit("promotion_slot", function()
				Toast.success(Loc.t("msg.promo_slot", {
					p = typed.newPromotion, max = PromotionConfig.MAX_PROMOTION,
					slots = table.concat(numerals, ", "),
				}))
			end, function()
				Moment.show("slot", Theme.COLORS.goldGummy, "ui.moment.new")
			end)
		else
			Notify.emit("promotion", function()
				Toast.success(Loc.t("msg.promo", { p = typed.newPromotion, max = PromotionConfig.MAX_PROMOTION }))
			end, function()
				Feedback.gain("star", typed.newPromotion)
			end)
		end
	end)

	Remotes.EggCollectedReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.EggCollectResult
		local eggName = Names.egg(typed.eggType)

		-- Leere eggUid heisst "alles auf einmal" (siehe EggLayService.collectAll):
		-- dann steht in inStock die ANZAHL der eingesammelten Eier, nicht der
		-- Lagerbestand einer Sorte.
		-- Neuer Weg: das Ei fliegt ueber den Datenstand zur Eier-Kachel
		-- (UI/Feedback), deshalb hier nur der alte Text.
		if typed.eggUid == "merchant" then
			-- Kauf beim versteckten Haendler (EggMerchantService)
			Notify.emit("egg_bought", function()
				Toast.success(Loc.t("msg.egg_bought", {
					egg = Names.egg(typed.eggType) }))
			end)
		elseif typed.eggUid == "" then
			Notify.emit("egg_collected_all", function()
				Toast.success(Loc.t("msg.eggs_collected_all", { n = typed.inStock }))
			end)
		else
			Notify.emit("egg_collected", function()
				Toast.success(Loc.t("msg.egg_collected", {
					egg = Names.egg(typed.eggType),
					n   = typed.inStock,
				}))
			end)
		end
	end)

	Remotes.OfflineEggReportReceived.OnClientEvent:Connect(function(report: any)
		if typeof(report) ~= "table" then return end
		local typed = report :: Types.OfflineEggReport

		Notify.emit("offline_eggs", function()
			-- Paket 6.1: "Lager voll", wenn die Offline-Grenze gegriffen hat
			if typed.laid <= 0 then
				Toast.info(Loc.t("msg.offline_eggs_full"))
			elseif typed.skipped then
				Toast.success(Loc.t("msg.offline_eggs", { n = typed.laid }) .. "  " .. Loc.t("msg.offline_eggs_full"))
			else
				Toast.success(Loc.t("msg.offline_eggs", { n = typed.laid }))
			end
		end, function()
			if typed.laid > 0 then
				ReturnSummary.addEggs(typed.secondsAway, typed.laid)
			end
		end)
	end)

	Remotes.EventStatGained.OnClientEvent:Connect(function(gain: any)
		if typeof(gain) ~= "table" then return end
		local typed = gain :: Types.EventStatGain

		-- Zwischenmeldung waehrend eines Events: nur der Text, kein "vorbei".
		if typed.midEvent then
			if typed.rarityUp then
				local rarity = typed.rarityUp :: string
				Notify.emit("event_mid_rarity", function()
					Toast.success(Loc.resolve(typed.bonusText or ""))
				end, function()
					Moment.show("rarity", Theme.rarityColor(rarity :: any), "ui.moment.rarity")
				end)
			elseif typed.bonusText then
				local text = typed.bonusText :: any
				Notify.emit("event_mid", function()
					Toast.info(Loc.resolve(text))
				end)
			end
			return
		end

		-- Die Meldung wird aus bis zu zwei Teilen zusammengesetzt: Stat-Stufe
		-- und Bonus. Beide koennen einzeln fehlen — `statKey` ist nil, wenn
		-- schon jeder Stat am Rarity-Cap steht (dann gab es nur den Bonus),
		-- `bonusText` fehlt bei den reinen Trainings-Events. Deshalb hier
		-- zusammensetzen statt eines festen Satzes.
		local eventDef  = EventConfig.getById(typed.eventId)
		local eventName = Names.event(typed.eventId)

		local parts: { string } = {}

		local statKey = typed.statKey
		if statKey then
			table.insert(parts, Loc.t("msg.event.stat_level", {
				stat = PromotionConfig.STAT_LABELS[statKey] or statKey,
				level = typed.newLevel, cap = typed.cap,
			}))
		end

		if typed.bonusText then
			table.insert(parts, Loc.resolve(typed.bonusText))
		end

		if #parts == 0 then
			table.insert(parts, Loc.t("msg.event.all_maxed"))
		end

		-- HBB Paket 1: neuer Weg = Mutation als grosser Moment, Stat-Stufe
		-- als Zahl ueber dem Baerchi. Eier/Gummies des Bonus fliegen ueber
		-- den Datenstand (UI/Feedback).
		Notify.emit("event_end", function()
			Toast.success(Loc.t("msg.event.ended", { event = eventName, text = table.concat(parts, "  •  ") }))
		end, function()
			local mutation = typed.mutation
			if mutation then
				Notify.emit("event_end_mutation", function() end, function()
					Moment.show("mutation", BaerchiConfig.getMutationColor(mutation), "ui.moment.mutation")
				end)
			end
			if statKey then
				Feedback.gain("stat", 1, nil, PromotionConfig.STAT_LABELS[statKey] or statKey)
			end
		end)
	end)

	print("[BaerchiPanel] Initialisiert")
end

return BaerchiPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX86"><Properties><string name="Name">BuildingPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- BuildingPanel.luau
-- StarterPlayerScripts/UI/BuildingPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Fuer JEDES Honig-Gebaeude ein eigenes Menue bauen und aktuell halten
--
-- v15: zwei Gebaeude (Bienenstock, Honig-Veredler), Level 1-60 mit Look-Stufe
-- und Meilenstein-Faehigkeiten. Das fruehere Menue der Kampfplattform
-- (PIT-Level) ist entfallen — die Tower-Wahl liegt im CombatPanel. Der Recycler
-- wird an seinem eigenen Prompt ausgebaut (CombController).
--
-- ============================================================
-- WARUM EIGENE MENUES STATT EINER LISTE
-- ============================================================
-- Bis v7 gab es EIN Panel mit drei untereinander gestapelten Karten. Das war
-- richtig, solange die drei Gebaeude dasselbe taten — man wollte sie ja
-- vergleichen. Seit jedes eine eigene Rolle hat (Vorrat / Heilung / Wachstum,
-- siehe Config/BuildingBehavior), vergleicht man nicht mehr, sondern
-- entscheidet sich: "ich brauche jetzt Heilung". Dafuer will man EIN Fenster
-- sehen, das ganz diesem Gebaeude gehoert — mit seiner Farbe, seinem Level und
-- seinem Honig, gross statt in einer Zeile.
--
-- Trotzdem gibt es nur DIESE eine Datei: sie baut viermal dasselbe Geruest mit
-- unterschiedlichen Farben und Inhalten. Drei fast gleiche Panel-Module waeren
-- dieselbe Dopplung, die dieses Projekt an anderen Stellen schon aufgeloest
-- hat.
--
-- Jedes Menue meldet sich unter PanelManager.buildingPanelName(id) an. Diesen
-- Namen benutzen auch die Menueleiste und der Prompt am Gebaeude in der Welt —
-- deshalb steht er im PanelManager und nicht hier.
--
-- ============================================================
-- OHNE HINLAUFEN BEDIENBAR
-- ============================================================
-- Jedes Menue kann BEIDES: ausbauen und den ausgeruesteten Baerchi mit dem
-- Honig genau dieses Gebaeudes fuettern. Zusammen mit den Knoepfen in der
-- Menueleiste heisst das: der Spieler muss zu keinem Gebaeude mehr hinlaufen.
-- Die Prompts in der Welt bleiben trotzdem — wer davorsteht, soll es auch
-- dort anklicken koennen.
--
-- Dieses Modul rechnet nichts aus und formuliert nichts selbst: Effekt-Saetze
-- kommen aus BuildingBehavior, Preise aus EconomyConfig, Namen aus MapConfig,
-- Farben aus Theme. Ein hier nachgebauter Text waere beim naechsten Balancing
-- sofort falsch.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local Names            = require(ReplicatedStorage.Localization.Names)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local EconomyConfig    = require(ReplicatedStorage.Config.EconomyConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local MapConfig        = require(ReplicatedStorage.Config.MapConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local BuildingPanel = {}

-- Feste Reihenfolge. Die Gebaeude in IslandData liegen in einer Hash-Tabelle
-- und kommen damit nicht stabil heraus.
--
-- Nur die ids stehen hier: Name kommt aus MapConfig (dasselbe Schild traegt
-- ihn in der Welt), Farbe aus Theme.buildingColor (dieselbe faerbt die
-- Fuetter-Knoepfe auf der Baerchi-Karte).
local BUILDINGS: { { id: Types.BuildingId } } = {
	{ id = "Beehive"      },
	{ id = "HoneyRefiner" },
	{ id = "HoneyPond"    },
}

-- Alles, was ein einzelnes Menue zum Aktualisieren braucht.
type Menu = {
	root       : Frame,
	title      : TextLabel,
	levelBadge : TextLabel,
	subLabel   : TextLabel,
	honeyFill  : Frame,
	honeyText  : TextLabel,
	nowText    : TextLabel,
	nextText   : TextLabel,
	priceText  : TextLabel,
	abilities  : TextLabel,
	upgrade    : TextButton,
	feed       : TextButton?,
}

local _menus: { [string]: Menu } = {}

--------------------------------------------------------------------------------
-- Hilfstexte
--------------------------------------------------------------------------------

local function displayName(buildingId: string): string
	return Names.building(buildingId)
end

-- v15: Meilenstein-Faehigkeiten als eine Zeile ("Lv.10 Auto-Abnahme ✓ ·
-- Lv.30 Goldene Tropfen (bald)").
local function abilitiesText(buildingId: string, level: number): string
	local parts: { string } = {}
	for _, ability in BuildingBehavior.getAbilities(buildingId) do
		local name = Loc.t("ability." .. ability.id)
		local state = if not ability.implemented then Loc.t("ui.ability.soon")
			elseif level >= ability.level then "✓"
			else ""
		table.insert(parts, string.format("Lv.%d %s %s", ability.level, name, state))
	end
	return table.concat(parts, "  ·  ")
end

local function priceText(costGummies: number, costGoldGummies: number): string
	local parts: { string } = {}

	if costGummies > 0 then
		table.insert(parts, Loc.t("event.bonus.gummies", { n = costGummies }))
	end
	if costGoldGummies > 0 then
		table.insert(parts, Loc.t("event.bonus.gold", { n = costGoldGummies }))
	end
	if #parts == 0 then
		return Loc.t("ui.common.free")
	end

	return table.concat(parts, " + ")
end

local function canPay(data: Types.PlayerDataUpdate, costGummies: number, costGoldGummies: number): boolean
	if costGummies > 0 and data.gummies < costGummies then return false end
	if costGoldGummies > 0 and data.goldGummies < costGoldGummies then return false end
	return true
end

--------------------------------------------------------------------------------
-- Das Geruest eines Menues
--------------------------------------------------------------------------------

-- Baut ein Menue in der Farbe `accent`. `withFeed` legt zusaetzlich den
-- Fuetter-Knopf an — die Kampfplattform hat keinen Honig.
local function buildMenu(
	screenGui: ScreenGui,
	panelName: string,
	title: string,
	accent: Color3,
	withFeed: boolean,
	onUpgrade: () -> (),
	onFeed: (() -> ())?
): Menu
	local root = Theme.dialog(
		panelName, screenGui,
		Vector2.new(0.40, 0.62),
		Vector2.new(300, 400),
		Vector2.new(440, 520)
	)

	-- Der Rand des ganzen Fensters traegt die Gebaeudefarbe: schon bevor man
	-- liest, sieht man welches Gebaeude offen ist.
	local outline = root:FindFirstChildOfClass("UIStroke")
	if outline then
		outline.Color = Theme.shade(accent, -0.35)
	end

	--------------------------------------------------------------------------
	-- Kopfbalken mit Verlauf
	--------------------------------------------------------------------------

	local header = Theme.panel("Banner", root, accent)
	header.Size     = UDim2.new(1, 0, 0, 74)
	header.Position = UDim2.fromScale(0, 0)
	Theme.gradient(header, Theme.shade(accent, 0.30), Theme.shade(accent, -0.18))

	-- Rundes Emblem mit der Stufe darin. Zwei Fliegen: es macht den Kopf bunt
	-- UND beantwortet die haeufigste Frage ("auf welcher Stufe bin ich?"),
	-- ohne dass man Text lesen muss.
	local badge = Theme.panel("Badge", header, Theme.shade(accent, -0.30))
	badge.AnchorPoint = Vector2.new(0, 0.5)
	badge.Position    = UDim2.new(0, 12, 0.5, 0)
	badge.Size        = UDim2.new(0, 50, 0, 50)
	Theme.corner(badge, 25)

	local levelBadge = Theme.label("Level", badge, "1")
	levelBadge.Size           = UDim2.fromScale(1, 1)
	levelBadge.TextXAlignment = Enum.TextXAlignment.Center

	local titleLabel = Theme.label("Title", header, title)
	titleLabel.Position   = UDim2.new(0, 72, 0, 12)
	titleLabel.Size       = UDim2.new(1, -118, 0, 30)
	titleLabel.TextColor3 = Theme.COLORS.outline

	local subLabel = Theme.sectionLabel("Sub", header, "", Theme.shade(accent, -0.45))
	subLabel.Position = UDim2.new(0, 72, 0, 42)
	subLabel.Size     = UDim2.new(1, -118, 0, 20)

	-- Gemeinsamer Schliessen-Knopf (grosse Trefferflaeche), oben rechts im Kopf
	local close = Theme.closeButton(header, function()
		PanelManager.close(panelName)
	end, Theme.shade(accent, -0.30))
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position    = UDim2.new(1, -10, 0, 10)

	--------------------------------------------------------------------------
	-- Inhalt
	--------------------------------------------------------------------------

	local body = Theme.container("Body", root)
	body.Position = UDim2.new(0, 0, 0, 74)
	body.Size     = UDim2.new(1, 0, 1, -74)
	Theme.padding(body, 14)

	local layout = Theme.listLayout(body, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local order = 0
	local function row(height: number): Frame
		order += 1
		local frame = Theme.container("Row", body)
		frame.Size        = UDim2.new(1, 0, 0, height)
		frame.LayoutOrder = order
		return frame
	end

	-- Sammel-Update 3.6: ein Satz, was Verbessern bringt
	local whyRow = row(34)
	local whyText = Theme.bodyText("Why", whyRow, Loc.t("ui.building.why"))
	whyText.Size = UDim2.fromScale(1, 1)
	whyText.TextColor3 = Theme.COLORS.goldGummy
	Loc.onChanged(function() whyText.Text = Loc.t("ui.building.why") end)

	-- Honig-Balken: der Wert, den man beim Reinschauen zuerst sucht.
	local honeyHead = row(18)
	Theme.sectionLabel("HoneyHead", honeyHead, Loc.t("ui.building.honey_head"), accent).Size = UDim2.fromScale(1, 1)

	local honeyRow  = row(26)
	local honeyBar  = Theme.progress(honeyRow, accent)
	honeyBar.track.Size = UDim2.new(1, 0, 1, 0)

	-- Was das Gebaeude JETZT kann
	local nowHead = row(18)
	Theme.sectionLabel("NowHead", nowHead, Loc.t("ui.building.now_head"), accent).Size = UDim2.fromScale(1, 1)

	local nowRow  = row(38)
	local nowText = Theme.bodyText("Now", nowRow, "")
	nowText.Size      = UDim2.fromScale(1, 1)
	nowText.TextColor3 = Theme.COLORS.text

	-- Was die naechste Stufe braechte
	local nextHead = row(18)
	Theme.sectionLabel("NextHead", nextHead, Loc.t("ui.building.next_head"), accent).Size = UDim2.fromScale(1, 1)

	local nextRow  = row(38)
	local nextText = Theme.bodyText("Next", nextRow, "")
	nextText.Size = UDim2.fromScale(1, 1)

	local priceRow   = row(22)
	local priceLabel = Theme.label("Price", priceRow, "")
	priceLabel.Size     = UDim2.fromScale(1, 1)
	priceLabel.TextSize = 16
	priceLabel.TextScaled = false

	-- v15: Meilenstein-Faehigkeiten dieses Gebaeudes
	local abilityRow  = row(30)
	local abilityText = Theme.bodyText("Abilities", abilityRow, "")
	abilityText.Size       = UDim2.fromScale(1, 1)
	abilityText.TextColor3 = Theme.COLORS.textDim

	-- Die Knoepfe ganz unten, in der Reihenfolge, in der man sie braucht.
	local upgradeRow = row(44)
	local upgrade    = Theme.bigButton("Upgrade", upgradeRow, Loc.t("ui.building.upgrade_button"), accent)
	upgrade.Size = UDim2.new(1, 0, 1, 0)
	upgrade.Activated:Connect(onUpgrade)

	local feedButton: TextButton? = nil
	if withFeed and onFeed then
		local feedRow = row(38)
		local feed    = Theme.bigButton("Feed", feedRow, Loc.t("ui.building.feed", { n = 0 }), Theme.shade(accent, -0.10))
		feed.Size = UDim2.new(1, 0, 1, 0)
		feed.Activated:Connect(onFeed)
		feedButton = feed
	end

	return {
		root       = root,
		title      = titleLabel,
		levelBadge = levelBadge,
		subLabel   = subLabel,
		honeyFill  = honeyBar.fill,
		honeyText  = honeyBar.text,
		nowText    = nowText,
		nextText   = nextText,
		priceText  = priceLabel,
		abilities  = abilityText,
		upgrade    = upgrade,
		feed       = feedButton,
	}
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

local function refreshBuilding(buildingId: Types.BuildingId)
	local menu = _menus[PanelManager.buildingPanelName(buildingId)]
	if not menu or not menu.root.Visible then return end

	local data = ClientState.get()
	if not data then return end

	local building = data.island.buildings[buildingId]
	local level    = if building then building.level else 1
	local honey    = if building then (building.honey or 0) else 0
	local capacity = math.max(1, BuildingBehavior.getCapacity(buildingId, level))

	menu.levelBadge.Text = tostring(level)
	menu.subLabel.Text   = Loc.t("ui.building.level_look", {
		level = level, max = EconomyConfig.MAX_BUILDING_LEVEL, look = BuildingBehavior.getLook(level),
	})
	menu.abilities.Text  = abilitiesText(buildingId, level)

	menu.honeyFill.Size = UDim2.fromScale(math.clamp(honey / capacity, 0, 1), 1)
	menu.honeyText.Text = string.format("%d / %d", honey, capacity)

	menu.nowText.Text = BuildingBehavior.describeEffect(buildingId, level)

	local next_ = BuildingBehavior.getUpgrade(buildingId, level + 1)

	if next_ then
		local affordable = canPay(data, next_.costGummies, next_.costGoldGummies)

		menu.nextText.Text   = next_.effect
		menu.priceText.Text  = priceText(next_.costGummies, next_.costGoldGummies)
		menu.priceText.TextColor3 = if affordable then Theme.COLORS.good else Theme.COLORS.bad

		menu.upgrade.Text = Loc.t("ui.building.upgrade_button")
		Theme.setEnabled(menu.upgrade, affordable)
	else
		menu.nextText.Text        = Loc.t("ui.building.max")
		menu.priceText.Text       = ""
		menu.upgrade.Text         = Loc.t("ui.building.maxed_button")
		Theme.setEnabled(menu.upgrade, false)
	end

	local feed = menu.feed
	if feed then
		feed.Text = Loc.t("ui.building.feed", { n = honey })
		Theme.setEnabled(feed, honey > 0 and data.island.equippedUid ~= nil)
	end
end

-- Oeffentlich, damit ClientState alle Menues auf einmal nachziehen kann.
function BuildingPanel.refresh()
	for _, entry in BUILDINGS do
		refreshBuilding(entry.id)
	end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function BuildingPanel.init(screenGui: ScreenGui)
	for _, entry in BUILDINGS do
		local id        = entry.id
		local panelName = PanelManager.buildingPanelName(id)

		-- Sammel-Update 2.6: kein "Honig fuettern"-Knopf mehr — der Baerchi
		-- isst selbst (BaerchiAutopilotService). RequestFeedHoney bleibt als
		-- Remote bestehen, nur die Oberflaeche dazu entfaellt.
		local menu = buildMenu(
			screenGui, panelName, displayName(id), Theme.buildingColor(id), false,
			function()
				Remotes.RequestUpgradeBuilding:FireServer(id)
			end,
			function()
				-- Gefuettert wird immer der ausgeruestete Baerchi: nur der steht
				-- in der Welt, und nur er kaempft. Wer einen anderen meint,
				-- ruestet ihn erst aus — dieselbe Regel wie beim Autopiloten.
				local data = ClientState.get()
				local uid  = if data then data.island.equippedUid else nil
				if not uid then return end

				Remotes.RequestFeedHoney:FireServer(uid, id)
			end
		)

		_menus[panelName] = menu

		PanelManager.register(panelName, {
			open = function()
				menu.root.Visible = true
				refreshBuilding(id)
			end,
			close = function()
				menu.root.Visible = false
			end,
		})
	end

	ClientState.onChanged(function()
		BuildingPanel.refresh()
	end)
	-- Sprachwechsel: Titel und alle Zeilen der offenen Menues neu beschriften
	Loc.onChanged(function()
		for _, entry in BUILDINGS do
			local menu = _menus[PanelManager.buildingPanelName(entry.id)]
			if menu then menu.title.Text = displayName(entry.id) end
		end
		BuildingPanel.refresh()
	end)

	print("[BuildingPanel] Initialisiert |", #BUILDINGS, "Gebaeude-Menues")
end

return BuildingPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX87"><Properties><string name="Name">CharmPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- CharmPanel.luau
-- StarterPlayerScripts/UI/CharmPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die acht Battle-Charm-Slots eines Baerchis zeigen
--   - Einzelne Slots sperren/freigeben und alle offenen neu wuerfeln
--
-- Wird aus der Baerchi-Detailkarte geoeffnet (Knopf "Charms") und bekommt die
-- uid dabei uebergeben — genau wie BaerchiPanel selbst. Eigene Auswahl haelt
-- dieses Panel nicht.
--
-- ============================================================
-- WAS DIE "PROMOTION TIERS"-LISTE HIER IST — UND WAS NICHT
-- ============================================================
-- Sie zeigt AUSSCHLIESSLICH, ab welcher Promotions-Stufe ein Slot benutzbar
-- wird. Sie sagt NICHT, welcher Stat in einem Slot sitzt: die Slots sind nicht
-- an einen Stat-Typ gebunden, jeder Wurf wuerfelt Rarity UND Stat neu (siehe
-- CharmConfig, Kopf-Kommentar). Wer hier eine Spalte "Bonus" vermisst: die
-- gibt es bewusst nicht.
--
-- Der Server bleibt in jedem Fall autoritativ. Ausgegraute Knoepfe sind nur
-- die freundliche Vorwarnung — abgelehnt wird serverseitig (→ Toast).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Loc             = require(ReplicatedStorage.Localization.Loc)   -- Sammel-Update 2.4
local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local CharmConfig     = require(ReplicatedStorage.Config.CharmConfig)
local PromotionConfig = require(ReplicatedStorage.Config.PromotionConfig)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Loc          = require(ReplicatedStorage.Localization.Loc)
local Names        = require(ReplicatedStorage.Localization.Names)

local CharmPanel = {}

local PANEL_NAME = "Charms"

local _root: Frame?          = nil
local _openUid: string?      = nil
local _titleLabel: TextLabel? = nil
local _hintLabel: TextLabel?  = nil
local _costLabel: TextLabel?  = nil
local _rollButton: TextButton? = nil
local _autoButton: TextButton? = nil

-- Ein Eintrag pro Slot: der Knopf (= Sperr-Umschalter) und seine Beschriftung.
type SlotWidget = {
	slot    : number,
	button  : TextButton,
	letter  : TextLabel,
	lockDot : Frame,
	detail  : TextLabel,
}

local _slots: { SlotWidget } = {}

--------------------------------------------------------------------------------
-- Lesen
--------------------------------------------------------------------------------

local function findCharm(baerchi: Types.Baerchi, slot: number): Types.Charm?
	-- `or {}`: ein Datenpaket von einem aelteren Serverstand haette das Feld
	-- nicht. Die Zuweisung an eine typisierte Variable statt direkt in die
	-- Schleife, damit der Typ dabei nicht verloren geht.
	local charms: { Types.Charm } = baerchi.charms or {}

	for _, charm in charms do
		if charm.slot == slot then
			return charm
		end
	end
	return nil
end

-- Dieselbe Bedingung, nach der CharmService.getRollableSlots wuerfelt.
local function countRollable(baerchi: Types.Baerchi): number
	local count = 0
	for slot = 1, CharmConfig.SLOT_COUNT do
		if CharmConfig.isSlotUnlocked(slot, baerchi.promotionLevel or 0) then
			local charm = findCharm(baerchi, slot)
			if not (charm and charm.locked) then
				count += 1
			end
		end
	end
	return count
end

--------------------------------------------------------------------------------
-- Fuellen
--------------------------------------------------------------------------------

local function fill(baerchi: Types.Baerchi)
	local data      = ClientState.get()
	local promotion = baerchi.promotionLevel or 0

	if _titleLabel then
		_titleLabel.Text = Loc.t("ui.charm.title_baerchi", {
			name = Names.baerchi(baerchi.configId),
			p    = promotion,
			max  = PromotionConfig.MAX_PROMOTION,
		})
	end

	for _, widget in _slots do
		local unlocked = CharmConfig.isSlotUnlocked(widget.slot, promotion)
		local charm    = if unlocked then findCharm(baerchi, widget.slot) else nil

		if not unlocked then
			widget.button.BackgroundColor3 = Theme.COLORS.disabled
			widget.letter.Text             = "-"
			widget.letter.TextColor3       = Theme.COLORS.textDim
			widget.lockDot.Visible         = false
			widget.detail.Text = Loc.t("ui.charm.unlock_at", { n = CharmConfig.getUnlockPromotion(widget.slot) })
			widget.detail.TextColor3 = Theme.COLORS.textDim

		elseif not charm then
			widget.button.BackgroundColor3 = Theme.COLORS.panelLight
			widget.letter.Text             = "?"
			widget.letter.TextColor3       = Theme.COLORS.text
			widget.lockDot.Visible         = false
			widget.detail.Text             = Loc.t("ui.charm.empty_slot")
			widget.detail.TextColor3       = Theme.COLORS.textDim

		else
			local color = CharmConfig.RARITY_COLORS[charm.rarity] or Theme.COLORS.panelLight

			widget.button.BackgroundColor3 = color
			widget.letter.Text             = CharmConfig.RARITY_LETTER[charm.rarity] or "?"
			widget.letter.TextColor3       = Theme.COLORS.outline
			widget.lockDot.Visible         = charm.locked
			widget.detail.Text             = CharmConfig.describe(charm)
			widget.detail.TextColor3       = color
		end
	end

	local rollable = countRollable(baerchi)
	local gold     = if data then data.goldGummies else 0
	local cost     = CharmConfig.ROLL_COST_GOLD_GUMMIES

	if _costLabel then
		_costLabel.Text = Loc.t("ui.charm.cost", { gold = gold, cost = cost })
		_costLabel.TextColor3 = if gold >= cost then Theme.COLORS.goldGummy else Theme.COLORS.bad
	end

	if _hintLabel then
		if rollable == 0 then
			_hintLabel.Text = Loc.t("ui.charm.all_locked")
		else
			_hintLabel.Text = Loc.t("ui.charm.roll_hint", { n = rollable })
		end
	end

	local canRoll = rollable > 0 and gold >= cost
	if _rollButton then Theme.setEnabled(_rollButton, canRoll) end
	if _autoButton then Theme.setEnabled(_autoButton, canRoll) end
end

function CharmPanel.refresh()
	local root = _root
	if not root or not root.Visible then return end

	local uid = _openUid
	if not uid then return end

	local baerchi = ClientState.getBaerchi(uid)
	if baerchi then
		fill(baerchi)
	else
		PanelManager.close(PANEL_NAME)
	end
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local argument = ...
	if typeof(argument) ~= "string" then return end

	local uid = argument :: string
	if not ClientState.getBaerchi(uid) then
		PanelManager.close(PANEL_NAME)
		return
	end

	_openUid = uid

	local root = _root
	if root then root.Visible = true end

	CharmPanel.refresh()
end

local function closeInternal()
	_openUid = nil
	local root = _root
	if root then root.Visible = false end
end

function CharmPanel.show(uid: string)
	if not ClientState.getBaerchi(uid) then return end
	PanelManager.open(PANEL_NAME, uid)
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function CharmPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"CharmPanel", screenGui,
		Vector2.new(0.50, 0.66),
		Vector2.new(320, 420),
		Vector2.new(560, 620)
	)
	_root = root

	_titleLabel = Theme.dialogHeader(root, Loc.t("ui.card.section_charms"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	-- Die acht Slot-Kacheln in zwei Reihen zu vier. Eine Reihe zu acht waere
	-- auf einem Handy zu schmal zum Antippen.
	local slotArea = Theme.container("Slots", body)
	slotArea.Size = UDim2.new(1, 0, 0, 118)

	local grid = Instance.new("UIGridLayout")
	grid.CellSize      = UDim2.new(0.25, -6, 0, 54)
	grid.CellPadding   = UDim2.new(0, 6, 0, 8)
	grid.SortOrder     = Enum.SortOrder.LayoutOrder
	grid.FillDirection = Enum.FillDirection.Horizontal
	grid.Parent        = slotArea

	for slot = 1, CharmConfig.SLOT_COUNT do
		local button = Theme.button("Slot_" .. slot, slotArea, "", Theme.COLORS.panelLight)
		button.LayoutOrder = slot
		button.Text        = ""

		local letter = Theme.label("Letter", button, CharmConfig.SLOT_NUMERALS[slot])
		letter.Size           = UDim2.new(1, 0, 0, 26)
		letter.Position       = UDim2.new(0, 0, 0, 4)
		letter.TextXAlignment = Enum.TextXAlignment.Center
		letter.TextColor3     = Theme.COLORS.outline

		local numeral = Theme.label("Numeral", button, CharmConfig.SLOT_NUMERALS[slot])
		numeral.Size           = UDim2.new(1, 0, 0, 16)
		numeral.Position       = UDim2.new(0, 0, 1, -20)
		numeral.TextXAlignment = Enum.TextXAlignment.Center
		numeral.TextScaled     = false
		numeral.TextSize       = 12
		numeral.TextColor3     = Theme.COLORS.outline

		-- Kleines Schloss-Zeichen oben rechts: gesperrte Slots wuerfelt ein
		-- Wurf nicht mit.
		local lockDot = Theme.panel("Lock", button, Theme.COLORS.outline)
		lockDot.AnchorPoint = Vector2.new(1, 0)
		lockDot.Position    = UDim2.new(1, -2, 0, 2)
		lockDot.Size        = UDim2.new(0, 16, 0, 16)
		lockDot.Visible     = false
		lockDot.ZIndex      = 3
		Theme.corner(lockDot, 8)

		local lockText = Theme.label("Text", lockDot, "")
		Loc.bind(lockText, "ui.charm.lock_letter")
		lockText.Size           = UDim2.fromScale(1, 1)
		lockText.TextXAlignment = Enum.TextXAlignment.Center
		lockText.TextScaled     = false
		lockText.TextSize       = 11
		lockText.ZIndex         = 4

		button.Activated:Connect(function()
			local uid = _openUid
			if not uid then return end
			Remotes.RequestToggleCharmLock:FireServer(uid, slot)
		end)

		table.insert(_slots, {
			slot    = slot,
			button  = button,
			letter  = letter,
			lockDot = lockDot,
			detail  = Theme.label("Detail_" .. slot, body, ""),   -- Position unten
		})
	end

	-- Die Effekt-Zeilen unter den Kacheln: eine pro Slot, scrollbar, damit acht
	-- Zeilen auch auf einem kleinen Bildschirm vollstaendig lesbar bleiben.
	local list = Theme.scroller("Effects", body)
	list.Position = UDim2.new(0, 0, 0, 126)
	list.Size     = UDim2.new(1, 0, 1, -126 - 92)
	Theme.listLayout(list, 3)

	for _, widget in _slots do
		local row = Theme.container("Row_" .. widget.slot, list)
		-- Sammel-Update 2.5 ("Charm Text der Effekte groesser"): 13 -> 18 px,
		-- Zeile 20 -> 28 px, mit duenner dunkler Kontur fuer den Kontrast auf
		-- dem farbigen Text (Rarity-Farben sind teils hell).
		row.Size        = UDim2.new(1, -8, 0, 28)
		row.LayoutOrder = widget.slot

		local numeral = Theme.label("Num", row, CharmConfig.SLOT_NUMERALS[widget.slot])
		numeral.Size       = UDim2.new(0, 44, 1, 0)
		numeral.TextScaled = false
		numeral.TextSize   = 17
		numeral.TextColor3 = Theme.COLORS.textDim

		widget.detail.Parent         = row
		widget.detail.Position       = UDim2.new(0, 48, 0, 0)
		widget.detail.Size           = UDim2.new(1, -48, 1, 0)
		widget.detail.TextScaled     = false
		widget.detail.TextSize       = 18
		widget.detail.TextWrapped    = true
		widget.detail.TextXAlignment = Enum.TextXAlignment.Left
		widget.detail.TextStrokeTransparency = 0.55
		widget.detail.TextStrokeColor3       = Theme.COLORS.outline
	end

	-- Fusszeile: Bestand, Hinweis, zwei Knoepfe.
	local footer = Theme.container("Footer", body)
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Position    = UDim2.new(0, 0, 1, 0)
	footer.Size        = UDim2.new(1, 0, 0, 88)

	_costLabel = Theme.label("Cost", footer, "")
	_costLabel.Size       = UDim2.new(1, 0, 0, 20)
	_costLabel.TextScaled = false
	_costLabel.TextSize   = 14

	_hintLabel = Theme.bodyText("Hint", footer, "")
	_hintLabel.Position = UDim2.new(0, 0, 0, 22)
	_hintLabel.Size     = UDim2.new(1, 0, 0, 26)

	local roll = Theme.button("Roll", footer, Loc.t("ui.charm.roll"), Theme.COLORS.gummy)
	roll.Position = UDim2.new(0, 0, 0, 52)
	roll.Size     = UDim2.new(0.5, -4, 0, 34)
	_rollButton = roll
	roll.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Remotes.RequestRollCharms:FireServer(uid, 1)
	end)

	local auto = Theme.button("AutoRoll", footer, "", Theme.COLORS.goldGummy)
	Loc.bind(auto, "ui.charm.auto_roll", { n = CharmConfig.AUTO_ROLL_COUNT })
	auto.AnchorPoint = Vector2.new(1, 0)
	auto.Position    = UDim2.new(1, 0, 0, 52)
	auto.Size        = UDim2.new(0.5, -4, 0, 34)
	_autoButton = auto
	auto.Activated:Connect(function()
		local uid = _openUid
		if not uid then return end
		Remotes.RequestRollCharms:FireServer(uid, CharmConfig.AUTO_ROLL_COUNT)
	end)

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	ClientState.onChanged(function()
		CharmPanel.refresh()
	end)
	Loc.onChanged(function()
		CharmPanel.refresh()
	end)

	Remotes.CharmRollResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.CharmRollResult

		Notify.emit("charm_roll", function()
			Toast.success(Loc.tn("msg.charm_rolled", typed.rolls, { gold = typed.goldGummiesSpent }))
		end)

		CharmPanel.refresh()
	end)

	print("[CharmPanel] Initialisiert |", CharmConfig.SLOT_COUNT, "Slots")
end

return CharmPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX88"><Properties><string name="Name">CombatPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- CombatPanel.luau
-- StarterPlayerScripts/UI/CombatPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die Tower-Wahl zeigen (v15): eine Karte pro Tower mit Look-Farbe,
--     Rekord, Deckel des aktuellen Rebirths und naechstem Meilenstein
--   - Nach einem Lauf eine kurze Ergebnis-Meldung zeigen (Toast), am Deckel den
--     Rebirth-Hinweis mit Knopf zum RebirthDialog, und Meilenstein-Toasts
--
-- Gestartet und zurueckgeholt wird weiterhin ueber den Fight-Knopf der unteren
-- Pet-Leiste (PetBar). Dieses Panel waehlt nur, WOHIN er schickt
-- (RequestSelectTower). Ob ein Tower offen ist, prueft der Server; die Karten
-- rechnen mit denselben Funktionen aus TowerConfig nur fuer die Anzeige.
--
-- Der Ergebnis-Listener haengt am Modul, nicht am Panel: ein Lauf soll seine
-- Meldung auch bringen, wenn das Panel zu ist.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local Loc         = require(ReplicatedStorage.Localization.Loc)
local Names       = require(ReplicatedStorage.Localization.Names)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local EggConfig   = require(ReplicatedStorage.Config.EggConfig)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local Moment       = require(script.Parent.Moment)
local PanelManager = require(script.Parent.PanelManager)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local Icons        = require(script.Parent.Icons)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local CombatPanel = {}

local PANEL_NAME   = "Combat"
local REBIRTH_PANEL = "Rebirth"
local CARD_HEIGHT  = 78

type Card = {
	frame  : Frame,
	stroke : UIStroke?,
	title  : TextLabel,
	info   : TextLabel,
	button : TextButton,
}

local _root: Frame?        = nil
local _info: TextLabel?    = nil
local _hint: Frame?        = nil
local _cards: { [string]: Card } = {}

-- HBB Paket 2: bezahlter Wiedereinstieg ab der letzten Stage als kleiner
-- Knopf (frueher eine Option im PitResumeDialog). Der kostenlose Einstieg
-- ab 65 % laeuft jetzt ohne Frage ueber den Fight-Knopf.
local _resume: TextButton? = nil
local _resumeHint: TextLabel? = nil

local function refreshResume(data: Types.PlayerDataUpdate)
	local button, hintText = _resume, _resumeHint
	if not button or not hintText then return end
	local reached = PitResumeDialog.getProgress(data)
	local towerId = if data.towers then data.towers.selected else TowerConfig.FIRST_TOWER
	local cost = if reached then TowerConfig.getResumeCost(towerId, reached, data.rebirthMult) else 0
	local show = FeatureFlags.isOn("UI_V2_GUIDE") and reached ~= nil and reached > 1 and cost > 0
	button.Visible = show
	hintText.Visible = not show
	if show then
		button.Text = string.format("⏩ %d   %s", reached :: number, Theme.formatNumber(cost))
		Theme.setEnabled(button, cost <= data.gummies)
	end
end

--------------------------------------------------------------------------------
-- Karten
--------------------------------------------------------------------------------

local function towerName(def: TowerConfig.TowerDef): string
	return Loc.t("tower." .. def.id .. ".name")
end

local function buildCard(parent: Instance, def: TowerConfig.TowerDef, order: number): Card
	local frame = Theme.panel("Tower_" .. def.id, parent, Theme.COLORS.panel)
	frame.Size        = UDim2.new(1, -8, 0, CARD_HEIGHT)
	frame.LayoutOrder = order

	-- Farbstreifen links in der Look-Farbe des Towers
	local stripe = Theme.panel("Stripe", frame, def.color)
	stripe.Size     = UDim2.new(0, 14, 1, -12)
	stripe.Position = UDim2.new(0, 6, 0, 6)

	local title = Theme.label("Title", frame, "")
	title.Position   = UDim2.new(0, 28, 0, 6)
	title.Size       = UDim2.new(1, -150, 0, 26)
	title.TextColor3 = Theme.shade(def.color, -0.1)
	Theme.outlineText(title)

	local info = Theme.bodyText("Info", frame, "")
	info.Position = UDim2.new(0, 28, 0, 34)
	info.Size     = UDim2.new(1, -150, 0, CARD_HEIGHT - 38)
	info.TextSize = 13

	local button = Theme.bigButton("Choose", frame, "", def.color)
	button.AnchorPoint = Vector2.new(1, 0.5)
	button.Position    = UDim2.new(1, -10, 0.5, 0)
	button.Size        = UDim2.new(0, 110, 0, 40)
	button.Activated:Connect(function()
		if not button.Active then return end
		Remotes.RequestSelectTower:FireServer(def.id)
	end)

	return {
		frame  = frame,
		stroke = frame:FindFirstChildOfClass("UIStroke"),
		title  = title,
		info   = info,
		button = button,
	}
end

local function refreshCard(card: Card, def: TowerConfig.TowerDef, data: Types.PlayerDataUpdate)
	local towers = data.towers
	local record = if towers then towers.records[def.id] or 0 else 0
	local cap    = TowerConfig.getStageCap(data.rebirthCount, def.id, if towers then towers.records else nil)
	local open   = cap > 0
	local selected = towers ~= nil and towers.selected == def.id
	local endless = def.id == "Endless"   -- HBB Paket 9: ohne Obergrenze

	card.title.Text = if endless then towerName(def) else string.format("%s  (%d)", towerName(def), def.stages)

	if open then
		local claimed = if towers then towers.claimed[def.id] else nil
		local nextStage = TowerConfig.nextMilestoneStage(def.id, claimed, record + 1)
		local lines = {
			if endless
				then Loc.t("ui.tower.record_endless", { record = record })
				else Loc.t("ui.tower.record_cap", { record = record, cap = cap, stages = def.stages }),
		}
		if nextStage then
			table.insert(lines, Loc.t("ui.tower.next_milestone", { stage = nextStage }))
		end
		card.info.Text = table.concat(lines, "\n")
		card.button.Text = if selected then Loc.t("ui.tower.selected") else Loc.t("ui.tower.choose")
		Theme.setEnabled(card.button, not selected)
	else
		card.info.Text = if endless
			then Loc.t("ui.tower.locked_endless")
			else Loc.t("ui.tower.locked", { rebirths = TowerConfig.getOpeningRebirth(def.id) })
		card.button.Text = Loc.t("ui.tower.locked_short")
		Theme.setEnabled(card.button, false)
	end

	local stroke = card.stroke
	if stroke then
		stroke.Color     = if selected then Theme.COLORS.good else Theme.COLORS.outline
		stroke.Thickness = if selected then Theme.OUTLINE_THICKNESS + 2 else Theme.OUTLINE_THICKNESS
	end
end

function CombatPanel.refresh()
	local root = _root
	if not root or not root.Visible then return end

	local data = ClientState.get()
	if not data then return end

	local capTower, capStage = TowerConfig.getCap(data.rebirthCount)
	local capDef = TowerConfig.get(capTower) or TowerConfig.TOWERS[1]
	local info = _info
	if info then
		info.Text = Loc.t("ui.tower.cap_line", { rebirths = data.rebirthCount, tower = towerName(capDef), stage = capStage })
	end

	refreshResume(data)

	for _, def in TowerConfig.TOWERS do
		local card = _cards[def.id]
		if card then refreshCard(card, def, data) end
	end
end

--------------------------------------------------------------------------------
-- Ergebnis des Laufs
--------------------------------------------------------------------------------

local function showCapHint(result: Types.PitRunResult)
	local hint = _hint
	if not hint then return end
	local label = hint:FindFirstChild("Text")
	if label and label:IsA("TextLabel") then
		label.Text = Loc.t("ui.tower.cap_reached", { stage = result.capStage or 0 })
	end
	hint.Visible = true
	task.delay(12, function()
		hint.Visible = false
	end)
end

local function showResult(result: Types.PitRunResult)
	local cleared = result.stagesCleared or 0
	local def = TowerConfig.get(result.towerId or "") or TowerConfig.TOWERS[1]
	local parts = {
		"Tower " .. def.numeral,
		Loc.tn("msg.tower_cleared", cleared),
		"+" .. Theme.formatNumber(result.gummiesWon or 0) .. " Gummies",
	}
	if (result.goldGummiesWon or 0) > 0 then
		table.insert(parts, "+" .. Theme.formatNumber(result.goldGummiesWon) .. " GoldGummies")
	end
	if result.newRecord then
		table.insert(parts, Loc.t("msg.tower_new_record", { stage = result.newRecord }))
	end
	if result.recalled then
		table.insert(parts, Loc.t("msg.tower_recalled"))
	end

	local text = table.concat(parts, "  •  ")
	-- Gummies/GoldGummies fliegen ueber den Datenstand (UI/Feedback); der
	-- neue Rekord ist der Moment, den man sehen soll.
	Notify.emit("tower_result", function()
		if cleared > 0 then Toast.success(text) else Toast.info(text) end
	end, function()
		if result.newRecord then
			Notify.emit("tower_record", function() end, function()
				Moment.show("record", Theme.COLORS.goldGummy, "ui.moment.record")
			end)
		end
	end)

	if result.capReached then
		showCapHint(result)
	end
end

local function showMilestone(reward: Types.TowerMilestoneReward)
	local def = TowerConfig.get(reward.towerId) or TowerConfig.TOWERS[1]
	local parts: { string } = {}
	if reward.gummies > 0 then table.insert(parts, "+" .. Theme.formatNumber(reward.gummies) .. " Gummies") end
	if reward.goldGummies > 0 then table.insert(parts, "+" .. Theme.formatNumber(reward.goldGummies) .. " GoldGummies") end
	if reward.eggType and reward.eggs > 0 then
		table.insert(parts, string.format("+%d %s", reward.eggs, Names.egg(reward.eggType)))
	end
	if reward.blueprints > 0 then table.insert(parts, Loc.t("msg.tower_blueprint")) end
	if (reward.endlessLevels or 0) > 0 then
		table.insert(parts, Loc.t("msg.tower_endless_level", { n = reward.endlessLevels or 0 }))
	end
	Notify.emit("tower_milestone", function()
		Toast.success(Loc.t("msg.tower_milestone", { tower = def.numeral, stage = reward.stage, reward = table.concat(parts, ", ") }))
	end, function()
		Moment.show("milestone", Theme.COLORS.goldGummy, "ui.moment.milestone")
	end)
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local root = _root
	if not root then return end

	root.Visible = true
	CombatPanel.refresh()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function CombatPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"CombatPanel", screenGui,
		Vector2.new(0.50, 0.70),
		Vector2.new(320, 420),
		Vector2.new(560, 600)
	)
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.tower.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	local info = Theme.bodyText("Info", body, "")
	info.Size = UDim2.new(1, -8, 0, 34)
	_info = info

	local scroller = Theme.scroller("List", body)
	scroller.Position = UDim2.new(0, 0, 0, 38)
	scroller.Size     = UDim2.new(1, 0, 1, -84)

	local layout = Theme.listLayout(scroller, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	for order, def in TowerConfig.TOWERS do
		_cards[def.id] = buildCard(scroller, def, order)
	end

	local hintText = Theme.bodyText("Hint", body, Loc.t("ui.tower.hint"))
	hintText.AnchorPoint = Vector2.new(0.5, 1)
	hintText.Position    = UDim2.new(0.5, 0, 1, 0)
	hintText.Size        = UDim2.new(1, -8, 0, 40)
	_resumeHint = hintText

	local resume = Theme.bigButton("ResumeLast", body, "", Theme.COLORS.goldGummy)
	resume.AnchorPoint = Vector2.new(0.5, 1)
	resume.Position    = UDim2.new(0.5, 0, 1, -2)
	resume.Size        = UDim2.new(0, 200, 0, 40)
	resume.Visible     = false
	if Icons.has("gummy") then
		local coin = Icons.make(resume, "gummy")
		coin.AnchorPoint = Vector2.new(1, 0.5)
		coin.Position    = UDim2.new(1, -6, 0.5, 0)
		coin.Size        = UDim2.fromOffset(28, 28)
		coin.ZIndex      = 4
	end
	resume.Activated:Connect(function()
		if not resume.Active then return end
		Remotes.RequestPetMode:FireServer("Fight", "Last")
		PanelManager.close(PANEL_NAME)
	end)
	_resume = resume

	-- Rebirth-Hinweis am Deckel: eigenes kleines Fenster unten in der Mitte,
	-- unabhaengig davon, ob das Panel offen ist.
	local hint = Theme.panel("CapHint", screenGui, Theme.COLORS.panel)
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position    = UDim2.new(0.5, 0, 1, -110)
	hint.Size        = UDim2.fromOffset(420, 70)
	hint.Visible     = false
	hint.ZIndex      = 15
	_hint = hint

	local hintLabel = Theme.bodyText("Text", hint, "")
	hintLabel.Position = UDim2.new(0, 10, 0, 8)
	hintLabel.Size     = UDim2.new(1, -140, 1, -16)
	hintLabel.TextColor3 = Theme.COLORS.text

	local rebirthButton = Theme.bigButton("Rebirth", hint, Loc.t("ui.tower.to_rebirth"), Theme.COLORS.goldGummy)
	rebirthButton.AnchorPoint = Vector2.new(1, 0.5)
	rebirthButton.Position    = UDim2.new(1, -10, 0.5, 0)
	rebirthButton.Size        = UDim2.new(0, 116, 0, 44)
	rebirthButton.Activated:Connect(function()
		hint.Visible = false
		PanelManager.open(REBIRTH_PANEL)
	end)

	-- 08.10. (Paket D): mit TOWER_PANEL_V2 meldet sich das neue Tower-Panel
	-- (UI/TowerPanel) unter demselben Namen an; dieses Fenster bleibt dann
	-- unsichtbar, die Ergebnis-/Meilenstein-Meldungen unten laufen weiter.
	if not FeatureFlags.isOn("TOWER_PANEL_V2") then
		PanelManager.register(PANEL_NAME, {
			open  = openInternal,
			close = closeInternal,
		})
	end

	ClientState.onChanged(function()
		CombatPanel.refresh()
	end)

	Loc.onChanged(function()
		CombatPanel.refresh()
	end)

	Remotes.CombatResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.PitRunResult

		-- Auf dem Hinweg zurueckgeholt: es gab keinen Kampf.
		if typed.recalled and (typeof(typed.stages) ~= "table" or #typed.stages == 0) then
			return
		end

		showResult(typed)
	end)

	Remotes.TowerMilestoneReceived.OnClientEvent:Connect(function(reward: any)
		if typeof(reward) ~= "table" then return end
		showMilestone(reward :: Types.TowerMilestoneReward)
	end)

	print("[CombatPanel] Initialisiert |", #TowerConfig.TOWERS, "Tower")
end

return CombatPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX89"><Properties><string name="Name">CurrencyHint</string><ProtectedString name="Source"><![CDATA[--!strict
-- CurrencyHint.luau
-- StarterPlayerScripts/UI/CurrencyHint.luau
--
-- Einzige Zustaendigkeit:
--   - Einmal erklaeren, wofuer eine Waehrung gut ist (Sammel-Update 05.10.,
--     Paket 3.4): beim ersten Gummy-Gewinn und bei den ersten GoldGummies ein
--     Satz in einer Sprechblase an der Waehrungs-Pille, mit Pfeil darauf.
--
-- Keine Textwand: ein Satz, ein Pfeil, Tippen oder 8 Sekunden schliessen.
-- Gemerkt wird ueber uiSeen ("hint_gummies" / "hint_gold", UiStateService),
-- damit der Hinweis nur einmal pro Konto kommt. Veteranen (GuideSteps)
-- bekommen ihn nicht.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Loc        = require(ReplicatedStorage.Localization.Loc)
local GuideSteps = require(ReplicatedStorage.Modules.GuideSteps)

local Theme       = require(script.Parent.Theme)
local UiScale     = require(script.Parent.UiScale)
local Hud         = require(script.Parent.Hud)
local Unlock      = require(script.Parent.Unlock)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local CurrencyHint = {}

local SHOW_SECONDS = 8
local START_GUMMIES = 100   -- Startbestand (Types.createDefaultPlayerData): erst ein GEWINN zaehlt

local _bubble: Frame? = nil
local _text: TextLabel? = nil
local _shownSession: { [string]: boolean } = {}

local function show(kind: string, key: string)
	local bubble, text = _bubble, _text
	local anchor = Hud.getPillAnchor(kind)
	if not bubble or not text or not anchor then return end
	text.Text = "⬆ " .. Loc.t(key)
	-- Bildschirm-Pixel -> Oberflaechen-Einheiten (globale UiScale)
	local pos, size = UiScale.toGui(anchor.AbsolutePosition), UiScale.toGui(anchor.AbsoluteSize)
	bubble.Position = UDim2.fromOffset(pos.X, pos.Y + size.Y + 10)
	bubble.Visible = true
	local token = os.clock()
	bubble:SetAttribute("Token", token)
	task.delay(SHOW_SECONDS, function()
		if bubble:GetAttribute("Token") == token then bubble.Visible = false end
	end)
end

local function check()
	local data = ClientState.get()
	if not data or GuideSteps.isVeteran(data :: any) then return end
	local seen = (data :: any).uiSeen or {}
	if not seen.hint_gummies and not _shownSession.hint_gummies and data.gummies > START_GUMMIES then
		_shownSession.hint_gummies = true
		Unlock.markSeen("hint_gummies")
		show("gummies", "hint.gummies")
	elseif not seen.hint_gold and not _shownSession.hint_gold and data.goldGummies > 0 then
		_shownSession.hint_gold = true
		Unlock.markSeen("hint_gold")
		show("goldGummies", "hint.gold")
	end
end

function CurrencyHint.init(screenGui: ScreenGui)
	local bubble = Theme.panel("CurrencyHint", screenGui, Theme.COLORS.panelDeep)
	bubble.Size = UDim2.fromOffset(300, 56)
	bubble.Visible = false
	bubble.ZIndex = 45
	local text = Theme.bodyText("Text", bubble, "")
	text.Position = UDim2.fromOffset(10, 4)
	text.Size = UDim2.new(1, -20, 1, -8)
	text.TextColor3 = Theme.COLORS.goldGummy
	text.ZIndex = 46
	local hit = Instance.new("TextButton")
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 47
	hit.Parent = bubble
	hit.Activated:Connect(function() bubble.Visible = false end)
	_bubble, _text = bubble, text

	ClientState.onChanged(check)
end

return CurrencyHint
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX90"><Properties><string name="Name">Feedback</string><ProtectedString name="Source"><![CDATA[--!strict
-- Feedback.luau
-- StarterPlayerScripts/UI/Feedback.luau
--
-- Einzige Zustaendigkeit:
--   - Gewinne ohne Text zeigen: Icon fliegt zur passenden Pille/Kachel,
--     eine Zahl ("+25") steigt auf, Honig/XP/Stufen als Zahl ueber dem Baerchi
--
-- Kontext: HBB Paket 1. Ein Kind soll Belohnungen sehen, nicht lesen.
--
-- Zwei Quellen:
--   1. Waehrungen und Eier erkennt dieses Modul selbst am Datenstand
--      (ClientState): steigt `gummies`, `goldGummies` oder die Summe im
--      Ei-Lager, fliegt ein Icon. So braucht keine Belohnungsstelle eigenen
--      Code, und nichts wird doppelt gezeigt.
--   2. Alles, was keine Pille hat (XP, Honig, Level, Stat-Stufe, Waben,
--      Ausbau), meldet der Aufrufer mit Feedback.gain(kind, amount, origin?).
--
-- Leistung: ein fester Pool wiederverwendeter Elemente und EINE Schleife pro
-- Frame. Kein Thread und kein Tween pro Icon.
--
-- Mit FeatureFlags.UI_V2_FEEDBACK = false zeigt dieses Modul nichts.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local GuiService        = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local Types          = require(ReplicatedStorage.Network.Types)
local FeedbackConfig = require(ReplicatedStorage.Config.FeedbackConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)

local Theme       = require(script.Parent.Theme)
local UiScale     = require(script.Parent.UiScale)
local Icons       = require(script.Parent.Icons)
local Hud         = require(script.Parent.Hud)
local MenuBar     = require(script.Parent.MenuBar)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local Feedback = {}

export type Origin = GuiObject | Vector3 | BasePart

-- Wie jede Art aussieht. `icon` = Name in Icons, `text` = Rueckfall/Praefix.
-- `me` = Zahl ueber dem eigenen Charakter statt ueber dem Baerchi.
local LOOK: { [string]: { icon: string?, text: string, color: Color3, float: boolean, me: boolean? } } = {
	gummies     = { icon = "gummy",     text = "G",  color = Theme.COLORS.gummy,     float = false },
	goldGummies = { icon = "goldgummy", text = "$",  color = Theme.COLORS.goldGummy, float = false },
	eggs        = { icon = "egg",       text = "🥚", color = Theme.COLORS.text,      float = false },
	xp          = { icon = nil,         text = "XP", color = Theme.COLORS.growth,    float = true },
	honey       = { icon = "honey",     text = "",   color = Theme.COLORS.volume,    float = true },
	level       = { icon = nil,         text = "Lv", color = Theme.COLORS.good,      float = true },
	stat        = { icon = nil,         text = "",   color = Theme.COLORS.accent,    float = true },
	comb        = { icon = "honey",     text = "",   color = Theme.COLORS.volume,    float = true, me = true },
	upgrade     = { icon = nil,         text = "⬆",  color = Theme.COLORS.good,      float = true, me = true },
	star        = { icon = nil,         text = "★",  color = Theme.COLORS.goldGummy, float = true },
}

-- Groesse eines fliegenden Icons (px)
local ICON_SIZE = 38
-- Wie hoch die Zahl ueber den Startpunkt steigt (px)
local NUMBER_RISE = 46
-- Wie hoch die Zahl ueber dem Baerchi steigt (Studs)
local FLOAT_RISE = 3
local FLOAT_BASE = 4

type Flyer = {
	frame  : Frame,
	icon   : GuiObject,
	number : TextLabel,
	busy   : boolean,
	t0     : number,
	from   : Vector2,
	to     : Vector2?,
	kind   : string,
	landed : boolean,
	spent  : boolean,   -- Paket G: Betrag fliegt AUS der Pille (keinen Puls am Ziel)
}

type Floater = {
	gui    : BillboardGui,
	label  : TextLabel,
	busy   : boolean,
	t0     : number,
}

local _layer: Frame? = nil
local _flyers: { Flyer } = {}
local _floaters: { Floater } = {}

-- Sammeln gleicher Gewinne im MERGE_WINDOW
local _pending: { [string]: { amount: number, origin: Origin?, due: number, suffix: string? } } = {}

-- Letzter bekannter Stand fuer die Erkennung aus ClientState
local _last: { gummies: number, goldGummies: number, eggs: number }? = nil

-- Zwischenspeicher fuer die Figur des ausgeruesteten Baerchis
local _bearPart: BasePart? = nil
local _bearUid: string? = nil

local function enabled(): boolean
	return FeatureFlags.isOn("UI_V2_FEEDBACK")
end

local function formatAmount(kind: string, amount: number, suffix: string?): string
	if suffix then
		return "+" .. Theme.formatNumber(amount) .. " " .. suffix
	end
	local look = LOOK[kind]
	local prefix = if look then look.text else ""
	if kind == "level" then
		return prefix .. " " .. Theme.formatNumber(amount)
	elseif kind == "upgrade" or kind == "star" then
		return prefix .. " " .. Theme.formatNumber(amount)
	elseif kind == "xp" then
		return "+" .. Theme.formatNumber(amount) .. " " .. prefix
	end
	return "+" .. Theme.formatNumber(amount)
end

--------------------------------------------------------------------------------
-- Positionen
--------------------------------------------------------------------------------

local function guiCenter(gui: GuiObject): Vector2
	-- Bildschirm-Pixel -> Oberflaechen-Einheiten (globale UiScale)
	return UiScale.toGui(gui.AbsolutePosition + gui.AbsoluteSize * 0.5)
end

local function worldToScreen(position: Vector3): Vector2?
	local camera = Workspace.CurrentCamera
	if not camera then return nil end
	local point, visible = camera:WorldToViewportPoint(position)
	if not visible then return nil end
	-- Die ScreenGui laesst Platz fuer die Topbar (IgnoreGuiInset = false):
	-- Viewport-Koordinaten muessen um diesen Rand verschoben werden.
	local inset = GuiService:GetGuiInset()
	return UiScale.toGui(Vector2.new(point.X, point.Y) - inset)
end

local function defaultOrigin(): Vector2
	local layer = _layer
	if not layer then return Vector2.zero end
	local size = UiScale.toGui(layer.AbsoluteSize)
	-- Ueber der Pet-Leiste, wo der Blick ohnehin ist
	return Vector2.new(size.X * 0.5, size.Y * 0.72)
end

local function resolveOrigin(origin: Origin?): Vector2
	if typeof(origin) == "Instance" then
		if origin:IsA("GuiObject") then
			return guiCenter(origin)
		elseif origin:IsA("BasePart") then
			return worldToScreen(origin.Position) or defaultOrigin()
		end
	elseif typeof(origin) == "Vector3" then
		return worldToScreen(origin) or defaultOrigin()
	end
	return defaultOrigin()
end

local function targetFor(kind: string): GuiObject?
	local anchor = Hud.getPillAnchor(kind)
	if anchor then return anchor end
	if kind == "eggs" then
		return MenuBar.getTileAnchor("Hatch")
	end
	return nil
end

local function pulseTarget(kind: string, target: GuiObject?)
	if Hud.getPillAnchor(kind) then
		Hud.pulse(kind)
	elseif target then
		local scale = target:FindFirstChild("PulseScale")
		if not scale then
			local created = Instance.new("UIScale")
			created.Name = "PulseScale"
			created.Parent = target
			scale = created
		end
		local uiScale = scale :: UIScale
		uiScale.Scale = 1.15
	end
end

-- Sucht die Figur des eigenen, ausgeruesteten Baerchis (Attribut BaerchiUid,
-- siehe WorldController). Bleibt zwischengespeichert, bis sie verschwindet.
local function findBearPart(): BasePart?
	local data = ClientState.get()
	local uid = if data then data.island.equippedUid else nil
	if not uid then return nil end
	local cached = _bearPart
	if cached and cached.Parent and _bearUid == uid then
		return cached
	end
	_bearPart = nil
	_bearUid = uid
	for _, descendant in Workspace:GetDescendants() do
		if descendant:IsA("BasePart") and descendant:GetAttribute("BaerchiUid") == uid then
			_bearPart = descendant
			return descendant
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Pools
--------------------------------------------------------------------------------

local function makeFlyer(layer: Frame): Flyer
	local frame = Instance.new("Frame")
	frame.Name = "Flyer"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromOffset(ICON_SIZE, ICON_SIZE)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Visible = false
	frame.ZIndex = 60
	frame.Parent = layer

	local number = Theme.label("Number", layer, "")
	number.AnchorPoint = Vector2.new(0.5, 0.5)
	number.Size = UDim2.fromOffset(120, 34)
	number.TextXAlignment = Enum.TextXAlignment.Center
	number.ZIndex = 61
	number.Visible = false
	Theme.outlineText(number, 2)

	return {
		frame = frame, icon = frame, number = number, busy = false,
		t0 = 0, from = Vector2.zero, to = nil, kind = "", landed = false, spent = false,
	}
end

local function setFlyerLook(flyer: Flyer, kind: string)
	if flyer.kind == kind and flyer.icon ~= flyer.frame then return end
	if flyer.icon ~= flyer.frame then
		flyer.icon:Destroy()
	end
	local look = LOOK[kind]
	local iconName = if look then look.icon else nil
	local icon = Icons.make(flyer.frame, iconName or "", if look then look.text else "?")
	icon.Size = UDim2.fromScale(1, 1)
	icon.ZIndex = 60
	flyer.icon = icon
	flyer.kind = kind
end

local function makeFloater(): Floater
	local gui = Instance.new("BillboardGui")
	gui.Name = "FeedbackFloat"
	gui.Size = UDim2.fromOffset(160, 44)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Enabled = false
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local label = Theme.label("Text", gui, "")
	label.Size = UDim2.fromScale(1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Center
	Theme.outlineText(label, 2)

	return { gui = gui, label = label, busy = false, t0 = 0 }
end

--------------------------------------------------------------------------------
-- Ausloesen
--------------------------------------------------------------------------------

local function launchFlyer(kind: string, amount: number, origin: Origin?)
	local free: Flyer? = nil
	for _, flyer in _flyers do
		if not flyer.busy then
			free = flyer
			break
		end
	end
	-- Alle belegt: die Pille zaehlt den Wert ohnehin hoch. Kein siebtes Icon.
	if not free then return end

	local target = targetFor(kind)
	local from = resolveOrigin(origin)
	setFlyerLook(free, kind)
	free.busy   = true
	free.landed = false
	free.spent  = false
	free.t0     = os.clock()
	free.from   = from
	free.to     = if target then guiCenter(target) else nil
	free.frame.Position = UDim2.fromOffset(from.X, from.Y)
	free.frame.Visible  = true

	local look = LOOK[kind]
	free.number.Text       = formatAmount(kind, amount)
	free.number.TextColor3 = if look then look.color else Theme.COLORS.text
	free.number.Position   = UDim2.fromOffset(from.X, from.Y - 20)
	free.number.TextTransparency = 0
	free.number.Visible    = true
end

local function characterPart(): BasePart?
	local character = Players.LocalPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then return root end
	return nil
end

local function launchFloater(kind: string, amount: number, suffix: string?)
	local look0 = LOOK[kind]
	local part = if look0 and look0.me then characterPart() else findBearPart()
	if not part then return end
	local free: Floater? = nil
	for _, floater in _floaters do
		if not floater.busy then
			free = floater
			break
		end
	end
	if not free then return end
	local look = LOOK[kind]
	free.busy = true
	free.t0 = os.clock()
	free.gui.Adornee = part
	free.gui.StudsOffset = Vector3.new(0, FLOAT_BASE, 0)
	free.gui.Enabled = true
	free.label.Text = formatAmount(kind, amount, suffix)
	free.label.TextColor3 = if look then look.color else Theme.COLORS.text
	free.label.TextTransparency = 0
end

local function flush(kind: string)
	local entry = _pending[kind]
	_pending[kind] = nil
	if not entry or entry.amount == 0 then return end
	local look = LOOK[kind]
	if look and look.float then
		launchFloater(kind, entry.amount, entry.suffix)
	else
		launchFlyer(kind, entry.amount, entry.origin)
	end
end

-- Oeffentlich: einen Gewinn zeigen. Gleiche Arten innerhalb des
-- MERGE_WINDOW werden zu einer Zahl addiert. Bei "level", "upgrade" und
-- "star" ist `amount` die neue Stufe (wird nicht addiert, sondern ersetzt).
-- `suffix`: kurzes Kuerzel hinter der Zahl ("+1 ATK"); nur Zahlen und
-- sprachneutrale Kuerzel, keine Woerter.
function Feedback.gain(kind: string, amount: number, origin: Origin?, suffix: string?)
	if not enabled() then return end
	if not LOOK[kind] then
		warn("[Feedback] Unbekannte Art:", kind)
		return
	end
	local entry = _pending[kind]
	if entry then
		if kind == "level" or kind == "upgrade" or kind == "star" then
			entry.amount = amount
		else
			entry.amount += amount
		end
		entry.origin = origin or entry.origin
		entry.suffix = suffix or entry.suffix
	else
		_pending[kind] = { amount = amount, origin = origin, due = os.clock() + FeedbackConfig.MERGE_WINDOW, suffix = suffix }
	end
end

-- Paket G (08.10.): einen BEZAHLTEN Betrag zeigen. Das Icon fliegt aus der
-- Pille zum Ziel in der Welt (z. B. dem ausgebauten Gebaeude), an der Pille
-- steigt "-1.234" auf. Nur aufrufen, wenn der Server die Ausgabe bestaetigt
-- hat (Datenstand), nie spekulativ.
function Feedback.spend(kind: string, amount: number, toWorld: Vector3?)
	if not enabled() or amount <= 0 then return end
	local pill = targetFor(kind)
	if not pill then return end
	local free: Flyer? = nil
	for _, flyer in _flyers do
		if not flyer.busy then
			free = flyer
			break
		end
	end
	if not free then return end
	local from = guiCenter(pill)
	setFlyerLook(free, kind)
	free.busy   = true
	free.landed = false
	free.spent  = true
	free.t0     = os.clock()
	free.from   = from
	free.to     = if toWorld then worldToScreen(toWorld) else nil
	free.frame.Position = UDim2.fromOffset(from.X, from.Y)
	free.frame.Visible  = true
	free.number.Text       = "-" .. Theme.formatNumber(amount)
	free.number.TextColor3 = Theme.COLORS.bad
	free.number.Position   = UDim2.fromOffset(from.X, from.Y + 20)
	free.number.TextTransparency = 0
	free.number.Visible    = true
	Hud.pulse(kind)
end

--------------------------------------------------------------------------------
-- Die eine Schleife
--------------------------------------------------------------------------------

local function easeOut(t: number): number
	return 1 - (1 - t) * (1 - t)
end

local function step()
	local now = os.clock()

	for kind, entry in _pending do
		if now >= entry.due then
			flush(kind)
		end
	end

	local fly = FeedbackConfig.FLY_SECONDS
	local rise = FeedbackConfig.NUMBER_SECONDS
	for _, flyer in _flyers do
		if not flyer.busy then continue end
		local t = now - flyer.t0

		-- Zahl: steigt am Startpunkt auf und blendet aus
		local tn = math.clamp(t / rise, 0, 1)
		-- Ausgaben (spend) sinken unter der Pille ab: die Pille sitzt oben
		-- am Rand, nach oben waere kein Platz.
		local dy = if flyer.spent then 26 + NUMBER_RISE * easeOut(tn) else -20 - NUMBER_RISE * easeOut(tn)
		flyer.number.Position = UDim2.fromOffset(flyer.from.X, flyer.from.Y + dy)
		flyer.number.TextTransparency = math.max(0, (tn - 0.6) / 0.4)

		-- Icon: Bogen zum Ziel (ohne Ziel: nur kurz aufsteigen)
		local tf = math.clamp(t / fly, 0, 1)
		local to = flyer.to or (flyer.from - Vector2.new(0, 80))
		local mid = (flyer.from + to) * 0.5 + Vector2.new(0, -90)
		local e = easeOut(tf)
		local a = flyer.from:Lerp(mid, e)
		local b = mid:Lerp(to, e)
		local p = a:Lerp(b, e)
		flyer.frame.Position = UDim2.fromOffset(p.X, p.Y)
		local size = ICON_SIZE * (1 - 0.35 * tf)
		flyer.frame.Size = UDim2.fromOffset(size, size)

		if tf >= 1 and not flyer.landed then
			flyer.landed = true
			flyer.frame.Visible = false
			if not flyer.spent then
				pulseTarget(flyer.kind, targetFor(flyer.kind))
			end
		end
		if tf >= 1 and tn >= 1 then
			flyer.busy = false
			flyer.number.Visible = false
		end
	end

	local floatTime = FeedbackConfig.FLOAT_SECONDS
	for _, floater in _floaters do
		if not floater.busy then continue end
		local t = math.clamp((now - floater.t0) / floatTime, 0, 1)
		floater.gui.StudsOffset = Vector3.new(0, FLOAT_BASE + FLOAT_RISE * easeOut(t), 0)
		floater.label.TextTransparency = math.max(0, (t - 0.6) / 0.4)
		if t >= 1 then
			floater.busy = false
			floater.gui.Enabled = false
			floater.gui.Adornee = nil
		end
	end

	-- Puls der Kacheln zurueckfedern (Pillen machen das selbst per Tween)
	local tile = MenuBar.getTileAnchor("Hatch")
	if tile then
		local scale = tile:FindFirstChild("PulseScale")
		if scale and scale:IsA("UIScale") and scale.Scale > 1 then
			scale.Scale = math.max(1, scale.Scale - 0.6 * (1 / 60))
		end
	end
end

--------------------------------------------------------------------------------
-- Erkennung aus dem Datenstand
--------------------------------------------------------------------------------

local function countEggs(data: Types.PlayerDataUpdate): number
	local total = 0
	for _, n in data.island.eggStock do
		total += n
	end
	return total
end

local function onData(data: Types.PlayerDataUpdate)
	local now = { gummies = data.gummies, goldGummies = data.goldGummies, eggs = countEggs(data) }
	local last = _last
	_last = now
	-- Erster Stand nach dem Join ist kein Gewinn
	if not last then return end
	if now.gummies > last.gummies then Feedback.gain("gummies", now.gummies - last.gummies) end
	if now.goldGummies > last.goldGummies then Feedback.gain("goldGummies", now.goldGummies - last.goldGummies) end
	if now.eggs > last.eggs then Feedback.gain("eggs", now.eggs - last.eggs) end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function Feedback.init(screenGui: ScreenGui)
	local layer = Theme.container("FeedbackLayer", screenGui)
	layer.Size = UDim2.fromScale(1, 1)
	layer.ZIndex = 60
	_layer = layer

	for _ = 1, FeedbackConfig.MAX_ICONS do
		table.insert(_flyers, makeFlyer(layer))
	end
	for _ = 1, FeedbackConfig.MAX_FLOATS do
		table.insert(_floaters, makeFloater())
	end

	ClientState.onChanged(onData)
	RunService.RenderStepped:Connect(step)

	print("[Feedback] Initialisiert")
end

return Feedback
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX91"><Properties><string name="Name">FightStartPrompt</string><ProtectedString name="Source"><![CDATA[--!strict
-- FightStartPrompt.luau
-- StarterPlayerScripts/UI/FightStartPrompt.luau
--
-- Einzige Zustaendigkeit:
--   - Das kleine Feld beim Fight-Klick (FeatureFlags.FIGHT_RESUME_PROMPT):
--     "Ab Stage X weiter" gegen Gummies. Klickt der Spieler nichts, ist es
--     nach AUTO_SECONDS weg und der Lauf startet bei Stage 1.
--
-- Entscheidung Projektinhaber 05.10.: Stages schafft man durch STAERKERE
-- Baerchis. Der Einstieg weiter oben ist eine bewusste Spieler-Entscheidung
-- gegen Waehrung, nie der Standard. (Vorher startete der Fight-Knopf ohne
-- Frage ab 65 % des letzten Laufs und buchte dafuer Gummies ab.)
--
-- Kosten und Start-Stage rechnet PitResumeDialog.offer — dieselbe Rechnung,
-- mit der der Server abbucht. Bezahlbar entscheidet am Ende der Server.
--
-- 08.10. (Paket C, "der bezahlte Knopf leuchtet, keiner nimmt den Gratis-
-- Start"): Hierarchie umgedreht. Oben gross und gruen der GRATIS-Start bei
-- Stage 1, darunter klein und gedaempft der bezahlte Einstieg (mit dem
-- Gamepass "Gratis (Pass)"). Keine falschen Countdowns: der Balken zeigt nur,
-- wann es von selbst gratis losgeht.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local Loc = require(ReplicatedStorage.Localization.Loc)

local Theme           = require(script.Parent.Theme)
local Icons           = require(script.Parent.Icons)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local ClientState     = require(script.Parent.Parent.Controllers.ClientState)

local FightStartPrompt = {}

FightStartPrompt.AUTO_SECONDS = 7

local _root: Frame? = nil
local _resume: TextButton? = nil
local _cost: TextLabel? = nil
local _bar: Frame? = nil
local _onChoose: ((PitResumeDialog.Choice) -> ())? = nil
local _openedAt = 0
local _token = 0

local function finish(choice: PitResumeDialog.Choice)
	local callback = _onChoose
	_onChoose = nil
	_token += 1
	local root = _root
	if root then root.Visible = false end
	if callback then callback(choice) end
end

function FightStartPrompt.isOpen(): boolean
	return _onChoose ~= nil
end

-- Sofort mit Stage 1 starten (zweiter Fight-Klick waehrend das Feld offen ist)
function FightStartPrompt.chooseFresh()
	if _onChoose then finish("Fresh") end
end

-- Oeffnet das Feld, wenn es einen letzten Lauf ueber Stage 1 gibt. Gibt
-- false zurueck, wenn es nichts anzubieten gibt (Aufrufer startet dann
-- selbst bei Stage 1).
function FightStartPrompt.open(onChoose: (PitResumeDialog.Choice) -> ()): boolean
	local root, resume, cost = _root, _resume, _cost
	local data = ClientState.get()
	if not root or not resume or not cost or not data then return false end
	local reached = PitResumeDialog.getProgress(data)
	if not reached or reached <= 1 then return false end

	local stage, price = PitResumeDialog.offer(data, "Last")
	local pass = PitResumeDialog.hasSkipPass()
	resume.Text = if pass
		then Loc.t("ui.fight.resume_pass", { stage = stage })
		else Loc.t("ui.fight.resume", { stage = stage })
	cost.Text = if pass then "" else Theme.formatNumber(price)
	Theme.setEnabled(resume, price <= data.gummies)
	local coin = resume:FindFirstChild("Icon")
	if coin and coin:IsA("GuiObject") then coin.Visible = not pass end

	_onChoose = onChoose
	_openedAt = os.clock()
	_token += 1
	local token = _token
	root.Visible = true

	task.delay(FightStartPrompt.AUTO_SECONDS, function()
		if token == _token and _onChoose then
			finish("Fresh")
		end
	end)
	return true
end

function FightStartPrompt.init(screenGui: ScreenGui, anchorAbove: GuiObject)
	local root = Theme.panel("FightStartPrompt", screenGui, Theme.COLORS.panelDeep)
	root.AnchorPoint = Vector2.new(0.5, 1)
	root.Size = UDim2.fromOffset(300, 104)
	root.Visible = false
	root.ZIndex = 6
	_root = root

	-- Ueber der Pet-Leiste, und mit ihr mitwandern: auf Touch-Geraeten sitzt
	-- sie nicht mittig, sondern im freien Streifen neben der Steuerung
	-- (TouchSafeArea), und ihr UIScale macht sie kleiner.
	local function follow()
		local barScale = anchorAbove:FindFirstChildOfClass("UIScale")
		local factor = if barScale then barScale.Scale else 1
		root.Position = UDim2.new(
			anchorAbove.Position.X.Scale, anchorAbove.Position.X.Offset,
			1, -(anchorAbove.Size.Y.Offset * factor + 26)
		)
	end
	anchorAbove:GetPropertyChangedSignal("Position"):Connect(follow)
	local barScale = anchorAbove:FindFirstChildOfClass("UIScale")
	if barScale then
		barScale:GetPropertyChangedSignal("Scale"):Connect(follow)
	end
	follow()

	-- Primaer: der Gratis-Start (gross, gruen)
	local fresh = Theme.bigButton("Fresh", root, Loc.t("ui.fight.fresh_free"), Theme.COLORS.good)
	fresh.Position = UDim2.new(0, 8, 0, 8)
	fresh.Size = UDim2.new(1, -16, 0, 46)
	fresh.TextColor3 = Theme.COLORS.text
	Theme.outlineText(fresh :: any, 2)
	Loc.bind(fresh, "ui.fight.fresh_free")
	fresh.Activated:Connect(function() finish("Fresh") end)

	-- Sekundaer: der bezahlte Einstieg (klein, gedaempft, kein Glanz)
	local resume = Theme.button("Resume", root, "", Theme.COLORS.panelLight)
	resume.Position = UDim2.new(0, 8, 0, 62)
	resume.Size = UDim2.new(0.62, 0, 0, 30)
	resume.TextColor3 = Theme.COLORS.text
	resume.TextXAlignment = Enum.TextXAlignment.Left
	local shine = resume:FindFirstChild("Shine")
	if shine then shine:Destroy() end
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 64)
	pad.Parent = resume
	resume.Activated:Connect(function()
		if resume.Active then finish("Last") end
	end)
	_resume = resume

	-- Kosten rechts im Knopf: Gummi-Icon + Zahl
	local coin = Icons.make(resume, "gummy", "G")
	coin.AnchorPoint = Vector2.new(1, 0.5)
	coin.Position = UDim2.new(1, 62, 0.5, 0)
	coin.Size = UDim2.fromOffset(20, 20)
	local cost = Theme.label("Cost", resume, "")
	cost.AnchorPoint = Vector2.new(1, 0.5)
	cost.Position = UDim2.new(1, 40, 0.5, 0)
	cost.Size = UDim2.fromOffset(44, 20)
	_cost = cost

	-- Ablaufbalken: zeigt, dass es gleich von selbst bei Stage 1 losgeht
	local track = Instance.new("Frame")
	track.Name = "Timer"
	track.BackgroundColor3 = Theme.COLORS.panelLight
	track.BorderSizePixel = 0
	track.Position = UDim2.new(0.62, 16, 0, 72)
	track.Size = UDim2.new(0.38, -24, 0, 10)
	track.Parent = root
	Theme.corner(track, 5)
	local bar = Instance.new("Frame")
	bar.BackgroundColor3 = Theme.COLORS.good
	bar.BorderSizePixel = 0
	bar.Size = UDim2.fromScale(1, 1)
	bar.Parent = track
	Theme.corner(bar, 5)
	_bar = bar

	RunService.RenderStepped:Connect(function()
		if not _onChoose then return end
		local left = math.clamp(1 - (os.clock() - _openedAt) / FightStartPrompt.AUTO_SECONDS, 0, 1)
		local b = _bar
		if b then b.Size = UDim2.fromScale(left, 1) end
	end)

end

return FightStartPrompt
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX92"><Properties><string name="Name">FusionPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- FusionPanel.luau
-- StarterPlayerScripts/UI/FusionPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Zwei im Inventar markierte Baerchis bestaetigen und fusionieren
--   - Den Sperr-Schritt anbieten (Ability / Level / Eier von A oder B)
--   - Das Ergebnis kurz zeigen
--
-- Die Auswahl der beiden Baerchis passiert im Inventar (BaerchiInventory,
-- Fusions-Modus). Dieses Panel bekommt die beiden uids beim Oeffnen uebergeben
-- und haelt selbst nur noch die Sperr-Entscheidung.
--
-- ============================================================
-- DREI ANSICHTEN, WEIL DIE FUSION SEIT v8 EINE ENTSCHEIDUNG IST
-- ============================================================
--   1. Auswahl  — was kommt rein, was kommt heraus (Vorschau)
--   2. Sperren  — genau EINE von drei Eigenschaften festlegen
--   3. Ergebnis — was tatsaechlich herausgekommen ist
--
-- Der Sperr-Schritt liegt DAZWISCHEN und nicht in der Auswahl, weil er nur
-- Sinn hat, wenn beide Baerchis feststehen: erst dann gibt es zwei Werte zum
-- Vergleichen. Wer nichts sperren will, klickt einfach durch — "automatisch"
-- ist ueberall der Ausgangszustand.
--
-- ============================================================
-- ZUR VORSCHAU
-- ============================================================
-- Die Fusions-Regel steht verbindlich im Kopf von FusionService. Hier wird sie
-- NUR nachgelesen, um zu zeigen was herauskommt. Seit v14 steigt die Rarity
-- NICHT mehr: das Ergebnis ist die Art des levelhoeheren Baerchis (bei
-- Gleichstand A) in derselben Rarity, mit den besseren Stats beider.
--
-- Abgelehnt wird trotzdem serverseitig: die Vorschau kann veraltet sein.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Loc = require(game:GetService("ReplicatedStorage").Localization.Loc)   -- Sammel-Update 2.4

local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local EconomyConfig   = require(ReplicatedStorage.Config.EconomyConfig)
local PromotionConfig = require(ReplicatedStorage.Config.PromotionConfig)
local SkillConfig     = require(ReplicatedStorage.Config.SkillConfig)
local Loc             = require(ReplicatedStorage.Localization.Loc)
local Names           = require(ReplicatedStorage.Localization.Names)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local FusionPanel = {}

local PANEL_NAME = "Fusion"

local _root: Frame?             = nil
local _selectView: Frame?       = nil
local _lockView: Frame?         = nil
local _resultView: Frame?       = nil
local _slotLabels: { TextLabel } = {}
local _previewLabel: TextLabel? = nil
local _detailLabel: TextLabel?  = nil
local _nextButton: TextButton?  = nil
local _resultTitle: TextLabel?  = nil
local _resultSub: TextLabel?    = nil

local _uidA: string? = nil
local _uidB: string? = nil

-- Die Sperr-Entscheidung. Beide zusammen oder beide nil — der Server
-- verwirft eine halbe Auswahl ohnehin (siehe FusionService.init).
local _lockedProperty: string? = nil
local _lockedFrom: string?     = nil

--------------------------------------------------------------------------------
-- Die drei sperrbaren Eigenschaften
--------------------------------------------------------------------------------

-- `read` liefert den ANZEIGETEXT dieser Eigenschaft fuer einen Baerchi.
-- Was der Server daraus macht, steht in FusionService — hier wird nur gezeigt,
-- worueber man entscheidet.
type LockDef = {
	id    : string,
	label : string,   -- Loc-Schluessel
	read  : (Types.Baerchi) -> string,
}

local LOCK_DEFS: { LockDef } = {
	{
		id    = "ability",
		label = "ui.fusion.lock_ability",
		read  = function(baerchi: Types.Baerchi): string
			return Names.skill(baerchi.skillId)
		end,
	},
	{
		id    = "level",
		label = "ui.fusion.lock_level",
		read  = function(baerchi: Types.Baerchi): string
			return "Lv. " .. baerchi.level
		end,
	},
	{
		id    = "eggs",
		label = "ui.fusion.lock_eggs",
		read  = function(baerchi: Types.Baerchi): string
			local levels = baerchi.statLevels
			local value  = if levels then (levels.egg or 0) else 0
			return Loc.t("ui.fusion.stage", { n = value })
		end,
	},
}

type LockRow = {
	def     : LockDef,
	valueA  : TextLabel,
	valueB  : TextLabel,
	buttons : { [string]: TextButton },   -- "auto" | "A" | "B"
}

local _lockRows: { LockRow } = {}

--------------------------------------------------------------------------------
-- Vorschau
--------------------------------------------------------------------------------

type Preview = {
	ok      : boolean,
	headline: string,
	detail  : string,
}

local function buildPreview(a: Types.Baerchi?, b: Types.Baerchi?): Preview
	local data = ClientState.get()
	if not data or not a or not b then
		return { ok = false, headline = Loc.t("ui.fusion.pick_two"), detail = "" }
	end

	if a.uid == b.uid then
		return { ok = false, headline = Loc.t("ui.fusion.two_needed"), detail = "" }
	end

	if a.rarity ~= b.rarity then
		return {
			ok = false,
			headline = Loc.t("ui.fusion.rarity_mismatch"),
			detail   = Loc.t("ui.fusion.rarity_mismatch_detail", { a = Loc.t("rarity." .. a.rarity), b = Loc.t("rarity." .. b.rarity) }),
		}
	end

	-- Seit v8: das HOEHERE Level, nicht mehr der Durchschnitt (siehe
	-- FusionService, Regel C).
	local resultLevel = math.clamp(math.max(a.level, b.level), 1, BaerchiConfig.MAX_LEVEL)
	local bonus       = EconomyConfig.getFusionStatBonus()

	-- v14: keine hoehere Rarity mehr — die Art des levelhoeheren Inputs.
	local keep = if b.level > a.level then b else a
	local keepDef = BaerchiConfig.getById(keep.configId)
	local headline = string.format("%s  (%s)",
		Names.baerchi(keep.configId),
		Loc.t("rarity." .. keep.rarity))

	local detail = Loc.t("ui.fusion.detail", { level = resultLevel, bonus = math.floor(bonus * 100 + 0.5) })

	return { ok = true, headline = headline, detail = detail }
end

--------------------------------------------------------------------------------
-- Anzeige
--------------------------------------------------------------------------------

local function describe(baerchi: Types.Baerchi?): (string, Color3)
	if not baerchi then
		return Loc.t("ui.fusion.empty"), Theme.COLORS.textDim
	end

	return string.format(
		"%s  —  %s  —  Lv. %d",
		Names.baerchi(baerchi.configId),
		Names.rarity(baerchi.rarity),
		baerchi.level
	), Theme.rarityColor(baerchi.rarity)
end

local function refreshLockRows(a: Types.Baerchi?, b: Types.Baerchi?)
	for _, lockRow in _lockRows do
		lockRow.valueA.Text = if a then lockRow.def.read(a) else "—"
		lockRow.valueB.Text = if b then lockRow.def.read(b) else "—"

		local isLocked = _lockedProperty == lockRow.def.id

		for choice, button in lockRow.buttons do
			local active =
				(choice == "auto" and not isLocked)
				or (isLocked and choice == _lockedFrom)

			-- Aktive Wahl faerbig, die anderen matt. Bewusst ueber die
			-- Hintergrundfarbe und nicht ueber setEnabled: alle drei bleiben
			-- klickbar, sonst koennte man eine Sperre nicht mehr aufheben.
			button.BackgroundColor3 = if active
				then Theme.COLORS.accent
				else Theme.COLORS.panelLight
			button.TextColor3 = if active then Theme.COLORS.outline else Theme.COLORS.text
		end
	end
end

function FusionPanel.refresh()
	local root = _root
	if not root or not root.Visible then return end

	local a = if _uidA then ClientState.getBaerchi(_uidA) else nil
	local b = if _uidB then ClientState.getBaerchi(_uidB) else nil

	local labelA, colorA = describe(a)
	local labelB, colorB = describe(b)

	if _slotLabels[1] then
		_slotLabels[1].Text      = "A:  " .. labelA
		_slotLabels[1].TextColor3 = colorA
	end
	if _slotLabels[2] then
		_slotLabels[2].Text      = "B:  " .. labelB
		_slotLabels[2].TextColor3 = colorB
	end

	local preview = buildPreview(a, b)

	if _previewLabel then
		_previewLabel.Text       = preview.headline
		_previewLabel.TextColor3 = if preview.ok then Theme.COLORS.text else Theme.COLORS.bad
	end
	if _detailLabel then
		_detailLabel.Text = preview.detail
	end
	if _nextButton then
		Theme.setEnabled(_nextButton, preview.ok)
	end

	refreshLockRows(a, b)
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function showView(which: "select" | "lock" | "result")
	if _selectView then _selectView.Visible = which == "select" end
	if _lockView   then _lockView.Visible   = which == "lock"   end
	if _resultView then _resultView.Visible = which == "result" end
end

local function openInternal(...: any)
	local root = _root
	if not root then return end

	local argA, argB = ...

	_uidA = nil
	_uidB = nil
	if typeof(argA) == "string" then _uidA = argA :: string end
	if typeof(argB) == "string" then _uidB = argB :: string end

	-- Jede neue Fusion startet ohne Sperre: eine Auswahl von der letzten
	-- Fusion stillschweigend zu uebernehmen waere die Art Ueberraschung, bei
	-- der hinterher niemand weiss, warum das Ergebnis so aussieht.
	_lockedProperty = nil
	_lockedFrom     = nil

	showView("select")
	root.Visible = true
	FusionPanel.refresh()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
end

--------------------------------------------------------------------------------
-- Ergebnis
--------------------------------------------------------------------------------

local function showResult(result: Types.FusionResult)
	local baerchi = result.resultBaerchi
	local name    = Names.baerchi(baerchi.configId)

	Notify.emit("fusion_result", function()
		Toast.success(Loc.t("msg.fusion_done", { name = name, rarity = Names.rarity(baerchi.rarity), level = baerchi.level }))
	end)

	local root = _root
	if not root or not root.Visible then return end

	if _resultTitle then
		_resultTitle.Text       = name
		_resultTitle.TextColor3 = Theme.rarityColor(baerchi.rarity)
	end
	if _resultSub then
		local levels = baerchi.statLevels
		local cap    = PromotionConfig.getStatCap(baerchi.rarity)

		-- Frueher stand hier noch DEF: das Feld gibt es seit dem Wegfall der
		-- Verteidigung nicht mehr, string.format("%d", nil) brach ab und der
		-- Ergebnis-Bildschirm kam nie. Jetzt die fuenf echten Stat-Stufen.
		_resultSub.Text = Loc.t("ui.fusion.result_detail", {
			rarity = Names.rarity(baerchi.rarity),
			level  = baerchi.level,
			bonus  = math.floor((baerchi.fusionBonus or 0) * 100 + 0.5),
			hp     = if levels then levels.hp  or 0 else 0,
			atk    = if levels then levels.atk or 0 else 0,
			spd    = if levels then levels.spd or 0 else 0,
			pwr    = if levels then levels.pwr or 0 else 0,
			egg    = if levels then levels.egg or 0 else 0,
			cap    = cap,
		})
	end

	showView("result")
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function FusionPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"FusionPanel", screenGui,
		Vector2.new(0.48, 0.56),
		Vector2.new(320, 320),
		Vector2.new(540, 460)
	)
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.fusion.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	-- ------------------------------------------------------- Auswahl-Ansicht
	local selectView = Theme.container("SelectView", body)
	selectView.Size = UDim2.fromScale(1, 1)
	_selectView = selectView

	for slot = 1, 2 do
		local label = Theme.label("Slot" .. slot, selectView, "")
		label.Position   = UDim2.new(0, 4, 0, (slot - 1) * 26)
		label.Size       = UDim2.new(1, -8, 0, 22)
		label.TextColor3  = Theme.COLORS.textDim
		_slotLabels[slot] = label
	end

	local arrow = Theme.label("Arrow", selectView, Loc.t("ui.fusion.becomes"))
	arrow.Position       = UDim2.new(0, 4, 0, 58)
	arrow.Size           = UDim2.new(1, -8, 0, 18)
	arrow.TextXAlignment = Enum.TextXAlignment.Center
	arrow.TextColor3     = Theme.COLORS.textDim

	local previewBox = Theme.panel("Preview", selectView, Theme.COLORS.panel)
	previewBox.Position = UDim2.new(0, 0, 0, 80)
	previewBox.Size     = UDim2.new(1, -8, 0, 106)

	local preview = Theme.label("Headline", previewBox, "")
	preview.Position       = UDim2.new(0, 10, 0, 8)
	preview.Size           = UDim2.new(1, -20, 0, 26)
	preview.TextXAlignment = Enum.TextXAlignment.Center
	_previewLabel = preview

	local detail = Theme.bodyText("Detail", previewBox, "")
	detail.Position       = UDim2.new(0, 10, 0, 36)
	detail.Size           = UDim2.new(1, -20, 0, 62)
	detail.TextXAlignment = Enum.TextXAlignment.Center
	_detailLabel = detail

	local back = Theme.button("Back", selectView, "", Theme.COLORS.panelLight)
	Loc.bind(back, "ui.common.back")
	back.AnchorPoint = Vector2.new(0, 1)
	back.Position    = UDim2.new(0, 0, 1, 0)
	back.Size        = UDim2.new(0.5, -6, 0, 36)
	back.TextColor3  = Theme.COLORS.text
	back.Activated:Connect(function()
		PanelManager.open("Inventory")
	end)

	local next_ = Theme.button("Next", selectView, "", Theme.COLORS.gummy)
	Loc.bind(next_, "ui.common.next")
	next_.AnchorPoint = Vector2.new(1, 1)
	next_.Position    = UDim2.new(1, -8, 1, 0)
	next_.Size        = UDim2.new(0.5, -6, 0, 36)
	_nextButton = next_
	next_.Activated:Connect(function()
		showView("lock")
		FusionPanel.refresh()
	end)

	-- -------------------------------------------------------- Sperr-Ansicht
	local lockView = Theme.container("LockView", body)
	lockView.Size    = UDim2.fromScale(1, 1)
	lockView.Visible = false
	_lockView = lockView

	local lockHint = Theme.bodyText("LockHint", lockView,
		Loc.t("ui.fusion.lock_hint"))
	lockHint.Position = UDim2.new(0, 4, 0, 0)
	lockHint.Size     = UDim2.new(1, -8, 0, 40)

	for index, def in LOCK_DEFS do
		local y = 44 + (index - 1) * 52

		local rowFrame = Theme.panel("Lock_" .. def.id, lockView, Theme.COLORS.panel)
		rowFrame.Position = UDim2.new(0, 0, 0, y)
		rowFrame.Size     = UDim2.new(1, -8, 0, 46)

		local name = Theme.label("Name", rowFrame, "")
		Loc.bind(name, def.label)
		name.Position   = UDim2.new(0, 10, 0, 2)
		name.Size       = UDim2.new(0, 70, 0, 20)
		name.TextScaled = false
		name.TextSize   = 15

		local valueA = Theme.label("ValueA", rowFrame, "—")
		valueA.Position   = UDim2.new(0, 10, 0, 22)
		valueA.Size       = UDim2.new(0, 110, 0, 18)
		valueA.TextScaled = false
		valueA.TextSize   = 12
		valueA.TextColor3 = Theme.COLORS.textDim

		local valueB = Theme.label("ValueB", rowFrame, "—")
		valueB.Position   = UDim2.new(0, 124, 0, 22)
		valueB.Size       = UDim2.new(0, 110, 0, 18)
		valueB.TextScaled = false
		valueB.TextSize   = 12
		valueB.TextColor3 = Theme.COLORS.textDim

		local buttons: { [string]: TextButton } = {}

		local choices = { "auto", "A", "B" }
		for order, choice in choices do
			local button = Theme.button("Choice_" .. choice, rowFrame, choice, Theme.COLORS.panelLight)
		if choice == "auto" then Loc.bind(button, "ui.fusion.auto") end
			button.AnchorPoint = Vector2.new(1, 0.5)
			button.Position    = UDim2.new(1, -8 - (3 - order) * 46, 0.5, 0)
			button.Size        = UDim2.new(0, 42, 0, 28)
			button.TextColor3  = Theme.COLORS.text

			button.Activated:Connect(function()
				if choice == "auto" then
					-- Nur die Sperre DIESER Zeile aufheben; eine Sperre in einer
					-- anderen Zeile bleibt bestehen.
					if _lockedProperty == def.id then
						_lockedProperty = nil
						_lockedFrom     = nil
					end
				else
					-- Es darf immer nur EINE Eigenschaft gesperrt sein: eine
					-- neue Wahl ersetzt deshalb die alte, statt sich dazu zu
					-- gesellen.
					_lockedProperty = def.id
					_lockedFrom     = choice
				end

				FusionPanel.refresh()
			end)

			buttons[choice] = button
		end

		table.insert(_lockRows, {
			def     = def,
			valueA  = valueA,
			valueB  = valueB,
			buttons = buttons,
		})
	end

	local lockBack = Theme.button("LockBack", lockView, "", Theme.COLORS.panelLight)
	Loc.bind(lockBack, "ui.common.back")
	lockBack.AnchorPoint = Vector2.new(0, 1)
	lockBack.Position    = UDim2.new(0, 0, 1, 0)
	lockBack.Size        = UDim2.new(0.5, -6, 0, 36)
	lockBack.TextColor3  = Theme.COLORS.text
	lockBack.Activated:Connect(function()
		showView("select")
		FusionPanel.refresh()
	end)

	local confirm = Theme.button("Confirm", lockView, "", Theme.COLORS.gummy)
	Loc.bind(confirm, "ui.fusion.fuse")
	confirm.AnchorPoint = Vector2.new(1, 1)
	confirm.Position    = UDim2.new(1, -8, 1, 0)
	confirm.Size        = UDim2.new(0.5, -6, 0, 36)
	confirm.Activated:Connect(function()
		local a, b = _uidA, _uidB
		if not a or not b then return end
		Remotes.RequestFuseBaerchis:FireServer(a, b, _lockedProperty, _lockedFrom)
	end)

	-- ------------------------------------------------------ Ergebnis-Ansicht
	local resultView = Theme.container("ResultView", body)
	resultView.Size    = UDim2.fromScale(1, 1)
	resultView.Visible = false
	_resultView = resultView

	local resultHint = Theme.label("Hint", resultView, Loc.t("ui.fusion.success"))
	resultHint.Position       = UDim2.new(0, 4, 0, 6)
	resultHint.Size           = UDim2.new(1, -8, 0, 22)
	resultHint.TextXAlignment = Enum.TextXAlignment.Center
	resultHint.TextColor3     = Theme.COLORS.good

	local resultTitle = Theme.label("Title", resultView, "")
	resultTitle.Position       = UDim2.new(0, 4, 0, 40)
	resultTitle.Size           = UDim2.new(1, -8, 0, 34)
	resultTitle.TextXAlignment = Enum.TextXAlignment.Center
	_resultTitle = resultTitle

	local resultSub = Theme.bodyText("Sub", resultView, "")
	resultSub.Position       = UDim2.new(0, 4, 0, 80)
	resultSub.Size           = UDim2.new(1, -8, 0, 76)
	resultSub.TextXAlignment = Enum.TextXAlignment.Center
	_resultSub = resultSub

	local done = Theme.button("Done", resultView, Loc.t("ui.fusion.to_inventory"), Theme.COLORS.accent)
	done.AnchorPoint = Vector2.new(0.5, 1)
	done.Position    = UDim2.new(0.5, -4, 1, 0)
	done.Size        = UDim2.new(1, -8, 0, 36)
	done.Activated:Connect(function()
		PanelManager.open("Inventory")
	end)

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	ClientState.onChanged(function()
		FusionPanel.refresh()
	end)

	Remotes.FusionResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		showResult(result :: Types.FusionResult)
	end)

	-- Sprachwechsel bei offenem Fenster: Vorschau und Zeilen neu beschriften
	Loc.onChanged(function()
		FusionPanel.refresh()
	end)

	print("[FusionPanel] Initialisiert")
end

return FusionPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX93"><Properties><string name="Name">HatchAnimation</string><ProtectedString name="Source"><![CDATA[--!strict
-- HatchAnimation.luau
-- StarterPlayerScripts/UI/HatchAnimation.luau
--
-- Einzige Zustaendigkeit:
--   - Die Ei-Oeffnen-Animation abspielen: Drop, Wackeln, Risse, Aufladen,
--     Burst in der Rarity-Farbe, Reveal-Karte des Baerchis.
--
-- Reine Client-Optik aus UI-Elementen, keine Assets. Der Server entscheidet
-- allein, was aus dem Ei kommt (EggService.openEgg) — die Animation startet
-- trotzdem SOFORT beim Klick (Drop + Wackeln in Schleife) und geht erst zu
-- Rissen und Burst ueber, wenn das Ergebnis da ist. So fuehlt sich der Klick
-- unmittelbar an, ohne dass der Client etwas vorwegnimmt.
--
-- Ablauf pro Ei (bei normaler Rarity rund 3 Sekunden):
--   1. Drop     — Ei faellt von oben ins Bild und federt
--   2. Wackeln  — drei Stufen, jede staerker, mit jeder ein Riss
--   3. Aufladen — starkes Zittern, Gluehen in der Rarity-Farbe
--   4. Burst    — weisser Blitz, Ring, Partikel in der Rarity-Farbe
--   5. Reveal   — Karte mit Name, Rarity, Level, NEU!, Mutation
--
-- Die Rarity bestimmt die Wucht (siehe intensityFor): ab Epic mehr Risse,
-- ab Legendary laenger Wackeln, Bildschirmzittern und mehr Partikel, ab Divine
-- zusaetzlich ein Lichtstrahl. Das skaliert ueber den Rarity-Index und
-- funktioniert damit auch fuer kuenftige Rarities ohne Code-Aenderung.
--
-- Mehrere Eier: jede Oeffnung kommt in eine Warteschlange und wird
-- nacheinander gezeigt. Ergebnisse kommen in derselben Reihenfolge an, in der
-- die Anfragen rausgingen (ein Remote, ein Server-Thread) — deshalb wird ein
-- eintreffendes Ergebnis immer der aeltesten noch offenen Oeffnung zugeordnet.
--
-- Ton: bewusst offen (keine verifizierten Sound-Assets).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local TweenService      = game:GetService("TweenService")

local Types         = require(ReplicatedStorage.Network.Types)
local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local Names         = require(ReplicatedStorage.Localization.Names)

local BaerchiMesh   = require(ReplicatedStorage.Modules.BaerchiMesh)   -- Sammel-Update 2.2: Baerchi gross zeigen
local Loc           = require(ReplicatedStorage.Localization.Loc)

local Theme = require(script.Parent.Theme)
local EggIcon = require(script.Parent.EggIcon)
local Toast = require(script.Parent.Toast)
-- Sammel-Update: fehlte, Notify.emit beim Fehlschlag waere ein Laufzeitfehler.
local Notify = require(script.Parent.Notify)

local HatchAnimation = {}

--------------------------------------------------------------------------------
-- Zahlen (reine Optik, deshalb hier und nicht in einer Config)
--------------------------------------------------------------------------------

local DROP_SECONDS        = 0.4
local WOBBLE_STAGE_SECONDS = 0.45   -- pro Wackel-Stufe (3 Stufen = ~1,4 s)
local CHARGE_SECONDS      = 0.3
-- Sammel-Update 2.2 ("Ei-Oeffnen geht zu schnell weg"): das Ergebnis bleibt
-- mindestens REVEAL_MIN_SECONDS stehen (vorher 1,2 s + 0,8 s) und schliesst
-- danach erst durch Tippen oder nach REVEAL_AUTO_CLOSE Sekunden.
local REVEAL_SECONDS      = 2.5
local REVEAL_MIN_TAP      = 0.8     -- frueher als das schliesst auch ein Tipp nicht
local REVEAL_AUTO_CLOSE   = 7.0
local CARD_SIZE           = Vector2.new(360, 330)
local MODEL_VIEW_HEIGHT   = 150
local FADE_SECONDS        = 0.25
local RESULT_TIMEOUT      = 5       -- Sekunden ohne Server-Antwort, dann Abbruch
local SKIP_AFTER          = 1.0     -- ab hier beschleunigt ein Tap aufs Ergebnis
local EGG_SIZE            = Vector2.new(150, 190)
local BACKDROP_TRANSPARENCY = 0.35

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

type Job = {
	eggType : Types.EggType,
	result  : Types.HatchResult?,
	failed  : string?,     -- Grund, falls der Server abgelehnt hat oder nichts kam
	silent  : boolean,     -- true = die Meldung hat schon der Toast gezeigt (ActionFailed)
	started : number,      -- os.clock() beim Klick (fuer den Timeout)
}

local _screenGui: ScreenGui? = nil
local _queue: { Job } = {}
local _running = false
local _skip = false

--------------------------------------------------------------------------------
-- Intensitaet nach Rarity
--------------------------------------------------------------------------------

type Intensity = {
	cracks    : number,    -- Risse insgesamt
	wobbleMul : number,    -- Faktor auf die Wackel-Dauer
	amplitude : number,    -- Grad, maximales Wackeln in der letzten Stufe
	particles : number,
	shake     : boolean,   -- Bildschirmzittern
	beam      : boolean,   -- Lichtstrahl hinter der Karte
	flash     : number,    -- Deckkraft des weissen Blitzes (0..1)
}

local function intensityFor(rarity: Types.Rarity): Intensity
	-- Common = 1 ... Omega = 12. Unbekannte Rarities zaehlen wie Common.
	local index = BaerchiConfig.getRarityIndex(rarity) or 1

	return {
		cracks    = if index >= 4 then 5 else 3,
		wobbleMul = if index >= 5 then 1.35 else 1,
		amplitude = math.min(10 + index * 2.5, 32),
		particles = math.min(10 + index * 4, 56),
		shake     = index >= 5,
		beam      = index >= 7,
		flash     = if index >= 4 then 0.95 else 0.6,
	}
end

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function tween(instance: Instance, seconds: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local info = TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(instance, info, props)
	t:Play()
	return t
end

-- Wartet `seconds`, bricht aber frueher ab, sobald der Spieler ueberspringt.
local function waitSkippable(seconds: number)
	local untilTime = os.clock() + seconds
	while os.clock() < untilTime do
		if _skip then return end
		RunService.RenderStepped:Wait()
	end
end

local function newFrame(name: string, parent: Instance, size: UDim2, position: UDim2, color: Color3): Frame
	local frame = Instance.new("Frame")
	frame.Name             = name
	frame.Size             = size
	frame.Position         = position
	frame.AnchorPoint      = Vector2.new(0.5, 0.5)
	frame.BackgroundColor3 = color
	frame.BorderSizePixel  = 0
	frame.Parent           = parent
	return frame
end

local function round(frame: Frame)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = frame
end

--------------------------------------------------------------------------------
-- Bausteine der Szene
--------------------------------------------------------------------------------

type Scene = {
	root     : Frame,     -- Vollbild, faengt Taps
	backdrop : Frame,
	stage    : Frame,     -- traegt alles, wird beim Bildschirmzittern verschoben
	glow     : Frame,
	egg      : Frame,
	eggStroke: UIStroke,
	cracks   : Frame,
	label    : TextLabel,
}

local function buildScene(screenGui: ScreenGui, eggType: Types.EggType): Scene
	local eggDef   = EggConfig.data[eggType]
	local eggColor = if eggDef then eggDef.color else Color3.fromRGB(238, 232, 214)

	local root = Instance.new("TextButton")
	root.Name                   = "HatchAnimation"
	root.Text                   = ""
	root.AutoButtonColor        = false
	root.BackgroundTransparency = 1
	root.Size                   = UDim2.fromScale(1, 1)
	root.ZIndex                 = 50
	root.Parent                 = screenGui

	local backdrop = newFrame("Backdrop", root, UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0.5), Color3.new(0, 0, 0))
	backdrop.BackgroundTransparency = 1
	backdrop.ZIndex = 50

	local stage = Instance.new("Frame")
	stage.Name                   = "Stage"
	stage.BackgroundTransparency = 1
	stage.Size                   = UDim2.fromScale(1, 1)
	stage.ZIndex                 = 51
	stage.Parent                 = root

	-- Leuchten hinter dem Ei (erst beim Aufladen sichtbar)
	local glow = newFrame("Glow", stage, UDim2.fromOffset(EGG_SIZE.X * 1.6, EGG_SIZE.Y * 1.5), UDim2.fromScale(0.5, 0.48), Color3.new(1, 1, 1))
	glow.BackgroundTransparency = 1
	glow.ZIndex = 51
	round(glow)

	-- Das Ei: eine Ellipse in der Ei-Farbe mit dickem Cartoon-Rand
	local egg = newFrame("Egg", stage, UDim2.fromOffset(EGG_SIZE.X, EGG_SIZE.Y), UDim2.new(0.5, 0, -0.3, 0), eggColor)
	egg.ZIndex = 52
	round(egg)
	local stroke = Theme.stroke(egg, Theme.COLORS.outline, 4)
	Theme.gradient(egg, Theme.shade(eggColor, 0.25), Theme.shade(eggColor, -0.15))

	-- Muster und Glanzpunkt wie auf dem Ei in der Welt (EggIcon/EggLook)
	EggIcon.decorate(egg, eggType, EGG_SIZE.X / EGG_SIZE.Y, 53)

	local cracks = Instance.new("Frame")
	cracks.Name                   = "Cracks"
	cracks.BackgroundTransparency = 1
	cracks.Size                   = UDim2.fromScale(1, 1)
	cracks.ZIndex                 = 54
	cracks.Parent                 = egg

	local label = Theme.label("Hint", stage, Names.egg(tostring(eggType)))
	label.AnchorPoint    = Vector2.new(0.5, 0)
	label.Position       = UDim2.new(0.5, 0, 0.48, EGG_SIZE.Y * 0.5 + 18)
	label.Size           = UDim2.fromOffset(320, 30)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.ZIndex         = 55
	Theme.outlineText(label)

	return {
		root = root, backdrop = backdrop, stage = stage, glow = glow,
		egg = egg, eggStroke = stroke, cracks = cracks, label = label,
	}
end

-- Ein Riss: zwei kurze, dunkle, schraeg gestellte Striche als Zickzack.
local function addCrack(scene: Scene, index: number)
	local x = 0.25 + ((index * 0.37) % 0.5)
	local y = 0.30 + ((index * 0.23) % 0.4)
	local base = (index % 2 == 0) and 35 or -35

	for part = 0, 1 do
		local line = newFrame("Crack" .. index .. "_" .. part, scene.cracks,
			UDim2.new(0, 0, 0, 4),
			UDim2.fromScale(x + part * 0.08, y + part * 0.07),
			Theme.COLORS.outline)
		line.Rotation = base * (if part == 0 then 1 else -1)
		line.ZIndex   = 54
		tween(line, 0.12, { Size = UDim2.new(0.22, 0, 0, 4) })
	end
end

-- Partikel: kleine Quadrate, die in alle Richtungen auseinanderfliegen.
local function burstParticles(scene: Scene, color: Color3, count: number)
	for index = 1, count do
		local angle    = (index / count) * math.pi * 2 + math.random() * 0.4
		local distance = 180 + math.random() * 220
		local size     = 8 + math.random() * 10

		local particle = newFrame("Particle", scene.stage, UDim2.fromOffset(size, size), UDim2.fromScale(0.5, 0.48),
			if index % 3 == 0 then Color3.new(1, 1, 1) else color)
		particle.ZIndex   = 56
		particle.Rotation = math.random(0, 90)

		tween(particle, 0.6 + math.random() * 0.3, {
			Position = UDim2.new(0.5, math.cos(angle) * distance, 0.48, math.sin(angle) * distance),
			BackgroundTransparency = 1,
			Rotation = particle.Rotation + 180,
		})
		task.delay(1, function()
			particle:Destroy()
		end)
	end
end

local function burstRing(scene: Scene, color: Color3)
	local ring = newFrame("Ring", scene.stage, UDim2.fromOffset(60, 60), UDim2.fromScale(0.5, 0.48), color)
	ring.BackgroundTransparency = 1
	ring.ZIndex = 55
	round(ring)
	local stroke = Theme.stroke(ring, color, 10)

	tween(ring, 0.55, { Size = UDim2.fromOffset(620, 620) })
	tween(stroke, 0.55, { Transparency = 1, Thickness = 2 })
	task.delay(0.6, function()
		ring:Destroy()
	end)
end

local function flash(scene: Scene, strength: number)
	local white = newFrame("Flash", scene.root, UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0.5), Color3.new(1, 1, 1))
	white.BackgroundTransparency = 1 - strength
	white.ZIndex = 60
	tween(white, 0.45, { BackgroundTransparency = 1 })
	task.delay(0.5, function()
		white:Destroy()
	end)
end

local function shakeScreen(scene: Scene, seconds: number, strength: number)
	task.spawn(function()
		local untilTime = os.clock() + seconds
		while os.clock() < untilTime and scene.stage.Parent do
			scene.stage.Position = UDim2.fromOffset(
				math.random(-strength, strength),
				math.random(-strength, strength)
			)
			RunService.RenderStepped:Wait()
		end
		if scene.stage.Parent then
			scene.stage.Position = UDim2.fromOffset(0, 0)
		end
	end)
end

local function beam(scene: Scene, color: Color3)
	for index = 0, 2 do
		local ray = newFrame("Beam" .. index, scene.stage, UDim2.fromOffset(70, 0), UDim2.fromScale(0.5, 0.48), color)
		ray.BackgroundTransparency = 0.35
		ray.Rotation = -20 + index * 20
		ray.ZIndex   = 51
		Theme.gradient(ray, Theme.shade(color, 0.6), color, 0)
		tween(ray, 0.35, { Size = UDim2.fromOffset(70, 1400) })
		task.delay(REVEAL_SECONDS + 0.4, function()
			if ray.Parent then
				tween(ray, FADE_SECONDS, { BackgroundTransparency = 1 })
			end
		end)
	end
end

-- Die Reveal-Karte. Eine Mutation uebernimmt Farbe und Titel und bekommt
-- zusaetzlich einen farbigen Ring um die Karte.
local function buildReveal(scene: Scene, result: Types.HatchResult): Frame
	local baerchi  = result.baerchi
	local def      = BaerchiConfig.getById(baerchi.configId)
	local mutation = baerchi.mutation
	local rarityColor = Theme.rarityColor(baerchi.rarity)
	local color = if mutation then BaerchiConfig.getMutationColor(mutation) else rarityColor

	local card = Theme.panel("RevealCard", scene.stage, Theme.COLORS.panelDeep)
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position    = UDim2.fromScale(0.5, 0.48)
	card.Size        = UDim2.fromOffset(0, 0)
	card.ZIndex      = 57

	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color     = color
		stroke.Thickness = 5
	end

	if mutation then
		local ring = newFrame("MutationRing", card, UDim2.new(1, 22, 1, 22), UDim2.fromScale(0.5, 0.5), color)
		ring.BackgroundTransparency = 1
		ring.ZIndex = 56
		Theme.corner(ring, 22)
		Theme.stroke(ring, color, 4)
	end

	local function cardLabel(name: string, text: string, y: number, height: number, textColor: Color3): TextLabel
		local label = Theme.label(name, card, text)
		label.AnchorPoint    = Vector2.new(0.5, 0)
		label.Position       = UDim2.new(0.5, 0, 0, y)
		label.Size           = UDim2.new(1, -24, 0, height)
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.TextColor3     = textColor
		label.ZIndex         = 58
		return label
	end

	if result.isNew then
		local new = cardLabel("New", Loc.t("ui.hatch.new"), 10, 22, Theme.COLORS.goldGummy)
		Theme.outlineText(new)
	end

	-- Sammel-Update 2.2 (Luccini: "Baerchen bei Eioeffnung zeigen"): der
	-- Baerchi selbst, gross und drehend, in einem ViewportFrame.
	local view = Instance.new("ViewportFrame")
	view.Name                   = "Model"
	view.AnchorPoint            = Vector2.new(0.5, 0)
	view.Position               = UDim2.new(0.5, 0, 0, 34)
	view.Size                   = UDim2.new(1, -40, 0, MODEL_VIEW_HEIGHT)
	view.BackgroundTransparency = 1
	view.ZIndex                 = 58
	view.Ambient                = Color3.fromRGB(200, 200, 210)
	view.LightColor             = Color3.fromRGB(255, 250, 235)
	view.Parent                 = card
	local okModel, model = pcall(function()
		return BaerchiMesh.build(Vector3.zero, rarityColor, baerchi.rarity,
			if mutation then BaerchiConfig.getMutationColor(mutation) else nil)
	end)
	if okModel and model then
		model.Parent = view
		local cf, size = model:GetBoundingBox()
		local camera = Instance.new("Camera")
		camera.FieldOfView = 30
		local radius = math.max(size.X, size.Y, size.Z)
		local distance = radius / (2 * math.tan(math.rad(camera.FieldOfView / 2))) * 1.1
		camera.Parent = view
		view.CurrentCamera = camera
		-- Langsam drehen, solange die Karte steht (Ende: Karte zerstoert).
		local center = cf.Position
		local spin = 0
		local conn: RBXScriptConnection? = nil
		conn = RunService.RenderStepped:Connect(function(dt)
			if not view.Parent then
				if conn then conn:Disconnect() end
				return
			end
			spin += dt * 0.9
			local dir = Vector3.new(math.sin(spin), 0.3, math.cos(spin)).Unit
			camera.CFrame = CFrame.lookAt(center + dir * distance, center)
		end)
	end

	local title = (if mutation then Loc.name("mutation." .. mutation .. ".name", BaerchiConfig.getMutationDisplayName(mutation)):upper() .. "  " else "")
		.. Names.baerchi(baerchi.configId)
	local base = 34 + MODEL_VIEW_HEIGHT
	local titleLabel = cardLabel("Title", title, base + 2, 34, color)
	Theme.outlineText(titleLabel)

	cardLabel("Rarity", string.upper(Loc.t("rarity." .. baerchi.rarity)), base + 40, 24, rarityColor)

	local eggName = Loc.name("egg." .. tostring(result.eggType) .. ".name", tostring(result.eggType))
	local sub = cardLabel("Sub", Loc.t("ui.hatch.sub", {
		level = baerchi.level,
		mutation = if mutation then string.format("  •  %s x%.2g", Loc.name("mutation." .. mutation .. ".name", BaerchiConfig.getMutationDisplayName(mutation)), BaerchiConfig.getMutationMultiplier(mutation)) else "",
		egg = eggName,
	}), base + 66, 40, Theme.COLORS.textDim)
	sub.Font       = Theme.FONT_BODY
	sub.TextScaled = false
	sub.TextSize   = 15

	local tapHint = cardLabel("Tap", Loc.t("ui.hatch.tap_close"), CARD_SIZE.Y - 22, 16, Theme.COLORS.textDim)
	tapHint.TextScaled = false
	tapHint.TextSize   = 13

	tween(card, 0.28, { Size = UDim2.fromOffset(CARD_SIZE.X, CARD_SIZE.Y) }, Enum.EasingStyle.Back)
	return card
end

--------------------------------------------------------------------------------
-- Ablauf einer Oeffnung
--------------------------------------------------------------------------------

local function play(job: Job)
	local screenGui = _screenGui
	if not screenGui then return end

	_skip = false
	local scene = buildScene(screenGui, job.eggType)
	local opened = os.clock()

	scene.root.Activated:Connect(function()
		if os.clock() - opened >= SKIP_AFTER then
			_skip = true
		end
	end)

	-- 1. Drop
	tween(scene.backdrop, 0.25, { BackgroundTransparency = BACKDROP_TRANSPARENCY })
	tween(scene.egg, DROP_SECONDS, { Position = UDim2.fromScale(0.5, 0.48) }, Enum.EasingStyle.Bounce)
	task.wait(DROP_SECONDS)

	-- 2. Wackeln — in Schleife, bis das Ergebnis da ist (oder der Timeout greift).
	-- Danach noch die drei Stufen bis zum Burst. Die Stufen-Dauer haengt an der
	-- Rarity, die erst mit dem Ergebnis bekannt ist — vorher wackelt das Ei
	-- mit der leichtesten Stufe.
	local wobbleClock = 0
	local amplitude = 6
	local connection = RunService.RenderStepped:Connect(function(delta)
		wobbleClock += delta
		scene.egg.Rotation = math.sin(wobbleClock * 18) * amplitude
	end)

	while not job.result and not job.failed do
		if os.clock() - job.started > RESULT_TIMEOUT then
			job.failed = Loc.t("err.hatch_timeout")
			break
		end
		RunService.RenderStepped:Wait()
	end

	local result = job.result
	if not result then
		connection:Disconnect()
		if not job.silent then
			Notify.emit("hatch_failed", function()
				Toast.show(job.failed or Loc.t("err.hatch_failed"), Theme.COLORS.bad)
			end)
		end
		tween(scene.backdrop, FADE_SECONDS, { BackgroundTransparency = 1 })
		tween(scene.egg, FADE_SECONDS, { BackgroundTransparency = 1, Position = UDim2.fromScale(0.5, 1.3) })
		task.wait(FADE_SECONDS)
		scene.root:Destroy()
		return
	end

	local rarityColor = Theme.rarityColor(result.baerchi.rarity)
	local intensity   = intensityFor(result.baerchi.rarity)

	-- Wackel-Stufen mit Rissen
	local crackIndex = 0
	local stages = 3
	for stage = 1, stages do
		amplitude = intensity.amplitude * (stage / stages)
		local cracksNow = math.floor(intensity.cracks * stage / stages) - crackIndex
		for _ = 1, cracksNow do
			crackIndex += 1
			addCrack(scene, crackIndex)
		end
		waitSkippable(WOBBLE_STAGE_SECONDS * intensity.wobbleMul)
		if _skip then break end
	end

	-- 3. Aufladen: Zittern, Gluehen in der Rarity-Farbe
	if not _skip then
		scene.glow.BackgroundColor3 = rarityColor
		tween(scene.glow, CHARGE_SECONDS, { BackgroundTransparency = 0.35, Size = UDim2.fromOffset(EGG_SIZE.X * 2.1, EGG_SIZE.Y * 1.9) })
		tween(scene.eggStroke, CHARGE_SECONDS, { Color = rarityColor, Thickness = 8 })
		amplitude = intensity.amplitude * 1.4
		wobbleClock *= 2.5
		waitSkippable(CHARGE_SECONDS)
	end
	connection:Disconnect()

	-- 4. Burst
	flash(scene, intensity.flash)
	burstRing(scene, rarityColor)
	burstParticles(scene, rarityColor, intensity.particles)
	if intensity.shake then
		shakeScreen(scene, 0.45, 10)
	end
	if intensity.beam then
		beam(scene, rarityColor)
	end

	scene.egg.Visible  = false
	scene.label.Visible = false
	tween(scene.glow, 0.5, { BackgroundTransparency = 1 })

	-- 5. Reveal
	local card = buildReveal(scene, result)

	-- Nach dem Burst darf ein Tap die Karte sofort schliessen.
	_skip = false
	local revealStart = os.clock()
	-- Sammel-Update 2.2: steht mindestens REVEAL_SECONDS (plus Zuschlag fuer
	-- seltene), ein Tipp schliesst ab REVEAL_MIN_TAP, sonst nach REVEAL_AUTO_CLOSE.
	-- Warten in der Schlange weitere Eier, geht es nach der Mindestzeit weiter.
	local minimum = REVEAL_SECONDS + (if intensity.beam then 0.8 elseif intensity.shake then 0.4 else 0)
	while true do
		local shown = os.clock() - revealStart
		if _skip and shown > REVEAL_MIN_TAP then break end
		if shown >= REVEAL_AUTO_CLOSE then break end
		if shown >= minimum and #_queue > 1 then break end
		RunService.RenderStepped:Wait()
	end

	tween(scene.backdrop, FADE_SECONDS, { BackgroundTransparency = 1 })
	tween(card, FADE_SECONDS, { Size = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.wait(FADE_SECONDS)
	scene.root:Destroy()
end

local function pump()
	if _running then return end
	_running = true

	task.spawn(function()
		while #_queue > 0 do
			local job = _queue[1]
			local ok, err = pcall(play, job)
			if not ok then
				warn("[HatchAnimation] Abspielen fehlgeschlagen:", err)
				local gui = _screenGui
				local leftover = if gui then gui:FindFirstChild("HatchAnimation") else nil
				if leftover then leftover:Destroy() end
			end
			table.remove(_queue, 1)
		end
		_running = false
	end)
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Beim Klick auf "Oeffnen": startet (oder reiht ein) eine Animation fuer
-- dieses Ei. Das Ergebnis liefert spaeter deliver().
function HatchAnimation.request(eggType: Types.EggType)
	table.insert(_queue, {
		eggType = eggType,
		result  = nil,
		failed  = nil,
		silent  = false,
		started = os.clock(),
	})
	pump()
end

-- Die aelteste noch offene Oeffnung, oder nil.
local function oldestPending(): Job?
	for _, job in _queue do
		if not job.result and not job.failed then
			return job
		end
	end
	return nil
end

-- Server-Ergebnis eingetroffen. Ohne offene Oeffnung (z.B. ein Debug-Befehl
-- aus der Command Bar) wird eine neue Animation direkt mit Ergebnis gestartet.
function HatchAnimation.deliver(result: Types.HatchResult)
	local job = oldestPending()
	if job then
		job.result = result
		return
	end

	table.insert(_queue, {
		eggType = result.eggType,
		result  = result,
		failed  = nil,
		silent  = false,
		started = os.clock(),
	})
	pump()
end

-- Der Server hat das Oeffnen abgelehnt (ActionFailed fuer RequestHatchEgg).
-- Die Fehlermeldung zeigt der Toast ohnehin — hier wird nur die Animation
-- ohne eigene zweite Meldung beendet.
function HatchAnimation.reject(reason: string)
	local job = oldestPending()
	if job then
		job.failed = reason
		job.silent = true
	end
end

function HatchAnimation.init(screenGui: ScreenGui)
	_screenGui = screenGui

	-- Beim Verlassen nichts haengen lassen
	Players.LocalPlayer.AncestryChanged:Connect(function()
		table.clear(_queue)
	end)

	print("[HatchAnimation] Initialisiert")
end

return HatchAnimation
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX94"><Properties><string name="Name">HatchPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- HatchPanel.luau
-- StarterPlayerScripts/UI/HatchPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die Eier im Lager auflisten und per "Oeffnen" sofort oeffnen lassen
--
-- Seit v12 (Ei-Baum-Konzept, Block A) gibt es keine Brut-Slots, keine
-- Brutzeit und keine Preise mehr: das Menue ist nur noch eine Liste der Eier
-- im Lager. Ein Klick auf "Oeffnen" startet sofort die Ei-Animation
-- (HatchAnimation) und schickt die Anfrage an den Server, der allein
-- entscheidet, was herauskommt.
--
-- Eier kommen aus Legen, Events und Rebirth-Meilensteinen. Kaufen kann man
-- nur das Basis-Ei, und das nur beim versteckten Haendler in der Welt —
-- bewusst ohne Hinweis hier.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types     = require(ReplicatedStorage.Network.Types)
local Remotes   = require(ReplicatedStorage.Network.Remotes)
local EggConfig = require(ReplicatedStorage.Config.EggConfig)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local Names     = require(ReplicatedStorage.Localization.Names)
local EggTree   = require(ReplicatedStorage.Modules.EggTree)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)
local IncubatorRules = require(ReplicatedStorage.Modules.IncubatorRules)   -- Sammel-Update 8

local Theme          = require(script.Parent.Theme)
local PanelManager   = require(script.Parent.PanelManager)
local EggIcon        = require(script.Parent.EggIcon)
local HatchAnimation = require(script.Parent.HatchAnimation)
local ClientState    = require(script.Parent.Parent.Controllers.ClientState)

local HatchPanel = {}

local PANEL_NAME = "Hatch"
local EGG_HEIGHT = 84

local _root: Frame?              = nil
local _scroller: ScrollingFrame? = nil
local _signature = ""

--------------------------------------------------------------------------------
-- Reihenfolge der Eier
--------------------------------------------------------------------------------

-- Nach EggConfig.sortOrder: stabil (die Iteration ueber EggConfig.data waere
-- es nicht) und unabhaengig von der frueheren Brutdauer.
local function buildEggOrder(): { Types.EggType }
	local list: { Types.EggType } = {}
	for eggType in EggConfig.data do
		table.insert(list, eggType)
	end

	table.sort(list, function(a, b)
		local orderA = EggConfig.data[a].sortOrder or 999
		local orderB = EggConfig.data[b].sortOrder or 999
		if orderA ~= orderB then
			return orderA < orderB
		end
		return a < b
	end)

	return list
end

local EGG_ORDER = buildEggOrder()

--------------------------------------------------------------------------------
-- Zeilen bauen
--------------------------------------------------------------------------------

local function buildEggCard(parent: Instance, order: number, eggType: Types.EggType, stock: number)
	local def = EggConfig.data[eggType]

	local card = Theme.panel("Egg_" .. eggType, parent, Theme.COLORS.panel)
	card.Size        = UDim2.new(1, -8, 0, EGG_HEIGHT)
	card.LayoutOrder = order

	-- Das Ei links in Farbe und Muster seines Pfads (EggIcon), damit man die
	-- Sorte ohne Lesen erkennt — genau so liegt es auch auf dem Plot.
	local icon = EggIcon.make(card, eggType, 62, 3)
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.Position    = UDim2.new(0, 10, 0.5, 0)

	local name = Theme.label("Name", card, Names.egg(eggType))
	name.Position = UDim2.new(0, 68, 0, 8)
	name.Size     = UDim2.new(1, -200, 0, 22)

	-- v14: ein noch gesperrtes Ei im Lager ist ein Sprung-Ei aus einem Event.
	local data = ClientState.get()
	local locked = data ~= nil and not EggTree.isUnlocked(data.eggTree, eggType)
	local desc = Theme.bodyText("Desc", card, if locked then Loc.t("ui.tree.jump_hint") else Names.eggDesc(eggType))
	desc.Position = UDim2.new(0, 68, 0, 32)
	desc.Size     = UDim2.new(1, -200, 0, 40)

	local count = Theme.label("Count", card, "x" .. stock)
	count.Position       = UDim2.new(1, -128, 0, 8)
	count.Size           = UDim2.new(0, 116, 0, 22)
	count.TextXAlignment = Enum.TextXAlignment.Right
	count.TextColor3     = Theme.COLORS.good

	-- Sammel-Update 05.10. (Paket 8): Eier ab Gold-Stufe gehen in den
	-- Inkubator statt sofort auf (gleiche Regel wie der Server).
	local toIncubator = FeatureFlags.isOn("INCUBATOR") and not FeatureFlags.isOn("INCUBATOR_BREED") and data ~= nil
		and IncubatorRules.requiresIncubator(eggType, IncubatorRules.isUnlocked(data))
	local button = Theme.bigButton("Open", card,
		if toIncubator then Loc.t("ui.hatch.to_incubator") else Loc.t("ui.hatch.open"),
		if toIncubator then Theme.COLORS.growth else Theme.COLORS.accent)
	button.Position = UDim2.new(1, -128, 0, 38)
	button.Size     = UDim2.new(0, 116, 0, 32)

	button.Activated:Connect(function()
		if toIncubator then
			Remotes.RequestIncubatorStart:FireServer(eggType)
			PanelManager.open("Incubator")
			return
		end
		-- Animation zuerst: der Klick soll sich sofort anfuehlen. Was
		-- herauskommt, kommt trotzdem ausschliesslich vom Server.
		HatchAnimation.request(eggType)
		Remotes.RequestHatchEgg:FireServer(eggType)
	end)
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

function HatchPanel.refresh()
	local scroller = _scroller
	local root     = _root
	if not scroller or not root then return end
	if not root.Visible then return end

	local data = ClientState.get()
	if not data then return end

	-- Sammel-Update 1.3-Muster: nur neu bauen, wenn sich das Lager (oder die
	-- Sprache) aendert — sonst zerstoert jeder Datenstand den Knopf unter dem
	-- Finger, und der Tipp kommt nicht an.
	local parts = { Loc.getLanguage(), tostring(IncubatorRules.isUnlocked(data)) }
	for _, eggType in EGG_ORDER do
		local n = data.island.eggStock[eggType] or 0
		if n > 0 then table.insert(parts, eggType .. n) end
	end
	local signature = table.concat(parts, "|")
	if signature == _signature then return end
	_signature = signature

	for _, child in scroller:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	local shown = 0
	for order, eggType in EGG_ORDER do
		local stock = data.island.eggStock[eggType] or 0
		if stock > 0 then
			buildEggCard(scroller, order, eggType, stock)
			shown += 1
		end
	end

	if shown == 0 then
		local empty = Theme.bodyText("Empty", scroller, Loc.t("ui.hatch.empty"))
		empty.Size        = UDim2.new(1, -8, 0, 60)
		empty.LayoutOrder = 1
	end
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local root = _root
	if not root then return end

	root.Visible = true
	_signature = ""
	HatchPanel.refresh()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function HatchPanel.init(screenGui: ScreenGui)
	HatchAnimation.init(screenGui)

	local root = Theme.dialog(
		"HatchPanel", screenGui,
		Vector2.new(0.52, 0.68),
		Vector2.new(320, 320),
		Vector2.new(560, 600)
	)
	_root = root

	local header = Theme.dialogHeader(root, Loc.t("ui.menu.eggs"), function()
		PanelManager.close(PANEL_NAME)
	end)

	-- v14: Knopf zum Ei-Baum (Presse, Freischaltung, Drop-Vorschau)
	local treeButton = Theme.button("TreeButton", header.Parent :: Instance, Loc.t("ui.menu.tree"), Theme.COLORS.growth)
	treeButton.AnchorPoint = Vector2.new(1, 0.5)
	treeButton.Position = UDim2.new(1, -40, 0.5, 0)
	treeButton.Size = UDim2.new(0, 92, 0, 26)
	treeButton.Activated:Connect(function()
		PanelManager.open("EggTree")
	end)
	Loc.onChanged(function()
		treeButton.Text = Loc.t("ui.menu.tree")
	end)

	local body     = Theme.dialogBody(root)
	local scroller = Theme.scroller("List", body)
	scroller.Size = UDim2.fromScale(1, 1)
	_scroller = scroller

	local layout = Theme.listLayout(scroller, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	-- Neue Serverdaten: Lagerbestand neu zeichnen. Nur wenn sichtbar.
	ClientState.onChanged(function()
		HatchPanel.refresh()
	end)

	Remotes.HatchResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		HatchAnimation.deliver(result :: Types.HatchResult)
	end)

	-- Abgelehnt (z.B. Lager inzwischen leer): die Animation ohne Ergebnis
	-- beenden. Die Meldung selbst zeigt der Toast (ActionFailed).
	Remotes.ActionFailed.OnClientEvent:Connect(function(action: any, reason: any)
		if action == "RequestHatchEgg" then
			HatchAnimation.reject(tostring(reason))
		end
	end)

	print("[HatchPanel] Initialisiert")
end

return HatchPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX95"><Properties><string name="Name">HudRow</string><ProtectedString name="Source"><![CDATA[--!strict
-- HudRow.luau
-- StarterPlayerScripts/UI/HudRow.luau
--
-- Einzige Zustaendigkeit:
--   - Die Knopf-Zeile oben links (FeatureFlags.HUD_ROW_V2): Zahnrad, Quests,
--     Shop — alles nebeneinander in einer Zeile.
--
-- Wunsch Projektinhaber 05.10.: Die Quest-Karte muss nicht die ganze Zeit
-- sichtbar sein; ein kleiner Knopf rechts neben den Einstellungen reicht, und
-- der Shop sitzt rechts daneben (statt in der Kachelleiste rechts).
--
-- Das Zahnrad baut weiterhin Hud (Sprache); hier wird es nur in die Zeile
-- gehaengt. Die Quest-Karte (QuestTracker) bleibt gebaut, ist aber versteckt —
-- ihr Belohnungs-Toast laeuft weiter. Ein rotes "!" an den Knoepfen zeigt,
-- dass etwas abholbereit ist.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types        = require(ReplicatedStorage.Network.Types)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local Theme        = require(script.Parent.Theme)
local Icons        = require(script.Parent.Icons)
local PanelManager = require(script.Parent.PanelManager)
local Unlock       = require(script.Parent.Unlock)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local HudRow = {}

local SIZE = 38
local GAP  = 6

type Button = { button: TextButton, alert: Frame }
local _quests: Button? = nil
local _shop: Button? = nil

local function makeAlert(parent: GuiObject): Frame
	local alert = Theme.panel("Alert", parent, Theme.COLORS.bad)
	alert.AnchorPoint = Vector2.new(1, 0)
	alert.Position    = UDim2.new(1, 6, 0, -6)
	alert.Size        = UDim2.fromOffset(18, 18)
	alert.Visible     = false
	alert.ZIndex      = 6
	Theme.corner(alert, 9)
	local bang = Theme.label("Bang", alert, "!")
	bang.Size           = UDim2.fromScale(1, 1)
	bang.TextXAlignment = Enum.TextXAlignment.Center
	bang.ZIndex         = 7
	return alert
end

local function makeButton(parent: Instance, name: string, order: number, icon: string, fallback: string, color: Color3, onClick: () -> ()): Button
	local button = Theme.button(name, parent, fallback, color)
	button.Size        = UDim2.fromOffset(SIZE, SIZE)
	button.LayoutOrder = order
	button.TextColor3  = Theme.COLORS.outline
	if Icons.has(icon) then
		button.Text = ""
		local image = Icons.make(button, icon)
		image.AnchorPoint = Vector2.new(0.5, 0.5)
		image.Position    = UDim2.fromScale(0.5, 0.5)
		image.Size        = UDim2.fromScale(0.82, 0.82)
		image.ZIndex      = 3
	end
	button.Activated:Connect(onClick)
	return { button = button, alert = makeAlert(button) }
end

local function questsReady(data: Types.PlayerDataUpdate): boolean
	local quests = (data :: any).quests
	if not quests then return false end
	local chain = quests.chain
	if chain and chain.progress >= chain.target then return true end
	for _, entry in quests.daily or {} do
		if not entry.claimed and entry.progress >= entry.target then return true end
	end
	return false
end

local function refresh(data: Types.PlayerDataUpdate)
	local quests = _quests
	if quests then
		quests.alert.Visible = questsReady(data)
	end
	local shop = _shop
	if shop then
		Unlock.apply("tile_shop", shop.button)
		local view = (data :: any).shop
		shop.alert.Visible = Unlock.isNew("tile_shop") or (view ~= nil and view.freeReady == true)
	end
end

function HudRow.init(screenGui: ScreenGui)
	if not FeatureFlags.isOn("HUD_ROW_V2") then return end

	local row = Theme.container("HudRow", screenGui)
	-- Gleiche Stelle wie vorher das Zahnrad (Hud), Pixel-Offset wie dort.
	row.Position = UDim2.new(0.012, 12, 0, 106)
	row.Size     = UDim2.fromOffset(SIZE * 3 + GAP * 2 + 8, SIZE)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection     = Enum.FillDirection.Horizontal
	layout.Padding           = UDim.new(0, GAP)
	layout.SortOrder         = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent            = row

	-- 1) Zahnrad aus dem Hud in die Zeile holen
	local gear = screenGui:FindFirstChild("Language")
	if gear and gear:IsA("GuiObject") then
		gear.Parent      = row
		gear.Size        = UDim2.fromOffset(SIZE, SIZE)
		gear.LayoutOrder = 1
	end

	-- 2) Quests
	_quests = makeButton(row, "QuestButton", 2, "scroll", "📜", Theme.COLORS.panelLight, function()
		PanelManager.toggle("Quests")
	end)

	-- 3) Shop (erscheint wie die alte Kachel erst ab der 2. Sitzung, UnlockRules)
	if FeatureFlags.isOn("SHOP_V1") then
		_shop = makeButton(row, "ShopButton", 3, "goldgummy", "GG", Theme.COLORS.goldGummy, function()
			Unlock.markSeen("tile_shop")
			PanelManager.toggle("Shop")
		end)
	end

	-- Quest-Karte verstecken (sie bleibt fuer ihre Toasts gebaut)
	local card = screenGui:FindFirstChild("QuestTracker")
	if card and card:IsA("GuiObject") then
		card.Visible = false
	end

	ClientState.onChanged(refresh)
	PanelManager.onOpened(function(name)
		if name == "Shop" then Unlock.markSeen("tile_shop") end
	end)
end

return HudRow
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX96"><Properties><string name="Name">IncubatorPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- IncubatorPanel.luau
-- StarterPlayerScripts/UI/IncubatorPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Das Fenster des Inkubators (Sammel-Update 05.10., Paket 8): Plaetze mit
--     Ei und Restzeit (Abholen / Beschleunigen), Eier aus dem Lager zum
--     Einlegen, Ausbau mit Vorher/Nachher.
--
-- Rechnet mit Modules/IncubatorRules (dieselben Regeln wie der Server) und
-- workspace:GetServerTimeNow() als "jetzt" — die Zeitmarken der Plaetze sind
-- os.time() des Servers. Entscheiden tut der Server (IncubatorService).
--
-- Neu gebaut wird nur, wenn sich der Inhalt aendert (Signatur); die Restzeiten
-- laufen in einer eigenen Schleife. So geht ein Tipp nicht verloren, weil die
-- Zeile gerade neu gebaut wurde (siehe Sammel-Update 1.3).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local Types           = require(ReplicatedStorage.Network.Types)
local Remotes         = require(ReplicatedStorage.Network.Remotes)
local Loc             = require(ReplicatedStorage.Localization.Loc)
local Names = require(game:GetService("ReplicatedStorage").Localization.Names)
local EggConfig       = require(ReplicatedStorage.Config.EggConfig)
local IncubatorConfig = require(ReplicatedStorage.Config.IncubatorConfig)
local IncubatorRules  = require(ReplicatedStorage.Modules.IncubatorRules)

local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local EggCalculator   = require(ReplicatedStorage.Modules.EggCalculator)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local EggIcon      = require(script.Parent.EggIcon)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local IncubatorPanel = {}

local PANEL_NAME = "Incubator"
IncubatorPanel.PANEL_NAME = PANEL_NAME

local ROW_H = 64

local _root: Frame? = nil
local _scroller: ScrollingFrame? = nil
local _signature = ""
-- Zeilen der Plaetze: Restzeit-Label und Knoepfe, damit die Uhr ohne Neubau laeuft
type SlotRow = { slot: number, timeLabel: TextLabel, collect: TextButton, speed: TextButton }
local _slotRows: { SlotRow } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function eggName(eggType: string): string
	local def = EggConfig.data[eggType :: Types.EggType]
	return Names.egg(eggType)
end

local function breedOn(): boolean
	return FeatureFlags.isOn("INCUBATOR_BREED")
end

-- INCUBATOR_BREED: Inhalt haengt an Plaetzen, Baerchis und Ausbau
local function breedSignature(data: any): string
	local incubator = data.island.incubator
	local parts = { "breed", tostring(incubator.level), tostring(IncubatorRules.slotCountFor(data)),
		tostring(data.gummies), tostring(data.goldGummies), Loc.getLanguage(), tostring(data.island.equippedUid) }
	for _, entry in incubator.breeders or {} do
		table.insert(parts, string.format("%d=%s", entry.slot, entry.uid))
	end
	local uids = {}
	for uid, baerchi in data.island.baerchis do
		table.insert(uids, uid .. ":" .. baerchi.rarity .. ":" .. tostring(baerchi.mutation))
	end
	table.sort(uids)
	table.insert(parts, table.concat(uids, ","))
	return table.concat(parts, "|")
end

local function signatureOf(data: any): string
	local incubator = data.island.incubator
	if not incubator then return "none" end
	if breedOn() then return breedSignature(data) end
	local parts = { tostring(incubator.level), tostring(IncubatorRules.slotCountFor(data)),
		tostring(data.gummies), tostring(data.goldGummies), Loc.getLanguage() }
	for _, entry in incubator.slots do
		table.insert(parts, string.format("%d=%s@%d", entry.slot, entry.eggType, entry.finishAt))
	end
	local stock = {}
	for eggType, count in data.island.eggStock do
		if count > 0 then table.insert(stock, eggType .. "x" .. count) end
	end
	table.sort(stock)
	table.insert(parts, table.concat(stock, ","))
	return table.concat(parts, "|")
end

--------------------------------------------------------------------------------
-- Restzeiten (laeuft jede halbe Sekunde, baut nichts neu)
--------------------------------------------------------------------------------

-- INCUBATOR_BREED: Zeit bis zum naechsten Ei je Platz
type BreedRow = { slot: number, timeLabel: TextLabel }
local _breedRows: { BreedRow } = {}

local function tickBreedRows(data: any)
	local incubator = data.island.incubator
	local t = now()
	for _, row in _breedRows do
		local entry = IncubatorRules.findBreeder(incubator.breeders, row.slot)
		local baerchi = if entry then data.island.baerchis[entry.uid] else nil
		if not entry or not baerchi then continue end
		local seconds = IncubatorRules.breedSeconds(baerchi.rarity, incubator.level)
		local left = math.max(0, entry.lastEggAt + seconds - t)
		row.timeLabel.Text = Loc.t("ui.incubator.next_egg", { time = Loc.formatDuration(math.ceil(left)) })
	end
end

local function tickRows()
	local data = ClientState.get()
	if not data or not data.island.incubator then return end
	if breedOn() then
		tickBreedRows(data)
		return
	end
	local t = now()
	for _, row in _slotRows do
		local entry = IncubatorRules.findSlot(data.island.incubator.slots, row.slot)
		if not entry then continue end
		local ready = IncubatorRules.isReady(entry, t)
		row.timeLabel.Text = if ready
			then Loc.t("ui.incubator.ready")
			else Loc.t("ui.incubator.left", { time = Loc.formatDuration(IncubatorRules.remaining(entry, t)) })
		row.timeLabel.TextColor3 = if ready then Theme.COLORS.good else Theme.COLORS.textDim
		row.collect.Visible = ready
		row.speed.Visible = not ready
		row.speed.Text = Loc.t("ui.incubator.speedup", { gold = IncubatorRules.speedUpCost(entry, t) })
	end
end

--------------------------------------------------------------------------------
-- Aufbau des Inhalts
--------------------------------------------------------------------------------

local function sectionRow(parent: Instance, order: number, text: string)
	local holder = Theme.container("Section", parent)
	holder.Size = UDim2.new(1, -8, 0, 20)
	holder.LayoutOrder = order
	Theme.sectionLabel("Label", holder, text).Size = UDim2.fromScale(1, 1)
end

local function baerchiName(baerchi: any): string
	local def = BaerchiConfig.getById(baerchi.configId)
	return Names.baerchi(baerchi.configId)
end

-- Kurze Chancen-Zeile: "Basis-Ei 60% · Zucker-Ei 30% · ..."
local function oddsLine(baerchi: any, eggTree: any, maxEntries: number): string
	local parts: { string } = {}
	for i, entry in EggCalculator.getResolvedChances(baerchi, eggTree) do
		if i > maxEntries then break end
		local percent = if entry.percent >= 10 then string.format("%d", math.floor(entry.percent + 0.5))
			else Loc.formatDecimal(entry.percent, 1)
		table.insert(parts, string.format("%s %s%%", eggName(entry.eggType), percent))
	end
	return table.concat(parts, " · ")
end

local function upgradeSection(scroller: ScrollingFrame, data: any, count: number, nextOrder: () -> number)
	local incubator = data.island.incubator
	sectionRow(scroller, nextOrder(), Loc.t("ui.incubator.upgrade_title", { level = incubator.level }))
	local cost = IncubatorRules.upgradeCost(incubator.level + 1)
	local upRow = Theme.panel("Upgrade", scroller, Theme.COLORS.panel)
	upRow.Size = UDim2.new(1, -8, 0, 70)
	upRow.LayoutOrder = nextOrder()
	local effect = Theme.bodyText("Effect", upRow, "")
	effect.Position = UDim2.new(0, 10, 0, 4)
	effect.Size = UDim2.new(1, -160, 1, -8)
	if cost then
		local nextCount = IncubatorRules.slotCount(incubator.level + 1, data.rebirthCount or 0, data.indexClaimed)
		effect.Text = Loc.t("ui.incubator.upgrade_effect", {
			speedNow  = Loc.formatDecimal(IncubatorRules.speed(incubator.level), 2),
			speedNext = Loc.formatDecimal(IncubatorRules.speed(incubator.level + 1), 2),
			slotsNow  = count,
			slotsNext = nextCount,
		})
		local up = Theme.bigButton("Up", upRow, Loc.t("ui.incubator.upgrade_cost", {
			gummies = cost.gummies, gold = cost.goldGummies }), Theme.COLORS.gummy)
		up.AnchorPoint = Vector2.new(1, 0.5)
		up.Position = UDim2.new(1, -8, 0.5, 0)
		up.Size = UDim2.fromOffset(140, 48)
		Theme.setEnabled(up, data.gummies >= cost.gummies and data.goldGummies >= cost.goldGummies)
		up.Activated:Connect(function()
			Remotes.RequestUpgradeIncubator:FireServer()
		end)
	else
		effect.Text = Loc.t("ui.incubator.max_level")
	end
end

-- INCUBATOR_BREED: Plaetze mit Baerchi (Chancen, naechstes Ei, Herausnehmen),
-- darunter die Baerchis zum Einsetzen und der Ausbau.
local function rebuildBreed(scroller: ScrollingFrame, data: any)
	table.clear(_breedRows)
	local incubator = data.island.incubator
	local breeders = incubator.breeders or {}
	local count = IncubatorRules.slotCountFor(data)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	local hint = Theme.bodyText("Hint", scroller, Loc.t("ui.incubator.breed_hint"))
	hint.Size = UDim2.new(1, -8, 0, 40)
	hint.LayoutOrder = nextOrder()

	sectionRow(scroller, nextOrder(), Loc.t("ui.incubator.slots", { used = #breeders, total = count }))
	local highest = count
	for _, entry in breeders do highest = math.max(highest, entry.slot) end
	for index = 1, highest do
		local entry = IncubatorRules.findBreeder(breeders, index)
		local baerchi = if entry then data.island.baerchis[entry.uid] else nil
		local row = Theme.panel("Slot_" .. index, scroller, Theme.COLORS.panel)
		row.Size = UDim2.new(1, -8, 0, if baerchi then 86 else ROW_H)
		row.LayoutOrder = nextOrder()

		if entry and baerchi then
			local name = Theme.label("Name", row, string.format("%s · %s · Lv.%d",
				baerchiName(baerchi), Loc.name("rarity." .. baerchi.rarity, baerchi.rarity), baerchi.level))
			name.Position = UDim2.new(0, 10, 0, 4)
			name.Size = UDim2.new(1, -150, 0, 22)
			name.TextColor3 = BaerchiConfig.getRarityColor(baerchi.rarity)

			local odds = Theme.bodyText("Odds", row, oddsLine(baerchi, data.eggTree, 4))
			odds.Position = UDim2.new(0, 10, 0, 28)
			odds.Size = UDim2.new(1, -150, 0, 34)
			odds.TextWrapped = true

			local timeLabel = Theme.label("Time", row, "")
			timeLabel.Position = UDim2.new(0, 10, 0, 62)
			timeLabel.Size = UDim2.new(1, -150, 0, 20)
			timeLabel.Font = Theme.FONT_BODY
			timeLabel.TextColor3 = Theme.COLORS.textDim
			if index > count then
				timeLabel.Text = "🔒 " .. Loc.t("ui.incubator.slot_locked")
			else
				table.insert(_breedRows, { slot = index, timeLabel = timeLabel })
			end

			local take = Theme.button("Take", row, Loc.t("ui.incubator.take"), Theme.COLORS.panelLight)
			take.AnchorPoint = Vector2.new(1, 0.5)
			take.Position = UDim2.new(1, -8, 0.5, 0)
			take.Size = UDim2.fromOffset(128, 40)
			take.Activated:Connect(function()
				Remotes.RequestIncubatorBaerchi:FireServer("take", index)
			end)
		else
			local free = Theme.bodyText("Free", row, Loc.t("ui.incubator.free_breed"))
			free.Position = UDim2.new(0, 12, 0, 0)
			free.Size = UDim2.new(1, -24, 1, 0)
			free.TextYAlignment = Enum.TextYAlignment.Center
		end
	end

	-- Baerchis zum Einsetzen --------------------------------------------------
	sectionRow(scroller, nextOrder(), Loc.t("ui.incubator.pick"))
	local freeSlot = IncubatorRules.firstFreeBreeder(breeders, count) ~= nil
	local list: { any } = {}
	for uid, baerchi in data.island.baerchis do
		if IncubatorRules.canBreed(data.island, uid) then table.insert(list, baerchi) end
	end
	local rank: { [string]: number } = {}
	for i, rarity in BaerchiConfig.RARITY_ORDER do rank[rarity] = i end
	table.sort(list, function(a, b)
		local ra, rb = rank[a.rarity] or 0, rank[b.rarity] or 0
		if ra ~= rb then return ra > rb end
		if a.level ~= b.level then return a.level > b.level end
		return a.uid < b.uid
	end)
	if #list == 0 then
		local empty = Theme.bodyText("Empty", scroller, Loc.t("ui.incubator.no_baerchis"))
		empty.Size = UDim2.new(1, -8, 0, 40)
		empty.LayoutOrder = nextOrder()
	end
	for _, baerchi in list do
		local row = Theme.panel("Pick_" .. baerchi.uid, scroller, Theme.COLORS.panel)
		row.Size = UDim2.new(1, -8, 0, 70)
		row.LayoutOrder = nextOrder()

		local name = Theme.label("Name", row, string.format("%s · %s · Lv.%d",
			baerchiName(baerchi), Loc.name("rarity." .. baerchi.rarity, baerchi.rarity), baerchi.level))
		name.Position = UDim2.new(0, 10, 0, 4)
		name.Size = UDim2.new(1, -150, 0, 22)
		name.TextColor3 = BaerchiConfig.getRarityColor(baerchi.rarity)

		local info = Theme.bodyText("Info", row, Loc.t("ui.incubator.breed_rate", {
			time = Loc.formatDuration(IncubatorRules.breedSeconds(baerchi.rarity, incubator.level)) })
			.. "\n" .. oddsLine(baerchi, data.eggTree, 3))
		info.Position = UDim2.new(0, 10, 0, 26)
		info.Size = UDim2.new(1, -150, 0, 40)
		info.TextWrapped = true

		local put = Theme.button("Put", row, Loc.t("ui.incubator.put_baerchi"), Theme.COLORS.accent)
		put.AnchorPoint = Vector2.new(1, 0.5)
		put.Position = UDim2.new(1, -8, 0.5, 0)
		put.Size = UDim2.fromOffset(128, 40)
		Theme.setEnabled(put, freeSlot)
		local uid = baerchi.uid
		put.Activated:Connect(function()
			Remotes.RequestIncubatorBaerchi:FireServer("put", uid)
		end)
	end

	upgradeSection(scroller, data, count, nextOrder)
	tickBreedRows(data)
end

local function rebuild()
	local scroller = _scroller
	if not scroller then return end
	local data = ClientState.get()
	if not data or not data.island.incubator then return end

	for _, child in scroller:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	table.clear(_slotRows)

	if breedOn() then
		rebuildBreed(scroller, data)
		return
	end

	local incubator = data.island.incubator
	local count = IncubatorRules.slotCountFor(data)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	-- Plaetze ---------------------------------------------------------------
	sectionRow(scroller, nextOrder(), Loc.t("ui.incubator.slots", { used = #incubator.slots, total = count }))
	local readyCount = 0
	for index = 1, math.max(count, #incubator.slots) do
		local entry = IncubatorRules.findSlot(incubator.slots, index)
		local row = Theme.panel("Slot_" .. index, scroller, Theme.COLORS.panel)
		row.Size = UDim2.new(1, -8, 0, ROW_H)
		row.LayoutOrder = nextOrder()

		if entry then
			local icon = EggIcon.make(row, entry.eggType, 48, 2)
			icon.AnchorPoint = Vector2.new(0, 0.5)
			icon.Position = UDim2.new(0, 8, 0.5, 0)

			local name = Theme.label("Name", row, eggName(entry.eggType))
			name.Position = UDim2.new(0, 64, 0, 6)
			name.Size = UDim2.new(1, -200, 0, 24)

			local timeLabel = Theme.label("Time", row, "")
			timeLabel.Position = UDim2.new(0, 64, 0, 32)
			timeLabel.Size = UDim2.new(1, -200, 0, 22)
			timeLabel.Font = Theme.FONT_BODY

			local collect = Theme.bigButton("Collect", row, Loc.t("ui.incubator.collect"), Theme.COLORS.good)
			collect.AnchorPoint = Vector2.new(1, 0.5)
			collect.Position = UDim2.new(1, -8, 0.5, 0)
			collect.Size = UDim2.fromOffset(128, 40)
			collect.Activated:Connect(function()
				Remotes.RequestIncubatorCollect:FireServer(index)
			end)

			local speed = Theme.button("Speed", row, "", Theme.COLORS.goldGummy)
			speed.AnchorPoint = Vector2.new(1, 0.5)
			speed.Position = UDim2.new(1, -8, 0.5, 0)
			speed.Size = UDim2.fromOffset(128, 40)
			speed.TextColor3 = Theme.COLORS.outline
			speed.Activated:Connect(function()
				Remotes.RequestIncubatorSpeedUp:FireServer(index)
			end)

			table.insert(_slotRows, { slot = index, timeLabel = timeLabel, collect = collect, speed = speed })
			if IncubatorRules.isReady(entry, now()) then readyCount += 1 end
		else
			local free = Theme.bodyText("Free", row, Loc.t("ui.incubator.free"))
			free.Position = UDim2.new(0, 12, 0, 0)
			free.Size = UDim2.new(1, -24, 1, 0)
			free.TextYAlignment = Enum.TextYAlignment.Center
		end
	end

	if readyCount > 1 then
		local allRow = Theme.container("CollectAll", scroller)
		allRow.Size = UDim2.new(1, -8, 0, 40)
		allRow.LayoutOrder = nextOrder()
		local all = Theme.bigButton("All", allRow, Loc.t("ui.incubator.collect_all", { n = readyCount }), Theme.COLORS.good)
		all.Size = UDim2.fromScale(1, 1)
		all.Activated:Connect(function()
			Remotes.RequestIncubatorCollect:FireServer("all")
		end)
	end

	-- Eier aus dem Lager --------------------------------------------------------
	sectionRow(scroller, nextOrder(), Loc.t("ui.incubator.stock"))
	local freeSlot = IncubatorRules.firstFree(incubator.slots, count) ~= nil
	local ids: { Types.EggType } = {}
	for eggType, n in data.island.eggStock do
		if n > 0 and EggConfig.data[eggType] then table.insert(ids, eggType) end
	end
	table.sort(ids, function(a, b) return EggConfig.data[a].sortOrder < EggConfig.data[b].sortOrder end)
	if #ids == 0 then
		local empty = Theme.bodyText("Empty", scroller, Loc.t("ui.incubator.no_eggs"))
		empty.Size = UDim2.new(1, -8, 0, 40)
		empty.LayoutOrder = nextOrder()
	end
	for _, eggType in ids do
		local row = Theme.panel("Egg_" .. eggType, scroller, Theme.COLORS.panel)
		row.Size = UDim2.new(1, -8, 0, 52)
		row.LayoutOrder = nextOrder()

		local icon = EggIcon.make(row, eggType, 40, 2)
		icon.AnchorPoint = Vector2.new(0, 0.5)
		icon.Position = UDim2.new(0, 8, 0.5, 0)

		local name = Theme.label("Name", row, string.format("%s  x%d", eggName(eggType), data.island.eggStock[eggType] or 0))
		name.Position = UDim2.new(0, 56, 0, 4)
		name.Size = UDim2.new(1, -200, 0, 22)

		local brew = Theme.bodyText("Brew", row, Loc.t("ui.incubator.brew_time", {
			time = Loc.formatDuration(IncubatorRules.brewSeconds(eggType, incubator.level)) }))
		brew.Position = UDim2.new(0, 56, 0, 26)
		brew.Size = UDim2.new(1, -200, 0, 20)

		local put = Theme.button("Put", row, Loc.t("ui.incubator.put"), Theme.COLORS.accent)
		put.AnchorPoint = Vector2.new(1, 0.5)
		put.Position = UDim2.new(1, -8, 0.5, 0)
		put.Size = UDim2.fromOffset(128, 36)
		Theme.setEnabled(put, freeSlot)
		put.Activated:Connect(function()
			Remotes.RequestIncubatorStart:FireServer(eggType)
		end)
	end

	-- Ausbau -------------------------------------------------------------------
	sectionRow(scroller, nextOrder(), Loc.t("ui.incubator.upgrade_title", { level = incubator.level }))
	local cost = IncubatorRules.upgradeCost(incubator.level + 1)
	local upRow = Theme.panel("Upgrade", scroller, Theme.COLORS.panel)
	upRow.Size = UDim2.new(1, -8, 0, 70)
	upRow.LayoutOrder = nextOrder()
	local effect = Theme.bodyText("Effect", upRow, "")
	effect.Position = UDim2.new(0, 10, 0, 4)
	effect.Size = UDim2.new(1, -160, 1, -8)
	if cost then
		local nextCount = IncubatorRules.slotCount(incubator.level + 1, data.rebirthCount or 0, (data :: any).indexClaimed)
		effect.Text = Loc.t("ui.incubator.upgrade_effect", {
			speedNow  = Loc.formatDecimal(IncubatorRules.speed(incubator.level), 2),
			speedNext = Loc.formatDecimal(IncubatorRules.speed(incubator.level + 1), 2),
			slotsNow  = count,
			slotsNext = nextCount,
		})
		local up = Theme.bigButton("Up", upRow, Loc.t("ui.incubator.upgrade_cost", {
			gummies = cost.gummies, gold = cost.goldGummies }), Theme.COLORS.gummy)
		up.AnchorPoint = Vector2.new(1, 0.5)
		up.Position = UDim2.new(1, -8, 0.5, 0)
		up.Size = UDim2.fromOffset(140, 48)
		Theme.setEnabled(up, data.gummies >= cost.gummies and data.goldGummies >= cost.goldGummies)
		up.Activated:Connect(function()
			Remotes.RequestUpgradeIncubator:FireServer()
		end)
	else
		effect.Text = Loc.t("ui.incubator.max_level")
	end

	tickRows()
end

local function refresh()
	local root = _root
	if not root or not root.Visible then return end
	local data = ClientState.get()
	if not data then return end
	local signature = signatureOf(data)
	if signature == _signature then return end
	_signature = signature
	rebuild()
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function IncubatorPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog("IncubatorPanel", screenGui, Vector2.new(0.5, 0.7), Vector2.new(320, 340), Vector2.new(560, 640))
	_root = root
	local header = Theme.dialogHeader(root, Loc.t("ui.incubator.title"), function()
		PanelManager.close(PANEL_NAME)
	end)
	Loc.onChanged(function()
		header.Text = Loc.t("ui.incubator.title")
		_signature = ""
		refresh()
	end)

	local body = Theme.dialogBody(root)
	local scroller = Theme.scroller("List", body)
	scroller.Size = UDim2.fromScale(1, 1)
	_scroller = scroller
	Theme.listLayout(scroller, 6).HorizontalAlignment = Enum.HorizontalAlignment.Left

	PanelManager.register(PANEL_NAME, {
		open = function()
			root.Visible = true
			_signature = ""
			refresh()
		end,
		close = function()
			root.Visible = false
		end,
	})

	ClientState.onChanged(refresh)

	task.spawn(function()
		while true do
			task.wait(0.5)
			if root.Visible then
				-- Ein fertig gewordener Platz aendert die Knoepfe: einmal neu
				-- bauen, wenn sich die Zahl der fertigen aendert.
				local data = ClientState.get()
				if data and data.island.incubator then
					local ready = 0
					for _, entry in data.island.incubator.slots do
						if IncubatorRules.isReady(entry, now()) then ready += 1 end
					end
					if root:GetAttribute("Ready") ~= ready then
						root:SetAttribute("Ready", ready)
						_signature = ""
						refresh()
					end
				end
				tickRows()
			end
		end
	end)

	print("[IncubatorPanel] Initialisiert | Plaetze max", IncubatorConfig.MAX_SLOTS)
end

return IncubatorPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX97"><Properties><string name="Name">IndexView</string><ProtectedString name="Source"><![CDATA[--!strict
-- IndexView.luau
-- StarterPlayerScripts/UI/IndexView.luau
--
-- Einzige Zustaendigkeit:
--   - Den Index zeichnen: pro Ei eine Reihe Baerchis mit Wahrscheinlichkeit,
--     entdeckte in Farbe, unentdeckte als schwarze Silhouette
--   - Das kleine Fenster mit den Eiern, aus denen ein Baerchi faellt
--     (PC: Maus drueberhalten, Handy: antippen)
--
-- Zweck ist Orientierung: wer eine schwarze Silhouette sieht, tippt sie an und
-- weiss sofort, WELCHES Ei er oeffnen muss. Der Index liest nur — er schaltet
-- nichts frei. Entdeckt ist ein Baerchi, sobald der Server ihn in
-- data.discovered vermerkt hat (QuestService).
--
-- Die Daten (welche Eier, welche Chancen) kommen komplett aus
-- IndexCalculator/EggConfig; dieses Modul kennt keine einzige Baerchi-id.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types           = require(ReplicatedStorage.Network.Types)
local Loc             = require(ReplicatedStorage.Localization.Loc)
local Names           = require(ReplicatedStorage.Localization.Names)
local EggConfig       = require(ReplicatedStorage.Config.EggConfig)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local IndexCalculator = require(ReplicatedStorage.Modules.IndexCalculator)
local BaerchiMesh     = require(ReplicatedStorage.Modules.BaerchiMesh)
local Remotes           = require(ReplicatedStorage.Network.Remotes)
local FeatureFlags      = require(ReplicatedStorage.Config.FeatureFlags)
local IndexRewardConfig = require(ReplicatedStorage.Config.IndexRewardConfig)   -- Sammel-Update 7

local Theme       = require(script.Parent.Theme)
local UiScale     = require(script.Parent.UiScale)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local IndexView = {}

local TILE_W   = 78
local TILE_H   = 104
local VIEW     = 62
local POP_W    = 210

local _page: Frame?        = nil
local _scroller: ScrollingFrame? = nil
local _summary: TextLabel? = nil
local _popup: Frame?       = nil
local _popupHost: Frame?   = nil

-- Antippen haelt das Fenster fest (Handy); Hover zeigt es nur solange die Maus
-- drauf ist.
local _pinnedId: string? = nil
local _shownId: string?  = nil
local _signature = ""

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function percent(chance: number): string
	local p = chance * 100
	if math.abs(p - math.round(p)) < 0.05 then
		return Loc.formatNumber(math.round(p)) .. "%"
	end
	return Loc.formatDecimal(p, 1) .. "%"
end

local function isDiscovered(configId: string): boolean
	local data = ClientState.get()
	return data ~= nil and data.discovered ~= nil and data.discovered[configId] == true
end

-- Macht aus einem gebauten Baerchi eine schwarze Silhouette.
local function blacken(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Color    = Color3.new(0.04, 0.04, 0.06)
			d.Material = Enum.Material.SmoothPlastic
			if d:IsA("MeshPart") then
				d.TextureID = ""
			end
		elseif d:IsA("Decal") or d:IsA("Texture") or d:IsA("SurfaceAppearance") then
			d:Destroy()
		end
	end
end

-- Zeigt einen Baerchi in einem ViewportFrame. Gibt false zurueck, wenn kein
-- Modell gebaut werden konnte (fehlendes Template) — der Aufrufer zeigt dann
-- ein Fragezeichen.
local function fillViewport(vp: ViewportFrame, configId: string, discovered: boolean): boolean
	local def = BaerchiConfig.getById(configId)
	if not def then return false end

	local ok, model = pcall(function()
		return BaerchiMesh.build(Vector3.zero, Theme.rarityColor(def.rarity), def.rarity, nil)
	end)
	if not ok or not model then return false end

	if not discovered then
		blacken(model)
	end
	model.Parent = vp

	local cf, size = model:GetBoundingBox()
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	local radius = math.max(size.X, size.Y, size.Z)
	local distance = radius / (2 * math.tan(math.rad(camera.FieldOfView / 2))) * 1.15
	-- Leicht von vorne-oben, damit man Gesicht und Koerper sieht.
	local dir = Vector3.new(0.35, 0.25, 1).Unit
	camera.CFrame = CFrame.lookAt(cf.Position + dir * distance, cf.Position)
	camera.Parent = vp
	vp.CurrentCamera = camera
	return true
end

--------------------------------------------------------------------------------
-- Das Fenster "faellt aus diesen Eiern"
--------------------------------------------------------------------------------

local function hidePopup()
	local popup = _popup
	if popup then popup.Visible = false end
	_shownId = nil
end

local function showPopup(configId: string, anchor: GuiObject)
	local popup, host = _popup, _popupHost
	if not popup or not host then return end

	local def = BaerchiConfig.getById(configId)
	if not def then return end

	for _, child in popup:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	local found = isDiscovered(configId)
	local color = Theme.rarityColor(def.rarity)

	local title = Theme.label("Title", popup,
		if found then Names.baerchi(configId) else Loc.t("ui.index.unknown"))
	title.Position = UDim2.new(0, 10, 0, 6)
	title.Size     = UDim2.new(1, -20, 0, 22)

	local rarity = Theme.label("Rarity", popup, Loc.name("rarity." .. def.rarity, def.rarity))
	rarity.Position   = UDim2.new(0, 10, 0, 28)
	rarity.Size       = UDim2.new(1, -20, 0, 16)
	rarity.TextColor3 = color

	local header = Theme.bodyText("DropsFrom", popup, Loc.t("ui.index.drops_from"))
	header.Position = UDim2.new(0, 10, 0, 50)
	header.Size     = UDim2.new(1, -20, 0, 16)

	local data   = ClientState.get()
	local sources = IndexCalculator.sourcesOf(configId)
	local y = 68

	for _, source in sources do
		local eggDef = EggConfig.data[source.eggId :: Types.EggType]
		local row = Theme.container("Src_" .. source.eggId, popup)
		row.Position = UDim2.new(0, 10, 0, y)
		row.Size     = UDim2.new(1, -20, 0, 22)

		local dot = Theme.panel("Dot", row, if eggDef then eggDef.color else Theme.COLORS.accent)
		dot.Position = UDim2.new(0, 0, 0.5, -7)
		dot.Size     = UDim2.new(0, 14, 0, 14)
		Theme.corner(dot, 7)

		local name = Theme.label("Name", row, Loc.name("egg." .. source.eggId .. ".name", source.eggId))
		name.Position = UDim2.new(0, 22, 0, 0)
		name.Size     = UDim2.new(1, -90, 1, 0)
		name.TextSize = 14

		local chance = Theme.label("Chance", row, percent(source.chance))
		chance.AnchorPoint    = Vector2.new(1, 0)
		chance.Position       = UDim2.new(1, 0, 0, 0)
		chance.Size           = UDim2.new(0, 64, 1, 0)
		chance.TextXAlignment = Enum.TextXAlignment.Right
		chance.TextColor3     = Theme.COLORS.goldGummy

		y += 22

		-- Hat der Spieler dieses Ei gerade im Lager? Dann ist das der
		-- naechste Schritt, und genau den soll das Fenster zeigen.
		local stock = if data then (data.island.eggStock :: any)[source.eggId] or 0 else 0
		if stock > 0 then
			local have = Theme.bodyText("Have", popup, Loc.t("ui.index.you_have", { n = stock }))
			have.Position   = UDim2.new(0, 32, 0, y - 4)
			have.Size       = UDim2.new(1, -42, 0, 14)
			have.TextSize   = 12
			have.TextColor3 = Theme.COLORS.good
			y += 14
		end
	end

	if #sources == 0 then
		local none = Theme.bodyText("None", popup, Loc.t("ui.index.no_source"))
		none.Position = UDim2.new(0, 10, 0, y)
		none.Size     = UDim2.new(1, -20, 0, 30)
		y += 30
	end

	popup.Size = UDim2.new(0, POP_W, 0, y + 10)

	-- Neben die Kachel setzen und im Dialog halten.
	-- Bildschirm-Pixel -> Oberflaechen-Einheiten (globale UiScale), dann in die
	-- Einheiten INNERHALB des Dialogs (Theme.dialogScale: auf kleinen
	-- Bildschirmen ist der ganze Dialog verkleinert).
	local inner    = math.max(Theme.dialogScale(host), 0.01)
	local hostPos  = UiScale.toGui(host.AbsolutePosition) / inner
	local hostSize = UiScale.toGui(host.AbsoluteSize) / inner
	local aPos, aSize = UiScale.toGui(anchor.AbsolutePosition) / inner, UiScale.toGui(anchor.AbsoluteSize) / inner

	local x = aPos.X - hostPos.X + aSize.X + 6
	if x + POP_W > hostSize.X then
		x = aPos.X - hostPos.X - POP_W - 6
	end
	x = math.clamp(x, 4, math.max(4, hostSize.X - POP_W - 4))
	local py = math.clamp(aPos.Y - hostPos.Y, 4, math.max(4, hostSize.Y - (y + 10) - 4))

	popup.Position = UDim2.new(0, x, 0, py)
	popup.Visible  = true
	_shownId = configId
end

--------------------------------------------------------------------------------
-- Eine Kachel
--------------------------------------------------------------------------------

local function buildTile(parent: Instance, order: number, drop: IndexCalculator.Drop)
	local def = BaerchiConfig.getById(drop.configId)
	if not def then return end

	local found = isDiscovered(drop.configId)
	local color = Theme.rarityColor(def.rarity)

	local tile = Theme.panel("Tile_" .. drop.configId, parent, Theme.COLORS.panel)
	tile.LayoutOrder = order

	local stroke = tile:FindFirstChildOfClass("UIStroke")
	if stroke and found then stroke.Color = color end

	local vp = Instance.new("ViewportFrame")
	vp.Name                   = "Preview"
	vp.BackgroundColor3       = if found then Theme.shade(color, -0.55) else Color3.fromRGB(70, 66, 92)
	vp.BackgroundTransparency = 0
	vp.BorderSizePixel        = 0
	vp.Ambient                = Color3.fromRGB(180, 180, 190)
	vp.LightColor             = Color3.fromRGB(255, 255, 255)
	vp.AnchorPoint            = Vector2.new(0.5, 0)
	vp.Position               = UDim2.new(0.5, 0, 0, 5)
	vp.Size                   = UDim2.new(0, VIEW, 0, VIEW)
	vp.Parent                 = tile
	Theme.corner(vp, 10)

	if not fillViewport(vp, drop.configId, found) then
		local q = Theme.label("Q", vp, if found then "B" else "?")
		q.Size           = UDim2.fromScale(1, 1)
		q.TextXAlignment = Enum.TextXAlignment.Center
		q.TextColor3     = if found then color else Theme.COLORS.textDim
	end

	local name = Theme.label("Name", tile,
		if found then Names.baerchi(drop.configId) else Loc.t("ui.index.unknown"))
	name.Position       = UDim2.new(0, 3, 0, VIEW + 7)
	name.Size           = UDim2.new(1, -6, 0, 14)
	name.TextXAlignment = Enum.TextXAlignment.Center
	name.TextColor3     = if found then Theme.COLORS.text else Theme.COLORS.textDim

	local chance = Theme.label("Chance", tile, percent(drop.chance))
	chance.Position       = UDim2.new(0, 3, 0, VIEW + 22)
	chance.Size           = UDim2.new(1, -6, 0, 14)
	chance.TextXAlignment = Enum.TextXAlignment.Center
	chance.TextColor3     = Theme.COLORS.goldGummy

	local hit = Instance.new("TextButton")
	hit.Name                   = "Hit"
	hit.BackgroundTransparency = 1
	hit.Text                   = ""
	hit.Size                   = UDim2.fromScale(1, 1)
	hit.ZIndex                 = 5
	hit.Parent                 = tile

	-- Maus: Hover zeigt, Verlassen versteckt (ausser angetippt).
	hit.MouseEnter:Connect(function()
		if _pinnedId == nil then
			showPopup(drop.configId, tile)
		end
	end)
	hit.MouseLeave:Connect(function()
		if _pinnedId == nil and _shownId == drop.configId then
			hidePopup()
		end
	end)
	-- Handy (und Mausklick): antippen haelt fest, nochmal antippen schliesst.
	hit.Activated:Connect(function()
		if _pinnedId == drop.configId then
			_pinnedId = nil
			hidePopup()
		else
			_pinnedId = drop.configId
			showPopup(drop.configId, tile)
		end
	end)
end

--------------------------------------------------------------------------------
-- Aufbau / Aktualisieren
--------------------------------------------------------------------------------

local function currentSignature(): string
	local data = ClientState.get()
	local keys: { string } = {}
	if data and data.discovered then
		for id in data.discovered do table.insert(keys, id) end
	end
	table.sort(keys)
	-- Sammel-Update 7: abgeholte Belohnungen aendern die Knoepfe
	local claimed: { string } = {}
	local claimedMap = if data then (data :: any).indexClaimed else nil
	if claimedMap then
		for id in claimedMap do table.insert(claimed, id) end
	end
	table.sort(claimed)
	return table.concat(keys, ",") .. "|" .. table.concat(claimed, ",") .. "|" .. Loc.getLanguage()
end

--------------------------------------------------------------------------------
-- Sammel-Update 05.10. (Paket 7): Index-Belohnungen
--------------------------------------------------------------------------------

local function claimedMap(): { [string]: boolean }
	local data = ClientState.get()
	return (if data then (data :: any).indexClaimed else nil) or {}
end

local function discoveredMap(): { [string]: boolean }
	local data = ClientState.get()
	return (if data then data.discovered else nil) or {}
end

-- Wie viele Belohnungen gerade abholbar sind (fuer das "!" am Index).
function IndexView.claimableCount(): number
	if not FeatureFlags.isOn("INDEX_REWARDS") then return 0 end
	return #IndexRewardConfig.claimable(discoveredMap(), claimedMap())
end

-- Kurztext der Belohnung ("+2 Gold-Ei · +4.000 Gummies").
local function rewardText(entry: IndexRewardConfig.Entry): string
	local r = entry.reward
	local parts: { string } = {}
	if r.eggs > 0 and r.eggType then
		table.insert(parts, string.format("+%d %s", r.eggs, Loc.name("egg." .. r.eggType .. ".name", r.eggType)))
	end
	if r.gummies > 0 then table.insert(parts, "+" .. Loc.formatNumber(r.gummies) .. " G") end
	if r.goldGummies > 0 then table.insert(parts, "+" .. Loc.formatNumber(r.goldGummies) .. " Gold") end
	if r.blueprints > 0 then table.insert(parts, Loc.t("ui.index_reward.blueprint", { n = r.blueprints })) end
	if r.incubatorSlots > 0 then table.insert(parts, Loc.t("ui.index_reward.slot", { n = r.incubatorSlots })) end
	return table.concat(parts, "  ·  ")
end

-- Abholen-Knopf bzw. Haken rechts in einer Zeile. Gibt nil zurueck, wenn es
-- fuer diese Kollektion nichts zu zeigen gibt (Schalter aus).
local function claimWidget(parent: Instance, entry: IndexRewardConfig.Entry): GuiObject?
	if not FeatureFlags.isOn("INDEX_REWARDS") then return nil end
	if claimedMap()[entry.id] then
		local done = Theme.label("Claimed", parent, "✔")
		done.TextColor3 = Theme.COLORS.good
		done.TextXAlignment = Enum.TextXAlignment.Center
		return done
	end
	local complete = IndexRewardConfig.isComplete(entry, discoveredMap())
	local button = Theme.button("Claim", parent, Loc.t("ui.index_reward.claim"), Theme.COLORS.good)
	button.TextColor3 = Theme.COLORS.outline
	Theme.setEnabled(button, complete)
	button.Activated:Connect(function()
		if not complete then return end
		Remotes.RequestClaimIndexReward:FireServer(entry.id)
	end)
	return button
end

-- Eine Zeile "Sammlung": Name, Fortschritt (3/5), Belohnung, Knopf.
local function collectionRow(parent: Instance, order: number, entry: IndexRewardConfig.Entry, title: string)
	local row = Theme.panel("Reward_" .. entry.id, parent, Theme.COLORS.panel)
	row.Size = UDim2.new(1, -8, 0, 46)
	row.LayoutOrder = order
	local have, total = IndexRewardConfig.progress(entry, discoveredMap())
	local name = Theme.label("Name", row, string.format("%s  (%d/%d)", title, have, total))
	name.Position = UDim2.new(0, 10, 0, 3)
	name.Size = UDim2.new(1, -130, 0, 22)
	local reward = Theme.bodyText("Reward", row, rewardText(entry))
	reward.Position = UDim2.new(0, 10, 0, 24)
	reward.Size = UDim2.new(1, -130, 0, 18)
	reward.TextColor3 = Theme.COLORS.goldGummy
	local widget = claimWidget(row, entry)
	if widget then
		widget.AnchorPoint = Vector2.new(1, 0.5)
		widget.Position = UDim2.new(1, -8, 0.5, 0)
		widget.Size = UDim2.fromOffset(104, 32)
	end
end

local function buildCollections(scroller: Instance)
	if not FeatureFlags.isOn("INDEX_REWARDS") then return end
	local block = Theme.container("Collections", scroller)
	block.LayoutOrder = 0
	block.Size = UDim2.new(1, -8, 0, 0)
	block.AutomaticSize = Enum.AutomaticSize.Y
	Theme.listLayout(block, 4).HorizontalAlignment = Enum.HorizontalAlignment.Left

	local head = Theme.container("Head", block)
	head.LayoutOrder = 0
	head.Size = UDim2.new(1, 0, 0, 22)
	Theme.sectionLabel("Title", head, Loc.t("ui.index_reward.collections")).Size = UDim2.fromScale(1, 1)

	for _, entry in IndexRewardConfig.ENTRIES do
		if entry.kind == "path" then
			collectionRow(block, entry.order, entry, Loc.t("ui.index_reward.path", { path = Loc.name("path." .. entry.key, entry.key) }))
		elseif entry.kind == "rarity" then
			collectionRow(block, entry.order, entry, Loc.t("ui.index_reward.rarity", { rarity = Loc.name("rarity." .. entry.key, entry.key) }))
		elseif entry.kind == "all" then
			collectionRow(block, entry.order, entry, Loc.t("ui.index_reward.all"))
		end
	end
end

function IndexView.refresh(force: boolean?)
	local scroller, page = _scroller, _page
	if not scroller or not page or not page.Visible then return end

	local signature = currentSignature()
	if not force and signature == _signature then return end
	_signature = signature

	hidePopup()
	_pinnedId = nil

	for _, child in scroller:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	local tree  = IndexCalculator.buildTree()
	local total = #IndexCalculator.allPets()
	local found = 0
	for _, configId in IndexCalculator.allPets() do
		if isDiscovered(configId) then found += 1 end
	end

	local summary = _summary
	if summary then
		summary.Text = Loc.t("ui.index.progress", { found = found, total = total })
	end

	-- Sammel-Update 7: Pfad-, Rarity- und Gesamt-Belohnungen oben
	buildCollections(scroller)

	for order, node in tree do
		local eggDef = EggConfig.data[node.eggId :: Types.EggType]

		local section = Theme.container("Egg_" .. node.eggId, scroller)
		section.LayoutOrder   = order
		section.Size          = UDim2.new(1, -8, 0, 0)
		section.AutomaticSize = Enum.AutomaticSize.Y
		local sl = Theme.listLayout(section, 4)
		sl.HorizontalAlignment = Enum.HorizontalAlignment.Left

		local head = Theme.container("Head", section)
		head.LayoutOrder = 1
		head.Size        = UDim2.new(1, 0, 0, 24)

		local dot = Theme.panel("Dot", head, if eggDef then eggDef.color else Theme.COLORS.accent)
		dot.Position = UDim2.new(0, 2, 0.5, -9)
		dot.Size     = UDim2.new(0, 18, 0, 18)
		Theme.corner(dot, 9)

		local sectionFound = 0
		for _, drop in node.drops do
			if isDiscovered(drop.configId) then sectionFound += 1 end
		end

		local title = Theme.label("Title", head,
			Loc.name("egg." .. node.eggId .. ".name", node.eggId)
			.. "  (" .. sectionFound .. "/" .. #node.drops .. ")")
		title.Position = UDim2.new(0, 28, 0, 0)
		title.Size     = UDim2.new(1, -30, 1, 0)

		-- Sammel-Update 7: Belohnung dieser Ei-Reihe (Abholen / Haken)
		local eggEntry = IndexRewardConfig.get("egg:" .. node.eggId)
		if eggEntry then
			local widget = claimWidget(head, eggEntry)
			if widget then
				head.Size = UDim2.new(1, 0, 0, 30)
				title.Size = UDim2.new(1, -150, 1, 0)
				widget.AnchorPoint = Vector2.new(1, 0.5)
				widget.Position = UDim2.new(1, -4, 0.5, 0)
				widget.Size = UDim2.fromOffset(110, 26)
				local hint = Theme.bodyText("RewardHint", head, rewardText(eggEntry))
				hint.AnchorPoint = Vector2.new(1, 0.5)
				hint.Position = UDim2.new(1, -120, 0.5, 0)
				hint.Size = UDim2.fromOffset(170, 26)
				hint.TextXAlignment = Enum.TextXAlignment.Right
				hint.TextColor3 = Theme.COLORS.goldGummy
				title.Size = UDim2.new(1, -330, 1, 0)
			end
		end

		local grid = Theme.container("Grid", section)
		grid.LayoutOrder   = 2
		grid.Size          = UDim2.new(1, 0, 0, 0)
		grid.AutomaticSize = Enum.AutomaticSize.Y

		local layout = Instance.new("UIGridLayout")
		layout.CellSize            = UDim2.new(0, TILE_W, 0, TILE_H)
		layout.CellPadding         = UDim2.new(0, 6, 0, 6)
		layout.SortOrder           = Enum.SortOrder.LayoutOrder
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
		layout.Parent              = grid

		for i, drop in node.drops do
			buildTile(grid, i, drop)
		end
	end
end

-- Fuer BaerchiInventory: Seite zeigen/verstecken.
function IndexView.setVisible(visible: boolean)
	local page = _page
	if not page then return end
	page.Visible = visible
	if visible then
		IndexView.refresh(true)
	else
		hidePopup()
		_pinnedId = nil
	end
end

-- `host` ist der Dialog, in dem das Fenster liegen darf (damit es nicht vom
-- Scroller abgeschnitten wird); `parent` ist die Flaeche fuer die Seite.
function IndexView.build(parent: Instance, host: Frame): Frame
	local page = Theme.container("IndexPage", parent)
	page.Size    = UDim2.fromScale(1, 1)
	page.Visible = false
	_page = page

	local summary = Theme.label("Summary", page, "")
	summary.Size    = UDim2.new(1, 0, 0, 22)
	summary.TextSize = 16
	_summary = summary

	local scroller = Theme.scroller("IndexList", page)
	scroller.Position = UDim2.new(0, 0, 0, 28)
	scroller.Size     = UDim2.new(1, 0, 1, -28)
	_scroller = scroller

	local layout = Theme.listLayout(scroller, 10)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	-- Das Fenster haengt am Dialog, ganz oben.
	local popup = Theme.panel("DropPopup", host, Theme.COLORS.panelDeep)
	popup.Visible = false
	popup.ZIndex  = 50
	popup.Active  = false
	_popup     = popup
	_popupHost = host

	ClientState.onChanged(function()
		IndexView.refresh(false)
	end)
	Loc.onChanged(function()
		IndexView.refresh(true)
	end)

	return page
end

return IndexView
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX98"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[--!strict
-- Kit.luau
-- StarterPlayerScripts/UI/Kit.luau
--
-- Einzige Zustaendigkeit:
--   - Die Bausteine des neuen UI-Looks (08.10., Paket D): Fenster mit Schatten
--     und Kopf, Schliessen-X, Karte, Chip, Abzeichen, Balken, Knoepfe
--     (primaer/sekundaer/premium/waehlen), Schloss, Tower-Abzeichen,
--     Konfetti, Klang — und EINE Animations-Schleife fuer alles Bewegte.
--
-- Alle Farben, Radien, Striche, Abstaende, Schriftgroessen und Zeiten kommen
-- aus Theme.v2 (Tokens). Kein Baustein kennt ein bestimmtes Panel: das
-- Tower-Panel (UI/TowerPanel) ist der erste Nutzer, die anderen Panels
-- koennen spaeter einfach umsteigen. Die alte Theme-API bleibt unberuehrt.
--
-- Leistung: Bausteine sind ein paar Frames, keine Bilder (ausser optionalen
-- Icons mit Text-Rueckfall). Bewegung laeuft ueber Kit.animate in EINER
-- RenderStepped-Verbindung, die nur lebt, solange etwas animiert — kein
-- Thread und kein Dauer-Tween pro Element. Tweens (Oeffnen, Druecken) sind
-- kurz und raeumen sich selbst auf.

local SoundService      = game:GetService("SoundService")
local RunService        = game:GetService("RunService")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SoundConfig = require(ReplicatedStorage.Config.SoundConfig)

local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)

local Kit = {}

local T = Theme.v2
Kit.T = T

--------------------------------------------------------------------------------
-- Klang
--------------------------------------------------------------------------------

-- Ein Sound-Objekt je Name, einmal angelegt und wiederverwendet.
local _sounds: { [string]: Sound } = {}

-- Spielt einen UI-Klang aus SoundConfig. Stumm-sicher: unbekannt, leer oder
-- nicht ladbar → es passiert nichts.
function Kit.playSound(name: string)
	local def = SoundConfig.get(name)
	if not def then return end
	local sound = _sounds[name]
	if not sound then
		local created = Instance.new("Sound")
		created.Name    = "UiSound_" .. name
		created.SoundId = def.id
		created.Parent  = SoundService
		_sounds[name] = created
		sound = created
	end
	sound.Volume = def.volume * SoundConfig.MASTER_VOLUME
	pcall(function()
		SoundService:PlayLocalSound(sound)
	end)
end

--------------------------------------------------------------------------------
-- Zahlen kurz (fuer enge Knoepfe): bis 99.999 ausgeschrieben, darueber
-- 120K / 3,1M / 2,4B / 1,2T. Die Buchstaben sind in Roblox-Spielen in jeder
-- Sprache ueblich (sprachneutral); das Komma kommt aus der Sprache (Loc).
--------------------------------------------------------------------------------

local Loc = require(ReplicatedStorage.Localization.Loc)

function Kit.formatCompact(value: number): string
	local v = math.floor(value)
	if math.abs(v) < 100000 then return Loc.formatNumber(v) end
	for _, step in { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } } do
		if math.abs(v) >= step[1] then
			local n = v / step[1]
			local digits = if math.abs(n) >= 100 then 0 else 1
			return Loc.formatDecimal(n, digits) .. step[2]
		end
	end
	return Loc.formatNumber(v)
end

--------------------------------------------------------------------------------
-- Die eine Animations-Schleife
--------------------------------------------------------------------------------
-- Kit.animate(step) haengt `step(now)` an; gibt step false zurueck, faellt er
-- heraus. Laeuft nichts mehr, wird die Verbindung getrennt. Rueckgabe: eine
-- Funktion zum vorzeitigen Abmelden.

type Step = (number) -> boolean
local _steps: { Step } = {}
local _connection: RBXScriptConnection? = nil

local function runSteps()
	local now = os.clock()
	for i = #_steps, 1, -1 do
		local ok, keep = pcall(_steps[i], now)
		if not ok or keep == false then
			table.remove(_steps, i)
		end
	end
	if #_steps == 0 and _connection then
		_connection:Disconnect()
		_connection = nil
	end
end

function Kit.animate(step: Step): () -> ()
	table.insert(_steps, step)
	if not _connection then
		_connection = RunService.RenderStepped:Connect(runSteps)
	end
	return function()
		local index = table.find(_steps, step)
		if index then table.remove(_steps, index) end
	end
end

-- Anzahl laufender Animationen (Leck-Test: muss nach dem Schliessen 0 sein).
function Kit.activeAnimations(): number
	return #_steps
end

function Kit.tween(instance: Instance, seconds: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(instance, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

--------------------------------------------------------------------------------
-- Grundformen
--------------------------------------------------------------------------------

function Kit.corner(parent: Instance, radius: number): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
	return corner
end

function Kit.stroke(parent: Instance, thickness: number, color: Color3?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or T.color.outline
	stroke.Thickness = thickness
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = parent
	return stroke
end

-- Verlauf von oben nach unten. Achtung: ein UIGradient MULTIPLIZIERT sich auf
-- die Hintergrundfarbe — deshalb setzen die Bausteine BackgroundColor3 weiss
-- und tragen die echte Farbe im Verlauf.
function Kit.gradient(parent: Instance, top: Color3, bottom: Color3): UIGradient
	local gradient = parent:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(top, bottom)
	gradient.Rotation = 90
	gradient.Parent = parent
	return gradient
end

function Kit.frame(name: string, parent: Instance, color: Color3?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BorderSizePixel = 0
	if color then
		frame.BackgroundColor3 = color
	else
		frame.BackgroundTransparency = 1
	end
	frame.Parent = parent
	return frame
end

-- Text, der nie abgeschnitten wird: TextScaled zwischen `size` (Ziel) und
-- T.text.small (Untergrenze). Lange FR/ES-Texte werden kleiner, nicht kuerzer.
export type TextOptions = {
	color   : Color3?,
	stroke  : number?,           -- Kontur (px), nil = keine
	strokeColor : Color3?,
	align   : Enum.TextXAlignment?,
	alignY  : Enum.TextYAlignment?,
	wrap    : boolean?,
	min     : number?,
}

function Kit.text(name: string, parent: Instance, text: string, size: number, options: TextOptions?): TextLabel
	local o: TextOptions = options or {}
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Font = T.text.font
	label.Text = text
	label.TextColor3 = o.color or T.color.ink
	label.TextScaled = true
	label.TextWrapped = o.wrap == true
	label.TextXAlignment = o.align or Enum.TextXAlignment.Left
	label.TextYAlignment = o.alignY or Enum.TextYAlignment.Center
	label.Parent = parent
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = size
	limit.MinTextSize = math.min(size, o.min or T.text.small)
	limit.Parent = label
	if o.stroke then
		local stroke = Instance.new("UIStroke")
		stroke.Color = o.strokeColor or T.color.outline
		stroke.Thickness = o.stroke
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		stroke.LineJoinMode = Enum.LineJoinMode.Round
		stroke.Parent = label
	end
	return label
end

-- Glanzlicht auf der oberen Haelfte (wie Theme.shine, mit v2-Masse)
function Kit.shine(parent: GuiObject, radius: number, height: number?): Frame
	local shine = Kit.frame("Shine", parent, T.color.white)
	shine.BackgroundTransparency = 0.72
	shine.AnchorPoint = Vector2.new(0.5, 0)
	shine.Position = UDim2.new(0.5, 0, 0, 4)
	shine.Size = UDim2.new(1, -16, height or 0.38, 0)
	shine.ZIndex = parent.ZIndex + 1
	Kit.corner(shine, math.max(4, radius - 6))
	local fade = Instance.new("UIGradient")
	fade.Rotation = 90
	fade.Transparency = NumberSequence.new(0, 0.85)
	fade.Parent = shine
	return shine
end

-- Weiches Anwachsen beim Drueberfahren, Eindruecken beim Druecken (UIScale,
-- damit Layouts unberuehrt bleiben).
function Kit.pressable(button: GuiButton, onPress: (() -> ())?): UIScale
	local scale = Instance.new("UIScale")
	scale.Name = "PressScale"
	scale.Parent = button
	local function to(target: number)
		Kit.tween(scale, T.motion.press, { Scale = target })
	end
	button.MouseEnter:Connect(function() if button.Active then to(1.04) end end)
	button.MouseLeave:Connect(function() to(1) end)
	button.MouseButton1Down:Connect(function()
		if button.Active then
			to(0.94)
			if onPress then onPress() end
		end
	end)
	button.MouseButton1Up:Connect(function() if button.Active then to(1.04) end end)
	return scale
end

--------------------------------------------------------------------------------
-- Fenster
--------------------------------------------------------------------------------

export type Window = {
	root     : Frame,    -- unsichtbarer Rahmen, traegt FitScale (passt aufs Bild)
	holder   : Frame,    -- traegt PopScale (Aufspring-Animation)
	pop      : UIScale,
	body     : Frame,    -- Creme-Koerper mit Kontur
	content  : Frame,    -- Innenflaeche unter dem Kopf
	header   : Frame?,
	title    : TextLabel?,
	close    : TextButton?,
	mascot   : GuiObject?,
	setSize  : (Vector2) -> (),
}

-- Ein zentriertes Fenster mit Schlagschatten. `design` ist die gebaute Groesse
-- in Oberflaechen-Einheiten; passt sie nicht, wird erst die Hoehe bis
-- `minHeight` gekuerzt (die Liste darin scrollt), danach alles gleichmaessig
-- verkleinert. `reserve(screen)` haelt Raender frei (HUD, Pet-Leiste,
-- Menueleiste) — als Funktion der Bildschirmgroesse (Oberflaechen-Einheiten),
-- weil ein Handy quer andere Raender braucht als ein Monitor.
export type Reserve = { top: number, bottom: number, left: number, right: number }
export type WindowOptions = {
	design    : Vector2,
	minHeight : number,
	reserve   : (Vector2) -> Reserve,
}

function Kit.window(name: string, screenGui: ScreenGui, options: WindowOptions): Window
	local root = Kit.frame(name, screenGui)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Visible = false
	root.ZIndex = 20
	local fit = Instance.new("UIScale")
	fit.Name = "FitScale"
	fit.Parent = root

	local holder = Kit.frame("Holder", root)
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = 20
	local pop = Instance.new("UIScale")
	pop.Name = "PopScale"
	pop.Parent = holder

	-- Weicher Schlagschatten: dieselbe Form, dunkel, nach unten versetzt
	local shadow = Kit.frame("Shadow", holder, T.color.shadow)
	shadow.BackgroundTransparency = 0.55
	shadow.Position = UDim2.fromOffset(0, 10)
	shadow.Size = UDim2.fromScale(1, 1)
	shadow.ZIndex = 20
	Kit.corner(shadow, T.radius.panel)

	local body = Kit.frame("Body", holder, T.color.white)
	body.Size = UDim2.fromScale(1, 1)
	body.ZIndex = 22
	Kit.corner(body, T.radius.panel)
	Kit.stroke(body, T.stroke.panel)
	Kit.gradient(body, T.color.surface, T.color.surfaceDeep)

	local content = Kit.frame("Content", body)
	content.Size = UDim2.fromScale(1, 1)
	content.ZIndex = 23

	local window: Window = {
		root = root, holder = holder, pop = pop, body = body, content = content,
		header = nil, title = nil, close = nil, mascot = nil,
		setSize = function(_: Vector2) end,
	}

	local function refit()
		local global = screenGui:FindFirstChild("GlobalScale")
		local g = if global and global:IsA("UIScale") then math.max(global.Scale, 0.01) else 1
		local screen = screenGui.AbsoluteSize / g
		if screen.X <= 0 or screen.Y <= 0 then return end
		local r = options.reserve(screen)
		local roomX = screen.X - r.left - r.right
		local roomY = screen.Y - r.top - r.bottom
		local width = options.design.X
		local height = math.clamp(roomY, options.minHeight, options.design.Y)
		local scale = math.min(1, roomX / width, roomY / height)
		root.Size = UDim2.fromOffset(width, height)
		fit.Scale = scale
		-- Mitte des freien Bereichs
		root.Position = UDim2.fromOffset(r.left + roomX * 0.5, r.top + roomY * 0.5)
		window.setSize(Vector2.new(width, height))
	end
	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
	screenGui.ChildAdded:Connect(function(child)
		if child.Name == "GlobalScale" and child:IsA("UIScale") then
			child:GetPropertyChangedSignal("Scale"):Connect(refit)
			refit()
		end
	end)
	local global = screenGui:FindFirstChild("GlobalScale")
	if global and global:IsA("UIScale") then
		global:GetPropertyChangedSignal("Scale"):Connect(refit)
	end
	task.defer(refit)
	;(window :: any).refit = refit
	return window
end

-- Kopf: Honig-Band oben im Koerper. Es hat DENSELBEN Eckradius und liegt
-- buendig in der oberen Kante — dadurch folgt es der Rundung exakt und kein
-- Pixel steht ueber die Kontur. Die unteren Ecken fuellt ein Streifen in
-- Bandfarbe auf (gerade Unterkante). Der Titel federt beim Oeffnen ein.
function Kit.header(window: Window, title: string, height: number): TextLabel
	local band = Kit.frame("Header", window.body, T.color.white)
	band.Size = UDim2.new(1, 0, 0, height)
	band.ZIndex = 24
	Kit.corner(band, T.radius.panel)
	Kit.gradient(band, T.color.honeyTop, T.color.honeyBottom)

	local filler = Kit.frame("HeaderFill", band, T.color.white)
	filler.AnchorPoint = Vector2.new(0, 1)
	filler.Position = UDim2.fromScale(0, 1)
	filler.Size = UDim2.new(1, 0, 0, T.radius.panel)
	filler.ZIndex = 24
	local fillGradient = Instance.new("UIGradient")
	fillGradient.Rotation = 90
	-- Fortsetzung des Band-Verlaufs im unteren Teil (ohne sichtbare Naht)
	local split = 1 - T.radius.panel / height
	fillGradient.Color = ColorSequence.new(
		T.color.honeyTop:Lerp(T.color.honeyBottom, split),
		T.color.honeyBottom
	)
	fillGradient.Parent = filler

	-- Trennlinie zum Inhalt (Teil der dicken Kontur-Sprache)
	local line = Kit.frame("HeaderLine", band, T.color.outline)
	line.AnchorPoint = Vector2.new(0, 1)
	line.Position = UDim2.fromScale(0, 1)
	line.Size = UDim2.new(1, 0, 0, T.stroke.card)
	line.ZIndex = 26

	local shine = Kit.frame("HeaderShine", band, T.color.white)
	shine.BackgroundTransparency = 0.7
	shine.Position = UDim2.fromOffset(14, 6)
	shine.Size = UDim2.new(1, -28, 0, math.floor(height * 0.28))
	shine.ZIndex = 25
	Kit.corner(shine, 12)
	local fade = Instance.new("UIGradient")
	fade.Rotation = 90
	fade.Transparency = NumberSequence.new(0, 0.9)
	fade.Parent = shine

	local label = Kit.text("Title", band, title, T.text.title, {
		color = T.color.white, stroke = T.stroke.text + 1, align = Enum.TextXAlignment.Center,
	})
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.new(1, -220, 0, T.text.title + 6)
	label.ZIndex = 27
	local titleScale = Instance.new("UIScale")
	titleScale.Name = "TitleScale"
	titleScale.Parent = label

	window.header = band
	window.title = label
	return label
end

-- Maskottchen: ein Baerchi-Kopf lugt ueber die obere Kante (hinter dem
-- Koerper, nur die obere Haelfte ist zu sehen).
function Kit.mascot(window: Window, xOffset: number): GuiObject
	local holder = Kit.frame("Mascot", window.holder)
	holder.AnchorPoint = Vector2.new(0.5, 1)
	holder.Position = UDim2.new(0, xOffset, 0, 34)
	holder.Size = UDim2.fromOffset(84, 84)
	holder.ZIndex = 21   -- unter dem Koerper (22): die untere Haelfte steckt dahinter
	local icon = Icons.make(holder, "bear", "🐻")
	icon.Size = UDim2.fromScale(1, 1)
	icon.ZIndex = 21
	window.mascot = holder
	return holder
end

-- Schliessen-X: eigenes Geschwister des Koerpers, an dessen Ecke oben rechts
-- verankert (Mittelpunkt 10 px innerhalb der Ecke), steht leicht ueber, wird
-- nicht abgeschnitten. 52 px sichtbar, 64 px Trefferflaeche (Touch >= 48).
function Kit.closeButton(window: Window, onClose: () -> ()): TextButton
	local size = 52
	local button = Instance.new("TextButton")
	button.Name = "Close"
	button.AnchorPoint = Vector2.new(0.5, 0.5)
	button.Position = UDim2.new(1, -10, 0, 10)
	button.Size = UDim2.fromOffset(size, size)
	button.BackgroundColor3 = T.color.white
	button.AutoButtonColor = false
	button.Text = ""
	button.ZIndex = 40
	button.Parent = window.holder
	Kit.corner(button, size)
	Kit.stroke(button, T.stroke.button)
	Kit.gradient(button, Color3.fromRGB(255, 120, 120), Color3.fromRGB(226, 60, 70))

	local cross = Kit.text("X", button, "✕", 30, { color = T.color.white, stroke = 2, align = Enum.TextXAlignment.Center })
	cross.Size = UDim2.fromScale(1, 1)
	cross.ZIndex = 41

	local hit = Instance.new("TextButton")
	hit.Name = "CloseHit"
	hit.AnchorPoint = Vector2.new(0.5, 0.5)
	hit.Position = UDim2.fromScale(0.5, 0.5)
	hit.Size = UDim2.fromOffset(64, 64)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.ZIndex = 42
	hit.Parent = button

	Kit.pressable(button)
	local function fire()
		Kit.playSound("click")
		onClose()
	end
	button.Activated:Connect(fire)
	hit.Activated:Connect(fire)
	window.close = button
	return button
end

-- Aufspringen beim Oeffnen: Fenster von 0,86 auf 1 (Back), Titel etwas spaeter.
function Kit.popIn(window: Window)
	window.pop.Scale = 0.86
	Kit.tween(window.pop, T.motion.open, { Scale = 1 }, Enum.EasingStyle.Back)
	local title = window.title
	local titleScale = if title then title:FindFirstChild("TitleScale") else nil
	if titleScale and titleScale:IsA("UIScale") then
		titleScale.Scale = 0.5
		task.delay(0.08, function()
			Kit.tween(titleScale, T.motion.open + 0.1, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end
end

-- Scrollbare Liste (Canvas waechst mit dem Inhalt), Balken in Baerchi-Braun.
function Kit.scroller(name: string, parent: Instance): ScrollingFrame
	local list = Instance.new("ScrollingFrame")
	list.Name = name
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 8
	list.ScrollBarImageColor3 = T.color.bear
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.ScrollingDirection = Enum.ScrollingDirection.Y
	list.ZIndex = 30
	list.Parent = parent
	return list
end

--------------------------------------------------------------------------------
-- Karte, Chip, Abzeichen, Balken
--------------------------------------------------------------------------------

-- Karte mit Kontur und kleiner 3D-Kante (dunklerer Streifen unten).
-- Rueckgabe: der Halter fuer Layouts (`holder`) und die Kartenflaeche (`face`),
-- die beim Einlaufen verschoben werden darf.
export type Card = { holder: Frame, face: Frame, stroke: UIStroke, gradient: UIGradient }

function Kit.card(name: string, parent: Instance, height: number): Card
	local holder = Kit.frame(name, parent)
	holder.Size = UDim2.new(1, 0, 0, height)

	local face = Kit.frame("Face", holder, T.color.white)
	face.Size = UDim2.new(1, -8, 1, -6)
	face.Position = UDim2.fromOffset(4, 0)
	face.ZIndex = 30
	Kit.corner(face, T.radius.card)
	local stroke = Kit.stroke(face, T.stroke.card)
	local gradient = Kit.gradient(face, T.color.card, T.color.surface)

	-- 3D-Kante: gleiche Form, dunkler, 6 px tiefer, HINTER der Flaeche.
	-- Geschwister (nicht Kind) der Flaeche: Kinder liegen in Roblox immer
	-- ueber ihrem Eltern-Element, egal welcher ZIndex.
	local edge = Kit.frame("Edge", holder, T.color.quietEdge)
	edge.Position = UDim2.fromOffset(4, 6)
	edge.Size = UDim2.new(1, -8, 1, -6)
	edge.ZIndex = 29
	Kit.corner(edge, T.radius.card)
	Kit.stroke(edge, T.stroke.card)

	return { holder = holder, face = face, stroke = stroke, gradient = gradient }
end

-- Pille mit Text (Status, Fortschritt). Breite waechst mit dem Text.
function Kit.chip(name: string, parent: Instance, text: string, color: Color3?, textColor: Color3?): Frame
	local chip = Kit.frame(name, parent, color or T.color.sunk)
	chip.AutomaticSize = Enum.AutomaticSize.X
	chip.Size = UDim2.fromOffset(0, 30)
	chip.ZIndex = 32
	Kit.corner(chip, 15)
	Kit.stroke(chip, T.stroke.textSmall)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 12)
	pad.PaddingRight = UDim.new(0, 12)
	pad.Parent = chip
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Size = UDim2.fromScale(0, 1)
	label.Font = T.text.font
	label.TextSize = T.text.small + 1
	label.TextColor3 = textColor or T.color.ink
	label.Text = text
	label.ZIndex = 33
	label.Parent = chip
	return chip
end

function Kit.setChip(chip: Frame, text: string)
	local label = chip:FindFirstChild("Text")
	if label and label:IsA("TextLabel") then label.Text = text end
end

-- Kleiner schraeger Aufkleber ("NEU", "AKTIV", "GRATIS").
function Kit.badge(name: string, parent: Instance, text: string, color: Color3, rotation: number?): Frame
	local badge = Kit.frame(name, parent, T.color.white)
	badge.AnchorPoint = Vector2.new(0.5, 0.5)
	badge.AutomaticSize = Enum.AutomaticSize.X
	badge.Size = UDim2.fromOffset(0, 28)
	badge.Rotation = rotation or -8
	badge.ZIndex = 36
	Kit.corner(badge, 10)
	Kit.stroke(badge, T.stroke.textSmall)
	Kit.gradient(badge, Theme.shade(color, 0.25), color)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = badge
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Size = UDim2.fromScale(0, 1)
	label.Font = T.text.font
	label.TextSize = T.text.small + 2
	label.TextColor3 = T.color.white
	label.Text = text
	label.ZIndex = 37
	label.Parent = badge
	local stroke = Instance.new("UIStroke")
	stroke.Color = T.color.outline
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent = label
	return badge
end

export type Progress = { track: Frame, fill: Frame, label: TextLabel, set: (number, string) -> () }

-- Fortschrittsbalken mit Text in der Mitte.
function Kit.progress(name: string, parent: Instance, height: number, color: Color3?): Progress
	local track = Kit.frame(name, parent, T.color.sunk)
	track.Size = UDim2.new(1, 0, 0, height)
	track.ZIndex = 32
	track.ClipsDescendants = true
	Kit.corner(track, math.floor(height / 2))
	Kit.stroke(track, T.stroke.textSmall)

	local fill = Kit.frame("Fill", track, T.color.white)
	fill.Size = UDim2.fromScale(0, 1)
	fill.ZIndex = 33
	Kit.corner(fill, math.floor(height / 2))
	local base = color or T.color.progress
	Kit.gradient(fill, Theme.shade(base, 0.3), base)

	local label = Kit.text("Text", track, "", height - 4, { color = T.color.white, stroke = 2, align = Enum.TextXAlignment.Center, min = 12 })
	label.Size = UDim2.fromScale(1, 1)
	label.ZIndex = 34

	local function set(ratio: number, text: string)
		local r = math.clamp(ratio, 0, 1)
		fill.Visible = r > 0
		fill.Size = UDim2.new(math.max(r, 0.06), 0, 1, 0)
		label.Text = text
	end
	return { track = track, fill = fill, label = label, set = set }
end

--------------------------------------------------------------------------------
-- Knoepfe
--------------------------------------------------------------------------------
-- Ein Knopf = unsichtbarer TextButton (Trefferflaeche) mit "Edge" (3D-Kante,
-- dunkel, volle Groesse) und "Face" (Flaeche mit Verlauf und Glanz, 6 px
-- hoeher). Beim Druecken sinkt die Flaeche auf die Kante.
--   primary   gross, kraeftig gruen, Glanz, darf pulsieren (Kit.pulse)
--   secondary Creme mit Kontur, kein Glanz, gedaempfte Kante — lesbar, ruhig
--   premium   gold, ruhig, Krone
--   choose    himmelblau (Waehlen auf einer Karte)

export type ButtonKind = "primary" | "secondary" | "premium" | "choose"

export type Button = {
	button : TextButton,
	face   : Frame,
	label  : TextLabel,
	sub    : TextLabel,
	kind   : ButtonKind,
	setEnabled : (boolean) -> (),
	setKind    : (ButtonKind) -> (),
}

local KIND_COLORS: { [string]: { top: Color3, bottom: Color3, edge: Color3, text: Color3, stroke: number? } } = {
	primary   = { top = T.color.goTop,   bottom = T.color.go,       edge = T.color.goEdge,     text = T.color.white, stroke = T.stroke.text },
	secondary = { top = T.color.quiet,   bottom = T.color.surface,  edge = T.color.quietEdge,  text = T.color.ink,   stroke = nil },
	premium   = { top = T.color.goldTop, bottom = T.color.gold,     edge = T.color.goldEdge,   text = T.color.ink,   stroke = nil },
	choose    = { top = Theme.shade(T.color.choose, 0.3), bottom = T.color.choose, edge = T.color.chooseEdge, text = T.color.white, stroke = T.stroke.text },
}

local EDGE = 6

function Kit.button(name: string, parent: Instance, kind: ButtonKind, text: string, textSize: number?): Button
	local button = Instance.new("TextButton")
	button.Name = name
	button.BackgroundTransparency = 1
	button.AutoButtonColor = false
	button.Text = ""
	button.ZIndex = 34
	button.Parent = parent

	local edge = Kit.frame("Edge", button, T.color.white)
	edge.Position = UDim2.fromOffset(0, EDGE)
	edge.Size = UDim2.new(1, 0, 1, -EDGE)
	edge.ZIndex = 34
	Kit.corner(edge, T.radius.button)
	Kit.stroke(edge, T.stroke.button)

	local face = Kit.frame("Face", button, T.color.white)
	face.Size = UDim2.new(1, 0, 1, -EDGE)
	face.ZIndex = 35
	Kit.corner(face, T.radius.button)
	Kit.stroke(face, T.stroke.button)
	local shine = Kit.shine(face, T.radius.button)
	shine.ZIndex = 36

	local label = Kit.text("Label", face, text, textSize or T.text.button, { align = Enum.TextXAlignment.Center })
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.new(1, -16, 0.62, 0)
	label.ZIndex = 37

	local sub = Kit.text("Sub", face, "", T.text.small, { align = Enum.TextXAlignment.Center })
	sub.AnchorPoint = Vector2.new(0.5, 1)
	sub.Position = UDim2.new(0.5, 0, 1, -4)
	sub.Size = UDim2.new(1, -16, 0, T.text.small + 2)
	sub.ZIndex = 37
	sub.Visible = false

	local view: Button = {
		button = button, face = face, label = label, sub = sub, kind = kind,
		setEnabled = function(_: boolean) end, setKind = function(_: ButtonKind) end,
	}

	local function paint()
		local c = KIND_COLORS[view.kind]
		local enabled = button.Active
		local top = if enabled then c.top else T.color.sunk
		local bottom = if enabled then c.bottom else T.color.cardLocked
		Kit.gradient(face, top, bottom)
		edge.BackgroundColor3 = if enabled then c.edge else T.color.quietEdge
		shine.Visible = enabled and view.kind ~= "secondary"
		local textColor = if enabled then c.text else T.color.inkSoft
		label.TextColor3 = textColor
		sub.TextColor3 = textColor
		for _, l in { label, sub } do
			local stroke = l:FindFirstChildOfClass("UIStroke")
			if c.stroke and enabled then
				if not stroke then
					stroke = Instance.new("UIStroke")
					stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
					stroke.LineJoinMode = Enum.LineJoinMode.Round
					stroke.Parent = l
				end
				local s = stroke :: UIStroke
				s.Color = T.color.outline
				s.Thickness = if l == label then c.stroke else 2
				s.Enabled = true
			elseif stroke then
				stroke.Enabled = false
			end
		end
	end

	view.setEnabled = function(enabled: boolean)
		button.Active = enabled
		button.Selectable = enabled
		paint()
	end
	view.setKind = function(newKind: ButtonKind)
		view.kind = newKind
		paint()
	end

	-- Eindruecken: Flaeche sinkt auf die Kante
	button.MouseButton1Down:Connect(function()
		if button.Active then face.Position = UDim2.fromOffset(0, EDGE - 2) end
	end)
	local function release() face.Position = UDim2.fromOffset(0, 0) end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
	Kit.pressable(button)

	paint()
	return view
end

-- Sanfter Puls (nur fuer EIN Element je Fenster: den Hauptknopf). Laeuft in
-- der gemeinsamen Schleife; die Rueckgabe stoppt ihn.
function Kit.pulse(target: GuiObject, amount: number?): () -> ()
	local scale = target:FindFirstChild("PulseScale") :: UIScale?
	if not scale then
		local created = Instance.new("UIScale")
		created.Name = "PulseScale"
		-- Ein GuiObject darf nur EIN UIScale haben; der Knopf hat schon
		-- PressScale. Deshalb pulsiert der Inhalt (Face) statt des Knopfs.
		created.Parent = target
		scale = created
	end
	local s = scale :: UIScale
	local a = amount or 0.045
	local t0 = os.clock()
	local stop = Kit.animate(function(now)
		if not target.Parent then return false end
		local phase = ((now - t0) % T.motion.pulse) / T.motion.pulse
		s.Scale = 1 + a * math.sin(phase * math.pi * 2) ^ 2
		return true
	end)
	return function()
		stop()
		s.Scale = 1
	end
end

--------------------------------------------------------------------------------
-- Schloss, Tower-Abzeichen, Konfetti
--------------------------------------------------------------------------------

-- Gedaempfte Flaeche mit Schloss — "gesperrt, aber nicht tot": der Inhalt
-- darunter bleibt lesbar (nur leicht abgedeckt).
function Kit.lockOverlay(parent: GuiObject): Frame
	local overlay = Kit.frame("Lock", parent, T.color.cardLocked)
	overlay.BackgroundTransparency = 0.45
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = parent.ZIndex + 5
	Kit.corner(overlay, T.radius.card)
	return overlay
end

function Kit.lockIcon(parent: Instance, size: number): GuiObject
	local icon = Icons.make(parent, "lock", "🔒")
	icon.Size = UDim2.fromOffset(size, size)
	return icon
end

-- Tower-Abzeichen: Quadrat in der Look-Farbe mit Kante, grosser Ziffer und
-- einem Material-Zeichen aus Frames (Holz: Maserung, Stein: Fugen, Gold:
-- Glanzstreif, Kristall: Raute, Endless: Kreis). Keine Bilder noetig.
function Kit.towerBadge(name: string, parent: Instance, look: string, color: Color3, numeral: string, size: number): Frame
	local badge = Kit.frame(name, parent, T.color.white)
	badge.Size = UDim2.fromOffset(size, size)
	badge.ZIndex = 32
	Kit.corner(badge, T.radius.badge)
	Kit.stroke(badge, T.stroke.card)
	Kit.gradient(badge, Theme.shade(color, 0.35), Theme.shade(color, -0.12))

	local deco = Theme.shade(color, -0.3)
	local function mark(n: string, pos: UDim2, sz: UDim2, rot: number?, radius: number?)
		local f = Kit.frame(n, badge, deco)
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = pos
		f.Size = sz
		f.Rotation = rot or 0
		f.BackgroundTransparency = 0.45
		f.ZIndex = 33
		if radius then Kit.corner(f, radius) end
	end
	if look == "Wood" then
		mark("Grain1", UDim2.fromScale(0.5, 0.3), UDim2.new(0.8, 0, 0, 3), 0, 2)
		mark("Grain2", UDim2.fromScale(0.5, 0.72), UDim2.new(0.8, 0, 0, 3), 0, 2)
	elseif look == "Stone" then
		mark("Joint1", UDim2.fromScale(0.5, 0.36), UDim2.new(0.9, 0, 0, 3))
		mark("Joint2", UDim2.fromScale(0.5, 0.66), UDim2.new(0.9, 0, 0, 3))
		mark("Joint3", UDim2.fromScale(0.3, 0.51), UDim2.new(0, 3, 0.3, 0))
	elseif look == "Gold" then
		-- zwei kleine Funkel-Rauten statt eines Streifens (der las sich wie
		-- "durchgestrichen")
		for i, spot in { { 0.22, 0.24, 0.16 }, { 0.8, 0.76, 0.11 } } do
			local f = Kit.frame("Sparkle" .. i, badge, T.color.white)
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.Position = UDim2.fromScale(spot[1], spot[2])
			f.Size = UDim2.fromScale(spot[3], spot[3])
			f.Rotation = 45
			f.BackgroundTransparency = 0.25
			f.ZIndex = 33
			Kit.corner(f, 2)
		end
	elseif look == "Crystal" then
		mark("Gem", UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.62, 0.62), 45, 6)
	elseif look == "Endless" then
		mark("Ring", UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.8, 0.8), 0, 999)
	end

	local label = Kit.text("Numeral", badge, numeral, math.floor(size * 0.52), {
		color = T.color.white, stroke = T.stroke.text, align = Enum.TextXAlignment.Center,
	})
	label.Size = UDim2.fromScale(1, 1)
	label.ZIndex = 34
	local s = Kit.shine(badge, T.radius.badge, 0.32)
	s.ZIndex = 35
	return badge
end

-- Konfetti: wenige Schnipsel (Frames) fallen aus `origin` (Position in
-- `parent`), drehen sich und verblassen. Alles in der gemeinsamen Schleife,
-- nach T.motion.confetti wieder weg.
local CONFETTI_COLORS = { T.color.honey, T.color.gummy, T.color.sky, T.color.go, T.color.gold }

function Kit.confetti(parent: GuiObject, origin: Vector2, count: number?)
	local pieces: { { frame: Frame, vx: number, vy: number, spin: number } } = {}
	for i = 1, count or 22 do
		local f = Kit.frame("Confetti", parent, CONFETTI_COLORS[(i - 1) % #CONFETTI_COLORS + 1])
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Size = UDim2.fromOffset(math.random(7, 12), math.random(10, 16))
		f.Position = UDim2.fromOffset(origin.X, origin.Y)
		f.ZIndex = 60
		f.Rotation = math.random(0, 360)
		Kit.corner(f, 3)
		table.insert(pieces, {
			frame = f,
			vx = (math.random() - 0.5) * 520,
			vy = -(220 + math.random() * 260),
			spin = (math.random() - 0.5) * 900,
		})
	end
	local t0 = os.clock()
	local last = t0
	Kit.animate(function(now)
		local dt = math.min(now - last, 0.05)
		last = now
		local t = (now - t0) / T.motion.confetti
		for _, p in pieces do
			p.vy += 900 * dt
			local pos = p.frame.Position
			p.frame.Position = UDim2.fromOffset(pos.X.Offset + p.vx * dt, pos.Y.Offset + p.vy * dt)
			p.frame.Rotation += p.spin * dt
			p.frame.BackgroundTransparency = math.max(0, (t - 0.6) / 0.4)
		end
		if t >= 1 then
			for _, p in pieces do p.frame:Destroy() end
			return false
		end
		return true
	end)
end

return Kit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX99"><Properties><string name="Name">LeaderboardPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- LeaderboardPanel.luau
-- StarterPlayerScripts/UI/LeaderboardPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Die Bestenlisten im Menue zeigen (v15): drei Reiter (Tower, Rebirths,
--     Sammlung), Top 50 und der eigene Rang.
--
-- Die Daten holt das Panel beim Oeffnen und beim Reiterwechsel ueber die
-- RemoteFunction GetLeaderboard (der Server antwortet aus seinem Cache, der
-- alle 120 s aufgefrischt wird). Ein Klick auf einen Namen eines Spielers auf
-- diesem Server oeffnet seine Profilkarte (Inspektor).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types             = require(ReplicatedStorage.Network.Types)
local Remotes           = require(ReplicatedStorage.Network.Remotes)
local Loc               = require(ReplicatedStorage.Localization.Loc)
local LeaderboardConfig = require(ReplicatedStorage.Config.LeaderboardConfig)
local TowerConfig       = require(ReplicatedStorage.Config.TowerConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)

local LeaderboardPanel = {}

local PANEL_NAME = "Leaderboard"
local ROW_HEIGHT = 26

local _root: Frame? = nil
local _scroller: ScrollingFrame? = nil
local _own: TextLabel? = nil
local _tabs: { [string]: TextButton } = {}
local _list = "Tower"
local _requestId = 0

local function formatValue(listId: string, value: number): string
	if listId == "Tower" then
		local towerId, stage = TowerConfig.fromLeaderboardValue(value)
		local def = TowerConfig.get(towerId) or TowerConfig.TOWERS[1]
		return Loc.t("ui.leaderboard.tower_value", { tower = Loc.t("ui.petbar.tower", { n = def.numeral }), stage = stage })
	end
	return Loc.formatNumber(value)
end

local function render(view: Types.LeaderboardView?)
	local scroller = _scroller
	if not scroller then return end
	for _, child in scroller:GetChildren() do
		if child:IsA("Frame") then child:Destroy() end
	end

	local own = _own
	if not view then
		if own then own.Text = Loc.t("ui.leaderboard.loading") end
		return
	end

	for _, entry in view.entries do
		local mine = entry.userId == Players.LocalPlayer.UserId
		local row = Theme.panel("Row" .. entry.rank, scroller, if mine then Theme.COLORS.panelLight else Theme.COLORS.panel)
		row.Size        = UDim2.new(1, -8, 0, ROW_HEIGHT)
		row.LayoutOrder = entry.rank

		local rank = Theme.label("Rank", row, "#" .. entry.rank)
		rank.Position = UDim2.new(0, 8, 0, 3)
		rank.Size     = UDim2.new(0, 44, 1, -6)
		rank.TextColor3 = if entry.rank <= 3 then Theme.COLORS.goldGummy else Theme.COLORS.textDim

		local name = Instance.new("TextButton")
		name.Name = "Name"
		name.BackgroundTransparency = 1
		name.Font = Theme.FONT
		name.TextScaled = true
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextColor3 = Theme.COLORS.text
		name.Text = entry.name
		name.Position = UDim2.new(0, 56, 0, 3)
		name.Size     = UDim2.new(0.55, -56, 1, -6)
		name.Parent   = row
		name.Activated:Connect(function()
			if Players:GetPlayerByUserId(entry.userId) and entry.userId ~= Players.LocalPlayer.UserId then
				PanelManager.open("Profile", entry.userId)
			end
		end)

		local value = Theme.label("Value", row, formatValue(view.listId, entry.value))
		value.AnchorPoint    = Vector2.new(1, 0)
		value.Position       = UDim2.new(1, -8, 0, 3)
		value.Size           = UDim2.new(0.42, 0, 1, -6)
		value.TextXAlignment = Enum.TextXAlignment.Right
	end

	if own then
		own.Text = if view.ownRank
			then Loc.t("ui.leaderboard.own_rank", { rank = view.ownRank, value = formatValue(view.listId, view.ownValue) })
			else Loc.t("ui.leaderboard.own_unranked", { value = formatValue(view.listId, view.ownValue) })
	end
end

local function load(listId: string)
	_list = listId
	for id, tab in _tabs do
		tab.BackgroundColor3 = if id == listId then Theme.COLORS.accent else Theme.COLORS.panelLight
	end
	render(nil)

	_requestId += 1
	local myRequest = _requestId
	task.spawn(function()
		local ok, view = pcall(function()
			return Remotes.GetLeaderboard:InvokeServer(listId)
		end)
		if myRequest ~= _requestId then return end   -- inzwischen anderer Reiter
		render(if ok and typeof(view) == "table" then view :: Types.LeaderboardView else nil)
	end)
end

function LeaderboardPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog("LeaderboardPanel", screenGui, Vector2.new(0.46, 0.72), Vector2.new(320, 420), Vector2.new(520, 640))
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.leaderboard.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)

	local tabs = Theme.container("Tabs", body)
	tabs.Size = UDim2.new(1, 0, 0, 30)
	local tabLayout = Theme.listLayout(tabs, 6, true)
	tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	for order, listId in LeaderboardConfig.LISTS do
		local tab = Theme.button("Tab_" .. listId, tabs, Loc.t("ui.leaderboard.list." .. listId), Theme.COLORS.panelLight)
		-- Paket 9: 5 Listen passen nur schmaler (gleich breit, 6 px Luecke)
		tab.Size = UDim2.new(1 / #LeaderboardConfig.LISTS, -6, 1, 0)
		tab.TextScaled = true
		tab.LayoutOrder = order
		tab.TextColor3 = Theme.COLORS.text
		tab.Activated:Connect(function() load(listId) end)
		_tabs[listId] = tab
	end

	local scroller = Theme.scroller("List", body)
	scroller.Position = UDim2.new(0, 0, 0, 38)
	scroller.Size     = UDim2.new(1, 0, 1, -72)
	local layout = Theme.listLayout(scroller, 4)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	_scroller = scroller

	local own = Theme.label("Own", body, "")
	own.AnchorPoint = Vector2.new(0, 1)
	own.Position    = UDim2.new(0, 4, 1, 0)
	own.Size        = UDim2.new(1, -8, 0, 26)
	own.TextColor3  = Theme.COLORS.goldGummy
	_own = own

	PanelManager.register(PANEL_NAME, {
		open = function()
			root.Visible = true
			load(_list)
		end,
		close = function()
			root.Visible = false
		end,
	})

	print("[LeaderboardPanel] Initialisiert")
end

return LeaderboardPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX100"><Properties><string name="Name">MenuBar</string><ProtectedString name="Source"><![CDATA[--!strict
-- MenuBar.luau
-- StarterPlayerScripts/UI/MenuBar.luau
--
-- Einzige Zustaendigkeit:
--   - Die schmale Kachelleiste am rechten Bildschirmrand: Eier und Baerchis
--
-- ============================================================
-- WARUM NUR ZWEI KACHELN
-- ============================================================
-- Vorher standen hier sieben Kacheln (Eier, Baerchis, Kampf, drei Gebaeude,
-- Arena). Fuer einen neuen Spieler war das eine Wand aus Knoepfen ohne Antwort
-- auf "was mache ich jetzt?". Drei Dinge sind weggefallen:
--   - Gebaeude und Arena: Man oeffnet sie, indem man am Gebaeude selbst den
--     Prompt benutzt (WorldController). Eine zweite Tuer dorthin ist ueberfluessig.
--   - Kampf: Die PetBar unten ist der bessere Kampf-Knopf.
-- Uebrig bleiben die zwei Dinge, die man von ueberall aus braucht: Eier
-- (zum Schluepfen) und Baerchis (Sammlung, Fusion und der Index).
--
-- Welches Panel offen ist, weiss weiterhin ausschliesslich der PanelManager.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local IncubatorRules   = require(ReplicatedStorage.Modules.IncubatorRules)   -- Sammel-Update 8
local IndexRewardConfig = require(ReplicatedStorage.Config.IndexRewardConfig) -- Sammel-Update 7
local BuildingBehavior  = require(ReplicatedStorage.Config.BuildingBehavior)
local FeatureFlags     = require(ReplicatedStorage.Config.FeatureFlags)
local Workspace        = game:GetService("Workspace")

local Theme        = require(script.Parent.Theme)
local TouchSafeArea = require(script.Parent.TouchSafeArea)
local UiScale      = require(script.Parent.UiScale)
local PanelManager = require(script.Parent.PanelManager)
local Icons        = require(script.Parent.Icons)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Unlock       = require(script.Parent.Unlock)

-- HBB Paket 3: Kachel (Panel-Name) → Element-Id der Freischaltung
local TILE_ELEMENT: { [string]: string } = {
	Hatch = "tile_eggs", Inventory = "tile_bears", EggTree = "tile_tree",
	Leaderboard = "tile_leaderboard", DailyBonus = "tile_daily",
	Shop = "tile_shop",
	Incubator = "tile_incubator",   -- Sammel-Update Paket 8
}

local MenuBar = {}

-- Groessen. TILE ist gleichzeitig die Antippflaeche — darunter wird es auf dem
-- Handy zur Geduldsprobe.
-- HUD_ROW_V2: weniger Kacheln (Verbessern, Inkubator und Shop sind weg),
-- dafuer groesser. Die UIScale unten schrumpft weiterhin auf kleinen Fenstern.
local BIG    = FeatureFlags.isOn("HUD_ROW_V2")
local TILE   = if BIG then 70 else 54
local LABEL  = if BIG then 18 else 16
local GAP    = if BIG then 8 else 6
local WIDTH  = if BIG then 94 else 76

-- Was eine Kachel anzeigt: `value` ist die Beschriftung IN der Kachel,
-- `alert` laesst das rote Ausrufezeichen erscheinen.
type Live = (Types.PlayerDataUpdate) -> (string, boolean)

type Entry = {
	panel  : string,
	-- Beschriftung unter der Kachel. Eine Funktion statt eines Strings, weil
	-- sie bei jedem Sprachwechsel neu ausgewertet wird.
	title  : () -> string,
	color  : Color3,
	symbol : string,
	-- Name des Bild-Icons (siehe Icons); `symbol` ist der Text-Rueckfall
	icon   : string,
	live   : Live?,
}

type Tile = {
	entry : Entry,
	-- Die Beschriftung IN der Kachel ist das Text-Feld des Knopfes selbst: ein
	-- eigenes Label darueber wuerde die Klicks abfangen.
	tile  : TextButton,
	alert : Frame,
	label : TextLabel,
	-- true, wenn die Kachel ein Bild zeigt: dann bleibt ihr Text leer
	image : boolean,
}

local _tiles: { Tile } = {}
local buildAllEntries: () -> { Entry }

-- Sammel-Update 3.5: welches Gebaeude-Menue die Kachel oeffnet
local function buildingPanel(): string
	return PanelManager.buildingPanelName(if FeatureFlags.isOn("HONEY_POND_V2") then "HoneyPond" else "HoneyRefiner")
end
TILE_ELEMENT[buildingPanel()] = "tile_building"

--------------------------------------------------------------------------------
-- Die Eintraege
--------------------------------------------------------------------------------

local function buildEntries(): { Entry }
	local list = buildAllEntries()
	-- HUD_ROW_V2: Honig-Brunnen und Inkubator benutzt man vor Ort (Prompt am
	-- Plot), der Shop sitzt in der Knopf-Zeile oben links (Hud).
	local hidden: { [string]: boolean } = {}
	if not FeatureFlags.isOn("INCUBATOR") then hidden.Incubator = true end
	if BIG then
		hidden.Incubator = true
		hidden.Shop = true
		hidden[buildingPanel()] = true
	end
	for i = #list, 1, -1 do
		if hidden[list[i].panel] then table.remove(list, i) end
	end
	return list
end

function buildAllEntries(): { Entry }
	return {
		{ panel = "Hatch",     title = function() return Loc.t("ui.menu.eggs") end,     color = Theme.COLORS.gummy,  symbol = "EI", icon = "egg" },
		-- Sammel-Update 05.10. (Paket 7): "!" = eine Index-Belohnung ist abholbar.
		{ panel = "Inventory", title = function() return Loc.t("ui.menu.baerchis") end, color = Theme.COLORS.accent, symbol = "BA", icon = "bear",
			live = function(data: Types.PlayerDataUpdate)
				if not FeatureFlags.isOn("INDEX_REWARDS") then return "BA", false end
				return "BA", #IndexRewardConfig.claimable(data.discovered, data.indexClaimed) > 0
			end },
		-- Sammel-Update 05.10. (Paket 3.5/3.6): das Honig-Gebaeude als Kachel
		-- (Verbessern ohne hinzulaufen). "!" = Ausbau bezahlbar.
		{ panel = buildingPanel(), title = function() return Loc.t("ui.menu.building") end, color = Theme.COLORS.goldGummy, symbol = "⬆", icon = "upgrade",
			live = function(data: Types.PlayerDataUpdate)
				local id = if FeatureFlags.isOn("HONEY_POND_V2") then "HoneyPond" else "HoneyRefiner"
				local building = data.island.buildings[id :: any]
				if not building then return "⬆", false end
				local cost = BuildingBehavior.getUpgrade(id :: any, building.level + 1)
				return "⬆", cost ~= nil and data.gummies >= cost.costGummies and data.goldGummies >= (cost.costGoldGummies or 0)
			end },
		-- Sammel-Update 05.10. (Paket 8): Inkubator ("!" = ein Ei ist fertig).
		{ panel = "Incubator", title = function() return Loc.t("ui.incubator.tile") end, color = Theme.COLORS.growth, symbol = "⏳", icon = "incubator",
			live = function(data: Types.PlayerDataUpdate)
				local incubator = data.island.incubator
				if not incubator then return "⏳", false end
				local now = Workspace:GetServerTimeNow()
				local ready = false
				for _, entry in incubator.slots do
					if IncubatorRules.isReady(entry, now) then ready = true end
				end
				return "⏳", ready
			end },
		-- v14: Ei-Baum. Das "!" zeigt eine ungenutzte Blaupause an.
		{ panel = "EggTree", title = function() return Loc.t("ui.menu.tree") end, color = Theme.COLORS.growth, symbol = "BAUM", icon = "tree",
			live = function(data: Types.PlayerDataUpdate)
				local bp = if data.eggTree then data.eggTree.blueprints or 0 else 0
				return "BAUM", bp > 0
			end },
		-- v15: Bestenlisten und Login-Bonus ("!" = heute noch nicht abgeholt)
		{ panel = "Leaderboard", title = function() return Loc.t("ui.menu.leaderboard") end, color = Theme.COLORS.goldGummy, symbol = "TOP", icon = "trophy" },
		{ panel = "DailyBonus", title = function() return Loc.t("ui.menu.daily") end, color = Theme.COLORS.gummy, symbol = "7", icon = "gift",
			live = function(data: Types.PlayerDataUpdate)
				local daily = data.daily
				return if daily then tostring(daily.day) else "7", daily ~= nil and daily.claimable
			end },
		-- HBB Paket 10: Shop ("!" = Gratis-Griff heute noch offen). Sichtbar ab
		-- der 2. Sitzung und nur mit SHOP_V1 (UnlockRules "tile_shop").
		{ panel = "Shop", title = function() return Loc.t("ui.menu.shop") end, color = Theme.COLORS.goldGummy, symbol = "GG", icon = "goldgummy",
			live = function(data: Types.PlayerDataUpdate)
				local shop = data.shop
				return "GG", shop ~= nil and shop.freeReady
			end },
	}
end

--------------------------------------------------------------------------------
-- Eine Kachel
--------------------------------------------------------------------------------

local function buildTile(parent: Instance, order: number, entry: Entry): Tile
	local slot = Theme.container("Slot_" .. entry.panel, parent)
	slot.Size        = UDim2.new(1, 0, 0, TILE + LABEL + 2)
	slot.LayoutOrder = order

	local button = Theme.button("Tile", slot, entry.symbol, entry.color)
	button.AnchorPoint = Vector2.new(0.5, 0)
	button.Position    = UDim2.new(0.5, 0, 0, 0)
	button.Size        = UDim2.new(0, TILE, 0, TILE)
	button.TextColor3  = Theme.COLORS.outline
	Theme.gradient(button, Theme.shade(entry.color, 0.34), Theme.shade(entry.color, -0.16))

	-- Bild-Icon gross in die Kachel. Ohne Asset bleibt das Text-Kuerzel stehen.
	local hasImage = Icons.has(entry.icon)
	if hasImage then
		button.Text = ""
		local icon = Icons.make(button, entry.icon)
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position    = UDim2.fromScale(0.5, 0.52)
		icon.Size        = UDim2.fromScale(0.86, 0.86)
		icon.ZIndex      = 3
	end

	button.Activated:Connect(function()
		local element = TILE_ELEMENT[entry.panel]
		if element then Unlock.markSeen(element) end
		PanelManager.toggle(entry.panel)
	end)

	-- Rotes Ausrufezeichen oben rechts, wie man es aus dem Genre kennt.
	-- Startet unsichtbar und wird von refresh() geschaltet.
	local alert = Theme.panel("Alert", slot, Theme.COLORS.bad)
	alert.AnchorPoint = Vector2.new(1, 0)
	alert.Position    = UDim2.new(0.5, TILE * 0.5 + 5, 0, -4)
	alert.Size        = UDim2.new(0, 20, 0, 20)
	alert.Visible     = false
	alert.ZIndex      = 3
	Theme.corner(alert, 10)

	local bang = Theme.label("Bang", alert, "!")
	bang.Size           = UDim2.fromScale(1, 1)
	bang.TextXAlignment = Enum.TextXAlignment.Center
	bang.ZIndex         = 4

	local label = Theme.label("Name", slot, entry.title())
	label.Position       = UDim2.new(0, 0, 0, TILE + 1)
	label.Size           = UDim2.new(1, 0, 0, LABEL)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextScaled     = false
	label.TextSize       = if BIG then 16 else 14
	Theme.outlineText(label)

	return { entry = entry, tile = button, alert = alert, label = label, image = hasImage }
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

local function refresh(data: Types.PlayerDataUpdate)
	for _, tile in _tiles do
		-- HBB Paket 3: Kachel erst zeigen, wenn sie gebraucht wird; neue
		-- Kacheln tragen das "!" bis zum ersten Antippen.
		local element = TILE_ELEMENT[tile.entry.panel]
		local isNew = false
		if element then
			local slot = tile.tile.Parent
			if slot and slot:IsA("GuiObject") then
				Unlock.apply(element, slot)
			end
			isNew = Unlock.isNew(element)
			tile.alert.Visible = isNew
		end

		local live = tile.entry.live
		if live then
			local ok, value, alert = pcall(live, data)

			-- In pcall: eine kaputte Kachel darf nicht die ganze Leiste
			-- lahmlegen. Ein alter Spielstand ohne ein Gebaeude waere sonst
			-- genau so ein Fall.
			if ok then
				if not tile.image then
					tile.tile.Text = value
				end
				tile.alert.Visible = alert or isNew
			end
		end
	end
end

--------------------------------------------------------------------------------
-- HBB Paket 1: Ziel fliegender Icons (Eier fliegen zur Eier-Kachel)
--------------------------------------------------------------------------------

function MenuBar.getTileAnchor(panel: string): GuiObject?
	for _, tile in _tiles do
		if tile.entry.panel == panel then
			return tile.tile
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function MenuBar.init(screenGui: ScreenGui)
	local entries = buildEntries()
	local slot    = TILE + LABEL + 2
	local height  = #entries * slot + (#entries - 1) * GAP

	local root = Theme.container("MenuBar", screenGui)
	root.AnchorPoint = Vector2.new(1, 0)
	-- Rechte Kante, unter den Rang-/Rebirth-Pillen. Y bewusst als Pixel-Offset:
	-- die Pillen darueber sind ebenfalls pixelhoch, mit Scale wuerde die Leiste
	-- je nach Bildschirmhoehe hineinrutschen.
	root.Position = UDim2.new(0.988, 0, 0, 108)
	root.Size     = UDim2.new(0, WIDTH, 0, height)

	-- Raster statt Liste: eine Spalte wie bisher, auf Touch-Geraeten bei Bedarf
	-- zwei (siehe rescale). Unsichtbare Kacheln (Unlock) ueberspringt es.
	local grid = Instance.new("UIGridLayout")
	grid.CellSize              = UDim2.fromOffset(WIDTH, slot)
	grid.CellPadding           = UDim2.fromOffset(GAP, GAP)
	grid.FillDirection         = Enum.FillDirection.Horizontal
	grid.FillDirectionMaxCells = 1
	grid.HorizontalAlignment   = Enum.HorizontalAlignment.Right
	grid.SortOrder             = Enum.SortOrder.LayoutOrder
	grid.Parent                = root

	-- Auf niedrigen Fenstern (Handy quer, kleines Studio-Fenster) schrumpfen,
	-- damit die Leiste nicht ueber den unteren Rand ragt.
	--
	-- Playtest 07.10.: auf Touch-Geraeten endet die Leiste ueber dem
	-- Sprung-Knopf (unten rechts), sonst oeffnete ein Sprung ein Menue. Wuerden
	-- die Kacheln dafuer in einer Spalte zu klein zum Antippen (< 70 %), werden
	-- es zwei Spalten.
	local MIN_TOUCH_SCALE = 0.7
	local scale = Instance.new("UIScale")
	scale.Parent = root
	local function rescale()
		local bottom = TouchSafeArea.rightBottomReserve(screenGui, 12)
		local room = UiScale.toGui(screenGui.AbsoluteSize.Y) - 108 - bottom

		local columns = 1
		if TouchSafeArea.isTouch() and room / height < MIN_TOUCH_SCALE then
			columns = 2
		end
		local rows = math.ceil(#entries / columns)
		local gridHeight = rows * slot + (rows - 1) * GAP

		grid.FillDirectionMaxCells = columns
		root.Size   = UDim2.fromOffset(columns * WIDTH + (columns - 1) * GAP, gridHeight)
		scale.Scale = math.clamp(room / gridHeight, 0.4, 1)
	end
	TouchSafeArea.watch(screenGui, rescale)

	for order, entry in entries do
		table.insert(_tiles, buildTile(root, order, entry))
	end

	ClientState.onChanged(refresh)

	-- HBB Paket 3: ein Panel, das sich von selbst oeffnet (Login-Bonus u.a.), gilt
	-- ebenso als gesehen wie eines, das per Kachel geoeffnet wurde.
	PanelManager.onOpened(function(name)
		local element = TILE_ELEMENT[name]
		if element then Unlock.markSeen(element) end
	end)

	-- Sprachwechsel: nur die Beschriftungen neu setzen (die Zahlen in den
	-- Kacheln sind sprachunabhaengig)
	Loc.onChanged(function()
		for _, tile in _tiles do
			tile.label.Text = tile.entry.title()
		end
	end)

	print("[MenuBar] Initialisiert |", #entries, "Kacheln")
end

return MenuBar
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX101"><Properties><string name="Name">Moment</string><ProtectedString name="Source"><![CDATA[--!strict
-- Moment.luau
-- StarterPlayerScripts/UI/Moment.luau
--
-- Einzige Zustaendigkeit:
--   - Seltene, wichtige Ereignisse als grosses Icon in der Bildschirmmitte
--     zeigen (neuer Rekord, Freischaltung, Mutation, Rebirth …)
--
-- Kontext: HBB Paket 1. Hoechstens EIN kurzes Wort, Farbe der Rarity oder
-- des Ereignisses, ein kurzer Klang. Kein Ersatz fuer HatchAnimation: das
-- Schluepfen bleibt, wie es ist.
--
-- Momente kommen nacheinander, nie uebereinander. Die Warteschlange ist kurz
-- (FeedbackConfig.MOMENT_QUEUE); wer mehr ausloest, verliert die aeltesten.

local TweenService      = game:GetService("TweenService")
local SoundService      = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Loc            = require(ReplicatedStorage.Localization.Loc)
local FeedbackConfig = require(ReplicatedStorage.Config.FeedbackConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)

local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)

local Moment = {}

-- Art → Icon. Unbekannte Arten bekommen den Stern.
local ICON_FOR: { [string]: string } = {
	record    = "trophy",
	tower_unlocked = "crown",   -- 08.10. neuer Tower frei
	milestone = "trophy",
	unlock    = "tree",
	rebirth   = "rebirth",
	mutation  = "bear",
	rarity    = "crown",
	jackpot   = "egg",
	slot      = "check",
	boss      = "swords",
	chest     = "gift",
}

local ICON_SIZE = 150

type Job = { kind: string, color: Color3, shortKey: string? }

local _root: Frame? = nil
local _ring: Frame? = nil
local _iconHolder: Frame? = nil
local _word: TextLabel? = nil
local _scale: UIScale? = nil
local _queue: { Job } = {}
local _running = false

local function playSound()
	local sound = Instance.new("Sound")
	sound.SoundId = FeedbackConfig.MOMENT_SOUND
	sound.Volume  = FeedbackConfig.MOMENT_VOLUME
	SoundService:PlayLocalSound(sound)
	task.delay(3, function()
		sound:Destroy()
	end)
end

local function showOne(job: Job)
	local root, ring, holder, word, scale = _root, _ring, _iconHolder, _word, _scale
	if not root or not ring or not holder or not word or not scale then return end

	for _, child in holder:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	local icon = Icons.make(holder, ICON_FOR[job.kind] or "", "★")
	icon.Size = UDim2.fromScale(1, 1)
	icon.ZIndex = 72

	ring.BackgroundColor3 = job.color
	word.Text = if job.shortKey then Loc.t(job.shortKey) else ""
	word.TextColor3 = job.color
	word.Visible = job.shortKey ~= nil

	root.Visible = true
	ring.BackgroundTransparency = 0.25
	word.TextTransparency = 0
	scale.Scale = 0.2
	playSound()

	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.wait(FeedbackConfig.MOMENT_SECONDS)
	local fadeTime = 0.3
	TweenService:Create(scale, TweenInfo.new(fadeTime), { Scale = 1.25 }):Play()
	TweenService:Create(ring, TweenInfo.new(fadeTime), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(word, TweenInfo.new(fadeTime), { TextTransparency = 1 }):Play()
	if icon:IsA("ImageLabel") then
		TweenService:Create(icon, TweenInfo.new(fadeTime), { ImageTransparency = 1 }):Play()
	end
	task.wait(fadeTime)
	root.Visible = false
end

local function run()
	_running = true
	while #_queue > 0 do
		local job = table.remove(_queue, 1)
		if not job then break end
		showOne(job)
	end
	_running = false
end

-- kind: siehe ICON_FOR. color: Rarity-/Ereignisfarbe. shortKey: optionaler
-- Loc-Schluessel fuer EIN Wort (ui.moment.*).
function Moment.show(kind: string, color: Color3, shortKey: string?)
	if not FeatureFlags.isOn("UI_V2_FEEDBACK") then return end
	while #_queue >= FeedbackConfig.MOMENT_QUEUE do
		table.remove(_queue, 1)
	end
	table.insert(_queue, { kind = kind, color = color, shortKey = shortKey })
	if not _running then
		task.spawn(run)
	end
end

function Moment.init(screenGui: ScreenGui)
	local root = Theme.container("Moment", screenGui)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.42)
	root.Size = UDim2.fromOffset(ICON_SIZE + 60, ICON_SIZE + 110)
	root.ZIndex = 70
	root.Visible = false

	local scale = Instance.new("UIScale")
	scale.Parent = root

	local ring = Instance.new("Frame")
	ring.Name = "Ring"
	ring.AnchorPoint = Vector2.new(0.5, 0)
	ring.Position = UDim2.new(0.5, 0, 0, 0)
	ring.Size = UDim2.fromOffset(ICON_SIZE + 50, ICON_SIZE + 50)
	ring.BorderSizePixel = 0
	ring.ZIndex = 70
	ring.Parent = root
	Theme.corner(ring, (ICON_SIZE + 50) // 2)
	Theme.stroke(ring, Theme.COLORS.outline, 4)

	local holder = Theme.container("Icon", ring)
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromOffset(ICON_SIZE, ICON_SIZE)
	holder.ZIndex = 71

	local word = Theme.label("Word", root, "")
	word.AnchorPoint = Vector2.new(0.5, 1)
	word.Position = UDim2.new(0.5, 0, 1, 0)
	word.Size = UDim2.new(1, 80, 0, 50)
	word.TextXAlignment = Enum.TextXAlignment.Center
	word.ZIndex = 72
	Theme.outlineText(word, 3)
	local limit = word:FindFirstChildOfClass("UITextSizeConstraint")
	if limit then limit.MaxTextSize = 44 end

	_root, _ring, _iconHolder, _word, _scale = root, ring, holder, word, scale
	print("[Moment] Initialisiert")
end

return Moment
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX102"><Properties><string name="Name">PanelManager</string><ProtectedString name="Source"><![CDATA[--!strict
-- PanelManager.luau
-- StarterPlayerScripts/UI/PanelManager.luau
--
-- Einzige Zustaendigkeit:
--   - Wissen welches Panel gerade offen ist und immer nur eines offen lassen
--
-- Warum es dieses Modul gibt: die Panels muessen sich gegenseitig oeffnen
-- koennen (Inventar → Fusion, Inventar → Detailkarte, Welt-Klick → Kampf).
-- Wuerden sie sich dafuer direkt gegenseitig requiren, entstuenden Zyklen —
-- und Luau bricht bei zyklischen require-Ketten ab.
--
-- Deshalb: jedes Panel meldet sich hier unter einem Namen an, und alle
-- Oeffnen-Aufrufe laufen ueber diesen Namen. Dieses Modul selbst requirt
-- absichtlich nichts aus dem UI-Ordner.
--
-- Nur ein Panel gleichzeitig: auf einem Handy ist gestapeltes UI unbedienbar,
-- und der Spieler soll nie raten muessen welches Fenster gerade zuhoert.

local UserInputService = game:GetService("UserInputService")

local PanelManager = {}

-- open ist bewusst variadisch getypt: manche Panels brauchen Argumente
-- (Detailkarte: uid, Fusion: zwei uids), die meisten keine. Jedes Panel
-- schreibt deshalb `local function openInternal(...: any)` und prueft die
-- Argumente selbst — genau wie der Server es mit Client-Eingaben tut.
export type Panel = {
	open  : (...any) -> (),
	close : () -> (),
}

local _panels: { [string]: Panel } = {}
local _openName: string? = nil

-- HBB Paket 0: Beobachter fuer Messpunkte (UiEventLogger). Bekommen nur den
-- Namen bzw. Namen + offene Dauer; sie duerfen kein Panel steuern.
local _openedAt: number = 0
local _onOpened: { (string) -> () } = {}
local _onClosed: { (string, number) -> () } = {}

local function notifyClosed(name: string)
	local seconds = os.clock() - _openedAt
	for _, callback in _onClosed do
		task.spawn(callback, name, seconds)
	end
end

function PanelManager.onOpened(callback: (string) -> ())
	table.insert(_onOpened, callback)
end

function PanelManager.onClosed(callback: (string, number) -> ())
	table.insert(_onClosed, callback)
end

-- Seit jedes Gebaeude sein EIGENES Menue hat, brauchen drei Stellen denselben
-- Panel-Namen: BuildingPanel meldet ihn an, die Menueleiste oeffnet ihn, und
-- der Welt-Prompt am Gebaeude auch. Die Konvention steht deshalb hier — das
-- ist ohnehin das Modul, dem die Panel-Namen gehoeren, und keines der drei
-- muss dafuer eines der anderen requiren.
function PanelManager.buildingPanelName(buildingId: string): string
	return "Building_" .. buildingId
end

-- v15: der Prompt an der Kampfplattform oeffnet die Tower-Wahl im Kampf-Panel
-- ("Combat"). Das fruehere Ausbau-Menue der Arena (PIT-Level) gibt es nicht mehr.
PanelManager.ARENA_PANEL = "Combat"

--------------------------------------------------------------------------------
-- Anmeldung
--------------------------------------------------------------------------------

function PanelManager.register(name: string, panel: Panel)
	if _panels[name] then
		warn("[PanelManager] Panel doppelt angemeldet:", name)
	end
	_panels[name] = panel
end

--------------------------------------------------------------------------------
-- Steuern
--------------------------------------------------------------------------------

-- Schliesst alle anderen und oeffnet dieses. Zusaetzliche Argumente gehen
-- unveraendert an die open-Funktion des Panels (z.B. die uid einer Karte).
function PanelManager.open(name: string, ...: any)
	local panel = _panels[name]
	if not panel then
		warn("[PanelManager] Unbekanntes Panel:", name)
		return
	end

	for other, entry in _panels do
		if other ~= name then
			local ok, err = pcall(entry.close)
			if not ok then
				warn("[PanelManager] close fehlgeschlagen:", other, err)
			end
		end
	end

	-- Ein Wechsel schliesst das bisherige Panel implizit.
	local previous = _openName
	if previous and previous ~= name then
		notifyClosed(previous)
	end

	_openName = name
	panel.open(...)

	if previous ~= name then
		_openedAt = os.clock()
		for _, callback in _onOpened do
			task.spawn(callback, name)
		end
	end
end

function PanelManager.close(name: string)
	local panel = _panels[name]
	if not panel then return end

	panel.close()
	if _openName == name then
		_openName = nil
		notifyClosed(name)
	end
end

-- Fuer Menue-Buttons: nochmal draufdruecken schliesst wieder.
function PanelManager.toggle(name: string, ...: any)
	if _openName == name then
		PanelManager.close(name)
		return
	end
	PanelManager.open(name, ...)
end

--------------------------------------------------------------------------------
-- Sammel-Update 2.1: Tippen ausserhalb schliesst
--------------------------------------------------------------------------------
-- Ein kurzer Tipp/Klick in die WELT (nicht auf eine Oberflaeche: dann ist
-- gameProcessed true) schliesst das offene Fenster. Bewusst ueber
-- UserInputService statt eines bildschirmfuellenden Knopfs hinter dem
-- Fenster: der wuerde Menueleiste und HUD blockieren. Ein Wischen (Kamera
-- drehen) zaehlt nicht — nur kurz (< TAP_SECONDS) und kaum bewegt.
-- Fenster, die ausdruecklich offen bleiben muessen, stehen in KEEP_OPEN.
local TAP_SECONDS = 0.35
local TAP_MOVE_PX = 14
local KEEP_OPEN: { [string]: boolean } = { Hatch = true, Rebirth = true }

local _tapStart: { [any]: { at: number, pos: Vector3 } } = {}

local function isTapInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or not isTapInput(input) or not _openName then return end
	_tapStart[input] = { at = os.clock(), pos = input.Position }
end)

UserInputService.InputEnded:Connect(function(input: InputObject, _processed: boolean)
	local start = _tapStart[input]
	_tapStart[input] = nil
	if not start then return end
	local name = _openName
	if not name or KEEP_OPEN[name] then return end
	if os.clock() - start.at > TAP_SECONDS then return end
	if (input.Position - start.pos).Magnitude > TAP_MOVE_PX then return end
	PanelManager.close(name)
end)

return PanelManager
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX103"><Properties><string name="Name">PetBar</string><ProtectedString name="Source"><![CDATA[--!strict
-- PetBar.luau
-- StarterPlayerScripts/UI/PetBar.luau
--
-- Einzige Zustaendigkeit:
--   - Die untere Pet-Leiste: zwei grosse Knoepfe "Event" und "Fight", die den
--     ausgeruesteten Baerchi hinschicken bzw. zurueckholen.
--
-- Die Leiste ZEIGT nur an, was der Server meldet (PetModeChanged) — was ein
-- Klick bedeutet, entscheidet PetModeService. Der Client schickt nur, welcher
-- Knopf gedrueckt wurde, und beim Fight-Knopf ggf. die Wahl aus der
-- Fortsetzungs-Frage (PitResumeDialog).
--
-- Zustaende je Knopf:
--   normal        Normalfarbe, Klick schickt hin
--   unterwegs/da  leuchtet, Text "Zurueckholen"
--   wartet        der Baerchi geht erst heim und dann hierher; Klick bricht ab
--   gesperrt      grau, kleine Zeile mit dem Grund

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local FeatureFlags      = require(ReplicatedStorage.Config.FeatureFlags)

local Remotes          = require(ReplicatedStorage.Network.Remotes)
local EventConfig      = require(ReplicatedStorage.Config.EventConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local Loc              = require(ReplicatedStorage.Localization.Loc)   -- Sammel-Update 2.4
local Names = require(game:GetService("ReplicatedStorage").Localization.Names)

local Theme           = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)   -- 08.10.: Tower-Name oeffnet das Tower-Panel
local UiScale         = require(script.Parent.UiScale)
local TouchSafeArea   = require(script.Parent.TouchSafeArea)
local Icons           = require(script.Parent.Icons)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local FightStartPrompt = require(script.Parent.FightStartPrompt)
local ClientState     = require(script.Parent.Parent.Controllers.ClientState)
local Unlock          = require(script.Parent.Unlock)

local PetBar = {}

local BUTTON_WIDTH  = 210
local BUTTON_HEIGHT = 68    -- Mindesthoehe 56 px fuer Touch
local GAP           = 14

local EVENT_COLOR = Color3.fromRGB(120, 190, 255)
local FIGHT_COLOR = Color3.fromRGB(255,  96,  96)
local GLOW_COLOR  = Color3.fromRGB(255, 236, 140)

type ButtonView = {
	button : TextButton,
	title  : TextLabel,
	sub    : TextLabel,
	stroke : UIStroke,
	color  : Color3,
	icon   : GuiObject,
}

local _event: ButtonView? = nil
local _fight: ButtonView? = nil

-- Letzte Server-Meldung (PetModeChanged)
local _state   = "Home"
-- Sammel-Update 05.10. (Paket 4.3): gewaehltes Wiedergabe-Tempo (0 = sofort)
local SPEED_STEPS = { 1, 2, 4, 0 }
local _bossAt: number? = nil   -- Sammel-Update 5.3
local _speedChoice = 1
local _speedButton: TextButton? = nil
local _pending: string? = nil
local _stage: number? = nil
local _tower: string? = nil   -- v15: Tower des laufenden Kampfs (vom Server)
local _from: string? = nil
local _abducting = false

-- Event-Zyklus (EventPhaseChanged)
local _eventId: string? = nil
local _nextEventId: string? = nil
local _phaseEndsAt = 0

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

-- HBB Paket 6: Icon je Event fuer den Timer am Knopf (Name aus UI/Icons,
-- sonst das Zeichen als Rueckfall). Die Wespenkoenigin bekommt ein eigenes.
local EVENT_ICON: { [string]: { name: string, fallback: string } } = {
	Ufo            = { name = "ufo",   fallback = "UFO" },
	HotEgg         = { name = "egg",   fallback = "🥚" },
	MutationsSturm = { name = "",      fallback = "🌪" },
	Koenigshuegel  = { name = "crown", fallback = "♛" },
	Schatzgraeber  = { name = "gift",  fallback = "💎" },
	WaspQueen      = { name = "",      fallback = "🐝" },
}

local function clock(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

local function eventLine(): string
	local remaining = _phaseEndsAt - os.clock()
	if _eventId then
		local def = EventConfig.getById(_eventId)
		return string.format("%s  %s", Names.event(_eventId), clock(remaining))
	end
	if _nextEventId then
		return Loc.t("ui.petbar.next_event", { t = clock(remaining) })
	end
	return ""
end

-- Sammel-Update 5.3: "🐝 Boss in 12 min" (bzw. "🐝 Boss LIVE").
local function bossLine(): string
	local at = _bossAt
	if not at then return "" end
	local left = at - os.clock()
	if left <= 0 then return Loc.t("ui.petbar.boss_live") end
	return Loc.t("ui.petbar.boss_in", { min = math.max(1, math.ceil(left / 60)) })
end

-- "Tower II" fuer eine Tower-Id.
local function towerLabel(towerId: string?): string
	local def = TowerConfig.get(towerId or "") or TowerConfig.TOWERS[1]
	return Loc.t("ui.petbar.tower", { n = def.numeral })
end

-- HP-Anteil des ausgeruesteten Baerchis (nil = keiner da) und der gewaehlte
-- Tower (v15, ersetzt das PIT-Level).
local function fighterInfo(): (number?, string)
	local data = ClientState.get()
	if not data then return nil, "I" end

	local tower = if data.towers then data.towers.selected else "I"
	local uid = data.island.equippedUid
	local baerchi = if uid then data.island.baerchis[uid] else nil
	local def = if baerchi then BaerchiConfig.getById(baerchi.configId) else nil
	if not baerchi or not def then
		return nil, tower
	end

	local maxHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
	local hp = math.clamp(baerchi.currentHp or maxHp, 0, maxHp)
	return hp / math.max(1, maxHp), tower
end

local function paint(view: ButtonView, title: string, sub: string, mode: "normal" | "active" | "waiting" | "disabled")
	view.title.Text = title
	view.sub.Text   = sub

	if mode == "disabled" then
		view.button.Active           = false
		view.button.AutoButtonColor  = false
		view.button.BackgroundColor3 = Theme.COLORS.disabled
		view.stroke.Color            = Theme.COLORS.outline
		view.stroke.Thickness        = Theme.OUTLINE_THICKNESS
		view.title.TextTransparency  = 0.35
		Icons.tint(view.icon, Color3.fromRGB(140, 140, 150))
		return
	end

	Icons.tint(view.icon, Color3.new(1, 1, 1))

	view.button.Active          = true
	view.button.AutoButtonColor = false
	view.title.TextTransparency = 0

	if mode == "active" then
		view.button.BackgroundColor3 = Theme.shade(view.color, 0.15)
		view.stroke.Color            = GLOW_COLOR
		view.stroke.Thickness        = 5
	elseif mode == "waiting" then
		view.button.BackgroundColor3 = Theme.shade(view.color, -0.25)
		view.stroke.Color            = GLOW_COLOR
		view.stroke.Thickness        = 3
	else
		view.button.BackgroundColor3 = view.color
		view.stroke.Color            = Theme.COLORS.outline
		view.stroke.Thickness        = Theme.OUTLINE_THICKNESS
	end
end

--------------------------------------------------------------------------------
-- Anzeige
--------------------------------------------------------------------------------

local _eventIconKey: string? = nil

-- Tauscht das Icon des Event-Knopfs gegen das des kommenden/laufenden Events.
local function setEventIcon(view: ButtonView, eventId: string?)
	local key = eventId or "Ufo"
	if _eventIconKey == key then return end
	_eventIconKey = key
	local look = EVENT_ICON[key] or EVENT_ICON.Ufo
	local old = view.icon
	local icon = Icons.make(view.button, look.name, look.fallback)
	icon.AnchorPoint = old.AnchorPoint
	icon.Position    = old.Position
	icon.Size        = old.Size
	icon.ZIndex      = old.ZIndex
	old:Destroy()
	view.icon = icon
end

local function refresh()
	local event, fight = _event, _fight
	if not event or not fight then return end

	-- Paket 4.3: Tempo-Knopf nur im Tower
	local speedButton = _speedButton
	if speedButton then
		speedButton.Visible = _state == "InPit" or _state == "ToPit"
		speedButton.Text = if _speedChoice == 0 then "⏭ " .. Loc.t("ui.petbar.speed_skip") else "⏩ x" .. _speedChoice
	end

	-- HBB Paket 3: der Event-Knopf erscheint erst nach dem ersten Kampf
	Unlock.apply("button_event", event.button)

	local hpRatio, selectedTower = fighterInfo()
	local hasPet = hpRatio ~= nil

	-- --------------------------------------------------------------- Event
	local eventTitle = Loc.t("ui.petbar.event")
	local recall     = Loc.t("ui.petbar.recall")
	local waiting    = Loc.t("ui.petbar.waiting")
	if not hasPet then
		paint(event, eventTitle, Loc.t("ui.petbar.no_pet"), "disabled")
	elseif _abducting then
		paint(event, eventTitle, Loc.t("ui.petbar.abducted"), "disabled")
	elseif _state == "ToEvent" then
		paint(event, Loc.t("ui.petbar.recall"), Loc.t("ui.petbar.walking_there") .. " • " .. eventLine(), "active")
	elseif _state == "AtEvent" then
		paint(event, Loc.t("ui.petbar.recall"), eventLine(), "active")
	elseif _pending == "Event" then
		paint(event, Loc.t("ui.petbar.waiting"), Loc.t("ui.petbar.switch_hint"), "waiting")
	elseif _state == "Returning" and _from == "Event" then
		paint(event, eventTitle, Loc.t("ui.petbar.coming_home"), "normal")
	elseif FeatureFlags.isOn("EVENT_V2_TIMER") then
		-- HBB Paket 6: Icon des kommenden bzw. laufenden Events + Restzeit,
		-- keine Woerter.
		setEventIcon(event, _eventId or _nextEventId)
		paint(event, clock(_phaseEndsAt - os.clock()), bossLine(), "normal")
	else
		paint(event, eventTitle, eventLine(), "normal")
	end

	-- --------------------------------------------------------------- Fight
	local hpText = if hpRatio then string.format("HP %d%%  •  %s", math.floor(hpRatio * 100 + 0.5), towerLabel(selectedTower)) else ""

	local fightTitle = Loc.t("ui.petbar.fight")
	if not hasPet then
		paint(fight, fightTitle, Loc.t("ui.petbar.no_pet"), "disabled")
	elseif _state == "ToPit" then
		paint(fight, Loc.t("ui.petbar.recall"), Loc.t("ui.petbar.walking_pit"), "active")
	elseif _state == "InPit" then
		paint(fight, Loc.t("ui.petbar.recall"), if _stage then Loc.t("ui.petbar.in_pit_stage", { tower = towerLabel(_tower or selectedTower), stage = _stage }) else towerLabel(_tower or selectedTower), "active")
	elseif _pending == "Fight" then
		paint(fight, Loc.t("ui.petbar.waiting"), Loc.t("ui.petbar.switch_hint_pit"), "waiting")
	elseif _state == "Returning" and _from == "Fight" then
		paint(fight, fightTitle, Loc.t("ui.petbar.coming_home"), "normal")
	elseif (hpRatio or 0) <= 0 then
		paint(fight, fightTitle, Loc.t("ui.petbar.exhausted"), "disabled")
	else
		paint(fight, fightTitle, hpText, "normal")
	end
end

--------------------------------------------------------------------------------
-- Klicks
--------------------------------------------------------------------------------

local function onEventClicked()
	Unlock.markSeen("button_event")
	Remotes.RequestPetMode:FireServer("Event")
end

local function onFightClicked()
	-- Zurueckholen oder einen vorgemerkten Wechsel abbrechen: keine Frage.
	if _state == "ToPit" or _state == "InPit" or _pending == "Fight" then
		Remotes.RequestPetMode:FireServer("Fight")
		return
	end

	-- Neuer Lauf: gibt es einen letzten Lauf in diesem Tower, zuerst die
	-- Fortsetzungs-Frage.
	local data = ClientState.get()

	-- Entscheidung 05.10. (FIGHT_RESUME_PROMPT): Standard ist IMMER Stage 1.
	-- Der Einstieg ab der letzten Stage gegen Gummies ist ein kleines Feld,
	-- das nach 7 s von selbst verschwindet (dann Stage 1). Ein zweiter
	-- Fight-Klick waehrend das Feld offen ist, startet sofort bei Stage 1.
	if FeatureFlags.isOn("FIGHT_RESUME_PROMPT") then
		if FightStartPrompt.isOpen() then
			FightStartPrompt.chooseFresh()
			return
		end
		local opened = FightStartPrompt.open(function(choice)
			Remotes.RequestPetMode:FireServer("Fight", choice)
		end)
		if not opened then
			Remotes.RequestPetMode:FireServer("Fight", "Fresh")
		end
		return
	end

	-- HBB Paket 2: keine Frage mehr. Mit gespeichertem Lauf geht es
	-- kostenlos ab 65 % weiter; der bezahlte Einstieg ab der letzten Stage
	-- ist ein eigener kleiner Knopf im Tower-Fenster (CombatPanel). Der
	-- Server rechnet beide Wege unveraendert.
	if FeatureFlags.isOn("UI_V2_GUIDE") then
		local choice = if data and PitResumeDialog.getProgress(data) then "Percent" else "Fresh"
		Remotes.RequestPetMode:FireServer("Fight", choice)
		return
	end

	if data and PitResumeDialog.getProgress(data) then
		PitResumeDialog.open(function(choice)
			Remotes.RequestPetMode:FireServer("Fight", choice)
		end)
		return
	end

	Remotes.RequestPetMode:FireServer("Fight", "Fresh")
end

--------------------------------------------------------------------------------
-- HBB Paket 2: Anker fuer die Fuehrung (GuideController)
--------------------------------------------------------------------------------

-- 08.10.: letzter Zustand vom Server ("Home", "ToPit", "InPit", ...)
function PetBar.getState(): string
	return _state
end

function PetBar.getButton(mode: string): GuiObject?
	local view = if mode == "Fight" then _fight elseif mode == "Event" then _event else nil
	return if view then view.button else nil
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

local function buildButton(parent: Instance, name: string, color: Color3, order: number, onClick: () -> (), iconName: string, fallback: string): ButtonView
	local button = Theme.bigButton(name, parent, "", color)
	button.Size        = UDim2.fromOffset(BUTTON_WIDTH, BUTTON_HEIGHT)
	button.LayoutOrder = order

	local stroke = button:FindFirstChildOfClass("UIStroke") :: UIStroke

	-- Icon links, ragt oben ueber den Knopf hinaus
	local icon = Icons.make(button, iconName, fallback)
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.Position    = UDim2.new(0, 6, 0.5, -6)
	icon.Size        = UDim2.fromOffset(60, 60)
	icon.ZIndex      = 4

	-- Beschriftung setzt refresh() (in der Spielersprache); `name` ist nur der Instanz-Name
	local title = Theme.label("Title", button, "")
	title.Position       = UDim2.new(0, 64, 0, 6)
	title.Size           = UDim2.new(1, -72, 0, 30)
	title.TextXAlignment = Enum.TextXAlignment.Center
	title.TextColor3     = Theme.COLORS.text
	Theme.outlineText(title)

	local sub = Theme.label("Sub", button, "")
	sub.Position       = UDim2.new(0, 64, 1, -26)
	sub.Size           = UDim2.new(1, -70, 0, 18)
	sub.TextXAlignment = Enum.TextXAlignment.Center
	sub.TextScaled     = false
	sub.TextSize       = 12
	sub.Font           = Theme.FONT_BODY
	sub.TextColor3     = Theme.COLORS.outline
	sub.TextTruncate   = Enum.TextTruncate.AtEnd

	button.Activated:Connect(function()
		if not button.Active then return end
		onClick()
	end)

	return { button = button, title = title, sub = sub, stroke = stroke, color = color, icon = icon }
end

function PetBar.init(screenGui: ScreenGui)
	local bar = Theme.container("PetBar", screenGui)
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position    = UDim2.new(0.5, 0, 1, -14)
	bar.Size        = UDim2.fromOffset(BUTTON_WIDTH * 2 + GAP, BUTTON_HEIGHT)
	bar.ZIndex      = 5

	-- Auf schmalen Bildschirmen (Handy) mitskalieren statt ueber den Rand.
	-- Playtest 07.10.: auf Touch-Geraeten ausserdem raus aus der Zone des
	-- Bewegungs-Sticks und weg vom Sprung-Knopf (TouchSafeArea) — sonst
	-- loeste, wer laufen wollte, den Event-Knopf aus.
	local scale = Instance.new("UIScale")
	scale.Parent = bar
	local barWidth = BUTTON_WIDTH * 2 + GAP
	local function rescale()
		local zone = TouchSafeArea.zone(screenGui)
		if zone then
			bar.Position = UDim2.new(0, zone.center, 1, -14)
			scale.Scale  = math.clamp(zone.width / barWidth, 0.5, 1)
		else
			local width = UiScale.toGui(screenGui.AbsoluteSize.X)
			bar.Position = UDim2.new(0.5, 0, 1, -14)
			scale.Scale  = math.clamp((width - 32) / barWidth, 0.6, 1)
		end
	end
	TouchSafeArea.watch(screenGui, rescale)

	local layout = Theme.listLayout(bar, GAP, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	_event = buildButton(bar, "Event", EVENT_COLOR, 1, onEventClicked, "ufo", "UFO")
	_fight = buildButton(bar, "Fight", FIGHT_COLOR, 2, onFightClicked, "swords", "X")

	-- Sammel-Update 05.10. (Paket 4.3): Tempo-Knopf ueber dem Fight-Knopf,
	-- nur waehrend der Baerchi im Tower kaempft. Ein Tipp schaltet
	-- x1 -> x2 -> x4 -> "sofort" -> x1. Der Server spielt ab der naechsten
	-- Stage schneller ab; die Abrechnung bleibt gleich.
	local speedButton = Theme.button("SpeedButton", _fight.button, "⏩ x1", Theme.COLORS.panelLight)
	speedButton.AnchorPoint = Vector2.new(1, 1)
	speedButton.Position    = UDim2.new(1, 0, 0, -6)
	speedButton.Size        = UDim2.fromOffset(96, 34)
	speedButton.ZIndex      = 6
	speedButton.TextColor3  = Theme.COLORS.text
	speedButton.Visible     = false
	_speedButton = speedButton
	speedButton.Activated:Connect(function()
		local index = (table.find(SPEED_STEPS, _speedChoice) or 1) % #SPEED_STEPS + 1
		_speedChoice = SPEED_STEPS[index]
		Remotes.RequestPitSpeed:FireServer(_speedChoice)
		refresh()
	end)
	FightStartPrompt.init(screenGui, bar)

	-- 08.10. (Tower-Terminal): Antippen des Tower-Namens unter "Kampf"
	-- ("HP 100% · Tower I") oeffnet das Tower-Panel — derselbe Weg wie am
	-- Terminal, nur kuerzer. Eine unsichtbare Flaeche ueber der Unterzeile.
	local towerTap = Instance.new("TextButton")
	towerTap.Name = "TowerTap"
	towerTap.BackgroundTransparency = 1
	towerTap.Text = ""
	towerTap.AnchorPoint = Vector2.new(1, 1)
	towerTap.Position = UDim2.new(1, 0, 1, 0)
	towerTap.Size = UDim2.new(1, -64, 0, 30)
	towerTap.ZIndex = 7
	towerTap.Parent = _fight.button
	towerTap.Activated:Connect(function()
		if _state == "ToPit" or _state == "InPit" then
			onFightClicked()   -- waehrend des Kampfs bleibt es der Zurueckholen-Knopf
			return
		end
		PanelManager.open(PanelManager.ARENA_PANEL)
	end)

	PitResumeDialog.init(screenGui)

	Remotes.PetModeChanged.OnClientEvent:Connect(function(state: any, pending: any, info: any)
		_state   = if typeof(state) == "string" then state else "Home"
		_pending = if typeof(pending) == "string" then pending else nil
		local typedInfo = if typeof(info) == "table" then info else {}
		_stage     = if typeof(typedInfo.stage) == "number" then typedInfo.stage else nil
		_tower     = if typeof(typedInfo.tower) == "string" then typedInfo.tower else nil
		_from      = if typeof(typedInfo.from) == "string" then typedInfo.from else nil
		_abducting = typedInfo.abducting == true

		-- Laeuft der Baerchi los, ist eine offene Fortsetzungs-Frage hinfaellig.
		if _state ~= "Home" and _state ~= "Returning" and PitResumeDialog.isOpen() then
			PitResumeDialog.close()
		end

		refresh()
	end)

	Remotes.EventPhaseChanged.OnClientEvent:Connect(function(eventId: any, remaining: any, nextEventId: any, untilBoss: any)
		-- Sammel-Update 5.3: Countdown bis zum Boss
		_bossAt      = if typeof(untilBoss) == "number" then os.clock() + untilBoss else nil
		_eventId     = if typeof(eventId) == "string" then eventId else nil
		_nextEventId = if typeof(nextEventId) == "string" then nextEventId else nil
		_phaseEndsAt = os.clock() + (if typeof(remaining) == "number" then remaining else 0)
		refresh()
	end)

	ClientState.onChanged(refresh)
	Loc.onChanged(function() refresh() end)

	-- Restzeit des Events jede Sekunde nachziehen
	local accumulator = 0
	RunService.Heartbeat:Connect(function(delta)
		accumulator += delta
		if accumulator < 1 then return end
		accumulator = 0
		refresh()
	end)

	refresh()
	print("[PetBar] Initialisiert")
end

return PetBar
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX104"><Properties><string name="Name">PitResumeDialog</string><ProtectedString name="Source"><![CDATA[--!strict
-- PitResumeDialog.luau
-- StarterPlayerScripts/UI/PitResumeDialog.luau
--
-- Einzige Zustaendigkeit:
--   - Vor einem PIT-Lauf fragen, wo eingestiegen wird: von vorn, ab 65 % des
--     letzten Laufs oder ab der letzten erreichten Stage (gegen Gummies).
--
-- v15: pro Tower. Erscheint nur, wenn es im GEWAEHLTEN Tower einen
-- gespeicherten letzten Lauf gibt (island.towerProgress), auch nach einer
-- Niederlage oder einem Zurueckholen. Startstage und Kosten rechnet
-- TowerConfig — dieselben
-- Funktionen benutzt der Server beim Abbuchen. Nicht bezahlbare Optionen sind
-- sichtbar, aber nicht klickbar. Abbrechen schliesst den Dialog, der Baerchi
-- bleibt zu Hause.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players           = game:GetService("Players")
local Loc = require(game:GetService("ReplicatedStorage").Localization.Loc)   -- Sammel-Update 2.4

local Types            = require(ReplicatedStorage.Network.Types)
local TowerConfig      = require(ReplicatedStorage.Config.TowerConfig)
local GamepassConfig   = require(ReplicatedStorage.Config.GamepassConfig)
local BaerchiConfig    = require(ReplicatedStorage.Config.BaerchiConfig)
local CombatCalculator = require(ReplicatedStorage.Modules.CombatCalculator)
local Loc              = require(ReplicatedStorage.Localization.Loc)

local Theme       = require(script.Parent.Theme)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local PitResumeDialog = {}

export type Choice = "Fresh" | "Percent" | "Last"

local _root: Frame? = nil
local _hpLabel: TextLabel? = nil
local _options: { [Choice]: TextButton } = {}
local _onChoose: ((Choice) -> ())? = nil

local function selectedTower(data: Types.PlayerDataUpdate): string
	return if data.towers then data.towers.selected else TowerConfig.FIRST_TOWER
end

-- Die letzte erreichte Stage im gewaehlten Tower (nil = kein Lauf gespeichert).
function PitResumeDialog.getProgress(data: Types.PlayerDataUpdate): number?
	local progress = data.island.towerProgress
	local reached = if progress then progress[selectedTower(data)] else nil
	if typeof(reached) == "number" and reached >= 1 then
		return reached
	end
	return nil
end

-- Start-Stage und Gummi-Kosten einer Option — dieselbe Rechnung wie
-- CombatService.getResumeOffer (TowerConfig). Oeffentlich fuer FightStartPrompt.
local function offer(data: Types.PlayerDataUpdate, choice: Choice): (number, number)
	if choice == "Fresh" then
		return 1, 0
	end
	local reached = PitResumeDialog.getProgress(data)
	if not reached then
		return 1, 0
	end
	local towerId = selectedTower(data)
	local def = TowerConfig.get(towerId)
	local stage = if choice == "Last"
		then reached
		else TowerConfig.getResumePercentStage(reached)
	stage = math.clamp(stage, 1, if def then def.stages else 1)
	return stage, TowerConfig.getResumeCost(towerId, stage, data.rebirthMult, PitResumeDialog.hasSkipPass())
end

-- 08.10. (Paket C): Gamepass Gratis-Skip besessen? Nur Anzeige — die Kosten
-- rechnet der Server selbst (GamepassService), das Attribut setzt er auch.
function PitResumeDialog.hasSkipPass(): boolean
	return Players.LocalPlayer:GetAttribute(GamepassConfig.attributeName("SKIP_PASS")) == true
end

-- Sammel-Update 2.4: Schluessel statt fester Texte
local LABELS: { [Choice]: string } = {
	Fresh   = "ui.resume.fresh",
	Percent = "ui.resume.percent",
	Last    = "ui.resume.last",
}

local function fill()
	local data = ClientState.get()
	if not data then return end

	for choice, button in _options do
		local stage, cost = offer(data, choice)
		local affordable = cost <= data.gummies

		button.Text = Loc.t("ui.pit_resume.option", {
			label = Loc.t(LABELS[choice]),
			stage = stage,
			cost  = if cost > 0 then Loc.t("event.bonus.gummies", { n = cost }) else Loc.t("ui.resume.free"),
		})
		Theme.setEnabled(button, affordable)
	end

	local hpLabel = _hpLabel
	if hpLabel then
		local uid = data.island.equippedUid
		local baerchi = if uid then data.island.baerchis[uid] else nil
		local def = if baerchi then BaerchiConfig.getById(baerchi.configId) else nil
		local reached = PitResumeDialog.getProgress(data)
		if baerchi and def then
			local maxHp = CombatCalculator.getEffectiveStats(baerchi, def.baseStats).maxHp
			local hp = math.clamp(baerchi.currentHp or maxHp, 0, maxHp)
			hpLabel.Text = Loc.t("ui.resume.status", {
				tower = (TowerConfig.get(selectedTower(data)) or TowerConfig.TOWERS[1]).numeral,
				stage = reached or 0,
				hp = hp, max = maxHp, pct = math.floor(hp / math.max(1, maxHp) * 100 + 0.5),
			})
		end
	end
end

function PitResumeDialog.offer(data: Types.PlayerDataUpdate, choice: Choice): (number, number)
	return offer(data, choice)
end

function PitResumeDialog.close()
	_onChoose = nil
	local root = _root
	if root then root.Visible = false end
end

-- Oeffnet den Dialog. `onChoose` bekommt die gewaehlte Option.
function PitResumeDialog.open(onChoose: (Choice) -> ())
	local root = _root
	if not root then return end
	_onChoose = onChoose
	fill()
	root.Visible = true
end

function PitResumeDialog.isOpen(): boolean
	return _root ~= nil and (_root :: Frame).Visible
end

function PitResumeDialog.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"PitResumeDialog", screenGui,
		Vector2.new(0.46, 0.42),
		Vector2.new(300, 280),
		Vector2.new(520, 340)
	)
	root.ZIndex = 20
	_root = root

	Theme.dialogHeader(root, Loc.t("ui.resume.title"), PitResumeDialog.close)

	local body = Theme.dialogBody(root)
	local layout = Theme.listLayout(body, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local hp = Theme.bodyText("Hp", body, "")
	hp.Size        = UDim2.new(1, 0, 0, 20)
	hp.LayoutOrder = 0
	_hpLabel = hp

	local colors: { [Choice]: Color3 } = {
		Fresh   = Theme.COLORS.accent,
		Percent = Theme.COLORS.goldGummy,
		Last    = Theme.COLORS.bad,
	}

	for order, choice in { "Fresh", "Percent", "Last" } :: { Choice } do
		local button = Theme.bigButton("Option_" .. choice, body, Loc.t(LABELS[choice]), colors[choice])
		button.Size        = UDim2.new(1, 0, 0, 44)
		button.LayoutOrder = order
		button.Activated:Connect(function()
			if not button.Active then return end
			local callback = _onChoose
			PitResumeDialog.close()
			if callback then callback(choice) end
		end)
		_options[choice] = button
	end

	local cancel = Theme.button("Cancel", body, "", Theme.COLORS.panelLight)
	Loc.bind(cancel, "ui.common.cancel")
	cancel.Size        = UDim2.new(1, 0, 0, 34)
	cancel.LayoutOrder = 10
	cancel.TextColor3  = Theme.COLORS.text
	cancel.Activated:Connect(PitResumeDialog.close)

	ClientState.onChanged(function()
		if PitResumeDialog.isOpen() then fill() end
	end)
	Loc.onChanged(function()
		if PitResumeDialog.isOpen() then fill() end
	end)

	print("[PitResumeDialog] Initialisiert")
end

return PitResumeDialog
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX105"><Properties><string name="Name">QuestTracker</string><ProtectedString name="Source"><![CDATA[--!strict
-- QuestTracker.luau
-- StarterPlayerScripts/UI/QuestTracker.luau
--
-- Einzige Zustaendigkeit:
--   - Die kleine Quest-Karte links: immer EINE aktuelle Aufgabe mit Hinweis,
--     Fortschritt und (wenn geschafft) dem Abholen-Knopf
--   - Der Zugang zum Quest-Fenster (Karte antippen)
--   - Der Toast bei ausgezahlter Belohnung
--
-- Das ist die Antwort auf "was mache ich jetzt?": der Spieler muss nichts
-- oeffnen, die naechste sinnvolle Aufgabe steht immer im Bild. Die Karte
-- rechnet nichts, sie zeigt ClientState.get().quests.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")

local Types   = require(ReplicatedStorage.Network.Types)
local Remotes = require(ReplicatedStorage.Network.Remotes)
local Loc     = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local QuestConfig  = require(ReplicatedStorage.Config.QuestConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local Icons        = require(script.Parent.Icons)
local QuestPanel   = require(script.Parent.QuestPanel)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local QuestTracker = {}

local CARD_W = 236
-- Playtest 05.10.: 124 liess "Abholen" und "Tagesbonus" ineinander laufen
local CARD_H = 142

local _card: Frame?          = nil
local _header: TextLabel?    = nil
local _title: TextLabel?     = nil
local _hint: TextLabel?      = nil
local _bar: Theme.Progress?  = nil
local _claim: TextButton?    = nil
local _daily: TextButton?    = nil
local _alert: Frame?         = nil
local _pulse: Tween?         = nil

local function dailyReady(quests: Types.QuestView): (number, number)
	local done, claimable = 0, 0
	for _, entry in quests.daily do
		if entry.claimed then
			done += 1
		elseif entry.progress >= entry.target then
			claimable += 1
		end
	end
	return done, claimable
end

local _bonusOpen = false

-- HBB Paket 2: kompakte Karte (Icon + Zaehler + Belohnungs-Icon). Antippen
-- klappt den Volltext fuer EXPAND_SECONDS auf; ein zweites Antippen oeffnet
-- wie bisher das Quest-Fenster.
local EXPAND_SECONDS = 6
local _expanded = false
local _expandToken = 0
local _questIcon: Frame? = nil
local _reward: Frame? = nil
local _rewardIcon: Frame? = nil
local _rewardLabel: TextLabel? = nil
local _claimCheck: GuiObject? = nil

-- Sammel-Update 05.10. (Paket 3.10, "Quest-UI am Anfang schwierig"): die
-- ERSTE Kettenquest steht immer gross mit Volltext und Fortschritt da, die
-- Tages-Quests erscheinen erst nach ihrem Abschluss.
local _firstQuest = false

local function compact(): boolean
	return FeatureFlags.isOn("UI_V2_GUIDE") and not _expanded and not _firstQuest
end

local function setIcon(holder: Frame?, name: string, fallback: string)
	if not holder then return end
	if holder:GetAttribute("IconName") == name then return end
	holder:SetAttribute("IconName", name)
	for _, child in holder:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	local icon = Icons.make(holder, name, fallback)
	icon.Size = UDim2.fromScale(1, 1)
	icon.ZIndex = 4
end

local function refresh(data: Types.PlayerDataUpdate)
	local quests = data.quests
	local header, title, hint, bar, claim, daily, alert =
		_header, _title, _hint, _bar, _claim, _daily, _alert
	if not quests or not header or not title or not hint or not bar or not claim or not daily or not alert then
		return
	end

	local chain = quests.chain
	_firstQuest = quests.chainDone == 0 and chain ~= nil
	if chain then
		local done = chain.progress >= chain.target
		header.Text = Loc.t("ui.quest.header", { done = quests.chainDone + 1, total = quests.chainTotal })
		title.Text  = QuestPanel.title(chain.id)
		hint.Text   = if done then QuestPanel.rewardText(chain.id) else QuestPanel.hint(chain.id)
		hint.TextColor3 = if done then Theme.COLORS.goldGummy else Theme.COLORS.textDim

		bar.track.Visible = not done
		claim.Visible     = done
		bar.fill.Size     = UDim2.fromScale(math.clamp(chain.progress / math.max(1, chain.target), 0, 1), 1)
		bar.text.Text     = Loc.formatNumber(chain.progress) .. " / " .. Loc.formatNumber(chain.target)

		claim:SetAttribute("QuestId", chain.id)
	else
		header.Text = Loc.t("ui.quest.panel_title")
		title.Text  = Loc.t("ui.quest.chain_done")
		hint.Text   = ""
		bar.track.Visible = false
		claim.Visible     = false
	end

	-- HBB Paket 2: kompakte Darstellung
	local isCompact = compact()
	header.Visible = not isCompact
	title.Visible  = not isCompact
	hint.Visible   = not isCompact
	local questIcon, reward, rewardIcon, rewardLabel, check = _questIcon, _reward, _rewardIcon, _rewardLabel, _claimCheck
	if questIcon and reward and rewardLabel and check then
		local def = if chain then QuestConfig.getById(chain.id) else nil
		questIcon.Visible = isCompact and def ~= nil
		reward.Visible    = isCompact and def ~= nil
		check.Visible     = isCompact and claim.Visible
		claim.TextTransparency = if isCompact then 1 else 0
		if def then
			setIcon(questIcon, QuestConfig.METRIC_ICON[def.metric] or "scroll", "?")
			if def.reward.eggType then
				setIcon(rewardIcon, "egg", "🥚")
				rewardLabel.Text = "+" .. Loc.formatNumber(def.reward.gummies)
			else
				setIcon(rewardIcon, "gummy", "G")
				rewardLabel.Text = "+" .. Loc.formatNumber(def.reward.gummies)
			end
		end
		-- Der Abholen-Knopf bleibt, wo er ist (sein Puls-Tween setzt die Groesse).
		if isCompact then
			bar.track.Position = UDim2.new(0, 64, 0, 18)
			bar.track.Size     = UDim2.new(1, -74, 0, 22)
		else
			bar.track.Position = UDim2.new(0, 10, 0, 80)
			bar.track.Size     = UDim2.new(1, -20, 0, 18)
		end
	end

	local doneCount, claimable = dailyReady(quests)
	daily.Visible = not _firstQuest   -- Paket 3.10: erst nach der ersten Quest
	-- v15: ist der Login-Bonus noch nicht abgeholt, zeigt der untere Knopf
	-- darauf (und oeffnet das Bonus-Fenster statt der Quests).
	local bonusOpen = data.daily ~= nil and data.daily.claimable
	_bonusOpen = bonusOpen
	if isCompact then
		-- Nur Zeichen und Zahlen: Geschenk = Login-Bonus, Rolle = Tagesquests
		daily.Text = if bonusOpen then "🎁" else string.format("📜 %d/%d", doneCount, #quests.daily)
	else
		daily.Text = if bonusOpen
			then Loc.t("ui.daily.tracker_hint")
			else Loc.t("ui.quest.daily_link", { done = doneCount, total = #quests.daily })
	end

	-- Rotes "!" am Karten-Rand: irgendetwas ist abholbereit.
	local chainReady = chain ~= nil and chain.progress >= chain.target
	alert.Visible = chainReady or claimable > 0 or bonusOpen
end

function QuestTracker.init(screenGui: ScreenGui)
	local card = Theme.panel("QuestTracker", screenGui, Theme.COLORS.panelDeep)
	card.Position = UDim2.new(0.012, 12, 0, 148)
	card.Size     = UDim2.new(0, CARD_W, 0, CARD_H)
	card.ZIndex   = 2
	_card = card

	-- Die ganze Karte ist antippbar (oeffnet das Quest-Fenster); die Knoepfe
	-- darauf liegen hoeher und fangen ihre eigenen Klicks ab.
	local hit = Instance.new("TextButton")
	hit.Name                   = "Hit"
	hit.BackgroundTransparency = 1
	hit.Text                   = ""
	hit.Size                   = UDim2.fromScale(1, 1)
	hit.ZIndex                 = 2
	hit.Parent                 = card
	hit.Activated:Connect(function()
		-- HBB Paket 2: erst aufklappen (Volltext), dann erst das Fenster
		if compact() then
			_expanded = true
			_expandToken += 1
			local token = _expandToken
			local data = ClientState.get()
			if data then refresh(data) end
			task.delay(EXPAND_SECONDS, function()
				if token ~= _expandToken then return end
				_expanded = false
				local current = ClientState.get()
				if current then refresh(current) end
			end)
			return
		end
		PanelManager.toggle("Quests")
	end)

	-- Schriftrolle links oben, ragt ueber die Ecke der Karte hinaus
	local icon = Icons.make(card, "scroll", "?")
	icon.Position = UDim2.new(0, -10, 0, -12)
	icon.Size     = UDim2.fromOffset(40, 40)
	icon.ZIndex   = 4

	local header = Theme.label("Header", card, "")
	header.Position   = UDim2.new(0, 36, 0, 5)
	header.Size       = UDim2.new(1, -46, 0, 14)
	header.TextColor3 = Theme.COLORS.accent
	_header = header

	local title = Theme.label("Title", card, "")
	title.Position = UDim2.new(0, 36, 0, 20)
	title.Size     = UDim2.new(1, -46, 0, 22)
	Theme.outlineText(title, 2)
	_title = title

	local hint = Theme.bodyText("Hint", card, "")
	hint.Position  = UDim2.new(0, 10, 0, 44)
	hint.Size      = UDim2.new(1, -20, 0, 32)
	hint.TextSize  = 12
	_hint = hint

	local bar = Theme.progress(card, Theme.COLORS.accent)
	bar.track.Position = UDim2.new(0, 10, 0, 80)
	bar.track.Size     = UDim2.new(1, -20, 0, 18)
	bar.text.TextScaled = false
	bar.text.TextSize   = 12
	_bar = bar

	local claim = Theme.bigButton("Claim", card, "", Theme.COLORS.good)
	-- Mittig verankert: das Pulsieren waechst nach beiden Seiten statt nach rechts unten
	claim.AnchorPoint = Vector2.new(0.5, 0)
	claim.Position = UDim2.new(0.5, 0, 0, 78)
	claim.Size     = UDim2.new(1, -20, 0, 28)
	claim.ZIndex   = 3
	claim.Visible  = false
	Loc.bind(claim, "ui.quest.claim")
	_claim = claim
	claim.Activated:Connect(function()
		local id = claim:GetAttribute("QuestId")
		if typeof(id) == "string" then
			Remotes.RequestClaimQuest:FireServer("chain", id)
		end
	end)

	-- Sanftes Pulsieren, damit ein abholbarer Knopf auffaellt.
	_pulse = TweenService:Create(claim, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Size = UDim2.new(1, -14, 0, 30),
	})
	_pulse:Play()

	local daily = Theme.button("Daily", card, "", Theme.COLORS.panelLight)
	daily.Position   = UDim2.new(0, 10, 1, -30)
	daily.Size       = UDim2.new(1, -20, 0, 22)
	daily.TextColor3 = Theme.COLORS.text
	daily.ZIndex     = 3
	_daily = daily
	daily.Activated:Connect(function()
		PanelManager.toggle(if _bonusOpen then "DailyBonus" else "Quests")
	end)

	local alert = Theme.panel("Alert", card, Theme.COLORS.bad)
	alert.AnchorPoint = Vector2.new(1, 0)
	alert.Position    = UDim2.new(1, 6, 0, -6)
	alert.Size        = UDim2.new(0, 22, 0, 22)
	alert.Visible     = false
	alert.ZIndex      = 4
	Theme.corner(alert, 11)
	local bang = Theme.label("Bang", alert, "!")
	bang.Size           = UDim2.fromScale(1, 1)
	bang.TextXAlignment = Enum.TextXAlignment.Center
	bang.ZIndex         = 5
	_alert = alert

	-- HBB Paket 2: Elemente der kompakten Karte
	local questIcon = Theme.container("QuestIcon", card)
	questIcon.Position = UDim2.new(0, 8, 0, 8)
	questIcon.Size     = UDim2.fromOffset(50, 50)
	questIcon.ZIndex   = 3
	questIcon.Visible  = false
	_questIcon = questIcon

	local reward = Theme.container("Reward", card)
	reward.Position = UDim2.new(0, 64, 0, 46)
	reward.Size     = UDim2.new(1, -74, 0, 28)
	reward.ZIndex   = 3
	reward.Visible  = false
	_reward = reward
	local rewardIcon = Theme.container("Icon", reward)
	rewardIcon.Size = UDim2.fromOffset(28, 28)
	_rewardIcon = rewardIcon
	local rewardLabel = Theme.label("Amount", reward, "")
	rewardLabel.Position = UDim2.new(0, 34, 0, 2)
	rewardLabel.Size     = UDim2.new(1, -34, 1, -4)
	rewardLabel.TextColor3 = Theme.COLORS.goldGummy
	Theme.outlineText(rewardLabel, 2)
	_rewardLabel = rewardLabel

	local check = Icons.make(claim, "check", "✓")
	check.AnchorPoint = Vector2.new(0.5, 0.5)
	check.Position    = UDim2.fromScale(0.5, 0.5)
	check.Size        = UDim2.fromOffset(24, 24)
	check.ZIndex      = 4
	check.Visible     = false
	_claimCheck = check

	ClientState.onChanged(refresh)
	Loc.onChanged(function()
		local data = ClientState.get()
		if data then refresh(data) end
	end)

	Remotes.QuestRewardReceived.OnClientEvent:Connect(function(reward: Types.QuestReward)
		-- Gummies und Eier der Quest fliegen ueber den Datenstand.
		Notify.emit("quest_reward", function()
			Toast.success(Loc.t("ui.quest.toast", { text = QuestPanel.rewardText(reward.questId) }))
		end)
	end)

	print("[QuestTracker] Initialisiert")
end

return QuestTracker
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX106"><Properties><string name="Name">RebirthButton</string><ProtectedString name="Source"><![CDATA[--!strict
-- RebirthButton.luau
-- StarterPlayerScripts/UI/RebirthButton.luau
--
-- Einzige Zustaendigkeit:
--   - Der feste Rebirth-Knopf unten rechts: immer an derselben Stelle,
--     unsichtbar bis zur ersten Rebirth-Moeglichkeit, dann mit Pop-in.
--
-- Kontext: Sammel-Update 05.10., Paket 2.7 ("Rebirth Button muss fixiert
-- sein. Ab der ersten Rebirth-Moeglichkeit erst."). Die Rebirth-Pille oben
-- rechts (Multiplikator) bleibt als zweiter Weg bestehen; dieser Knopf ist
-- der, den man nicht suchen muss.
--
-- Sichtbar ab: erste Rebirth-Bedingung erfuellt (Paket 4.1,
-- TowerConfig.isRebirthReady) ODER schon einmal rebirthed. Danach bleibt er
-- stehen; leuchtet nur, wenn ein Rebirth gerade moeglich ist. Die Wahrheit
-- (darf ich?) entscheidet weiterhin der Server (RebirthService).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")

local Loc         = require(ReplicatedStorage.Localization.Loc)
local TowerConfig = require(ReplicatedStorage.Config.TowerConfig)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local RebirthButton = {}

local SIZE        = Vector2.new(132, 56)
local MARGIN      = 16
local GLOW_PERIOD = 1.2

local _button: TextButton? = nil
local _shown = false
local _glow: UIStroke? = nil
local _glowTween: Tween? = nil

-- Darf der Spieler gerade rebirthen? (gleiche Regel wie der Server)
local function isReady(data: any): boolean
	return TowerConfig.isRebirthReady(data.rebirthCount or 0, data.island.stageBest, data.towers and data.towers.records)
end

local function popIn(button: TextButton)
	local scale = button:FindFirstChild("PopScale") :: UIScale?
	if not scale then
		local created = Instance.new("UIScale")
		created.Name = "PopScale"
		created.Parent = button
		scale = created
	end
	local uiScale = scale :: UIScale
	uiScale.Scale = 0.2
	TweenService:Create(uiScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function setGlow(on: boolean)
	local glow = _glow
	if not glow then return end
	if _glowTween then
		_glowTween:Cancel()
		_glowTween = nil
	end
	if on then
		glow.Transparency = 0
		local tween = TweenService:Create(glow,
			TweenInfo.new(GLOW_PERIOD * 0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Transparency = 0.8 })
		tween:Play()
		_glowTween = tween
	else
		glow.Transparency = 1
	end
end

local function refresh()
	local button = _button
	if not button then return end
	local data = ClientState.get()
	if not data then
		button.Visible = false
		return
	end

	local ready = isReady(data)
	local show = ready or (data.rebirthCount or 0) >= 1
	button.Visible = show
	if show and not _shown then
		popIn(button)
	end
	_shown = show
	setGlow(ready)
end

function RebirthButton.init(screenGui: ScreenGui)
	local button = Theme.bigButton("RebirthButton", screenGui, Loc.t("ui.rebirth.button"), Theme.COLORS.good)
	Loc.bind(button, "ui.rebirth.button")
	button.AnchorPoint = Vector2.new(1, 1)
	button.Position    = UDim2.new(1, -MARGIN, 1, -MARGIN)
	button.Size        = UDim2.fromOffset(SIZE.X, SIZE.Y)
	button.Visible     = false
	button.ZIndex      = 5

	local glow = Instance.new("UIStroke")
	glow.Name            = "Glow"
	glow.Color           = Theme.COLORS.goldGummy
	glow.Thickness       = 5
	glow.Transparency    = 1
	glow.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	glow.Parent          = button
	_glow = glow

	button.Activated:Connect(function()
		PanelManager.toggle("Rebirth")
	end)
	_button = button

	ClientState.onChanged(refresh)
	refresh()
end

return RebirthButton
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX107"><Properties><string name="Name">RebirthDialog</string><ProtectedString name="Source"><![CDATA[--!strict
-- RebirthDialog.luau
-- StarterPlayerScripts/UI/RebirthDialog.luau
--
-- Einzige Zustaendigkeit:
--   - Vor dem Rebirth klar sagen was verloren geht und was bleibt
--   - Den Rebirth ausloesen und das Ergebnis bestaetigen
--
-- Der Text unten muss zu RebirthService passen — dort steht die verbindliche
-- Liste. Stand jetzt:
--   verloren : alle Baerchis, alle Gebaeude-Level, PIT-Level, laufende Bruten,
--              Gummies (zurueck auf EconomyConfig.REBIRTH_START_GUMMIES)
--   behalten : GoldGummies, Rang, Statistiken, bereits verdiente AscensionEggs
--   gewonnen : hoeherer Multiplikator, ggf. AscensionEggs (Meilenstein)
-- Wer den Service aendert, aendert diesen Text mit.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types         = require(ReplicatedStorage.Network.Types)
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local TowerConfig   = require(ReplicatedStorage.Config.TowerConfig)   -- Paket 4.1
local EconomyConfig = require(ReplicatedStorage.Config.EconomyConfig)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags  = require(ReplicatedStorage.Config.FeatureFlags)

local Theme        = require(script.Parent.Theme)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local Moment       = require(script.Parent.Moment)
local PanelManager = require(script.Parent.PanelManager)
local Icons        = require(script.Parent.Icons)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local RebirthDialog = {}

local PANEL_NAME = "Rebirth"

local _root: Frame?               = nil
local _statusLabel: TextLabel?    = nil
local _costLabel: TextLabel?      = nil
local _lossLabel: TextLabel?      = nil
local _rewardLabel: TextLabel?    = nil
local _confirmButton: TextButton? = nil
-- HBB Paket 2: Icons vor den Zeilen (Vorher/Nachher ohne Saetze)
local _rowIcons: { GuiObject } = {}
local ICON_W = 28

--------------------------------------------------------------------------------
-- Inhalt
--------------------------------------------------------------------------------

function RebirthDialog.refresh()
	local root = _root
	if not root or not root.Visible then return end

	local data = ClientState.get()
	if not data then return end

	-- Sammel-Update 05.10. (Paket 4.1): Bedingung ist eine Stage, kein Preis.
	local records = data.towers and data.towers.records
	local reqTower, reqStage = TowerConfig.getRebirthRequirement(data.rebirthCount, records)
	local reqDef  = TowerConfig.get(reqTower)
	local have    = ((data.island :: any).stageBest or {})[reqTower] or 0
	local nextMult = EconomyConfig.getRebirthMult(data.rebirthCount + 1)
	local eggs    = EconomyConfig.getAscensionEggReward(data.rebirthCount + 1)
	local enough  = TowerConfig.isRebirthReady(data.rebirthCount, (data.island :: any).stageBest, records)

	-- Zahlen uebergibt der Code als Zahlen: Loc formatiert sie je nach Sprache
	-- ("1.500" / "1,500" / "1 500"), der Text legt das Dezimalformat fest ({mult:d2}).
	if _statusLabel then
		_statusLabel.Text = Loc.t("ui.rebirth.status", {
			count = data.rebirthCount,
			mult  = data.rebirthMult,
		})
	end

	if _costLabel then
		_costLabel.Text = Loc.t("ui.rebirth.requirement", {
			tower = if reqDef then reqDef.numeral else reqTower,
			have  = math.min(have, reqStage),
			stage = reqStage,
		})
		_costLabel.TextColor3 = if enough then Theme.COLORS.good else Theme.COLORS.bad
	end

	if _lossLabel then
		_lossLabel.Text = Loc.t("ui.rebirth.loss", { start = EconomyConfig.REBIRTH_START_GUMMIES })
	end

	if _rewardLabel then
		-- v14: Meilensteine koennen jetzt alle vier Ascensions-Eier geben.
		local milestone = EconomyConfig.getRebirthMilestone(data.rebirthCount + 1)
		local onlyAscension = true
		local parts: { string } = {}
		if milestone then
			for _, entry in milestone.eggs do
				if entry.eggType ~= "AscensionEgg" then onlyAscension = false end
				table.insert(parts, string.format("+%d %s", entry.count,
					Loc.name("egg." .. entry.eggType .. ".name", entry.eggType)))
			end
		end
		_rewardLabel.Text = if #parts > 0 and not onlyAscension
			then Loc.t("ui.rebirth.reward_list", { mult = nextMult, eggs = table.concat(parts, ", ") })
			elseif eggs > 0 then Loc.tn("ui.rebirth.reward_eggs", eggs, { mult = nextMult })
			else Loc.t("ui.rebirth.reward", { mult = nextMult })
	end

	if _confirmButton then
		Theme.setEnabled(_confirmButton, enough)
	end

	-- HBB Paket 2: dieselben Zeilen als Icon + Zahl. Die Warnung vor dem
	-- Zuruecksetzen bleibt ein kurzer Satz: sie darf nicht in einem Icon
	-- verschwinden.
	local iconMode = FeatureFlags.isOn("UI_V2_GUIDE")
	for _, icon in _rowIcons do
		icon.Visible = iconMode
	end
	local labels = { _statusLabel, _costLabel, _lossLabel, _rewardLabel }
	for index, label in labels do
		if label then
			-- Platz fuer das Icon links; die Warnung (Zeile 3) hat keins
			local shift = if iconMode and index ~= 3 then ICON_W + 6 else 0
			label.Position = UDim2.new(0, shift + (if index == 3 then 2 else 0), label.Position.Y.Scale, label.Position.Y.Offset)
			label.Size = UDim2.new(1, -8 - shift, label.Size.Y.Scale, label.Size.Y.Offset)
		end
	end
	if iconMode then
		if _statusLabel then
			_statusLabel.Text = string.format("x%s  ➜  x%s",
				Loc.formatDecimal(data.rebirthMult, 2), Loc.formatDecimal(nextMult, 2))
		end
		if _costLabel then
			_costLabel.Text = string.format("%s %s · %s / %s", "🗼",
				if reqDef then reqDef.numeral else reqTower,
				Loc.formatNumber(math.min(have, reqStage)), Loc.formatNumber(reqStage))
		end
		if _lossLabel then
			_lossLabel.Text = "⚠ " .. Loc.t("ui.rebirth.warn_short")
		end
		if _rewardLabel then
			local milestone = EconomyConfig.getRebirthMilestone(data.rebirthCount + 1)
			local total = 0
			if milestone then
				for _, entry in milestone.eggs do total += entry.count end
			end
			total = math.max(total, eggs)
			_rewardLabel.Text = if total > 0 then "+" .. Loc.formatNumber(total) else "—"
		end
	end
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local root = _root
	if not root then return end

	root.Visible = true
	RebirthDialog.refresh()
end

local function closeInternal()
	local root = _root
	if root then root.Visible = false end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function RebirthDialog.init(screenGui: ScreenGui)
	local root = Theme.dialog(
		"RebirthDialog", screenGui,
		Vector2.new(0.46, 0.50),
		Vector2.new(300, 270),
		Vector2.new(520, 400)
	)
	_root = root

	local title = Theme.dialogHeader(root, "", function()
		PanelManager.close(PANEL_NAME)
	end)
	Loc.bind(title, "ui.rebirth.title")

	local body = Theme.dialogBody(root)

	local status = Theme.label("Status", body, "")
	status.Size = UDim2.new(1, -8, 0, 24)
	_statusLabel = status

	local cost = Theme.label("Cost", body, "")
	cost.Position = UDim2.new(0, 0, 0, 28)
	cost.Size     = UDim2.new(1, -8, 0, 22)
	_costLabel = cost

	local loss = Theme.bodyText("Loss", body, "")
	loss.Position = UDim2.new(0, 2, 0, 56)
	loss.Size     = UDim2.new(1, -8, 0, 86)
	_lossLabel = loss

	local reward = Theme.label("Reward", body, "")
	reward.Position   = UDim2.new(0, 0, 0, 146)
	reward.Size       = UDim2.new(1, -8, 0, 24)
	reward.TextColor3 = Theme.COLORS.goldGummy
	_rewardLabel = reward

	-- HBB Paket 2: Icons fuer Multiplikator, Kosten, Belohnung (Zeile 3 =
	-- Warnung bleibt ohne Icon)
	local function rowIcon(y: number, name: string, fallback: string)
		local icon = Icons.make(body, name, fallback)
		icon.Position = UDim2.new(0, 0, 0, y)
		icon.Size = UDim2.fromOffset(ICON_W, ICON_W)
		icon.Visible = false
		table.insert(_rowIcons, icon)
	end
	rowIcon(-2, "rebirth", "*")
	rowIcon(25, "gummy", "G")
	rowIcon(144, "egg", "🥚")

	local cancel = Theme.button("Cancel", body, "", Theme.COLORS.panelLight)
	Loc.bind(cancel, "ui.rebirth.cancel")
	cancel.AnchorPoint = Vector2.new(0, 1)
	cancel.Position    = UDim2.new(0, 0, 1, 0)
	cancel.Size        = UDim2.new(0.5, -6, 0, 38)
	cancel.TextColor3  = Theme.COLORS.text
	cancel.Activated:Connect(function()
		PanelManager.close(PANEL_NAME)
	end)

	local confirm = Theme.button("Confirm", body, "", Theme.COLORS.gummy)
	Loc.bind(confirm, "ui.rebirth.confirm")
	confirm.AnchorPoint = Vector2.new(1, 1)
	confirm.Position    = UDim2.new(1, -8, 1, 0)
	confirm.Size        = UDim2.new(0.5, -6, 0, 38)
	_confirmButton = confirm

	confirm.Activated:Connect(function()
		Remotes.RequestRebirth:FireServer()
	end)

	PanelManager.register(PANEL_NAME, {
		open  = openInternal,
		close = closeInternal,
	})

	ClientState.onChanged(function()
		RebirthDialog.refresh()
	end)

	-- Sprachwechsel bei offenem Dialog: die Texte aus dem Spielstand neu setzen
	-- (die gebundenen Beschriftungen — Titel, Knoepfe — zieht Loc selbst nach)
	Loc.onChanged(function()
		RebirthDialog.refresh()
	end)

	Remotes.RebirthResultReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.RebirthResult

		local args = { count = typed.newRebirthCount, mult = typed.newMultiplier }

		local parts: { string } = {}
		local onlyAscension = true
		for _, entry in (typed.milestoneEggs or {}) do
			if entry.eggType ~= "AscensionEgg" then onlyAscension = false end
			table.insert(parts, string.format("%d %s", entry.count,
				Loc.name("egg." .. entry.eggType .. ".name", entry.eggType)))
		end
		Notify.emit("rebirth_done", function()
			if #parts > 0 and not onlyAscension then
				Toast.success(Loc.t("msg.rebirth_done_list", {
					count = typed.newRebirthCount, mult = typed.newMultiplier, eggs = table.concat(parts, ", "),
				}))
			else
				Toast.success(if typed.ascensionEggs > 0
					then Loc.tn("msg.rebirth_done_eggs", typed.ascensionEggs, args)
					else Loc.t("msg.rebirth_done", args))
			end
		end, function()
			-- Meilenstein-Eier fliegen ueber den Datenstand (UI/Feedback).
			Moment.show("rebirth", Theme.COLORS.good, "ui.moment.rebirth")
		end)

		PanelManager.close(PANEL_NAME)
	end)

	print("[RebirthDialog] Initialisiert")
end

return RebirthDialog
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX108"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!strict
-- Theme.luau
-- StarterPlayerScripts/UI/Theme.luau
--
-- Einzige Zustaendigkeit:
--   - Farben, Schrift und Baustein-Helfer fuer das gesamte UI
--
-- Kein UI-Modul definiert eigene Farben oder baut Frames von Hand —
-- alles laeuft hier durch. Wenn der Look sich aendert, aendert er sich hier.
--
-- Die Rarity-Farben kommen bewusst NICHT von hier, sondern aus
-- BaerchiConfig.RARITY_COLORS: der Server faerbt die Figuren auf der Insel
-- mit denselben Werten, und die duerfen nicht auseinanderlaufen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")

local BaerchiConfig = require(ReplicatedStorage.Config.BaerchiConfig)
local Types         = require(ReplicatedStorage.Network.Types)
local Loc           = require(ReplicatedStorage.Localization.Loc)
local RarityBandConfig = require(ReplicatedStorage.Config.RarityBandConfig)  -- HBB Paket 4

local Theme = {}

--------------------------------------------------------------------------------
-- Farben
--------------------------------------------------------------------------------

Theme.COLORS = {
	-- Flaechen
	panel      = Color3.fromRGB( 52,  46,  78),
	panelDeep  = Color3.fromRGB( 38,  34,  58),
	panelLight = Color3.fromRGB( 72,  64, 104),

	-- Rahmen (der dicke dunkle Cartoon-Rand)
	outline    = Color3.fromRGB( 24,  20,  38),

	-- Schrift
	text       = Color3.fromRGB(255, 255, 255),
	textDim    = Color3.fromRGB(188, 182, 210),

	-- Waehrungen
	gummy      = Color3.fromRGB(255, 105, 150),
	goldGummy  = Color3.fromRGB(255, 196,  60),

	-- Zustaende
	good       = Color3.fromRGB( 76, 217, 100),
	bad        = Color3.fromRGB(255,  82,  82),
	accent     = Color3.fromRGB(120, 190, 255),

	-- Die drei Gebaeude-Rollen (siehe Theme.buildingColor). Benannt nach der
	-- ROLLE, nicht nach dem Gebaeude: die Farbe soll sagen WOFUER sein Honig
	-- gut ist.
	volume     = Color3.fromRGB(255, 186,  62),   -- Vorrat
	healing    = Color3.fromRGB( 92, 222, 160),   -- Heilung
	growth     = Color3.fromRGB(178, 148, 255),   -- Wachstum

	-- Ausgegrauter Button (siehe Theme.setEnabled)
	disabled   = Color3.fromRGB( 84,  80, 104),
}

Theme.FONT      = Enum.Font.FredokaOne
Theme.FONT_BODY = Enum.Font.GothamMedium

-- Dicke des Cartoon-Rands
Theme.OUTLINE_THICKNESS = 3
Theme.CORNER_RADIUS     = 14

function Theme.rarityColor(rarity: Types.Rarity): Color3
	return BaerchiConfig.getRarityColor(rarity)
end

-- Akzentfarbe eines Honig-Gebaeudes.
--
-- Die Zuordnung steht an EINER Stelle, genau wie bei rarityColor: das
-- Gebaeude-Panel faerbt damit seine Karten, die Baerchi-Detailkarte ihre
-- Fuetter-Knoepfe. Zwei getrennte Listen waeren die naechste Stelle, an der
-- Farbe und Gebaeude auseinanderlaufen.
--
-- Was die Farben BEDEUTEN, steht bei den Rollen in Config/BuildingBehavior:
-- Bienenstock = Vorrat, Honigtopf = Heilung, Honig-Presse = Wachstum.
local BUILDING_COLORS: { [string]: Color3 } = {
	Beehive    = Theme.COLORS.volume,
	HoneyRefiner = Theme.COLORS.growth,
	HoneyPond  = Theme.COLORS.goldGummy,   -- Honig-Teich / -Brunnen (HONEY_POND_V2)
}

-- HBB Paket 4: Farben der fuenf Rarity-Baender (Zuordnung in
-- Config/RarityBandConfig). Kraeftig und weit auseinander, damit ein Kind
-- sie ohne Text unterscheidet.
Theme.BAND_COLORS = {
	Color3.fromRGB(176, 190, 204),   -- 1 grau
	Color3.fromRGB( 46, 155, 255),   -- 2 blau
	Color3.fromRGB(255, 176,  32),   -- 3 gold
	Color3.fromRGB(168,  85, 247),   -- 4 lila
	Color3.fromRGB(255,  70, 110),   -- 5 rot-pink
}

function Theme.bandColor(rarity: string): Color3
	return Theme.BAND_COLORS[RarityBandConfig.bandOf(rarity)] or Theme.BAND_COLORS[1]
end

function Theme.buildingColor(buildingId: string): Color3
	return BUILDING_COLORS[buildingId] or Theme.COLORS.accent
end

--------------------------------------------------------------------------------
-- Bausteine
--------------------------------------------------------------------------------

function Theme.corner(parent: Instance, radius: number?): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or Theme.CORNER_RADIUS)
	corner.Parent = parent
	return corner
end

function Theme.stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color        = color or Theme.COLORS.outline
	stroke.Thickness    = thickness or Theme.OUTLINE_THICKNESS
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent       = parent
	return stroke
end

-- Hellere bzw. dunklere Variante einer Farbe. `amount` > 0 hellt auf, < 0
-- dunkelt ab, jeweils 0..1. Damit muss keine Farbvariante von Hand gepflegt
-- werden — jede Flaeche kann sich ihre Abstufung aus der Grundfarbe holen.
function Theme.shade(color: Color3, amount: number): Color3
	if amount >= 0 then
		return color:Lerp(Color3.new(1, 1, 1), math.clamp(amount, 0, 1))
	end
	return color:Lerp(Color3.new(0, 0, 0), math.clamp(-amount, 0, 1))
end

-- Farbverlauf ueber eine Flaeche.
--
-- Der kuerzeste Weg von "Platzhalter" zu "Spiel": eine flache Farbe sieht aus
-- wie ein unfertiges Rechteck, dieselbe Farbe mit einem Verlauf sieht aus wie
-- ein Knopf. Wird fuer die Kopfbalken und die grossen Knoepfe der
-- Gebaeude-Menues benutzt.
--
-- `rotation` in Grad: 90 = von oben nach unten (Standard).
function Theme.gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	-- Ein vorhandener Verlauf wird ueberschrieben statt gestapelt: zwei
	-- UIGradients multiplizieren sich und machen den Knopf dunkel. So kann
	-- Theme.button schon einen Grundverlauf setzen, und bigButton oder eine
	-- Kachel faerbt ihn nur um.
	local gradient = parent:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, top),
		ColorSequenceKeypoint.new(1, bottom),
	})
	gradient.Rotation = rotation or 90
	gradient.Parent   = parent
	return gradient
end

function Theme.padding(parent: Instance, px: number): UIPadding
	local padding = Instance.new("UIPadding")
	padding.PaddingTop    = UDim.new(0, px)
	padding.PaddingBottom = UDim.new(0, px)
	padding.PaddingLeft   = UDim.new(0, px)
	padding.PaddingRight  = UDim.new(0, px)
	padding.Parent        = parent
	return padding
end

function Theme.listLayout(parent: Instance, padding: number, horizontal: boolean?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.FillDirection       = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	layout.SortOrder           = Enum.SortOrder.LayoutOrder
	layout.Padding             = UDim.new(0, padding)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment   = Enum.VerticalAlignment.Top
	layout.Parent              = parent
	return layout
end

-- Durchsichtiger Container ohne Rand
function Theme.container(name: string, parent: Instance): Frame
	local frame = Instance.new("Frame")
	frame.Name                   = name
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel        = 0
	frame.Parent                 = parent
	return frame
end

-- Gefuellte Flaeche mit Rundung und Cartoon-Rand
function Theme.panel(name: string, parent: Instance, color: Color3?): Frame
	local frame = Instance.new("Frame")
	frame.Name            = name
	frame.BackgroundColor3 = color or Theme.COLORS.panel
	frame.BorderSizePixel = 0
	frame.Parent          = parent

	Theme.corner(frame)
	Theme.stroke(frame)
	-- Leichter Verlauf: eine flache Flaeche wirkt wie ein Platzhalter, mit
	-- hellerer Oberkante wie ein Spielelement.
	-- (Ein UIGradient MULTIPLIZIERT sich auf die Hintergrundfarbe: weiss =
	-- unveraendert, grau = dunkler. Deshalb neutrale Farben, nicht shade().)
	Theme.gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(196, 196, 208))
	return frame
end

-- Heller Glanzstreifen auf der oberen Haelfte eines Knopfes — der kleine
-- Kniff, der aus einem Rechteck einen "Cartoon-Knopf" macht. Faengt keine
-- Klicks ab (Frame, nicht aktiv).
function Theme.shine(parent: GuiObject, radius: number?): Frame
	local shine = Instance.new("Frame")
	shine.Name                   = "Shine"
	shine.AnchorPoint            = Vector2.new(0.5, 0)
	shine.Position               = UDim2.new(0.5, 0, 0, 3)
	shine.Size                   = UDim2.new(1, -10, 0.42, 0)
	shine.BackgroundColor3       = Color3.new(1, 1, 1)
	shine.BackgroundTransparency = 0.82
	shine.BorderSizePixel        = 0
	shine.Active                 = false
	shine.Parent                 = parent
	Theme.corner(shine, radius or 8)
	return shine
end

-- Weiches Anwachsen beim Drueberfahren, Eindruecken beim Druecken. Ein
-- UIScale statt Size, damit Layouts und Tweens an der Groesse unberuehrt bleiben.
local PRESS_TWEEN = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function Theme.pressable(button: GuiButton, hover: number?)
	local grow = hover or 1.06
	local scale = Instance.new("UIScale")
	scale.Name   = "PressScale"
	scale.Parent = button

	local function to(target: number)
		TweenService:Create(scale, PRESS_TWEEN, { Scale = target }):Play()
	end

	button.MouseEnter:Connect(function()
		if button.Active then to(grow) end
	end)
	button.MouseLeave:Connect(function()
		to(1)
	end)
	button.MouseButton1Down:Connect(function()
		if button.Active then to(0.93) end
	end)
	button.MouseButton1Up:Connect(function()
		if button.Active then to(grow) end
	end)
end

function Theme.label(name: string, parent: Instance, text: string?): TextLabel
	local label = Instance.new("TextLabel")
	label.Name                   = name
	label.BackgroundTransparency = 1
	label.Font                   = Theme.FONT
	label.Text                   = text or ""
	label.TextColor3             = Theme.COLORS.text
	label.TextScaled             = true
	label.TextXAlignment         = Enum.TextXAlignment.Left
	label.Parent                 = parent

	-- Verhindert absurd grosse Schrift auf hohen Frames
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 28
	constraint.MinTextSize = 8
	constraint.Parent      = label

	return label
end

-- Kleiner, mehrzeiliger Fliesstext (Beschreibungen, Effekt-Texte).
-- Bewusst mit fester TextSize statt TextScaled: umgebrochener Text
-- wird sonst je nach Zeilenzahl unterschiedlich gross.
function Theme.bodyText(name: string, parent: Instance, text: string?): TextLabel
	local label = Instance.new("TextLabel")
	label.Name                   = name
	label.BackgroundTransparency = 1
	label.Font                   = Theme.FONT_BODY
	label.Text                   = text or ""
	label.TextColor3             = Theme.COLORS.textDim
	label.TextScaled             = false
	label.TextSize               = 14
	label.TextWrapped            = true
	label.TextXAlignment         = Enum.TextXAlignment.Left
	label.TextYAlignment         = Enum.TextYAlignment.Top
	label.Parent                 = parent
	return label
end

function Theme.button(name: string, parent: Instance, text: string, color: Color3?): TextButton
	local button = Instance.new("TextButton")
	button.Name             = name
	button.BackgroundColor3  = color or Theme.COLORS.accent
	button.BorderSizePixel   = 0
	button.Font              = Theme.FONT
	button.Text              = text
	button.TextColor3        = Theme.COLORS.outline
	button.TextScaled        = true
	button.AutoButtonColor   = true
	button.Parent            = parent

	Theme.corner(button, 12)
	Theme.stroke(button)

	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 24
	constraint.MinTextSize = 8
	constraint.Parent      = button

	-- Cartoon-Look: Verlauf + Glanzstreifen + Hover/Druck-Animation.
	-- AutoButtonColor aus: der Standard-Abdunkler faerbt sonst den ganzen
	-- Verlauf grau; die Animation uebernimmt das Feedback.
	-- Neutraler Verlauf (multipliziert sich auf die Knopffarbe, siehe panel).
	Theme.gradient(button, Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 190, 200))
	Theme.shine(button, 9)
	button.AutoButtonColor = false
	Theme.pressable(button)

	return button
end

-- Button ausgrauen bzw. wieder freigeben.
--
-- Das ist reiner Komfort: der Server prueft jede Anfrage selbst und schickt
-- bei Ablehnung ein ActionFailed (→ Toast). Ein ausgegrauter Button ist nur
-- die freundliche Vorwarnung, nie die Absicherung.
--
-- Die urspruengliche Farbe wird beim ersten Ausgrauen als Attribut gemerkt,
-- damit der Aufrufer sie nicht selbst mitschleppen muss.
-- Grosser, bunter Aktionsknopf mit Verlauf — der Knopf, um den herum ein
-- Menue gebaut wird ("AUSBAUEN", "FUETTERN"). Bewusst deutlich hoeher und
-- kraeftiger als Theme.button: in einem Menue soll auf einen Blick klar sein,
-- was der Hauptzweck ist.
function Theme.bigButton(name: string, parent: Instance, text: string, color: Color3): TextButton
	local button = Theme.button(name, parent, text, color)
	Theme.gradient(button, Theme.shade(color, 0.28), Theme.shade(color, -0.12))
	return button
end

-- Dunkler Umriss um die Schrift — der Look, den Roblox-Spiele fuer Beschriftungen
-- ueber bunten Flaechen benutzen. Ohne ihn verschwindet weisser Text auf gelben
-- Kacheln, und mit ihm wirkt jede Beschriftung wie aufgeklebt statt wie
-- hineingerechnet.
function Theme.outlineText(label: TextLabel, thickness: number?): TextLabel
	label.TextStrokeColor3       = Theme.COLORS.outline
	label.TextStrokeTransparency = 0
	label.RichText               = false

	local stroke = Instance.new("UIStroke")
	stroke.Color         = Theme.COLORS.outline
	stroke.Thickness     = thickness or 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent        = label

	return label
end

-- Kleine Grossbuchstaben-Ueberschrift ueber einem Abschnitt einer Karte.
function Theme.sectionLabel(name: string, parent: Instance, text: string, color: Color3?): TextLabel
	local label = Theme.label(name, parent, string.upper(text))
	label.TextColor3 = color or Theme.COLORS.textDim
	label.TextScaled = false
	label.TextSize   = 13
	label.Font       = Theme.FONT
	return label
end

function Theme.setEnabled(button: TextButton, enabled: boolean)
	local stored = button:GetAttribute("EnabledColor")
	if typeof(stored) ~= "Color3" then
		stored = button.BackgroundColor3
		button:SetAttribute("EnabledColor", stored)
	end

	button.Active          = enabled
	local shine = button:FindFirstChild("Shine")
	if shine and shine:IsA("GuiObject") then
		shine.Visible = enabled
	end
	button.BackgroundColor3 = if enabled then (stored :: Color3) else Theme.COLORS.disabled
	button.TextTransparency = if enabled then 0 else 0.4

	-- Ein Verlauf (Theme.bigButton) multipliziert sich auf die Hintergrundfarbe
	-- und wuerde den ausgegrauten Knopf weiter bunt aussehen lassen. Deshalb
	-- geht er beim Ausgrauen mit aus.
	local gradient = button:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Enabled = enabled
	end
end

-- Scrollbare Liste. Der Aufrufer haengt ein Theme.listLayout hinein und
-- setzt seine Zeilen auf UDim2.new(1, -8, 0, hoehe) — die -8 lassen Platz
-- fuer den Scrollbalken, sonst ragt jede Zeile darunter.
function Theme.scroller(name: string, parent: Instance): ScrollingFrame
	local scroller = Instance.new("ScrollingFrame")
	scroller.Name                   = name
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel        = 0
	scroller.ScrollBarThickness     = 6
	scroller.ScrollBarImageColor3   = Theme.COLORS.panelLight
	scroller.CanvasSize             = UDim2.new()
	scroller.AutomaticCanvasSize    = Enum.AutomaticSize.Y
	scroller.ScrollingDirection     = Enum.ScrollingDirection.Y
	scroller.Parent                 = parent
	return scroller
end

export type Progress = {
	track : Frame,
	fill  : Frame,
	text  : TextLabel,
}

-- Fortschrittsbalken mit Text darueber (Brut-Timer, XP, Kampf-HP).
function Theme.progress(parent: Instance, fillColor: Color3?): Progress
	local track = Theme.panel("Track", parent, Theme.COLORS.panelDeep)
	track.ClipsDescendants = true   -- damit der Fuellbalken die Rundung nicht ueberragt

	local fill = Instance.new("Frame")
	fill.Name             = "Fill"
	fill.Size             = UDim2.fromScale(0, 1)
	fill.BackgroundColor3  = fillColor or Theme.COLORS.accent
	fill.BorderSizePixel   = 0
	fill.Parent            = track
	Theme.corner(fill, 12)
	Theme.gradient(fill, Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 170, 185))
	Theme.shine(fill, 6).Size = UDim2.new(1, -8, 0.4, 0)

	local text = Theme.label("Text", track, "")
	text.Size           = UDim2.fromScale(1, 1)
	text.TextXAlignment = Enum.TextXAlignment.Center
	text.ZIndex         = 3
	Theme.outlineText(text, 2)

	return { track = track, fill = fill, text = text }
end

--------------------------------------------------------------------------------
-- Dialoge
--------------------------------------------------------------------------------

-- Ein Dialog laesst mindestens so viel vom Bildschirm frei (Anteil, je Achse).
local DIALOG_SCREEN_FILL = 0.94

-- Name des UIScale, mit dem ein Dialog auf kleine Bildschirme passt (siehe
-- Theme.dialog und Theme.dialogScale).
local FIT_SCALE_NAME = "FitScale"

-- Schliessen-Knopf (Sammel-Update 2.1: 44x40) plus eine unsichtbare
-- Trefferflaeche 56x56 darum — auf dem Handy trifft ein Daumen sonst leicht
-- daneben (Richtwert 44 pt).
local CLOSE_HIT = 56

-- Zentriertes Panel, standardmaessig unsichtbar. Groesse in Scale, damit es
-- auf Handy und Monitor passt; die Constraints halten es lesbar.
--
-- UI-Qualitaet Schritt 2: die Mindestgroesse (minSize) war auf kleinen
-- Bildschirmen groesser als der Bildschirm selbst — ein Handy quer hat ohne
-- Topbar rund 350 px Hoehe, Charms/Bestenliste/Kampf brauchen 420. Kopfzeile
-- und Schliessen-X lagen dann ausserhalb. Jetzt verkleinert ein UIScale
-- (FitScale) den GANZEN Dialog gleichmaessig, bis er passt: das Layout bleibt
-- wie gebaut, nur kleiner. Auf normalen Bildschirmen ist der Faktor 1.
function Theme.dialog(name: string, parent: Instance, scale: Vector2, minSize: Vector2, maxSize: Vector2): Frame
	local root = Theme.panel(name, parent, Theme.COLORS.panelDeep)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position    = UDim2.fromScale(0.5, 0.5)
	root.Size        = UDim2.fromScale(scale.X, scale.Y)
	root.Visible     = false
	root.ZIndex      = 10

	local constraint = Instance.new("UISizeConstraint")
	constraint.MinSize = minSize
	constraint.MaxSize = maxSize
	constraint.Parent  = root

	local fit = Instance.new("UIScale")
	fit.Name   = FIT_SCALE_NAME
	fit.Parent = root

	if parent:IsA("LayerCollector") then
		local screen = parent :: LayerCollector
		local function refit()
			-- AbsoluteSize sind echte Pixel; die globale UiScale (>= 1) rechnet
			-- sie in Oberflaechen-Einheiten um, in denen minSize gemeint ist.
			local global = screen:FindFirstChild("GlobalScale")
			local globalScale = if global and global:IsA("UIScale") then math.max(global.Scale, 0.01) else 1
			local room = screen.AbsoluteSize / globalScale * DIALOG_SCREEN_FILL
			if room.X <= 0 or room.Y <= 0 then return end
			fit.Scale = math.min(1, room.X / minSize.X, room.Y / minSize.Y)
		end
		screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
		-- Die globale UiScale kann nach dem Dialog angelegt werden (Main) und
		-- aendert sich mit der Fenstergroesse.
		screen.ChildAdded:Connect(function(child)
			if child.Name == "GlobalScale" and child:IsA("UIScale") then
				child:GetPropertyChangedSignal("Scale"):Connect(refit)
				refit()
			end
		end)
		local global = screen:FindFirstChild("GlobalScale")
		if global and global:IsA("UIScale") then
			global:GetPropertyChangedSignal("Scale"):Connect(refit)
		end
		refit()
	end

	return root
end

-- Gesamter Verkleinerungsfaktor der Dialoge, in denen `gui` steckt (1 = keiner).
-- Fuer Code, der AbsolutePosition/AbsoluteSize in eine Position INNERHALB eines
-- Dialogs zurueckrechnet (IndexView): erst UiScale.toGui, dann durch diesen Wert.
function Theme.dialogScale(gui: Instance): number
	local factor = 1
	local node: Instance? = gui
	while node do
		local fit = node:FindFirstChild(FIT_SCALE_NAME)
		if fit and fit:IsA("UIScale") then
			factor *= fit.Scale
		end
		node = node.Parent
	end
	return factor
end

-- Sammel-Update 2.1: der eine Schliessen-Knopf fuer alle Fenster (oben
-- rechts, gross genug zum Tippen). Fenster ohne dialogHeader (Baerchi-Karte)
-- setzen ihn direkt. `color` optional (Gebaeude-Menue: Ton seiner Farbe).
-- UI-Qualitaet: dazu eine unsichtbare Trefferflaeche (CLOSE_HIT) als Kind —
-- sie liegt ueber dem Knopf (ZIndexBehavior.Sibling) und nimmt jeden Klick in
-- ihrem Bereich an, auch knapp neben dem sichtbaren X.
function Theme.closeButton(parent: Instance, onClose: () -> (), color: Color3?): TextButton
	local close = Theme.button("Close", parent, "X", color or Theme.COLORS.bad)
	close.AnchorPoint = Vector2.new(1, 0.5)
	close.Position    = UDim2.new(1, 4, 0.5, 0)
	close.Size        = UDim2.new(0, 44, 0, 40)
	close.TextColor3  = Theme.COLORS.text
	close.ZIndex      = math.max(close.ZIndex, 12)
	close.Activated:Connect(onClose)

	local hit = Instance.new("TextButton")
	hit.Name                   = "CloseHit"
	hit.AnchorPoint            = Vector2.new(0.5, 0.5)
	hit.Position               = UDim2.fromScale(0.5, 0.5)
	hit.Size                   = UDim2.fromOffset(CLOSE_HIT, CLOSE_HIT)
	hit.BackgroundTransparency = 1
	hit.Text                   = ""
	hit.AutoButtonColor        = false
	hit.ZIndex                 = close.ZIndex
	hit.Parent                 = close
	hit.Activated:Connect(onClose)

	return close
end

-- Kopfzeile eines Dialogs: Titel links, Schliessen-Kreuz rechts.
-- Gibt das Titel-Label zurueck, damit der Aufrufer es spaeter aendern kann.
function Theme.dialogHeader(root: Frame, title: string, onClose: () -> ()): TextLabel
	-- Farbiger Titelbalken hinter der Kopfzeile (zuerst gebaut, liegt darum
	-- unter Titel und Kreuz).
	local band = Instance.new("Frame")
	band.Name             = "TitleBand"
	band.Position         = UDim2.new(0, 6, 0, 5)
	band.Size             = UDim2.new(1, -12, 0, 42)
	band.BackgroundColor3 = Color3.fromRGB(122, 104, 204)
	band.BorderSizePixel  = 0
	band.Parent           = root
	Theme.corner(band, 12)
	Theme.stroke(band, Theme.COLORS.outline, 2)
	Theme.gradient(band, Color3.fromRGB(255, 255, 255), Color3.fromRGB(176, 170, 215))
	Theme.shine(band, 8).Size = UDim2.new(1, -12, 0.36, 0)

	local header = Theme.container("Header", root)
	header.Position = UDim2.new(0, 14, 0, 11)
	header.Size     = UDim2.new(1, -28, 0, 30)

	local label = Theme.label("Title", header, title)
	label.Size = UDim2.new(1, -52, 1, 0)
	Theme.outlineText(label, 2)

	-- Sammel-Update 2.1: groesserer X-Knopf (Tippflaeche ~44 px, Apple/
	-- Google-Empfehlung) — er ragt bewusst etwas ueber die Kopfzeile hinaus.
	Theme.closeButton(header, onClose)

	return label
end

-- Inhaltsflaeche unter der Kopfzeile.
function Theme.dialogBody(root: Frame): Frame
	local body = Theme.container("Body", root)
	body.Position = UDim2.new(0, 14, 0, 48)
	body.Size     = UDim2.new(1, -28, 1, -62)
	return body
end

--------------------------------------------------------------------------------
-- Theme.v2 — Tokens des neuen Looks (08.10., Paket D)
--------------------------------------------------------------------------------
-- Nur UI/Kit (und Panels, die Kit benutzen) lesen diese Tabelle. Alles oben
-- (COLORS, panel, button, dialog ...) bleibt unveraendert: die alten Panels
-- sehen genauso aus wie vorher. Wer die Palette tauschen will, aendert NUR
-- die Werte hier — kein Kit-Baustein hat eine eigene Farbe oder Zahl.
--
-- Richtung: warm und freundlich (Honig-Amber, Baerchi-Braun, Gummi-Pink,
-- Himmelblau), helle Creme-Flaechen mit dicker schokobrauner Kontur, Knoepfe
-- mit 3D-Kante und Glanz. Masse in Oberflaechen-Einheiten (die globale
-- UiScale vergroessert auf grossen Bildschirmen, 1080p ~ x1,27). 8er-Raster.
-- Kontraste (WCAG, gerechnet im Bericht): ink auf surface 11,6:1, inkSoft auf
-- card 6,5:1; weisse Knopfschrift traegt immer eine 3-px-Kontur (ink).
Theme.v2 = {
	color = {
		-- Flaechen
		surface     = Color3.fromRGB(255, 244, 220),   -- Panel-Koerper (Creme)
		surfaceDeep = Color3.fromRGB(246, 226, 190),   -- Verlauf unten
		card        = Color3.fromRGB(255, 252, 243),   -- Karte
		cardLocked  = Color3.fromRGB(236, 226, 210),   -- gesperrte Karte
		sunk        = Color3.fromRGB(240, 222, 190),   -- Balken-Spur, Chips
		shadow      = Color3.fromRGB( 59,  34,  18),   -- Schlagschatten

		-- Schrift und Kontur
		ink         = Color3.fromRGB( 74,  44,  23),   -- Text (Schokolade)
		inkSoft     = Color3.fromRGB(122,  84,  53),   -- Nebentext
		outline     = Color3.fromRGB( 59,  34,  18),   -- dicke Kontur
		white       = Color3.fromRGB(255, 255, 255),

		-- Marke
		honey       = Color3.fromRGB(255, 182,  39),
		honeyTop    = Color3.fromRGB(255, 214, 100),
		honeyBottom = Color3.fromRGB(255, 152,  24),
		bear        = Color3.fromRGB(156,  98,  51),
		gummy       = Color3.fromRGB(255,  92, 154),
		gummyDeep   = Color3.fromRGB(214,  51, 120),
		sky         = Color3.fromRGB( 76, 195, 255),
		skyDeep     = Color3.fromRGB( 22, 120, 190),

		-- Knopf-Arten
		go          = Color3.fromRGB( 72, 196,  70),   -- Primaer (Gratis-Start)
		goTop       = Color3.fromRGB(120, 230, 100),
		goEdge      = Color3.fromRGB( 30, 128,  44),   -- 3D-Kante unten
		quiet       = Color3.fromRGB(255, 248, 232),   -- Sekundaer (Skip): Creme
		quietEdge   = Color3.fromRGB(214, 190, 150),
		gold        = Color3.fromRGB(255, 222, 128),   -- Premium (Pass): ruhiges Gold
		goldTop     = Color3.fromRGB(255, 243, 200),
		goldEdge    = Color3.fromRGB(206, 150,  30),
		choose      = Color3.fromRGB( 76, 195, 255),   -- "Waehlen" auf der Karte
		chooseEdge  = Color3.fromRGB( 22, 120, 190),

		-- Zustaende
		active      = Color3.fromRGB(255, 196,  40),   -- "AKTIV"-Band
		new         = Color3.fromRGB(255,  92, 154),   -- "NEU"-Abzeichen
		lock        = Color3.fromRGB(150, 132, 112),
		progress    = Color3.fromRGB( 72, 196,  70),
	},
	radius = { panel = 26, card = 18, button = 16, chip = 999, badge = 14 },
	stroke = { panel = 4, card = 3, button = 3, text = 3, textSmall = 2 },
	space  = { xs = 4, s = 8, m = 16, l = 24, xl = 32 },
	text   = {
		font      = Enum.Font.FredokaOne,
		title     = 40,
		cardTitle = 26,
		number    = 30,
		body      = 18,
		small     = 15,   -- nie kleiner (1080p: ~19 px)
		button    = 26,
	},
	motion = {
		open      = 0.32,   -- Panel springt auf (Back)
		stagger   = 0.05,   -- Karten nacheinander
		cardIn    = 0.28,
		press     = 0.10,
		pulse     = 1.6,    -- Sekunden je Puls (nur der Gratis-Start)
		glimmer   = 2.6,    -- Glanz ueber freie neue Karten
		confetti  = 1.2,
	},
}

--------------------------------------------------------------------------------
-- Formatierung
--------------------------------------------------------------------------------

-- Grosse Zahlen lesbar machen: 1234567 → "1.234.567" (de/es), "1,234,567" (en),
-- "1 234 567" (fr). Das Trennzeichen kommt aus der Sprache des Spielers — die
-- Logik steht in Loc, damit Server-Texte und UI dieselbe Formatierung teilen.
-- Bleibt als Theme-Funktion bestehen, damit kein UI-Modul umgeschrieben werden
-- muss, das schon formatNumber benutzt.
function Theme.formatNumber(value: number): string
	return Loc.formatNumber(value)
end

-- Restzeiten: "45s", "2m 05s", "1h 12m" (Einheiten je nach Sprache)
function Theme.formatDuration(seconds: number): string
	return Loc.formatDuration(seconds)
end

return Theme
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX109"><Properties><string name="Name">TowerPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- TowerPanel.luau
-- StarterPlayerScripts/UI/TowerPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Das Tower-Fenster im neuen Look (08.10., Paket D, FeatureFlags.
--     TOWER_PANEL_V2): Tower waehlen (Karten mit Zustand AKTIV / WAEHLEN /
--     NEU / GESPERRT) und von hier aus losschicken (Einstiegsleiste mit
--     Gratis-Start, bezahltem Skip und Gamepass-Knopf).
--
-- Geoeffnet vom Tower-Terminal an der Bruecke (Hauptweg), vom Prompt an der
-- Arena, vom Antippen des Tower-Namens in der Pet-Leiste. Es meldet sich
-- unter dem Namen "Combat" an (PanelManager.ARENA_PANEL) — alle bisherigen
-- Wege zur Tower-Wahl landen damit hier. Lauf-Ergebnis- und Meilenstein-
-- Meldungen bleiben im CombatPanel (die laufen auch bei geschlossenem
-- Fenster).
--
-- Gebaut ausschliesslich aus UI/Kit (Tokens Theme.v2). Der Server prueft
-- alles selbst (offen? bezahlbar? Pass?); die Karten rechnen mit denselben
-- Funktionen aus TowerConfig nur fuer die Anzeige.
--
-- Hierarchie (Kinder 7-14): der Blick soll zuerst auf den GRATIS-Start
-- fallen — groesster Knopf, kraeftigste Farbe, als einziges Element mit Puls.
-- Der bezahlte Skip ist klein, cremefarben, ohne Glanz und Puls. Keine
-- falschen Countdowns, nichts versteckt.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types          = require(ReplicatedStorage.Network.Types)
local Remotes        = require(ReplicatedStorage.Network.Remotes)
local Loc            = require(ReplicatedStorage.Localization.Loc)
local TowerConfig    = require(ReplicatedStorage.Config.TowerConfig)
local GamepassConfig = require(ReplicatedStorage.Config.GamepassConfig)
local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)

local Theme           = require(script.Parent.Theme)
local Kit             = require(script.Parent.Kit)
local Icons           = require(script.Parent.Icons)
local Notify          = require(script.Parent.Notify)
local Moment          = require(script.Parent.Moment)
local Toast           = require(script.Parent.Toast)
local PanelManager    = require(script.Parent.PanelManager)
local PitResumeDialog = require(script.Parent.PitResumeDialog)
local ClientState     = require(script.Parent.Parent.Controllers.ClientState)

local TowerPanel = {}

local T = Kit.T
local PANEL_NAME = PanelManager.ARENA_PANEL   -- "Combat"
local PASS_KEY   = "SKIP_PASS"

-- Masse (Oberflaechen-Einheiten, 8er-Raster)
local DESIGN     = Vector2.new(640, 688)
local MIN_HEIGHT = 316   -- Kopf + eine Karte + Leiste (kompakt)
local HEADER_H   = 84
local STATUS_H   = 40
local FOOTER_H   = 140
-- Kompakt (niedrige Bildschirme, Handy quer): kleinerer Kopf, ohne
-- Statuszeile und ohne die erste Leisten-Zeile (Gummies stehen ohnehin im
-- HUD); die Liste scrollt. Ab dieser Fensterhoehe:
local COMPACT_BELOW = 520
local HEADER_H_COMPACT = 60
local FOOTER_H_COMPACT = 104
local CARD_H     = 116
local PAD        = T.space.m
local BADGE      = 80
local RIGHT_W    = 140
-- Freie Raender: oben HUD-Luft, unten Pet-Leiste (68 + Abstand), rechts
-- Menueleiste (Kacheln bis 94 + Rand), links etwas Luft. Auf kurzen
-- Bildschirmen (Handy quer) stehen HUD-Pillen und Menueleiste neben dem
-- Fenster: dort links/rechts mehr Platz lassen, oben weniger.
local function reserve(screen: Vector2): Kit.Reserve
	if screen.Y < COMPACT_BELOW then
		return { top = 6, bottom = 90, left = 196, right = 84 }
	end
	-- Schmalere Bildschirme (Tablet, 1366): links an den HUD-Pillen vorbei
	local left = if screen.X < 1400 then 196 else 12
	return { top = 12, bottom = 96, left = left, right = 112 }
end
local _compact = false

type CardView = {
	def      : TowerConfig.TowerDef,
	card     : Kit.Card,
	badge    : Frame,
	lockIcon : GuiObject,
	title    : TextLabel,
	progress : Kit.Progress,
	reward   : TextLabel,
	rewardIcon : Frame,
	choose   : Kit.Button,
	active   : Frame,
	newBadge : Frame,
	lockChip : Frame,
	lockBar  : Kit.Progress,
	glimmer  : Frame,
	state    : string,
}

local _window: Kit.Window? = nil
local _status: { selected: Frame, record: Frame, nextOpen: Frame }? = nil
local _list: ScrollingFrame? = nil
local _cards: { [string]: CardView } = {}
local _order: { string } = {}
local _footer: Frame? = nil
local _gummyChip: Frame? = nil
local _hint: TextLabel? = nil
local _primary: Kit.Button? = nil
local _skip: Kit.Button? = nil
local _premium: Kit.Button? = nil
local _freeBadge: Frame? = nil
local _stopPulse: (() -> ())? = nil
local _stopLoop: (() -> ())? = nil
local _isOpen = false
local _petState = "Home"

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function towerName(id: string): string
	return Loc.t("tower." .. id .. ".name")
end

local function hasPass(): boolean
	return Players.LocalPlayer:GetAttribute(GamepassConfig.attributeName(PASS_KEY)) == true
end

local function cardState(def: TowerConfig.TowerDef, data: Types.PlayerDataUpdate): string
	local towers = data.towers
	if not towers then return if def.id == TowerConfig.FIRST_TOWER then "active" else "locked" end
	local open = TowerConfig.isOpen(data.rebirthCount, def.id, towers.records, (towers :: any).unlocked)
	if not open then return "locked" end
	if towers.selected == def.id then return "active" end
	if TowerConfig.isNew(def.id, towers :: any) then return "new" end
	return "open"
end

-- Naechster Meilenstein als (Icon-Name, Rueckfall, Text) fuer die Karte.
local function rewardHint(def: TowerConfig.TowerDef, data: Types.PlayerDataUpdate): (string?, string?, string?)
	local towers = data.towers
	local record = if towers then towers.records[def.id] or 0 else 0
	local claimed = if towers then towers.claimed[def.id] else nil
	local stage = TowerConfig.nextMilestoneStage(def.id, claimed, record + 1)
	if not stage then return nil, nil, nil end
	local m = TowerConfig.getMilestone(def.id, stage)
	if not m then return nil, nil, nil end
	if m.eggs > 0 then
		return "egg", "🥚", Loc.t("ui.tower2.reward_egg", { stage = stage, n = m.eggs })
	elseif m.goldGummies > 0 then
		return "goldgummy", "$", Loc.t("ui.tower2.reward_amount", { stage = stage, n = Theme.formatNumber(m.goldGummies) })
	elseif m.endlessLevels > 0 then
		return "trophy", "★", Loc.t("ui.tower2.reward_endless", { stage = stage, n = m.endlessLevels })
	end
	return "gummy", "G", Loc.t("ui.tower2.reward_amount", { stage = stage, n = Theme.formatNumber(m.gummies) })
end

--------------------------------------------------------------------------------
-- Karte
--------------------------------------------------------------------------------

local function buildCard(parent: Instance, def: TowerConfig.TowerDef, order: number): CardView
	local card = Kit.card("Tower_" .. def.id, parent, CARD_H)
	card.holder.LayoutOrder = order
	local face = card.face
	local endless = def.id == "Endless"
	if endless then
		-- Endless: besondere Karte in Rosa/Lila
		Kit.gradient(face, Color3.fromRGB(255, 236, 248), Color3.fromRGB(240, 214, 255))
	end

	local badge = Kit.towerBadge("Badge", face, def.look, def.color, def.numeral, BADGE)
	badge.AnchorPoint = Vector2.new(0, 0.5)
	badge.Position = UDim2.new(0, 14, 0.5, -1)

	local lockIcon = Kit.lockIcon(badge, 34)
	lockIcon.AnchorPoint = Vector2.new(1, 1)
	lockIcon.Position = UDim2.new(1, 8, 1, 8)
	lockIcon.ZIndex = 38

	local left = 14 + BADGE + 14
	local title = Kit.text("Title", face, towerName(def.id), T.text.cardTitle)
	title.Position = UDim2.fromOffset(left, 10)
	title.Size = UDim2.new(1, -(left + RIGHT_W + 12), 0, 30)
	title.ZIndex = 32

	local progress = Kit.progress("Record", face, 26)
	progress.track.Position = UDim2.fromOffset(left, 46)
	progress.track.Size = UDim2.new(1, -(left + RIGHT_W + 16), 0, 26)

	local rewardIcon = Kit.frame("RewardIcon", face)
	rewardIcon.Position = UDim2.fromOffset(left, 80)
	rewardIcon.Size = UDim2.fromOffset(24, 24)
	rewardIcon.ZIndex = 32
	local reward = Kit.text("Reward", face, "", T.text.small + 1, { color = T.color.inkSoft })
	reward.Position = UDim2.fromOffset(left + 30, 80)
	reward.Size = UDim2.new(1, -(left + 30 + RIGHT_W + 12), 0, 24)
	reward.ZIndex = 32

	-- Rechts: Waehlen-Knopf ...
	local choose = Kit.button("Choose", face, "choose", Loc.t("ui.tower2.choose"), 24)
	choose.button.AnchorPoint = Vector2.new(1, 0.5)
	choose.button.Position = UDim2.new(1, -14, 0.5, 0)
	choose.button.Size = UDim2.fromOffset(RIGHT_W - 8, 64)
	choose.button.Activated:Connect(function()
		if not choose.button.Active then return end
		Kit.playSound("select")
		Remotes.RequestSelectTower:FireServer(def.id)
	end)

	-- ... oder AKTIV-Band ...
	local active = Kit.badge("Active", face, Loc.t("ui.tower2.active"), T.color.active, 0)
	active.AnchorPoint = Vector2.new(1, 0.5)
	active.Position = UDim2.new(1, -18, 0.5, 0)
	active.Size = UDim2.fromOffset(0, 40)
	local activeLabel = active:FindFirstChild("Text") :: TextLabel
	activeLabel.TextSize = 22

	-- ... oder Fortschritt zur Freischaltung
	local lockChip = Kit.frame("LockInfo", face)
	lockChip.AnchorPoint = Vector2.new(1, 0.5)
	lockChip.Position = UDim2.new(1, -14, 0.5, 0)
	lockChip.Size = UDim2.fromOffset(RIGHT_W, 68)
	lockChip.ZIndex = 32
	local lockText = Kit.text("Text", lockChip, "", T.text.small + 1, { color = T.color.ink, align = Enum.TextXAlignment.Center, wrap = true })
	lockText.Size = UDim2.new(1, 0, 0, 36)
	lockText.ZIndex = 33
	local lockBar = Kit.progress("Bar", lockChip, 24, T.color.honey)
	lockBar.track.Position = UDim2.fromOffset(0, 40)

	-- NEU-Aufkleber oben links (schraeg) und Glanz fuer frisch freie Karten
	local newBadge = Kit.badge("New", card.holder, Loc.t("ui.tower2.new"), T.color.new, -10)
	newBadge.Position = UDim2.fromOffset(46, 4)
	newBadge.ZIndex = 45
	local newLabel = newBadge:FindFirstChild("Text") :: TextLabel
	newLabel.ZIndex = 46

	local glimmer = Kit.frame("Glimmer", face, T.color.white)
	glimmer.Size = UDim2.new(0.22, 0, 1, 0)
	glimmer.Rotation = 18
	glimmer.BackgroundTransparency = 0.6
	glimmer.ZIndex = 31
	glimmer.Visible = false
	local glimmerFade = Instance.new("UIGradient")
	glimmerFade.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1),
	})
	glimmerFade.Parent = glimmer
	face.ClipsDescendants = false

	return {
		def = def, card = card, badge = badge, lockIcon = lockIcon, title = title,
		progress = progress, reward = reward, rewardIcon = rewardIcon, choose = choose,
		active = active, newBadge = newBadge, lockChip = lockChip, lockBar = lockBar,
		glimmer = glimmer, state = "",
	}
end

local function refreshCard(view: CardView, data: Types.PlayerDataUpdate)
	local def = view.def
	local towers = data.towers
	local state = cardState(def, data)
	view.state = state
	local record = if towers then towers.records[def.id] or 0 else 0
	local endless = def.id == "Endless"

	view.title.Text = if endless
		then towerName(def.id)
		else Loc.t("ui.tower2.title_stages", { tower = towerName(def.id), stages = def.stages })

	local locked = state == "locked"
	view.lockIcon.Visible = locked
	view.choose.button.Visible = state == "open" or state == "new"
	view.active.Visible = state == "active"
	view.newBadge.Visible = state == "new"
	view.lockChip.Visible = locked
	view.glimmer.Visible = state == "new"

	-- Rekord-Balken (Endless: ohne Ende, Balken zeigt das naechste Zehnerziel)
	if endless then
		local goal = math.max(10, (math.floor(record / 10) + 1) * 10)
		view.progress.set(record / goal, Loc.t("ui.tower2.record_endless", { record = record }))
	else
		view.progress.set(record / def.stages, Loc.t("ui.tower2.record", { record = record, stages = def.stages }))
	end
	view.progress.track.Visible = not locked or record > 0

	-- Meilenstein
	for _, child in view.rewardIcon:GetChildren() do child:Destroy() end
	local iconName, fallback, text = rewardHint(def, data)
	if iconName and text and not locked then
		local icon = Icons.make(view.rewardIcon, iconName, fallback)
		icon.Size = UDim2.fromScale(1, 1)
		icon.ZIndex = 33
		view.reward.Text = text
		view.reward.Visible = true
	else
		view.reward.Visible = locked
		view.reward.Text = if locked then "🔒 " .. Loc.t("ui.tower2.locked_hint") else ""
	end
	-- Gesperrt: Hinweis in die Mitte der Karte (dort stuende sonst der Balken)
	view.reward.Position = UDim2.fromOffset(14 + BADGE + 14 + (if locked then 0 else 30), if locked then 48 else 80)

	-- Gesperrt: gedaempft, aber lesbar
	if locked then
		local prev, have, need = TowerConfig.getUnlockProgress(def.id, if towers then towers.records else nil)
		local lockText = view.lockChip:FindFirstChild("Text") :: TextLabel
		lockText.Text = if prev
			then Loc.t("ui.tower2.unlock_by", { tower = towerName(prev) })
			else ""
		view.lockBar.set(if need > 0 then have / need else 0, string.format("%d/%d", have, need))
		Kit.gradient(view.card.face, T.color.cardLocked, T.color.sunk)
		Kit.gradient(view.badge, Theme.shade(def.color, 0.1):Lerp(T.color.lock, 0.6), T.color.lock)
	else
		if endless then
			Kit.gradient(view.card.face, Color3.fromRGB(255, 236, 248), Color3.fromRGB(240, 214, 255))
		else
			Kit.gradient(view.card.face, T.color.card, T.color.surface)
		end
		Kit.gradient(view.badge, Theme.shade(def.color, 0.35), Theme.shade(def.color, -0.12))
	end

	view.card.stroke.Color = if state == "active" then T.color.honeyBottom else T.color.outline
	view.card.stroke.Thickness = if state == "active" then T.stroke.card + 2 else T.stroke.card
	view.choose.label.Text = Loc.t("ui.tower2.choose")
	view.choose.setEnabled(true)
	local activeLabel = view.active:FindFirstChild("Text")
	if activeLabel and activeLabel:IsA("TextLabel") then activeLabel.Text = "✔ " .. Loc.t("ui.tower2.active") end
	local newLabel = view.newBadge:FindFirstChild("Text")
	if newLabel and newLabel:IsA("TextLabel") then newLabel.Text = Loc.t("ui.tower2.new") end
end

--------------------------------------------------------------------------------
-- Status und Einstiegsleiste
--------------------------------------------------------------------------------

local function refreshStatus(data: Types.PlayerDataUpdate)
	local status = _status
	if not status then return end
	local towers = data.towers
	local selected = if towers then towers.selected else TowerConfig.FIRST_TOWER
	local def = TowerConfig.get(selected) or TowerConfig.TOWERS[1]
	local record = if towers then towers.records[selected] or 0 else 0
	Kit.setChip(status.selected, Loc.t("ui.tower2.status_selected", { tower = towerName(selected) }))
	Kit.setChip(status.record, if def.id == "Endless"
		then Loc.t("ui.tower2.record_endless", { record = record })
		else Loc.t("ui.tower2.record", { record = record, stages = def.stages }))
	-- Naechste Freischaltung
	local nextText = Loc.t("ui.tower2.status_all_open")
	for _, other in TowerConfig.TOWERS do
		if not TowerConfig.isOpen(data.rebirthCount, other.id, if towers then towers.records else nil, if towers then (towers :: any).unlocked else nil) then
			local prev, have, need = TowerConfig.getUnlockProgress(other.id, if towers then towers.records else nil)
			if prev then
				nextText = Loc.t("ui.tower2.status_next", { tower = towerName(other.id), have = have, need = need })
			end
			break
		end
	end
	Kit.setChip(status.nextOpen, nextText)
end

-- Ordnet die Einstiegsleiste je nach Lage: mit/ohne gespeichertem Lauf,
-- mit/ohne Pass. Primaer ist immer der breiteste Knopf.
local function layoutFooter(showSkip: boolean, passOwned: boolean, footerWidth: number)
	local primary, skip, premium = _primary, _skip, _premium
	if not primary or not skip or not premium then return end
	local gap = T.space.s
	local inner = footerWidth - PAD * 2
	if passOwned and showSkip then
		-- Pass: Skip und Pass verschmelzen zu EINEM goldenen Knopf
		skip.button.Visible = false
		premium.button.Visible = true
		local w = math.floor(inner * 0.42)
		primary.button.Size = UDim2.fromOffset(inner - w - gap, 76)
		premium.button.Size = UDim2.fromOffset(w, 64)
		premium.button.Position = UDim2.new(0, PAD + inner - w, 1, -PAD - 64)
	elseif showSkip then
		skip.button.Visible = true
		premium.button.Visible = true
		local wSkip, wPrem = 160, 148
		primary.button.Size = UDim2.fromOffset(inner - wSkip - wPrem - gap * 2, 76)
		skip.button.Size = UDim2.fromOffset(wSkip, 64)
		skip.button.Position = UDim2.new(0, PAD + inner - wSkip - wPrem - gap, 1, -PAD - 64)
		premium.button.Size = UDim2.fromOffset(wPrem, 64)
		premium.button.Position = UDim2.new(0, PAD + inner - wPrem, 1, -PAD - 64)
	else
		skip.button.Visible = false
		premium.button.Visible = true
		local wPrem = 148
		primary.button.Size = UDim2.fromOffset(inner - wPrem - gap, 76)
		premium.button.Size = UDim2.fromOffset(wPrem, 64)
		premium.button.Position = UDim2.new(0, PAD + inner - wPrem, 1, -PAD - 64)
	end
	primary.button.Position = UDim2.new(0, PAD, 1, -PAD - 76)
end

local function refreshFooter(data: Types.PlayerDataUpdate)
	local primary, skip, premium, gummyChip, hint = _primary, _skip, _premium, _gummyChip, _hint
	local window = _window
	if not primary or not skip or not premium or not gummyChip or not hint or not window then return end

	Kit.setChip(gummyChip, Theme.formatNumber(data.gummies))

	local running = _petState == "ToPit" or _petState == "InPit"
	local reached = PitResumeDialog.getProgress(data)
	local showSkip = reached ~= nil and reached > 1 and not running
	local stage, price = 1, 0
	if showSkip then
		stage, price = PitResumeDialog.offer(data, "Last")
	end
	local passOwned = hasPass()
	local passReady = GamepassConfig.isReady(PASS_KEY)

	-- Primaer: Gratis-Start (die tatsaechliche freie Stage: immer 1,
	-- Entscheidung 05.10.)
	primary.label.Text = if running then Loc.t("ui.tower2.running") else Loc.t("ui.tower2.start")
	primary.sub.Text = if running then "" else Loc.t("ui.tower2.start_sub", { stage = 1 })
	primary.sub.Visible = not running
	primary.label.Size = UDim2.new(1, -20, 0, 34)
	primary.label.Position = UDim2.new(0.5, 0, 0, if running then 22 else 8)
	primary.label.AnchorPoint = Vector2.new(0.5, 0)
	primary.setEnabled(not running)
	if _freeBadge then _freeBadge.Visible = not running end

	-- Sekundaer: bezahlter Einstieg ab der letzten Stage
	skip.label.Text = Loc.t("ui.tower2.skip", { stage = stage })
	skip.sub.Text = Loc.t("ui.tower2.price", { price = Kit.formatCompact(price) })
	skip.sub.Visible = true
	skip.setEnabled(price <= data.gummies)

	-- Premium / Pass
	if passOwned and showSkip then
		premium.label.Text = Loc.t("ui.tower2.skip", { stage = stage })
		premium.sub.Text = Loc.t("ui.tower2.pass_free")
		premium.setEnabled(true)
	else
		premium.label.Text = "👑 " .. Loc.t("ui.pass.skip.name")
		premium.sub.Text = if passOwned then Loc.t("ui.tower2.pass_owned")
			elseif passReady then Loc.t("ui.tower2.pass_buy")
			else Loc.t("ui.pass.soon")
		premium.setEnabled(not passOwned)
	end
	premium.sub.Visible = true

	hint.Text = if running then Loc.t("ui.tower2.hint_running") else Loc.t("ui.tower2.hint_free")

	local size = window.root.Size
	layoutFooter(showSkip, passOwned, size.X.Offset)
end

function TowerPanel.refresh()
	if not _isOpen then return end
	local data = ClientState.get()
	if not data then return end
	refreshStatus(data)
	for _, view in _cards do
		refreshCard(view, data)
	end
	refreshFooter(data)
end

--------------------------------------------------------------------------------
-- Bewegung (eine Schleife, solange das Fenster offen ist)
--------------------------------------------------------------------------------

local function startLoop()
	if _stopLoop then return end
	local t0 = os.clock()
	_stopLoop = Kit.animate(function(now)
		local t = now - t0
		-- Glanz ueber neue Karten (sanft, alle ~2,6 s)
		local phase = (t % T.motion.glimmer) / T.motion.glimmer
		for _, view in _cards do
			if view.glimmer.Visible then
				view.glimmer.Position = UDim2.new(-0.3 + phase * 1.6, 0, 0, 0)
				view.glimmer.BackgroundTransparency = 0.55 + 0.45 * math.abs(phase - 0.5) * 2
			end
			if view.newBadge.Visible then
				view.newBadge.Rotation = -10 + math.sin(t * 4) * 4
			end
		end
		return true
	end)
end

local function stopLoop()
	if _stopLoop then _stopLoop() end
	_stopLoop = nil
	if _stopPulse then _stopPulse() end
	_stopPulse = nil
end

-- Karten laufen gestaffelt ein (von rechts, leicht vergroessert)
local function staggerCards()
	for index, id in _order do
		local view = _cards[id]
		local face = view.card.face
		face.Position = UDim2.fromOffset(4 + 40, 0)
		local delay = (index - 1) * T.motion.stagger
		task.delay(delay, function()
			if not _isOpen then
				face.Position = UDim2.fromOffset(4, 0)
				return
			end
			Kit.tween(face, T.motion.cardIn, { Position = UDim2.fromOffset(4, 0) }, Enum.EasingStyle.Back)
		end)
	end
end

local function scrollToSelected()
	local list, data = _list, ClientState.get()
	if not list or not data or not data.towers then return end
	local index = table.find(_order, data.towers.selected) or 1
	local y = math.max(0, (index - 2) * (CARD_H + T.space.s))
	list.CanvasPosition = Vector2.new(0, y)
end

--------------------------------------------------------------------------------
-- Oeffnen / Schliessen
--------------------------------------------------------------------------------

local function openInternal(...: any)
	local window = _window
	if not window then return end
	local refit = (window :: any).refit
	if refit then refit() end
	window.root.Visible = true
	_isOpen = true
	TowerPanel.refresh()
	scrollToSelected()
	Kit.popIn(window)
	staggerCards()
	startLoop()
	local primary = _primary
	if primary and not _stopPulse then
		_stopPulse = Kit.pulse(primary.face, 0.05)
	end
end

local function closeInternal()
	local window = _window
	if window then window.root.Visible = false end
	_isOpen = false
	stopLoop()
end

function TowerPanel.isOpen(): boolean
	return _isOpen
end

-- Fuer die Fuehrung (GuideController): der Waehlen-Knopf des ersten neuen Towers.
function TowerPanel.getGuideTarget(): GuiObject?
	if not _isOpen then return nil end
	for _, id in _order do
		local view = _cards[id]
		if view.state == "new" then
			return view.choose.button
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Freischalt-Moment
--------------------------------------------------------------------------------

local function onUnlocked(towerId: string)
	local def = TowerConfig.get(towerId)
	if not def then return end
	Kit.playSound("unlock")
	Notify.emit("tower_unlocked", function()
		Toast.success(Loc.t("msg.tower_unlocked", { tower = towerName(towerId) }))
	end, function()
		Moment.show("tower_unlocked", def.color, "ui.moment.tower_unlocked")
	end)
	local view = _cards[towerId]
	local window = _window
	if _isOpen and view and window then
		TowerPanel.refresh()
		local face = view.card.face
		local rel = face.AbsolutePosition - window.body.AbsolutePosition
		-- AbsolutePosition sind Pixel; der Koerper ist mit FitScale und der
		-- globalen UiScale skaliert — fuer das Konfetti grob zurueckrechnen.
		local scale = window.body.AbsoluteSize.X / math.max(1, window.root.Size.X.Offset)
		Kit.confetti(window.content, Vector2.new(rel.X / scale + 60, rel.Y / scale + 40), 26)
	end
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function TowerPanel.init(screenGui: ScreenGui)
	if not FeatureFlags.isOn("TOWER_PANEL_V2") then return end

	local window = Kit.window("TowerPanel", screenGui, {
		design = DESIGN, minHeight = MIN_HEIGHT, reserve = reserve,
	})
	_window = window
	Kit.mascot(window, 74)
	local title = Kit.header(window, Loc.t("ui.tower.title"), HEADER_H)
	Loc.bind(title, "ui.tower.title")
	Kit.closeButton(window, function()
		PanelManager.close(PANEL_NAME)
	end)

	local content = window.content

	-- Statuszeile
	local statusRow = Kit.frame("Status", content)
	statusRow.Position = UDim2.fromOffset(PAD, HEADER_H + 10)
	statusRow.Size = UDim2.new(1, -PAD * 2, 0, STATUS_H - 8)
	statusRow.ZIndex = 30
	local statusLayout = Instance.new("UIListLayout")
	statusLayout.FillDirection = Enum.FillDirection.Horizontal
	statusLayout.Padding = UDim.new(0, T.space.s)
	statusLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	statusLayout.SortOrder = Enum.SortOrder.LayoutOrder
	statusLayout.Parent = statusRow
	local selectedChip = Kit.chip("Selected", statusRow, "", T.color.honeyTop)
	selectedChip.LayoutOrder = 1
	local recordChip = Kit.chip("Record", statusRow, "")
	recordChip.LayoutOrder = 2
	local nextChip = Kit.chip("Next", statusRow, "")
	nextChip.LayoutOrder = 3
	_status = { selected = selectedChip, record = recordChip, nextOpen = nextChip }

	-- Kartenliste
	local list = Kit.scroller("List", content)
	_list = list
	local listPad = Instance.new("UIPadding")
	listPad.PaddingTop = UDim.new(0, 14)   -- Platz fuer den NEU-Aufkleber
	listPad.PaddingRight = UDim.new(0, 10)
	listPad.Parent = list
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, T.space.s + 2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	for order, def in TowerConfig.TOWERS do
		_cards[def.id] = buildCard(list, def, order)
		table.insert(_order, def.id)
	end

	-- Einstiegsleiste
	local footer = Kit.frame("Footer", content, T.color.white)
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Position = UDim2.fromScale(0, 1)
	footer.Size = UDim2.new(1, 0, 0, FOOTER_H)
	footer.ZIndex = 31
	Kit.corner(footer, T.radius.panel)
	Kit.gradient(footer, T.color.surfaceDeep, Theme.shade(T.color.surfaceDeep, -0.06))
	_footer = footer
	local footerTop = Kit.frame("FooterTop", footer, T.color.white)
	footerTop.Size = UDim2.new(1, 0, 0, T.radius.panel)
	footerTop.ZIndex = 31
	Kit.gradient(footerTop, T.color.surfaceDeep, T.color.surfaceDeep)
	local footerLine = Kit.frame("FooterLine", footer, T.color.outline)
	footerLine.Size = UDim2.new(1, 0, 0, T.stroke.card)
	footerLine.ZIndex = 32

	-- Zeile 1: Gummy-Stand und ein ehrlicher Satz zum Gratis-Start
	local gummyChip = Kit.chip("Gummies", footer, "0", T.color.white)
	gummyChip.Position = UDim2.fromOffset(PAD, 10)
	-- Icon links in der Pille (die Polsterung macht ihm Platz)
	local gummyPad = gummyChip:FindFirstChildOfClass("UIPadding")
	if gummyPad then gummyPad.PaddingLeft = UDim.new(0, 36) end
	local gummyIcon = Icons.make(gummyChip, "gummy", "G")
	gummyIcon.Size = UDim2.fromOffset(28, 28)
	gummyIcon.AnchorPoint = Vector2.new(0, 0.5)
	gummyIcon.Position = UDim2.new(0, -32, 0.5, 0)
	gummyIcon.ZIndex = 34
	_gummyChip = gummyChip

	local hint = Kit.text("Hint", footer, "", T.text.small, { color = T.color.inkSoft, align = Enum.TextXAlignment.Right })
	hint.AnchorPoint = Vector2.new(1, 0)
	hint.Position = UDim2.new(1, -PAD, 0, 10)
	hint.Size = UDim2.new(0.6, 0, 0, 30)
	hint.ZIndex = 33
	_hint = hint

	-- Zeile 2: die drei Einstiege
	local primary = Kit.button("Start", footer, "primary", Loc.t("ui.tower2.start"), 30)
	primary.sub.Visible = true
	primary.sub.Size = UDim2.new(1, -20, 0, 20)
	primary.button.Activated:Connect(function()
		if not primary.button.Active then return end
		Kit.playSound("click")
		Remotes.RequestPetMode:FireServer("Fight", "Fresh")
		PanelManager.close(PANEL_NAME)
	end)
	_primary = primary
	local freeBadge = Kit.badge("Free", primary.button, Loc.t("ui.tower2.free"), T.color.gummy, 8)
	-- Oben rechts INNERHALB des Knopfs: links steht die Gummy-Pille, rechts
	-- daneben der naechste Knopf, in der Mitte die Beschriftung.
	freeBadge.AnchorPoint = Vector2.new(1, 0.5)
	freeBadge.Position = UDim2.new(1, -10, 0, 2)
	freeBadge.ZIndex = 44
	local freeLabel = freeBadge:FindFirstChild("Text") :: TextLabel
	freeLabel.ZIndex = 45
	_freeBadge = freeBadge

	local skip = Kit.button("Skip", footer, "secondary", "", 20)
	skip.label.Size = UDim2.new(1, -12, 0, 24)
	skip.label.AnchorPoint = Vector2.new(0.5, 0)
	skip.label.Position = UDim2.new(0.5, 0, 0, 6)
	skip.sub.Size = UDim2.new(1, -12, 0, 20)
	skip.button.Activated:Connect(function()
		if not skip.button.Active then return end
		Kit.playSound("click")
		Remotes.RequestPetMode:FireServer("Fight", "Last")
		PanelManager.close(PANEL_NAME)
	end)
	_skip = skip

	local premium = Kit.button("Pass", footer, "premium", "", 20)
	premium.label.Size = UDim2.new(1, -12, 0, 24)
	premium.label.AnchorPoint = Vector2.new(0.5, 0)
	premium.label.Position = UDim2.new(0.5, 0, 0, 6)
	premium.sub.Size = UDim2.new(1, -12, 0, 20)
	premium.button.Activated:Connect(function()
		if not premium.button.Active then return end
		Kit.playSound("click")
		if hasPass() then
			-- Mit Pass ist das der Gratis-Skip (der Server rechnet 0)
			Remotes.RequestPetMode:FireServer("Fight", "Last")
			PanelManager.close(PANEL_NAME)
		elseif GamepassConfig.isReady(PASS_KEY) then
			Remotes.RequestBuyGamepass:FireServer(PASS_KEY)
		else
			-- "Bald": kurzer Wackler statt eines Kaufs
			local face = premium.face
			Kit.tween(face, 0.06, { Rotation = 3 })
			task.delay(0.07, function() Kit.tween(face, 0.12, { Rotation = 0 }, Enum.EasingStyle.Back) end)
		end
	end)
	_premium = premium

	-- Groesse: Liste fuellt den Platz zwischen Status und Leiste; auf
	-- niedrigen Fenstern die kompakte Anordnung.
	window.setSize = function(size: Vector2)
		_compact = size.Y < COMPACT_BELOW
		local headerH = if _compact then HEADER_H_COMPACT else HEADER_H
		local statusH = if _compact then 0 else STATUS_H
		local footerH = if _compact then FOOTER_H_COMPACT else FOOTER_H
		local band = window.header
		if band then band.Size = UDim2.new(1, 0, 0, headerH) end
		statusRow.Visible = not _compact
		footer.Size = UDim2.new(1, 0, 0, footerH)
		gummyChip.Visible = not _compact
		hint.Visible = not _compact
		list.Position = UDim2.fromOffset(PAD, headerH + statusH + 4)
		list.Size = UDim2.new(1, -PAD * 2 + 10, 0, math.max(CARD_H * 0.6, size.Y - headerH - statusH - footerH - 8))
		if _isOpen then TowerPanel.refresh() end
	end

	PanelManager.register(PANEL_NAME, { open = openInternal, close = closeInternal })

	ClientState.onChanged(function() TowerPanel.refresh() end)
	Loc.onChanged(function() TowerPanel.refresh() end)
	Players.LocalPlayer:GetAttributeChangedSignal(GamepassConfig.attributeName(PASS_KEY)):Connect(function()
		TowerPanel.refresh()
	end)
	Remotes.PetModeChanged.OnClientEvent:Connect(function(state: any)
		_petState = if typeof(state) == "string" then state else "Home"
		TowerPanel.refresh()
	end)
	Remotes.TowerUnlocked.OnClientEvent:Connect(function(towerId: any)
		if typeof(towerId) == "string" then onUnlocked(towerId) end
	end)

	print("[TowerPanel] Initialisiert |", #_order, "Tower")
end

return TowerPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX110"><Properties><string name="Name">UpgradeFX</string><ProtectedString name="Source"><![CDATA[--!strict
-- UpgradeFX.luau
-- StarterPlayerScripts/UI/UpgradeFX.luau
--
-- Einzige Zustaendigkeit:
--   - Der Erfolgs-Moment nach einem BESTAETIGTEN Ausbau (Paket G, 08.10.):
--     das Gebaeude springt kurz auf, Funken in seiner Farbe steigen auf,
--     "Level 7 ➜ 8" schwebt hoch, ein kurzer Klang, und der bezahlte Betrag
--     fliegt aus der Gummy-Pille zum Gebaeude (Feedback.spend). Beim
--     Look-Wechsel (Level 10/20/30/45/60) die grosse Variante.
--
-- Ausgeloest wird NUR aus dem Datenstand (ClientState): steigt das Level des
-- Honig-Brunnens bzw. eines Gebaeudes oder des Recyclers, hat der Server den
-- Kauf schon gebucht. Nie spekulativ beim Tastendruck — ein abgelehnter Kauf
-- (zu wenig Gummies) zeigt nur die Ablehnung (ActionFailed), keinen Effekt.
-- Egal ob ueber den Prompt (E) oder ein Menue ausgebaut wurde: es sieht
-- gleich aus.
--
-- Leistung: EINE Heartbeat-Schleife fuer alle laufenden Effekte, kein Thread
-- und kein Tween pro Effekt; je Effekt ein unsichtbarer Anker-Teil mit EINEM
-- Emitter und EINEM BillboardGui, nach <= 1,2 s wieder weg. Die Gebaeude-Teile
-- werden nur lokal skaliert und danach exakt auf ihren Stand zurueckgesetzt.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local FeedbackConfig   = require(ReplicatedStorage.Config.FeedbackConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local CombConfig       = require(ReplicatedStorage.Config.CombConfig)
local MapConfig        = require(ReplicatedStorage.Config.MapConfig)

local Theme       = require(script.Parent.Theme)
local Kit         = require(script.Parent.Kit)
local Feedback    = require(script.Parent.Feedback)
local ClientState = require(script.Parent.Parent.Controllers.ClientState)

local UpgradeFX = {}

local FX = FeedbackConfig.UPGRADE_FX
local OWNER_ATTRIBUTE = "PlotOwner"
local RECYCLER_KEY = "Recycler"
local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"

type PartState = { part: BasePart, cframe: CFrame, size: Vector3 }

type Job = {
	key      : string,       -- BuildingId oder "Recycler"
	from     : number,
	to       : number,
	big      : boolean,      -- Look-Wechsel
	t0       : number,       -- Start (os.clock); bis dahin wird auf den Neubau gewartet
	waitLook : number?,      -- Look, auf den gewartet wird (nil = sofort)
	started  : boolean,
	parts    : { PartState },
	origin   : CFrame,
	anchor   : BasePart?,
	label    : TextLabel?,
	gui      : BillboardGui?,
	popDone  : boolean,
}

local _jobs: { Job } = {}
local _last: { [string]: number }? = nil

--------------------------------------------------------------------------------
-- Welt
--------------------------------------------------------------------------------

local function ownPlot(): Instance?
	local userId = Players.LocalPlayer.UserId
	for _, child in Workspace:GetChildren() do
		if child:IsA("Model") and child:GetAttribute(OWNER_ATTRIBUTE) == userId then
			return child
		end
	end
	return nil
end

local function findBody(key: string): BasePart?
	local plot = ownPlot()
	if not plot then return nil end
	local name = if key == RECYCLER_KEY then CombConfig.RECYCLER_NAME else key
	local body = plot:FindFirstChild(name)
	return if body and body:IsA("BasePart") then body else nil
end

local function colorFor(key: string): Color3
	if key == RECYCLER_KEY then
		return Color3.fromRGB(120, 230, 140)
	end
	local def = MapConfig.BUILDING_OFFSETS[key]
	return if def then def.color else Theme.COLORS.goldGummy
end

--------------------------------------------------------------------------------
-- Effekt-Teile
--------------------------------------------------------------------------------

local function easeOut(t: number): number
	return 1 - (1 - t) * (1 - t)
end

-- Skalierung ueber die Zeit: schnell auf `peak`, dann gedaempft zurueck
-- (kurzes Unterschwingen wie eine Feder).
local function popScale(t: number, peak: number): number
	if t <= 0 then return 1 end
	if t >= 1 then return 1 end
	if t < 0.35 then
		return 1 + (peak - 1) * easeOut(t / 0.35)
	end
	local u = (t - 0.35) / 0.65
	return 1 + (peak - 1) * math.cos(u * math.pi * 1.5) * (1 - u)
end

local function startJob(job: Job, body: BasePart)
	job.started = true
	job.t0 = os.clock()

	-- Teile merken (nur die Deko, nicht der unsichtbare Koerper)
	local top = body.Position.Y
	for _, child in body:GetDescendants() do
		if child:IsA("BasePart") then
			table.insert(job.parts, { part = child, cframe = child.CFrame, size = child.Size })
			top = math.max(top, child.Position.Y + child.Size.Y * 0.5)
		end
	end
	job.origin = body.CFrame * CFrame.new(0, -body.Size.Y * 0.5, 0)

	-- Anker oben auf dem Gebaeude: Funken + Zahl
	local anchor = Instance.new("Part")
	anchor.Name         = "UpgradeFxAnchor"
	anchor.Anchored     = true
	anchor.CanCollide   = false
	anchor.CanQuery     = false
	anchor.CanTouch     = false
	anchor.CastShadow   = false
	anchor.Transparency = 1
	anchor.Size         = Vector3.new(1, 1, 1)
	anchor.CFrame       = CFrame.new(body.Position.X, top + 0.5, body.Position.Z)
	anchor.Parent       = Workspace.CurrentCamera or Workspace
	job.anchor = anchor

	local color = colorFor(job.key)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture       = SPARK_TEXTURE
	emitter.Color         = ColorSequence.new(Theme.shade(color, 0.35), color)
	emitter.LightEmission = 1
	emitter.Size          = NumberSequence.new({
		NumberSequenceKeypoint.new(0, if job.big then 1.4 else 1.0),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency  = NumberSequence.new(0.1, 1)
	emitter.Lifetime      = NumberRange.new(FX.SPARK_LIFETIME * 0.6, FX.SPARK_LIFETIME)
	emitter.Speed         = NumberRange.new(8, if job.big then 22 else 15)
	emitter.SpreadAngle   = Vector2.new(55, 55)
	emitter.Acceleration  = Vector3.new(0, 6, 0)
	emitter.Drag          = 3
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Rate          = 0
	emitter.Parent        = anchor
	emitter:Emit(if job.big then FX.SPARKS_BIG else FX.SPARKS)

	local size = if job.big then FX.NUMBER_SIZE_BIG else FX.NUMBER_SIZE
	local gui = Instance.new("BillboardGui")
	gui.Name           = "UpgradeFxNumber"
	gui.Size           = UDim2.fromOffset(size.X, size.Y)
	gui.AlwaysOnTop    = true
	gui.LightInfluence = 0
	gui.StudsOffset    = Vector3.new(0, 1, 0)
	gui.Adornee        = anchor
	gui.Parent         = anchor
	job.gui = gui

	local label = Theme.label("Text", gui, "")
	label.Size = UDim2.fromScale(1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextColor3 = if job.big then Theme.COLORS.goldGummy else Color3.new(1, 1, 1)
	local text = Loc.t("ui.upgrade.fx_level", { from = job.from, to = job.to })
	if job.big then
		text = text .. "\n" .. Loc.t("ui.upgrade.fx_look")
		label.TextWrapped = true
		local limit = label:FindFirstChildOfClass("UITextSizeConstraint")
		if limit then limit.MaxTextSize = 44 end
	end
	label.Text = text
	Theme.outlineText(label, 3)
	job.label = label

	Kit.playSound(if job.big then "lookUp" else "upgrade")

	-- Bezahlter Betrag fliegt aus der Pille zum Gebaeude (Mechanik aus Paket 1)
	local cost = 0
	if job.key == RECYCLER_KEY then
		local def = CombConfig.getUpgradeCost(job.to)
		cost = if def then def.gummies else 0
	else
		local def = BuildingBehavior.getUpgrade(job.key :: any, job.to)
		cost = if def then def.costGummies else 0
	end
	if cost > 0 then
		Feedback.spend("gummies", cost, anchor.Position)
	end
end

local function finishJob(job: Job)
	for _, state in job.parts do
		if state.part.Parent then
			state.part.Size   = state.size
			state.part.CFrame = state.cframe
		end
	end
	table.clear(job.parts)
	if job.anchor then
		job.anchor:Destroy()
		job.anchor = nil
	end
end

local function step()
	if #_jobs == 0 then return end
	local now = os.clock()
	for i = #_jobs, 1, -1 do
		local job = _jobs[i]
		if not job.started then
			-- Look-Wechsel: der Server baut das Gebaeude neu. Erst auf den
			-- neuen Koerper warten, sonst springt der alte, gleich verschwindende.
			local body = findBody(job.key)
			local ready = body ~= nil and (job.waitLook == nil or body:GetAttribute("Look") == job.waitLook)
			local late = now - job.t0 > FX.LOOK_WAIT
			if body and (ready or late) then
				startJob(job, body)
			elseif late then
				table.remove(_jobs, i)
			end
			continue
		end

		local t = now - job.t0

		-- 1. Aufspringen und zurueckfedern
		if not job.popDone then
			local tp = math.clamp(t / FX.POP_SECONDS, 0, 1)
			local s = popScale(tp, if job.big then FX.POP_SCALE_BIG else FX.POP_SCALE)
			for _, state in job.parts do
				if state.part.Parent then
					local rel = job.origin:ToObjectSpace(state.cframe)
					state.part.Size   = state.size * s
					state.part.CFrame = job.origin * CFrame.new(rel.Position * s) * rel.Rotation
				end
			end
			if tp >= 1 then
				job.popDone = true
				for _, state in job.parts do
					if state.part.Parent then
						state.part.Size   = state.size
						state.part.CFrame = state.cframe
					end
				end
			end
		end

		-- 2. Zahl steigt auf und blendet aus
		local tn = math.clamp(t / FX.NUMBER_SECONDS, 0, 1)
		local gui, label = job.gui, job.label
		if gui and label then
			gui.StudsOffset = Vector3.new(0, 1 + FX.NUMBER_RISE * easeOut(tn), 0)
			local fade = math.max(0, (tn - 0.6) / 0.4)
			label.TextTransparency = fade
			local stroke = label:FindFirstChildOfClass("UIStroke")
			if stroke then stroke.Transparency = fade end
			label.TextStrokeTransparency = fade
		end

		if tn >= 1 and job.popDone then
			finishJob(job)
			table.remove(_jobs, i)
		end
	end
end

--------------------------------------------------------------------------------
-- Ausloesen
--------------------------------------------------------------------------------

-- Oeffentlich (auch fuer Tests/Debug): Effekt fuer `key` von Level `from` auf `to`.
function UpgradeFX.play(key: string, from: number, to: number)
	local big = BuildingBehavior.getLook(to) > BuildingBehavior.getLook(from)
	-- Ein laufender Effekt am selben Gebaeude wird beendet (schnelles
	-- Doppelt-Ausbauen ueber das Menue): nie zwei Skalierungen uebereinander.
	for i = #_jobs, 1, -1 do
		if _jobs[i].key == key then
			finishJob(_jobs[i])
			table.remove(_jobs, i)
		end
	end
	table.insert(_jobs, {
		key = key, from = from, to = to, big = big,
		t0 = os.clock(), waitLook = if big then BuildingBehavior.getLook(to) else nil,
		started = false, parts = {}, origin = CFrame.identity, popDone = false,
	})
end

local function levelsOf(data: Types.PlayerDataUpdate): { [string]: number }
	local levels: { [string]: number } = {}
	for id, building in data.island.buildings do
		levels[id :: string] = building.level
	end
	levels[RECYCLER_KEY] = data.island.recycler.level
	return levels
end

local function onData(data: Types.PlayerDataUpdate)
	local now = levelsOf(data)
	local last = _last
	_last = now
	if not last then return end   -- erster Stand nach dem Join
	for key, level in now do
		local before = last[key]
		-- Nur ein echter Ausbau: genau +1 (ein Rebirth senkt, ein
		-- Debug-Sprung um viele Level ist keiner).
		if before and level == before + 1 then
			UpgradeFX.play(key, before, level)
		end
	end
end

function UpgradeFX.init()
	ClientState.onChanged(onData)
	RunService.Heartbeat:Connect(step)
	print("[UpgradeFX] Initialisiert")
end

return UpgradeFX
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
