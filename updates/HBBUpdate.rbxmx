	Uncommon  = false,
	Rare      = false,
	Epic      = true,
	Legendary = true,
	Mythic    = true,
	Divine    = true,
	Cosmic    = true,
	Secret    = true,
	Godly     = true,
	Eternal   = true,
	Omega     = true,
}

