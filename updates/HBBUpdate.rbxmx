	----------------------------------------------------------------------------
	-- UI-Qualitaet: Beschreibungen aus den Configs (Baerchis, Eier, Skills, Events, Charms)
	----------------------------------------------------------------------------
	["baerchi.RedBaerchi.desc"]           = "Der Klassiker. Zuverlässig, unaufgeregt.",
	["baerchi.GreenBaerchi.desc"]         = "Etwas zäher, dafür langsamer.",
	["baerchi.YellowBaerchi.desc"]        = "Schnell, aber zerbrechlich. Glaskanone.",
	["baerchi.BlueBaerchi.desc"]          = "Solide in allen Bereichen.",
	["baerchi.OrangeBaerchi.desc"]        = "Hoher Schaden, mittlere Ausdauer.",
	["baerchi.SugarBaerchi.desc"]         = "Riecht nach Bonbon, haut zu wie ein Laster.",
	["baerchi.CrystalBaerchi.desc"]       = "Scharfkantig und blitzschnell. Zerbricht leicht.",
	["baerchi.GoldenGrizzly.desc"]        = "Selten, mächtig, und weiß es.",
	["baerchi.VoidBaerchi.desc"]          = "Kommt aus dem Nichts. Verschwindet genauso.",
	["baerchi.RainbowBaerchi.desc"]       = "Jede Farbe. Jede Kraft.",
	["baerchi.AncientBaerchi.desc"]       = "War schon da, bevor Gummies erfunden wurden.",
	["baerchi.CosmicBaerchi.desc"]        = "Ein Stück Sternenhimmel mit Fell.",
	["baerchi.PhoenixBaerchi.desc"]       = "Fällt einmal. Steht immer wieder auf.",
	["baerchi.GlacierBaerchi.desc"]       = "Wo er hinschaut, wird alles langsam.",
	["baerchi.PhantomBaerchi.desc"]       = "Man sieht ihn kaum. Seine Eier schon.",
	["baerchi.SeraphBaerchi.desc"]        = "Sechs Flügel, ein Herz aus Honig.",
	["baerchi.NorthernLightBaerchi.desc"] = "Tanzt über den Himmel, schneller als das Auge.",
	["baerchi.EclipseBaerchi.desc"]       = "Wenn er auftaucht, wird es mitten am Tag dunkel.",
	["baerchi.CometBaerchi.desc"]         = "Kommt mit einem Knall. Bleibt mit einem Krater.",
	["baerchi.NebulaBaerchi.desc"]        = "Ein Fell aus Sternenstaub, der brennt.",
	["baerchi.PulsarBaerchi.desc"]        = "Tickt wie eine Uhr. Jeder Schlag lauter.",
	["baerchi.ShadeBaerchi.desc"]         = "Niemand hat ihn je ganz gesehen.",
	["baerchi.RiddleBaerchi.desc"]        = "Beantwortet jede Frage mit einer neuen.",
	["baerchi.TitanBaerchi.desc"]         = "Trägt Berge, als wären es Gummibärchen.",
	["baerchi.GenesisBaerchi.desc"]       = "Am Anfang war der Baerchi.",
	["baerchi.ChronosBaerchi.desc"]       = "Kommt immer genau rechtzeitig.",
	["baerchi.InfinityBaerchi.desc"]      = "Hört nie auf. Wirklich nie.",
	["baerchi.OmegaBaerchi.desc"]         = "Der letzte Baerchi. Danach kommt nichts mehr.",
	["egg.BasicEgg.desc"]                 = "Ein ganz normales Ei. Was wird wohl rauskommen?",
	["egg.SugarEgg.desc"]                 = "Schmeckt süß. Der Inhalt auch.",
	["egg.GoldenEgg.desc"]                = "Glitzert verdächtig. Rare oder besser garantiert.",
	["egg.PlatinumEgg.desc"]              = "Schwer wie Blei, wertvoller als Gold.",
	["egg.SunEgg.desc"]                   = "Warm in der Hand. Sehr warm.",
	["egg.ZenithEgg.desc"]                = "Der höchste Punkt des Gold-Pfads.",
	["egg.CrystalEgg.desc"]               = "Durchsichtig. Man sieht fast schon, was drin ist.",
	["egg.PrismEgg.desc"]                 = "Bricht das Licht in sieben Farben.",
	["egg.AuroraEgg.desc"]                = "Leuchtet wie der Himmel im Norden.",
	["egg.MistEgg.desc"]                  = "Fühlt sich kalt und feucht an.",
