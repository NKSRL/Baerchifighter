<roblox version="4"><Item class="Folder" referent="RBX60"><Properties><string name="Name">HBBUpdate</string></Properties><Item class="Folder" referent="RBX13"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX4"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">BuildingBehavior</string><ProtectedString name="Source"><![CDATA[--!strict
-- BuildingBehavior.luau
-- ReplicatedStorage/Config/BuildingBehavior.luau
--
-- Einzige Zustaendigkeit:
--   - Alles, was pro Types.BuildingId unterschiedlich ist: was ein Gebaeude
--     kann, was sein Ausbau kostet, wie sein Effekt heisst, welche Look-Stufe
--     es hat und welche Meilenstein-Faehigkeiten es freischaltet.
--
-- ============================================================
-- ZWEI HONIG-GEBAEUDE (v15, Option B)
-- ============================================================
-- Bis v14 gab es drei: Bienenstock (Vorrat), Honigtopf (Heilung), Honig-Presse
-- (XP). Die Entscheidung "Heil-Honig oder XP-Honig?" war schwach, und jedes
-- Gebaeude braucht in Prompt 4 sechs Looks. Seit v15:
--
--   Beehive       VORRAT    Lager waechst, und es produziert schneller.
--
--   HoneyRefiner  VEREDELN  Sein Level hebt die XP JEDES Honigs (die alte
--                           Kurve der Presse) und die Heilung SEINES Honigs
--                           (die alte Achse des Topfs, 25 % -> 60 % auf Level 10,
--                           -> 100 % auf Level 60). Name "Honig-Veredler" ist
--                           ein Platzhalter (steht nur in Strings/MapConfig).
--
-- Damit niemand Honig verliert, produziert der Veredler im Tempo von Topf und
-- Presse zusammen (halbes Intervall, doppeltes Lager). Die Gesamtmenge Honig
-- pro Minute ist dieselbe wie bis v14.
--
-- Das dritte Gebaeude, der Waben-Recycler, hat seine Zahlen in CombConfig; nur
-- seine Meilenstein-Faehigkeiten stehen hier (MILESTONES.Recycler), damit alle
-- Faehigkeiten an einer Stelle sind.
--
-- ============================================================
-- WARUM ALLES HIER STEHT
-- ============================================================
-- Kein Service und kein Panel verzweigt nach einer BuildingId. Ein Gebaeude
-- aendern heisst: EINEN Eintrag in BEHAVIORS anfassen. Die Abhaengigkeit geht
-- nur in EINE Richtung: BuildingBehavior kennt EconomyConfig (Basiswerte,
-- Kostenkurve, XP-Kurve, Look-Stufen), EconomyConfig kennt BuildingBehavior
-- nicht.

local EconomyConfig = require(script.Parent.EconomyConfig)
local Types         = require(script.Parent.Parent.Network.Types)
local Loc           = require(script.Parent.Parent.Localization.Loc)

--------------------------------------------------------------------------------
-- Abweichungen der einzelnen Gebaeude
--------------------------------------------------------------------------------

-- Bienenstock — Vorrat. Bis Level 10 wie bisher (Lager 5 -> 14, je Ausbau ein
-- Platz; Intervall 20 s -> 8 s). Danach langsamer weiter: +1 Lager je
-- BEEHIVE_CAPACITY_STEP Level und Intervall bis BEEHIVE_MIN_INTERVAL_L60.
local BEEHIVE_CAPACITY_L10        = 14
local BEEHIVE_CAPACITY_STEP       = 2      -- ab Level 11: alle 2 Level +1 Platz (L60 = 39)
local BEEHIVE_INTERVAL_L10        = 8
local BEEHIVE_MIN_INTERVAL_L60    = 4

-- Honig-Veredler — Tempo/Lager wie Topf + Presse zusammen.
local REFINER_INTERVAL_FACTOR = 0.5    -- halbes Basis-Intervall (= zwei Gebaeude)
local REFINER_CAPACITY        = 10     -- doppeltes Basis-Lager
-- Heilung SEINES Honigs: Basis (Level 1) -> 60 % (Level 10) -> 100 % (Level 60)
local REFINER_HEAL_L10 = 0.60
local REFINER_HEAL_L60 = 1.00

--------------------------------------------------------------------------------
-- Meilenstein-Faehigkeiten (README 4.3) — Daten + Effekt-Hook
--------------------------------------------------------------------------------
-- Pro Gebaeude: ab welchem Level welche Faehigkeit gilt. `implemented = false`
-- heisst: nur als Daten da, der Effekt kommt spaeter (Liste im Bericht). Ein
-- Service fragt mit BuildingBehavior.hasAbility(...) — er muss nie selbst
-- wissen, auf welchem Level etwas freigeschaltet wird.
export type Ability = {
	id          : string,
	level       : number,
	implemented : boolean,
}

local MILESTONES: { [string]: { Ability } } = {
	Beehive = {
		-- Volles Lager wird automatisch an den ausgeruesteten Baerchi verfuettert
		-- (XP + Heilung), die Produktion steht also nie still (HoneyService).
		{ id = "AutoHarvest",   level = 10, implemented = true },
		{ id = "GoldenDrops",   level = 30, implemented = false },
	},
	HoneyRefiner = {
		{ id = "RefinerBoost",  level = 10, implemented = false },
		{ id = "RoyalJelly",    level = 30, implemented = false },
		{ id = "NectarOfAges",  level = 60, implemented = false },
	},
	-- Honig-Teich (HONEY_POND_V2): die Faehigkeiten von Stock und Veredler
	-- zusammen, auf denselben Leveln.
	HoneyPond = {
		{ id = "AutoHarvest",   level = 10, implemented = true },
		{ id = "RefinerBoost",  level = 10, implemented = false },
		{ id = "GoldenDrops",   level = 30, implemented = false },
		{ id = "RoyalJelly",    level = 30, implemented = false },
		{ id = "NectarOfAges",  level = 60, implemented = false },
	},
	Recycler = {
		-- Groesserer Aufheb-Radius fuer Waben im Event-Pit (CombService).
		{ id = "CollectRadius", level = 20, implemented = true },
		{ id = "AutoDeposit",   level = 45, implemented = false },
	},
}

--------------------------------------------------------------------------------
-- Kleine Rechen-Hilfen
--------------------------------------------------------------------------------

local MAX = EconomyConfig.MAX_BUILDING_LEVEL

-- Linear von `fromValue` (Level fromLevel) nach `toValue` (Level toLevel).
local function lerpLevel(fromLevel: number, fromValue: number, toLevel: number, toValue: number, level: number): number
	local span = math.max(1, toLevel - fromLevel)
	local t = math.clamp((level - fromLevel) / span, 0, 1)
	return fromValue + (toValue - fromValue) * t
end

local function clampLevel(level: number): number
	return EconomyConfig.clampBuildingLevel(level)
end

local function roundToInt(value: number): number
	return math.floor(value + 0.5)
end

local function percentText(value: number): string
	return tostring(roundToInt(value * 100)) .. "%"
end

--------------------------------------------------------------------------------
-- Verhaltens-Objekte
--------------------------------------------------------------------------------

export type Behavior = {
	-- Sekunden, bis dieses Gebaeude auf diesem Level den naechsten Honig hat.
	getIntervalSeconds : (level: number) -> number,

	-- Wie viel Honig dieses Gebaeude auf diesem Level lagern kann.
	getCapacity : (level: number) -> number,

	-- Anteil der maximalen HP, den EIN Honig AUS DIESEM Gebaeude heilt.
	getHealPercent : (level: number) -> number,

	-- Faktor, den dieses Gebaeude zur XP JEDES Honigs beitraegt (1 = keiner).
	getXpMultiplier : (level: number) -> number,

	-- Der Effekt dieses Gebaeudes auf diesem Level, in eigenen Worten
	-- (deutsch; das UI zeigt die lokalisierten Werte selbst an).
	describe : (level: number) -> string,
}

local BASE_INTERVAL = EconomyConfig.HONEY_INTERVAL_SECONDS
local BASE_CAPACITY = EconomyConfig.HONEY_CAPACITY
local BASE_HEAL     = EconomyConfig.HONEY_HEAL_PERCENT

local function baseInterval(_level: number): number  return BASE_INTERVAL end
local function baseCapacity(_level: number): number  return BASE_CAPACITY end
local function baseHeal(_level: number): number      return BASE_HEAL end
local function noXpBonus(_level: number): number     return 1 end

--------------------------------------------------------------------------------
-- Beehive — Vorrat
--------------------------------------------------------------------------------

local function beehiveInterval(level: number): number
	local l = clampLevel(level)
	if l <= 10 then
		return lerpLevel(1, BASE_INTERVAL, 10, BEEHIVE_INTERVAL_L10, l)
	end
	return lerpLevel(10, BEEHIVE_INTERVAL_L10, MAX, BEEHIVE_MIN_INTERVAL_L60, l)
end

local function beehiveCapacity(level: number): number
	local l = clampLevel(level)
	if l <= 10 then
		return roundToInt(lerpLevel(1, BASE_CAPACITY, 10, BEEHIVE_CAPACITY_L10, l))
	end
	return BEEHIVE_CAPACITY_L10 + math.floor((l - 10) / BEEHIVE_CAPACITY_STEP)
end

-- Effekt-Texte in der aktiven Sprache (nur der Client zeigt sie an).
local function beehiveDescribe(level: number): string
	return Loc.t("building.Beehive.effect", {
		cap = beehiveCapacity(level),
		sec = Loc.formatDecimal(beehiveInterval(level), 1),
	})
end

--------------------------------------------------------------------------------
-- HoneyRefiner — Veredeln (XP fuer jeden Honig + Heilung seines Honigs)
--------------------------------------------------------------------------------

local function refinerInterval(_level: number): number
	return BASE_INTERVAL * REFINER_INTERVAL_FACTOR
end

local function refinerCapacity(_level: number): number
	return REFINER_CAPACITY
end

local function refinerHeal(level: number): number
	local l = clampLevel(level)
	if l <= 10 then
		return lerpLevel(1, BASE_HEAL, 10, REFINER_HEAL_L10, l)
	end
	return lerpLevel(10, REFINER_HEAL_L10, MAX, REFINER_HEAL_L60, l)
end

-- Der Multiplikator ist die XP-Kurve, bezogen auf ihren eigenen Startwert:
-- Level 1 = Faktor 1, Level 10 = 25x (wie die alte Presse), danach weiter.
local function refinerXpMultiplier(level: number): number
	local base = EconomyConfig.getHoneyXp(1)
	if base <= 0 then return 1 end
	return EconomyConfig.getHoneyXp(level) / base
end

local function refinerDescribe(level: number): string
	return Loc.t("building.HoneyRefiner.effect", {
		xp   = percentText(refinerXpMultiplier(level) - 1),
		heal = percentText(refinerHeal(level)),
	})
end

--------------------------------------------------------------------------------
-- HoneyPond — Honig-Teich (HONEY_POND_V2): Stock + Veredler in einem
--------------------------------------------------------------------------------
-- Auf Level L genau so viel wie Stock UND Veredler auf Level L: dieselbe
-- Honigmenge pro Minute (Raten addiert), beide Lager, XP und Heilung wie der
-- Veredler. Ein Ausbau kostet dafuer POND_COST_FACTOR x die Grundkosten
-- (statt zwei Gebaeude einzeln). tools/luau-tests/honey_pond.test.lua prueft
-- die Gleichheit; tools/sim/progression_pacing.lua den Kostenfaktor.

local function pondInterval(level: number): number
	local perSecond = 1 / beehiveInterval(level) + 1 / refinerInterval(level)
	return 1 / perSecond
end

local function pondCapacity(level: number): number
	return beehiveCapacity(level) + refinerCapacity(level)
end

local function pondDescribe(level: number): string
	return Loc.t("building.HoneyPond.effect", {
		cap  = pondCapacity(level),
		sec  = Loc.formatDecimal(pondInterval(level), 1),
		xp   = percentText(refinerXpMultiplier(level) - 1),
		heal = percentText(refinerHeal(level)),
	})
end

-- Kosten eines Teich-Ausbaus relativ zu EconomyConfig.HONEY_UPGRADE_COSTS,
-- abgestimmt mit progression_pacing (Bericht docs/HBB_HONIG_TEICH_2026-10-05.md):
--   bis Level 10: 1,2 — Look 2 (L10) nach ~24 min, also in der ERSTEN Sitzung
--   ab Level 11:  2,2 — der Teich kann so viel wie zwei Gebaeude; mit 2,2
--                 halten Look 3-6 ihre Zielzeiten (Look 4 ~8 h, Look 6 Woche 8)
local POND_COST_FACTOR_EARLY = 1.2
local POND_COST_FACTOR       = 2.2

local function pondCostFactor(level: number): number
	return if level <= 10 then POND_COST_FACTOR_EARLY else POND_COST_FACTOR
end

--------------------------------------------------------------------------------
-- Die Tabelle
--------------------------------------------------------------------------------

local BEHAVIORS: { [Types.BuildingId]: Behavior } = {
	Beehive = {
		getIntervalSeconds = beehiveInterval,
		getCapacity        = beehiveCapacity,
		getHealPercent     = baseHeal,
		getXpMultiplier    = noXpBonus,
		describe           = beehiveDescribe,
	},

	HoneyRefiner = {
		getIntervalSeconds = refinerInterval,
		getCapacity        = refinerCapacity,
		getHealPercent     = refinerHeal,
		getXpMultiplier    = refinerXpMultiplier,
		describe           = refinerDescribe,
	},

	HoneyPond = {
		getIntervalSeconds = pondInterval,
		getCapacity        = pondCapacity,
		getHealPercent     = refinerHeal,
		getXpMultiplier    = refinerXpMultiplier,
		describe           = pondDescribe,
	},
}

-- Fallback fuer kaputte Spielstaende mit einer id, die es nicht (mehr) gibt:
-- lieber die Basis-Mechanik als ein Fehler mitten in der Honig-Abrechnung.
local DEFAULT_BEHAVIOR: Behavior = {
	getIntervalSeconds = baseInterval,
	getCapacity        = baseCapacity,
	getHealPercent     = baseHeal,
	getXpMultiplier    = noXpBonus,
	describe           = function(_level: number): string return Loc.t("building.default.effect") end,
}

--------------------------------------------------------------------------------
-- Ausbau-Kosten und -Texte, pro Gebaeude
--------------------------------------------------------------------------------
-- Die KOSTEN sind fuer alle gleich (EconomyConfig.HONEY_UPGRADE_COSTS), der
-- Effekt-Text ist die describe() des Gebaeudes auf der gekauften Stufe —
-- Anzeige und Wirkung koennen nicht auseinanderlaufen.

export type UpgradeDef = {
	costGummies     : number,
	costGoldGummies : number,
	effect          : string,   -- was DIESE Stufe kann (erzeugt aus describe)
}

local BUILDING_UPGRADES: { [Types.BuildingId]: { [number]: UpgradeDef } } = {
	Beehive      = {},
	HoneyRefiner = {},
	HoneyPond    = {},
}

for id, table_ in BUILDING_UPGRADES do
	local behavior = BEHAVIORS[id]
	for level, cost in EconomyConfig.HONEY_UPGRADE_COSTS do
		local factor = if id == "HoneyPond" then pondCostFactor(level) else 1
		table_[level] = {
			costGummies     = cost.gummies * factor,
			costGoldGummies = cost.goldGummies * factor,
			effect          = behavior.describe(level),
		}
	end
end


--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

local BuildingBehavior = {}

BuildingBehavior.BUILDING_UPGRADES = BUILDING_UPGRADES
BuildingBehavior.MILESTONES        = MILESTONES
BuildingBehavior.POND_COST_FACTOR  = POND_COST_FACTOR
BuildingBehavior.pondCostFactor    = pondCostFactor

function BuildingBehavior.get(buildingId: Types.BuildingId): Behavior
	return BEHAVIORS[buildingId] or DEFAULT_BEHAVIOR
end

-- Ist das ein Gebaeude, das es wirklich gibt? Fuer Strings, die vom Client
-- kommen — die duerfen nie ungeprueft als Types.BuildingId weiterlaufen.
function BuildingBehavior.isValidId(value: string): boolean
	return BEHAVIORS[value :: Types.BuildingId] ~= nil
end

function BuildingBehavior.getIntervalSeconds(buildingId: Types.BuildingId, level: number): number
	return BuildingBehavior.get(buildingId).getIntervalSeconds(level)
end

function BuildingBehavior.getCapacity(buildingId: Types.BuildingId, level: number): number
	return BuildingBehavior.get(buildingId).getCapacity(level)
end

-- Groesstes Lager, das dieses Gebaeude je haben kann.
function BuildingBehavior.getMaxCapacity(buildingId: Types.BuildingId): number
	return BuildingBehavior.getCapacity(buildingId, EconomyConfig.MAX_BUILDING_LEVEL)
end

function BuildingBehavior.getHealPercent(buildingId: Types.BuildingId, level: number): number
	return BuildingBehavior.get(buildingId).getHealPercent(level)
end

function BuildingBehavior.getXpMultiplier(buildingId: Types.BuildingId, level: number): number
	return BuildingBehavior.get(buildingId).getXpMultiplier(level)
end

function BuildingBehavior.describeEffect(buildingId: Types.BuildingId, level: number): string
	return BuildingBehavior.get(buildingId).describe(level)
end

function BuildingBehavior.getUpgrade(buildingId: Types.BuildingId, targetLevel: number): UpgradeDef?
	local upgrades = BUILDING_UPGRADES[buildingId]
	if not upgrades then return nil end
	return upgrades[targetLevel]
end

-- v15: Look-Stufe (1-6) eines Gebaeude-Levels. Gilt fuer Bienenstock,
-- Veredler UND Recycler (gleiche Stufen). PlotDisplayService baut ein Gebaeude
-- nur neu, wenn sich DIESE Zahl aendert, nicht bei jedem Level.
function BuildingBehavior.getLook(level: number): number
	return EconomyConfig.getLook(level)
end

-- v15: Hat dieses Gebaeude (oder "Recycler") auf diesem Level die Faehigkeit?
-- Nur umgesetzte Faehigkeiten zaehlen — eine reine Daten-Faehigkeit hat noch
-- keinen Effekt und darf deshalb auch keinen ausloesen.
function BuildingBehavior.hasAbility(buildingKey: string, level: number, abilityId: string): boolean
	for _, ability in MILESTONES[buildingKey] or {} do
		if ability.id == abilityId then
			return ability.implemented and level >= ability.level
		end
	end
	return false
end

-- Alle Faehigkeiten eines Gebaeudes mit Freischalt-Level (fuers Panel).
function BuildingBehavior.getAbilities(buildingKey: string): { Ability }
	return MILESTONES[buildingKey] or {}
end

-- XP, die EIN Honig gibt — egal aus welchem Gebaeude er kommt.
--
-- Die Multiplikatoren ALLER Gebaeude werden aufmultipliziert. Heute traegt nur
-- der Veredler etwas bei (der Bienenstock gibt 1).
function BuildingBehavior.getXpPerHoney(buildings: { [Types.BuildingId]: Types.Building }): number
	local multiplier = 1

	for id, building in buildings do
		multiplier *= BuildingBehavior.getXpMultiplier(id, building.level)
	end

	-- RUNDEN, nicht abschneiden: Basis mal Quotient landet in Fliesskomma knapp
	-- NEBEN der ganzen Zahl (30 * (65/30) = 64.999...).
	return math.max(1, math.floor(EconomyConfig.getHoneyXp(1) * multiplier + 0.5))
end

-- Gesamtes Lager einer Insel ueber alle Gebaeude — fuer die Teich-Anzeige.
function BuildingBehavior.getTotalCapacity(buildings: { [Types.BuildingId]: Types.Building }): number
	local total = 0

	for id, building in buildings do
		total += BuildingBehavior.getCapacity(id, building.level)
	end

	return total
end

return BuildingBehavior
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">CharmConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- CharmConfig.luau
-- ReplicatedStorage/Config/CharmConfig.luau
--
-- Alle Zahlen der Battle-Charms an einer Stelle:
--   - acht Slots und ab welcher Promotions-Stufe jeder freigeschaltet wird
--   - die Rarity-Odds eines Wurfs
--   - der Pool moeglicher Stat-Typen und ihre Wertebereiche je Rarity
--   - was ein Wurf kostet
--
-- ============================================================
-- EIN SLOT IST NICHT AN EINEN STAT-TYP GEBUNDEN
-- ============================================================
-- Wichtigste Regel, vom Projektinhaber ausdruecklich klargestellt: die acht
-- Slots haben KEINEN festen Stat-Typ. Jeder Wurf zieht zweimal unabhaengig —
-- erst eine Rarity (RARITY_ODDS), dann einen Stat-Typ (STAT_POOL) — und zwar
-- fuer jeden Slot gleich, egal welcher Slot-Index es ist.
--
-- Die "Promotion Tiers"-Tabelle aus der Vorlage ist deshalb hier NUR eine
-- Freischalt-Liste (SLOT_UNLOCK_PROMOTION): sie sagt, ab wann ein Slot
-- ueberhaupt benutzbar ist — nicht, was darin sitzt.
--
-- ============================================================
-- KEINE NEUE WAEHRUNG
-- ============================================================
-- Die Vorlage kennt eine eigene Ressource ("Charm Dust"). In Baerchi Fighter
-- gibt es die bewusst NICHT — der Projektinhaber will das Ressourcen-System
-- einfach halten. Ein Wurf kostet direkt GoldGummies, die bereits bestehende
-- zweite Waehrung (seit GOLD_CHARMS_ONLY nur noch aus den Tages-Quests).
--
-- ============================================================
-- WARUM NUR VIER STAT-TYPEN
-- ============================================================
-- Die Vorlage zeigt Boni wie "Crit DMG" oder "Movement Speed" — beides gibt es
-- in Baerchi Fighter gar nicht (keine Krits, die Figuren laufen mit
-- MapConfig.WALK_SPEED). Ein Charm, der auf nichts wirkt, waere ein stiller
-- Fehler, der erst beim Balancing auffaellt. Deshalb enthaelt der Pool
-- ausschliesslich Boni, die CombatCalculator.getEffectiveStats auch wirklich
-- anwendet. Neue Typen sind ein Eintrag in STAT_POOL plus eine Zeile dort —
-- mehr braucht es nicht.

local Types = require(script.Parent.Parent.Network.Types)
local Loc   = require(script.Parent.Parent.Localization.Loc)

--------------------------------------------------------------------------------
-- Slots
--------------------------------------------------------------------------------

local SLOT_COUNT = 8

-- Ab welcher PROMOTIONS-STUFE (0-10, nicht Sterne!) ein Slot benutzbar ist.
-- Die Zahlen kommen 1:1 aus der "Promotion Tiers"-Tabelle der Vorlage:
-- Slot I ist von Anfang an offen, II ab 2, III ab 4, IV ab 6, V und VI ab 8,
-- VII und VIII ab 10.
local SLOT_UNLOCK_PROMOTION: { number } = { 0, 2, 4, 6, 8, 8, 10, 10 }

-- Roemische Ziffern fuer die Slot-Beschriftung (I-VIII), wie in der Vorlage.
local SLOT_NUMERALS: { string } = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII" }

--------------------------------------------------------------------------------
-- Rarity eines Charms
--------------------------------------------------------------------------------

-- Eigene Rarity-Kette, absichtlich NICHT Types.Rarity: ein Charm hat sechs
-- Stufen mit anderen Namen ("Super Rare", "Ascended") als ein Baerchi. Sie in
-- einen Topf zu werfen waere die naechste Stelle, an der eine Baerchi-Aenderung
-- versehentlich die Charm-Odds verschiebt.
local RARITY_ORDER: { Types.CharmRarity } = {
	"Common", "Uncommon", "Rare", "SuperRare", "Legendary", "Ascended",
}

-- Wahrscheinlichkeit je Wurf, in Prozent. Zahlen 1:1 aus der Vorlage
-- (Bild 3: "Each slot rolls a rarity, then a stat").
-- Summe = 100.0 — die Pruefung dazu steht in rollRarity.
local RARITY_ODDS: { [Types.CharmRarity]: number } = {
	Common    = 49.8,
	Uncommon  = 26.9,
	Rare      = 17.9,
	SuperRare =  4.3,
	Legendary =  1.0,
	Ascended  =  0.1,
}

-- Kurzbuchstabe fuer das Slot-Icon (C / U / R / S / L / A), wie in der Vorlage.
local RARITY_LETTER: { [Types.CharmRarity]: string } = {
	Common    = "C",
	Uncommon  = "U",
	Rare      = "R",
	SuperRare = "S",
	Legendary = "L",
	Ascended  = "A",
}

local RARITY_LABEL: { [Types.CharmRarity]: string } = {
	Common    = "Common",
	Uncommon  = "Uncommon",
	Rare      = "Rare",
	SuperRare = "Super Rare",
	Legendary = "Legendary",
	Ascended  = "Ascended",
}

local RARITY_COLORS: { [Types.CharmRarity]: Color3 } = {
	Common    = Color3.fromRGB(176, 190, 204),
	Uncommon  = Color3.fromRGB( 76, 217, 100),
	Rare      = Color3.fromRGB( 46, 155, 255),
	SuperRare = Color3.fromRGB(168,  85, 247),
	Legendary = Color3.fromRGB(255, 176,  32),
	Ascended  = Color3.fromRGB(255,  59, 107),
}

-- Wie stark ein Charm dieser Rarity ist, als Faktor auf den Grundwert des
-- Stat-Typs (siehe STAT_POOL). Ein Ascended-Charm ist damit fuenfmal so stark
-- wie ein Common desselben Typs.
local RARITY_POWER: { [Types.CharmRarity]: number } = {
	Common    = 1.0,
	Uncommon  = 1.6,
	Rare      = 2.4,
	SuperRare = 3.4,
	Legendary = 4.4,
	Ascended  = 6.0,
}

--------------------------------------------------------------------------------
-- Stat-Typen
--------------------------------------------------------------------------------

-- `mode`:
--   "percent" — der Wert ist ein Faktor auf den Basiswert (0.014 = +1.4%)
--   "flat"    — der Wert wird direkt addiert
--
-- `base` ist der Wert eines COMMON-Charms dieses Typs; die Rarity
-- multipliziert ihn (RARITY_POWER), und rollValue streut zusaetzlich
-- +/- SPREAD, damit zwei Charms derselben Rarity nicht identisch sind.
export type CharmStatDef = {
	id          : string,
	displayName : string,
	target      : "hp" | "atk" | "spd" | "pwr",
	mode        : "percent" | "flat",
	base        : number,
}

-- Die vier Ziele sind genau die vier Basiswerte des Spiels. Eine
-- Schadensabwehr gibt es NICHT — es gibt keine Verteidigung mehr (siehe
-- BaerchiConfig): wer einen Tank will, wuerfelt auf HP-Boost.
local STAT_POOL: { CharmStatDef } = {
	{ id = "HpBoost",   displayName = "HP-Boost",         target = "hp",  mode = "percent", base = 0.014 },
	{ id = "AtkBoost",  displayName = "ATK-Boost",        target = "atk", mode = "percent", base = 0.012 },
	{ id = "SpdBoost",  displayName = "Angriffs-Tempo",   target = "spd", mode = "flat",    base = 0.020 },

	-- Flach, nicht prozentual: PWR ist selbst schon ein Multiplikator auf den
	-- Skill-Schaden. "+8% auf einen Multiplikator" waere eine Zahl, die
	-- niemand im Kopf nachrechnet — "+2.4 Prozentpunkte Ability-Schaden"
	-- dagegen schon.
	{ id = "PwrBoost",  displayName = "Ability-Staerke",  target = "pwr", mode = "flat",    base = 0.008 },
}

-- Streuung um den errechneten Wert (0.25 = +/- 25%).
local SPREAD = 0.25

--------------------------------------------------------------------------------
-- Kosten
--------------------------------------------------------------------------------

-- Ein Wurf wuerfelt ALLE freigeschalteten und nicht gesperrten Slots des
-- Baerchis auf einmal neu — genau wie in der Vorlage ("rerolls every slot you
-- have not locked"). Deshalb ist der Preis pro WURF, nicht pro Slot.
local ROLL_COST_GOLD_GUMMIES = 25

-- "Auto Roll" ist serverseitig einfach ein Wurf-Paket: der Client schickt eine
-- Anzahl, der Server wuerfelt so oft hintereinander, bis die Anzahl erreicht
-- ist ODER die GoldGummies nicht mehr reichen, und meldet das Ergebnis
-- gesammelt zurueck.
--
-- Bewusst so statt eines Dauer-Timers auf dem Client: ein Auto-Roll, der pro
-- Wurf ein Remote feuert, laeuft sofort in den RateLimiter (siehe
-- NetworkConfig) und wuerde entweder haengen oder halb durchlaufen. Ein Paket
-- ist eine Anfrage, eine Abrechnung, ein Ergebnis.
local AUTO_ROLL_COUNT = 20

--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

local function getUnlockPromotion(slot: number): number
	return SLOT_UNLOCK_PROMOTION[slot] or math.huge
end

local function isSlotUnlocked(slot: number, promotionLevel: number): boolean
	if slot < 1 or slot > SLOT_COUNT then
		return false
	end
	return (promotionLevel or 0) >= getUnlockPromotion(slot)
end

-- Wie viele Slots bei diesem Promotions-Stand offen sind.
local function countUnlockedSlots(promotionLevel: number): number
	local count = 0
	for slot = 1, SLOT_COUNT do
		if isSlotUnlocked(slot, promotionLevel) then
			count += 1
		end
	end
	return count
end

local function getStatDef(statId: string): CharmStatDef?
	for _, def in STAT_POOL do
		if def.id == statId then
			return def
		end
	end
	return nil
end

-- Wuerfelt eine Rarity anhand von RARITY_ODDS.
--
-- Geht die Kette bewusst von der SELTENSTEN zur haeufigsten durch und
-- vergleicht gegen die aufsummierte Wahrscheinlichkeit: so faellt ein
-- Rundungsrest (die Odds summieren sich auf exakt 100.0, aber math.random gibt
-- Werte bis knapp darunter) immer auf Common zurueck und nie auf einen
-- Ascended.
local function rollRarity(): Types.CharmRarity
	local roll        = math.random() * 100
	local accumulated = 0

	for i = #RARITY_ORDER, 1, -1 do
		local rarity = RARITY_ORDER[i]
		accumulated += RARITY_ODDS[rarity] or 0
		if roll < accumulated then
			return rarity
		end
	end

	return "Common"
end

local function rollStatDef(): CharmStatDef
	return STAT_POOL[math.random(1, #STAT_POOL)]
end

-- Der konkrete Bonus-Wert eines Charms: Grundwert des Typs, mal Rarity-Staerke,
-- plus/minus SPREAD.
local function rollValue(statDef: CharmStatDef, rarity: Types.CharmRarity): number
	local power  = RARITY_POWER[rarity] or 1
	local center = statDef.base * power
	local factor = 1 + (math.random() * 2 - 1) * SPREAD

	-- Auf vier Nachkommastellen runden: sonst stehen im Spielstand Zahlen mit
	-- fuenfzehn Stellen, die kein Mensch und keine Anzeige braucht.
	return math.floor(center * factor * 10000 + 0.5) / 10000
end

-- Wuerfelt einen kompletten Charm fuer einen Slot.
local function rollCharm(slot: number): Types.Charm
	local rarity  = rollRarity()
	local statDef = rollStatDef()

	return {
		slot   = slot,
		rarity = rarity,
		statId = statDef.id,
		value  = rollValue(statDef, rarity),
		locked = false,
	}
end

-- Lesbarer Effekt-Text ("+3.4% HP-Boost"). Server und Client benutzen
-- denselben, damit die Anzeige nicht zweimal formatiert wird. Text in der
-- aktiven Sprache (Client: Spielersprache); der Name des Werts kommt aus
-- `charm.<id>.name`, `displayName` ist nur der deutsche Rueckfall.
local function describe(charm: Types.Charm): string
	local statDef = getStatDef(charm.statId)
	if not statDef then
		return charm.statId
	end

	-- Als Prozent anzuzeigen sind zwei Faelle: echte Prozent-Charms (HP/ATK)
	-- und PWR. PWR ist zwar technisch ein FLACHER Zuschlag, aber der Wert
	-- selbst ist ein Anteil (0.05 = 5% mehr Ability-Schaden) — als "+0.048"
	-- koennte ihn niemand einordnen.
	local stat = Loc.name("charm." .. statDef.id .. ".name", statDef.displayName) -- ui-ok: Rueckfall hinter Loc
	if statDef.mode == "percent" or statDef.target == "pwr" then
		return Loc.t("charm.effect_pct", { value = Loc.formatDecimal(charm.value * 100, 1), stat = stat })
	end
	return Loc.t("charm.effect_flat", { value = Loc.formatDecimal(charm.value, 3), stat = stat })
end

return {
	SLOT_COUNT            = SLOT_COUNT,
	SLOT_UNLOCK_PROMOTION = SLOT_UNLOCK_PROMOTION,
	SLOT_NUMERALS         = SLOT_NUMERALS,

	RARITY_ORDER   = RARITY_ORDER,
	RARITY_ODDS    = RARITY_ODDS,
	RARITY_LETTER  = RARITY_LETTER,
	RARITY_LABEL   = RARITY_LABEL,
	RARITY_COLORS  = RARITY_COLORS,
	RARITY_POWER   = RARITY_POWER,

	STAT_POOL = STAT_POOL,
	SPREAD    = SPREAD,

	ROLL_COST_GOLD_GUMMIES = ROLL_COST_GOLD_GUMMIES,
	AUTO_ROLL_COUNT        = AUTO_ROLL_COUNT,

	getUnlockPromotion = getUnlockPromotion,
	isSlotUnlocked     = isSlotUnlocked,
	countUnlockedSlots = countUnlockedSlots,
	getStatDef         = getStatDef,
	rollRarity         = rollRarity,
	rollCharm          = rollCharm,
	describe           = describe,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">EventConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- EventConfig.luau
-- ReplicatedStorage/Config/EventConfig.luau
--
-- Der Event-Zyklus (Stand 2026-10-04, siehe Projekt-Docs
-- EVENT_UND_RARITY_IDEEN_2026-10-02 und README_EVENTS_GEBAEUDE_TOWER_PLAN):
-- SECHS Events im festen Wechsel, das Boss-Event nur in jedem zweiten
-- Durchlauf (everyNthCycle). Ein Durchlauf ohne Boss dauert ~41 min, mit ~46.
--
--   UFO             Flaggschiff, 4 Min. Patrouilliert ueber dem Pit, der Beam
--                   wandert mit; Entfuehrung = +1 auf ALLE Stats und
--                   Rarity-Up-Chance. Alle 30 s ein Ei-Abwurf (1 % Jackpot).
--   Hot Egg         Heisses Ei wird weitergegeben -> Gutes Ei. Waben werden
--                   zu Lava (x3), alle ~30 s ein Vulkan-Ausbruch.
--   Mutations-Sturm Blitze mutieren Baerchis, Chance sinkt mit Rarity -> Mutation
--   Koenigshuegel   Wer am laengsten oben steht -> Gutes Ei
--   Schatzgraeber   Baerchis graben, Bomben schicken sie heim -> Gutes Ei
--   Wespenkoenigin  Boss-Kampf fuer alle (jeder zweite Durchlauf): Baerchis
--                   kaempfen, Spieler weichen Telegraphen aus. Belohnung nach
--                   Schadensanteil.
--
-- EventService faehrt nur die Uhr, EventParticipationService teilt aus und
-- startet die Event-Handler (Services/EventHandlers/*). WAS es gibt und alle
-- Zahlen stehen ausschliesslich hier.
--
-- Der alte 10-Events-Katalog steht im Projekt-Doc EVENT_KATALOG_2026-09-16.

local Types           = require(script.Parent.Parent.Network.Types)
local EggConfig       = require(script.Parent.EggConfig)
local PromotionConfig = require(script.Parent.PromotionConfig)
local Loc             = require(script.Parent.Parent.Localization.Loc)

--------------------------------------------------------------------------------
-- Typen
--------------------------------------------------------------------------------

--   kind = "honey"        amount  = Honig je Gebaeude (aufs Lager gedeckelt)
--   kind = "eggs"         amount  = Anzahl, eggType = welche Sorte
--   kind = "gummies"      amount  = Basisbetrag, wird mit rebirthMult vergeben
--   kind = "goldGummies"  amount  = Betrag (kein Multiplikator)
--   kind = "mutation"     chance  = Basis-Wahrscheinlichkeit auf EINEN Mutations-Wurf
--                         (wird mit MUTATION_RARITY_FACTOR[rarity] multipliziert)
--
-- v14 (Ei-Baum, WP10): bei kind = "eggs" darf statt einer festen Sorte
--   eggPick = "highest"   das hoechste freie Ei des Spielers (ohne Ascension)
--   eggPick = "jump"      ein SPRUNG-EI: eine Stufe ueber dem hoechsten freien
--                         Ei eines Pfads. Laesst sich oeffnen, schaltet den
--                         Knoten aber nicht frei. Gibt es keins (alles frei),
--                         wird es zu "highest".
-- stehen, und blueprintChance gibt eine Chance auf eine Blaupause dazu.
export type EventBonus = {
	kind    : "honey" | "eggs" | "gummies" | "goldGummies" | "mutation",
	amount  : number?,
	eggType : Types.EggType?,
	eggPick : ("highest" | "jump")?,
	blueprintChance : number?,
	chance  : number?,
}

-- v14: NOTFALL-EI. Bei jeder Ei-Belohnung eines Events gibt es mit dieser
-- Chance ZUSAETZLICH ein Basis-Ei. Das Konzept sah "statt" vor — zusaetzlich
-- erfuellt denselben Zweck (Notanker fuer das Basis-Ei), ohne dass ein
-- Spieler sein gutes Ei verliert. ANNAHME, eine Zeile hier.
local EMERGENCY_BASIC_EGG_CHANCE = 0.05

export type EventDef = {
	id          : string,
	displayName : string,

	floorColor  : Color3,
	fenceColor  : Color3,
	ringColor   : Color3,
	bannerColor : Color3,

	-- "bounce" | "lean" | "spin": rein kosmetisch (Idle-Bewegung am Event).
	action      : "bounce" | "lean" | "spin",
	actionText  : string,

	-- Dauer DIESES Events in Sekunden (individuell je Event).
	durationSeconds : number,

	-- Welcher Handler (Services/EventHandlers/<handler>) das Event steuert.
	handler     : string,

	-- true NUR beim UFO: Stat-Stufen + Rarity-Up. Alle anderen Events geben
	-- keine Stat-Stufe.
	statGain    : boolean,

	-- Legacy-Feld (frueher Stat-Fokus je Event). Bleibt nil.
	statFocus   : string?,

	-- Zusatz-Ertrag ("gutes Ei" bzw. Mutations-Wurf), oder nil.
	bonus       : EventBonus?,

	-- Ein Satz fuer Tafel/UI. Hat Vorrang vor der automatisch gebauten Zeile.
	-- Deutsch zum Lesen der Config; angezeigt wird `event.<id>.reward` aus
	-- den Sprachdateien (tools/check_ui.py, Regel T4, verlangt den Schluessel).
	rewardText  : string?,

	-- Laeuft nur in jedem n-ten Durchlauf des Zyklus (nil = jeder). Der Zyklus
	-- zaehlt ab 1; mit 2 kommt das Event im 2., 4., 6. ... Durchlauf.
	everyNthCycle : number?,
}

--------------------------------------------------------------------------------
-- Zeiten
--------------------------------------------------------------------------------

-- Standard-Dauer, falls ein Event keine eigene hat (und fuer Debug-Ausgaben).
local EVENT_DURATION_SECONDS = 180
local EVENT_GAP_SECONDS      = 300
-- HBB Paket 6: Pause vor dem ERSTEN Event eines frisch gestarteten Servers.
-- Kuerzer, damit die ersten Spieler eines neuen Servers nicht fuenf Minuten
-- auf das erste Event warten. Alle spaeteren Pausen und die Boss-Haeufigkeit
-- (everyNthCycle) bleiben unveraendert. Gilt nur mit FeatureFlags.EVENT_V2_TIMER.
local FIRST_GAP_SECONDS      = 75

--------------------------------------------------------------------------------
-- UFO-Event
--------------------------------------------------------------------------------

local UFO = {
	-- So viele Sekunden Beam-Fortschritt braucht ein Baerchi zur Entfuehrung.
	-- Der Fortschritt muss nicht am Stueck laufen (Kaempfe pausieren ihn nur).
	-- 20 statt 30: der Ring wandert, der Baerchi verliert beim Nachlaufen Zeit.
	BEAM_REQUIRED_SECONDS = 20,

	-- PATROUILLE: Lissajous-Bahn ueber dem Pit (Studs, Sekunden), reine
	-- Funktion der Serverzeit (Modules/EventMotion). Halbachsen so, dass der
	-- Beam-Ring immer im Pit bleibt (Pit-Radius 50, Ring 11); schnellster
	-- Punkt ~2,5 Studs/s, ein Baerchi laeuft am Event 26.
	PATROL_RADIUS_X = 24,
	PATROL_RADIUS_Z = 18,
	PATROL_PERIOD_X = 90,
	PATROL_PERIOD_Z = 60,
	-- Ein Baerchi im Beam laeuft nach, sobald er weiter als dieser Anteil des
	-- Ring-Radius von der Ring-Mitte steht; Ziel ist die Ring-Mitte so viele
	-- Sekunden voraus.
	FOLLOW_SHARE      = 0.55,
	FOLLOW_LEAD_SECONDS = 1.5,

	-- EI-ABWURF: alle DROP_INTERVAL_SECONDS (erster nach DROP_FIRST_SECONDS,
	-- 8 pro Event). DROP_TELEGRAPH_SECONDS vorher erscheint der Landekreis an
	-- der vorhergesagten UFO-Position. Aufheben: Spieler-CHARAKTER innerhalb
	-- DROP_PICKUP_RADIUS, erster gewinnt (Server prueft im Takt).
	DROP_FIRST_SECONDS      = 15,
	DROP_INTERVAL_SECONDS   = 30,
	DROP_TELEGRAPH_SECONDS  = 3,
	DROP_PICKUP_RADIUS      = 5,
	DROP_PICKUP_MAX_HEIGHT  = 8,
	DROP_CHECK_SECONDS      = 0.1,
	DROP_EGG                = "BasicEgg" :: Types.EggType,

	-- JACKPOT: goldene Kiste mit dem UFO-Jackpot-Ei. Pity: spaetestens der
	-- JACKPOT_PITY_DROPS-te Abwurf (serverweit, Laufzeit-Zaehler, wird nach
	-- jedem Jackpot zurueckgesetzt).
	JACKPOT_CHANCE     = 0.01,
	JACKPOT_PITY_DROPS = 100,
	JACKPOT_EGG        = "UfoJackpotEgg" :: Types.EggType,

	-- War so lange KEIN Baerchi im Beam (oder kommt einer zu spaet), schliesst
	-- das UFO den Beam und setzt ihn zurueck: alle Countdowns beginnen neu.
	BEAM_IDLE_TIMEOUT_SECONDS = 75,

	-- Fixe Kampfdauer, wenn sich ein Baerchi im Beam und ein anderer beruehren.
	-- Waehrenddessen pausiert der Beam-Fortschritt.
	FIGHT_SECONDS = 3,

	-- Nach der Entfuehrung: Wartezeit, bevor das Baerchi wieder aufs Plot gesetzt wird.
	ABDUCT_WAIT_SECONDS = 10,

	-- Beim Absetzen: +1 auf jeden dieser Stats (begrenzt durch STAT_CAP).
	STAT_GAIN_PER_STAT = 1,

	-- Radius des Beam-Rings (Anteil des Podest-Radius) und Beruehrungsabstand.
	BEAM_RADIUS_FACTOR = 0.22,
	TOUCH_DISTANCE     = 5,

	-- Takt der Beam-Pruefung. Der Fortschritt waechst je Takt um genau diesen
	-- Wert, die Summe pro Sekunde bleibt also gleich; der Takt bestimmt nur,
	-- wie fein Beruehrungen und Beam-Grenze erkannt werden.
	TICK_SECONDS = 0.25,

	-- Der Verlierer eines Kampfs laeuft zurueck und darf so lange nicht
	-- wieder zum Beam.
	LOSER_COOLDOWN_SECONDS = 4,

	-- Dasselbe Paar kaempft fruehestens nach FIGHT_SECONDS + so vielen
	-- Sekunden erneut gegeneinander.
	PAIR_COOLDOWN_EXTRA_SECONDS = 6,

	-- Nach einem Beam-Reset bleibt der Beam so lange geschlossen.
	BEAM_REOPEN_SECONDS = 4,

	-- Wunsch Projektinhaber 05.10.: Ein Baerchi darf im selben UFO-Event
	-- erneut mitmachen. Nach dem Absetzen ist er aber DROP_WEAKEN_SECONDS lang
	-- geschwaecht: sein Level zaehlt in Event-Duellen nur mit diesem Faktor.
	-- Das gibt anderen Spielern eine Chance, ohne den Wiederkehrer auszusperren.
	DROP_WEAKEN_SECONDS      = 60,
	DROP_WEAKEN_LEVEL_FACTOR = 0.5,
}

-- Rarity-Up-Chance beim Absetzen des entfuehrten Baerchis. Aufstieg immer nur
-- EINE Stufe. Chance je AKTUELLER Rarity. Common->Uncommon 55 % und
-- Secret->Godly 0,5 % vom Projektinhaber, Rest Interpolation.
local RARITY_UP_CHANCE: { [string]: number } = {
	Common    = 0.55,
	Uncommon  = 0.40,
	Rare      = 0.28,
	Epic      = 0.18,
	Legendary = 0.11,
	Mythic    = 0.065,
	Divine    = 0.035,
	Cosmic    = 0.015,
	Secret    = 0.005,
	Godly     = 0.0025,
	Eternal   = 0.001,
	Omega     = 0,
}

--------------------------------------------------------------------------------
-- Mutations-Sturm
--------------------------------------------------------------------------------

-- Faktor auf die Mutationschance: je hoeher die Rarity, desto geringer.
local MUTATION_RARITY_FACTOR: { [string]: number } = {
	Common    = 1.00,
	Uncommon  = 0.80,
	Rare      = 0.60,
	Epic      = 0.40,
	Legendary = 0.25,
	Mythic    = 0.15,
	Divine    = 0.10,
	Cosmic    = 0.06,
	Secret    = 0.03,
	Godly     = 0.015,
	Eternal   = 0.008,
	Omega     = 0.004,
}

-- Duelle (UFO, Koenigshuegel): die Kampfkraft beider Seiten wird mit einem
-- Zufallsfaktor 1 ± POWER_SPREAD multipliziert. 0.2 = auch der Schwaechere
-- gewinnt manchmal, wenn der Abstand klein ist.
local DUEL = {
	POWER_SPREAD = 0.2,
}

local STORM = {
	-- Alle so viele Sekunden schlaegt ein Blitz in einen Teilnehmer ein (nur
	-- Optik); der Mutations-Wurf selbst faellt am Event-Ende.
	STRIKE_INTERVAL_SECONDS = 20,
}

--------------------------------------------------------------------------------
-- Hot Egg
--------------------------------------------------------------------------------

local HOT_EGG = {
	CHECK_INTERVAL_SECONDS = 0.5,
	-- Nach einer Weitergabe darf das Ei kurz nicht zurueck.
	PASS_COOLDOWN_SECONDS  = 2.0,
	TOUCH_DISTANCE         = 5,

	-- Wabenthema waehrend des Events (CombConfig.THEMES).
	COMB_THEME = "HotEgg",

	-- VULKAN-AUSBRUCH: alle ERUPTION_INTERVAL_SECONDS ein Warnring in der
	-- Mitte, ERUPTION_WARN_SECONDS spaeter fliegen ERUPTION_MIN..MAX
	-- Lava-Waben in alle Richtungen (landen als normale Waben im Slot-Modell).
	ERUPTION_INTERVAL_SECONDS = 30,
	ERUPTION_WARN_SECONDS     = 2,
	ERUPTION_MIN              = 8,
	ERUPTION_MAX              = 10,
}

--------------------------------------------------------------------------------
-- Koenigshuegel
--------------------------------------------------------------------------------

local KING = {
	-- Radius des Huegels (Anteil des Podest-Radius).
	HILL_RADIUS_FACTOR = 0.30,
	TICK_SECONDS       = 1,

	-- Zwei Baerchis auf dem Huegel, die sich so nahe kommen, kaempfen.
	TOUCH_DISTANCE = 6,
	-- Fixe Dauer eines Huegel-Duells.
	DUEL_SECONDS = 3,
	-- Der Verlierer muss runter und darf so lange nicht wieder hoch.
	LOSER_COOLDOWN_SECONDS = 6,
	-- Ein Herausforderer bleibt so weit vor dem Koenig stehen (innerhalb von
	-- TOUCH_DISTANCE, damit das Duell ausgeloest wird).
	CHALLENGE_DISTANCE = 4,
}

--------------------------------------------------------------------------------
-- Schatzgraeber
--------------------------------------------------------------------------------

local TREASURE = {
	-- Basis-Sekunden pro Fundstelle; hoeheres Level = schneller.
	BASE_DIG_SECONDS      = 14,
	DIG_SECONDS_PER_LEVEL = 0.15,
	MIN_DIG_SECONDS       = 6,
	-- Fundstellen je Spieler (hoeheres Level -> mehr).
	BASE_SITES            = 5,
	LEVEL_PER_EXTRA_SITE  = 10,
	MAX_SITES             = 9,
	-- Anteil der Fundstellen, in denen eine Bombe liegt.
	BOMB_SHARE            = 0.15,
	-- Fundstellen liegen in diesem Ring um die Event-Mitte (Anteil des
	-- Podest-Radius): nicht direkt in der Mitte und nicht am Zaun.
	SITE_MIN_RADIUS_FACTOR = 0.25,
	SITE_MAX_RADIUS_FACTOR = 0.80,
	-- Belohnung nach Funden (ueberlebt man bis Ende): hoechste passende Stufe.
	-- Bei Bombe geht ALLES verloren.
	-- v14: hoechstes freies Ei statt fest Golden/Kristall; ab 5 Funden ein
	-- Sprung-Ei mit 10% Chance auf eine Blaupause.
	REWARDS = {
		{ minFinds = 1, eggPick = "highest", amount = 1 },
		{ minFinds = 3, eggPick = "highest", amount = 2 },
		{ minFinds = 5, eggPick = "jump",    amount = 1, blueprintChance = 0.10 },
	},
}

--------------------------------------------------------------------------------
-- Wespenkoenigin (Boss-Event)
--------------------------------------------------------------------------------
-- Ablauf: ANNOUNCE_SECONDS Ankuendigung (Himmel dunkelt), dann Kampf bis zum
-- Sieg oder Event-Ende. Die Baerchis am Event kaempfen automatisch, ihr
-- Schaden kommt aus dem echten Kampfmodell (Modules/BossBalance ueber
-- CombatCalculator). Die Spieler weichen Telegraphen aus: ein Treffer stoesst
-- zurueck, bremst und setzt den Schaden des eigenen Baerchis kurz aus. Wer
-- mit seinem Charakter im Pit steht, feuert an (CHEER_FACTOR).

local WASP_QUEEN = {
	ANNOUNCE_SECONDS = 20,
	TICK_SECONDS     = 0.5,

	-- Ziel-Kampfdauer, aus der die HP berechnet werden:
	--   HP = Spieler x mittlere DPS x TARGET_FIGHT_SECONDS x HP_FACTOR
	-- (Spieler = Baerchis am Event beim Kampfbeginn). Wer spaeter dazukommt,
	-- erhoeht die HP um seine DPS x Restzeit bis zum Ziel (mind. LATE_JOIN_MIN_SECONDS).
	-- 135 statt 150: Treffer setzen Schaden aus, und Anfaenger weichen
	-- schlechter aus; mit 135 liegt der Kampf ueber alle Staerken bei
	-- ~125-170 s (tools/sim/boss_balance.lua).
	TARGET_FIGHT_SECONDS  = 135,
	HP_FACTOR             = 1.0,
	-- v15 (vorbereitet, AUS): Boss-HP-Faktor nach dem hoechsten Tower der
	-- Teilnehmer (Index 1-4 = I, II, III, Final). Standard ueberall 1 — erst
	-- nach dem Playtest einschalten (BossBalance.towerHpFactor).
	TOWER_HP_FACTOR       = { 1.0, 1.0, 1.0, 1.0 },
	MIN_HP                = 400,
	LATE_JOIN_MIN_SECONDS = 30,

	CHEER_FACTOR     = 1.25,
	HIT_STUN_SECONDS = 3,
	-- Treffer am Spieler: Rueckstoss (Studs/s) und Bremse (Anteil, Sekunden).
	KNOCKBACK_SPEED  = 70,
	SLOW_FACTOR      = 0.5,
	SLOW_SECONDS     = 2,

	-- Phase 2 ab diesem HP-Anteil: schnellere Attacken, Waben-Regen (Koenigsgelee).
	PHASE2_AT              = 0.5,
	PHASE1_ATTACK_INTERVAL = 6,
	PHASE2_ATTACK_INTERVAL = 4,
	TELEGRAPH_SECONDS      = 2,
	RAIN_THEME             = "WaspQueen",
	RAIN_INTERVAL_SECONDS  = 8,
	RAIN_COUNT             = 6,

	-- Attacken (Studs). Schockwelle: Ring um den Boden unter der Koenigin.
	-- Stachel-Salve: Kreise auf Spielerpositionen. Schwarm: Bahn quer durchs Pit.
	SHOCK_INNER        = 7,
	SHOCK_OUTER        = 17,
	STING_RADIUS       = 6,
	STING_COUNT        = 3,
	STING_COUNT_PHASE2 = 5,
	SWARM_WIDTH        = 9,

	-- Bewegung (Modules/EventMotion): Kreis ueber dem Pit.
	ORBIT_RADIUS        = 14,
	ORBIT_PERIOD        = 32,
	ORBIT_PERIOD_PHASE2 = 20,

	-- Belohnung nach Schadensanteil. Unter MIN_DAMAGE_SHARE gibt es nichts.
	-- Teilnahme: Gummies (mit Rebirth-Multiplikator) und Wabeneinheiten in den
	-- Recycler, je GUMMIES_BASE/COMB_UNITS_BASE mal Anteil x Teilnehmerzahl
	-- (ein Durchschnitts-Teilnehmer bekommt genau die Basis), begrenzt auf
	-- SHARE_FACTOR_MIN..MAX. Die besten TOP_RANKS bekommen ein Sprung-Ei und
	-- einen Rarity-Up-Wurf (RARITY_UP_FACTOR x EventConfig.RARITY_UP_CHANCE).
	-- Sieg: jeder bekommt sein hoechstes Ei, mit JACKPOT_CHANCE stattdessen das
	-- Jackpot-Ei. Niederlage: nur Teilnahme x DEFEAT_FACTOR.
	MIN_DAMAGE_SHARE  = 0.02,
	GUMMIES_BASE      = 300,
	COMB_UNITS_BASE   = 15,
	SHARE_FACTOR_MIN  = 0.5,
	SHARE_FACTOR_MAX  = 2.0,
	TOP_RANKS         = 3,
	RARITY_UP_FACTOR  = 0.5,
	JACKPOT_CHANCE    = 0.01,
	DEFEAT_FACTOR     = 0.5,
}

-- HBB Paket 7: Belohnungsstufen am Boss (Modules/BossTiers), ZUSAETZLICH zur
-- Belohnung nach Schadensanteil oben. Gilt nur mit FeatureFlags.BOSS_TIERS.
-- Schwellen relativ zum eigenen Potenzial (DPS x Zeit am Boss).
-- Belohnungen nur aus vorhandenen Bausteinen; Gummies sind Basisbetraege
-- (EconomyService wendet den Rebirth-Multiplikator an). Kumuliert: Stufe 3
-- hat zusammen zwei Basis-Eier, Stufe 4 dazu einen Mutations-Wurf.
local BOSS_TIERS = {
	T2 = 0.05,
	T3 = 0.25,
	T4 = 0.60,
	-- Aktivitaet: Charakter alle CHECK_SECONDS mehr als MOVE_STUDS bewegt
	-- (Player.Idled gibt es nur auf dem Client)
	ACTIVE_WINDOW_SECONDS = 60,
	ACTIVE_CHECK_SECONDS  = 2,
	ACTIVE_MOVE_STUDS     = 4,
	REWARDS = {
		[1] = { gummies = 40,  combUnits = 3, basicEggs = 0, mutationRoll = false },
		[2] = { gummies = 60,  combUnits = 4, basicEggs = 1, mutationRoll = false },
		[3] = { gummies = 80,  combUnits = 5, basicEggs = 2, mutationRoll = false },
		[4] = { gummies = 100, combUnits = 6, basicEggs = 2, mutationRoll = true },
	} :: { [number]: { gummies: number, combUnits: number, basicEggs: number, mutationRoll: boolean } },
	-- Wurf wie beim Mutations-Sturm (gleiche Chance, gleiche Rarity-Daempfung)
	MUTATION_CHANCE = 0.20,
}

--------------------------------------------------------------------------------
-- Der Katalog
--------------------------------------------------------------------------------

local EVENTS: { EventDef } = {

	-- ---------------------------------------------------------------- 1
	{
		id              = "Ufo",
		displayName     = "UFO",
		floorColor      = Color3.fromRGB( 18,  34,  64),
