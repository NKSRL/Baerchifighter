	----------------------------------------------------------------------------
	-- UI-Qualitaet: Beschreibungen aus den Configs (Baerchis, Eier, Skills, Events, Charms)
	----------------------------------------------------------------------------
	["baerchi.RedBaerchi.desc"]           = "Le classique. Fiable, sans chichis.",
	["baerchi.GreenBaerchi.desc"]         = "Un peu plus coriace, mais plus lent.",
	["baerchi.YellowBaerchi.desc"]        = "Rapide mais fragile. Un canon de verre.",
	["baerchi.BlueBaerchi.desc"]          = "Solide en tout.",
	["baerchi.OrangeBaerchi.desc"]        = "Gros dégâts, endurance moyenne.",
	["baerchi.SugarBaerchi.desc"]         = "Sent le bonbon, frappe comme un camion.",
	["baerchi.CrystalBaerchi.desc"]       = "Tranchant et rapide comme l'éclair. Se brise facilement.",
	["baerchi.GoldenGrizzly.desc"]        = "Rare, puissant, et il le sait.",
	["baerchi.VoidBaerchi.desc"]          = "Surgit de nulle part. Repart de même.",
	["baerchi.RainbowBaerchi.desc"]       = "Toutes les couleurs. Tous les pouvoirs.",
	["baerchi.AncientBaerchi.desc"]       = "Était là avant l'invention des Gummies.",
	["baerchi.CosmicBaerchi.desc"]        = "Un morceau de ciel étoilé avec de la fourrure.",
	["baerchi.PhoenixBaerchi.desc"]       = "Tombe une fois. Se relève toujours.",
	["baerchi.GlacierBaerchi.desc"]       = "Là où il regarde, tout ralentit.",
	["baerchi.PhantomBaerchi.desc"]       = "On le voit à peine. Ses oeufs, si.",
	["baerchi.SeraphBaerchi.desc"]        = "Six ailes, un coeur de miel.",
	["baerchi.NorthernLightBaerchi.desc"] = "Danse dans le ciel, plus vite que l'oeil.",
	["baerchi.EclipseBaerchi.desc"]       = "Quand il arrive, il fait nuit en plein jour.",
	["baerchi.CometBaerchi.desc"]         = "Arrive avec fracas. Laisse un cratère.",
	["baerchi.NebulaBaerchi.desc"]        = "Une fourrure de poussière d'étoiles qui brûle.",
	["baerchi.PulsarBaerchi.desc"]        = "Bat comme une horloge. Chaque coup plus fort.",
	["baerchi.ShadeBaerchi.desc"]         = "Personne ne l'a jamais vu en entier.",
	["baerchi.RiddleBaerchi.desc"]        = "Répond à chaque question par une autre.",
	["baerchi.TitanBaerchi.desc"]         = "Porte des montagnes comme des oursons en gomme.",
	["baerchi.GenesisBaerchi.desc"]       = "Au commencement était le Baerchi.",
	["baerchi.ChronosBaerchi.desc"]       = "Arrive toujours pile à l'heure.",
	["baerchi.InfinityBaerchi.desc"]      = "Ne s'arrête jamais. Vraiment jamais.",
	["baerchi.OmegaBaerchi.desc"]         = "Le dernier Baerchi. Après, plus rien.",
	["egg.BasicEgg.desc"]                 = "Un oeuf tout à fait normal. Qu'en sortira-t-il ?",
	["egg.SugarEgg.desc"]                 = "Goût sucré. Le contenu aussi.",
	["egg.GoldenEgg.desc"]                = "Brille de façon suspecte. Rare ou mieux garanti.",
	["egg.PlatinumEgg.desc"]              = "Lourd comme du plomb, plus précieux que l'or.",
	["egg.SunEgg.desc"]                   = "Chaud dans la main. Très chaud.",
	["egg.ZenithEgg.desc"]                = "Le sommet de la voie de l'Or.",
	["egg.CrystalEgg.desc"]               = "Transparent. On voit presque ce qu'il contient.",
	["egg.PrismEgg.desc"]                 = "Décompose la lumière en sept couleurs.",
	["egg.AuroraEgg.desc"]                = "Brille comme le ciel du Nord.",
	["egg.MistEgg.desc"]                  = "Froid et humide au toucher.",
	["egg.VoidEgg.desc"]                  = "Plus noir que noir.",
	["egg.ShadowEgg.desc"]                = "Ne projette pas d'ombre. Il EN EST une.",
	["egg.AbyssEgg.desc"]                 = "Tout au fond. Rien en dessous.",
	["egg.CometEgg.desc"]                 = "Traîne une queue d'étincelles.",
	["egg.NovaEgg.desc"]                  = "Sur le point d'exploser.",
	["egg.GalaxyEgg.desc"]                = "Tout un univers dans une coquille.",
	["egg.AscensionEgg.desc"]             = "Mérité, pas acheté. Legendary garanti.",
	["egg.TranscendenceEgg.desc"]         = "Au-delà de tout ce qui s'achète.",
	["egg.EternityEgg.desc"]              = "Il a toujours été là. Il restera pour toujours.",
	["egg.OmegaEgg.desc"]                 = "Le dernier oeuf. 30 % Omega.",
	["egg.UfoJackpotEgg.desc"]            = "Largué par l'OVNI. Une trouvaille très rare.",
