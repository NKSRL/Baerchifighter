	----------------------------------------------------------------------------
	["ui.egg.full"] = "Almacén lleno — ¡recoge primero!",
	["ui.egg.soon"] = "Próximo huevo: ¡enseguida!",
	["ui.egg.next"] = "Próximo huevo: {time}",

