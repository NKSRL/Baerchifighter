						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">HatchPanel</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">791fef6ea3ff961e0aaa5df400000417</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXD968F049DD974D5F800771B18A727E9F">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Hud.luau
-- StarterPlayerScripts/UI/Hud.luau
--
-- Einzige Zustaendigkeit:
--   - Dauerhaft sichtbare Kopfzeile: Waehrungen, Rang, Rebirth-Multiplikator
--
-- Liest ausschliesslich aus ClientState und reagiert auf dessen onChanged —
-- die Anzeige rechnet nie selbst etwas hoch.
--
-- Die Rebirth-Pille rechts oben ist gleichzeitig der Knopf fuer den
-- Rebirth-Dialog: der Multiplikator ist genau die Zahl die ein Rebirth
-- erhoeht, also gehoert der Weg dorthin an dieselbe Stelle.
--
-- Die Y-Positionen der beiden Spalten sind bewusst Pixel-Offsets und keine
-- Scale-Werte: die MenuBar haengt direkt darunter und wuerde sonst je nach
-- Bildschirmhoehe in die Pillen rutschen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")

local Types = require(ReplicatedStorage.Network.Types)
local Loc   = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local Theme        = require(script.Parent.Theme)
local PanelManager = require(script.Parent.PanelManager)
local Icons        = require(script.Parent.Icons)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Unlock       = require(script.Parent.Unlock)

local Hud = {}

-- Merker auf die Labels, damit refresh() nicht jedes Mal suchen muss
local _gummyLabel: TextLabel?     = nil
local _goldLabel: TextLabel?      = nil
local _rankLabel: TextLabel?      = nil
local _multLabel: TextLabel?      = nil
local _languageButton: TextButton? = nil

-- HBB Paket 1: Ziel der fliegenden Icons (UI/Feedback). Schluessel = Art des
-- Gewinns ("gummies", "goldGummies", "rank", "rebirth").
local _pills: { [string]: Frame } = {}

-- HBB Paket 3: Pille → Element-Id der Freischaltung, und die "!"-Badges
local PILL_ELEMENT: { [string]: string } = {
	gummies = "pill_gummies", goldGummies = "pill_gold", rank = "pill_rank", rebirth = "pill_rebirth",
}
local _badges: { [string]: Frame } = {}
-- Eine Pille ohne Klick gilt nach so vielen Sekunden Sichtbarkeit als gesehen
local SEEN_AFTER_SECONDS = 4

local function makeBadge(pill: Frame): Frame
	local badge = Theme.panel("NewBadge", pill, Theme.COLORS.bad)
	badge.AnchorPoint = Vector2.new(1, 0)
	badge.Position    = UDim2.new(1, 6, 0, -6)
	badge.Size        = UDim2.fromOffset(20, 20)
	badge.ZIndex      = 6
	badge.Visible     = false
	Theme.corner(badge, 10)
	local bang = Theme.label("Bang", badge, "!")
	bang.Size = UDim2.fromScale(1, 1)
	bang.TextXAlignment = Enum.TextXAlignment.Center
	bang.ZIndex = 7
	return badge
end

local function refreshUnlocks()
	for kind, pill in _pills do
		local id = PILL_ELEMENT[kind]
		if id then
			Unlock.apply(id, pill)
			local badge = _badges[kind]
			if badge then
				local isNew = Unlock.isNew(id)
				badge.Visible = isNew
				if isNew and not badge:GetAttribute("Timer") then
					badge:SetAttribute("Timer", true)
					task.delay(SEEN_AFTER_SECONDS, function()
						Unlock.markSeen(id)
					end)
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Bausteine
--------------------------------------------------------------------------------

-- Eine "Pille": farbiger Kreis mit Symbol links, Wert rechts.
-- Gibt Wert-Label UND Pille zurueck — manche Pillen sind anklickbar.
local PILL_H = 40

-- Das Icon ragt links ueber den Rand der Pille hinaus (wie bei den grossen
-- Genre-Vorbildern): so wirkt die Zahl "an" das Symbol gehaengt statt in
-- einem Kasten zu stehen. Ohne Bild-Asset sitzt stattdessen ein farbiger
-- Kreis mit Kuerzel dort (Icons.make-Fallback).
local function makePill(parent: Instance, order: number, iconName: string, fallback: string, iconColor: Color3): (TextLabel, Frame)
	local pill = Theme.panel("Pill", parent, Theme.COLORS.panelDeep)
	pill.Size        = UDim2.new(1, 0, 0, PILL_H)
	pill.LayoutOrder = order

	local holder = Theme.container("IconHolder", pill)
	holder.AnchorPoint = Vector2.new(0, 0.5)
	holder.Position    = UDim2.new(0, -8, 0.5, 0)
	holder.Size        = UDim2.fromOffset(PILL_H + 12, PILL_H + 12)
	holder.ZIndex      = 4

	if Icons.has(iconName) then
		local icon = Icons.make(holder, iconName)
		icon.Size   = UDim2.fromScale(1, 1)
		icon.ZIndex = 4
	else
		local badge = Instance.new("Frame")
		badge.Name             = "Badge"
		badge.Size             = UDim2.fromScale(0.82, 0.82)
		badge.AnchorPoint      = Vector2.new(0.5, 0.5)
		badge.Position         = UDim2.fromScale(0.5, 0.5)
		badge.BackgroundColor3  = iconColor
		badge.BorderSizePixel   = 0
		badge.ZIndex            = 4
		badge.Parent            = holder
		Theme.corner(badge, 22)
		Theme.stroke(badge, Theme.COLORS.outline, 3)
		Theme.gradient(badge, Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 190, 200))

		local iconLabel = Icons.make(badge, iconName, fallback)
		iconLabel.Size     = UDim2.fromScale(0.7, 0.7)
		iconLabel.Position = UDim2.fromScale(0.15, 0.15)
		iconLabel.ZIndex   = 5
	end

	local value = Theme.label("Value", pill, "0")
	value.Position = UDim2.new(0, PILL_H + 8, 0, 3)
	value.Size     = UDim2.new(1, -(PILL_H + 16), 1, -6)
	value.ZIndex   = 3
	Theme.outlineText(value, 2)

	return value, pill
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

local function refresh(data: Types.PlayerDataUpdate)
	refreshUnlocks()
	if _gummyLabel then
		_gummyLabel.Text = Theme.formatNumber(data.gummies)
	end
	if _goldLabel then
		_goldLabel.Text = Theme.formatNumber(data.goldGummies)
	end
	if _rankLabel then
		-- Der Rang-NAME steht im Spielstand (englisch, als er vergeben wurde);
		-- angezeigt wird der uebersetzte Name zur Stufe, der gespeicherte nur
		-- als Rueckfall.
		_rankLabel.Text = Loc.name("rank." .. data.rank.tier, data.rank.name)
	end
	if _multLabel then
		_multLabel.Text = string.format("x%s  (%s)", Loc.formatDecimal(data.rebirthMult, 2), Loc.formatNumber(data.rebirthCount))
	end
end

-- Sprachwechsel: alles, was aus dem Spielstand gebaut wird, neu schreiben
-- und das Kuerzel auf dem Sprach-Knopf nachziehen.
local function onLanguageChanged()
	local data = ClientState.get()
	if data then
		refresh(data)
	end

	local button = _languageButton
	if button and not FeatureFlags.isOn("UI_V2_GUIDE") then
		button.Text = string.upper(Loc.getLanguage())
	end
end

--------------------------------------------------------------------------------
-- HBB Paket 1: Anker und Puls fuer fliegende Icons
--------------------------------------------------------------------------------

-- Die Pille, zu der ein Gewinn dieser Art fliegt (nil = keine Pille dafuer).
function Hud.getPillAnchor(kind: string): GuiObject?
	return _pills[kind]
end

-- Kurzes Aufpumpen der Pille, wenn ein Icon ankommt. Laeuft ueber eine
-- UIScale, damit Layout und Groesse der Pille unangetastet bleiben.
function Hud.pulse(kind: string)
	local pill = _pills[kind]
	if not pill then return end
	local scale = pill:FindFirstChild("PulseScale")
	if not scale then
		local created = Instance.new("UIScale")
		created.Name   = "PulseScale"
		created.Parent = pill
		scale = created
	end
	local uiScale = scale :: UIScale
	uiScale.Scale = 1.12
	TweenService:Create(uiScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function Hud.init(screenGui: ScreenGui)
	-- Links oben: Waehrungen
	local left = Theme.container("HudLeft", screenGui)
	left.AnchorPoint = Vector2.new(0, 0)
	-- +12 nach rechts: das Icon ragt links aus der Pille heraus
	left.Position    = UDim2.new(0.012, 12, 0, 12)
	left.Size        = UDim2.new(0.21, 0, 0, PILL_H * 2 + 6)

	local leftConstraint = Instance.new("UISizeConstraint")
	leftConstraint.MinSize = Vector2.new(150, 0)
	leftConstraint.MaxSize = Vector2.new(260, math.huge)
	leftConstraint.Parent  = left

	local leftLayout = Theme.listLayout(left, 6)
	leftLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local gummyPill, goldPill
	_gummyLabel, gummyPill = makePill(left, 1, "gummy", "G", Theme.COLORS.gummy)
	_goldLabel, goldPill   = makePill(left, 2, "goldgummy", "$", Theme.COLORS.goldGummy)
	_pills.gummies     = gummyPill
	_pills.goldGummies = goldPill

	-- Rechts oben: Rang und Rebirth
	local right = Theme.container("HudRight", screenGui)
	right.AnchorPoint = Vector2.new(1, 0)
	right.Position    = UDim2.new(0.988, 0, 0, 12)
	right.Size        = UDim2.new(0.24, 0, 0, PILL_H * 2 + 6)

	local rightConstraint = Instance.new("UISizeConstraint")
	rightConstraint.MinSize = Vector2.new(160, 0)
	rightConstraint.MaxSize = Vector2.new(280, math.huge)
	rightConstraint.Parent  = right

	local rightLayout = Theme.listLayout(right, 6)
	rightLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right

	local rankPill
	_rankLabel, rankPill = makePill(right, 1, "crown", "R", Theme.COLORS.accent)
	_pills.rank = rankPill

	local multLabel, multPill = makePill(right, 2, "rebirth", "*", Theme.COLORS.good)
	_multLabel = multLabel
	_pills.rebirth = multPill

	-- Die Pille selbst ist der Rebirth-Knopf. Ein durchsichtiger Button
	-- darueber, damit der Aufbau der Pille unveraendert bleibt.
	local rebirthHit = Instance.new("TextButton")
	rebirthHit.Name                   = "RebirthHit"
	rebirthHit.BackgroundTransparency = 1
	rebirthHit.Text                   = ""
	rebirthHit.Size                   = UDim2.fromScale(1, 1)
	rebirthHit.ZIndex                 = 3
	rebirthHit.Parent                 = multPill

	rebirthHit.Activated:Connect(function()
		Unlock.markSeen("pill_rebirth")
		PanelManager.toggle("Rebirth")
	end)

	for kind, pill in _pills do
		_badges[kind] = makeBadge(pill)
	end

	-- Sprach-Knopf: direkt unter den Waehrungs-Pillen, klein und unauffaellig.
	-- Zeigt das Kuerzel der aktiven Sprache und oeffnet die Auswahl.
	local languageButton = Theme.button("Language", screenGui, string.upper(Loc.getLanguage()), Theme.COLORS.panelLight)
	languageButton.AnchorPoint = Vector2.new(0, 0)
	languageButton.Position    = UDim2.new(0.012, 12, 0, 106)
	languageButton.Size        = UDim2.new(0, 70, 0, 30)
	languageButton.TextColor3  = Theme.COLORS.text
	languageButton.TextXAlignment = Enum.TextXAlignment.Right
	Theme.padding(languageButton, 0).PaddingRight = UDim.new(0, 10)
	if Icons.has("globe") then
		local globe = Icons.make(languageButton, "globe")
		globe.AnchorPoint = Vector2.new(0, 0.5)
		globe.Position    = UDim2.new(0, 6, 0.5, 0)
		globe.Size        = UDim2.fromOffset(22, 22)
	end
	languageButton.Activated:Connect(function()
		PanelManager.toggle("Language")
	end)
	_languageButton = languageButton

	-- HBB Paket 2: kein Globus mit Sprachkuerzel im HUD mehr, sondern ein
	-- kleines Zahnrad (gleiche Stelle, gleiche Funktion). Die Standardsprache
	-- bleibt die Roblox-Sprache des Clients. Eine eigene Profilkarte, in die
	-- eine Sprach-Zeile passen wuerde, gibt es nicht (ProfilePanel zeigt nur
	-- andere Spieler).
	if FeatureFlags.isOn("UI_V2_GUIDE") then
		for _, child in languageButton:GetChildren() do
			if child.Name == "Icon" then child:Destroy() end
		end
		languageButton.Text = "⚙"
		languageButton.TextXAlignment = Enum.TextXAlignment.Center
		languageButton.Size = UDim2.new(0, 30, 0, 30)
		local padding = languageButton:FindFirstChildOfClass("UIPadding")
		if padding then padding.PaddingRight = UDim.new(0, 0) end
	end

	-- Sofort mit dem aktuellen Stand fuellen, danach bei jeder Aenderung
	ClientState.onChanged(refresh)
	Loc.onChanged(onLanguageChanged)

	print("[Hud] Initialisiert")
end

return Hud
]]></ProtectedString>
						<string name="ScriptGuid">{E5835AF6-3BCD-4FED-ABF8-EE2A109F3278}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Hud</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">791fef6ea3ff961e0aaa5df400000418</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX114B89BA76ED4683B79FB3903335AEAC">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- MenuBar.luau
-- StarterPlayerScripts/UI/MenuBar.luau
--
-- Einzige Zustaendigkeit:
--   - Die schmale Kachelleiste am rechten Bildschirmrand: Eier und Baerchis
--
-- ============================================================
-- WARUM NUR ZWEI KACHELN
-- ============================================================
-- Vorher standen hier sieben Kacheln (Eier, Baerchis, Kampf, drei Gebaeude,
-- Arena). Fuer einen neuen Spieler war das eine Wand aus Knoepfen ohne Antwort
-- auf "was mache ich jetzt?". Drei Dinge sind weggefallen:
--   - Gebaeude und Arena: Man oeffnet sie, indem man am Gebaeude selbst den
--     Prompt benutzt (WorldController). Eine zweite Tuer dorthin ist ueberfluessig.
--   - Kampf: Die PetBar unten ist der bessere Kampf-Knopf.
-- Uebrig bleiben die zwei Dinge, die man von ueberall aus braucht: Eier
-- (zum Schluepfen) und Baerchis (Sammlung, Fusion und der Index).
--
-- Welches Panel offen ist, weiss weiterhin ausschliesslich der PanelManager.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local IncubatorRules   = require(ReplicatedStorage.Modules.IncubatorRules)   -- Sammel-Update 8
local IndexRewardConfig = require(ReplicatedStorage.Config.IndexRewardConfig) -- Sammel-Update 7
local BuildingBehavior  = require(ReplicatedStorage.Config.BuildingBehavior)
local FeatureFlags     = require(ReplicatedStorage.Config.FeatureFlags)
local Workspace        = game:GetService("Workspace")

local Theme        = require(script.Parent.Theme)
local UiScale      = require(script.Parent.UiScale)
local PanelManager = require(script.Parent.PanelManager)
local Icons        = require(script.Parent.Icons)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)
local Unlock       = require(script.Parent.Unlock)

-- HBB Paket 3: Kachel (Panel-Name) → Element-Id der Freischaltung
local TILE_ELEMENT: { [string]: string } = {
	Hatch = "tile_eggs", Inventory = "tile_bears", EggTree = "tile_tree",
	Leaderboard = "tile_leaderboard", DailyBonus = "tile_daily",
	Shop = "tile_shop",
	Incubator = "tile_incubator",   -- Sammel-Update Paket 8
}

local MenuBar = {}

-- Groessen. TILE ist gleichzeitig die Antippflaeche — darunter wird es auf dem
-- Handy zur Geduldsprobe.
-- HUD_ROW_V2: weniger Kacheln (Verbessern, Inkubator und Shop sind weg),
-- dafuer groesser. Die UIScale unten schrumpft weiterhin auf kleinen Fenstern.
local BIG    = FeatureFlags.isOn("HUD_ROW_V2")
local TILE   = if BIG then 70 else 54
local LABEL  = if BIG then 18 else 16
local GAP    = if BIG then 8 else 6
local WIDTH  = if BIG then 94 else 76

-- Was eine Kachel anzeigt: `value` ist die Beschriftung IN der Kachel,
-- `alert` laesst das rote Ausrufezeichen erscheinen.
type Live = (Types.PlayerDataUpdate) -> (string, boolean)

type Entry = {
	panel  : string,
	-- Beschriftung unter der Kachel. Eine Funktion statt eines Strings, weil
	-- sie bei jedem Sprachwechsel neu ausgewertet wird.
	title  : () -> string,
	color  : Color3,
	symbol : string,
	-- Name des Bild-Icons (siehe Icons); `symbol` ist der Text-Rueckfall
	icon   : string,
	live   : Live?,
}

type Tile = {
	entry : Entry,
	-- Die Beschriftung IN der Kachel ist das Text-Feld des Knopfes selbst: ein
	-- eigenes Label darueber wuerde die Klicks abfangen.
	tile  : TextButton,
	alert : Frame,
	label : TextLabel,
	-- true, wenn die Kachel ein Bild zeigt: dann bleibt ihr Text leer
	image : boolean,
}

local _tiles: { Tile } = {}
local buildAllEntries: () -> { Entry }

-- Sammel-Update 3.5: welches Gebaeude-Menue die Kachel oeffnet
local function buildingPanel(): string
	return PanelManager.buildingPanelName(if FeatureFlags.isOn("HONEY_POND_V2") then "HoneyPond" else "HoneyRefiner")
end
TILE_ELEMENT[buildingPanel()] = "tile_building"

--------------------------------------------------------------------------------
-- Die Eintraege
--------------------------------------------------------------------------------

local function buildEntries(): { Entry }
	local list = buildAllEntries()
	-- HUD_ROW_V2: Honig-Brunnen und Inkubator benutzt man vor Ort (Prompt am
	-- Plot), der Shop sitzt in der Knopf-Zeile oben links (Hud).
	local hidden: { [string]: boolean } = {}
	if not FeatureFlags.isOn("INCUBATOR") then hidden.Incubator = true end
	if BIG then
		hidden.Incubator = true
		hidden.Shop = true
		hidden[buildingPanel()] = true
	end
	for i = #list, 1, -1 do
		if hidden[list[i].panel] then table.remove(list, i) end
	end
	return list
end

function buildAllEntries(): { Entry }
	return {
		{ panel = "Hatch",     title = function() return Loc.t("ui.menu.eggs") end,     color = Theme.COLORS.gummy,  symbol = "EI", icon = "egg" },
		-- Sammel-Update 05.10. (Paket 7): "!" = eine Index-Belohnung ist abholbar.
		{ panel = "Inventory", title = function() return Loc.t("ui.menu.baerchis") end, color = Theme.COLORS.accent, symbol = "BA", icon = "bear",
			live = function(data: Types.PlayerDataUpdate)
				if not FeatureFlags.isOn("INDEX_REWARDS") then return "BA", false end
				return "BA", #IndexRewardConfig.claimable(data.discovered, data.indexClaimed) > 0
			end },
		-- Sammel-Update 05.10. (Paket 3.5/3.6): das Honig-Gebaeude als Kachel
		-- (Verbessern ohne hinzulaufen). "!" = Ausbau bezahlbar.
		{ panel = buildingPanel(), title = function() return Loc.t("ui.menu.building") end, color = Theme.COLORS.goldGummy, symbol = "⬆", icon = "upgrade",
			live = function(data: Types.PlayerDataUpdate)
				local id = if FeatureFlags.isOn("HONEY_POND_V2") then "HoneyPond" else "HoneyRefiner"
				local building = data.island.buildings[id :: any]
				if not building then return "⬆", false end
				local cost = BuildingBehavior.getUpgrade(id :: any, building.level + 1)
				return "⬆", cost ~= nil and data.gummies >= cost.costGummies and data.goldGummies >= (cost.costGoldGummies or 0)
			end },
		-- Sammel-Update 05.10. (Paket 8): Inkubator ("!" = ein Ei ist fertig).
		{ panel = "Incubator", title = function() return Loc.t("ui.incubator.tile") end, color = Theme.COLORS.growth, symbol = "⏳", icon = "incubator",
			live = function(data: Types.PlayerDataUpdate)
				local incubator = data.island.incubator
				if not incubator then return "⏳", false end
				local now = Workspace:GetServerTimeNow()
				local ready = false
				for _, entry in incubator.slots do
					if IncubatorRules.isReady(entry, now) then ready = true end
				end
				return "⏳", ready
			end },
		-- v14: Ei-Baum. Das "!" zeigt eine ungenutzte Blaupause an.
		{ panel = "EggTree", title = function() return Loc.t("ui.menu.tree") end, color = Theme.COLORS.growth, symbol = "BAUM", icon = "tree",
			live = function(data: Types.PlayerDataUpdate)
				local bp = if data.eggTree then data.eggTree.blueprints or 0 else 0
				return "BAUM", bp > 0
			end },
		-- v15: Bestenlisten und Login-Bonus ("!" = heute noch nicht abgeholt)
		{ panel = "Leaderboard", title = function() return Loc.t("ui.menu.leaderboard") end, color = Theme.COLORS.goldGummy, symbol = "TOP", icon = "trophy" },
		{ panel = "DailyBonus", title = function() return Loc.t("ui.menu.daily") end, color = Theme.COLORS.gummy, symbol = "7", icon = "gift",
			live = function(data: Types.PlayerDataUpdate)
				local daily = data.daily
				return if daily then tostring(daily.day) else "7", daily ~= nil and daily.claimable
			end },
		-- HBB Paket 10: Shop ("!" = Gratis-Griff heute noch offen). Sichtbar ab
		-- der 2. Sitzung und nur mit SHOP_V1 (UnlockRules "tile_shop").
		{ panel = "Shop", title = function() return Loc.t("ui.menu.shop") end, color = Theme.COLORS.goldGummy, symbol = "GG", icon = "goldgummy",
			live = function(data: Types.PlayerDataUpdate)
				local shop = data.shop
				return "GG", shop ~= nil and shop.freeReady
			end },
	}
end

--------------------------------------------------------------------------------
-- Eine Kachel
--------------------------------------------------------------------------------

local function buildTile(parent: Instance, order: number, entry: Entry): Tile
	local slot = Theme.container("Slot_" .. entry.panel, parent)
	slot.Size        = UDim2.new(1, 0, 0, TILE + LABEL + 2)
	slot.LayoutOrder = order

	local button = Theme.button("Tile", slot, entry.symbol, entry.color)
	button.AnchorPoint = Vector2.new(0.5, 0)
	button.Position    = UDim2.new(0.5, 0, 0, 0)
	button.Size        = UDim2.new(0, TILE, 0, TILE)
	button.TextColor3  = Theme.COLORS.outline
	Theme.gradient(button, Theme.shade(entry.color, 0.34), Theme.shade(entry.color, -0.16))

	-- Bild-Icon gross in die Kachel. Ohne Asset bleibt das Text-Kuerzel stehen.
	local hasImage = Icons.has(entry.icon)
	if hasImage then
		button.Text = ""
		local icon = Icons.make(button, entry.icon)
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position    = UDim2.fromScale(0.5, 0.52)
		icon.Size        = UDim2.fromScale(0.86, 0.86)
		icon.ZIndex      = 3
	end

	button.Activated:Connect(function()
		local element = TILE_ELEMENT[entry.panel]
		if element then Unlock.markSeen(element) end
		PanelManager.toggle(entry.panel)
	end)

	-- Rotes Ausrufezeichen oben rechts, wie man es aus dem Genre kennt.
	-- Startet unsichtbar und wird von refresh() geschaltet.
	local alert = Theme.panel("Alert", slot, Theme.COLORS.bad)
	alert.AnchorPoint = Vector2.new(1, 0)
	alert.Position    = UDim2.new(0.5, TILE * 0.5 + 5, 0, -4)
	alert.Size        = UDim2.new(0, 20, 0, 20)
	alert.Visible     = false
	alert.ZIndex      = 3
	Theme.corner(alert, 10)

	local bang = Theme.label("Bang", alert, "!")
	bang.Size           = UDim2.fromScale(1, 1)
	bang.TextXAlignment = Enum.TextXAlignment.Center
	bang.ZIndex         = 4

	local label = Theme.label("Name", slot, entry.title())
	label.Position       = UDim2.new(0, 0, 0, TILE + 1)
	label.Size           = UDim2.new(1, 0, 0, LABEL)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextScaled     = false
	label.TextSize       = if BIG then 16 else 14
	Theme.outlineText(label)

	return { entry = entry, tile = button, alert = alert, label = label, image = hasImage }
end

--------------------------------------------------------------------------------
-- Aktualisieren
--------------------------------------------------------------------------------

local function refresh(data: Types.PlayerDataUpdate)
	for _, tile in _tiles do
		-- HBB Paket 3: Kachel erst zeigen, wenn sie gebraucht wird; neue
		-- Kacheln tragen das "!" bis zum ersten Antippen.
		local element = TILE_ELEMENT[tile.entry.panel]
		local isNew = false
		if element then
			local slot = tile.tile.Parent
			if slot and slot:IsA("GuiObject") then
				Unlock.apply(element, slot)
			end
			isNew = Unlock.isNew(element)
			tile.alert.Visible = isNew
		end

		local live = tile.entry.live
		if live then
			local ok, value, alert = pcall(live, data)

			-- In pcall: eine kaputte Kachel darf nicht die ganze Leiste
			-- lahmlegen. Ein alter Spielstand ohne ein Gebaeude waere sonst
			-- genau so ein Fall.
			if ok then
				if not tile.image then
					tile.tile.Text = value
				end
				tile.alert.Visible = alert or isNew
			end
		end
	end
end

--------------------------------------------------------------------------------
-- HBB Paket 1: Ziel fliegender Icons (Eier fliegen zur Eier-Kachel)
--------------------------------------------------------------------------------

function MenuBar.getTileAnchor(panel: string): GuiObject?
	for _, tile in _tiles do
		if tile.entry.panel == panel then
			return tile.tile
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Aufbau
--------------------------------------------------------------------------------

function MenuBar.init(screenGui: ScreenGui)
	local entries = buildEntries()
	local slot    = TILE + LABEL + 2
	local height  = #entries * slot + (#entries - 1) * GAP

	local root = Theme.container("MenuBar", screenGui)
	root.AnchorPoint = Vector2.new(1, 0)
	-- Rechte Kante, unter den Rang-/Rebirth-Pillen. Y bewusst als Pixel-Offset:
	-- die Pillen darueber sind ebenfalls pixelhoch, mit Scale wuerde die Leiste
	-- je nach Bildschirmhoehe hineinrutschen.
	root.Position = UDim2.new(0.988, 0, 0, 108)
	root.Size     = UDim2.new(0, WIDTH, 0, height)

	local layout = Theme.listLayout(root, GAP)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	-- Auf niedrigen Fenstern (Handy quer, kleines Studio-Fenster) schrumpfen,
	-- damit die Leiste nicht ueber den unteren Rand ragt.
	local scale = Instance.new("UIScale")
	scale.Parent = root
	local function rescale()
		local room = UiScale.toGui(screenGui.AbsoluteSize.Y) - 108 - 12
		scale.Scale = math.clamp(room / height, 0.55, 1)
	end
	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
	rescale()

	for order, entry in entries do
		table.insert(_tiles, buildTile(root, order, entry))
	end

	ClientState.onChanged(refresh)

	-- HBB Paket 3: ein Panel, das sich von selbst oeffnet (Login-Bonus u.a.), gilt
	-- ebenso als gesehen wie eines, das per Kachel geoeffnet wurde.
	PanelManager.onOpened(function(name)
		local element = TILE_ELEMENT[name]
		if element then Unlock.markSeen(element) end
	end)

	-- Sprachwechsel: nur die Beschriftungen neu setzen (die Zahlen in den
	-- Kacheln sind sprachunabhaengig)
	Loc.onChanged(function()
		for _, tile in _tiles do
			tile.label.Text = tile.entry.title()
		end
	end)

	print("[MenuBar] Initialisiert |", #entries, "Kacheln")
end

return MenuBar
]]></ProtectedString>
						<string name="ScriptGuid">{36151B2F-DF26-47A8-8104-449F203248B8}</string>
