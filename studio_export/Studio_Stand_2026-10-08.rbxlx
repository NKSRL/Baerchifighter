	-- KOSMOS-PFAD (Allrounder)
	-- ============================================================
	CometEgg = {
		id = "CometEgg", displayName = "Kometen-Ei", path = "Kosmos", parent = nil, tier = 7, sortOrder = 14,
		description = "Zieht einen Schweif aus Funken hinter sich her.",
		color = Color3.fromRGB(120, 180, 255), shortName = "Komet", hatchTable = {},
	},
	NovaEgg = {
		id = "NovaEgg", displayName = "Nova-Ei", path = "Kosmos", parent = "CometEgg", tier = 8, sortOrder = 15,
		description = "Kurz vor dem Explodieren.",
		color = Color3.fromRGB(255, 240, 255), shortName = "Nova", hatchTable = {},
	},
	GalaxyEgg = {
		id = "GalaxyEgg", displayName = "Galaxie-Ei", path = "Kosmos", parent = "NovaEgg", tier = 9, sortOrder = 16,
		description = "Ein ganzes Universum in einer Schale.",
		color = Color3.fromRGB(110, 40, 180), shortName = "Galaxie", hatchTable = {},
	},

	-- ============================================================
	-- ASCENSIONS-PFAD (nur Rebirth)
	-- ============================================================
	AscensionEgg = {
		id = "AscensionEgg", displayName = "Ascensions-Ei", path = "Ascension", parent = nil, tier = 5, sortOrder = 17,
		description = "Verdient, nicht gekauft. Legendary garantiert.",
		color = Color3.fromRGB(196, 128, 255), shortName = "Ascension", hatchTable = {},
	},
	TranscendenceEgg = {
		id = "TranscendenceEgg", displayName = "Transzendenz-Ei", path = "Ascension", parent = "AscensionEgg", tier = 9, sortOrder = 18,
		description = "Jenseits von allem, was man kaufen kann.",
		color = Color3.fromRGB(255, 200, 255), shortName = "Transz.", hatchTable = {},
	},
	EternityEgg = {
		id = "EternityEgg", displayName = "Ewigkeits-Ei", path = "Ascension", parent = "TranscendenceEgg", tier = 10, sortOrder = 19,
		description = "Es war schon immer da. Es bleibt fuer immer.",
		color = Color3.fromRGB(255, 120, 40), shortName = "Ewigkeit", hatchTable = {},
	},
	OmegaEgg = {
		id = "OmegaEgg", displayName = "Omega-Ei", path = "Ascension", parent = "EternityEgg", tier = 11, sortOrder = 20,
		description = "Das letzte Ei. 30% Omega.",
		color = Color3.fromRGB(255, 255, 255), shortName = "Omega", hatchTable = {},
	},

	-- ============================================================
	-- SONDER-EIER (v17, nicht im Baum)
	-- ============================================================
	UfoJackpotEgg = {
		id = "UfoJackpotEgg", displayName = "UFO-Jackpot-Ei", path = "Event", parent = nil, tier = 0, sortOrder = 21,
		description = "Vom UFO abgeworfen. Ein ganz seltener Fund.",
		color = Color3.fromRGB(255, 214, 60), shortName = "Jackpot", hatchTable = {},
		special = true,
	},
}

--------------------------------------------------------------------------------
-- Freischaltung (TREE)
--------------------------------------------------------------------------------
--
-- Ein Knoten wird frei, wenn ALLE Bedingungen gelten:
--   hatch     Vorgaenger-Eier so oft GEOEFFNET (eggTree.hatched). Bei
--             `hatchAnyOf` reicht es, wenn `need` der Eintraege erfuellt sind
--             (Kometen-Ei: zwei der drei Endeier).
--   index     so viele VERSCHIEDENE Baerchis dieser Rarity entdeckt (Index)
--   rebirth   mindestens so viele Rebirths
--
-- Eine Blaupause ersetzt hatch und index, NICHT das Rebirth-Gate.
-- Einmal frei, bleibt ein Knoten frei (auch nach Rebirth).
--
-- Die Hatch-Zahlen sind mit tools/sim/egg_tree_sim.lua gegen die echten
-- Lege-Intervalle bestimmt (siehe Bericht MEGA_EGG_TREE_UMGESETZT): die
-- Platzhalter aus dem Konzept (15, 12, 10, 6 ...) waren so klein, dass der
-- ganze Baum ohne Rebirth-Gates in ~16 Spielstunden frei war — die Eier
-- haetten nie gebremst. Jetzt braucht das Ei-Sammeln etwa die Haelfte bis
-- zwei Drittel der Zeit bis zum jeweiligen Rebirth-Gate, beides zaehlt.

export type HatchReq = { egg: Types.EggType, count: number }
export type TreeNode = {
	hatch      : { HatchReq }?,
	hatchAnyOf : { need: number, of: { HatchReq } }?,
	index      : { rarity: Types.Rarity, count: number }?,
	rebirth    : number?,
	start      : boolean?,        -- von Anfang an frei
}

local TREE: { [Types.EggType]: TreeNode } = {
	BasicEgg    = { start = true },
	SugarEgg    = { start = true },

	GoldenEgg   = { hatch = { { egg = "SugarEgg",    count = 15 } }, index = { rarity = "Rare",      count = 1 } },
	PlatinumEgg = { hatch = { { egg = "GoldenEgg",   count = 25 } }, index = { rarity = "Epic",      count = 2 } },
	SunEgg      = { hatch = { { egg = "PlatinumEgg", count = 25 } }, index = { rarity = "Legendary", count = 2 }, rebirth = 3 },
	ZenithEgg   = { hatch = { { egg = "SunEgg",      count = 40 } }, index = { rarity = "Mythic",    count = 2 }, rebirth = 6 },

	CrystalEgg  = { hatch = { { egg = "GoldenEgg",   count = 20 } }, index = { rarity = "Legendary", count = 1 } },
	PrismEgg    = { hatch = { { egg = "CrystalEgg",  count = 30 } }, index = { rarity = "Legendary", count = 2 }, rebirth = 3 },
	AuroraEgg   = { hatch = { { egg = "PrismEgg",    count = 40 } }, index = { rarity = "Mythic",    count = 2 }, rebirth = 6 },

	MistEgg     = { hatch = { { egg = "SugarEgg",    count = 15 } }, index = { rarity = "Epic",      count = 1 } },
	VoidEgg     = { hatch = { { egg = "MistEgg",     count = 20 } }, index = { rarity = "Legendary", count = 1 }, rebirth = 2 },
	ShadowEgg   = { hatch = { { egg = "VoidEgg",     count = 40 } }, index = { rarity = "Mythic",    count = 2 }, rebirth = 6 },
	AbyssEgg    = { hatch = { { egg = "ShadowEgg",   count = 40 } }, index = { rarity = "Divine",    count = 2 }, rebirth = 8 },

	CometEgg    = {
		hatchAnyOf = { need = 2, of = {
			{ egg = "ZenithEgg", count = 30 },
			{ egg = "AuroraEgg", count = 30 },
			{ egg = "AbyssEgg",  count = 30 },
		} },
		index = { rarity = "Divine", count = 3 }, rebirth = 10,
	},
	NovaEgg     = { hatch = { { egg = "CometEgg", count = 120 } }, index = { rarity = "Cosmic", count = 3 }, rebirth = 15 },
	GalaxyEgg   = { hatch = { { egg = "NovaEgg",  count = 200 } }, index = { rarity = "Secret", count = 2 }, rebirth = 25 },

	AscensionEgg     = { rebirth = 1 },
	TranscendenceEgg = { rebirth = 15 },
	EternityEgg      = { rebirth = 30 },
	OmegaEgg         = { rebirth = 50 },
}

-- Kinder je Ei (fuer Panel und "naechste Stufe"). Kometen-Ei hat keinen
-- parent, haengt im Panel aber an allen drei Endeiern.
local CHILDREN: { [string]: { Types.EggType } } = {}

--------------------------------------------------------------------------------
-- hatchTables BERECHNEN
--------------------------------------------------------------------------------

local function buildHatchTables()
	-- Baerchis je Rarity, deterministisch sortiert.
	local byRarity: { [string]: { any } } = {}
	for id, def in BaerchiConfig.data do
		byRarity[def.rarity] = byRarity[def.rarity] or {}
		table.insert(byRarity[def.rarity], def)
	end
	for _, list in byRarity do
		table.sort(list, function(a, b) return a.id < b.id end)
	end

	for eggId, egg in EGGS do
		local dist = RARITY_DIST[eggId]
		local hatch: HatchTable = {}
		for rarity, percent in dist do
			local pets = byRarity[rarity]
			assert(pets and #pets > 0, "EggConfig: keine Baerchis der Rarity " .. rarity .. " fuer " .. eggId)
			local total = 0
			local weights = {}
			for _, def in pets do
				local w = 1
				if egg.path ~= "Ascension" and def.path == egg.path then
					w = PATH_MATCH_WEIGHT
				end
				weights[def.id] = w
				total += w
			end
			for id, w in weights do
				hatch[id] = (hatch[id] or 0) + percent * w / total
			end
		end
		egg.hatchTable = hatch
	end

	-- eggSource der Baerchis nachtragen (frueher von Hand gepflegt).
	for _, def in BaerchiConfig.data do
		table.clear(def.eggSource)
	end
	local eggIds = {}
	for eggId in EGGS do table.insert(eggIds, eggId) end
	table.sort(eggIds, function(a, b) return EGGS[a].sortOrder < EGGS[b].sortOrder end)
	for _, eggId in eggIds do
		for configId in EGGS[eggId].hatchTable do
			local def = BaerchiConfig.data[configId]
			if def then table.insert(def.eggSource, eggId) end
		end
	end

	for eggId, egg in EGGS do
		if egg.parent then
			CHILDREN[egg.parent] = CHILDREN[egg.parent] or {}
			table.insert(CHILDREN[egg.parent], eggId)
		end
	end
	for _, list in CHILDREN do
		table.sort(list, function(a, b) return EGGS[a].sortOrder < EGGS[b].sortOrder end)
	end
end

buildHatchTables()

-- Alle Ei-IDs des BAUMS in Anzeige-Reihenfolge (ohne Sonder-Eier: Baum,
-- Freischaltung, Sprung-Ei und Panel kennen nur diese).
local function getOrderedIds(): { Types.EggType }
	local ids: { Types.EggType } = {}
	for eggId, egg in EGGS do
		if not egg.special then table.insert(ids, eggId) end
	end
	table.sort(ids, function(a, b) return EGGS[a].sortOrder < EGGS[b].sortOrder end)
	return ids
end

local function getChildren(eggType: Types.EggType): { Types.EggType }
	return CHILDREN[eggType] or {}
end

-- Die "naechste Stufe" eines Eis im SELBEN Pfad (Ei-Presse, Lege-Aufstieg).
-- Golden hat zwei Kinder (Platin im eigenen Pfad, Kristall im naechsten):
-- bevorzugt wird das Kind im eigenen Pfad. Fuer Stamm-Eier (Zucker) und
-- Endeier gibt es mehrere bzw. keine — dann entscheidet `preferPath`
-- bzw. es gibt nil.
local function getNextInPath(eggType: Types.EggType, preferPath: string?): Types.EggType?
	local egg = EGGS[eggType]
	if not egg then return nil end
	local kids = CHILDREN[eggType]
	if not kids or #kids == 0 then return nil end
	local want = preferPath or egg.path
	for _, kid in kids do
		if EGGS[kid].path == want then return kid end
	end
	-- Zucker-Ei ohne Wunsch-Pfad: zwei Wege (Gold oder Void), keiner ist "der"
	-- naechste. Der Aufrufer muss einen Pfad angeben.
	return nil
end

--------------------------------------------------------------------------------
-- Ei-Presse (v14)
--------------------------------------------------------------------------------
-- 5 gleiche Eier werden zu 1 Ei der naechsten Stufe im selben Pfad gepresst.
-- Nur, wenn das Ziel-Ei schon freigeschaltet ist, und nie im Ascensions-Pfad
-- (dessen Eier gibt es nur ueber Rebirth-Meilensteine). Beim Zucker-Ei
-- waehlt der Spieler, ob Gold- oder Void-Pfad.
local PRESS = {
	cost          = 5,
	blockedPaths  = { Ascension = true, Event = true },
	-- Playtest 05.10. (Schalter PRESS_NO_BASIC_EGG): Basis-Eier gibt es beim
	-- Haendler unbegrenzt fuer Gummies. Waeren sie pressbar, liesse sich jedes
	-- Gummi-Polster ueber die Presse in immer bessere Eier tauschen.
	blockedEggs   = { BasicEgg = true } :: { [string]: boolean },
}

-- Darf `eggType` gepresst werden? Einzige Regel fuer Server (EggTreeService)
-- und Anzeige (EggTreePanel).
local function canPress(eggType: Types.EggType): boolean
	local egg = EGGS[eggType]
	if not egg or PRESS.blockedPaths[egg.path] then return false end
	if PRESS.blockedEggs[eggType] and FeatureFlags.isOn("PRESS_NO_BASIC_EGG") then return false end
	return true
end

-- Hilfsfunktion: Hatch-Table als normalisierte Gewichtungs-Liste
-- GachaRoller benutzt dies direkt
local function getNormalizedTable(eggType: Types.EggType): { configId: string, weight: number }
	local def = EGGS[eggType]
	assert(def, "EggConfig: unbekannter EggType " .. eggType)

	local total = 0
	for _, w in def.hatchTable do total += w end

	local result = {}
	for id, w in def.hatchTable do
		table.insert(result, { configId = id, weight = w / total })
	end
	return result
end

--------------------------------------------------------------------------------
-- EIER LEGEN
--------------------------------------------------------------------------------
--
-- Der ausgeruestete Baerchi legt regelmaessig ein Ei dort ab, wo er gerade
-- steht. Es bleibt als anklickbares Objekt in der Welt liegen, bis der Spieler
-- es einsammelt — dann landet es in island.eggStock und laesst sich wie ein
-- gekauftes Ei ausbrueten.
--
-- Die Zahlen HIER gelten fuer alle Baerchis. Was ein EINZELNER legt und wie
-- schnell, steht bei ihm in BaerchiConfig (layIntervalSeconds / eggTable).
--
-- ============================================================
-- WARUM DAS LEVEL HIER LINEAR WIRKT UND NICHT EXPONENTIELL
-- ============================================================
-- HP und ATK wachsen mit 1.1^(level-1), auf Level 50 also auf das 106-fache.
-- Das ist dort richtig, weil die PIT-Gegner mit derselben Kurve mitwachsen —
-- es gibt eine Gegenseite.
--
-- Beim Ei-Legen gibt es die nicht. Dieselbe Kurve wuerde bedeuten: ein
-- Level-50-Baerchi legt 106-mal so schnell, also alle zwei bis neun Sekunden.
-- Der individuelle Grundwert jedes Baerchis waere damit bedeutungslos, und die
-- Obergrenze unten waere binnen einer Minute erreicht — die ganze Mechanik
-- liefe leer.
--
-- Deshalb addiert jedes Level hier 10% des GRUNDWERTS statt 10% des Vorwerts:
-- auf Level 50 legt ein Baerchi knapp 6-mal so schnell wie auf Level 1. Das
-- ist spuerbar, laesst die Unterschiede zwischen den Baerchis aber bestehen.
--
-- Wer das doch exponentiell haben will: LAY_LEVEL_GAIN durch
-- CombatCalculator.getLevelGrowth ersetzen — es ist genau eine Zeile in
-- EggCalculator.
local LAY_LEVEL_GAIN = 0.10

-- Was eine EGG-Stat-Stufe bringt (waechst ueber Event-Teilnahme, gedeckelt
-- durch die Rarity — siehe PromotionConfig). Ein Legendary am Cap (24) legt
-- damit knapp dreimal so schnell.
--
-- Die Zahl steht bewusst NICHT in PromotionConfig.STAT_LEVEL_GAIN wie die
-- vier Kampf-Stats: die wirken alle in CombatCalculator, diese hier wirkt
-- ausschliesslich im Ei-System. Sie neben den Kampfwerten abzulegen waere die
-- naechste Stelle, an der jemand beim Balancing am falschen Wert dreht.
local LAY_STAT_LEVEL_GAIN = 0.08

-- Wie viel langsamer offline gelegt wird.
--
-- Die Produktion laeuft weiter, waehrend der Spieler weg ist (dasselbe
-- Zeitstempel-Verfahren wie beim Honig, kein Server-Loop noetig) — aber
-- gebremst. Anwesenheit soll sich lohnen, ohne dass Abwesenheit bestraft wird.
-- Sammel-Update 05.10. (Paket 6.1): 2,5 -> 3,5 (Offline-Rate 40 % -> ca. 29 %).
-- "Man kommt wieder und hat direkt ganz viele Eier. Wozu spielt man dann noch?"
local OFFLINE_SLOWDOWN = 3.5

-- Sammel-Update 05.10. (Paket 6.1): eigene Obergrenze fuers Offline-Legen.
-- Eine reine Prozent-Senkung verlaengert nur die Zeit bis "voll" — ein
-- starker Baerchi fuellt die 12 Plaetze trotzdem ueber Nacht. Offline legt er
-- deshalb hoechstens bis 6 liegende Eier, online weiter bis 12. Liegen schon
-- mehr als 6, kommt offline nichts dazu (es wird nichts weggenommen).
local OFFLINE_MAX_EGGS = 6

-- Sammel-Update 05.10. (Paket 6.5, Annahme "brueten" = LEGEN): niedrige
-- Rarities legen schneller, damit der Anfang nicht zaeh ist. Faktor auf das
-- Grundintervall (BaerchiConfig.layIntervalSeconds), fehlende Rarity = 1.
-- Common 240-300 s -> 144-180 s, Uncommon 330-360 s -> ca. 230-250 s,
-- Rare 360-420 s -> ca. 300-350 s. Ab Epic unveraendert, damit die
-- Freischalt-Zeiten im Ei-Baum (tools/sim/egg_tree_sim.lua) nicht kippen.
local LAY_RARITY_FACTOR: { [string]: number } = {
	Common   = 0.60,
	Uncommon = 0.70,
	Rare     = 0.82,
}

-- Wie viele NICHT eingesammelte Eier gleichzeitig herumliegen duerfen.
--
-- Ist die Grenze erreicht, hoert der Baerchi auf zu legen — genau wie ein
-- volles Honig-Lager die Produktion anhaelt. Laenger wegbleiben bringt also
-- nichts zusaetzlich, und der Plot wird nie zum Ei-Teppich.
local MAX_UNCOLLECTED_EGGS = 12

-- Absolute Untergrenze, egal wie viel Level, Stufen und Charms
-- zusammenkommen. Reines Sicherheitsnetz gegen eine Kombination, an die beim
-- Balancing niemand gedacht hat — kein Balancing-Wert.
local MIN_LAY_INTERVAL_SECONDS = 15

-- Wie weit ein gelegtes Ei seitlich neben dem Baerchi landet (Studs). Ohne
-- diesen Versatz laegen mehrere Eier exakt uebereinander, wenn der Baerchi
-- laenger an derselben Stelle steht.
local LAY_SCATTER_RADIUS = 4.5

-- Groesse des Eis in der Welt. Bewusst klein: es sollen bis zu zwoelf davon
-- auf einem Plot liegen koennen, ohne dass man den Baerchi nicht mehr sieht.
local LAY_EGG_SIZE = Vector3.new(1.7, 2.3, 1.7)

-- Ab welcher Entfernung die Beschriftung ueber einem Ei ausgeblendet wird.
local LAY_LABEL_DISTANCE = 60

-- Gewichtete Ei-Auswahl fuer einen Baerchi.
--
-- `eggTable` kommt aus BaerchiConfig und ist pro Baerchi verschieden. Die
-- Gewichte muessen sich zu nichts Bestimmtem addieren — hier wird normalisiert,
-- damit man in der Config mit runden Zahlen arbeiten kann.
--
-- Gibt nil zurueck, wenn die Tabelle leer oder unbrauchbar ist. Der Aufrufer
-- legt dann kein Ei, statt eines zu erfinden.
local function rollEggType(eggTable: { { eggType: Types.EggType, weight: number } }): Types.EggType?
	local total = 0
	for _, entry in eggTable do
		if entry.weight > 0 then
			total += entry.weight
		end
	end

	if total <= 0 then
		return nil
	end

	local roll        = math.random() * total
	local accumulated = 0

	for _, entry in eggTable do
		if entry.weight > 0 then
			accumulated += entry.weight
			if roll < accumulated then
				return entry.eggType
			end
		end
	end

	-- Rundungsrest: der letzte gueltige Eintrag.
	for i = #eggTable, 1, -1 do
		if eggTable[i].weight > 0 then
			return eggTable[i].eggType
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- VERSTECKTER BASIS-EI-HAENDLER (v12)
--------------------------------------------------------------------------------
--
-- Die einzige Kaufmoeglichkeit fuer ein Ei im ganzen Spiel. Bewusst ohne
-- Marker, ohne Menue-Eintrag und ohne HUD-Hinweis: die meisten Spieler
-- brauchen ihn nie, weil ihr ausgeruesteter Baerchi Eier legt und nie
-- verwertet werden kann. Er ist ein Notanker, kein Laden.
--
-- Lage: am Rand der Hauptinsel, genau zwischen zwei Plot-Stegen (die Stege
-- liegen bei 0, 45, 90 ... Grad, der Haendler bei 157,5 Grad, also mittig
-- dazwischen). Dort laeuft niemand auf dem Weg zum eigenen Plot vorbei.
-- ANNAHME: der genaue Ort war offen (EI_BAUM_KONZEPT, Abschnitt 12), das ist
-- mein Vorschlag und laesst sich hier mit zwei Zahlen verschieben.
local MERCHANT = {
	eggType          = "BasicEgg" :: Types.EggType,
	priceGummies     = 50,      -- heutiger Basis-Preis, anpassbar
	angleDegrees     = 157.5,   -- Winkel um die Weltmitte (siehe oben)
	radius           = 108,     -- Abstand zur Weltmitte, knapp vor der Sandkante (Inselradius 120)
	promptDistance   = 8,       -- ab hier erscheint "E" am Stand
	-- Der Server prueft die Entfernung zusaetzlich selbst: ein Kauf von weiter
	-- weg wird abgelehnt, egal was der Client behauptet. Etwas groesser als
	-- promptDistance, damit Latenz keinen ehrlichen Kauf scheitern laesst.
	maxBuyDistance   = 14,
}

-- HBB Paket 5 (MAP_V2_MERCHANT): sichtbarer Standort des Haendlers. Auf dem
-- Ring zwischen Event-Pit-Zaun (Radius 50) und Bestenlisten-Tafel (Radius 80,
-- 22,5 Grad), mittig zwischen zwei Stegen (alle 45 Grad, Luecke +-9 Grad):
-- jeder, der zum Event laeuft, kommt daran vorbei. Abstand zur Tafel ca. 59
-- Studs, zum Pit-Zaun ca. 16 Studs. Mit dem Flag aus gilt MERCHANT oben.
-- Das Schild ueber dem Stand zeigt nur ein Ei (Bild, kein Text).
local MERCHANT_V2 = {
	angleDegrees = 67.5,
	radius       = 66,
	signImage    = "rbxassetid://136964848925363",   -- dasselbe Ei wie UI/Icons.egg
	signHeight   = 9,
	signSize     = 5,     -- Studs
}

return {
	data               = EGGS,
	MERCHANT           = MERCHANT,
	MERCHANT_V2        = MERCHANT_V2,
	getNormalizedTable = getNormalizedTable,

	-- v14: Ei-Baum
	RARITY_DIST        = RARITY_DIST,
	PATH_MATCH_WEIGHT  = PATH_MATCH_WEIGHT,
	TREE               = TREE,
	PRESS              = PRESS,
	canPress           = canPress,
	getOrderedIds      = getOrderedIds,
	getChildren        = getChildren,
	getNextInPath      = getNextInPath,
	isSpecial          = function(eggType: Types.EggType): boolean
		local egg = EGGS[eggType]
		return egg ~= nil and egg.special == true
	end,

	LAY_LEVEL_GAIN           = LAY_LEVEL_GAIN,
	LAY_STAT_LEVEL_GAIN      = LAY_STAT_LEVEL_GAIN,
	OFFLINE_SLOWDOWN         = OFFLINE_SLOWDOWN,
	OFFLINE_MAX_EGGS         = OFFLINE_MAX_EGGS,
	LAY_RARITY_FACTOR        = LAY_RARITY_FACTOR,
	MAX_UNCOLLECTED_EGGS     = MAX_UNCOLLECTED_EGGS,
	MIN_LAY_INTERVAL_SECONDS = MIN_LAY_INTERVAL_SECONDS,
	LAY_SCATTER_RADIUS       = LAY_SCATTER_RADIUS,
	LAY_EGG_SIZE             = LAY_EGG_SIZE,
	LAY_LABEL_DISTANCE       = LAY_LABEL_DISTANCE,

	rollEggType = rollEggType,
}
]]></ProtectedString>
					<string name="ScriptGuid">{C7F265DA-4A76-483B-9DFD-E0D529B901D6}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">EggConfig</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">791fef6ea3ff961e0aaa5df4000003ea</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXDF34078BB68544B88B2488E6E1F9EDED">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- MapConfig.luau
-- ReplicatedStorage/Config/MapConfig.luau
--
-- Alle Positionen, Groessen und visuellen Werte fuer die Map.
-- MapService hat keine einzige hardcodierte Zahl.
--
-- ============================================================
-- WELT-AUFBAU: INSELN IM WASSER
-- ============================================================
-- Drei Ringe aus Inseln, alle mit Holzstegen verbunden, rundherum Wasser:
--
--                        (A)
--                         |
--                        [P]
--                         |
--             (A)—[P]— (( C )) —[P]—(A)      8 mal, alle 45 Grad
--                         |
--                        [P]
--                         |
--                        (A)
--
--   (( C ))  Hauptinsel: Spawn, Honigmast, freie Karo-Wiese. Hier landen
--            alle und hier laufen sich alle ueber den Weg.
--   [P]      Plot-Insel: eine pro Spieler, mit dem eigenen Beet, den drei
--            Gebaeuden und dem Honig-Teich.
--   (A)      Arena-Insel: die eigene PIT-Arena, ein Stueck weiter draussen.
--
-- WARUM INSELN STATT EINER PLATTFORM
-- Vorher war alles eine einzige 480 Studs breite Scheibe, auf der die Plots
-- als Rechtecke lagen. Das las sich aus der Spielerkamera als eine grosse
-- gruene Flaeche mit Markierungen darauf — man sah nicht, wo der eigene
-- Bereich anfaengt. Getrennte Inseln beantworten das ohne ein einziges
-- Schild: was zu mir gehoert, ist das, was am Ende MEINES Stegs liegt.
--
-- Alle drei Abstaende sind derselbe Wert (ISLAND_GAP) und damit auch alle
-- Stege gleich lang. Ein Steg ueberbrueckt IMMER genau eine Luecke — es gibt
-- keine zweite Laengen-Zahl mehr, die davon abweichen koennte.
--
-- Die Wiese ist KARIERT (zwei Gruentoene). Gebaut wird nur die helle Haelfte
-- als flache Teile auf der dunklen Inselscheibe; das Raster liegt in
-- Weltkoordinaten, laeuft also ueber alle Inseln durch. Die frueheren
-- Lego-Noppen sind dafuer weg: Noppen UND Karos uebereinander ergeben nur
-- Unruhe, und das Karo ist das, was die Flaeche gliedert.
--
-- ============================================================
-- PLOT-LOKALES KOORDINATENSYSTEM (wichtig!)
-- ============================================================
-- Jeder Plot bekommt in MapService ein eigenes CFrame, das zur Plattform-
-- MITTE schaut. Alle Offsets hier unten sind deshalb LOKAL zu diesem Plot:
--
--     lokales -Z  = Richtung Plattform-Mitte
--     lokales +Z  = nach aussen (Richtung Rand → Bruecke → PIT)
--     lokales +X  = seitlich (rechts, wenn man vom Plot zur Mitte schaut)
--
-- Nur dadurch stehen die Gebaeude bei allen 8 Winkeln richtig herum statt
-- verdreht. Das Y in den Offsets ist eine ZUSATZ-Hoehe ueber dem Plot-Boden;
-- die eigentliche Standhoehe rechnet MapService selbst aus der jeweiligen
-- Teilegroesse aus, damit nichts schwebt oder im Boden steckt.

--------------------------------------------------------------------------------
-- Hauptinsel, Wasser, Karo-Wiese
--------------------------------------------------------------------------------

local CENTER = Vector3.new(0, 0, 0)

-- Oberkante JEDER Insel. Alles andere wird relativ dazu berechnet —
-- die Welt laesst sich damit an einer einzigen Zahl hoch/runter schieben.
local PLATFORM_TOP_Y = 0

-- War 150. Von der eigenen Plot-Insel bis zur Mitte war das ein spuerbar
-- langer Fussmarsch quer ueber die Hauptinsel — genau die Strecke, die am
-- meisten zaehlt, weil man sie bei jedem Ei, jedem Ausruesten und jedem
-- Rebirth-Blick zur Mitte zuruecklegt. 120 kuerzt das um ein Fuenftel, ohne
-- die Hauptinsel eng wirken zu lassen (das Spawn-Pad ist 24 Studs breit,
-- bleibt also weiterhin ein kleiner Punkt darauf).
local PLATFORM_RADIUS = 120

-- Wie dick eine Insel ist. Sie steckt damit sichtbar im Wasser statt wie eine
-- Scheibe darauf zu liegen — bei 16 Studs sieht man von der Kamerahoehe eines
-- Spielers eine richtige Kante, keinen Strich.
local ISLAND_HEIGHT = 16

-- Abstand zwischen zwei Inseln UND damit die Laenge jedes Stegs. Ein Steg
-- ueberbrueckt immer genau eine Luecke, deshalb gibt es nur diese eine Zahl.
-- War 44 (rund drei Sekunden bei WALK_SPEED). 34 bleibt immer noch lang genug,
-- dass die Inseln spuerbar getrennt wirken, kuerzt aber jede der beiden
-- Bruecken pro Weg (Hauptinsel→Plot, Plot→Arena) um gut zwei Sekunden.
local ISLAND_GAP = 34

-- ============================================================
-- KARO-WIESE
-- ============================================================
-- Zwei Gruentoene im Schachbrett. Gebaut werden NUR die hellen Felder als
-- flache Teile — die dunkle Haelfte ist die Inselscheibe selbst. Das halbiert
-- die Teilezahl gegenueber "jedes Feld ein Teil" bei exakt demselben Bild.
--
-- GRASS_TILE gilt fuer die ganze Welt, und das Raster liegt in WELT-
-- Koordinaten mit Ursprung im Weltmittelpunkt: die Karos laufen dadurch ueber
-- alle Inseln durch, statt auf jeder neu anzusetzen. Nur die Plot-Beete
-- rastern plot-lokal (siehe unten) — sonst laege das Karo auf einem gedrehten
-- Beet schief.
--
-- 24 Studs sind bewusst gross: bei 12 wirkt die Wiese aus der Spielerkamera
-- wie ein Muster statt wie Felder, und die Teilezahl vervierfacht sich.
--
-- Das Beet auf der Plot-Insel rastert FEINER (PLOT_GRASS_TILE). Es ist die
-- Flaeche, auf der man selbst steht und auf die man die ganze Zeit schaut;
-- 24er-Felder waeren darauf nur drei Reihen und wuerden gar nicht mehr als
-- Karo lesen. Dieselbe Ueberlegung wie bei einem Teppich gegenueber einer
-- Wiese. 72 / 18 geht glatt auf, es bleibt kein Reststreifen an einer Kante.
local GRASS_TILE      = 24
local PLOT_GRASS_TILE = 18
local GRASS_HEIGHT    = 0.08   -- wie weit ein helles Feld ueber der Scheibe liegt
local GRASS_DARK      = Color3.fromRGB( 58, 140,  62)
local GRASS_LIGHT     = Color3.fromRGB( 92, 178,  82)

-- Sandkante am Wasser: eine BREITERE Scheibe, die ein Stueck tiefer liegt.
-- Ringsum bleibt dadurch ein Sandstreifen sichtbar, ohne dass dafuer ein Ring
-- aus Einzelteilen gebaut werden muesste.
--
-- SHORE_DROP und WATER_DROP bilden zusammen eine Treppe: Wiese 0, Sand -1,
-- Wasser -2.6. Beide Stufen sind niedrig genug, dass eine Roblox-Figur sie
-- ohne Springen hochgeht — wer ins Wasser faellt, laeuft einfach zurueck an
-- Land. Waeren sie hoeher, waere jeder Fehltritt eine Sackgasse.
local SHORE_WIDTH = 8
local SHORE_DROP  = 1.0
local SHORE_COLOR = Color3.fromRGB(238, 214, 158)

-- Das Wasser ist EINE grosse Scheibe unter allem.
--
-- Sie ist begehbar (CanCollide): wer vom Steg faellt, landet auf der
-- Oberflaeche und laeuft zurueck, statt ins Leere zu stuerzen. In einem Spiel,
-- in dem man staendig ueber schmale Stege laeuft, ist das die freundlichere
-- Loesung — ein Sturz waere reine Strafe ohne Spielinhalt.
--
-- WATER_RADIUS muss die aeusserste Arena mit Sandkante umschliessen; das
-- prueft MapService beim Start. War 700 — mit der kleineren Welt reicht 650
-- fuer denselben grosszuegigen Rand offenen Wassers dahinter.
local WATER_RADIUS       = 650
local WATER_DROP         = 2.6    -- wie weit unter Inselhoehe die Oberflaeche liegt
local WATER_HEIGHT       = 10
local WATER_COLOR        = Color3.fromRGB(64, 164, 214)
local WATER_TRANSPARENCY = 0.28

-- Not-Spawn in der Mitte der Wiese. Greift nur noch, wenn ein Spieler
-- ausnahmsweise KEINEN eigenen Plot bekommt (Server voll, siehe
-- MapService.spawnIsland) — der normale Weg ist seit dem Insel-Spawn
-- (siehe PLAYER_SPAWN_OFFSET unten) die eigene Insel, nicht mehr die Mitte.
-- Unsichtbar, damit sie nicht als zweiter Bodenbelag unter dem Event-Pit
-- durchscheint.
local SPAWN_SIZE = Vector3.new(10, 1, 10)
local SPAWN_COLOR = Color3.fromRGB(240, 230, 200)

-- ============================================================
-- EVENT-PIT: DER STALL IN DER MITTE
-- ============================================================
-- Ein rundes, eingezaeuntes Podest genau in der Weltmitte, unter dem
-- Honigmast. Normalerweise ein schlichter Holz-Stall — sobald ein Event
-- laeuft, faerbt EventService Boden, Zaun und Ring in dessen Farben um
-- (siehe MapService.setEventPitTheme) und die Anzeigetafel darueber zeigt
-- Name und Restzeit. Ausserhalb eines Events zeigt dieselbe Tafel den
-- Countdown bis zum naechsten (siehe MapService.setEventBanner).
--
-- Acht Zaunluecken statt einer (wie bei den Spieler-Arenen): das Pit steht
-- in der Mitte aller acht Stege, nicht am Ende von nur einem. Jede Luecke
-- liegt genau in der Aussenrichtung eines Plots — wer von seiner Bruecke
-- kommt, laeuft geradewegs hinein statt am Zaun entlang zu suchen.
--
-- Podesthoehe 2 Studs, derselbe Trick wie beim Plot-Beet (PLOT_SIZE.Y):
-- ein klarer Schritt nach oben statt eines Absenk-Tricks, niedrig genug zum
-- Hochlaufen ohne Springen.
local EVENT_PIT_RADIUS       = 50
local EVENT_PIT_FLOOR_HEIGHT = 2

-- Sicherheitsabstand zwischen dem Karo-Rasen (GRASS_HEIGHT ueber
-- PLATFORM_TOP_Y) und der Podest-Unterkante — derselbe Grundgedanke wie
-- BRIDGE_SINK/GRASS_HEIGHT selbst: ohne diesen Puffer laege die Unterkante
-- GENAU auf Rasenhoehe, und ein paar Karo-Kacheln direkt am Podestrand
-- wuerden mit der Unterkante flimmern bzw. leicht durchscheinen — genau der
-- "das Pit steckt teilweise im Boden"-Effekt. Mit dem Puffer liegt die
-- Unterkante immer sauber ueber dem Rasen, egal welche Kachel gerade
-- darunterliegt.
local EVENT_PIT_GROUND_CLEARANCE = 0.3

-- Stall-Look: gedeckte Stroh-/Holztoene, kein Glimmen. Erst ein Event macht
-- daraus etwas Auffaelliges (siehe EventConfig.EVENTS).
local EVENT_PIT_DEFAULT_FLOOR_COLOR = Color3.fromRGB(178, 150, 100)
local EVENT_PIT_DEFAULT_FENCE_COLOR = Color3.fromRGB(150, 105, 60)
local EVENT_PIT_DEFAULT_RING_COLOR  = Color3.fromRGB(120,  98,  70)

local EVENT_PIT_RING_OVERHANG = 1.6
local EVENT_PIT_RING_HEIGHT   = 0.7

local EVENT_PIT_FENCE_COUNT       = 28
local EVENT_PIT_FENCE_SIZE        = Vector3.new(1.0, 5.0, 1.0)
local EVENT_PIT_FENCE_GAP_DEGREES = 9     -- Oeffnung je Bruecken-Richtung, halber Winkel je Seite
local EVENT_PIT_FENCE_INSET       = 1.6

-- Anzeigetafel: anders als bei den Spieler-Arenen IMMER eingeblendet — sie
-- ist der einzige Ort, an dem der Event-Countdown steht.
-- Playtest 05.10.: bei 16 lag die Tafel im Honigmast (Spitze ~33) und die
-- Schrift lief durch ihn hindurch. 38 = Unterkante ueber dem Tropfen.
local EVENT_PIT_BANNER_HEIGHT   = 38
local EVENT_PIT_BANNER_SIZE     = Vector2.new(22, 6)
local EVENT_PIT_BANNER_DISTANCE = 300
local EVENT_PIT_BANNER_IDLE_COLOR = Color3.fromRGB(230, 220, 200)

--------------------------------------------------------------------------------
-- Spieler-Plots
--------------------------------------------------------------------------------

local PLOT_COUNT = 8

-- Jeder Plot ist eine eigene RUNDE Insel; darauf liegt das quadratische Beet.
--
-- PLOT_ISLAND_RADIUS muss die ECKEN des Beetes decken, nicht seine Kanten:
-- bei 72x72 liegt eine Ecke 50.9 Studs von der Mitte. 58 laesst also rund
-- 7 Studs Wiesenrand ums Beet, dahinter kommt die Sandkante. Zu knapp, und
-- das Beet ragt an vier Stellen ueber die Insel; MapService prueft das beim
-- Start.
local PLOT_ISLAND_RADIUS = 58

-- Abstand der Insel-MITTE zur Weltmitte. Ergibt sich aus den Radien und der
-- Luecke: Hauptinsel-Rand + Steg + halbe Plot-Insel.
--     120 + 34 + 58 = 212
-- MapService rechnet das beim Start nach und warnt, wenn es nicht passt.
-- PLOT_ISLAND_RADIUS selbst bleibt unangetastet: er haengt fest an PLOT_SIZE
-- (die Insel muss die Beet-Ecken decken) — an dieser Zahl zu drehen wuerde das
-- Beet ueber den Inselrand ragen lassen, nicht nur den Weg dorthin verkuerzen.
local PLOT_RING_RADIUS = 212
local PLOT_SIZE        = Vector3.new(72, 2, 72)

-- Der Wiesenrand der Plot-Insel, auf dem das Beet steht. Etwas dunkler als das
-- Karo, damit das Beet als eigene Flaeche liest und nicht mit der Insel
-- verschwimmt.
local PLOT_ISLAND_COLOR = Color3.fromRGB(70, 152, 70)

-- Zaun an den beiden SEITEN des Plots (lokales +X und -X). Vorne (+Z, Richtung
-- Bruecke) und hinten (-Z, Richtung Mitte) bleibt bewusst offen — sonst muesste
-- man ueber den Zaun springen um auf den eigenen Plot oder zur Bruecke zu kommen.
local FENCE_POST_SIZE    = Vector3.new(1.2, 5, 1.2)
local FENCE_POST_SPACING = 9
local FENCE_RAIL_HEIGHT  = 0.8
local FENCE_COLOR        = Color3.fromRGB(225, 215, 190)

-- Schild an der zur Mitte zeigenden Kante: zeigt, wem der Plot gehoert
local SIGN_POST_SIZE  = Vector3.new(0.8, 7, 0.8)
-- Playtest 05.10.: 16 breit wirkte langgezogen, und EIN Pfosten in der Mitte
-- ragte vorne durch die Schrift. Jetzt 12 breit, zwei Pfosten HINTER dem Brett
-- an den Raendern, dunkle Leisten oben und unten.
local SIGN_BOARD_SIZE = Vector3.new(12, 5.2, 0.6)
local SIGN_TRIM_COLOR = Color3.fromRGB(150, 105, 60)
local SIGN_POST_COLOR = Color3.fromRGB(150, 105, 60)
local SIGN_COLOR      = Color3.fromRGB(245, 235, 205)

-- Blumen auf der freien Wiese der Hauptinsel. Rein optisch, deterministisch
-- gesetzt (fester Zufallsstartwert), damit die Welt bei jedem Server-Start
-- gleich aussieht.
--
-- Weniger als vorher (90), weil die Hauptinsel nur noch ein Fuenftel der
-- frueheren Flaeche hat: dieselbe Zahl waere jetzt ein Blumenfeld, und die
-- Karos darunter waeren nicht mehr zu sehen.
local FLOWER_COUNT      = 46
local FLOWER_SEED       = 20260903
local FLOWER_STEM_SIZE  = Vector3.new(0.4, 3, 0.4)
local FLOWER_HEAD_SIZE  = 1.8
local FLOWER_STEM_COLOR = Color3.fromRGB(70, 150, 55)
local FLOWER_COLORS: { Color3 } = {
	Color3.fromRGB(255, 235, 120),
	Color3.fromRGB(255, 160, 190),
	Color3.fromRGB(180, 165, 255),
	Color3.fromRGB(255, 255, 255),
}

--------------------------------------------------------------------------------
-- Gebaeude auf dem Plot (Offsets im PLOT-LOKALEN Raum, siehe Kopf)
--------------------------------------------------------------------------------

-- Die zwei Honig-Gebaeude (v15: Bienenstock und Honig-Veredler) stehen ab dem
-- ersten Join auf dem Plot (siehe Types.createDefaultPlayerData). Der dritte
-- Ausbau, der Waben-Recycler, steht vorne am Steg (CombConfig.RECYCLER_OFFSET). Sie stehen in einer Reihe an der zur Mitte
-- zeigenden Seite (-Z), damit die vordere Haelfte des Plots (+Z) frei bleibt
-- fuer die Baerchis und den Weg zur Bruecke.
--
-- Der Part-Name ist die BuildingId — der Client findet darueber das Gebaeude
-- fuer den ProximityPrompt. Wer hier einen Schluessel aendert, muss ihn auch
-- in Types.BuildingId, BuildingBehavior und IslandService.VALID_BUILDINGS
-- aendern; tools/check_consistency.py prueft alle Listen gegeneinander.
-- displayName steht bewusst HIER und nicht im Client: das Schild in der Welt
-- (MapService) und das Gebaeude-Panel (BuildingPanel) benennen dasselbe
-- Objekt. Zwei getrennte Listen waeren die naechste Stelle, an der etwas
-- auseinanderlaeuft.
-- shortName steht aus demselben Grund hier wie displayName: seit v7 waehlt der
-- Spieler auf der Baerchi-Detailkarte aus, welchen Honig er verfuettert, und
-- auf einen Knopf von einem Drittel Kartenbreite passt "Honig-Presse" nicht.
-- Eine zweite Namensliste im Client waere die naechste Stelle, an der etwas
-- auseinanderlaeuft.
local BUILDING_OFFSETS: { [string]: { offset: Vector3, size: Vector3, color: Color3, displayName: string, shortName: string } } = {
	Beehive = {
		offset      = Vector3.new(-22, 0, -22),
		size        = Vector3.new(12, 11, 12),
		color       = Color3.fromRGB(240, 190, 70),    -- Bienenstock-Gelb
		displayName = "Bienenstock",
		shortName   = "Stock",
	},
	-- v15: Honigtopf + Honig-Presse -> Honig-Veredler ("Honig-Veredler" ist ein
	-- Platzhalter-Name). Steht dort, wo die Presse stand; die Mitte (frueher
	-- der Topf) bleibt frei.
	HoneyRefiner = {
		offset      = Vector3.new(22, 0, -22),
		size        = Vector3.new(12, 11, 12),
		color       = Color3.fromRGB(205, 135, 45),    -- Honig-Orange
		displayName = "Honig-Veredler",
		shortName   = "Veredler",
	},
	-- Honig-Teich (HONEY_POND_V2): ersetzt Stock und Veredler. Steht mitten im
	-- hinteren Plot-Teil (wo die beiden standen), damit sein Brunnen vom Steg
	-- aus zu sehen ist. Der Koerper ist so gross wie Becken + Steinkranz; die
	-- Look-Deko (BUILDING_LOOK_DECOR.HoneyPond) waechst darin bis zum
	-- Honig-Springbrunnen. Das Becken selbst baut PondBuilder an derselben Stelle.
	HoneyPond = {
		offset      = Vector3.new(0, 0, -14),
		size        = Vector3.new(20, 15, 20),
		color       = Color3.fromRGB(255, 190, 60),    -- Honig-Gold
		displayName = "Honig-Brunnen",
		shortName   = "Brunnen",
	},
}

-- Feste Reihenfolge fuer alles was die Gebaeude AUFLISTET (Panel, Schilder).
-- Die Gebaeude-Tabelle in IslandData ist eine Hash-Tabelle und damit nicht
-- stabil sortiert.
local BUILDING_ORDER: { string } = { "Beehive", "HoneyRefiner", "HoneyPond" }

--------------------------------------------------------------------------------
-- Aussehen der Gebaeude
--------------------------------------------------------------------------------

-- Die Part aus BUILDING_OFFSETS ist seit v5 nur noch der unsichtbare Koerper:
-- sie traegt Namen, Attribut und Schild, und der Client haengt seinen
-- ProximityPrompt daran. Sie kollidiert NICHT — dagegen laufen kann man nur
-- an den Teilen, die hier `solid = true` tragen. WIE ein Gebaeude aussieht
-- steht also hier, als reine Beschreibung, ohne eine Zeile Code.
--
-- Warum getrennt: der Klotz von vorher war der Grund, dass alle drei Gebaeude
-- gleich aussahen und man sie nur am Schild unterscheiden konnte. Wer die Form
-- aendern will, aendert diese Liste und fasst MapService nicht an.
--
-- Koordinaten sind GEBAEUDE-lokal: Ursprung ist die Mitte der Grundflaeche auf
-- Plot-Hoehe, +Y ist nach oben, -Z zeigt zur Plattform-Mitte (also zu der
-- Seite, von der der Spieler kommt) und +Z zu den Baerchis.
--
-- shape/rotation: ein Cylinder liegt in Roblox von Haus aus entlang X. Damit
-- er STEHT, braucht er rotation = Vector3.new(0, 0, 90) — die Size ist dann
-- (Hoehe, Durchmesser, Durchmesser). Das ist die haeufigste Stolperfalle hier.
-- solid: dagegen laeuft man. Standard ist false, weil die meisten Teile nur
-- Zierrat sind (Wimpel, Flugloch, Honig-Fuellung) und man daran sonst haengen
-- bliebe. Der KOERPER selbst kollidiert seit v5 nicht mehr: er ist ein Kasten
-- in der Groesse aus BUILDING_OFFSETS und passt damit nicht mehr zur
-- sichtbaren Form — bei der offenen Presse etwa wuerde man mitten in der Luft
-- zwischen den Pfosten stehenbleiben. Also markiert die Config genau die
-- Teile, die den Umriss ausmachen.
export type DecorPiece = {
	name     : string,
	shape    : Enum.PartType,
	size     : Vector3,
	offset   : Vector3,
	color    : Color3,
	material : Enum.Material?,
	rotation : Vector3?,   -- Grad, optional
	solid    : boolean?,   -- Standard: false
}

local UPRIGHT = Vector3.new(0, 0, 90)   -- macht aus einem liegenden einen stehenden Cylinder

local WOOD       = Color3.fromRGB(160, 110, 65)
