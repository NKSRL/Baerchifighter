					<ProtectedString name="Source"><![CDATA[--!strict
-- CombService.luau
-- ServerScriptService/Services/CombService.luau
--
-- Einzige Zustaendigkeit:
--   - Honigwaben im Event-Pit: entstehen lassen, vom Spieler aufsammeln lassen,
--     als Stapel ueber seinem Kopf zeigen, ihn innerhalb des Pits verlangsamen
--     und den Stapel abgeben, sobald er seine eigene Insel betritt.
--
-- Was mit den abgegebenen Waben passiert (Warteschlange, Gummies, Ausbau),
-- gehoert CombRecyclerService. Dieser Service reicht sie nur dorthin durch
-- (CombRecyclerService.deposit) und kennt weder Gummies noch den Spielstand.
--
-- Was ein Spieler gerade TRAEGT, ist bewusst kein Spielstand: es lebt nur hier,
-- im Arbeitsspeicher, und geht beim Tod oder Verlassen verloren. Das haelt das
-- Sammeln spannend (nicht im Pit sterben!) und erspart dem DataStore eine
-- Zahl, die sich zehnmal pro Sekunde aendert. Alle Zahlen: Config/CombConfig.
--
-- WARUM DER SERVER DAS ALLES MACHT: Der Stapel soll fuer ALLE sichtbar sein
-- (jeder sieht, wer schwer beladen durchs Pit schleicht), und das Einsammeln
-- darf kein Client behaupten koennen. Der Server prueft deshalb im Takt
-- (PICKUP_CHECK_SECONDS) die Position jedes Spielers gegen die Waben — ein
-- Touched-Event pro Wabe waere bei bis zu 40 Waben und 8 Spielern unzuverlaessiger
-- und teurer.
--
-- Anzeige beim Client: Player-Attribute "CombsCarried" / "CombsMax" / "CombsUnits"
-- (CombController zeigt sie an) und das Remote CombDelivered fuer die Abgabe.
--
-- NACHSCHUB (Slot-Modell, Rechnung in Util/CombSlots): eine aufgehobene Wabe
-- behaelt ihren Slot. Erst die Abgabe (deliver) oder der Verlust eines Stapels
-- traegt sie in die Respawn-Warteschlange ein; ein Takt-Loop spawnt faellige
-- Waben, fuellt freie Slots nach und laesst bei fast leerem Pit troepfeln.
-- Die Abgabe kennt dieser Service selbst (er ruft CombRecyclerService.deposit),
-- deshalb plant er den Respawn hier ein: kein Rueckruf vom Recycler noetig,
-- kein Zirkelbezug.
--
-- WABENTHEMEN (CombConfig.THEMES): ein Event setzt per setTheme/clearTheme ein
-- Thema (Lava im Hot Egg, Koenigsgelee beim Boss). Das Thema bestimmt Skin,
-- Wert, Slot-Zahl, Nachschub-Tempo und Tragebremse. Der Wert einer Wabe wird
-- beim Aufheben festgeschrieben. launchCombs laesst Waben einfliegen
-- (Vulkan-Ausbruch, Waben-Regen): der Server legt Landepunkt und Flugzeit
-- fest und schreibt beides als Attribute, der Client zeichnet den Flug.

local Players             = game:GetService("Players")
local Workspace           = game:GetService("Workspace")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Remotes    = require(ReplicatedStorage.Network.Remotes)

local CombBuilder = require(ServerScriptService.Util.CombBuilder)
local CombSlots   = require(ServerScriptService.Util.CombSlots)

local MapService          = require(ServerScriptService.Services.MapService)
local CombRecyclerService = require(ServerScriptService.Services.CombRecyclerService)
local PlayerService = require(ServerScriptService.Services.PlayerService)   -- Sammel-Update 3.5

local CombService = {}

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

type WorldComb = {
	model       : Model,
	position    : Vector3,   -- Bodenpunkt unter der Wabe
	units       : number,
	isGold      : boolean,
	themeId     : string?,
	yaw         : number,
	phase       : number,
	availableAt : number,    -- os.clock(); fliegende Waben erst nach der Landung
}

type CarriedItem = { isGold: boolean, units: number, themeId: string?, slow: number }

type Carried = {
	items  : { CarriedItem },
	models : { Model },
	units  : number,
	folder : Folder?,
}

local WORLD_FOLDER_NAME = "EventPitCombs"
local STACK_FOLDER_NAME = "CombStack"

local _worldFolder: Folder? = nil
local _world: { WorldComb } = {}

local _carried: { [Player]: Carried } = {}

-- Fuer welche Spieler wir WalkSpeed veraendert haben. Nur dann fassen wir ihn
-- wieder an: ein Spieler, der nie Waben getragen hat, behaelt, was immer ein
-- anderes System ihm gesetzt hat.
local _slowed: { [Player]: boolean } = {}
-- Sammel-Update 05.10. (Paket 5.2): kurze Aufheb-Pause nach einem Stoss im
-- Kampf um die Mitte (PitBrawlService).
local _pickupPausedUntil: { [Player]: number } = {}

local _random = Random.new()

-- Respawn-Warteschlange und Zeitgeber (Zeitbasis: os.clock, nur Server).
local _slots = CombSlots.new()

-- Aktives Wabenthema (CombConfig.THEMES), nil = normale Waben.
local _themeId: string? = nil

--------------------------------------------------------------------------------
-- Hilfen
--------------------------------------------------------------------------------

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function getCarried(player: Player): Carried
	local carried = _carried[player]
	if not carried then
		carried = { items = {}, models = {}, units = 0, folder = nil }
		_carried[player] = carried
	end
	return carried
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

local function publishCarried(player: Player)
	local carried = getCarried(player)
	player:SetAttribute("CombsCarried", #carried.items)
	player:SetAttribute("CombsMax", CombConfig.MAX_CARRY)
	player:SetAttribute("CombsUnits", carried.units)
end

-- Wie schnell der Spieler IM PIT mit diesem Stapel laeuft. Jede Wabe bremst
-- mit dem Wert ihres Themas (Lava ist schwerer).
local function pitWalkSpeed(carried: Carried): number
	local slow = 0
	for _, item in carried.items do
		slow += item.slow
	end
	local factor = math.max(CombConfig.MIN_SPEED_FACTOR, 1 - slow)
	return CombConfig.BASE_WALK_SPEED * factor
end

local function restoreSpeed(player: Player)
	if not _slowed[player] then return end
	_slowed[player] = nil

	local humanoid = getHumanoid(player)
	if humanoid then
		humanoid.WalkSpeed = CombConfig.BASE_WALK_SPEED
	end
end

--------------------------------------------------------------------------------
-- Waben in der Welt
--------------------------------------------------------------------------------

-- Wie viele Waben gerade auf Koepfen getragen werden (belegen ihre Slots).
local function heldTotal(): number
	local total = 0
	for _, carried in _carried do
		total += #carried.items
	end
	return total
end

-- Aktuelle Slot-Zahl (= Hoechstzahl im Pit).
local function currentLimit(): number
	local theme = CombConfig.getTheme(_themeId)
	return if theme then theme.limit else CombConfig.MAX_WORLD_COMBS
end

-- Abstand beim Nachfuellen freier Slots (ein Thema kann es beschleunigen).
local function refillInterval(): number
	local theme = CombConfig.getTheme(_themeId)
	local factor = if theme then math.max(0.1, theme.spawnRateFactor) else 1
	return CombConfig.SPAWN_INTERVAL_SECONDS / factor
end

local function tooCloseToOthers(position: Vector3): boolean
	for _, comb in _world do
		if flatDistance(comb.position, position) < CombConfig.SPAWN_MIN_DISTANCE then
			return true
		end
	end
	return false
end

-- Freie Stelle im Ring des Pits (gleichmaessig ueber die Flaeche, sqrt, sonst
-- klumpen die Waben in der Mitte), bis zu 8 Versuche gegen Ueberlappung.
local function findFreeGround(): Vector3?
	local center = MapService.getEventPitPosition()
	local minR2 = CombConfig.SPAWN_RADIUS_MIN * CombConfig.SPAWN_RADIUS_MIN
	local maxR2 = CombConfig.SPAWN_RADIUS_MAX * CombConfig.SPAWN_RADIUS_MAX

	for _ = 1, 8 do
		local radius = math.sqrt(minR2 + (maxR2 - minR2) * _random:NextNumber())
		local angle  = _random:NextNumber() * math.pi * 2
		local ground = Vector3.new(
			center.X + math.cos(angle) * radius,
			center.Y,
			center.Z + math.sin(angle) * radius
		)
		if not tooCloseToOthers(ground) then
			return ground
		end
	end
	return nil
end

-- Baut das Model einer Wabe im Pit (aktuelles Thema).
local function buildModel(comb: WorldComb): Model
	local model = CombBuilder.buildWorldComb(comb.position, comb.yaw, comb.isGold, comb.units, comb.phase, comb.themeId)
	-- Fuer den Auftauch-Effekt im Client (CombController), vor dem
	-- Einhaengen gesetzt, damit es mit dem Model ankommt.
	model:SetAttribute("SpawnTime", Workspace:GetServerTimeNow())
	return model
end

-- Legt eine neue Wabe auf `ground`. `flight` = Flug von `from` ueber
-- `seconds` (Client zeichnet ihn aus den Attributen, aufheben erst danach).
local function placeComb(ground: Vector3, flight: { from: Vector3, seconds: number }?): boolean
	local folder = _worldFolder
	if not folder then return false end

	-- Gold-Chance bleibt pro Spawn gleich (8 %), auch bei Respawn und Thema.
	local isGold = _random:NextNumber() < CombConfig.GOLD_CHANCE
	local comb: WorldComb = {
		model       = nil :: any,
		position    = ground,
		units       = CombConfig.getUnits(isGold, _themeId),
		isGold      = isGold,
		themeId     = _themeId,
		yaw         = _random:NextNumber() * math.pi * 2,
		phase       = _random:NextNumber() * math.pi * 2,
		availableAt = 0,
	}

	local model = buildModel(comb)
	if flight then
		local now = Workspace:GetServerTimeNow()
		model:SetAttribute("FlyFrom", flight.from)
		model:SetAttribute("FlyStart", now)
		model:SetAttribute("FlyEnd", now + flight.seconds)
		comb.availableAt = os.clock() + flight.seconds
	end
	model.Parent = folder
	comb.model = model

	table.insert(_world, comb)
	return true
end

local function spawnComb(): boolean
	if not _worldFolder then return false end
	if #_world >= currentLimit() then return false end

	local ground = findFreeGround()
	if not ground then return false end
	return placeComb(ground, nil)
end

-- Baut alle Waben im Pit mit dem aktuellen Thema neu (Skin + Wert).
local function reskinWorld()
	local folder = _worldFolder
	if not folder then return end
	for _, comb in _world do
		comb.themeId = _themeId
		comb.units   = CombConfig.getUnits(comb.isGold, _themeId)
		local old = comb.model
		local model = buildModel(comb)
		-- Kein Auftauch-Effekt beim Umfaerben: nur der Burst in der Mitte.
		model:SetAttribute("SpawnTime", 0)
		if comb.availableAt > os.clock() then
			for _, name in { "FlyFrom", "FlyStart", "FlyEnd" } do
				model:SetAttribute(name, old:GetAttribute(name))
			end
		end
		model.Parent = folder
		comb.model = model
		old:Destroy()
	end
end

local function removeWorldComb(index: number)
	local comb = _world[index]
	comb.model:Destroy()
	table.remove(_world, index)
end

--------------------------------------------------------------------------------
-- Der Stapel ueber dem Kopf
--------------------------------------------------------------------------------

local function ensureStackFolder(player: Player, carried: Carried): Folder?
	local character = player.Character
	if not character then return nil end

	local existing = carried.folder
	if existing and existing.Parent == character then
		return existing
	end

	local folder = Instance.new("Folder")
	folder.Name   = STACK_FOLDER_NAME
	folder.Parent = character
	carried.folder = folder
	return folder
end

local function clearStack(player: Player)
	local carried = _carried[player]
	if not carried then return end

	if carried.folder then
		carried.folder:Destroy()
	end
	carried.folder = nil
	table.clear(carried.items)
	table.clear(carried.models)
	carried.units = 0

	publishCarried(player)
end

-- Der Stapel geht verloren (Tod, Verlassen, neuer Charakter): seine Slots
-- werden nach ORPHAN_RELEASE_SECONDS frei, die Waben kommen ins Pit zurueck.
local function releaseOrphans(carried: Carried?)
	if not carried then return end
	local count = #carried.items
	if count > 0 then
		CombSlots.schedule(_slots, os.clock() + CombConfig.ORPHAN_RELEASE_SECONDS, count)
	end
end

local function loseStack(player: Player)
	releaseOrphans(_carried[player])
	clearStack(player)
end

local function addToStack(player: Player, comb: WorldComb): boolean
	local carried = getCarried(player)
	if #carried.items >= CombConfig.MAX_CARRY then return false end

	local character = player.Character
	local head = if character then character:FindFirstChild("Head") else nil
	if not head or not head:IsA("BasePart") then return false end

	local folder = ensureStackFolder(player, carried)
	if not folder then return false end

	-- Wert und Gewicht werden HIER festgeschrieben: endet das Thema, behaelt
	-- die getragene Wabe beides.
	table.insert(carried.items, {
		isGold  = comb.isGold,
		units   = comb.units,
		themeId = comb.themeId,
		slow    = CombConfig.getSlowPerComb(comb.themeId),
	})
	carried.units += comb.units

	local model = CombBuilder.buildStackComb(head, #carried.items, comb.isGold, folder, comb.themeId)
	table.insert(carried.models, model)

	publishCarried(player)
	return true
end

--------------------------------------------------------------------------------
-- Der Takt: aufsammeln, bremsen, abgeben
--------------------------------------------------------------------------------

local function tryPickup(player: Player, root: BasePart)
	if os.clock() < (_pickupPausedUntil[player] or 0) then return end   -- Paket 5.2
	local carried = getCarried(player)
	if #carried.items >= CombConfig.MAX_CARRY then return end

	-- v15: Recycler-Faehigkeit "Sammelradius" (BuildingBehavior.MILESTONES).
	local radius = CombConfig.PICKUP_RADIUS
	if BuildingBehavior.hasAbility("Recycler", CombRecyclerService.getLevel(player), "CollectRadius") then
		radius *= CombConfig.COLLECT_RADIUS_FACTOR
	end

	-- Rueckwaerts, weil beim Aufheben Eintraege aus der Liste verschwinden.
	local now = os.clock()
	for i = #_world, 1, -1 do
		local comb = _world[i]
		local dy = math.abs(root.Position.Y - comb.position.Y)

		if comb.availableAt <= now
			and dy <= CombConfig.PICKUP_MAX_HEIGHT
			and flatDistance(root.Position, comb.position) <= radius
		then
			if addToStack(player, comb) then
				removeWorldComb(i)
			end

			if #carried.items >= CombConfig.MAX_CARRY then return end
		end
	end
end

local function deliver(player: Player)
	local carried = getCarried(player)
	local count   = #carried.items
	local units   = carried.units
	if count == 0 then return end

	-- Erst abgeben, dann leeren: scheitert die Abgabe (Spieldaten noch nicht
	-- geladen), behaelt der Spieler seinen Stapel und es wird beim naechsten
	-- Takt erneut versucht.
	if not CombRecyclerService.deposit(player, units) then return end

	-- Sammel-Update 05.10. (Paket 3.5): Zaehler fuer die Einfuehrung
	-- ("Waben im Recycler abgeben"). Monoton, im Spielstand.
	local data = PlayerService.getData(player)
	if data then
		local stats = data.stats :: any
		stats.totalCombsDelivered = (stats.totalCombsDelivered or 0) + count
	end

	-- Jede abgegebene Wabe kommt nach der Respawn-Zeit zurueck ins Pit.
	local delay = CombConfig.getRespawnDelay(CombRecyclerService.getLevel(player))
	CombSlots.schedule(_slots, os.clock() + delay, count)

	clearStack(player)
	restoreSpeed(player)

	Remotes.CombDelivered:FireClient(player, count, units)
end

local function checkPlayer(player: Player)
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid = getHumanoid(player)
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then return end

	local carried = _carried[player]
	local count   = if carried then #carried.items else 0

	local center = MapService.getEventPitPosition()
	local inPit  = flatDistance(root.Position, center) <= MapService.getEventPitRadius()

	if inPit then
		tryPickup(player, root)
		count = #getCarried(player).items
	end

	-- Tempo: nur im Pit und nur mit Last. Ausserhalb wieder normal.
	if inPit and count > 0 then
		_slowed[player] = true
		humanoid.WalkSpeed = pitWalkSpeed(getCarried(player))
	else
		restoreSpeed(player)
	end

	-- Abgabe: eigene Insel betreten.
	if count > 0 then
		local plotCFrame = MapService.getPlotCFrame(player)
		if plotCFrame and flatDistance(root.Position, plotCFrame.Position) <= CombConfig.DELIVER_RADIUS then
			deliver(player)
		end
	end
end

--------------------------------------------------------------------------------
-- Spieler- und Charakter-Lebenszyklus
--------------------------------------------------------------------------------

local function hookCharacter(player: Player, character: Model)
	-- Neuer Charakter = leerer Stapel. Der alte Stapel haengt am alten
	-- Charakter und verschwindet mit ihm; hier nur die Buchfuehrung nachziehen.
	-- Hatte er noch Waben (Charakter ohne Tod ersetzt), werden die Slots frei.
	releaseOrphans(_carried[player])
	_carried[player] = { items = {}, models = {}, units = 0, folder = nil }
	_slowed[player] = nil
	publishCarried(player)

	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid and humanoid:IsA("Humanoid") then
		humanoid.Died:Connect(function()
			-- Wer im Pit stirbt, verliert seine Waben (siehe Kopf der Datei).
			loseStack(player)
			_slowed[player] = nil
		end)
	end
end

local function hookPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		hookCharacter(player, character)
	end)

	if player.Character then
		task.spawn(hookCharacter, player, player.Character)
	else
		publishCarried(player)
	end
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Wie viele Waben liegen gerade im Pit (fuer Debug und Tests).
-- Sammel-Update 05.10. (Paket 5.2): Waben-Aufheben kurz pausieren.
function CombService.pausePickup(player: Player, seconds: number)
	_pickupPausedUntil[player] = math.max(_pickupPausedUntil[player] or 0, os.clock() + seconds)
end

function CombService.getWorldCount(): number
	return #_world
end

-- Wie viele Waben dieser Spieler gerade traegt.
function CombService.getCarriedCount(player: Player): number
	local carried = _carried[player]
	return if carried then #carried.items else 0
end

-- Nur fuer den Studio-Test (DebugService): sofort `n` Waben ins Pit legen
-- (am Slot-Modell vorbei, aber nie ueber das Limit im Pit).
function CombService.debugSpawn(n: number)
	for _ = 1, n do
		spawnComb()
	end
end

-- Setzt das Wabenthema (CombConfig.THEMES[themeId]) oder hebt es auf (nil).
-- Bestehende Waben im Pit wechseln sofort Skin und Wert (ein Funken-Burst in
-- der Pit-Mitte); getragene behalten ihren Wert. Endet ein Thema mit mehr
-- Waben im Pit als normal erlaubt, verschwinden die ueberzaehligen (ihre Slots
-- gab es nur waehrend des Themas).
function CombService.setTheme(themeId: string?)
	if themeId and not CombConfig.getTheme(themeId) then
		warn("[CombService] Unbekanntes Wabenthema:", themeId)
		themeId = nil
	end
	if themeId == _themeId then return end

	local previous = CombConfig.getTheme(_themeId)
	_themeId = themeId

	local limit = currentLimit()
	while #_world > limit do
		removeWorldComb(_random:NextInteger(1, #_world))
	end

	reskinWorld()

	local theme = CombConfig.getTheme(themeId) or previous
	local folder = _worldFolder
	if theme and folder then
		local center = MapService.getEventPitPosition()
		CombBuilder.themeBurst(center + Vector3.new(0, 3, 0), theme.burstColor, folder)
	end
	print("[CombService] Wabenthema:", themeId or "normal", "| Slots", limit)
end

function CombService.clearTheme()
	CombService.setTheme(nil)
end

function CombService.getTheme(): string?
	return _themeId
end

-- Laesst bis zu `count` Waben einfliegen und landen (Vulkan-Ausbruch aus
-- `origin`, Waben-Regen von oben, wenn origin nil ist). Nie ueber das Limit im
-- Pit; die gelandeten Waben sind ganz normale Waben im Slot-Modell. Gibt die
-- Zahl der gestarteten Waben zurueck.
function CombService.launchCombs(count: number, origin: Vector3?): number
	local launched = 0
	for _ = 1, math.max(0, math.floor(count)) do
		if #_world >= currentLimit() then break end
		local ground = findFreeGround()
		if ground then
			local landing = ground + Vector3.new(0, CombConfig.WORLD_HOVER, 0)
			local from = origin or (landing + Vector3.new(0, CombConfig.RAIN_DROP_HEIGHT, 0))
			if placeComb(ground, { from = from, seconds = CombConfig.FLIGHT_SECONDS }) then
				launched += 1
			end
		end
	end
	return launched
end

-- Stand des Slot-Modells (fuer DebugService und Tests).
function CombService.getSlotInfo(): { world: number, held: number, queued: number, limit: number }
	return {
		world  = #_world,
		held   = heldTotal(),
		queued = CombSlots.pending(_slots),
		limit  = currentLimit(),
	}
end

-- Ein Takt des Nachschubs: so viele Waben spawnen, wie das Slot-Modell sagt.
local function respawnTick()
	local count = CombSlots.tick(_slots, {
		now            = os.clock(),
		world          = #_world,
		held           = heldTotal(),
		limit          = currentLimit(),
		refillInterval = refillInterval(),
		minWorld       = CombConfig.MIN_WORLD_COMBS,
		trickleSeconds = CombConfig.MIN_TRICKLE_SECONDS,
	})
	for _ = 1, count do
		spawnComb()
	end
end

function CombService.init()
	-- nichts anzumelden; alles Zeitabhaengige laeuft in start()
	print("[CombService] Initialisiert | max.", CombConfig.MAX_WORLD_COMBS, "Waben im Pit")
end

-- Erst in start(): dann steht die Welt (das Event-Pit baut MapService.init) und
-- Spieler werden geladen.
function CombService.start()
	local folder = Instance.new("Folder")
	folder.Name   = WORLD_FOLDER_NAME
	folder.Parent = Workspace
	_worldFolder  = folder

	for _ = 1, CombConfig.INITIAL_COMBS do
		spawnComb()
	end

	Players.PlayerAdded:Connect(hookPlayer)
	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		releaseOrphans(_carried[player])
		_carried[player] = nil
		_slowed[player] = nil
	end)

	-- Nachschub (Slot-Modell): Respawn, Nachfuellen, Troepfeln
	task.spawn(function()
		while true do
			task.wait(CombConfig.RESPAWN_TICK_SECONDS)
			local ok, err = pcall(respawnTick)
			if not ok then
				warn("[CombService] Spawn fehlgeschlagen:", err)
			end
		end
	end)

	-- Aufsammeln, bremsen, abgeben
	task.spawn(function()
		while true do
			task.wait(CombConfig.PICKUP_CHECK_SECONDS)
			for _, player in Players:GetPlayers() do
				local ok, err = pcall(checkPlayer, player)
				if not ok then
					warn("[CombService] Pruefung fehlgeschlagen:", err)
				end
			end
		end
	end)
end

return CombService
]]></ProtectedString>
					<string name="ScriptGuid">{E929CAFF-B052-46CF-850D-F5F105B0BE14}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CombService</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">08eaaf7cd91c3e760ad3af9b000026f0</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXC352F4B41F7D43129F28175E14CF5FEE">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- CombRecyclerService.luau
-- ServerScriptService/Services/CombRecyclerService.luau
--
-- Einzige Zustaendigkeit:
--   - Den Waben-Recycler auf dem Plot betreiben: abgegebene Waben in die
--     Warteschlange legen, sie zeitgesteuert in Gummies verwandeln und den
--     Ausbau des Recyclers verkaufen.
--
-- Nicht zu verwechseln mit RecycleService (verwertet einen Baerchi gegen
-- Gummies). Das hier ist die Maschine fuer die Waben aus dem Event-Pit
-- (siehe CombService und Config/CombConfig).
--
-- Die Verarbeitung laeuft ueber eine Zeitmarke (island.recycler.lastProcessedAt)
-- und nicht ueber einen Timer pro Spieler, genau wie Honig und Eierlegen: der
-- Recycler arbeitet damit auch weiter, waehrend der Spieler offline ist, und es
-- braucht keine Schleife pro Spieler. Der Takt unten verrechnet nur, was seit
-- der letzten Verrechnung dazugekommen ist.
--
-- Auszahlung ueber EconomyService.awardGummies, also MIT Rebirth-Multiplikator:
-- das ist Einkommen aus Arbeit, kein Gegenwert wie beim Verwerten eines
-- Baerchis (dort ist awardGummiesFlat richtig, siehe RecycleService).

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local Types      = require(ReplicatedStorage.Network.Types)
local Remotes    = require(ReplicatedStorage.Network.Remotes)
local Loc        = require(ReplicatedStorage.Localization.Loc)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local CombRecyclerService = {}

--------------------------------------------------------------------------------
-- Verrechnung
--------------------------------------------------------------------------------

-- Rechnet die Zeit seit der letzten Verrechnung nach, schreibt die fertigen
-- Einheiten als Gummies gut und gibt zurueck, wie viele Einheiten fertig wurden.
--
-- Immer zuerst aufrufen, BEVOR sich Level oder Warteschlange aendern: sonst
-- wuerde die Zeit davor mit dem neuen Wert gerechnet (z.B. eine halbe Stunde
-- Leerlauf, die ploetzlich "Arbeit" waere, sobald eine Abgabe kommt).
local function settle(player: Player, data: Types.PlayerData): number
	local recycler = data.island.recycler
	local now = os.time()

	local elapsed = math.clamp(now - recycler.lastProcessedAt, 0, CombConfig.OFFLINE_MAX_SECONDS)
	recycler.lastProcessedAt = now

	if recycler.queued <= 0 then
		recycler.queued   = 0
		recycler.progress = 0
		return 0
	end
	if elapsed <= 0 then return 0 end

	recycler.progress += elapsed * CombConfig.getSpeed(recycler.level)

	local done = math.min(recycler.queued, math.floor(recycler.progress))
	if done <= 0 then return 0 end

	recycler.queued   -= done
	recycler.progress -= done
	if recycler.queued <= 0 then
		recycler.queued   = 0
		recycler.progress = 0
	end

	EconomyService.awardGummies(player, done * CombConfig.getPayPerUnit(recycler.level))
	return done
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Nimmt abgegebene Waben entgegen. Gibt false zurueck, wenn die Spieldaten
-- noch nicht geladen sind — CombService behaelt den Stapel dann und versucht es
-- spaeter noch einmal.
function CombRecyclerService.deposit(player: Player, units: number): boolean
	local data = PlayerService.getData(player)
	if not data then return false end
	if units <= 0 then return true end

	settle(player, data)

	local recycler = data.island.recycler
	recycler.queued += math.floor(units)

	PlayerService.markDirty(player)
	return true
end

-- Aktuelles Recycler-Level (1, solange die Daten nicht geladen sind). Fuer den
-- Respawn-Hook (CombConfig.getRespawnDelay).
function CombRecyclerService.getLevel(player: Player): number
	local data = PlayerService.getData(player)
	if not data then return 1 end
	return data.island.recycler.level
end

-- Kauft das naechste Level. Meldet Fehler als ActionFailed (wie IslandService).
function CombRecyclerService.upgrade(player: Player)
	local data = PlayerService.getData(player)
	if not data then return end

	local function fail(reason: Types.LocMsg)
		Remotes.ActionFailed:FireClient(player, "RequestUpgradeRecycler", reason)
	end

	-- Erst die laufende Arbeit nach dem ALTEN Level abrechnen.
	settle(player, data)

	local recycler = data.island.recycler
	local nextLevel = recycler.level + 1

	if nextLevel > CombConfig.RECYCLER_MAX_LEVEL then
		fail(Loc.msg("err.max_level"))
		return
	end

	local cost = CombConfig.getUpgradeCost(nextLevel)
	if not cost then
		fail(Loc.msg("err.max_level"))
		return
	end

	-- Erst pruefen, dann buchen (wie EconomyService.upgradeBuilding): sonst kann
	-- der erste Teilbetrag abgezogen werden, obwohl der zweite scheitert.
	if cost.gummies > 0 and data.gummies < cost.gummies then
		fail(Loc.msg("err.not_enough_gummies", { have = data.gummies, need = cost.gummies }))
		return
	end
	if cost.goldGummies > 0 and data.goldGummies < cost.goldGummies then
		fail(Loc.msg("err.not_enough_gold_gummies", { have = data.goldGummies, need = cost.goldGummies }))
		return
	end

	if cost.gummies > 0 then
		local ok, reason = EconomyService.spendGummies(player, cost.gummies)
		if not ok then
			fail(reason or Loc.msg("err.unknown"))
			return
		end
	end
	if cost.goldGummies > 0 then
		local ok, reason = EconomyService.spendGoldGummies(player, cost.goldGummies)
		if not ok then
			fail(reason or Loc.msg("err.unknown"))
			return
		end
	end

	recycler.level = nextLevel
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	Remotes.RecyclerUpgraded:FireClient(player, nextLevel)
	print("[CombRecyclerService]", player.Name, "| Recycler → Level", nextLevel)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

local function tickAll()
	for _, player in Players:GetPlayers() do
		local data = PlayerService.getData(player)
		if data and data.island.recycler.queued > 0 then
			-- settle() schreibt die fertigen Einheiten ueber awardGummies gut, und
			-- das loest markDirty aus: Hud, Schild und Lampe ziehen darueber nach.
			settle(player, data)
		end
	end
end

function CombRecyclerService.init()
	RateLimiter.connect(Remotes.RequestUpgradeRecycler, "RequestUpgradeRecycler", function(player)
		CombRecyclerService.upgrade(player)
	end)

	-- Offline-Arbeit beim Join: die Zeitmarke steht noch auf dem letzten
	-- Verlassen, settle() rechnet die Zwischenzeit nach (hoechstens
	-- OFFLINE_MAX_SECONDS).
	PlayerService.onDataLoaded(function(player, data)
		settle(player, data)
	end)

	-- Vor dem Speichern beim Verlassen noch einmal verrechnen, damit die
	-- Zeitmarke im Spielstand aktuell ist.
	PlayerService.onPlayerLeaving(function(player, data)
		settle(player, data)
	end)

	print("[CombRecyclerService] Initialisiert")
end

function CombRecyclerService.start()
	task.spawn(function()
		while true do
			task.wait(CombConfig.RECYCLER_TICK_SECONDS)
			local ok, err = pcall(tickAll)
			if not ok then
				warn("[CombRecyclerService] Tick fehlgeschlagen:", err)
			end
		end
	end)
end

return CombRecyclerService
]]></ProtectedString>
					<string name="ScriptGuid">{9228C090-F651-475B-B30A-31162A51056A}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CombRecyclerService</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">08eaaf7cd91c3e760ad3af9b000026f2</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX97969298F9804959A04E77A7A8A8EB7B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- LeaderboardService.luau
-- ServerScriptService/Services/LeaderboardService.luau
--
-- Einzige Zustaendigkeit:
--   - Die Bestenlisten (v15): Tower, Rebirths, Sammlung; mit Paket 9 auch
--     Endless und Endless-Woche. Werte schreiben (gedrosselt), Top-Listen
--     lesen (gecacht), dem Client auf Anfrage geben, die Tafeln beschriften
--     und die Top 10 der Vorwoche kroenen (Plot-Schild, MapService).
--
-- REGEL (seit v15, steht auch im Briefing): dieser Service ist der EINZIGE, der
-- OrderedDataStores benutzt — so wie PlayerService der einzige mit dem
-- Spieler-DataStore ist. Kein anderer Service fasst DataStoreService an.
--
-- Budget: Schreiben nur bei Aenderung und hoechstens alle WRITE_MIN_SECONDS pro
-- Spieler, Lesen serverweit alle READ_INTERVAL_SECONDS. Jeder Zugriff laeuft in
-- pcall und erst nach einer Budget-Pruefung (GetRequestBudgetForRequestType);
-- ist das Budget knapp, wird verschoben statt riskiert.
--
-- Ohne DataStore (Studio ohne API-Zugriff, unveroeffentlichter Place) gibt es
-- eine Sitzungsliste: die Werte aller Spieler, die in dieser Sitzung auf dem
-- Server waren. Das Spiel bleibt so vollstaendig testbar.

local Players             = game:GetService("Players")
local DataStoreService    = game:GetService("DataStoreService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types             = require(ReplicatedStorage.Network.Types)
local Remotes           = require(ReplicatedStorage.Network.Remotes)
local LeaderboardConfig = require(ReplicatedStorage.Config.LeaderboardConfig)
local TowerConfig       = require(ReplicatedStorage.Config.TowerConfig)

local PlayerService = require(ServerScriptService.Services.PlayerService)
local MapService    = require(ServerScriptService.Services.MapService)
local RateLimiter   = require(ServerScriptService.Util.RateLimiter)

local LeaderboardService = {}

type Entry = Types.LeaderboardEntry

-- Gelesener Stand je Liste (Top N) und Zeitpunkt.
local _cache: { [string]: { entries: { Entry }, updatedAt: number } } = {}

-- Pro Spieler: zuletzt geschriebene Werte und Zeitpunkt.
local _written: { [number]: { [string]: number } } = {}
local _lastWriteAt: { [number]: number } = {}

-- Sitzungsliste (ohne DataStore) und Namens-Cache.
local _session: { [string]: { [number]: number } } = {}
local _names: { [number]: string } = {}

-- Nach Store-NAME (EndlessWeek hat jede Woche einen neuen).
local _stores: { [string]: OrderedDataStore } = {}
local _storesChecked = false
local _storesOk = false

local _lastRead = 0
local _boardIndex = 0

-- Paket 9: Krone = Top CROWN_TOP_N der Vorwoche. `_crownWeek` = fuer welche
-- (laufende) Woche `_crowned` gilt; nil = noch nicht gelesen.
local _crowned: { [number]: boolean } = {}
local _crownWeek: number? = nil

--------------------------------------------------------------------------------
-- Werte
--------------------------------------------------------------------------------

local function countKeys(t: { [string]: any }?): number
	local n = 0
	for _ in t or {} do n += 1 end
	return n
end

-- Wert eines Spielers in einer Liste (ganze Zahl, OrderedDataStore-tauglich).
function LeaderboardService.valueOf(data: Types.PlayerData, listId: string): number
	if listId == "Tower" then
		local towerId, record = TowerConfig.bestRecord(data.towers)
		if record <= 0 then return 0 end
		return TowerConfig.leaderboardValue(towerId, record)
	elseif listId == "Rebirths" then
		return math.max(0, math.floor(data.rebirthCount))
	elseif listId == "Collection" then
		return countKeys(data.discovered)
	elseif listId == "Endless" then
		return math.max(0, math.floor(data.towers.records.Endless or 0))
	elseif listId == "EndlessWeek" then
		local entry = data.towers.endlessWeek
		if entry and entry.week == LeaderboardConfig.weekOf(os.time()) then
			return math.max(0, math.floor(entry.best))
		end
		return 0
	end
	return 0
end

--------------------------------------------------------------------------------
-- DataStore (nur hier!)
--------------------------------------------------------------------------------

local function currentStoreName(listId: string): string
	return LeaderboardConfig.storeName(listId, LeaderboardConfig.weekOf(os.time()))
end

-- Store nach Namen (einmal geholt, dann gecacht). nil = nicht verfuegbar.
local function storeByName(name: string): OrderedDataStore?
	local store = _stores[name]
	if store then return store end
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(name)
	end)
	if not ok then return nil end
	_stores[name] = result
	return result
end

local function getStores(): boolean
	if _storesChecked then return _storesOk end
	_storesChecked = true
	local ok, err = pcall(function()
		for _, listId in LeaderboardConfig.LISTS do
			local name = currentStoreName(listId)
			_stores[name] = DataStoreService:GetOrderedDataStore(name)
		end
	end)
	_storesOk = ok
	if not ok then
		warn("[LeaderboardService] Keine OrderedDataStores — Sitzungsliste. Grund:", err)
	end
	return ok
end

local function hasBudget(requestType: Enum.DataStoreRequestType): boolean
	local ok, budget = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(requestType)
	end)
	return ok and (budget :: number) >= LeaderboardConfig.MIN_REQUEST_BUDGET
end

local function nameOf(userId: number): string
	local cached = _names[userId]
	if cached then return cached end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		_names[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and typeof(name) == "string" then name else ("#" .. userId)
	_names[userId] = result
	return result
end

--------------------------------------------------------------------------------
-- Schreiben
--------------------------------------------------------------------------------

-- Schreibt die geaenderten Werte eines Spielers (gedrosselt, ausser `force`).
local function writePlayer(player: Player, force: boolean)
	local data = PlayerService.getData(player)
	if not data then return end
	local userId = player.UserId
	_names[userId] = player.DisplayName

	local now = os.clock()
	if not force and now - (_lastWriteAt[userId] or -math.huge) < LeaderboardConfig.WRITE_MIN_SECONDS then
		return
	end

	local written = _written[userId] or {}
	_written[userId] = written
	local changed = false

	for _, listId in LeaderboardConfig.LISTS do
		local value = LeaderboardService.valueOf(data, listId)
		-- Nach Store-Namen gemerkt: in einer neuen Woche wird neu geschrieben.
		local name = currentStoreName(listId)

		-- Sitzungsliste immer pflegen (Studio-Ersatz und Fallback). Die
		-- Wochenliste beginnt zum Wochenwechsel leer.
		local session = _session[name] or {}
		_session[name] = session
		session[userId] = value

		if written[name] ~= value then
			if getStores() then
				local store = storeByName(name)
				if store and hasBudget(Enum.DataStoreRequestType.SetIncrementSortedAsync) then
					local ok, err = pcall(function()
						store:SetAsync(tostring(userId), value)
					end)
					if ok then
						written[name] = value
						changed = true
					else
						-- Studio ohne API-Zugriff: GetOrderedDataStore klappt, jeder
						-- Zugriff scheitert. Einmal melden, dann Sitzungsliste.
						warn("[LeaderboardService] Schreiben fehlgeschlagen — ab jetzt Sitzungsliste:", listId, err)
						_storesOk = false
					end
				end
			else
				written[name] = value
				changed = true
			end
		end
	end

	if changed then
		_lastWriteAt[userId] = now
	end
end

--------------------------------------------------------------------------------
-- Lesen
--------------------------------------------------------------------------------

local function sessionTop(listId: string): { Entry }
	local rows: { { userId: number, value: number } } = {}
	for userId, value in _session[currentStoreName(listId)] or {} do
		if value > 0 then
			table.insert(rows, { userId = userId, value = value })
		end
	end
	table.sort(rows, function(a, b)
		if a.value ~= b.value then return a.value > b.value end
		return a.userId < b.userId
	end)
	local entries: { Entry } = {}
	for rank, row in rows do
		if rank > LeaderboardConfig.TOP_N then break end
		table.insert(entries, { rank = rank, userId = row.userId, name = nameOf(row.userId), value = row.value })
	end
	return entries
end

-- Liest die Top `count` eines Stores. nil = gerade nicht moeglich.
local function readStore(name: string, count: number): { Entry }?
	if not hasBudget(Enum.DataStoreRequestType.GetSortedAsync) then
		return nil
	end
	local store = storeByName(name)
	if not store then return nil end
	local ok, result = pcall(function()
		local pages = store:GetSortedAsync(false, count)
		return pages:GetCurrentPage()
	end)
	if not ok then
		warn("[LeaderboardService] Lesen fehlgeschlagen — ab jetzt Sitzungsliste:", name, result)
		_storesOk = false
		return nil
	end
	local entries: { Entry } = {}
	for _, item in result :: { any } do
		local userId = tonumber(item.key)
		local value = tonumber(item.value) or 0
		-- Paket 9: Nullen (z. B. Endless noch nicht offen) stehen nicht in der Liste.
		if userId and value > 0 then
			table.insert(entries, { rank = #entries + 1, userId = userId, name = nameOf(userId), value = value })
		end
	end
	return entries
end

local function readList(listId: string): { Entry }?
	if not getStores() then
		return sessionTop(listId)
	end
	local entries = readStore(currentStoreName(listId), LeaderboardConfig.TOP_N)
	if entries == nil and not _storesOk then
		return sessionTop(listId)
	end
	return entries
end

-- Paket 9: Krone fuer die Top 10 der VORWOCHE (eine Woche lang). Ohne
-- DataStore (Studio) gibt es keine Vorwoche — dann kroenen die Top 10 der
-- laufenden Sitzungsliste, damit sich das testen laesst.
local function applyCrowns()
	for _, player in Players:GetPlayers() do
		MapService.setOwnerCrown(player, _crowned[player.UserId] == true)
	end
end

local function refreshCrowns()
	if not table.find(LeaderboardConfig.LISTS, "EndlessWeek") then return end
	local week = LeaderboardConfig.weekOf(os.time())
	local entries: { Entry }?
	if getStores() then
		if _crownWeek == week then return end
		entries = readStore(LeaderboardConfig.storeName("EndlessWeek", week - 1), LeaderboardConfig.CROWN_TOP_N)
	end
	if entries == nil and not (getStores() and _storesOk) then
		entries = sessionTop("EndlessWeek")
	end
	if entries == nil then return end   -- spaeter nochmal versuchen

	_crowned = {}
	for _, entry in entries do
		if entry.rank <= LeaderboardConfig.CROWN_TOP_N then
			_crowned[entry.userId] = true
		end
	end
	_crownWeek = week
	applyCrowns()
end

local function refreshAll()
	_lastRead = os.clock()
	for _, listId in LeaderboardConfig.LISTS do
		local entries = readList(listId)
		if entries then
			_cache[listId] = { entries = entries, updatedAt = os.time() }
		end
	end
	refreshCrowns()
end

function LeaderboardService.isCrowned(userId: number): boolean
	return _crowned[userId] == true
end

--------------------------------------------------------------------------------
-- Anzeige
--------------------------------------------------------------------------------

-- Wert fuer die Anzeige ("Tower III · 42", "17", "23/28").
function LeaderboardService.formatValue(listId: string, value: number): string
	if listId == "Tower" then
		local towerId, stage = TowerConfig.fromLeaderboardValue(value)
		local def = TowerConfig.get(towerId) or TowerConfig.TOWERS[1]
		return string.format("Tower %s · %d", def.numeral, stage)
	elseif listId == "Endless" or listId == "EndlessWeek" then
		return string.format("∞ · %d", value)
	end
	return tostring(value)
end

local BOARD_TITLES: { [string]: string } = {
	Tower      = "TOP 10  ·  TOWER",
	Rebirths   = "TOP 10  ·  REBIRTHS",
	Collection = "TOP 10  ·  INDEX",
	Endless    = "TOP 10  ·  ENDLESS ∞",
	EndlessWeek = "TOP 10  ·  ∞ WEEK  ·  ♛",
}

local function paintList(listId: string)
	local cached = _cache[listId]
	local lines: { string } = {}
	for _, entry in (if cached then cached.entries else {}) do
		if entry.rank > LeaderboardConfig.BOARD_TOP_N then break end
		table.insert(lines, string.format("%2d.  %s   —   %s", entry.rank, entry.name, LeaderboardService.formatValue(listId, entry.value)))
	end
	MapService.writeLeaderboardBoard(BOARD_TITLES[listId] or listId, lines, listId)
end

-- HBB Paket 5: Hat jede Liste ihre feste Tafel, werden alle beschrieben;
-- sonst wechselt die eine Tafel reihum (v15).
local function paintBoard()
	if MapService.hasLeaderboardBoard(LeaderboardConfig.LISTS[1]) then
		for _, listId in LeaderboardConfig.LISTS do
			-- Paket 9: eine Liste ohne eigene Tafel landete sonst auf der
			-- wechselnden (die es dann nicht gibt) — einfach auslassen.
			if MapService.hasLeaderboardBoard(listId) then
				paintList(listId)
			end
		end
		return
	end
	_boardIndex = (_boardIndex % #LeaderboardConfig.LISTS) + 1
	paintList(LeaderboardConfig.LISTS[_boardIndex])
end

-- Die Sicht eines Spielers auf eine Liste (Top N + eigener Rang).
function LeaderboardService.getView(player: Player, listId: string): Types.LeaderboardView?
	if not table.find(LeaderboardConfig.LISTS, listId :: any) then return nil end
	local cached = _cache[listId]
	local entries = if cached then cached.entries else {}
	local data = PlayerService.getData(player)
	local ownValue = if data then LeaderboardService.valueOf(data, listId) else 0
	local ownRank: number? = nil
	for _, entry in entries do
		if entry.userId == player.UserId then
			ownRank = entry.rank
			break
		end
	end
	return {
		listId    = listId,
		entries   = entries,
		ownRank   = ownRank,
		ownValue  = ownValue,
		updatedAt = if cached then cached.updatedAt else 0,
	}
end

-- Debug ("lbflush"): alle sofort schreiben und neu lesen.
function LeaderboardService.flush(): { [string]: number }
	for _, player in Players:GetPlayers() do
		writePlayer(player, true)
	end
	refreshAll()
	paintBoard()
	local counts: { [string]: number } = {}
	for listId, cached in _cache do
		counts[listId] = #cached.entries
	end
	return counts
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function LeaderboardService.init()
	RateLimiter.connectFunction(Remotes.GetLeaderboard, "GetLeaderboard", function(player, listId: any)
		if typeof(listId) ~= "string" then return nil end
		return LeaderboardService.getView(player, listId)
	end)

	-- Beim Verlassen zuletzt noch schreiben (ungedrosselt, wenn sich etwas
	-- geaendert hat). Laeuft vor dem Speichern, darf aber nicht yielden — daher
	-- abgekoppelt.
	PlayerService.onPlayerLeaving(function(player, _data)
		task.spawn(writePlayer, player, true)
	end)

	-- Paket 9: Krone gleich beim Betreten, nicht erst beim naechsten Lesen.
	PlayerService.onPlayerReady(function(player, _data)
		MapService.setOwnerCrown(player, _crowned[player.UserId] == true)
	end)

	Players.PlayerRemoving:Connect(function(player)
		_lastWriteAt[player.UserId] = nil
		_written[player.UserId] = nil
	end)

	print("[LeaderboardService] Initialisiert |", #LeaderboardConfig.LISTS, "Listen")
end

function LeaderboardService.start()
	task.spawn(function()
		while true do
			task.wait(LeaderboardConfig.BOARD_CYCLE_SECONDS)
			local ok, err = pcall(paintBoard)
			if not ok then
				warn("[LeaderboardService] Tafel fehlgeschlagen:", err)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(LeaderboardConfig.TICK_SECONDS)
			local ok, err = pcall(function()
				for _, player in Players:GetPlayers() do
					writePlayer(player, false)
				end
				if os.clock() - _lastRead >= LeaderboardConfig.READ_INTERVAL_SECONDS or next(_cache) == nil then
					refreshAll()
				end
			end)
			if not ok then
				warn("[LeaderboardService] Takt fehlgeschlagen:", err)
			end
		end
	end)
end

return LeaderboardService
]]></ProtectedString>
