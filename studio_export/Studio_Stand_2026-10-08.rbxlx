				<Item class="ModuleScript" referent="RBX21D89D104E904CD39E96031F480CCC4D">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- EggTimerController.luau
-- StarterPlayerScripts/Controllers/EggTimerController.luau
--
-- Einzige Zustaendigkeit:
--   - Auf dem Feld, direkt am Namensschild des EIGENEN Baerchis, anzeigen,
--     wie lange es noch bis zum naechsten gelegten Ei dauert.
--
-- ============================================================
-- WARUM DAS REIN CLIENTSEITIG TICKT
-- ============================================================
-- Der Server schickt nur EINEN Zeitstempel (island.lastEggAt), keinen
-- laufenden Countdown — dasselbe Zeitmarken-Prinzip wie ueberall im Projekt
-- (Honig, Brut-Timer). Eine Anzeige, die jede Sekunde weiterzaehlt, braucht
-- dafuer keinen einzigen zusaetzlichen Netzwerk-Roundtrip: das Legeintervall
-- steht als reine Formel in EggCalculator (geteiltes Modul, ReplicatedStorage)
-- und ist auf dem Client genauso berechenbar wie auf dem Server.
--
-- Das ist eine bewusste Ausnahme von "der Client hat keinen eigenen
-- Wahrheitsstand" — hier wird nichts SIMULIERT, nur eine bereits bekannte
-- Formel auf einen bereits bekannten Zeitstempel angewendet. Sobald der
-- naechste PlayerDataUpdated hereinkommt (z.B. weil das Ei tatsaechlich
-- gelegt wurde), zeigt der naechste Tick automatisch wieder den echten Stand.
--
-- ============================================================
-- WARUM NUR DER EIGENE BAERCHI
-- ============================================================
-- PlayerDataUpdated liefert ausschliesslich die eigene Insel (siehe
-- ClientState-Kommentar-Kopf) — fuer die Baerchis anderer Spieler haette
-- dieser Client also gar keine Zahlen, mit denen er rechnen koennte.

local Players   = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EggConfig     = require(ReplicatedStorage.Config.EggConfig)
local EggCalculator = require(ReplicatedStorage.Modules.EggCalculator)
local Loc           = require(ReplicatedStorage.Localization.Loc)

local ClientState = require(script.Parent.ClientState)

local EggTimerController = {}

local OWNER_ATTRIBUTE = "PlotOwner"
local UID_ATTRIBUTE   = "BaerchiUid"
local TICK_SECONDS     = 1

-- Das aktuell bekannte Label des EIGENEN Baerchis, plus seine uid. Wird bei
-- jedem Neuaufbau der Figur (Level-Up, Equip-Wechsel) neu gefunden und
-- ersetzt automatisch den alten Eintrag.
local _label: TextLabel? = nil
local _uid: string? = nil

-- v12: Zustand der Pet-Leiste (PetModeChanged). Ist der Baerchi unterwegs
-- (Event/PIT), pausiert der Lege-Timer auf dem Server — dann zeigt das
-- Schild das an, statt herunterzuzaehlen.
local _petState = "Home"

--------------------------------------------------------------------------------
-- Wem gehoert der Plot, in dem dieses Teil steckt?
--
-- Dieselbe Logik wie in WorldController.findPlotOwner. Bewusst hier noch
-- einmal (kurz genug) statt geteilt, damit dieser Controller unabhaengig
-- bleibt und nichts von WorldControllers interner Struktur wissen muss.
--------------------------------------------------------------------------------
local function findPlotOwner(instance: Instance): number?
	local current: Instance? = instance

	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner
		end
		current = current.Parent
	end

	return nil
end

local function isOwnPlot(instance: Instance): boolean
	return findPlotOwner(instance) == Players.LocalPlayer.UserId
end

--------------------------------------------------------------------------------
-- Anzeige
--------------------------------------------------------------------------------

local function formatSeconds(totalSeconds: number): string
	local seconds = math.max(0, math.floor(totalSeconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

-- Schreibt den aktuellen Countdown in das gemerkte Label. Laeuft jede Sekunde
-- UND sofort nach dem Einhaengen eines neuen Labels, damit nicht bis zu einer
-- Sekunde lang "kein Text" zu sehen ist.
local function refresh()
	local label = _label
	local uid   = _uid
	if not label or not uid then return end

	if not label.Parent then
		-- Figur wurde inzwischen neu aufgebaut (altes Label zerstoert) — der
		-- naechste hook() findet das neue Label von selbst.
		_label = nil
		_uid   = nil
		return
	end

	local data = ClientState.get()
	if not data then return end

	-- Der Baerchi kann inzwischen umgeruestet worden sein, ohne dass diese
	-- Figur schon durch eine neue ersetzt wurde (kurzes Zeitfenster waehrend
	-- MapService neu baut) — dann lieber nichts anzeigen als etwas Falsches.
	if data.island.equippedUid ~= uid then
		label.Text = ""
		return
	end

	local baerchi = data.island.baerchis[uid]
	if not baerchi then
		label.Text = ""
		return
	end

	if _petState ~= "Home" then
		label.Text = Loc.t("ui.egg.paused")
		return
	end

	if EggCalculator.countOwnLaid(data.island.laidEggs) >= EggConfig.MAX_UNCOLLECTED_EGGS then
		label.Text = Loc.t("ui.egg.full")
		return
	end

	local interval = EggCalculator.getLayIntervalSeconds(baerchi, false)
	if not interval then
		-- Dieser Baerchi legt grundsaetzlich keine Eier (kein layIntervalSeconds
		-- oder keine eggTable in seiner Config).
		label.Text = ""
		return
	end

	local nextAt      = (data.island.lastEggAt or os.time()) + interval
	local secondsLeft = nextAt - os.time()

	label.Text = if secondsLeft <= 0
		then Loc.t("ui.egg.soon")
		else Loc.t("ui.egg.next", { time = formatSeconds(secondsLeft) })
end

--------------------------------------------------------------------------------
-- Label finden
--------------------------------------------------------------------------------

-- Sucht am Modell der gerade angekommenen Part nach dem "EggTimer"-Label, das
-- MapService.buildBaerchiFigure im Namensschild mit anlegt. Nur fuer den
-- EIGENEN Plot — fuer fremde Baerchis gibt es weder Daten noch einen Grund,
-- deren Timer mitzuzaehlen.
local function tryHookFigurePart(part: BasePart): boolean
	local uid = part:GetAttribute(UID_ATTRIBUTE)
	if typeof(uid) ~= "string" then return false end
	if not isOwnPlot(part) then return false end

	local model = part:FindFirstAncestorWhichIsA("Model")
	if not model then return false end

	local label = model:FindFirstChild("EggTimer", true)
	if not (label and label:IsA("TextLabel")) then return false end

	_label = label
	_uid   = uid
	refresh()

	return true
end

local function hook(instance: Instance)
	if not instance:IsA("BasePart") then return end
	tryHookFigurePart(instance)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function EggTimerController.init()
	for _, descendant in Workspace:GetDescendants() do
		hook(descendant)
	end

	-- Die Figuren werden bei jedem Struktur-Neuaufbau ersetzt (siehe
	-- PlotDisplayService) — also staendig neu einhaengen.
	Workspace.DescendantAdded:Connect(hook)

	-- Bei einem Sprachwechsel sofort neu beschriften statt bis zum naechsten
	-- Sekunden-Tick zu warten.
	Loc.onChanged(function()
		refresh()
	end)

	local Remotes = require(ReplicatedStorage.Network.Remotes)
	Remotes.PetModeChanged.OnClientEvent:Connect(function(state: any)
		_petState = if typeof(state) == "string" then state else "Home"
		pcall(refresh)
	end)

	task.spawn(function()
		while true do
			task.wait(TICK_SECONDS)

			local ok, err = pcall(refresh)
			if not ok then
				warn("[EggTimerController] Tick fehlgeschlagen:", err)
			end
		end
	end)

	print("[EggTimerController] Initialisiert")
end

return EggTimerController
]]></ProtectedString>
						<string name="ScriptGuid">{45608DAC-D0EA-4D48-8C19-572F484A37DE}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">EggTimerController</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">0c90d4d1334cce8f0ab565d100001179</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXDF2945799C6B4D0295815F63FFBCD1A0">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- LanguageController.luau
-- StarterPlayerScripts/Controllers/LanguageController.luau
--
-- Einzige Zustaendigkeit:
--   - Entscheiden, in welcher Sprache der Client gerade laeuft, und das Loc
--     mitteilen
--   - Die Wahl des Spielers an den Server schicken (damit sie gespeichert wird)
--
-- ============================================================
-- WELCHE SPRACHE GILT — in dieser Reihenfolge
-- ============================================================
--   1. Die gespeicherte Wahl des Spielers (data.language vom Server).
--   2. Die Roblox-Sprache seines Kontos/Clients (Player.LocaleId, zum Beispiel
--      "de-de" → Deutsch). Das ist der Normalfall fuer jeden, der nie im Menue
--      war — er sieht das Spiel sofort in seiner Sprache.
--   3. Englisch, wenn Roblox eine Sprache meldet, die wir nicht uebersetzt haben.
--
-- Der Client wertet die Roblox-Sprache SOFORT aus, noch bevor der erste
-- Server-Sync da ist. Sonst waere der allererste Toast (und alles, was
-- vorher beschriftet wird) einen Moment lang in der falschen Sprache.
--
-- ============================================================
-- WARUM DIE WAHL OPTIMISTISCH GILT
-- ============================================================
-- Klickt der Spieler eine Sprache an, wechselt die Oberflaeche sofort — nicht
-- erst, wenn der Server bestaetigt hat. Das ist eine reine Darstellungs-
-- Einstellung (kein Spielwert), der Server prueft sie nur und legt sie ab.
-- Damit ein PlayerDataUpdated, das noch den ALTEN Wert traegt (weil es vor
-- dem Klick gesendet wurde), die Wahl nicht kurz zurueckdreht, wird die eigene
-- Wahl fuer PENDING_SECONDS bevorzugt, bis der Server denselben Wert meldet.

local Players             = game:GetService("Players")
local LocalizationService = game:GetService("LocalizationService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local Types   = require(ReplicatedStorage.Network.Types)
local Remotes = require(ReplicatedStorage.Network.Remotes)
local Loc     = require(ReplicatedStorage.Localization.Loc)

local ClientState = require(script.Parent.ClientState)

local LanguageController = {}

-- So lange gewinnt die eigene Wahl gegen einen (moeglicherweise veralteten)
-- Server-Wert. Deutlich laenger als der Rate-Limit-Abstand des Remotes.
local PENDING_SECONDS = 5

-- nil = "automatisch" (Roblox-Sprache)
local _choice: string? = nil
local _pendingUntil = 0

-- Letzter vom Server gemeldeter Wert, damit nicht bei JEDEM PlayerDataUpdated
-- (das ist haeufig) neu verglichen werden muss, ob sich die Sprache aendert.
local _lastServerValue: string? = nil
local _seenServerValue = false

--------------------------------------------------------------------------------
-- Roblox-Sprache
--------------------------------------------------------------------------------

local function detectRobloxLanguage(): Loc.Lang
	local fromPlayer = Loc.fromLocaleId(Players.LocalPlayer.LocaleId)
	if fromPlayer then return fromPlayer end

	local fromService = Loc.fromLocaleId(LocalizationService.RobloxLocaleId)
	if fromService then return fromService end

	return Loc.DEFAULT_LANGUAGE
end

local function applyChoice()
	local code = _choice
	if code == nil or not Loc.isSupported(code) then
		code = detectRobloxLanguage()
	end
	Loc.setLanguage(code :: string)
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Die gewaehlte Sprache; nil bedeutet "automatisch". NICHT die gerade
-- aktive Sprache — die liefert Loc.getLanguage().
function LanguageController.getChoice(): string?
	return _choice
end

-- `code` = "de" | "en" | "fr" | "es", oder nil fuer "automatisch".
function LanguageController.choose(code: string?)
	if code ~= nil and not Loc.isSupported(code) then return end
	if code == _choice then return end

	_choice       = code
	_pendingUntil = os.clock() + PENDING_SECONDS
	applyChoice()

	Remotes.RequestSetLanguage:FireServer(code)
end

--------------------------------------------------------------------------------
-- Server-Stand
--------------------------------------------------------------------------------

local function onData(update: Types.PlayerDataUpdate)
	local serverValue = update.language

	-- Die gespeicherte Sprache aendert sich nur durch den Spieler selbst —
	-- fast jedes Update traegt denselben Wert wie das letzte. Dann gibt es
	-- nichts zu tun.
	if _seenServerValue and serverValue == _lastServerValue then
		return
	end
	_seenServerValue  = true
	_lastServerValue  = serverValue

	-- Eigene, noch nicht bestaetigte Wahl hat Vorrang
	if os.clock() < _pendingUntil then
		if serverValue == _choice then
			_pendingUntil = 0   -- bestaetigt
		end
		return
	end

	if serverValue ~= _choice then
		_choice = serverValue
		applyChoice()
	end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function LanguageController.init()
	-- Sofort: Roblox-Sprache, noch vor dem ersten Server-Sync
	applyChoice()

	ClientState.onChanged(onData)

	print("[LanguageController] Initialisiert |", Loc.getLanguage())
end

return LanguageController
]]></ProtectedString>
						<string name="ScriptGuid">{81DE99D3-6DFD-4019-A376-1A0498DF15F1}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">LanguageController</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">799be9253639b7590ad16e2100000d2b</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX05F1AB481A3A4B3FBC28D6B9197F0DD2">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- SkillFXController.luau
-- StarterPlayerScripts/Controllers/SkillFXController.luau
--
-- v14 (Mega Egg Tree, WP8): der SkillFX-Baukasten.
--
-- Spielt die Show einer Faehigkeit ab, wenn der Server sie im PIT meldet
-- (Remotes.SkillFXPlay, gefeuert von PitArenaService). WAS gezeigt wird,
-- steht als reine Daten in Config/SkillFXConfig — hier stehen nur die
-- Bausteine (aura, ring, pillar, ...) und der Ablauf.
--
-- Alles hier ist rein CLIENTSEITIG: die Teile entstehen nur auf diesem
-- Rechner, beruehren keine Physik und verschwinden nach ihrer Dauer selbst.
-- Der Server wartet waehrend der vollen Show einfach (SkillFXConfig.getDuration),
-- damit Kampf und Show zusammenpassen.
--
-- WER sieht was:
--   * Besitzer: alles — Welt-Effekte, Farbfilter, Blitz, Wackeln, Kamerafahrt.
--   * Andere Spieler in der Naehe: nur die Effekte in der Welt. Ihr Bild und
--     ihre Kamera gehoeren ihnen.
--
-- Partikel-Budget: alle Stueckzahlen werden mit dem Faktor der Grafikstufe
-- multipliziert (SkillFXConfig.PARTICLE_BUDGET), damit Handys nicht ruckeln.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")
local RunService        = game:GetService("RunService")
local Lighting          = game:GetService("Lighting")
local Debris            = game:GetService("Debris")

local Remotes       = require(ReplicatedStorage.Network.Remotes)
local SkillFXConfig = require(ReplicatedStorage.Config.SkillFXConfig)

local SkillFXController = {}

local player = Players.LocalPlayer

-- Wie weit weg ein Zuschauer noch Effekte sieht (Studs).
local SPECTATOR_DISTANCE = 260

local _folder: Folder? = nil

local function folder(): Folder
	if _folder and _folder.Parent then
		return _folder
	end
	local f = Instance.new("Folder")
	f.Name = "SkillFXLocal"
	f.Parent = workspace
	_folder = f
	return f
end

--------------------------------------------------------------------------------
-- Budget
--------------------------------------------------------------------------------

local function budgetFactor(): number
	local ok, level = pcall(function()
		local settingsObj = UserSettings():GetService("UserGameSettings")
		return (settingsObj :: any).SavedQualityLevel
	end)
	local b = SkillFXConfig.PARTICLE_BUDGET
	if not ok or level == nil or level == Enum.SavedQualitySetting.Automatic then
		return b.medium
	end
	local n = tonumber(string.match(tostring(level), "(%d+)$")) or 5
	if n <= 3 then return b.low end
	if n <= 6 then return b.medium end
	return b.high
end

local function scaled(count: number?, factor: number): number
	return math.max(SkillFXConfig.PARTICLE_BUDGET.MIN_COUNT, math.floor((count or 6) * factor + 0.5))
end

--------------------------------------------------------------------------------
-- Kleine Werkzeuge
--------------------------------------------------------------------------------

local function newPart(shape: Enum.PartType?, size: Vector3, color: Color3, cf: CFrame, transparency: number?): Part
	local p = Instance.new("Part")
	p.Shape        = shape or Enum.PartType.Block
	p.Size         = size
	p.Color        = color
	p.Material     = Enum.Material.Neon
	p.Anchored     = true
	p.CanCollide   = false
	p.CanQuery     = false
	p.CanTouch     = false
	p.CastShadow   = false
	p.CFrame       = cf
	p.Transparency = transparency or 0
	p.Parent       = folder()
	return p
end

local function tween(inst: Instance, seconds: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local t = TweenService:Create(inst, TweenInfo.new(math.max(0.01, seconds), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function fadeAndDestroy(p: BasePart, seconds: number, extra: { [string]: any }?)
	local props: { [string]: any } = { Transparency = 1 }
	if extra then
		for k, v in extra do props[k] = v end
	end
	tween(p, seconds, props)
	Debris:AddItem(p, seconds + 0.1)
end

local function centerOf(model: Model?): Vector3?
	if not model or not model.Parent then return nil end
	local ok, cf = pcall(function()
		return (model :: Model):GetBoundingBox()
	end)
	if not ok or typeof(cf) ~= "CFrame" then return nil end
	return (cf :: CFrame).Position
end

local RAINBOW = {
	Color3.fromRGB(255, 60, 60), Color3.fromRGB(255, 160, 40), Color3.fromRGB(255, 240, 60),
	Color3.fromRGB(80, 230, 90), Color3.fromRGB(60, 180, 255), Color3.fromRGB(150, 90, 255),
}

local function pickColor(step: { [string]: any }, fx: SkillFXConfig.SkillFX, i: number?): Color3
	if step.rainbow then
		return RAINBOW[((i or 1) - 1) % #RAINBOW + 1]
	end
	if step.dark then
		return fx.color2
	end
	if i and i % 2 == 0 then
		return fx.color2
	end
	return fx.color
end

--------------------------------------------------------------------------------
-- Kontext einer Show
--------------------------------------------------------------------------------

type Ctx = {
	fx       : SkillFXConfig.SkillFX,
	selfPos  : Vector3,
	targetPos: Vector3,
	arena    : Vector3,
	isOwner  : boolean,
	factor   : number,
	cc       : ColorCorrectionEffect?,
	sounds   : { [string]: boolean },
}

local function at(ctx: Ctx, where: string?): Vector3
	if where == "target" then return ctx.targetPos end
	if where == "arena" then return ctx.arena end
	return ctx.selfPos
end

--------------------------------------------------------------------------------
-- Bausteine
--------------------------------------------------------------------------------

local BLOCKS: { [string]: (Ctx, { [string]: any }) -> () } = {}

BLOCKS.aura = function(ctx, s)
	local pos = at(ctx, s.at)
	local size = s.size or 4
	local dur = s.dur or 0.6
	local ball = newPart(Enum.PartType.Ball, Vector3.one * size * 0.4, pickColor(s, ctx.fx), CFrame.new(pos), 0.35)
	local light = Instance.new("PointLight")
	light.Color = ball.Color
	light.Range = size * 3
	light.Brightness = 3
	light.Parent = ball
	tween(ball, dur * 0.5, { Size = Vector3.one * size }, Enum.EasingStyle.Back)
	if s.rainbow then
		task.spawn(function()
			local t0 = os.clock()
			while ball.Parent and os.clock() - t0 < dur do
				ball.Color = Color3.fromHSV(((os.clock() - t0) * 1.5) % 1, 0.8, 1)
				light.Color = ball.Color
				task.wait(0.05)
			end
		end)
	end
	task.delay(dur * 0.5, function()
		if ball.Parent then fadeAndDestroy(ball, dur * 0.5, { Size = Vector3.one * size * 1.3 }) end
	end)
end

BLOCKS.ring = function(ctx, s)
	local pos = at(ctx, s.at) - Vector3.new(0, 1.2, 0)
	local r = s.radius or 6
	local dur = s.dur or 0.6
	local startD = if s.shrink then r * 2 else 0.5
	local endD   = if s.shrink then 0.5 else r * 2
	local ring = newPart(Enum.PartType.Cylinder, Vector3.new(0.25, startD, startD), pickColor(s, ctx.fx),
		CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), 0.2)
	if s.rainbow or s.glyphs or s.infinity or s.clock then
		task.spawn(function()
			local t0 = os.clock()
			while ring.Parent and os.clock() - t0 < dur do
				local k = os.clock() - t0
				if s.rainbow then ring.Color = Color3.fromHSV((k * 1.2) % 1, 0.8, 1) end
				ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, k * (if s.clock then -6 else 4), math.rad(90))
				task.wait(0.03)
			end
		end)
	end
	tween(ring, dur, { Size = Vector3.new(0.25, endD, endD) })
	task.delay(dur * 0.6, function()
		if ring.Parent then fadeAndDestroy(ring, dur * 0.4) end
	end)
end

BLOCKS.pillar = function(ctx, s)
	local pos = at(ctx, s.at)
	local h = s.height or 16
	local w = s.width or 3
	local dur = s.dur or 0.8
	local base = pos - Vector3.new(0, 1.5, 0)
	local startCf = if s.fromSky
		then CFrame.new(base + Vector3.new(0, h * 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
		else CFrame.new(base) * CFrame.Angles(0, 0, math.rad(90))
	local col = newPart(Enum.PartType.Cylinder, Vector3.new(0.2, w, w), pickColor(s, ctx.fx), startCf, 0.15)
	tween(col, dur * 0.35, {
		Size = Vector3.new(h, w, w),
		CFrame = CFrame.new(base + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	}, Enum.EasingStyle.Quart)
	if s.beacon then
		task.spawn(function()
			local t0 = os.clock()
			while col.Parent and os.clock() - t0 < dur do
				col.Transparency = 0.15 + 0.5 * (0.5 + 0.5 * math.sin((os.clock() - t0) * 12))
				task.wait(0.03)
			end
		end)
	end
	task.delay(dur * 0.6, function()
		if col.Parent then fadeAndDestroy(col, dur * 0.4, { Size = Vector3.new(h, w * 0.2, w * 0.2) }) end
	end)
end

local function shootOne(ctx: Ctx, s: { [string]: any }, delaySeconds: number, offset: Vector3)
	task.delay(delaySeconds, function()
		local from = ctx.selfPos + Vector3.new(0, 0.5, 0) + offset
		local to = ctx.targetPos + Vector3.new(0, 0.5, 0)
		local size = s.size or 1
		local ball = newPart(Enum.PartType.Ball, Vector3.one * size, pickColor(s, ctx.fx), CFrame.new(from), 0)
		local a0 = Instance.new("Attachment"); a0.Position = Vector3.new(0, size * 0.3, 0); a0.Parent = ball
		local a1 = Instance.new("Attachment"); a1.Position = Vector3.new(0, -size * 0.3, 0); a1.Parent = ball
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(ball.Color, ctx.fx.color2)
		trail.Lifetime = 0.25
		trail.LightEmission = 1
		trail.Transparency = NumberSequence.new(0, 1)
		trail.Parent = ball
		if s.flame then
			local fire = Instance.new("Fire")
			fire.Size = size * 2
			fire.Color = ctx.fx.color
			fire.SecondaryColor = ctx.fx.color2
			fire.Parent = ball
		end
		local dur = s.dur or 0.3
		tween(ball, dur, { CFrame = CFrame.new(to) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(dur, function()
			if ball.Parent then fadeAndDestroy(ball, 0.15, { Size = Vector3.one * size * 2.5 }) end
		end)
	end)
end

BLOCKS.projectile = function(ctx, s)
	local n = s.count or 1
	for i = 1, n do
		local off = if n > 1 then Vector3.new(0, (i - (n + 1) / 2) * 0.9, 0) else Vector3.zero
		shootOne(ctx, s, (i - 1) * 0.07, off)
	end
end

BLOCKS.meteor = function(ctx, s)
	local to = at(ctx, s.at or "target")
	local h = s.height or 20
	local size = s.size or 2
	local dur = s.dur or 0.5
	local from = to + Vector3.new(h * 0.35, h, -h * 0.2)
	local rock = newPart(Enum.PartType.Ball, Vector3.one * size, pickColor(s, ctx.fx), CFrame.new(from), 0)
	if s.fist then
		rock.Shape = Enum.PartType.Block
		rock.Size = Vector3.new(size, size * 1.2, size * 0.9)
		rock.Material = Enum.Material.Slate
	end
	if s.tail or s.fist then
		local fire = Instance.new("Fire")
		fire.Size = size * 3
		fire.Heat = 25
		fire.Color = ctx.fx.color
		fire.SecondaryColor = ctx.fx.color2
		fire.Parent = rock
	end
	local light = Instance.new("PointLight")
	light.Range = size * 6
	light.Brightness = 4
	light.Color = rock.Color
	light.Parent = rock
	tween(rock, dur, { CFrame = CFrame.new(to) }, if s.slow then Enum.EasingStyle.Sine else Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(dur, function()
		if rock.Parent then fadeAndDestroy(rock, if s.dark then 1.2 else 0.25, { Size = rock.Size * 1.6 }) end
	end)
end

BLOCKS.beam = function(ctx, s)
	local from = ctx.selfPos + Vector3.new(0, 0.5, 0)
	local to = ctx.targetPos + Vector3.new(0, 0.5, 0)
	if s.curtain then
		from = ctx.selfPos + Vector3.new(-6, 9, 0)
		to = ctx.targetPos + Vector3.new(6, 9, 0)
	end
	local dist = (to - from).Magnitude
	local w = s.width or 1
	local dur = s.dur or 0.6
	local mid = (from + to) / 2
	local cf = CFrame.lookAt(mid, to)
	if s.cross then
		cf = cf * CFrame.Angles(0, 0, math.rad(90))
	end
	local beam = newPart(Enum.PartType.Block, Vector3.new(w * 0.2, w * 0.2, 0.2), pickColor(s, ctx.fx), cf, 0.05)
	if s.slash or s.rift then
		beam.Color = if s.rift then Color3.new(0, 0, 0) else ctx.fx.color2
		beam.Size = Vector3.new(w, 0.1, 0.1)
		beam.CFrame = CFrame.lookAt(ctx.targetPos, ctx.targetPos + Vector3.new(0, 1, 0.001)) * CFrame.Angles(0, 0, if s.cross then math.rad(-35) else math.rad(35))
		tween(beam, dur * 0.4, { Size = Vector3.new(w, 9, 0.1) }, Enum.EasingStyle.Quart)
	else
		tween(beam, dur * 0.3, { Size = Vector3.new(w, if s.curtain then w * 3 else w, dist) }, Enum.EasingStyle.Quart)
	end
	if s.rainbow or s.curtain then
		task.spawn(function()
			local t0 = os.clock()
			while beam.Parent and os.clock() - t0 < dur do
				beam.Color = Color3.fromHSV(((os.clock() - t0) * (if s.curtain then 0.4 else 1.5) + 0.35) % 1, 0.7, 1)
				task.wait(0.04)
			end
		end)
	end
	task.delay(dur * 0.65, function()
		if beam.Parent then fadeAndDestroy(beam, dur * 0.35) end
	end)
end

BLOCKS.wave = function(ctx, s)
	local pos = at(ctx, s.at)
	local r = s.radius or 10
	local dur = s.dur or 0.6
	local ball = newPart(Enum.PartType.Ball, Vector3.one, pickColor(s, ctx.fx), CFrame.new(pos), 0.3)
	ball.Material = if s.cloud then Enum.Material.SmoothPlastic else Enum.Material.ForceField
	tween(ball, dur, { Size = Vector3.one * r * 2, Transparency = 1 }, Enum.EasingStyle.Quart)
	Debris:AddItem(ball, dur + 0.1)
end

BLOCKS.shards = function(ctx, s)
	local pos = at(ctx, s.at)
	local n = scaled(s.count, ctx.factor)
	local size = s.size or 0.6
	local dur = s.dur or 0.6
	for i = 1, n do
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8 + 0.1, math.random() - 0.5).Unit
		local from = if s.inward then pos + dir * 6 else pos
		local to = if s.inward then pos else pos + dir * (5 + math.random() * 6)
		local p = newPart(Enum.PartType.Block, Vector3.new(size, size * 1.6, size * 0.5), pickColor(s, ctx.fx, i),
			CFrame.new(from) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), 0)
		if s.stone then
			p.Material = Enum.Material.Slate
			p.Color = Color3.fromRGB(120, 110, 100):Lerp(ctx.fx.color, 0.25)
		end
		if s.glyphs then
			p.Shape = Enum.PartType.Ball
		end
		tween(p, dur, { CFrame = CFrame.new(to) * CFrame.Angles(math.random() * 6, math.random() * 6, 0) })
		task.delay(dur * 0.5, function()
			if p.Parent then fadeAndDestroy(p, dur * 0.5) end
		end)
	end
end

BLOCKS.sparks = function(ctx, s)
	local pos = at(ctx, s.at)
	local n = scaled(s.count, ctx.factor)
	local dur = s.dur or 0.6
	for i = 1, n do
		local dir = Vector3.new(math.random() - 0.5, math.random() - 0.2, math.random() - 0.5).Unit
		local size = if s.stars then 0.35 else 0.22
		local p = newPart(Enum.PartType.Ball, Vector3.one * size, pickColor(s, ctx.fx, i), CFrame.new(pos), 0)
		local reach = (if s.stars then 14 else 6) * (0.5 + math.random())
		local endPos = pos + dir * reach + (if s.ember then Vector3.new(0, 3, 0) else Vector3.zero)
		tween(p, dur, { CFrame = CFrame.new(endPos), Transparency = 1 }, Enum.EasingStyle.Quad)
		Debris:AddItem(p, dur + 0.1)
	end
end

BLOCKS.bubble = function(ctx, s)
	local pos = at(ctx, s.at)
	local size = s.size or 6
	local dur = s.dur or 1
	local b = newPart(Enum.PartType.Ball, Vector3.one * 0.5, pickColor(s, ctx.fx), CFrame.new(pos), 0.55)
	b.Material = Enum.Material.ForceField
	tween(b, dur * 0.25, { Size = Vector3.one * size }, Enum.EasingStyle.Back)
	if s.hex then
		local inner = newPart(Enum.PartType.Ball, Vector3.one * 0.5, ctx.fx.color2, CFrame.new(pos), 0.8)
		inner.Material = Enum.Material.Glass
		tween(inner, dur * 0.3, { Size = Vector3.one * size * 0.92 })
		task.delay(dur * 0.7, function() if inner.Parent then fadeAndDestroy(inner, dur * 0.3) end end)
	end
	task.delay(dur * 0.7, function()
		if b.Parent then fadeAndDestroy(b, dur * 0.3) end
	end)
end

BLOCKS.rise = function(ctx, s)
	local pos = at(ctx, s.at)
	local n = scaled(s.count, ctx.factor)
	local dur = s.dur or 0.8
	for i = 1, n do
		task.delay((i / n) * dur * 0.5, function()
			local off = Vector3.new((math.random() - 0.5) * 4, -1, (math.random() - 0.5) * 4)
			if s.wings then
				local side = if i % 2 == 0 then 1 else -1
				off = Vector3.new(side * (1 + math.random() * 5), math.random() * 2, (math.random() - 0.5) * 2)
			end
			local p = newPart(Enum.PartType.Ball, Vector3.one * 0.35, pickColor(s, ctx.fx, i), CFrame.new(pos + off), 0)
			local goal = pos + off + Vector3.new(0, 4 + math.random() * 3, 0)
			if s.toSelf then goal = ctx.selfPos + Vector3.new(0, 1, 0) end
			tween(p, dur * 0.6, { CFrame = CFrame.new(goal), Transparency = 1 }, Enum.EasingStyle.Sine)
			Debris:AddItem(p, dur * 0.6 + 0.1)
		end)
	end
end

BLOCKS.spiral = function(ctx, s)
	local center = at(ctx, s.at)
	local n = scaled(s.count, ctx.factor)
	local r = s.radius or 8
	local dur = s.dur or 1
	for i = 1, n do
		local angle = (i / n) * math.pi * 2
		local startR = if s.outward then 0.5 else r
		local endR = if s.outward then r else 0.3
		local size = if s.cloud then 1.4 else (if s.snow then 0.3 else 0.4)
		local p = newPart(Enum.PartType.Ball, Vector3.one * size, pickColor(s, ctx.fx, i),
			CFrame.new(center + Vector3.new(math.cos(angle) * startR, (math.random() - 0.3) * 3, math.sin(angle) * startR)),
			if s.cloud then 0.5 else 0)
		task.spawn(function()
			local t0 = os.clock()
			while p.Parent and os.clock() - t0 < dur do
				local k = (os.clock() - t0) / dur
				local rr = startR + (endR - startR) * k
				local a = angle + k * math.pi * 3
				p.CFrame = CFrame.new(center + Vector3.new(math.cos(a) * rr, (1 - k) * 2, math.sin(a) * rr))
				task.wait(0.03)
			end
			if p.Parent then fadeAndDestroy(p, 0.15) end
		end)
	end
end

BLOCKS.frost = function(ctx, s)
	local pos = at(ctx, s.at)
	local n = scaled(s.count, ctx.factor)
	local dur = s.dur or 0.8
	for i = 1, n do
		local off = Vector3.new((math.random() - 0.5) * 3, (math.random() - 0.3) * 2.5, (math.random() - 0.5) * 3)
		local p = newPart(Enum.PartType.Block, Vector3.new(0.1, 0.1, 0.1), ctx.fx.color,
			CFrame.new(pos + off) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6), 0.1)
		p.Material = Enum.Material.Ice
		tween(p, dur * 0.3, { Size = Vector3.new(0.3, 1.2 + math.random(), 0.3) }, Enum.EasingStyle.Back)
		task.delay(dur * 0.7, function() if p.Parent then fadeAndDestroy(p, dur * 0.3) end end)
	end
end

BLOCKS.starfield = function(ctx, s)
	local center = ctx.arena
	local n = scaled(s.count, ctx.factor)
	local dur = s.dur or 3
	for i = 1, n do
		local a = math.random() * math.pi * 2
		local r = 10 + math.random() * 35
		local pos = center + Vector3.new(math.cos(a) * r, 18 + math.random() * 30, math.sin(a) * r)
		local col = if s.nebula then pickColor({ rainbow = false }, ctx.fx, i) else Color3.new(1, 1, 1)
		local p = newPart(Enum.PartType.Ball, Vector3.one * (0.2 + math.random() * 0.4), col, CFrame.new(pos), 1)
		tween(p, 0.4 + math.random() * 0.6, { Transparency = 0.1 })
		task.delay(dur * 0.75, function() if p.Parent then fadeAndDestroy(p, dur * 0.25) end end)
	end
end

-- Ab hier: nur fuer den Besitzer (Bildschirm und Kamera gehoeren ihm).

local function ensureCC(ctx: Ctx): ColorCorrectionEffect
	if ctx.cc and ctx.cc.Parent then return ctx.cc end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "SkillFX_Sky"
	cc.Parent = Lighting
	ctx.cc = cc
	return cc
end

BLOCKS.sky = function(ctx, s)
	if not ctx.isOwner then return end
	local cc = ensureCC(ctx)
	local dur = s.dur or 2
	tween(cc, 0.35, {
		TintColor = s.tint or Color3.new(1, 1, 1),
		Brightness = s.brightness or 0,
		Saturation = s.saturation or 0,
	})
	task.delay(math.max(0.4, dur - 0.5), function()
		if cc.Parent then
			tween(cc, 0.5, { TintColor = Color3.new(1, 1, 1), Brightness = 0, Saturation = 0, Contrast = 0 })
		end
	end)
end

BLOCKS.spectrum = function(ctx, s)
	if not ctx.isOwner then return end
	local cc = ensureCC(ctx)
	local dur = s.dur or 1.5
	task.spawn(function()
		local t0 = os.clock()
		while cc.Parent and os.clock() - t0 < dur do
			cc.TintColor = Color3.fromHSV(((os.clock() - t0) / dur) % 1, 0.45, 1)
			cc.Saturation = 0.6
			task.wait(0.03)
		end
		if cc.Parent then
			tween(cc, 0.3, { TintColor = Color3.new(1, 1, 1), Saturation = 0 })
		end
	end)
end

BLOCKS.hitstop = function(ctx, s)
	-- Den Server-Kampf kann der Client nicht anhalten. "Zeitlupe" heisst hier:
	-- Bild entsaettigt, Kontrast hoch, Sichtfeld zieht kurz zusammen.
	local dur = s.dur or 0.3
	if ctx.isOwner then
		local cc = ensureCC(ctx)
		local before = { Saturation = cc.Saturation, Contrast = cc.Contrast }
		cc.Saturation = -0.8
		cc.Contrast = 0.35
		task.delay(dur, function()
			if cc.Parent then tween(cc, 0.25, before) end
		end)
		local cam = workspace.CurrentCamera
		if cam then
			local fov = cam.FieldOfView
			tween(cam, dur * 0.4, { FieldOfView = math.max(30, fov - 12) })
			task.delay(dur, function() tween(cam, 0.3, { FieldOfView = fov }) end)
		end
	end
end

local _flashGui: ScreenGui? = nil
BLOCKS.flash = function(ctx, s)
	if not ctx.isOwner then return end
	local gui = _flashGui
	if not gui or not gui.Parent then
		local g = Instance.new("ScreenGui")
		g.Name = "SkillFXFlash"
		g.IgnoreGuiInset = true
		g.DisplayOrder = 50
		g.ResetOnSpawn = false
		g.Parent = player:WaitForChild("PlayerGui")
		_flashGui = g
		gui = g
	end
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.BackgroundTransparency = 0.05
	f.BorderSizePixel = 0
	f.Parent = gui
	tween(f, s.dur or 0.3, { BackgroundTransparency = 1 })
	Debris:AddItem(f, (s.dur or 0.3) + 0.1)
end

local _shakeUntil = 0
local _shakePower = 0
local _shakeBound = false
BLOCKS.shake = function(ctx, s)
	if not ctx.isOwner then return end
	_shakeUntil = math.max(_shakeUntil, os.clock() + (s.dur or 0.3))
	_shakePower = math.max(_shakePower, s.power or 0.5)
	if _shakeBound then return end
	_shakeBound = true
	RunService:BindToRenderStep("SkillFXShake", Enum.RenderPriority.Camera.Value + 1, function()
		local cam = workspace.CurrentCamera
		local left = _shakeUntil - os.clock()
		if left <= 0 or not cam then
			RunService:UnbindFromRenderStep("SkillFXShake")
			_shakeBound = false
			_shakePower = 0
			return
		end
		local p = _shakePower * math.min(1, left * 3) * 0.6
		cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * p, (math.random() - 0.5) * p, 0)
	end)
end

local _cinematic = false
BLOCKS.cinematic = function(ctx, s)
	if not ctx.isOwner or not SkillFXConfig.CINEMATIC_CAMERA or _cinematic then return end
	if not SkillFXConfig.TIERS[ctx.fx.tier].cinematic then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	_cinematic = true
	local dur = math.min(2.5, s.dur or 2)
	local center = (ctx.selfPos + ctx.targetPos) / 2
	local oldType = cam.CameraType
	local oldCf = cam.CFrame
	cam.CameraType = Enum.CameraType.Scriptable
	local style = s.style or "orbit"
	local t0 = os.clock()
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		local k = math.clamp((os.clock() - t0) / dur, 0, 1)
		local eye: Vector3
		if style == "up" then
			eye = center + Vector3.new(14 - 4 * k, 2 + 4 * k, 14 - 4 * k)
			cam.CFrame = CFrame.lookAt(eye, center + Vector3.new(0, 6 + 20 * (1 - k), 0))
		elseif style == "low" then
			eye = center + Vector3.new(-10 + 6 * k, 1.2, 8)
			cam.CFrame = CFrame.lookAt(eye, ctx.targetPos)
		elseif style == "side" then
			eye = center + Vector3.new(0, 4, 18 - 6 * k)
			cam.CFrame = CFrame.lookAt(eye, center)
		else
			local a = k * math.pi * 0.9
			eye = center + Vector3.new(math.cos(a) * 16, 6, math.sin(a) * 16)
			cam.CFrame = CFrame.lookAt(eye, center)
		end
		if k >= 1 then
			if conn then conn:Disconnect() end
			cam.CFrame = oldCf
			cam.CameraType = if oldType == Enum.CameraType.Scriptable then Enum.CameraType.Custom else oldType
			_cinematic = false
		end
	end)
end

BLOCKS.sound = function(ctx, s)
	local slot = s.slot or "strike"
	local key = (ctx.fx.sounds :: any)[slot]
	if not key then return end
	local id = SkillFXConfig.SOUND_LIBRARY[key] or key
	local anchor = newPart(Enum.PartType.Block, Vector3.one * 0.1, Color3.new(), CFrame.new(ctx.selfPos), 1)
	local snd = Instance.new("Sound")
	snd.SoundId = if tonumber(id) then "rbxassetid://" .. id else id
	-- v15: leiser, Echo noch leiser, nach MAX_SECONDS ausgeblendet
	-- (SkillFXConfig.SOUND) — die eingebauten Klaenge sind sonst sehr hart.
	local cfg = SkillFXConfig.SOUND
	local volume = if ctx.isOwner then cfg.OWNER_VOLUME else cfg.SPECTATOR_VOLUME
	if s.echo then
		volume *= cfg.ECHO_FACTOR
	end
	snd.Volume = volume
	snd.PlaybackSpeed = (ctx.fx.pitch or 1) * (if slot == "charge" then 0.9 elseif slot == "impact" then 0.8 else 1)
	snd.RollOffMode = Enum.RollOffMode.InverseTapered
	snd.RollOffMinDistance = cfg.ROLLOFF_MIN
	snd.RollOffMaxDistance = cfg.ROLLOFF_MAX
	snd.Parent = anchor
	snd:Play()
	task.delay(cfg.MAX_SECONDS, function()
		if snd.Parent ~= nil and snd.IsPlaying then
			tween(snd, cfg.FADE_SECONDS, { Volume = 0 })
		end
	end)
	Debris:AddItem(anchor, cfg.MAX_SECONDS + cfg.FADE_SECONDS + 0.2)
end

--------------------------------------------------------------------------------
-- Abspielen
--------------------------------------------------------------------------------

export type PlayRequest = {
	owner    : number,     -- UserId des Besitzers
	skillId  : string,
	full     : boolean,    -- volle Show (erster Einsatz im Lauf) oder kurzes Echo
	attacker : Model?,     -- die Figur des Baerchis
	target   : Model?,     -- der Gegner
	center   : Vector3?,   -- Arena-Mitte (Fallback fuer Positionen)
}

function SkillFXController.play(req: PlayRequest)
	local fx = SkillFXConfig.get(req.skillId)
	local selfPos = centerOf(req.attacker) or req.center
	if not selfPos then return end
	local targetPos = centerOf(req.target) or (selfPos + Vector3.new(0, 0, -8))
	local isOwner = req.owner == player.UserId

	if not isOwner then
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root or (root.Position - selfPos).Magnitude > SPECTATOR_DISTANCE then
			return
		end
	end

	local ctx: Ctx = {
		fx = fx,
		selfPos = selfPos,
		targetPos = targetPos,
		arena = req.center or (selfPos + targetPos) / 2,
		isOwner = isOwner,
		factor = budgetFactor() * (if isOwner then 1 else 0.6),
		cc = nil,
		sounds = {},
	}

	if not req.full then
		-- Echo: die ersten zwei Welt-Effekte der Show, stark verkuerzt.
		local shown = 0
		for _, step in fx.steps do
			local block = BLOCKS[step.fx]
			if block and step.fx ~= "sound" and step.fx ~= "sky" and step.fx ~= "cinematic"
				and step.fx ~= "spectrum" and step.fx ~= "hitstop" and step.fx ~= "starfield"
				and step.fx ~= "flash" and step.fx ~= "shake"
			then
				local short = table.clone(step)
				short.dur = math.min(step.dur or 0.4, SkillFXConfig.TIERS[fx.tier].echo)
				task.spawn(block, ctx, short)
				shown += 1
				if shown >= 2 then break end
			end
		end
		BLOCKS.sound(ctx, { slot = "strike", echo = true })
		return
	end

	local maxDur = SkillFXConfig.getDuration(req.skillId, true)
	for _, step in fx.steps do
		local block = BLOCKS[step.fx]
		if block then
			local t = math.min(step.t or 0, maxDur)
			task.delay(t, function()
				local ok, err = pcall(block, ctx, step)
				if not ok then
					warn("[SkillFX]", req.skillId, step.fx, err)
				end
			end)
		end
	end

	-- Farbfilter am Ende sicher entfernen.
	task.delay(maxDur + 1, function()
		if ctx.cc and ctx.cc.Parent then
			tween(ctx.cc, 0.3, { TintColor = Color3.new(1, 1, 1), Brightness = 0, Saturation = 0, Contrast = 0 })
			Debris:AddItem(ctx.cc, 0.4)
		end
	end)
end

function SkillFXController.init()
	Remotes.SkillFXPlay.OnClientEvent:Connect(function(req: any)
		if typeof(req) ~= "table" or typeof(req.skillId) ~= "string" then return end
		local ok, err = pcall(SkillFXController.play, req)
		if not ok then
			warn("[SkillFXController] Show fehlgeschlagen:", err)
		end
	end)
	print("[SkillFXController] Bereit")
end

return SkillFXController
]]></ProtectedString>
						<string name="ScriptGuid">{3BF0EDAE-C756-458A-A221-A40CD4EE75E5}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">SkillFXController</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">690d8b1f16c2bd080ad30dbb000028ff</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXE3EF7E8D54B640CAA5835E50F165BBF5">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- CombController.luau
-- StarterPlayerScripts/Controllers/CombController.luau
--
-- Einzige Zustaendigkeit:
--   - Alles, was der Spieler von den Honigwaben im Event-Pit und vom
--     Waben-Recycler SIEHT und ausloest:
--       1. Eine kleine Anzeige "Waben 12/25" (nur wenn er welche traegt)
--       2. Meldungen bei Abgabe und Recycler-Ausbau
--       3. Den Ausbau-Prompt am EIGENEN Recycler
--       4. Das Wippen und Drehen der im Pit liegenden Waben
--
-- Die Wahrheit liegt komplett auf dem Server (CombService, CombRecyclerService):
-- was getragen wird, kommt ueber Player-Attribute ("CombsCarried"/"CombsMax"),
-- Level und Warteschlange des Recyclers ueber PlayerDataUpdated. Dieser Controller
-- rechnet nichts und entscheidet nichts.
--
-- Der Prompt entsteht auf dem Client, nur am eigenen Plot — dasselbe Muster wie
-- die Gebaeude-Prompts im WorldController (der Server wendet die Anfrage ohnehin
-- immer auf die Daten des anfragenden Spielers an).

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local MapConfig  = require(ReplicatedStorage.Config.MapConfig)
local Remotes    = require(ReplicatedStorage.Network.Remotes)
local Loc        = require(ReplicatedStorage.Localization.Loc)

local Theme       = require(script.Parent.Parent.UI.Theme)
local Toast       = require(script.Parent.Parent.UI.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify      = require(script.Parent.Parent.UI.Notify)
local Feedback    = require(script.Parent.Parent.UI.Feedback)
local ClientState = require(script.Parent.ClientState)

local CombController = {}

local localPlayer = Players.LocalPlayer

local WORLD_FOLDER_NAME = "EventPitCombs"
local OWNER_ATTRIBUTE   = "PlotOwner"
local PROMPT_NAME       = "UpgradeRecycler"
local PROMPT_DISTANCE   = 14
local PROMPT_HOLD       = 0.4

-- Wippen und Drehen der Waben im Pit (rein optisch, nur auf diesem Client)
local BOB_HEIGHT = 0.32
local BOB_RATE   = 2.0    -- Schwingungen pro Sekunde (in Radiant: * 1)
local SPIN_RATE  = 0.9    -- Radiant pro Sekunde

--------------------------------------------------------------------------------
-- Anzeige "Waben x/y"
--------------------------------------------------------------------------------

local _pill: Frame? = nil
local _carryLabel: TextLabel? = nil
local _hintLabel: TextLabel? = nil

local function isInPit(): boolean
	local character = localPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not root or not root:IsA("BasePart") then return false end

	local flat = Vector3.new(
		root.Position.X - MapConfig.CENTER.X,
		0,
		root.Position.Z - MapConfig.CENTER.Z
	)
	return flat.Magnitude <= MapConfig.EVENT_PIT_RADIUS
end

local function refreshCarry()
	local pill, carryLabel, hint = _pill, _carryLabel, _hintLabel
	if not pill or not carryLabel or not hint then return end

	local count = localPlayer:GetAttribute("CombsCarried")
	local max   = localPlayer:GetAttribute("CombsMax")
	if typeof(count) ~= "number" or typeof(max) ~= "number" or count <= 0 then
		pill.Visible = false
		return
	end

	pill.Visible = true
	carryLabel.Text = Loc.t("ui.comb.carry", { n = count, max = max })

	if count >= max then
		hint.Text = Loc.t("ui.comb.full")
		hint.TextColor3 = Theme.COLORS.goldGummy
	elseif isInPit() then
		hint.Text = Loc.t("ui.comb.slow")
		hint.TextColor3 = Theme.COLORS.textDim
	else
		hint.Text = ""
	end
end

local function buildPill(screenGui: ScreenGui)
	local pill = Theme.panel("CombPill", screenGui, Theme.COLORS.panel)
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.Position    = UDim2.new(0.5, 0, 0, 12)
	pill.Size        = UDim2.new(0, 250, 0, 54)
	pill.Visible     = false

	local carry = Theme.label("Carry", pill, "")
	carry.Position       = UDim2.new(0, 10, 0, 4)
	carry.Size           = UDim2.new(1, -20, 0, 26)
	carry.TextXAlignment = Enum.TextXAlignment.Center
	carry.TextColor3     = Theme.COLORS.goldGummy

	local hint = Theme.bodyText("Hint", pill, "")
	hint.Position       = UDim2.new(0, 10, 0, 30)
	hint.Size           = UDim2.new(1, -20, 0, 20)
	hint.TextXAlignment = Enum.TextXAlignment.Center

	_pill        = pill
	_carryLabel  = carry
	_hintLabel   = hint
end

--------------------------------------------------------------------------------
-- Recycler-Prompt (nur am eigenen Plot)
--------------------------------------------------------------------------------

local function findPlotOwner(instance: Instance): number?
	local current: Instance? = instance
	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner
		end
		current = current.Parent
	end
	return nil
end

local function costText(level: number): string
	local cost = CombConfig.getUpgradeCost(level + 1)
	if not cost then
		return Loc.t("ui.recycler.maxed")
	end

	local text = if cost.goldGummies > 0
		then Loc.t("ui.recycler.cost_gg", { gummies = Theme.formatNumber(cost.gummies), gold = cost.goldGummies })
		else Loc.t("ui.recycler.cost_g", { gummies = Theme.formatNumber(cost.gummies) })

	return Loc.t("ui.recycler.upgrade", { cost = text })
end

local function writePrompt(prompt: ProximityPrompt)
	local data = ClientState.get()
	local level = if data then data.island.recycler.level else 1

	prompt.ObjectText = string.format("%s  Lv.%d", Loc.t("ui.recycler.name"), level)

	if level >= CombConfig.RECYCLER_MAX_LEVEL then
		prompt.ActionText = Loc.t("ui.recycler.maxed")
		prompt.Enabled    = false
	else
		prompt.ActionText = costText(level)
		prompt.Enabled    = true
	end
end

local _prompts: { ProximityPrompt } = {}

local function attachPrompt(body: BasePart)
	if body:FindFirstChild(PROMPT_NAME) then return end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = PROMPT_NAME
	prompt.KeyboardKeyCode       = Enum.KeyCode.E
	prompt.HoldDuration          = PROMPT_HOLD
	prompt.MaxActivationDistance = PROMPT_DISTANCE
	prompt.RequiresLineOfSight   = false
	prompt.Parent                = body

	prompt.Triggered:Connect(function()
		Remotes.RequestUpgradeRecycler:FireServer()
	end)

	table.insert(_prompts, prompt)
	prompt.Destroying:Connect(function()
		local index = table.find(_prompts, prompt)
		if index then table.remove(_prompts, index) end
	end)

	writePrompt(prompt)
end

local function hookWorldPart(instance: Instance)
	if not instance:IsA("BasePart") then return end
	if instance.Name ~= CombConfig.RECYCLER_NAME then return end

	local function tryAttach()
		if findPlotOwner(instance) == localPlayer.UserId then
			attachPrompt(instance)
			return true
		end
		return false
	end

	if tryAttach() then return end

	-- Replikation ist nicht sortiert: das Plot-Model kann beim Client ankommen,
	-- bevor sein Besitzer-Attribut da ist. Einmal im naechsten Frame nachsehen.
	task.defer(function()
		if instance.Parent then
			tryAttach()
		end
	end)
end

--------------------------------------------------------------------------------
-- Waben im Pit: Wippen und Drehen
--------------------------------------------------------------------------------

-- `fly` = Einflug (Vulkan-Ausbruch, Waben-Regen): von `from` zur Ruhelage
-- zwischen den Serverzeiten `start` und `finish` (Attribute FlyFrom/FlyStart/FlyEnd).
type Fly = { from: Vector3, start: number, finish: number }
type Bob = { base: CFrame?, phase: number, spawnTime: number, fly: Fly? }

local _bobbing: { [Model]: Bob } = {}

-- Wie oft trackComb auf fehlende Attribute wartet (je ein Frame), bevor die
-- Wabe aufgegeben wird. Attribute kommen mit dem Model selbst an; das ist nur
-- ein Sicherheitsnetz.
local BASE_RETRY_FRAMES = 6

-- Auftauch-Effekt frisch gespawnter Waben: steigt aus dem Boden und federt nach.
local POP_SECONDS = 0.45
local POP_DEPTH   = 1.6

-- Baut die Ruhelage aus den Attributen "Pos"/"Yaw" (CombBuilder.buildWorldComb).
-- NIE aus GetPivot(): siehe Kopf von buildWorldComb.
local function readBase(model: Model): CFrame?
	local pos = model:GetAttribute("Pos")
	local yaw = model:GetAttribute("Yaw")
	if typeof(pos) ~= "Vector3" or typeof(yaw) ~= "number" then
		return nil
	end
	return CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
end

local function trackComb(child: Instance)
	if not child:IsA("Model") then return end
	local model = child :: Model

	local phase = model:GetAttribute("Phase")
	local spawnTime = model:GetAttribute("SpawnTime")
	local flyFrom   = model:GetAttribute("FlyFrom")
	local flyStart  = model:GetAttribute("FlyStart")
	local flyEnd    = model:GetAttribute("FlyEnd")
	local fly: Fly? = nil
	if typeof(flyFrom) == "Vector3" and typeof(flyStart) == "number" and typeof(flyEnd) == "number" then
		fly = { from = flyFrom, start = flyStart, finish = flyEnd }
	end
	local bob: Bob = {
		base      = readBase(model),
		phase     = if typeof(phase) == "number" then phase else 0,
		-- Fliegende Waben tauchen nicht zusaetzlich aus dem Boden auf.
		spawnTime = if fly then 0 elseif typeof(spawnTime) == "number" then spawnTime else 0,
		fly       = fly,
	}
	_bobbing[model] = bob

	if bob.base then return end

	-- Sicherheitsnetz: Attribute fehlen noch. Ein paar Frames nachsehen, bis
	-- dahin ueberspringt animateCombs diese Wabe (kein PivotTo mit Identitaet).
	task.spawn(function()
		for _ = 1, BASE_RETRY_FRAMES do
			task.wait()
			if _bobbing[model] ~= bob then return end
			local base = readBase(model)
			if base then
				bob.base = base
				return
			end
		end
	end)
end

local function hookWorldFolder(folder: Instance)
	for _, child in folder:GetChildren() do
		trackComb(child)
	end
	folder.ChildAdded:Connect(trackComb)
	folder.ChildRemoved:Connect(function(child)
		if child:IsA("Model") then
			_bobbing[child] = nil
		end
	end)
end

-- Versatz nach unten waehrend des Auftauchens (0 = fertig). Ueberschwingt kurz.
local function popOffset(now: number, spawnTime: number): number
	local age = now - spawnTime
	if spawnTime <= 0 or age >= POP_SECONDS or age < 0 then return 0 end
	local k = age / POP_SECONDS
	-- 1 → 0 mit kleinem Ueberschwinger (Back-Ease-Out)
	local c = 1.7
	local eased = 1 + (c + 1) * (k - 1) ^ 3 + c * (k - 1) ^ 2
	return -POP_DEPTH * (1 - eased)
end

-- Einflug: Bogen von `from` zur Ruhelage, Hoehe CombConfig.FLIGHT_ARC_HEIGHT.
-- nil = Flug ist vorbei (oder hat noch nicht begonnen und die Wabe wartet oben).
local function flyPosition(fly: Fly, landing: Vector3, now: number): Vector3?
	if now >= fly.finish then return nil end
	local span = math.max(0.05, fly.finish - fly.start)
	local k = math.clamp((now - fly.start) / span, 0, 1)
	local arc = 4 * k * (1 - k) * CombConfig.FLIGHT_ARC_HEIGHT
	return fly.from:Lerp(landing, k) + Vector3.new(0, arc, 0)
end

local function animateCombs()
	local t = os.clock()
	local serverNow = Workspace:GetServerTimeNow()
	for model, bob in _bobbing do
		local base = bob.base
		local fly = bob.fly
		if base and fly and model.Parent then
			local pos = flyPosition(fly, base.Position, serverNow)
			if pos then
				model:PivotTo(CFrame.new(pos) * CFrame.Angles(t * 6, t * SPIN_RATE * 3, 0))
				continue
			end
			bob.fly = nil
		end
		if base and model.Parent then
			local lift = math.sin(t * BOB_RATE + bob.phase) * BOB_HEIGHT + popOffset(serverNow, bob.spawnTime)
			model:PivotTo(base * CFrame.new(0, lift, 0) * CFrame.Angles(0, t * SPIN_RATE + bob.phase, 0))
		end
	end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function CombController.init(screenGui: ScreenGui)
	buildPill(screenGui)

	for _, name in { "CombsCarried", "CombsMax" } do
		localPlayer:GetAttributeChangedSignal(name):Connect(refreshCarry)
	end
	refreshCarry()

	-- "Im Pit" aendert sich ohne Attribut-Aenderung, deshalb ein gemuetlicher
	-- Takt fuer den Hinweistext.
	task.spawn(function()
		while true do
			task.wait(0.4)
			refreshCarry()
		end
	end)

	Remotes.CombDelivered.OnClientEvent:Connect(function(count: any, _units: any)
		if typeof(count) ~= "number" then return end
		Notify.emit("comb_delivered", function()
			Toast.success(Loc.tn("msg.comb_delivered", count))
		end, function()
			Feedback.gain("comb", count)
		end)
	end)

	Remotes.RecyclerUpgraded.OnClientEvent:Connect(function(level: any)
		if typeof(level) ~= "number" then return end
		Notify.emit("recycler_upgraded", function()
			Toast.success(Loc.t("msg.recycler_upgraded", { level = level }))
		end, function()
			Feedback.gain("upgrade", level)
		end)
	end)

	-- Prompt-Text nachziehen, wenn sich Level/Gummies aendern oder die Sprache
	ClientState.onChanged(function()
		for _, prompt in _prompts do
			writePrompt(prompt)
		end
	end)
	Loc.onChanged(function()
		for _, prompt in _prompts do
			writePrompt(prompt)
		end
		refreshCarry()
	end)

	for _, descendant in Workspace:GetDescendants() do
		hookWorldPart(descendant)
	end
	Workspace.DescendantAdded:Connect(hookWorldPart)

	local existing = Workspace:FindFirstChild(WORLD_FOLDER_NAME)
	if existing then
		hookWorldFolder(existing)
	end
	Workspace.ChildAdded:Connect(function(child)
		if child.Name == WORLD_FOLDER_NAME then
			hookWorldFolder(child)
		end
	end)

	RunService.RenderStepped:Connect(animateCombs)

	print("[CombController] Initialisiert")
end

return CombController
]]></ProtectedString>
						<string name="ScriptGuid">{1EC4C1E8-6A54-4035-BACF-9ECF4878B216}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">CombController</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">08eaaf7cd91c3e760ad3af9b000026f6</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX3BD516E59E4946C8839DAC84B0544320">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- AmbienceController.luau
-- StarterPlayerScripts/Controllers/AmbienceController.luau
--
-- Einzige Zustaendigkeit:
--   - Lebendige Himmels-Kulisse nur auf dem Client: treibende Wolkenpuffs,
--     ferne Schwebeinseln, schwebender Pollen um die Kamera und das leise
--     Atmen der Schaumsaeume um die Inseln
--
-- Warum auf dem Client: Kulisse ist fuer jeden Spieler gleich und hat keine
-- Spielwirkung. Gebaut auf dem Server wuerde sie repliziert und der Server
-- muesste sie bewegen; hier kostet sie das Netzwerk nichts und die Rechenzeit
-- bezahlt nur, wer sie sieht. Zahlen in AmbienceConfig.
--
-- PERFORMANCE:
--   * Alle Wolken sind EIN Model und werden pro Frame mit EINEM PivotTo
--     gedreht; die Schwebeinseln je EIN PivotTo. Keine Schleife ueber Parts.
--   * Alle Parts: Anchored, ohne Kollision, ohne Query, ohne Schatten. Die
--     Kamera-Zoom-Logik und Klick-Raycasts sehen sie nicht.
--   * Schwache Geraete (Grafikstufe < AmbienceConfig.HIGH_QUALITY_FROM) bekommen
--     weniger Wolken, weniger Inseln und keinen Pollen.
--   * Der Schaum wird nur 10 mal pro Sekunde aktualisiert.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local AmbienceConfig = require(ReplicatedStorage.Config.AmbienceConfig)
local MapConfig      = require(ReplicatedStorage.Config.MapConfig)

local AmbienceController = {}

local FOAM_TICK = 0.1

local _folder: Folder? = nil
local _cloudModel: Model? = nil
local _cloudBase: CFrame = CFrame.new()
local _islands: { { model: Model, base: CFrame, phase: number } } = {}
local _foamParts: { { part: Part, phase: number } } = {}
local _pollenPart: Part? = nil

--------------------------------------------------------------------------------
-- Qualitaet
--------------------------------------------------------------------------------

local function isHighQuality(): boolean
	local ok, level = pcall(function()
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel.Value
	end)
	if not ok then
		return true
	end
	-- 0 = Automatisch: zaehlt als hoch, Roblox regelt dort selbst nach.
	return level == 0 or level >= AmbienceConfig.HIGH_QUALITY_FROM
end

--------------------------------------------------------------------------------
-- Bausteine
--------------------------------------------------------------------------------

local function newPart(name: string, parent: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType): Part
	local part = Instance.new("Part")
	part.Name          = name
	part.Anchored      = true
	part.CanCollide    = false
	part.CanQuery      = false
	part.CanTouch      = false
	part.CastShadow    = false
	part.Size          = size
	part.CFrame        = cframe
	part.Color         = color
	part.Material      = material
	part.Shape         = shape
	part.TopSurface    = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent        = parent
	return part
end

--------------------------------------------------------------------------------
-- Wolkenpuffs
--------------------------------------------------------------------------------

-- Ein Puff = vier bis fuenf ueberlappende, plattgedrueckte Baelle.
local function buildCloudPuff(parent: Instance, position: Vector3, random: Random)
	local scale = random:NextNumber(0.8, 1.4)
	local lumps = random:NextInteger(4, 5)

	for i = 1, lumps do
		local w = random:NextNumber(60, 110) * scale
		local offset = Vector3.new(
			(i - (lumps + 1) / 2) * 45 * scale + random:NextNumber(-12, 12),
			random:NextNumber(-6, 10),
			random:NextNumber(-20, 20)
		)
		local part = newPart(
			"Puff", parent,
			Vector3.new(w, w * 0.38, w * 0.7),
			CFrame.new(position + offset),
			AmbienceConfig.CLOUD_COLOR,
			Enum.Material.SmoothPlastic,
			Enum.PartType.Ball
		)
		part.Transparency = 0.12
	end
end

local function buildClouds(parent: Instance, count: number, random: Random)
	local model = Instance.new("Model")
	model.Name = "Clouds"

	for i = 1, count do
		-- Gleichmaessig um den Kreis verteilt, mit Zufall in Abstand und Hoehe.
		local angle  = (i - 1) / count * math.pi * 2 + random:NextNumber(-0.15, 0.15)
		local radius = random:NextNumber(AmbienceConfig.CLOUD_RING_MIN, AmbienceConfig.CLOUD_RING_MAX)
		local height = random:NextNumber(AmbienceConfig.CLOUD_HEIGHT_MIN, AmbienceConfig.CLOUD_HEIGHT_MAX)

		buildCloudPuff(model, Vector3.new(
			MapConfig.CENTER.X + radius * math.cos(angle),
			height,
			MapConfig.CENTER.Z + radius * math.sin(angle)
		), random)
	end

	model.Parent = parent
	_cloudModel = model
	_cloudBase  = model:GetPivot()
end

--------------------------------------------------------------------------------
-- Ferne Schwebeinseln
--------------------------------------------------------------------------------

local function buildFarIsland(parent: Instance, angle: number, random: Random, index: number)
	local model = Instance.new("Model")
	model.Name = "FarIsland"

	local base = Vector3.new(
		MapConfig.CENTER.X + AmbienceConfig.FAR_ISLAND_RING * math.cos(angle),
		AmbienceConfig.FAR_ISLAND_HEIGHT + random:NextNumber(-20, 40),
		MapConfig.CENTER.Z + AmbienceConfig.FAR_ISLAND_RING * math.sin(angle)
	)
	local size = random:NextNumber(70, 110)

	-- Felsbrocken darunter (ein umgedrehter, plattgedrueckter Ball), Wiese oben drauf.
	newPart("Rock", model, Vector3.new(size, size * 0.7, size),
		CFrame.new(base + Vector3.new(0, -size * 0.28, 0)),
		Color3.fromRGB(140, 130, 150), Enum.Material.Slate, Enum.PartType.Ball)
	newPart("Grass", model, Vector3.new(4, size, size),
		CFrame.new(base) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(96, 190, 92), Enum.Material.Grass, Enum.PartType.Cylinder)

	-- Ein Baum und ein Leuchtkristall, damit die Silhouette nicht langweilig ist.
	newPart("Trunk", model, Vector3.new(14, 4, 4),
		CFrame.new(base + Vector3.new(size * 0.15, 9, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(122, 84, 52), Enum.Material.Wood, Enum.PartType.Cylinder)
	newPart("Crown", model, Vector3.new(26, 20, 26),
		CFrame.new(base + Vector3.new(size * 0.15, 22, 0)),
		(index % 2 == 0) and Color3.fromRGB(255, 160, 190) or Color3.fromRGB(72, 170, 80),
		Enum.Material.Grass, Enum.PartType.Ball)

	model.Parent = parent
	table.insert(_islands, { model = model, base = model:GetPivot(), phase = random:NextNumber(0, math.pi * 2) })
end

--------------------------------------------------------------------------------
-- Pollen
--------------------------------------------------------------------------------

local function buildPollen(parent: Instance)
	local anchor = Instance.new("Part")
	anchor.Name         = "PollenAnchor"
	anchor.Anchored     = true
	anchor.CanCollide   = false
	anchor.CanQuery     = false
	anchor.CanTouch     = false
	anchor.CastShadow   = false
	anchor.Transparency = 1
	anchor.Size         = Vector3.new(140, 50, 140)
	anchor.Parent       = parent

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color         = ColorSequence.new(AmbienceConfig.POLLEN_COLOR)
	emitter.Size          = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, 0.8),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency  = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime      = NumberRange.new(8, 12)
	emitter.Rate          = AmbienceConfig.POLLEN_RATE
	emitter.Speed         = NumberRange.new(0.5, 2)
	emitter.SpreadAngle   = Vector2.new(180, 180)
	emitter.Acceleration  = Vector3.new(0, 0.3, 0)
	emitter.LightEmission = 0.6
	emitter.LockedToPart  = false
	emitter.Shape         = Enum.ParticleEmitterShape.Box
	emitter.Parent        = anchor

	_pollenPart = anchor
end

--------------------------------------------------------------------------------
-- Schaum einsammeln
--------------------------------------------------------------------------------

local function collectFoam()
	local platform = workspace:WaitForChild("Platform", 30)
	if not platform then
		return
	end
	local scenery = platform:WaitForChild("Scenery", 30)
	local foam = scenery and scenery:WaitForChild("Foam", 30)
	if not foam then
		return
	end
	for _, child in foam:GetChildren() do
		if child:IsA("Part") then
			table.insert(_foamParts, { part = child, phase = (child:GetAttribute("FoamPhase") :: number?) or 0 })
		end
	end
end

--------------------------------------------------------------------------------
-- Einstieg
--------------------------------------------------------------------------------

function AmbienceController.init()
	local high   = isHighQuality()
	local random = Random.new(AmbienceConfig.SCENERY_SEED + 7)

	local folder = Instance.new("Folder")
	folder.Name   = "BaerchiAmbience"
	folder.Parent = workspace
	_folder = folder

	buildClouds(folder, high and AmbienceConfig.CLOUD_PUFFS_HIGH or AmbienceConfig.CLOUD_PUFFS_LOW, random)

	local islandCount = high and AmbienceConfig.FAR_ISLANDS_HIGH or AmbienceConfig.FAR_ISLANDS_LOW
	for i = 1, islandCount do
		-- Gleichmaessig verteilt, damit man von jeder Insel eine am Horizont sieht.
		buildFarIsland(folder, (i - 0.5) / islandCount * math.pi * 2, random, i)
	end

	if high then
		buildPollen(folder)
	end

	task.spawn(collectFoam)

	local clock = 0
	local foamClock = 0
	local cloudAngle = 0

	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt

		-- Wolken: ein Pivot fuer alle.
		local clouds = _cloudModel
		if clouds then
			cloudAngle += dt * AmbienceConfig.CLOUD_DRIFT_SPEED
			-- Drehung um die Weltmitte, relativ zur Ausgangslage (das Model-Pivot liegt
			-- in der Mitte seiner Teile, nicht in der Weltmitte).
			clouds:PivotTo(CFrame.new(MapConfig.CENTER) * CFrame.Angles(0, cloudAngle, 0) * CFrame.new(-MapConfig.CENTER) * _cloudBase)
		end

		-- Schwebeinseln: sanftes Auf und Ab, ein Pivot je Insel.
		for _, island in _islands do
			island.model:PivotTo(island.base * CFrame.new(0, math.sin(clock * 0.35 + island.phase) * 5, 0))
		end

		-- Pollen folgt der Kamera.
		local anchor = _pollenPart
		local camera = workspace.CurrentCamera
		if anchor and camera then
			anchor.Position = camera.CFrame.Position + Vector3.new(0, 4, 0)
		end

		-- Schaum atmet, 10 mal pro Sekunde.
		foamClock += dt
		if foamClock >= FOAM_TICK then
			foamClock = 0
			local twoPi = math.pi * 2
			for _, foam in _foamParts do
				foam.part.Transparency = AmbienceConfig.FOAM_TRANSPARENCY
					+ math.sin(clock / AmbienceConfig.FOAM_PULSE_PERIOD * twoPi + foam.phase) * AmbienceConfig.FOAM_PULSE
			end
		end
	end)

	print("[Ambience] Kulisse aktiv |", high and "hoch" or "niedrig")
end

return AmbienceController
]]></ProtectedString>
						<string name="ScriptGuid">{1D313535-3257-40DB-A242-5E674D9B1B06}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">AmbienceController</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">08eaaf7cd91c3e760ad3af9b00002e81</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXB9B7B56386F94D99B5776515A8019EDB">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- EventFXController.luau
-- StarterPlayerScripts/Controllers/EventFXController.luau
--
-- Einzige Zustaendigkeit:
--   - Die bewegte Optik der lebendigen Events zeichnen: UFO-Patrouille,
--     fallende Abwurf-Kisten, Wespenkoenigin (samt HP-Leiste), Telegraphen der
--     Boss-Attacken, Himmel beim Boss — und Treffer am eigenen Charakter
--     ausfuehren und Event-Meldungen anzeigen.
--
-- Der Client rechnet und entscheidet nichts: Bahnen kommen aus
-- Modules/EventMotion (reine Funktionen der Serverzeit) und den Attributen,
-- die der Server einmal setzt (StartTime, Center, LandAt, Phase2At, HP).
-- Ob jemand getroffen ist, hat der Server entschieden (Remotes.EventHazardHit);
-- hier wird nur die Physik am EIGENEN Charakter ausgefuehrt, den der Client
-- besitzt.
--
-- PERFORMANCE: EIN RenderStepped fuer alles, ein PivotTo pro bewegtem Model
-- und Frame. Telegraphen sind wenige lokale Teile, die nach dem Treffer
-- verschwinden. Keine Lichter, keine Emitter.

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local Lighting          = game:GetService("Lighting")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types       = require(ReplicatedStorage.Network.Types)
local Remotes     = require(ReplicatedStorage.Network.Remotes)
local EventMotion = require(ReplicatedStorage.Modules.EventMotion)
local Loc         = require(ReplicatedStorage.Localization.Loc)

local Theme = require(script.Parent.Parent.UI.Theme)
local Toast = require(script.Parent.Parent.UI.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify   = require(script.Parent.Parent.UI.Notify)
local Feedback = require(script.Parent.Parent.UI.Feedback)
local Moment   = require(script.Parent.Parent.UI.Moment)

local EventFXController = {}

local localPlayer = Players.LocalPlayer

--------------------------------------------------------------------------------
-- Optik (keine Balance)
--------------------------------------------------------------------------------

local UFO_FOLDER   = "EventUfo"
local QUEEN_FOLDER = "EventWaspQueen"

local QUEEN_DESCENT_HEIGHT = 60          -- waehrend der Ankuendigung von so hoch herab
local QUEEN_SPIN_WINGS     = 18          -- Fluegelschlag (Grad)

local TELEGRAPH_COLOR      = Color3.fromRGB(255, 70, 50)
local TELEGRAPH_SAFE_COLOR = Color3.fromRGB(90, 230, 120)
local TELEGRAPH_FLASH      = 0.25        -- so lange blitzt die Flaeche beim Treffer
local TELEGRAPH_THICKNESS  = 0.3
local TELEGRAPH_LIFT       = 0.35

local HP_BAR_SIZE    = UDim2.fromOffset(260, 46)
local HP_BAR_OFFSET  = Vector3.new(0, 14, 0)
local HP_BAR_COLOR   = Color3.fromRGB(255, 190, 40)
local HP_BAR_BACK    = Color3.fromRGB(30, 26, 22)

local SKY_TINT       = Color3.fromRGB(255, 205, 170)
local SKY_BRIGHTNESS = -0.12
local SKY_SATURATION = -0.15
local SKY_TWEEN      = 3

local HIT_UPWARD     = 22               -- kleiner Hopser beim Rueckstoss

--------------------------------------------------------------------------------
-- Zustand
--------------------------------------------------------------------------------

type Crate = { model: Model, release: number, land: number, parts: { { part: BasePart, base: CFrame } }, canopy: BasePart?, landed: boolean }

local _ufo: { folder: Instance, model: Model?, start: number, center: Vector3 }? = nil
local _crates: { [Model]: Crate } = {}
local _queen: { folder: Instance, model: Model?, start: number, center: Vector3 }? = nil
local _telegraphs: { { parts: { BasePart }, hitAt: number, until_: number } } = {}
local _fxFolder: Folder? = nil

local function fxFolder(): Folder
	local folder = _fxFolder
	if folder and folder.Parent then
		return folder
	end
	local created = Instance.new("Folder")
	created.Name = "EventFX_Local"
	created.Parent = Workspace
	_fxFolder = created
	return created
end

local function localPart(props: { [string]: any }): BasePart
	local part: any = Instance.new("Part")
	part.Anchored   = true
	part.CanCollide = false
	part.CanQuery   = false
	part.CanTouch   = false
	part.CastShadow = false
	for key, value in props do
		part[key] = value
	end
	part.Parent = fxFolder()
	return part
end

--------------------------------------------------------------------------------
-- UFO und Kisten
--------------------------------------------------------------------------------

local function trackCrate(child: Instance)
	if not child:IsA("Model") or child.Name ~= "UfoDrop" then return end
	local release = child:GetAttribute("ReleaseAt")
	local land    = child:GetAttribute("LandAt")
	if typeof(release) ~= "number" or typeof(land) ~= "number" then return end

	-- Nur Kiste und Schirm fallen; Landekreis und Lichtsaeule stehen am Boden.
	local parts = {}
	for _, name in { "Crate", "Canopy" } do
		local part = child:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			table.insert(parts, { part = part, base = part.CFrame })
		end
	end
	local canopy = child:FindFirstChild("Canopy")
	_crates[child] = {
		model = child, release = release, land = land, parts = parts,
		canopy = if canopy and canopy:IsA("BasePart") then canopy else nil,
		landed = false,
	}
end

local function hookUfoFolder(folder: Instance)
	local start  = folder:GetAttribute("StartTime")
	local center = folder:GetAttribute("Center")
	if typeof(start) ~= "number" or typeof(center) ~= "Vector3" then
		-- Attribute kommen mit dem Ordner; ein Frame spaeter nochmal.
		task.defer(function()
			if folder.Parent and not _ufo then hookUfoFolder(folder) end
		end)
		return
	end
	local model = folder:FindFirstChild("Ufo")
	_ufo = { folder = folder, model = if model and model:IsA("Model") then model else nil, start = start, center = center }

	for _, child in folder:GetChildren() do
		trackCrate(child)
	end
	folder.ChildAdded:Connect(function(child)
		if child.Name == "Ufo" and child:IsA("Model") and _ufo and _ufo.folder == folder then
			_ufo.model = child
		end
		-- Kinder eines Models kommen evtl. nach dem Model an.
		task.defer(trackCrate, child)
	end)
	folder.ChildRemoved:Connect(function(child)
		if child:IsA("Model") then _crates[child] = nil end
	end)
end

local function animateUfo(now: number)
	local ufo = _ufo
	if not ufo then return end
	if not ufo.folder.Parent then
		_ufo = nil
		table.clear(_crates)
		return
	end
	local model = ufo.model
	if model and model.Parent then
		model:PivotTo(CFrame.new(EventMotion.ufoGround(ufo.center, ufo.start, now)))
	end

	for crateModel, crate in _crates do
		if not crateModel.Parent then
			_crates[crateModel] = nil
			continue
		end
		if crate.landed then continue end
		local height = if now < crate.release then EventMotion.DROP_FALL_HEIGHT else EventMotion.dropHeight(crate.release, crate.land, now)
		-- Vor dem Abwurf noch unsichtbar (unter dem UFO): ganz oben halten.
		for _, entry in crate.parts do
			entry.part.CFrame = entry.base + Vector3.new(0, height, 0)
		end
		if now >= crate.land then
			crate.landed = true
			local canopy = crate.canopy
			if canopy then canopy.Transparency = 1 end
		end
	end
end

--------------------------------------------------------------------------------
-- Wespenkoenigin
--------------------------------------------------------------------------------

local _hpFill: Frame? = nil
local _hpText: TextLabel? = nil

local function refreshHp(model: Model)
	local fill, text = _hpFill, _hpText
	if not fill or not text then return end
	local hp = model:GetAttribute("HP")
	local maxHp = model:GetAttribute("MaxHP")
	if typeof(hp) ~= "number" or typeof(maxHp) ~= "number" or maxHp <= 0 then
		fill.Size = UDim2.fromScale(1, 1)
		text.Text = Loc.t("ui.boss.name")
		return
	end
	fill.Size = UDim2.fromScale(math.clamp(hp / maxHp, 0, 1), 1)
	text.Text = Loc.t("ui.boss.hp", { hp = Loc.formatNumber(hp), max = Loc.formatNumber(maxHp) })
end

local function buildHpBar(model: Model)
	local head = model:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then return end

	local gui = Instance.new("BillboardGui")
	gui.Name        = "BossHp"
	gui.Size        = HP_BAR_SIZE
	gui.StudsOffset = HP_BAR_OFFSET
	gui.AlwaysOnTop = true
	gui.Adornee     = head
	gui.Parent      = model

	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.new(1, 0, 0, 18)
	back.Position = UDim2.new(0, 0, 1, -18)
	back.BackgroundColor3 = HP_BAR_BACK
	back.BorderSizePixel = 0
	back.Parent = gui
	Theme.corner(back, 6)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = HP_BAR_COLOR
	fill.BorderSizePixel = 0
	fill.Parent = back
	Theme.corner(fill, 6)

	local text = Theme.label("Name", gui, "")
	text.Size = UDim2.new(1, 0, 0, 24)
	text.TextXAlignment = Enum.TextXAlignment.Center
	text.TextColor3 = Theme.COLORS.goldGummy

	_hpFill, _hpText = fill, text
	refreshHp(model)
	model:GetAttributeChangedSignal("HP"):Connect(function() refreshHp(model) end)
	model:GetAttributeChangedSignal("MaxHP"):Connect(function() refreshHp(model) end)
end

local function hookQueenFolder(folder: Instance)
	local start  = folder:GetAttribute("StartTime")
	local center = folder:GetAttribute("Center")
	if typeof(start) ~= "number" or typeof(center) ~= "Vector3" then
		task.defer(function()
			if folder.Parent and not _queen then hookQueenFolder(folder) end
		end)
		return
	end
	_queen = { folder = folder, model = nil, start = start, center = center }

	local function adopt(child: Instance)
		if child.Name == "WaspQueen" and child:IsA("Model") and _queen and _queen.folder == folder then
			_queen.model = child
			task.defer(buildHpBar, child)
		end
	end
	for _, child in folder:GetChildren() do adopt(child) end
	folder.ChildAdded:Connect(adopt)
end

local function animateQueen(now: number)
	local queen = _queen
	if not queen then return end
	if not queen.folder.Parent then
		_queen = nil
		_hpFill, _hpText = nil, nil
		return
	end
	local model = queen.model
	if not model or not model.Parent then return end

	local phase2 = model:GetAttribute("Phase2At")
	local phase2At = if typeof(phase2) == "number" then phase2 else nil
	local pose: CFrame
	if now < queen.start then
		-- Ankuendigung: sinkt von oben herab auf ihre Bahn.
		local remaining = queen.start - now
		pose = EventMotion.queenPose(queen.center, queen.start, queen.start, nil)
			+ Vector3.new(0, QUEEN_DESCENT_HEIGHT * math.clamp(remaining / 20, 0, 1), 0)
	else
		pose = EventMotion.queenPose(queen.center, queen.start, now, phase2At)
	end
	model:PivotTo(pose)

	-- Fluegelschlag (lokal, rein optisch)
	local flap = math.rad(math.sin(now * 30) * QUEEN_SPIN_WINGS)
	for _, name in { "WingL", "WingR" } do
		local wing = model:FindFirstChild(name)
		if wing and wing:IsA("BasePart") then
			local sign = if name == "WingL" then 1 else -1
			wing.Transparency = 0.35 + 0.15 * math.abs(math.sin(now * 30))
			wing.CFrame = pose * CFrame.new(-5 * 1.6 * sign, 3 * 1.6, 1.6) * CFrame.Angles(0, 0, math.rad(20) * sign + flap * sign)
		end
	end
end

--------------------------------------------------------------------------------
-- Telegraphen
--------------------------------------------------------------------------------

local function disc(position: Vector3, radius: number, color: Color3, lift: number): BasePart
	return localPart({
		Name = "Telegraph", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon,
		Color = color, Transparency = 0.55,
		Size = Vector3.new(TELEGRAPH_THICKNESS, radius * 2, radius * 2),
		CFrame = CFrame.new(position + Vector3.new(0, lift, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	})
end

local function showTelegraph(t: Types.HazardTelegraph)
	local parts: { BasePart } = {}
	if t.kind == "ring" and t.center then
		table.insert(parts, disc(t.center, t.outer or 0, TELEGRAPH_COLOR, TELEGRAPH_LIFT))
		-- Innen ist sicher: gruene Scheibe knapp darueber.
		table.insert(parts, disc(t.center, t.inner or 0, TELEGRAPH_SAFE_COLOR, TELEGRAPH_LIFT + 0.05))
	elseif t.kind == "circles" and t.points then
		for _, point in t.points do
			table.insert(parts, disc(point, t.radius or 0, TELEGRAPH_COLOR, TELEGRAPH_LIFT))
		end
	elseif t.kind == "lane" and t.from and t.to then
		local from, to = t.from, t.to
		local mid = (from + to) / 2
		local length = (Vector3.new(to.X - from.X, 0, to.Z - from.Z)).Magnitude
		table.insert(parts, localPart({
			Name = "Telegraph", Material = Enum.Material.Neon, Color = TELEGRAPH_COLOR, Transparency = 0.55,
			Size = Vector3.new(t.width or 0, TELEGRAPH_THICKNESS, length),
			CFrame = CFrame.lookAt(mid + Vector3.new(0, TELEGRAPH_LIFT, 0), Vector3.new(to.X, mid.Y + TELEGRAPH_LIFT, to.Z)),
		}))
	end
	table.insert(_telegraphs, { parts = parts, hitAt = t.hitAt, until_ = t.hitAt + TELEGRAPH_FLASH })
end

local function animateTelegraphs(now: number)
	for i = #_telegraphs, 1, -1 do
		local t = _telegraphs[i]
		if now >= t.until_ then
			for _, part in t.parts do part:Destroy() end
			table.remove(_telegraphs, i)
		elseif now >= t.hitAt then
			for _, part in t.parts do part.Transparency = 0.05 end
		else
			-- pulsiert schneller, je naeher der Treffer
			local left = t.hitAt - now
			local pulse = 0.45 + 0.2 * math.sin(now * (8 + 12 / math.max(0.2, left)))
			for _, part in t.parts do
				if part.Color ~= TELEGRAPH_SAFE_COLOR then
					part.Transparency = pulse
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Treffer am eigenen Charakter
--------------------------------------------------------------------------------

local _slowToken = 0

local function onHit(info: any)
	if typeof(info) ~= "table" or typeof(info.push) ~= "Vector3" then return end
	local character = localPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not root or not root:IsA("BasePart") or not humanoid then return end

	root.AssemblyLinearVelocity = info.push + Vector3.new(0, HIT_UPWARD, 0)

	local factor  = if typeof(info.slowFactor) == "number" then info.slowFactor else 1
	local seconds = if typeof(info.slowSeconds) == "number" then info.slowSeconds else 0
	if factor < 1 and seconds > 0 then
		_slowToken += 1
		local token = _slowToken
		local before = humanoid.WalkSpeed
		local slowed = before * factor
		humanoid.WalkSpeed = slowed
		task.delay(seconds, function()
			-- Nur zuruecksetzen, wenn niemand sonst (CombService) inzwischen
			-- einen anderen Wert gesetzt hat.
			if token == _slowToken and humanoid.Parent and humanoid.WalkSpeed == slowed then
				humanoid.WalkSpeed = before
			end
		end)
	end
	Notify.emit("boss_hit", function()
		-- Sammel-Update 5.2: Stoss eines gegnerischen Baerchis im Pit
		Toast.show(Loc.t(if info.source == "brawl" then "ui.brawl.hit" else "ui.boss.hit"), Theme.COLORS.bad)
	end)
end

--------------------------------------------------------------------------------
-- Himmel beim Boss
--------------------------------------------------------------------------------

local _sky: ColorCorrectionEffect? = nil

local function setBossSky(active: boolean)
	local sky = _sky
	if not sky then
		local created = Instance.new("ColorCorrectionEffect")
		created.Name = "BossSky_Local"
		created.Parent = Lighting
		sky = created
		_sky = created
	end
	local effect = sky :: ColorCorrectionEffect
	TweenService:Create(effect, TweenInfo.new(SKY_TWEEN), {
		TintColor  = if active then SKY_TINT else Color3.new(1, 1, 1),
		Brightness = if active then SKY_BRIGHTNESS else 0,
		Saturation = if active then SKY_SATURATION else 0,
	}):Play()
end

--------------------------------------------------------------------------------
-- Belohnungs-Momente (Icon-Weg von "event_notice_good")
--------------------------------------------------------------------------------

-- HBB Paket 7: Truhenfarbe je Boss-Stufe 1..4 (Bronze, Silber, Gold, Lila)
local BOSS_TIER_COLORS = {
	Color3.fromRGB(205, 127, 50), Color3.fromRGB(200, 210, 225),
	Color3.fromRGB(255, 200, 40), Color3.fromRGB(190, 110, 255),
}

-- Zeigt zu einer bekannten Belohnungsnotiz das passende Bild ohne Text.
-- Rueckgabe false = Notiz unbekannt, der Aufrufer faellt auf den Toast zurueck.
local function playRewardMoment(key: any, args: any): boolean
	if key == "msg.boss.tier" then
		-- Truhe in der Stufenfarbe; die Inhalte fliegen danach ueber den
		-- Datenstand in die Pillen.
		local tier = if typeof(args) == "table" and typeof(args.tier) == "number" then args.tier else 1
		Moment.show("chest", BOSS_TIER_COLORS[math.clamp(tier, 1, 4)], nil)
	elseif key == "msg.event.rarity_up" then
		local to = if typeof(args) == "table" and Loc.isMsg(args.to) then args.to.k else nil
		local rarity = if typeof(to) == "string" then string.gsub(to, "^rarity%.", "") else nil
		Moment.show("rarity", if rarity then Theme.rarityColor(rarity :: any) else Theme.COLORS.goldGummy, "ui.moment.rarity")
	elseif key == "msg.event.combs" then
		local n = if typeof(args) == "table" and typeof(args.n) == "number" then args.n else 1
		Feedback.gain("comb", n)
	elseif key == "msg.event.gummies" or key == "msg.ufo.drop_picked" then
		-- schon ueber den Datenstand sichtbar
	else
		return false
	end
	return true
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function EventFXController.init()
	local function onWorkspaceChild(child: Instance)
		if child.Name == UFO_FOLDER then
			hookUfoFolder(child)
		elseif child.Name == QUEEN_FOLDER then
			hookQueenFolder(child)
		end
	end
	for _, child in Workspace:GetChildren() do
		onWorkspaceChild(child)
	end
	Workspace.ChildAdded:Connect(onWorkspaceChild)

	Remotes.EventTelegraph.OnClientEvent:Connect(function(t: any)
		if typeof(t) ~= "table" or typeof(t.hitAt) ~= "number" then return end
		showTelegraph(t :: Types.HazardTelegraph)
	end)

	Remotes.EventHazardHit.OnClientEvent:Connect(onHit)

	Remotes.EventNotice.OnClientEvent:Connect(function(msg: any, style: any)
		if not Loc.isMsg(msg) and typeof(msg) ~= "string" then return end
		if style == "big" then
			Notify.emit("event_notice_big", function()
				Toast.show(msg, Theme.COLORS.goldGummy)
			end)
		elseif style == "good" then
			Notify.emit("event_notice_good", function()
				Toast.success(msg)
			end, function()
				-- Gummies und Eier fliegen schon ueber den Datenstand
				-- (UI/Feedback). Hier nur, was dort nicht sichtbar wird.
				if not (Loc.isMsg(msg) and playRewardMoment((msg :: any).k, (msg :: any).a)) then
					-- Unbekannte Belohnungsnotiz: lieber lesen als verlieren
					Toast.success(msg)
				end
			end)
		else
			Notify.emit("event_notice_info", function()
				Toast.info(msg)
			end)
		end
	end)

	Remotes.EventPhaseChanged.OnClientEvent:Connect(function(eventId: any)
		setBossSky(eventId == "WaspQueen")
	end)

	RunService.RenderStepped:Connect(function()
		local now = Workspace:GetServerTimeNow()
		animateUfo(now)
		animateQueen(now)
		animateTelegraphs(now)
	end)

	print("[EventFXController] Initialisiert")
end

return EventFXController
]]></ProtectedString>
