			<Item class="ModuleScript" referent="RBX86975DA159EC44109BC80E7A80E5096A">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- PromotionConfig.luau
-- ReplicatedStorage/Config/PromotionConfig.luau
--
-- Alle Zahlen der ZWEITEN Fortschrittsachse an einer Stelle:
--   1. Promotion  — einen Baerchi mit Duplikaten befoerdern (10 Stufen)
--   2. Stat-Level — jeder einzelne Basiswert waechst durch Event-Teilnahme,
--                   begrenzt durch eine von der Rarity abhaengige Obergrenze
--
-- Kein Service rechnet diese Zahlen selbst aus (Konvention des Projekts:
-- Konfig-Werte nie hartkodiert in Services). PromotionService, CharmService,
-- EventParticipationService, CombatCalculator und das UI lesen alle hier.
--
-- ============================================================
-- WARUM ZWEI FORTSCHRITTSACHSEN
-- ============================================================
-- baerchi.level (Honig/XP, siehe HoneyService) bleibt der Weg, wie ein Baerchi
-- von Level 1 bis MAX_LEVEL waechst. Promotion und Stat-Level sind davon
-- vollkommen unabhaengig: sie kosten keine XP, sondern Duplikate (Promotion)
-- bzw. Event-Teilnahme (Stat-Level). Ein Baerchi kann also auf Level 50 stehen
-- und trotzdem Promotion 0 / Stat-Level 0 haben — und umgekehrt.
--
-- ============================================================
-- DIE FUENF STATS: HP / ATK / SPD / PWR / EGG
-- ============================================================
-- SPD ist die Angriffsgeschwindigkeit, PWR die Ability-Staerke (sie skaliert
-- den Schaden von Skills, Formel siehe SkillConfig, gerechnet in
-- CombatCalculator), EGG das Lege-Tempo. Eine Verteidigung gibt es NICHT — wer
-- einen Tank will, baut einen Baerchi mit viel HP. Genau diese fuenf sind auch
-- die Stats, die durch Event-Teilnahme wachsen.
--
-- ============================================================
-- EGG IST SEIT v10 EIN ECHTER STAT
-- ============================================================
-- Lange war EGG ein Balken ohne Wirkung — das Ei-Legen gab es noch nicht.
-- Jetzt gibt es das (EggLayService), und EGG steuert, wie schnell der
-- ausgeruestete Baerchi Eier legt.
--
-- Damit ist EGG der FUENFTE wachsende Stat: eine Event-Teilnahme kann ihn
-- genauso erhoehen wie HP, ATK, SPD oder PWR. Was eine Stufe konkret bringt,
-- steht NICHT hier, sondern bei EggConfig.LAY_STAT_LEVEL_GAIN — dort, wo auch
-- der Rest des Ei-Systems steht (siehe Kommentar dort).

local Types = require(script.Parent.Parent.Network.Types)

--------------------------------------------------------------------------------
-- 1. Promotion
--------------------------------------------------------------------------------

-- Zehn Stufen, dargestellt als FUENF Sterne: Stufe 1-5 fuellt die Sterne einer
-- nach dem anderen (leer → Silber), Stufe 6-10 faerbt dieselben fuenf Sterne
-- ein zweites Mal um (Silber → Gold). Bei Promotion 10 sind alle fuenf golden.
-- Die Umrechnung macht getStarState weiter unten — kein UI-Modul rechnet das
-- selbst nach.
local MAX_PROMOTION = 10
local STAR_COUNT    = 5

-- Was eine Promotion an Basiswerten bringt (zusaetzlich zu den frei
-- geschalteten Charm-Slots). Vom Projektinhaber bestaetigt: +2% HP und ATK je
-- Stufe, bei Promotion 10 also +20%. Bewusst nur HP/ATK — dieselbe Regel wie
-- beim Fusions-Bonus (siehe CombatCalculator): SPD und PWR bekommen ihren
-- Zuwachs ueber die Stat-Stufen (flach), nicht ueber prozentuale Boni, weil
-- PWR ohnehin schon den ATK-abhaengigen Skill-Schaden multipliziert.
local PROMOTION_STAT_BONUS_PER_LEVEL = 0.02

-- Wie viele Duplikate desselben configId eine einzelne Promotions-Stufe
-- kostet. Je SELTENER die Rarity, desto WENIGER Duplikate — spiegelbildlich
-- dazu, wie viel schwerer ein seltener Baerchi ueberhaupt zu bekommen ist.
--
-- Die beiden Zahlen sind die Endpunkte: `first` gilt fuer den Schritt 0 → 1,
-- `last` fuer den Schritt 9 → 10. Dazwischen wird linear interpoliert und
-- aufgerundet (siehe getDuplicateCost) — hoehere Stufen kosten also spuerbar
-- mehr als die erste, ohne dass hier zehn Zahlen pro Rarity stehen muessen.
--
-- VORLAEUFIGE ANNAHME: der Projektinhaber hat keine exakten Zahlen vorgegeben,
-- nur die Richtung ("je nach Raritaet oefter oder weniger oft").
local DUPLICATE_COST: { [Types.Rarity]: { first: number, last: number } } = {
	Common    = { first = 3, last = 8 },
	Uncommon  = { first = 2, last = 6 },
	Rare      = { first = 2, last = 5 },
	Epic      = { first = 1, last = 4 },
	Legendary = { first = 1, last = 3 },
	Mythic    = { first = 1, last = 2 },
	Divine    = { first = 1, last = 2 },
	Cosmic    = { first = 1, last = 2 },
	Secret    = { first = 1, last = 1 },
	Godly     = { first = 1, last = 1 },
	Eternal   = { first = 1, last = 1 },
	Omega     = { first = 1, last = 1 },
}

--------------------------------------------------------------------------------
-- 2. Stat-Level und ihre Rarity-Obergrenze
--------------------------------------------------------------------------------

-- Die Obergrenze JEDES EINZELNEN Stats, abhaengig von der Rarity.
-- Common bis Legendary sind Vorgabe des Projektinhabers; Mythic = 28 setzt das
-- +4-Muster fort und ist vom Projektinhaber bestaetigt.
local STAT_CAP: { [Types.Rarity]: number } = {
	Common    =  8,
	Uncommon  = 12,
	Rare      = 16,
	Epic      = 20,
	Legendary = 24,
	Mythic    = 28,
	Divine    = 32,
	Cosmic    = 36,
	Secret    = 40,
	Godly     = 46,
	Eternal   = 52,
	Omega     = 60,
}

-- Die Stats, die durch Event-Teilnahme wachsen koennen — die Zufallsauswahl
-- beim Event-Abschluss zieht genau aus dieser Liste. Seit v10 sind es fuenf:
-- `egg` ist dazugekommen, weil das Ei-Legen jetzt existiert.
local GROWABLE_STATS: { string } = { "hp", "atk", "spd", "pwr", "egg" }

-- Alle Stats, die es als Feld/Balken gibt. Seit v10 identisch mit
-- GROWABLE_STATS — die Trennung bleibt trotzdem bestehen, weil ein kuenftiger
-- Stat wieder nur anzeigbar sein koennte. Reihenfolge = Anzeigereihenfolge auf
-- der Baerchi-Karte.
local ALL_STATS: { string } = { "hp", "atk", "spd", "pwr", "egg" }

-- Was EINE Stufe eines Stat-Levels bringt.
--
-- HP und ATK prozentual (dieselbe Logik wie Level/Fusion/Promotion), SPD und
-- PWR flach — genau aus dem Grund, der in BaerchiConfig bei SPD_PER_LEVEL /
-- PWR_PER_LEVEL steht: PWR multipliziert bereits den Skill-Schaden, der
-- seinerseits am exponentiell wachsenden ATK haengt.
--
-- Zur Groessenordnung: ein Legendary am Stat-Cap (24) haette damit +96% HP,
-- +96% ATK, +0.48 SPD und +0.24 PWR — spuerbar, aber kein Ersatz fuer das
-- Level (das auf Stufe 50 das 106-fache bringt). Die +0.24 PWR sind dabei der
-- groesste einzelne PWR-Zuwachs im Spiel: mehr als jeder Baerchi von Haus aus
-- mitbringt. Stat-Stufen sind damit fuer einen Ability-Baerchi das Lohnendste,
-- was Event-Teilnahme bringen kann — genau so gewollt.
local STAT_LEVEL_GAIN = {
	hp  = 0.04,    -- +4% Basis-HP je Stufe
	atk = 0.04,    -- +4% Basis-ATK je Stufe
	spd = 0.02,    -- flach
	pwr = 0.01,    -- flach: +1 Prozentpunkt Ability-Schaden je Stufe
}

-- Anzeigenamen der Stat-Zeilen (UI liest nur hier, damit Server und Client
-- dieselbe Beschriftung benutzen).
local STAT_LABELS: { [string]: string } = {
	hp  = "HP",
	atk = "ATK",
	spd = "SPD",
	pwr = "PWR",
	egg = "EGG",
}

--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

local function getStatCap(rarity: Types.Rarity): number
	return STAT_CAP[rarity] or STAT_CAP.Common
end

-- Frische, vollstaendig genullte Stat-Level-Tabelle. Einzige erlaubte Quelle —
-- BaerchiFactory und die Migration (Util/PlayerMigration) rufen beide dies auf,
-- damit ein neues Feld nur an EINER Stelle nachgetragen werden muss.
local function newStatLevels(): Types.StatLevels
	return { hp = 0, atk = 0, spd = 0, pwr = 0, egg = 0 }
end

-- Wie viele Duplikate der Schritt auf `targetPromotion` kostet
-- (targetPromotion = 1 heisst der Schritt 0 → 1).
-- Gibt 0 zurueck, wenn die Stufe ausserhalb 1..MAX_PROMOTION liegt — der
-- Aufrufer behandelt das als "geht nicht mehr", nicht als "kostenlos".
local function getDuplicateCost(rarity: Types.Rarity, targetPromotion: number): number
	if targetPromotion < 1 or targetPromotion > MAX_PROMOTION then
		return 0
	end

	local curve = DUPLICATE_COST[rarity] or DUPLICATE_COST.Common

	-- t laeuft von 0 (erste Stufe) bis 1 (letzte Stufe).
	local t = (targetPromotion - 1) / (MAX_PROMOTION - 1)
	return math.max(1, math.ceil(curve.first + (curve.last - curve.first) * t))
end

-- Der Stat-Bonus, den `promotionLevel` Stufen auf HP/ATK geben (0.0 = keiner).
local function getPromotionBonus(promotionLevel: number): number
	return math.clamp(promotionLevel or 0, 0, MAX_PROMOTION) * PROMOTION_STAT_BONUS_PER_LEVEL
end

export type StarState = "empty" | "silver" | "gold"

-- Zustand der fuenf Sterne fuer einen Promotion-Stand. Die Umrechnung
-- 10 Stufen → 5 Sterne steht damit an genau einer Stelle.
local function getStarStates(promotionLevel: number): { StarState }
	local level  = math.clamp(promotionLevel or 0, 0, MAX_PROMOTION)
	local states: { StarState } = {}

	for star = 1, STAR_COUNT do
		if level >= STAR_COUNT + star then
			states[star] = "gold"     -- Stufe 6-10: zweite Faerbung
		elseif level >= star then
			states[star] = "silver"   -- Stufe 1-5: erste Fuellung
		else
			states[star] = "empty"
		end
	end

	return states
end

-- Farben der beiden Sterne-Stufen. Stehen hier statt im Client-Theme, weil sie
-- direkt zur Promotion-Mechanik gehoeren und (wie RARITY_COLORS in
-- BaerchiConfig) potenziell auch serverseitig gebraucht werden.
local STAR_COLORS = {
	empty  = Color3.fromRGB( 84,  80, 104),
	silver = Color3.fromRGB(214, 222, 236),
	gold   = Color3.fromRGB(255, 196,  60),
}

return {
	MAX_PROMOTION = MAX_PROMOTION,
	STAR_COUNT    = STAR_COUNT,
	STAR_COLORS   = STAR_COLORS,

	PROMOTION_STAT_BONUS_PER_LEVEL = PROMOTION_STAT_BONUS_PER_LEVEL,
	DUPLICATE_COST = DUPLICATE_COST,

	STAT_CAP        = STAT_CAP,
	GROWABLE_STATS  = GROWABLE_STATS,
	ALL_STATS       = ALL_STATS,
	STAT_LEVEL_GAIN = STAT_LEVEL_GAIN,
	STAT_LABELS     = STAT_LABELS,

	getStatCap        = getStatCap,
	newStatLevels     = newStatLevels,
	getDuplicateCost  = getDuplicateCost,
	getPromotionBonus = getPromotionBonus,
	getStarStates     = getStarStates,
}
]]></ProtectedString>
					<string name="ScriptGuid">{86564522-A46B-457C-ADA2-CC8A58C7D041}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">PromotionConfig</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">66513cb557ff88f30ab182cd00004b2b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX033CF6A83DEF49A8BB2DD04AA315A2D1">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- CharmConfig.luau
-- ReplicatedStorage/Config/CharmConfig.luau
--
-- Alle Zahlen der Battle-Charms an einer Stelle:
--   - acht Slots und ab welcher Promotions-Stufe jeder freigeschaltet wird
--   - die Rarity-Odds eines Wurfs
--   - der Pool moeglicher Stat-Typen und ihre Wertebereiche je Rarity
--   - was ein Wurf kostet
--
-- ============================================================
-- EIN SLOT IST NICHT AN EINEN STAT-TYP GEBUNDEN
-- ============================================================
-- Wichtigste Regel, vom Projektinhaber ausdruecklich klargestellt: die acht
-- Slots haben KEINEN festen Stat-Typ. Jeder Wurf zieht zweimal unabhaengig —
-- erst eine Rarity (RARITY_ODDS), dann einen Stat-Typ (STAT_POOL) — und zwar
-- fuer jeden Slot gleich, egal welcher Slot-Index es ist.
--
-- Die "Promotion Tiers"-Tabelle aus der Vorlage ist deshalb hier NUR eine
-- Freischalt-Liste (SLOT_UNLOCK_PROMOTION): sie sagt, ab wann ein Slot
-- ueberhaupt benutzbar ist — nicht, was darin sitzt.
--
-- ============================================================
-- KEINE NEUE WAEHRUNG
-- ============================================================
-- Die Vorlage kennt eine eigene Ressource ("Charm Dust"). In Baerchi Fighter
-- gibt es die bewusst NICHT — der Projektinhaber will das Ressourcen-System
-- einfach halten. Ein Wurf kostet direkt GoldGummies, die bereits bestehende
-- zweite Waehrung (seit GOLD_CHARMS_ONLY nur noch aus den Tages-Quests).
--
-- ============================================================
-- WARUM NUR VIER STAT-TYPEN
-- ============================================================
-- Die Vorlage zeigt Boni wie "Crit DMG" oder "Movement Speed" — beides gibt es
-- in Baerchi Fighter gar nicht (keine Krits, die Figuren laufen mit
-- MapConfig.WALK_SPEED). Ein Charm, der auf nichts wirkt, waere ein stiller
-- Fehler, der erst beim Balancing auffaellt. Deshalb enthaelt der Pool
-- ausschliesslich Boni, die CombatCalculator.getEffectiveStats auch wirklich
-- anwendet. Neue Typen sind ein Eintrag in STAT_POOL plus eine Zeile dort —
-- mehr braucht es nicht.

local Types = require(script.Parent.Parent.Network.Types)

--------------------------------------------------------------------------------
-- Slots
--------------------------------------------------------------------------------

local SLOT_COUNT = 8

-- Ab welcher PROMOTIONS-STUFE (0-10, nicht Sterne!) ein Slot benutzbar ist.
-- Die Zahlen kommen 1:1 aus der "Promotion Tiers"-Tabelle der Vorlage:
-- Slot I ist von Anfang an offen, II ab 2, III ab 4, IV ab 6, V und VI ab 8,
-- VII und VIII ab 10.
local SLOT_UNLOCK_PROMOTION: { number } = { 0, 2, 4, 6, 8, 8, 10, 10 }

-- Roemische Ziffern fuer die Slot-Beschriftung (I-VIII), wie in der Vorlage.
local SLOT_NUMERALS: { string } = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII" }

--------------------------------------------------------------------------------
-- Rarity eines Charms
--------------------------------------------------------------------------------

-- Eigene Rarity-Kette, absichtlich NICHT Types.Rarity: ein Charm hat sechs
-- Stufen mit anderen Namen ("Super Rare", "Ascended") als ein Baerchi. Sie in
-- einen Topf zu werfen waere die naechste Stelle, an der eine Baerchi-Aenderung
-- versehentlich die Charm-Odds verschiebt.
local RARITY_ORDER: { Types.CharmRarity } = {
	"Common", "Uncommon", "Rare", "SuperRare", "Legendary", "Ascended",
}

-- Wahrscheinlichkeit je Wurf, in Prozent. Zahlen 1:1 aus der Vorlage
-- (Bild 3: "Each slot rolls a rarity, then a stat").
-- Summe = 100.0 — die Pruefung dazu steht in rollRarity.
local RARITY_ODDS: { [Types.CharmRarity]: number } = {
	Common    = 49.8,
	Uncommon  = 26.9,
	Rare      = 17.9,
	SuperRare =  4.3,
	Legendary =  1.0,
	Ascended  =  0.1,
}

-- Kurzbuchstabe fuer das Slot-Icon (C / U / R / S / L / A), wie in der Vorlage.
local RARITY_LETTER: { [Types.CharmRarity]: string } = {
	Common    = "C",
	Uncommon  = "U",
	Rare      = "R",
	SuperRare = "S",
	Legendary = "L",
	Ascended  = "A",
}

local RARITY_LABEL: { [Types.CharmRarity]: string } = {
	Common    = "Common",
	Uncommon  = "Uncommon",
	Rare      = "Rare",
	SuperRare = "Super Rare",
	Legendary = "Legendary",
	Ascended  = "Ascended",
}

local RARITY_COLORS: { [Types.CharmRarity]: Color3 } = {
	Common    = Color3.fromRGB(176, 190, 204),
	Uncommon  = Color3.fromRGB( 76, 217, 100),
	Rare      = Color3.fromRGB( 46, 155, 255),
	SuperRare = Color3.fromRGB(168,  85, 247),
	Legendary = Color3.fromRGB(255, 176,  32),
	Ascended  = Color3.fromRGB(255,  59, 107),
}

-- Wie stark ein Charm dieser Rarity ist, als Faktor auf den Grundwert des
-- Stat-Typs (siehe STAT_POOL). Ein Ascended-Charm ist damit fuenfmal so stark
-- wie ein Common desselben Typs.
local RARITY_POWER: { [Types.CharmRarity]: number } = {
	Common    = 1.0,
	Uncommon  = 1.6,
	Rare      = 2.4,
	SuperRare = 3.4,
	Legendary = 4.4,
	Ascended  = 6.0,
}

--------------------------------------------------------------------------------
-- Stat-Typen
--------------------------------------------------------------------------------

-- `mode`:
--   "percent" — der Wert ist ein Faktor auf den Basiswert (0.014 = +1.4%)
--   "flat"    — der Wert wird direkt addiert
--
-- `base` ist der Wert eines COMMON-Charms dieses Typs; die Rarity
-- multipliziert ihn (RARITY_POWER), und rollValue streut zusaetzlich
-- +/- SPREAD, damit zwei Charms derselben Rarity nicht identisch sind.
export type CharmStatDef = {
	id          : string,
	displayName : string,
	target      : "hp" | "atk" | "spd" | "pwr",
	mode        : "percent" | "flat",
	base        : number,
}

-- Die vier Ziele sind genau die vier Basiswerte des Spiels. Eine
-- Schadensabwehr gibt es NICHT — es gibt keine Verteidigung mehr (siehe
-- BaerchiConfig): wer einen Tank will, wuerfelt auf HP-Boost.
local STAT_POOL: { CharmStatDef } = {
	{ id = "HpBoost",   displayName = "HP-Boost",         target = "hp",  mode = "percent", base = 0.014 },
	{ id = "AtkBoost",  displayName = "ATK-Boost",        target = "atk", mode = "percent", base = 0.012 },
	{ id = "SpdBoost",  displayName = "Angriffs-Tempo",   target = "spd", mode = "flat",    base = 0.020 },

	-- Flach, nicht prozentual: PWR ist selbst schon ein Multiplikator auf den
	-- Skill-Schaden. "+8% auf einen Multiplikator" waere eine Zahl, die
	-- niemand im Kopf nachrechnet — "+2.4 Prozentpunkte Ability-Schaden"
	-- dagegen schon.
	{ id = "PwrBoost",  displayName = "Ability-Staerke",  target = "pwr", mode = "flat",    base = 0.008 },
}

-- Streuung um den errechneten Wert (0.25 = +/- 25%).
local SPREAD = 0.25

--------------------------------------------------------------------------------
-- Kosten
--------------------------------------------------------------------------------

-- Ein Wurf wuerfelt ALLE freigeschalteten und nicht gesperrten Slots des
-- Baerchis auf einmal neu — genau wie in der Vorlage ("rerolls every slot you
-- have not locked"). Deshalb ist der Preis pro WURF, nicht pro Slot.
local ROLL_COST_GOLD_GUMMIES = 25

-- "Auto Roll" ist serverseitig einfach ein Wurf-Paket: der Client schickt eine
-- Anzahl, der Server wuerfelt so oft hintereinander, bis die Anzahl erreicht
-- ist ODER die GoldGummies nicht mehr reichen, und meldet das Ergebnis
-- gesammelt zurueck.
--
-- Bewusst so statt eines Dauer-Timers auf dem Client: ein Auto-Roll, der pro
-- Wurf ein Remote feuert, laeuft sofort in den RateLimiter (siehe
-- NetworkConfig) und wuerde entweder haengen oder halb durchlaufen. Ein Paket
-- ist eine Anfrage, eine Abrechnung, ein Ergebnis.
local AUTO_ROLL_COUNT = 20

--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

local function getUnlockPromotion(slot: number): number
	return SLOT_UNLOCK_PROMOTION[slot] or math.huge
end

local function isSlotUnlocked(slot: number, promotionLevel: number): boolean
	if slot < 1 or slot > SLOT_COUNT then
		return false
	end
	return (promotionLevel or 0) >= getUnlockPromotion(slot)
end

-- Wie viele Slots bei diesem Promotions-Stand offen sind.
local function countUnlockedSlots(promotionLevel: number): number
	local count = 0
	for slot = 1, SLOT_COUNT do
		if isSlotUnlocked(slot, promotionLevel) then
			count += 1
		end
	end
	return count
end

local function getStatDef(statId: string): CharmStatDef?
	for _, def in STAT_POOL do
		if def.id == statId then
			return def
		end
	end
	return nil
end

-- Wuerfelt eine Rarity anhand von RARITY_ODDS.
--
-- Geht die Kette bewusst von der SELTENSTEN zur haeufigsten durch und
-- vergleicht gegen die aufsummierte Wahrscheinlichkeit: so faellt ein
-- Rundungsrest (die Odds summieren sich auf exakt 100.0, aber math.random gibt
-- Werte bis knapp darunter) immer auf Common zurueck und nie auf einen
-- Ascended.
local function rollRarity(): Types.CharmRarity
	local roll        = math.random() * 100
	local accumulated = 0

	for i = #RARITY_ORDER, 1, -1 do
		local rarity = RARITY_ORDER[i]
		accumulated += RARITY_ODDS[rarity] or 0
		if roll < accumulated then
			return rarity
		end
	end

	return "Common"
end

local function rollStatDef(): CharmStatDef
	return STAT_POOL[math.random(1, #STAT_POOL)]
end

-- Der konkrete Bonus-Wert eines Charms: Grundwert des Typs, mal Rarity-Staerke,
-- plus/minus SPREAD.
local function rollValue(statDef: CharmStatDef, rarity: Types.CharmRarity): number
	local power  = RARITY_POWER[rarity] or 1
	local center = statDef.base * power
	local factor = 1 + (math.random() * 2 - 1) * SPREAD

	-- Auf vier Nachkommastellen runden: sonst stehen im Spielstand Zahlen mit
	-- fuenfzehn Stellen, die kein Mensch und keine Anzeige braucht.
	return math.floor(center * factor * 10000 + 0.5) / 10000
end

-- Wuerfelt einen kompletten Charm fuer einen Slot.
local function rollCharm(slot: number): Types.Charm
	local rarity  = rollRarity()
	local statDef = rollStatDef()

	return {
		slot   = slot,
		rarity = rarity,
		statId = statDef.id,
		value  = rollValue(statDef, rarity),
		locked = false,
	}
end

-- Lesbarer Effekt-Text ("+3.4% HP-Boost"). Server und Client benutzen
-- denselben, damit die Anzeige nicht zweimal formatiert wird.
local function describe(charm: Types.Charm): string
	local statDef = getStatDef(charm.statId)
	if not statDef then
		return charm.statId
	end

	-- Als Prozent anzuzeigen sind zwei Faelle: echte Prozent-Charms (HP/ATK)
	-- und PWR. PWR ist zwar technisch ein FLACHER Zuschlag, aber der Wert
	-- selbst ist ein Anteil (0.05 = 5% mehr Ability-Schaden) — als "+0.048"
	-- koennte ihn niemand einordnen.
	if statDef.mode == "percent" or statDef.target == "pwr" then
		return string.format("+%.1f%% %s", charm.value * 100, statDef.displayName)
	end
	return string.format("+%.3f %s", charm.value, statDef.displayName)
end

return {
	SLOT_COUNT            = SLOT_COUNT,
	SLOT_UNLOCK_PROMOTION = SLOT_UNLOCK_PROMOTION,
	SLOT_NUMERALS         = SLOT_NUMERALS,

	RARITY_ORDER   = RARITY_ORDER,
	RARITY_ODDS    = RARITY_ODDS,
	RARITY_LETTER  = RARITY_LETTER,
	RARITY_LABEL   = RARITY_LABEL,
	RARITY_COLORS  = RARITY_COLORS,
	RARITY_POWER   = RARITY_POWER,

	STAT_POOL = STAT_POOL,
	SPREAD    = SPREAD,

	ROLL_COST_GOLD_GUMMIES = ROLL_COST_GOLD_GUMMIES,
	AUTO_ROLL_COUNT        = AUTO_ROLL_COUNT,

	getUnlockPromotion = getUnlockPromotion,
	isSlotUnlocked     = isSlotUnlocked,
	countUnlockedSlots = countUnlockedSlots,
	getStatDef         = getStatDef,
	rollRarity         = rollRarity,
	rollCharm          = rollCharm,
	describe           = describe,
}
]]></ProtectedString>
					<string name="ScriptGuid">{CF5D342B-0D53-45C8-9308-33BAD5104992}</string>
