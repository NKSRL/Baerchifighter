					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- EggModels.luau
-- ReplicatedStorage/Modules/EggModels.luau
--
-- Einzige Zustaendigkeit:
--   - Welches fertige Ei-Modell (ReplicatedStorage.Assets.Eggs, aus den GLB-
--     Dateien importiert) zu welchem EggType gehoert, und wie eine Kopie davon
--     auf einen Ei-Koerper in der Welt gesetzt wird.
--
-- Die Modelle sind fertig gefaerbt (Textur auf dem Koerper, Gold/Edelsteine/
-- Konturen als Teilfarben, Leucht-Teile als Neon). Sie haben mehrere MeshParts
-- (7 bis 50; Ascension 35), deshalb setzt NUR DER CLIENT sie ein (LaidEggMeshController):
-- der Server baut weiter einen einzelnen unsichtbaren Koerper je Ei und bleibt
-- im Teile-Budget (<= 250 je Insel).
--
-- Eier ohne Modell behalten den alten Look (EggMesh + Gurte/Steine). Seit R2 haben
-- alle 21 Eier ein Modell (Nova, UFO-Jackpot aus den Teilen der anderen Eier + eigener Textur).
-- Schalter: FeatureFlags.EGG_MODELS_V1 (aus = alter Look fuer alle Eier).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local EggModels = {}

-- Modell-Name je EggType. Neue Eier: Modell nach Assets.Eggs legen und hier eintragen.
local TEMPLATE_NAME: { [string]: string } = {
	BasicEgg         = "Egg_Basic",
	SugarEgg         = "Egg_PinkBow",
	PlatinumEgg      = "Egg_Platinum",
	SunEgg           = "Egg_Blaze",
	CrystalEgg       = "Egg_Crystal",
	PrismEgg         = "Egg_Frost",
	AuroraEgg        = "Egg_Aurora",
	MistEgg          = "Egg_Mist",
	VoidEgg          = "Egg_Void",
	CometEgg         = "Egg_Comet",
	GalaxyEgg        = "Egg_Galaxy",
	TranscendenceEgg = "Egg_Transcendence",
	OmegaEgg         = "Egg_Omega",
	GoldenEgg        = "Egg_Goldenes",
	ZenithEgg        = "Egg_Zenit",
	ShadowEgg        = "Egg_Schatten",
	AbyssEgg         = "Egg_Abyss",
	EternityEgg      = "Egg_Ewigkeit",
	AscensionEgg     = "Egg_Ascension",
	NovaEgg          = "Egg_Nova",          -- R2 (16.10.)
	UfoJackpotEgg    = "Egg_UfoJackpot",    -- R2 (16.10.)
}

-- Wie gross das Modell gegenueber dem Koerper-Hoehe des gelegten Eis ist.
-- 1.1 = die Eier sind (mit Kontur und Zubehoer) etwas besser zu sehen, bleiben
-- aber klar kleiner als der Baerchi (2,7 Studs).
local MODEL_SCALE = 1.1

function EggModels.isEnabled(): boolean
	return FeatureFlags.isOn("EGG_MODELS_V1")
end

-- Hat dieser EggType ein Modell (und ist der Schalter an)?
function EggModels.has(eggId: string): boolean
	return TEMPLATE_NAME[eggId] ~= nil and EggModels.isEnabled()
end

-- Die Vorlage oder nil (Schalter aus, kein Modell, Assets noch nicht da).
function EggModels.getTemplate(eggId: string): Model?
	if not EggModels.has(eggId) then return nil end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Eggs")
	local template = folder and folder:FindFirstChild(TEMPLATE_NAME[eggId])
	if template and template:IsA("Model") and template.PrimaryPart then
		return template
	end
	return nil
end

-- Setzt `model` (Kopie einer Vorlage) so auf den Ei-Koerper `body`, dass der
-- Fuss am Boden bleibt und die Drehung des Koerpers uebernommen wird.
-- `factor` skaliert zusaetzlich (Pop-Animation, 1 = fertig).
-- Das Modell wird ueber seine Vorlage skaliert; `baseHeight` ist die Hoehe des
-- Ei-Koerpers (PrimaryPart) der UNskalierten Vorlage.
function EggModels.place(model: Model, baseHeight: number, body: BasePart, factor: number)
	local target   = body.Size.Y * MODEL_SCALE
	local scale    = target / baseHeight * factor
	model:ScaleTo(scale)
	local half     = baseHeight * scale * 0.5
	model:PivotTo(body.CFrame * CFrame.new(0, -body.Size.Y * 0.5 + half, 0))
end

return EggModels
]]></ProtectedString>
						<string name="ScriptGuid">{40BE0F03-8852-43FC-8904-9C9C81916983}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">EggModels</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX1E9FE22E77C64A49BBF64F3A3F93B22A">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- PetCapacity.luau
-- ReplicatedStorage/Modules/PetCapacity.luau
--
-- Einzige Zustaendigkeit:
--   - Die Rechenregeln des Pet-Limits als reine Funktionen ueber den Spielstand:
--     Limit, Anzahl, freier Platz, Zustand (ok / warn / full / over)
--
-- Keine Roblox-Dienste ausser den Schaltern. Der Server (EggService) setzt die
-- Regel durch, der Client (Zaehler, ausgegraute Oeffnen-Knoepfe) rechnet mit
-- denselben Funktionen — der Client entscheidet aber nie.
--
-- Was zaehlt: ALLE Baerchis in island.baerchis (auch das ausgeruestete und das
-- im Inkubator). Was nicht zaehlt: Eier und der Index.
--
-- Schalter aus (PET_LIMIT_V1 = false): es gibt kein Limit, getFree liefert
-- unendlich viel Platz — das Spiel verhaelt sich wie vor dem Paket.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FeatureFlags   = require(ReplicatedStorage.Config.FeatureFlags)
local PetLimitConfig = require(ReplicatedStorage.Config.PetLimitConfig)

local PetCapacity = {}

export type State = "ok" | "warn" | "full" | "over"

function PetCapacity.isActive(): boolean
	return FeatureFlags.isOn("PET_LIMIT_V1")
end

-- Das Limit dieses Spielers. HAKEN fuer spaeter: hier kommen Rebirth-, Gamepass-
-- und Upgrade-Boni drauf (data.rebirthCount, data.gamepasses, ...). Heute nur
-- der Basiswert.
function PetCapacity.getPetLimit(_data: any): number
	return PetLimitConfig.BASE_LIMIT
end

-- Anzahl aller Baerchis im Besitz.
function PetCapacity.count(data: any): number
	local n = 0
	for _ in data.island.baerchis do
		n += 1
	end
	return n
end

-- Freier Platz (>= 0). Mit ausgeschaltetem Schalter: math.huge.
function PetCapacity.getFree(data: any): number
	if not PetCapacity.isActive() then return math.huge end
	return math.max(0, PetCapacity.getPetLimit(data) - PetCapacity.count(data))
end

-- Passen `n` weitere Baerchis hinein?
function PetCapacity.canAdd(data: any, n: number): boolean
	return PetCapacity.getFree(data) >= n
end

function PetCapacity.isFull(data: any): boolean
	return PetCapacity.getFree(data) <= 0
end

-- Zustand fuer die Anzeige. "over" = ein Bestandsspieler mit mehr Baerchis als
-- das Limit: nichts wird geloescht, aber es kommt nichts Neues dazu.
function PetCapacity.state(data: any): State
	local limit = PetCapacity.getPetLimit(data)
	local count = PetCapacity.count(data)
	if count > limit then return "over" end
	if count >= limit then return "full" end
	if count >= limit * PetLimitConfig.WARN_FRACTION then return "warn" end
	return "ok"
end

return PetCapacity
]]></ProtectedString>
						<string name="ScriptGuid">{10F83EA4-6911-46A5-BA65-11A1EF164826}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">PetCapacity</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
