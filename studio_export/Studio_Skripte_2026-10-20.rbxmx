	-- 19.10.: Pet-Limit und Verkaufsmodus
	["err.pet_limit_full"]            = "Dein Bärchi-Lager ist voll – verkaufe Bärchis, um Platz zu schaffen",
	["err.pet_limit_partial"]         = "Lager voll – geöffnet: {n}. Der Rest bleibt im Eier-Lager",
