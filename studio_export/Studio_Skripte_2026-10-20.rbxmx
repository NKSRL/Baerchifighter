					<Item class="ModuleScript" referent="RBX7244C783832C4E70966068C40875A4E1">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- MapParts.luau
-- ServerScriptService/Util/MapBuild/MapParts.luau
--
-- Einzige Zustaendigkeit:
--   - Bausteine, die alle Map-Builder teilen: Plot-Lage (CFrame, Richtung
--     nach aussen, Arena-Mitte), einfache Parts und Beschriftungen, Inseln,
--     Karo-Wiese, Stege und deklarative Deko aus MapConfig
--
-- Reine Bau-Funktionen ohne Zustand ausser einem Cache der Plot-CFrames (die
-- sich nie aendern). Alle Masse kommen aus MapConfig.
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)

local MapParts = {}

-- Plot-CFrames pro Slot. Sie haengen nur an MapConfig und aendern sich nie,
-- deshalb einmal berechnet und gemerkt.
local _plotCFrames: { [number]: CFrame } = {}

-- Das CFrame eines Plots: steht auf dem Ring und schaut zur Plattform-Mitte.
-- Dadurch ist lokales -Z immer "Richtung Mitte" und +Z immer "nach aussen",
-- egal bei welchem der 8 Winkel der Plot liegt.
function MapParts.buildPlotCFrame(slot: number): CFrame
	local angle = math.rad((slot - 1) * (360 / MapConfig.PLOT_COUNT))
	local position = Vector3.new(
		MapConfig.CENTER.X + MapConfig.PLOT_RING_RADIUS * math.cos(angle),
		MapConfig.PLATFORM_TOP_Y,
		MapConfig.CENTER.Z + MapConfig.PLOT_RING_RADIUS * math.sin(angle)
	)

	return CFrame.lookAt(position, Vector3.new(MapConfig.CENTER.X, position.Y, MapConfig.CENTER.Z))
end

-- Richtung "nach aussen" fuer einen Plot (XZ-Einheitsvektor vom Mittelpunkt weg)
function MapParts.outwardDirection(slot: number): Vector3
	local position = MapParts.plotCFrame(slot).Position
	local flat = Vector3.new(position.X - MapConfig.CENTER.X, 0, position.Z - MapConfig.CENTER.Z)
	if flat.Magnitude < 1e-3 then
		return Vector3.new(1, 0, 0)   -- Sicherheitsnetz, sollte nie vorkommen
	end
	return flat.Unit
end

-- Hoehe der begehbaren Plot-Oberflaeche ueber dem Plot-CFrame-Ursprung.
-- Der Ursprung liegt auf der Plattform-Oberkante, die Plot-Platte liegt
-- darauf — alles was auf dem Plot steht, startet also hier.
function MapParts.plotSurfaceOffset(): number
	return MapConfig.PLOT_SIZE.Y
end

function MapParts.newPart(name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material): Part
	local part = Instance.new("Part")
	part.Name          = name
	part.Size          = size
	part.CFrame        = cframe
	part.Anchored      = true
	part.Material      = material
	part.Color         = color
	part.TopSurface    = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

-- Eine runde Insel: Sandkante plus die eigentliche Oberflaeche.
--
-- Der Trick fuer die Sandkante ist, dass sie KEIN Ring ist, sondern eine
-- breitere Scheibe, die ein Stueck tiefer liegt. Sichtbar bleibt nur ihr
-- ueberstehender Rand — ein echter Ring waere ein Dutzend Segmente fuer
-- dasselbe Bild, und an jeder Naht eine Kante, an der man haengen bleibt.
--
-- Ein Cylinder-Part liegt in Roblox von Haus aus entlang X; damit er flach
-- liegt, wird er um 90 Grad um Z gekippt. Seine Size ist dann
-- (Dicke, Durchmesser, Durchmesser) — dieselbe Stolperfalle wie bei den
-- Deko-Zylindern in der Config.
-- `drop` senkt die Oberflaeche der Insel ab (Standard 0, also buendig mit
-- PLATFORM_TOP_Y). Gebraucht wird das nur von der Arena-Insel: auf ihr liegt
-- noch die Kampfflaeche, und zwei deckungsgleiche Oberseiten wuerden
-- flimmern — siehe MapConfig.PIT_RIM_DROP.
function MapParts.buildIsland(
	parent: Instance,
	name: string,
	center: Vector3,
	radius: number,
	topColor: Color3,
	topMaterial: Enum.Material,
	drop: number?
): Part
	local topY = MapConfig.PLATFORM_TOP_Y - (drop or 0)

	local shoreRadius = radius + MapConfig.SHORE_WIDTH
	local shore = MapParts.newPart(
		name .. "Shore",
		Vector3.new(MapConfig.ISLAND_HEIGHT, shoreRadius * 2, shoreRadius * 2),
		CFrame.new(
			center.X,
			topY - MapConfig.SHORE_DROP - MapConfig.ISLAND_HEIGHT * 0.5,
			center.Z
		) * CFrame.Angles(0, 0, math.rad(90)),
		MapConfig.SHORE_COLOR,
		Enum.Material.Sand
	)
	shore.Shape  = Enum.PartType.Cylinder
	shore.Parent = parent

	local top = MapParts.newPart(
		name,
		Vector3.new(MapConfig.ISLAND_HEIGHT, radius * 2, radius * 2),
		CFrame.new(center.X, topY - MapConfig.ISLAND_HEIGHT * 0.5, center.Z)
			* CFrame.Angles(0, 0, math.rad(90)),
		topColor,
		topMaterial
	)
	top.Shape  = Enum.PartType.Cylinder
	top.Parent = parent

	return top
end

-- Ein einzelnes helles Karo-Feld.
--
-- Es liegt GRASS_HEIGHT ueber der Inselscheibe statt buendig mit ihr: zwei
-- exakt gleich hohe Flaechen flimmern in Roblox gegeneinander. Es kollidiert
-- nicht — die begehbare Flaeche bleibt die Insel darunter, sonst haette die
-- Wiese alle paar Studs eine 0.08 hohe Stufe.
function MapParts.newGrassTile(parent: Instance, name: string, cframe: CFrame, sizeX: number, sizeZ: number)
	local tile = MapParts.newPart(
		name,
		Vector3.new(sizeX, MapConfig.GRASS_HEIGHT, sizeZ),
		cframe,
		MapConfig.GRASS_LIGHT,
		Enum.Material.Grass
	)
	tile.CanCollide = false
	tile.CanQuery   = false
	tile.CanTouch   = false
	tile.Parent     = parent
end

-- Die hellen Felder der Karo-Wiese auf einer runden Insel.
--
-- Gebaut wird nur die HELLE Haelfte; die dunkle ist die Inselscheibe selbst.
-- Das Raster liegt in Weltkoordinaten mit Ursprung im Weltmittelpunkt, damit
-- die Karos ueber alle Inseln durchlaufen statt auf jeder neu anzusetzen.
--
-- Ein Feld wird nur gesetzt, wenn seine VIER ECKEN in der Scheibe liegen —
-- sonst raete ein halbes Karo ueber den Inselrand hinaus ins Wasser. Am Rand
-- bleibt dadurch ein unregelmaessiger dunkler Saum stehen, und genau der
-- laesst die Wiese am Ufer auslaufen statt abgeschnitten zu wirken.
-- Die Mitte kommt als zwei Zahlen und nicht als Vector3: das hier ist ein
-- Raster in der Ebene, die Hoehe steht ohnehin fest. Aufrufer, die einen
-- Vector3 haben, geben eben .X und .Z weiter.
function MapParts.buildCheckerDisc(parent: Instance, centerX: number, centerZ: number, radius: number)
	local tile = MapConfig.GRASS_TILE
	local half = tile * 0.5
	local y    = MapConfig.PLATFORM_TOP_Y + MapConfig.GRASS_HEIGHT * 0.5

	for i = math.floor((centerX - radius) / tile), math.ceil((centerX + radius) / tile) do
		for j = math.floor((centerZ - radius) / tile), math.ceil((centerZ + radius) / tile) do
			if (i + j) % 2 == 0 then
				local x = (i + 0.5) * tile
				local z = (j + 0.5) * tile

				local inside = true
				for _, cx in { -half, half } do
					for _, cz in { -half, half } do
						local dx = x + cx - centerX
						local dz = z + cz - centerZ
						if dx * dx + dz * dz > radius * radius then
							inside = false
						end
					end
				end

				if inside then
					MapParts.newGrassTile(parent, "GrassTile", CFrame.new(x, y, z), tile, tile)
				end
			end
		end
	end
end

-- Dasselbe auf einer quadratischen, GEDREHTEN Flaeche (dem Plot-Beet).
--
-- Hier rastert das Karo plot-lokal und nicht weltweit: das Beet steht je nach
-- Plot in einem anderen Winkel, und ein weltweit ausgerichtetes Raster laege
-- darauf schief. Weil zwischen Beet und Hauptinsel Wasser liegt, sieht man die
-- beiden Raster nie nebeneinander.
function MapParts.buildCheckerPlate(parent: Instance, plate: CFrame, sizeX: number, sizeZ: number)
	local tile   = MapConfig.PLOT_GRASS_TILE
	local countX = math.max(1, math.floor(sizeX / tile))
	local countZ = math.max(1, math.floor(sizeZ / tile))

	-- Was nicht in ganze Felder aufgeht, wird gleichmaessig auf die Felder
	-- verteilt statt als Reststreifen an einer Kante stehen zu lassen.
	local stepX = sizeX / countX
	local stepZ = sizeZ / countZ
	local y     = MapConfig.GRASS_HEIGHT * 0.5

	for i = 0, countX - 1 do
		for j = 0, countZ - 1 do
			if (i + j) % 2 == 0 then
				local x = (i - (countX - 1) * 0.5) * stepX
				local z = (j - (countZ - 1) * 0.5) * stepZ
				MapParts.newGrassTile(parent, "GrassTile", plate * CFrame.new(x, y, z), stepX, stepZ)
			end
		end
	end
end

-- Baut eine Liste von Deko-Teilen (MapConfig.DecorPiece) auf.
--
-- `origin` ist der Ursprung, auf den sich alle Offsets beziehen: die Mitte der
-- Grundflaeche des Objekts, +Y nach oben. Damit kann in der Config in "so hoch
-- ueber dem Boden" gedacht werden statt in Weltkoordinaten.
--
-- Deko ist nie anklickbar (CanQuery = false): ein Klick soll immer beim
-- EIGENTLICHEN Objekt landen — der Gebaeude-Part —, nicht beim Deckel oder
-- der Kuppel.
--
-- Kollision entscheidet dagegen die Config pro Teil (`solid`). Der unsichtbare
-- Koerper taugt dafuer nicht: er ist ein Kasten in der Groesse aus
-- BUILDING_OFFSETS und hat mit der sichtbaren Form nichts mehr zu tun. Bei der
-- offenen Presse wuerde man mitten in der Luft zwischen den Pfosten
-- stehenbleiben und ueber der Kuppel des Bienenstocks auf einer 12x12 grossen
-- unsichtbaren Platte. Also kollidieren genau die Teile, die man auch SIEHT.
function MapParts.buildDecor(parent: Instance, origin: CFrame, pieces: { MapConfig.DecorPiece })
	for _, piece in pieces do
		local cframe = origin * CFrame.new(piece.offset)

		local rotation = piece.rotation
		if rotation then
			cframe = cframe * CFrame.Angles(
				math.rad(rotation.X),
				math.rad(rotation.Y),
				math.rad(rotation.Z)
			)
		end

		local part = MapParts.newPart(
			piece.name,
			piece.size,
			cframe,
			piece.color,
			piece.material or Enum.Material.SmoothPlastic
		)
		part.Shape      = piece.shape
		part.CanCollide = piece.solid == true
		part.CanQuery   = false
		part.CanTouch   = false
		part.Parent     = parent
	end
end

-- Wie hoch das hoechste Deko-Teil einer Liste ueber dem Boden reicht.
--
-- Braucht das Schild ueber einem Gebaeude: haenge es an der Groesse des
-- unsichtbaren Koerpers auf, und es rutscht bei jeder Formaenderung entweder
-- in die Kuppel hinein oder schwebt weit darueber. So bleibt die Regel
-- "Form aendert man nur in der Config" auch fuer das Schild wahr.
--
-- Ein um 90 Grad gekippter Zylinder hat seine Hoehe in X, nicht in Y — dieselbe
-- Umrechnung wie in tools/check_decor.py.
function MapParts.decorHeight(pieces: { MapConfig.DecorPiece }?): number
	if not pieces then return 0 end

	local top = 0
	for _, piece in pieces do
		local halfHeight = piece.size.Y * 0.5

		local rotation = piece.rotation
		if rotation then
			local roll = rotation.Z % 360
			if roll == 90 or roll == 270 then
				halfHeight = piece.size.X * 0.5
			end
		end

		top = math.max(top, piece.offset.Y + halfHeight)
	end

	return top
end

-- Ein einzeiliges Text-Label, wie es auf allen Schildern und Namensschildern
-- benutzt wird. Spart die immer gleichen acht Zeilen Aufbau.
function MapParts.newTextLabel(name: string, parent: Instance, size: UDim2, position: UDim2): TextLabel
	local label = Instance.new("TextLabel")
	label.Name                   = name
	label.Size                   = size
	label.Position               = position
	label.BackgroundTransparency = 1
	label.Font                   = Enum.Font.FredokaOne
	label.TextScaled             = true
	label.TextColor3             = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
	label.Text                   = ""
	label.Parent                 = parent
	return label
end

-- Ein Holzsteg zwischen zwei Inseln, entlang der Aussenrichtung eines Plots.
--
-- `fromRadius` ist der Rand der inneren, `toRadius` der Rand der aeusseren
-- Insel — beide als Abstand zur WELT-Mitte, weil alle Inseln auf derselben
-- Achse liegen. Der Steg schiebt sich an beiden Enden um BRIDGE_OVERLAP
-- darunter, damit an den runden Raendern keine Sichel klafft (siehe
-- MapConfig.BRIDGE_OVERLAP).
--
-- Es gibt genau diese eine Funktion fuer alle 16 Stege: der innere (Hauptinsel
-- → Plot) und der aeussere (Plot → Arena) unterscheiden sich nur in den beiden
-- Radien. Zwei getrennte Bau-Funktionen waren genau die Doppelung, aus der die
-- alte, nur fuer den aeusseren Steg gedachte BRIDGE_LENGTH stammte.
function MapParts.buildSpan(parent: Instance, name: string, outward: Vector3, fromRadius: number, toRadius: number)
	local innerEdge = fromRadius - MapConfig.BRIDGE_OVERLAP
	local outerEdge = toRadius + MapConfig.BRIDGE_OVERLAP

	local deckLength = outerEdge - innerEdge
	local midpoint   = MapConfig.CENTER + outward * ((innerEdge + outerEdge) * 0.5)
	local deckY      = MapConfig.PLATFORM_TOP_Y - MapConfig.BRIDGE_SINK - MapConfig.BRIDGE_HEIGHT * 0.5

	local deckCFrame = CFrame.lookAt(
		Vector3.new(midpoint.X, deckY, midpoint.Z),
		Vector3.new(midpoint.X, deckY, midpoint.Z) + outward
	)

	local deck = MapParts.newPart(
		name,
		Vector3.new(MapConfig.BRIDGE_WIDTH, MapConfig.BRIDGE_HEIGHT, deckLength),
		deckCFrame,
		MapConfig.BRIDGE_COLOR,
		Enum.Material.WoodPlanks
	)
	deck.Parent = parent

	-- Gelaender links und rechts, damit der Steg nicht wie ein Brett aussieht
	local railOffsetX = (MapConfig.BRIDGE_WIDTH + MapConfig.BRIDGE_RAIL_WIDTH) * 0.5
	local railY       = MapConfig.BRIDGE_HEIGHT * 0.5 + MapConfig.BRIDGE_RAIL_HEIGHT * 0.5

	for _, side in { -1, 1 } do
		local rail = MapParts.newPart(
			name .. "Rail",
			Vector3.new(MapConfig.BRIDGE_RAIL_WIDTH, MapConfig.BRIDGE_RAIL_HEIGHT, deckLength),
			deckCFrame * CFrame.new(side * railOffsetX, railY, 0),
			MapConfig.BRIDGE_RAIL_COLOR,
			Enum.Material.WoodPlanks
		)
		rail.Parent = parent
	end
end

-- Weltposition der Arena-Mitte (Oberkante Kampfflaeche).
--
-- Die Arena-Insel liegt genau eine Luecke hinter der Plot-Insel, ihr SOCKEL
-- (PIT_BASE_RADIUS) ist ihr Inselrand. Der Steg landet deshalb auf dem Sockel;
-- die goldene Kampfflaeche liegt als kleinere Scheibe darauf, sodass ringsum
-- ein Absatz fuer Zaun und Leuchtring bleibt.
function MapParts.pitCenter(slot: number): Vector3
	local outward = MapParts.outwardDirection(slot)
	local radius  = MapConfig.PLOT_RING_RADIUS
		+ MapConfig.PLOT_ISLAND_RADIUS
		+ MapConfig.ISLAND_GAP
		+ MapConfig.PIT_BASE_RADIUS

	local flat = MapConfig.CENTER + outward * radius
	return Vector3.new(flat.X, MapConfig.PLATFORM_TOP_Y, flat.Z)
end

-- Das CFrame eines Plots (gemerkt). Siehe buildPlotCFrame.
function MapParts.plotCFrame(slot: number): CFrame
	local cached = _plotCFrames[slot]
	if cached then
		return cached
	end
	local cframe = MapParts.buildPlotCFrame(slot)
	_plotCFrames[slot] = cframe
	return cframe
end

return MapParts
]]></ProtectedString>
							<string name="ScriptGuid">{C40D396B-FBC7-400D-9C6B-FFF1204247C7}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">MapParts</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX2F8601029AB64F369FD7BB4A109924F7">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- PlotBuilder.luau
-- ServerScriptService/Util/MapBuild/PlotBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Das Grundgeruest eines Spieler-Plots (Beet, Zaun, Schild) und die
--     Honig-Gebaeude mit Schild und Honig-Tropfen bauen und beschriften
--
-- Gebaeude bestehen aus einem unsichtbaren Koerper (Name, Level, Schild,
-- Client-Prompt) und der deklarativen Deko aus MapConfig.BUILDING_DECOR plus
-- den Zusaetzen ihres Looks (v15, MapConfig.getBuildingDecor). Der Look steht
-- als Attribut "Look" am Koerper — MapService baut ein Gebaeude nur neu, wenn
-- sich der Look aendert.
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types            = require(ReplicatedStorage.Network.Types)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local Names     = require(ReplicatedStorage.Localization.Names)
local WorldText = require(ReplicatedStorage.Localization.WorldText)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local PlotBuilder = {}

-- Zaun rund um den Plot: an beiden Seiten durchgehend und vorne (-Z) sowie
-- hinten (+Z) von den Ecken bis direkt an die Torbogen-Saeulen (x = ±8.6),
-- sodass das gesamte Beet eingerahmt ist und nur die beiden Torboegen offen bleiben.
function PlotBuilder.buildFence(plotModel: Model, slot: number)
	local plotCFrame = MapParts.plotCFrame(slot)
	local halfX = MapConfig.PLOT_SIZE.X * 0.5
	local halfZ = MapConfig.PLOT_SIZE.Z * 0.5

	local surfaceY      = MapParts.plotSurfaceOffset()
	local postY         = surfaceY + MapConfig.FENCE_POST_SIZE.Y * 0.5
	local steps         = math.max(1, math.floor(MapConfig.PLOT_SIZE.Z / MapConfig.FENCE_POST_SPACING))
	local postColor     = Color3.fromRGB(122, 78, 42)
	local goldColor     = Color3.fromRGB(235, 180, 50)
	local pillarX       = 8.6
	local wingSpan      = halfX - pillarX
	local wingCenterX   = (halfX + pillarX) * 0.5
	local railThickness = MapConfig.FENCE_POST_SIZE.X * 0.62

	for _, side in { -1, 1 } do
		for i = 0, steps do
			local z = -halfZ + (i / steps) * MapConfig.PLOT_SIZE.Z

			local post = MapParts.newPart(
				"FencePost",
				MapConfig.FENCE_POST_SIZE,
				plotCFrame * CFrame.new(side * halfX, postY, z),
				postColor,
				Enum.Material.Wood
			)
			post.CanCollide = false
			post.Parent     = plotModel

			-- Goldene Honig-Kappen samt Metall-Kragen auf den vier Eckpfosten
			-- (Eingang von der Hauptinsel und Ausgang zur Arena), damit das Plot
			-- wie ein edel eingerahmtes Camp wirkt.
			if i == 0 or i == steps then
				local collar = MapParts.newPart(
					"FenceCollar",
					Vector3.new(MapConfig.FENCE_POST_SIZE.X + 0.35, 0.45, MapConfig.FENCE_POST_SIZE.Z + 0.35),
					plotCFrame * CFrame.new(side * halfX, surfaceY + MapConfig.FENCE_POST_SIZE.Y - 0.15, z),
					goldColor,
					Enum.Material.Metal
				)
				collar.CanCollide = false
				collar.CanQuery   = false
				collar.CanTouch   = false
				collar.CastShadow = false
				collar.Parent     = plotModel

				local capY = surfaceY + MapConfig.FENCE_POST_SIZE.Y + 0.55
				local cap = MapParts.newPart(
					"FenceCap",
					Vector3.new(1.65, 1.65, 1.65),
					plotCFrame * CFrame.new(side * halfX, capY, z),
					Color3.fromRGB(255, 200, 65),
					Enum.Material.Neon
				)
				cap.Shape      = Enum.PartType.Ball
				cap.CanCollide = false
				cap.CanQuery   = false
				cap.CanTouch   = false
				cap.CastShadow = false
				cap.Parent     = plotModel
			end
		end

		-- Zwei durchgehende Honig-Zedernholz-Querlatten an den beiden laengsseitigen Zaeunen
		for _, heightFactor in { 0.42, 0.82 } do
			local railY = surfaceY + MapConfig.FENCE_POST_SIZE.Y * heightFactor

			local rail = MapParts.newPart(
				"FenceRail",
				Vector3.new(railThickness, MapConfig.FENCE_RAIL_HEIGHT, MapConfig.PLOT_SIZE.Z),
				plotCFrame * CFrame.new(side * halfX, railY, 0),
				MapConfig.FENCE_COLOR,
				Enum.Material.WoodPlanks
			)
			rail.CanCollide = false
			rail.Parent     = plotModel
		end

		-- Vorne (-Z) und hinten (+Z): Zaunfluegel von der Ecke bis direkt in die Torbogen-Saeule
		for _, zSign in { -1, 1 } do
			local zPos = zSign * halfZ

			for step = 1, 2 do
				local xPos = side * (pillarX + (step / 3) * wingSpan)
				local wingPost = MapParts.newPart(
					"FencePost",
					MapConfig.FENCE_POST_SIZE,
					plotCFrame * CFrame.new(xPos, postY, zPos),
					postColor,
					Enum.Material.Wood
				)
				wingPost.CanCollide = false
				wingPost.Parent     = plotModel
			end

			for _, heightFactor in { 0.42, 0.82 } do
				local railY = surfaceY + MapConfig.FENCE_POST_SIZE.Y * heightFactor
				local wingRail = MapParts.newPart(
					"FenceRail",
					Vector3.new(wingSpan, MapConfig.FENCE_RAIL_HEIGHT, railThickness),
					plotCFrame * CFrame.new(side * wingCenterX, railY, zPos),
					MapConfig.FENCE_COLOR,
					Enum.Material.WoodPlanks
				)
				wingRail.CanCollide = false
				wingRail.Parent     = plotModel
			end
		end
	end
end

-- Trittstein-Gartenpfad auf dem 72x72-Beet: fuehrt das Auge (und die Fuesse)
-- vom inneren Steg direkt durch den Torbogen zum Honig-Brunnen/Baerchi-Platz
-- und weiter zum Arena-Steg sowie zu Inkubator und Recycler. Rein optisch (keine Kollision).
local STEP_STONES: { { x: number, z: number, r: number } } = {
	{ x =   0, z = -32, r = 3.5 },
	{ x =  -3, z = -23, r = 3.0 },
	{ x =  -8, z = -14, r = 3.0 },
	{ x =  -6, z =  -3, r = 3.2 },
	{ x =   0, z =   6, r = 4.2 },
	{ x =   0, z =  17, r = 3.2 },
	{ x =   3, z =  26, r = 3.0 },
	{ x =   0, z =  33, r = 3.4 },
	{ x =  12, z =   8, r = 2.8 },
}

function PlotBuilder.buildPlotPath(plotModel: Model, slot: number)
	local plotCFrame = MapParts.plotCFrame(slot)
	local y = MapParts.plotSurfaceOffset() + MapConfig.GRASS_HEIGHT + 0.04
	local stoneColor = Color3.fromRGB(228, 206, 162)

	for i, s in STEP_STONES do
		local stone = MapParts.newPart(
			"StepStone_" .. i,
			Vector3.new(0.12, s.r * 2, s.r * 2),
			plotCFrame * CFrame.new(s.x, y, s.z) * CFrame.Angles(0, 0, math.rad(90)),
			stoneColor,
			Enum.Material.Cobblestone
		)
		stone.Shape      = Enum.PartType.Cylinder
		stone.CanCollide = false
		stone.CanQuery   = false
		stone.CanTouch   = false
		stone.CastShadow = false
		stone.Parent     = plotModel
	end
end

-- Baut jeweils einen eindrucksvollen Torbogen vorne (-Z, Richtung Hauptinsel,
-- mit grosser Namenstafel "SignBoard" fuer Besitzername und Tower-Rekord) und
-- hinten (+Z, Richtung Arena-Steg, als reiner monumentaler Ehrenbogen ohne Namenstafel).
-- Die Saeulen stehen bei x = ±8.6 direkt in der Flucht der vorderen/hinteren Zaeune.
function PlotBuilder.buildPlotSign(plotModel: Model, slot: number, ownerName: string)
	local plotCFrame = MapParts.plotCFrame(slot)
	local halfZ      = MapConfig.PLOT_SIZE.Z * 0.5
	local surfaceY   = MapParts.plotSurfaceOffset()

	local boardSize  = MapConfig.SIGN_BOARD_SIZE
	local pillarX    = 8.6
	local postHeight = 15.2
	local goldColor  = Color3.fromRGB(235, 180, 50)
	local stoneColor = Color3.fromRGB(215, 198, 168)

	local gates: { { z: number, boardName: string? } } = {
		{ z = -halfZ, boardName = "SignBoard" },
		{ z =  halfZ, boardName = nil },
	}

	for _, gate in gates do
		local archZ = gate.z

		-- Zwei Torbogen-Saeulen links und rechts neben dem Hauptweg (15+ Studs Durchgang)
		for _, side in { -1, 1 } do
			local px = side * pillarX

			local plinth = MapParts.newPart(
				"SignPlinth",
				Vector3.new(2.8, 1.8, 2.8),
				plotCFrame * CFrame.new(px, surfaceY + 0.9, archZ),
				stoneColor,
				Enum.Material.Cobblestone
			)
			plinth.CanCollide = false
			plinth.CanQuery   = false
			plinth.CanTouch   = false
			plinth.CastShadow = false
			plinth.Parent     = plotModel

			local post = MapParts.newPart(
				"SignPost",
				Vector3.new(MapConfig.SIGN_POST_SIZE.X, postHeight, MapConfig.SIGN_POST_SIZE.Z),
				plotCFrame * CFrame.new(px, surfaceY + postHeight * 0.5, archZ),
				MapConfig.SIGN_POST_COLOR,
				Enum.Material.Wood
			)
			post.CanCollide = false
			post.Parent     = plotModel

			local capital = MapParts.newPart(
				"SignCapital",
				Vector3.new(2.6, 0.8, 2.6),
				plotCFrame * CFrame.new(px, surfaceY + postHeight + 0.4, archZ),
				goldColor,
				Enum.Material.Metal
			)
			capital.CanCollide = false
			capital.CanQuery   = false
			capital.CanTouch   = false
			capital.CastShadow = false
			capital.Parent     = plotModel

			-- Warme Honig-Laterne innen an jeder Saeule (direkt mit dem Pfosten verbunden)
			local lantern = MapParts.newPart(
				"SignLantern",
				Vector3.new(1.5, 1.9, 1.5),
				plotCFrame * CFrame.new(side * (pillarX - 1.25), surfaceY + 9.2, archZ),
				Color3.fromRGB(255, 205, 75),
				Enum.Material.Neon
			)
			lantern.Shape      = Enum.PartType.Ball
			lantern.CanCollide = false
			lantern.CanQuery   = false
			lantern.CanTouch   = false
			lantern.CastShadow = false
			lantern.Parent     = plotModel
		end

		-- Unterer Tor-Querbalken (ueber 10 Studs freie Durchgangshoehe)
		local archBeam = MapParts.newPart(
			"SignArchBeam",
			Vector3.new(20.0, 1.1, 2.0),
			plotCFrame * CFrame.new(0, surfaceY + 10.6, archZ),
			MapConfig.SIGN_POST_COLOR,
			Enum.Material.Wood
		)
		archBeam.CanCollide = false
		archBeam.CanQuery   = false
		archBeam.CanTouch   = false
		archBeam.CastShadow = false
		archBeam.Parent     = plotModel

		-- Goldener Giebelbalken oben (SignTrim1) und goldene Einfassung unten (SignTrim2)
		local trimTop = MapParts.newPart(
			"SignTrim1",
			Vector3.new(20.6, 0.9, 2.2),
			plotCFrame * CFrame.new(0, surfaceY + 16.2, archZ),
			goldColor,
			Enum.Material.Metal
		)
		trimTop.CanCollide = false
		trimTop.CanQuery   = false
		trimTop.CanTouch   = false
		trimTop.CastShadow = false
		trimTop.Parent     = plotModel

		local trimBot = MapParts.newPart(
			"SignTrim2",
			Vector3.new(boardSize.X + 0.8, 0.45, boardSize.Z + 0.5),
			plotCFrame * CFrame.new(0, surfaceY + 11.15, archZ),
			goldColor,
			Enum.Material.Metal
		)
		trimBot.CanCollide = false
		trimBot.CanQuery   = false
		trimBot.CanTouch   = false
		trimBot.CastShadow = false
		trimBot.Parent     = plotModel

		-- Goldene Honigwaben-Krone auf dem Torbogen-Scheitel
		local crown = MapParts.newPart(
			"SignCrown",
			Vector3.new(1.0, 3.6, 3.6),
			plotCFrame * CFrame.new(0, surfaceY + 17.5, archZ) * CFrame.Angles(0, math.rad(90), 0),
			goldColor,
			Enum.Material.Metal
		)
		crown.Shape      = Enum.PartType.Cylinder
		crown.CanCollide = false
		crown.CanQuery   = false
		crown.CanTouch   = false
		crown.CastShadow = false
		crown.Parent     = plotModel

		local crownGem = MapParts.newPart(
			"SignCrownGem",
			Vector3.new(1.6, 1.6, 1.5),
			plotCFrame * CFrame.new(0, surfaceY + 17.5, archZ),
			Color3.fromRGB(255, 220, 80),
			Enum.Material.Neon
		)
		crownGem.Shape      = Enum.PartType.Ball
		crownGem.CanCollide = false
		crownGem.CanQuery   = false
		crownGem.CanTouch   = false
		crownGem.CastShadow = false
		crownGem.Parent     = plotModel

		-- Die grosse Namenstafel sitzt nur am vorderen Torbogen (-Z, Richtung Hauptinsel)
		if gate.boardName then
			local boardY = surfaceY + 13.5
			local board = MapParts.newPart(
				gate.boardName,
				boardSize,
				plotCFrame * CFrame.new(0, boardY, archZ),
				MapConfig.SIGN_COLOR,
				Enum.Material.Wood
			)
			board.CanCollide = false
			board.Parent     = plotModel

			-- Die Schrift kommt auf die Vorderseite (-Z) sowie auf die Rueckseite (+Z)
			local surface = Instance.new("SurfaceGui")
			surface.Name          = "SignText"
			surface.Face          = Enum.NormalId.Front
			surface.PixelsPerStud = 45
			surface.Adornee       = board
			surface.Parent        = board

			local label = MapParts.newTextLabel("Owner", surface, UDim2.fromScale(0.92, 0.50), UDim2.fromScale(0.04, 0.06))
			label.TextColor3             = Color3.fromRGB(55, 35, 18)
			label.TextStrokeColor3       = Color3.fromRGB(255, 220, 125)
			label.TextStrokeTransparency = 0.35
			label.Text                   = ownerName

			local divider = Instance.new("Frame")
			divider.Name             = "Divider"
			divider.Size             = UDim2.fromScale(0.76, 0.04)
			divider.Position         = UDim2.fromScale(0.12, 0.58)
			divider.BackgroundColor3 = goldColor
			divider.BorderSizePixel  = 0
			divider.Parent           = surface

			local badge = MapParts.newTextLabel("TowerBadge", surface, UDim2.fromScale(0.92, 0.34), UDim2.fromScale(0.04, 0.63))
			badge.TextStrokeColor3       = Color3.fromRGB(35, 22, 12)
			badge.TextStrokeTransparency = 0.15
			badge.Text                   = ""

			local backSurface = surface:Clone()
			backSurface.Name = "SignTextBack"
			backSurface.Face = Enum.NormalId.Back
			backSurface.Parent = board
		end
	end
end

-- v15: Tower-Symbol unter dem Besitzernamen ("◆ III · 42") am vorderen Torbogen. Billig, nur Text.
function PlotBuilder.writeOwnerBadge(plotModel: Model, text: string | Types.LocMsg, color: Color3)
	local board = plotModel:FindFirstChild("SignBoard")
	if board then
		for _, guiName in { "SignText", "SignTextBack" } do
			local surface = board:FindFirstChild(guiName)
			local badge = surface and surface:FindFirstChild("TowerBadge")
			if badge and badge:IsA("TextLabel") then
				WorldText.set(badge, text)
				badge.TextColor3 = color
			end
		end
	end
end

-- Die Plot-Platte samt Terrassen-Einfassung, Zaun und Torbogen-Schild.
--
-- Das Besitzer-Attribut wird gesetzt BEVOR das Model in den Workspace kommt:
-- der Client bekommt es damit zusammen mit dem Model und muss nicht darauf
-- warten. WorldController haengt daran, ob er ueberhaupt einen Prompt baut.
function PlotBuilder.buildPlotBase(slot: number, owner: Player): Model
	local plotCFrame = MapParts.plotCFrame(slot)

	local model = Instance.new("Model")
	model.Name  = "Plot_" .. slot
	model:SetAttribute("PlotOwner", owner.UserId)

	-- Das Beet: eine quadratische Platte auf der Plot-Insel. Dunkles Gruen wie
	-- die Hauptinsel, darauf dieselben hellen Karos — nur plot-lokal gerastert,
	-- weil das Beet je nach Plot in einem anderen Winkel steht.
	local base = MapParts.newPart(
		"Base",
		MapConfig.PLOT_SIZE,
		plotCFrame * CFrame.new(0, MapConfig.PLOT_SIZE.Y * 0.5, 0),
		MapConfig.GRASS_DARK,
		Enum.Material.Grass
	)
	base.CanCollide = true
	base.Parent     = model

	-- Steinerne Garten-Terrassenkante rund um das 72x72-Beet (vorne und hinten
	-- in der Mitte fuer Steg und Torbogen offen gelassen, damit keine Stufe entsteht).
	local halfX     = MapConfig.PLOT_SIZE.X * 0.5
	local halfZ     = MapConfig.PLOT_SIZE.Z * 0.5
	local curbY     = MapConfig.PLOT_SIZE.Y * 0.5 + 0.06
	local curbH     = MapConfig.PLOT_SIZE.Y + 0.12
	local curbColor = Color3.fromRGB(215, 198, 168)

	for _, side in { -1, 1 } do
		local sideCurb = MapParts.newPart(
			"PlotCurb",
			Vector3.new(1.0, curbH, MapConfig.PLOT_SIZE.Z + 2.0),
			plotCFrame * CFrame.new(side * (halfX + 0.5), curbY, 0),
			curbColor,
			Enum.Material.Cobblestone
		)
		sideCurb.CanCollide = false
		sideCurb.CanQuery   = false
		sideCurb.CanTouch   = false
		sideCurb.CastShadow = false
		sideCurb.Parent     = model

		for _, zSign in { -1, 1 } do
			local endCurb = MapParts.newPart(
				"PlotCurb",
				Vector3.new(27.0, curbH, 1.0),
				plotCFrame * CFrame.new(side * 22.5, curbY, zSign * (halfZ + 0.5)),
				curbColor,
				Enum.Material.Cobblestone
			)
			endCurb.CanCollide = false
			endCurb.CanQuery   = false
			endCurb.CanTouch   = false
			endCurb.CastShadow = false
			endCurb.Parent     = model
		end
	end

	MapParts.buildCheckerPlate(
		model,
		plotCFrame * CFrame.new(0, MapConfig.PLOT_SIZE.Y, 0),
		MapConfig.PLOT_SIZE.X,
		MapConfig.PLOT_SIZE.Z
	)

	model.PrimaryPart = base

	PlotBuilder.buildFence(model, slot)
	PlotBuilder.buildPlotPath(model, slot)
	PlotBuilder.buildPlotSign(model, slot, owner.DisplayName)

	-- Der Spieler spawnt (und respawnt nach dem Tod) auf seiner EIGENEN
	-- Insel statt in der Weltmitte — siehe MapConfig.PLAYER_SPAWN_OFFSET fuer
	-- die Wahl der Stelle. Unsichtbar: sie soll wie ein normaler Fleck Wiese
	-- aussehen, kein Extra-Bodenbelag auf dem Plot.
	--
	-- `owner.RespawnLocation` direkt zu setzen (statt sich auf Roblox' eigene
	-- Naechste-SpawnLocation-Auswahl zu verlassen) ist entscheidend: mit acht
	-- SpawnLocations in der Welt (eine pro Plot) waere sonst nicht garantiert,
	-- dass ein Spieler nach dem Tod bei SEINER eigenen landet.
	--
	-- newPart baut nur ein normales Part — eine SpawnLocation braucht die
	-- eigene Roblox-Klasse (Instance.new("SpawnLocation")), deshalb hier von
	-- Hand statt ueber das gemeinsame Util.
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name          = "PlayerSpawn"
	spawnLocation.Size          = Vector3.new(6, 1, 6)
	spawnLocation.CFrame        = plotCFrame * CFrame.new(
		MapConfig.PLAYER_SPAWN_OFFSET.X,
		MapParts.plotSurfaceOffset() + MapConfig.PLAYER_SPAWN_OFFSET.Y + 0.5,
		MapConfig.PLAYER_SPAWN_OFFSET.Z
	)
	spawnLocation.Anchored      = true
	spawnLocation.CanCollide    = false
	spawnLocation.CanQuery      = false
	spawnLocation.Neutral       = true
	spawnLocation.Transparency  = 1
	spawnLocation.Duration      = 0   -- keine Unverwundbarkeits-Phase, das Spiel kennt kein PvP am Spawn
	spawnLocation.Parent        = model

	owner.RespawnLocation = spawnLocation

	model.Parent = workspace

	return model
end

-- Die Honig-Tropfen am Fuss eines Gebaeudes einmalig anlegen. Sie werden
-- danach nur noch ein- und ausgeblendet (writeBuildingState), nie neu gebaut:
-- ein Neuaufbau alle 20 Sekunden mal drei Gebaeude mal acht Spieler waere
-- fuer reine Deko viel zu teuer.
--
-- `ground` ist die Mitte der Grundflaeche des Gebaeudes, also derselbe
-- Ursprung wie fuer die Deko.
--
-- `slots` ist das GROESSTE Lager, das dieses Gebaeude je haben kann — nicht
-- sein aktuelles —, seit v15 aber hoechstens MapConfig.HONEY_DOT_MAX (das Lager
-- des Bienenstocks waechst bis 39). Ueberzaehlige Tropfen stoeren nicht:
-- sichtbar ist ein Tropfen erst, wenn wirklich Honig drin liegt
-- (writeBuildingState).
function PlotBuilder.buildHoneyDots(body: BasePart, ground: CFrame, slots: number)
	if slots <= 0 then return end

	-- Fester Abstand, bis der maximale Bogen erreicht ist — dann ruecken die
	-- Tropfen zusammen, statt sich um das ganze Gebaeude zu wickeln.
	local arc = math.min(
		math.rad(MapConfig.HONEY_DOT_ARC),
		math.rad(MapConfig.HONEY_DOT_SPACING) * math.max(1, slots - 1)
	)

	for i = 1, slots do
		-- Bogen mittig um -Z herum. Bei nur einem Punkt gibt es nichts zu
		-- verteilen — dann steht er genau vorne.
		local t     = if slots > 1 then (i - 1) / (slots - 1) - 0.5 else 0
		local angle = t * arc

		local offset = Vector3.new(
			math.sin(angle) * MapConfig.HONEY_DOT_RADIUS,
			MapConfig.HONEY_DOT_HEIGHT,
			-math.cos(angle) * MapConfig.HONEY_DOT_RADIUS
		)

		local dot = MapParts.newPart(
			"HoneyDot" .. i,
			Vector3.new(MapConfig.HONEY_DOT_SIZE, MapConfig.HONEY_DOT_SIZE, MapConfig.HONEY_DOT_SIZE),
			ground * CFrame.new(offset),
			MapConfig.HONEY_DOT_COLOR,
			Enum.Material.Neon
		)
		dot.Shape        = Enum.PartType.Ball
		dot.Transparency = 1        -- Startzustand: leeres Lager
		dot.CanCollide   = false
		dot.CanQuery     = false
		dot.CanTouch     = false
		dot.Parent       = body
	end
end

-- Alles am Gebaeude, was sich im Betrieb aendert: Schildtext, Honig-Tropfen
-- und der Vorrats-Wert fuer den Fuetter-Prompt. Getrennt vom Aufbau, weil das
-- bei JEDER Honig-Aenderung laeuft (siehe updateBuildingSigns) und deshalb
-- billig bleiben muss.
function PlotBuilder.writeBuildingState(part: BasePart, buildingData: Types.Building, pool: number)
	local config = MapConfig.BUILDING_OFFSETS[buildingData.id]
	if not config then return end

	-- Attribut statt eigenem Remote: der Client haengt seinen Fuetter-Prompt
	-- daran und bekommt jede Aenderung ohne Zutun mit.
	part:SetAttribute("HoneyPool", pool)

	-- Lager DIESES Gebaeudes auf DIESEM Level — beim Bienenstock waechst es mit.
	local capacity = BuildingBehavior.getCapacity(buildingData.id, buildingData.level)
	local honey    = math.clamp(buildingData.honey or 0, 0, capacity)

	-- Ein Tropfen pro eingelagertem Honig. Es koennen mehr Tropfen dastehen als
	-- das aktuelle Lager fasst (gebaut wird nach dem Maximal-Lager) — die
	-- ueberzaehligen bleiben unsichtbar. v15: ist das Lager groesser als
	-- HONEY_DOT_MAX, steht ein Tropfen fuer einen ANTEIL (voll = alle an).
	local dotCount = math.min(BuildingBehavior.getMaxCapacity(buildingData.id), MapConfig.HONEY_DOT_MAX)
	local lit = if capacity <= MapConfig.HONEY_DOT_MAX
		then honey
		else math.ceil(honey * MapConfig.HONEY_DOT_MAX / math.max(1, capacity))
	for i = 1, dotCount do
		local dot = part:FindFirstChild("HoneyDot" .. i)
		if dot and dot:IsA("BasePart") then
			dot.Transparency = if i <= lit then 0 else 1
		end
	end

	local sign = part:FindFirstChild("Sign")
	if not sign or not sign:IsA("BillboardGui") then return end

	local title = sign:FindFirstChild("Title")
	if title and title:IsA("TextLabel") then
		WorldText.set(title, Loc.msg("ui.world.sign_level", {
			name = Names.msg.building(buildingData.id), level = buildingData.level,
		}))
	end

	local stock = sign:FindFirstChild("Stock")
	if stock and stock:IsA("TextLabel") then
		stock.Text = string.format("🍯 %d / %d", honey, capacity)   -- sprachneutral (2.4)

		-- Volles Lager faellt farblich auf: dann steht die Produktion und es
		-- wird Zeit, zurueckzukommen und zu fuettern.
		stock.TextColor3 = if honey >= capacity
			then Color3.fromRGB(255, 215, 100)
			else Color3.fromRGB(235, 235, 235)
	end
end

-- Ein Gebaeude auf dem Plot.
-- Der Name der Part ist die BuildingId — der Client (WorldController) findet
-- darueber das Gebaeude fuer den ProximityPrompt.
--
-- Die Part selbst ist seit v5 unsichtbar und kollidiert nicht: sie ist nur
-- noch Trefferflaeche fuer den Prompt sowie Traeger von Name, Attribut und
-- Schild. Zu SEHEN und anzustossen ist ausschliesslich die Deko. Getrennt,
-- weil das Anklickbare und das Huebsche zwei verschiedene Dinge sind — sonst
-- muesste jede Formaenderung Ruecksicht auf die Trefferflaeche nehmen.
-- Partikel-Effekte des Looks an die gerade gebauten Deko-Teile haengen
-- (MapConfig.BUILDING_LOOK_FX / FX_PRESETS). Fehlt ein Teil, wird der Effekt
-- still uebersprungen — der Test honey_pond.test.lua faengt das vorher ab.
function PlotBuilder.addLookEffects(body: BasePart, buildingId: string, look: number)
	for _, fx in MapConfig.getLookFx(buildingId, look) do
		local target = body:FindFirstChild(fx.piece)
		local preset = MapConfig.FX_PRESETS[fx.preset]
		if target and target:IsA("BasePart") and preset then
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name          = "Fx_" .. fx.preset
			emitter.Texture       = preset.texture
			emitter.Color         = ColorSequence.new(preset.color)
			emitter.Size          = NumberSequence.new(preset.size[1], preset.size[2])
			emitter.Transparency  = NumberSequence.new(preset.transparency[1], preset.transparency[2])
			emitter.Lifetime      = NumberRange.new(preset.lifetime[1], preset.lifetime[2])
			emitter.Rate          = preset.rate
			emitter.Speed         = NumberRange.new(preset.speed[1], preset.speed[2])
			emitter.SpreadAngle   = Vector2.new(preset.spread, preset.spread)
			emitter.Acceleration  = preset.acceleration
			emitter.EmissionDirection = (Enum.NormalId :: any)[preset.emitFrom]
			emitter.LightEmission = preset.lightEmission
			emitter.Parent        = target
		end
	end
end

function PlotBuilder.buildBuilding(plotModel: Model, slot: number, buildingData: Types.Building, pool: number)
	local config = MapConfig.BUILDING_OFFSETS[buildingData.id]
	if not config then return end

	local plotCFrame = MapParts.plotCFrame(slot)
	local localY = MapParts.plotSurfaceOffset() + config.offset.Y + config.size.Y * 0.5

	local part = MapParts.newPart(
		buildingData.id,
		config.size,
		plotCFrame * CFrame.new(config.offset.X, localY, config.offset.Z),
		config.color,
		Enum.Material.SmoothPlastic
	)
	part.Transparency = 1
	part.CanCollide   = false
	part.Parent       = plotModel

	-- Ursprung von Deko UND Honig-Tropfen: Mitte der Grundflaeche des Gebaeudes
	-- auf Plot-Hoehe.
	local ground = plotCFrame * CFrame.new(
		config.offset.X,
		MapParts.plotSurfaceOffset() + config.offset.Y,
		config.offset.Z
	)

	-- v15: Grund-Deko plus die Zusaetze des aktuellen Looks.
	local look  = BuildingBehavior.getLook(buildingData.level)
	local decor = MapConfig.getBuildingDecor(buildingData.id, look)
	-- NEW_MODELS_V3: der Honig-Brunnen kommt als Modell aus PondBuilder
	-- (Assets.Fountains); die alte Teile-Deko wuerde ihn ueberlagern.
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local fountainModel = buildingData.id == "HoneyPond"
		and require(ReplicatedStorage.Config.FeatureFlags).isOn("NEW_MODELS_V3")
		and assets ~= nil and assets:FindFirstChild("Fountains") ~= nil
	if not fountainModel then
		MapParts.buildDecor(part, ground, decor)
		PlotBuilder.addLookEffects(part, buildingData.id, look)

		PlotBuilder.buildHoneyDots(part, ground,
			math.min(BuildingBehavior.getMaxCapacity(buildingData.id), MapConfig.HONEY_DOT_MAX))
	end

	-- Level als Attribut: der Client kann es direkt auslesen ohne eigenes Remote
	part:SetAttribute("BuildingLevel", buildingData.level)
	part:SetAttribute("Look", look)

	-- Schild ueber dem Gebaeude: Name, Level und Honig-Lagerstand. Ohne das
	-- muesste man fuer die Frage "ist schon wieder Honig da?" jedes Mal ein
	-- Panel oeffnen.
	--
	-- Die Hoehe richtet sich nach dem hoechsten Deko-Teil, nicht nach der
	-- Koerpergroesse: sonst haengt das Schild nach jeder Formaenderung falsch.
	-- StudsOffset zaehlt ab der MITTE der Part, deshalb die Halbierung.
	local topOfDecor = math.max(MapParts.decorHeight(decor), config.size.Y)

	-- Sammel-Update 2.6 ("UI von Honig-Sumpf weg"): der Honig-Teich bekommt
	-- kein Schild — der Baerchi isst dort von selbst (Autopilot), Text und
	-- Zahlen braucht dort niemand. writeBuildingState kommt ohne Schild aus.
	if buildingData.id == "HoneyPond" then
		PlotBuilder.writeBuildingState(part, buildingData, pool)
		return
	end

	local sign = Instance.new("BillboardGui")
	sign.Name         = "Sign"
	sign.Size         = UDim2.fromScale(9, 2.6)
	sign.StudsOffset  = Vector3.new(0, topOfDecor - config.size.Y * 0.5 + 2, 0)
	sign.AlwaysOnTop  = false
	sign.MaxDistance  = MapConfig.BUILDING_SIGN_DISTANCE
	sign.Adornee      = part
	sign.Parent       = part

	MapParts.newTextLabel("Title", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0))
	MapParts.newTextLabel("Stock", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0.5))

	PlotBuilder.writeBuildingState(part, buildingData, pool)
end

return PlotBuilder
]]></ProtectedString>
							<string name="ScriptGuid">{AA13CA08-D1F1-496A-8A82-FA90AD198F4C}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">PlotBuilder</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX4A76DFF21FB342C0A8B3B42753A118D8">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- PondBuilder.luau
-- ServerScriptService/Util/MapBuild/PondBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Den Honig-Teich eines Plots bauen und seinen Fuellstand anzeigen
--
-- Der Fuellstand ist der gelagerte Honig aller Gebaeude (honeyPool). Der
-- ausgeruestete Baerchi isst am Steg (pondStand).
--
-- Teil von MapService: nur MapService (und die Builder untereinander)
-- benutzen dieses Modul. Es aendert keine Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local MapConfig        = require(ReplicatedStorage.Config.MapConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types            = require(ReplicatedStorage.Network.Types)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)
local EconomyConfig = require(ReplicatedStorage.Config.EconomyConfig)
local MapLayout = require(ReplicatedStorage.Modules.MapLayout)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)

local PondBuilder = {}

-- Der gesamte Honig-Vorrat einer Insel.
--
-- Wird als Attribut an JEDES Gebaeude geschrieben, nicht nur der eigene
-- Bestand: gefuettert wird auf der Baerchi-Detailkarte, und dort stehen alle
-- drei Vorraete nebeneinander zur Wahl. Wer vor dem Bienenstock steht, soll
-- deshalb sehen, dass ueberhaupt noch Honig da ist — auch wenn er im Honigtopf
-- nebenan liegt.
function PondBuilder.honeyPool(islandData: Types.IslandData): number
	local total = 0
	for _, building in islandData.buildings do
		total += math.max(0, building.honey or 0)
	end
	return total
end

-- Wie voll der Teich angezeigt wird: Anteil des GESAMTEN Honig-Vorrats an der
-- Lagermenge, die diese Insel auf ihren AKTUELLEN Leveln fasst.
--
-- Bewusst die aktuelle und nicht die theoretisch maximale Menge: der
-- Bienenstock vergroessert sein Lager mit jedem Level, und ein Teich, der nach
-- einem Ausbau ploetzlich leerer aussieht, waere die falsche Rueckmeldung.
-- So heisst "voller Teich" immer dasselbe — alle Lager sind voll.
function PondBuilder.pondFillRatio(islandData: Types.IslandData): number
	local capacity = BuildingBehavior.getTotalCapacity(islandData.buildings)
	if capacity <= 0 then return 0 end
	return math.clamp(PondBuilder.honeyPool(islandData) / capacity, 0, 1)
end

-- Der Boden-Ursprung des Teichs fuer einen Plot.
--
-- Mitte des Beckens auf Beet-Hoehe — dieselbe Rolle wie `ground` bei den
-- Gebaeuden, aber zusaetzlich GEDREHT: das lokale -Z zeigt zum Baerchi-Platz,
-- also dorthin, wo der Baerchi herkommt und beim Fressen steht. Genau
-- dieselbe Regel wie beim Plot-CFrame ("-Z zeigt dorthin, wo man herkommt"),
-- und der Grund, warum die Offsets in MapConfig.POND_DECOR ohne einen einzigen
-- Winkel auskommen.
--
-- Faellt die Richtung weg (Teich exakt auf dem Baerchi-Platz — kann nur durch
-- eine kaputte Config passieren), bleibt die Plot-Ausrichtung stehen: lieber
-- ein Teich, der in die falsche Richtung schaut, als gar keiner.
function PondBuilder.pondGround(slot: number): CFrame
	local plotCFrame = MapParts.plotCFrame(slot)

	-- Lage und Richtung aus MapLayout (HONEY_POND_V2: Teich in der Plot-Mitte
	-- hinten, Standplatz nach +Z; sonst wie bisher zum Baerchi-Platz).
	local offset = MapLayout.pondOffset()
	local center = CFrame.new(offset.X, MapParts.plotSurfaceOffset() + offset.Y, offset.Z)
	local toHome = MapLayout.pondFacing()

	-- CFrame.lookAt richtet -Z auf das Ziel aus (siehe buildPlotCFrame).
	local facing = CFrame.lookAt(center.Position, center.Position + toHome)
	return plotCFrame * facing
end

-- Der Standplatz vor dem Becken: teich-lokal auf -Z, um Beckenrand plus
-- Abstand von der Mitte entfernt. Hier landet der Baerchi, hier liegen die
-- Bohlen, und genau hier hat der Steinkranz seine Luecke.
function PondBuilder.pondStandDistance(): number
	return MapLayout.pondStandDistance()
end

function PondBuilder.pondStand(slot: number): CFrame
	return PondBuilder.pondGround(slot) * CFrame.new(0, 0, -PondBuilder.pondStandDistance())
end

-- Setzt die Fuellhoehe der "Fuellung"-Part auf den aktuellen Vorrat. Getrennt
-- vom Aufbau, weil das bei jeder Honig-Aenderung laeuft (siehe
-- updateBuildingSigns) und deshalb billig bleiben muss — kein Neuaufbau.
--
-- `ground` ist derselbe Ursprung wie beim Aufbau: die Fuellung waechst von
-- dort nach oben, statt ueber die WELT-Position herumzurechnen (die haengt
-- vom Plot-Winkel ab und ist dafuer ungeeignet).
function PondBuilder.writePondFill(fill: BasePart, ground: CFrame, ratio: number)
	-- Breiter UND hoeher (siehe MapConfig): nur hoeher waere aus der
	-- Spielerkamera kaum abzulesen, nur breiter saehe aus wie ein Aufkleber.
	local maxRadius = MapConfig.POND_RADIUS - MapConfig.POND_FILL_INSET
	local scale     = MapConfig.POND_FILL_MIN_SCALE
		+ (1 - MapConfig.POND_FILL_MIN_SCALE) * math.clamp(ratio, 0, 1)

	local radius = maxRadius * scale
	local height = MapConfig.POND_FILL_MIN_HEIGHT
		+ (MapConfig.POND_FILL_MAX_HEIGHT - MapConfig.POND_FILL_MIN_HEIGHT) * math.clamp(ratio, 0, 1)

	-- Der Honig steht AUF dem Beckenboden, nicht auf dem Beet.
	fill.CFrame = ground
		* CFrame.new(0, MapConfig.POND_FLOOR_TOP + height * 0.5, 0)
		* CFrame.Angles(0, 0, math.rad(90))
	fill.Size   = Vector3.new(height, radius * 2, radius * 2)

	fill.Transparency = if ratio <= 0 then 1 else MapConfig.POND_FILL_TRANSPARENCY
end

-- NEW_MODELS_V3: Honig-Brunnen aus ReplicatedStorage.Assets.Fountains
-- (Fountain_Stage0..4, eine Stufe pro Look des Gebaeudes HoneyPond). Die
-- Vorlagen liegen auf Y = 1000, der Steg zeigt in der Vorlage nach -X; hier
-- wird der Beckenboden auf `ground` gesetzt und der Steg nach -Z gedreht
-- (dorthin, wo der Baerchi steht, siehe MapService.getPondPosition).
local FOUNTAIN_STAGES = 5
-- Groesse: so passt der Steg zu MapService.getPondPosition (6.3 Studs von der
-- Mitte, ~1.5 hoch) und der Brunnen steht gleichwertig neben dem Inkubator.
local FOUNTAIN_SCALE = 1.4
-- Ausbau macht den Brunnen groesser: bis +25 % auf Level 60 (waechst vom
-- Beckenboden aus, siehe growFountain).
local FOUNTAIN_GROWTH = 0.25

function PondBuilder.fountainScale(level: number): number
	local max = EconomyConfig.MAX_BUILDING_LEVEL
	local progress = (math.clamp(level, 1, max) - 1) / (max - 1)
	return FOUNTAIN_SCALE * (1 + FOUNTAIN_GROWTH * progress)
end

-- Billig: nur skalieren, kein Neuaufbau. Aufruf bei jedem Ausbau (MapService.updatePondFill).
function PondBuilder.growFountain(plotModel: Model, level: number)
	local pond = plotModel:FindFirstChild("Pond")
	local fountain = pond and pond:FindFirstChild("Fountain")
	if fountain and fountain:IsA("Model") then
		local target = PondBuilder.fountainScale(level)
		if math.abs(fountain:GetScale() - target) > 0.001 then
			fountain:ScaleTo(target)
		end
	end
end

-- Faktor fuer den Standplatz am Steg (MapService.getPondPosition rechnet mit
-- Groesse FOUNTAIN_SCALE): der Steg wandert mit dem Wachstum nach aussen.
function PondBuilder.standFactor(plotModel: Model?): number
	local pond = plotModel and plotModel:FindFirstChild("Pond")
	local fountain = pond and pond:FindFirstChild("Fountain")
	if fountain and fountain:IsA("Model") then
		return fountain:GetScale() / FOUNTAIN_SCALE
	end
	return 1
end

function PondBuilder.fountainFolder(): Instance?
	if not FeatureFlags.isOn("NEW_MODELS_V3") then return nil end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	return assets and assets:FindFirstChild("Fountains")
end

function PondBuilder.buildFountain(parent: Instance, ground: CFrame, islandData: Types.IslandData): Model?
	local folder = PondBuilder.fountainFolder()
	if not folder then return nil end

	local building = islandData.buildings["HoneyPond" :: any]
	local look = BuildingBehavior.getLook(if building then building.level else 1)
	local stage = math.clamp(look - 1, 0, FOUNTAIN_STAGES - 1)
	local template = folder:FindFirstChild("Fountain_Stage" .. stage)
	if not template or not template:IsA("Model") then return nil end

	local model = template:Clone()
	model.Name = "Fountain"

	-- Ursprung: Mitte und Unterkante des Beckenbodens der Vorlage
	local origin = Vector3.new(0, 1000, 0)
	local floor = model:FindFirstChild("Basin_Floor_Node")
	if floor and floor:IsA("Model") then
		local cf, size = floor:GetBoundingBox()
		origin = Vector3.new(cf.Position.X, cf.Position.Y - size.Y * 0.5, cf.Position.Z)
	end

	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored   = true
			d.CanCollide = false
			d.CanTouch   = false
			d.CanQuery   = false
		end
	end

	-- Pivot an den Beckenboden: Skalieren (auch spaeter beim Ausbau) wirkt von dort aus
	model.WorldPivot = CFrame.new(origin)
	model:ScaleTo(PondBuilder.fountainScale(if building then building.level else 1))
	model:PivotTo(ground * CFrame.Angles(0, math.rad(-90), 0))
	model.Parent = parent
	return model
end

-- Eine der beiden flachen Scheiben des Beckens (Sandkante bzw. Beckenboden).
-- Beide sind dicker als der sichtbare Teil; der Rest steckt im Beet, damit
-- unten nichts durchscheint.
function PondBuilder.buildPondDisc(parent: Instance, ground: CFrame, name: string, radius: number, top: number, color: Color3, material: Enum.Material)
	local disc = MapParts.newPart(
		name,
		Vector3.new(MapConfig.POND_DISC_HEIGHT, radius * 2, radius * 2),
		ground * CFrame.new(0, top - MapConfig.POND_DISC_HEIGHT * 0.5, 0)
			* CFrame.Angles(0, 0, math.rad(90)),
		color,
		material
	)
	disc.Shape      = Enum.PartType.Cylinder
	disc.CanCollide = true
	disc.CanQuery   = false
	disc.Parent     = parent
end

-- Der Steinkranz: die Beckenwand.
--
-- Er laesst auf der Seite zum Baerchi-Platz eine Luecke frei — dieselbe Idee
-- wie beim Zaun um die Arena, und aus demselben Grund: durch eine Wand kommt
-- man nicht. Groessen und Farben wechseln reihum durch, damit es nach
-- gesammelten Feldsteinen aussieht und nicht nach einer Perlenkette.
function PondBuilder.buildPondStones(parent: Instance, ground: CFrame)
	local ringRadius = MapConfig.POND_RADIUS + MapConfig.POND_RIM_WIDTH * 0.5
	local gap        = math.rad(MapConfig.POND_STONE_GAP_DEGREES)

	-- Die Steine stehen bei (sin a, cos a): a = 0 ist teich-lokales +Z,
	-- a = pi ist -Z. Die Luecke liegt also bei pi.
	local gapAngle = math.pi

	for i = 1, MapConfig.POND_STONE_COUNT do
		local angle = (i - 1) * (2 * math.pi / MapConfig.POND_STONE_COUNT)

		-- Winkelabstand zur Luecke, immer als kuerzester Weg gemessen.
		local delta = math.abs(((angle - gapAngle + math.pi) % (2 * math.pi)) - math.pi)

		if delta > gap then
			local size  = MapConfig.POND_STONE_SIZES[((i - 1) % #MapConfig.POND_STONE_SIZES) + 1]
			local color = MapConfig.POND_STONE_COLORS[((i - 1) % #MapConfig.POND_STONE_COLORS) + 1]

			-- Etwas eingegraben: die Steine sollen im Sand liegen und nicht
			-- auf dem Boden balancieren. Sie sind leicht gestaucht, damit sie
			-- nach Feldsteinen aussehen und nicht nach Murmeln.
			local stone = MapParts.newPart(
				"Stein_" .. i,
				Vector3.new(size, size * 0.82, size),
				ground * CFrame.new(
					math.sin(angle) * ringRadius,
					MapConfig.POND_RIM_TOP + size * 0.30,
					math.cos(angle) * ringRadius
				),
				color,
				Enum.Material.Slate
			)
			stone.Shape      = Enum.PartType.Ball
			stone.CanCollide = true
			stone.CanQuery   = false
			stone.Parent     = parent
		end
	end
end

-- Die zwei Bohlen vor der Luecke, auf denen der Baerchi beim Fressen steht,
-- plus zwei Pfloecke daneben. Sie liegen um den Standplatz herum, den auch
-- MapService.getPondPosition zurueckgibt — eine Rechnung, kein zweiter Satz
-- Zahlen (siehe MapConfig.POND_STAND_GAP).
function PondBuilder.buildPondPlanks(parent: Instance, ground: CFrame)
	local stand = PondBuilder.pondStandDistance()
	local step: number = (MapConfig.POND_PLANK_SIZE.Z + MapConfig.POND_PLANK_GAP) * 0.5
	local y: number    = MapConfig.POND_PLANK_TOP - MapConfig.POND_PLANK_SIZE.Y * 0.5

	for i, offset in { -step, step } do
		local plank = MapParts.newPart(
			"Bohle_" .. i,
			MapConfig.POND_PLANK_SIZE,
			ground * CFrame.new(0, y, -stand + offset),
			MapConfig.POND_PLANK_COLORS[((i - 1) % #MapConfig.POND_PLANK_COLORS) + 1],
			Enum.Material.WoodPlanks
		)
		plank.CanCollide = false
		plank.CanQuery   = false
		plank.Parent     = parent
	end

	-- Pfloecke: kleine Pfosten an beiden Bohlen-Enden. CFrame.Angles(0, 0, 90)
	-- stellt den Zylinder AUFRECHT (seine Laenge ist Size.X) — deshalb muss
	-- auch die Hoehe aus Size.X kommen. 08.10.: vorher stand hier
	-- Size.Y * 0.4 (der Durchmesser), der Pfosten steckte 0.49 im Beet.
	for i, side in { -1, 1 } do
		local peg = MapParts.newPart(
			"Pflock_" .. i,
			MapConfig.POND_PEG_SIZE,
			ground * CFrame.new(side * MapConfig.POND_PEG_SPREAD, MapConfig.POND_PEG_SIZE.X * MapConfig.POND_PEG_LIFT, -stand)
				* CFrame.Angles(0, 0, math.rad(90)),
			MapConfig.POND_PLANK_COLORS[2],
			Enum.Material.Wood
		)
		peg.Shape      = Enum.PartType.Cylinder
		peg.CanCollide = false
		peg.CanQuery   = false
		peg.Parent     = parent
	end
end

-- Der Honig-Teich auf dem Plot: Sandkante, Steinkranz, abgesenkter Beckenboden
-- und darauf der Honig, dessen Flaeche und Hoehe den Gesamt-Vorrat zeigen. Der
-- ausgeruestete Baerchi laeuft zu den Bohlen davor, um zu essen (siehe
-- BaerchiAutopilotService).
function PondBuilder.buildPond(plotModel: Model, slot: number, islandData: Types.IslandData)
	local old = plotModel:FindFirstChild("Pond")
	if old then old:Destroy() end

	local ground = PondBuilder.pondGround(slot)

	local pond = Instance.new("Model")
	pond.Name   = "Pond"
	pond.Parent = plotModel

	-- Brunnen-Modell statt Scheiben/Steinkranz/Bohlen (NEW_MODELS_V3)
	if PondBuilder.buildFountain(pond, ground, islandData) then
		return
	end

	-- Sandkante zuerst und TIEFER als der Beckenboden: nur so bleibt sie
	-- ringsum als Streifen sichtbar, ohne dass ein Ring aus Einzelteilen
	-- noetig waere — derselbe Trick wie am Ufer jeder Insel.
	PondBuilder.buildPondDisc(
		pond, ground, "Rand",
		MapConfig.POND_RADIUS + MapConfig.POND_RIM_WIDTH,
		MapConfig.POND_RIM_TOP,
		MapConfig.POND_RIM_COLOR,
		Enum.Material.Sand
	)
	PondBuilder.buildPondDisc(
		pond, ground, "Boden",
		MapConfig.POND_RADIUS,
		MapConfig.POND_FLOOR_TOP,
		MapConfig.POND_FLOOR_COLOR,
		Enum.Material.Slate
	)

	PondBuilder.buildPondStones(pond, ground)
	PondBuilder.buildPondPlanks(pond, ground)
	-- Mit HONEY_POND_V2 schmueckt der Brunnen (Gebaeude HoneyPond) das
	-- Becken; der Honigloeffel wuerde in seine Schale ragen.
	if not FeatureFlags.isOn("HONEY_POND_V2") then
		MapParts.buildDecor(pond, ground, MapConfig.POND_DECOR)
	end

	-- Als Platzhalter-Groesse angelegt — writePondFill setzt Groesse und
	-- Position gleich im Anschluss auf den echten Vorrat.
	local fill = MapParts.newPart(
		"Fuellung",
		Vector3.new(0.05, MapConfig.POND_RADIUS, MapConfig.POND_RADIUS),
		ground,
		MapConfig.POND_FILL_COLOR,
		Enum.Material.Neon
	)
	fill.Shape      = Enum.PartType.Cylinder
	fill.CanCollide = false
	fill.CanQuery   = false
	fill.CanTouch   = false
	fill.Parent     = pond

	-- Sanftes goldenes Bienen-/Honig-Schwirren ueber dem Becken (schon ab Level 1),
	-- damit der Teich vom ersten Moment an lebendig wirkt.
	local beeEmitter = Instance.new("ParticleEmitter")
	beeEmitter.Name          = "PondBees"
	beeEmitter.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
	beeEmitter.Color         = ColorSequence.new(Color3.fromRGB(255, 225, 110), Color3.fromRGB(255, 175, 40))
	beeEmitter.Size          = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(0.5, 0.55),
		NumberSequenceKeypoint.new(1, 0),
	})
	beeEmitter.Transparency  = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(0.8, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	beeEmitter.Lifetime      = NumberRange.new(1.6, 2.6)
	beeEmitter.Rate          = 5
	beeEmitter.Speed         = NumberRange.new(1.2, 2.4)
	beeEmitter.SpreadAngle   = Vector2.new(160, 160)
	beeEmitter.Acceleration  = Vector3.new(0, 0.6, 0)
	beeEmitter.EmissionDirection = Enum.NormalId.Right
	beeEmitter.LightEmission = 0.85
	beeEmitter.Parent        = fill

	PondBuilder.writePondFill(fill, ground, PondBuilder.pondFillRatio(islandData))
end

return PondBuilder
]]></ProtectedString>
							<string name="ScriptGuid">{6CF380B7-56D4-4F1E-8DC5-2E3ABA42F2AF}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">PondBuilder</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX2D0271F6100E4C42ABC498DC355A86E1">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- RecyclerBuilder.luau
-- ServerScriptService/Util/MapBuild/RecyclerBuilder.luau
--
-- Einzige Zustaendigkeit:
--   - Den Waben-Recycler auf dem Plot bauen und sein Schild/seine Lampe
--     beschriften.
--
-- Wie ein Gebaeude (siehe PlotBuilder.buildBuilding): ein unsichtbarer Koerper,
-- der Name, Attribute und Schild traegt, plus die deklarative Deko aus
-- CombConfig.RECYCLER_DECOR und (v15) den Zusaetzen seines Looks
-- (CombConfig.getDecor). Der Look steht als Attribut "Look" am Koerper. Der Koerper heisst "Recycler"; der Client
-- (CombController) haengt daran den Ausbau-Prompt, aber nur am eigenen Plot.
--
-- Teil von MapService: nur MapService benutzt dieses Modul. Es aendert keine
-- Spielerdaten.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local CombConfig = require(ReplicatedStorage.Config.CombConfig)
local FeatureFlags = require(ReplicatedStorage.Config.FeatureFlags)
local MapConfig  = require(ReplicatedStorage.Config.MapConfig)
local BuildingBehavior = require(ReplicatedStorage.Config.BuildingBehavior)
local Types      = require(ReplicatedStorage.Network.Types)
local Loc       = require(ReplicatedStorage.Localization.Loc)
local WorldText = require(ReplicatedStorage.Localization.WorldText)

local MapParts = require(ServerScriptService.Util.MapBuild.MapParts)

local RecyclerBuilder = {}

-- Die Insel-Wiese liegt auf PLATFORM_TOP_Y, also auf dem Plot-Ursprung — NICHT
-- auf der Beet-Hoehe (die ist PLOT_SIZE.Y darueber). Der Recycler steht auf dem
-- Gras vor dem Beet, deshalb Boden = Ursprung plus die Karo-Hoehe, damit nichts
-- in den hellen Feldern versinkt.
local function groundOffset(): number
	return MapConfig.GRASS_HEIGHT
end

-- Schreibt Level, Warteschlange und Lampe. Billig; laeuft bei jeder Aenderung
-- der Warteschlange (einmal pro Sekunde, solange gearbeitet wird).
-- Groesse des Recycler-Modells: Grundfaktor plus Wachstum mit dem Ausbau
-- (bis +25 % auf Level 60). Das Modell hat seinen Pivot am Boden, es waechst
-- also nach oben und zur Seite.
local RECYCLER_BASE_SCALE = 1.4
local RECYCLER_GROWTH     = 0.25

function RecyclerBuilder.modelScale(level: number): number
	local max = CombConfig.RECYCLER_MAX_LEVEL
	local progress = (math.clamp(level, 1, max) - 1) / math.max(1, max - 1)
	return RECYCLER_BASE_SCALE * (1 + RECYCLER_GROWTH * progress)
end

local function fitModel(body: BasePart, level: number)
	local mesh = body:FindFirstChild("RecyclerModel")
	if not mesh or not mesh:IsA("Model") then return end
	local target = RecyclerBuilder.modelScale(level)
	if math.abs(mesh:GetScale() - target) < 0.001 then return end
	mesh:ScaleTo(target)
	local sign = body:FindFirstChild("Sign")
	if sign and sign:IsA("BillboardGui") then
		local height = select(2, mesh:GetBoundingBox()).Y
		sign.StudsOffset = Vector3.new(0, height - body.Size.Y * 0.5 + 2, 0)
	end
end

function RecyclerBuilder.writeState(body: BasePart, recycler: Types.RecyclerData)
	-- Attribute: der Client rechnet daraus Prompt-Text und Kosten selbst.
	body:SetAttribute("RecyclerLevel", recycler.level)
	fitModel(body, recycler.level)
	body:SetAttribute("RecyclerQueued", recycler.queued)

	local lamp = body:FindFirstChild("Lampe")
	if lamp and lamp:IsA("BasePart") then
		lamp.Color = if recycler.queued > 0 then CombConfig.LAMP_ACTIVE_COLOR else CombConfig.LAMP_IDLE_COLOR
	end

	local sign = body:FindFirstChild("Sign")
	if not sign or not sign:IsA("BillboardGui") then return end

	-- 12.10. (Playtest): das Schild zeigt IMMER nur den Geld-Multiplikator
	-- ("×12", sprachneutral) — sonst nichts. Ausgezahlt wird sofort, eine
	-- Warteschlange gibt es nicht mehr (CombConfig.INSTANT_PAYOUT).
	local title = sign:FindFirstChild("Title")
	local stock = sign:FindFirstChild("Stock")
	if CombConfig.INSTANT_PAYOUT then
		if title and title:IsA("TextLabel") then
			WorldText.set(title, CombConfig.formatMultiplier(recycler.level))
			title.TextColor3 = CombConfig.LAMP_ACTIVE_COLOR
			title.Size = UDim2.fromScale(1, 1)   -- die ganze Schildflaeche
		end
		if stock and stock:IsA("TextLabel") then
			stock.Visible = false
		end
		return
	end

	if title and title:IsA("TextLabel") then
		WorldText.set(title, Loc.msg("ui.world.sign_level", {
			name = Loc.msg("ui.recycler.name"), level = recycler.level,
		}))
	end

	if stock and stock:IsA("TextLabel") then
		if recycler.queued > 0 then
			stock.Text = string.format("⬡ %d", recycler.queued)   -- sprachneutral (2.4)
			stock.TextColor3 = CombConfig.LAMP_ACTIVE_COLOR
		else
			-- Sammel-Update 3.6: sprachneutral "⬡ = 12 G" (eine Wabe bringt so viel)
			stock.Text = string.format("⬡ = %d G", CombConfig.getPayPerUnit(recycler.level))
			stock.TextColor3 = Color3.fromRGB(235, 235, 235)
		end
	end
end

-- Baut den Recycler in das Plot-Model.
function RecyclerBuilder.build(plotModel: Model, slot: number, recycler: Types.RecyclerData)
	local plotCFrame = MapParts.plotCFrame(slot)
	local offset = CombConfig.RECYCLER_OFFSET
	local size   = CombConfig.RECYCLER_BODY_SIZE

	local ground = plotCFrame * CFrame.new(offset.X, groundOffset() + offset.Y, offset.Z)

	local body = MapParts.newPart(
		CombConfig.RECYCLER_NAME,
		size,
		ground * CFrame.new(0, size.Y * 0.5, 0),
		Color3.fromRGB(84, 178, 96),
		Enum.Material.SmoothPlastic
	)
	body.Transparency = 1
	body.CanCollide   = false
	body.Parent       = plotModel

	local look  = BuildingBehavior.getLook(recycler.level)
	local decor = CombConfig.getDecor(look)
	-- NEW_MODELS_V3: Mesh-Recycler aus ReplicatedStorage.Assets.Recyclers
	-- (Look 1..6 -> Stage 0..4). Haengt unter dem Koerper, wird mit ihm
	-- zerstoert; Aus oder Vorlage fehlt = alte Deko aus CombConfig.
	local newTop: number? = nil
	if FeatureFlags.isOn("NEW_MODELS_V3") then
		local assets = ReplicatedStorage:FindFirstChild("Assets")
		local folder = assets and assets:FindFirstChild("Recyclers")
		local tpl = folder and folder:FindFirstChild("Recycler_Stage" .. math.clamp(look - 1, 0, 4))
		if tpl and tpl:IsA("Model") then
			local mesh = tpl:Clone()
			mesh.Name = "RecyclerModel"
			mesh:ScaleTo(RecyclerBuilder.modelScale(recycler.level))
			mesh:PivotTo(ground)
			mesh.Parent = body
			newTop = select(2, mesh:GetBoundingBox()).Y
		end
	end
	if not newTop then
		MapParts.buildDecor(body, ground, decor)
	end
	body:SetAttribute("Look", look)

	-- Schild ueber dem Trichter, auf die Hoehe der hoechsten Deko gesetzt (wie
	-- bei den Gebaeuden: so haengt es nach einer Formaenderung nicht falsch).
	local top = newTop or math.max(MapParts.decorHeight(decor), size.Y)

	local sign = Instance.new("BillboardGui")
	sign.Name        = "Sign"
	sign.Size        = UDim2.fromScale(9, 2.6)
	sign.StudsOffset = Vector3.new(0, top - size.Y * 0.5 + 2, 0)
	sign.AlwaysOnTop = true
	sign.MaxDistance = MapConfig.BUILDING_SIGN_DISTANCE
	sign.Adornee     = body
	sign.Parent      = body

	MapParts.newTextLabel("Title", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0))
	MapParts.newTextLabel("Stock", sign, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0.5))

	RecyclerBuilder.writeState(body, recycler)
end

return RecyclerBuilder
]]></ProtectedString>
							<string name="ScriptGuid">{5A3DCC74-2B2C-47E8-A3F9-ED1B39FCC30C}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">RecyclerBuilder</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
