						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXF09BD4D8DFF6480B8027983EBA3BC867">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- IncubatorController.luau
-- StarterPlayerScripts/Controllers/IncubatorController.luau
--
-- Einzige Zustaendigkeit:
--   - Den Solo-Inkubator auf dem EIGENEN Plot lebendig machen (15.10.2026):
--     Prompt am Stumpf (oeffnet das Fenster) und ein Schild ueber der Kuppel
--     mit Name und Chancen des Baerchis, Zeit bis zum naechsten Ei und dem
--     Fuellstand des Lagers ("5 / 12").
--
-- Rein clientseitig aus den Attributen der Kuppel (BreederUid, LastEggAt,
-- BreedSeconds, Stored, Capacity, siehe IncubatorBuilder) — Zeitmarken-
-- Prinzip wie EggTimerController: kein Server-Takt, kein Remote. "Jetzt" ist
-- workspace:GetServerTimeNow() (die Marken sind os.time() des Servers).

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local Loc             = require(ReplicatedStorage.Localization.Loc)
local Names           = require(ReplicatedStorage.Localization.Names)
local FeatureFlags    = require(ReplicatedStorage.Config.FeatureFlags)
local IncubatorConfig = require(ReplicatedStorage.Config.IncubatorConfig)
local BaerchiConfig   = require(ReplicatedStorage.Config.BaerchiConfig)
local EggCalculator   = require(ReplicatedStorage.Modules.EggCalculator)

local PanelManager = require(script.Parent.Parent.UI.PanelManager)
local ClientState  = require(script.Parent.ClientState)

local IncubatorController = {}

local OWNER_ATTRIBUTE = "PlotOwner"
local TICK_SECONDS    = 0.5
local OK_COLOR        = Color3.fromRGB(120, 230, 140)
local FULL_COLOR      = Color3.fromRGB(255, 220, 90)
local MAX_ODDS_LINES  = 3

type DomeView = {
	dome: BasePart, gui: BillboardGui,
	title: TextLabel, odds: TextLabel, timer: TextLabel, stored: TextLabel,
	key: string,
}
local _views: { [BasePart]: DomeView } = {}

local function isOwnPlot(instance: Instance): boolean
	local current: Instance? = instance
	while current do
		local owner = current:GetAttribute(OWNER_ATTRIBUTE)
		if typeof(owner) == "number" then
			return owner == Players.LocalPlayer.UserId
		end
		current = current.Parent
	end
	return false
end

local function label(parent: Instance, name: string, y: number, h: number, color: Color3): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.Position = UDim2.fromScale(0, y)
	l.Size = UDim2.fromScale(1, h)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.2
	l.Text = ""
	l.Parent = parent
	return l
end

local function attachView(dome: BasePart)
	if _views[dome] then return end
	local gui = Instance.new("BillboardGui")
	gui.Name        = "IncubatorInfo"
	gui.Size        = UDim2.fromScale(8, 5.6)
	gui.StudsOffset = Vector3.new(0, dome.Size.Y * 0.5 + 4.2, 0)   -- ueber den Ohren
	gui.MaxDistance = IncubatorConfig.LOOK.signDistance
	gui.AlwaysOnTop = true
	gui.Adornee     = dome
	gui.Parent      = dome

	local title  = label(gui, "Title", 0, 0.2, Color3.new(1, 1, 1))
	local odds   = label(gui, "Odds", 0.2, 0.42, Color3.fromRGB(255, 240, 200))
	odds.TextYAlignment = Enum.TextYAlignment.Top
	local timer  = label(gui, "Timer", 0.63, 0.17, OK_COLOR)
	local stored = label(gui, "Stored", 0.82, 0.18, Color3.new(1, 1, 1))
	_views[dome] = { dome = dome, gui = gui, title = title, odds = odds, timer = timer, stored = stored, key = "" }
end

-- Chancen dieses Baerchis, nach dem tatsaechlich gebrueteten Ei zusammengefasst
-- (gesperrte Eier rutschen auf den freien Vorgaenger, wie auf dem Server).
local function oddsText(baerchi: any, eggTree: any): string
	local lines: { string } = {}
	for i, entry in EggCalculator.getResolvedChances(baerchi, eggTree) do
		if i > MAX_ODDS_LINES then break end
		local percent = if entry.percent >= 10 then string.format("%d", math.floor(entry.percent + 0.5))
			else Loc.formatDecimal(entry.percent, 1)
		table.insert(lines, string.format("%s  %s%%", Names.egg(entry.eggType), percent))
	end
	return table.concat(lines, "\n")
end

local function update(view: DomeView, now: number)
	local dome = view.dome
	local stored = dome:GetAttribute("Stored")
	local capacity = dome:GetAttribute("Capacity")
	local uid = dome:GetAttribute("BreederUid")
	local data = ClientState.get()
	local baerchi = if typeof(uid) == "string" and uid ~= "" and data then data.island.baerchis[uid] else nil

	-- Lager immer zeigen
	if typeof(stored) == "number" and typeof(capacity) == "number" then
		local full = stored >= capacity
		view.stored.Text = "🥚 " .. string.format("%d / %d", stored, capacity)
		view.stored.TextColor3 = if full then FULL_COLOR else Color3.new(1, 1, 1)
	end

	if not baerchi or not data then
		view.title.Text = Loc.t("ui.incubator.prompt_breed")
		view.title.TextColor3 = Color3.new(1, 1, 1)
		view.odds.Text = ""
		view.timer.Text = ""
		view.key = ""
		return
	end

	-- Name und Chancen nur neu schreiben, wenn sich etwas daran aendert
	local unlockedCount = 0
	if data.eggTree then
		for _ in data.eggTree.unlocked do unlockedCount += 1 end
	end
	local key = table.concat({ uid :: string, baerchi.configId, tostring(baerchi.mutation), Loc.getLanguage(),
		tostring(unlockedCount) }, "|")
	if key ~= view.key then
		view.key = key
		view.title.Text = string.format("%s · %s", Names.baerchi(baerchi.configId),
			Loc.name("rarity." .. baerchi.rarity, baerchi.rarity))
		view.title.TextColor3 = BaerchiConfig.getRarityColor(baerchi.rarity)
		view.odds.Text = oddsText(baerchi, data.eggTree)
	end

	if typeof(stored) == "number" and typeof(capacity) == "number" and stored >= capacity then
		view.timer.Text = Loc.t("ui.incubator.breed_full")
		view.timer.TextColor3 = FULL_COLOR
		return
	end
	local last = dome:GetAttribute("LastEggAt")
	local seconds = dome:GetAttribute("BreedSeconds")
	if typeof(last) == "number" and typeof(seconds) == "number" and seconds > 0 then
		local left = math.max(0, last + seconds - now)
		view.timer.Text = "⏱ " .. Loc.formatDuration(math.ceil(left))
		view.timer.TextColor3 = OK_COLOR
	end
end

local function attachPrompt(base: BasePart)
	if base:FindFirstChild("IncubatorPrompt") then return end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "IncubatorPrompt"
	prompt.ActionText = Loc.t("ui.incubator.prompt_action")
	prompt.ObjectText = Loc.t("ui.incubator.title")
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	prompt.Triggered:Connect(function()
		PanelManager.open("Incubator")
	end)
	Loc.onChanged(function()
		prompt.ActionText = Loc.t("ui.incubator.prompt_action")
		prompt.ObjectText = Loc.t("ui.incubator.title")
	end)
end

local function hook(instance: Instance)
	if not instance:IsA("BasePart") then return end
	local model = instance.Parent
	if not model or model.Name ~= IncubatorConfig.MODEL_NAME then return end
	if not isOwnPlot(model) then return end
	if instance.Name == "Base" then
		attachPrompt(instance)
	elseif instance.Name == "Dome_1" then
		attachView(instance)
	end
end

function IncubatorController.init()
	if not FeatureFlags.isOn("INCUBATOR") then return end

	for _, descendant in Workspace:GetDescendants() do
		hook(descendant)
	end
	Workspace.DescendantAdded:Connect(function(instance)
		-- Die Attribute (PlotOwner) haengen am Plot; die Teile kommen dazu.
		task.defer(hook, instance)
	end)

	task.spawn(function()
		while true do
			task.wait(TICK_SECONDS)
			local now = Workspace:GetServerTimeNow()
			for dome, view in _views do
				if dome.Parent == nil then
					_views[dome] = nil
				else
					local ok, err = pcall(update, view, now)
					if not ok then warn("[IncubatorController] Schild:", err) end
				end
			end
		end
	end)
end

return IncubatorController
]]></ProtectedString>
						<string name="ScriptGuid">{A8D2B542-A435-46E7-9976-43B6FA7BEF07}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">IncubatorController</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX6B91D735445B4F35B3CF3874FA1FC9B4">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- LaidEggMeshController.luau
-- StarterPlayerScripts/Controllers/LaidEggMeshController.luau
--
-- Einzige Zustaendigkeit:
--   - Das Ei-Mesh (EggMesh) auf dem Client ueber jeden gelegten Ei-Koerper legen.
--
-- Der Server baut je Ei einen schlichten Koerper und markiert ihn mit dem Tag
-- "LaidEggBody" (Fallback: Kugel). Ein EditableMesh wird nicht repliziert,
-- darum entsteht das feine Mesh hier: es folgt Groesse und Farbe des Koerpers,
-- der Koerper selbst wird lokal unsichtbar. Gurte, Steine, Beruehren und
-- Beschriftung bleiben beim Server-Koerper.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")

local EggMesh   = require(ReplicatedStorage.Modules.EggMesh)
local EggModels = require(ReplicatedStorage.Modules.EggModels)

local LaidEggMeshController = {}

local TAG = "LaidEggBody"

-- Ein frisch gelegtes Ei macht ganz leicht auf sich aufmerksam: es "poppt" kurz
-- auf (Groesse mit Ueberschwingen) und streut ein paar Funken. Bewusst klein.
local POP_TIME     = 0.45
local POP_START    = 0.35   -- Anfangsgroesse (Anteil)
local SPARK_COUNT  = 6
local SETTLE_TIME  = 4      -- so lange nach dem Start gelten vorhandene Eier als "alt"

local _seen: { [string]: boolean } = {}
local _settled = false

local function popIn(body: BasePart, mesh: MeshPart)
	local full = mesh.Size
	mesh.Size = full * POP_START
	TweenService:Create(mesh, TweenInfo.new(POP_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Size = full }):Play()

	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color         = ColorSequence.new(Color3.new(1, 1, 1):Lerp(body.Color, 0.3))
	sparks.Size          = NumberSequence.new(0.3, 0)
	sparks.Lifetime      = NumberRange.new(0.5, 0.9)
	sparks.Speed         = NumberRange.new(2, 4)
	sparks.SpreadAngle   = Vector2.new(180, 180)
	sparks.LightEmission = 1
	sparks.Rate          = 0
	sparks.Parent        = body
	sparks:Emit(SPARK_COUNT)
	task.delay(1.5, function() sparks:Destroy() end)
end

-- 14.10.: Eier mit fertigem Modell (Assets.Eggs). Der Server-Koerper bleibt als
-- unsichtbare Huelle (Touch, Attribut, Beschriftung), das Modell sitzt darauf.
-- Gibt true zurueck, wenn das Modell gesetzt wurde.
local function dressModel(body: BasePart): boolean
	local eggId = body:GetAttribute("EggId")
	if type(eggId) ~= "string" then return false end

	-- Assets koennen beim Beitritt kurz nach den Eiern ankommen: einmal warten.
	if EggModels.has(eggId) and not EggModels.getTemplate(eggId) then
		local assets = ReplicatedStorage:WaitForChild("Assets", 10)
		if assets then assets:WaitForChild("Eggs", 10) end
	end
	local template = EggModels.getTemplate(eggId)
	if not template or not template.PrimaryPart then return false end
	if body:FindFirstChild("EggModel") then return true end

	local model = template:Clone()
	model.Name = "EggModel"
	local baseHeight = (template.PrimaryPart :: BasePart).Size.Y
	EggModels.place(model, baseHeight, body, 1)
	model.Parent = body
	body.Transparency = 1

	local uid = body:GetAttribute("LaidEggUid")
	if type(uid) == "string" then
		local isNew = _settled and not _seen[uid]
		_seen[uid] = true
		if isNew then
			-- Pop wie beim Mesh-Ei: Groesse mit Ueberschwingen, Fuss bleibt am Boden.
			local value = Instance.new("NumberValue")
			value.Value = POP_START
			EggModels.place(model, baseHeight, body, POP_START)
			value.Changed:Connect(function(factor: number)
				if model.Parent then EggModels.place(model, baseHeight, body, factor) end
			end)
			local tween = TweenService:Create(value,
				TweenInfo.new(POP_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = 1 })
			tween.Completed:Once(function() value:Destroy() end)
			tween:Play()

			local sparks = Instance.new("ParticleEmitter")
			sparks.Texture       = "rbxasset://textures/particles/sparkles_main.dds"
			sparks.Color         = ColorSequence.new(Color3.new(1, 1, 1))
			sparks.Size          = NumberSequence.new(0.3, 0)
			sparks.Lifetime      = NumberRange.new(0.5, 0.9)
			sparks.Speed         = NumberRange.new(2, 4)
			sparks.SpreadAngle   = Vector2.new(180, 180)
			sparks.LightEmission = 1
			sparks.Rate          = 0
			sparks.Parent        = body
			sparks:Emit(SPARK_COUNT)
			task.delay(1.5, function() sparks:Destroy() end)
		end
	end
	return true
end

local function dress(body: Instance)
	if not body:IsA("BasePart") or body:FindFirstChild("EggMesh") then return end
	if dressModel(body) then return end

	local template = EggMesh.getTemplate()
	if not template then return end   -- Server-Kugel bleibt sichtbar

	local mesh = template:Clone()
	mesh.Name     = "EggMesh"
	mesh.Size     = body.Size
	mesh.CFrame   = body.CFrame
	mesh.Color    = body.Color
	mesh.Material = body.Material
	mesh.Parent   = body
	body.Transparency = 1

	local uid = body:GetAttribute("LaidEggUid")
	if type(uid) == "string" then
		local isNew = _settled and not _seen[uid]
		_seen[uid] = true
		if isNew then popIn(body, mesh) end
	end
end

function LaidEggMeshController.init()
	task.delay(SETTLE_TIME, function() _settled = true end)
	CollectionService:GetInstanceAddedSignal(TAG):Connect(dress)
	for _, body in CollectionService:GetTagged(TAG) do
		task.spawn(dress, body)
	end
end

return LaidEggMeshController
]]></ProtectedString>
						<string name="ScriptGuid">{DAC3A96C-5DEB-4836-AC62-274E6940F0F8}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">LaidEggMeshController</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX519DA6B308554E5481697CAB27466C56">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- LanguageController.luau
-- StarterPlayerScripts/Controllers/LanguageController.luau
--
-- Einzige Zustaendigkeit:
--   - Entscheiden, in welcher Sprache der Client gerade laeuft, und das Loc
--     mitteilen
--   - Die Wahl des Spielers an den Server schicken (damit sie gespeichert wird)
--
-- ============================================================
-- WELCHE SPRACHE GILT — in dieser Reihenfolge
-- ============================================================
--   1. Die gespeicherte Wahl des Spielers (data.language vom Server).
--   2. Die Roblox-Sprache seines Kontos/Clients (Player.LocaleId, zum Beispiel
--      "de-de" → Deutsch). Das ist der Normalfall fuer jeden, der nie im Menue
--      war — er sieht das Spiel sofort in seiner Sprache.
--   3. Englisch, wenn Roblox eine Sprache meldet, die wir nicht uebersetzt haben.
--
-- Der Client wertet die Roblox-Sprache SOFORT aus, noch bevor der erste
-- Server-Sync da ist. Sonst waere der allererste Toast (und alles, was
-- vorher beschriftet wird) einen Moment lang in der falschen Sprache.
--
-- ============================================================
-- WARUM DIE WAHL OPTIMISTISCH GILT
-- ============================================================
-- Klickt der Spieler eine Sprache an, wechselt die Oberflaeche sofort — nicht
-- erst, wenn der Server bestaetigt hat. Das ist eine reine Darstellungs-
-- Einstellung (kein Spielwert), der Server prueft sie nur und legt sie ab.
-- Damit ein PlayerDataUpdated, das noch den ALTEN Wert traegt (weil es vor
-- dem Klick gesendet wurde), die Wahl nicht kurz zurueckdreht, wird die eigene
-- Wahl fuer PENDING_SECONDS bevorzugt, bis der Server denselben Wert meldet.

local Players             = game:GetService("Players")
local LocalizationService = game:GetService("LocalizationService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local Types   = require(ReplicatedStorage.Network.Types)
local Remotes = require(ReplicatedStorage.Network.Remotes)
local Loc     = require(ReplicatedStorage.Localization.Loc)

local ClientState = require(script.Parent.ClientState)

local LanguageController = {}

-- So lange gewinnt die eigene Wahl gegen einen (moeglicherweise veralteten)
-- Server-Wert. Deutlich laenger als der Rate-Limit-Abstand des Remotes.
local PENDING_SECONDS = 5

-- nil = "automatisch" (Roblox-Sprache)
local _choice: string? = nil
local _pendingUntil = 0

-- Letzter vom Server gemeldeter Wert, damit nicht bei JEDEM PlayerDataUpdated
-- (das ist haeufig) neu verglichen werden muss, ob sich die Sprache aendert.
local _lastServerValue: string? = nil
local _seenServerValue = false

--------------------------------------------------------------------------------
-- Roblox-Sprache
--------------------------------------------------------------------------------

local function detectRobloxLanguage(): Loc.Lang
	local fromPlayer = Loc.fromLocaleId(Players.LocalPlayer.LocaleId)
	if fromPlayer then return fromPlayer end

	local fromService = Loc.fromLocaleId(LocalizationService.RobloxLocaleId)
	if fromService then return fromService end

	return Loc.DEFAULT_LANGUAGE
end

local function applyChoice()
	local code = _choice
	if code == nil or not Loc.isSupported(code) then
		code = detectRobloxLanguage()
	end
	Loc.setLanguage(code :: string)
end

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Die gewaehlte Sprache; nil bedeutet "automatisch". NICHT die gerade
-- aktive Sprache — die liefert Loc.getLanguage().
function LanguageController.getChoice(): string?
	return _choice
end

-- `code` = "de" | "en" | "fr" | "es", oder nil fuer "automatisch".
function LanguageController.choose(code: string?)
	if code ~= nil and not Loc.isSupported(code) then return end
	if code == _choice then return end

	_choice       = code
	_pendingUntil = os.clock() + PENDING_SECONDS
	applyChoice()

	Remotes.RequestSetLanguage:FireServer(code)
end

--------------------------------------------------------------------------------
-- Server-Stand
--------------------------------------------------------------------------------

local function onData(update: Types.PlayerDataUpdate)
	local serverValue = update.language

	-- Die gespeicherte Sprache aendert sich nur durch den Spieler selbst —
	-- fast jedes Update traegt denselben Wert wie das letzte. Dann gibt es
	-- nichts zu tun.
	if _seenServerValue and serverValue == _lastServerValue then
		return
	end
	_seenServerValue  = true
	_lastServerValue  = serverValue

	-- Eigene, noch nicht bestaetigte Wahl hat Vorrang
	if os.clock() < _pendingUntil then
		if serverValue == _choice then
			_pendingUntil = 0   -- bestaetigt
		end
		return
	end

	if serverValue ~= _choice then
		_choice = serverValue
		applyChoice()
	end
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function LanguageController.init()
	-- Sofort: Roblox-Sprache, noch vor dem ersten Server-Sync
	applyChoice()

	ClientState.onChanged(onData)

	print("[LanguageController] Initialisiert |", Loc.getLanguage())
end

return LanguageController
]]></ProtectedString>
						<string name="ScriptGuid">{61849852-6829-41EA-9FA0-8FA0E2943294}</string>
