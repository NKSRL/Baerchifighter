				<Item class="ModuleScript" referent="RBXE04A47BD903A40BF98997EF20F80F89E">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- DailyBonusPanel.luau
-- StarterPlayerScripts/UI/DailyBonusPanel.luau
--
-- Einzige Zustaendigkeit:
--   - Das Fenster des taeglichen Login-Bonus (v15): sieben Felder (heutiges
--     hervorgehoben, abgeholte abgehakt, kommende grau) und der Abholen-Knopf.
--
-- Oeffnet sich beim Join von selbst, wenn heute noch nicht abgeholt ist (der
-- Server liefert die Sicht im PlayerDataUpdate: Types.DailyView). Ob abgeholt
-- werden darf, entscheidet der Server (RequestClaimDailyBonus).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types            = require(ReplicatedStorage.Network.Types)
local Remotes          = require(ReplicatedStorage.Network.Remotes)
local Loc              = require(ReplicatedStorage.Localization.Loc)
local LoginBonusConfig = require(ReplicatedStorage.Config.LoginBonusConfig)
local FeatureFlags     = require(ReplicatedStorage.Config.FeatureFlags)
local GuideSteps       = require(ReplicatedStorage.Modules.GuideSteps)

local TweenService = game:GetService("TweenService")

local Theme        = require(script.Parent.Theme)
local Icons        = require(script.Parent.Icons)
local Toast        = require(script.Parent.Toast)
-- HBB Paket 1: Meldungen nach FeedbackConfig verteilen (Icon/Moment/Toast)
local Notify       = require(script.Parent.Notify)
local PanelManager = require(script.Parent.PanelManager)
local ClientState  = require(script.Parent.Parent.Controllers.ClientState)

local DailyBonusPanel = {}

local PANEL_NAME = "DailyBonus"

local _root: Frame? = nil
local _cells: { Frame } = {}
local _pulses: { [Frame]: Tween } = {}
local _claim: TextButton? = nil
local _status: TextLabel? = nil
local _autoOpened = false
local _claimWord: TextLabel? = nil
local _claimArt: ImageLabel? = nil

-- 14.10. (UI_HONEY_SKIN): jeder Tag = eine Saeule (daily_pillar, 342x976). Anteile der Bildgroesse:
-- Sechseck (Tag) oben, Creme-Flaeche (Icon, Extras), untere Pille (Menge).
local PILL_W, PILL_H = 104, 297
local BROWN = Color3.fromRGB(110, 70, 36)

local function buildPillar(row: Instance, day: number, iconName: string, amount: string, extra: string): Frame
	local cell = Instance.new("Frame")
	cell.Name = "Day" .. day
	cell.BackgroundTransparency = 1
	cell.Size = UDim2.fromOffset(PILL_W, PILL_H)
	cell.LayoutOrder = day
	cell.Parent = row

	local art = Instance.new("ImageLabel")
	art.Name = "HoneySkin"
	art.BackgroundTransparency = 1
	art.Image = Icons.ui("honey/daily_pillar") :: string
	art.ScaleType = Enum.ScaleType.Stretch
	art.Size = UDim2.fromScale(1, 1)
	art.ZIndex = 1
	art.Parent = cell

	local function label(name: string, x: number, y: number, w: number, h: number, text: string, maxSize: number, color: Color3, stroke: boolean): TextLabel
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.FredokaOne
		l.Text = text
		l.TextColor3 = color
		l.TextScaled = true
		l.TextWrapped = true
		l.Position = UDim2.fromScale(x, y)
		l.Size = UDim2.fromScale(w, h)
		l.ZIndex = 4
		if stroke then
			l.TextStrokeColor3 = Color3.fromRGB(110, 60, 20)
			l.TextStrokeTransparency = 0
		end
		local cap = Instance.new("UITextSizeConstraint")
		cap.MaxTextSize = maxSize
		cap.Parent = l
		l.Parent = cell
		return l
	end

	-- Sechseck: Tag
	label("Head", 0.26, 0.055, 0.48, 0.115, Loc.t("ui.daily.day", { day = day }), 15, Color3.new(1, 1, 1), true)

	-- Creme-Flaeche: Icon, Extras
	local holder = Instance.new("Frame")
	holder.Name = "IconHolder"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Position = UDim2.fromScale(0.5, 0.31)
	holder.Size = UDim2.fromScale(0.62, 0.2)
	holder.ZIndex = 4
	holder.Parent = cell
	local icon = Icons.make(holder, iconName, "*")
	icon.Size = UDim2.fromScale(1, 1)
	icon.ZIndex = 4
	if icon:IsA("ImageLabel") then icon.ScaleType = Enum.ScaleType.Fit end

	label("Reward", 0.17, 0.53, 0.66, 0.23, extra, 15, BROWN, false).TextYAlignment = Enum.TextYAlignment.Top

	-- Pille unten: Menge
	label("Amount", 0.17, 0.835, 0.66, 0.085, amount, 17, Color3.new(1, 1, 1), true)

	-- Abgeholt: grosser Haken ueber der Creme-Flaeche
	local mark = Icons.make(cell, "check", "OK")
	mark.Name = "Mark"
	mark.AnchorPoint = Vector2.new(0.5, 0.5)
	mark.Position = UDim2.fromScale(0.5, 0.54)
	mark.Size = UDim2.fromScale(0.62, 0.22)
	mark.ZIndex = 6
	mark.Visible = false
	return cell
end

-- Playtest 05.10.: statt reiner Textzeilen je Tag ein grosses Icon, eine
-- grosse Zahl und die Extras klein darunter. Hauptbild: Tag 7 Geschenk,
-- sonst Gummies, sonst Ei.
local function dayVisual(day: number): (string, string, string)
	local reward = LoginBonusConfig.getDay(day)
	local extras: { string } = {}
	if reward.eggs and reward.eggType then table.insert(extras, string.format("+%d %s", reward.eggs, Loc.t("ui.daily.egg"))) end
	if reward.highestEgg then table.insert(extras, Loc.t("ui.daily.best_egg")) end
	if reward.blueprintChance then table.insert(extras, Loc.t("ui.daily.blueprint_chance", { pct = math.floor(reward.blueprintChance * 100 + 0.5) })) end
	if reward.goldGummies then table.insert(extras, "+" .. Loc.formatNumber(reward.goldGummies) .. " GG") end

	local icon = if day == LoginBonusConfig.CYCLE_DAYS then "gift"
		elseif reward.gummies then "gummy"
		elseif reward.eggType then "egg"
		else "goldgummy"
	local amount = if reward.gummies then Theme.formatNumber(reward.gummies)
		elseif reward.eggs then string.format("%dx", reward.eggs)
		elseif reward.goldGummies then Loc.formatNumber(reward.goldGummies)
		else ""
	return icon, amount, table.concat(extras, "\n")
end

local function refresh()
	local data = ClientState.get()
	local view: Types.DailyView? = if data then data.daily else nil
	if not view then return end

	for day, cell in _cells do
		local done = day <= view.streak and not (view.claimable and day == view.day)
		local today = day == view.day
		local claimed = done or (today and not view.claimable)
		local open = today and view.claimable
		cell.BackgroundColor3 = if open then Theme.COLORS.goldGummy
			elseif claimed then Theme.COLORS.good
			elseif day == LoginBonusConfig.CYCLE_DAYS then Theme.shade(Theme.COLORS.goldGummy, -0.35)
			else Theme.COLORS.panelLight

		local skin = cell:FindFirstChild("HoneySkin")
		if skin and skin:IsA("ImageLabel") then
			skin.ImageColor3 = if claimed then Color3.fromRGB(176, 176, 176) else Color3.new(1, 1, 1)
		end
		local mark = cell:FindFirstChild("Mark")
		if mark and mark:IsA("GuiObject") then
			mark.Visible = claimed
		end
		local stroke = cell:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if open then Color3.fromRGB(255, 245, 190) else Theme.COLORS.outline
			stroke.Thickness = if open then 4 else Theme.OUTLINE_THICKNESS
		end
		-- Kommende Tage etwas gedaempft, damit "heute" heraussticht
		local icon = cell:FindFirstChild("Icon", true)
		if icon and icon:IsA("ImageLabel") then
			icon.ImageTransparency = if claimed or open then 0 else 0.25
		end
		local pulse = _pulses[cell]
		if pulse then
			if open then pulse:Play() else
				pulse:Cancel()
				local scale = cell:FindFirstChildOfClass("UIScale")
				if scale then scale.Scale = 1 end
			end
		end
	end

	local claim, status = _claim, _status
	if claim then
		claim.Text = if view.claimable then Loc.t("ui.daily.claim", { day = view.day }) else Loc.t("ui.daily.claimed")
		Theme.setEnabled(claim, view.claimable)
		if _claimWord then _claimWord.Text = claim.Text end
		if _claimArt then _claimArt.ImageColor3 = if view.claimable then Color3.new(1, 1, 1) else Color3.fromRGB(150, 150, 150) end
	end
	if status then
		status.Text = Loc.t("ui.daily.reset_in", { time = Loc.formatDuration(view.resetIn) })
	end

	-- HBB Paket 2: ein Konto, das an diesem UTC-Tag angelegt wurde, sieht
	-- in den ersten Minuten kein Popup. Das Fenster kommt erst nach dem
	-- ersten beendeten Kampf (dann aendern sich die Daten und refresh
	-- laeuft erneut). Server-Logik unveraendert, nur der Zeitpunkt.
	if view.claimable and not _autoOpened and FeatureFlags.isOn("UI_V2_GUIDE") and data then
		local createdAt = (data :: any).createdAt
		local today = math.floor(workspace:GetServerTimeNow() / 86400)
		local createdToday = typeof(createdAt) == "number" and math.floor(createdAt / 86400) == today
		if createdToday and not GuideSteps.hasFought(data :: any) then
			return
		end
	end

	-- Beim Join einmal von selbst oeffnen, wenn noch nicht abgeholt.
	if view.claimable and not _autoOpened then
		_autoOpened = true
		task.delay(2, function()
			PanelManager.open(PANEL_NAME)
		end)
	end
end

function DailyBonusPanel.init(screenGui: ScreenGui)
	local root = Theme.dialog("DailyBonusPanel", screenGui, Vector2.new(0.6, 0.46), Vector2.new(340, 280), Vector2.new(680, 380))
	_root = root

	-- 14.10. (UI_HONEY_SKIN): das Fenster ist ein Bild (daily_window, 900 x 600 Einheiten)
	local honey = Icons.honeyWindow(root, "honey/daily_window", 900, 600) ~= nil

	Theme.dialogHeader(root, Loc.t("ui.daily.title"), function()
		PanelManager.close(PANEL_NAME)
	end)

	local body = Theme.dialogBody(root)
	if honey then
		Icons.honeyHeader(root, Rect.new(82, 41, 797, 105), 837, 55, 58)
		body.Position = UDim2.fromOffset(70, 125)
		body.Size     = UDim2.fromOffset(765, 385)
	end

	local pillars = honey and Icons.hasUi("honey/daily_pillar")
	local row = Theme.container("Days", body)
	row.Size = UDim2.new(1, 0, 0.62, 0)
	if pillars then row.Size = UDim2.new(1, 0, 0, PILL_H) end
	local layout = Theme.listLayout(row, if pillars then 4 else 6, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	for day = 1, LoginBonusConfig.CYCLE_DAYS do
		local iconName, amount, extra = dayVisual(day)
		local isBig = day == LoginBonusConfig.CYCLE_DAYS
		local cell: Frame
		if pillars then
			cell = buildPillar(row, day, iconName, if amount ~= "" then amount else "?", extra)
		else
		cell = Theme.panel("Day" .. day, row, Theme.COLORS.disabled)
		cell.Size = UDim2.new(1 / LoginBonusConfig.CYCLE_DAYS, -6, 1, 0)
		cell.LayoutOrder = day

		local head = Theme.label("Head", cell, Loc.t("ui.daily.day", { day = day }))
		head.Position = UDim2.new(0, 4, 0, 4)
		head.Size = UDim2.new(1, -8, 0, 18)
		head.TextXAlignment = Enum.TextXAlignment.Center

		-- Hauptgewinn: Krone ueber dem Tag-7-Feld
		if isBig then
			local crown = Icons.make(cell, "crown", "♛")
			crown.Name = "Crown"
			crown.AnchorPoint = Vector2.new(0.5, 0.5)
			crown.Position = UDim2.new(0.5, 0, 0, -4)
			crown.Size = UDim2.fromOffset(30, 30)
			crown.ZIndex = 4
		end

		local holder = Instance.new("Frame")
		holder.Name = "IconHolder"
		holder.BackgroundTransparency = 1
		holder.AnchorPoint = Vector2.new(0.5, 0)
		holder.Position = UDim2.new(0.5, 0, 0, 26)
		holder.Size = UDim2.new(if isBig then 0.95 else 0.8, 0, 0.38, 0)
		holder.Parent = cell
		local icon = Icons.make(holder, iconName, "★")
		icon.Size = UDim2.fromScale(1, 1)

		local amountLabel = Theme.label("Amount", cell, amount)
		amountLabel.AnchorPoint = Vector2.new(0.5, 0)
		amountLabel.Position = UDim2.new(0.5, 0, 0.38, 30)
		amountLabel.Size = UDim2.new(1, -6, 0, 22)
		amountLabel.TextXAlignment = Enum.TextXAlignment.Center

		local text = Theme.bodyText("Reward", cell, extra)
		text.Position = UDim2.new(0, 3, 0.38, 54)
		text.Size = UDim2.new(1, -6, 0.62, -58)
		text.TextSize = 11
		text.TextColor3 = Theme.COLORS.text
		text.TextXAlignment = Enum.TextXAlignment.Center

		-- Abgeholt: Haken oben rechts
		local mark = Icons.make(cell, "check", "✓")
		mark.Name = "Mark"
		mark.AnchorPoint = Vector2.new(1, 0)
		mark.Position = UDim2.new(1, 4, 0, -6)
		mark.Size = UDim2.fromOffset(24, 24)
		mark.ZIndex = 4
		mark.Visible = false

		end -- pillars/else

		-- Heute abholbar: sanftes Pulsieren
		local scale = Instance.new("UIScale")
		scale.Parent = cell
		_pulses[cell] = TweenService:Create(scale,
			TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.06 })

		table.insert(_cells, cell)
	end

	local claim = Theme.bigButton("Claim", body, "", Theme.COLORS.good)
	claim.AnchorPoint = Vector2.new(0.5, 1)
	claim.Position = UDim2.new(0.5, 0, 1, -22)
	claim.Size = UDim2.new(0.6, 0, 0, 40)
	claim.Activated:Connect(function()
		if not claim.Active then return end
		Remotes.RequestClaimDailyBonus:FireServer()
	end)
	_claim = claim
	if honey and Icons.hasUi("honey/res_bar_gold") then
		claim.AnchorPoint = Vector2.new(0.5, 1)
		claim.Position = UDim2.new(0.5, 0, 1, -22)
		claim.Size = UDim2.fromOffset(222, 51)   -- Bildverhaeltnis 855:196
		local word, art = Icons.skinLabelButton(claim, "honey/res_bar_gold", "")
		_claimWord, _claimArt = word, art
	end

	local status = Theme.bodyText("Status", body, "")
	status.AnchorPoint = Vector2.new(0.5, 1)
	status.Position = UDim2.new(0.5, 0, 1, 0)
	status.Size = UDim2.new(1, 0, 0, 18)
	status.TextXAlignment = Enum.TextXAlignment.Center
	_status = status

	PanelManager.register(PANEL_NAME, {
		open = function()
			root.Visible = true
			refresh()
		end,
		close = function()
			root.Visible = false
		end,
	})

	ClientState.onChanged(function()
		refresh()
	end)

	Remotes.DailyBonusReceived.OnClientEvent:Connect(function(result: any)
		if typeof(result) ~= "table" then return end
		local typed = result :: Types.DailyBonusResult
		local parts: { string } = {}
		if typed.gummies > 0 then table.insert(parts, "+" .. Loc.formatNumber(typed.gummies) .. " Paw Coins") end
		if typed.goldGummies > 0 then table.insert(parts, "+" .. Loc.formatNumber(typed.goldGummies) .. " Honey Crystals") end
		if typed.eggs > 0 and typed.eggType then
			table.insert(parts, string.format("+%d %s", typed.eggs, Loc.name("egg." .. typed.eggType .. ".name", typed.eggType)))
		end
		if typed.blueprint then table.insert(parts, Loc.t("msg.tower_blueprint")) end
		-- Inhalte (Gummies, Honey Crystals, Eier) fliegen ueber den Datenstand.
		Notify.emit("daily_claimed", function()
			Toast.success(Loc.t("msg.daily_claimed", { day = typed.day, reward = table.concat(parts, ", ") }))
		end)
	end)

	print("[DailyBonusPanel] Initialisiert")
end

return DailyBonusPanel
]]></ProtectedString>
						<string name="ScriptGuid">{97B6DF29-5BFE-4D7E-AD02-D68C11BACF85}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">DailyBonusPanel</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXC1BC3B04C21343AB9E16E58F3381FE35">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- EggIcon.luau
-- StarterPlayerScripts/UI/EggIcon.luau
--
-- Einzige Zustaendigkeit:
--   - Ein Ei als UI-Symbol: das gezeichnete Ei-Bild (assets/ui/eggs, in
--     Blender aus EggConfig + EggLook gerendert), dazu Seltenheits-Effekte
--     und die kleine "will gleich schluepfen"-Animation.
--
-- Was man am Ei sieht:
--   - Ab Tier 6 (EggLook.glow): innerer Schimmer (wandernder Lichtstreifen
--     ueber der Ei-Maske) und ein weicher Halo dahinter.
--   - Die hoechsten Eier (Tier 9+, Event): ein langsam rotierender Lichtkranz.
--   - opts.idle: das Ei wackelt ab und zu um seinen Fusspunkt und blitzt kurz
--     auf. Alles per Eigenschaften, keine Sprite-Sheets.
--
-- Ohne hochgeladenes Bild (Icons.luau, Schluessel "eggs/<EggId>") zeichnet
-- das Modul wie frueher ein Ei aus Frames — jetzt aus EINER Ellipse, nicht
-- mehr aus zwei mit Taille. Das UI bleibt so ohne Upload bedienbar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local EggLook = require(ReplicatedStorage.Modules.EggLook)
local EggModels = require(ReplicatedStorage.Modules.EggModels)   -- R2: Modell-Symbol fuer Eier ohne PNG
local Theme   = require(script.Parent.Theme)
local Icons   = require(script.Parent.Icons)

local EggIcon = {}

-- Breite : Hoehe des Symbols (unveraendert, damit Aufrufer-Layouts passen)
local ASPECT = 0.8

-- Masse im 512-px-Ei-Bild (tools/art/render_eggs.py: Kamera 3.3 Einheiten,
-- Mitte z 1.27): Fusspunkt des Eis von oben, Abstand Mitte → Fuss.
EggIcon.FOOT_Y = 0.885
local FOOT_FROM_CENTER = EggIcon.FOOT_Y - 0.5

-- Ab dieser Stufe dreht sich ein Lichtkranz hinter dem Ei.
local RAYS_FROM_TIER = 9

local SILHOUETTE = Color3.fromRGB(38, 30, 46)

export type Options = {
	idle     : boolean?,   -- wackeln + aufblitzen
	pedestal : boolean?,   -- kleiner Baumstumpf-Sockel unter dem Ei
	effects  : boolean?,   -- Halo/Kranz/Schimmer (Standard: an)
}

type Entry = {
	root    : Frame,
	body    : Frame,
	height  : number,
	flash   : ImageLabel?,
	flashG  : UIGradient?,
	shimmer : UIGradient?,
	halo    : ImageLabel?,
	rays    : ImageLabel?,
	idle    : boolean,
	phase   : number,
	nextAt  : number,
	wobbleT : number,     -- Startzeit des laufenden Wackelns, -1 = keins
	flashT  : number,     -- Startzeit des laufenden Aufblitzens, -1 = keins
}

local _entries: { Entry } = {}
local _loop: RBXScriptConnection? = nil
local _rng = Random.new()

function EggIcon.imageId(eggId: string): string?
	return Icons.ui("eggs/" .. eggId)
end

--------------------------------------------------------------------------------
-- Rueckfall ohne Bild: Frames
--------------------------------------------------------------------------------

local function shape(parent: Instance, name: string, cx: number, cy: number, w: number, h: number, color: Color3, z: number, roundness: number?): Frame
	local frame = Instance.new("Frame")
	frame.Name             = name
	frame.AnchorPoint      = Vector2.new(0.5, 0.5)
	frame.Position         = UDim2.fromScale(cx, cy)
	frame.Size             = UDim2.fromScale(w, h)
	frame.BackgroundColor3 = color
	frame.BorderSizePixel  = 0
	frame.ZIndex           = z
	frame.Active           = false
	frame.Parent           = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(roundness or 0.5, 0)
	corner.Parent = frame
	return frame
end

-- Kreis mit Durchmesser `d` (Anteil der Breite); die Hoehe rechnet `aspect`
-- (Breite : Hoehe des Elternobjekts) um, damit er rund bleibt.
local function dot(parent: Instance, name: string, cx: number, cy: number, d: number, aspect: number, color: Color3, z: number): Frame
	return shape(parent, name, cx, cy, d, d * aspect, color, z)
end

-- Muster in ein eifoermiges Elternobjekt. Alle Positionen liegen bewusst im
-- Mittelbereich (x 0.2 bis 0.8), damit sie auf der Ei-Silhouette bleiben.
function EggIcon.addPattern(parent: Instance, eggId: string, aspect: number, z: number)
	local look = EggLook.get(eggId)
	local accent = look.accent

	if look.pattern == "spots" then
		dot(parent, "Spot", 0.34, 0.62, 0.20, aspect, accent, z)
		dot(parent, "Spot", 0.64, 0.76, 0.16, aspect, accent, z)
		dot(parent, "Spot", 0.60, 0.40, 0.13, aspect, accent, z)

	elseif look.pattern == "band" then
		local band = shape(parent, "Band", 0.5, 0.56, 0.86, 0.13, accent, z, 0.45)
		band.Rotation = -4

	elseif look.pattern == "stripes" then
		local upper = shape(parent, "Stripe", 0.5, 0.40, 0.58, 0.06, accent, z, 0.45)
		local lower = shape(parent, "Stripe", 0.5, 0.60, 0.74, 0.06, accent, z, 0.45)
		upper.Rotation = -5
		lower.Rotation = -5

	else
		-- "swirl" (Void: violette Tupfen) und "stars" (Kosmos/Ascension/Event:
		-- vierzackige Funken aus einem gedrehten Quadrat)
		if look.pattern == "swirl" then
			dot(parent, "Glint", 0.36, 0.60, 0.22, aspect, accent, z).BackgroundTransparency = 0.1
			dot(parent, "Glint", 0.64, 0.74, 0.15, aspect, accent, z).BackgroundTransparency = 0.1
			dot(parent, "Glint", 0.60, 0.40, 0.12, aspect, accent, z).BackgroundTransparency = 0.1
		else
			for index, spot in { Vector3.new(0.36, 0.60, 0.16), Vector3.new(0.64, 0.74, 0.11), Vector3.new(0.60, 0.38, 0.09) } do
				local star = shape(parent, "Star" .. index, spot.X, spot.Y, spot.Z, spot.Z * aspect, accent, z, 0.12)
				star.Rotation = 45
			end
		end
	end

	-- Glanzpunkt oben links
	local shine = shape(parent, "Shine", 0.34, 0.24, 0.20, 0.10, Color3.new(1, 1, 1), z, 0.5)
	shine.BackgroundTransparency = 0.3
	shine.Rotation = -30
end

-- EINE Ellipse (oben etwas schmaler wirkt durch die Neigung) statt der
-- frueheren zwei Ellipsen mit Taille.
local function drawFallback(body: Frame, eggId: string, z: number)
	local look = EggLook.get(eggId)
	local outline = shape(body, "Outline", 0.5, 0.52, 0.80, 0.86, Theme.COLORS.outline, z)
	outline.Rotation = 6
	local fill = shape(outline, "Fill", 0.5, 0.5, 0.88, 0.9, look.base, z)
	EggIcon.addPattern(fill, eggId, 0.8 / 0.86, z)
end

--------------------------------------------------------------------------------
-- R2: Eier ohne PNG (Nova, UFO-Jackpot) zeigen ihr 3D-Modell in einem
-- ViewportFrame. Das Modell schaut zur -Z-Seite des Koerpers (LookVector).
--------------------------------------------------------------------------------
local VIEW_FOV      = 30
local VIEW_DISTANCE = 2.1    -- Vielfaches der Eihoehe (bei FOV 30 passt das Ei dann ins Bild)
local VIEW_LIFT     = 0.10   -- Kamera leicht von oben (Anteil der Hoehe)

local function modelView(body: Frame, eggId: string, z: number): ViewportFrame?
	local template = EggModels.getTemplate(eggId)
	if not template then return nil end
	local view = Instance.new("ViewportFrame")
	view.Name                   = "Egg"
	view.BackgroundTransparency = 1
	view.Size                   = UDim2.fromScale(1, 1)
	view.ZIndex                 = z
	view.Ambient                = Color3.fromRGB(190, 190, 200)
	view.LightColor             = Color3.new(1, 1, 1)
	view.LightDirection         = Vector3.new(-0.4, -0.7, -0.6)
	local clone = template:Clone()
	clone:PivotTo(CFrame.new())
	clone.Parent = view
	local primary = clone.PrimaryPart
	local cf, size = clone:GetBoundingBox()
	local front = if primary then primary.CFrame.LookVector else Vector3.new(0, 0, -1)
	local camera = Instance.new("Camera")
	camera.FieldOfView = VIEW_FOV
	camera.CFrame = CFrame.lookAt(cf.Position + front * size.Y * VIEW_DISTANCE + Vector3.new(0, size.Y * VIEW_LIFT, 0), cf.Position)
	camera.Parent = view
	view.CurrentCamera = camera
	view.Parent = body
	return view
end

--------------------------------------------------------------------------------
-- Animation (ein gemeinsamer Takt fuer alle Eier)
--------------------------------------------------------------------------------

local function onScreen(root: Frame): boolean
	if root.AbsoluteSize.X <= 0 then return false end
	local node: Instance? = root
	while node do
		if node:IsA("GuiObject") and not node.Visible then return false end
		if node:IsA("ScreenGui") then return node.Enabled end
		node = node.Parent
	end
	return false
end

local function step()
	local now = os.clock()
	local i = 1
	while i <= #_entries do
		local e = _entries[i]
		if e.root.Parent == nil then
			table.remove(_entries, i)
			continue
		end
		i += 1
		if not onScreen(e.root) then continue end

		local t = now + e.phase
		if e.rays then
			e.rays.Rotation = (t * 14) % 360
		end
		if e.halo then
			e.halo.ImageTransparency = 0.45 + 0.15 * math.sin(t * 2.1)
		end
		if e.shimmer then
			e.shimmer.Offset = Vector2.new(((t * 0.45) % 1) * 3 - 1.5, 0)
		end

		-- Wackeln um den Fusspunkt: Ei will schluepfen
		local angle = 0
		if e.idle and e.root:GetAttribute("Silhouette") ~= true then
			if e.wobbleT < 0 and now >= e.nextAt then
				e.wobbleT = now
			end
			if e.wobbleT >= 0 then
				local k = now - e.wobbleT
				if k > 0.75 then
					e.wobbleT = -1
					e.flashT = now
					e.nextAt = now + _rng:NextNumber(3.5, 7.5)
				else
					angle = 9 * math.sin(k * 26) * (1 - k / 0.75)
				end
			end
		end
		local d = e.height * FOOT_FROM_CENTER
		local rad = math.rad(angle)
		e.body.Rotation = angle
		e.body.Position = UDim2.new(0.5, d * math.sin(rad), 0, d * (1 - math.cos(rad)))

		-- Aufblitzen: heller Streifen gleitet ueber die Ei-Maske
		if e.flash and e.flashG then
			if e.flashT >= 0 then
				local k = (now - e.flashT) / 0.4
				if k >= 1 then
					e.flashT = -1
					e.flash.Visible = false
				else
					e.flash.Visible = true
					e.flashG.Offset = Vector2.new(-1.2 + 2.4 * k, 0)
				end
			end
		end
	end
	if #_entries == 0 and _loop then
		_loop:Disconnect()
		_loop = nil
	end
end

local function register(e: Entry)
	table.insert(_entries, e)
	if not _loop then
		_loop = RunService.Heartbeat:Connect(step)
	end
end

-- Ein Bild aus der Ei-Maske (gleiche Form fuer alle Eier) mit Verlaufsband.
local function maskOverlay(parent: Instance, name: string, color: Color3, z: number, width: number, strength: number): (ImageLabel?, UIGradient?)
	local mask = Icons.uiImage(parent, "eggs/egg_mask")
	if not mask then return nil, nil end
	mask.Name        = name
	mask.Size        = UDim2.fromScale(1, 1)
	mask.ImageColor3 = color
	mask.ZIndex      = z
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 25
	local a = 1 - strength
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(math.max(0.001, 0.5 - width), 1),
		NumberSequenceKeypoint.new(0.5, a),
		NumberSequenceKeypoint.new(math.min(0.999, 0.5 + width), 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = mask
	return mask, gradient
end

--------------------------------------------------------------------------------
-- Oeffentlich
--------------------------------------------------------------------------------

-- Ein Ei-Symbol der Hoehe `height` Pixel in `parent`. Position stellt der
-- Aufrufer ein. `z` ist der ZIndex des Symbols (Panels mit eigenen
-- ZIndex-Staffeln brauchen ihn).
function EggIcon.make(parent: Instance, eggId: string, height: number, z: number?, opts: Options?): Frame
	local look = EggLook.get(eggId)
	local layer = z or 1
	local options: Options = opts or {}
	local effects = options.effects ~= false

	local root = Instance.new("Frame")
	root.Name                   = "EggIcon"
	root.BackgroundTransparency = 1
	root.Size                   = UDim2.fromOffset(math.floor(height * ASPECT), height)
	root.ZIndex                 = layer
	root:SetAttribute("EggId", eggId)
	root.Parent                 = parent

	local imageId = EggIcon.imageId(eggId)
	-- R2: ohne PNG, aber mit Modell -> Modell-Symbol statt gezeichnetem Rueckfall
	local picture = imageId ~= nil or EggModels.getTemplate(eggId) ~= nil
	local glowColor = look.accent:Lerp(Color3.new(1, 1, 1), 0.3)

	-- Lichtkranz und Halo hinter dem Ei
	local rays: ImageLabel? = nil
	local halo: ImageLabel? = nil
	if effects and picture and (look.tier >= RAYS_FROM_TIER or look.pattern == "stars" and look.tier == 0) then
		rays = Icons.uiImage(root, "fx/ring_rays")
		if rays then
			rays.Name        = "Rays"
			rays.AnchorPoint = Vector2.new(0.5, 0.5)
			rays.Position    = UDim2.fromScale(0.5, 0.5)
			rays.Size        = UDim2.fromOffset(height * 1.9, height * 1.9)
			rays.ImageColor3 = glowColor
			rays.ImageTransparency = 0.25
			rays.ZIndex      = layer
		end
	end
	if effects and look.glow then
		halo = Icons.uiImage(root, "fx/ring_soft")
		if halo then
			halo.Name        = "Halo"
			halo.AnchorPoint = Vector2.new(0.5, 0.5)
			halo.Position    = UDim2.fromScale(0.5, 0.5)
			halo.Size        = UDim2.fromOffset(height * 1.35, height * 1.35)
			halo.ImageColor3 = glowColor
			halo.ZIndex      = layer
		elseif not picture then
			-- Rueckfall: der alte Schimmer-Kreis
			local glow = shape(root, "Glow", 0.5, 0.55, 1.5, 1.2, look.accent, layer)
			glow.BackgroundTransparency = 0.7
		end
	end

	if options.pedestal then
		local ped = Icons.uiImage(root, "frames/pedestal")
		if ped then
			ped.Name        = "Pedestal"
			ped.AnchorPoint = Vector2.new(0.5, 0)
			ped.Position    = UDim2.new(0.5, 0, 0, height * (EggIcon.FOOT_Y - 0.2))
			ped.Size        = UDim2.fromOffset(height * 1.05, height * 1.05 * 160 / 256)
			ped.ZIndex      = layer
		end
	end

	-- Koerper: quadratisch, unten am Fusspunkt ausgerichtet; dreht beim Wackeln.
	local body = Instance.new("Frame")
	body.Name                   = "Body"
	body.BackgroundTransparency = 1
	body.AnchorPoint            = Vector2.new(0.5, 0)
	body.Position               = UDim2.fromScale(0.5, 0)
	body.Size                   = UDim2.fromOffset(height, height)
	body.ZIndex                 = layer + 1   -- ueber Kranz, Halo und Sockel
	body.Parent                 = root

	local flash: ImageLabel? = nil
	local flashG: UIGradient? = nil
	local shimmer: UIGradient? = nil

	if picture then
		if imageId then
			local image = Instance.new("ImageLabel")
			image.Name                   = "Egg"
			image.BackgroundTransparency = 1
			image.Image                  = imageId
			image.ScaleType              = Enum.ScaleType.Fit
			image.Size                   = UDim2.fromScale(1, 1)
			image.ZIndex                 = layer
			image.Parent                 = body
		else
			modelView(body, eggId, layer)
		end

		if effects and look.glow then
			local _, g = maskOverlay(body, "Shimmer", glowColor, layer + 1, 0.22, 0.45)
			shimmer = g
		end
		if options.idle then
			local f, g = maskOverlay(body, "Flash", Color3.new(1, 1, 1), layer + 2, 0.12, 0.85)
			if f then f.Visible = false end
			flash, flashG = f, g
		end
	else
		drawFallback(body, eggId, layer)
	end

	if rays or halo or shimmer or options.idle then
		register({
			root = root, body = body, height = height,
			flash = flash, flashG = flashG, shimmer = shimmer, halo = halo, rays = rays,
			idle = options.idle == true,
			phase = _rng:NextNumber(0, 10),
			nextAt = os.clock() + _rng:NextNumber(0.8, 5),
			wobbleT = -1, flashT = -1,
		})
	end
	return root
end

-- Dunkle Silhouette (gesperrter Knoten im Ei-Baum) bzw. wieder in Farbe.
function EggIcon.setSilhouette(root: Frame, on: boolean)
	root:SetAttribute("Silhouette", on)
	for _, d in root:GetDescendants() do
		if d:IsA("ViewportFrame") and d.Name == "Egg" then
			d.ImageColor3 = if on then SILHOUETTE else Color3.new(1, 1, 1)   -- R2: Modell-Symbol
		elseif d:IsA("ImageLabel") then
			if d.Name == "Egg" then
				d.ImageColor3 = if on then SILHOUETTE else Color3.new(1, 1, 1)
			elseif d.Name == "Shimmer" or d.Name == "Halo" or d.Name == "Rays" then
				d.Visible = not on
			end
		elseif d:IsA("Frame") and d.Name == "Fill" then
			local eggId = root:GetAttribute("EggId")
			if typeof(eggId) == "string" then
				d.BackgroundColor3 = if on then SILHOUETTE else EggLook.get(eggId).base
			end
		end
	end
end

-- Sofort einmal wackeln und aufblitzen (z. B. nach dem Landen beim Freischalten).
function EggIcon.poke(root: Frame)
	for _, e in _entries do
		if e.root == root then
			e.wobbleT = os.clock()
			return
		end
	end
end

-- Fuer ein Ei, das schon als Ellipsen-Frame existiert (Schluepf-Animation):
-- Muster und Glanz darauf setzen. `aspect` = Breite : Hoehe des Frames.
function EggIcon.decorate(egg: Frame, eggId: string, aspect: number, z: number)
	EggIcon.addPattern(egg, eggId, aspect, z)
end

return EggIcon
]]></ProtectedString>
