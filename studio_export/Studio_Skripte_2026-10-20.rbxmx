	["err.sell_incubator"]            = "Dieses Bärchi sitzt im Inkubator und kann nicht verkauft werden",
	["err.sell_disabled"]             = "Verkaufen ist gerade nicht verfügbar",
	["ui.pets.limit.counter"]         = "{n} / {max}",
	["ui.pets.limit.full_short"]      = "Lager voll",
	["ui.pets.limit.full_hint"]       = "Verkaufe Bärchis, um Platz zu schaffen",
	["ui.pets.sell.toggle"]           = "Verkaufen",
	["ui.pets.sell.toggle_active"]    = "Fertig",
	["ui.pets.sell.hint"]             = "Tippe Bärchis an, um sie zum Verkaufen zu markieren",
