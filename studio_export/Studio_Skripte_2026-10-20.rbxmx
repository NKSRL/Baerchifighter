	-- OMEGA (Kosmos)
	-- ============================================================

	OmegaBaerchi = {
		id = "OmegaBaerchi", displayName = "Omega-Baerchi", rarity = "Omega", path = "Kosmos",
		baseStats = { hp = 31500, atk = 1050, spd = 1.5, pwr = 0.40 },
		layIntervalSeconds = 300,
		eggTable = {
			{ eggType = "GalaxyEgg", weight = 100 },
		},
		defaultSkill = "OmegaStrike", eggSource = {},
		description = "Der letzte Baerchi. Danach kommt nichts mehr.",
	},
}

--------------------------------------------------------------------------------
-- Progression (Level-Cap, Stat-Wachstum, XP-Kurve)
--------------------------------------------------------------------------------

local MAX_LEVEL = 50

-- Stat-Wachstum pro Level — die Zahlen dahinter wendet CombatCalculator an.
--
-- HP und ATK wachsen EXPONENTIELL: jedes Level gibt +10% auf den Wert des
-- vorherigen Levels, also stat = basis * 1.1^(level-1). Das ist auf Level 10
-- das 2,4-fache, auf Level 20 das 6,1-fache und auf Level 50 (Cap) das
-- 106-fache des Grundwerts. Die PIT-Gegner skalieren mit derselben Kurve
-- mit, sonst waere ab Level 15 jede Stage trivial.
--
-- SPD und PWR wachsen bewusst NICHT mit 10%, sondern klein und linear.
--
-- Beide sind Werte, bei denen ein Prozentwachstum entgleist: SPD ist die
-- Angriffsgeschwindigkeit (die rundenbasierte Simulation wertet sie aktuell
-- noch gar nicht aus), und PWR multipliziert den Skill-Schaden, der seinerseits
-- schon am exponentiell wachsenden ATK haengt — 10% pro Level darauf waere
-- exponentielles Wachstum auf exponentiellem Wachstum.
--
-- Auf Level 50 macht das +0.98 SPD und +0.147 PWR. Der Loewenanteil beider
-- Werte kommt also weiterhin vom Baerchi selbst und von seinen Stat-Stufen
-- (PromotionConfig), nicht vom Level.
local STAT_GROWTH_PER_LEVEL = 0.10
local SPD_PER_LEVEL         = 0.02
local PWR_PER_LEVEL         = 0.003

-- XP-Kurve: benoetigte XP um von `level` auf `level + 1` zu kommen.
--
-- Bewusst flach am Anfang: bis Level 6-7 soll ein Baerchi sehr schnell
-- kommen (zusammen ca. 730 XP), damit man frueh mehrere PIT-Stages am Stueck
-- schafft. Danach zieht die Kurve exponentiell an und wird zum Idle-Ziel.
-- XP gibt es NICHT mehr aus Kaempfen, sondern nur noch ueber Honig
-- (siehe HoneyService) — die Kurve haengt also direkt an der
-- Honig-Produktion der Gebaeude.
local XP_CURVE_BASE   = 60
local XP_CURVE_FACTOR = 1.28

local function xpForNextLevel(level: number): number
	return math.floor(XP_CURVE_BASE * math.pow(XP_CURVE_FACTOR, math.max(level, 1) - 1))
end

-- Paket 9 (FeatureFlags.ENDLESS): Endless-Level ueber Level 50 hinaus.
-- Zaehlt nur auf MAX_LEVEL, bleibt ueber Rebirths (RebirthService setzt nur
-- level/xp zurueck) und kommt aus Honig-XP (sobald Final 100 geschafft ist)
-- und aus jeder 10. Endless-Stage. +1 Endless-Level wirkt wie +1 Level
-- (CombatCalculator) und ist im Tower-Modell etwa +2 Endless-Stages wert.
-- Faktor per tools/sim/progression_pacing.lua abgestimmt.
local ENDLESS_XP_BASE   = 340     -- x xpForNextLevel(MAX_LEVEL)
local ENDLESS_XP_FACTOR = 1.02

local function xpForEndlessLevel(endlessLevel: number): number
	return math.floor(xpForNextLevel(MAX_LEVEL) * ENDLESS_XP_BASE * math.pow(ENDLESS_XP_FACTOR, math.max(endlessLevel, 0)))
end

--------------------------------------------------------------------------------
-- Rarity-Kette (Grundlage der Fusions-Regel)
--------------------------------------------------------------------------------

local RARITY_ORDER: { Types.Rarity } = {
	"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic",
	"Divine", "Cosmic", "Secret", "Godly", "Eternal", "Omega",
}

-- Eine Farbe pro Rarity — benutzt von BEIDEN Seiten:
-- Server faerbt damit die Baerchi-Parts auf der Insel,
-- Client faerbt damit Rahmen, Badges und Karten im UI.
-- Deshalb hier und nicht im Client-Theme: sonst laufen die Farben auseinander.
local RARITY_COLORS: { [Types.Rarity]: Color3 } = {
	Common    = Color3.fromRGB(176, 190, 204),   -- Grau-Blau
	Uncommon  = Color3.fromRGB( 76, 217, 100),   -- Gruen
	Rare      = Color3.fromRGB( 46, 155, 255),   -- Blau
	Epic      = Color3.fromRGB(168,  85, 247),   -- Lila
	Legendary = Color3.fromRGB(255, 176,  32),   -- Gold
	Mythic    = Color3.fromRGB(255,  59, 107),   -- Pink-Rot
	Divine    = Color3.fromRGB(255, 244, 190),   -- Himmlisches Hellgold
	Cosmic    = Color3.fromRGB( 92,  72, 255),   -- Tiefes Indigo
	Secret    = Color3.fromRGB( 30,  34,  48),   -- Fast-Schwarz
	Godly     = Color3.fromRGB( 40, 235, 220),   -- Tuerkis-Leuchten
	Eternal   = Color3.fromRGB(255, 120,  40),   -- Gluehendes Orange
	Omega     = Color3.fromRGB(255, 255, 255),   -- Weiss
}

local function getRarityColor(rarity: Types.Rarity): Color3
	return RARITY_COLORS[rarity] or RARITY_COLORS.Common
end

--------------------------------------------------------------------------------
-- Mutation (ersetzt seit v11 das binaere Inverted-System)
--------------------------------------------------------------------------------

-- Ein MUTIERTER Baerchi ist derselbe Baerchi, nur durchweg besser — genau wie
-- vorher Inverted. Neu ist die STUFUNG: acht Stufen statt einem einzigen
-- Bonus, jede mit eigenem Multiplikator, eigener Farbe und eigener Seltenheit
-- (Vorbild: das Mutations-System aus "Steal a Brainrot"). Wie bei Inverted
-- ist es KEINE eigene Rarity und KEINE eigene Art: jeder configId kann jede
-- Stufe tragen, die Rarity bleibt dabei unveraendert.
--
-- ANNAHME, nicht vom Projektinhaber vorgegeben (Zahlen/Farben/Namen sind mein
-- Entwurf aus DESIGN_VORSCHLAG_TRENDANALYSE_2026-09-11.md, Abschnitt 3):
--
--   * `multiplier` ist der Anteil, um den HP/ATK/EGG steigen (multiplier - 1
--     als Bonus, siehe getMutationBonus) — SPD/PWR bekommen davon nur ein
--     Drittel, aus demselben Grund wie frueher bei INVERTED_BONUS (sie
--     multiplizieren sich bereits mit anderen Werten).
--   * `weight` ist ein Gewicht in einem Wurf ueber ALLE Stufen PLUS einem
--     riesigen "keine Mutation"-Gewicht (siehe rollMutation) — kein Wurf pro
--     Stufe einzeln. Die Summe aus allen Gewichten (inkl. "keine Mutation")
--     ist absichtlich eine runde Million, damit die Prozentzahlen unten
--     nachrechenbar bleiben.
--   * Celestial und Candy teilen sich denselben Multiplikator (4x), genau wie
--     Lava und Galaxy (6x) — das ist Absicht: zwei kosmetisch verschiedene
--     "Geschmacksrichtungen" derselben Machtstufe, kein Tippfehler.
--   * Rainbow bekommt eine einzelne repraesentative Farbe statt eines
--     echten Farbwechsels — ein zyklisches ColorSequence/Tween-Rainbow waere
--     ein separater Studio-Effekt und ist hier bewusst NICHT mit umgesetzt.
--
-- Wer andere Zahlen will: alles Balancing steckt ausschliesslich in dieser
-- Tabelle, nirgendwo sonst im Code.
export type MutationDef = {
	id          : Types.MutationId,
	displayName : string,
	badge       : string,    -- kurzes Kuerzel fuers Namensschild, z.B. "[GOLD]"
	multiplier  : number,    -- 1.25 = +25% auf HP/ATK/EGG (siehe getMutationBonus)
	color       : Color3,
	weight      : number,    -- Gewicht im Gesamtwurf (siehe rollMutation)
}

-- Reihenfolge = Seltenheits-/Staerke-Kette, genau wie RARITY_ORDER bei Rarity.
-- FusionService.pickHigherMutation vergleicht Baerchis ueber den Index hier.
local MUTATION_ORDER: { Types.MutationId } = {
	"Gold", "Diamond", "Bloodrot", "Celestial", "Candy", "Lava", "Galaxy", "Rainbow",
}

local MUTATIONS: { [Types.MutationId]: MutationDef } = {
	Gold = {
		id = "Gold", displayName = "Gold", badge = "[GOLD]",
		multiplier = 1.25, color = Color3.fromRGB(255, 215, 0), weight = 10000,
	},
	Diamond = {
		id = "Diamond", displayName = "Diamond", badge = "[DIA]",
		multiplier = 1.50, color = Color3.fromRGB(120, 224, 255), weight = 3000,
	},
	Bloodrot = {
		id = "Bloodrot", displayName = "Bloodrot", badge = "[BLOOD]",
		multiplier = 2.00, color = Color3.fromRGB(139, 0, 0), weight = 1200,
	},
	Celestial = {
		id = "Celestial", displayName = "Celestial", badge = "[CEL]",
		multiplier = 4.00, color = Color3.fromRGB(147, 112, 219), weight = 400,
	},
	Candy = {
		id = "Candy", displayName = "Candy", badge = "[CANDY]",
		multiplier = 4.00, color = Color3.fromRGB(255, 105, 180), weight = 300,
	},
	Lava = {
		id = "Lava", displayName = "Lava", badge = "[LAVA]",
		multiplier = 6.00, color = Color3.fromRGB(255, 69, 0), weight = 70,
	},
	Galaxy = {
		id = "Galaxy", displayName = "Galaxy", badge = "[GAL]",
		multiplier = 6.00, color = Color3.fromRGB(106, 27, 154), weight = 25,
	},
	Rainbow = {
		id = "Rainbow", displayName = "Rainbow", badge = "[RBW]",
		multiplier = 10.00, color = Color3.fromRGB(255, 0, 170), weight = 5,
	},
}

-- Gewicht des "gar keine Mutation"-Falls im Gesamtwurf (siehe rollMutation).
-- Zusammen mit den Gewichten oben ergibt das genau 1_000_000 — macht die
-- Gesamtchance auf IRGENDEINE Mutation genau 15_000 / 1_000_000 = 1.5%.
local NO_MUTATION_WEIGHT = 985000

-- Wuerfelt EINMAL ueber alle acht Stufen plus "keine Mutation" und gibt die
-- getroffene Stufe zurueck (nil = keine). Bewusst EIN Wurf und nicht "erst
-- pruefen OB, dann WELCHE": das mischt Gesamtchance und Stufen-Verteilung in
-- einer einzigen, leicht nachrechenbaren Tabelle, genau wie EggConfig.rollEggType
-- es fuer Ei-Typen macht.
--
-- Bewusst hier und nicht in EggService: die Chancen sind ein Konfig-Wert,
-- EggService ruft nur auf (dieselbe Aufteilung wie vorher bei rollInverted).
local function rollMutation(): Types.MutationId?
	local total = NO_MUTATION_WEIGHT
	for _, id in MUTATION_ORDER do
		total += MUTATIONS[id].weight
	end

	local roll = math.random() * total
	local cumulative = NO_MUTATION_WEIGHT

	if roll < cumulative then
		return nil
	end

	for _, id in MUTATION_ORDER do
		cumulative += MUTATIONS[id].weight
		if roll < cumulative then
			return id
		end
	end

	return nil   -- sollte durch Rundungsfehler praktisch nie erreicht werden
end

-- Wuerfelt eine Mutation OHNE die Moeglichkeit "keine": das Ergebnis ist
-- garantiert eine der acht Stufen, verteilt nach denselben Gewichten wie in
-- rollMutation (Gold am haeufigsten, Rainbow am seltensten).
--
-- Gebraucht vom Mutations-Sturm-Event (siehe EventConfig und
-- EventParticipationService): dort ist die Frage OB schon durch die
-- Event-Chance beantwortet, hier geht es nur noch um WELCHE Stufe. Mit
-- rollMutation waere das Ergebnis auch dann in 98.5% der Faelle nil und das
-- ganze Event praktisch wirkungslos.
local function rollMutationTier(): Types.MutationId
	local total = 0
	for _, id in MUTATION_ORDER do
		total += MUTATIONS[id].weight
	end

	local roll = math.random() * total
	local cumulative = 0

	for _, id in MUTATION_ORDER do
		cumulative += MUTATIONS[id].weight
		if roll < cumulative then
			return id
		end
	end

	-- Nur durch Rundungsfehler erreichbar: die haeufigste Stufe.
	return MUTATION_ORDER[1]
end

-- Die Fellfarbe/Leuchtfarbe einer Mutations-Stufe. Server (Figur auf der
-- Insel) und Client (Rahmen und Badges im UI) benutzen dieselbe Funktion —
-- genau wie bei getRarityColor, aus demselben Grund: zwei getrennte
-- Berechnungen laufen beim naechsten Farbwechsel auseinander.
--
-- nil (keine Mutation) gibt es hier bewusst nicht: der Aufrufer weiss selbst,
-- ob er ueberhaupt eine Farbe braucht (siehe `if baerchi.mutation then ...`
-- an jeder Aufrufstelle) — eine Fallback-Farbe hier waere eine zweite,
-- unnoetige Fallunterscheidung.
local function getMutationColor(mutation: Types.MutationId): Color3
	return MUTATIONS[mutation].color
end

local function getMutationDisplayName(mutation: Types.MutationId): string
	return MUTATIONS[mutation].displayName
end

local function getMutationBadge(mutation: Types.MutationId): string
	return MUTATIONS[mutation].badge
end

-- Der reine Multiplikator ("x1.25", "x10") fuer die Anzeige. 1.0 fuer nil
-- (keine Mutation) — dadurch kann ein Aufrufer immer damit multiplizieren,
-- ohne vorher auf nil zu pruefen.
local function getMutationMultiplier(mutation: Types.MutationId?): number
	if not mutation then
		return 1.0
	end
	return MUTATIONS[mutation].multiplier
end

-- Was eine Mutation an den vier Basiswerten PLUS Ei-Tempo aendert, als Anteil
-- (0.25 = +25%) — direkt einsetzbar wie zuvor INVERTED_BONUS.
--
-- HP/ATK/EGG bekommen den vollen Multiplikator-Anteil, SPD/PWR nur ein
-- Drittel davon — siehe Kommentar-Kopf, derselbe Grund wie beim alten
-- INVERTED_BONUS (hp/atk/egg = 15%, spd/pwr = 5%, exakt Faktor 3).
--
-- nil (keine Mutation) gibt einen Nullbonus zurueck — Aufrufer koennen das
-- Ergebnis deshalb IMMER anwenden, ohne vorher auf nil zu pruefen (siehe
-- CombatCalculator.getEffectiveStats).
local function getMutationBonus(mutation: Types.MutationId?): { hp: number, atk: number, spd: number, pwr: number, egg: number }
	local extra = getMutationMultiplier(mutation) - 1.0
	return {
		hp  = extra,
		atk = extra,
		spd = extra / 3,
		pwr = extra / 3,
		egg = extra,
	}
end

-- Index in MUTATION_ORDER (1 = Gold, ... 8 = Rainbow). 0 fuer nil (keine
-- Mutation) — dadurch ist "keine Mutation" garantiert die niedrigste Stufe
-- in jedem Vergleich, ohne dass der Aufrufer nil gesondert behandeln muss.
local function getMutationRank(mutation: Types.MutationId?): number
	if not mutation then
		return 0
	end
	for index, id in MUTATION_ORDER do
		if id == mutation then
			return index
		end
	end
	return 0
end

-- Die hoehere der beiden Mutationen (fuer FusionService, "das Bessere
-- gewinnt" — dieselbe Linie wie Regel A/B, nur jetzt gestuft statt binaer).
-- Bei Gleichstand (z.B. beide nil, oder beide dieselbe Stufe) gewinnt `a`.
local function pickHigherMutation(a: Types.MutationId?, b: Types.MutationId?): Types.MutationId?
	if getMutationRank(b) > getMutationRank(a) then
		return b
	end
	return a
end

-- v14: Fusion erhoeht die Rarity NICHT mehr (Wunsch des Projektinhabers:
-- "Fusionen sollen nur die Stats mergen"). Die fruehere Konstante
-- FUSION_MYTHIC_RESULT ist entfallen — Mythics fallen jetzt aus Eiern.

-- v14: die Pfade, in Anzeige-Reihenfolge, mit Farbe und Ziel. Server und
-- Client nutzen dieselbe Tabelle (Ei-Baum-Panel, Index, Panel-Badges).
local PATHS: { { id: Types.PathId, color: Color3, goal: string } } = {
	{ id = "Stamm",     color = Color3.fromRGB(238, 214, 170), goal = "start" },
	{ id = "Gold",      color = Color3.fromRGB(255, 196,  60), goal = "strong" },
	{ id = "Kristall",  color = Color3.fromRGB(120, 220, 255), goal = "fast" },
	{ id = "Void",      color = Color3.fromRGB(150,  90, 230), goal = "rare" },
	{ id = "Kosmos",    color = Color3.fromRGB( 92,  72, 255), goal = "all" },
	{ id = "Ascension", color = Color3.fromRGB(196, 128, 255), goal = "rebirth" },
	-- v17: Sonder-Eier aus Events (kein Baerchi hat diesen Pfad)
	{ id = "Event",     color = Color3.fromRGB(255, 214,  60), goal = "event" },
}

local function getPathColor(path: string?): Color3
	for _, p in PATHS do
		if p.id == path then return p.color end
	end
	return PATHS[1].color
end

local function getRarityIndex(rarity: Types.Rarity): number
	for i, r in RARITY_ORDER do
		if r == rarity then
			return i
		end
	end
	return 1
end

-- Naechsthoehere Rarity — nil wenn schon am Ende der Kette (Mythic)
local function getNextRarity(rarity: Types.Rarity): Types.Rarity?
	local idx = getRarityIndex(rarity)
	return RARITY_ORDER[idx + 1]
end

--------------------------------------------------------------------------------
-- Hilfsfunktionen fuer Services
--------------------------------------------------------------------------------

local function getById(id: string): BaerchiDef?
	return BAERCHIS[id]
end

local function getByRarity(rarity: Types.Rarity): { BaerchiDef }
	local result: { BaerchiDef } = {}
	for _, def in BAERCHIS do
		if def.rarity == rarity then
			table.insert(result, def)
		end
	end
	-- Deterministische Reihenfolge: die Iteration ueber eine Hash-Tabelle
	-- ist in Luau nicht garantiert stabil, ein Gacha-Roll darf davon nicht abhaengen.
	table.sort(result, function(a, b)
		return a.id < b.id
	end)
	return result
end

local function getByEggSource(eggType: Types.EggType): { BaerchiDef }
	local result: { BaerchiDef } = {}
	for _, def in BAERCHIS do
		for _, source in def.eggSource do
			if source == eggType then
				table.insert(result, def)
				break
			end
		end
	end
	table.sort(result, function(a, b)
		return a.id < b.id
	end)
	return result
end

return {
	data         = BAERCHIS,
	MAX_LEVEL    = MAX_LEVEL,

	STAT_GROWTH_PER_LEVEL = STAT_GROWTH_PER_LEVEL,
	SPD_PER_LEVEL         = SPD_PER_LEVEL,
	PWR_PER_LEVEL         = PWR_PER_LEVEL,

	MUTATIONS      = MUTATIONS,
	MUTATION_ORDER = MUTATION_ORDER,

	rollMutation            = rollMutation,
	rollMutationTier        = rollMutationTier,
	getMutationColor        = getMutationColor,
	getMutationDisplayName  = getMutationDisplayName,
	getMutationBadge        = getMutationBadge,
	getMutationMultiplier   = getMutationMultiplier,
	getMutationBonus        = getMutationBonus,
	getMutationRank         = getMutationRank,
	pickHigherMutation      = pickHigherMutation,

	RARITY_ORDER  = RARITY_ORDER,
	RARITY_COLORS = RARITY_COLORS,
	PATHS         = PATHS,
	getPathColor  = getPathColor,

	getRarityColor = getRarityColor,
	xpForNextLevel = xpForNextLevel,
	ENDLESS_XP_BASE   = ENDLESS_XP_BASE,
	ENDLESS_XP_FACTOR = ENDLESS_XP_FACTOR,
	xpForEndlessLevel = xpForEndlessLevel,
	getRarityIndex = getRarityIndex,
	getNextRarity  = getNextRarity,
	getById        = getById,
	getByRarity    = getByRarity,
	getByEggSource = getByEggSource,
}
]]></ProtectedString>
						<string name="ScriptGuid">{C2873651-BE9C-4EF6-9AC4-123C83C9970A}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">BaerchiConfig</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0DADB56961DD43D6A246274BA4141365">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- BuildingBehavior.luau
-- ReplicatedStorage/Config/BuildingBehavior.luau
--
-- Einzige Zustaendigkeit:
--   - Alles, was pro Types.BuildingId unterschiedlich ist: was ein Gebaeude
--     kann, was sein Ausbau kostet, wie sein Effekt heisst, welche Look-Stufe
--     es hat und welche Meilenstein-Faehigkeiten es freischaltet.
--
-- ============================================================
-- ZWEI HONIG-GEBAEUDE (v15, Option B)
-- ============================================================
-- Bis v14 gab es drei: Bienenstock (Vorrat), Honigtopf (Heilung), Honig-Presse
-- (XP). Die Entscheidung "Heil-Honig oder XP-Honig?" war schwach, und jedes
-- Gebaeude braucht in Prompt 4 sechs Looks. Seit v15:
--
--   Beehive       VORRAT    Lager waechst, und es produziert schneller.
--
--   HoneyRefiner  VEREDELN  Sein Level hebt die XP JEDES Honigs (die alte
--                           Kurve der Presse) und die Heilung SEINES Honigs
--                           (die alte Achse des Topfs, 25 % -> 60 % auf Level 10,
--                           -> 100 % auf Level 60). Name "Honig-Veredler" ist
--                           ein Platzhalter (steht nur in Strings/MapConfig).
--
-- Damit niemand Honig verliert, produziert der Veredler im Tempo von Topf und
-- Presse zusammen (halbes Intervall, doppeltes Lager). Die Gesamtmenge Honig
-- pro Minute ist dieselbe wie bis v14.
--
-- Das dritte Gebaeude, der Waben-Recycler, hat seine Zahlen in CombConfig; nur
-- seine Meilenstein-Faehigkeiten stehen hier (MILESTONES.Recycler), damit alle
-- Faehigkeiten an einer Stelle sind.
--
-- ============================================================
-- WARUM ALLES HIER STEHT
-- ============================================================
-- Kein Service und kein Panel verzweigt nach einer BuildingId. Ein Gebaeude
-- aendern heisst: EINEN Eintrag in BEHAVIORS anfassen. Die Abhaengigkeit geht
-- nur in EINE Richtung: BuildingBehavior kennt EconomyConfig (Basiswerte,
-- Kostenkurve, XP-Kurve, Look-Stufen), EconomyConfig kennt BuildingBehavior
-- nicht.

local EconomyConfig = require(script.Parent.EconomyConfig)
local Types         = require(script.Parent.Parent.Network.Types)
local Loc           = require(script.Parent.Parent.Localization.Loc)

--------------------------------------------------------------------------------
-- Abweichungen der einzelnen Gebaeude
--------------------------------------------------------------------------------

-- Bienenstock — Vorrat. Bis Level 10 wie bisher (Lager 5 -> 14, je Ausbau ein
-- Platz; Intervall 20 s -> 8 s). Danach langsamer weiter: +1 Lager je
-- BEEHIVE_CAPACITY_STEP Level und Intervall bis BEEHIVE_MIN_INTERVAL_L60.
local BEEHIVE_CAPACITY_L10        = 14
local BEEHIVE_CAPACITY_STEP       = 2      -- ab Level 11: alle 2 Level +1 Platz (L60 = 39)
local BEEHIVE_INTERVAL_L10        = 8
local BEEHIVE_MIN_INTERVAL_L60    = 4

-- Honig-Veredler — Tempo/Lager wie Topf + Presse zusammen.
local REFINER_INTERVAL_FACTOR = 0.5    -- halbes Basis-Intervall (= zwei Gebaeude)
local REFINER_CAPACITY        = 10     -- doppeltes Basis-Lager
-- Heilung SEINES Honigs: Basis (Level 1) -> 60 % (Level 10) -> 100 % (Level 60)
local REFINER_HEAL_L10 = 0.60
local REFINER_HEAL_L60 = 1.00

--------------------------------------------------------------------------------
-- Meilenstein-Faehigkeiten (README 4.3) — Daten + Effekt-Hook
--------------------------------------------------------------------------------
-- Pro Gebaeude: ab welchem Level welche Faehigkeit gilt. `implemented = false`
-- heisst: nur als Daten da, der Effekt kommt spaeter (Liste im Bericht). Ein
-- Service fragt mit BuildingBehavior.hasAbility(...) — er muss nie selbst
-- wissen, auf welchem Level etwas freigeschaltet wird.
export type Ability = {
	id          : string,
	level       : number,
	implemented : boolean,
}

local MILESTONES: { [string]: { Ability } } = {
	Beehive = {
		-- Volles Lager wird automatisch an den ausgeruesteten Baerchi verfuettert
		-- (XP + Heilung), die Produktion steht also nie still (HoneyService).
		{ id = "AutoHarvest",   level = 10, implemented = true },
		{ id = "GoldenDrops",   level = 30, implemented = false },
	},
	HoneyRefiner = {
		{ id = "RefinerBoost",  level = 10, implemented = false },
		{ id = "RoyalJelly",    level = 30, implemented = false },
		{ id = "NectarOfAges",  level = 60, implemented = false },
	},
	-- Honig-Teich (HONEY_POND_V2): die Faehigkeiten von Stock und Veredler
	-- zusammen, auf denselben Leveln.
	HoneyPond = {
		{ id = "AutoHarvest",   level = 10, implemented = true },
		{ id = "RefinerBoost",  level = 10, implemented = false },
		{ id = "GoldenDrops",   level = 30, implemented = false },
		{ id = "RoyalJelly",    level = 30, implemented = false },
		{ id = "NectarOfAges",  level = 60, implemented = false },
	},
	Recycler = {
		-- Groesserer Aufheb-Radius fuer Waben im Event-Pit (CombService).
		{ id = "CollectRadius", level = 20, implemented = true },
		{ id = "AutoDeposit",   level = 45, implemented = false },
	},
}

--------------------------------------------------------------------------------
-- Kleine Rechen-Hilfen
--------------------------------------------------------------------------------

local MAX = EconomyConfig.MAX_BUILDING_LEVEL

-- Linear von `fromValue` (Level fromLevel) nach `toValue` (Level toLevel).
local function lerpLevel(fromLevel: number, fromValue: number, toLevel: number, toValue: number, level: number): number
	local span = math.max(1, toLevel - fromLevel)
	local t = math.clamp((level - fromLevel) / span, 0, 1)
	return fromValue + (toValue - fromValue) * t
end

local function clampLevel(level: number): number
	return EconomyConfig.clampBuildingLevel(level)
end

local function roundToInt(value: number): number
	return math.floor(value + 0.5)
end

local function percentText(value: number): string
	return tostring(roundToInt(value * 100)) .. "%"
end

--------------------------------------------------------------------------------
-- Verhaltens-Objekte
--------------------------------------------------------------------------------

export type Behavior = {
	-- Sekunden, bis dieses Gebaeude auf diesem Level den naechsten Honig hat.
	getIntervalSeconds : (level: number) -> number,

	-- Wie viel Honig dieses Gebaeude auf diesem Level lagern kann.
	getCapacity : (level: number) -> number,

	-- Anteil der maximalen HP, den EIN Honig AUS DIESEM Gebaeude heilt.
	getHealPercent : (level: number) -> number,

	-- Faktor, den dieses Gebaeude zur XP JEDES Honigs beitraegt (1 = keiner).
	getXpMultiplier : (level: number) -> number,

	-- Der Effekt dieses Gebaeudes auf diesem Level, in eigenen Worten
	-- (deutsch; das UI zeigt die lokalisierten Werte selbst an).
	describe : (level: number) -> string,
}

local BASE_INTERVAL = EconomyConfig.HONEY_INTERVAL_SECONDS
local BASE_CAPACITY = EconomyConfig.HONEY_CAPACITY
local BASE_HEAL     = EconomyConfig.HONEY_HEAL_PERCENT

local function baseInterval(_level: number): number  return BASE_INTERVAL end
local function baseCapacity(_level: number): number  return BASE_CAPACITY end
local function baseHeal(_level: number): number      return BASE_HEAL end
local function noXpBonus(_level: number): number     return 1 end

--------------------------------------------------------------------------------
-- Beehive — Vorrat
--------------------------------------------------------------------------------

local function beehiveInterval(level: number): number
	local l = clampLevel(level)
	if l <= 10 then
		return lerpLevel(1, BASE_INTERVAL, 10, BEEHIVE_INTERVAL_L10, l)
	end
	return lerpLevel(10, BEEHIVE_INTERVAL_L10, MAX, BEEHIVE_MIN_INTERVAL_L60, l)
end

local function beehiveCapacity(level: number): number
	local l = clampLevel(level)
	if l <= 10 then
		return roundToInt(lerpLevel(1, BASE_CAPACITY, 10, BEEHIVE_CAPACITY_L10, l))
	end
	return BEEHIVE_CAPACITY_L10 + math.floor((l - 10) / BEEHIVE_CAPACITY_STEP)
end

-- Effekt-Texte in der aktiven Sprache (nur der Client zeigt sie an).
local function beehiveDescribe(level: number): string
	return Loc.t("building.Beehive.effect", {
		cap = beehiveCapacity(level),
		sec = Loc.formatDecimal(beehiveInterval(level), 1),
	})
end

--------------------------------------------------------------------------------
-- HoneyRefiner — Veredeln (XP fuer jeden Honig + Heilung seines Honigs)
--------------------------------------------------------------------------------

local function refinerInterval(_level: number): number
	return BASE_INTERVAL * REFINER_INTERVAL_FACTOR
end

local function refinerCapacity(_level: number): number
	return REFINER_CAPACITY
end

local function refinerHeal(level: number): number
	local l = clampLevel(level)
	if l <= 10 then
		return lerpLevel(1, BASE_HEAL, 10, REFINER_HEAL_L10, l)
	end
	return lerpLevel(10, REFINER_HEAL_L10, MAX, REFINER_HEAL_L60, l)
end

-- Der Multiplikator ist die XP-Kurve, bezogen auf ihren eigenen Startwert:
-- Level 1 = Faktor 1, Level 10 = 25x (wie die alte Presse), danach weiter.
local function refinerXpMultiplier(level: number): number
	local base = EconomyConfig.getHoneyXp(1)
	if base <= 0 then return 1 end
	return EconomyConfig.getHoneyXp(level) / base
end

local function refinerDescribe(level: number): string
	return Loc.t("building.HoneyRefiner.effect", {
		xp   = percentText(refinerXpMultiplier(level) - 1),
		heal = percentText(refinerHeal(level)),
	})
end

--------------------------------------------------------------------------------
-- HoneyPond — Honig-Teich (HONEY_POND_V2): Stock + Veredler in einem
--------------------------------------------------------------------------------
-- Auf Level L genau so viel wie Stock UND Veredler auf Level L: dieselbe
-- Honigmenge pro Minute (Raten addiert), beide Lager, XP und Heilung wie der
-- Veredler. Ein Ausbau kostet dafuer POND_COST_FACTOR x die Grundkosten
-- (statt zwei Gebaeude einzeln). tools/luau-tests/honey_pond.test.lua prueft
-- die Gleichheit; tools/sim/progression_pacing.lua den Kostenfaktor.

local function pondInterval(level: number): number
	local perSecond = 1 / beehiveInterval(level) + 1 / refinerInterval(level)
	return 1 / perSecond
end

local function pondCapacity(level: number): number
	return beehiveCapacity(level) + refinerCapacity(level)
end

local function pondDescribe(level: number): string
	return Loc.t("building.HoneyPond.effect", {
		cap  = pondCapacity(level),
		sec  = Loc.formatDecimal(pondInterval(level), 1),
		xp   = percentText(refinerXpMultiplier(level) - 1),
		heal = percentText(refinerHeal(level)),
	})
end

-- Kosten eines Teich-Ausbaus relativ zu EconomyConfig.HONEY_UPGRADE_COSTS,
-- abgestimmt mit progression_pacing (Bericht docs/HBB_HONIG_TEICH_2026-10-05.md):
--   bis Level 10: 1,2 — Look 2 (L10) nach ~24 min, also in der ERSTEN Sitzung
--   ab Level 11:  2,2 — der Teich kann so viel wie zwei Gebaeude; mit 2,2
--                 halten Look 3-6 ihre Zielzeiten (Look 4 ~8 h, Look 6 Woche 8)
local POND_COST_FACTOR_EARLY = 1.2
local POND_COST_FACTOR       = 2.2

local function pondCostFactor(level: number): number
	return if level <= 10 then POND_COST_FACTOR_EARLY else POND_COST_FACTOR
end

--------------------------------------------------------------------------------
-- Die Tabelle
--------------------------------------------------------------------------------

local BEHAVIORS: { [Types.BuildingId]: Behavior } = {
	Beehive = {
		getIntervalSeconds = beehiveInterval,
		getCapacity        = beehiveCapacity,
		getHealPercent     = baseHeal,
		getXpMultiplier    = noXpBonus,
		describe           = beehiveDescribe,
	},

	HoneyRefiner = {
		getIntervalSeconds = refinerInterval,
		getCapacity        = refinerCapacity,
		getHealPercent     = refinerHeal,
		getXpMultiplier    = refinerXpMultiplier,
		describe           = refinerDescribe,
	},

	HoneyPond = {
		getIntervalSeconds = pondInterval,
		getCapacity        = pondCapacity,
		getHealPercent     = refinerHeal,
		getXpMultiplier    = refinerXpMultiplier,
		describe           = pondDescribe,
	},
}

-- Fallback fuer kaputte Spielstaende mit einer id, die es nicht (mehr) gibt:
-- lieber die Basis-Mechanik als ein Fehler mitten in der Honig-Abrechnung.
local DEFAULT_BEHAVIOR: Behavior = {
	getIntervalSeconds = baseInterval,
	getCapacity        = baseCapacity,
	getHealPercent     = baseHeal,
	getXpMultiplier    = noXpBonus,
	describe           = function(_level: number): string return Loc.t("building.default.effect") end,
}

--------------------------------------------------------------------------------
-- Ausbau-Kosten und -Texte, pro Gebaeude
--------------------------------------------------------------------------------
-- Die KOSTEN sind fuer alle gleich (EconomyConfig.HONEY_UPGRADE_COSTS), der
-- Effekt-Text ist die describe() des Gebaeudes auf der gekauften Stufe —
-- Anzeige und Wirkung koennen nicht auseinanderlaufen.

export type UpgradeDef = {
	costGummies     : number,
	costGoldGummies : number,
	effect          : string,   -- was DIESE Stufe kann (erzeugt aus describe)
}

local BUILDING_UPGRADES: { [Types.BuildingId]: { [number]: UpgradeDef } } = {
	Beehive      = {},
	HoneyRefiner = {},
	HoneyPond    = {},
}

for id, table_ in BUILDING_UPGRADES do
	local behavior = BEHAVIORS[id]
	for level, cost in EconomyConfig.HONEY_UPGRADE_COSTS do
		local factor = if id == "HoneyPond" then pondCostFactor(level) else 1
		table_[level] = {
			costGummies     = cost.gummies * factor,
			costGoldGummies = cost.goldGummies * factor,
			effect          = behavior.describe(level),
		}
	end
end


--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

local BuildingBehavior = {}

BuildingBehavior.BUILDING_UPGRADES = BUILDING_UPGRADES
BuildingBehavior.MILESTONES        = MILESTONES
BuildingBehavior.POND_COST_FACTOR  = POND_COST_FACTOR
BuildingBehavior.pondCostFactor    = pondCostFactor

function BuildingBehavior.get(buildingId: Types.BuildingId): Behavior
	return BEHAVIORS[buildingId] or DEFAULT_BEHAVIOR
end

-- Ist das ein Gebaeude, das es wirklich gibt? Fuer Strings, die vom Client
-- kommen — die duerfen nie ungeprueft als Types.BuildingId weiterlaufen.
function BuildingBehavior.isValidId(value: string): boolean
	return BEHAVIORS[value :: Types.BuildingId] ~= nil
end

function BuildingBehavior.getIntervalSeconds(buildingId: Types.BuildingId, level: number): number
	return BuildingBehavior.get(buildingId).getIntervalSeconds(level)
end

function BuildingBehavior.getCapacity(buildingId: Types.BuildingId, level: number): number
	return BuildingBehavior.get(buildingId).getCapacity(level)
end

-- Groesstes Lager, das dieses Gebaeude je haben kann.
function BuildingBehavior.getMaxCapacity(buildingId: Types.BuildingId): number
	return BuildingBehavior.getCapacity(buildingId, EconomyConfig.MAX_BUILDING_LEVEL)
end

function BuildingBehavior.getHealPercent(buildingId: Types.BuildingId, level: number): number
	return BuildingBehavior.get(buildingId).getHealPercent(level)
end

function BuildingBehavior.getXpMultiplier(buildingId: Types.BuildingId, level: number): number
	return BuildingBehavior.get(buildingId).getXpMultiplier(level)
end

function BuildingBehavior.describeEffect(buildingId: Types.BuildingId, level: number): string
	return BuildingBehavior.get(buildingId).describe(level)
end

function BuildingBehavior.getUpgrade(buildingId: Types.BuildingId, targetLevel: number): UpgradeDef?
	local upgrades = BUILDING_UPGRADES[buildingId]
	if not upgrades then return nil end
	return upgrades[targetLevel]
end

-- v15: Look-Stufe (1-6) eines Gebaeude-Levels. Gilt fuer Bienenstock,
-- Veredler UND Recycler (gleiche Stufen). PlotDisplayService baut ein Gebaeude
-- nur neu, wenn sich DIESE Zahl aendert, nicht bei jedem Level.
function BuildingBehavior.getLook(level: number): number
	return EconomyConfig.getLook(level)
end

-- v15: Hat dieses Gebaeude (oder "Recycler") auf diesem Level die Faehigkeit?
-- Nur umgesetzte Faehigkeiten zaehlen — eine reine Daten-Faehigkeit hat noch
-- keinen Effekt und darf deshalb auch keinen ausloesen.
function BuildingBehavior.hasAbility(buildingKey: string, level: number, abilityId: string): boolean
	for _, ability in MILESTONES[buildingKey] or {} do
		if ability.id == abilityId then
			return ability.implemented and level >= ability.level
		end
	end
	return false
end

-- Alle Faehigkeiten eines Gebaeudes mit Freischalt-Level (fuers Panel).
function BuildingBehavior.getAbilities(buildingKey: string): { Ability }
	return MILESTONES[buildingKey] or {}
end

-- XP, die EIN Honig gibt — egal aus welchem Gebaeude er kommt.
--
-- Die Multiplikatoren ALLER Gebaeude werden aufmultipliziert. Heute traegt nur
-- der Veredler etwas bei (der Bienenstock gibt 1).
function BuildingBehavior.getXpPerHoney(buildings: { [Types.BuildingId]: Types.Building }): number
	local multiplier = 1

	for id, building in buildings do
		multiplier *= BuildingBehavior.getXpMultiplier(id, building.level)
	end

	-- RUNDEN, nicht abschneiden: Basis mal Quotient landet in Fliesskomma knapp
	-- NEBEN der ganzen Zahl (30 * (65/30) = 64.999...).
	return math.max(1, math.floor(EconomyConfig.getHoneyXp(1) * multiplier + 0.5))
end

-- Gesamtes Lager einer Insel ueber alle Gebaeude — fuer die Teich-Anzeige.
function BuildingBehavior.getTotalCapacity(buildings: { [Types.BuildingId]: Types.Building }): number
	local total = 0

	for id, building in buildings do
		total += BuildingBehavior.getCapacity(id, building.level)
	end

	return total
end

return BuildingBehavior
]]></ProtectedString>
						<string name="ScriptGuid">{282489C9-244F-4241-891F-3AD8AB62BCF1}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">BuildingBehavior</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXBA3879E43C88447EB7666266CBE53E12">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- CharmConfig.luau
-- ReplicatedStorage/Config/CharmConfig.luau
--
-- Alle Zahlen der Battle-Charms an einer Stelle:
--   - acht Slots und ab welcher Promotions-Stufe jeder freigeschaltet wird
--   - die Rarity-Odds eines Wurfs
--   - der Pool moeglicher Stat-Typen und ihre Wertebereiche je Rarity
--   - was ein Wurf kostet
--
-- ============================================================
-- EIN SLOT IST NICHT AN EINEN STAT-TYP GEBUNDEN
-- ============================================================
-- Wichtigste Regel, vom Projektinhaber ausdruecklich klargestellt: die acht
-- Slots haben KEINEN festen Stat-Typ. Jeder Wurf zieht zweimal unabhaengig —
-- erst eine Rarity (RARITY_ODDS), dann einen Stat-Typ (STAT_POOL) — und zwar
-- fuer jeden Slot gleich, egal welcher Slot-Index es ist.
--
-- Die "Promotion Tiers"-Tabelle aus der Vorlage ist deshalb hier NUR eine
-- Freischalt-Liste (SLOT_UNLOCK_PROMOTION): sie sagt, ab wann ein Slot
-- ueberhaupt benutzbar ist — nicht, was darin sitzt.
--
-- ============================================================
-- KEINE NEUE WAEHRUNG
-- ============================================================
-- Die Vorlage kennt eine eigene Ressource ("Charm Dust"). In Baerchi Fighter
-- gibt es die bewusst NICHT — der Projektinhaber will das Ressourcen-System
-- einfach halten. Ein Wurf kostet direkt GoldGummies, die bereits bestehende
-- zweite Waehrung (seit GOLD_CHARMS_ONLY nur noch aus den Tages-Quests).
--
-- ============================================================
-- WARUM NUR VIER STAT-TYPEN
-- ============================================================
-- Die Vorlage zeigt Boni wie "Crit DMG" oder "Movement Speed" — beides gibt es
-- in Baerchi Fighter gar nicht (keine Krits, die Figuren laufen mit
-- MapConfig.WALK_SPEED). Ein Charm, der auf nichts wirkt, waere ein stiller
-- Fehler, der erst beim Balancing auffaellt. Deshalb enthaelt der Pool
-- ausschliesslich Boni, die CombatCalculator.getEffectiveStats auch wirklich
-- anwendet. Neue Typen sind ein Eintrag in STAT_POOL plus eine Zeile dort —
-- mehr braucht es nicht.

local Types = require(script.Parent.Parent.Network.Types)
local Loc   = require(script.Parent.Parent.Localization.Loc)

--------------------------------------------------------------------------------
-- Slots
--------------------------------------------------------------------------------

local SLOT_COUNT = 8

-- Ab welcher PROMOTIONS-STUFE (0-10, nicht Sterne!) ein Slot benutzbar ist.
-- Die Zahlen kommen 1:1 aus der "Promotion Tiers"-Tabelle der Vorlage:
-- Slot I ist von Anfang an offen, II ab 2, III ab 4, IV ab 6, V und VI ab 8,
-- VII und VIII ab 10.
local SLOT_UNLOCK_PROMOTION: { number } = { 0, 2, 4, 6, 8, 8, 10, 10 }

-- Roemische Ziffern fuer die Slot-Beschriftung (I-VIII), wie in der Vorlage.
local SLOT_NUMERALS: { string } = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII" }

--------------------------------------------------------------------------------
-- Rarity eines Charms
--------------------------------------------------------------------------------

-- Eigene Rarity-Kette, absichtlich NICHT Types.Rarity: ein Charm hat sechs
-- Stufen mit anderen Namen ("Super Rare", "Ascended") als ein Baerchi. Sie in
-- einen Topf zu werfen waere die naechste Stelle, an der eine Baerchi-Aenderung
-- versehentlich die Charm-Odds verschiebt.
local RARITY_ORDER: { Types.CharmRarity } = {
	"Common", "Uncommon", "Rare", "SuperRare", "Legendary", "Ascended",
}

-- Wahrscheinlichkeit je Wurf, in Prozent. Zahlen 1:1 aus der Vorlage
-- (Bild 3: "Each slot rolls a rarity, then a stat").
-- Summe = 100.0 — die Pruefung dazu steht in rollRarity.
local RARITY_ODDS: { [Types.CharmRarity]: number } = {
	Common    = 49.8,
	Uncommon  = 26.9,
	Rare      = 17.9,
	SuperRare =  4.3,
	Legendary =  1.0,
	Ascended  =  0.1,
}

-- Kurzbuchstabe fuer das Slot-Icon (C / U / R / S / L / A), wie in der Vorlage.
local RARITY_LETTER: { [Types.CharmRarity]: string } = {
	Common    = "C",
	Uncommon  = "U",
	Rare      = "R",
	SuperRare = "S",
	Legendary = "L",
	Ascended  = "A",
}

-- 16.10. Bild je Rarity (Slot-Kacheln in Charm-Fenster und Baerchi-Details).
-- Leere ID = kein Bild, dann bleiben Farbflaeche + Buchstabe (siehe UI/CharmIcon).
-- Epic-Bild = SuperRare, Ascendant-Bild = Ascended.
local RARITY_ICON: { [Types.CharmRarity]: string } = {
	-- Bilder mit echtem Alpha-Kanal (361x361). Image-IDs, aus den Decal-IDs umgerechnet.
	Common    = "rbxassetid://119562697163434",   -- Decal 79998039234504
	Uncommon  = "rbxassetid://137697276032105",   -- Decal 77140435732891
	Rare      = "rbxassetid://120361218015910",   -- Decal 109483756594322
	SuperRare = "rbxassetid://71491926811618",    -- Decal 139139603755712 (Epic)
	Legendary = "rbxassetid://72824208693958",    -- Decal 90850087818303
	Ascended  = "rbxassetid://81359276545418",    -- Decal 87049074161365 (Ascendant)
}

local RARITY_LABEL: { [Types.CharmRarity]: string } = {
	Common    = "Common",
	Uncommon  = "Uncommon",
	Rare      = "Rare",
	SuperRare = "Super Rare",
	Legendary = "Legendary",
	Ascended  = "Ascended",
}

local RARITY_COLORS: { [Types.CharmRarity]: Color3 } = {
	Common    = Color3.fromRGB(176, 190, 204),
	Uncommon  = Color3.fromRGB( 76, 217, 100),
	Rare      = Color3.fromRGB( 46, 155, 255),
	SuperRare = Color3.fromRGB(168,  85, 247),
	Legendary = Color3.fromRGB(255, 176,  32),
	Ascended  = Color3.fromRGB(255,  59, 107),
}

-- Wie stark ein Charm dieser Rarity ist, als Faktor auf den Grundwert des
-- Stat-Typs (siehe STAT_POOL). Ein Ascended-Charm ist damit fuenfmal so stark
-- wie ein Common desselben Typs.
local RARITY_POWER: { [Types.CharmRarity]: number } = {
	Common    = 1.0,
	Uncommon  = 1.6,
	Rare      = 2.4,
	SuperRare = 3.4,
	Legendary = 4.4,
	Ascended  = 6.0,
}

--------------------------------------------------------------------------------
-- Stat-Typen
--------------------------------------------------------------------------------

-- `mode`:
--   "percent" — der Wert ist ein Faktor auf den Basiswert (0.014 = +1.4%)
--   "flat"    — der Wert wird direkt addiert
--
-- `base` ist der Wert eines COMMON-Charms dieses Typs; die Rarity
-- multipliziert ihn (RARITY_POWER), und rollValue streut zusaetzlich
-- +/- SPREAD, damit zwei Charms derselben Rarity nicht identisch sind.
export type CharmStatDef = {
	id          : string,
	displayName : string,
	target      : "hp" | "atk" | "spd" | "pwr",
	mode        : "percent" | "flat",
	base        : number,
}

-- Die vier Ziele sind genau die vier Basiswerte des Spiels. Eine
-- Schadensabwehr gibt es NICHT — es gibt keine Verteidigung mehr (siehe
-- BaerchiConfig): wer einen Tank will, wuerfelt auf HP-Boost.
local STAT_POOL: { CharmStatDef } = {
	{ id = "HpBoost",   displayName = "HP-Boost",         target = "hp",  mode = "percent", base = 0.014 },
	{ id = "AtkBoost",  displayName = "ATK-Boost",        target = "atk", mode = "percent", base = 0.012 },
	{ id = "SpdBoost",  displayName = "Angriffs-Tempo",   target = "spd", mode = "flat",    base = 0.020 },

	-- Flach, nicht prozentual: PWR ist selbst schon ein Multiplikator auf den
	-- Skill-Schaden. "+8% auf einen Multiplikator" waere eine Zahl, die
	-- niemand im Kopf nachrechnet — "+2.4 Prozentpunkte Ability-Schaden"
	-- dagegen schon.
	{ id = "PwrBoost",  displayName = "Ability-Staerke",  target = "pwr", mode = "flat",    base = 0.008 },
}

-- Streuung um den errechneten Wert (0.25 = +/- 25%).
local SPREAD = 0.25

--------------------------------------------------------------------------------
-- Kosten
--------------------------------------------------------------------------------

-- Ein Wurf wuerfelt ALLE freigeschalteten und nicht gesperrten Slots des
-- Baerchis auf einmal neu — genau wie in der Vorlage ("rerolls every slot you
-- have not locked"). Deshalb ist der Preis pro WURF, nicht pro Slot.
local ROLL_COST_GOLD_GUMMIES = 25

-- 14.10. Ein Wurf wuerfelt IMMER alle acht Slots neu — ausser den gesperrten.
-- Jeder gesperrte Slot macht den Wurf teurer: Grundpreis * (1 + LOCK_SURCHARGE
-- * Anzahl gesperrter Slots), aufgerundet. Bei 25 Grundpreis und 0.4: 25, 35,
-- 45, 55 ... bis 95 bei sieben Sperren. Wirksam sind am Ende trotzdem nur die
-- Slots, die die aktuelle Promotion freischaltet (CombatCalculator).
local LOCK_SURCHARGE = 0.4

-- "Auto Roll" ist serverseitig einfach ein Wurf-Paket: der Client schickt eine
-- Anzahl, der Server wuerfelt so oft hintereinander, bis die Anzahl erreicht
-- ist ODER die GoldGummies nicht mehr reichen, und meldet das Ergebnis
-- gesammelt zurueck.
--
-- Bewusst so statt eines Dauer-Timers auf dem Client: ein Auto-Roll, der pro
-- Wurf ein Remote feuert, laeuft sofort in den RateLimiter (siehe
-- NetworkConfig) und wuerde entweder haengen oder halb durchlaufen. Ein Paket
-- ist eine Anfrage, eine Abrechnung, ein Ergebnis.
local AUTO_ROLL_COUNT = 20

--------------------------------------------------------------------------------
-- Hilfsfunktionen
--------------------------------------------------------------------------------

local function getUnlockPromotion(slot: number): number
	return SLOT_UNLOCK_PROMOTION[slot] or math.huge
end

local function isSlotUnlocked(slot: number, promotionLevel: number): boolean
	if slot < 1 or slot > SLOT_COUNT then
		return false
	end
	return (promotionLevel or 0) >= getUnlockPromotion(slot)
end

-- Wie viele Slots bei diesem Promotions-Stand offen sind.
local function countUnlockedSlots(promotionLevel: number): number
	local count = 0
	for slot = 1, SLOT_COUNT do
		if isSlotUnlocked(slot, promotionLevel) then
			count += 1
		end
	end
	return count
end

-- Wie viele Charms dieser Liste gesperrt sind.
local function countLocked(charms: { Types.Charm }?): number
	local count = 0
	for _, charm in charms or {} do
		if charm.locked then
			count += 1
		end
	end
	return count
end

-- Preis eines Wurfs bei dieser Anzahl gesperrter Slots (Server UND Anzeige).
local function getRollCost(lockedCount: number): number
	return math.ceil(ROLL_COST_GOLD_GUMMIES * (1 + LOCK_SURCHARGE * math.max(0, lockedCount)))
end

local function getStatDef(statId: string): CharmStatDef?
	for _, def in STAT_POOL do
		if def.id == statId then
			return def
		end
	end
	return nil
end

-- Wuerfelt eine Rarity anhand von RARITY_ODDS.
--
-- Geht die Kette bewusst von der SELTENSTEN zur haeufigsten durch und
-- vergleicht gegen die aufsummierte Wahrscheinlichkeit: so faellt ein
-- Rundungsrest (die Odds summieren sich auf exakt 100.0, aber math.random gibt
-- Werte bis knapp darunter) immer auf Common zurueck und nie auf einen
-- Ascended.
local function rollRarity(): Types.CharmRarity
	local roll        = math.random() * 100
	local accumulated = 0

	for i = #RARITY_ORDER, 1, -1 do
		local rarity = RARITY_ORDER[i]
		accumulated += RARITY_ODDS[rarity] or 0
		if roll < accumulated then
			return rarity
		end
	end

	return "Common"
end

local function rollStatDef(): CharmStatDef
	return STAT_POOL[math.random(1, #STAT_POOL)]
end

-- Der konkrete Bonus-Wert eines Charms: Grundwert des Typs, mal Rarity-Staerke,
-- plus/minus SPREAD.
local function rollValue(statDef: CharmStatDef, rarity: Types.CharmRarity): number
	local power  = RARITY_POWER[rarity] or 1
	local center = statDef.base * power
	local factor = 1 + (math.random() * 2 - 1) * SPREAD

	-- Auf vier Nachkommastellen runden: sonst stehen im Spielstand Zahlen mit
	-- fuenfzehn Stellen, die kein Mensch und keine Anzeige braucht.
	return math.floor(center * factor * 10000 + 0.5) / 10000
end

-- Wuerfelt einen kompletten Charm fuer einen Slot.
local function rollCharm(slot: number): Types.Charm
	local rarity  = rollRarity()
	local statDef = rollStatDef()

	return {
		slot   = slot,
		rarity = rarity,
		statId = statDef.id,
		value  = rollValue(statDef, rarity),
		locked = false,
	}
end

-- Lesbarer Effekt-Text ("+3.4% HP-Boost"). Server und Client benutzen
-- denselben, damit die Anzeige nicht zweimal formatiert wird. Text in der
-- aktiven Sprache (Client: Spielersprache); der Name des Werts kommt aus
-- `charm.<id>.name`, `displayName` ist nur der deutsche Rueckfall.
local function describe(charm: Types.Charm): string
	local statDef = getStatDef(charm.statId)
	if not statDef then
		return charm.statId
	end

	-- Als Prozent anzuzeigen sind zwei Faelle: echte Prozent-Charms (HP/ATK)
	-- und PWR. PWR ist zwar technisch ein FLACHER Zuschlag, aber der Wert
	-- selbst ist ein Anteil (0.05 = 5% mehr Ability-Schaden) — als "+0.048"
	-- koennte ihn niemand einordnen.
	local stat = Loc.name("charm." .. statDef.id .. ".name", statDef.displayName) -- ui-ok: Rueckfall hinter Loc
	if statDef.mode == "percent" or statDef.target == "pwr" then
		return Loc.t("charm.effect_pct", { value = Loc.formatDecimal(charm.value * 100, 1), stat = stat })
	end
	return Loc.t("charm.effect_flat", { value = Loc.formatDecimal(charm.value, 3), stat = stat })
end

return {
	SLOT_COUNT            = SLOT_COUNT,
	SLOT_UNLOCK_PROMOTION = SLOT_UNLOCK_PROMOTION,
	SLOT_NUMERALS         = SLOT_NUMERALS,

	RARITY_ORDER   = RARITY_ORDER,
	RARITY_ODDS    = RARITY_ODDS,
	RARITY_LETTER  = RARITY_LETTER,
	RARITY_ICON    = RARITY_ICON,
	RARITY_LABEL   = RARITY_LABEL,
	RARITY_COLORS  = RARITY_COLORS,
	RARITY_POWER   = RARITY_POWER,

	STAT_POOL = STAT_POOL,
	SPREAD    = SPREAD,

	ROLL_COST_GOLD_GUMMIES = ROLL_COST_GOLD_GUMMIES,
	AUTO_ROLL_COUNT        = AUTO_ROLL_COUNT,
	LOCK_SURCHARGE         = LOCK_SURCHARGE,

	countLocked = countLocked,
	getRollCost = getRollCost,

	getUnlockPromotion = getUnlockPromotion,
	isSlotUnlocked     = isSlotUnlocked,
	countUnlockedSlots = countUnlockedSlots,
	getStatDef         = getStatDef,
	rollRarity         = rollRarity,
	rollCharm          = rollCharm,
	describe           = describe,
}
]]></ProtectedString>
						<string name="ScriptGuid">{FF0F217F-93EE-4EFD-92A1-415D1F38E7D3}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">CharmConfig</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXC85F5972D4B04B319F2B1FFB241DF8D3">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- CombConfig.luau
-- ReplicatedStorage/Config/CombConfig.luau
--
-- Einzige Zustaendigkeit:
--   - Alle Zahlen und Masse fuer Honigwaben im Event-Pit und fuer den
--     Waben-Recycler auf dem Plot.
--
-- ============================================================
-- DIE IDEE
-- ============================================================
-- Das Event-Pit ist die ganze Zeit begehbar, aber zwischen den Events passiert
-- dort nichts, und wer seinen Baerchi losgeschickt hat, wartet nur. Deshalb
-- liegen im Pit Honigwaben herum:
--
--   * Wer darueber laeuft, hebt sie auf. Sie stapeln sich ueber seinem Kopf.
--   * Jede Wabe macht ihn INNERHALB des Pits ein Stueck langsamer (SLOW_*).
--     Verlaesst er das Pit, laeuft er wieder normal — das Gewicht ist ein
--     Risiko im Pit, keine Dauerstrafe.
--   * Betritt er seine EIGENE Insel, gibt er den Stapel ab. Die Waben
--     wandern in die Warteschlange des Recyclers, der sie nach und nach in
--     Gummies verwandelt — auch waehrend der Spieler schon wieder in der
--     Mitte sammelt.
--   * Der Recycler laesst sich mit Gummies ausbauen: mehr Gummies pro Wabe und
--     schnellere Verarbeitung.
--
-- Die Waben sind KEIN Spielstand: was ein Spieler gerade traegt, geht beim
-- Tod oder Verlassen verloren. Nur die Warteschlange des Recyclers wird
-- gespeichert (IslandData.recycler).
--
-- BALANCE-HINWEIS: ein voller Stapel (MAX_CARRY) bringt auf Recycler-Level 1
-- 250 Gummies, auf Level 10 etwa 20.000, auf Level 60 rund 5,7 Mio (vor dem
-- Rebirth-Multiplikator; 12.10.: Grundwert 10 x Multiplikator, sofort; seit 14.10.
-- Grundwert 25, also alle Zahlen hier x2,5). Zum Vergleich: Tower I zahlt auf Stage 1 10 Gummies
-- (TowerConfig). Die Ausbaukosten kommen aus EconomyConfig.HONEY_UPGRADE_COSTS,
-- dieselbe Kurve wie bei den Honig-Gebaeuden (v15: Level 1-60).

local EconomyConfig = require(script.Parent.EconomyConfig)
local MapConfig     = require(script.Parent.MapConfig)

local CombConfig = {}

--------------------------------------------------------------------------------
-- Waben im Event-Pit: Entstehen
--------------------------------------------------------------------------------

-- Sekunden zwischen zwei neuen Waben, solange FREIE Slots da sind (Serverstart,
-- Limit eines Wabenthemas gestiegen, ein Spawn hat keinen Platz gefunden).
CombConfig.SPAWN_INTERVAL_SECONDS = 1.2

-- SLOT-ZAHL: so viele Waben gibt es hoechstens gleichzeitig — im Pit, auf
-- Koepfen getragen und in der Respawn-Warteschlange zusammen. Mehr liegen auch
-- nie im Pit. Haelt die Zahl der Teile klein und macht Waben knapp.
-- Sammel-Update 05.10. (Paket 5.1, "Waben langsamer und etwas weniger"): 40 -> 30.
CombConfig.MAX_WORLD_COMBS = 30

--------------------------------------------------------------------------------
-- Waben im Event-Pit: Respawn (Slot-Modell)
--------------------------------------------------------------------------------
-- Eine aufgehobene Wabe behaelt ihren Slot (Besitzer = Spieler). Erst wenn sie
-- im Recycler abgegeben wird, kommt sie nach RESPAWN_DELAY_SECONDS an einer
-- freien Stelle im Pit zurueck. Der Wabenfluss haengt damit an der Abgabe-Rate.

-- Sekunden zwischen Abgabe und neuer Wabe im Pit.
-- Paket 5.1: 20 -> 30 s. Events (Hot Egg, Boss) behalten ihren Wabenwert
-- (valueFactor der Themen), dort bleibt die Wabe also gleich wertvoll.
CombConfig.RESPAWN_DELAY_SECONDS = 30

-- Hook: verkuerzt der Recycler-Level den Respawn? Faktor pro Level ueber 1
-- (1 = nein, 0.9 = je Level 10 % kuerzer). Absichtlich 1, Entscheidung offen.
CombConfig.RECYCLER_DELAY_FACTOR = 1

-- Geht ein Stapel verloren (Tod, Verlassen, neuer Charakter), werden seine
-- Slots nach dieser Zeit frei und die Waben kommen ins Pit zurueck.
CombConfig.ORPHAN_RELEASE_SECONDS = 60

-- Sicherheitsnetz: liegen weniger als MIN_WORLD_COMBS im Pit, kommt trotzdem
-- alle MIN_TRICKLE_SECONDS eine dazu (auch ueber die Slot-Zahl hinaus, aber nie
-- ueber das Limit im Pit), damit Neulinge nie ein leeres Pit sehen.
CombConfig.MIN_WORLD_COMBS     = 8
CombConfig.MIN_TRICKLE_SECONDS = 10   -- Paket 5.1: 6 -> 10 s

-- Takt der Respawn-Pruefung (ein Loop, kein Thread pro Wabe).
CombConfig.RESPAWN_TICK_SECONDS = 0.25

-- Beim Serverstart liegen schon so viele da, damit das Pit nicht leer wirkt.
CombConfig.INITIAL_COMBS = 24

-- Ringfoermiger Streifen um die Pit-Mitte, in dem Waben entstehen (Studs).
-- Innen bleibt die Mitte frei (Deko), aussen der Zaun (Radius 50).
CombConfig.SPAWN_RADIUS_MIN = 8
CombConfig.SPAWN_RADIUS_MAX = 44

-- Mindestabstand zwischen zwei Waben beim Entstehen.
CombConfig.SPAWN_MIN_DISTANCE = 4.5

-- Anteil goldener Waben und wie viel sie wert sind (in Wabeneinheiten, eine
-- normale Wabe ist 1).
CombConfig.GOLD_CHANCE = 0.08
CombConfig.GOLD_UNITS  = 5

--------------------------------------------------------------------------------
-- Wabenthemen (je Event, siehe CombService.setTheme)
--------------------------------------------------------------------------------
-- Ein Event kann den Waben im Pit fuer seine Dauer ein THEMA geben: anderes
-- Aussehen, anderer Wert, schnellerer Nachschub, mehr Slots, staerkere
-- Tragebremse. Der Wert wird beim AUFHEBEN festgeschrieben: wer bei
-- Event-Ende noch Lava-Waben traegt, gibt sie als Lava-Waben ab.
--
-- Schluessel = Event-id (EventConfig) bzw. Thema-id. Fehlt ein Eintrag, laeuft
-- das Event mit normalen Waben. Bewusst nur Hot Egg (Lava) und die
-- Wespenkoenigin (Koenigsgelee, Phase 2) — weitere Events koennen spaeter
-- ein Thema bekommen, ohne dass Code dazukommt.
export type CombTheme = {
	bodyColor      : Color3,
	cellColor      : Color3,
	goldBodyColor  : Color3,
	goldCellColor  : Color3,
	bodyMaterial   : Enum.Material,
	cellMaterial   : Enum.Material,
	valueFactor    : number,    -- Einheiten je Wabe (normal 1, Gold GOLD_UNITS) mal diesem Faktor
	spawnRateFactor: number,    -- Nachfuellen freier Slots so viel schneller
	limit          : number,    -- Slot-Zahl waehrend des Themas
	slowPerComb    : number?,   -- Tragebremse je Wabe dieses Themas (sonst SLOW_PER_COMB)
	burstColor     : Color3,    -- Farbe des Funken-Bursts beim Skin-Wechsel
}

CombConfig.THEMES = {
	-- Hot Egg: Vulkan-Waben. Basalt-Platte, glühende Zelle, dreifacher Wert
	-- (Lava-Gold 15), doppelt so schneller Nachschub, 60 Slots, schwerer.
	HotEgg = {
		bodyColor       = Color3.fromRGB( 58,  52,  50),
		cellColor       = Color3.fromRGB(255, 110,  30),
		goldBodyColor   = Color3.fromRGB( 90,  70,  50),
		goldCellColor   = Color3.fromRGB(255, 200,  80),
		bodyMaterial    = Enum.Material.Slate,
		cellMaterial    = Enum.Material.Neon,
		valueFactor     = 3,
		spawnRateFactor = 2,
		limit           = 60,
		slowPerComb     = 0.035,
		burstColor      = Color3.fromRGB(255, 120, 40),
	},
	-- Wespenkoenigin, Phase 2: Koenigsgelee. Cremig-weisse Waben, doppelter
	-- Wert; Slots und Tempo wie normal (der Waben-Regen des Bosses liefert sie).
	WaspQueen = {
		bodyColor       = Color3.fromRGB(250, 238, 200),
		cellColor       = Color3.fromRGB(255, 214,  90),
		goldBodyColor   = Color3.fromRGB(255, 230, 150),
		goldCellColor   = Color3.fromRGB(255, 255, 220),
		bodyMaterial    = Enum.Material.SmoothPlastic,
		cellMaterial    = Enum.Material.Neon,
		valueFactor     = 2,
		spawnRateFactor = 1,
		limit           = 40,
		slowPerComb     = nil,
		burstColor      = Color3.fromRGB(255, 230, 140),
	},
} :: { [string]: CombTheme }

-- Fliegende Waben (Vulkan-Ausbruch, Waben-Regen): Flugzeit und Bogenhoehe.
-- Erst nach der Landung lassen sie sich aufheben.
CombConfig.FLIGHT_SECONDS     = 1.4
CombConfig.FLIGHT_ARC_HEIGHT  = 18
-- Waben-Regen faellt aus dieser Hoehe ueber dem Landepunkt.
CombConfig.RAIN_DROP_HEIGHT   = 45

-- Funken-Burst beim Skin-Wechsel: EIN Emitter in der Pit-Mitte, so viele Funken.
CombConfig.THEME_BURST_COUNT  = 60

function CombConfig.getTheme(themeId: string?): CombTheme?
	if not themeId then return nil end
	return CombConfig.THEMES[themeId]
end

-- Wert einer Wabe in Einheiten (normal/Gold, mal Thema-Faktor).
function CombConfig.getUnits(isGold: boolean, themeId: string?): number
	local base = if isGold then CombConfig.GOLD_UNITS else 1
	local theme = CombConfig.getTheme(themeId)
	return base * (if theme then theme.valueFactor else 1)
end

-- Tragebremse einer Wabe dieses Themas.
function CombConfig.getSlowPerComb(themeId: string?): number
	local theme = CombConfig.getTheme(themeId)
	return if theme and theme.slowPerComb then theme.slowPerComb else CombConfig.SLOW_PER_COMB
end

--------------------------------------------------------------------------------
-- Einsammeln und Tragen
--------------------------------------------------------------------------------

-- Wie oft der Server prueft, wer auf einer Wabe steht.
CombConfig.PICKUP_CHECK_SECONDS = 0.1

-- Horizontaler Abstand zur Wabe, ab dem sie aufgehoben wird (Studs), und wie
-- weit sie hoechstens ueber/unter der Spielfigur liegen darf.
CombConfig.PICKUP_RADIUS     = 3.6
CombConfig.PICKUP_MAX_HEIGHT = 7

-- Wie viele Waben ein Spieler hoechstens traegt. Ist der Stapel voll, bleiben
-- weitere liegen.
CombConfig.MAX_CARRY = 25

--------------------------------------------------------------------------------
-- Tempo im Pit
--------------------------------------------------------------------------------

-- Laufgeschwindigkeit ohne Last. Das Spiel setzt sonst nirgends WalkSpeed,
-- das ist der Roblox-Standard.
CombConfig.BASE_WALK_SPEED = 16

-- Jede getragene Wabe nimmt diesen Anteil der Grundgeschwindigkeit (nicht
-- vom Rest: 25 Waben * 0.025 = 62,5 % weniger, also noch 37,5 %), nie weniger
-- als MIN_SPEED_FACTOR. Gilt NUR innerhalb des Pits.
CombConfig.SLOW_PER_COMB    = 0.025
CombConfig.MIN_SPEED_FACTOR = 0.35

--------------------------------------------------------------------------------
-- Abgabe auf der eigenen Insel
--------------------------------------------------------------------------------

-- Wer naeher als das an der Mitte SEINER Plot-Insel steht, hat die Insel
-- betreten. Etwas kleiner als MapConfig.PLOT_ISLAND_RADIUS (58), damit man
-- wirklich auf dem Gras steht und nicht noch auf dem Rand der Bruecke.
CombConfig.DELIVER_RADIUS = 54

--------------------------------------------------------------------------------
-- Optik der Wabe (Studs)
--------------------------------------------------------------------------------

-- Sechseck mit Umkreisradius R aus drei sich kreuzenden Platten: je 2R lang und
-- R*sqrt(3) breit, um 0, 60 und 120 Grad gedreht. Das ergibt exakt ein
-- regelmaessiges Sechseck, ohne dass dafuer ein Mesh noetig waere.
CombConfig.COMB_RADIUS    = 1.35
CombConfig.COMB_HEIGHT    = 0.55
CombConfig.CELL_RADIUS    = 0.72   -- die dunklere Honigzelle in der Mitte

-- Im Pit liegende Waben sind groesser, damit man sie von weitem sieht.
CombConfig.WORLD_SCALE    = 1.45
CombConfig.WORLD_HOVER    = 1.6    -- Hoehe ueber dem Boden

-- Stapel ueber dem Kopf: Abstand zwischen zwei Waben und Luft ueber dem Kopf.
CombConfig.STACK_STEP     = 0.62
CombConfig.STACK_HEAD_GAP = 0.9
-- Jede Wabe sitzt leicht versetzt/verdreht, damit der Turm wackelig-niedlich
-- aussieht statt wie eine Saeule. Ab der Wabe-Nummer wiederholt sich das Muster.
CombConfig.STACK_WOBBLE_STUDS   = 0.16
CombConfig.STACK_WOBBLE_DEGREES = 14

CombConfig.COMB_COLOR       = Color3.fromRGB(240, 186,  64)
CombConfig.CELL_COLOR       = Color3.fromRGB(214, 128,  28)
CombConfig.GOLD_COMB_COLOR  = Color3.fromRGB(255, 226, 110)
CombConfig.GOLD_CELL_COLOR  = Color3.fromRGB(255, 250, 190)

--------------------------------------------------------------------------------
-- Der Recycler
--------------------------------------------------------------------------------

-- v15: Level 1-60 wie die Honig-Gebaeude (gleiche Look-Stufen, siehe
-- BuildingBehavior.getLook; Faehigkeiten in BuildingBehavior.MILESTONES.Recycler).
CombConfig.RECYCLER_MAX_LEVEL = EconomyConfig.MAX_BUILDING_LEVEL

-- Gummies pro Wabeneinheit (VOR dem Rebirth-Multiplikator), je Recycler-Level.
-- Level 1-10 unveraendert; ab Level 11 waechst der Ertrag mit PAY_GROWTH pro
-- Level weiter (getPayPerUnit).
CombConfig.PAY_PER_UNIT = {
	[1]  = 3,
	[2]  = 5,
	[3]  = 8,
	[4]  = 13,
	[5]  = 21,
	[6]  = 34,
	[7]  = 55,
	[8]  = 90,
	[9]  = 145,
	[10] = 240,
} :: { [number]: number }

-- v15: Zuwachs des Ertrags pro Level ab Level 11 (Level 60 = 240 x 1.12^50 ≈
-- 69.000 je Einheit). ANNAHME, kalibriert mit tools/sim/progression_pacing.lua.
CombConfig.PAY_GROWTH = 1.12

-- Wabeneinheiten pro Sekunde, die der Recycler verarbeitet: Level 1 braucht
-- fuer einen vollen Stapel gut eine Minute, Level 10 ist in unter 10 s durch.
-- v15: danach linear weiter bis SPEED_LEVEL_60 (ein Stapel in ~4 s).
CombConfig.SPEED_LEVEL_1   = 0.4
CombConfig.SPEED_LEVEL_10  = 3.0
CombConfig.SPEED_LEVEL_60  = 6.0

-- Wie lange der Recycler offline hoechstens weiterarbeitet (Sekunden). Es kann
-- ohnehin nur die Warteschlange abgearbeitet werden, der Deckel schuetzt nur vor
-- Zeitmarken aus einer fernen Vergangenheit.
CombConfig.OFFLINE_MAX_SECONDS = 8 * 3600

-- Abstand der Zahlungs-Ticks auf dem Server.
CombConfig.RECYCLER_TICK_SECONDS = 1.0

--------------------------------------------------------------------------------
-- Der Recycler in der Welt (PLOT-LOKAL, siehe Kopf von MapConfig)
--------------------------------------------------------------------------------

-- Ganz vorne auf dem Gras der Plot-Insel: zwischen Wasserkante und Beet, auf der
-- Seite, von der der Spieler aus der Weltmitte kommt (lokales -Z). Das Beet
-- beginnt bei Z = -36, die Insel endet bei Z = -58. X seitlich neben der Bruecke
-- (die liegt auf X = 0), damit man beim Hereinlaufen nicht dagegen stoesst.
CombConfig.RECYCLER_OFFSET = Vector3.new(15, 0, -47)

-- Grosse des unsichtbaren Koerpers (Traeger fuer Name, Schild und Prompt).
CombConfig.RECYCLER_BODY_SIZE = Vector3.new(9, 8, 9)

CombConfig.RECYCLER_NAME = "Recycler"

-- Farbe der Betriebs-Lampe
CombConfig.LAMP_IDLE_COLOR   = Color3.fromRGB(190, 70, 60)
CombConfig.LAMP_ACTIVE_COLOR = Color3.fromRGB(90, 235, 110)

local UPRIGHT    = Vector3.new(0, 0, 90)
local WOOD       = Color3.fromRGB(160, 110, 65)
local WOOD_DARK  = Color3.fromRGB(118,  80,  46)
local METAL      = Color3.fromRGB(150, 152, 158)
local METAL_DARK = Color3.fromRGB( 96,  99, 106)
local GREEN      = Color3.fromRGB( 84, 178,  96)

-- Aussehen (Gebaeude-lokal, wie MapConfig.BUILDING_DECOR: Ursprung = Mitte der
-- Grundflaeche, +Y oben, -Z zur Weltmitte). Ein Trichter, in den die Waben
-- fallen, ein Maschinenkasten mit gruenem Recycling-Band, ein Auslaufrohr nach
-- vorne und die Betriebs-Lampe. "Lampe" wird vom Builder gefaerbt.
CombConfig.RECYCLER_DECOR = {
	{ name = "Sockel",     shape = Enum.PartType.Block,    size = Vector3.new(9.0, 1.2, 9.0),  offset = Vector3.new(0, 0.60, 0),     color = METAL_DARK, material = Enum.Material.Metal, solid = true },
	{ name = "Kasten",     shape = Enum.PartType.Block,    size = Vector3.new(7.0, 4.4, 7.0),  offset = Vector3.new(0, 3.40, 0),     color = WOOD,       material = Enum.Material.Wood, solid = true },
	{ name = "BandVorne",  shape = Enum.PartType.Block,    size = Vector3.new(7.2, 1.0, 7.2),  offset = Vector3.new(0, 3.40, 0),     color = GREEN,      material = Enum.Material.SmoothPlastic },
	{ name = "Deckel",     shape = Enum.PartType.Block,    size = Vector3.new(7.6, 0.7, 7.6),  offset = Vector3.new(0, 5.95, 0),     color = WOOD_DARK,  material = Enum.Material.Wood, solid = true },
	{ name = "TrichterU",  shape = Enum.PartType.Cylinder, size = Vector3.new(1.4, 4.2, 4.2),  offset = Vector3.new(0, 6.90, 0),     color = METAL,      material = Enum.Material.Metal, rotation = UPRIGHT, solid = true },
	{ name = "TrichterM",  shape = Enum.PartType.Cylinder, size = Vector3.new(1.4, 5.6, 5.6),  offset = Vector3.new(0, 8.10, 0),     color = METAL,      material = Enum.Material.Metal, rotation = UPRIGHT, solid = true },
	{ name = "TrichterO",  shape = Enum.PartType.Cylinder, size = Vector3.new(1.2, 7.0, 7.0),  offset = Vector3.new(0, 9.30, 0),     color = METAL,      material = Enum.Material.Metal, rotation = UPRIGHT, solid = true },
	{ name = "Fuellung",   shape = Enum.PartType.Cylinder, size = Vector3.new(0.3, 5.8, 5.8),  offset = Vector3.new(0, 9.85, 0),     color = Color3.fromRGB(240, 186, 64), material = Enum.Material.Neon, rotation = UPRIGHT },
	{ name = "Rohr",       shape = Enum.PartType.Cylinder, size = Vector3.new(3.0, 1.5, 1.5),  offset = Vector3.new(0, 2.40, -4.9), color = METAL_DARK, material = Enum.Material.Metal, rotation = Vector3.new(0, 90, 0) },
	{ name = "Lampe",      shape = Enum.PartType.Ball,     size = Vector3.new(1.3, 1.3, 1.3),  offset = Vector3.new(-2.4, 6.9, -2.4), color = Color3.fromRGB(190, 70, 60), material = Enum.Material.Neon },
} :: { MapConfig.DecorPiece }

-- v15: Look-Zusaetze des Recyclers (Platzhalter bis Prompt 4), Regeln wie
-- MapConfig.BUILDING_LOOK_DECOR: gebaut wird RECYCLER_DECOR plus alle Zusaetze
-- bis zum aktuellen Look (getDecor). Gleiche Look-Stufen wie die Gebaeude.
local GOLD_TRIM  = Color3.fromRGB(255, 205,  70)
local GLOW_GREEN = Color3.fromRGB(110, 255, 150)
local CRYSTAL    = Color3.fromRGB(150, 225, 255)
local PENNANT    = Color3.fromRGB(220,  70,  60)

CombConfig.RECYCLER_LOOK_DECOR = {
	[2] = {
		{ name = "L2Stab",     shape = Enum.PartType.Block,    size = Vector3.new(0.3, 3.0, 0.3),  offset = Vector3.new(-4.1, 1.50,  4.1), color = WOOD_DARK, material = Enum.Material.Wood },
		{ name = "L2Wimpel",   shape = Enum.PartType.Block,    size = Vector3.new(0.1, 1.0, 1.6),  offset = Vector3.new(-4.1, 2.50,  3.3), color = PENNANT },
	},
	[3] = {
		{ name = "L3Goldkante", shape = Enum.PartType.Block,   size = Vector3.new(9.4, 0.3, 9.4),  offset = Vector3.new(0, 1.35, 0), color = GOLD_TRIM, material = Enum.Material.Neon },
	},
	[4] = {
		{ name = "L4Krone",    shape = Enum.PartType.Cylinder, size = Vector3.new(0.5, 7.6, 7.6),  offset = Vector3.new(0, 10.15, 0), color = GOLD_TRIM, material = Enum.Material.Metal, rotation = UPRIGHT },
	},
	[5] = {
		{ name = "L5Glut1",    shape = Enum.PartType.Block,    size = Vector3.new(0.2, 3.6, 5.0),  offset = Vector3.new( 3.6, 3.40, 0), color = GLOW_GREEN, material = Enum.Material.Neon },
		{ name = "L5Glut2",    shape = Enum.PartType.Block,    size = Vector3.new(0.2, 3.6, 5.0),  offset = Vector3.new(-3.6, 3.40, 0), color = GLOW_GREEN, material = Enum.Material.Neon },
	},
	[6] = {
		{ name = "L6Kristall1", shape = Enum.PartType.Block,   size = Vector3.new(1.2, 2.4, 1.2),  offset = Vector3.new( 3.9, 2.40,  3.9), color = CRYSTAL, material = Enum.Material.Glass, rotation = Vector3.new(0, 45, 0) },
		{ name = "L6Kristall2", shape = Enum.PartType.Block,   size = Vector3.new(1.2, 2.4, 1.2),  offset = Vector3.new(-3.9, 2.40, -3.9), color = CRYSTAL, material = Enum.Material.Glass, rotation = Vector3.new(0, 45, 0) },
	},
} :: { [number]: { MapConfig.DecorPiece } }

-- Grund-Deko + Zusaetze bis zu diesem Look.
function CombConfig.getDecor(look: number): { MapConfig.DecorPiece }
	return MapConfig.combineLookDecor(CombConfig.RECYCLER_DECOR, CombConfig.RECYCLER_LOOK_DECOR, look)
end

-- v15: Faehigkeit "Sammelradius" (BuildingBehavior.MILESTONES.Recycler): ab dem
-- Freischalt-Level hebt der Spieler Waben aus so viel groesserem Abstand auf.
CombConfig.COLLECT_RADIUS_FACTOR = 1.6

--------------------------------------------------------------------------------
-- Rechen-Hilfen (Server UND Client benutzen dieselben, damit Anzeige und
-- Auszahlung nicht auseinanderlaufen)
--------------------------------------------------------------------------------

function CombConfig.clampLevel(level: number): number
	return math.clamp(math.floor(level), 1, CombConfig.RECYCLER_MAX_LEVEL)
end

-- 12.10. (Playtest "Recycler viel zu schwach, soll nur einen
-- Geldmultiplikator zeigen"): Jede Wabeneinheit hat einen GRUNDWERT, das
-- Recycler-Level ist ein MULTIPLIKATOR darauf. Die Kurve bleibt die alte
-- (PAY_PER_UNIT / PAY_GROWTH, geteilt durch den alten Level-1-Wert 3),
-- der Grundwert steigt von 3 auf BASE_PAY_PER_UNIT: alles x3,3. ANNAHME —
-- progression_pacing.lua rechnet den Recycler nicht mit; im Playtest pruefen.
-- 14.10. ("Recycler noch ein bisschen zu schwach"): 10 -> 25 (x2,5 auf alle
-- Level). Ein voller Stapel bringt damit auf Level 1 625, auf Level 10 50.000,
-- auf Level 30 rund 480.000 (vor dem Rebirth-Multiplikator). Zum Vergleich: eine
-- Stage in Tower II zahlt 140.000 bis 2,4 Mio.
CombConfig.BASE_PAY_PER_UNIT = 25

-- Auszahlung SOFORT bei der Abgabe statt nach und nach (Warteschlange,
-- getSpeed). Aus = alter Ablauf ueber Zeitmarke.
CombConfig.INSTANT_PAYOUT = true

local function legacyPay(clamped: number): number
	local fixed = CombConfig.PAY_PER_UNIT[clamped]
	if fixed then return fixed end
	local last = CombConfig.PAY_PER_UNIT[10] or 1
	return last * CombConfig.PAY_GROWTH ^ (clamped - 10)
end

-- Balance 15.10. ("Recycler im Verhaeltnis klar zu schwach", Ziel: ein voller
-- Stapel ~ 25 % des Tower-Einkommens im gleichen Fortschritt). Die alte Kurve
-- (x1,12 je Level) wuchs viel langsamer als Tower-Einkommen und Ausbaukosten
-- (x1,22 bis x1,33 je Level): auf Level 60 war der Stapel nur ~5 % einer
-- Tower-Stage. Deshalb ein Booster auf den Multiplikator:
--   Level 1-10   x1,0 (Einstieg unveraendert)
--   Level 10-30  linear bis x1,6
--   ab Level 30  x1,07 je Level (Level 60 ca. x12)
-- Ein voller Stapel liegt damit bei Level 20/30/40/60 etwa bei 0,2 / 0,8 / 4,7 /
-- 175 Mio (vor Rebirth-Multiplikator).
local function boost(level: number): number
	if level <= 10 then return 1 end
	if level <= 30 then return 1 + 0.6 * (level - 10) / 20 end
	return 1.6 * 1.07 ^ (level - 30)
end

-- Multiplikator auf den Grundwert bei diesem Level (Level 1 = x1). Unter 10
-- auf eine Nachkommastelle, darueber ganze Zahlen — so steht er auch am Schild.
function CombConfig.getMultiplier(level: number): number
	local clamped = CombConfig.clampLevel(level)
	local raw = legacyPay(clamped) / (CombConfig.PAY_PER_UNIT[1] or 1) * boost(clamped)
	if raw < 10 then
		return math.floor(raw * 10 + 0.5) / 10
	end
	return math.floor(raw + 0.5)
end

-- Gummies pro Wabeneinheit auf diesem Level, vor dem Rebirth-Multiplikator:
-- Grundwert x Multiplikator.
function CombConfig.getPayPerUnit(level: number): number
	return math.floor(CombConfig.BASE_PAY_PER_UNIT * CombConfig.getMultiplier(level) + 0.5)
end

-- Anzeige "x12" / "x2,5" (sprachneutral, Komma nur bei Nachkommastelle).
function CombConfig.formatMultiplier(level: number): string
	local m = CombConfig.getMultiplier(level)
	if m >= 1e6 then return (string.format("×%.1fM", m / 1e6):gsub("%.0M", "M")) end
	if m >= 1e4 then return string.format("×%dK", math.floor(m / 1000 + 0.5)) end
	if m == math.floor(m) then return string.format("×%d", m) end
	return (string.format("×%.1f", m):gsub("%.", ","))
end

-- Wabeneinheiten pro Sekunde: linear Level 1 -> 10, danach linear 10 -> 60.
function CombConfig.getSpeed(level: number): number
	local clamped = CombConfig.clampLevel(level)
	if clamped <= 10 then
		return CombConfig.SPEED_LEVEL_1
			+ (CombConfig.SPEED_LEVEL_10 - CombConfig.SPEED_LEVEL_1) * ((clamped - 1) / 9)
	end
	local span = math.max(1, CombConfig.RECYCLER_MAX_LEVEL - 10)
	return CombConfig.SPEED_LEVEL_10
		+ (CombConfig.SPEED_LEVEL_60 - CombConfig.SPEED_LEVEL_10) * ((clamped - 10) / span)
end

-- Kosten fuer den Ausbau AUF `targetLevel`; nil = es gibt dieses Level nicht.
-- Gleiche Kurve wie die Honig-Gebaeude (EconomyConfig.HONEY_UPGRADE_COSTS).
function CombConfig.getUpgradeCost(targetLevel: number): { gummies: number, goldGummies: number }?
	if targetLevel < 2 or targetLevel > CombConfig.RECYCLER_MAX_LEVEL then return nil end
	return EconomyConfig.HONEY_UPGRADE_COSTS[targetLevel]
end

-- Sekunden zwischen Abgabe und Respawn bei diesem Recycler-Level (Hook, siehe
-- RECYCLER_DELAY_FACTOR; mit Faktor 1 immer RESPAWN_DELAY_SECONDS).
function CombConfig.getRespawnDelay(recyclerLevel: number): number
	local steps = CombConfig.clampLevel(recyclerLevel) - 1
	return CombConfig.RESPAWN_DELAY_SECONDS * (CombConfig.RECYCLER_DELAY_FACTOR ^ steps)
end

-- Was ein VOLLER Stapel normaler Waben auf diesem Level ungefaehr bringt
-- (ohne goldene Waben und ohne Rebirth-Multiplikator). Nur fuer Anzeigen.
function CombConfig.estimateFullStackPay(level: number): number
	return CombConfig.MAX_CARRY * CombConfig.getPayPerUnit(level)
end

return CombConfig
]]></ProtectedString>
						<string name="ScriptGuid">{DEF5B028-8245-461A-837F-0EF83BBBBD78}</string>
