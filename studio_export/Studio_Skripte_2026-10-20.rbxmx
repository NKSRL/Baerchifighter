				<Item class="ModuleScript" referent="RBXE8DCAD516C634D68ADBE9CC2BDF737F8">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- RateLimiter.luau
-- ServerScriptService/Util/RateLimiter.luau
--
-- Einzige Zustaendigkeit:
--   - Cooldowns pro Spieler pro Remote durchsetzen
--   - Eine einheitliche Stelle an der Client-Requests entgegengenommen werden
--
-- Kein Service (kein init() im GameManager noetig ausser dem Cleanup-Hook) —
-- eine Utility die von jedem Service benutzt wird der ein Request*-Remote
-- entgegennimmt.
--
-- Benutzung in einem Service:
--   RateLimiter.connect(Remotes.RequestFoo, "RequestFoo", function(player, arg)
--       ...
--   end)
--
-- Damit ist es unmoeglich ein Remote zu verbinden und das Limit zu vergessen.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkConfig = require(ReplicatedStorage.Config.NetworkConfig)

local RateLimiter = {}

--------------------------------------------------------------------------------
-- Interner Zustand
--------------------------------------------------------------------------------

-- [Player][remoteName] = os.clock() des letzten akzeptierten Aufrufs
local _lastCall: { [Player]: { [string]: number } } = {}

-- [Player] = Anzahl bereits geloggter Verstoesse (Log-Flood-Schutz)
local _warnCount: { [Player]: number } = {}

--------------------------------------------------------------------------------
-- Oeffentliche API
--------------------------------------------------------------------------------

-- Prueft ob dieser Spieler dieses Remote gerade aufrufen darf.
-- Gibt true zurueck und merkt sich den Zeitpunkt, oder false bei Cooldown.
function RateLimiter.check(player: Player, remoteName: string): boolean
	local now      = os.clock()
	local cooldown = NetworkConfig.getCooldown(remoteName)

	local perPlayer = _lastCall[player]
	if not perPlayer then
		perPlayer = {}
		_lastCall[player] = perPlayer
	end

	local last = perPlayer[remoteName]
	if last and (now - last) < cooldown then
		local count = (_warnCount[player] or 0) + 1
		_warnCount[player] = count
		if count <= NetworkConfig.MAX_WARNINGS_PER_PLAYER then
			warn(
				"[RateLimiter] Zu schnell:", player.Name, "→", remoteName,
				string.format("(%.2fs von %.2fs)", now - last, cooldown)
			)
		end
		return false
	end

	perPlayer[remoteName] = now
	return true
end

-- Verbindet ein RemoteEvent mit einem Handler und schaltet das Limit davor.
-- Der Handler wird nur aufgerufen wenn der Cooldown eingehalten wurde.
function RateLimiter.connect(
	remote: RemoteEvent,
	remoteName: string,
	handler: (Player, ...any) -> ()
)
	remote.OnServerEvent:Connect(function(player: Player, ...)
		if not RateLimiter.check(player, remoteName) then
			return
		end
		handler(player, ...)
	end)
end

-- Dasselbe fuer RemoteFunctions. Bei Cooldown wird nil zurueckgegeben
-- statt den Handler aufzurufen.
function RateLimiter.connectFunction(
	remote: RemoteFunction,
	remoteName: string,
	handler: (Player, ...any) -> any
)
	remote.OnServerInvoke = function(player: Player, ...)
		if not RateLimiter.check(player, remoteName) then
			return nil
		end
		return handler(player, ...)
	end
end

-- Speicher freigeben wenn ein Spieler geht
function RateLimiter.clear(player: Player)
	_lastCall[player]  = nil
	_warnCount[player] = nil
end

function RateLimiter.init()
	Players.PlayerRemoving:Connect(RateLimiter.clear)
	print("[RateLimiter] Initialisiert")
end

return RateLimiter
]]></ProtectedString>
						<string name="ScriptGuid">{D54E2C69-0A3D-4C61-A3F7-667323B5B853}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">RateLimiter</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX57A24B32DC144C458941A81EC48391EC">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- SessionLock.luau
-- ServerScriptService/Util/SessionLock.luau
--
-- Einzige Zustaendigkeit:
--   - Entscheiden, ob ein gespeicherter Spielstand gerade von einem ANDEREN
--     Server benutzt wird, und das Sitzungs-Feld fuer diesen Server bauen
--
-- Warum es das gibt: wechselt ein Spieler schnell den Server, kann der neue
-- Server den Spielstand laden, bevor der alte ihn beim Verlassen geschrieben
-- hat. Ohne Sperre spielen dann zwei Server mit zwei Kopien, und wer zuletzt
-- schreibt, loescht den Fortschritt des anderen. Das Feld `session` im
-- Spielstand sagt, welcher Server ihn gerade haelt und seit wann.
--
-- Bewusst eine reine Rechnung (kein DataStore, keine Zeitquelle): PlayerService
-- ruft sie INNERHALB des UpdateAsync-Rueckrufs auf, und dort darf nichts
-- yielden. Ausserdem laesst sie sich so ohne Studio testen
-- (tools/luau-tests/session_lock.test.lua).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage.Network.Types)

-- Nach so vielen Sekunden ohne Auffrischung gilt eine fremde Sperre als
-- verwaist (Server abgestuerzt, ohne zu speichern). Der Halter frischt sie mit
-- jedem Speichern auf, also spaetestens alle SAVE_INTERVAL (60 s) in
-- PlayerService. Drei verpasste Speicherungen sind sicher kein Zufall mehr.
local STALE_AFTER_SECONDS = 180

local SessionLock = {}

SessionLock.STALE_AFTER_SECONDS = STALE_AFTER_SECONDS

-- true = ein anderer Server haelt den Spielstand und hat sich vor kurzem
-- gemeldet. Unlesbare oder unvollstaendige Felder zaehlen als "keine Sperre":
-- lieber einmal zu viel laden als einen Spieler fuer immer aussperren.
function SessionLock.isHeldByOther(session: any, jobId: string, now: number): boolean
	if typeof(session) ~= "table" then
		return false
	end
	if typeof(session.jobId) ~= "string" or typeof(session.lockedAt) ~= "number" then
		return false
	end
	if session.jobId == jobId then
		return false
	end
	return now - session.lockedAt < STALE_AFTER_SECONDS
end

-- Das Feld, das dieser Server beim Laden und bei jedem Speichern einsetzt.
function SessionLock.claim(jobId: string, now: number): Types.SessionLock
	return { jobId = jobId, lockedAt = now }
end

return SessionLock
]]></ProtectedString>
