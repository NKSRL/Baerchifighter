					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- IndexRewardService.luau
-- ServerScriptService/Services/IndexRewardService.luau
--
-- Einzige Zustaendigkeit:
--   - Index-Belohnungen (Sammel-Update 05.10., Paket 7): pruefen, ob eine
--     Kollektion fertig ist, und sie beim Abholen auszahlen.
--
-- Welche Kollektionen es gibt und was sie bringen, steht in
-- Config/IndexRewardConfig. Abgeholt wird bewusst von Hand (kein
-- automatisches Auszahlen) und auch rueckwirkend: wer eine Reihe schon
-- komplett hat, holt sie sofort ab.
--
-- Auszahlung nur ueber die bestehenden Wege: Gummies und GoldGummies ueber
-- EconomyService, Eier ueber EggService.grantEggs, Blaupausen ueber
-- EggTreeService.grantBlueprint. Inkubator-Plaetze werden nicht gespeichert,
-- sondern aus indexClaimed abgeleitet (IndexRewardConfig.incubatorSlots).
--
-- Beobachter an onDataChanged: meldet einmal pro Sitzung, wenn eine neue
-- Belohnung abholbar wird (Hinweis), mit task.defer und ohne markDirty —
-- er aendert nichts am Spielstand.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Players             = game:GetService("Players")

local Types             = require(ReplicatedStorage.Network.Types)
local Remotes           = require(ReplicatedStorage.Network.Remotes)
local Loc               = require(ReplicatedStorage.Localization.Loc)
local FeatureFlags      = require(ReplicatedStorage.Config.FeatureFlags)
local IndexRewardConfig = require(ReplicatedStorage.Config.IndexRewardConfig)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local EggService     = require(ServerScriptService.Services.EggService)
local EggTreeService = require(ServerScriptService.Services.EggTreeService)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local IndexRewardService = {}

-- Was dieser Spieler in dieser Sitzung schon als abholbar gemeldet bekam.
local _announced: { [Player]: { [string]: boolean } } = {}

local function fail(player: Player, reason: Types.LocMsg)
	Remotes.ActionFailed:FireClient(player, "RequestClaimIndexReward", reason)
end

function IndexRewardService.claim(player: Player, rewardId: string): Types.IndexRewardResult?
	if not FeatureFlags.isOn("INDEX_REWARDS") then return nil end
	local data = PlayerService.getData(player)
	if not data then return nil end

	local entry = IndexRewardConfig.get(rewardId)
	if not entry then
		fail(player, Loc.msg("err.index_reward_unknown"))
		return nil
	end
	if data.indexClaimed[rewardId] then
		fail(player, Loc.msg("err.index_reward_claimed"))
		return nil
	end
	if not IndexRewardConfig.isComplete(entry, data.discovered) then
		local have, total = IndexRewardConfig.progress(entry, data.discovered)
		fail(player, Loc.msg("err.index_reward_incomplete", { have = have, total = total }))
		return nil
	end

	-- Erst als abgeholt markieren, dann auszahlen: ein zweiter Klick im
	-- selben Moment findet den Haken schon gesetzt.
	data.indexClaimed[rewardId] = true

	local reward = entry.reward
	local result: Types.IndexRewardResult = {
		rewardId       = rewardId,
		gummies        = 0,
		goldGummies    = 0,
		eggType        = reward.eggType,
		eggs           = 0,
		blueprints     = reward.blueprints,
		incubatorSlots = reward.incubatorSlots,
	}
	if reward.gummies > 0 then
		result.gummies = EconomyService.awardGummies(player, reward.gummies)
	end
	if reward.goldGummies > 0 then
		result.goldGummies = EconomyService.awardGoldGummies(player, reward.goldGummies)
	end
	if reward.eggType and reward.eggs > 0 and EggService.grantEggs(player, reward.eggType, reward.eggs) then
		result.eggs = reward.eggs
	end
	if reward.blueprints > 0 then
		EggTreeService.grantBlueprint(player, data, reward.blueprints)
	end

	Remotes.IndexRewardReceived:FireClient(player, result)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)
	print("[IndexRewardService]", player.Name, "| abgeholt:", rewardId)
	return result
end

local function onDataChanged(player: Player, data: Types.PlayerData)
	if not FeatureFlags.isOn("INDEX_REWARDS") then return end
	local seen = _announced[player]
	if not seen then
		-- Erster Stand der Sitzung: was schon abholbar ist, zeigt das "!" am
		-- Index; ein Extra-Hinweis kommt nur fuer NEU fertige Reihen.
		seen = {}
		for _, id in IndexRewardConfig.claimable(data.discovered, data.indexClaimed) do
			seen[id] = true
		end
		_announced[player] = seen
		return
	end
	local fresh: { string } = {}
	for _, id in IndexRewardConfig.claimable(data.discovered, data.indexClaimed) do
		if not seen[id] then
			seen[id] = true
			table.insert(fresh, id)
		end
	end
	if #fresh > 0 then
		task.defer(function()
			if player.Parent then
				Remotes.EventNotice:FireClient(player, Loc.msg("msg.index_reward_ready"), "good")
			end
		end)
	end
end

function IndexRewardService.init()
	RateLimiter.connect(Remotes.RequestClaimIndexReward, "RequestClaimIndexReward", function(player, rewardId: any)
		if typeof(rewardId) ~= "string" or #rewardId > 64 then return end
		IndexRewardService.claim(player, rewardId)
	end)
	PlayerService.onDataChanged(onDataChanged)
	Players.PlayerRemoving:Connect(function(player)
		_announced[player] = nil
	end)
	print("[IndexRewardService] Initialisiert |", #IndexRewardConfig.ENTRIES, "Belohnungen")
end

return IndexRewardService
]]></ProtectedString>
						<string name="ScriptGuid">{DFA56E5A-10DA-4885-82D9-49967072E8FD}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">IndexRewardService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX7C71D868C52E40EDB0360BA2B2F04637">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- IslandService.luau
-- ServerScriptService/Services/IslandService.luau
--
-- Einzige Zustaendigkeit:
--   - Insel-Struktur veraendern: Gebaeude-Level und welcher Baerchi
--     ausgeruestet ist (v15: das PIT-Level ist entfallen, siehe TowerService)
--   - Die zugehoerigen Client-Requests entgegennehmen und validieren
--   - Nach einer Aenderung die sichtbare Insel via MapService nachziehen
--
-- Die Waehrungs-Transaktion selbst liegt in EconomyService — dieser Service
-- entscheidet nur WAS gekauft wird und was danach in der Welt passieren muss.
--
-- Equip-Baerchi gehoert hier rein statt in einen eigenen Service: es ist
-- genau wie die Gebaeude-Upgrades eine Aenderung an der
-- Insel-STRUKTUR (welcher Baerchi ueberhaupt in der Welt steht), keine neue
-- Zustaendigkeit fuer sich.

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Types         = require(ReplicatedStorage.Network.Types)
local Remotes       = require(ReplicatedStorage.Network.Remotes)
local Loc           = require(ReplicatedStorage.Localization.Loc)

local PlayerService  = require(ServerScriptService.Services.PlayerService)
local EconomyService = require(ServerScriptService.Services.EconomyService)
local MapService     = require(ServerScriptService.Services.MapService)
local ActivityLock   = require(ServerScriptService.Util.ActivityLock)
local RateLimiter    = require(ServerScriptService.Util.RateLimiter)

local IslandService = {}

-- Gueltige BuildingIds als Menge — Client-Strings duerfen nie ungeprueft
-- als Types.BuildingId weiterverwendet werden.
local VALID_BUILDINGS: { [string]: boolean } = {
	Beehive      = true,
	HoneyRefiner = true,
	HoneyPond    = true,
}

local function fail(player: Player, action: string, reason: Types.LocMsg?)
	Remotes.ActionFailed:FireClient(player, action, reason or Loc.msg("err.unknown"))
end

--------------------------------------------------------------------------------
-- Gebaeude-Upgrade
--------------------------------------------------------------------------------

function IslandService.upgradeBuilding(player: Player, buildingId: Types.BuildingId)
	local data = PlayerService.getData(player)
	if not data then return end

	local ok, reason = EconomyService.upgradeBuilding(player, buildingId)
	if not ok then
		fail(player, "RequestUpgradeBuilding", reason)
		return
	end

	local newLevel = data.island.buildings[buildingId].level

	-- Level-Attribut an der Gebaeude-Part nachziehen (Client liest es direkt)
	MapService.updateBuildingLevel(player, buildingId, newLevel)
	PlayerService.saveNow(player)

	print("[IslandService]", player.Name, "| Gebaeude:", buildingId, "→ Level", newLevel)
end

--------------------------------------------------------------------------------
-- Baerchi ausruesten
--------------------------------------------------------------------------------

-- Setzt automatisch einen ausgeruesteten Baerchi, falls gerade keiner steht
-- aber welche im Inventar sind. Oeffentlich, weil EggService (erster Hatch,
-- damit der Plot nicht leer bleibt) und FusionService das brauchen (seit v12
-- kann der ausgeruestete nicht mehr verwertet werden) — und weil es hier beim Laden jedes
-- Spielstands als Sicherheitsnetz laeuft (siehe init unten).
--
-- Reine Datenfunktion ohne Remote-Antwort: der Aufrufer entscheidet selbst,
-- ob danach ein MapService.updateBaerchis noetig ist.
function IslandService.autoEquipIfNone(data: Types.PlayerData)
	local island = data.island

	if island.equippedUid and island.baerchis[island.equippedUid] then
		return   -- schon einer da, und der existiert auch wirklich
	end

	-- Deterministisch nach uid statt "irgendeiner": sonst wuerde bei jedem
	-- Aufruf ein anderer Baerchi gewinnen, weil die Iteration ueber eine
	-- Hash-Tabelle nicht stabil ist.
	local bestUid: string? = nil
	for uid in island.baerchis do
		if not bestUid or uid < bestUid then
			bestUid = uid
		end
	end

	island.equippedUid = bestUid
end

-- 14.10. Pull-Hook statt require: PetModeService haengt von IslandService ab
-- (nicht umgekehrt), kennt aber alle laufenden Bewegungen der Figur.
local _beforeEquipHook: ((Player) -> boolean)? = nil

function IslandService.setBeforeEquipHook(hook: (Player) -> boolean)
	_beforeEquipHook = hook
end

function IslandService.equipBaerchi(player: Player, baerchiUid: string)
	local data = PlayerService.getData(player)
	if not data then return end

	if not data.island.baerchis[baerchiUid] then
		fail(player, "RequestEquipBaerchi", Loc.msg("err.baerchi_not_found"))
		return
	end

	if data.island.equippedUid == baerchiUid then
		return   -- schon ausgeruestet, nichts zu tun
	end

	-- 14.10. Ausruesten geht JEDERZEIT. Ein Equip-Wechsel ersetzt die Figur, die
	-- JETZT auf dem Plot steht — und die kann gerade laufen (Kampf, Event, Teich).
	-- Frueher wurde der Wechsel dann abgelehnt. Jetzt beendet der Hook (gesetzt
	-- von PetModeService, der alle diese Bewegungen kennt) die Aktivitaet der
	-- alten Figur sofort: im Kampf zaehlen nur die fertig gespielten Stages, das
	-- Event/der Weg endet. Der neue Baerchi steht danach zu Hause auf dem Plot.
	local hook = _beforeEquipHook
	if hook and not hook(player) then
		return   -- z.B. UFO-Entfuehrung: der Hook hat den Grund schon gemeldet
	end
	ActivityLock.forceRelease(player)

	data.island.equippedUid = baerchiUid

	-- Struktur-Aenderung (es steht jetzt eine ANDERE Figur auf dem Plot), kein
	-- reiner Zustandswert — deshalb der teurere Neuaufbau, und ohne Sperre: das
	-- Schloss ist eben freigegeben worden.
	MapService.replaceBaerchis(player, data.island)
	PlayerService.markDirty(player)
	PlayerService.saveNow(player)

	print("[IslandService]", player.Name, "| ausgeruestet:", baerchiUid)
end

--------------------------------------------------------------------------------
-- Initialisierung
--------------------------------------------------------------------------------

function IslandService.init()
	RateLimiter.connect(Remotes.RequestUpgradeBuilding, "RequestUpgradeBuilding", function(player, buildingId: any)
		if typeof(buildingId) ~= "string" then return end
		if not VALID_BUILDINGS[buildingId] then
			fail(player, "RequestUpgradeBuilding", Loc.msg("err.building_unknown"))
			return
		end
		IslandService.upgradeBuilding(player, buildingId :: Types.BuildingId)
	end)

	RateLimiter.connect(Remotes.RequestEquipBaerchi, "RequestEquipBaerchi", function(player, baerchiUid: any)
		if typeof(baerchiUid) ~= "string" then return end
		IslandService.equipBaerchi(player, baerchiUid)
	end)

	-- Sicherheitsnetz: ein alter Spielstand ohne equippedUid (oder einer
	-- dessen ausgeruesteter Baerchi inzwischen weg ist) bekommt beim Laden
	-- automatisch den naechstbesten.
	PlayerService.onDataLoaded(function(_player, data)
		IslandService.autoEquipIfNone(data)
	end)

	print("[IslandService] Initialisiert")
end

return IslandService
]]></ProtectedString>
						<string name="ScriptGuid">{20A01B81-C9A1-49CD-98F0-58A0364ABE5A}</string>
